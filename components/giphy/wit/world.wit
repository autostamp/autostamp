    /// The width of this GIF in pixels.
    width: option<string>
  }

  /// The User Object contains information about the user associated with a GIF and URLs to assets such as that user's avatar image, profile, and more.
  record user {
    /// The URL for this user's avatar image.
    avatar-url: option<string>,
    /// The URL for the banner image that appears atop this user's profile page.
    banner-url: option<string>,
    /// The display name associated with this user (contains formatting the base username might not).
    display-name: option<string>,
    /// The URL for this user's profile.
    profile-url: option<string>,
    /// The Twitter username associated with this user, if applicable.
    twitter: option<string>,
    /// The username associated with this user.
    username: option<string>
  }

  /// The Meta Object contains basic information regarding the request, whether it was successful, and the response given by the API.  Check `responses` to see a description of types of response codes the API might give you under different cirumstances.
  record meta {
    /// HTTP Response Message
    msg: option<string>,
    /// A unique ID paired with this response from the API.
    response-id: option<string>,
    /// HTTP Response Code
    status: option<s32>
  }

  /// The Pagination Object contains information relating to the number of total results available as well as the number of results fetched and their relative positions.
  record pagination {
    /// Total number of items returned.
    count: option<s32>,
    /// Position in pagination.
    offset: option<s32>,
    /// Total number of items available.
    total-count: option<s32>
  }

  record random-gif-response {
    data: option<gif>,
    meta: option<meta>
  }

  record search-gifs-response {
    data: option<list<gif>>,
    meta: option<meta>,
    pagination: option<pagination>
  }

  record translate-gif-response {
    data: option<gif>,
    meta: option<meta>
  }

  record trending-gifs-response {
    data: option<list<gif>>,
    meta: option<meta>,
    pagination: option<pagination>
  }

  record get-gif-by-id-response {
    data: option<gif>,
    meta: option<meta>
  }

  variant get-gifs-by-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant random-gif-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant search-gifs-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant translate-gif-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant trending-gifs-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant get-gif-by-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  /// Get GIFs by ID
  record get-gifs-by-id-params {
    /// Filters results by specified GIF IDs, separated by commas.
    ids: option<string>
  }
  get-gifs-by-id: func(params: get-gifs-by-id-params) -> result<get-gifs-by-id-response, get-gifs-by-id-error>;

  /// Random GIF
  record random-gif-params {
    /// Filters results by specified tag.
    tag: option<string>,
    /// Filters results by specified rating.
    rating: option<string>
  }
  random-gif: func(params: random-gif-params) -> result<random-gif-response, random-gif-error>;

  /// Search GIFs
  record search-gifs-params {
    /// Search query term or prhase.
    q: string,
    /// The maximum number of records to return.
    limit: option<s32>,
    /// An optional results offset.
    offset: option<s32>,
    /// Filters results by specified rating.
    rating: option<string>,
    /// Specify default language for regional content; use a 2-letter ISO 639-1 language code.
    lang: option<string>
  }
  search-gifs: func(params: search-gifs-params) -> result<search-gifs-response, search-gifs-error>;

  /// Translate phrase to GIF
  record translate-gif-params {
    /// Search term.
    s: string
  }
  translate-gif: func(params: translate-gif-params) -> result<translate-gif-response, translate-gif-error>;

  /// Trending GIFs
  record trending-gifs-params {
    /// The maximum number of records to return.
    limit: option<s32>,
    /// An optional results offset.
    offset: option<s32>,
    /// Filters results by specified rating.
    rating: option<string>
  }
  trending-gifs: func(params: trending-gifs-params) -> result<trending-gifs-response, trending-gifs-error>;

  /// Get GIF by Id
  record get-gif-by-id-params {
    /// Filters results by specified GIF ID.
    gif-id: string
  }
  get-gif-by-id: func(params: get-gif-by-id-params) -> result<get-gif-by-id-response, get-gif-by-id-error>;

}


interface stickers {
  enum gif-type-op-enum {
    gif,
  }

  record random-sticker-response {
    data: option<gif>,
    meta: option<meta>
  }

  record gif {
    /// The unique bit.ly URL for this GIF
    bitly-url: option<string>,
    /// Currently unused
    content-url: option<string>,
    /// The date this GIF was added to the GIPHY database.
    create-datetime: option<string>,
    /// A URL used for embedding this GIF
    embded-url: option<string>,
    /// An array of featured tags for this GIF (Note: Not available when using the Public Beta Key)
    featured-tags: option<list<string>>,
    /// This GIF's unique ID
    id: option<string>,
    /// An object containing data for various available formats and sizes of this GIF.
    images: option<gif-images>,
    /// The creation or upload date from this GIF's source.
    import-datetime: option<string>,
    /// The MPAA-style rating for this content. Examples include Y, G, PG, PG-13 and R
    rating: option<string>,
    /// The unique slug used in this GIF's URL
    slug: option<string>,
    /// The page on which this GIF was found
    source: option<string>,
    /// The URL of the webpage on which this GIF was found.
    source-post-url: option<string>,
    /// The top level domain of the source URL.
    source-tld: option<string>,
    /// An array of tags for this GIF (Note: Not available when using the Public Beta Key)
    tags: option<list<string>>,
    /// The date on which this gif was marked trending, if applicable.
