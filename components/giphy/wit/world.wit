  /// The User Object contains information about the user associated with a GIF and URLs to assets such as that user's avatar image, profile, and more.
  record user {
    /// The URL for this user's avatar image.
    avatar-url: option<string>,
    /// The URL for the banner image that appears atop this user's profile page.
    banner-url: option<string>,
    /// The display name associated with this user (contains formatting the base username might not).
    display-name: option<string>,
    /// The URL for this user's profile.
    profile-url: option<string>,
    /// The Twitter username associated with this user, if applicable.
    twitter: option<string>,
    /// The username associated with this user.
    username: option<string>
  }

  /// The Meta Object contains basic information regarding the request, whether it was successful, and the response given by the API.  Check `responses` to see a description of types of response codes the API might give you under different cirumstances.
  record meta {
    /// HTTP Response Message
    msg: option<string>,
    /// A unique ID paired with this response from the API.
    response-id: option<string>,
    /// HTTP Response Code
    status: option<s32>
  }

  record search-stickers-response {
    data: option<list<gif>>,
    meta: option<meta>,
    pagination: option<pagination>
  }

  /// The Pagination Object contains information relating to the number of total results available as well as the number of results fetched and their relative positions.
  record pagination {
    /// Total number of items returned.
    count: option<s32>,
    /// Position in pagination.
    offset: option<s32>,
    /// Total number of items available.
    total-count: option<s32>
  }

  record translate-sticker-response {
    data: option<gif>,
    meta: option<meta>
  }

  record trending-stickers-response {
    data: option<list<gif>>,
    meta: option<meta>,
    pagination: option<pagination>
  }

  variant random-sticker-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant search-stickers-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant translate-sticker-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant trending-stickers-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  /// Random Sticker
  record random-sticker-params {
    /// Filters results by specified tag.
    tag: option<string>,
    /// Filters results by specified rating.
    rating: option<string>
  }
  random-sticker: func(params: random-sticker-params) -> result<random-sticker-response, random-sticker-error>;

  /// Search Stickers
  record search-stickers-params {
    /// Search query term or prhase.
    q: string,
    /// The maximum number of records to return.
    limit: option<s32>,
    /// An optional results offset.
    offset: option<s32>,
    /// Filters results by specified rating.
    rating: option<string>,
    /// Specify default language for regional content; use a 2-letter ISO 639-1 language code.
    lang: option<string>
  }
  search-stickers: func(params: search-stickers-params) -> result<search-stickers-response, search-stickers-error>;

  /// Translate phrase to Sticker
  record translate-sticker-params {
    /// Search term.
    s: string
  }
  translate-sticker: func(params: translate-sticker-params) -> result<translate-sticker-response, translate-sticker-error>;

  /// Trending Stickers
  record trending-stickers-params {
    /// The maximum number of records to return.
    limit: option<s32>,
    /// An optional results offset.
    offset: option<s32>,
    /// Filters results by specified rating.
    rating: option<string>
  }
  trending-stickers: func(params: trending-stickers-params) -> result<trending-stickers-response, trending-stickers-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export gifs;
  export stickers;
}
