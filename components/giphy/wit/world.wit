/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `api_key` | query `api_key` |
package autostamp:giphy@0.3.0;

interface gifs {
  /// Get GIFs by ID
  record get-gifs-by-id-params {
    /// Filters results by specified GIF IDs, separated by commas.
    ids: option<string>
  }
  get-gifs-by-id: func(params: get-gifs-by-id-params) -> result<string, string>;

  /// Random GIF
  record random-gif-params {
    /// Filters results by specified tag.
    tag: option<string>,
    /// Filters results by specified rating.
    rating: option<string>
  }
  random-gif: func(params: random-gif-params) -> result<string, string>;

  /// Search GIFs
  record search-gifs-params {
    /// Search query term or prhase.
    q: string,
    /// The maximum number of records to return.
    limit: option<s32>,
    /// An optional results offset.
    offset: option<s32>,
    /// Filters results by specified rating.
    rating: option<string>,
    /// Specify default language for regional content; use a 2-letter ISO 639-1 language code.
    lang: option<string>
  }
  search-gifs: func(params: search-gifs-params) -> result<string, string>;

  /// Translate phrase to GIF
  record translate-gif-params {
    /// Search term.
    s: string
  }
  translate-gif: func(params: translate-gif-params) -> result<string, string>;

  /// Trending GIFs
  record trending-gifs-params {
    /// The maximum number of records to return.
    limit: option<s32>,
    /// An optional results offset.
    offset: option<s32>,
    /// Filters results by specified rating.
    rating: option<string>
  }
  trending-gifs: func(params: trending-gifs-params) -> result<string, string>;

  /// Get GIF by Id
  record get-gif-by-id-params {
    /// Filters results by specified GIF ID.
    gif-id: string
  }
  get-gif-by-id: func(params: get-gif-by-id-params) -> result<string, string>;

}


interface stickers {
  /// Random Sticker
  record random-sticker-params {
    /// Filters results by specified tag.
    tag: option<string>,
    /// Filters results by specified rating.
    rating: option<string>
  }
  random-sticker: func(params: random-sticker-params) -> result<string, string>;

  /// Search Stickers
  record search-stickers-params {
    /// Search query term or prhase.
    q: string,
    /// The maximum number of records to return.
    limit: option<s32>,
    /// An optional results offset.
    offset: option<s32>,
    /// Filters results by specified rating.
    rating: option<string>,
    /// Specify default language for regional content; use a 2-letter ISO 639-1 language code.
    lang: option<string>
  }
  search-stickers: func(params: search-stickers-params) -> result<string, string>;

  /// Translate phrase to Sticker
  record translate-sticker-params {
    /// Search term.
    s: string
  }
  translate-sticker: func(params: translate-sticker-params) -> result<string, string>;

  /// Trending Stickers
  record trending-stickers-params {
    /// The maximum number of records to return.
    limit: option<s32>,
    /// An optional results offset.
    offset: option<s32>,
    /// Filters results by specified rating.
    rating: option<string>
  }
  trending-stickers: func(params: trending-stickers-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export gifs;
  export stickers;
}
