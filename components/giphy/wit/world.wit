/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `api_key` | query `api_key` |
package autostamp:giphy@0.5.0;

interface gifs {
  enum gif-type-op-enum {
    gif,
  }

  record get-gifs-by-id-response {
    data: option<list<gif>>,
    meta: option<meta>,
    pagination: option<pagination>
  }

  record gif {
    /// The unique bit.ly URL for this GIF
    bitly-url: option<string>,
    /// Currently unused
    content-url: option<string>,
    /// The date this GIF was added to the GIPHY database.
    create-datetime: option<string>,
    /// A URL used for embedding this GIF
    embded-url: option<string>,
    /// An array of featured tags for this GIF (Note: Not available when using the Public Beta Key)
    featured-tags: option<list<string>>,
    /// This GIF's unique ID
    id: option<string>,
    /// An object containing data for various available formats and sizes of this GIF.
    images: option<gif-images>,
    /// The creation or upload date from this GIF's source.
    import-datetime: option<string>,
    /// The MPAA-style rating for this content. Examples include Y, G, PG, PG-13 and R
    rating: option<string>,
    /// The unique slug used in this GIF's URL
    slug: option<string>,
    /// The page on which this GIF was found
    source: option<string>,
    /// The URL of the webpage on which this GIF was found.
    source-post-url: option<string>,
    /// The top level domain of the source URL.
    source-tld: option<string>,
    /// An array of tags for this GIF (Note: Not available when using the Public Beta Key)
    tags: option<list<string>>,
    /// The date on which this gif was marked trending, if applicable.
    trending-datetime: option<string>,
    /// Type of the gif. By default, this is almost always gif
    type-op: option<gif-type-op-enum>,
    /// The date on which this GIF was last updated.
    update-datetime: option<string>,
    /// The unique URL for this GIF
    url: option<string>,
    user: option<user>,
    /// The username this GIF is attached to, if applicable
    username: option<string>
  }

  /// An object containing data for various available formats and sizes of this GIF.
  record gif-images {
    downsized: option<gif-images-downsized>,
    downsized-large: option<gif-images-downsized-large>,
    downsized-medium: option<gif-images-downsized-medium>,
    downsized-small: option<gif-images-downsized-small>,
    downsized-still: option<gif-images-downsized-still>,
    fixed-height: option<gif-images-fixed-height>,
    fixed-height-downsampled: option<gif-images-fixed-height-downsampled>,
    fixed-height-small: option<gif-images-fixed-height-small>,
    fixed-height-small-still: option<gif-images-fixed-height-small-still>,
    fixed-height-still: option<gif-images-fixed-height-still>,
    fixed-width: option<gif-images-fixed-width>,
    fixed-width-downsampled: option<gif-images-fixed-width-downsampled>,
    fixed-width-small: option<gif-images-fixed-width-small>,
    fixed-width-small-still: option<gif-images-fixed-width-small-still>,
    fixed-width-still: option<gif-images-fixed-width-still>,
    looping: option<gif-images-looping>,
    original: option<gif-images-original>,
    original-still: option<gif-images-original-still>,
    preview: option<gif-images-preview>,
    preview-gif: option<gif-images-preview-gif>
  }

  record gif-images-downsized {
    /// The number of frames in this GIF.
    frames: option<string>,
    /// The height of this GIF in pixels.
    height: option<string>,
    /// The URL for this GIF in .MP4 format.
    mp4: option<string>,
    /// The size in bytes of the .MP4 file corresponding to this GIF.
    mp4-size: option<string>,
    /// The size of this GIF in bytes.
    size: option<string>,
    /// The publicly-accessible direct URL for this GIF.
    url: option<string>,
    /// The URL for this GIF in .webp format.
    webp: option<string>,
    /// The size in bytes of the .webp file corresponding to this GIF.
    webp-size: option<string>,
    /// The width of this GIF in pixels.
    width: option<string>
  }

  record gif-images-downsized-large {
    /// The number of frames in this GIF.
    frames: option<string>,
