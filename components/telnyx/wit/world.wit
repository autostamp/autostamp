interface messaging-profiles {
  enum list-messaging-profile-metrics-time-frame-enum {
    v1h,
    v3h,
    v24h,
    v3d,
    v7d,
    v30d,
  }

  enum create-messaging-profile-request-webhook-api-version-enum {
    v1,
    v2,
    v2010-v04-v01,
  }

  enum update-messaging-profile-request-record-type-enum {
    messaging-profile,
  }

  /// Number Pool allows you to send messages from a pool of numbers of different types, assigning
  /// weights to each type. The pool consists of all the long code and toll free numbers
  /// assigned to the messaging profile.
  /// 
  /// To disable this feature, set the object field to `null`.
  record number-pool-settings {
    /// If set to true, Number Pool will try to choose a sending number with the same area code as the destination
    /// number. If there are no such numbers available, a nunber with a different area code will be chosen. Currently
    geomatch: option<bool>,
    /// Defines the probability weight for a Long Code number to be selected when sending a message.
    /// The higher the weight the higher the probability. The sum of the weights for all number types
    long-code-weight: f64,
    /// If set to true all unhealthy numbers will be automatically excluded from the pool.
    /// Health metrics per number are calculated on a regular basis, taking into account the deliverability
    skip-unhealthy: bool,
    /// If set to true, Number Pool will try to choose the same sending number for all messages to a particular
    /// recipient. If the sending number becomes unhealthy and `skip_unhealthy` is set to true, a new
    sticky-sender: option<bool>,
    /// Defines the probability weight for a Toll Free number to be selected when sending a message.
    /// The higher the weight the higher the probability. The sum of the weights for all number types
    toll-free-weight: f64
  }

  /// The URL shortener feature allows automatic replacement of URLs that were generated using
  /// a public URL shortener service. Some examples include bit.do, bit.ly, goo.gl, ht.ly,
  /// is.gd, ow.ly, rebrand.ly, t.co, tiny.cc, and tinyurl.com. Such URLs are replaced with
  /// with links generated by Telnyx. The use of custom links can improve branding and message
  /// deliverability.
  /// 
  /// To disable this feature, set the object field to `null`.
  record url-shortener-settings {
    /// One of the domains provided by the Telnyx URL shortener service.
    domain: string,
    /// Optional prefix that can be used to identify your brand, and will appear in the Telnyx generated URLs after the domain name.
    prefix: option<string>,
    /// Use the link replacement tool only for links that are specifically blacklisted by Telnyx.
    replace-blacklist-only: option<bool>,
    /// Receive webhooks for when your replaced links are clicked. Webhooks are sent to the webhooks on the messaging profile.
    send-webhooks: option<bool>
  }

  /// List messaging profile metrics
  record list-messaging-profile-metrics-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// The id of the messaging profile(s) to retrieve
    id: option<string>,
    /// The timeframe for which you'd like to retrieve metrics.
    time-frame: option<list-messaging-profile-metrics-time-frame-enum>
  }
  list-messaging-profile-metrics: func(params: list-messaging-profile-metrics-params) -> result<string, string>;

  /// List messaging profiles
  record list-messaging-profiles-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-messaging-profiles: func(params: list-messaging-profiles-params) -> result<string, string>;

  /// Create a messaging profile
  record create-messaging-profile-params {
    /// Specifies whether the messaging profile is enabled or not.
    enabled: option<bool>,
    /// A user friendly name for the messaging profile.
    name: string,
    number-pool-settings: option<number-pool-settings>,
    url-shortener-settings: option<url-shortener-settings>,
    /// Determines which webhook format will be used, Telnyx API v1, v2, or a legacy 2010-04-01 format.
    webhook-api-version: option<create-messaging-profile-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this messaging profile will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this messaging profile will be sent.
    webhook-url: option<string>
  }
  create-messaging-profile: func(params: create-messaging-profile-params) -> result<string, string>;

  /// Retrieve a messaging profile
  record retrieve-messaging-profile-params {
    /// The id of the messaging profile to retrieve
    id: string
  }
  retrieve-messaging-profile: func(params: retrieve-messaging-profile-params) -> result<string, string>;

  /// Update a messaging profile
  record update-messaging-profile-params {
    /// The id of the messaging profile to retrieve
    id: string,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// Specifies whether the messaging profile is enabled or not.
    enabled: option<bool>,
    /// A user friendly name for the messaging profile.
    name: option<string>,
    number-pool-settings: option<number-pool-settings>,
    /// Identifies the type of the resource.
    record-type: option<update-messaging-profile-request-record-type-enum>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>,
    url-shortener-settings: option<url-shortener-settings>,
    /// Secret used to authenticate with v1 endpoints.
    v1-secret: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1, v2, or a legacy 2010-04-01 format.
    webhook-api-version: option<create-messaging-profile-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this messaging profile will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this messaging profile will be sent.
    webhook-url: option<string>,
    /// Destinations to which the messaging profile is allowed to send. If set to `null`, all destinations will be allowed. Setting a value of `["*"]` has the equivalent effect. The elements in the list must be valid ISO 3166-1 alpha-2 country codes.
    whitelisted-destinations: option<list<string>>
  }
  update-messaging-profile: func(params: update-messaging-profile-params) -> result<string, string>;

  /// Delete a messaging profile
  record delete-messaging-profile-params {
    /// The id of the messaging profile to retrieve
    id: string
  }
  delete-messaging-profile: func(params: delete-messaging-profile-params) -> result<string, string>;

  /// Retrieve messaging profile metrics
  record retrieve-messaging-profile-detailed-metrics-params {
    /// The id of the messaging profile to retrieve
    id: string,
    /// The timeframe for which you'd like to retrieve metrics.
    time-frame: option<list-messaging-profile-metrics-time-frame-enum>
  }
  retrieve-messaging-profile-detailed-metrics: func(params: retrieve-messaging-profile-detailed-metrics-params) -> result<string, string>;

  /// List phone numbers associated with a messaging profile
  record list-messaging-profile-phone-numbers-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// The id of the messaging profile to retrieve
    id: string
  }
  list-messaging-profile-phone-numbers: func(params: list-messaging-profile-phone-numbers-params) -> result<string, string>;

  /// List short codes associated with a messaging profile
  record list-messaging-profile-short-codes-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// The id of the messaging profile to retrieve
    id: string
  }
  list-messaging-profile-short-codes: func(params: list-messaging-profile-short-codes-params) -> result<string, string>;

}

