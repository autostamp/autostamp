interface wdr-detail-reports {
  enum wireless-cost-currency-enum {
    aud,
    cad,
    eur,
    gbp,
    usd,
  }

  enum downlink-data-unit-enum {
    b,
    kb,
    mb,
  }

  record external-wdr-get-detail-response {
    data: option<list<external-wdr-detail-record-dto>>,
    meta: option<pagination-meta>
  }

  record external-wdr-detail-record-dto {
    cost: option<wireless-cost>,
    /// Record created time
    created-at: option<string>,
    downlink-data: option<downlink-data>,
    /// Session duration in seconds.
    duration-seconds: option<f64>,
    /// WDR id
    id: option<string>,
    /// International mobile subscriber identity
    imsi: option<string>,
    /// Mobile country code.
    mcc: option<string>,
    /// Mobile network code.
    mnc: option<string>,
    /// Phone number
    phone-number: option<string>,
    rate: option<wireless-rate>,
    record-type: option<string>,
    /// Sim card unique identifier
    sim-card-id: option<string>,
    /// Sim group unique identifier
    sim-group-id: option<string>,
    /// Defined sim group name
    sim-group-name: option<string>,
    uplink-data: option<uplink-data>
  }

  record wireless-cost {
    /// Final cost. Cost is calculated as rate * unit
    amount: option<string>,
    /// Currency of the rate and cost
    currency: option<wireless-cost-currency-enum>
  }

  record downlink-data {
    /// Downlink data
    amount: option<f64>,
    /// Transmission unit
    unit: option<downlink-data-unit-enum>
  }

  record wireless-rate {
    /// Rate from which cost is calculated
    amount: option<string>,
    /// Currency of the rate and cost
    currency: option<wireless-cost-currency-enum>
  }

  record uplink-data {
    /// Uplink data
    amount: option<f64>,
    /// Transmission unit
    unit: option<downlink-data-unit-enum>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record get-paginated-wdrs-params {
    /// Start date
    start-date: option<string>,
    /// End date
    end-date: option<string>,
    id: option<string>,
    mcc: option<string>,
    mnc: option<string>,
    imsi: option<string>,
    sim-group-name: option<string>,
    sim-group-id: option<string>,
    sim-card-id: option<string>,
    phone-number: option<string>,
    /// Page number
    page-number: option<s32>,
    /// Size of the page
    page-size: option<s32>,
    sort: option<list<string>>
  }
  get-paginated-wdrs: func(params: get-paginated-wdrs-params) -> result<external-wdr-get-detail-response, string>;

}

interface requirement-types {
