    /// The id of the file to associate as a number order document.
    file-id: option<string>,
    id: option<string>,
    record-type: option<string>,
    requirement-type: option<number-order-document-requirement-type-enum>,
    /// Unique id for a requirement.
    requirements-id: option<string>
  }
  create-number-order-document: func(params: create-number-order-document-params) -> result<create-number-order-document-response, string>;

  /// Retrieve a number order document
  record retrieve-number-order-document-params {
    /// The number order document ID.
    number-order-document-id: string
  }
  retrieve-number-order-document: func(params: retrieve-number-order-document-params) -> result<retrieve-number-order-document-response, string>;

  /// Update a number order document
  record update-number-order-document-params {
    /// The number order document ID.
    number-order-document-id: string,
    /// An ISO 8901 datetime string denoting when the number order document was uploaded.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    /// The id of the file to associate as a number order document.
    file-id: option<string>,
    id: option<string>,
    record-type: option<string>,
    requirement-type: option<number-order-document-requirement-type-enum>,
    /// Unique id for a requirement.
    requirements-id: option<string>
  }
  update-number-order-document: func(params: update-number-order-document-params) -> result<update-number-order-document-response, string>;

}

interface number-reservations {
  enum reserved-phone-number-status-enum {
    pending,
    success,
    failure,
  }

  record list-number-reservations-response {
    data: option<list<number-reservation>>,
    meta: option<pagination-meta>
  }

  record number-reservation {
    /// An ISO 8901 datetime string denoting when the numbers reservation was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    id: option<string>,
    phone-numbers: option<list<reserved-phone-number>>,
    record-type: option<string>,
    /// The status of the entire reservation.
    status: option<reserved-phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the number reservation was updated.
    updated-at: option<string>
  }

  record reserved-phone-number {
    /// An ISO 8901 datetime string denoting when the individual number reservation was created.
    created-at: option<string>,
    /// An ISO 8901 datetime string for when the individual number reservation is going to expire
    expired-at: option<string>,
    id: option<string>,
    phone-number: option<string>,
    record-type: option<string>,
    /// The status of the phone number's reservation.
    status: option<reserved-phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the the individual number reservation was updated.
    updated-at: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-number-reservation-response {
    data: option<number-reservation>
  }

  record retrieve-number-reservation-response {
    data: option<number-reservation>
  }

  record extend-number-reservation-expiry-time-response {
    data: option<number-reservation>
  }

  /// List number reservations
  record list-number-reservations-params {
    /// Filter number reservations by status.
    filter-status: option<string>,
    /// Filter number reservations later than this value.
    filter-created-at-gt: option<string>,
    /// Filter number reservations earlier than this value.
    filter-created-at-lt: option<string>,
    /// Filter number reservations having these phone numbers.
    filter-phone-numbers-phone-number: option<string>,
    /// Filter number reservations via the customer reference set.
    filter-customer-reference: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-number-reservations: func(params: list-number-reservations-params) -> result<list-number-reservations-response, string>;

  /// Create a number reservation
  record create-number-reservation-params {
    /// An ISO 8901 datetime string denoting when the numbers reservation was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    id: option<string>,
    phone-numbers: option<list<reserved-phone-number>>,
    record-type: option<string>,
    /// The status of the entire reservation.
    status: option<reserved-phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the number reservation was updated.
    updated-at: option<string>
  }
  create-number-reservation: func(params: create-number-reservation-params) -> result<create-number-reservation-response, string>;

  /// Retrieve a number reservation
  record retrieve-number-reservation-params {
    /// The number reservation ID.
    number-reservation-id: string
  }
  retrieve-number-reservation: func(params: retrieve-number-reservation-params) -> result<retrieve-number-reservation-response, string>;

  /// Extend a number reservation
  record extend-number-reservation-expiry-time-params {
    /// The number reservation ID.
    number-reservation-id: string
  }
  extend-number-reservation-expiry-time: func(params: extend-number-reservation-expiry-time-params) -> result<extend-number-reservation-expiry-time-response, string>;

}

interface ota-updates {
  enum list-op-filter-status-enum {
    in-progress,
    completed,
    failed,
  }

  enum list-op-filter-type-enum {
    sim-card-network-preferences,
  }

  record list-op-response {
    data: option<list<simplified-ota-update>>,
    meta: option<pagination-meta>
  }

  /// This object represents an Over the Air (OTA) update request. It allows tracking the current status of a operation that apply settings in a particular SIM card. <br/><br/>
  record simplified-ota-update {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    record-type: option<string>,
    /// The identification UUID of the related SIM card resource.
    sim-card-id: option<string>,
    status: option<list-op-filter-status-enum>,
    /// Represents the type of the operation requested. This will relate directly to the source of the request.
    type-op: option<list-op-filter-type-enum>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record ota-update-get-response {
    data: option<complete-ota-update>
  }

  /// This object represents an Over the Air (OTA) update request. It allows tracking the current status of a operation that apply settings in a particular SIM card. <br/><br/>
  record complete-ota-update {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    record-type: option<string>,
    /// A JSON object representation of the operation. The information present here will relate directly to the source of the OTA request.
    settings: option<complete-ota-update-settings>,
    /// The identification UUID of the related SIM card resource.
    sim-card-id: option<string>,
    status: option<list-op-filter-status-enum>,
    /// Represents the type of the operation requested. This will relate directly to the source of the request.
    type-op: option<list-op-filter-type-enum>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  /// A JSON object representation of the operation. The information present here will relate directly to the source of the OTA request.
  record complete-ota-update-settings {
    mobile-operator-networks-preferences: option<mobile-operator-networks-preferences-response>
  }

  /// A list of mobile operator networks and the priority that should be applied when the SIM is connecting to the network.
  record mobile-operator-networks-preferences-response {
    /// opaque schema; raw JSON
    value: string
  }

  /// List OTA updates
  record list-op-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter by a specific status of the resource's lifecycle.
    filter-status: option<list-op-filter-status-enum>,
    /// The SIM card identification UUID.
    filter-sim-card-id: option<string>,
    /// Filter by type.
    filter-type: option<list-op-filter-type-enum>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Get OTA update
  record ota-update-get-params {
    /// Identifies the resource.
    id: string
  }
  ota-update-get: func(params: ota-update-get-params) -> result<ota-update-get-response, string>;

}

interface outbound-voice-profiles {
  enum list-outbound-voice-profiles-sort-enum {
    enabled,
    enabled-v2,
    created-at,
    created-at-v2,
    name,
    name-v2,
    service-plan,
    service-plan-v2,
    traffic-type,
    traffic-type-v2,
    usage-payment-method,
    usage-payment-method-v2,
  }

  enum outbound-call-recording-call-recording-channels-enum {
    single,
    dual,
  }

  enum outbound-call-recording-call-recording-format-enum {
    wav,
    mp3,
  }

  enum outbound-call-recording-call-recording-type-enum {
    all,
    none,
    by-caller-phone-number,
  }

  record list-outbound-voice-profiles-response {
    data: option<list<outbound-voice-profile>>,
    meta: option<pagination-meta>
  }

  record outbound-voice-profile {
    /// The ID of the billing group associated with the outbound proflile. Defaults to null (for no group assigned).
    billing-group-id: option<string>,
    call-recording: option<outbound-call-recording>,
    /// Must be no more than your global concurrent call limit. Null means no limit.
    concurrent-call-limit: option<s32>,
    /// Amount of connections associated with this outbound voice profile.
    connections-count: option<s32>,
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// The maximum amount of usage charges, in USD, you want Telnyx to allow on this outbound voice profile in a day before disallowing new calls.
    daily-spend-limit: option<string>,
    /// Specifies whether to enforce the daily_spend_limit on this outbound voice profile.
    daily-spend-limit-enabled: option<bool>,
    /// Specifies whether the outbound voice profile can be used. Disabled profiles will result in outbound calls being blocked for the associated Connections.
    enabled: option<bool>,
    /// Identifies the resource.
    id: option<string>,
    /// Maximum rate (price per minute) for a Destination to be allowed when making outbound calls.
    max-destination-rate: option<f64>,
    /// A user-supplied name to help with organization.
    name: string,
    /// Identifies the type of the resource.
    record-type: option<string>,
    service-plan: option<service-plan>,
    tags: option<list<string>>,
    traffic-type: option<traffic-type>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>,
    usage-payment-method: option<usage-payment-method>,
    /// The list of destinations you want to be able to call using this outbound voice profile formatted in alpha2.
    whitelisted-destinations: option<list<string>>
  }

  record outbound-call-recording {
    /// When call_recording_type is 'by_caller_phone_number', only outbound calls using one of these numbers will be recorded. Numbers must be specified in E164 format.
    call-recording-caller-phone-numbers: option<list<string>>,
    /// When using 'dual' channels, the final audio file will be a stereo recording with the first leg on channel A, and the rest on channel B.
    call-recording-channels: option<outbound-call-recording-call-recording-channels-enum>,
    /// The audio file format for calls being recorded.
    call-recording-format: option<outbound-call-recording-call-recording-format-enum>,
    /// Specifies which calls are recorded.
    call-recording-type: option<outbound-call-recording-call-recording-type-enum>
  }

  /// Indicates the coverage of the termination regions. International and Global are the same but International may only be used for high volume/short duration Outbound Voice Profiles.
  record service-plan {
    /// opaque schema; raw JSON
    value: string
  }

  /// Specifies the type of traffic allowed in this profile.
  record traffic-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Setting for how costs for outbound profile are calculated.
  record usage-payment-method {
    /// opaque schema; raw JSON
    value: string
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-outbound-voice-profile-response {
    data: option<outbound-voice-profile>
  }

  record retrieve-outbound-voice-profile-response {
    data: option<outbound-voice-profile>
  }

  record update-outbound-voice-profile-response {
    data: option<outbound-voice-profile>
  }

  record delete-outbound-voice-profile-response {
    data: option<outbound-voice-profile>
  }

  variant list-outbound-voice-profiles-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-outbound-voice-profile-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant retrieve-outbound-voice-profile-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-outbound-voice-profile-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-outbound-voice-profile-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// Get all outbound voice profiles
  record list-outbound-voice-profiles-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Optional filter on outbound voice profile name.
    filter-name-contains: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code>-</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-outbound-voice-profiles-sort-enum>
  }
  list-outbound-voice-profiles: func(params: list-outbound-voice-profiles-params) -> result<list-outbound-voice-profiles-response, list-outbound-voice-profiles-error>;

  /// Create an outbound voice profile
  record create-outbound-voice-profile-params {
    /// The ID of the billing group associated with the outbound proflile. Defaults to null (for no group assigned).
    billing-group-id: option<string>,
    call-recording: option<outbound-call-recording>,
    /// Must be no more than your global concurrent call limit. Null means no limit.
    concurrent-call-limit: option<s32>,
    /// The maximum amount of usage charges, in USD, you want Telnyx to allow on this outbound voice profile in a day before disallowing new calls.
    daily-spend-limit: option<string>,
    /// Specifies whether to enforce the daily_spend_limit on this outbound voice profile.
    daily-spend-limit-enabled: option<bool>,
    /// Specifies whether the outbound voice profile can be used. Disabled profiles will result in outbound calls being blocked for the associated Connections.
    enabled: option<bool>,
    /// Maximum rate (price per minute) for a Destination to be allowed when making outbound calls.
    max-destination-rate: option<f64>,
    /// A user-supplied name to help with organization.
    name: string,
    service-plan: option<service-plan>,
    tags: option<list<string>>,
    traffic-type: option<traffic-type>,
    usage-payment-method: option<usage-payment-method>,
    /// The list of destinations you want to be able to call using this outbound voice profile formatted in alpha2.
    whitelisted-destinations: option<list<string>>
  }
  create-outbound-voice-profile: func(params: create-outbound-voice-profile-params) -> result<create-outbound-voice-profile-response, create-outbound-voice-profile-error>;

  /// Retrieve an outbound voice profile
  record retrieve-outbound-voice-profile-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-outbound-voice-profile: func(params: retrieve-outbound-voice-profile-params) -> result<retrieve-outbound-voice-profile-response, retrieve-outbound-voice-profile-error>;

  /// Updates an existing outbound voice profile.
  record update-outbound-voice-profile-params {
    /// Identifies the resource.
    id: string,
    /// The ID of the billing group associated with the outbound proflile. Defaults to null (for no group assigned).
    billing-group-id: option<string>,
    call-recording: option<outbound-call-recording>,
    /// Must be no more than your global concurrent call limit. Null means no limit.
    concurrent-call-limit: option<s32>,
    /// The maximum amount of usage charges, in USD, you want Telnyx to allow on this outbound voice profile in a day before disallowing new calls.
    daily-spend-limit: option<string>,
    /// Specifies whether to enforce the daily_spend_limit on this outbound voice profile.
    daily-spend-limit-enabled: option<bool>,
    /// Specifies whether the outbound voice profile can be used. Disabled profiles will result in outbound calls being blocked for the associated Connections.
    enabled: option<bool>,
    /// Maximum rate (price per minute) for a Destination to be allowed when making outbound calls.
    max-destination-rate: option<f64>,
    /// A user-supplied name to help with organization.
    name: string,
    service-plan: option<service-plan>,
    tags: option<list<string>>,
    traffic-type: option<traffic-type>,
    usage-payment-method: option<usage-payment-method>,
    /// The list of destinations you want to be able to call using this outbound voice profile formatted in alpha2.
    whitelisted-destinations: option<list<string>>
  }
  update-outbound-voice-profile: func(params: update-outbound-voice-profile-params) -> result<update-outbound-voice-profile-response, update-outbound-voice-profile-error>;

  /// Delete an outbound voice profile
  record delete-outbound-voice-profile-params {
    /// Identifies the resource.
    id: string
  }
  delete-outbound-voice-profile: func(params: delete-outbound-voice-profile-params) -> result<delete-outbound-voice-profile-response, delete-outbound-voice-profile-error>;

}

interface number-blocks-background-jobs {
  enum list-phone-number-blocks-jobs-filter-type-enum {
    delete-phone-number-block,
  }

  enum list-phone-number-blocks-jobs-filter-status-enum {
    pending,
    in-progress,
    completed,
    failed,
  }

  enum list-phone-number-blocks-jobs-sort-enum {
    created-at,
  }

  record list-phone-number-blocks-jobs-response {
    data: option<list<phone-number-blocks-job>>,
    meta: option<pagination-meta>
  }

  record phone-number-blocks-job {
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// ISO 8601 formatted date indicating when the estimated time of completion of the background job.
    etc: option<string>,
    failed-operations: option<list<phone-number-blocks-job-failed-operation>>,
    /// Identifies the resource.
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Indicates the completion status of the background operation.
    status: option<list-phone-number-blocks-jobs-filter-status-enum>,
    successful-operations: option<list<phone-number-blocks-job-successful-operation>>,
    /// Identifies the type of the background job.
    type-op: option<list-phone-number-blocks-jobs-filter-type-enum>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record phone-number-blocks-job-failed-operation {
    errors: option<list<error>>,
    /// The phone number's ID
    id: option<string>,
    /// The phone number in e164 format.
    phone-number: option<string>
  }

  record error {
    code: string,
    detail: option<string>,
    meta: option<error-meta>,
    source: option<error-source>,
    title: string
  }

  record error-meta {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record error-source {
    /// Indicates which query parameter caused the error.
    parameter: option<string>,
    /// JSON pointer (RFC6901) to the offending entity.
    pointer: option<string>
  }

  record phone-number-blocks-job-successful-operation {
    /// The phone number's ID
    id: option<string>,
    /// The phone number in e164 format.
    phone-number: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-phone-number-blocks-job-delete-phone-number-block-response {
    data: option<phone-number-blocks-job>
  }

  record retrieve-phone-number-blocks-job-response {
    data: option<phone-number-blocks-job>
  }

  /// Lists the phone number blocks jobs
  record list-phone-number-blocks-jobs-params {
    /// Filter the phone number blocks jobs by type.
    filter-type: option<list-phone-number-blocks-jobs-filter-type-enum>,
    /// Filter the phone number blocks jobs by status.
    filter-status: option<list-phone-number-blocks-jobs-filter-status-enum>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Specifies the sort order for results. If not given, results are sorted by created_at in descending order.
    sort: option<list-phone-number-blocks-jobs-sort-enum>
  }
  list-phone-number-blocks-jobs: func(params: list-phone-number-blocks-jobs-params) -> result<list-phone-number-blocks-jobs-response, string>;

  /// Deletes all numbers associated with a phone number block
  record create-phone-number-blocks-job-delete-phone-number-block-params {
    phone-number-block-id: string
  }
  create-phone-number-blocks-job-delete-phone-number-block: func(params: create-phone-number-blocks-job-delete-phone-number-block-params) -> result<create-phone-number-blocks-job-delete-phone-number-block-response, string>;

  /// Retrieves a phone number blocks job
  record retrieve-phone-number-blocks-job-params {
    /// Identifies the Phone Number Blocks Job.
    id: string
  }
  retrieve-phone-number-blocks-job: func(params: retrieve-phone-number-blocks-job-params) -> result<retrieve-phone-number-blocks-job-response, string>;

}

interface number-configurations {
  enum list-phone-numbers-filter-status-enum {
    purchase-pending,
    purchase-failed,
    port-pending,
    active,
    deleted,
    port-failed,
    emergency-only,
    ported-out,
    port-out-pending,
  }

  enum list-phone-numbers-filter-usage-payment-method-enum {
    pay-per-minute,
    channel,
  }

  enum list-phone-numbers-sort-enum {
    purchased-at,
    phone-number,
    connection-name,
    usage-payment-method,
  }

  enum phone-number-detailed-number-level-routing-enum {
    enabled,
    disabled,
  }

  enum phone-number-detailed-phone-number-type-enum {
    longcode,
    tollfree,
  }

  enum phone-number-detailed-status-enum {
    purchase-pending,
    purchase-failed,
    port-pending,
    port-failed,
    active,
    deleted,
    emergency-only,
    ported-out,
    port-out-pending,
  }

  enum phone-number-with-messaging-settings-record-type-enum {
    messaging-phone-number,
    messaging-settings,
  }

  enum phone-number-with-messaging-settings-type-op-enum {
    long-code,
    toll-free,
    short-code,
    longcode,
    tollfree,
    shortcode,
  }

  enum call-forwarding-forwarding-type-enum {
    always,
    on-failure,
  }

  enum call-recording-inbound-call-recording-channels-enum {
    single,
    dual,
  }

  enum call-recording-inbound-call-recording-format-enum {
    wav,
    mp3,
  }

  enum emergency-settings-emergency-status-enum {
    disabled,
    active,
    provisioning,
    deprovisioning,
  }

  enum media-features-media-handling-mode-enum {
    default,
    proxy,
  }

  record list-phone-numbers-response {
    data: option<list<phone-number-detailed>>,
    meta: option<pagination-meta>
  }

  record phone-number-detailed {
    /// Identifies the billing group associated with the phone number.
    billing-group-id: option<string>,
    /// Indicates if call forwarding will be enabled for this number if forwards_to and forwarding_type are filled in. Defaults to true for backwards compatibility with APIV1 use of numbers endpoints.
    call-forwarding-enabled: option<bool>,
    /// Indicates whether call recording is enabled for this number.
    call-recording-enabled: option<bool>,
    /// Indicates whether caller ID is enabled for this number.
    caller-id-name-enabled: option<bool>,
    /// Indicates whether a CNAM listing is enabled for this number.
    cnam-listing-enabled: option<bool>,
    /// Identifies the connection associated with the phone number.
    connection-id: option<string>,
    /// The user-assigned name of the connection to be associated with this phone number.
    connection-name: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    /// Identifies the emergency address associated with the phone number.
    emergency-address-id: option<string>,
    /// Indicates whether emergency services are enabled for this number.
    emergency-enabled: option<bool>,
    /// If someone attempts to port your phone number away from Telnyx and your phone number has an external PIN set, Telnyx will attempt to verify that you provided the correct external PIN to the winning carrier. Note that not all carriers cooperate with this security mechanism.
    external-pin: option<string>,
    id: option<int-id>,
    /// Identifies the messaging profile associated with the phone number.
    messaging-profile-id: option<string>,
    /// The name of the messaging profile associated with the phone number.
    messaging-profile-name: option<string>,
    /// Specifies whether the number can have overrides to the routing settings on itself (enabled) or if it uses the associated connection for all routing settings (disabled). Defaults to enabled but will be changed to disabled in the future. There are performance advantages to using disabled and setting all routing information at the connection level.
    number-level-routing: option<phone-number-detailed-number-level-routing-enum>,
    /// The +E.164-formatted phone number associated with this record.
    phone-number: option<string>,
    /// The phone number's type.
    phone-number-type: option<phone-number-detailed-phone-number-type-enum>,
    /// ISO 8601 formatted date indicating when the resource was purchased.
    purchased-at: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// The phone number's current status.
    status: option<phone-number-detailed-status-enum>,
    /// Indicates whether T38 Fax Gateway for inbound calls to this number.
    t38-fax-gateway-enabled: option<bool>,
    /// A list of user-assigned tags to help manage the phone number.
    tags: option<list<string>>
  }

  /// Uniquely identifies the resource.
  record int-id {
    /// opaque schema; raw JSON
    value: string
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record list-phone-numbers-with-messaging-settings-response {
    data: option<list<phone-number-with-messaging-settings>>,
    meta: option<pagination-meta>
  }

  record phone-number-with-messaging-settings {
    /// ISO 3166-1 alpha-2 country code.
    country-code: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// The messaging products that this number can be registered to use
    eligible-messaging-products: option<list<string>>,
    features: option<phone-number-with-messaging-settings-features>,
    health: option<number-health-metrics>,
    /// Identifies the type of resource.
    id: option<string>,
    /// The messaging product that the number is registered to use
    messaging-product: option<string>,
    /// Unique identifier for a messaging profile.
    messaging-profile-id: option<string>,
    /// +E.164 formatted phone number.
    phone-number: option<string>,
    /// Identifies the type of the resource.
    record-type: option<phone-number-with-messaging-settings-record-type-enum>,
    /// The messaging traffic or use case for which the number is currently configured.
    traffic-type: option<string>,
    /// The type of the phone number
    type-op: option<phone-number-with-messaging-settings-type-op-enum>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record phone-number-with-messaging-settings-features {
    mms: option<messaging-feature-set>,
    sms: option<messaging-feature-set>
  }

  /// The set of features available for a specific messaging use case (SMS or MMS). Features
  /// can vary depending on the characteristics the phone number, as well as its current
  /// product configuration.
  record messaging-feature-set {
    /// Send messages to and receive messages from numbers in the same country.
    domestic-two-way: bool,
    /// Receive messages from numbers in other countries.
    international-inbound: bool,
    /// Send messages to numbers in other countries.
    international-outbound: bool
  }

  /// High level health metrics about the number and it's messaging sending patterns.
  record number-health-metrics {
    /// The ratio of messages received to the number of messages sent.
    inbound-outbound-ratio: f64,
    /// The number of messages analyzed for the health metrics.
    message-count: s32,
    /// The ratio of messages blocked for spam to the number of messages attempted.
    spam-ratio: f64,
    /// The ratio of messages sucessfully delivered to the number of messages attempted.
    success-ratio: f64
  }

  record list-phone-numbers-with-voice-settings-response {
    data: option<list<phone-number-with-voice-settings>>,
    meta: option<pagination-meta>
  }

  record phone-number-with-voice-settings {
    call-forwarding: option<call-forwarding>,
    call-recording: option<call-recording>,
    cnam-listing: option<cnam-listing>,
    /// Identifies the connection associated with this phone number.
    connection-id: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    emergency: option<emergency-settings>,
    /// Identifies the type of resource.
    id: option<string>,
    media-features: option<media-features>,
    /// The phone number in +E164 format.
    phone-number: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Controls whether a tech prefix is enabled for this phone number.
    tech-prefix-enabled: option<bool>,
    /// This field allows you to rewrite the destination number of an inbound call before the call is routed to you. The value of this field may be any alphanumeric value, and the value will replace the number originally dialed.
    translated-number: option<string>,
    /// Controls whether a number is billed per minute or uses your concurrent channels.
    usage-payment-method: option<list-phone-numbers-filter-usage-payment-method-enum>
  }

  /// The call forwarding settings for a phone number.
  record call-forwarding {
    /// Indicates if call forwarding will be enabled for this number if forwards_to and forwarding_type are filled in. Defaults to true for backwards compatibility with APIV1 use of numbers endpoints.
    call-forwarding-enabled: option<bool>,
    /// Call forwarding type. 'forwards_to' must be set for this to have an effect.
    forwarding-type: option<call-forwarding-forwarding-type-enum>,
    /// The phone number to which inbound calls to this number are forwarded. Inbound calls will not be forwarded if this field is left blank. If set, must be a +E.164-formatted phone number.
    forwards-to: option<string>
  }

  /// The call recording settings for a phone number.
  record call-recording {
    /// When using 'dual' channels, final audio file will be stereo recorded with the first leg on channel A, and the rest on channel B.
    inbound-call-recording-channels: option<call-recording-inbound-call-recording-channels-enum>,
    /// When enabled, any inbound call to this number will be recorded.
    inbound-call-recording-enabled: option<bool>,
    /// The audio file format for calls being recorded.
    inbound-call-recording-format: option<call-recording-inbound-call-recording-format-enum>
  }

  /// The CNAM listing settings for a phone number.
  record cnam-listing {
    /// The CNAM listing details for this number. Must be alphanumeric characters or spaces with a maximum length of 15. Requires cnam_listing_enabled to also be set to true.
    cnam-listing-details: option<string>,
    /// Enables CNAM listings for this number. Requires cnam_listing_details to also be set.
    cnam-listing-enabled: option<bool>
  }

  /// The emergency services settings for a phone number.
  record emergency-settings {
    /// Identifies the address to be used with emergency services.
    emergency-address-id: option<string>,
    /// Allows you to enable or disable emergency services on the phone number. In order to enable emergency services, you must also set an emergency_address_id.
    emergency-enabled: option<bool>,
    /// Represents the state of the number regarding emergency activation.
    emergency-status: option<emergency-settings-emergency-status-enum>
  }

  /// The media features settings for a phone number.
  record media-features {
    /// When enabled, Telnyx will accept RTP packets from any customer-side IP address and port, not just those to which Telnyx is sending RTP.
    accept-any-rtp-packets-enabled: option<bool>,
    /// Controls how media is handled for the phone number. default: media routed through Telnyx with transcode support. proxy: media routed through Telnyx with no transcode support.
    media-handling-mode: option<media-features-media-handling-mode-enum>,
    /// When RTP Auto-Adjust is enabled, the destination RTP address port will be automatically changed to match the source of the incoming RTP packets.
    rtp-auto-adjust-enabled: option<bool>,
    /// Controls whether Telnyx will accept a T.38 re-INVITE for this phone number. Note that Telnyx will not send a T.38 re-INVITE; this option only controls whether one will be accepted.
    t38-fax-gateway-enabled: option<bool>
  }

  record retrieve-phone-number-response {
    data: option<phone-number-detailed>
  }

  record update-phone-number-response {
    data: option<phone-number-detailed>
  }

  record delete-phone-number-response {
    data: option<phone-number-deleted-detailed>
  }

  record phone-number-deleted-detailed {
    /// Identifies the billing group associated with the phone number.
    billing-group-id: option<string>,
    /// Indicates if call forwarding will be enabled for this number if forwards_to and forwarding_type are filled in. Defaults to true for backwards compatibility with APIV1 use of numbers endpoints.
    call-forwarding-enabled: option<bool>,
    /// Indicates whether call recording is enabled for this number.
    call-recording-enabled: option<bool>,
    /// Indicates whether caller ID is enabled for this number.
    caller-id-name-enabled: option<bool>,
    /// Indicates whether a CNAM listing is enabled for this number.
    cnam-listing-enabled: option<bool>,
    /// Identifies the connection associated with the phone number.
    connection-id: option<string>,
    /// The user-assigned name of the connection to be associated with this phone number.
    connection-name: option<string>,
    /// ISO 8601 formatted date indicating when the time it took to activate after the purchase.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    /// Identifies the emergency address associated with the phone number.
    emergency-address-id: option<string>,
    /// Indicates whether emergency services are enabled for this number.
    emergency-enabled: option<bool>,
    /// If someone attempts to port your phone number away from Telnyx and your phone number has an external PIN set, Telnyx will attempt to verify that you provided the correct external PIN to the winning carrier. Note that not all carriers cooperate with this security mechanism.
    external-pin: option<string>,
    id: option<int-id>,
    /// Identifies the messaging profile associated with the phone number.
    messaging-profile-id: option<string>,
    /// The name of the messaging profile associated with the phone number.
    messaging-profile-name: option<string>,
    /// Specifies whether the number can have overrides to the routing settings on itself (enabled) or if it uses the associated connection for all routing settings (disabled). Defaults to enabled but will be changed to disabled in the future. There are performance advantages to using disabled and setting all routing information at the connection level.
    number-level-routing: option<phone-number-detailed-number-level-routing-enum>,
    /// The +E.164-formatted phone number associated with this record.
    phone-number: option<string>,
    /// The phone number's type.
    phone-number-type: option<phone-number-detailed-phone-number-type-enum>,
    /// ISO 8601 formatted date indicating the time the request was made to purchase the number.
    purchased-at: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// The phone number's current status.
    status: option<phone-number-detailed-status-enum>,
    /// Indicates whether T38 Fax Gateway for inbound calls to this number.
    t38-fax-gateway-enabled: option<bool>,
    /// A list of user-assigned tags to help manage the phone number.
    tags: option<list<string>>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record enable-emergency-phone-number-response {
    data: option<phone-number-with-voice-settings>
  }

  record retrieve-phone-number-with-messaging-settings-response {
    data: option<phone-number-with-messaging-settings>
  }

  record update-phone-number-with-messaging-settings-response {
    data: option<phone-number-with-messaging-settings>
  }

  record retrieve-phone-number-with-voice-settings-response {
    data: option<phone-number-with-voice-settings>
  }

  record update-phone-number-with-voice-settings-response {
    data: option<phone-number-with-voice-settings>
  }

  /// List phone numbers
  record list-phone-numbers-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter by phone number tags.
    filter-tag: option<string>,
    /// Filter by phone number. Requires at least three digits.
    ///              Non-numerical characters will result in no values being returned.
    filter-phone-number: option<string>,
    /// Filter by phone number status.
    filter-status: option<list-phone-numbers-filter-status-enum>,
    /// Filter contains connection name. Requires at least three characters.
    filter-voice-connection-name-contains: option<string>,
    /// Filter starts with connection name. Requires at least three characters.
    filter-voice-connection-name-starts-with: option<string>,
    /// Filter ends with connection name. Requires at least three characters.
    filter-voice-connection-name-ends-with: option<string>,
    /// Filter by connection name.
    filter-voice-connection-name-eq: option<string>,
    /// Filter by usage_payment_method.
    filter-usage-payment-method: option<list-phone-numbers-filter-usage-payment-method-enum>,
    /// Filter by the billing_group_id associated with phone numbers. To filter to only phone numbers that have no billing group associated them, set the value of this filter to the string 'null'.
    filter-billing-group-id: option<string>,
    /// Filter by the emergency_address_id associated with phone numbers. To filter only phone numbers that have no emergency address associated with them, set the value of this filter to the string 'null'.
    filter-emergency-address-id: option<string>,
    /// Filter numbers via the customer_reference set.
    filter-customer-reference: option<string>,
    /// Specifies the sort order for results. If not given, results are sorted by created_at in descending order.
    sort: option<list-phone-numbers-sort-enum>
  }
  list-phone-numbers: func(params: list-phone-numbers-params) -> result<list-phone-numbers-response, string>;

  /// List phone numbers with messaging settings
  record list-phone-numbers-with-messaging-settings-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-phone-numbers-with-messaging-settings: func(params: list-phone-numbers-with-messaging-settings-params) -> result<list-phone-numbers-with-messaging-settings-response, string>;

  /// List phone numbers with voice settings
  record list-phone-numbers-with-voice-settings-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter by phone number. Requires at least three digits.
    ///              Non-numerical characters will result in no values being returned.
    filter-phone-number: option<string>,
    /// Filter contains connection name. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Filter numbers via the customer_reference set.
    filter-customer-reference: option<string>,
    /// Filter by usage_payment_method.
    filter-usage-payment-method: option<list-phone-numbers-filter-usage-payment-method-enum>,
    /// Specifies the sort order for results. If not given, results are sorted by created_at in descending order.
    sort: option<list-phone-numbers-sort-enum>
  }
  list-phone-numbers-with-voice-settings: func(params: list-phone-numbers-with-voice-settings-params) -> result<list-phone-numbers-with-voice-settings-response, string>;

  /// Retrieve a phone number
  record retrieve-phone-number-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-phone-number: func(params: retrieve-phone-number-params) -> result<retrieve-phone-number-response, string>;

  /// Update a phone number
  record update-phone-number-params {
    /// Identifies the resource.
    id: string,
    /// Identifies the billing group associated with the phone number.
    billing-group-id: option<string>,
    /// Identifies the connection associated with the phone number.
    connection-id: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    /// If someone attempts to port your phone number away from Telnyx and your phone number has an external PIN set, we will attempt to verify that you provided the correct external PIN to the winning carrier. Note that not all carriers cooperate with this security mechanism.
    external-pin: option<string>,
    /// Identifies the type of resource.
    id-v2: option<string>,
    /// Specifies whether the number can have overrides to the routing settings on itself (enabled) or if it uses the associated connection for all routing settings (disabled). Defaults to enabled but will be changed to disabled in the future. There are performance advantages to using disabled and setting all routing information at the connection level.
    number-level-routing: option<phone-number-detailed-number-level-routing-enum>,
    /// A list of user-assigned tags to help organize phone numbers.
    tags: option<list<string>>
  }
  update-phone-number: func(params: update-phone-number-params) -> result<update-phone-number-response, string>;

  /// Delete a phone number
  record delete-phone-number-params {
    /// Identifies the resource.
    id: string
  }
  delete-phone-number: func(params: delete-phone-number-params) -> result<delete-phone-number-response, string>;

  /// Enable emergency for a phone number
  record enable-emergency-phone-number-params {
    /// Identifies the resource.
    id: string,
    /// Identifies the address to be used with emergency services.
    emergency-address-id: string,
    /// Indicates whether to enable emergency services on this number.
    emergency-enabled: bool
  }
  enable-emergency-phone-number: func(params: enable-emergency-phone-number-params) -> result<enable-emergency-phone-number-response, string>;

  /// Retrieve a phone number with messaging settings
  record retrieve-phone-number-with-messaging-settings-params {
    /// Identifies the type of resource.
    id: string
  }
  retrieve-phone-number-with-messaging-settings: func(params: retrieve-phone-number-with-messaging-settings-params) -> result<retrieve-phone-number-with-messaging-settings-response, string>;

  /// Update a phone number with messaging settings
  record update-phone-number-with-messaging-settings-params {
    /// Identifies the type of resource.
    id: string,
    /// The requested messaging product the number should be on
    messaging-product: option<string>,
    /// Unique identifier for a messaging profile.
    messaging-profile-id: option<string>
  }
  update-phone-number-with-messaging-settings: func(params: update-phone-number-with-messaging-settings-params) -> result<update-phone-number-with-messaging-settings-response, string>;

  /// Retrieve a phone number with voice settings
  record retrieve-phone-number-with-voice-settings-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-phone-number-with-voice-settings: func(params: retrieve-phone-number-with-voice-settings-params) -> result<retrieve-phone-number-with-voice-settings-response, string>;

  /// Update a phone number with voice settings
  record update-phone-number-with-voice-settings-params {
    /// Identifies the resource.
    id: string,
    call-forwarding: option<call-forwarding>,
    call-recording: option<call-recording>,
    cnam-listing: option<cnam-listing>,
    media-features: option<media-features>,
    /// Controls whether a tech prefix is enabled for this phone number.
    tech-prefix-enabled: option<bool>,
    /// This field allows you to rewrite the destination number of an inbound call before the call is routed to you. The value of this field may be any alphanumeric value, and the value will replace the number originally dialed.
    translated-number: option<string>,
    /// Controls whether a number is billed per minute or uses your concurrent channels.
    usage-payment-method: option<list-phone-numbers-filter-usage-payment-method-enum>
  }
  update-phone-number-with-voice-settings: func(params: update-phone-number-with-voice-settings-params) -> result<update-phone-number-with-voice-settings-response, string>;

}

interface csv-downloads {
  enum csv-download-status-enum {
    pending,
    complete,
    failed,
    expired,
  }

  record list-csv-downloads-response {
    data: option<list<csv-download>>,
    meta: option<pagination-meta>
  }

  record csv-download {
    /// Identifies the resource.
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Indicates the completion level of the CSV report. Only complete CSV download requests will be able to be retrieved.
    status: option<csv-download-status-enum>,
    /// The URL at which the CSV file can be retrieved.
    url: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-csv-download-response {
    data: option<list<csv-download>>
  }

  record retrieve-csv-download-response {
    data: option<list<csv-download>>
  }

  /// List CSV downloads
  record list-csv-downloads-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-csv-downloads: func(params: list-csv-downloads-params) -> result<list-csv-downloads-response, string>;

  /// Create a CSV download
  create-csv-download: func() -> result<create-csv-download-response, string>;

