    page-size: option<s32>
  }
  list-number-block-orders: func(params: list-number-block-orders-params) -> result<list-number-block-orders-response, string>;

  /// Create a number block order
  record create-number-block-order-params {
    /// Identifies the connection associated with this phone number.
    connection-id: option<string>,
    /// An ISO 8901 datetime string denoting when the number order was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    /// Errors the reservation could happen upon
    errors: option<string>,
    id: option<string>,
    /// Identifies the messaging profile associated with the phone number.
    messaging-profile-id: option<string>,
    /// The count of phone numbers in the number order.
    phone-numbers-count: option<s32>,
    /// The phone number range included in the block.
    range: s32,
    record-type: option<string>,
    /// True if all requirements are met for every phone number, false otherwise.
    requirements-met: option<bool>,
    /// Starting phone number block
    starting-number: string,
    /// The status of the order.
    status: option<number-block-order-status-enum>,
    /// An ISO 8901 datetime string for when the number order was updated.
    updated-at: option<string>
  }
  create-number-block-order: func(params: create-number-block-order-params) -> result<create-number-block-order-response, string>;

  /// Retrieve a number block order
  record retrieve-number-block-order-params {
    /// The number block order ID.
    number-block-order-id: string
  }
  retrieve-number-block-order: func(params: retrieve-number-block-order-params) -> result<retrieve-number-block-order-response, string>;

}

interface number-lookup {
  enum number-lookup-type-op-enum {
    carrier,
    caller-name,
  }

  enum carrier-type-op-enum {
    fixed-line,
    mobile,
    voip,
    fixed-line-or-mobile,
    toll-free,
    premium-rate,
    shared-cost,
    personal-number,
    pager,
    uan,
    voicemail,
    unknown,
  }

  enum portability-ported-status-enum {
    y,
    n,
    empty,
  }

  record number-lookup-response {
    data: option<record-op>
  }

  record record-op {
    caller-name: option<caller-name>,
    carrier: option<carrier>,
    /// Region code that matches the specific country calling code
    country-code: option<string>,
    /// Unused
    fraud: option<string>,
    /// Hyphen-separated national number, preceded by the national destination code (NDC), with a 0 prefix, if an NDC is found
    national-format: option<string>,
    /// E164-formatted phone number
    phone-number: option<string>,
    portability: option<portability>,
    /// Identifies the type of record
    record-type: option<string>
  }

  record caller-name {
    /// The name of the requested phone number's owner as per the CNAM database
    caller-name: option<string>,
    /// A caller-name lookup specific error code, expressed as a stringified 5-digit integer
    error-code: option<string>
  }

  record carrier {
    /// Unused
    error-code: option<string>,
    /// Region code that matches the specific country calling code if the requested phone number type is mobile
    mobile-country-code: option<string>,
    /// National destination code (NDC), with a 0 prefix, if an NDC is found and the requested phone number type is mobile
    mobile-network-code: option<string>,
    /// SPID (Service Provider ID) name, if the requested phone number has been ported; otherwise, the name of carrier who owns the phone number block
    name: option<string>,
    /// A phone number type that identifies the type of service associated with the requested phone number
    type-op: option<carrier-type-op-enum>
  }

  record portability {
    /// Alternative SPID (Service Provider ID). Often used when a carrier is using a number from another carrier
    altspid: option<string>,
    /// Alternative service provider name
    altspid-carrier-name: option<string>,
    /// Alternative service provider type
    altspid-carrier-type: option<string>,
    /// City name extracted from the locality in the Local Exchange Routing Guide (LERG) database
    city: option<string>,
    /// Type of number
    line-type: option<string>,
    /// Local Routing Number, if assigned to the requested phone number
    lrn: option<string>,
    /// Operating Company Name (OCN) as per the Local Exchange Routing Guide (LERG) database
    ocn: option<string>,
    /// ISO-formatted date when the requested phone number has been ported
    ported-date: option<string>,
    /// Indicates whether or not the requested phone number has been ported
    ported-status: option<portability-ported-status-enum>,
    /// SPID (Service Provider ID)
    spid: option<string>,
    /// Service provider name
    spid-carrier-name: option<string>,
    /// Service provider type
    spid-carrier-type: option<string>,
    state: option<string>
  }

  variant number-lookup-error {
    unprocessable-entity(string),
    other(string)
  }

  /// Lookup phone number data
  record number-lookup-params {
    /// The phone number to be looked up
    phone-number: string,
    /// Specifies the type of number lookup to be performed
    type-op: option<number-lookup-type-op-enum>
  }
  number-lookup: func(params: number-lookup-params) -> result<number-lookup-response, number-lookup-error>;

}

interface number-order-documents {
