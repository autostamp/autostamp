interface call-control-applications {
  enum list-call-control-applications-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum call-control-application-anchorsite-override-enum {
    latency,
    chicago-il,
    ashburn-va,
    san-jose-ca,
  }

  enum call-control-application-dtmf-type-enum {
    rfc-v2833,
    inband,
    sip-info,
  }

  enum call-control-application-inbound-sip-subdomain-receive-settings-enum {
    only-my-connections,
    from-anyone,
  }

  enum call-control-application-record-type-enum {
    call-control-application,
  }

  enum call-control-application-webhook-api-version-enum {
    v1,
    v2,
  }

  record list-call-control-applications-response {
    data: option<list<call-control-application>>,
    meta: option<pagination-meta>
  }

  record call-control-application {
    /// Specifies whether the connection can be used.
    active: option<bool>,
    /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
    anchorsite-override: option<call-control-application-anchorsite-override-enum>,
    /// A user-assigned name to help manage the application.
    application-name: option<string>,
    /// ISO 8601 formatted date of when the resource was created
    created-at: option<string>,
    /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
    dtmf-type: option<call-control-application-dtmf-type-enum>,
    /// Specifies whether calls to phone numbers associated with this connection should hangup after timing out.
    first-command-timeout: option<bool>,
    /// Specifies how many seconds to wait before timing out a dial command.
    first-command-timeout-secs: option<s32>,
    id: option<string>,
    inbound: option<call-control-application-inbound>,
    outbound: option<call-control-application-outbound>,
    record-type: option<call-control-application-record-type-enum>,
    /// ISO 8601 formatted date of when the resource was last updated
    updated-at: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<call-control-application-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as `https`.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as `https`.
    webhook-event-url: option<string>,
    webhook-timeout-secs: option<s32>
  }

  record call-control-application-inbound {
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<call-control-application-inbound-sip-subdomain-receive-settings-enum>
  }

  record call-control-application-outbound {
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Identifies the associated outbound voice profile.
    outbound-voice-profile-id: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-call-control-application-response {
    data: option<call-control-application>
  }

  record retrieve-call-control-application-response {
    data: option<call-control-application>
  }

  record update-call-control-application-response {
    data: option<call-control-application>
  }

  record delete-call-control-application-response {
    data: option<call-control-application>
  }

  variant list-call-control-applications-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-call-control-application-error {
    unprocessable-entity(string),
    other(string)
  }

  variant retrieve-call-control-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-call-control-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-call-control-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List call control applications
  record list-call-control-applications-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, applications with <code>application_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-application-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-call-control-applications-sort-enum>
  }
  list-call-control-applications: func(params: list-call-control-applications-params) -> result<list-call-control-applications-response, list-call-control-applications-error>;

  /// Create a call control application
  record create-call-control-application-params {
    /// Specifies whether the connection can be used.
    active: option<bool>,
    /// <code>Latency</code> directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
    anchorsite-override: option<call-control-application-anchorsite-override-enum>,
    /// A user-assigned name to help manage the application.
    application-name: string,
    /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
    dtmf-type: option<call-control-application-dtmf-type-enum>,
    /// Specifies whether calls to phone numbers associated with this connection should hangup after timing out.
    first-command-timeout: option<bool>,
    /// Specifies how many seconds to wait before timing out a dial command.
    first-command-timeout-secs: option<s32>,
    inbound: option<call-control-application-inbound>,
    outbound: option<call-control-application-outbound>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<call-control-application-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: string,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  create-call-control-application: func(params: create-call-control-application-params) -> result<create-call-control-application-response, create-call-control-application-error>;

  /// Retrieve a call control application
  record retrieve-call-control-application-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-call-control-application: func(params: retrieve-call-control-application-params) -> result<retrieve-call-control-application-response, retrieve-call-control-application-error>;

  /// Update a call control application
  record update-call-control-application-params {
    /// Identifies the resource.
    id: string,
    /// Specifies whether the connection can be used.
    active: option<bool>,
    /// <code>Latency</code> directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
    anchorsite-override: option<call-control-application-anchorsite-override-enum>,
    /// A user-assigned name to help manage the application.
    application-name: string,
    /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
    dtmf-type: option<call-control-application-dtmf-type-enum>,
    /// Specifies whether calls to phone numbers associated with this connection should hangup after timing out.
    first-command-timeout: option<bool>,
    /// Specifies how many seconds to wait before timing out a dial command.
    first-command-timeout-secs: option<s32>,
    inbound: option<call-control-application-inbound>,
    outbound: option<call-control-application-outbound>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<call-control-application-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: string,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  update-call-control-application: func(params: update-call-control-application-params) -> result<update-call-control-application-response, update-call-control-application-error>;

  /// Delete a call control application
  record delete-call-control-application-params {
    /// Identifies the resource.
    id: string
  }
  delete-call-control-application: func(params: delete-call-control-application-params) -> result<delete-call-control-application-response, delete-call-control-application-error>;

}

interface debugging {
  enum list-call-events-filter-status-enum {
    delivered,
    failed,
  }

  enum list-call-events-filter-type-enum {
    command,
    webhook,
  }

  enum call-event-record-type-enum {
    call-event,
  }

  record list-call-events-response {
    data: option<list<call-event>>,
    meta: option<pagination-meta>
  }

  record call-event {
    /// Uniquely identifies an individual call leg.
    call-leg-id: string,
    /// Uniquely identifies the call control session. A session may include multiple call leg events.
    call-session-id: string,
    /// Event timestamp
    event-timestamp: string,
    /// Event metadata, which includes raw event, and extra information based on event type
    metadata: call-event-metadata,
    /// Event name
    name: string,
    record-type: call-event-record-type-enum,
    /// Event type
    type-op: list-call-events-filter-type-enum
  }

  /// Event metadata, which includes raw event, and extra information based on event type
  record call-event-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  /// List call events
  record list-call-events-params {
    /// The unique identifier of an individual call leg.
    filter-call-leg-id: option<string>,
    /// The unique identifier of the call control session. A session may include multiple call leg events.
    filter-call-session-id: option<string>,
    /// Event status
    filter-status: option<list-call-events-filter-status-enum>,
    /// Event type
    filter-type: option<list-call-events-filter-type-enum>,
    /// Event timestamp: greater than
    filter-event-timestamp-gt: option<string>,
    /// Event timestamp: greater than or equal
    filter-event-timestamp-gte: option<string>,
    /// Event timestamp: lower than
    filter-event-timestamp-lt: option<string>,
    /// Event timestamp: lower than or equal
    filter-event-timestamp-lte: option<string>,
    /// Event timestamp: equal
    filter-event-timestamp-eq: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-call-events: func(params: list-call-events-params) -> result<list-call-events-response, string>;

}

interface call-commands {
  enum call-request-answering-machine-detection-enum {
    detect,
    detect-beep,
    detect-words,
    greeting-end,
    disabled,
  }

  enum call-request-webhook-url-method-enum {
    post,
    get,
  }

  enum call-record-type-enum {
    call,
  }

  enum start-forking-request-stream-type-enum {
    raw,
    decrypted,
  }

  enum gather-using-speak-request-language-enum {
    arb,
    cmn-cn,
    cy-gb,
    da-dk,
    de-de,
    en-au,
    en-gb,
    en-gb-wls,
    en-in,
    en-us,
    es-es,
    es-mx,
    es-us,
    fr-ca,
    fr-fr,
    hi-in,
    is-is,
    it-it,
    ja-jp,
    ko-kr,
    nb-no,
    nl-nl,
    pl-pl,
    pt-br,
    pt-pt,
    ro-ro,
    ru-ru,
    sv-se,
    tr-tr,
  }

  enum gather-using-speak-request-payload-type-enum {
    text,
    ssml,
  }

  enum gather-using-speak-request-service-level-enum {
    basic,
    premium,
  }

  enum gather-using-speak-request-voice-enum {
    male,
    female,
  }

  enum start-recording-request-channels-enum {
    single,
    dual,
  }

  enum start-recording-request-format-enum {
    wav,
    mp3,
  }

  enum reject-request-cause-enum {
    call-rejected,
    user-busy,
  }

  enum transcription-start-request-language-enum {
    de,
    en,
    es,
    fr,
    it,
    pl,
  }

  /// Optional configuration parameters to modify 'answering_machine_detection' performance.
  record call-request-answering-machine-detection-config {
    /// Silence duration threshold after a greeting message or voice for it be considered human.
    after-greeting-silence-millis: option<s32>,
    /// Maximum threshold for silence between words.
    between-words-silence-millis: option<s32>,
    /// Maximum threshold of a human greeting. If greeting longer than this value, considered machine.
    greeting-duration-millis: option<s32>,
    /// If machine already detected, maximum threshold for silence between words. If exceeded, the greeting is considered ended.
    greeting-silence-duration-millis: option<s32>,
    /// If machine already detected, maximum timeout threshold to determine the end of the machine greeting.
    greeting-total-analysis-time-millis: option<s32>,
    /// If initial silence duration is greater than this value, consider it a machine.
    initial-silence-millis: option<s32>,
    /// If number of detected words is greater than this value, consder it a machine.
    maximum-number-of-words: option<s32>,
    /// If a single word lasts longer than this threshold, consider it a machine.
    maximum-word-length-millis: option<s32>,
    /// Minimum noise threshold for any analysis.
    silence-threshold: option<s32>,
    /// Maximum timeout threshold for overall detection.
    total-analysis-time-millis: option<s32>
  }

  record custom-sip-header {
    /// The name of the header to add.
    name: string,
    /// The value of the header.
    value: string
  }

  record call-dial-response {
    data: option<call>
  }

  record call {
    /// Unique identifier and token for controlling the call.
    call-control-id: string,
    /// ID that is unique to the call and can be used to correlate webhook events
    call-leg-id: string,
    /// ID that is unique to the call session and can be used to correlate webhook events
    call-session-id: string,
    /// Indicates whether the call is alive or not. For Dial command it will always be `false` (dialing is asynchronous).
    is-alive: bool,
    record-type: call-record-type-enum
  }

  record call-answer-response {
    data: option<call-control-command-result>
  }

  record call-control-command-result {
    result-op: option<string>
  }

  record call-bridge-response {
    data: option<call-control-command-result>
  }

  record call-enqueue-response {
    data: option<call-control-command-result>
  }

  record call-fork-start-response {
    data: option<call-control-command-result>
  }

  record call-fork-stop-response {
    data: option<call-control-command-result>
  }

  record call-gather-stop-response {
    data: option<call-control-command-result>
  }

  record call-gather-using-audio-response {
    data: option<call-control-command-result>
  }

  record call-gather-using-speak-response {
    data: option<call-control-command-result>
  }

  record call-hangup-response {
    data: option<call-control-command-result>
  }

  record leave-queue-response {
    data: option<call-control-command-result>
  }

  record loopcount {
    /// opaque schema; raw JSON
    value: string
  }

  record call-playback-start-response {
    data: option<call-control-command-result>
  }

  record call-playback-stop-response {
    data: option<call-control-command-result>
  }

  record call-record-pause-response {
    data: option<call-control-command-result>
  }

  record call-record-resume-response {
    data: option<call-control-command-result>
  }

  record call-record-start-response {
    data: option<call-control-command-result>
  }

  record call-record-stop-response {
    data: option<call-control-command-result>
  }

  record call-refer-response {
    data: option<call-control-command-result>
  }

  record call-reject-response {
    data: option<call-control-command-result>
  }

  record call-send-dtmf-response {
    data: option<call-control-command-result>
  }

  record call-speak-response {
    data: option<call-control-command-result>
  }

  record call-transcription-start-response {
    data: option<call-control-command-result>
  }

  record call-transcription-stop-response {
    data: option<call-control-command-result>
  }

  /// Optional configuration parameters to modify 'answering_machine_detection' performance.
  record transfer-call-request-answering-machine-detection-config {
    /// Silence duration threshold after a greeting message or voice for it be considered human.
    after-greeting-silence-millis: option<s32>,
    /// Maximum threshold for silence between words.
    between-words-silence-millis: option<s32>,
    /// Maximum threshold of a human greeting. If greeting longer than this value, considered machine.
    greeting-duration-millis: option<s32>,
    /// If machine already detected, maximum threshold for silence between words. If exceeded, the greeting is considered ended.
    greeting-silence-duration-millis: option<s32>,
    /// If machine already detected, maximum timeout threshold to determine the end of the machine greeting.
    greeting-total-analysis-time-millis: option<s32>,
    /// If initial silence duration is greater than this value, consider it a machine.
    initial-silence-millis: option<s32>,
    /// If number of detected words is greater than this value, consder it a machine.
    maximum-number-of-words: option<s32>,
    /// If a single word lasts longer than this threshold, consider it a machine.
    maximum-word-length-millis: option<s32>,
    /// Minimum noise threshold for any analysis.
    silence-threshold: option<s32>,
    /// Maximum timeout threshold for overall detection.
    total-analysis-time-millis: option<s32>
  }

  record call-transfer-response {
    data: option<call-control-command-result>
  }

  /// Dial
  record call-dial-params {
    /// Enables Answering Machine Detection. When a call is answered, Telnyx runs real-time detection to determine if it was picked up by a human or a machine and sends an `call.machine.detection.ended` webhook with the analysis result. If 'greeting_end' or 'detect_words' is used and a 'machine' is detected, you will receive another 'call.machine.greeting.ended' webhook when the answering machine greeting ends with a beep or silence. If `detect_beep` is used, you will only receive 'call.machine.greeting.ended' if a beep is detected.
    answering-machine-detection: option<call-request-answering-machine-detection-enum>,
    /// Optional configuration parameters to modify 'answering_machine_detection' performance.
    answering-machine-detection-config: option<call-request-answering-machine-detection-config>,
    /// The URL of a file to be played back to the callee when the call is answered. The URL can point to either a WAV or MP3 file. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// Use this field to set the Billing Group ID for the call. Must be a valid and existing Billing Group ID.
    billing-group-id: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The ID of the Call Control App (formerly ID of the connection) to be used when dialing the destination.
    connection-id: string,
    /// Custom headers to be added to the SIP INVITE.
    custom-headers: option<list<custom-sip-header>>,
    /// The `from` number to be used as the caller id presented to the destination (`to` number). The number should be in +E164 format. This attribute will default to the `from` number of the original call if omitted.
    from-op: string,
    /// The `from_display_name` string to be used as the caller id name (SIP From Display Name) presented to the destination (`to` number). The string should have a maximum of 128 characters, containing only letters, numbers, spaces, and -_~!.+ special characters. If ommited, the display name will be the same as the number in the `from` field.
    from-display-name: option<string>,
    /// Use another call's control id for sharing the same call session id
    link-to: option<string>,
    /// The media_name of a file to be played back to the callee when the call is answered. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>,
    /// SIP Authentication password used for SIP challenges.
    sip-auth-password: option<string>,
    /// SIP Authentication username used for SIP challenges.
    sip-auth-username: option<string>,
    /// Sets the maximum duration of a Call Control Leg in seconds. If the time limit is reached, the call will hangup and a `call.hangup` webhook with a `hangup_cause` of `time_limit` will be sent. For example, by setting a time limit of 120 seconds, a Call Leg will be automatically terminated two minutes after being answered. The default time limit is 14400 seconds or 4 hours and this is also the maximum allowed call length.
    time-limit-secs: option<s32>,
    /// The number of seconds that Telnyx will wait for the call to be answered by the destination to which it is being called. If the timeout is reached before an answer is received, the call will hangup and a `call.hangup` webhook with a `hangup_cause` of `timeout` will be sent. Minimum value is 5 seconds. Maximum value is 120 seconds.
    timeout-secs: option<s32>,
    /// The DID or SIP URI to dial out to.
    to: string,
    /// Use this field to override the URL for which Telnyx will send subsequent webhooks to for this call.
    webhook-url: option<string>,
    /// HTTP request type used for `webhook_url`.
    webhook-url-method: option<call-request-webhook-url-method-enum>
  }
  call-dial: func(params: call-dial-params) -> result<call-dial-response, string>;

  /// Answer call
  record call-answer-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to set the Billing Group ID for the call. Must be a valid and existing Billing Group ID.
    billing-group-id: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Use this field to override the URL for which Telnyx will send subsequent webhooks to for this call.
    webhook-url: option<string>,
    /// HTTP request type used for `webhook_url`.
    webhook-url-method: option<call-request-webhook-url-method-enum>
  }
  call-answer: func(params: call-answer-params) -> result<call-answer-response, string>;

  /// Bridge calls
  record call-bridge-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// The Call Control ID of the call you want to bridge with.
    call-control-id-v2: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Specifies behavior after the bridge ends (i.e. the opposite leg either hangs up or is transferred). If supplied with the value `self`, the current leg will be parked after unbridge. If not set, the default behavior is to hang up the leg.
    park-after-unbridge: option<string>,
    /// The name of the queue you want to bridge with, can't be used together with call_control_id parameter. Bridging with a queue means bridging with the first call in the queue. The call will always be removed from the queue regardless of whether bridging succeeds. Returns an error when the queue is empty.
    queue: option<string>
  }
  call-bridge: func(params: call-bridge-params) -> result<call-bridge-response, string>;

  /// Enqueue call
  record call-enqueue-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The maximum number of calls allowed in the queue at a given time. Can't be modified for an existing queue.
    max-size: option<s32>,
    /// The number of seconds after which the call will be removed from the queue.
    max-wait-time-secs: option<s32>,
    /// The name of the queue the call should be put in. If a queue with a given name doesn't exist yet it will be created.
    queue-name: option<string>
  }
  call-enqueue: func(params: call-enqueue-params) -> result<call-enqueue-response, string>;

  /// Forking start
  record call-fork-start-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The network target, <udp:ip_address:port>, where the call's incoming RTP media packets should be forwarded.
    rx: option<string>,
    /// Optionally specify a media type to stream. If `decrpyted` selected, Telnyx will decrypt incoming SIP media before forking to the target. `rx` and `tx` are required fields if `decrypted` selected.
    stream-type: option<start-forking-request-stream-type-enum>,
    /// The network target, <udp:ip_address:port>, where the call's RTP media packets should be forwarded. Both incoming and outgoing media packets will be delivered to the specified target, and information about the stream will be included in the encapsulation protocol header, including the direction (0 = inbound; 1 = outbound), leg (0 = A-leg; 1 = B-leg), and call_leg_id.
    target: option<string>,
    /// The network target, <udp:ip_address:port>, where the call's outgoing RTP media packets should be forwarded.
    tx: option<string>
  }
  call-fork-start: func(params: call-fork-start-params) -> result<call-fork-start-response, string>;

  /// Forking stop
  record call-fork-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-fork-stop: func(params: call-fork-stop-params) -> result<call-fork-stop-response, string>;

  /// Gather stop
  record call-gather-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-gather-stop: func(params: call-gather-stop-params) -> result<call-gather-stop-response, string>;

  /// Gather using audio
  record call-gather-using-audio-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// The URL of a file to be played back at the beginning of each prompt. The URL can point to either a WAV or MP3 file. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The number of milliseconds to wait for input between digits.
    inter-digit-timeout-millis: option<s32>,
    /// The URL of a file to play when digits don't match the `valid_digits` parameter or the number of digits is not between `min` and `max`. The URL can point to either a WAV or MP3 file. invalid_media_name and invalid_audio_url cannot be used together in one request.
    invalid-audio-url: option<string>,
    /// The media_name of a file to be played back when digits don't match the `valid_digits` parameter or the number of digits is not between `min` and `max`. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    invalid-media-name: option<string>,
    /// The maximum number of digits to fetch. This parameter has a maximum value of 128.
    maximum-digits: option<s32>,
    /// The maximum number of times the file should be played if there is no input from the user on the call.
    maximum-tries: option<s32>,
    /// The media_name of a file to be played back at the beginning of each prompt. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>,
    /// The minimum number of digits to fetch. This parameter has a minimum value of 1.
    minimum-digits: option<s32>,
    /// The digit used to terminate input if fewer than `maximum_digits` digits have been gathered.
    terminating-digit: option<string>,
    /// The number of milliseconds to wait for a DTMF response after file playback ends before a replaying the sound file.
    timeout-millis: option<s32>,
    /// A list of all digits accepted as valid.
    valid-digits: option<string>
  }
  call-gather-using-audio: func(params: call-gather-using-audio-params) -> result<call-gather-using-audio-response, string>;

  /// Gather using speak
  record call-gather-using-speak-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The number of milliseconds to wait for input between digits.
    inter-digit-timeout-millis: option<s32>,
    /// The text or SSML to be converted into speech when digits don't match the `valid_digits` parameter or the number of digits is not between `min` and `max`. There is a 5,000 character limit.
    invalid-payload: option<string>,
    /// The language you want spoken.
    language: gather-using-speak-request-language-enum,
    /// The maximum number of digits to fetch. This parameter has a maximum value of 128.
    maximum-digits: option<s32>,
    /// The maximum number of times that a file should be played back if there is no input from the user on the call.
    maximum-tries: option<s32>,
    /// The minimum number of digits to fetch. This parameter has a minimum value of 1.
    minimum-digits: option<s32>,
    /// The text or SSML to be converted into speech. There is a 5,000 character limit.
    payload: string,
    /// The type of the provided payload. The payload can either be plain text, or Speech Synthesis Markup Language (SSML).
    payload-type: option<gather-using-speak-request-payload-type-enum>,
    /// This parameter impacts speech quality, language options and payload types. When using `basic`, only the `en-US` language and payload type `text` are allowed.
    service-level: option<gather-using-speak-request-service-level-enum>,
    /// The digit used to terminate input if fewer than `maximum_digits` digits have been gathered.
    terminating-digit: option<string>,
    /// The number of milliseconds to wait for a DTMF response after speak ends before a replaying the sound file.
    timeout-millis: option<s32>,
    /// A list of all digits accepted as valid.
    valid-digits: option<string>,
    /// The gender of the voice used to speak back the text.
    voice: gather-using-speak-request-voice-enum
  }
  call-gather-using-speak: func(params: call-gather-using-speak-params) -> result<call-gather-using-speak-response, string>;

  /// Hangup call
  record call-hangup-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-hangup: func(params: call-hangup-params) -> result<call-hangup-response, string>;

  /// Remove call from a queue
  record leave-queue-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  leave-queue: func(params: leave-queue-params) -> result<leave-queue-response, string>;

  /// Play audio URL
  record call-playback-start-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// The URL of a file to be played back on the call. The URL can point to either a WAV or MP3 file. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    loop: option<loopcount>,
    /// The media_name of a file to be played back on the call. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>,
    /// When enabled, audio will be mixed on top of any other audio that is actively being played back. Note that `overlay: true` will only work if there is another audio file already being played on the call.
    overlay: option<bool>,
    /// When specified, it stops the current audio being played.  Specify `current` to stop the current audio being played, and to play the next file in the queue. Specify `all` to stop the current audio file being played and to also clear all audio files from the queue.
    stop: option<string>,
    /// Specifies the leg or legs on which audio will be played. If supplied, the value must be either `self`, `opposite` or `both`.
    target-legs: option<string>
  }
  call-playback-start: func(params: call-playback-start-params) -> result<call-playback-start-response, string>;

  /// Stop audio playback
  record call-playback-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Use `current` to stop only the current audio or `all` to stop all audios in the queue.
    stop: option<string>
  }
  call-playback-stop: func(params: call-playback-stop-params) -> result<call-playback-stop-response, string>;

  /// Record pause
  record call-record-pause-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-record-pause: func(params: call-record-pause-params) -> result<call-record-pause-response, string>;

  /// Record resume
  record call-record-resume-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-record-resume: func(params: call-record-resume-params) -> result<call-record-resume-response, string>;

  /// Recording start
  record call-record-start-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// When `dual`, final audio file will be stereo recorded with the first leg on channel A, and the rest on channel B.
    channels: start-recording-request-channels-enum,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The audio file format used when storing the call recording. Can be either `mp3` or `wav`.
    format: start-recording-request-format-enum,
    /// Defines the maximum length for the recording in seconds. Minimum value is 0. Maximum value is 14400. Default is 0 (infinite)
    max-length: option<s32>,
    /// If enabled, a beep sound will be played at the start of a recording.
    play-beep: option<bool>
  }
  call-record-start: func(params: call-record-start-params) -> result<call-record-start-response, string>;

  /// Recording stop
  record call-record-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-record-stop: func(params: call-record-stop-params) -> result<call-record-stop-response, string>;

  /// SIP Refer a call
  record call-refer-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// Custom headers to be added to the SIP INVITE.
    custom-headers: option<list<custom-sip-header>>,
    /// The SIP URI to which the call will be referred to.
    sip-address: string,
    /// SIP Authentication password used for SIP challenges.
    sip-auth-password: option<string>,
    /// SIP Authentication username used for SIP challenges.
    sip-auth-username: option<string>
  }
  call-refer: func(params: call-refer-params) -> result<call-refer-response, string>;

  /// Reject a call
  record call-reject-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Cause for call rejection.
    cause: reject-request-cause-enum,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-reject: func(params: call-reject-params) -> result<call-reject-response, string>;

  /// Send DTMF
  record call-send-dtmf-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// DTMF digits to send. Valid digits are 0-9, A-D, *, and #. Pauses can be added using w (0.5s) and W (1s).
    digits: string,
    /// Specifies for how many milliseconds each digit will be played in the audio stream. Ranges from 100 to 500ms
    duration-millis: option<s32>
  }
  call-send-dtmf: func(params: call-send-dtmf-params) -> result<call-send-dtmf-response, string>;

  /// Speak text
  record call-speak-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The language you want spoken.
    language: gather-using-speak-request-language-enum,
    /// The text or SSML to be converted into speech. There is a 5,000 character limit.
    payload: string,
    /// The type of the provided payload. The payload can either be plain text, or Speech Synthesis Markup Language (SSML).
    payload-type: option<gather-using-speak-request-payload-type-enum>,
    /// This parameter impacts speech quality, language options and payload types. When using `basic`, only the `en-US` language and payload type `text` are allowed.
    service-level: option<gather-using-speak-request-service-level-enum>,
    /// When specified, it stops the current audio being played.  Specify `current` to stop the current audio being played, and to play the next file in the queue. Specify `all` to stop the current audio file being played and to also clear all audio files from the queue.
    stop: option<string>,
    /// The gender of the voice used to speak back the text.
    voice: gather-using-speak-request-voice-enum
  }
  call-speak: func(params: call-speak-params) -> result<call-speak-response, string>;

  /// Transcription start
  record call-transcription-start-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Language to use for speech recognition
    language: option<transcription-start-request-language-enum>
  }
  call-transcription-start: func(params: call-transcription-start-params) -> result<call-transcription-start-response, string>;

  /// Transcription stop
  record call-transcription-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-transcription-stop: func(params: call-transcription-stop-params) -> result<call-transcription-stop-response, string>;

  /// Transfer call
  record call-transfer-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Enables Answering Machine Detection. When a call is answered, Telnyx runs real-time detection to determine if it was picked up by a human or a machine and sends an `call.machine.detection.ended` webhook with the analysis result. If 'greeting_end' or 'detect_words' is used and a 'machine' is detected, you will receive another 'call.machine.greeting.ended' webhook when the answering machine greeting ends with a beep or silence. If `detect_beep` is used, you will only receive 'call.machine.greeting.ended' if a beep is detected.
    answering-machine-detection: option<call-request-answering-machine-detection-enum>,
    /// Optional configuration parameters to modify 'answering_machine_detection' performance.
    answering-machine-detection-config: option<transfer-call-request-answering-machine-detection-config>,
    /// The URL of a file to be played back when the transfer destination answers before bridging the call. The URL can point to either a WAV or MP3 file. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Custom headers to be added to the SIP INVITE.
    custom-headers: option<list<custom-sip-header>>,
    /// The `from` number to be used as the caller id presented to the destination (`to` number). The number should be in +E164 format. This attribute will default to the `from` number of the original call if omitted.
    from-op: option<string>,
    /// The `from_display_name` string to be used as the caller id name (SIP From Display Name) presented to the destination (`to` number). The string should have a maximum of 128 characters, containing only letters, numbers, spaces, and -_~!.+ special characters. If ommited, the display name will be the same as the number in the `from` field.
    from-display-name: option<string>,
    /// The media_name of a file to be played back when the transfer destination answers before bridging the call. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>,
    /// SIP Authentication password used for SIP challenges.
    sip-auth-password: option<string>,
    /// SIP Authentication username used for SIP challenges.
    sip-auth-username: option<string>,
    /// Use this field to add state to every subsequent webhook for the new leg. It must be a valid Base-64 encoded string.
    target-leg-client-state: option<string>,
    /// Sets the maximum duration of a Call Control Leg in seconds. If the time limit is reached, the call will hangup and a `call.hangup` webhook with a `hangup_cause` of `time_limit` will be sent. For example, by setting a time limit of 120 seconds, a Call Leg will be automatically terminated two minutes after being answered. The default time limit is 14400 seconds or 4 hours and this is also the maximum allowed call length.
    time-limit-secs: option<s32>,
    /// The number of seconds that Telnyx will wait for the call to be answered by the destination to which it is being transferred. If the timeout is reached before an answer is received, the call will hangup and a `call.hangup` webhook with a `hangup_cause` of `timeout` will be sent. Minimum value is 5 seconds. Maximum value is 120 seconds.
    timeout-secs: option<s32>,
    /// The DID or SIP URI to dial out and bridge to the given call.
    to: string,
    /// Use this field to override the URL for which Telnyx will send subsequent webhooks to for this call.
    webhook-url: option<string>,
    /// HTTP request type used for `webhook_url`.
    webhook-url-method: option<call-request-webhook-url-method-enum>
  }
  call-transfer: func(params: call-transfer-params) -> result<call-transfer-response, string>;

}

interface call-information {
  enum call-record-type-enum {
    call,
  }

  record retrieve-call-status-response {
    data: option<call>
  }

  record call {
    /// Unique identifier and token for controlling the call.
    call-control-id: string,
    /// ID that is unique to the call and can be used to correlate webhook events
    call-leg-id: string,
    /// ID that is unique to the call session and can be used to correlate webhook events
    call-session-id: string,
    /// Indicates whether the call is alive or not. For Dial command it will always be `false` (dialing is asynchronous).
    is-alive: bool,
    record-type: call-record-type-enum
  }

  /// Retrieve a call status
  record retrieve-call-status-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string
  }
  retrieve-call-status: func(params: retrieve-call-status-params) -> result<retrieve-call-status-response, string>;

}

interface number-orders {
  enum comment-comment-record-type-enum {
    number-order,
    sub-number-order,
    number-order-phone-number,
  }

  enum comment-commenter-type-enum {
    admin,
    user,
  }

  enum number-order-phone-number-phone-number-type-enum {
    local,
    toll-free,
    mobile,
    national,
    shared-cost,
  }

  enum phone-number-regulatory-requirement-field-type-enum {
    textual,
    datetime,
    address,
    document,
  }

  enum number-order-phone-number-status-enum {
    pending,
    success,
    failure,
  }

  record list-comments-response {
    data: option<list<comment>>,
    meta: option<pagination-meta>
  }

  record comment {
    body: option<string>,
    comment-record-id: option<string>,
    comment-record-type: option<comment-comment-record-type-enum>,
    commenter: option<string>,
    commenter-type: option<comment-commenter-type-enum>,
    /// An ISO 8901 datetime string denoting when the comment was created.
    created-at: option<string>,
    id: option<string>,
    /// An ISO 8901 datetime string for when the comment was read.
    read-at: option<string>,
    /// An ISO 8901 datetime string for when the comment was updated.
    updated-at: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-comment-response {
    data: option<create-comment-response-data>
  }

  record create-comment-response-data {
    body: option<string>,
    comment-record-id: option<string>,
    comment-record-type: option<comment-comment-record-type-enum>,
    commenter: option<string>,
    commenter-type: option<comment-commenter-type-enum>,
    /// An ISO 8901 datetime string denoting when the comment was created.
    created-at: option<string>,
    id: option<string>,
    /// An ISO 8901 datetime string for when the comment was read.
    read-at: option<string>,
    /// An ISO 8901 datetime string for when the comment was updated.
    updated-at: option<string>
  }

  record retrieve-comment-response {
    data: option<retrieve-comment-response-data>
  }

  record retrieve-comment-response-data {
    body: option<string>,
    comment-record-id: option<string>,
    comment-record-type: option<comment-comment-record-type-enum>,
    commenter: option<string>,
    commenter-type: option<comment-commenter-type-enum>,
    /// An ISO 8901 datetime string denoting when the comment was created.
    created-at: option<string>,
    id: option<string>,
    /// An ISO 8901 datetime string for when the comment was read.
    read-at: option<string>,
    /// An ISO 8901 datetime string for when the comment was updated.
    updated-at: option<string>
  }

  record mark-comment-read-response {
    data: option<mark-comment-read-response-data>
  }

  record mark-comment-read-response-data {
    body: option<string>,
    comment-record-id: option<string>,
    comment-record-type: option<comment-comment-record-type-enum>,
    commenter: option<string>,
    commenter-type: option<comment-commenter-type-enum>,
    /// An ISO 8901 datetime string denoting when the comment was created.
    created-at: option<string>,
    id: option<string>,
    /// An ISO 8901 datetime string for when the comment was read.
    read-at: option<string>,
    /// An ISO 8901 datetime string for when the comment was updated.
    updated-at: option<string>
  }

  record retrieve-number-order-phone-numbers-response {
    data: option<list<number-order-phone-number>>,
    meta: option<pagination-meta>
  }

  record number-order-phone-number {
    country-code: option<string>,
    id: option<string>,
    order-request-id: option<string>,
    phone-number: option<string>,
    phone-number-type: option<number-order-phone-number-phone-number-type-enum>,
    record-type: option<string>,
    regulatory-requirements: option<list<phone-number-regulatory-requirement>>,
    /// True if all requirements are met for a phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the phone number in the order.
    status: option<number-order-phone-number-status-enum>,
    sub-number-order-id: option<string>
  }

  record phone-number-regulatory-requirement {
    field-type: option<phone-number-regulatory-requirement-field-type-enum>,
    record-type: option<string>,
    /// Unique id for a requirement.
    requirement-id: option<string>,
    /// The value of the requirement, this could be an id to a resource or a string value.
    field-value: option<string>
  }

  record retrieve-number-order-phone-number-response {
    data: option<number-order-phone-number>
  }

  record update-regulatory-requirement {
    /// The value of the requirement, this could be an id to a resource or a string value.
    field-value: option<string>,
    /// Unique id for a requirement.
    requirement-id: option<string>
  }

  record update-number-order-phone-number-response {
    data: option<number-order-phone-number>
  }

  record list-number-orders-response {
    data: option<list<number-order>>,
    meta: option<pagination-meta>
  }

  record number-order {
    /// Identifies the messaging profile associated with the phone number.
    billing-group-id: option<string>,
    /// Identifies the connection associated with this phone number.
    connection-id: option<string>,
    /// An ISO 8901 datetime string denoting when the number order was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    id: option<string>,
    /// Identifies the messaging profile associated with the phone number.
    messaging-profile-id: option<string>,
    /// The count of phone numbers in the number order.
    phone-numbers-count: option<s32>,
    record-type: option<string>,
    /// True if all requirements are met for every phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the order.
    status: option<number-order-phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the number order was updated.
    updated-at: option<string>
  }

  record phone-number {
    id: option<string>,
    phone-number: option<string>,
    record-type: option<string>,
    regulatory-group-id: option<string>,
    regulatory-requirements: option<list<phone-number-regulatory-requirement>>,
    /// True if all requirements are met for a phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the phone number in the order.
    status: option<number-order-phone-number-status-enum>
  }

  record create-number-order-response {
    data: option<number-order-with-phone-numbers>
  }

  record number-order-with-phone-numbers {
    /// Identifies the messaging profile associated with the phone number.
    billing-group-id: option<string>,
    /// Identifies the connection associated with this phone number.
    connection-id: option<string>,
    /// An ISO 8901 datetime string denoting when the number order was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    id: option<string>,
    /// Identifies the messaging profile associated with the phone number.
    messaging-profile-id: option<string>,
    /// The count of phone numbers in the number order.
    phone-numbers-count: option<s32>,
    record-type: option<string>,
    /// True if all requirements are met for every phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the order.
    status: option<number-order-phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the number order was updated.
    updated-at: option<string>,
    phone-numbers: option<list<phone-number>>
  }

  record retrieve-number-order-response {
    data: option<number-order-with-phone-numbers>
  }

  record update-number-order-response {
    data: option<number-order-with-phone-numbers>
  }

  record list-sub-number-orders-response {
    data: option<list<sub-number-order>>,
    meta: option<pagination-meta>
  }

  record sub-number-order {
    country-code: option<string>,
    /// An ISO 8901 datetime string denoting when the number order was created.
    created-at: option<string>,
    id: option<string>,
    order-request-id: option<string>,
    phone-number-type: option<number-order-phone-number-phone-number-type-enum>,
    /// The count of phone numbers in the number order.
    phone-numbers-count: option<s32>,
    record-type: option<string>,
    regulatory-requirements: option<list<sub-number-order-regulatory-requirement>>,
    /// True if all requirements are met for every phone number, false otherwise.
    requirements-met: option<bool>,
    /// An ISO 8901 datetime string for when the number order was updated.
    updated-at: option<string>,
    user-id: option<string>
  }

  record sub-number-order-regulatory-requirement {
    field-type: option<phone-number-regulatory-requirement-field-type-enum>,
    record-type: option<string>,
    /// Unique id for a requirement.
    requirement-id: option<string>
  }

  record retrieve-sub-number-order-response {
    data: option<sub-number-order>
  }

  record update-sub-number-order-response {
    data: option<sub-number-order>
  }

  /// Retrieve all comments
  record list-comments-params {
    /// Record type that the comment relates to i.e number_order, sub_number_order or number_order_phone_number
    filter-comment-record-type: string,
    /// ID of the record the comments relate to
    filter-comment-record-id: string
  }
  list-comments: func(params: list-comments-params) -> result<list-comments-response, string>;

  /// Create a comment
  record create-comment-params {
    body: option<string>,
    comment-record-id: option<string>,
    comment-record-type: option<comment-comment-record-type-enum>,
    commenter: option<string>,
    commenter-type: option<comment-commenter-type-enum>,
    /// An ISO 8901 datetime string denoting when the comment was created.
    created-at: option<string>,
    id: option<string>,
    /// An ISO 8901 datetime string for when the comment was read.
    read-at: option<string>,
    /// An ISO 8901 datetime string for when the comment was updated.
    updated-at: option<string>
  }
  create-comment: func(params: create-comment-params) -> result<create-comment-response, string>;

  /// Retrieve a comment
  record retrieve-comment-params {
    /// The comment ID.
    id: string
  }
  retrieve-comment: func(params: retrieve-comment-params) -> result<retrieve-comment-response, string>;

  /// Mark a comment as read
  record mark-comment-read-params {
    /// The comment ID.
    id: string
  }
  mark-comment-read: func(params: mark-comment-read-params) -> result<mark-comment-read-response, string>;

  /// Retrieve a list of phone numbers associated to orders
  retrieve-number-order-phone-numbers: func() -> result<retrieve-number-order-phone-numbers-response, string>;

  /// Retrieve a number order phone number.
  record retrieve-number-order-phone-number-params {
    /// The number order phone number ID.
    number-order-phone-number-id: string
  }
  retrieve-number-order-phone-number: func(params: retrieve-number-order-phone-number-params) -> result<retrieve-number-order-phone-number-response, string>;

  /// Update a number order phone number.
  record update-number-order-phone-number-params {
    /// The number order phone number ID.
    number-order-phone-number-id: string,
    regulatory-requirements: option<list<update-regulatory-requirement>>
  }
  update-number-order-phone-number: func(params: update-number-order-phone-number-params) -> result<update-number-order-phone-number-response, string>;

  /// List number orders
  record list-number-orders-params {
    /// Filter number orders by status.
    filter-status: option<string>,
    /// Filter number orders later than this value.
    filter-created-at-gt: option<string>,
    /// Filter number orders earlier than this value.
    filter-created-at-lt: option<string>,
    /// Filter number order with this amount of numbers
    filter-phone-numbers-count: option<string>,
    /// Filter number orders via the customer reference set.
    filter-customer-reference: option<string>,
    /// Filter number orders by requirements met.
    filter-requirements-met: option<bool>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-number-orders: func(params: list-number-orders-params) -> result<list-number-orders-response, string>;

  /// Create a number order
  record create-number-order-params {
    /// Identifies the billing group associated with the phone number.
    billing-group-id: option<string>,
    /// Identifies the connection associated with this phone number.
    connection-id: option<string>,
    /// An ISO 8901 datetime string denoting when the number order was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    id: option<string>,
    /// Identifies the messaging profile associated with the phone number.
    messaging-profile-id: option<string>,
    phone-numbers: option<list<phone-number>>,
    /// The count of phone numbers in the number order.
    phone-numbers-count: option<s32>,
    record-type: option<string>,
    /// True if all requirements are met for every phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the order.
    status: option<number-order-phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the number order was updated.
    updated-at: option<string>
  }
  create-number-order: func(params: create-number-order-params) -> result<create-number-order-response, string>;

  /// Retrieve a number order
  record retrieve-number-order-params {
    /// The number order ID.
    number-order-id: string
  }
  retrieve-number-order: func(params: retrieve-number-order-params) -> result<retrieve-number-order-response, string>;

  /// Update a number order
  record update-number-order-params {
    /// The number order ID.
    number-order-id: string,
    /// An ISO 8901 datetime string denoting when the number order was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    id: option<string>,
    phone-numbers: option<list<phone-number>>,
    /// The count of phone numbers in the number order.
    phone-numbers-count: option<s32>,
    record-type: option<string>,
    /// True if all requirements are met for every phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the order.
    status: option<number-order-phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the number order was updated.
    updated-at: option<string>
  }
  update-number-order: func(params: update-number-order-params) -> result<update-number-order-response, string>;

  /// List sub number orders
  record list-sub-number-orders-params {
    /// User ID of the user who owns the sub number order
    filter-user-id: option<string>,
    /// ID of the number order the sub number order belongs to
    filter-order-request-id: option<string>,
    /// ISO alpha-2 country code.
    filter-country-code: option<string>,
    /// Phone Number Type
    filter-phone-number-type: option<string>,
    /// Amount of numbers in the sub number order
    filter-phone-numbers-count: option<s32>
  }
  list-sub-number-orders: func(params: list-sub-number-orders-params) -> result<list-sub-number-orders-response, string>;

  /// Retrieve a sub number order
  record retrieve-sub-number-order-params {
    /// The sub number order ID.
    sub-number-order-id: string,
    /// Include the first 50 phone number objects in the results
    filter-include-phone-numbers: option<bool>
  }
  retrieve-sub-number-order: func(params: retrieve-sub-number-order-params) -> result<retrieve-sub-number-order-response, string>;

  /// Update a sub number order
  record update-sub-number-order-params {
    /// The sub number order ID.
    sub-number-order-id: string,
    regulatory-requirements: option<list<update-regulatory-requirement>>
  }
  update-sub-number-order: func(params: update-sub-number-order-params) -> result<update-sub-number-order-response, string>;

}

interface conference-commands {
  enum conference-end-reason-enum {
    all-left,
    ended-via-api,
    host-left,
    time-exceeded,
  }

  enum conference-record-type-enum {
    conference,
  }

  enum conference-status-enum {
    init,
    in-progress,
    completed,
  }

  enum create-conference-request-beep-enabled-enum {
    always,
    never,
    on-enter,
    on-exit,
  }

  enum participant-record-type-enum {
    participant,
  }

  enum participant-status-enum {
    joining,
    joined,
    left,
  }

  enum conference-call-request-supervisor-role-enum {
    barge,
    monitor,
    none,
    whisper,
  }

  enum start-recording-request-channels-enum {
    single,
    dual,
  }

  enum start-recording-request-format-enum {
    wav,
    mp3,
  }

  enum conference-speak-request-language-enum {
    arb,
    cmn-cn,
    cy-gb,
    da-dk,
    de-de,
    en-au,
    en-gb,
    en-gb-wls,
    en-in,
    en-us,
    es-es,
    es-mx,
    es-us,
    fr-ca,
    fr-fr,
    hi-in,
    is-is,
    it-it,
    ja-jp,
    ko-kr,
    nb-no,
    nl-nl,
    pl-pl,
    pt-br,
    pt-pt,
    ro-ro,
    ru-ru,
    sv-se,
    tr-tr,
  }

  enum conference-speak-request-payload-type-enum {
    text,
    ssml,
  }

  enum conference-speak-request-voice-enum {
    male,
    female,
  }

  record list-conferences-response {
    data: option<list<conference>>,
    meta: option<pagination-meta>
  }

  record conference {
    /// Identifies the connection (Call Control App) associated with the conference
    connection-id: option<string>,
    /// ISO 8601 formatted date of when the conference was created
    created-at: string,
    /// Reason why the conference ended
    end-reason: option<conference-end-reason-enum>,
    /// IDs related to who ended the conference. It is expected for them to all be there or all be null
    ended-by: option<conference-ended-by>,
    /// ISO 8601 formatted date of when the conference will expire
    expires-at: string,
    /// Uniquely identifies the conference
    id: string,
    /// Name of the conference
    name: string,
    record-type: conference-record-type-enum,
    /// Region where the conference is hosted
    region: option<string>,
    /// Status of the conference
    status: option<conference-status-enum>,
    /// ISO 8601 formatted date of when the conference was last updated
    updated-at: option<string>
  }

  /// IDs related to who ended the conference. It is expected for them to all be there or all be null
  record conference-ended-by {
    /// Call Control ID which ended the conference
    call-control-id: option<string>,
    /// Call Session ID which ended the conference
    call-session-id: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-conference-response {
    data: option<conference>
  }

  record list-conference-participants-response {
    data: option<list<participant>>,
    meta: option<pagination-meta>
  }

  record participant {
    /// Call Control ID associated with the partiipant of the conference
    call-control-id: string,
    /// Uniquely identifies the call leg associated with the participant
    call-leg-id: string,
    /// Info about the conference that the participant is in
    conference: participant-conference,
    /// ISO 8601 formatted date of when the participant was created
    created-at: string,
    /// Whether the conference will end and all remaining participants be hung up after the participant leaves the conference.
    end-conference-on-exit: bool,
    /// Uniquely identifies the participant
    id: string,
    /// Whether the participant is muted.
    muted: bool,
    /// Whether the participant is put on_hold.
    on-hold: bool,
    record-type: participant-record-type-enum,
    /// Whether the conference will end after the participant leaves the conference.
    soft-end-conference-on-exit: bool,
    /// The status of the participant with respect to the lifecycle within the conference
    status: participant-status-enum,
    /// ISO 8601 formatted date of when the participant was last updated
    updated-at: string,
    /// Array of unique call_control_ids the participant can whisper to..
    whisper-call-control-ids: list<string>
  }

  /// Info about the conference that the participant is in
  record participant-conference {
    /// Uniquely identifies the conference
    id: option<string>,
    /// Name of the conference
    name: option<string>
  }

  record retrieve-conference-response {
    data: option<conference>
  }

  record conference-dial-participant-in-response {
    data: option<conference-command-result>
  }

  record conference-command-result {
    result-op: string
  }

  record conference-hold-participants-response {
    data: option<conference-command-result>
  }

  record conference-join-response {
    data: option<conference-command-result>
  }

  record conference-leave-response {
    data: option<conference-command-result>
  }

  record conference-mute-participants-response {
    data: option<conference-command-result>
  }

  record loopcount {
    /// opaque schema; raw JSON
    value: string
  }

  record conference-play-audio-response {
    data: option<conference-command-result>
  }

  record conference-start-recording-response {
    data: option<conference-command-result>
  }

  record conference-stop-recording-response {
    data: option<conference-command-result>
  }

  record conference-speak-text-response {
    data: option<conference-command-result>
  }

  record conference-stop-audio-response {
    data: option<conference-command-result>
  }

  record conference-unhold-participants-response {
    data: option<conference-command-result>
  }

  record conference-unmute-participants-response {
    data: option<conference-command-result>
  }

  record conference-update-response {
    data: option<conference-command-result>
  }

  variant list-conferences-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-conference-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-conference-participants-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant retrieve-conference-error {
    not-found(string),
    other(string)
  }

  variant conference-dial-participant-in-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-hold-participants-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-join-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-leave-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-mute-participants-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-play-audio-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-start-recording-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-stop-recording-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-speak-text-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-stop-audio-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-unhold-participants-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-unmute-participants-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant conference-update-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List conferences
  record list-conferences-params {
    /// If present, conferences will be filtered to those with a matching `name` attribute. Matching is case-sensitive
    filter-name: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-conferences: func(params: list-conferences-params) -> result<list-conferences-response, list-conferences-error>;

  /// Create conference
  record create-conference-params {
    /// Whether a beep sound should be played when participants join and/or leave the conference.
    beep-enabled: option<create-conference-request-beep-enabled-enum>,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Toggle background comfort noise.
    comfort-noise: option<bool>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// Time length (minutes) after which the conference will end.
    duration-minutes: option<s32>,
    /// The URL of a file to be played to participants joining the conference. The URL can point to either a WAV or MP3 file. hold_media_name and hold_audio_url cannot be used together in one request. Takes effect only when "start_conference_on_create" is set to "false".
    hold-audio-url: option<string>,
    /// The media_name of a file to be played to participants joining the conference. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file. Takes effect only when "start_conference_on_create" is set to "false".
    hold-media-name: option<string>,
    /// Name of the conference
    name: string,
    /// Whether the conference should be started on creation. If the conference isn't started all participants that join are automatically put on hold. Defaults to "true".
    start-conference-on-create: option<bool>
  }
  create-conference: func(params: create-conference-params) -> result<create-conference-response, create-conference-error>;

  /// List conference participants
  record list-conference-participants-params {
    /// Uniquely identifies the conference by id
    conference-id: string,
    /// If present, participants will be filtered to those who are/are not muted
    filter-muted: option<bool>,
    /// If present, participants will be filtered to those who are/are not put on hold
    filter-on-hold: option<bool>,
    /// If present, participants will be filtered to those who are whispering or are not
    filter-whispering: option<bool>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-conference-participants: func(params: list-conference-participants-params) -> result<list-conference-participants-response, list-conference-participants-error>;

  /// Retrieve a conference
  record retrieve-conference-params {
    /// Uniquely identifies the conference by id
    id: string
  }
  retrieve-conference: func(params: retrieve-conference-params) -> result<retrieve-conference-response, retrieve-conference-error>;

  /// Dial a new participant into a conference
  record conference-dial-participant-in-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// The `from` number to be used as the caller id presented to the destination (`to` number).
    from-op: string,
    /// Whether the participant should be put on hold immediately after joining the conference.
    hold: option<bool>,
    /// The URL of a file to be played to the participant when they are put on hold after joining the conference. If media_name is also supplied, this is currently ignored. Takes effect only when "start_conference_on_create" is set to "false". This property takes effect only if "hold" is set to "true".
    hold-audio-url: option<string>,
    /// The media_name of a file to be played to the participant when they are put on hold after joining the conference. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file. Takes effect only when "start_conference_on_create" is set to "false". This property takes effect only if "hold" is set to "true".
    hold-media-name: option<string>,
    /// Whether the participant should be muted immediately after joining the conference.
    mute: option<bool>,
    /// Whether the conference should be started after the participant joins the conference.
    start-conference-on-enter: option<bool>,
    /// Sets the joining participant as a supervisor for the conference. A conference can have multiple supervisors. "barge" means the supervisor enters the conference as a normal participant. This is the same as "none". "monitor" means the supervisor is muted but can hear all participants. "whisper" means that only the specified "whisper_call_control_ids" can hear the supervisor. Defaults to "none".
    supervisor-role: option<conference-call-request-supervisor-role-enum>,
    /// The DID or SIP URI to dial out and bridge to the given call.
    to: string,
    /// Array of unique call_control_ids the joining supervisor can whisper to. If none provided, the supervisor will join the conference as a monitoring participant only.
    whisper-call-control-ids: option<list<string>>
  }
  conference-dial-participant-in: func(params: conference-dial-participant-in-params) -> result<conference-dial-participant-in-response, conference-dial-participant-in-error>;

  /// Hold conference participants
  record conference-hold-participants-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// The URL of a file to be played to the participants when they are put on hold. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// List of unique identifiers and tokens for controlling the call. When empty all participants will be placed on hold.
    call-control-ids: option<list<string>>,
    /// The media_name of a file to be played to the participants when they are put on hold. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>
  }
  conference-hold-participants: func(params: conference-hold-participants-params) -> result<conference-hold-participants-response, conference-hold-participants-error>;

  /// Join a conference
  record conference-join-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Whether a beep sound should be played when the participant joins and/or leaves the conference. Can be used to override the conference-level setting.
    beep-enabled: option<create-conference-request-beep-enabled-enum>,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// Whether the conference should end and all remaining participants be hung up after the participant leaves the conference. Defaults to "false".
    end-conference-on-exit: option<bool>,
    /// Whether the participant should be put on hold immediately after joining the conference. Defaults to "false".
    hold: option<bool>,
    /// The URL of a file to be played to the participant when they are put on hold after joining the conference. hold_media_name and hold_audio_url cannot be used together in one request. Takes effect only when "start_conference_on_create" is set to "false". This property takes effect only if "hold" is set to "true".
    hold-audio-url: option<string>,
    /// The media_name of a file to be played to the participant when they are put on hold after joining the conference. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file. Takes effect only when "start_conference_on_create" is set to "false". This property takes effect only if "hold" is set to "true".
    hold-media-name: option<string>,
    /// Whether the participant should be muted immediately after joining the conference. Defaults to "false".
    mute: option<bool>,
    /// Whether the conference should end after the participant leaves the conference. NOTE this doesn't hang up the other participants. Defaults to "false".
    soft-end-conference-on-exit: option<bool>,
    /// Whether the conference should be started after the participant joins the conference. Defaults to "false".
    start-conference-on-enter: option<bool>,
    /// Sets the joining participant as a supervisor for the conference. A conference can have multiple supervisors. "barge" means the supervisor enters the conference as a normal participant. This is the same as "none". "monitor" means the supervisor is muted but can hear all participants. "whisper" means that only the specified "whisper_call_control_ids" can hear the supervisor. Defaults to "none".
    supervisor-role: option<conference-call-request-supervisor-role-enum>,
    /// Array of unique call_control_ids the joining supervisor can whisper to. If none provided, the supervisor will join the conference as a monitoring participant only.
    whisper-call-control-ids: option<list<string>>
  }
  conference-join: func(params: conference-join-params) -> result<conference-join-response, conference-join-error>;

  /// Leave a conference
  record conference-leave-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Whether a beep sound should be played when the participant leaves the conference. Can be used to override the conference-level setting.
    beep-enabled: option<create-conference-request-beep-enabled-enum>,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>
  }
  conference-leave: func(params: conference-leave-params) -> result<conference-leave-response, conference-leave-error>;

  /// Mute conference participants
  record conference-mute-participants-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Array of unique identifiers and tokens for controlling the call. When empty all participants will be muted.
    call-control-ids: option<list<string>>
  }
  conference-mute-participants: func(params: conference-mute-participants-params) -> result<conference-mute-participants-response, conference-mute-participants-error>;

  /// Play audio to conference participants
  record conference-play-audio-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// The URL of a file to be played back in the conference. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// List of call control ids identifying participants the audio file should be played to. If not given, the audio file will be played to the entire conference.
    call-control-ids: option<list<string>>,
    loop: option<loopcount>,
    /// The media_name of a file to be played back in the conference. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>
  }
  conference-play-audio: func(params: conference-play-audio-params) -> result<conference-play-audio-response, conference-play-audio-error>;

  /// Conference recording start
  record conference-start-recording-params {
    /// Specifies the conference to record by id or name
    id: string,
    /// When `dual`, final audio file will be stereo recorded with the first leg on channel A, and the rest on channel B.
    channels: start-recording-request-channels-enum,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The audio file format used when storing the call recording. Can be either `mp3` or `wav`.
    format: start-recording-request-format-enum,
    /// Defines the maximum length for the recording in seconds. Minimum value is 0. Maximum value is 14400. Default is 0 (infinite)
    max-length: option<s32>,
    /// If enabled, a beep sound will be played at the start of a recording.
    play-beep: option<bool>
  }
  conference-start-recording: func(params: conference-start-recording-params) -> result<conference-start-recording-response, conference-start-recording-error>;

  /// Conference recording stop
  record conference-stop-recording-params {
    /// Specifies the conference to stop the recording for by id or name
    id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  conference-stop-recording: func(params: conference-stop-recording-params) -> result<conference-stop-recording-response, conference-stop-recording-error>;

  /// Speak text to conference participants
  record conference-speak-text-params {
    /// Specifies the conference by id or name
    id: string,
    /// Call Control IDs of participants who will hear the spoken text. When empty all participants will hear the spoken text.
    call-control-ids: option<list<string>>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// The language used to speak the text.
    language: conference-speak-request-language-enum,
    /// The text or SSML to be converted into speech. There is a 5,000 character limit.
    payload: string,
    /// The type of the provided payload. The payload can either be plain text, or Speech Synthesis Markup Language (SSML).
    payload-type: option<conference-speak-request-payload-type-enum>,
    /// The gender of the voice used to speak the text.
    voice: conference-speak-request-voice-enum
  }
  conference-speak-text: func(params: conference-speak-text-params) -> result<conference-speak-text-response, conference-speak-text-error>;

  /// Stop audio being played on the conference
  record conference-stop-audio-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// List of call control ids identifying participants the audio file should stop be played to. If not given, the audio will be stoped to the entire conference.
    call-control-ids: option<list<string>>
  }
  conference-stop-audio: func(params: conference-stop-audio-params) -> result<conference-stop-audio-response, conference-stop-audio-error>;

  /// Unhold conference participants
  record conference-unhold-participants-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// List of unique identifiers and tokens for controlling the call. Enter each call control ID to be unheld.
    call-control-ids: list<string>
  }
  conference-unhold-participants: func(params: conference-unhold-participants-params) -> result<conference-unhold-participants-response, conference-unhold-participants-error>;

  /// Unmute conference participants
  record conference-unmute-participants-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// List of unique identifiers and tokens for controlling the call. Enter each call control ID to be unmuted. When empty all participants will be unmuted.
    call-control-ids: option<list<string>>
  }
  conference-unmute-participants: func(params: conference-unmute-participants-params) -> result<conference-unmute-participants-response, conference-unmute-participants-error>;

  /// Update conference participant
  record conference-update-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// Sets the participant as a supervisor for the conference. A conference can have multiple supervisors. "barge" means the supervisor enters the conference as a normal participant. This is the same as "none". "monitor" means the supervisor is muted but can hear all participants. "whisper" means that only the specified "whisper_call_control_ids" can hear the supervisor. Defaults to "none".
    supervisor-role: conference-call-request-supervisor-role-enum,
    /// Array of unique call_control_ids the supervisor can whisper to. If none provided, the supervisor will join the conference as a monitoring participant only.
    whisper-call-control-ids: option<list<string>>
  }
  conference-update: func(params: conference-update-params) -> result<conference-update-response, conference-update-error>;

}

interface connections {
  enum list-connections-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum connection-webhook-api-version-enum {
    v1,
    v2,
  }

  record list-connections-response {
    data: option<list<connection>>,
    meta: option<pagination-meta>
  }

  record connection {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the specific resource.
    id: option<string>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent.
    webhook-event-url: option<string>
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// Identifies the associated outbound voice profile.
  record outbound-voice-profile-id {
    /// opaque schema; raw JSON
    value: string
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record retrieve-connection-response {
    data: option<connection>
  }

  variant list-connections-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant retrieve-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List connections
  record list-connections-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, connections with <code>connection_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-connections-sort-enum>
  }
  list-connections: func(params: list-connections-params) -> result<list-connections-response, list-connections-error>;

  /// Retrieve a connection
  record retrieve-connection-params {
    /// IP Connection ID
    id: string
  }
  retrieve-connection: func(params: retrieve-connection-params) -> result<retrieve-connection-response, retrieve-connection-error>;

}

interface credential-connections {
  enum list-credential-connections-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum credential-inbound-ani-number-format-enum {
    e-v164,
    e-v164-v2,
    e-v164-national,
    e-v164-national-v2,
  }

  enum credential-inbound-dnis-number-format-enum {
    e164,
    e164-v2,
    national,
    sip-username,
  }

  enum credential-outbound-ani-override-type-enum {
    always,
    normal,
    emergency,
  }

  enum credential-outbound-t38-reinvite-source-enum {
    telnyx,
    customer,
    disabled,
    passthru,
    caller-passthru,
    callee-passthru,
  }

  enum credential-connection-sip-uri-calling-preference-enum {
    disabled,
    unrestricted,
    internal,
  }

  enum credential-connection-webhook-api-version-enum {
    v1,
    v2,
  }

  record list-credential-connections-response {
    data: option<list<credential-connection>>,
    meta: option<pagination-meta>
  }

  record credential-connection {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// ISO-8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    /// Identifies the type of resource.
    id: option<string>,
    inbound: option<credential-inbound>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<credential-outbound>,
    /// The password to be used as part of the credentials. Must be 8 to 128 characters long.
    password: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    rtcp-settings: option<connection-rtcp-settings>,
    /// This feature enables inbound SIP URI calls to your Credential Auth Connection. If enabled for all (unrestricted) then anyone who calls the SIP URI <your-username>@telnyx.com will be connected to your Connection. You can also choose to allow only calls that are originated on any Connections under your account (internal).
    sip-uri-calling-preference: option<credential-connection-sip-uri-calling-preference-enum>,
    /// ISO-8601 formatted date indicating when the resource was updated.
    updated-at: option<string>,
    /// The user name to be used as part of the credentials. Must be 4-32 characters long and alphanumeric values only (no spaces or special characters).
    user-name: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<credential-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
  record dtmf-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Enable use of SRTP or ZRTP for encryption. Valid values are those listed or null. Cannot be set to non-null if the transport_portocol is TLS.
  record encrypted-media {
    /// opaque schema; raw JSON
    value: string
  }

  record credential-inbound {
    /// This setting allows you to set the format with which the caller's number (ANI) is sent for inbound phone calls.
    ani-number-format: option<credential-inbound-ani-number-format-enum>,
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Defines the list of codecs that Telnyx will send for inbound calls to a specific number on your portal account, in priority order. This only works when the Connection the number is assigned to uses Media Handling mode: default. OPUS and H.264 codecs are available only when using TCP or TLS transport for SIP.
    codecs: option<list<string>>,
    dnis-number-format: option<credential-inbound-dnis-number-format-enum>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, inbound phone calls will receive ISUP parameters via SIP headers. (Only when available and only when using TCP or TLS transport.)
    isup-headers-enabled: option<bool>,
    /// Enable PRACK messages as defined in RFC3262.
    prack-enabled: option<bool>,
    /// By default, Telnyx does not send caller-id information when the caller has chosen to hide this information. When this option is enabled, Telnyx will send the SIP header Privacy:id plus the caller-id information so that the receiver side can choose when to hide it.
    privacy-zone-enabled: option<bool>,
    /// Defaults to true.
    sip-compact-headers-enabled: option<bool>,
    /// Time(sec) before aborting if connection is not made.
    timeout-v1xx-secs: option<s32>,
    /// Time(sec) before aborting if call is unanswered (min: 1, max: 600).
    timeout-v2xx-secs: option<string>
  }

  record credential-outbound {
    /// Set a phone number as the ani_override value to override caller id number on outbound calls.
    ani-override: option<string>,
    /// Specifies when we apply your ani_override setting. Only applies when ani_override is not blank.
    ani-override-type: option<credential-outbound-ani-override-type-enum>,
    /// Forces all SIP calls originated on this connection to be "parked" instead of "bridged" to the destination specified on the URI. Parked calls will return ringback to the caller and will await for a Call Control command to define which action will be taken next.
    call-parking-enabled: option<bool>,
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, ringback will not wait for indication before sending ringback tone to calling party.
    instant-ringback-enabled: option<bool>,
    /// A 2-character country code specifying the country whose national dialing rules should be used. For example, if set to `US` then any US number can be dialed without preprending +1 to the number. When left blank, Telnyx will try US and GB dialing rules, in that order, by default.
    localization: option<string>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>,
    /// This setting only affects connections with Fax-type Outbound Voice Profiles. The setting dictates whether or not Telnyx sends a t.38 reinvite.<br/><br/> By default, Telnyx will send the re-invite. If set to `customer`, the caller is expected to send the t.38 reinvite.
    t38-reinvite-source: option<credential-outbound-t38-reinvite-source-enum>
  }

  /// Identifies the associated outbound voice profile.
  record outbound-voice-profile-id {
    /// opaque schema; raw JSON
    value: string
  }

  record connection-rtcp-settings {
    /// BETA - Enable the capture and storage of RTCP messages to create QoS reports on the Telnyx Mission Control Portal.
    capture-enabled: option<bool>,
    /// RTCP port by default is rtp+1, it can also be set to rtcp-mux
    port: option<string>,
    /// RTCP reports are sent to customers based on the frequency set. Frequency is in seconds and it can be set to values from 5 to 3000 seconds.
    report-frequency-secs: option<s32>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-credential-connection-response {
    data: option<credential-connection>
  }

  record retrieve-credential-connection-response {
    data: option<credential-connection>
  }

  record update-credential-connection-response {
    data: option<credential-connection>
  }

  record delete-credential-connection-response {
    data: option<credential-connection>
  }

  variant list-credential-connections-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-credential-connection-error {
    unprocessable-entity(string),
    other(string)
  }

  variant retrieve-credential-connection-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-credential-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-credential-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List credential connections
  record list-credential-connections-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, connections with <code>connection_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-credential-connections-sort-enum>
  }
  list-credential-connections: func(params: list-credential-connections-params) -> result<list-credential-connections-response, list-credential-connections-error>;

  /// Create a credential connection
  record create-credential-connection-params {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: string,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<credential-inbound>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<credential-outbound>,
    /// The password to be used as part of the credentials. Must be 8 to 128 characters long.
    password: string,
    rtcp-settings: option<connection-rtcp-settings>,
    /// This feature enables inbound SIP URI calls to your Credential Auth Connection. If enabled for all (unrestricted) then anyone who calls the SIP URI <your-username>@telnyx.com will be connected to your Connection. You can also choose to allow only calls that are originated on any Connections under your account (internal).
    sip-uri-calling-preference: option<credential-connection-sip-uri-calling-preference-enum>,
    /// The user name to be used as part of the credentials. Must be 4-32 characters long and alphanumeric values only (no spaces or special characters).
    user-name: string,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<credential-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  create-credential-connection: func(params: create-credential-connection-params) -> result<create-credential-connection-response, create-credential-connection-error>;

  /// Retrieve a credential connection
  record retrieve-credential-connection-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-credential-connection: func(params: retrieve-credential-connection-params) -> result<retrieve-credential-connection-response, retrieve-credential-connection-error>;

  /// Update a credential connection
  record update-credential-connection-params {
    /// Identifies the resource.
    id: string,
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<credential-inbound>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<credential-outbound>,
    /// The password to be used as part of the credentials. Must be 8 to 128 characters long.
    password: option<string>,
    rtcp-settings: option<connection-rtcp-settings>,
    /// This feature enables inbound SIP URI calls to your Credential Auth Connection. If enabled for all (unrestricted) then anyone who calls the SIP URI <your-username>@telnyx.com will be connected to your Connection. You can also choose to allow only calls that are originated on any Connections under your account (internal).
    sip-uri-calling-preference: option<credential-connection-sip-uri-calling-preference-enum>,
    /// The user name to be used as part of the credentials. Must be 4-32 characters long and alphanumeric values only (no spaces or special characters).
    user-name: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<credential-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  update-credential-connection: func(params: update-credential-connection-params) -> result<update-credential-connection-response, update-credential-connection-error>;

  /// Delete a credential connection
  record delete-credential-connection-params {
    /// Identifies the resource.
    id: string
  }
  delete-credential-connection: func(params: delete-credential-connection-params) -> result<delete-credential-connection-response, delete-credential-connection-error>;

}

interface detail-records {
  record search-response {
    data: option<list<detail-record>>,
    meta: option<pagination-meta>
  }

  /// An object following one of the schemas published in https://developers.telnyx.com/docs/api/v2/detail-records
  record detail-record {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  /// Search detail records
  record search-params {
    /// Filter by the given record type
    filter-record-type: string,
    /// Filter by the given user-friendly date range
    filter-date-range: option<string>,
    /// Filter records
    filter: option<string>,
    /// Page number
    page-number: option<s32>,
    /// Page size
    page-size: option<s32>,
    /// Specifies the sort order for results
    sort: option<list<string>>
  }
  search: func(params: search-params) -> result<search-response, string>;

}

interface documents {
  enum doc-service-document-status-enum {
    pending,
    verified,
    denied,
  }

  record list-document-links-response {
    data: option<list<doc-service-document-link>>,
    meta: option<pagination-meta>
  }

  record doc-service-document-link {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>,
    /// Identifies the associated document.
    document-id: option<string>,
    /// The linked resource's record type.
    linked-record-type: option<string>,
    /// Identifies the linked resource.
    linked-resource-id: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record list-documents-response {
    data: option<list<doc-service-document>>,
    meta: option<pagination-meta>
  }

  record doc-service-document {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>,
    /// The document's content_type.
    content-type: option<string>,
    /// The filename of the document.
    filename: option<string>,
    /// The document's SHA256 hash provided for optional verification purposes.
    sha256: option<string>,
    /// Indicates the document's filesize
    size: option<doc-service-document-size>,
    /// Indicates the current document reviewing status
    status: option<doc-service-document-status-enum>
  }

  /// Indicates the document's filesize
  record doc-service-document-size {
    /// The number of bytes
    amount: option<s32>,
    /// Identifies the unit
    unit: option<string>
  }

  record create-document-response {
    data: option<doc-service-document>
  }

  record retrieve-document-response {
    data: option<doc-service-document>
  }

  record update-document-response {
    data: option<doc-service-document>
  }

  record delete-document-response {
    data: option<doc-service-document>
  }

  variant create-document-error {
    unprocessable-entity(string),
    other(string)
  }

  /// List all document links
  record list-document-links-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Identifies the associated document to filter on.
    filter-document-id: option<string>,
    /// The `linked_record_type` of the document to filter on.
    filter-linked-record-type: option<string>,
    /// The `linked_resource_id` of the document to filter on.
    filter-linked-resource-id: option<string>
  }
  list-document-links: func(params: list-document-links-params) -> result<list-document-links-response, string>;

  /// List all documents
  record list-documents-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-documents: func(params: list-documents-params) -> result<list-documents-response, string>;

  /// Upload a document
  record create-document-params {
    /// opaque schema; raw JSON
    value: string
  }
  create-document: func(params: create-document-params) -> result<create-document-response, create-document-error>;

  /// Retrieve a document
  record retrieve-document-params {
    /// The id of the resource.
    id: string
  }
  retrieve-document: func(params: retrieve-document-params) -> result<retrieve-document-response, string>;

  /// Update a document
  record update-document-params {
    /// The id of the resource.
    id: string,
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the resource.
    id-v2: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>,
    /// The document's content_type.
    content-type: option<string>,
    /// The filename of the document.
    filename: option<string>,
    /// The document's SHA256 hash provided for optional verification purposes.
    sha256: option<string>,
    /// Indicates the document's filesize
    size: option<doc-service-document-size>,
    /// Indicates the current document reviewing status
    status: option<doc-service-document-status-enum>
  }
  update-document: func(params: update-document-params) -> result<update-document-response, string>;

  /// Delete a document
  record delete-document-params {
    /// The id of the resource.
    id: string
  }
  delete-document: func(params: delete-document-params) -> result<delete-document-response, string>;

  /// Download a document
  record download-doc-service-document-params {
    /// The id of the resource.
    id: string
  }
  download-doc-service-document: func(params: download-doc-service-document-params) -> result<string, string>;

}

interface programmable-fax-applications {
  enum list-fax-applications-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum fax-application-inbound-sip-subdomain-receive-settings-enum {
    only-my-connections,
    from-anyone,
  }

  record list-fax-applications-response {
    data: option<list<fax-application>>,
    meta: option<pagination-meta>
  }

  record fax-application {
    active: option<connection-active>,
    anchorsite-override: option<anchorsite-override>,
    application-name: option<application-name>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    id: option<int-id>,
    inbound: option<fax-application-inbound>,
    outbound: option<fax-application-outbound>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>,
    webhook-event-failover-url: option<webhook-event-failover-url>,
    webhook-event-url: option<webhook-event-url>,
    webhook-timeout-secs: option<webhook-timeout-secs>
  }

  /// Specifies whether the connection can be used.
  record connection-active {
    /// opaque schema; raw JSON
    value: string
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// A user-assigned name to help manage the application.
  record application-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Uniquely identifies the resource.
  record int-id {
    /// opaque schema; raw JSON
    value: string
  }

  record fax-application-inbound {
    /// When set, this will limit the number of concurrent inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<fax-application-inbound-sip-subdomain-receive-settings-enum>
  }

  record fax-application-outbound {
    /// When set, this will limit the number of concurrent outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>
  }

  /// Identifies the associated outbound voice profile.
  record outbound-voice-profile-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
  record webhook-event-failover-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
  record webhook-event-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Specifies how many seconds to wait before timing out a webhook.
  record webhook-timeout-secs {
    /// opaque schema; raw JSON
    value: string
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-fax-application-request-inbound {
    /// When set, this will limit the number of concurrent inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<fax-application-inbound-sip-subdomain-receive-settings-enum>
  }

  record create-fax-application-request-outbound {
    /// When set, this will limit the number of concurrent outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>
  }

  record create-fax-application-response {
    data: option<fax-application>
  }

  record get-fax-application-response {
    data: option<fax-application>
  }

  record update-fax-application-request-inbound {
    /// When set, this will limit the number of concurrent inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<fax-application-inbound-sip-subdomain-receive-settings-enum>
  }

  record update-fax-application-request-outbound {
    /// When set, this will limit the number of concurrent outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>
  }

  record update-fax-application-response {
    data: option<fax-application>
  }

  record delete-fax-application-response {
    data: option<fax-application>
  }

  variant list-fax-applications-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-fax-application-error {
    unprocessable-entity(string),
    other(string)
  }

  variant get-fax-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-fax-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-fax-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List all Fax Applications
  record list-fax-applications-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, applications with <code>application_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-application-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-fax-applications-sort-enum>
  }
  list-fax-applications: func(params: list-fax-applications-params) -> result<list-fax-applications-response, list-fax-applications-error>;

  /// Creates a Fax Application
  record create-fax-application-params {
    active: option<connection-active>,
    anchorsite-override: option<anchorsite-override>,
    application-name: application-name,
    inbound: option<create-fax-application-request-inbound>,
    outbound: option<create-fax-application-request-outbound>,
    webhook-event-failover-url: option<webhook-event-failover-url>,
    webhook-event-url: webhook-event-url,
    webhook-timeout-secs: option<webhook-timeout-secs>
  }
  create-fax-application: func(params: create-fax-application-params) -> result<create-fax-application-response, create-fax-application-error>;

  /// Retrieve a Fax Application
  record get-fax-application-params {
    /// Identifies the resource.
    id: string
  }
  get-fax-application: func(params: get-fax-application-params) -> result<get-fax-application-response, get-fax-application-error>;

  /// Update a Fax Application
  record update-fax-application-params {
    /// Identifies the resource.
    id: string,
    active: option<connection-active>,
    anchorsite-override: option<anchorsite-override>,
    application-name: application-name,
    inbound: option<update-fax-application-request-inbound>,
    outbound: option<update-fax-application-request-outbound>,
    webhook-event-failover-url: option<webhook-event-failover-url>,
    webhook-event-url: webhook-event-url,
    webhook-timeout-secs: option<webhook-timeout-secs>
  }
  update-fax-application: func(params: update-fax-application-params) -> result<update-fax-application-response, update-fax-application-error>;

  /// Deletes a Fax Application
  record delete-fax-application-params {
    /// Identifies the resource.
    id: string
  }
  delete-fax-application: func(params: delete-fax-application-params) -> result<delete-fax-application-response, delete-fax-application-error>;

}

interface programmable-fax-commands {
  enum fax-direction-enum {
    inbound,
    outbound,
  }

  enum fax-record-type-enum {
    fax,
  }

  enum fax-status-enum {
    queued,
    media-processed,
    sending,
    delivered,
    failed,
    initiated,
    receiving,
    media-processing,
    received,
  }

  record list-faxes-response {
    data: option<list<fax>>,
    meta: option<list-faxes-response-meta>
  }

  record fax {
    /// The connection ID to send the fax with.
    connection-id: option<string>,
    /// ISO 8601 timestamp when resource was created
    created-at: option<string>,
    /// The direction of the fax.
    direction: option<fax-direction-enum>,
    /// The phone number, in E.164 format, the fax will be sent from.
    from-op: option<string>,
    /// Identifies the fax.
    id: option<string>,
    /// The media_name of a file used for the fax's media.
    media-name: option<string>,
    /// The URL to the PDF used for the fax's media. If media_name was supplied, this is omitted.
    media-url: option<string>,
    /// The quality of the fax. Can be normal, high, very_high
    quality: option<string>,
    /// Identifies the type of the resource.
    record-type: option<fax-record-type-enum>,
    /// Status of the fax
    status: option<fax-status-enum>,
    /// Should fax media be stored on temporary URL.
    store-media: option<bool>,
    /// If store_media was set to true, this is a link to temporary location. Link expires after 7 days.
    stored-media-url: option<string>,
    /// The phone number, in E.164 format, the fax will be sent to or SIP URI
    to: option<string>,
    /// ISO 8601 timestamp when resource was updated
    updated-at: option<string>,
    /// Optional failover URL that will receive fax webhooks if webhook_url doesn't return a 2XX response
    webhook-failover-url: option<string>,
    /// URL that will receive fax webhooks
    webhook-url: option<string>
  }

  record list-faxes-response-meta {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record send-fax-response {
    data: option<fax>
  }

  record view-fax-response {
    data: option<fax>
  }

  record refresh-fax-response {
    result-op: option<string>
  }

  variant refresh-fax-error {
    not-found(string),
    other(string)
  }

  /// View a list of faxes
  record list-faxes-params {
    /// ISO 8601 date time for filtering faxes created after or on that date
    filter-created-at-gte: option<string>,
    /// ISO 8601 date time for filtering faxes created after that date
    filter-created-at-gt: option<string>,
    /// ISO 8601 formatted date time for filtering faxes created on or before that date
    filter-created-at-lte: option<string>,
    /// ISO 8601 formatted date time for filtering faxes created before that date
    filter-created-at-lt: option<string>,
    /// The direction, inbound or outbound, for filtering faxes sent from this account
    filter-direction-eq: option<string>,
    /// The phone number, in E.164 format for filtering faxes sent from this number
    filter-from-eq: option<string>,
    /// Number of fax resourcxes for the single page returned
    page-size: option<s32>,
    /// Number of the page to be retrieved
    page-number: option<s32>
  }
  list-faxes: func(params: list-faxes-params) -> result<list-faxes-response, string>;

  /// Send a fax
  record send-fax-params {
    /// The connection ID to send the fax with.
    connection-id: string,
    /// The phone number, in E.164 format, the fax will be sent from.
    from-op: string,
    /// The media_name of a file to be used for the fax's media. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. media_url and media_name can't be submitted together.
    media-name: option<string>,
    /// The URL to the PDF used for the fax's media. media_url and media_name can't be submitted together.
    media-url: option<string>,
    /// The quality of the fax. Can be normal, high, very_high.
    quality: option<string>,
    /// Should fax media be stored on temporary URL. It does not support media_name, they can't be submitted together.
    store-media: option<bool>,
    /// The phone number, in E.164 format, the fax will be sent to or SIP URI.
    to: string
  }
  send-fax: func(params: send-fax-params) -> result<send-fax-response, string>;

  /// View a fax
  record view-fax-params {
    /// The unique identifier of a fax.
    id: string
  }
  view-fax: func(params: view-fax-params) -> result<view-fax-response, string>;

  /// Delete a fax
  record delete-fax-params {
    /// The unique identifier of a fax.
    id: string
  }
  delete-fax: func(params: delete-fax-params) -> result<string, string>;

  /// Refresh a fax
  record refresh-fax-params {
    /// The unique identifier of a fax.
    id: string
  }
  refresh-fax: func(params: refresh-fax-params) -> result<refresh-fax-response, refresh-fax-error>;

}

interface fqdn-connections {
  enum list-fqdn-connections-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum inbound-fqdn-ani-number-format-enum {
    e-v164,
    e-v164-v2,
    e-v164-national,
    e-v164-national-v2,
  }

  enum inbound-fqdn-default-routing-method-enum {
    sequential,
    round-robin,
  }

  enum inbound-fqdn-dnis-number-format-enum {
    e164,
    e164-v2,
    national,
    sip-username,
  }

  enum inbound-fqdn-sip-region-enum {
    us,
    europe,
    australia,
  }

  enum inbound-fqdn-sip-subdomain-receive-settings-enum {
    only-my-connections,
    from-anyone,
  }

  enum fqdn-connection-webhook-api-version-enum {
    v1,
    v2,
  }

  record list-fqdn-connections-response {
    data: option<list<fqdn-connection>>,
    meta: option<pagination-meta>
  }

  record fqdn-connection {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: string,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    /// Identifies the resource.
    id: option<string>,
    inbound: option<inbound-fqdn>,
    /// Enable on-net T38 if you prefer that the sender and receiver negotiate T38 directly when both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call according to each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    rtcp-settings: option<connection-rtcp-settings>,
    transport-protocol: option<fqdn-connection-transport-protocol>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<fqdn-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
  record dtmf-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Enable use of SRTP or ZRTP for encryption. Valid values are those listed or null. Cannot be set to non-null if the transport_portocol is TLS.
  record encrypted-media {
    /// opaque schema; raw JSON
    value: string
  }

  record inbound-fqdn {
    /// This setting allows you to set the format with which the caller's number (ANI) is sent for inbound phone calls.
    ani-number-format: option<inbound-fqdn-ani-number-format-enum>,
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Defines the list of codecs that Telnyx will send for inbound calls to a specific number on your portal account, in priority order. This only works when the Connection the number is assigned to uses Media Handling mode: default. OPUS and H.264 codecs are available only when using TCP or TLS transport for SIP.
    codecs: option<list<string>>,
    /// Default routing method to be used when a number is associated with the connection. Must be one of the routing method types or null, other values are not allowed.
    default-routing-method: option<inbound-fqdn-default-routing-method-enum>,
    dnis-number-format: option<inbound-fqdn-dnis-number-format-enum>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, inbound phone calls will receive ISUP parameters via SIP headers. (Only when available and only when using TCP or TLS transport.)
    isup-headers-enabled: option<bool>,
    /// Enable PRACK messages as defined in RFC3262.
    prack-enabled: option<bool>,
    /// By default, Telnyx does not send caller-id information when the caller has chosen to hide this information. When this option is enabled, Telnyx will send the SIP header Privacy:id plus the caller-id information so that the receiver side can choose when to hide it.
    privacy-zone-enabled: option<bool>,
    /// Defaults to true.
    sip-compact-headers-enabled: option<bool>,
    /// Selects which `sip_region` to receive inbound calls from. If null, the default region (US) will be used.
    sip-region: option<inbound-fqdn-sip-region-enum>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<inbound-fqdn-sip-subdomain-receive-settings-enum>,
    /// Time(sec) before aborting if connection is not made.
    timeout-v1xx-secs: option<s32>,
    /// Time(sec) before aborting if call is unanswered (min: 1, max: 600).
    timeout-v2xx-secs: option<s32>
  }

  record connection-rtcp-settings {
    /// BETA - Enable the capture and storage of RTCP messages to create QoS reports on the Telnyx Mission Control Portal.
    capture-enabled: option<bool>,
    /// RTCP port by default is rtp+1, it can also be set to rtcp-mux
    port: option<string>,
    /// RTCP reports are sent to customers based on the frequency set. Frequency is in seconds and it can be set to values from 5 to 3000 seconds.
    report-frequency-secs: option<s32>
  }

  /// One of UDP, TLS, or TCP. Applies only to connections with IP authentication or FQDN authentication.
  record fqdn-connection-transport-protocol {
    /// opaque schema; raw JSON
    value: string
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-fqdn-connection-response {
    data: option<fqdn-connection>
  }

  record retrieve-fqdn-connection-response {
    data: option<fqdn-connection>
  }

  record update-fqdn-connection-response {
    data: option<fqdn-connection>
  }

  record delete-fqdn-connection-response {
    data: option<fqdn-connection>
  }

  variant list-fqdn-connections-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-fqdn-connection-error {
    unprocessable-entity(string),
    other(string)
  }

  variant retrieve-fqdn-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-fqdn-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-fqdn-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List FQDN connections
  record list-fqdn-connections-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, connections with <code>connection_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-fqdn-connections-sort-enum>
  }
  list-fqdn-connections: func(params: list-fqdn-connections-params) -> result<list-fqdn-connections-response, list-fqdn-connections-error>;

  /// Create an FQDN connection
  record create-fqdn-connection-params {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: string,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<inbound-fqdn>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    rtcp-settings: option<connection-rtcp-settings>,
    transport-protocol: option<fqdn-connection-transport-protocol>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<fqdn-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  create-fqdn-connection: func(params: create-fqdn-connection-params) -> result<create-fqdn-connection-response, create-fqdn-connection-error>;

  /// Retrieve an FQDN connection
  record retrieve-fqdn-connection-params {
    /// FQDN Connection ID
    id: string
  }
  retrieve-fqdn-connection: func(params: retrieve-fqdn-connection-params) -> result<retrieve-fqdn-connection-response, retrieve-fqdn-connection-error>;

  /// Update an FQDN connection
  record update-fqdn-connection-params {
    /// FQDN Connection ID
    id: string,
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<inbound-fqdn>,
    /// Enable on-net T38 if you prefer that the sender and receiver negotiate T38 directly when both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call according to each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    rtcp-settings: option<connection-rtcp-settings>,
    transport-protocol: option<fqdn-connection-transport-protocol>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<fqdn-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  update-fqdn-connection: func(params: update-fqdn-connection-params) -> result<update-fqdn-connection-response, update-fqdn-connection-error>;

  /// Delete an FQDN connection
  record delete-fqdn-connection-params {
    /// FQDN Connection ID
    id: string
  }
  delete-fqdn-connection: func(params: delete-fqdn-connection-params) -> result<delete-fqdn-connection-response, delete-fqdn-connection-error>;

}

interface fqd-ns {
  record list-fqdns-response {
    data: option<list<fqdn>>,
    meta: option<pagination-meta>
  }

  record fqdn {
    /// ID of the FQDN connection to which this FQDN is attached.
    connection-id: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// The DNS record type for the FQDN. For cases where a port is not set, the DNS record type must be 'srv'. For cases where a port is set, the DNS record type must be 'a'. If the DNS record type is 'a' and a port is not specified, 5060 will be used.
    dns-record-type: option<string>,
    /// FQDN represented by this resource.
    fqdn: option<string>,
    /// Identifies the resource.
    id: option<string>,
    /// Port to use when connecting to this FQDN.
    port: option<s32>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-fqdn-response {
    data: option<fqdn>
  }

  record retrieve-fqdn-response {
    data: option<fqdn>
  }

  record update-fqdn-response {
    data: option<fqdn>
  }

  record delete-fqdn-response {
    data: option<fqdn>
  }

  variant list-fqdns-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant create-fqdn-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant retrieve-fqdn-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant update-fqdn-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-fqdn-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// List FQDNs
  record list-fqdns-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// ID of the FQDN connection to which the FQDN belongs.
    filter-connection-id: option<string>,
    /// FQDN represented by the resource.
    filter-fqdn: option<string>,
    /// Port to use when connecting to the FQDN.
    filter-port: option<s32>,
    /// DNS record type used by the FQDN.
    filter-dns-record-type: option<string>
  }
  list-fqdns: func(params: list-fqdns-params) -> result<list-fqdns-response, list-fqdns-error>;

  /// Create an FQDN
  record create-fqdn-params {
    /// ID of the FQDN connection to which this IP should be attached.
    connection-id: string,
    /// The DNS record type for the FQDN. For cases where a port is not set, the DNS record type must be 'srv'. For cases where a port is set, the DNS record type must be 'a'. If the DNS record type is 'a' and a port is not specified, 5060 will be used.
    dns-record-type: string,
    /// FQDN represented by this resource.
    fqdn: string,
    /// Port to use when connecting to this FQDN.
    port: option<s32>
  }
  create-fqdn: func(params: create-fqdn-params) -> result<create-fqdn-response, create-fqdn-error>;

  /// Retrieve an FQDN
  record retrieve-fqdn-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-fqdn: func(params: retrieve-fqdn-params) -> result<retrieve-fqdn-response, retrieve-fqdn-error>;

  /// Update an FQDN
  record update-fqdn-params {
    /// Identifies the resource.
    id: string,
    /// ID of the FQDN connection to which this IP should be attached.
    connection-id: option<string>,
    /// The DNS record type for the FQDN. For cases where a port is not set, the DNS record type must be 'srv'. For cases where a port is set, the DNS record type must be 'a'. If the DNS record type is 'a' and a port is not specified, 5060 will be used.
    dns-record-type: option<string>,
    /// FQDN represented by this resource.
    fqdn: option<string>,
    /// Port to use when connecting to this FQDN.
    port: option<s32>
  }
  update-fqdn: func(params: update-fqdn-params) -> result<update-fqdn-response, update-fqdn-error>;

  /// Delete an FQDN
  record delete-fqdn-params {
    /// Identifies the resource.
    id: string
  }
  delete-fqdn: func(params: delete-fqdn-params) -> result<delete-fqdn-response, delete-fqdn-error>;

}

interface inventory-level {
  enum create-inventory-coverage-request-filter-number-type-enum {
    did,
    toll-free,
  }

  enum create-inventory-coverage-request-filter-phone-number-type-enum {
    local,
    toll-free,
    national,
    mobile,
    landline,
    shared-cost,
  }

  enum create-inventory-coverage-request-filter-country-code-enum {
    us,
    ca,
    gb,
  }

  enum create-inventory-coverage-request-filter-group-by-enum {
    rate-center,
    locality,
    npa,
    national-destination-code,
    nxx,
  }

  enum inventory-coverage-coverage-type-enum {
    number,
    block,
  }

  enum inventory-coverage-phone-number-type-enum {
    local,
    toll-free,
    national,
    landline,
    shared-cost,
    mobile,
  }

  record create-inventory-coverage-request-response {
    data: option<list<inventory-coverage>>,
    meta: option<inventory-coverage-metadata>
  }

  record inventory-coverage {
    count: option<s32>,
    coverage-type: option<inventory-coverage-coverage-type-enum>,
    group: option<string>,
    group-type: option<string>,
    number-range: option<s32>,
    number-type: option<create-inventory-coverage-request-filter-number-type-enum>,
    phone-number-type: option<inventory-coverage-phone-number-type-enum>,
    record-type: option<string>
  }

  record inventory-coverage-metadata {
    total-results: option<s32>
  }

  /// Create an inventory coverage request
  record create-inventory-coverage-request-params {
    filter-npa: option<s32>,
    filter-nxx: option<s32>,
    filter-administrative-area: option<string>,
    filter-number-type: option<create-inventory-coverage-request-filter-number-type-enum>,
    filter-phone-number-type: option<create-inventory-coverage-request-filter-phone-number-type-enum>,
    filter-country-code: option<create-inventory-coverage-request-filter-country-code-enum>,
    filter-count: option<bool>,
    filter-group-by: create-inventory-coverage-request-filter-group-by-enum
  }
  create-inventory-coverage-request: func(params: create-inventory-coverage-request-params) -> result<create-inventory-coverage-request-response, string>;

}

interface ip-connections {
  enum list-ip-connections-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum inbound-ip-ani-number-format-enum {
    e-v164,
    e-v164-v2,
    e-v164-national,
    e-v164-national-v2,
  }

  enum inbound-ip-default-routing-method-enum {
    sequential,
    round-robin,
  }

  enum inbound-ip-dnis-number-format-enum {
    e164,
    e164-v2,
    national,
    sip-username,
  }

  enum inbound-ip-sip-region-enum {
    us,
    europe,
    australia,
  }

  enum inbound-ip-sip-subdomain-receive-settings-enum {
    only-my-connections,
    from-anyone,
  }

  enum outbound-ip-ani-override-type-enum {
    always,
    normal,
    emergency,
  }

  enum outbound-ip-ip-authentication-method-enum {
    tech-prefixp-charge-info,
    token,
  }

  enum outbound-ip-t38-reinvite-source-enum {
    telnyx,
    customer,
    disabled,
    passthru,
    caller-passthru,
    callee-passthru,
  }

  enum ip-connection-transport-protocol-enum {
    udp,
    tcp,
    tls,
  }

  enum ip-connection-webhook-api-version-enum {
    v1,
    v2,
  }

  record list-ip-connections-response {
    data: option<list<ip-connection>>,
    meta: option<pagination-meta>
  }

  record ip-connection {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    /// Identifies the type of resource.
    id: option<string>,
    inbound: option<inbound-ip>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<outbound-ip>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    rtcp-settings: option<connection-rtcp-settings>,
    /// One of UDP, TLS, or TCP. Applies only to connections with IP authentication or FQDN authentication.
    transport-protocol: option<ip-connection-transport-protocol-enum>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<ip-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
  record dtmf-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Enable use of SRTP or ZRTP for encryption. Valid values are those listed or null. Cannot be set to non-null if the transport_portocol is TLS.
  record encrypted-media {
    /// opaque schema; raw JSON
    value: string
  }

  record inbound-ip {
    /// This setting allows you to set the format with which the caller's number (ANI) is sent for inbound phone calls.
    ani-number-format: option<inbound-ip-ani-number-format-enum>,
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Defines the list of codecs that Telnyx will send for inbound calls to a specific number on your portal account, in priority order. This only works when the Connection the number is assigned to uses Media Handling mode: default. OPUS and H.264 codecs are available only when using TCP or TLS transport for SIP.
    codecs: option<list<string>>,
    /// The default primary IP to use for the number. Only settable if the connection is
    ///               of IP authentication type. Value must be the ID of an authorized IP set on the connection.
    default-primary-ip-id: option<string>,
    /// Default routing method to be used when a number is associated with the connection. Must be one of the routing method types or left blank, other values are not allowed.
    default-routing-method: option<inbound-ip-default-routing-method-enum>,
    /// The default secondary IP to use for the number. Only settable if the connection is
    ///               of IP authentication type. Value must be the ID of an authorized IP set on the connection.
    default-secondary-ip-id: option<string>,
    /// The default tertiary IP to use for the number. Only settable if the connection is
    ///               of IP authentication type. Value must be the ID of an authorized IP set on the connection.
    default-tertiary-ip-id: option<string>,
    dnis-number-format: option<inbound-ip-dnis-number-format-enum>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, inbound phone calls will receive ISUP parameters via SIP headers. (Only when available and only when using TCP or TLS transport.)
    isup-headers-enabled: option<bool>,
    /// Enable PRACK messages as defined in RFC3262.
    prack-enabled: option<bool>,
    /// By default, Telnyx does not send caller-id information when the caller has chosen to hide this information. When this option is enabled, Telnyx will send the SIP header Privacy:id plus the caller-id information so that the receiver side can choose when to hide it.
    privacy-zone-enabled: option<bool>,
    /// Defaults to true.
    sip-compact-headers-enabled: option<bool>,
    /// Selects which `sip_region` to receive inbound calls from. If null, the default region (US) will be used.
    sip-region: option<inbound-ip-sip-region-enum>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<inbound-ip-sip-subdomain-receive-settings-enum>,
    /// Time(sec) before aborting if connection is not made.
    timeout-v1xx-secs: option<s32>,
    /// Time(sec) before aborting if call is unanswered (min: 1, max: 600).
    timeout-v2xx-secs: option<s32>
  }

  record outbound-ip {
    /// Set a phone number as the ani_override value to override caller id number on outbound calls.
    ani-override: option<string>,
    /// Specifies when we apply your ani_override setting. Only applies when ani_override is not blank.
    ani-override-type: option<outbound-ip-ani-override-type-enum>,
    /// Forces all SIP calls originated on this connection to be "parked" instead of "bridged" to the destination specified on the URI. Parked calls will return ringback to the caller and will await for a Call Control command to define which action will be taken next.
    call-parking-enabled: option<bool>,
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, ringback will not wait for indication before sending ringback tone to calling party.
    instant-ringback-enabled: option<bool>,
    ip-authentication-method: option<outbound-ip-ip-authentication-method-enum>,
    ip-authentication-token: option<string>,
    /// A 2-character country code specifying the country whose national dialing rules should be used. For example, if set to `US` then any US number can be dialed without preprending +1 to the number. When left blank, Telnyx will try US and GB dialing rules, in that order, by default.
    localization: option<string>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>,
    /// This setting only affects connections with Fax-type Outbound Voice Profiles. The setting dictates whether or not Telnyx sends a t.38 reinvite.<br/><br/> By default, Telnyx will send the re-invite. If set to `customer`, the caller is expected to send the t.38 reinvite.
    t38-reinvite-source: option<outbound-ip-t38-reinvite-source-enum>,
    /// Numerical chars only, exactly 4 characters.
    tech-prefix: option<string>
  }

  /// Identifies the associated outbound voice profile.
  record outbound-voice-profile-id {
    /// opaque schema; raw JSON
    value: string
  }

  record connection-rtcp-settings {
    /// BETA - Enable the capture and storage of RTCP messages to create QoS reports on the Telnyx Mission Control Portal.
    capture-enabled: option<bool>,
    /// RTCP port by default is rtp+1, it can also be set to rtcp-mux
    port: option<string>,
    /// RTCP reports are sent to customers based on the frequency set. Frequency is in seconds and it can be set to values from 5 to 3000 seconds.
    report-frequency-secs: option<s32>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-inbound-ip-request {
    /// This setting allows you to set the format with which the caller's number (ANI) is sent for inbound phone calls.
    ani-number-format: option<inbound-ip-ani-number-format-enum>,
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Defines the list of codecs that Telnyx will send for inbound calls to a specific number on your portal account, in priority order. This only works when the Connection the number is assigned to uses Media Handling mode: default. OPUS and H.264 codecs are available only when using TCP or TLS transport for SIP.
    codecs: option<list<string>>,
    /// Default routing method to be used when a number is associated with the connection. Must be one of the routing method types or left blank, other values are not allowed.
    default-routing-method: option<inbound-ip-default-routing-method-enum>,
    dnis-number-format: option<inbound-ip-dnis-number-format-enum>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, inbound phone calls will receive ISUP parameters via SIP headers. (Only when available and only when using TCP or TLS transport.)
    isup-headers-enabled: option<bool>,
    /// Enable PRACK messages as defined in RFC3262.
    prack-enabled: option<bool>,
    /// By default, Telnyx does not send caller-id information when the caller has chosen to hide this information. When this option is enabled, Telnyx will send the SIP header Privacy:id plus the caller-id information so that the receiver side can choose when to hide it.
    privacy-zone-enabled: option<bool>,
    /// Defaults to true.
    sip-compact-headers-enabled: option<bool>,
    /// Selects which `sip_region` to receive inbound calls from. If null, the default region (US) will be used.
    sip-region: option<inbound-ip-sip-region-enum>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<inbound-ip-sip-subdomain-receive-settings-enum>,
    /// Time(sec) before aborting if connection is not made.
    timeout-v1xx-secs: option<s32>,
    /// Time(sec) before aborting if call is unanswered (min: 1, max: 600).
    timeout-v2xx-secs: option<s32>
  }

  record create-ip-connection-response {
    data: option<ip-connection>
  }

  record retrieve-ip-connection-response {
    data: option<ip-connection>
  }

  record update-ip-connection-response {
    data: option<ip-connection>
  }

  record delete-ip-connection-response {
    data: option<ip-connection>
  }

  variant list-ip-connections-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-ip-connection-error {
    unprocessable-entity(string),
    other(string)
  }

  variant retrieve-ip-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-ip-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-ip-connection-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List Ip connections
  record list-ip-connections-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, connections with <code>connection_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-ip-connections-sort-enum>
  }
  list-ip-connections: func(params: list-ip-connections-params) -> result<list-ip-connections-response, list-ip-connections-error>;

  /// Create an Ip connection
  record create-ip-connection-params {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<create-inbound-ip-request>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<outbound-ip>,
    rtcp-settings: option<connection-rtcp-settings>,
    /// One of UDP, TLS, or TCP. Applies only to connections with IP authentication or FQDN authentication.
    transport-protocol: option<ip-connection-transport-protocol-enum>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<ip-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  create-ip-connection: func(params: create-ip-connection-params) -> result<create-ip-connection-response, create-ip-connection-error>;

  /// Retrieve an Ip connection
  record retrieve-ip-connection-params {
    /// IP Connection ID
    id: string
  }
  retrieve-ip-connection: func(params: retrieve-ip-connection-params) -> result<retrieve-ip-connection-response, retrieve-ip-connection-error>;

  /// Update an Ip connection
  record update-ip-connection-params {
    /// Identifies the type of resource.
    id: string,
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<inbound-ip>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<outbound-ip>,
    rtcp-settings: option<connection-rtcp-settings>,
    /// One of UDP, TLS, or TCP. Applies only to connections with IP authentication or FQDN authentication.
    transport-protocol: option<ip-connection-transport-protocol-enum>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<ip-connection-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  update-ip-connection: func(params: update-ip-connection-params) -> result<update-ip-connection-response, update-ip-connection-error>;

  /// Delete an Ip connection
  record delete-ip-connection-params {
    /// Identifies the type of resource.
    id: string
  }
  delete-ip-connection: func(params: delete-ip-connection-params) -> result<delete-ip-connection-response, delete-ip-connection-error>;

}

interface i-ps {
  record list-ips-response {
    data: option<list<ip>>
  }

  record ip {
    /// ID of the IP Connection to which this IP should be attached.
    connection-id: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the type of resource.
    id: option<string>,
    /// IP adddress represented by this resource.
    ip-address: option<string>,
    /// Port to use when connecting to this IP.
    port: option<s32>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record create-ip-response {
    data: option<ip>
  }

  record retrieve-ip-response {
    data: option<ip>
  }

  record update-ip-response {
    data: option<ip>
  }

  record delete-ip-response {
    data: option<ip>
  }

  variant list-ips-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant create-ip-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant retrieve-ip-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant update-ip-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-ip-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// List Ips
  record list-ips-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// ID of the IP Connection to which this IP should be attached.
    filter-connection-id: option<string>,
    /// IP adddress represented by this resource.
    filter-ip-address: option<string>,
    /// Port to use when connecting to this IP.
    filter-port: option<s32>
  }
  list-ips: func(params: list-ips-params) -> result<list-ips-response, list-ips-error>;

  /// Create an Ip
  record create-ip-params {
    /// ID of the IP Connection to which this IP should be attached.
    connection-id: option<string>,
    /// IP adddress represented by this resource.
    ip-address: string,
    /// Port to use when connecting to this IP.
    port: option<s32>
  }
  create-ip: func(params: create-ip-params) -> result<create-ip-response, create-ip-error>;

  /// Retrieve an Ip
  record retrieve-ip-params {
    /// Identifies the type of resource.
    id: string
  }
  retrieve-ip: func(params: retrieve-ip-params) -> result<retrieve-ip-response, retrieve-ip-error>;

  /// Update an Ip
  record update-ip-params {
    /// Identifies the type of resource.
    id: string,
    /// ID of the IP Connection to which this IP should be attached.
    connection-id: option<string>,
    /// IP adddress represented by this resource.
    ip-address: string,
    /// Port to use when connecting to this IP.
    port: option<s32>
  }
  update-ip: func(params: update-ip-params) -> result<update-ip-response, update-ip-error>;

  /// Delete an Ip
  record delete-ip-params {
    /// Identifies the type of resource.
    id: string
  }
  delete-ip: func(params: delete-ip-params) -> result<delete-ip-response, delete-ip-error>;

}

interface reports {
  enum ledger-billing-group-report-record-type-enum {
    ledger-billing-group-report,
  }

  enum ledger-billing-group-report-status-enum {
    pending,
    complete,
    failed,
    deleted,
  }

  record create-ledger-billing-group-report-response {
    data: option<ledger-billing-group-report>
  }

  record ledger-billing-group-report {
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the type of resource.
    id: option<string>,
    /// Uniquely identifies the organization that owns the resource.
    organization-id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<ledger-billing-group-report-record-type-enum>,
    /// External url of the ledger billing group report, if the status is complete
    report-url: option<string>,
    /// Status of the ledger billing group report
    status: option<ledger-billing-group-report-status-enum>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record retrieve-ledger-billing-group-report-response {
    data: option<ledger-billing-group-report>
  }

  /// Create a ledger billing group report
  record create-ledger-billing-group-report-params {
    /// Month of the ledger billing group report
    month: option<s32>,
    /// Year of the ledger billing group report
    year: option<s32>
  }
  create-ledger-billing-group-report: func(params: create-ledger-billing-group-report-params) -> result<create-ledger-billing-group-report-response, string>;

  /// Retrieve a ledger billing group report
  record retrieve-ledger-billing-group-report-params {
    /// The id of the ledger billing group report
    id: string
  }
  retrieve-ledger-billing-group-report: func(params: retrieve-ledger-billing-group-report-params) -> result<retrieve-ledger-billing-group-report-response, string>;

}

interface managed-accounts {
  enum list-managed-accounts-sort-enum {
    created-at,
    email,
  }

  enum managed-account-balance-record-type-enum {
    balance,
  }

  enum managed-account-record-type-enum {
    managed-account,
  }

  record list-managed-accounts-response {
    data: option<list<managed-account>>,
    meta: option<pagination-meta>
  }

  record managed-account {
    /// The managed account's V2 API access key
    api-key: string,
    /// The managed account's V1 API token
    api-token: string,
    /// The manager account's email, which serves as the V1 API user identifier
    api-user: string,
    balance: option<managed-account-balance>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: string,
    /// The managed account's email.
    email: string,
    /// Uniquely identifies the managed account.
    id: string,
    /// The ID of the manager account associated with the managed account.
    manager-account-id: string,
    /// The organization the managed account is associated with.
    organization-name: option<string>,
    /// Identifies the type of the resource.
    record-type: managed-account-record-type-enum,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: string
  }

  record managed-account-balance {
    /// Available amount to spend (balance + credit limit)
    available-credit: option<string>,
    /// The account's current balance.
    balance: option<string>,
    /// The account's credit limit.
    credit-limit: option<string>,
    /// The ISO 4217 currency identifier.
    currency: option<string>,
    /// Identifies the type of the resource.
    record-type: option<managed-account-balance-record-type-enum>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-managed-account-response {
    data: option<managed-account>
  }

  record retrieve-managed-account-response {
    data: option<managed-account>
  }

  record disable-managed-account-response {
    data: option<managed-account>
  }

  record enable-managed-account-response {
    data: option<managed-account>
  }

  variant list-managed-accounts-error {
    unauthorized(string),
    other(string)
  }

  variant create-managed-account-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant retrieve-managed-account-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant disable-managed-account-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant enable-managed-account-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// Lists accounts managed by the current user.
  record list-managed-accounts-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, email containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-email-contains: option<string>,
    /// If present, only returns results with the <code>email</code> matching exactly the value given.
    filter-email-eq: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-managed-accounts-sort-enum>
  }
  list-managed-accounts: func(params: list-managed-accounts-params) -> result<list-managed-accounts-response, list-managed-accounts-error>;

  /// Create a new managed account.
  record create-managed-account-params {
    /// The name of the business for which the new managed account is being created, that will be used as the managed accounts's organization's name.
    business-name: string,
    /// The email address for the managed account. If not provided, the email address will be generated based on the email address of the manager account.
    email: option<string>,
    /// Password for the managed account. If a password is not supplied, the account will not be able to be signed into directly. (A password reset may still be performed later to enable sign-in via password.)
    password: option<string>
  }
  create-managed-account: func(params: create-managed-account-params) -> result<create-managed-account-response, create-managed-account-error>;

  /// Retrieve a managed account
  record retrieve-managed-account-params {
    /// Managed Account User ID
    id: string
  }
  retrieve-managed-account: func(params: retrieve-managed-account-params) -> result<retrieve-managed-account-response, retrieve-managed-account-error>;

  /// Disables a managed account
  record disable-managed-account-params {
    /// Managed Account User ID
    id: string
  }
  disable-managed-account: func(params: disable-managed-account-params) -> result<disable-managed-account-response, disable-managed-account-error>;

  /// Enables a managed account
  record enable-managed-account-params {
    /// Managed Account User ID
    id: string
  }
  enable-managed-account: func(params: enable-managed-account-params) -> result<enable-managed-account-response, enable-managed-account-error>;

}

interface media-storage-api {
  record list-media-response {
    data: option<list<media-resource>>,
    meta: option<pagination-meta>
  }

  record media-resource {
    /// ISO 8601 formatted date of when the media resource was created
    created-at: option<string>,
    /// ISO 8601 formatted date of when the media resource will expire and be deleted.
    expires-at: option<string>,
    /// Uniquely identifies a media resource.
    media-name: option<string>,
    /// ISO 8601 formatted date of when the media resource was last updated
    updated-at: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-media-response {
    data: option<media-resource>
  }

  record get-media-response {
    data: option<media-resource>
  }

  record update-media-response {
    data: option<media-resource>
  }

  /// List uploaded media
  list-media: func() -> result<list-media-response, string>;

  /// Upload media
  record create-media-params {
    /// The unique identifier of a file.
    media-name: option<string>,
    /// The URL where the media to be stored in Telnyx network is currently hosted. The maximum allowed size is 20 MB.
    media-url: string,
    /// The number of seconds after which the media resource will be deleted, defaults to 2 days.
    ttl-secs: option<s32>
  }
  create-media: func(params: create-media-params) -> result<create-media-response, string>;

  /// Retrieve stored media
  record get-media-params {
    /// Uniquely identifies a media resource.
    media-name: string
  }
  get-media: func(params: get-media-params) -> result<get-media-response, string>;

  /// Update stored media
  record update-media-params {
    /// Uniquely identifies a media resource.
    media-name: string,
    /// The URL where the media to be stored in Telnyx network is currently hosted. The maximum allowed size is 20 MB.
    media-url: option<string>,
    /// The number of seconds after which the media resource will be deleted, defaults to 2 days.
    ttl-secs: option<s32>
  }
  update-media: func(params: update-media-params) -> result<update-media-response, string>;

  /// Deletes stored media
  record delete-media-params {
    /// Uniquely identifies a media resource.
    media-name: string
  }
  delete-media: func(params: delete-media-params) -> result<string, string>;

  /// Download stored media
  record download-media-params {
    /// Uniquely identifies a media resource.
    media-name: string
  }
  download-media: func(params: download-media-params) -> result<string, string>;

}

interface mdr-search-beta {
  enum mdr-detail-response-currency-enum {
    aud,
    cad,
    eur,
    gbp,
    usd,
  }

  enum mdr-detail-response-message-type-enum {
    sms,
    mms,
  }

  enum mdr-detail-response-status-enum {
    gw-timeout,
    delivered,
    dlr-unconfirmed,
    dlr-timeout,
    received,
    gw-reject,
    failed,
  }

  record direction {
    /// opaque schema; raw JSON
    value: string
  }

  /// Message status
  record message-status {
    /// opaque schema; raw JSON
    value: string
  }

  /// type of the message
  record message-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Used product
  record product {
    /// opaque schema; raw JSON
    value: string
  }

  record mdr-get-detail-response {
    data: option<list<mdr-detail-response>>,
    meta: option<pagination-meta>
  }

  record mdr-detail-response {
    /// The destination number for a call, or the callee
    cld: option<string>,
    /// The number associated with the person initiating the call, or the caller
    cli: option<string>,
    /// Final cost. Cost is calculated as rate * parts
    cost: option<string>,
    /// Message sent time
    created-at: option<string>,
    /// Currency of the rate and cost
    currency: option<mdr-detail-response-currency-enum>,
    /// Direction of message - inbound or outbound.
    direction: option<string>,
    /// Id of message detail record
    id: option<string>,
    /// Type of message
    message-type: option<mdr-detail-response-message-type-enum>,
    /// Number of parts this message has. Max number of character is 160. If message contains more characters then that it will be broken down in multiple parts
    parts: option<f64>,
    /// Configured profile name. New profiles can be created and configured on Telnyx portal
    profile-name: option<string>,
    /// Rate applied to the message
    rate: option<string>,
    record-type: option<string>,
    /// Message status
    status: option<mdr-detail-response-status-enum>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record mdr-message-body-response {
    data: option<message-body>
  }

  record message-body {
    /// Text of the message. This is available only for last 7 days
    message-body: option<string>,
    record-type: option<string>
  }

  /// Fetch messaging detail records.
  record get-paginated-mdrs-params {
    /// Start date
    start-date: string,
    /// End date
    end-date: string,
    id: option<string>,
    direction: option<direction>,
    outbound-profile-id: option<string>,
    cld: option<string>,
    cli: option<string>,
    status: option<message-status>,
    message-type: option<message-type>,
    country-iso: option<string>,
    error: option<string>,
    normalized-carrier: option<string>,
    tag: option<string>,
    mcc: option<string>,
    mnc: option<string>,
    product: option<product>,
    /// Page number
    page-number: option<s32>,
    /// Size of the page
    page-size: option<s32>,
    sort: option<list<string>>
  }
  get-paginated-mdrs: func(params: get-paginated-mdrs-params) -> result<mdr-get-detail-response, string>;

  /// Fetch message body by id.
  record get-mdr-message-body-params {
    /// Message unique identifier
    id: string
  }
  get-mdr-message-body: func(params: get-mdr-message-body-params) -> result<mdr-message-body-response, string>;

}

interface messages {
  enum create-message-request-type-op-enum {
    sms,
    mms,
  }

  enum outbound-message-payload-direction-enum {
    outbound,
  }

  enum outbound-message-payload-from-op-line-type-enum {
    wireline,
    wireless,
    vo-wi-fi,
    vo-ip,
    pre-paid-wireless,
    empty,
  }

  enum outbound-message-payload-record-type-enum {
    message,
  }

  enum outbound-message-payload-to-item-status-enum {
    queued,
    sending,
    sent,
    expired,
    sending-failed,
    delivery-unconfirmed,
    delivered,
    delivery-failed,
  }

  /// Receiving address (+E.164 formatted phone number or short code).
  record to-number {
    /// opaque schema; raw JSON
    value: string
  }

  record create-message-response {
    data: option<outbound-message-payload>
  }

  record outbound-message-payload {
    /// ISO 8601 formatted date indicating when the message was finalized.
    completed-at: option<string>,
    cost: option<outbound-message-payload-cost>,
    /// The direction of the message. Inbound messages are sent to you whereas outbound messages are sent from you.
    direction: option<outbound-message-payload-direction-enum>,
    /// Encoding scheme used for the message body.
    encoding: option<string>,
    /// These errors may point at addressees when referring to unsuccessful/unconfirmed delivery statuses.
    errors: option<list<error>>,
    from-op: option<outbound-message-payload-from-op>,
    /// Identifies the type of resource.
    id: option<string>,
    media: option<list<outbound-message-payload-media-item>>,
    /// Unique identifier for a messaging profile.
    messaging-profile-id: option<string>,
    /// The id of the organization the messaging profile belongs to.
    organization-id: option<string>,
    /// Number of parts into which the message's body must be split.
    parts: option<s32>,
    /// ISO 8601 formatted date indicating when the message request was received.
    received-at: option<string>,
    /// Identifies the type of the resource.
    record-type: option<outbound-message-payload-record-type-enum>,
    /// ISO 8601 formatted date indicating when the message was sent.
    sent-at: option<string>,
    /// Subject of multimedia message
    subject: option<string>,
    /// Tags associated with the resource.
    tags: option<list<string>>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: option<list<outbound-message-payload-to-item>>,
    /// The type of message.
    type-op: option<create-message-request-type-op-enum>,
    /// Message must be out of the queue by this time or else it will be discarded and marked as 'sending_failed'. Once the message moves out of the queue, this field will be nulled
    valid-until: option<string>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }

  record outbound-message-payload-cost {
    /// The amount deducted from your account.
    amount: option<string>,
    /// The ISO 4217 currency identifier.
    currency: option<string>
  }

  record error {
    code: string,
    detail: option<string>,
    meta: option<error-meta>,
    source: option<error-source>,
    title: string
  }

  record error-meta {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record error-source {
    /// Indicates which query parameter caused the error.
    parameter: option<string>,
    /// JSON pointer (RFC6901) to the offending entity.
    pointer: option<string>
  }

  record outbound-message-payload-from-op {
    /// The carrier of the receiver.
    carrier: option<string>,
    /// The line-type of the receiver.
    line-type: option<outbound-message-payload-from-op-line-type-enum>,
    /// Sending address (+E.164 formatted phone number, alphanumeric sender ID, or short code).
    phone-number: option<string>
  }

  record outbound-message-payload-media-item {
    /// The MIME type of the requested media.
    content-type: option<string>,
    /// The SHA256 hash of the requested media.
    sha256: option<string>,
    /// The size of the requested media.
    size: option<s32>,
    /// The url of the media requested to be sent.
    url: option<string>
  }

  record outbound-message-payload-to-item {
    /// The carrier of the receiver.
    carrier: option<string>,
    /// The line-type of the receiver.
    line-type: option<outbound-message-payload-from-op-line-type-enum>,
    /// Receiving address (+E.164 formatted phone number or short code).
    phone-number: option<string>,
    /// The delivery status of the message.
    status: option<outbound-message-payload-to-item-status-enum>
  }

  record create-long-code-message-response {
    data: option<outbound-message-payload>
  }

  record create-number-pool-message-response {
    data: option<outbound-message-payload>
  }

  record create-short-code-message-response {
    data: option<outbound-message-payload>
  }

  record retrieve-message-response {
    data: option<outbound-message-payload>
  }

  /// Send a message
  record create-message-params {
    /// Automatically detect if an SMS message is unusually long and exceeds a recommended limit of message parts.
    auto-detect: option<bool>,
    /// Sending address (+E.164 formatted phone number, alphanumeric sender ID, or short code).
    /// 
    from-op: option<string>,
    /// A list of media URLs. The total media size must be less than 1 MB.
    /// 
    media-urls: option<list<string>>,
    /// Unique identifier for a messaging profile.
    /// 
    messaging-profile-id: option<string>,
    /// Subject of multimedia message
    subject: option<string>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: to-number,
    /// The protocol for sending the message, either SMS or MMS.
    type-op: option<create-message-request-type-op-enum>,
    /// If the profile this number is associated with has webhooks, use them for delivery notifications. If webhooks are also specified on the message itself, they will be attempted first, then those on the profile.
    use-profile-webhooks: option<bool>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }
  create-message: func(params: create-message-params) -> result<create-message-response, string>;

  /// Send a long code message
  record create-long-code-message-params {
    /// Automatically detect if an SMS message is unusually long and exceeds a recommended limit of message parts.
    auto-detect: option<bool>,
    /// Phone number, in +E.164 format, used to send the message.
    from-op: string,
    /// A list of media URLs. The total media size must be less than 1 MB.
    /// 
    media-urls: option<list<string>>,
    /// Subject of multimedia message
    subject: option<string>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: to-number,
    /// The protocol for sending the message, either SMS or MMS.
    type-op: option<create-message-request-type-op-enum>,
    /// If the profile this number is associated with has webhooks, use them for delivery notifications. If webhooks are also specified on the message itself, they will be attempted first, then those on the profile.
    use-profile-webhooks: option<bool>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }
  create-long-code-message: func(params: create-long-code-message-params) -> result<create-long-code-message-response, string>;

  /// Send a message using number pool
  record create-number-pool-message-params {
    /// Automatically detect if an SMS message is unusually long and exceeds a recommended limit of message parts.
    auto-detect: option<bool>,
    /// A list of media URLs. The total media size must be less than 1 MB.
    /// 
    media-urls: option<list<string>>,
    /// Unique identifier for a messaging profile.
    messaging-profile-id: string,
    /// Subject of multimedia message
    subject: option<string>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: to-number,
    /// The protocol for sending the message, either SMS or MMS.
    type-op: option<create-message-request-type-op-enum>,
    /// If the profile this number is associated with has webhooks, use them for delivery notifications. If webhooks are also specified on the message itself, they will be attempted first, then those on the profile.
    use-profile-webhooks: option<bool>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }
  create-number-pool-message: func(params: create-number-pool-message-params) -> result<create-number-pool-message-response, string>;

  /// Send a short code message
  record create-short-code-message-params {
    /// Automatically detect if an SMS message is unusually long and exceeds a recommended limit of message parts.
    auto-detect: option<bool>,
    /// Phone number, in +E.164 format, used to send the message.
    from-op: string,
    /// A list of media URLs. The total media size must be less than 1 MB.
    /// 
    media-urls: option<list<string>>,
    /// Subject of multimedia message
    subject: option<string>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: to-number,
    /// The protocol for sending the message, either SMS or MMS.
    type-op: option<create-message-request-type-op-enum>,
    /// If the profile this number is associated with has webhooks, use them for delivery notifications. If webhooks are also specified on the message itself, they will be attempted first, then those on the profile.
    use-profile-webhooks: option<bool>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }
  create-short-code-message: func(params: create-short-code-message-params) -> result<create-short-code-message-response, string>;

  /// Retrieve a message
  record retrieve-message-params {
    /// The id of the message
    id: string
  }
  retrieve-message: func(params: retrieve-message-params) -> result<retrieve-message-response, string>;

}

interface messaging-hosted-number {
  enum hosted-number-status-enum {
    deleted,
    failed,
    pending,
    successful,
  }

  enum order-status-enum {
    failed,
    pending,
    successful,
  }

  record list-messaging-hosted-number-order-response {
    data: option<list<order>>,
    meta: option<pagination-meta>
  }

  record order {
    /// Resource unique identifier.
    id: option<string>,
    /// Automatically associate the number with this messaging profile ID when the order is complete.
    messaging-profile-id: option<string>,
    phone-numbers: option<list<hosted-number>>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    status: option<order-status-enum>
  }

  record hosted-number {
    /// Identifies the type of resource.
    id: option<string>,
    /// The messaging hosted phone number (+E.164 format)
    phone-number: option<string>,
    record-type: option<string>,
    status: option<hosted-number-status-enum>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-messaging-hosted-number-order-response {
    data: option<order>
  }

  record retrieve-messaging-hosted-number-order-response {
    data: option<order>
  }

  record upload-file-messaging-hosted-number-order-response {
    data: option<order>
  }

  record delete-messaging-hosted-number-response {
    data: option<hosted-number>
  }

  /// List messaging hosted number orders
  record list-messaging-hosted-number-order-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-messaging-hosted-number-order: func(params: list-messaging-hosted-number-order-params) -> result<list-messaging-hosted-number-order-response, string>;

  /// Create a messaging hosted number order
  record create-messaging-hosted-number-order-params {
    /// Automatically associate the number with this messaging profile ID when the order is complete.
    messaging-profile-id: option<string>,
    /// Phone numbers to be used for hosted messaging.
    phone-numbers: option<list<string>>
  }
  create-messaging-hosted-number-order: func(params: create-messaging-hosted-number-order-params) -> result<create-messaging-hosted-number-order-response, string>;

  /// Retrieve a messaging hosted number order
  record retrieve-messaging-hosted-number-order-params {
    /// Identifies the type of resource.
    id: string
  }
  retrieve-messaging-hosted-number-order: func(params: retrieve-messaging-hosted-number-order-params) -> result<retrieve-messaging-hosted-number-order-response, string>;

  /// Upload file required for a messaging hosted number order
  record upload-file-messaging-hosted-number-order-params {
    /// Identifies the type of resource.
    id: string,
    /// Must be the last month's bill with proof of ownership of all of the numbers in the order in PDF format.
    bill: option<string>,
    /// Must be a signed LOA for the numbers in the order in PDF format.
    loa: option<string>
  }
  upload-file-messaging-hosted-number-order: func(params: upload-file-messaging-hosted-number-order-params) -> result<upload-file-messaging-hosted-number-order-response, string>;

  /// Delete a messaging hosted number
  record delete-messaging-hosted-number-params {
    /// Identifies the type of resource.
    id: string
  }
  delete-messaging-hosted-number: func(params: delete-messaging-hosted-number-params) -> result<delete-messaging-hosted-number-response, string>;

}

interface messaging-profiles {
  enum list-messaging-profile-metrics-time-frame-enum {
    v1h,
    v3h,
    v24h,
    v3d,
    v7d,
    v30d,
  }

  enum messaging-profile-high-level-metrics-record-type-enum {
    messaging-profile-metrics,
  }

  enum messaging-profile-record-type-enum {
    messaging-profile,
  }

  enum messaging-profile-webhook-api-version-enum {
    v1,
    v2,
    v2010-v04-v01,
  }

  enum phone-number-with-messaging-settings-record-type-enum {
    messaging-phone-number,
    messaging-settings,
  }

  enum phone-number-with-messaging-settings-type-op-enum {
    long-code,
    toll-free,
    short-code,
    longcode,
    tollfree,
    shortcode,
  }

  enum short-code-record-type-enum {
    short-code,
  }

  record list-messaging-profile-metrics-response {
    data: option<list<messaging-profile-high-level-metrics>>,
    meta: option<pagination-meta>
  }

  record messaging-profile-high-level-metrics {
    inbound: option<messaging-profile-high-level-metrics-inbound>,
    /// Identifies the type of resource.
    messaging-profile-id: option<string>,
    outbound: option<messaging-profile-high-level-metrics-outbound>,
    /// The number of phone numbers associated with the messaging profile.
    phone-numbers: option<f64>,
    /// Identifies the type of the resource.
    record-type: option<messaging-profile-high-level-metrics-record-type-enum>
  }

  record messaging-profile-high-level-metrics-inbound {
    /// The number of inbound messages received.
    received: option<f64>
  }

  record messaging-profile-high-level-metrics-outbound {
    /// The number of outbound messages successfully delivered.
    delivered: option<f64>,
    /// The ratio of messages sent that resulted in errors.
    error-ratio: option<f64>,
    /// The number of outbound messages sent.
    sent: option<f64>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record list-messaging-profiles-response {
    data: option<list<messaging-profile>>,
    meta: option<pagination-meta>
  }

  record messaging-profile {
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// Specifies whether the messaging profile is enabled or not.
    enabled: option<bool>,
    /// Identifies the type of resource.
    id: option<string>,
    /// A user friendly name for the messaging profile.
    name: option<string>,
    number-pool-settings: option<number-pool-settings>,
    /// Identifies the type of the resource.
    record-type: option<messaging-profile-record-type-enum>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>,
    url-shortener-settings: option<url-shortener-settings>,
    /// Secret used to authenticate with v1 endpoints.
    v1-secret: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1, v2, or a legacy 2010-04-01 format.
    webhook-api-version: option<messaging-profile-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this messaging profile will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this messaging profile will be sent.
    webhook-url: option<string>,
    /// Destinations to which the messaging profile is allowed to send. If set to `null`, all destinations will be allowed. Setting a value of `["*"]` has the equivalent effect. The elements in the list must be valid ISO 3166-1 alpha-2 country codes.
    whitelisted-destinations: option<list<string>>
  }

  /// Number Pool allows you to send messages from a pool of numbers of different types, assigning
  /// weights to each type. The pool consists of all the long code and toll free numbers
  /// assigned to the messaging profile.
  /// 
  /// To disable this feature, set the object field to `null`.
  record number-pool-settings {
    /// If set to true, Number Pool will try to choose a sending number with the same area code as the destination
    /// number. If there are no such numbers available, a nunber with a different area code will be chosen. Currently
    geomatch: option<bool>,
    /// Defines the probability weight for a Long Code number to be selected when sending a message.
    /// The higher the weight the higher the probability. The sum of the weights for all number types
    long-code-weight: f64,
    /// If set to true all unhealthy numbers will be automatically excluded from the pool.
    /// Health metrics per number are calculated on a regular basis, taking into account the deliverability
    skip-unhealthy: bool,
    /// If set to true, Number Pool will try to choose the same sending number for all messages to a particular
    /// recipient. If the sending number becomes unhealthy and `skip_unhealthy` is set to true, a new
    sticky-sender: option<bool>,
    /// Defines the probability weight for a Toll Free number to be selected when sending a message.
    /// The higher the weight the higher the probability. The sum of the weights for all number types
    toll-free-weight: f64
  }

  /// The URL shortener feature allows automatic replacement of URLs that were generated using
  /// a public URL shortener service. Some examples include bit.do, bit.ly, goo.gl, ht.ly,
  /// is.gd, ow.ly, rebrand.ly, t.co, tiny.cc, and tinyurl.com. Such URLs are replaced with
  /// with links generated by Telnyx. The use of custom links can improve branding and message
  /// deliverability.
  /// 
  /// To disable this feature, set the object field to `null`.
  record url-shortener-settings {
    /// One of the domains provided by the Telnyx URL shortener service.
    domain: string,
    /// Optional prefix that can be used to identify your brand, and will appear in the Telnyx generated URLs after the domain name.
    prefix: option<string>,
    /// Use the link replacement tool only for links that are specifically blacklisted by Telnyx.
    replace-blacklist-only: option<bool>,
    /// Receive webhooks for when your replaced links are clicked. Webhooks are sent to the webhooks on the messaging profile.
    send-webhooks: option<bool>
  }

  record create-messaging-profile-response {
    data: option<messaging-profile>
  }

  record retrieve-messaging-profile-response {
    data: option<messaging-profile>
  }

  record update-messaging-profile-response {
    data: option<messaging-profile>
  }

  record delete-messaging-profile-response {
    data: option<messaging-profile>
  }

  record retrieve-messaging-profile-detailed-metrics-response {
    data: option<messaging-profile-detailed-metrics>
  }

  record messaging-profile-detailed-metrics {
    detailed: option<list<messaging-profile-detailed-metric>>,
    overview: option<messaging-profile-high-level-metrics>
  }

  record messaging-profile-detailed-metric {
    metrics: option<list<messaging-profile-message-type-metrics>>,
    /// The timestamp of the aggregated data.
    timestamp: option<string>
  }

  record messaging-profile-message-type-metrics {
    /// The number of outbound messages successfully delivered.
    delivered: option<f64>,
    /// The metric type.
    label: option<string>,
    /// The ratio of outbound messages sent that resulted in errors.
    outbound-error-ratio: option<f64>,
    /// The number of inbound messages received.
    received: option<f64>,
    /// The number of outbound messages sent.
    sent: option<f64>
  }

  record list-messaging-profile-phone-numbers-response {
    data: option<list<phone-number-with-messaging-settings>>,
    meta: option<pagination-meta>
  }

  record phone-number-with-messaging-settings {
    /// ISO 3166-1 alpha-2 country code.
    country-code: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// The messaging products that this number can be registered to use
    eligible-messaging-products: option<list<string>>,
    features: option<phone-number-with-messaging-settings-features>,
    health: option<number-health-metrics>,
    /// Identifies the type of resource.
    id: option<string>,
    /// The messaging product that the number is registered to use
    messaging-product: option<string>,
    /// Unique identifier for a messaging profile.
    messaging-profile-id: option<string>,
    /// +E.164 formatted phone number.
    phone-number: option<string>,
    /// Identifies the type of the resource.
    record-type: option<phone-number-with-messaging-settings-record-type-enum>,
    /// The messaging traffic or use case for which the number is currently configured.
    traffic-type: option<string>,
    /// The type of the phone number
    type-op: option<phone-number-with-messaging-settings-type-op-enum>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record phone-number-with-messaging-settings-features {
    mms: option<messaging-feature-set>,
    sms: option<messaging-feature-set>
  }

  /// The set of features available for a specific messaging use case (SMS or MMS). Features
  /// can vary depending on the characteristics the phone number, as well as its current
  /// product configuration.
  record messaging-feature-set {
    /// Send messages to and receive messages from numbers in the same country.
    domestic-two-way: bool,
    /// Receive messages from numbers in other countries.
    international-inbound: bool,
    /// Send messages to numbers in other countries.
    international-outbound: bool
  }

  /// High level health metrics about the number and it's messaging sending patterns.
  record number-health-metrics {
    /// The ratio of messages received to the number of messages sent.
    inbound-outbound-ratio: f64,
    /// The number of messages analyzed for the health metrics.
    message-count: s32,
    /// The ratio of messages blocked for spam to the number of messages attempted.
    spam-ratio: f64,
    /// The ratio of messages sucessfully delivered to the number of messages attempted.
    success-ratio: f64
  }

  record list-messaging-profile-short-codes-response {
    data: option<list<short-code>>,
