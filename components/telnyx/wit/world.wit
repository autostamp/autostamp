    id: string
  }
  create-telephony-credential-token: func(params: create-telephony-credential-token-params) -> result<string, create-telephony-credential-token-error>;

}

interface te-xml-applications {
  enum find-texml-applications-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum texml-application-inbound-sip-subdomain-receive-settings-enum {
    only-my-connections,
    from-anyone,
  }

  enum texml-application-status-callback-method-enum {
    get,
    post,
  }

  record find-texml-applications-response {
    data: option<list<texml-application>>,
    meta: option<pagination-meta>
  }

  record texml-application {
    active: option<connection-active>,
    anchorsite-override: option<anchorsite-override>,
    created-at: option<created-at>,
    dtmf-type: option<dtmf-type>,
    first-command-timeout: option<first-command-timeout>,
    first-command-timeout-secs: option<first-command-timeout-secs>,
    friendly-name: option<application-name>,
    id: option<int-id>,
    inbound: option<texml-application-inbound>,
    outbound: option<texml-application-outbound>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// URL for Telnyx to send requests to containing information about call progress events.
    status-callback: option<string>,
    /// HTTP request method Telnyx should use when requesting the status_callback URL.
    status-callback-method: option<texml-application-status-callback-method-enum>,
    updated-at: option<updated-at>,
    /// URL to which Telnyx will deliver your XML Translator webhooks if we get an error response from your voice_url.
    voice-fallback-url: option<string>,
    /// HTTP request method Telnyx will use to interact with your XML Translator webhooks. Either 'get' or 'post'.
    voice-method: option<texml-application-status-callback-method-enum>,
    /// URL to which Telnyx will deliver your XML Translator webhooks.
    voice-url: option<string>
  }

  /// Specifies whether the connection can be used.
  record connection-active {
    /// opaque schema; raw JSON
    value: string
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// ISO 8601 formatted date indicating when the resource was created.
  record created-at {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
  record dtmf-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Specifies whether calls to phone numbers associated with this connection should hangup after timing out.
  record first-command-timeout {
    /// opaque schema; raw JSON
    value: string
  }

  /// Specifies how many seconds to wait before timing out a dial command.
  record first-command-timeout-secs {
    /// opaque schema; raw JSON
    value: string
  }

  /// A user-assigned name to help manage the application.
  record application-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Uniquely identifies the resource.
  record int-id {
    /// opaque schema; raw JSON
    value: string
  }

  record texml-application-inbound {
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<texml-application-inbound-sip-subdomain-receive-settings-enum>
  }

  record texml-application-outbound {
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>
  }

  /// Identifies the associated outbound voice profile.
  record outbound-voice-profile-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// ISO 8601 formatted date indicating when the resource was updated.
  record updated-at {
    /// opaque schema; raw JSON
    value: string
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-texml-application-request-inbound {
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<texml-application-inbound-sip-subdomain-receive-settings-enum>
  }

  record create-texml-application-request-outbound {
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>
  }

  record create-texml-application-response {
    data: option<texml-application>
  }

  record get-texml-application-response {
    data: option<texml-application>
  }

  record update-texml-application-request-inbound {
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<texml-application-inbound-sip-subdomain-receive-settings-enum>
  }

  record update-texml-application-request-outbound {
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>
  }

  record update-texml-application-response {
    data: option<texml-application>
  }

  record delete-texml-application-response {
    data: option<texml-application>
  }

  variant find-texml-applications-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-texml-application-error {
    unprocessable-entity(string),
    other(string)
  }

  variant get-texml-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-texml-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-texml-application-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List all TeXML Applications
  record find-texml-applications-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, applications with <code>friendly_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-friendly-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<find-texml-applications-sort-enum>
  }
  find-texml-applications: func(params: find-texml-applications-params) -> result<find-texml-applications-response, find-texml-applications-error>;

  /// Creates a TeXML Application
  record create-texml-application-params {
    active: option<connection-active>,
    anchorsite-override: option<anchorsite-override>,
    dtmf-type: option<dtmf-type>,
    first-command-timeout: option<first-command-timeout>,
    first-command-timeout-secs: option<first-command-timeout-secs>,
    friendly-name: application-name,
    inbound: option<create-texml-application-request-inbound>,
    outbound: option<create-texml-application-request-outbound>,
    /// URL for Telnyx to send requests to containing information about call progress events.
    status-callback: option<string>,
    /// HTTP request method Telnyx should use when requesting the status_callback URL.
    status-callback-method: option<texml-application-status-callback-method-enum>,
    /// URL to which Telnyx will deliver your XML Translator webhooks if we get an error response from your voice_url.
    voice-fallback-url: option<string>,
    /// HTTP request method Telnyx will use to interact with your XML Translator webhooks. Either 'get' or 'post'.
    voice-method: option<texml-application-status-callback-method-enum>,
    /// URL to which Telnyx will deliver your XML Translator webhooks.
    voice-url: string
  }
  create-texml-application: func(params: create-texml-application-params) -> result<create-texml-application-response, create-texml-application-error>;

  /// Retrieve a TeXML Application
  record get-texml-application-params {
    /// Identifies the resource.
    id: string
  }
  get-texml-application: func(params: get-texml-application-params) -> result<get-texml-application-response, get-texml-application-error>;

  /// Update a TeXML Application
  record update-texml-application-params {
    /// Identifies the resource.
    id: string,
    active: option<connection-active>,
    anchorsite-override: option<anchorsite-override>,
    dtmf-type: option<dtmf-type>,
    first-command-timeout: option<first-command-timeout>,
    first-command-timeout-secs: option<first-command-timeout-secs>,
    friendly-name: application-name,
    inbound: option<update-texml-application-request-inbound>,
    outbound: option<update-texml-application-request-outbound>,
    /// URL for Telnyx to send requests to containing information about call progress events.
    status-callback: option<string>,
    /// HTTP request method Telnyx should use when requesting the status_callback URL.
    status-callback-method: option<texml-application-status-callback-method-enum>,
    /// URL to which Telnyx will deliver your XML Translator webhooks if we get an error response from your voice_url.
    voice-fallback-url: option<string>,
    /// HTTP request method Telnyx will use to interact with your XML Translator webhooks. Either 'get' or 'post'.
    voice-method: option<texml-application-status-callback-method-enum>,
    /// URL to which Telnyx will deliver your XML Translator webhooks.
    voice-url: string
  }
  update-texml-application: func(params: update-texml-application-params) -> result<update-texml-application-response, update-texml-application-error>;

  /// Deletes a TeXML Application
  record delete-texml-application-params {
    /// Identifies the resource.
    id: string
  }
  delete-texml-application: func(params: delete-texml-application-params) -> result<delete-texml-application-response, delete-texml-application-error>;

}

interface verify {
  enum verification-code-response-data-response-code-enum {
    accepted,
    rejected,
  }

  record list-verifications-response {
    data: list<verification>,
    meta: meta
  }

  record verification {
    /// This is the number of seconds before the call ends, if the verification makes a call. Note: this will override the `default_call_timeout_secs` on the Verify profile.
    call-timeout-secs: option<s32>,
    created-at: option<string>,
    id: option<string>,
    /// +E164 formatted phone number.
    phone-number: option<string>,
    record-type: option<verification-record-type>,
    status: option<verification-status>,
    /// This is the number of seconds before the code of the request is expired. Once this request has expired, the code will no longer verify the user. Note: this will override the `default_verification_timeout_secs` on the Verify profile.
    timeout-secs: option<s32>,
    updated-at: option<string>,
    verification-type: option<verification-type>,
    /// The identifier of the associated Verify profile.
    verify-profile-id: option<string>
  }

  /// The possible verification record types.
  record verification-record-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// The possible statuses of the verification request.
  record verification-status {
    /// opaque schema; raw JSON
    value: string
  }

  /// The possible types of verification.
  record verification-type {
    /// opaque schema; raw JSON
    value: string
  }

  record meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record verification-code-response {
    data: verification-code-response-data
  }

  record verification-code-response-data {
    /// +E164 formatted phone number.
    phone-number: string,
    /// Identifies if the verification code has been accepted or rejected.
    response-code: verification-code-response-data-response-code-enum
  }

  record create-verification-response {
    data: verification
  }

  /// The supported currencies.
  record currencies {
    /// opaque schema; raw JSON
    value: string
  }

  record retrieve-verification-response {
    data: verification
  }

  /// A paginated list of Verify profiles
  record list-verify-profiles-response {
    data: list<profile-response>,
    meta: meta
  }

  record profile-response {
    call: option<profile-call-response>,
    created-at: option<string>,
    flashcall: option<profile-flashcall-response>,
    id: option<string>,
    language: option<string>,
    name: option<string>,
    psd2: option<profile-psd2-response>,
    record-type: option<verification-profile-record-type>,
    sms: option<profile-sms-response>,
    updated-at: option<string>,
    webhook-failover-url: option<string>,
    webhook-url: option<string>,
    whatsapp: option<profile-whatsapp-response>
  }

  record profile-call-response {
    /// Must be less than default_verification_timeout_secs
    default-call-timeout-secs: option<s32>,
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>,
    /// Optionally sets a speech text template when sending the verification code. Uses `{code}` to template in the actual verification code.
    speech-template: option<string>
  }

  record profile-flashcall-response {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  record profile-psd2-response {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  /// The possible verification profile record types.
  record verification-profile-record-type {
    /// opaque schema; raw JSON
    value: string
  }

  record profile-sms-response {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>,
    /// Enables SMS text messaging for the Verify profile.
    messaging-enabled: option<bool>,
    /// Optionally sets a messaging text template when sending the verification code. Uses `{code}` to template in the actual verification code.
    messaging-template: option<string>,
    /// Enables RCS messaging for the Verify profile.
    rcs-enabled: option<bool>,
    /// Enables VSMS for the Verify profile.
    vsms-enabled: option<bool>
  }

  record profile-whatsapp-response {
    /// The name that identifies the application requesting 2fa in the verification message.
    app-name: option<string>,
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  record create-verify-profile-call-request {
    /// Must be less than default_verification_timeout_secs
    default-call-timeout-secs: option<s32>,
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>,
    /// Optionally sets a speech text template when sending the verification code. Uses `{code}` to template in the actual verification code.
    speech-template: option<string>
  }

  record create-verify-profile-flashcall-request {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  record create-verify-profile-psd2-request {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  record create-verify-profile-sms-request {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>,
    /// Enables SMS text messaging for the Verify profile.
    messaging-enabled: option<bool>,
    /// Optionally sets a messaging text template when sending the verification code. Uses `{code}` to template in the actual verification code.
    messaging-template: option<string>,
    /// Enables RCS messaging for the Verify profile.
    rcs-enabled: option<bool>,
    /// Enables VSMS for the Verify profile.
    vsms-enabled: option<bool>
  }

  record create-verify-profile-whatsapp-request {
    /// The name that identifies the application requesting 2fa in the verification message.
    app-name: option<string>,
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  record profile-response-data-wrapper {
    data: option<profile-response>
  }

  record update-verify-profile-call-request {
    /// Must be less than default_verification_timeout_secs
    default-call-timeout-secs: option<s32>,
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>,
    /// Optionally sets a speech text template when sending the verification code. Uses `{code}` to template in the actual verification code.
    speech-template: option<string>
  }

  record update-verify-profile-flashcall-request {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  record update-verify-profile-psd2-request {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  record update-verify-profile-sms-request {
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>,
    /// Enables SMS text messaging for the Verify profile.
    messaging-enabled: option<bool>,
    /// Optionally sets a messaging text template when sending the verification code. Uses `{code}` to template in the actual verification code.
    messaging-template: option<string>,
    /// Enables RCS messaging for the Verify profile.
    rcs-enabled: option<bool>,
    /// Enables VSMS for the Verify profile.
    vsms-enabled: option<bool>
  }

  record update-verify-profile-whatsapp-request {
    /// The name that identifies the application requesting 2fa in the verification message.
    app-name: option<string>,
    /// For every request that is initiated via this Verify profile, this sets the number of seconds before a verification request code expires. Once the verification request expires, the user cannot use the code to verify their identity.
    default-verification-timeout-secs: option<s32>
  }

  variant list-verifications-error {
    bad-request(string),
    other(string)
  }

  variant verification-code-error {
    bad-request(string),
    other(string)
  }

  variant create-verification-call-error {
    bad-request(string),
    other(string)
  }

  variant create-verification-flashcall-error {
    bad-request(string),
    other(string)
  }

  variant create-verification-psd2-error {
    bad-request(string),
    other(string)
  }

  variant create-verification-sms-error {
    bad-request(string),
    other(string)
  }

  variant create-verification-whatsapp-error {
    bad-request(string),
    other(string)
  }

  variant retrieve-verification-error {
    bad-request(string),
    other(string)
  }

  variant list-verify-profiles-error {
    bad-request(string),
    other(string)
  }

  variant create-verify-profile-error {
    bad-request(string),
    other(string)
  }

  variant retrieve-verify-profile-error {
    bad-request(string),
    other(string)
  }

  variant update-verify-profile-error {
    bad-request(string),
    other(string)
  }

  variant delete-verify-profile-error {
    bad-request(string),
    other(string)
  }

  /// List verifications by phone number
  record list-verifications-params {
    /// The phone number associated with the verifications to retrieve.
    phone-number: string
  }
  list-verifications: func(params: list-verifications-params) -> result<list-verifications-response, list-verifications-error>;

  /// Submit a verification code
  record verification-code-params {
    /// The phone number associated with the verification code being verified.
    phone-number: string,
    /// This is the code the user submits for verification.
    code: string
  }
  verification-code: func(params: verification-code-params) -> result<verification-code-response, verification-code-error>;

  /// Trigger a Call verification
  record create-verification-call-params {
    /// Must be less than the profile's default_verification_timeout_secs or timeout_secs, whichever is lesser.
    call-timeout-secs: option<s32>,
    /// +E164 formatted phone number.
    phone-number: string,
    /// The number of seconds the verification code is valid for.
    timeout-secs: option<s32>,
    /// The identifier of the associated Verify profile.
    verify-profile-id: string
  }
  create-verification-call: func(params: create-verification-call-params) -> result<create-verification-response, create-verification-call-error>;

  /// Trigger a Flash call verification
  record create-verification-flashcall-params {
    /// +E164 formatted phone number.
    phone-number: string,
    /// The number of seconds the verification code is valid for.
    timeout-secs: option<s32>,
    /// The identifier of the associated Verify profile.
    verify-profile-id: string
  }
  create-verification-flashcall: func(params: create-verification-flashcall-params) -> result<create-verification-response, create-verification-flashcall-error>;

  /// Trigger a PSD2 verification
  record create-verification-psd2-params {
    amount: string,
    currency: currencies,
    payee: string,
    /// +E164 formatted phone number.
    phone-number: string,
    /// The number of seconds the verification code is valid for.
    timeout-secs: option<s32>,
    /// The identifier of the associated Verify profile.
    verify-profile-id: string
  }
  create-verification-psd2: func(params: create-verification-psd2-params) -> result<create-verification-response, create-verification-psd2-error>;

  /// Trigger a SMS verification
  record create-verification-sms-params {
    /// +E164 formatted phone number.
    phone-number: string,
    /// The number of seconds the verification code is valid for.
    timeout-secs: option<s32>,
    /// The identifier of the associated Verify profile.
    verify-profile-id: string
  }
  create-verification-sms: func(params: create-verification-sms-params) -> result<create-verification-response, create-verification-sms-error>;

  /// Trigger a Whatsapp verification
  record create-verification-whatsapp-params {
    /// +E164 formatted phone number.
    phone-number: string,
    /// The number of seconds the verification code is valid for.
    timeout-secs: option<s32>,
    /// The identifier of the associated Verify profile.
    verify-profile-id: string
  }
  create-verification-whatsapp: func(params: create-verification-whatsapp-params) -> result<create-verification-response, create-verification-whatsapp-error>;

  /// Retrieve a verification
  record retrieve-verification-params {
    /// The identifier of the verification to retrieve.
    verification-id: string
  }
  retrieve-verification: func(params: retrieve-verification-params) -> result<retrieve-verification-response, retrieve-verification-error>;

  /// List all Verify profiles
  record list-verify-profiles-params {
    filter-name: option<string>,
    page-size: option<s32>,
    page-number: option<s32>
  }
  list-verify-profiles: func(params: list-verify-profiles-params) -> result<list-verify-profiles-response, list-verify-profiles-error>;

  /// Create a Verify profile
  record create-verify-profile-params {
    call: option<create-verify-profile-call-request>,
    flashcall: option<create-verify-profile-flashcall-request>,
    language: option<string>,
    name: string,
    psd2: option<create-verify-profile-psd2-request>,
    sms: option<create-verify-profile-sms-request>,
    webhook-failover-url: option<string>,
    webhook-url: option<string>,
    whatsapp: option<create-verify-profile-whatsapp-request>
  }
  create-verify-profile: func(params: create-verify-profile-params) -> result<profile-response-data-wrapper, create-verify-profile-error>;

  /// Retrieve a Verify profile
  record retrieve-verify-profile-params {
    /// The identifier of the Verify profile to retrieve.
    verify-profile-id: string
  }
  retrieve-verify-profile: func(params: retrieve-verify-profile-params) -> result<profile-response-data-wrapper, retrieve-verify-profile-error>;

  /// Update a Verify profile
  record update-verify-profile-params {
    /// The identifier of the Verify profile to update.
    verify-profile-id: string,
    call: option<update-verify-profile-call-request>,
    flashcall: option<update-verify-profile-flashcall-request>,
    language: option<string>,
    name: option<string>,
    psd2: option<update-verify-profile-psd2-request>,
    sms: option<update-verify-profile-sms-request>,
    webhook-failover-url: option<string>,
    webhook-url: option<string>,
    whatsapp: option<update-verify-profile-whatsapp-request>
  }
  update-verify-profile: func(params: update-verify-profile-params) -> result<profile-response-data-wrapper, update-verify-profile-error>;

  /// Delete a Verify profile
  record delete-verify-profile-params {
    /// The identifier of the Verify profile to delete.
    verify-profile-id: string
  }
  delete-verify-profile: func(params: delete-verify-profile-params) -> result<profile-response-data-wrapper, delete-verify-profile-error>;

}

interface webhooks {
  enum get-webhook-deliveries-filter-status-eq-enum {
    delivered,
    failed,
  }

  enum webhook-delivery-webhook-event-type-enum {
    webhook-command,
  }

  enum webhook-delivery-webhook-record-type-enum {
    event,
  }

  record get-webhook-deliveries-response {
    data: option<list<webhook-delivery>>,
    meta: option<pagination-meta-simple>
  }

  /// Record of all attempts to deliver a webhook.
  record webhook-delivery {
    /// Detailed delivery attempts, ordered by most recent.
    attempts: option<list<attempt>>,
    /// ISO 8601 timestamp indicating when the last webhook response has been received.
    finished-at: option<string>,
    /// Uniquely identifies the webhook_delivery record.
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 timestamp indicating when the first request attempt was initiated.
    started-at: option<string>,
    /// Delivery status: 'delivered' when successfuly delivered or 'failed' if all attempts have failed.
    status: option<get-webhook-deliveries-filter-status-eq-enum>,
    /// Uniquely identifies the user that owns the webhook_delivery record.
    user-id: option<string>,
    /// Original webhook JSON data. Payload fields vary according to event type.
    webhook: option<webhook-delivery-webhook>
  }

  /// Webhook delivery attempt details.
  record attempt {
    /// Webhook delivery errors.
    errors: option<list<error>>,
    /// ISO 8601 timestamp indicating when the attempt has finished.
    finished-at: option<string>,
    http: option<http>,
    /// ISO 8601 timestamp indicating when the attempt was initiated.
    started-at: option<string>,
    status: option<get-webhook-deliveries-filter-status-eq-enum>
  }

  record error {
    code: option<string>,
    detail: option<string>,
    title: option<string>
  }

  /// HTTP request and response information.
  record http {
    /// Request details.
    request: option<http-request>,
    /// Response details, optional.
    response: option<http-response>
  }

  record http-request {
    headers: option<http-headers>,
    url: option<string>
  }

  /// List of headers, limited to 10kB.
  record http-headers {
    /// opaque schema; raw JSON
    value: string
  }

  record http-response {
    /// Raw response body, limited to 10kB.
    body: option<string>,
    headers: option<http-headers>,
    status: option<s32>
  }

  /// Original webhook JSON data. Payload fields vary according to event type.
  record webhook-delivery-webhook {
    /// The type of event being delivered.
    event-type: option<webhook-delivery-webhook-event-type-enum>,
    /// Identifies the type of resource.
    id: option<string>,
    /// ISO 8601 datetime of when the event occurred.
    occurred-at: option<string>,
    payload: option<webhook-delivery-webhook-payload>,
    /// Identifies the type of the resource.
    record-type: option<webhook-delivery-webhook-record-type-enum>
  }

  record webhook-delivery-webhook-payload {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record pagination-meta-simple {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record get-webhook-delivery-response {
    data: option<webhook-delivery>
  }

  variant get-webhook-deliveries-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-webhook-delivery-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// List webhook deliveries
  record get-webhook-deliveries-params {
    /// Return only webhook_deliveries matching the given `status`
    filter-status-eq: option<get-webhook-deliveries-filter-status-eq-enum>,
    /// Return only webhook deliveries whose `webhook` component contains the given text
    filter-webhook-contains: option<string>,
    /// Return only webhook_deliveries whose `attempts` component contains the given text
    filter-attempts-contains: option<string>,
    /// Return only webhook_deliveries whose delivery started later than or at given ISO 8601 datetime
    filter-started-at-gte: option<string>,
    /// Return only webhook_deliveries whose delivery started earlier than or at given ISO 8601 datetime
    filter-started-at-lte: option<string>,
    /// Return only webhook_deliveries whose delivery finished later than or at given ISO 8601 datetime
    filter-finished-at-gte: option<string>,
    /// Return only webhook_deliveries whose delivery finished earlier than or at given ISO 8601 datetime
    filter-finished-at-lte: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  get-webhook-deliveries: func(params: get-webhook-deliveries-params) -> result<get-webhook-deliveries-response, get-webhook-deliveries-error>;

  /// Find webhook_delivery details by ID
  record get-webhook-delivery-params {
    /// Uniquely identifies the webhook_delivery.
    id: string
  }
  get-webhook-delivery: func(params: get-webhook-delivery-params) -> result<get-webhook-delivery-response, get-webhook-delivery-error>;

}

interface whats-app-contacts {
  enum check-contact-request-body-blocking-enum {
    no-wait,
    wait,
  }

  enum check-contact-v2-record-type-enum {
    whatsapp-contact,
  }

  enum check-contact-v2-status-enum {
    processing,
    valid,
    invalid,
  }

  record check-contact-response {
    data: option<list<check-contact-v2>>
  }

  record check-contact-v2 {
    /// WhatsApp user identifier that can be used in other API calls. Only returned if the status is valid.
    id: option<string>,
    /// The value you sent in the contacts field of the JSON request.
    input: option<string>,
    /// Identifies the type of the resource.
    record-type: option<check-contact-v2-record-type-enum>,
    /// Status of the user.
    status: option<check-contact-v2-status-enum>
  }

  /// Check Contact
  record check-contact-params {
    /// Blocking determines whether the request should wait for the processing to complete (synchronous) or not (asynchronous).
    blocking: option<check-contact-request-body-blocking-enum>,
    /// Array of contact phone numbers. The numbers can be in any standard telephone number format.
    contacts: list<string>,
    /// The sender's WhatsApp ID.
    whatsapp-user-id: string
  }
  check-contact: func(params: check-contact-params) -> result<check-contact-response, string>;

}

interface whats-app-detail-reports {
  enum whats-app-detail-record-report-status-enum {
    pending,
    complete,
    failed,
    expired,
  }

  record whats-app-get-all-detail-report-response {
    data: option<list<whats-app-detail-record-report>>,
    meta: option<pagination-meta>
  }

  record whats-app-detail-record-report {
    created-at: option<string>,
    download-link: option<string>,
    end-date: option<string>,
    id: option<string>,
    record-type: option<string>,
    start-date: option<string>,
    status: option<whats-app-detail-record-report-status-enum>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record whats-app-detail-report-response {
    data: option<whats-app-detail-record-report>
  }

  variant get-request-error {
    not-found(string),
    other(string)
  }

  record get-requests-params {
    /// Page number
    page-number: option<s32>,
    /// Size of the page
    page-size: option<s32>
  }
  get-requests: func(params: get-requests-params) -> result<whats-app-get-all-detail-report-response, string>;

  record submit-request-params {
    end-date: string,
    start-date: string
  }
  submit-request: func(params: submit-request-params) -> result<whats-app-detail-report-response, string>;

  record get-request-params {
    id: string
  }
  get-request: func(params: get-request-params) -> result<whats-app-detail-report-response, get-request-error>;

  record delete-request-params {
    id: string
  }
  delete-request: func(params: delete-request-params) -> result<whats-app-detail-report-response, string>;

}

interface whats-app-media {
  enum upload-media-v2-record-type-enum {
    whatsapp-media-id,
  }

  record upload-media-response {
    data: option<list<upload-media-v2>>
  }

  record upload-media-v2 {
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<upload-media-v2-record-type-enum>
  }

  /// Upload Media
  record upload-media-params {
    /// The content-type of the uplaoded media.
    media-content-type: string,
    /// The media to store with WhatsApp.
    upload-file: string,
    /// The user's WhatsApp ID.
    whatsapp-user-id: string
  }
  upload-media: func(params: upload-media-params) -> result<upload-media-response, string>;

  /// Download Media
  record get-whatsapp-media-whatsapp-user-id-media-id-params {
    /// User's WhatsApp ID
    whatsapp-user-id: string,
    /// WhatsApp's Media ID
    media-id: string
  }
  get-whatsapp-media-whatsapp-user-id-media-id: func(params: get-whatsapp-media-whatsapp-user-id-media-id-params) -> result<string, string>;

  /// Delete Media
  record delete-whatsapp-media-whatsapp-user-id-media-id-params {
    /// User's WhatsApp ID
    whatsapp-user-id: string,
    /// WhatsApp's Media ID
    media-id: string
  }
  delete-whatsapp-media-whatsapp-user-id-media-id: func(params: delete-whatsapp-media-whatsapp-user-id-media-id-params) -> result<string, string>;

}

interface whats-app-messages {
  enum language-policy-enum {
    fallback,
    deterministic,
  }

  enum message-record-type-enum {
    whatsapp-message-id,
  }

  /// The media object containing audio details.
  record audio {
    /// The media object ID returned when the media is successfully uploaded to the media endpoint.
    id: option<string>,
    /// The protocol and URL of the media to be sent. Use only with HTTP/HTTPS URLs. Either id or link must be provided, not both.
    link: option<string>
  }

  record contact {
    /// Full contact address(es)
    addresses: option<list<whats-app-contact-address>>,
    /// YYYY-MM-DD formatted string
    birthday: option<string>,
    /// Contact email address(es)
    emails: option<list<email>>,
    ims: option<list<string>>,
    name: option<name>,
    org: option<organization>,
    /// Contact phone number(s)
    phones: option<list<phone>>,
    /// Contact URL(s)
    urls: option<list<url>>
  }

  record whats-app-contact-address {
    /// City name
    city: string,
    /// Full country name
    country: string,
    /// Two-letter country abbreviation
    country-code: string,
    /// State abbreviation
    state: string,
    /// Street number and name
    street: string,
    /// Standard Values: HOME, WORK
    type-op: string,
    /// ZIP code
    zip: string
  }

  record email {
    email: string,
    type-op: string
  }

  /// Full contact name
  record name {
    /// First name
    first-name: option<string>,
    /// Full name as it normally appears
    formatted-name: string,
    /// Last name
    last-name: option<string>,
    /// Name preffix
    prefix: option<string>,
    /// Name suffix
    suffix: option<string>
  }

  /// Contact organization information
  record organization {
    /// Name of the contact's company
    company: string,
    /// Name of the contact's department
    department: option<string>,
    /// Contact's business title
    title: option<string>
  }

  record phone {
    /// WhatsApp ID
    id: option<string>,
    phone: option<string>,
    /// Standard Values: CELL, MAIN, IPHONE, HOME, WORK
    type-op: option<string>
  }

  /// Standard Values: HOME, WORK
  record url {
    /// Standard Values: HOME, WORK
    type-op: option<string>,
    /// URL
    url: option<string>
  }

  /// The media object containing a document reference
  record document {
    /// Describes the specified media.
    caption: option<string>,
    /// Describes the filename for the specific document.
    filename: option<string>,
    /// The media object ID returned when the media is successfully uploaded to the media endpoint.
    id: option<string>,
    /// The protocol and URL of the media to be sent. Use only with HTTP/HTTPS URLs. Either id or link must be provided, not both.
    link: option<string>
  }

  /// The containing element for the message content — Indicates that the message is highly structured. Parameters contained within provide the structure.
  record hsm {
    /// The element name that indicates which template to use within the namespace
    element-name: string,
    language: language,
    /// This field is an array of values to apply to variables in the template
    localizable-params: list<localizable-param>,
    /// The namespace that will be used
    namespace: string
  }

  record language {
    /// The code of the language or locale to use — Accepts both language and language_locale formats (e.g., en and en_US).
    code: string,
    /// The language policy the message should follow
    policy: language-policy-enum
  }

  record localizable-param {
    currency: option<currency>,
    date-time: option<date-time-object>,
    /// Default text if localization fails
    default: string
  }

  record currency {
    amount-v1000: s32,
    currency-code: string,
    fallback-value: option<string>
  }

  /// The Whatsapp Business API Client will attempt to format the date/time based on a specified localization.
  record date-time-object {
    component: option<date-time-component>,
    unix-epoch: option<date-time-unix-epoch>
  }

  /// Date/time by component
  record date-time-component {
    /// The day of month
    day-of-month: option<s32>,
    /// Both strings and numbers are accepted. If different from the value derived from the date (if specified), use the derived value.
    day-of-week: option<s32>,
    /// The hour
    hour: option<s32>,
    /// The minute
    minute: option<s32>,
    /// The month
    month: option<s32>,
    /// The year
    year: option<s32>
  }

  /// Date/time by Unix epoch
  record date-time-unix-epoch {
    /// Epoch timestamp in seconds
    timestamp: option<s32>
  }

  /// The media object containing an image
  record image {
    /// Describes the specified media.
    caption: option<string>,
    /// The media object ID returned when the media is successfully uploaded to the media endpoint.
    id: option<string>,
    /// The protocol and URL of the media to be sent. Use only with HTTP/HTTPS URLs. Either id or link must be provided, not both.
    link: option<string>
  }

  record location {
    /// Address of the location. Only displayed if name is present.
    address: string,
    /// Latitude of the location
    latitude: string,
    /// Longitude of the location
    longitude: string,
    /// Name of the location
    name: string
  }

  record template {
    components: option<template-components>,
    language: language,
    /// Name of the template.
    name: string,
    /// Namespace of the template. This must be the namespace associated with the WhatsApp business account that owns the phone number associated with the current WhatsApp Business API client or the message fails to send.
    namespace: string
  }

  record template-components {
    /// opaque schema; raw JSON
    value: string
  }

  record text {
    body: string
  }

  /// type of the message
  record message-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// The media object containing a video
  record video {
    /// Describes the specified media.
    caption: option<string>,
    /// The media object ID returned when the media is successfully uploaded to the media endpoint.
    id: option<string>,
    /// The protocol and URL of the media to be sent. Use only with HTTP/HTTPS URLs. Either id or link must be provided, not both.
    link: option<string>
  }

  record send-message-response {
    data: option<message>
  }

  record message {
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<message-record-type-enum>
  }

  /// Send Message
  record send-message-params {
    audio: option<audio>,
    contacts: option<list<contact>>,
    document: option<document>,
    hsm: option<hsm>,
    image: option<image>,
    location: option<location>,
    /// Specifying preview_url in the request is optional when not including a URL in your message.
    /// To include a URL preview, set preview_url to true in the message body and make sure the URL begins with http:// or https://.
    preview-url: option<bool>,
    template: option<template>,
    text: option<text>,
    /// The WhatsApp ID (phone number) returned from contacts endpoint.
    to: string,
    type-op: option<message-type>,
    video: option<video>,
    /// The sender's WhatsApp ID.
    whatsapp-user-id: string
  }
  send-message: func(params: send-message-params) -> result<send-message-response, string>;

  /// Mark Message As Read
  record mark-message-as-read-params {
    /// Message ID from Webhook
    message-id: string,
    status: string,
    /// The user's WhatsApp ID.
    whatsapp-user-id: string
  }
  mark-message-as-read: func(params: mark-message-as-read-params) -> result<string, string>;

}

interface whats-app-usage-aggregations {
  enum money-currency-enum {
    aud,
    cad,
    eur,
    gbp,
    usd,
  }

  record response-container {
    data: option<list<whats-app-usage-aggregation>>
  }

  record whats-app-usage-aggregation {
    cost: option<money>,
    count: option<string>,
    direction: option<string>,
    message-type: option<string>,
    recipient-country-code: option<string>,
    record-type: option<string>,
    status: option<string>,
    telnyx-fee: option<money>,
    whatsapp-fee: option<money>
  }

  record money {
    amount: option<string>,
    currency: option<money-currency-enum>
  }

  record get-usage-aggregations-sync-params {
    start-date: option<string>,
    end-date: option<string>
  }
  get-usage-aggregations-sync: func(params: get-usage-aggregations-sync-params) -> result<response-container, string>;

}

interface whats-app-users {
  enum whats-app-user-record-type-enum {
    whatsapp-user,
  }

  record get-user-response {
    data: option<whats-app-user>
  }

  /// The WhatsApp user object
  record whats-app-user {
    /// The WhatsApp User ID, usually a phone number.
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<whats-app-user-record-type-enum>,
    /// The URL that WhatsApp webhooks are sent to.
    webhook-url: option<string>
  }

  /// Get User
  record get-user-params {
    /// User's WhatsApp ID
    whatsapp-user-id: string
  }
  get-user: func(params: get-user-params) -> result<get-user-response, string>;

  /// Update WhatsApp User
  record update-whats-app-webhook-params {
    /// User's WhatsApp ID
    whatsapp-user-id: string,
    /// The desired URL to set for your WhatsApp webhook endpoint.
    webhook-url: string
  }
  update-whats-app-webhook: func(params: update-whats-app-webhook-params) -> result<string, string>;

}

interface reporting {
  enum wdr-report-status-enum {
    pending,
    complete,
    failed,
    deleted,
  }

  record get-wdr-reports-response {
    data: option<list<wdr-report>>
  }

  record wdr-report {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// ISO 8601 formatted date-time indicating the end time.
    end-time: option<string>,
    /// Identifies the resource.
    id: option<string>,
    record-type: option<string>,
    /// The URL where the report content, when generated, will be published to.
    report-url: option<string>,
    /// ISO 8601 formatted date-time indicating the start time.
    start-time: option<string>,
    /// Indicates the status of the report, which is updated asynchronously.
    status: option<wdr-report-status-enum>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  record create-wdr-report-response {
    data: option<wdr-report>
  }

  record get-wdr-report-response {
    data: option<wdr-report>
  }

  record delete-wdr-report-response {
    data: option<wdr-report>
  }

  variant create-wdr-report-error {
    unprocessable-entity(string),
    other(string)
  }

  variant get-wdr-report-error {
    not-found(string),
    other(string)
  }

  variant delete-wdr-report-error {
    not-found(string),
    other(string)
  }

  /// Get all Wireless Detail Records (WDRs) Reports
  record get-wdr-reports-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  get-wdr-reports: func(params: get-wdr-reports-params) -> result<get-wdr-reports-response, string>;

  /// Create a Wireless Detail Records (WDRs) Report
  record create-wdr-report-params {
    /// ISO 8601 formatted date-time indicating the end time.
    end-time: option<string>,
    /// ISO 8601 formatted date-time indicating the start time.
    start-time: option<string>
  }
  create-wdr-report: func(params: create-wdr-report-params) -> result<create-wdr-report-response, create-wdr-report-error>;

  /// Get a Wireless Detail Record (WDR) Report
  record get-wdr-report-params {
    /// Identifies the resource.
    id: string
  }
  get-wdr-report: func(params: get-wdr-report-params) -> result<get-wdr-report-response, get-wdr-report-error>;

  /// Delete a Wireless Detail Record (WDR) Report
  record delete-wdr-report-params {
    /// Identifies the resource.
    id: string
  }
  delete-wdr-report: func(params: delete-wdr-report-params) -> result<delete-wdr-report-response, delete-wdr-report-error>;

}
