    /// The id of the short code
    id: string,
    /// Unique identifier for a messaging profile.
    messaging-profile-id: string
  }
  update-short-code: func(params: update-short-code-params) -> result<string, string>;

}

interface sim-card-group-actions {
  enum get-filter-status-enum {
    in-progress,
    completed,
    failed,
  }

  enum get-filter-type-enum {
    set-private-wireless-gateway,
    remove-private-wireless-gateway,
  }

  /// List SIM card group actions
  record get-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// A valid SIM card group ID.
    filter-sim-card-group-id: option<string>,
    /// Filter by a specific status of the resource's lifecycle.
    filter-status: option<get-filter-status-enum>,
    /// Filter by action type.
    filter-type: option<get-filter-type-enum>
  }
  get: func(params: get-params) -> result<string, string>;

  /// Get SIM card group action details
  record sim-card-group-action-get-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-group-action-get: func(params: sim-card-group-action-get-params) -> result<string, string>;

}

interface sim-card-groups {
  /// Get all SIM card groups
  record get-all-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// A valid SIM card group name.
    filter-name: option<string>
  }
  get-all: func(params: get-all-params) -> result<string, string>;

  /// Create a SIM card group
  record post-params {
    /// Upper limit on the amount of data the SIM cards, within the group, can use.
    data-limit: option<s32>,
    /// A user friendly name for the SIM card group.
    name: string
  }
  post: func(params: post-params) -> result<string, string>;

  /// Get SIM card group
  record get-params {
    /// Identifies the resource.
    id: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update a SIM card group
  record sim-card-group-update-params {
    /// Identifies the resource.
    id: string,
    /// Upper limit on the amount of data the SIM cards, within the group, can use.
    data-limit: option<s32>,
    /// A user friendly name for the SIM card group.
    name: option<string>
  }
  sim-card-group-update: func(params: sim-card-group-update-params) -> result<string, string>;

  /// Delete a SIM card group
  record sim-card-group-delete-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-group-delete: func(params: sim-card-group-delete-params) -> result<string, string>;

  /// Request Private Wireless Gateway removal from SIM card group
  record remove-sim-card-group-private-wireless-gateway-params {
    /// Identifies the resource.
    id: string
  }
  remove-sim-card-group-private-wireless-gateway: func(params: remove-sim-card-group-private-wireless-gateway-params) -> result<string, string>;

  /// Request Private Wireless Gateway assignment for SIM card group
  record set-sim-card-group-private-wireless-gateway-params {
    /// Identifies the resource.
    id: string,
    /// The identification of the related Private Wireless Gateway resource.
    private-wireless-gateway-id: string
  }
  set-sim-card-group-private-wireless-gateway: func(params: set-sim-card-group-private-wireless-gateway-params) -> result<string, string>;

}

interface sim-card-orders {
  /// Preview SIM card orders
  record preview-params {
    /// Uniquely identifies the address for the order.
    address-id: string,
    /// The amount of SIM cards that the user would like to purchase in the SIM card order.
    quantity: s32
  }
  preview: func(params: preview-params) -> result<string, string>;

  /// Get all SIM card orders
  record get-params {
    /// Filter by ISO 8601 formatted date-time string matching resource creation date-time.
    filter-created-at: option<string>,
    /// Filter by ISO 8601 formatted date-time string matching resource last update date-time.
    filter-updated-at: option<string>,
    /// Filter orders by how many SIM cards were ordered.
    filter-quantity: option<s32>,
    /// The total monetary amount of the order.
    filter-cost-amount: option<string>,
    /// Filter by ISO 4217 currency string.
    filter-cost-currency: option<string>,
    /// Uniquely identifies the address for the order.
    filter-address-id: option<string>,
    /// Returns entries with matching name of the street where the address is located.
    filter-address-street-address: option<string>,
    /// Returns entries with matching name of the supplemental field for address information.
    filter-address-extended-address: option<string>,
    /// Filter by the name of the city where the address is located.
    filter-address-locality: option<string>,
    /// Filter by state or province where the address is located.
    filter-address-administrative-area: option<string>,
    /// Filter by the mobile operator two-character (ISO 3166-1 alpha-2) origin country code.
    filter-address-country-code: option<string>,
    /// Filter by postal code for the address.
    filter-address-postal-code: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  get: func(params: get-params) -> result<string, string>;

  /// Create a SIM card order
  record post-params {
    /// Uniquely identifies the address for the order.
    address-id: string,
    /// The amount of SIM cards to order.
    quantity: s32
  }
  post: func(params: post-params) -> result<string, string>;

  /// Get a single SIM card order
  record sim-card-order-get-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-order-get: func(params: sim-card-order-get-params) -> result<string, string>;

}

interface credentials {
  /// List all credentials
  record find-telephony-credentials-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter by tag
    filter-tag: option<string>,
    /// Filter by name
    filter-name: option<string>,
    /// Filter by status
    filter-status: option<string>,
    /// Filter by resource_id
    filter-resource-id: option<string>,
    /// Filter by sip_username
    filter-sip-username: option<string>
  }
  find-telephony-credentials: func(params: find-telephony-credentials-params) -> result<string, string>;

  /// Create a credential
  record create-telephony-credential-params {
    /// Identifies the Credential Connection this credential is associated with.
    connection-id: string,
    /// ISO-8601 formatted date indicating when the credential will expire.
    expires-at: option<string>,
    name: option<string>,
    /// Tags a credential to filter for bulk operations. A single tag can hold at maximum 1000 credentials.
    tag: option<string>
  }
  create-telephony-credential: func(params: create-telephony-credential-params) -> result<string, string>;

  /// List all tags
  record list-tags-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-tags: func(params: list-tags-params) -> result<string, string>;

  /// Get a credential
  record get-telephony-credential-params {
    /// Identifies the resource.
    id: string
  }
  get-telephony-credential: func(params: get-telephony-credential-params) -> result<string, string>;

  /// Update a credential
  record update-telephony-credential-params {
    /// Identifies the resource.
    id: string,
    /// Identifies the Credential Connection this credential is associated with.
    connection-id: option<string>,
    /// ISO-8601 formatted date indicating when the credential will expire.
    expires-at: option<string>,
    name: option<string>,
    /// Tags a credential to filter for bulk operations. A single tag can hold at maximum 1000 credentials.
    tag: option<string>
  }
  update-telephony-credential: func(params: update-telephony-credential-params) -> result<string, string>;

  /// Delete a credential
  record delete-telephony-credential-params {
    /// Identifies the resource.
    id: string
  }
  delete-telephony-credential: func(params: delete-telephony-credential-params) -> result<string, string>;

  /// Perform activate or deactivate action on provided Credential
