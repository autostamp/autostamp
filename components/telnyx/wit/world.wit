/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `BearerAuth` | `Authorization: Bearer <secret>` |
/// | `bearerAuth` | `Authorization: Bearer <secret>` |
package autostamp:telnyx@0.5.0;

interface bulk-credentials {
  record create-bulk-telephony-credential-response {
    data: option<create-bulk-telephony-credential-response-data>
  }

  record create-bulk-telephony-credential-response-data {
    /// Amount of credentials affected
    credentials: option<s32>
  }

  record update-bulk-telephony-credential-response {
    data: option<update-bulk-telephony-credential-response-data>
  }

  record update-bulk-telephony-credential-response-data {
    /// Amount of credentials affected
    credentials: option<s32>
  }

  record delete-bulk-telephony-credential-response {
    data: option<delete-bulk-telephony-credential-response-data>
  }

  record delete-bulk-telephony-credential-response-data {
    /// Amount of credentials affected
    credentials: option<s32>
  }

  record bulk-credential-action-response {
    data: option<bulk-credential-action-response-data>
  }

  record bulk-credential-action-response-data {
    /// Amount of credentials affected
    credentials: option<s32>
  }

  variant create-bulk-telephony-credential-error {
    unprocessable-entity(string),
    other(string)
  }

  variant update-bulk-telephony-credential-error {
    unprocessable-entity(string),
    other(string)
  }

  variant delete-bulk-telephony-credential-error {
    unprocessable-entity(string),
    other(string)
  }

  variant bulk-credential-action-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// Creates several credentials
  record create-bulk-telephony-credential-params {
    /// Amount of credentials to be created. A single tag can hold at maximum 1000 credentials
    amount: option<s32>,
    /// Identifies the connection this credential is associated with.
    connection-id: string,
    /// A default name for all credentials.
    name: option<string>,
    /// Tags a credential for bulk operations. A single tag can hold at maximum 1000 credentials.
    tag: string
  }
  create-bulk-telephony-credential: func(params: create-bulk-telephony-credential-params) -> result<create-bulk-telephony-credential-response, create-bulk-telephony-credential-error>;

  /// Update several credentials
  record update-bulk-telephony-credential-params {
    /// Filter by tag, required by bulk operations.
    filter-tag: string,
    /// Amount of credentials to be created. A single tag can hold at maximum 1000 credentials
    amount: option<s32>,
    /// Identifies the connection this credential is associated with.
    connection-id: string,
    /// A default name for all credentials.
    name: option<string>,
    /// Tags a credential for bulk operations. A single tag can hold at maximum 1000 credentials.
    tag: string
  }
  update-bulk-telephony-credential: func(params: update-bulk-telephony-credential-params) -> result<update-bulk-telephony-credential-response, update-bulk-telephony-credential-error>;

  /// Delete several credentials
  record delete-bulk-telephony-credential-params {
    /// Filter by tag, required by bulk operations.
    filter-tag: string
  }
  delete-bulk-telephony-credential: func(params: delete-bulk-telephony-credential-params) -> result<delete-bulk-telephony-credential-response, delete-bulk-telephony-credential-error>;

  /// Perform activate or deactivate action on all credentials filtered by the provided tag.
  record bulk-credential-action-params {
    /// Identifies the action to be taken. Activate will change the status to active. Deactivate will change the status to inactive.
    action: string,
    /// Filter by tag, required by bulk operations.
    filter-tag: string
  }
  bulk-credential-action: func(params: bulk-credential-action-params) -> result<bulk-credential-action-response, bulk-credential-action-error>;

}


interface sim-cards {
  enum complete-ota-update-status-enum {
    in-progress,
    completed,
    failed,
  }

  enum complete-ota-update-type-op-enum {
    sim-card-network-preferences,
  }

  enum sim-card-registration-status-enum {
    enabled,
    disabled,
    standby,
  }

  enum simple-sim-card-status-enum {
    registering,
    enabling,
    enabled,
    disabling,
    disabled,
    data-limit-exceeded,
  }

  enum sim-card-public-ip-status-value-enum {
    provisioning,
    provisioned,
    failed,
    decommissioning,
  }

  enum sim-card-public-ip-type-op-enum {
    ipv4,
  }

  enum wireless-connectivity-log-log-type-enum {
    registration,
    data,
  }

  /// A list of mobile operator networks and the priority that should be applied when the SIM is connecting to the network.
  record mobile-operator-networks-preferences-request {
    /// opaque schema; raw JSON
    value: string
  }

  record bulk-sim-card-network-preferences-response {
    /// Multi requested SIM cards network preferences.
    data: option<list<sim-card-network-preference-with-ota-updates>>,
    errors: option<list<error>>
  }

  record sim-card-network-preference-with-ota-updates {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    mobile-operator-networks-preferences: option<mobile-operator-networks-preferences-response>,
    ota-updates: option<list<complete-ota-update>>,
    record-type: option<string>,
    sim-card-id: option<string>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  /// A list of mobile operator networks and the priority that should be applied when the SIM is connecting to the network.
  record mobile-operator-networks-preferences-response {
    /// opaque schema; raw JSON
    value: string
  }

  /// This object represents an Over the Air (OTA) update request. It allows tracking the current status of a operation that apply settings in a particular SIM card. <br/><br/>
  record complete-ota-update {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    record-type: option<string>,
    /// A JSON object representation of the operation. The information present here will relate directly to the source of the OTA request.
    settings: option<complete-ota-update-settings>,
    /// The identification UUID of the related SIM card resource.
    sim-card-id: option<string>,
    status: option<complete-ota-update-status-enum>,
    /// Represents the type of the operation requested. This will relate directly to the source of the request.
    type-op: option<complete-ota-update-type-op-enum>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  /// A JSON object representation of the operation. The information present here will relate directly to the source of the OTA request.
  record complete-ota-update-settings {
    mobile-operator-networks-preferences: option<mobile-operator-networks-preferences-response>
  }

  record error {
    code: string,
    detail: option<string>,
    meta: option<error-meta>,
    source: option<error-source>,
    title: string
  }

  record error-meta {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record error-source {
    /// Indicates which query parameter caused the error.
    parameter: option<string>,
    /// JSON pointer (RFC6901) to the offending entity.
    pointer: option<string>
  }

  record sim-card-register-response {
    /// Successfully registered SIM cards.
    data: option<list<simple-sim-card>>,
    errors: option<list<error>>
  }

  record simple-sim-card {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// The ICCID is the identifier of the specific SIM card/chip. Each SIM is internationally identified by its integrated circuit card identifier (ICCID). ICCIDs are stored in the SIM card's memory and are also engraved or printed on the SIM card body during a process called personalization.
    iccid: option<string>,
    /// Identifies the resource.
    id: option<string>,
    /// SIM cards are identified on their individual operator networks by a unique International Mobile Subscriber Identity (IMSI). <br/>
    /// Mobile network operators connect mobile phone calls and communicate with their market SIM cards using their IMSIs. The IMSI is stored in the Subscriber  Identity Module (SIM) inside the device and is sent by the device to the appropriate network. It is used to acquire the details of the device in the Home  Location Register (HLR) or the Visitor Location Register (VLR).
    imsi: option<string>,
    /// Mobile Station International Subscriber Directory Number (MSISDN) is a number used to identify a mobile phone number internationally. <br/>
    /// MSISDN is defined by the E.164 numbering plan. It includes a country code and a National Destination Code which identifies the subscriber's operator.
    msisdn: option<string>,
    record-type: option<string>,
    /// The group SIMCardGroup identification. This attribute can be <code>null</code> when it's present in an associated resource.
    sim-card-group-id: option<string>,
    /// The current status of the SIM card. It will be one of the following: <br/>
    /// <ul>
    status: option<simple-sim-card-status-enum>,
    /// Searchable tags associated with the SIM card
    tags: option<list<string>>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  record get-response {
    data: option<list<simple-sim-card>>,
    meta: option<pagination-meta>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record sim-card-registration-code-validations {
    data: option<list<sim-card-registration-code-validation>>
  }

  record sim-card-registration-code-validation {
    /// The validation message
    invalid-detail: option<string>,
    record-type: option<string>,
    /// The 10-digit SIM card registration code
    registration-code: option<string>,
    /// The attribute that denotes whether the code is valid or not
    valid: option<bool>
  }

  record sim-card-get-response {
    data: option<sim-card>
  }

  record sim-card {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// The ICCID is the identifier of the specific SIM card/chip. Each SIM is internationally identified by its integrated circuit card identifier (ICCID). ICCIDs are stored in the SIM card's memory and are also engraved or printed on the SIM card body during a process called personalization.
    iccid: option<string>,
    /// Identifies the resource.
    id: option<string>,
    /// SIM cards are identified on their individual operator networks by a unique International Mobile Subscriber Identity (IMSI). <br/>
    /// Mobile network operators connect mobile phone calls and communicate with their market SIM cards using their IMSIs. The IMSI is stored in the Subscriber  Identity Module (SIM) inside the device and is sent by the device to the appropriate network. It is used to acquire the details of the device in the Home  Location Register (HLR) or the Visitor Location Register (VLR).
    imsi: option<string>,
    /// The SIM's address in the currently connected network. This IPv4 address is usually obtained dynamically, so it may vary according to the location or new connections.
    ipv4: option<string>,
    /// The SIM's address in the currently connected network. This IPv6 address is usually obtained dynamically, so it may vary according to the location or new connections.
    ipv6: option<string>,
    /// Mobile Station International Subscriber Directory Number (MSISDN) is a number used to identify a mobile phone number internationally. <br/>
    /// MSISDN is defined by the E.164 numbering plan. It includes a country code and a National Destination Code which identifies the subscriber's operator.
    msisdn: option<string>,
    record-type: option<string>,
    /// The group SIMCardGroup identification. This attribute can be <code>null</code> when it's present in an associated resource.
    sim-card-group-id: option<string>,
    /// The current status of the SIM card. It will be one of the following: <br/>
    /// <ul>
    status: option<simple-sim-card-status-enum>,
    /// Searchable tags associated with the SIM card
    tags: option<list<string>>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  record sim-card-update-response {
    data: option<sim-card>
  }

  record sim-card-delete-response {
    data: option<sim-card>
  }

  record sim-card-disable-response {
    data: option<simple-sim-card>
  }

  record sim-card-enable-response {
    data: option<simple-sim-card>
  }

  record sim-card-set-standby-response {
    data: option<simple-sim-card>
  }

  record sim-card-network-preferences-get-response {
    data: option<sim-card-network-preference-with-ota-updates>
  }

  record mobile-operator-network-preferences-request {
    /// The mobile operator network resource identification UUID.
    mobile-operator-network-id: option<string>,
    /// It determines what is the priority of a specific operator network that should be assumed by a SIM card when connecting to a network. The highest priority is 0, the second highest is 1 and so on.
    priority: option<s32>
  }

  record sim-card-network-preferences-put-response {
    data: option<sim-card-network-preference-with-ota-updates>
  }

  record sim-card-network-preferences-delete-response {
    data: option<sim-card-network-preference-with-ota-updates>
  }

  record sim-card-public-ip-get-response {
    data: option<sim-card-public-ip>
  }

  record sim-card-public-ip {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// The provisioned IP address. This attribute will only be available when underlying resource status is in a "provisioned" status.
    ip: option<string>,
    record-type: option<string>,
    sim-card-id: option<string>,
    status: option<sim-card-public-ip-status>,
    type-op: option<sim-card-public-ip-type-op-enum>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  /// The current status or failure details of the SIM card's public IP.
  record sim-card-public-ip-status {
    /// This attribute is an <a href="https://developers.telnyx.com/docs/api/v2/overview#errors">error code</a> related to the failure reason.
    error-code: option<string>,
    /// This attribute provides a human-readable explanation of why a failure happened.
    error-description: option<string>,
    /// The current status or failure details of the SIM card's public IP. <ul>
    ///  <li><code>provisioning</code> - the IP is being provisioned.</li>
    value: option<sim-card-public-ip-status-value-enum>
  }

  record sim-card-public-ip-post-response {
    data: option<sim-card-public-ip>
  }

  record sim-card-public-ip-delete-response {
    data: option<sim-card-public-ip>
  }

  record wireless-connectivity-logs-get-response {
    data: option<list<wireless-connectivity-log>>,
    meta: option<pagination-meta>
  }

  /// This object represents a wireless connectivity session log that happened through a SIM card. It aids in finding out potential problems when the SIM is not able to attach properly.
  record wireless-connectivity-log {
    /// The Access Point Name (APN) identifies the packet data network that a mobile data user wants to communicate with.
    apn: option<string>,
    /// Uniquely identifies the session.
    id: option<s32>,
    /// The International Mobile Equipment Identity (or IMEI) is a number, usually unique, that identifies the device currently being used connect to the network.
    imei: option<string>,
    /// SIM cards are identified on their individual operator networks by a unique International Mobile Subscriber Identity (IMSI). <br/>
    /// Mobile network operators connect mobile phone calls and communicate with their market SIM cards using their IMSIs. The IMSI is stored in the Subscriber  Identity Module (SIM) inside the device and is sent by the device to the appropriate network. It is used to acquire the details of the device in the Home  Location Register (HLR) or the Visitor Location Register (VLR).
    imsi: option<string>,
    /// The SIM's address in the currently connected network. This IPv4 address is usually obtained dynamically, so it may vary according to the location or new connections.
    ipv4: option<string>,
    /// The SIM's address in the currently connected network. This IPv6 address is usually obtained dynamically, so it may vary according to the location or new connections.
    ipv6: option<string>,
    /// The type of the session, 'registration' being the initial authentication session and 'data' the actual data transfer sessions.
    log-type: option<wireless-connectivity-log-log-type-enum>,
    /// It's a three decimal digit that identifies a country.<br/><br/>
    /// This code is commonly seen joined with a Mobile Network Code (MNC) in a tuple that allows identifying a carrier known as PLMN (Public Land Mobile Network) code.
    mobile-country-code: option<string>,
    /// It's a two to three decimal digits that identify a network.<br/><br/>
    ///  This code is commonly seen joined with a Mobile Country Code (MCC) in a tuple that allows identifying a carrier known as PLMN (Public Land Mobile Network) code.
    mobile-network-code: option<string>,
    /// The radio technology the SIM card used during the session.
    radio-access-technology: option<string>,
    record-type: option<string>,
    /// The identification UUID of the related SIM card resource.
    sim-card-id: option<string>,
    /// ISO 8601 formatted date-time indicating when the session started.
    start-time: option<string>,
    /// The state of the SIM card after when the session happened.
    state: option<string>,
    /// ISO 8601 formatted date-time indicating when the session ended.
    stop-time: option<string>
  }

  variant bulk-sim-card-network-preferences-error {
    unprocessable-entity(string),
    other(string)
  }

  variant sim-card-enable-error {
    unprocessable-entity(string),
    other(string)
  }

  /// Bulk Network Preferences for SIM cards
  record bulk-sim-card-network-preferences-params {
    mobile-operator-networks-preferences: option<mobile-operator-networks-preferences-request>,
    sim-card-ids: option<list<string>>
  }
  bulk-sim-card-network-preferences: func(params: bulk-sim-card-network-preferences-params) -> result<bulk-sim-card-network-preferences-response, bulk-sim-card-network-preferences-error>;

  /// Register SIM cards
  record sim-card-register-params {
    registration-codes: list<string>,
    /// The group SIMCardGroup identification. This attribute can be <code>null</code> when it's present in an associated resource.
    sim-card-group-id: option<string>,
    /// Status on which the SIM card will be set after being successful registered.
    status: option<sim-card-registration-status-enum>,
    /// Searchable tags associated with the SIM card
    tags: option<list<string>>
  }
  sim-card-register: func(params: sim-card-register-params) -> result<sim-card-register-response, string>;

  /// Get all SIM cards
  record get-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// It includes the associated SIM card group object in the response when present.
    include-sim-card-group: option<bool>,
    /// A valid SIM card group ID.
    filter-sim-card-group-id: option<string>,
    /// A list of SIM card tags to filter on.<br/><br/>
    /// If the SIM card contains <b><i>all</i></b> of the given <code>tags</code> they will be found.<br/><br/>
    filter-tags: option<list<string>>,
    /// A search string to partially match for the SIM card's ICCID.
    filter-iccid: option<string>
  }
  get: func(params: get-params) -> result<get-response, string>;

  /// Validate SIM cards registration codes
  record post-validate-registration-codes-params {
    registration-codes: option<list<string>>
  }
  post-validate-registration-codes: func(params: post-validate-registration-codes-params) -> result<sim-card-registration-code-validations, string>;

  /// Get SIM card
  record sim-card-get-params {
    /// Identifies the resource.
    id: string,
    /// It includes the associated SIM card group object in the response when present.
    include-sim-card-group: option<bool>
  }
  sim-card-get: func(params: sim-card-get-params) -> result<sim-card-get-response, string>;

  /// Update a SIM card
  record sim-card-update-params {
    /// Identifies the resource.
    id: string,
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// The ICCID is the identifier of the specific SIM card/chip. Each SIM is internationally identified by its integrated circuit card identifier (ICCID). ICCIDs are stored in the SIM card's memory and are also engraved or printed on the SIM card body during a process called personalization.
    iccid: option<string>,
    /// Identifies the resource.
    id-v2: option<string>,
    /// SIM cards are identified on their individual operator networks by a unique International Mobile Subscriber Identity (IMSI). <br/>
    /// Mobile network operators connect mobile phone calls and communicate with their market SIM cards using their IMSIs. The IMSI is stored in the Subscriber  Identity Module (SIM) inside the device and is sent by the device to the appropriate network. It is used to acquire the details of the device in the Home  Location Register (HLR) or the Visitor Location Register (VLR).
    imsi: option<string>,
    /// The SIM's address in the currently connected network. This IPv4 address is usually obtained dynamically, so it may vary according to the location or new connections.
    ipv4: option<string>,
    /// The SIM's address in the currently connected network. This IPv6 address is usually obtained dynamically, so it may vary according to the location or new connections.
    ipv6: option<string>,
    /// Mobile Station International Subscriber Directory Number (MSISDN) is a number used to identify a mobile phone number internationally. <br/>
    /// MSISDN is defined by the E.164 numbering plan. It includes a country code and a National Destination Code which identifies the subscriber's operator.
    msisdn: option<string>,
    record-type: option<string>,
    /// The group SIMCardGroup identification. This attribute can be <code>null</code> when it's present in an associated resource.
    sim-card-group-id: option<string>,
    /// The current status of the SIM card. It will be one of the following: <br/>
    /// <ul>
    status: option<simple-sim-card-status-enum>,
    /// Searchable tags associated with the SIM card
    tags: option<list<string>>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }
  sim-card-update: func(params: sim-card-update-params) -> result<sim-card-update-response, string>;

  /// Deletes a SIM card
  record sim-card-delete-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-delete: func(params: sim-card-delete-params) -> result<sim-card-delete-response, string>;

  /// Request a SIM card disable
  record sim-card-disable-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-disable: func(params: sim-card-disable-params) -> result<sim-card-disable-response, string>;

  /// Request a SIM card enable
  record sim-card-enable-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-enable: func(params: sim-card-enable-params) -> result<sim-card-enable-response, sim-card-enable-error>;

  /// Request setting a SIM card to standby
  record sim-card-set-standby-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-set-standby: func(params: sim-card-set-standby-params) -> result<sim-card-set-standby-response, string>;

  /// Get network preferences
  record sim-card-network-preferences-get-params {
    /// Identifies a SIM card.
    sim-card-id: string,
    /// It includes the associated OTA update objects in the response when present.
    include-ota-updates: option<bool>
  }
  sim-card-network-preferences-get: func(params: sim-card-network-preferences-get-params) -> result<sim-card-network-preferences-get-response, string>;

  /// Set network preferences
  record sim-card-network-preferences-put-params {
    /// Identifies a SIM card.
    sim-card-id: string,
    /// A list of mobile operator networks and the priority that should be applied when the SIM is connecting to the network.
    mobile-operator-networks-preferences: option<list<mobile-operator-network-preferences-request>>
  }
  sim-card-network-preferences-put: func(params: sim-card-network-preferences-put-params) -> result<sim-card-network-preferences-put-response, string>;

  /// DELETE network preferences
  record sim-card-network-preferences-delete-params {
    /// Identifies a SIM card.
    sim-card-id: string
  }
  sim-card-network-preferences-delete: func(params: sim-card-network-preferences-delete-params) -> result<sim-card-network-preferences-delete-response, string>;

  /// Get SIM card public IP definition
  record sim-card-public-ip-get-params {
    /// Identifies a SIM card.
    sim-card-id: string
  }
  sim-card-public-ip-get: func(params: sim-card-public-ip-get-params) -> result<sim-card-public-ip-get-response, string>;

  /// Set SIM card public IP
  record sim-card-public-ip-post-params {
    /// Identifies a SIM card.
    sim-card-id: string
  }
  sim-card-public-ip-post: func(params: sim-card-public-ip-post-params) -> result<sim-card-public-ip-post-response, string>;

  /// Delete SIM card public IP
  record sim-card-public-ip-delete-params {
    /// Identifies a SIM card.
    sim-card-id: string
  }
  sim-card-public-ip-delete: func(params: sim-card-public-ip-delete-params) -> result<sim-card-public-ip-delete-response, string>;

  /// List wireless connectivity logs
  record wireless-connectivity-logs-get-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Identifies a SIM card.
    sim-card-id: string
  }
  wireless-connectivity-logs-get: func(params: wireless-connectivity-logs-get-params) -> result<wireless-connectivity-logs-get-response, string>;

}

interface addresses {
  enum find-addresss-sort-enum {
    created-at,
    first-name,
    last-name,
    business-name,
    street-address,
  }

  enum validate-address-result-result-op-enum {
    valid,
    invalid,
  }

  record find-addresss-response {
    data: option<list<address>>,
    meta: option<pagination-meta>
  }

  record address {
    address-book: option<address-book>,
    administrative-area: option<administrative-area>,
    borough: option<borough>,
    business-name: option<business-name>,
    country-code: option<country-code>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    customer-reference: option<customer-reference>,
    extended-address: option<extended-address>,
    first-name: option<first-name>,
    /// Uniquely identifies the address.
    id: option<string>,
    last-name: option<last-name>,
    locality: option<locality>,
    neighborhood: option<neighborhood>,
    phone-number: option<phone-number>,
    postal-code: option<postal-code>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    street-address: option<street-address>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>,
    validate-address: option<validate-address>
  }

  /// Indicates whether or not the address should be considered part of your list of addresses that appear for regular use.
  record address-book {
    /// opaque schema; raw JSON
    value: string
  }

  /// The locality of the address. For US addresses, this corresponds to the state of the address.
  record administrative-area {
    /// opaque schema; raw JSON
    value: string
  }

  /// The borough of the address. This field is not used for addresses in the US but is used for some international addresses.
  record borough {
    /// opaque schema; raw JSON
    value: string
  }

  /// The business name associated with the address. An address must have either a first last name or a business name.
  record business-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The two-character (ISO 3166-1 alpha-2) country code of the address.
  record country-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// A customer reference string for customer look ups.
  record customer-reference {
    /// opaque schema; raw JSON
    value: string
  }

  /// Additional street address information about the address such as, but not limited to, unit number or apartment number.
  record extended-address {
    /// opaque schema; raw JSON
    value: string
  }

  /// The first name associated with the address. An address must have either a first last name or a business name.
  record first-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The last name associated with the address. An address must have either a first last name or a business name.
  record last-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The locality of the address. For US addresses, this corresponds to the city of the address.
  record locality {
    /// opaque schema; raw JSON
    value: string
  }

  /// The neighborhood of the address. This field is not used for addresses in the US but is used for some international addresses.
  record neighborhood {
    /// opaque schema; raw JSON
    value: string
  }

  /// The phone number associated with the address.
  record phone-number {
    /// opaque schema; raw JSON
    value: string
  }

  /// The postal code of the address.
  record postal-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// The primary street address information about the address.
  record street-address {
    /// opaque schema; raw JSON
    value: string
  }

  /// Indicates whether or not the address should be validated for emergency use upon creation or not. This should be left with the default value of `true` unless you have used the `/addresses/actions/validate` endpoint to validate the address separately prior to creation. If an address is not validated for emergency use upon creation and it is not valid, it will not be able to be used for emergency services.
  record validate-address {
    /// opaque schema; raw JSON
    value: string
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-address-response {
    data: option<address>
  }

  record validate-address-v2-response {
    data: option<validate-address-result>
  }

  record validate-address-result {
    errors: option<list<error>>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Indicates whether an address is valid or invalid.
    result-op: validate-address-result-result-op-enum,
    suggested: validate-address-v3
  }

  record error {
    code: string,
    detail: option<string>,
    meta: option<error-meta>,
    source: option<error-source>,
    title: string
  }

  record error-meta {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record error-source {
    /// Indicates which query parameter caused the error.
    parameter: option<string>,
    /// JSON pointer (RFC6901) to the offending entity.
    pointer: option<string>
  }

  record validate-address-v3 {
    administrative-area: option<administrative-area>,
    country-code: option<country-code>,
    extended-address: option<extended-address>,
    locality: option<locality>,
    postal-code: option<postal-code>,
    street-address: option<street-address>
  }

  record get-address-response {
    data: option<address>
  }

  record delete-address-response {
    data: option<address>
  }

  variant find-addresss-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-address-error {
    unprocessable-entity(string),
    other(string)
  }

  variant validate-address-v2-error {
    unprocessable-entity(string),
    other(string)
  }

  variant get-address-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-address-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List all addresses
  record find-addresss-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter addresses via the customer reference set. Matching is not case-sensitive.
    filter-customer-reference-eq: option<string>,
    /// If present, addresses with <code>customer_reference</code> containing the given value will be returned. Matching is not case-sensitive.
    filter-customer-reference-contains: option<string>,
    /// If set as 'true', only addresses used as the emergency address for at least one active phone-number will be returned. When set to 'false', the opposite happens: only addresses not used as the emergency address from phone-numbers will be returned.
    filter-used-as-emergency: option<string>,
    /// If present, addresses with <code>street_address</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-street-address-contains: option<string>,
    /// If present, only returns results with the <code>address_book</code> flag set to the given value.
    filter-address-book-eq: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<find-addresss-sort-enum>
  }
  find-addresss: func(params: find-addresss-params) -> result<find-addresss-response, find-addresss-error>;

  /// Creates an address
  record create-address-params {
    address-book: option<address-book>,
    administrative-area: option<administrative-area>,
    borough: option<borough>,
    business-name: business-name,
    country-code: country-code,
    customer-reference: option<customer-reference>,
    extended-address: option<extended-address>,
    first-name: first-name,
    last-name: last-name,
    locality: locality,
    neighborhood: option<neighborhood>,
    phone-number: option<phone-number>,
    postal-code: option<postal-code>,
    street-address: street-address,
    validate-address: option<validate-address>
  }
  create-address: func(params: create-address-params) -> result<create-address-response, create-address-error>;

  /// Validate an address
  record validate-address-v2-params {
    administrative-area: option<administrative-area>,
    country-code: country-code,
    extended-address: option<extended-address>,
    locality: option<locality>,
    postal-code: postal-code,
    street-address: street-address
  }
  validate-address-v2: func(params: validate-address-v2-params) -> result<validate-address-v2-response, validate-address-v2-error>;

  /// Retrieve an address
  record get-address-params {
    /// address ID
    id: string
  }
  get-address: func(params: get-address-params) -> result<get-address-response, get-address-error>;

  /// Deletes an address
  record delete-address-params {
    /// address ID
    id: string
  }
  delete-address: func(params: delete-address-params) -> result<delete-address-response, delete-address-error>;

}

interface authentication-providers {
  enum find-authentication-providers-sort-enum {
    name,
    name-v2,
    short-name,
    short-name-v2,
    active,
    active-v2,
    created-at,
    created-at-v2,
    updated-at,
    updated-at-v2,
  }

  enum authentication-provider-settings-idp-cert-fingerprint-algorithm-enum {
    sha1,
    sha256,
    sha384,
    sha512,
  }

  record find-authentication-providers-response {
    data: option<list<authentication-provider>>,
    meta: option<pagination-meta>
  }

  record authentication-provider {
    active: option<active>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// Uniquely identifies the authentication provider.
    id: option<string>,
    name: option<name>,
    organization-id: option<organization-id>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// The settings associated with the authentication provider.
    settings: option<authentication-provider-settings>,
    short-name: option<short-name>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  /// The active status of the authentication provider
  record active {
    /// opaque schema; raw JSON
    value: string
  }

  /// The name associated with the authentication provider.
  record name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The id from the Organization the authentication provider belongs to.
  record organization-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The settings associated with the authentication provider.
  record authentication-provider-settings {
    /// The Assertion Consumer Service URL for the service provider (Telnyx).
    assertion-consumer-service-url: option<string>,
    /// The certificate fingerprint for the identity provider (IdP)
    idp-cert-fingerprint: option<string>,
    /// The algorithm used to generate the identity provider's (IdP) certificate fingerprint
    idp-cert-fingerprint-algorithm: option<authentication-provider-settings-idp-cert-fingerprint-algorithm-enum>,
    /// The Entity ID for the identity provider (IdP).
    idp-entity-id: option<string>,
    /// The SSO target url for the identity provider (IdP).
    idp-sso-target-url: option<string>,
    /// The name identifier format associated with the authentication provider. This must be the same for both the Identity Provider (IdP) and the service provider (Telnyx).
    name-identifier-format: option<string>,
    /// The Entity ID for the service provider (Telnyx).
    service-provider-entity-id: option<string>
  }

  /// The short name associated with the authentication provider. This must be unique and URL-friendly, as it's going to be part of the login URL.
  record short-name {
    /// opaque schema; raw JSON
    value: string
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  /// The settings associated with the authentication provider.
  record settings {
    /// The certificate fingerprint for the identity provider (IdP)
    idp-cert-fingerprint: string,
    /// The algorithm used to generate the identity provider's (IdP) certificate fingerprint
    idp-cert-fingerprint-algorithm: option<authentication-provider-settings-idp-cert-fingerprint-algorithm-enum>,
    /// The Entity ID for the identity provider (IdP).
    idp-entity-id: string,
    /// The SSO target url for the identity provider (IdP).
    idp-sso-target-url: string
  }

  /// The URL for the identity provider metadata file to populate the settings automatically. If the settings attribute is provided, that will be used instead.
  record settings-url {
    /// opaque schema; raw JSON
    value: string
  }

  record create-authentication-provider-response {
    data: option<authentication-provider>
  }

  record get-authentication-provider-response {
    data: option<authentication-provider>
  }

  record update-authentication-provider-response {
    data: option<authentication-provider>
  }

  record delete-authentication-provider-response {
    data: option<authentication-provider>
  }

  variant find-authentication-providers-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-authentication-provider-error {
    unprocessable-entity(string),
    other(string)
  }

  variant get-authentication-provider-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-authentication-provider-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-authentication-provider-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List all SSO authentication providers
  record find-authentication-providers-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<find-authentication-providers-sort-enum>
  }
  find-authentication-providers: func(params: find-authentication-providers-params) -> result<find-authentication-providers-response, find-authentication-providers-error>;

  /// Creates an authentication provider
  record create-authentication-provider-params {
    active: option<active>,
    name: name,
    settings: settings,
    settings-url: option<settings-url>,
    short-name: short-name
  }
  create-authentication-provider: func(params: create-authentication-provider-params) -> result<create-authentication-provider-response, create-authentication-provider-error>;

  /// Retrieve an authentication provider
  record get-authentication-provider-params {
    /// authentication provider ID
    id: string
  }
  get-authentication-provider: func(params: get-authentication-provider-params) -> result<get-authentication-provider-response, get-authentication-provider-error>;

  /// Update a authentication provider
  record update-authentication-provider-params {
    /// Identifies the resource.
    id: string,
    active: option<active>,
    name: option<name>,
    settings: option<settings>,
    settings-url: option<settings-url>,
    short-name: option<short-name>
  }
  update-authentication-provider: func(params: update-authentication-provider-params) -> result<update-authentication-provider-response, update-authentication-provider-error>;

  /// Deletes an authentication provider
  record delete-authentication-provider-params {
    /// authentication provider ID
    id: string
  }
  delete-authentication-provider: func(params: delete-authentication-provider-params) -> result<delete-authentication-provider-response, delete-authentication-provider-error>;

}

interface number-search {
  enum list-available-phone-number-blocks-filter-number-type-enum {
    toll-free,
  }

  enum list-available-phone-number-blocks-filter-features-item-enum {
    sms,
    mms,
    voice,
    fax,
    emergency,
  }

  enum available-phone-number-block-record-type-enum {
    available-phone-number-block,
  }

  enum region-information-region-type-enum {
    country-code,
    rate-center,
    state,
    location,
  }

  enum list-available-phone-numbers-filter-number-type-enum {
    toll-free,
    national,
    mobile,
    local,
  }

  enum available-phone-number-record-type-enum {
    available-phone-number,
  }

  record list-available-phone-number-blocks-response {
    data: option<list<available-phone-number-block>>,
    meta: option<available-phone-numbers-metadata>
  }

  record available-phone-number-block {
    cost-information: option<cost-information>,
    features: option<list<feature>>,
    range: option<s32>,
    record-type: option<available-phone-number-block-record-type-enum>,
    region-information: option<list<region-information>>,
    starting-number: option<string>
  }

  record cost-information {
    /// The ISO 4217 code for the currency.
    currency: option<string>,
    monthly-cost: option<string>,
    upfront-cost: option<string>
  }

  record feature {
    name: option<string>
  }

  record region-information {
    region-name: option<string>,
    region-type: option<region-information-region-type-enum>
  }

  record available-phone-numbers-metadata {
    best-effort-results: option<s32>,
    total-results: option<s32>
  }

  record list-available-phone-numbers-response {
    data: option<list<available-phone-number>>,
    meta: option<available-phone-numbers-metadata>
  }

  record available-phone-number {
    /// Specifies whether the phone number is an exact match based on the search criteria or not.
    best-effort: option<bool>,
    cost-information: option<cost-information>,
    features: option<list<feature>>,
    phone-number: option<string>,
    /// Specifies whether the phone number can receive calls immediately after purchase or not.
    quickship: option<bool>,
    record-type: option<available-phone-number-record-type-enum>,
    region-information: option<list<region-information>>,
    /// Specifies whether the phone number can be reserved before purchase or not.
    reservable: option<bool>,
    vanity-format: option<string>
  }

  /// List available phone number blocks
  record list-available-phone-number-blocks-params {
    /// Filter number blocks that start with a pattern (meant to be used after `national_destination_code` filter has been set).
    filter-phone-number-starts-with: option<string>,
    /// Filter numbers ending with a pattern.
    filter-phone-number-ends-with: option<string>,
    /// Filter numbers containing a pattern.
    filter-phone-number-contains: option<string>,
    /// Filter phone numbers by city.
    filter-locality: option<string>,
    /// Filter phone numbers by US state/CA province.
    filter-administrative-area: option<string>,
    /// Filter phone numbers by ISO alpha-2 country code.
    filter-country-code: option<string>,
    /// Filter by the national destination code of the number. This filter is only applicable to North American numbers.
    filter-national-destination-code: option<string>,
    /// Filter phone numbers by NANP rate center. This filter is only applicable to North American numbers.
    filter-rate-center: option<string>,
    /// Filter phone numbers by number type.
    filter-number-type: option<list-available-phone-number-blocks-filter-number-type-enum>,
    /// Filter if the phone number should be used for voice, fax, mms, sms, emergency.
    filter-features: option<list<list-available-phone-number-blocks-filter-features-item-enum>>,
    /// Filter number blocks by minimum blocks size
    filter-minimum-block-size: option<s32>,
    /// Limits the number of results.
    filter-limit: option<s32>
  }
  list-available-phone-number-blocks: func(params: list-available-phone-number-blocks-params) -> result<list-available-phone-number-blocks-response, string>;

  /// List available phone numbers
  record list-available-phone-numbers-params {
    /// Filter numbers starting with a pattern (meant to be used after `national_destination_code` filter has been set).
    filter-phone-number-starts-with: option<string>,
    /// Filter numbers ending with a pattern.
    filter-phone-number-ends-with: option<string>,
    /// Filter numbers containing a pattern.
    filter-phone-number-contains: option<string>,
    /// Filter phone numbers by city.
    filter-locality: option<string>,
    /// Filter phone numbers by US state/CA province.
    filter-administrative-area: option<string>,
    /// Filter phone numbers by ISO alpha-2 country code.
    filter-country-code: option<string>,
    /// Filter by the national destination code of the number. This filter is only applicable to North American numbers.
    filter-national-destination-code: option<string>,
    /// Filter phone numbers by NANP rate center. This filter is only applicable to North American numbers.
    filter-rate-center: option<string>,
    /// Filter phone numbers by number type.
    filter-number-type: option<list-available-phone-numbers-filter-number-type-enum>,
    /// Filter if the phone number should be used for voice, fax, mms, sms, emergency.
    filter-features: option<list<list-available-phone-number-blocks-filter-features-item-enum>>,
    /// Limits the number of results.
    filter-limit: option<s32>,
    /// Filter to determine if best effort results should be included.
    filter-best-effort: option<bool>,
    /// Filter to exclude phone numbers that need additional time after to purchase to receive phone calls.
    filter-quickship: option<bool>,
    /// Filter to exclude phone numbers that cannot be reserved before purchase.
    filter-reservable: option<bool>,
    /// Filter to exclude phone numbers that are currently on hold for your account.
    filter-exclude-held-numbers: option<bool>
  }
  list-available-phone-numbers: func(params: list-available-phone-numbers-params) -> result<list-available-phone-numbers-response, string>;

}

