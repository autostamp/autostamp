interface mobile-operator-networks {
  record get-response {
    data: option<list<mobile-operator-network>>,
    meta: option<pagination-meta>
  }

  record mobile-operator-network {
    /// The mobile operator two-character (ISO 3166-1 alpha-2) origin country code.
    country-code: option<string>,
    /// Identifies the resource.
    id: option<string>,
    /// MCC stands for Mobile Country Code. It's a three decimal digit that identifies a country.<br/><br/>
    /// This code is commonly seen joined with a Mobile Network Code (MNC) in a tuple that allows identifying a carrier known as PLMN (Public Land Mobile Network) code.
    mcc: option<string>,
    /// MNC stands for Mobile Network Code. It's a two to three decimal digits that identify a network.<br/><br/>
    ///  This code is commonly seen joined with a Mobile Country Code (MCC) in a tuple that allows identifying a carrier known as PLMN (Public Land Mobile Network) code.
    mnc: option<string>,
    /// The operator network name.
    name: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// TADIG stands for Transferred Account Data Interchange Group. The TADIG code is a unique identifier for network operators in GSM mobile networks.
    tadig: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  /// List mobile operator networks
  record get-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter by name starting with.
    filter-name-starts-with: option<string>,
    /// Filter by name containing match.
    filter-name-contains: option<string>,
    /// Filter by name ending with.
    filter-name-ends-with: option<string>,
    /// Filter by exact country_code.
    filter-country-code: option<string>,
    /// Filter by exact MCC.
    filter-mcc: option<string>,
    /// Filter by exact MNC.
    filter-mnc: option<string>,
    /// Filter by exact TADIG.
    filter-tadig: option<string>
  }
  get: func(params: get-params) -> result<get-response, string>;

}

