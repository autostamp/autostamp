interface sim-card-orders {
  enum sim-card-order-status-enum {
    pending,
    processing,
    ready-to-ship,
    shipped,
    delivered,
  }

  record preview-response {
    data: option<sim-card-order-preview>
  }

  record sim-card-order-preview {
    /// The amount of SIM cards requested in the SIM card order.
    quantity: option<s32>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    shipping-cost: option<sim-card-order-preview-shipping-cost>,
    sim-cards-cost: option<sim-card-order-preview-sim-cards-cost>,
    total-cost: option<sim-card-order-preview-total-cost>
  }

  record sim-card-order-preview-shipping-cost {
    /// A string representing the cost amount.
    amount: option<string>,
    /// ISO 4217 currency string.
    currency: option<string>
  }

  record sim-card-order-preview-sim-cards-cost {
    /// A string representing the cost amount.
    amount: option<string>,
    /// ISO 4217 currency string.
    currency: option<string>
  }

  record sim-card-order-preview-total-cost {
    /// A string representing the cost amount.
    amount: option<string>,
    /// ISO 4217 currency string.
    currency: option<string>
  }

  record get-response {
    data: option<list<sim-card-order>>,
    meta: option<pagination-meta>
  }

  record sim-card-order {
    /// An object representing the total cost of the order.
    cost: option<sim-card-order-cost>,
    /// ISO 8601 formatted date-time indicating when the resource was last created.
    created-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    /// An object representing the address information from when the order was submitted.
    order-address: option<sim-card-order-order-address>,
    /// The amount of SIM cards requested in the SIM card order.
    quantity: option<s32>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// The current status of the SIM Card order.<ul> <li><code>pending</code> - the order is waiting to be processed.</li> <li><code>processing</code> - the order is currently being processed.</li> <li><code>ready_to_ship</code> - the order is ready to be shipped to the specified <b>address</b>.</li> <li><code>shipped</code> - the order was shipped and is on its way to be delivered to the specified <b>address</b>.</li> <li><code>delivered</code> - the order was delivered to the specified <b>address</b>.</li> </ul>
    status: option<sim-card-order-status-enum>,
    /// The URL used to get tracking information about the order.
    tracking-url: option<string>,
    /// ISO 8601 formatted date-time indicating when the resource was last updated.
    updated-at: option<string>
  }

  /// An object representing the total cost of the order.
  record sim-card-order-cost {
    /// A string representing the cost amount.
    amount: option<string>,
    /// Filter by ISO 4217 currency string.
    currency: option<string>
  }

  /// An object representing the address information from when the order was submitted.
  record sim-card-order-order-address {
    /// State or province where the address is located.
    administrative-area: option<string>,
    /// The mobile operator two-character (ISO 3166-1 alpha-2) origin country code.
    country-code: option<string>,
    /// Supplemental field for address information.
    extended-address: option<string>,
    /// Uniquely identifies the address for the order.
    id: option<string>,
    /// The name of the city where the address is located.
    locality: option<string>,
    /// Postal code for the address.
    postal-code: option<string>,
    /// The name of the street where the address is located.
    street-address: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record post-response {
    data: option<sim-card-order>
  }

  record sim-card-order-get-response {
    data: option<sim-card-order>
  }

  variant preview-error {
    unprocessable-entity(string),
    other(string)
  }

  variant sim-card-order-get-error {
    not-found(string),
    other(string)
  }

  /// Preview SIM card orders
  record preview-params {
    /// Uniquely identifies the address for the order.
    address-id: string,
    /// The amount of SIM cards that the user would like to purchase in the SIM card order.
    quantity: s32
  }
  preview: func(params: preview-params) -> result<preview-response, preview-error>;

  /// Get all SIM card orders
  record get-params {
    /// Filter by ISO 8601 formatted date-time string matching resource creation date-time.
    filter-created-at: option<string>,
    /// Filter by ISO 8601 formatted date-time string matching resource last update date-time.
    filter-updated-at: option<string>,
    /// Filter orders by how many SIM cards were ordered.
    filter-quantity: option<s32>,
    /// The total monetary amount of the order.
    filter-cost-amount: option<string>,
    /// Filter by ISO 4217 currency string.
    filter-cost-currency: option<string>,
    /// Uniquely identifies the address for the order.
    filter-address-id: option<string>,
    /// Returns entries with matching name of the street where the address is located.
    filter-address-street-address: option<string>,
    /// Returns entries with matching name of the supplemental field for address information.
    filter-address-extended-address: option<string>,
    /// Filter by the name of the city where the address is located.
    filter-address-locality: option<string>,
    /// Filter by state or province where the address is located.
    filter-address-administrative-area: option<string>,
    /// Filter by the mobile operator two-character (ISO 3166-1 alpha-2) origin country code.
    filter-address-country-code: option<string>,
    /// Filter by postal code for the address.
    filter-address-postal-code: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  get: func(params: get-params) -> result<get-response, string>;

  /// Create a SIM card order
  record post-params {
    /// Uniquely identifies the address for the order.
    address-id: string,
    /// The amount of SIM cards to order.
    quantity: s32
  }
  post: func(params: post-params) -> result<post-response, string>;

  /// Get a single SIM card order
  record sim-card-order-get-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-order-get: func(params: sim-card-order-get-params) -> result<sim-card-order-get-response, sim-card-order-get-error>;

}

interface credentials {
  record find-telephony-credentials-response {
    data: option<list<telephony-credential>>,
    meta: option<pagination-meta>
  }

  record telephony-credential {
    /// ISO-8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// Defaults to false
    expired: option<bool>,
    /// ISO-8601 formatted date indicating when the resource will expire.
    expires-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    name: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Identifies the resource this credential is associated with.
    resource-id: option<string>,
    /// The randomly generated SIP password for the credential.
    sip-password: option<string>,
    /// The randomly generated SIP username for the credential.
    sip-username: option<string>,
    /// ISO-8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-telephony-credential-response {
    data: option<telephony-credential>
  }

  record list-tags-response {
    data: option<list<list-tags-response-data-item>>,
    meta: option<pagination-meta>
  }

  record list-tags-response-data-item {
    amount: option<s32>,
    tag: option<string>
  }

  record get-telephony-credential-response {
    data: option<telephony-credential>
  }

  record update-telephony-credential-response {
    data: option<telephony-credential>
  }

  record delete-telephony-credential-response {
    data: option<telephony-credential>
  }

  record telephony-credential-action-response {
    data: option<telephony-credential>
  }

  variant find-telephony-credentials-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-telephony-credential-error {
    unprocessable-entity(string),
    other(string)
  }

  variant list-tags-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-telephony-credential-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-telephony-credential-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-telephony-credential-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant telephony-credential-action-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// List all credentials
  record find-telephony-credentials-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter by tag
    filter-tag: option<string>,
    /// Filter by name
    filter-name: option<string>,
    /// Filter by status
    filter-status: option<string>,
    /// Filter by resource_id
    filter-resource-id: option<string>,
    /// Filter by sip_username
    filter-sip-username: option<string>
  }
  find-telephony-credentials: func(params: find-telephony-credentials-params) -> result<find-telephony-credentials-response, find-telephony-credentials-error>;

  /// Create a credential
  record create-telephony-credential-params {
    /// Identifies the Credential Connection this credential is associated with.
    connection-id: string,
    /// ISO-8601 formatted date indicating when the credential will expire.
    expires-at: option<string>,
    name: option<string>,
    /// Tags a credential to filter for bulk operations. A single tag can hold at maximum 1000 credentials.
    tag: option<string>
  }
  create-telephony-credential: func(params: create-telephony-credential-params) -> result<create-telephony-credential-response, create-telephony-credential-error>;

  /// List all tags
  record list-tags-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-tags: func(params: list-tags-params) -> result<list-tags-response, list-tags-error>;

  /// Get a credential
  record get-telephony-credential-params {
    /// Identifies the resource.
    id: string
  }
  get-telephony-credential: func(params: get-telephony-credential-params) -> result<get-telephony-credential-response, get-telephony-credential-error>;

  /// Update a credential
  record update-telephony-credential-params {
    /// Identifies the resource.
    id: string,
    /// Identifies the Credential Connection this credential is associated with.
    connection-id: option<string>,
    /// ISO-8601 formatted date indicating when the credential will expire.
    expires-at: option<string>,
    name: option<string>,
    /// Tags a credential to filter for bulk operations. A single tag can hold at maximum 1000 credentials.
    tag: option<string>
  }
  update-telephony-credential: func(params: update-telephony-credential-params) -> result<update-telephony-credential-response, update-telephony-credential-error>;

  /// Delete a credential
  record delete-telephony-credential-params {
    /// Identifies the resource.
    id: string
  }
  delete-telephony-credential: func(params: delete-telephony-credential-params) -> result<delete-telephony-credential-response, delete-telephony-credential-error>;

  /// Perform activate or deactivate action on provided Credential
  record telephony-credential-action-params {
    /// Identifies the resource.
    id: string,
    /// Identifies the action to be taken.
    action: string
  }
  telephony-credential-action: func(params: telephony-credential-action-params) -> result<telephony-credential-action-response, telephony-credential-action-error>;

}

interface access-tokens {
  variant create-telephony-credential-token-error {
    not-found(string),
