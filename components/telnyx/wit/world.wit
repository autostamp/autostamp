  record list-rooms-response {
    data: option<list<room>>,
    meta: option<pagination-meta>
  }

  record room {
    /// The identifier of the active room session if any.
    active-session-id: option<string>,
    /// ISO 8601 timestamp when the room was created.
    created-at: option<string>,
    /// Identifies the room.
    id: option<string>,
    /// Maximum participants allowed in the room.
    max-participants: option<s32>,
    record-type: option<string>,
    sessions: option<list<room-session>>,
    /// The unique (within the Telnyx account scope) name of the room.
    unique-name: option<string>,
    /// ISO 8601 timestamp when the room was updated.
    updated-at: option<string>
  }

  record room-session {
    /// Shows if the room session is active or not.
    active: option<bool>,
    /// ISO 8601 timestamp when the room session was created.
    created-at: option<string>,
    /// ISO 8601 timestamp when the room session has ended.
    ended-at: option<string>,
    /// Identifies the room session.
    id: option<string>,
    participants: option<list<room-participant>>,
    record-type: option<string>,
    /// Identify the room hosting that room session.
    room-id: option<string>,
    /// ISO 8601 timestamp when the room session was updated.
    updated-at: option<string>
  }

  record room-participant {
    /// Context provided to the given participant through the client SDK
    context: option<string>,
    /// Identifies the room participant.
    id: option<string>,
    /// ISO 8601 timestamp when the participant joined the session.
    joined-at: option<string>,
    /// ISO 8601 timestamp when the participant left the session.
    left-at: option<string>,
    record-type: option<string>,
    /// Identify the room session that participant is part of.
    session-id: option<string>,
    /// ISO 8601 timestamp when the participant was updated.
    updated-at: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-room-response {
    data: option<room>
  }

  record view-room-response {
    data: option<room>
  }

  record nested-list-room-sessions-response {
    data: option<list<room-session>>,
    meta: option<pagination-meta>
  }

  variant create-room-error {
    unprocessable-entity(string),
    other(string)
  }

  variant view-room-error {
    not-found(string),
    other(string)
  }

  variant delete-room-error {
    not-found(string),
    other(string)
  }

  /// View a list of rooms.
  record list-rooms-params {
    /// ISO 8601 date for filtering rooms created on that date.
    filter-date-created-at-eq: option<string>,
    /// ISO 8601 date for filtering rooms created after that date.
    filter-date-created-at-gte: option<string>,
    /// ISO 8601 date for filtering rooms created before that date.
    filter-date-created-at-lte: option<string>,
    /// ISO 8601 date for filtering rooms updated on that date.
    filter-date-updated-at-eq: option<string>,
    /// ISO 8601 date for filtering rooms updated after that date.
    filter-date-updated-at-gte: option<string>,
    /// ISO 8601 date for filtering rooms updated before that date.
    filter-date-updated-at-lte: option<string>,
    /// Unique_name for filtering rooms.
    filter-unique-name: option<string>,
    /// To decide if room sessions should be included in the response.
    include-sessions: option<bool>,
    /// The size of the page.
    page-size: option<s32>,
    /// The page number to load.
    page-number: option<s32>
  }
  list-rooms: func(params: list-rooms-params) -> result<list-rooms-response, string>;

  /// Create a room.
  record create-room-params {
    /// The maximum amount of participants allowed in a room. If new participants try to join after that limit is reached, their request will be rejected.
    max-participants: option<s32>,
    /// The unique (within the Telnyx account scope) name of the room.
    unique-name: option<string>
  }
  create-room: func(params: create-room-params) -> result<create-room-response, create-room-error>;

  /// View a room.
  record view-room-params {
    /// The unique identifier of a room.
    room-id: string,
    /// To decide if room sessions should be included in the response.
    include-sessions: option<bool>
  }
  view-room: func(params: view-room-params) -> result<view-room-response, view-room-error>;

  /// Delete a room.
  record delete-room-params {
    /// The unique identifier of a room.
    room-id: string
  }
  delete-room: func(params: delete-room-params) -> result<string, delete-room-error>;

  /// View a list of room sessions.
  record nested-list-room-sessions-params {
    /// The unique identifier of a room.
    room-id: string,
    /// ISO 8601 date for filtering room sessions created on that date.
    filter-date-created-at-eq: option<string>,
    /// ISO 8601 date for filtering room sessions created after that date.
    filter-date-created-at-gte: option<string>,
    /// ISO 8601 date for filtering room sessions created before that date.
    filter-date-created-at-lte: option<string>,
    /// ISO 8601 date for filtering room sessions updated on that date.
    filter-date-updated-at-eq: option<string>,
    /// ISO 8601 date for filtering room sessions updated after that date.
    filter-date-updated-at-gte: option<string>,
    /// ISO 8601 date for filtering room sessions updated before that date.
    filter-date-updated-at-lte: option<string>,
    /// ISO 8601 date for filtering room sessions ended on that date.
    filter-date-ended-at-eq: option<string>,
    /// ISO 8601 date for filtering room sessions ended after that date.
    filter-date-ended-at-gte: option<string>,
    /// ISO 8601 date for filtering room sessions ended before that date.
    filter-date-ended-at-lte: option<string>,
    /// Filter active or inactive room sessions.
    filter-active: option<bool>,
    /// To decide if room participants should be included in the response.
    include-participants: option<bool>,
    /// The size of the page.
    page-size: option<s32>,
    /// The page number to load.
    page-number: option<s32>
  }
  nested-list-room-sessions: func(params: nested-list-room-sessions-params) -> result<nested-list-room-sessions-response, string>;

}

interface rooms-client-tokens {
  record create-room-client-token-response {
    data: option<create-room-client-token-response-data>
  }

  record create-room-client-token-response-data {
    refresh-token: option<string>,
    /// ISO 8601 timestamp when the refresh token expires.
    refresh-token-expires-at: option<string>,
    token: option<string>,
    /// ISO 8601 timestamp when the token expires.
    token-expires-at: option<string>
  }

  record refresh-room-client-token-response {
    data: option<refresh-room-client-token-response-data>
  }

  record refresh-room-client-token-response-data {
    token: option<string>,
    /// ISO 8601 timestamp when the token expires.
    token-expires-at: option<string>
  }

  variant create-room-client-token-error {
    forbidden(string),
    other(string)
  }

  variant refresh-room-client-token-error {
    forbidden(string),
    other(string)
  }

  /// Create Client Token to join a room.
  record create-room-client-token-params {
    /// The unique identifier of a room.
    room-id: string,
    /// The time to live in seconds of the Refresh Token, after that time the Refresh Token is invalid and can't be used to refresh Client Token.
    refresh-token-ttl-secs: option<s32>,
    /// The time to live in seconds of the Client Token, after that time the Client Token is invalid and can't be used to join a Room.
    token-ttl-secs: option<s32>
  }
  create-room-client-token: func(params: create-room-client-token-params) -> result<create-room-client-token-response, create-room-client-token-error>;

  /// Refresh Client Token to join a room.
  record refresh-room-client-token-params {
    /// The unique identifier of a room.
    room-id: string,
    refresh-token: string,
    /// The time to live in seconds of the Client Token, after that time the Client Token is invalid and can't be used to join a Room.
    token-ttl-secs: option<s32>
  }
  refresh-room-client-token: func(params: refresh-room-client-token-params) -> result<refresh-room-client-token-response, refresh-room-client-token-error>;

}

interface short-codes {
  enum short-code-record-type-enum {
    short-code,
  }

  record list-short-codes-response {
    data: option<list<short-code>>,
