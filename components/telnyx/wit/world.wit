    caller-passthru,
    callee-passthru,
  }

  enum create-ip-connection-request-transport-protocol-enum {
    udp,
    tcp,
    tls,
  }

  enum create-ip-connection-request-webhook-api-version-enum {
    v1,
    v2,
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
  record dtmf-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Enable use of SRTP or ZRTP for encryption. Valid values are those listed or null. Cannot be set to non-null if the transport_portocol is TLS.
  record encrypted-media {
    /// opaque schema; raw JSON
    value: string
  }

  record create-inbound-ip-request {
    /// This setting allows you to set the format with which the caller's number (ANI) is sent for inbound phone calls.
    ani-number-format: option<create-inbound-ip-request-ani-number-format-enum>,
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Defines the list of codecs that Telnyx will send for inbound calls to a specific number on your portal account, in priority order. This only works when the Connection the number is assigned to uses Media Handling mode: default. OPUS and H.264 codecs are available only when using TCP or TLS transport for SIP.
    codecs: option<list<string>>,
    /// Default routing method to be used when a number is associated with the connection. Must be one of the routing method types or left blank, other values are not allowed.
    default-routing-method: option<create-inbound-ip-request-default-routing-method-enum>,
    dnis-number-format: option<create-inbound-ip-request-dnis-number-format-enum>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, inbound phone calls will receive ISUP parameters via SIP headers. (Only when available and only when using TCP or TLS transport.)
    isup-headers-enabled: option<bool>,
    /// Enable PRACK messages as defined in RFC3262.
    prack-enabled: option<bool>,
    /// By default, Telnyx does not send caller-id information when the caller has chosen to hide this information. When this option is enabled, Telnyx will send the SIP header Privacy:id plus the caller-id information so that the receiver side can choose when to hide it.
    privacy-zone-enabled: option<bool>,
    /// Defaults to true.
    sip-compact-headers-enabled: option<bool>,
    /// Selects which `sip_region` to receive inbound calls from. If null, the default region (US) will be used.
    sip-region: option<create-inbound-ip-request-sip-region-enum>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<create-inbound-ip-request-sip-subdomain-receive-settings-enum>,
    /// Time(sec) before aborting if connection is not made.
    timeout-v1xx-secs: option<s32>,
    /// Time(sec) before aborting if call is unanswered (min: 1, max: 600).
    timeout-v2xx-secs: option<s32>
  }

  record outbound-ip {
    /// Set a phone number as the ani_override value to override caller id number on outbound calls.
    ani-override: option<string>,
    /// Specifies when we apply your ani_override setting. Only applies when ani_override is not blank.
    ani-override-type: option<outbound-ip-ani-override-type-enum>,
    /// Forces all SIP calls originated on this connection to be "parked" instead of "bridged" to the destination specified on the URI. Parked calls will return ringback to the caller and will await for a Call Control command to define which action will be taken next.
    call-parking-enabled: option<bool>,
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, ringback will not wait for indication before sending ringback tone to calling party.
    instant-ringback-enabled: option<bool>,
    ip-authentication-method: option<outbound-ip-ip-authentication-method-enum>,
    ip-authentication-token: option<string>,
    /// A 2-character country code specifying the country whose national dialing rules should be used. For example, if set to `US` then any US number can be dialed without preprending +1 to the number. When left blank, Telnyx will try US and GB dialing rules, in that order, by default.
    localization: option<string>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>,
    /// This setting only affects connections with Fax-type Outbound Voice Profiles. The setting dictates whether or not Telnyx sends a t.38 reinvite.<br/><br/> By default, Telnyx will send the re-invite. If set to `customer`, the caller is expected to send the t.38 reinvite.
    t38-reinvite-source: option<outbound-ip-t38-reinvite-source-enum>,
    /// Numerical chars only, exactly 4 characters.
    tech-prefix: option<string>
  }

  /// Identifies the associated outbound voice profile.
  record outbound-voice-profile-id {
    /// opaque schema; raw JSON
    value: string
  }

  record connection-rtcp-settings {
    /// BETA - Enable the capture and storage of RTCP messages to create QoS reports on the Telnyx Mission Control Portal.
    capture-enabled: option<bool>,
    /// RTCP port by default is rtp+1, it can also be set to rtcp-mux
    port: option<string>,
    /// RTCP reports are sent to customers based on the frequency set. Frequency is in seconds and it can be set to values from 5 to 3000 seconds.
    report-frequency-secs: option<s32>
  }

  record inbound-ip {
    /// This setting allows you to set the format with which the caller's number (ANI) is sent for inbound phone calls.
    ani-number-format: option<create-inbound-ip-request-ani-number-format-enum>,
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Defines the list of codecs that Telnyx will send for inbound calls to a specific number on your portal account, in priority order. This only works when the Connection the number is assigned to uses Media Handling mode: default. OPUS and H.264 codecs are available only when using TCP or TLS transport for SIP.
    codecs: option<list<string>>,
    /// The default primary IP to use for the number. Only settable if the connection is
    ///               of IP authentication type. Value must be the ID of an authorized IP set on the connection.
    default-primary-ip-id: option<string>,
    /// Default routing method to be used when a number is associated with the connection. Must be one of the routing method types or left blank, other values are not allowed.
    default-routing-method: option<create-inbound-ip-request-default-routing-method-enum>,
    /// The default secondary IP to use for the number. Only settable if the connection is
    ///               of IP authentication type. Value must be the ID of an authorized IP set on the connection.
    default-secondary-ip-id: option<string>,
    /// The default tertiary IP to use for the number. Only settable if the connection is
    ///               of IP authentication type. Value must be the ID of an authorized IP set on the connection.
    default-tertiary-ip-id: option<string>,
    dnis-number-format: option<create-inbound-ip-request-dnis-number-format-enum>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, inbound phone calls will receive ISUP parameters via SIP headers. (Only when available and only when using TCP or TLS transport.)
    isup-headers-enabled: option<bool>,
    /// Enable PRACK messages as defined in RFC3262.
    prack-enabled: option<bool>,
    /// By default, Telnyx does not send caller-id information when the caller has chosen to hide this information. When this option is enabled, Telnyx will send the SIP header Privacy:id plus the caller-id information so that the receiver side can choose when to hide it.
    privacy-zone-enabled: option<bool>,
    /// Defaults to true.
    sip-compact-headers-enabled: option<bool>,
    /// Selects which `sip_region` to receive inbound calls from. If null, the default region (US) will be used.
    sip-region: option<create-inbound-ip-request-sip-region-enum>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<create-inbound-ip-request-sip-subdomain-receive-settings-enum>,
    /// Time(sec) before aborting if connection is not made.
    timeout-v1xx-secs: option<s32>,
    /// Time(sec) before aborting if call is unanswered (min: 1, max: 600).
    timeout-v2xx-secs: option<s32>
  }

  /// List Ip connections
  record list-ip-connections-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, connections with <code>connection_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-ip-connections-sort-enum>
  }
  list-ip-connections: func(params: list-ip-connections-params) -> result<string, string>;

  /// Create an Ip connection
  record create-ip-connection-params {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<create-inbound-ip-request>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<outbound-ip>,
    rtcp-settings: option<connection-rtcp-settings>,
    /// One of UDP, TLS, or TCP. Applies only to connections with IP authentication or FQDN authentication.
    transport-protocol: option<create-ip-connection-request-transport-protocol-enum>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<create-ip-connection-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  create-ip-connection: func(params: create-ip-connection-params) -> result<string, string>;

  /// Retrieve an Ip connection
  record retrieve-ip-connection-params {
    /// IP Connection ID
    id: string
  }
  retrieve-ip-connection: func(params: retrieve-ip-connection-params) -> result<string, string>;

  /// Update an Ip connection
  record update-ip-connection-params {
    /// Identifies the type of resource.
    id: string,
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<inbound-ip>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<outbound-ip>,
    rtcp-settings: option<connection-rtcp-settings>,
    /// One of UDP, TLS, or TCP. Applies only to connections with IP authentication or FQDN authentication.
    transport-protocol: option<create-ip-connection-request-transport-protocol-enum>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<create-ip-connection-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  update-ip-connection: func(params: update-ip-connection-params) -> result<string, string>;

  /// Delete an Ip connection
  record delete-ip-connection-params {
    /// Identifies the type of resource.
    id: string
  }
  delete-ip-connection: func(params: delete-ip-connection-params) -> result<string, string>;

}

interface i-ps {
  /// List Ips
  record list-ips-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// ID of the IP Connection to which this IP should be attached.
    filter-connection-id: option<string>,
    /// IP adddress represented by this resource.
    filter-ip-address: option<string>,
    /// Port to use when connecting to this IP.
    filter-port: option<s32>
  }
  list-ips: func(params: list-ips-params) -> result<string, string>;

  /// Create an Ip
  record create-ip-params {
    /// ID of the IP Connection to which this IP should be attached.
    connection-id: option<string>,
    /// IP adddress represented by this resource.
    ip-address: string,
    /// Port to use when connecting to this IP.
    port: option<s32>
  }
  create-ip: func(params: create-ip-params) -> result<string, string>;

  /// Retrieve an Ip
  record retrieve-ip-params {
    /// Identifies the type of resource.
    id: string
  }
  retrieve-ip: func(params: retrieve-ip-params) -> result<string, string>;

  /// Update an Ip
  record update-ip-params {
    /// Identifies the type of resource.
    id: string,
    /// ID of the IP Connection to which this IP should be attached.
    connection-id: option<string>,
    /// IP adddress represented by this resource.
    ip-address: string,
    /// Port to use when connecting to this IP.
    port: option<s32>
  }
  update-ip: func(params: update-ip-params) -> result<string, string>;

  /// Delete an Ip
  record delete-ip-params {
    /// Identifies the type of resource.
    id: string
  }
  delete-ip: func(params: delete-ip-params) -> result<string, string>;

}

interface reports {
  /// Create a ledger billing group report
  record create-ledger-billing-group-report-params {
    /// Month of the ledger billing group report
    month: option<s32>,
    /// Year of the ledger billing group report
    year: option<s32>
  }
  create-ledger-billing-group-report: func(params: create-ledger-billing-group-report-params) -> result<string, string>;

  /// Retrieve a ledger billing group report
  record retrieve-ledger-billing-group-report-params {
    /// The id of the ledger billing group report
    id: string
  }
  retrieve-ledger-billing-group-report: func(params: retrieve-ledger-billing-group-report-params) -> result<string, string>;

}

interface managed-accounts {
  enum list-managed-accounts-sort-enum {
    created-at,
    email,
  }

  /// Lists accounts managed by the current user.
  record list-managed-accounts-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, email containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-email-contains: option<string>,
    /// If present, only returns results with the <code>email</code> matching exactly the value given.
    filter-email-eq: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-managed-accounts-sort-enum>
  }
  list-managed-accounts: func(params: list-managed-accounts-params) -> result<string, string>;

  /// Create a new managed account.
  record create-managed-account-params {
    /// The name of the business for which the new managed account is being created, that will be used as the managed accounts's organization's name.
    business-name: string,
    /// The email address for the managed account. If not provided, the email address will be generated based on the email address of the manager account.
    email: option<string>,
    /// Password for the managed account. If a password is not supplied, the account will not be able to be signed into directly. (A password reset may still be performed later to enable sign-in via password.)
    password: option<string>
  }
  create-managed-account: func(params: create-managed-account-params) -> result<string, string>;

  /// Retrieve a managed account
  record retrieve-managed-account-params {
    /// Managed Account User ID
    id: string
  }
  retrieve-managed-account: func(params: retrieve-managed-account-params) -> result<string, string>;

  /// Disables a managed account
  record disable-managed-account-params {
    /// Managed Account User ID
    id: string
  }
  disable-managed-account: func(params: disable-managed-account-params) -> result<string, string>;

  /// Enables a managed account
  record enable-managed-account-params {
    /// Managed Account User ID
    id: string
  }
  enable-managed-account: func(params: enable-managed-account-params) -> result<string, string>;

}

interface media-storage-api {
  /// List uploaded media
  list-media: func() -> result<string, string>;

  /// Upload media
  record create-media-params {
    /// The unique identifier of a file.
    media-name: option<string>,
    /// The URL where the media to be stored in Telnyx network is currently hosted. The maximum allowed size is 20 MB.
    media-url: string,
    /// The number of seconds after which the media resource will be deleted, defaults to 2 days.
    ttl-secs: option<s32>
  }
  create-media: func(params: create-media-params) -> result<string, string>;

  /// Retrieve stored media
  record get-media-params {
    /// Uniquely identifies a media resource.
    media-name: string
  }
  get-media: func(params: get-media-params) -> result<string, string>;

  /// Update stored media
  record update-media-params {
    /// Uniquely identifies a media resource.
    media-name: string,
    /// The URL where the media to be stored in Telnyx network is currently hosted. The maximum allowed size is 20 MB.
    media-url: option<string>,
    /// The number of seconds after which the media resource will be deleted, defaults to 2 days.
    ttl-secs: option<s32>
  }
  update-media: func(params: update-media-params) -> result<string, string>;

  /// Deletes stored media
  record delete-media-params {
    /// Uniquely identifies a media resource.
    media-name: string
  }
  delete-media: func(params: delete-media-params) -> result<string, string>;

  /// Download stored media
  record download-media-params {
    /// Uniquely identifies a media resource.
    media-name: string
  }
  download-media: func(params: download-media-params) -> result<string, string>;

}

interface mdr-search-beta {
  record direction {
    /// opaque schema; raw JSON
    value: string
  }

  /// Message status
  record message-status {
    /// opaque schema; raw JSON
    value: string
  }

  /// type of the message
  record message-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Used product
  record product {
    /// opaque schema; raw JSON
    value: string
  }

  /// Fetch messaging detail records.
  record get-paginated-mdrs-params {
    /// Start date
    start-date: string,
    /// End date
    end-date: string,
    id: option<string>,
    direction: option<direction>,
    outbound-profile-id: option<string>,
    cld: option<string>,
    cli: option<string>,
    status: option<message-status>,
    message-type: option<message-type>,
    country-iso: option<string>,
    error: option<string>,
    normalized-carrier: option<string>,
    tag: option<string>,
    mcc: option<string>,
    mnc: option<string>,
    product: option<product>,
    /// Page number
    page-number: option<s32>,
    /// Size of the page
    page-size: option<s32>,
    sort: option<list<string>>
  }
  get-paginated-mdrs: func(params: get-paginated-mdrs-params) -> result<string, string>;

  /// Fetch message body by id.
  record get-mdr-message-body-params {
    /// Message unique identifier
    id: string
  }
  get-mdr-message-body: func(params: get-mdr-message-body-params) -> result<string, string>;

}

interface messages {
  enum create-message-request-type-op-enum {
    sms,
    mms,
  }

  /// Receiving address (+E.164 formatted phone number or short code).
  record to-number {
    /// opaque schema; raw JSON
    value: string
  }

  /// Send a message
  record create-message-params {
    /// Automatically detect if an SMS message is unusually long and exceeds a recommended limit of message parts.
    auto-detect: option<bool>,
    /// Sending address (+E.164 formatted phone number, alphanumeric sender ID, or short code).
    /// 
    from-op: option<string>,
    /// A list of media URLs. The total media size must be less than 1 MB.
    /// 
    media-urls: option<list<string>>,
    /// Unique identifier for a messaging profile.
    /// 
    messaging-profile-id: option<string>,
    /// Subject of multimedia message
    subject: option<string>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: to-number,
    /// The protocol for sending the message, either SMS or MMS.
    type-op: option<create-message-request-type-op-enum>,
    /// If the profile this number is associated with has webhooks, use them for delivery notifications. If webhooks are also specified on the message itself, they will be attempted first, then those on the profile.
    use-profile-webhooks: option<bool>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }
  create-message: func(params: create-message-params) -> result<string, string>;

  /// Send a long code message
  record create-long-code-message-params {
    /// Automatically detect if an SMS message is unusually long and exceeds a recommended limit of message parts.
    auto-detect: option<bool>,
    /// Phone number, in +E.164 format, used to send the message.
    from-op: string,
    /// A list of media URLs. The total media size must be less than 1 MB.
    /// 
    media-urls: option<list<string>>,
    /// Subject of multimedia message
    subject: option<string>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: to-number,
    /// The protocol for sending the message, either SMS or MMS.
    type-op: option<create-message-request-type-op-enum>,
    /// If the profile this number is associated with has webhooks, use them for delivery notifications. If webhooks are also specified on the message itself, they will be attempted first, then those on the profile.
    use-profile-webhooks: option<bool>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }
  create-long-code-message: func(params: create-long-code-message-params) -> result<string, string>;

  /// Send a message using number pool
  record create-number-pool-message-params {
    /// Automatically detect if an SMS message is unusually long and exceeds a recommended limit of message parts.
    auto-detect: option<bool>,
    /// A list of media URLs. The total media size must be less than 1 MB.
    /// 
    media-urls: option<list<string>>,
    /// Unique identifier for a messaging profile.
    messaging-profile-id: string,
    /// Subject of multimedia message
    subject: option<string>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: to-number,
    /// The protocol for sending the message, either SMS or MMS.
    type-op: option<create-message-request-type-op-enum>,
    /// If the profile this number is associated with has webhooks, use them for delivery notifications. If webhooks are also specified on the message itself, they will be attempted first, then those on the profile.
    use-profile-webhooks: option<bool>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }
  create-number-pool-message: func(params: create-number-pool-message-params) -> result<string, string>;

  /// Send a short code message
  record create-short-code-message-params {
    /// Automatically detect if an SMS message is unusually long and exceeds a recommended limit of message parts.
    auto-detect: option<bool>,
    /// Phone number, in +E.164 format, used to send the message.
    from-op: string,
    /// A list of media URLs. The total media size must be less than 1 MB.
    /// 
    media-urls: option<list<string>>,
    /// Subject of multimedia message
    subject: option<string>,
    /// Message body (i.e., content) as a non-empty string.
    /// 
    text: option<string>,
    to: to-number,
    /// The protocol for sending the message, either SMS or MMS.
    type-op: option<create-message-request-type-op-enum>,
    /// If the profile this number is associated with has webhooks, use them for delivery notifications. If webhooks are also specified on the message itself, they will be attempted first, then those on the profile.
    use-profile-webhooks: option<bool>,
    /// The failover URL where webhooks related to this message will be sent if sending to the primary URL fails.
    webhook-failover-url: option<string>,
    /// The URL where webhooks related to this message will be sent.
    webhook-url: option<string>
  }
  create-short-code-message: func(params: create-short-code-message-params) -> result<string, string>;

  /// Retrieve a message
  record retrieve-message-params {
    /// The id of the message
    id: string
  }
  retrieve-message: func(params: retrieve-message-params) -> result<string, string>;

}

interface messaging-hosted-number {
  /// List messaging hosted number orders
  record list-messaging-hosted-number-order-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
