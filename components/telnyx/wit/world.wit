}

interface sim-card-group-actions {
  enum get-filter-status-enum {
    in-progress,
    completed,
    failed,
  }

  enum get-filter-type-enum {
    set-private-wireless-gateway,
    remove-private-wireless-gateway,
  }

  record get-response {
    data: option<list<sim-card-group-action>>,
    meta: option<pagination-meta>
  }

  /// This object represents a SIM card group action request. It allows tracking the current status of an operation that impacts the SIM card group and SIM card in it.
  record sim-card-group-action {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    record-type: option<string>,
    /// A JSON object representation of the action params.
    settings: option<sim-card-group-action-settings>,
    /// The SIM card group identification.
    sim-card-group-id: option<string>,
    status: option<get-filter-status-enum>,
    /// Represents the type of the operation requested.
    type-op: option<get-filter-type-enum>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  /// A JSON object representation of the action params.
  record sim-card-group-action-settings {
    /// The identification of the related Private Wireless Gateway resource.
    private-wireless-gateway-id: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record sim-card-group-action-get-response {
    data: option<sim-card-group-action>
  }

  /// List SIM card group actions
  record get-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// A valid SIM card group ID.
    filter-sim-card-group-id: option<string>,
    /// Filter by a specific status of the resource's lifecycle.
    filter-status: option<get-filter-status-enum>,
    /// Filter by action type.
    filter-type: option<get-filter-type-enum>
  }
  get: func(params: get-params) -> result<get-response, string>;

  /// Get SIM card group action details
  record sim-card-group-action-get-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-group-action-get: func(params: sim-card-group-action-get-params) -> result<sim-card-group-action-get-response, string>;

}

