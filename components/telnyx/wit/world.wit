    filter-date-created-at-gte: option<string>,
    /// ISO 8601 date for filtering rooms created before that date.
    filter-date-created-at-lte: option<string>,
    /// ISO 8601 date for filtering rooms updated on that date.
    filter-date-updated-at-eq: option<string>,
    /// ISO 8601 date for filtering rooms updated after that date.
    filter-date-updated-at-gte: option<string>,
    /// ISO 8601 date for filtering rooms updated before that date.
    filter-date-updated-at-lte: option<string>,
    /// Unique_name for filtering rooms.
    filter-unique-name: option<string>,
    /// To decide if room sessions should be included in the response.
    include-sessions: option<bool>,
    /// The size of the page.
    page-size: option<s32>,
    /// The page number to load.
    page-number: option<s32>
  }
  list-rooms: func(params: list-rooms-params) -> result<string, string>;

  /// Create a room.
  record create-room-params {
    /// The maximum amount of participants allowed in a room. If new participants try to join after that limit is reached, their request will be rejected.
    max-participants: option<s32>,
    /// The unique (within the Telnyx account scope) name of the room.
    unique-name: option<string>
  }
  create-room: func(params: create-room-params) -> result<string, string>;

  /// View a room.
  record view-room-params {
    /// The unique identifier of a room.
    room-id: string,
    /// To decide if room sessions should be included in the response.
    include-sessions: option<bool>
  }
  view-room: func(params: view-room-params) -> result<string, string>;

  /// Delete a room.
  record delete-room-params {
    /// The unique identifier of a room.
    room-id: string
  }
  delete-room: func(params: delete-room-params) -> result<string, string>;

  /// View a list of room sessions.
  record nested-list-room-sessions-params {
    /// The unique identifier of a room.
    room-id: string,
    /// ISO 8601 date for filtering room sessions created on that date.
    filter-date-created-at-eq: option<string>,
    /// ISO 8601 date for filtering room sessions created after that date.
    filter-date-created-at-gte: option<string>,
    /// ISO 8601 date for filtering room sessions created before that date.
    filter-date-created-at-lte: option<string>,
    /// ISO 8601 date for filtering room sessions updated on that date.
    filter-date-updated-at-eq: option<string>,
    /// ISO 8601 date for filtering room sessions updated after that date.
    filter-date-updated-at-gte: option<string>,
    /// ISO 8601 date for filtering room sessions updated before that date.
    filter-date-updated-at-lte: option<string>,
    /// ISO 8601 date for filtering room sessions ended on that date.
    filter-date-ended-at-eq: option<string>,
    /// ISO 8601 date for filtering room sessions ended after that date.
    filter-date-ended-at-gte: option<string>,
    /// ISO 8601 date for filtering room sessions ended before that date.
    filter-date-ended-at-lte: option<string>,
    /// Filter active or inactive room sessions.
    filter-active: option<bool>,
    /// To decide if room participants should be included in the response.
    include-participants: option<bool>,
    /// The size of the page.
    page-size: option<s32>,
    /// The page number to load.
    page-number: option<s32>
  }
  nested-list-room-sessions: func(params: nested-list-room-sessions-params) -> result<string, string>;

}

interface rooms-client-tokens {
  /// Create Client Token to join a room.
  record create-room-client-token-params {
    /// The unique identifier of a room.
    room-id: string,
    /// The time to live in seconds of the Refresh Token, after that time the Refresh Token is invalid and can't be used to refresh Client Token.
    refresh-token-ttl-secs: option<s32>,
    /// The time to live in seconds of the Client Token, after that time the Client Token is invalid and can't be used to join a Room.
    token-ttl-secs: option<s32>
  }
  create-room-client-token: func(params: create-room-client-token-params) -> result<string, string>;

  /// Refresh Client Token to join a room.
  record refresh-room-client-token-params {
    /// The unique identifier of a room.
    room-id: string,
    refresh-token: string,
    /// The time to live in seconds of the Client Token, after that time the Client Token is invalid and can't be used to join a Room.
    token-ttl-secs: option<s32>
  }
  refresh-room-client-token: func(params: refresh-room-client-token-params) -> result<string, string>;

}

interface short-codes {
