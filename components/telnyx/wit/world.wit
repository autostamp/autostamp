/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `BearerAuth` | `Authorization: Bearer <secret>` |
/// | `bearerAuth` | `Authorization: Bearer <secret>` |
package autostamp:telnyx@0.3.0;

interface bulk-credentials {
  /// Creates several credentials
  record create-bulk-telephony-credential-params {
    /// Amount of credentials to be created. A single tag can hold at maximum 1000 credentials
    amount: option<s32>,
    /// Identifies the connection this credential is associated with.
    connection-id: string,
    /// A default name for all credentials.
    name: option<string>,
    /// Tags a credential for bulk operations. A single tag can hold at maximum 1000 credentials.
    tag: string
  }
  create-bulk-telephony-credential: func(params: create-bulk-telephony-credential-params) -> result<string, string>;

  /// Update several credentials
  record update-bulk-telephony-credential-params {
    /// Filter by tag, required by bulk operations.
    filter-tag: string,
    /// Amount of credentials to be created. A single tag can hold at maximum 1000 credentials
    amount: option<s32>,
    /// Identifies the connection this credential is associated with.
    connection-id: string,
    /// A default name for all credentials.
    name: option<string>,
    /// Tags a credential for bulk operations. A single tag can hold at maximum 1000 credentials.
    tag: string
  }
  update-bulk-telephony-credential: func(params: update-bulk-telephony-credential-params) -> result<string, string>;

  /// Delete several credentials
  record delete-bulk-telephony-credential-params {
    /// Filter by tag, required by bulk operations.
    filter-tag: string
  }
  delete-bulk-telephony-credential: func(params: delete-bulk-telephony-credential-params) -> result<string, string>;

  /// Perform activate or deactivate action on all credentials filtered by the provided tag.
  record bulk-credential-action-params {
    /// Identifies the action to be taken. Activate will change the status to active. Deactivate will change the status to inactive.
    action: string,
    /// Filter by tag, required by bulk operations.
    filter-tag: string
  }
  bulk-credential-action: func(params: bulk-credential-action-params) -> result<string, string>;

}


interface sim-cards {
  enum sim-card-registration-status-enum {
    enabled,
    disabled,
    standby,
  }

  enum sim-card-status-enum {
    registering,
    enabling,
    enabled,
    disabling,
    disabled,
    data-limit-exceeded,
  }

  /// A list of mobile operator networks and the priority that should be applied when the SIM is connecting to the network.
  record mobile-operator-networks-preferences-request {
    /// opaque schema; raw JSON
    value: string
  }

  record mobile-operator-network-preferences-request {
    /// The mobile operator network resource identification UUID.
    mobile-operator-network-id: option<string>,
    /// It determines what is the priority of a specific operator network that should be assumed by a SIM card when connecting to a network. The highest priority is 0, the second highest is 1 and so on.
    priority: option<s32>
  }

  /// Bulk Network Preferences for SIM cards
  record bulk-sim-card-network-preferences-params {
    mobile-operator-networks-preferences: option<mobile-operator-networks-preferences-request>,
    sim-card-ids: option<list<string>>
  }
  bulk-sim-card-network-preferences: func(params: bulk-sim-card-network-preferences-params) -> result<string, string>;

  /// Register SIM cards
  record sim-card-register-params {
    registration-codes: list<string>,
    /// The group SIMCardGroup identification. This attribute can be <code>null</code> when it's present in an associated resource.
    sim-card-group-id: option<string>,
    /// Status on which the SIM card will be set after being successful registered.
    status: option<sim-card-registration-status-enum>,
    /// Searchable tags associated with the SIM card
    tags: option<list<string>>
  }
  sim-card-register: func(params: sim-card-register-params) -> result<string, string>;

  /// Get all SIM cards
  record get-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// It includes the associated SIM card group object in the response when present.
    include-sim-card-group: option<bool>,
    /// A valid SIM card group ID.
    filter-sim-card-group-id: option<string>,
    /// A list of SIM card tags to filter on.<br/><br/>
    /// If the SIM card contains <b><i>all</i></b> of the given <code>tags</code> they will be found.<br/><br/>
    filter-tags: option<list<string>>,
    /// A search string to partially match for the SIM card's ICCID.
    filter-iccid: option<string>
  }
  get: func(params: get-params) -> result<string, string>;

  /// Validate SIM cards registration codes
  record post-validate-registration-codes-params {
    registration-codes: option<list<string>>
  }
  post-validate-registration-codes: func(params: post-validate-registration-codes-params) -> result<string, string>;

  /// Get SIM card
  record sim-card-get-params {
    /// Identifies the resource.
    id: string,
    /// It includes the associated SIM card group object in the response when present.
    include-sim-card-group: option<bool>
  }
  sim-card-get: func(params: sim-card-get-params) -> result<string, string>;

  /// Update a SIM card
  record sim-card-update-params {
    /// Identifies the resource.
    id: string,
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// The ICCID is the identifier of the specific SIM card/chip. Each SIM is internationally identified by its integrated circuit card identifier (ICCID). ICCIDs are stored in the SIM card's memory and are also engraved or printed on the SIM card body during a process called personalization.
    iccid: option<string>,
    /// SIM cards are identified on their individual operator networks by a unique International Mobile Subscriber Identity (IMSI). <br/>
    /// Mobile network operators connect mobile phone calls and communicate with their market SIM cards using their IMSIs. The IMSI is stored in the Subscriber  Identity Module (SIM) inside the device and is sent by the device to the appropriate network. It is used to acquire the details of the device in the Home  Location Register (HLR) or the Visitor Location Register (VLR).
    imsi: option<string>,
    /// The SIM's address in the currently connected network. This IPv4 address is usually obtained dynamically, so it may vary according to the location or new connections.
    ipv4: option<string>,
    /// The SIM's address in the currently connected network. This IPv6 address is usually obtained dynamically, so it may vary according to the location or new connections.
    ipv6: option<string>,
    /// Mobile Station International Subscriber Directory Number (MSISDN) is a number used to identify a mobile phone number internationally. <br/>
    /// MSISDN is defined by the E.164 numbering plan. It includes a country code and a National Destination Code which identifies the subscriber's operator.
    msisdn: option<string>,
    record-type: option<string>,
    /// The group SIMCardGroup identification. This attribute can be <code>null</code> when it's present in an associated resource.
    sim-card-group-id: option<string>,
    /// The current status of the SIM card. It will be one of the following: <br/>
    /// <ul>
    status: option<sim-card-status-enum>,
    /// Searchable tags associated with the SIM card
    tags: option<list<string>>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }
  sim-card-update: func(params: sim-card-update-params) -> result<string, string>;

  /// Deletes a SIM card
  record sim-card-delete-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-delete: func(params: sim-card-delete-params) -> result<string, string>;

  /// Request a SIM card disable
  record sim-card-disable-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-disable: func(params: sim-card-disable-params) -> result<string, string>;

  /// Request a SIM card enable
  record sim-card-enable-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-enable: func(params: sim-card-enable-params) -> result<string, string>;

  /// Request setting a SIM card to standby
  record sim-card-set-standby-params {
    /// Identifies the resource.
    id: string
  }
  sim-card-set-standby: func(params: sim-card-set-standby-params) -> result<string, string>;

  /// Get network preferences
  record sim-card-network-preferences-get-params {
    /// Identifies a SIM card.
    sim-card-id: string,
    /// It includes the associated OTA update objects in the response when present.
    include-ota-updates: option<bool>
  }
  sim-card-network-preferences-get: func(params: sim-card-network-preferences-get-params) -> result<string, string>;

  /// Set network preferences
  record sim-card-network-preferences-put-params {
    /// Identifies a SIM card.
    sim-card-id: string,
    /// A list of mobile operator networks and the priority that should be applied when the SIM is connecting to the network.
    mobile-operator-networks-preferences: option<list<mobile-operator-network-preferences-request>>
  }
  sim-card-network-preferences-put: func(params: sim-card-network-preferences-put-params) -> result<string, string>;

  /// DELETE network preferences
  record sim-card-network-preferences-delete-params {
    /// Identifies a SIM card.
    sim-card-id: string
  }
  sim-card-network-preferences-delete: func(params: sim-card-network-preferences-delete-params) -> result<string, string>;

  /// Get SIM card public IP definition
  record sim-card-public-ip-get-params {
    /// Identifies a SIM card.
    sim-card-id: string
  }
  sim-card-public-ip-get: func(params: sim-card-public-ip-get-params) -> result<string, string>;

  /// Set SIM card public IP
  record sim-card-public-ip-post-params {
    /// Identifies a SIM card.
    sim-card-id: string
  }
  sim-card-public-ip-post: func(params: sim-card-public-ip-post-params) -> result<string, string>;

  /// Delete SIM card public IP
  record sim-card-public-ip-delete-params {
    /// Identifies a SIM card.
    sim-card-id: string
  }
  sim-card-public-ip-delete: func(params: sim-card-public-ip-delete-params) -> result<string, string>;

  /// List wireless connectivity logs
  record wireless-connectivity-logs-get-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Identifies a SIM card.
    sim-card-id: string
  }
  wireless-connectivity-logs-get: func(params: wireless-connectivity-logs-get-params) -> result<string, string>;

}

interface addresses {
  enum find-addresss-sort-enum {
    created-at,
    first-name,
    last-name,
    business-name,
    street-address,
  }

  /// Indicates whether or not the address should be considered part of your list of addresses that appear for regular use.
  record address-book {
    /// opaque schema; raw JSON
    value: string
  }

  /// The locality of the address. For US addresses, this corresponds to the state of the address.
  record administrative-area {
    /// opaque schema; raw JSON
    value: string
  }

  /// The borough of the address. This field is not used for addresses in the US but is used for some international addresses.
  record borough {
    /// opaque schema; raw JSON
    value: string
  }

  /// The business name associated with the address. An address must have either a first last name or a business name.
  record business-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The two-character (ISO 3166-1 alpha-2) country code of the address.
  record country-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// A customer reference string for customer look ups.
  record customer-reference {
    /// opaque schema; raw JSON
    value: string
  }

  /// Additional street address information about the address such as, but not limited to, unit number or apartment number.
  record extended-address {
    /// opaque schema; raw JSON
    value: string
  }

  /// The first name associated with the address. An address must have either a first last name or a business name.
  record first-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The last name associated with the address. An address must have either a first last name or a business name.
  record last-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The locality of the address. For US addresses, this corresponds to the city of the address.
  record locality {
    /// opaque schema; raw JSON
    value: string
  }

  /// The neighborhood of the address. This field is not used for addresses in the US but is used for some international addresses.
  record neighborhood {
    /// opaque schema; raw JSON
    value: string
  }

  /// The phone number associated with the address.
  record phone-number {
    /// opaque schema; raw JSON
    value: string
  }

  /// The postal code of the address.
  record postal-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// The primary street address information about the address.
  record street-address {
    /// opaque schema; raw JSON
    value: string
  }

  /// Indicates whether or not the address should be validated for emergency use upon creation or not. This should be left with the default value of `true` unless you have used the `/addresses/actions/validate` endpoint to validate the address separately prior to creation. If an address is not validated for emergency use upon creation and it is not valid, it will not be able to be used for emergency services.
  record validate-address {
    /// opaque schema; raw JSON
    value: string
  }

  /// List all addresses
  record find-addresss-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter addresses via the customer reference set. Matching is not case-sensitive.
    filter-customer-reference-eq: option<string>,
    /// If present, addresses with <code>customer_reference</code> containing the given value will be returned. Matching is not case-sensitive.
    filter-customer-reference-contains: option<string>,
    /// If set as 'true', only addresses used as the emergency address for at least one active phone-number will be returned. When set to 'false', the opposite happens: only addresses not used as the emergency address from phone-numbers will be returned.
    filter-used-as-emergency: option<string>,
    /// If present, addresses with <code>street_address</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-street-address-contains: option<string>,
    /// If present, only returns results with the <code>address_book</code> flag set to the given value.
    filter-address-book-eq: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<find-addresss-sort-enum>
  }
  find-addresss: func(params: find-addresss-params) -> result<string, string>;

  /// Creates an address
  record create-address-params {
    address-book: option<address-book>,
    administrative-area: option<administrative-area>,
    borough: option<borough>,
    business-name: business-name,
    country-code: country-code,
    customer-reference: option<customer-reference>,
    extended-address: option<extended-address>,
    first-name: first-name,
    last-name: last-name,
    locality: locality,
    neighborhood: option<neighborhood>,
    phone-number: option<phone-number>,
    postal-code: option<postal-code>,
    street-address: street-address,
    validate-address: option<validate-address>
  }
  create-address: func(params: create-address-params) -> result<string, string>;

  /// Validate an address
  record validate-address-v2-params {
    administrative-area: option<administrative-area>,
    country-code: country-code,
    extended-address: option<extended-address>,
    locality: option<locality>,
    postal-code: postal-code,
    street-address: street-address
  }
  validate-address-v2: func(params: validate-address-v2-params) -> result<string, string>;

  /// Retrieve an address
  record get-address-params {
    /// address ID
    id: string
  }
  get-address: func(params: get-address-params) -> result<string, string>;

  /// Deletes an address
  record delete-address-params {
    /// address ID
    id: string
  }
  delete-address: func(params: delete-address-params) -> result<string, string>;

}

interface authentication-providers {
  enum find-authentication-providers-sort-enum {
    name,
    name-v2,
    short-name,
    short-name-v2,
    active,
    active-v2,
    created-at,
    created-at-v2,
    updated-at,
    updated-at-v2,
  }

  enum settings-idp-cert-fingerprint-algorithm-enum {
    sha1,
    sha256,
    sha384,
    sha512,
  }

  /// The active status of the authentication provider
  record active {
    /// opaque schema; raw JSON
    value: string
  }

  /// The name associated with the authentication provider.
  record name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The settings associated with the authentication provider.
  record settings {
    /// The certificate fingerprint for the identity provider (IdP)
    idp-cert-fingerprint: string,
    /// The algorithm used to generate the identity provider's (IdP) certificate fingerprint
    idp-cert-fingerprint-algorithm: option<settings-idp-cert-fingerprint-algorithm-enum>,
    /// The Entity ID for the identity provider (IdP).
    idp-entity-id: string,
    /// The SSO target url for the identity provider (IdP).
    idp-sso-target-url: string
  }

  /// The URL for the identity provider metadata file to populate the settings automatically. If the settings attribute is provided, that will be used instead.
  record settings-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// The short name associated with the authentication provider. This must be unique and URL-friendly, as it's going to be part of the login URL.
  record short-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// List all SSO authentication providers
  record find-authentication-providers-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<find-authentication-providers-sort-enum>
  }
  find-authentication-providers: func(params: find-authentication-providers-params) -> result<string, string>;

  /// Creates an authentication provider
  record create-authentication-provider-params {
    active: option<active>,
    name: name,
    settings: settings,
    settings-url: option<settings-url>,
    short-name: short-name
  }
  create-authentication-provider: func(params: create-authentication-provider-params) -> result<string, string>;

  /// Retrieve an authentication provider
  record get-authentication-provider-params {
    /// authentication provider ID
    id: string
  }
  get-authentication-provider: func(params: get-authentication-provider-params) -> result<string, string>;

  /// Update a authentication provider
  record update-authentication-provider-params {
    /// Identifies the resource.
    id: string,
    active: option<active>,
    name: option<name>,
    settings: option<settings>,
    settings-url: option<settings-url>,
    short-name: option<short-name>
  }
  update-authentication-provider: func(params: update-authentication-provider-params) -> result<string, string>;

  /// Deletes an authentication provider
  record delete-authentication-provider-params {
    /// authentication provider ID
    id: string
  }
  delete-authentication-provider: func(params: delete-authentication-provider-params) -> result<string, string>;

}

interface number-search {
  enum list-available-phone-number-blocks-filter-number-type-enum {
    toll-free,
  }

  enum list-available-phone-number-blocks-filter-features-item-enum {
    sms,
    mms,
    voice,
    fax,
    emergency,
  }

  enum list-available-phone-numbers-filter-number-type-enum {
    toll-free,
    national,
    mobile,
    local,
  }

  /// List available phone number blocks
  record list-available-phone-number-blocks-params {
    /// Filter number blocks that start with a pattern (meant to be used after `national_destination_code` filter has been set).
    filter-phone-number-starts-with: option<string>,
    /// Filter numbers ending with a pattern.
    filter-phone-number-ends-with: option<string>,
    /// Filter numbers containing a pattern.
    filter-phone-number-contains: option<string>,
    /// Filter phone numbers by city.
    filter-locality: option<string>,
    /// Filter phone numbers by US state/CA province.
    filter-administrative-area: option<string>,
    /// Filter phone numbers by ISO alpha-2 country code.
    filter-country-code: option<string>,
    /// Filter by the national destination code of the number. This filter is only applicable to North American numbers.
    filter-national-destination-code: option<string>,
    /// Filter phone numbers by NANP rate center. This filter is only applicable to North American numbers.
    filter-rate-center: option<string>,
    /// Filter phone numbers by number type.
    filter-number-type: option<list-available-phone-number-blocks-filter-number-type-enum>,
    /// Filter if the phone number should be used for voice, fax, mms, sms, emergency.
    filter-features: option<list<list-available-phone-number-blocks-filter-features-item-enum>>,
    /// Filter number blocks by minimum blocks size
    filter-minimum-block-size: option<s32>,
    /// Limits the number of results.
    filter-limit: option<s32>
  }
  list-available-phone-number-blocks: func(params: list-available-phone-number-blocks-params) -> result<string, string>;

  /// List available phone numbers
  record list-available-phone-numbers-params {
    /// Filter numbers starting with a pattern (meant to be used after `national_destination_code` filter has been set).
    filter-phone-number-starts-with: option<string>,
    /// Filter numbers ending with a pattern.
    filter-phone-number-ends-with: option<string>,
    /// Filter numbers containing a pattern.
    filter-phone-number-contains: option<string>,
    /// Filter phone numbers by city.
    filter-locality: option<string>,
    /// Filter phone numbers by US state/CA province.
    filter-administrative-area: option<string>,
    /// Filter phone numbers by ISO alpha-2 country code.
    filter-country-code: option<string>,
    /// Filter by the national destination code of the number. This filter is only applicable to North American numbers.
    filter-national-destination-code: option<string>,
    /// Filter phone numbers by NANP rate center. This filter is only applicable to North American numbers.
    filter-rate-center: option<string>,
    /// Filter phone numbers by number type.
    filter-number-type: option<list-available-phone-numbers-filter-number-type-enum>,
    /// Filter if the phone number should be used for voice, fax, mms, sms, emergency.
    filter-features: option<list<list-available-phone-number-blocks-filter-features-item-enum>>,
    /// Limits the number of results.
    filter-limit: option<s32>,
    /// Filter to determine if best effort results should be included.
    filter-best-effort: option<bool>,
    /// Filter to exclude phone numbers that need additional time after to purchase to receive phone calls.
    filter-quickship: option<bool>,
    /// Filter to exclude phone numbers that cannot be reserved before purchase.
    filter-reservable: option<bool>,
    /// Filter to exclude phone numbers that are currently on hold for your account.
    filter-exclude-held-numbers: option<bool>
  }
  list-available-phone-numbers: func(params: list-available-phone-numbers-params) -> result<string, string>;

}

interface billing {
  /// Retrieve user balance details
  get-user-balance: func() -> result<string, string>;

}

interface billing-groups {
  /// List all billing groups
  record list-billing-groups-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-billing-groups: func(params: list-billing-groups-params) -> result<string, string>;

  /// Create a billing group
  record create-billing-group-params {
    /// A name for the billing group
    name: option<string>
  }
  create-billing-group: func(params: create-billing-group-params) -> result<string, string>;

  /// Retrieve a billing group
  record retrieve-billing-group-params {
    /// The id of the billing group
    id: string
  }
  retrieve-billing-group: func(params: retrieve-billing-group-params) -> result<string, string>;

  /// Update a billing group
  record update-billing-group-v2-params {
    /// The id of the billing group
    id: string,
    /// A name for the billing group
    name: option<string>
  }
  update-billing-group-v2: func(params: update-billing-group-v2-params) -> result<string, string>;

  /// Delete a billing group
  record delete-billing-group-params {
    /// The id of the billing group
    id: string
  }
  delete-billing-group: func(params: delete-billing-group-params) -> result<string, string>;

}

interface call-control-applications {
  enum list-call-control-applications-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum create-call-control-application-request-anchorsite-override-enum {
    latency,
    chicago-il,
    ashburn-va,
    san-jose-ca,
  }

  enum create-call-control-application-request-dtmf-type-enum {
    rfc-v2833,
    inband,
    sip-info,
  }

  enum call-control-application-inbound-sip-subdomain-receive-settings-enum {
    only-my-connections,
    from-anyone,
  }

  enum create-call-control-application-request-webhook-api-version-enum {
    v1,
    v2,
  }

  record call-control-application-inbound {
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<call-control-application-inbound-sip-subdomain-receive-settings-enum>
  }

  record call-control-application-outbound {
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Identifies the associated outbound voice profile.
    outbound-voice-profile-id: option<string>
  }

  /// List call control applications
  record list-call-control-applications-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, applications with <code>application_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-application-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-call-control-applications-sort-enum>
  }
  list-call-control-applications: func(params: list-call-control-applications-params) -> result<string, string>;

  /// Create a call control application
  record create-call-control-application-params {
    /// Specifies whether the connection can be used.
    active: option<bool>,
    /// <code>Latency</code> directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
    anchorsite-override: option<create-call-control-application-request-anchorsite-override-enum>,
    /// A user-assigned name to help manage the application.
    application-name: string,
    /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
    dtmf-type: option<create-call-control-application-request-dtmf-type-enum>,
    /// Specifies whether calls to phone numbers associated with this connection should hangup after timing out.
    first-command-timeout: option<bool>,
    /// Specifies how many seconds to wait before timing out a dial command.
    first-command-timeout-secs: option<s32>,
    inbound: option<call-control-application-inbound>,
    outbound: option<call-control-application-outbound>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<create-call-control-application-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: string,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  create-call-control-application: func(params: create-call-control-application-params) -> result<string, string>;

  /// Retrieve a call control application
  record retrieve-call-control-application-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-call-control-application: func(params: retrieve-call-control-application-params) -> result<string, string>;

  /// Update a call control application
  record update-call-control-application-params {
    /// Identifies the resource.
    id: string,
    /// Specifies whether the connection can be used.
    active: option<bool>,
    /// <code>Latency</code> directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
    anchorsite-override: option<create-call-control-application-request-anchorsite-override-enum>,
    /// A user-assigned name to help manage the application.
    application-name: string,
    /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
    dtmf-type: option<create-call-control-application-request-dtmf-type-enum>,
    /// Specifies whether calls to phone numbers associated with this connection should hangup after timing out.
    first-command-timeout: option<bool>,
    /// Specifies how many seconds to wait before timing out a dial command.
    first-command-timeout-secs: option<s32>,
    inbound: option<call-control-application-inbound>,
    outbound: option<call-control-application-outbound>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<create-call-control-application-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: string,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  update-call-control-application: func(params: update-call-control-application-params) -> result<string, string>;

  /// Delete a call control application
  record delete-call-control-application-params {
    /// Identifies the resource.
    id: string
  }
  delete-call-control-application: func(params: delete-call-control-application-params) -> result<string, string>;

}

interface debugging {
  enum list-call-events-filter-status-enum {
    delivered,
    failed,
  }

  enum list-call-events-filter-type-enum {
    command,
    webhook,
  }

  /// List call events
  record list-call-events-params {
    /// The unique identifier of an individual call leg.
    filter-call-leg-id: option<string>,
    /// The unique identifier of the call control session. A session may include multiple call leg events.
    filter-call-session-id: option<string>,
    /// Event status
    filter-status: option<list-call-events-filter-status-enum>,
    /// Event type
    filter-type: option<list-call-events-filter-type-enum>,
    /// Event timestamp: greater than
    filter-event-timestamp-gt: option<string>,
    /// Event timestamp: greater than or equal
    filter-event-timestamp-gte: option<string>,
    /// Event timestamp: lower than
    filter-event-timestamp-lt: option<string>,
    /// Event timestamp: lower than or equal
    filter-event-timestamp-lte: option<string>,
    /// Event timestamp: equal
    filter-event-timestamp-eq: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-call-events: func(params: list-call-events-params) -> result<string, string>;

}

interface call-commands {
  enum call-request-answering-machine-detection-enum {
    detect,
    detect-beep,
    detect-words,
    greeting-end,
    disabled,
  }

  enum call-request-webhook-url-method-enum {
    post,
    get,
  }

  enum start-forking-request-stream-type-enum {
    raw,
    decrypted,
  }

  enum gather-using-speak-request-language-enum {
    arb,
    cmn-cn,
    cy-gb,
    da-dk,
    de-de,
    en-au,
    en-gb,
    en-gb-wls,
    en-in,
    en-us,
    es-es,
    es-mx,
    es-us,
    fr-ca,
    fr-fr,
    hi-in,
    is-is,
    it-it,
    ja-jp,
    ko-kr,
    nb-no,
    nl-nl,
    pl-pl,
    pt-br,
    pt-pt,
    ro-ro,
    ru-ru,
    sv-se,
    tr-tr,
  }

  enum gather-using-speak-request-payload-type-enum {
    text,
    ssml,
  }

  enum gather-using-speak-request-service-level-enum {
    basic,
    premium,
  }

  enum gather-using-speak-request-voice-enum {
    male,
    female,
  }

  enum start-recording-request-channels-enum {
    single,
    dual,
  }

  enum start-recording-request-format-enum {
    wav,
    mp3,
  }

  enum reject-request-cause-enum {
    call-rejected,
    user-busy,
  }

  enum transcription-start-request-language-enum {
    de,
    en,
    es,
    fr,
    it,
    pl,
  }

  /// Optional configuration parameters to modify 'answering_machine_detection' performance.
  record call-request-answering-machine-detection-config {
    /// Silence duration threshold after a greeting message or voice for it be considered human.
    after-greeting-silence-millis: option<s32>,
    /// Maximum threshold for silence between words.
    between-words-silence-millis: option<s32>,
    /// Maximum threshold of a human greeting. If greeting longer than this value, considered machine.
    greeting-duration-millis: option<s32>,
    /// If machine already detected, maximum threshold for silence between words. If exceeded, the greeting is considered ended.
    greeting-silence-duration-millis: option<s32>,
    /// If machine already detected, maximum timeout threshold to determine the end of the machine greeting.
    greeting-total-analysis-time-millis: option<s32>,
    /// If initial silence duration is greater than this value, consider it a machine.
    initial-silence-millis: option<s32>,
    /// If number of detected words is greater than this value, consder it a machine.
    maximum-number-of-words: option<s32>,
    /// If a single word lasts longer than this threshold, consider it a machine.
    maximum-word-length-millis: option<s32>,
    /// Minimum noise threshold for any analysis.
    silence-threshold: option<s32>,
    /// Maximum timeout threshold for overall detection.
    total-analysis-time-millis: option<s32>
  }

  record custom-sip-header {
    /// The name of the header to add.
    name: string,
    /// The value of the header.
    value: string
  }

  record loopcount {
    /// opaque schema; raw JSON
    value: string
  }

  /// Optional configuration parameters to modify 'answering_machine_detection' performance.
  record transfer-call-request-answering-machine-detection-config {
    /// Silence duration threshold after a greeting message or voice for it be considered human.
    after-greeting-silence-millis: option<s32>,
    /// Maximum threshold for silence between words.
    between-words-silence-millis: option<s32>,
    /// Maximum threshold of a human greeting. If greeting longer than this value, considered machine.
    greeting-duration-millis: option<s32>,
    /// If machine already detected, maximum threshold for silence between words. If exceeded, the greeting is considered ended.
    greeting-silence-duration-millis: option<s32>,
    /// If machine already detected, maximum timeout threshold to determine the end of the machine greeting.
    greeting-total-analysis-time-millis: option<s32>,
    /// If initial silence duration is greater than this value, consider it a machine.
    initial-silence-millis: option<s32>,
    /// If number of detected words is greater than this value, consder it a machine.
    maximum-number-of-words: option<s32>,
    /// If a single word lasts longer than this threshold, consider it a machine.
    maximum-word-length-millis: option<s32>,
    /// Minimum noise threshold for any analysis.
    silence-threshold: option<s32>,
    /// Maximum timeout threshold for overall detection.
    total-analysis-time-millis: option<s32>
  }

  /// Dial
  record call-dial-params {
    /// Enables Answering Machine Detection. When a call is answered, Telnyx runs real-time detection to determine if it was picked up by a human or a machine and sends an `call.machine.detection.ended` webhook with the analysis result. If 'greeting_end' or 'detect_words' is used and a 'machine' is detected, you will receive another 'call.machine.greeting.ended' webhook when the answering machine greeting ends with a beep or silence. If `detect_beep` is used, you will only receive 'call.machine.greeting.ended' if a beep is detected.
    answering-machine-detection: option<call-request-answering-machine-detection-enum>,
    /// Optional configuration parameters to modify 'answering_machine_detection' performance.
    answering-machine-detection-config: option<call-request-answering-machine-detection-config>,
    /// The URL of a file to be played back to the callee when the call is answered. The URL can point to either a WAV or MP3 file. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// Use this field to set the Billing Group ID for the call. Must be a valid and existing Billing Group ID.
    billing-group-id: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The ID of the Call Control App (formerly ID of the connection) to be used when dialing the destination.
    connection-id: string,
    /// Custom headers to be added to the SIP INVITE.
    custom-headers: option<list<custom-sip-header>>,
    /// The `from` number to be used as the caller id presented to the destination (`to` number). The number should be in +E164 format. This attribute will default to the `from` number of the original call if omitted.
    from-op: string,
    /// The `from_display_name` string to be used as the caller id name (SIP From Display Name) presented to the destination (`to` number). The string should have a maximum of 128 characters, containing only letters, numbers, spaces, and -_~!.+ special characters. If ommited, the display name will be the same as the number in the `from` field.
    from-display-name: option<string>,
    /// Use another call's control id for sharing the same call session id
    link-to: option<string>,
    /// The media_name of a file to be played back to the callee when the call is answered. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>,
    /// SIP Authentication password used for SIP challenges.
    sip-auth-password: option<string>,
    /// SIP Authentication username used for SIP challenges.
    sip-auth-username: option<string>,
    /// Sets the maximum duration of a Call Control Leg in seconds. If the time limit is reached, the call will hangup and a `call.hangup` webhook with a `hangup_cause` of `time_limit` will be sent. For example, by setting a time limit of 120 seconds, a Call Leg will be automatically terminated two minutes after being answered. The default time limit is 14400 seconds or 4 hours and this is also the maximum allowed call length.
    time-limit-secs: option<s32>,
    /// The number of seconds that Telnyx will wait for the call to be answered by the destination to which it is being called. If the timeout is reached before an answer is received, the call will hangup and a `call.hangup` webhook with a `hangup_cause` of `timeout` will be sent. Minimum value is 5 seconds. Maximum value is 120 seconds.
    timeout-secs: option<s32>,
    /// The DID or SIP URI to dial out to.
    to: string,
    /// Use this field to override the URL for which Telnyx will send subsequent webhooks to for this call.
    webhook-url: option<string>,
    /// HTTP request type used for `webhook_url`.
    webhook-url-method: option<call-request-webhook-url-method-enum>
  }
  call-dial: func(params: call-dial-params) -> result<string, string>;

  /// Answer call
  record call-answer-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to set the Billing Group ID for the call. Must be a valid and existing Billing Group ID.
    billing-group-id: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Use this field to override the URL for which Telnyx will send subsequent webhooks to for this call.
    webhook-url: option<string>,
    /// HTTP request type used for `webhook_url`.
    webhook-url-method: option<call-request-webhook-url-method-enum>
  }
  call-answer: func(params: call-answer-params) -> result<string, string>;

  /// Bridge calls
  record call-bridge-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Specifies behavior after the bridge ends (i.e. the opposite leg either hangs up or is transferred). If supplied with the value `self`, the current leg will be parked after unbridge. If not set, the default behavior is to hang up the leg.
    park-after-unbridge: option<string>,
    /// The name of the queue you want to bridge with, can't be used together with call_control_id parameter. Bridging with a queue means bridging with the first call in the queue. The call will always be removed from the queue regardless of whether bridging succeeds. Returns an error when the queue is empty.
    queue: option<string>
  }
  call-bridge: func(params: call-bridge-params) -> result<string, string>;

  /// Enqueue call
  record call-enqueue-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The maximum number of calls allowed in the queue at a given time. Can't be modified for an existing queue.
    max-size: option<s32>,
    /// The number of seconds after which the call will be removed from the queue.
    max-wait-time-secs: option<s32>,
    /// The name of the queue the call should be put in. If a queue with a given name doesn't exist yet it will be created.
    queue-name: option<string>
  }
  call-enqueue: func(params: call-enqueue-params) -> result<string, string>;

  /// Forking start
  record call-fork-start-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The network target, <udp:ip_address:port>, where the call's incoming RTP media packets should be forwarded.
    rx: option<string>,
    /// Optionally specify a media type to stream. If `decrpyted` selected, Telnyx will decrypt incoming SIP media before forking to the target. `rx` and `tx` are required fields if `decrypted` selected.
    stream-type: option<start-forking-request-stream-type-enum>,
    /// The network target, <udp:ip_address:port>, where the call's RTP media packets should be forwarded. Both incoming and outgoing media packets will be delivered to the specified target, and information about the stream will be included in the encapsulation protocol header, including the direction (0 = inbound; 1 = outbound), leg (0 = A-leg; 1 = B-leg), and call_leg_id.
    target: option<string>,
    /// The network target, <udp:ip_address:port>, where the call's outgoing RTP media packets should be forwarded.
    tx: option<string>
  }
  call-fork-start: func(params: call-fork-start-params) -> result<string, string>;

  /// Forking stop
  record call-fork-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-fork-stop: func(params: call-fork-stop-params) -> result<string, string>;

  /// Gather stop
  record call-gather-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-gather-stop: func(params: call-gather-stop-params) -> result<string, string>;

  /// Gather using audio
  record call-gather-using-audio-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// The URL of a file to be played back at the beginning of each prompt. The URL can point to either a WAV or MP3 file. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The number of milliseconds to wait for input between digits.
    inter-digit-timeout-millis: option<s32>,
    /// The URL of a file to play when digits don't match the `valid_digits` parameter or the number of digits is not between `min` and `max`. The URL can point to either a WAV or MP3 file. invalid_media_name and invalid_audio_url cannot be used together in one request.
    invalid-audio-url: option<string>,
    /// The media_name of a file to be played back when digits don't match the `valid_digits` parameter or the number of digits is not between `min` and `max`. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    invalid-media-name: option<string>,
    /// The maximum number of digits to fetch. This parameter has a maximum value of 128.
    maximum-digits: option<s32>,
    /// The maximum number of times the file should be played if there is no input from the user on the call.
    maximum-tries: option<s32>,
    /// The media_name of a file to be played back at the beginning of each prompt. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>,
    /// The minimum number of digits to fetch. This parameter has a minimum value of 1.
    minimum-digits: option<s32>,
    /// The digit used to terminate input if fewer than `maximum_digits` digits have been gathered.
    terminating-digit: option<string>,
    /// The number of milliseconds to wait for a DTMF response after file playback ends before a replaying the sound file.
    timeout-millis: option<s32>,
    /// A list of all digits accepted as valid.
    valid-digits: option<string>
  }
  call-gather-using-audio: func(params: call-gather-using-audio-params) -> result<string, string>;

  /// Gather using speak
  record call-gather-using-speak-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The number of milliseconds to wait for input between digits.
    inter-digit-timeout-millis: option<s32>,
    /// The text or SSML to be converted into speech when digits don't match the `valid_digits` parameter or the number of digits is not between `min` and `max`. There is a 5,000 character limit.
    invalid-payload: option<string>,
    /// The language you want spoken.
    language: gather-using-speak-request-language-enum,
    /// The maximum number of digits to fetch. This parameter has a maximum value of 128.
    maximum-digits: option<s32>,
    /// The maximum number of times that a file should be played back if there is no input from the user on the call.
    maximum-tries: option<s32>,
    /// The minimum number of digits to fetch. This parameter has a minimum value of 1.
    minimum-digits: option<s32>,
    /// The text or SSML to be converted into speech. There is a 5,000 character limit.
    payload: string,
    /// The type of the provided payload. The payload can either be plain text, or Speech Synthesis Markup Language (SSML).
    payload-type: option<gather-using-speak-request-payload-type-enum>,
    /// This parameter impacts speech quality, language options and payload types. When using `basic`, only the `en-US` language and payload type `text` are allowed.
    service-level: option<gather-using-speak-request-service-level-enum>,
    /// The digit used to terminate input if fewer than `maximum_digits` digits have been gathered.
    terminating-digit: option<string>,
    /// The number of milliseconds to wait for a DTMF response after speak ends before a replaying the sound file.
    timeout-millis: option<s32>,
    /// A list of all digits accepted as valid.
    valid-digits: option<string>,
    /// The gender of the voice used to speak back the text.
    voice: gather-using-speak-request-voice-enum
  }
  call-gather-using-speak: func(params: call-gather-using-speak-params) -> result<string, string>;

  /// Hangup call
  record call-hangup-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-hangup: func(params: call-hangup-params) -> result<string, string>;

  /// Remove call from a queue
  record leave-queue-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  leave-queue: func(params: leave-queue-params) -> result<string, string>;

  /// Play audio URL
  record call-playback-start-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// The URL of a file to be played back on the call. The URL can point to either a WAV or MP3 file. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    loop: option<loopcount>,
    /// The media_name of a file to be played back on the call. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>,
    /// When enabled, audio will be mixed on top of any other audio that is actively being played back. Note that `overlay: true` will only work if there is another audio file already being played on the call.
    overlay: option<bool>,
    /// When specified, it stops the current audio being played.  Specify `current` to stop the current audio being played, and to play the next file in the queue. Specify `all` to stop the current audio file being played and to also clear all audio files from the queue.
    stop: option<string>,
    /// Specifies the leg or legs on which audio will be played. If supplied, the value must be either `self`, `opposite` or `both`.
    target-legs: option<string>
  }
  call-playback-start: func(params: call-playback-start-params) -> result<string, string>;

  /// Stop audio playback
  record call-playback-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Use `current` to stop only the current audio or `all` to stop all audios in the queue.
    stop: option<string>
  }
  call-playback-stop: func(params: call-playback-stop-params) -> result<string, string>;

  /// Record pause
  record call-record-pause-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-record-pause: func(params: call-record-pause-params) -> result<string, string>;

  /// Record resume
  record call-record-resume-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-record-resume: func(params: call-record-resume-params) -> result<string, string>;

  /// Recording start
  record call-record-start-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// When `dual`, final audio file will be stereo recorded with the first leg on channel A, and the rest on channel B.
    channels: start-recording-request-channels-enum,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The audio file format used when storing the call recording. Can be either `mp3` or `wav`.
    format: start-recording-request-format-enum,
    /// Defines the maximum length for the recording in seconds. Minimum value is 0. Maximum value is 14400. Default is 0 (infinite)
    max-length: option<s32>,
    /// If enabled, a beep sound will be played at the start of a recording.
    play-beep: option<bool>
  }
  call-record-start: func(params: call-record-start-params) -> result<string, string>;

  /// Recording stop
  record call-record-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-record-stop: func(params: call-record-stop-params) -> result<string, string>;

  /// SIP Refer a call
  record call-refer-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// Custom headers to be added to the SIP INVITE.
    custom-headers: option<list<custom-sip-header>>,
    /// The SIP URI to which the call will be referred to.
    sip-address: string,
    /// SIP Authentication password used for SIP challenges.
    sip-auth-password: option<string>,
    /// SIP Authentication username used for SIP challenges.
    sip-auth-username: option<string>
  }
  call-refer: func(params: call-refer-params) -> result<string, string>;

  /// Reject a call
  record call-reject-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Cause for call rejection.
    cause: reject-request-cause-enum,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-reject: func(params: call-reject-params) -> result<string, string>;

  /// Send DTMF
  record call-send-dtmf-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// DTMF digits to send. Valid digits are 0-9, A-D, *, and #. Pauses can be added using w (0.5s) and W (1s).
    digits: string,
    /// Specifies for how many milliseconds each digit will be played in the audio stream. Ranges from 100 to 500ms
    duration-millis: option<s32>
  }
  call-send-dtmf: func(params: call-send-dtmf-params) -> result<string, string>;

  /// Speak text
  record call-speak-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The language you want spoken.
    language: gather-using-speak-request-language-enum,
    /// The text or SSML to be converted into speech. There is a 5,000 character limit.
    payload: string,
    /// The type of the provided payload. The payload can either be plain text, or Speech Synthesis Markup Language (SSML).
    payload-type: option<gather-using-speak-request-payload-type-enum>,
    /// This parameter impacts speech quality, language options and payload types. When using `basic`, only the `en-US` language and payload type `text` are allowed.
    service-level: option<gather-using-speak-request-service-level-enum>,
    /// When specified, it stops the current audio being played.  Specify `current` to stop the current audio being played, and to play the next file in the queue. Specify `all` to stop the current audio file being played and to also clear all audio files from the queue.
    stop: option<string>,
    /// The gender of the voice used to speak back the text.
    voice: gather-using-speak-request-voice-enum
  }
  call-speak: func(params: call-speak-params) -> result<string, string>;

  /// Transcription start
  record call-transcription-start-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Language to use for speech recognition
    language: option<transcription-start-request-language-enum>
  }
  call-transcription-start: func(params: call-transcription-start-params) -> result<string, string>;

  /// Transcription stop
  record call-transcription-stop-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  call-transcription-stop: func(params: call-transcription-stop-params) -> result<string, string>;

  /// Transfer call
  record call-transfer-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Enables Answering Machine Detection. When a call is answered, Telnyx runs real-time detection to determine if it was picked up by a human or a machine and sends an `call.machine.detection.ended` webhook with the analysis result. If 'greeting_end' or 'detect_words' is used and a 'machine' is detected, you will receive another 'call.machine.greeting.ended' webhook when the answering machine greeting ends with a beep or silence. If `detect_beep` is used, you will only receive 'call.machine.greeting.ended' if a beep is detected.
    answering-machine-detection: option<call-request-answering-machine-detection-enum>,
    /// Optional configuration parameters to modify 'answering_machine_detection' performance.
    answering-machine-detection-config: option<transfer-call-request-answering-machine-detection-config>,
    /// The URL of a file to be played back when the transfer destination answers before bridging the call. The URL can point to either a WAV or MP3 file. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// Custom headers to be added to the SIP INVITE.
    custom-headers: option<list<custom-sip-header>>,
    /// The `from` number to be used as the caller id presented to the destination (`to` number). The number should be in +E164 format. This attribute will default to the `from` number of the original call if omitted.
    from-op: option<string>,
    /// The `from_display_name` string to be used as the caller id name (SIP From Display Name) presented to the destination (`to` number). The string should have a maximum of 128 characters, containing only letters, numbers, spaces, and -_~!.+ special characters. If ommited, the display name will be the same as the number in the `from` field.
    from-display-name: option<string>,
    /// The media_name of a file to be played back when the transfer destination answers before bridging the call. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>,
    /// SIP Authentication password used for SIP challenges.
    sip-auth-password: option<string>,
    /// SIP Authentication username used for SIP challenges.
    sip-auth-username: option<string>,
    /// Use this field to add state to every subsequent webhook for the new leg. It must be a valid Base-64 encoded string.
    target-leg-client-state: option<string>,
    /// Sets the maximum duration of a Call Control Leg in seconds. If the time limit is reached, the call will hangup and a `call.hangup` webhook with a `hangup_cause` of `time_limit` will be sent. For example, by setting a time limit of 120 seconds, a Call Leg will be automatically terminated two minutes after being answered. The default time limit is 14400 seconds or 4 hours and this is also the maximum allowed call length.
    time-limit-secs: option<s32>,
    /// The number of seconds that Telnyx will wait for the call to be answered by the destination to which it is being transferred. If the timeout is reached before an answer is received, the call will hangup and a `call.hangup` webhook with a `hangup_cause` of `timeout` will be sent. Minimum value is 5 seconds. Maximum value is 120 seconds.
    timeout-secs: option<s32>,
    /// The DID or SIP URI to dial out and bridge to the given call.
    to: string,
    /// Use this field to override the URL for which Telnyx will send subsequent webhooks to for this call.
    webhook-url: option<string>,
    /// HTTP request type used for `webhook_url`.
    webhook-url-method: option<call-request-webhook-url-method-enum>
  }
  call-transfer: func(params: call-transfer-params) -> result<string, string>;

}

interface call-information {
  /// Retrieve a call status
  record retrieve-call-status-params {
    /// Unique identifier and token for controlling the call
    call-control-id: string
  }
  retrieve-call-status: func(params: retrieve-call-status-params) -> result<string, string>;

}

interface number-orders {
  enum comment-comment-record-type-enum {
    number-order,
    sub-number-order,
    number-order-phone-number,
  }

  enum comment-commenter-type-enum {
    admin,
    user,
  }

  enum phone-number-status-enum {
    pending,
    success,
    failure,
  }

  record update-regulatory-requirement {
    /// The value of the requirement, this could be an id to a resource or a string value.
    field-value: option<string>,
    /// Unique id for a requirement.
    requirement-id: option<string>
  }

  record phone-number {
    id: option<string>,
    phone-number: option<string>,
    record-type: option<string>,
    regulatory-group-id: option<string>,
    regulatory-requirements: option<list<phone-number-regulatory-requirement>>,
    /// True if all requirements are met for a phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the phone number in the order.
    status: option<phone-number-status-enum>
  }

  record phone-number-regulatory-requirement {
    /// opaque schema; raw JSON
    value: string
  }

  /// Retrieve all comments
  record list-comments-params {
    /// Record type that the comment relates to i.e number_order, sub_number_order or number_order_phone_number
    filter-comment-record-type: string,
    /// ID of the record the comments relate to
    filter-comment-record-id: string
  }
  list-comments: func(params: list-comments-params) -> result<string, string>;

  /// Create a comment
  record create-comment-params {
    body: option<string>,
    comment-record-id: option<string>,
    comment-record-type: option<comment-comment-record-type-enum>,
    commenter: option<string>,
    commenter-type: option<comment-commenter-type-enum>,
    /// An ISO 8901 datetime string denoting when the comment was created.
    created-at: option<string>,
    id: option<string>,
    /// An ISO 8901 datetime string for when the comment was read.
    read-at: option<string>,
    /// An ISO 8901 datetime string for when the comment was updated.
    updated-at: option<string>
  }
  create-comment: func(params: create-comment-params) -> result<string, string>;

  /// Retrieve a comment
  retrieve-comment: func() -> result<string, string>;

  /// Mark a comment as read
  mark-comment-read: func() -> result<string, string>;

  /// Retrieve a list of phone numbers associated to orders
  retrieve-number-order-phone-numbers: func() -> result<string, string>;

  /// Retrieve a number order phone number.
  record retrieve-number-order-phone-number-params {
    /// The number order phone number ID.
    number-order-phone-number-id: string
  }
  retrieve-number-order-phone-number: func(params: retrieve-number-order-phone-number-params) -> result<string, string>;

  /// Update a number order phone number.
  record update-number-order-phone-number-params {
    /// The number order phone number ID.
    number-order-phone-number-id: string,
    regulatory-requirements: option<list<update-regulatory-requirement>>
  }
  update-number-order-phone-number: func(params: update-number-order-phone-number-params) -> result<string, string>;

  /// List number orders
  record list-number-orders-params {
    /// Filter number orders by status.
    filter-status: option<string>,
    /// Filter number orders later than this value.
    filter-created-at-gt: option<string>,
    /// Filter number orders earlier than this value.
    filter-created-at-lt: option<string>,
    /// Filter number order with this amount of numbers
    filter-phone-numbers-count: option<string>,
    /// Filter number orders via the customer reference set.
    filter-customer-reference: option<string>,
    /// Filter number orders by requirements met.
    filter-requirements-met: option<bool>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-number-orders: func(params: list-number-orders-params) -> result<string, string>;

  /// Create a number order
  record create-number-order-params {
    /// Identifies the billing group associated with the phone number.
    billing-group-id: option<string>,
    /// Identifies the connection associated with this phone number.
    connection-id: option<string>,
    /// An ISO 8901 datetime string denoting when the number order was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    id: option<string>,
    /// Identifies the messaging profile associated with the phone number.
    messaging-profile-id: option<string>,
    phone-numbers: option<list<phone-number>>,
    /// The count of phone numbers in the number order.
    phone-numbers-count: option<s32>,
    record-type: option<string>,
    /// True if all requirements are met for every phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the order.
    status: option<phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the number order was updated.
    updated-at: option<string>
  }
  create-number-order: func(params: create-number-order-params) -> result<string, string>;

  /// Retrieve a number order
  record retrieve-number-order-params {
    /// The number order ID.
    number-order-id: string
  }
  retrieve-number-order: func(params: retrieve-number-order-params) -> result<string, string>;

  /// Update a number order
  record update-number-order-params {
    /// The number order ID.
    number-order-id: string,
    /// An ISO 8901 datetime string denoting when the number order was created.
    created-at: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    id: option<string>,
    phone-numbers: option<list<phone-number>>,
    /// The count of phone numbers in the number order.
    phone-numbers-count: option<s32>,
    record-type: option<string>,
    /// True if all requirements are met for every phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the order.
    status: option<phone-number-status-enum>,
    /// An ISO 8901 datetime string for when the number order was updated.
    updated-at: option<string>
  }
  update-number-order: func(params: update-number-order-params) -> result<string, string>;

  /// List sub number orders
  record list-sub-number-orders-params {
    /// User ID of the user who owns the sub number order
    filter-user-id: option<string>,
    /// ID of the number order the sub number order belongs to
    filter-order-request-id: option<string>,
    /// ISO alpha-2 country code.
    filter-country-code: option<string>,
    /// Phone Number Type
    filter-phone-number-type: option<string>,
    /// Amount of numbers in the sub number order
    filter-phone-numbers-count: option<s32>
  }
  list-sub-number-orders: func(params: list-sub-number-orders-params) -> result<string, string>;

  /// Retrieve a sub number order
  record retrieve-sub-number-order-params {
    /// The sub number order ID.
    sub-number-order-id: string,
    /// Include the first 50 phone number objects in the results
    filter-include-phone-numbers: option<bool>
  }
  retrieve-sub-number-order: func(params: retrieve-sub-number-order-params) -> result<string, string>;

  /// Update a sub number order
  record update-sub-number-order-params {
    /// The sub number order ID.
    sub-number-order-id: string,
    regulatory-requirements: option<list<update-regulatory-requirement>>
  }
  update-sub-number-order: func(params: update-sub-number-order-params) -> result<string, string>;

}

interface conference-commands {
  enum create-conference-request-beep-enabled-enum {
    always,
    never,
    on-enter,
    on-exit,
  }

  enum conference-call-request-supervisor-role-enum {
    barge,
    monitor,
    none,
    whisper,
  }

  enum start-recording-request-channels-enum {
    single,
    dual,
  }

  enum start-recording-request-format-enum {
    wav,
    mp3,
  }

  enum conference-speak-request-language-enum {
    arb,
    cmn-cn,
    cy-gb,
    da-dk,
    de-de,
    en-au,
    en-gb,
    en-gb-wls,
    en-in,
    en-us,
    es-es,
    es-mx,
    es-us,
    fr-ca,
    fr-fr,
    hi-in,
    is-is,
    it-it,
    ja-jp,
    ko-kr,
    nb-no,
    nl-nl,
    pl-pl,
    pt-br,
    pt-pt,
    ro-ro,
    ru-ru,
    sv-se,
    tr-tr,
  }

  enum conference-speak-request-payload-type-enum {
    text,
    ssml,
  }

  enum conference-speak-request-voice-enum {
    male,
    female,
  }

  record loopcount {
    /// opaque schema; raw JSON
    value: string
  }

  /// List conferences
  record list-conferences-params {
    /// If present, conferences will be filtered to those with a matching `name` attribute. Matching is case-sensitive
    filter-name: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-conferences: func(params: list-conferences-params) -> result<string, string>;

  /// Create conference
  record create-conference-params {
    /// Whether a beep sound should be played when participants join and/or leave the conference.
    beep-enabled: option<create-conference-request-beep-enabled-enum>,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Toggle background comfort noise.
    comfort-noise: option<bool>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// Time length (minutes) after which the conference will end.
    duration-minutes: option<s32>,
    /// The URL of a file to be played to participants joining the conference. The URL can point to either a WAV or MP3 file. hold_media_name and hold_audio_url cannot be used together in one request. Takes effect only when "start_conference_on_create" is set to "false".
    hold-audio-url: option<string>,
    /// The media_name of a file to be played to participants joining the conference. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file. Takes effect only when "start_conference_on_create" is set to "false".
    hold-media-name: option<string>,
    /// Name of the conference
    name: string,
    /// Whether the conference should be started on creation. If the conference isn't started all participants that join are automatically put on hold. Defaults to "true".
    start-conference-on-create: option<bool>
  }
  create-conference: func(params: create-conference-params) -> result<string, string>;

  /// List conference participants
  record list-conference-participants-params {
    /// Uniquely identifies the conference by id
    conference-id: string,
    /// If present, participants will be filtered to those who are/are not muted
    filter-muted: option<bool>,
    /// If present, participants will be filtered to those who are/are not put on hold
    filter-on-hold: option<bool>,
    /// If present, participants will be filtered to those who are whispering or are not
    filter-whispering: option<bool>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-conference-participants: func(params: list-conference-participants-params) -> result<string, string>;

  /// Retrieve a conference
  record retrieve-conference-params {
    /// Uniquely identifies the conference by id
    id: string
  }
  retrieve-conference: func(params: retrieve-conference-params) -> result<string, string>;

  /// Dial a new participant into a conference
  record conference-dial-participant-in-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// The `from` number to be used as the caller id presented to the destination (`to` number).
    from-op: string,
    /// Whether the participant should be put on hold immediately after joining the conference.
    hold: option<bool>,
    /// The URL of a file to be played to the participant when they are put on hold after joining the conference. If media_name is also supplied, this is currently ignored. Takes effect only when "start_conference_on_create" is set to "false". This property takes effect only if "hold" is set to "true".
    hold-audio-url: option<string>,
    /// The media_name of a file to be played to the participant when they are put on hold after joining the conference. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file. Takes effect only when "start_conference_on_create" is set to "false". This property takes effect only if "hold" is set to "true".
    hold-media-name: option<string>,
    /// Whether the participant should be muted immediately after joining the conference.
    mute: option<bool>,
    /// Whether the conference should be started after the participant joins the conference.
    start-conference-on-enter: option<bool>,
    /// Sets the joining participant as a supervisor for the conference. A conference can have multiple supervisors. "barge" means the supervisor enters the conference as a normal participant. This is the same as "none". "monitor" means the supervisor is muted but can hear all participants. "whisper" means that only the specified "whisper_call_control_ids" can hear the supervisor. Defaults to "none".
    supervisor-role: option<conference-call-request-supervisor-role-enum>,
    /// The DID or SIP URI to dial out and bridge to the given call.
    to: string,
    /// Array of unique call_control_ids the joining supervisor can whisper to. If none provided, the supervisor will join the conference as a monitoring participant only.
    whisper-call-control-ids: option<list<string>>
  }
  conference-dial-participant-in: func(params: conference-dial-participant-in-params) -> result<string, string>;

  /// Hold conference participants
  record conference-hold-participants-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// The URL of a file to be played to the participants when they are put on hold. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// List of unique identifiers and tokens for controlling the call. When empty all participants will be placed on hold.
    call-control-ids: option<list<string>>,
    /// The media_name of a file to be played to the participants when they are put on hold. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>
  }
  conference-hold-participants: func(params: conference-hold-participants-params) -> result<string, string>;

  /// Join a conference
  record conference-join-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Whether a beep sound should be played when the participant joins and/or leaves the conference. Can be used to override the conference-level setting.
    beep-enabled: option<create-conference-request-beep-enabled-enum>,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// Whether the conference should end and all remaining participants be hung up after the participant leaves the conference. Defaults to "false".
    end-conference-on-exit: option<bool>,
    /// Whether the participant should be put on hold immediately after joining the conference. Defaults to "false".
    hold: option<bool>,
    /// The URL of a file to be played to the participant when they are put on hold after joining the conference. hold_media_name and hold_audio_url cannot be used together in one request. Takes effect only when "start_conference_on_create" is set to "false". This property takes effect only if "hold" is set to "true".
    hold-audio-url: option<string>,
    /// The media_name of a file to be played to the participant when they are put on hold after joining the conference. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file. Takes effect only when "start_conference_on_create" is set to "false". This property takes effect only if "hold" is set to "true".
    hold-media-name: option<string>,
    /// Whether the participant should be muted immediately after joining the conference. Defaults to "false".
    mute: option<bool>,
    /// Whether the conference should end after the participant leaves the conference. NOTE this doesn't hang up the other participants. Defaults to "false".
    soft-end-conference-on-exit: option<bool>,
    /// Whether the conference should be started after the participant joins the conference. Defaults to "false".
    start-conference-on-enter: option<bool>,
    /// Sets the joining participant as a supervisor for the conference. A conference can have multiple supervisors. "barge" means the supervisor enters the conference as a normal participant. This is the same as "none". "monitor" means the supervisor is muted but can hear all participants. "whisper" means that only the specified "whisper_call_control_ids" can hear the supervisor. Defaults to "none".
    supervisor-role: option<conference-call-request-supervisor-role-enum>,
    /// Array of unique call_control_ids the joining supervisor can whisper to. If none provided, the supervisor will join the conference as a monitoring participant only.
    whisper-call-control-ids: option<list<string>>
  }
  conference-join: func(params: conference-join-params) -> result<string, string>;

  /// Leave a conference
  record conference-leave-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Whether a beep sound should be played when the participant leaves the conference. Can be used to override the conference-level setting.
    beep-enabled: option<create-conference-request-beep-enabled-enum>,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>
  }
  conference-leave: func(params: conference-leave-params) -> result<string, string>;

  /// Mute conference participants
  record conference-mute-participants-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Array of unique identifiers and tokens for controlling the call. When empty all participants will be muted.
    call-control-ids: option<list<string>>
  }
  conference-mute-participants: func(params: conference-mute-participants-params) -> result<string, string>;

  /// Play audio to conference participants
  record conference-play-audio-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// The URL of a file to be played back in the conference. media_name and audio_url cannot be used together in one request.
    audio-url: option<string>,
    /// List of call control ids identifying participants the audio file should be played to. If not given, the audio file will be played to the entire conference.
    call-control-ids: option<list<string>>,
    loop: option<loopcount>,
    /// The media_name of a file to be played back in the conference. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. The file must either be a WAV or MP3 file.
    media-name: option<string>
  }
  conference-play-audio: func(params: conference-play-audio-params) -> result<string, string>;

  /// Conference recording start
  record conference-start-recording-params {
    /// Specifies the conference to record by id or name
    id: string,
    /// When `dual`, final audio file will be stereo recorded with the first leg on channel A, and the rest on channel B.
    channels: start-recording-request-channels-enum,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>,
    /// The audio file format used when storing the call recording. Can be either `mp3` or `wav`.
    format: start-recording-request-format-enum,
    /// Defines the maximum length for the recording in seconds. Minimum value is 0. Maximum value is 14400. Default is 0 (infinite)
    max-length: option<s32>,
    /// If enabled, a beep sound will be played at the start of a recording.
    play-beep: option<bool>
  }
  conference-start-recording: func(params: conference-start-recording-params) -> result<string, string>;

  /// Conference recording stop
  record conference-stop-recording-params {
    /// Specifies the conference to stop the recording for by id or name
    id: string,
    /// Use this field to add state to every subsequent webhook. It must be a valid Base-64 encoded string.
    client-state: option<string>,
    /// Use this field to avoid duplicate commands. Telnyx will ignore commands with the same `command_id`.
    command-id: option<string>
  }
  conference-stop-recording: func(params: conference-stop-recording-params) -> result<string, string>;

  /// Speak text to conference participants
  record conference-speak-text-params {
    /// Specifies the conference by id or name
    id: string,
    /// Call Control IDs of participants who will hear the spoken text. When empty all participants will hear the spoken text.
    call-control-ids: option<list<string>>,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// The language used to speak the text.
    language: conference-speak-request-language-enum,
    /// The text or SSML to be converted into speech. There is a 5,000 character limit.
    payload: string,
    /// The type of the provided payload. The payload can either be plain text, or Speech Synthesis Markup Language (SSML).
    payload-type: option<conference-speak-request-payload-type-enum>,
    /// The gender of the voice used to speak the text.
    voice: conference-speak-request-voice-enum
  }
  conference-speak-text: func(params: conference-speak-text-params) -> result<string, string>;

  /// Stop audio being played on the conference
  record conference-stop-audio-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// List of call control ids identifying participants the audio file should stop be played to. If not given, the audio will be stoped to the entire conference.
    call-control-ids: option<list<string>>
  }
  conference-stop-audio: func(params: conference-stop-audio-params) -> result<string, string>;

  /// Unhold conference participants
  record conference-unhold-participants-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// List of unique identifiers and tokens for controlling the call. Enter each call control ID to be unheld.
    call-control-ids: list<string>
  }
  conference-unhold-participants: func(params: conference-unhold-participants-params) -> result<string, string>;

  /// Unmute conference participants
  record conference-unmute-participants-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// List of unique identifiers and tokens for controlling the call. Enter each call control ID to be unmuted. When empty all participants will be unmuted.
    call-control-ids: option<list<string>>
  }
  conference-unmute-participants: func(params: conference-unmute-participants-params) -> result<string, string>;

  /// Update conference participant
  record conference-update-params {
    /// Uniquely identifies the conference by id or name
    id: string,
    /// Unique identifier and token for controlling the call
    call-control-id: string,
    /// Use this field to avoid execution of duplicate commands. Telnyx will ignore subsequent commands with the same `command_id` as one that has already been executed.
    command-id: option<string>,
    /// Sets the participant as a supervisor for the conference. A conference can have multiple supervisors. "barge" means the supervisor enters the conference as a normal participant. This is the same as "none". "monitor" means the supervisor is muted but can hear all participants. "whisper" means that only the specified "whisper_call_control_ids" can hear the supervisor. Defaults to "none".
    supervisor-role: conference-call-request-supervisor-role-enum,
    /// Array of unique call_control_ids the supervisor can whisper to. If none provided, the supervisor will join the conference as a monitoring participant only.
    whisper-call-control-ids: option<list<string>>
  }
  conference-update: func(params: conference-update-params) -> result<string, string>;

}

interface connections {
  enum list-connections-sort-enum {
    created-at,
    connection-name,
    active,
  }

  /// List connections
  record list-connections-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, connections with <code>connection_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-connections-sort-enum>
  }
  list-connections: func(params: list-connections-params) -> result<string, string>;

  /// Retrieve a connection
  record retrieve-connection-params {
    /// IP Connection ID
    id: string
  }
  retrieve-connection: func(params: retrieve-connection-params) -> result<string, string>;

}

interface credential-connections {
  enum list-credential-connections-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum credential-inbound-ani-number-format-enum {
    e-v164,
    e-v164-v2,
    e-v164-national,
    e-v164-national-v2,
  }

  enum credential-inbound-dnis-number-format-enum {
    e164,
    e164-v2,
    national,
    sip-username,
  }

  enum credential-outbound-ani-override-type-enum {
    always,
    normal,
    emergency,
  }

  enum credential-outbound-t38-reinvite-source-enum {
    telnyx,
    customer,
    disabled,
    passthru,
    caller-passthru,
    callee-passthru,
  }

  enum create-credential-connection-request-sip-uri-calling-preference-enum {
    disabled,
    unrestricted,
    internal,
  }

  enum create-credential-connection-request-webhook-api-version-enum {
    v1,
    v2,
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
  record dtmf-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Enable use of SRTP or ZRTP for encryption. Valid values are those listed or null. Cannot be set to non-null if the transport_portocol is TLS.
  record encrypted-media {
    /// opaque schema; raw JSON
    value: string
  }

  record credential-inbound {
    /// This setting allows you to set the format with which the caller's number (ANI) is sent for inbound phone calls.
    ani-number-format: option<credential-inbound-ani-number-format-enum>,
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Defines the list of codecs that Telnyx will send for inbound calls to a specific number on your portal account, in priority order. This only works when the Connection the number is assigned to uses Media Handling mode: default. OPUS and H.264 codecs are available only when using TCP or TLS transport for SIP.
    codecs: option<list<string>>,
    dnis-number-format: option<credential-inbound-dnis-number-format-enum>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, inbound phone calls will receive ISUP parameters via SIP headers. (Only when available and only when using TCP or TLS transport.)
    isup-headers-enabled: option<bool>,
    /// Enable PRACK messages as defined in RFC3262.
    prack-enabled: option<bool>,
    /// By default, Telnyx does not send caller-id information when the caller has chosen to hide this information. When this option is enabled, Telnyx will send the SIP header Privacy:id plus the caller-id information so that the receiver side can choose when to hide it.
    privacy-zone-enabled: option<bool>,
    /// Defaults to true.
    sip-compact-headers-enabled: option<bool>,
    /// Time(sec) before aborting if connection is not made.
    timeout-v1xx-secs: option<s32>,
    /// Time(sec) before aborting if call is unanswered (min: 1, max: 600).
    timeout-v2xx-secs: option<string>
  }

  record credential-outbound {
    /// Set a phone number as the ani_override value to override caller id number on outbound calls.
    ani-override: option<string>,
    /// Specifies when we apply your ani_override setting. Only applies when ani_override is not blank.
    ani-override-type: option<credential-outbound-ani-override-type-enum>,
    /// Forces all SIP calls originated on this connection to be "parked" instead of "bridged" to the destination specified on the URI. Parked calls will return ringback to the caller and will await for a Call Control command to define which action will be taken next.
    call-parking-enabled: option<bool>,
    /// When set, this will limit the total number of outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, ringback will not wait for indication before sending ringback tone to calling party.
    instant-ringback-enabled: option<bool>,
    /// A 2-character country code specifying the country whose national dialing rules should be used. For example, if set to `US` then any US number can be dialed without preprending +1 to the number. When left blank, Telnyx will try US and GB dialing rules, in that order, by default.
    localization: option<string>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>,
    /// This setting only affects connections with Fax-type Outbound Voice Profiles. The setting dictates whether or not Telnyx sends a t.38 reinvite.<br/><br/> By default, Telnyx will send the re-invite. If set to `customer`, the caller is expected to send the t.38 reinvite.
    t38-reinvite-source: option<credential-outbound-t38-reinvite-source-enum>
  }

  /// Identifies the associated outbound voice profile.
  record outbound-voice-profile-id {
    /// opaque schema; raw JSON
    value: string
  }

  record connection-rtcp-settings {
    /// BETA - Enable the capture and storage of RTCP messages to create QoS reports on the Telnyx Mission Control Portal.
    capture-enabled: option<bool>,
    /// RTCP port by default is rtp+1, it can also be set to rtcp-mux
    port: option<string>,
    /// RTCP reports are sent to customers based on the frequency set. Frequency is in seconds and it can be set to values from 5 to 3000 seconds.
    report-frequency-secs: option<s32>
  }

  /// List credential connections
  record list-credential-connections-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, connections with <code>connection_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-credential-connections-sort-enum>
  }
  list-credential-connections: func(params: list-credential-connections-params) -> result<string, string>;

  /// Create a credential connection
  record create-credential-connection-params {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: string,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<credential-inbound>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<credential-outbound>,
    /// The password to be used as part of the credentials. Must be 8 to 128 characters long.
    password: string,
    rtcp-settings: option<connection-rtcp-settings>,
    /// This feature enables inbound SIP URI calls to your Credential Auth Connection. If enabled for all (unrestricted) then anyone who calls the SIP URI <your-username>@telnyx.com will be connected to your Connection. You can also choose to allow only calls that are originated on any Connections under your account (internal).
    sip-uri-calling-preference: option<create-credential-connection-request-sip-uri-calling-preference-enum>,
    /// The user name to be used as part of the credentials. Must be 4-32 characters long and alphanumeric values only (no spaces or special characters).
    user-name: string,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<create-credential-connection-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  create-credential-connection: func(params: create-credential-connection-params) -> result<string, string>;

  /// Retrieve a credential connection
  record retrieve-credential-connection-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-credential-connection: func(params: retrieve-credential-connection-params) -> result<string, string>;

  /// Update a credential connection
  record update-credential-connection-params {
    /// Identifies the resource.
    id: string,
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<credential-inbound>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    outbound: option<credential-outbound>,
    /// The password to be used as part of the credentials. Must be 8 to 128 characters long.
    password: option<string>,
    rtcp-settings: option<connection-rtcp-settings>,
    /// This feature enables inbound SIP URI calls to your Credential Auth Connection. If enabled for all (unrestricted) then anyone who calls the SIP URI <your-username>@telnyx.com will be connected to your Connection. You can also choose to allow only calls that are originated on any Connections under your account (internal).
    sip-uri-calling-preference: option<create-credential-connection-request-sip-uri-calling-preference-enum>,
    /// The user name to be used as part of the credentials. Must be 4-32 characters long and alphanumeric values only (no spaces or special characters).
    user-name: option<string>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<create-credential-connection-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  update-credential-connection: func(params: update-credential-connection-params) -> result<string, string>;

  /// Delete a credential connection
  record delete-credential-connection-params {
    /// Identifies the resource.
    id: string
  }
  delete-credential-connection: func(params: delete-credential-connection-params) -> result<string, string>;

}

interface detail-records {
  /// Search detail records
  record search-params {
    /// Filter by the given record type
    filter-record-type: string,
    /// Filter by the given user-friendly date range
    filter-date-range: option<string>,
    /// Filter records
    filter: option<string>,
    /// Page number
    page-number: option<s32>,
    /// Page size
    page-size: option<s32>,
    /// Specifies the sort order for results
    sort: option<list<string>>
  }
  search: func(params: search-params) -> result<string, string>;

}

interface documents {
  /// List all document links
  record list-document-links-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Identifies the associated document to filter on.
    filter-document-id: option<string>,
    /// The `linked_record_type` of the document to filter on.
    filter-linked-record-type: option<string>,
    /// The `linked_resource_id` of the document to filter on.
    filter-linked-resource-id: option<string>
  }
  list-document-links: func(params: list-document-links-params) -> result<string, string>;

  /// List all documents
  record list-documents-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-documents: func(params: list-documents-params) -> result<string, string>;

  /// Upload a document
  record create-document-params {
    /// opaque schema; raw JSON
    value: string
  }
  create-document: func(params: create-document-params) -> result<string, string>;

  /// Retrieve a document
  record retrieve-document-params {
    /// The id of the resource.
    id: string
  }
  retrieve-document: func(params: retrieve-document-params) -> result<string, string>;

  /// Update a document
  record update-document-params {
    /// The id of the resource.
    id: string,
    /// opaque schema; raw JSON
    value: string
  }
  update-document: func(params: update-document-params) -> result<string, string>;

  /// Delete a document
  record delete-document-params {
    /// The id of the resource.
    id: string
  }
  delete-document: func(params: delete-document-params) -> result<string, string>;

  /// Download a document
  record download-doc-service-document-params {
    /// The id of the resource.
    id: string
  }
  download-doc-service-document: func(params: download-doc-service-document-params) -> result<string, string>;

}

interface programmable-fax-applications {
  enum list-fax-applications-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum create-fax-application-request-inbound-sip-subdomain-receive-settings-enum {
    only-my-connections,
    from-anyone,
  }

  /// Specifies whether the connection can be used.
  record connection-active {
    /// opaque schema; raw JSON
    value: string
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// A user-assigned name to help manage the application.
  record application-name {
    /// opaque schema; raw JSON
    value: string
  }

  record create-fax-application-request-inbound {
    /// When set, this will limit the number of concurrent inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<create-fax-application-request-inbound-sip-subdomain-receive-settings-enum>
  }

  record create-fax-application-request-outbound {
    /// When set, this will limit the number of concurrent outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>
  }

  /// Identifies the associated outbound voice profile.
  record outbound-voice-profile-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
  record webhook-event-failover-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
  record webhook-event-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Specifies how many seconds to wait before timing out a webhook.
  record webhook-timeout-secs {
    /// opaque schema; raw JSON
    value: string
  }

  record update-fax-application-request-inbound {
    /// When set, this will limit the number of concurrent inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<create-fax-application-request-inbound-sip-subdomain-receive-settings-enum>
  }

  record update-fax-application-request-outbound {
    /// When set, this will limit the number of concurrent outbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    outbound-voice-profile-id: option<outbound-voice-profile-id>
  }

  /// List all Fax Applications
  record list-fax-applications-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, applications with <code>application_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-application-name-contains: option<string>,
    /// Identifies the associated outbound voice profile.
    filter-outbound-voice-profile-id: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-fax-applications-sort-enum>
  }
  list-fax-applications: func(params: list-fax-applications-params) -> result<string, string>;

  /// Creates a Fax Application
  record create-fax-application-params {
    active: option<connection-active>,
    anchorsite-override: option<anchorsite-override>,
    application-name: application-name,
    inbound: option<create-fax-application-request-inbound>,
    outbound: option<create-fax-application-request-outbound>,
    webhook-event-failover-url: option<webhook-event-failover-url>,
    webhook-event-url: webhook-event-url,
    webhook-timeout-secs: option<webhook-timeout-secs>
  }
  create-fax-application: func(params: create-fax-application-params) -> result<string, string>;

  /// Retrieve a Fax Application
  record get-fax-application-params {
    /// Identifies the resource.
    id: string
  }
  get-fax-application: func(params: get-fax-application-params) -> result<string, string>;

  /// Update a Fax Application
  record update-fax-application-params {
    /// Identifies the resource.
    id: string,
    active: option<connection-active>,
    anchorsite-override: option<anchorsite-override>,
    application-name: application-name,
    inbound: option<update-fax-application-request-inbound>,
    outbound: option<update-fax-application-request-outbound>,
    webhook-event-failover-url: option<webhook-event-failover-url>,
    webhook-event-url: webhook-event-url,
    webhook-timeout-secs: option<webhook-timeout-secs>
  }
  update-fax-application: func(params: update-fax-application-params) -> result<string, string>;

  /// Deletes a Fax Application
  record delete-fax-application-params {
    /// Identifies the resource.
    id: string
  }
  delete-fax-application: func(params: delete-fax-application-params) -> result<string, string>;

}

interface programmable-fax-commands {
  /// View a list of faxes
  record list-faxes-params {
    /// ISO 8601 date time for filtering faxes created after or on that date
    filter-created-at-gte: option<string>,
    /// ISO 8601 date time for filtering faxes created after that date
    filter-created-at-gt: option<string>,
    /// ISO 8601 formatted date time for filtering faxes created on or before that date
    filter-created-at-lte: option<string>,
    /// ISO 8601 formatted date time for filtering faxes created before that date
    filter-created-at-lt: option<string>,
    /// The direction, inbound or outbound, for filtering faxes sent from this account
    filter-direction-eq: option<string>,
    /// The phone number, in E.164 format for filtering faxes sent from this number
    filter-from-eq: option<string>,
    /// Number of fax resourcxes for the single page returned
    page-size: option<s32>,
    /// Number of the page to be retrieved
    page-number: option<s32>
  }
  list-faxes: func(params: list-faxes-params) -> result<string, string>;

  /// Send a fax
  record send-fax-params {
    /// The connection ID to send the fax with.
    connection-id: string,
    /// The phone number, in E.164 format, the fax will be sent from.
    from-op: string,
    /// The media_name of a file to be used for the fax's media. The media_name must point to a file previously uploaded to api.telnyx.com/v2/media by the same user/organization. media_url and media_name can't be submitted together.
    media-name: option<string>,
    /// The URL to the PDF used for the fax's media. media_url and media_name can't be submitted together.
    media-url: option<string>,
    /// The quality of the fax. Can be normal, high, very_high.
    quality: option<string>,
    /// Should fax media be stored on temporary URL. It does not support media_name, they can't be submitted together.
    store-media: option<bool>,
    /// The phone number, in E.164 format, the fax will be sent to or SIP URI.
    to: string
  }
  send-fax: func(params: send-fax-params) -> result<string, string>;

  /// View a fax
  record view-fax-params {
    /// The unique identifier of a fax.
    id: string
  }
  view-fax: func(params: view-fax-params) -> result<string, string>;

  /// Delete a fax
  record delete-fax-params {
    /// The unique identifier of a fax.
    id: string
  }
  delete-fax: func(params: delete-fax-params) -> result<string, string>;

  /// Refresh a fax
  record refresh-fax-params {
    /// The unique identifier of a fax.
    id: string
  }
  refresh-fax: func(params: refresh-fax-params) -> result<string, string>;

}

interface fqdn-connections {
  enum list-fqdn-connections-sort-enum {
    created-at,
    connection-name,
    active,
  }

  enum inbound-fqdn-ani-number-format-enum {
    e-v164,
    e-v164-v2,
    e-v164-national,
    e-v164-national-v2,
  }

  enum inbound-fqdn-default-routing-method-enum {
    sequential,
    round-robin,
  }

  enum inbound-fqdn-dnis-number-format-enum {
    e164,
    e164-v2,
    national,
    sip-username,
  }

  enum inbound-fqdn-sip-region-enum {
    us,
    europe,
    australia,
  }

  enum inbound-fqdn-sip-subdomain-receive-settings-enum {
    only-my-connections,
    from-anyone,
  }

  enum create-fqdn-connection-request-webhook-api-version-enum {
    v1,
    v2,
  }

  /// `Latency` directs Telnyx to route media through the site with the lowest round-trip time to the user's connection. Telnyx calculates this time using ICMP ping messages. This can be disabled by specifying a site to handle all media.
  record anchorsite-override {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the type of DTMF digits sent from Telnyx to this Connection. Note that DTMF digits sent to Telnyx will be accepted in all formats.
  record dtmf-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Enable use of SRTP or ZRTP for encryption. Valid values are those listed or null. Cannot be set to non-null if the transport_portocol is TLS.
  record encrypted-media {
    /// opaque schema; raw JSON
    value: string
  }

  record inbound-fqdn {
    /// This setting allows you to set the format with which the caller's number (ANI) is sent for inbound phone calls.
    ani-number-format: option<inbound-fqdn-ani-number-format-enum>,
    /// When set, this will limit the total number of inbound calls to phone numbers associated with this connection.
    channel-limit: option<s32>,
    /// Defines the list of codecs that Telnyx will send for inbound calls to a specific number on your portal account, in priority order. This only works when the Connection the number is assigned to uses Media Handling mode: default. OPUS and H.264 codecs are available only when using TCP or TLS transport for SIP.
    codecs: option<list<string>>,
    /// Default routing method to be used when a number is associated with the connection. Must be one of the routing method types or null, other values are not allowed.
    default-routing-method: option<inbound-fqdn-default-routing-method-enum>,
    dnis-number-format: option<inbound-fqdn-dnis-number-format-enum>,
    /// Generate ringback tone through 183 session progress message with early media.
    generate-ringback-tone: option<bool>,
    /// When set, inbound phone calls will receive ISUP parameters via SIP headers. (Only when available and only when using TCP or TLS transport.)
    isup-headers-enabled: option<bool>,
    /// Enable PRACK messages as defined in RFC3262.
    prack-enabled: option<bool>,
    /// By default, Telnyx does not send caller-id information when the caller has chosen to hide this information. When this option is enabled, Telnyx will send the SIP header Privacy:id plus the caller-id information so that the receiver side can choose when to hide it.
    privacy-zone-enabled: option<bool>,
    /// Defaults to true.
    sip-compact-headers-enabled: option<bool>,
    /// Selects which `sip_region` to receive inbound calls from. If null, the default region (US) will be used.
    sip-region: option<inbound-fqdn-sip-region-enum>,
    /// Specifies a subdomain that can be used to receive Inbound calls to a Connection, in the same way a phone number is used, from a SIP endpoint. Example: the subdomain "example.sip.telnyx.com" can be called from any SIP endpoint by using the SIP URI "sip:@example.sip.telnyx.com" where the user part can be any alphanumeric value. Please note TLS encrypted calls are not allowed for subdomain calls.
    sip-subdomain: option<string>,
    /// This option can be enabled to receive calls from: "Anyone" (any SIP endpoint in the public Internet) or "Only my connections" (any connection assigned to the same Telnyx user).
    sip-subdomain-receive-settings: option<inbound-fqdn-sip-subdomain-receive-settings-enum>,
    /// Time(sec) before aborting if connection is not made.
    timeout-v1xx-secs: option<s32>,
    /// Time(sec) before aborting if call is unanswered (min: 1, max: 600).
    timeout-v2xx-secs: option<s32>
  }

  record connection-rtcp-settings {
    /// BETA - Enable the capture and storage of RTCP messages to create QoS reports on the Telnyx Mission Control Portal.
    capture-enabled: option<bool>,
    /// RTCP port by default is rtp+1, it can also be set to rtcp-mux
    port: option<string>,
    /// RTCP reports are sent to customers based on the frequency set. Frequency is in seconds and it can be set to values from 5 to 3000 seconds.
    report-frequency-secs: option<s32>
  }

  /// One of UDP, TLS, or TCP. Applies only to connections with IP authentication or FQDN authentication.
  record fqdn-connection-transport-protocol {
    /// opaque schema; raw JSON
    value: string
  }

  /// List FQDN connections
  record list-fqdn-connections-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// If present, connections with <code>connection_name</code> containing the given value will be returned. Matching is not case-sensitive. Requires at least three characters.
    filter-connection-name-contains: option<string>,
    /// Specifies the sort order for results. By default sorting direction is ascending. To have the results sorted in descending order add the <code> -</code> prefix.<br/><br/>
    /// That is: <ul>
    sort: option<list-fqdn-connections-sort-enum>
  }
  list-fqdn-connections: func(params: list-fqdn-connections-params) -> result<string, string>;

  /// Create an FQDN connection
  record create-fqdn-connection-params {
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: string,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<inbound-fqdn>,
    /// Enable on-net T38 if you prefer the sender and receiver negotiating T38 directly if both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call depending on each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    rtcp-settings: option<connection-rtcp-settings>,
    transport-protocol: option<fqdn-connection-transport-protocol>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<create-fqdn-connection-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  create-fqdn-connection: func(params: create-fqdn-connection-params) -> result<string, string>;

  /// Retrieve an FQDN connection
  record retrieve-fqdn-connection-params {
    /// FQDN Connection ID
    id: string
  }
  retrieve-fqdn-connection: func(params: retrieve-fqdn-connection-params) -> result<string, string>;

  /// Update an FQDN connection
  record update-fqdn-connection-params {
    /// FQDN Connection ID
    id: string,
    /// Defaults to true
    active: option<bool>,
    anchorsite-override: option<anchorsite-override>,
    connection-name: option<string>,
    /// When enabled, Telnyx will generate comfort noise when you place the call on hold. If disabled, you will need to generate comfort noise or on hold music to avoid RTP timeout.
    default-on-hold-comfort-noise-enabled: option<bool>,
    dtmf-type: option<dtmf-type>,
    /// Encode the SIP contact header sent by Telnyx to avoid issues for NAT or ALG scenarios.
    encode-contact-header-enabled: option<bool>,
    encrypted-media: option<encrypted-media>,
    inbound: option<inbound-fqdn>,
    /// Enable on-net T38 if you prefer that the sender and receiver negotiate T38 directly when both are on the Telnyx network. If this is disabled, Telnyx will be able to use T38 on just one leg of the call according to each leg's settings.
    onnet-t38-passthrough-enabled: option<bool>,
    rtcp-settings: option<connection-rtcp-settings>,
    transport-protocol: option<fqdn-connection-transport-protocol>,
    /// Determines which webhook format will be used, Telnyx API v1 or v2.
    webhook-api-version: option<create-fqdn-connection-request-webhook-api-version-enum>,
    /// The failover URL where webhooks related to this connection will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'.
    webhook-event-failover-url: option<string>,
    /// The URL where webhooks related to this connection will be sent. Must include a scheme, such as 'https'.
    webhook-event-url: option<string>,
    /// Specifies how many seconds to wait before timing out a webhook.
    webhook-timeout-secs: option<s32>
  }
  update-fqdn-connection: func(params: update-fqdn-connection-params) -> result<string, string>;

  /// Delete an FQDN connection
  record delete-fqdn-connection-params {
    /// FQDN Connection ID
    id: string
  }
  delete-fqdn-connection: func(params: delete-fqdn-connection-params) -> result<string, string>;

}

interface fqd-ns {
  /// List FQDNs
  record list-fqdns-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// ID of the FQDN connection to which the FQDN belongs.
    filter-connection-id: option<string>,
    /// FQDN represented by the resource.
    filter-fqdn: option<string>,
    /// Port to use when connecting to the FQDN.
    filter-port: option<s32>,
    /// DNS record type used by the FQDN.
    filter-dns-record-type: option<string>
  }
  list-fqdns: func(params: list-fqdns-params) -> result<string, string>;

  /// Create an FQDN
  record create-fqdn-params {
    /// ID of the FQDN connection to which this IP should be attached.
    connection-id: string,
    /// The DNS record type for the FQDN. For cases where a port is not set, the DNS record type must be 'srv'. For cases where a port is set, the DNS record type must be 'a'. If the DNS record type is 'a' and a port is not specified, 5060 will be used.
    dns-record-type: string,
    /// FQDN represented by this resource.
    fqdn: string,
    /// Port to use when connecting to this FQDN.
    port: option<s32>
  }
  create-fqdn: func(params: create-fqdn-params) -> result<string, string>;

  /// Retrieve an FQDN
  record retrieve-fqdn-params {
    /// Identifies the resource.
    id: string
  }
  retrieve-fqdn: func(params: retrieve-fqdn-params) -> result<string, string>;

  /// Update an FQDN
  record update-fqdn-params {
    /// Identifies the resource.
    id: string,
    /// ID of the FQDN connection to which this IP should be attached.
    connection-id: option<string>,
    /// The DNS record type for the FQDN. For cases where a port is not set, the DNS record type must be 'srv'. For cases where a port is set, the DNS record type must be 'a'. If the DNS record type is 'a' and a port is not specified, 5060 will be used.
    dns-record-type: option<string>,
    /// FQDN represented by this resource.
    fqdn: option<string>,
    /// Port to use when connecting to this FQDN.
    port: option<s32>
  }
  update-fqdn: func(params: update-fqdn-params) -> result<string, string>;

  /// Delete an FQDN
  record delete-fqdn-params {
    /// Identifies the resource.
    id: string
  }
  delete-fqdn: func(params: delete-fqdn-params) -> result<string, string>;

}

interface inventory-level {
