interface number-background-jobs {
  enum list-phone-numbers-jobs-filter-type-enum {
    update-emergency-settings,
    delete-phone-numbers,
    update-phone-numbers,
  }

  enum list-phone-numbers-jobs-sort-enum {
    created-at,
  }

  enum phone-numbers-job-status-enum {
    pending,
    in-progress,
    completed,
    failed,
    expired,
  }

  record list-phone-numbers-jobs-response {
    data: option<list<phone-numbers-job>>,
    meta: option<pagination-meta>
  }

  record phone-numbers-job {
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// ISO 8601 formatted date indicating when the estimated time of completion of the background job.
    etc: option<string>,
    failed-operations: option<list<phone-numbers-job-failed-operation>>,
    /// Identifies the resource.
    id: option<string>,
    pending-operations: option<list<phone-numbers-job-pending-operation>>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Indicates the completion status of the background update.
    status: option<phone-numbers-job-status-enum>,
    successful-operations: option<list<phone-numbers-job-successful-operation>>,
    /// Identifies the type of the background job.
    type-op: option<list-phone-numbers-jobs-filter-type-enum>,
    /// ISO 8601 formatted date indicating when the resource was updated.
    updated-at: option<string>
  }

  record phone-numbers-job-failed-operation {
    errors: option<list<error>>,
    /// The phone number's ID
    id: option<string>,
    /// The phone number in e164 format.
    phone-number: option<string>
  }

  record error {
    code: string,
    detail: option<string>,
    meta: option<error-meta>,
    source: option<error-source>,
    title: string
  }

  record error-meta {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record error-source {
    /// Indicates which query parameter caused the error.
    parameter: option<string>,
    /// JSON pointer (RFC6901) to the offending entity.
    pointer: option<string>
  }

  record phone-numbers-job-pending-operation {
    /// The phone number's ID
    id: option<string>,
    /// The phone number in e164 format.
    phone-number: option<string>
  }

  record phone-numbers-job-successful-operation {
    /// The phone number's ID
    id: option<string>,
    /// The phone number in e164 format.
    phone-number: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-phone-numbers-job-delete-phone-numbers-response {
    data: option<phone-numbers-job>
  }

  record create-phone-numbers-job-update-emergency-settings-response {
    data: option<phone-numbers-job>
  }

  record create-phone-numbers-job-update-phone-number-response {
    data: option<phone-numbers-job>
  }

  record retrieve-phone-numbers-job-response {
    data: option<phone-numbers-job>
  }

  /// Lists the phone numbers jobs
  record list-phone-numbers-jobs-params {
    /// Filter the phone number jobs by type.
    filter-type: option<list-phone-numbers-jobs-filter-type-enum>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Specifies the sort order for results. If not given, results are sorted by created_at in descending order.
    sort: option<list-phone-numbers-jobs-sort-enum>
  }
  list-phone-numbers-jobs: func(params: list-phone-numbers-jobs-params) -> result<list-phone-numbers-jobs-response, string>;

  /// Delete a batch of numbers
  record create-phone-numbers-job-delete-phone-numbers-params {
    phone-numbers: list<string>
  }
  create-phone-numbers-job-delete-phone-numbers: func(params: create-phone-numbers-job-delete-phone-numbers-params) -> result<create-phone-numbers-job-delete-phone-numbers-response, string>;

  /// Update the emergency settings from a batch of numbers
  record create-phone-numbers-job-update-emergency-settings-params {
    /// Identifies the address to be used with emergency services.
    emergency-address-id: string,
    /// Indicates whether to enable emergency services on this number.
    emergency-enabled: bool,
    phone-numbers: list<string>
  }
  create-phone-numbers-job-update-emergency-settings: func(params: create-phone-numbers-job-update-emergency-settings-params) -> result<create-phone-numbers-job-update-emergency-settings-response, string>;

  /// Update a batch of numbers
  record create-phone-numbers-job-update-phone-number-params {
    /// Identifies the billing group associated with the phone number.
    billing-group-id: option<string>,
    /// Identifies the connection associated with the phone number.
    connection-id: option<string>,
    /// A customer reference string for customer look ups.
    customer-reference: option<string>,
    /// If someone attempts to port your phone number away from Telnyx and your phone number has an external PIN set, we will attempt to verify that you provided the correct external PIN to the winning carrier. Note that not all carriers cooperate with this security mechanism.
    external-pin: option<string>,
    /// Array of phone number ids and/or phone numbers in E164 format to update
    phone-numbers: list<string>,
    /// A list of user-assigned tags to help organize phone numbers.
    tags: option<list<string>>
  }
  create-phone-numbers-job-update-phone-number: func(params: create-phone-numbers-job-update-phone-number-params) -> result<create-phone-numbers-job-update-phone-number-response, string>;

  /// Retrieve a phone numbers job
  record retrieve-phone-numbers-job-params {
    /// Identifies the Phone Numbers Job.
    id: string
  }
  retrieve-phone-numbers-job: func(params: retrieve-phone-numbers-job-params) -> result<retrieve-phone-numbers-job-response, string>;

}

interface phone-number-porting {
  record post-portability-check-response {
    data: option<list<portability-check-details>>
  }

  record portability-check-details {
    /// Indicates whether this phone number is FastPort eligible
    fast-portable: option<bool>,
    /// If this phone number is not portable, explains why. Empty string if the number is portable.
    not-portable-reason: option<string>,
    /// The +E.164 formatted phone number this result is about
    phone-number: option<string>,
    /// Indicates whether this phone number is portable
    portable: option<bool>,
    /// Identifies the type of the resource.
    record-type: option<string>
  }

  variant post-portability-check-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  /// Run a portability check
  record post-portability-check-params {
    /// The list of +E.164 formatted phone numbers to check for portability
    phone-numbers: option<list<string>>
  }
  post-portability-check: func(params: post-portability-check-params) -> result<post-portability-check-response, post-portability-check-error>;

}

interface porting-order {
  enum list-porting-orders-sort-enum {
    created-at,
    created-at-v2,
    activation-settings-foc-datetime-requested,
    activation-settings-foc-datetime-requested-v2,
  }

  enum requirement-field-type-enum {
    document,
  }

  enum porting-orders-exception-type-code-enum {
    account-number-mismatch,
    auth-person-mismatch,
    btn-atn-mismatch,
    entity-name-mismatch,
    foc-expired,
    foc-rejected,
    location-mismatch,
    lsr-pending,
    main-btn-porting,
    osp-irresponsive,
    other,
    passcode-pin-invalid,
    phone-number-has-special-feature,
    phone-number-mismatch,
    phone-number-not-portable,
    port-type-incorrect,
    porting-order-split-required,
    porting-order-split-required-v2,
    postal-code-mismatch,
    rate-center-not-portable,
    sv-conflict,
    sv-unknown-failure,
  }

  enum status-value-enum {
    draft,
    in-process,
    submitted,
    exception,
    foc-date-confirmed,
    ported,
    canceled,
    cancel-pending,
  }

  enum porting-orders-activation-job-status-enum {
    created,
    in-process,
    completed,
    failed,
  }

  enum porting-orders-comment-user-type-enum {
    admin,
    user,
    system,
  }

  enum phone-number-regulatory-requirement-field-type-enum {
    textual,
    datetime,
    address,
    document,
  }

  enum phone-number-status-enum {
    pending,
    success,
    failure,
  }

  /// A port can be either 'full' or 'partial'. When type is 'full' the other attributes should be omitted.
  record type-op {
    /// opaque schema; raw JSON
    value: string
  }

  record list-porting-orders-response {
    data: option<list<porting-order>>,
    meta: option<pagination-meta>
  }

  record porting-order {
    activation-settings: option<activation-settings>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    end-user: option<porting-end-user>,
    /// Uniquely identifies this porting order
    id: option<string>,
    misc: option<misc>,
    /// Identifies the old service provider
    old-service-provider-ocn: option<string>,
    phone-number-configuration: option<phone-number-configuration>,
    /// Count of phone numbers associated with this porting order
    porting-phone-numbers-count: option<s32>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// List of documentation requirements for porting numbers.
    requirements: option<list<requirement>>,
    status: option<status>,
    /// A key to reference this porting order when contacting Telnyx customer support
    support-key: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    updated-at: option<string>,
    user-feedback: option<user-feedback>,
    /// A customer-specified reference number for customer bookkeeping purposes
    user-reference: option<string>,
    webhook-url: option<string>
  }

  record activation-settings {
    activation-status: option<activation-status>,
    /// Indicates whether this porting order is eligible for FastPort
    fast-port-eligible: option<bool>,
    /// ISO 8601 formatted Date/Time of the FOC date
    foc-datetime-actual: option<string>,
    /// ISO 8601 formatted Date/Time requested for the FOC date
    foc-datetime-requested: option<string>
  }

  /// Activation status
  record activation-status {
    /// opaque schema; raw JSON
    value: string
  }

  record porting-end-user {
    admin: option<end-user-admin>,
    location: option<end-user-location>
  }

  record end-user-admin {
    /// The authorized person's account number with the current service provider
    account-number: option<string>,
    /// Name of person authorizing the porting order
    auth-person-name: option<string>,
    /// Billing phone number associated with these phone numbers
    billing-phone-number: option<string>,
    /// European business identification number. Applicable only in the European Union
    business-identifier: option<string>,
    /// Person Name or Company name requesting the port
    entity-name: option<string>,
    /// PIN/passcode possibly required by the old service provider for extra verification
    pin-passcode: option<string>,
    /// European tax identification number. Applicable only in the European Union
    tax-identifier: option<string>
  }

  record end-user-location {
    /// State, province, or similar of billing address
    administrative-area: option<string>,
    /// ISO3166-1 alpha-2 country code of billing address
    country-code: option<string>,
    /// Second line of billing address
    extended-address: option<string>,
    /// City or municipality of billing address
    locality: option<string>,
    /// Postal Code of billing address
    postal-code: option<string>,
    /// First line of billing address
    street-address: option<string>
  }

  record misc {
    /// New billing phone number for the remaining numbers. Used in case the current billing phone number is being ported to Telnyx. This will be set on your account with your current service provider and should be one of the numbers remaining on that account.
    new-billing-phone-number: option<string>,
    remaining-numbers-action: option<remaining-numbers-action>,
    type-op: option<type-op>
  }

  /// Remaining numbers can be either kept with their current service provider or disconnected. 'new_billing_telephone_number' is required when 'remaining_numbers_action' is 'keep'.
  record remaining-numbers-action {
    /// opaque schema; raw JSON
    value: string
  }

  record phone-number-configuration {
    /// identifies the connection to set on the numbers when ported
    connection-id: option<string>,
    /// identifies the emergency address to set on the numbers when ported
    emergency-address-id: option<string>,
    /// identifies the messaging profile to set on the numbers when ported
    messaging-profile-id: option<string>,
    tags: option<list<string>>
  }

  record requirement {
    /// Type of value expected on field_value field
    field-type: option<requirement-field-type-enum>,
    /// identifies the document that satisfies this requirement
    field-value: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Identifies the requirement type that meets this requirement
    requirement-type-id: option<string>
  }

  /// Porting order status
  record status {
    /// A list of 0 or more details about this porting order's status
    details: option<list<porting-orders-exception-type>>,
    /// The current status of the porting order
    value: option<status-value-enum>
  }

  record porting-orders-exception-type {
    /// Identifier of an exception type
    code: option<porting-orders-exception-type-code-enum>,
    /// Description of an exception type
    description: option<string>
  }

  record user-feedback {
    /// A comment related to the customer rating.
    user-comment: option<string>,
    /// Once an order is ported, cancellation is requested or the request is canceled, the user may rate their experience
    user-rating: option<s32>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-porting-order-v2-response {
    data: option<list<porting-order>>
  }

  record list-porting-orders-exception-types-response {
    data: option<list<porting-orders-exception-type>>
  }

  record get-porting-order-response {
    data: option<porting-order>,
    meta: option<get-porting-order-response-meta>
  }

  record get-porting-order-response-meta {
    /// Link to list all phone numbers
    phone-numbers-url: option<string>
  }

  record update-porting-order-activation-settings {
    /// ISO 8601 formatted Date/Time requested for the FOC date
    foc-datetime-requested: option<string>
  }

  record update-porting-order-requirement {
    /// identifies the document that satisfies this requirement
    field-value: string,
    /// Identifies the requirement type that meets this requirement
    requirement-type-id: string
  }

  record update-porting-order-v2-response {
    data: option<porting-order>,
    meta: option<update-porting-order-v2-response-meta>
  }

  record update-porting-order-v2-response-meta {
    /// Link to list all phone numbers
    phone-numbers-url: option<string>
  }

  record delete-porting-order-response {
    data: option<porting-order>,
    meta: option<delete-porting-order-response-meta>
  }

  record delete-porting-order-response-meta {
    /// Link to list all phone numbers
    phone-numbers-url: option<string>
  }

  record activate-porting-order-response {
    data: option<porting-orders-activation-job>
  }

  record porting-orders-activation-job {
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    /// Uniquely identifies this activation job
    id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Specifies the status of this activation job
    status: option<porting-orders-activation-job-status-enum>,
    /// ISO 8601 formatted date indicating when the resource was created.
    updated-at: option<string>
  }

  record cancel-porting-order-response {
    data: option<porting-order>,
    meta: option<cancel-porting-order-response-meta>
  }

  record cancel-porting-order-response-meta {
    /// Link to list all phone numbers
    phone-numbers-url: option<string>
  }

  record confirm-porting-order-response {
    data: option<porting-order>,
    meta: option<confirm-porting-order-response-meta>
  }

  record confirm-porting-order-response-meta {
    /// Link to list all phone numbers
    phone-numbers-url: option<string>
  }

  record list-porting-orders-activation-jobs-response {
    data: option<list<porting-orders-activation-job>>,
    meta: option<pagination-meta>
  }

  record get-porting-orders-activation-job-response {
    data: option<porting-orders-activation-job>
  }

  record list-porting-orders-comments-response {
    data: option<list<porting-orders-comment>>,
    meta: option<pagination-meta>
  }

  record porting-orders-comment {
    /// Body of comment
    body: option<string>,
    /// ISO 8601 formatted date indicating when the resource was created.
    created-at: option<string>,
    id: option<string>,
    porting-order-id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Indicates whether this comment was created by a Telnyx Admin, user, or system
    user-type: option<porting-orders-comment-user-type-enum>
  }

  record create-porting-order-comment-v2-response {
    data: option<porting-orders-comment>
  }

  /// Specifies whether Telnyx is able to confirm portability this number in the United States & Canada. International phone numbers are provisional by default.
  record portability-status {
    /// opaque schema; raw JSON
    value: string
  }

  record get-porting-phone-numbers-response {
    data: option<list<phone-number>>,
    meta: option<pagination-meta>
  }

  record phone-number {
    id: option<string>,
    phone-number: option<string>,
    record-type: option<string>,
    regulatory-group-id: option<string>,
    regulatory-requirements: option<list<phone-number-regulatory-requirement>>,
    /// True if all requirements are met for a phone number, false otherwise.
    requirements-met: option<bool>,
    /// The status of the phone number in the order.
    status: option<phone-number-status-enum>
  }

  record phone-number-regulatory-requirement {
    field-type: option<phone-number-regulatory-requirement-field-type-enum>,
    record-type: option<string>,
    /// Unique id for a requirement.
    requirement-id: option<string>,
    /// The value of the requirement, this could be an id to a resource or a string value.
    field-value: option<string>
  }

  variant list-porting-orders-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-porting-order-v2-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-porting-orders-exception-types-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-porting-order-error {
    unauthorized(string),
    other(string)
  }

  variant update-porting-order-v2-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-porting-order-error {
    unauthorized(string),
    other(string)
  }

  variant activate-porting-order-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant cancel-porting-order-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant confirm-porting-order-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-porting-orders-activation-jobs-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-porting-orders-activation-job-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-porting-orders-comments-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-porting-order-comment-v2-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-porting-order-loa-template-error {
    unauthorized(string),
    other(string)
  }

  variant get-porting-phone-numbers-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List all porting orders
  record list-porting-orders-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Include the first 50 phone number objects in the results
    include-phone-numbers: option<bool>,
    /// Filter results by status
    filter-status: option<string>,
    /// Filter results by user reference
    filter-customer-reference: option<string>,
    /// Filter results by country ISO 3166-1 alpha-2 code
    filter-phone-numbers-country-code: option<string>,
    /// Filter results by old service provider
    filter-phone-numbers-carrier-name: option<string>,
    /// Filter results by porting order type
    filter-misc-type: option<type-op>,
    /// Filter results by person or company name
    filter-end-user-admin-entity-name: option<string>,
    /// Filter results by authorized person
    filter-end-user-admin-auth-person-name: option<string>,
    /// Filter results by fast port eligible
    filter-activation-settings-fast-port-eligible: option<bool>,
    /// Filter results by foc date later than this value
    filter-activation-settings-foc-datetime-requested-gt: option<string>,
    /// Filter results by foc date earlier than this value
    filter-activation-settings-foc-datetime-requested-lt: option<string>,
    /// Specifies the sort order for results. If not given, results are sorted by created_at in descending order.
    sort: option<list-porting-orders-sort-enum>
  }
  list-porting-orders: func(params: list-porting-orders-params) -> result<list-porting-orders-response, list-porting-orders-error>;

  /// Create a porting order
  record create-porting-order-v2-params {
    /// The list of +E.164 formatted phone numbers
    phone-numbers: list<string>
  }
  create-porting-order-v2: func(params: create-porting-order-v2-params) -> result<create-porting-order-v2-response, create-porting-order-v2-error>;

  /// List all exception types
  list-porting-orders-exception-types: func() -> result<list-porting-orders-exception-types-response, list-porting-orders-exception-types-error>;

  /// Retrieve a porting order
  record get-porting-order-params {
    /// Porting Order id
    id: string,
    /// Include the first 50 phone number objects in the results
    include-phone-numbers: option<bool>
  }
  get-porting-order: func(params: get-porting-order-params) -> result<get-porting-order-response, get-porting-order-error>;

  /// Edit a porting order
  record update-porting-order-v2-params {
    /// Porting Order id
    id: string,
    activation-settings: option<update-porting-order-activation-settings>,
    customer-reference: option<string>,
    end-user: option<porting-end-user>,
    misc: option<misc>,
    phone-number-configuration: option<phone-number-configuration>,
    /// List of requirements for porting numbers.
    requirements: option<list<update-porting-order-requirement>>,
    user-feedback: option<user-feedback>,
    webhook-url: option<string>
  }
  update-porting-order-v2: func(params: update-porting-order-v2-params) -> result<update-porting-order-v2-response, update-porting-order-v2-error>;

  /// Request cancellation
  record delete-porting-order-params {
    /// Porting Order id
    id: string
  }
  delete-porting-order: func(params: delete-porting-order-params) -> result<delete-porting-order-response, delete-porting-order-error>;

  /// Activates every number on a porting order.
  record activate-porting-order-params {
    /// Porting Order id
    id: string
  }
  activate-porting-order: func(params: activate-porting-order-params) -> result<activate-porting-order-response, activate-porting-order-error>;

  /// Cancel this porting order
  record cancel-porting-order-params {
    /// Porting Order id
    id: string
  }
  cancel-porting-order: func(params: cancel-porting-order-params) -> result<cancel-porting-order-response, cancel-porting-order-error>;

  /// Confirms the porting order is ready to be actioned.
  record confirm-porting-order-params {
    /// Porting Order id
    id: string
  }
  confirm-porting-order: func(params: confirm-porting-order-params) -> result<confirm-porting-order-response, confirm-porting-order-error>;

  /// List all porting activation jobs
  record list-porting-orders-activation-jobs-params {
    /// Porting Order id
    id: string,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-porting-orders-activation-jobs: func(params: list-porting-orders-activation-jobs-params) -> result<list-porting-orders-activation-jobs-response, list-porting-orders-activation-jobs-error>;

  /// Retrieve a porting activation job
  record get-porting-orders-activation-job-params {
    /// Porting Order id
    id: string,
    /// Activation Job Identifier
    activation-job-id: string
  }
  get-porting-orders-activation-job: func(params: get-porting-orders-activation-job-params) -> result<get-porting-orders-activation-job-response, get-porting-orders-activation-job-error>;

  /// List all comments of a porting order
  record list-porting-orders-comments-params {
    /// Porting Order id
    id: string,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-porting-orders-comments: func(params: list-porting-orders-comments-params) -> result<list-porting-orders-comments-response, list-porting-orders-comments-error>;

  /// Create a comment for a porting order
  record create-porting-order-comment-v2-params {
    /// Porting Order id
    id: string,
    body: option<string>
  }
  create-porting-order-comment-v2: func(params: create-porting-order-comment-v2-params) -> result<create-porting-order-comment-v2-response, create-porting-order-comment-v2-error>;

  /// Download a porting order loa template
  record get-porting-order-loa-template-params {
    /// Porting Order id
    id: string
  }
  get-porting-order-loa-template: func(params: get-porting-order-loa-template-params) -> result<string, get-porting-order-loa-template-error>;

  /// List all porting phone numbers
  record get-porting-phone-numbers-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// Filter results by porting order id
    filter-porting-order-id: option<string>,
    /// Filter results by phone number
    filter-phone-number: option<string>,
    /// Filter results by activation status
    filter-activation-status: option<activation-status>,
    /// Filter results by portability status
    filter-portability-status: option<portability-status>
  }
  get-porting-phone-numbers: func(params: get-porting-phone-numbers-params) -> result<get-porting-phone-numbers-response, get-porting-phone-numbers-error>;

}

interface number-portout {
  enum list-portout-request-filter-status-enum {
    pending,
    authorized,
    ported,
    rejected,
    rejected-pending,
    canceled,
  }

  record list-portout-request-response {
    data: option<list<portout-details>>,
    meta: option<metadata>
  }

  record portout-details {
    /// Carrier the number will be ported out to
    carrier-name: option<string>,
    /// ISO 8601 formatted date of when the portout was created
    created-at: option<string>,
    /// ISO 8601 formatted Date/Time of the FOC date
    foc-date: option<string>,
    id: option<string>,
    /// Phone numbers associated with this portout
    phone-numbers: option<list<string>>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// ISO 8601 formatted Date/Time of the user requested FOC date
    requested-foc-date: option<string>,
    /// New service provider spid
    spid: option<string>,
    /// Status of portout request
    status: option<list-portout-request-filter-status-enum>,
    /// ISO 8601 formatted date of when the portout was last updated
    updated-at: option<string>
  }

  record metadata {
    /// Current Page based on pagination settings (included when defaults are used.)
    page-number: option<f64>,
    /// Number of results to return per page based on pagination settings (included when defaults are used.)
    page-size: option<f64>,
    /// Total number of pages based on pagination settings
    total-pages: option<f64>,
    /// Total number of results
    total-results: option<f64>
  }

  record find-portout-request-response {
    data: option<portout-details>
  }

  record find-portout-comments-response {
    data: option<list<portout-comment>>,
    meta: option<metadata>
  }

  record portout-comment {
    /// Comment body
    body: string,
    /// Comment creation timestamp in ISO 8601 format
    created-at: string,
    id: string,
    /// Identifies the associated port request
    portout-id: option<string>,
    /// Identifies the type of the resource.
    record-type: option<string>,
    /// Identifies the user who created the comment. Will be null if created by Telnyx Admin
    user-id: string
  }

  record post-port-request-comment-response {
    data: option<portout-comment>
  }

  record update-portout-request-response {
    data: option<portout-details>
  }

  variant list-portout-request-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant find-portout-request-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant find-portout-comments-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant post-port-request-comment-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-portout-request-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// Retrieve a list of portout requests
  record list-portout-request-params {
    /// Filter by new carrier name.
    filter-carrier-name: option<string>,
    /// Filter by new carrier spid.
    filter-spid: option<string>,
    /// Filter by portout status.
    filter-status: option<list-portout-request-filter-status-enum>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-portout-request: func(params: list-portout-request-params) -> result<list-portout-request-response, list-portout-request-error>;

  /// Retrieve a portout request
  record find-portout-request-params {
    /// Portout id
    id: string
  }
  find-portout-request: func(params: find-portout-request-params) -> result<find-portout-request-response, find-portout-request-error>;

  /// List all comments for a portout request
  record find-portout-comments-params {
    /// Portout id
    id: string
  }
  find-portout-comments: func(params: find-portout-comments-params) -> result<find-portout-comments-response, find-portout-comments-error>;

  /// Create a comment on a portout request
  record post-port-request-comment-params {
    /// Portout id
    id: string,
    /// Comment to post on this portout request
    body: option<string>
  }
  post-port-request-comment: func(params: post-port-request-comment-params) -> result<post-port-request-comment-response, post-port-request-comment-error>;

  /// Update Status
  record update-portout-request-params {
    /// Portout id
    id: string,
    /// Updated portout status
    status: string
  }
  update-portout-request: func(params: update-portout-request-params) -> result<update-portout-request-response, update-portout-request-error>;

}

interface private-wireless-gateways {
  enum private-wireless-gateway-status-value-enum {
    provisioning,
    provisioned,
    failed,
    decommissioning,
  }

  record get-private-wireless-gateways-response {
    data: option<list<private-wireless-gateway>>,
    meta: option<pagination-meta>
  }

  record private-wireless-gateway {
    /// ISO 8601 formatted date-time indicating when the resource was created.
    created-at: option<string>,
    /// Identifies the resource.
    id: option<string>,
    /// IP block used to assign IPs to the SIM cards in the Private Wireless Gateway.
    ip-range: option<string>,
    /// The private wireless gateway name.
    name: option<string>,
    /// The identification of the related network resource.
    network-id: option<string>,
    record-type: option<string>,
    /// The geographical region where the Private Wireless Gateway is deployed to.
    region-code: option<string>,
    status: option<private-wireless-gateway-status>,
    /// ISO 8601 formatted date-time indicating when the resource was updated.
    updated-at: option<string>
  }

  /// The current status or failure details of the Private Wireless Gateway.
  record private-wireless-gateway-status {
    /// This attribute is an <a href="https://developers.telnyx.com/docs/api/v2/overview#errors">error code</a> related to the failure reason.
    error-code: option<string>,
    /// This attribute provides a human-readable explanation of why a failure happened.
    error-description: option<string>,
    /// The current status or failure details of the Private Wireless Gateway. <ul>
    ///  <li><code>provisioning</code> - the Private Wireless Gateway is being provisioned.</li>
    value: option<private-wireless-gateway-status-value-enum>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record create-private-wireless-gateway-response {
    data: option<private-wireless-gateway>
  }

  record get-private-wireless-gateway-response {
    data: option<private-wireless-gateway>
  }

  record delete-private-wireless-gateway-response {
    data: option<private-wireless-gateway>
  }

  variant create-private-wireless-gateway-error {
    unprocessable-entity(string),
    other(string)
  }

  variant get-private-wireless-gateway-error {
    not-found(string),
    other(string)
  }

  variant delete-private-wireless-gateway-error {
    not-found(string),
    other(string)
  }

  /// Get all Private Wireless Gateways
  record get-private-wireless-gateways-params {
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>,
    /// The name of the Private Wireless Gateway.
    filter-name: option<string>,
    /// The IP address range of the Private Wireless Gateway.
    filter-ip-range: option<string>,
    /// The name of the region where the Private Wireless Gateway is deployed.
    filter-region-code: option<string>,
    /// Private Wireless Gateway resource creation date.
    filter-created-at: option<string>,
    /// When the Private Wireless Gateway was last updated.
    filter-updated-at: option<string>
  }
  get-private-wireless-gateways: func(params: get-private-wireless-gateways-params) -> result<get-private-wireless-gateways-response, string>;

  /// Create a Private Wireless Gateway
  record create-private-wireless-gateway-params {
    /// The private wireless gateway name.
    name: string,
    /// The identification of the related network resource.
    network-id: string
  }
  create-private-wireless-gateway: func(params: create-private-wireless-gateway-params) -> result<create-private-wireless-gateway-response, create-private-wireless-gateway-error>;

  /// Get a Private Wireless Gateway
  record get-private-wireless-gateway-params {
    /// Identifies the resource.
    id: string
  }
  get-private-wireless-gateway: func(params: get-private-wireless-gateway-params) -> result<get-private-wireless-gateway-response, get-private-wireless-gateway-error>;

  /// Delete a Private Wireless Gateway
  record delete-private-wireless-gateway-params {
    /// Identifies the resource.
    id: string
  }
  delete-private-wireless-gateway: func(params: delete-private-wireless-gateway-params) -> result<delete-private-wireless-gateway-response, delete-private-wireless-gateway-error>;

}

interface queue-commands {
  enum queue-record-type-enum {
    queue,
  }

  enum queue-call-record-type-enum {
    queue-call,
  }

  record retrieve-call-queue-response {
    data: option<queue>
  }

  record queue {
    /// The average time that the calls currently in the queue have spent waiting, given in seconds.
    average-wait-time-secs: s32,
    /// ISO 8601 formatted date of when the queue was created
    created-at: string,
    /// The number of calls currently in the queue
    current-size: s32,
    /// Uniquely identifies the queue
    id: string,
    /// The maximum number of calls allowed in the queue
    max-size: s32,
    /// Name of the queue
    name: string,
    record-type: queue-record-type-enum,
    /// ISO 8601 formatted date of when the queue was last updated
    updated-at: string
  }

  record list-queue-calls-response {
    data: option<list<queue-call>>,
    meta: option<pagination-meta>
  }

  record queue-call {
    /// Unique identifier and token for controlling the call.
    call-control-id: string,
    /// ID that is unique to the call and can be used to correlate webhook events
    call-leg-id: string,
    /// ID that is unique to the call session and can be used to correlate webhook events
    call-session-id: string,
    /// Telnyx connection ID used in the call.
    connection-id: string,
    /// ISO 8601 formatted date of when the call was put in the queue
    enqueued-at: string,
    /// Number or SIP URI placing the call.
    from-op: string,
    /// Unique identifier of the queue the call is in.
    queue-id: string,
    /// Current position of the call in the queue
    queue-position: s32,
    record-type: queue-call-record-type-enum,
    /// Destination number or SIP URI of the call.
    to: string,
    /// The time the call has been waiting in the queue, given in seconds
    wait-time-secs: s32
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record retrieve-call-from-queue-response {
    data: option<queue-call>
  }

  variant retrieve-call-queue-error {
    not-found(string),
    other(string)
  }

  variant list-queue-calls-error {
    not-found(string),
    other(string)
  }

  variant retrieve-call-from-queue-error {
    not-found(string),
    other(string)
  }

  /// Retrieve a call queue
  record retrieve-call-queue-params {
    /// Uniquely identifies the queue by name
    queue-name: string
  }
  retrieve-call-queue: func(params: retrieve-call-queue-params) -> result<retrieve-call-queue-response, retrieve-call-queue-error>;

  /// Retrieve calls from a queue
  record list-queue-calls-params {
    /// Uniquely identifies the queue by name
    queue-name: string,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-queue-calls: func(params: list-queue-calls-params) -> result<list-queue-calls-response, list-queue-calls-error>;

  /// Retrieve a call from a queue
  record retrieve-call-from-queue-params {
    /// Uniquely identifies the queue by name
    queue-name: string,
    /// Unique identifier and token for controlling the call
    call-control-id: string
  }
  retrieve-call-from-queue: func(params: retrieve-call-from-queue-params) -> result<retrieve-call-from-queue-response, retrieve-call-from-queue-error>;

}

interface recordings-commands {
  enum recording-channels-enum {
    single,
    dual,
  }

  enum recording-record-type-enum {
    recording,
  }

  enum recording-source-enum {
    conference,
    call,
  }

  enum recording-status-enum {
    completed,
  }

  record list-recordings-response {
    data: option<list<recording>>,
    meta: option<pagination-meta>
  }

  record recording {
    /// If a call recording, uniquely identifies the recorded call leg
    call-leg-id: option<string>,
    /// If a call recording, uniquely identifies the recorded call session
    call-session-id: option<string>,
    /// When `dual`, final audio file has the first leg on channel A, and the rest on channel B.
    channels: recording-channels-enum,
    /// If a conference recording, uniquely identifies the recorded conference
    conference-id: option<string>,
    /// ISO 8601 formatted date of when the recording was created
    created-at: string,
    /// The links to download the recording files
    download-urls: recording-download-urls,
    /// The duration of the recording in milliseconds
    duration-millis: s32,
    /// Uniquely identifies the recording
    id: string,
    record-type: recording-record-type-enum,
    /// ISO 8601 formatted date of when the recording ended
    recording-ended-at: string,
    /// ISO 8601 formatted date of when the recording started
    recording-started-at: string,
    /// The kind of event that led to this recording being created
    source: recording-source-enum,
    /// The status of the recording. Only resources for `completed` recordings are currently supported
    status: recording-status-enum,
    /// ISO 8601 formatted date of when the recording was last updated
    updated-at: string
  }

  /// The links to download the recording files
  record recording-download-urls {
    /// Link to download the recording in mp3 format
    mp3: option<string>,
    /// Link to download the recording in wav format
    wav: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record retrieve-recording-response {
    data: option<recording>
  }

  variant list-recordings-error {
    unauthorized(string),
    unprocessable-entity(string),
    other(string)
  }

  variant retrieve-recording-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// List recordings
  record list-recordings-params {
    /// Return only recordings associated with a given conference
    filter-conference-id: option<string>,
    /// Return only recordings created later than or at given ISO 8601 datetime
    filter-created-at-gte: option<string>,
    /// Return only recordings created earlier than or at given ISO 8601 datetime
    filter-created-at-lte: option<string>,
    /// The page number to load.
    page-number: option<s32>,
    /// The size of the page.
    page-size: option<s32>
  }
  list-recordings: func(params: list-recordings-params) -> result<list-recordings-response, list-recordings-error>;

  /// Retrieve a recording
  record retrieve-recording-params {
    /// Uniquely identifies the recording
    id: string
  }
  retrieve-recording: func(params: retrieve-recording-params) -> result<retrieve-recording-response, retrieve-recording-error>;

}

interface mdr-detail-reports {
  enum mdr-detail-report-response-directions-item-enum {
    inbound,
    outbound,
  }

  enum filter-cld-filter-enum {
    contains,
    starts-with,
    ends-with,
  }

  enum filter-filter-type-enum {
    and,
    or,
  }

  enum mdr-detail-report-response-record-types-item-enum {
    incomplete,
    completed,
    errors,
  }

  enum mdr-detail-report-response-status-enum {
    pending,
    complete,
    failed,
    expired,
  }

  enum get-reports-mdrs-status-enum {
    gw-timeout,
    delivered,
    dlr-unconfirmed,
    dlr-timeout,
    received,
    gw-reject,
    failed,
  }

  enum get-reports-mdrs-message-type-enum {
    sms,
    mms,
  }

  enum mdr-detail-response-currency-enum {
    aud,
    cad,
    eur,
    gbp,
    usd,
  }

  record mdr-get-detail-report-response {
    data: option<list<mdr-detail-report-response>>,
    meta: option<pagination-meta>
  }

  record mdr-detail-report-response {
    connections: option<list<s64>>,
    created-at: option<string>,
    directions: option<list<mdr-detail-report-response-directions-item-enum>>,
    end-date: option<string>,
    filters: option<list<filter>>,
    /// Identifies the resource
    id: option<string>,
    profiles: option<string>,
    record-type: option<string>,
    record-types: option<list<mdr-detail-report-response-record-types-item-enum>>,
    report-name: option<string>,
    report-url: option<string>,
    start-date: option<string>,
    status: option<mdr-detail-report-response-status-enum>,
    updated-at: option<string>
  }

  record filter {
    billing-group: option<string>,
    cld: option<string>,
    cld-filter: option<filter-cld-filter-enum>,
    cli: option<string>,
    cli-filter: option<filter-cld-filter-enum>,
    filter-type: option<filter-filter-type-enum>,
    tags-list: option<string>
  }

  record pagination-meta {
    page-number: option<s32>,
    page-size: option<s32>,
    total-pages: option<s32>,
    total-results: option<s32>
  }

  record mdr-post-detail-report-response {
    data: option<mdr-detail-report-response>
  }

  record mdr-get-detail-report-by-id-response {
    data: option<mdr-detail-report-response>
  }

  record mdr-delete-detail-report-response {
    data: option<mdr-detail-report-response>
  }

  record mdr-get-detail-response {
    data: option<list<mdr-detail-response>>,
    meta: option<pagination-meta>
  }

  record mdr-detail-response {
    /// The destination number for a call, or the callee
    cld: option<string>,
    /// The number associated with the person initiating the call, or the caller
    cli: option<string>,
    /// Final cost. Cost is calculated as rate * parts
    cost: option<string>,
    /// Message sent time
    created-at: option<string>,
    /// Currency of the rate and cost
    currency: option<mdr-detail-response-currency-enum>,
    /// Direction of message - inbound or outbound.
    direction: option<string>,
    /// Id of message detail record
    id: option<string>,
    /// Type of message
    message-type: option<get-reports-mdrs-message-type-enum>,
    /// Number of parts this message has. Max number of character is 160. If message contains more characters then that it will be broken down in multiple parts
    parts: option<f64>,
    /// Configured profile name. New profiles can be created and configured on Telnyx portal
    profile-name: option<string>,
    /// Rate applied to the message
    rate: option<string>,
    record-type: option<string>,
    /// Message status
    status: option<get-reports-mdrs-status-enum>
  }

  record get-cdr-requests-params {
    /// Page number
    page-number: option<s32>,
    /// Size of the page
    page-size: option<s32>
  }
  get-cdr-requests: func(params: get-cdr-requests-params) -> result<mdr-get-detail-report-response, string>;

