    country-code,
    locality,
    phone-number-type,
  }

  enum doc-reqs-requirement-action-enum {
    both,
    ordering,
    porting,
  }

  enum doc-reqs-requirement-type-type-op-enum {
    document,
    address,
    textual,
  }

  record list-requirements-response {
    data: option<doc-reqs-requirement-list>,
