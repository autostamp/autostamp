package wilted:svix@0.1.0;

interface application {
  record application-in-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record application-in-metadata-2 {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List Applications
  record list-applications-api-v1-app-get-params {
    iterator: option<string>,
    limit: option<s32>,
    order: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-applications-api-v1-app-get: func(params: list-applications-api-v1-app-get-params) -> result<string, string>;

  /// Create Application
  record create-application-api-v1-app-post-params {
    /// Get an existing application, or create a new one if doesn't exist. It's two separate functions in the libs.
    get-if-exists: option<bool>,
    /// The request's idempotency key
    idempotency-key: option<string>,
    metadata: option<application-in-metadata>,
    name: string,
    rate-limit: option<s32>,
    /// Optional unique identifier for the application
    uid: option<string>
  }
  create-application-api-v1-app-post: func(params: create-application-api-v1-app-post-params) -> result<string, string>;

  /// Get Application
  record get-application-api-v1-app-app-id-get-params {
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  get-application-api-v1-app-app-id-get: func(params: get-application-api-v1-app-app-id-get-params) -> result<string, string>;

  /// Update Application
  record update-application-api-v1-app-app-id-put-params {
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    metadata: option<application-in-metadata-2>,
    name: string,
    rate-limit: option<s32>,
    /// Optional unique identifier for the application
    uid: option<string>
  }
  update-application-api-v1-app-app-id-put: func(params: update-application-api-v1-app-app-id-put-params) -> result<string, string>;

  /// Delete Application
  record delete-application-api-v1-app-app-id-delete-params {
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  delete-application-api-v1-app-app-id-delete: func(params: delete-application-api-v1-app-app-id-delete-params) -> result<string, string>;

}


interface message-attempt {
  /// The sending status of the message:
  /// - Success = 0
  /// - Pending = 1
  /// - Fail = 2
  /// - Sending = 3
  record message-status {
    /// opaque schema; raw JSON
    value: string
  }

  /// The different classes of HTTP status codes:
  /// - CodeNone = 0
  /// - Code1xx = 100
  /// - Code2xx = 200
  /// - Code3xx = 300
  /// - Code4xx = 400
  /// - Code5xx = 500
  record status-code-class {
    /// opaque schema; raw JSON
    value: string
  }

  /// List Attempts By Endpoint
  record list-attempts-by-endpoint-api-v1-app-app-id-attempt-endpoint-endpoint-id-get-params {
    app-id: string,
    endpoint-id: string,
    iterator: option<string>,
    limit: option<s32>,
    status: option<message-status>,
    status-code-class: option<status-code-class>,
    event-types: option<list<string>>,
    channel: option<string>,
    before: option<string>,
    after: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-attempts-by-endpoint-api-v1-app-app-id-attempt-endpoint-endpoint-id-get: func(params: list-attempts-by-endpoint-api-v1-app-app-id-attempt-endpoint-endpoint-id-get-params) -> result<string, string>;

  /// List Attempts By Msg
  record list-attempts-by-msg-api-v1-app-app-id-attempt-msg-msg-id-get-params {
    app-id: string,
    msg-id: string,
    endpoint-id: option<string>,
    iterator: option<string>,
    limit: option<s32>,
    status: option<message-status>,
    status-code-class: option<status-code-class>,
    event-types: option<list<string>>,
    channel: option<string>,
    before: option<string>,
    after: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-attempts-by-msg-api-v1-app-app-id-attempt-msg-msg-id-get: func(params: list-attempts-by-msg-api-v1-app-app-id-attempt-msg-msg-id-get-params) -> result<string, string>;

  /// List Attempted Messages
  record list-attempted-messages-api-v1-app-app-id-endpoint-endpoint-id-msg-get-params {
    endpoint-id: string,
    app-id: string,
    iterator: option<string>,
    limit: option<s32>,
    channel: option<string>,
    status: option<message-status>,
    before: option<string>,
    after: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-attempted-messages-api-v1-app-app-id-endpoint-endpoint-id-msg-get: func(params: list-attempted-messages-api-v1-app-app-id-endpoint-endpoint-id-msg-get-params) -> result<string, string>;

  /// List Attempts
  record list-attempts-api-v1-app-app-id-msg-msg-id-attempt-get-params {
    app-id: string,
    msg-id: string,
    iterator: option<string>,
    limit: option<s32>,
    endpoint-id: option<string>,
    event-types: option<list<string>>,
    channel: option<string>,
    status: option<message-status>,
    before: option<string>,
    after: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-attempts-api-v1-app-app-id-msg-msg-id-attempt-get: func(params: list-attempts-api-v1-app-app-id-msg-msg-id-attempt-get-params) -> result<string, string>;

  /// Get Attempt
  record get-attempt-api-v1-app-app-id-msg-msg-id-attempt-attempt-id-get-params {
    attempt-id: string,
    msg-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  get-attempt-api-v1-app-app-id-msg-msg-id-attempt-attempt-id-get: func(params: get-attempt-api-v1-app-app-id-msg-msg-id-attempt-attempt-id-get-params) -> result<string, string>;

  /// Delete attempt response body
  record expunge-attempt-content-api-v1-app-app-id-msg-msg-id-attempt-attempt-id-content-delete-params {
    attempt-id: string,
    msg-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  expunge-attempt-content-api-v1-app-app-id-msg-msg-id-attempt-attempt-id-content-delete: func(params: expunge-attempt-content-api-v1-app-app-id-msg-msg-id-attempt-attempt-id-content-delete-params) -> result<string, string>;

  /// List Attempted Destinations
  record list-attempted-destinations-api-v1-app-app-id-msg-msg-id-endpoint-get-params {
    msg-id: string,
    app-id: string,
    iterator: option<string>,
    limit: option<s32>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-attempted-destinations-api-v1-app-app-id-msg-msg-id-endpoint-get: func(params: list-attempted-destinations-api-v1-app-app-id-msg-msg-id-endpoint-get-params) -> result<string, string>;

  /// List Attempts For Endpoint
  record list-attempts-for-endpoint-api-v1-app-app-id-msg-msg-id-endpoint-endpoint-id-attempt-get-params {
    msg-id: string,
    app-id: string,
    endpoint-id: string,
    iterator: option<string>,
    limit: option<s32>,
    event-types: option<list<string>>,
    channel: option<string>,
    status: option<message-status>,
    before: option<string>,
    after: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-attempts-for-endpoint-api-v1-app-app-id-msg-msg-id-endpoint-endpoint-id-attempt-get: func(params: list-attempts-for-endpoint-api-v1-app-app-id-msg-msg-id-endpoint-endpoint-id-attempt-get-params) -> result<string, string>;

  /// Resend Webhook
  record resend-webhook-api-v1-app-app-id-msg-msg-id-endpoint-endpoint-id-resend-post-params {
    endpoint-id: string,
    msg-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  resend-webhook-api-v1-app-app-id-msg-msg-id-endpoint-endpoint-id-resend-post: func(params: resend-webhook-api-v1-app-app-id-msg-msg-id-endpoint-endpoint-id-resend-post-params) -> result<string, string>;

}

interface endpoint {
  record endpoint-in-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record endpoint-update-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record endpoint-headers-in-headers {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record endpoint-headers-patch-in-headers {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List Endpoints
  record list-endpoints-api-v1-app-app-id-endpoint-get-params {
    app-id: string,
    iterator: option<string>,
    limit: option<s32>,
    order: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-endpoints-api-v1-app-app-id-endpoint-get: func(params: list-endpoints-api-v1-app-app-id-endpoint-get-params) -> result<string, string>;

  /// Create Endpoint
  record create-endpoint-api-v1-app-app-id-endpoint-post-params {
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    /// List of message channels this endpoint listens to (omit for all)
    channels: option<list<string>>,
    description: option<string>,
    disabled: option<bool>,
    filter-types: option<list<string>>,
    metadata: option<endpoint-in-metadata>,
    rate-limit: option<s32>,
    /// The endpoint's verification secret. If `null` is passed, a secret is automatically generated. Format: `base64` encoded random bytes optionally prefixed with `whsec_`. Recommended size: 24.
    secret: option<string>,
    /// Optional unique identifier for the endpoint
    uid: option<string>,
    url: string,
    version: s32
  }
  create-endpoint-api-v1-app-app-id-endpoint-post: func(params: create-endpoint-api-v1-app-app-id-endpoint-post-params) -> result<string, string>;

  /// Get Endpoint
  record get-endpoint-api-v1-app-app-id-endpoint-endpoint-id-get-params {
    endpoint-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  get-endpoint-api-v1-app-app-id-endpoint-endpoint-id-get: func(params: get-endpoint-api-v1-app-app-id-endpoint-endpoint-id-get-params) -> result<string, string>;

  /// Update Endpoint
  record update-endpoint-api-v1-app-app-id-endpoint-endpoint-id-put-params {
    endpoint-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    /// List of message channels this endpoint listens to (omit for all)
    channels: option<list<string>>,
    description: option<string>,
    disabled: option<bool>,
    filter-types: option<list<string>>,
    metadata: option<endpoint-update-metadata>,
    rate-limit: option<s32>,
    /// Optional unique identifier for the endpoint
    uid: option<string>,
    url: string,
    version: s32
  }
  update-endpoint-api-v1-app-app-id-endpoint-endpoint-id-put: func(params: update-endpoint-api-v1-app-app-id-endpoint-endpoint-id-put-params) -> result<string, string>;

  /// Delete Endpoint
  record delete-endpoint-api-v1-app-app-id-endpoint-endpoint-id-delete-params {
    endpoint-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  delete-endpoint-api-v1-app-app-id-endpoint-endpoint-id-delete: func(params: delete-endpoint-api-v1-app-app-id-endpoint-endpoint-id-delete-params) -> result<string, string>;

  /// Get Endpoint Headers
  record get-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-get-params {
    endpoint-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  get-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-get: func(params: get-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-get-params) -> result<string, string>;

  /// Update Endpoint Headers
  record update-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-put-params {
    app-id: string,
    endpoint-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    headers: endpoint-headers-in-headers
  }
  update-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-put: func(params: update-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-put-params) -> result<string, string>;

  /// Patch Endpoint Headers
  record patch-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-patch-params {
    app-id: string,
    endpoint-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    headers: endpoint-headers-patch-in-headers
  }
  patch-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-patch: func(params: patch-endpoint-headers-api-v1-app-app-id-endpoint-endpoint-id-headers-patch-params) -> result<string, string>;

  /// Recover Failed Webhooks
  record recover-failed-webhooks-api-v1-app-app-id-endpoint-endpoint-id-recover-post-params {
    app-id: string,
    endpoint-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    since: string,
    until: option<string>
  }
  recover-failed-webhooks-api-v1-app-app-id-endpoint-endpoint-id-recover-post: func(params: recover-failed-webhooks-api-v1-app-app-id-endpoint-endpoint-id-recover-post-params) -> result<string, string>;

  /// Replay Missing Webhooks
  record replay-missing-webhooks-api-v1-app-app-id-endpoint-endpoint-id-replay-missing-post-params {
    app-id: string,
    endpoint-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    since: string,
    until: option<string>
  }
  replay-missing-webhooks-api-v1-app-app-id-endpoint-endpoint-id-replay-missing-post: func(params: replay-missing-webhooks-api-v1-app-app-id-endpoint-endpoint-id-replay-missing-post-params) -> result<string, string>;

  /// Get Endpoint Secret
  record get-endpoint-secret-api-v1-app-app-id-endpoint-endpoint-id-secret-get-params {
    endpoint-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  get-endpoint-secret-api-v1-app-app-id-endpoint-endpoint-id-secret-get: func(params: get-endpoint-secret-api-v1-app-app-id-endpoint-endpoint-id-secret-get-params) -> result<string, string>;

  /// Rotate Endpoint Secret
  record rotate-endpoint-secret-api-v1-app-app-id-endpoint-endpoint-id-secret-rotate-post-params {
    endpoint-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    /// The endpoint's verification secret. If `null` is passed, a secret is automatically generated. Format: `base64` encoded random bytes optionally prefixed with `whsec_`. Recommended size: 24.
    key: option<string>
  }
  rotate-endpoint-secret-api-v1-app-app-id-endpoint-endpoint-id-secret-rotate-post: func(params: rotate-endpoint-secret-api-v1-app-app-id-endpoint-endpoint-id-secret-rotate-post-params) -> result<string, string>;

  /// Send Event Type Example Message
  record send-event-type-example-message-api-v1-app-app-id-endpoint-endpoint-id-send-example-post-params {
    app-id: string,
    endpoint-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    event-type: string
  }
  send-event-type-example-message-api-v1-app-app-id-endpoint-endpoint-id-send-example-post: func(params: send-event-type-example-message-api-v1-app-app-id-endpoint-endpoint-id-send-example-post-params) -> result<string, string>;

  /// Get Endpoint Stats
  record get-endpoint-stats-api-v1-app-app-id-endpoint-endpoint-id-stats-get-params {
    endpoint-id: string,
    app-id: string,
    since: option<string>,
    until: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  get-endpoint-stats-api-v1-app-app-id-endpoint-endpoint-id-stats-get: func(params: get-endpoint-stats-api-v1-app-app-id-endpoint-endpoint-id-stats-get-params) -> result<string, string>;

  /// Get Endpoint Transformation
  record get-endpoint-transformation-api-v1-app-app-id-endpoint-endpoint-id-transformation-get-params {
    endpoint-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  get-endpoint-transformation-api-v1-app-app-id-endpoint-endpoint-id-transformation-get: func(params: get-endpoint-transformation-api-v1-app-app-id-endpoint-endpoint-id-transformation-get-params) -> result<string, string>;

  /// Set Endpoint Transformation
  record set-endpoint-transformation-api-v1-app-app-id-endpoint-endpoint-id-transformation-patch-params {
    app-id: string,
    endpoint-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
    code: option<string>,
    enabled: option<bool>
  }
  set-endpoint-transformation-api-v1-app-app-id-endpoint-endpoint-id-transformation-patch: func(params: set-endpoint-transformation-api-v1-app-app-id-endpoint-endpoint-id-transformation-patch-params) -> result<string, string>;

}

