interface message {
  record application-in {
    metadata: option<application-in-metadata>,
    name: string,
    rate-limit: option<s32>,
    /// Optional unique identifier for the application
    uid: option<string>
  }

  record application-in-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record message-in-payload {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List Messages
  record list-messages-api-v1-app-app-id-msg-get-params {
    app-id: string,
    iterator: option<string>,
    limit: option<s32>,
    event-types: option<list<string>>,
    channel: option<string>,
    before: option<string>,
    after: option<string>,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  list-messages-api-v1-app-app-id-msg-get: func(params: list-messages-api-v1-app-app-id-msg-get-params) -> result<string, string>;

  /// Create Message
  record create-message-api-v1-app-app-id-msg-post-params {
    app-id: string,
    with-content: option<bool>,
    /// The request's idempotency key
    idempotency-key: option<string>,
    application: option<application-in>,
    /// List of free-form identifiers that endpoints can filter by
    channels: option<list<string>>,
    /// Optional unique identifier for the message
    event-id: option<string>,
    event-type: string,
    payload: message-in-payload,
    /// The retention period for the payload (in days).
    payload-retention-period: option<s32>
  }
  create-message-api-v1-app-app-id-msg-post: func(params: create-message-api-v1-app-app-id-msg-post-params) -> result<string, string>;

  /// Get Message
  record get-message-api-v1-app-app-id-msg-msg-id-get-params {
    msg-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  get-message-api-v1-app-app-id-msg-msg-id-get: func(params: get-message-api-v1-app-app-id-msg-msg-id-get-params) -> result<string, string>;

  /// Delete message payload
  record expunge-message-payload-api-v1-app-app-id-msg-msg-id-content-delete-params {
    msg-id: string,
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>
  }
  expunge-message-payload-api-v1-app-app-id-msg-msg-id-content-delete: func(params: expunge-message-payload-api-v1-app-app-id-msg-msg-id-content-delete-params) -> result<string, string>;

}

interface authentication {
  /// Get Consumer App Portal Access
  record get-app-portal-access-api-v1-auth-app-portal-access-app-id-post-params {
    app-id: string,
    /// The request's idempotency key
    idempotency-key: option<string>,
