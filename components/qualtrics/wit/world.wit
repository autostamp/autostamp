package autostamp:qualtrics@0.6.0;

interface directories {
  /// Create contact in mailing list
  record create-contact-in-mailinglist-params {
    /// ID of the qualtrics directory to create the contact to
    directory-id: string,
    /// ID of the mailing list
    mailing-list-id: string,
    email: option<string>,
    first-name: option<string>,
    last-name: option<string>,
    unsubscribed: option<bool>
  }
  create-contact-in-mailinglist: func(params: create-contact-in-mailinglist-params) -> result<string, string>;

}


interface distributions {
  record response {
    meta: option<response-meta>,
    result-op: option<response-result-op>
  }

  record response-meta {
    http-status: option<string>,
    request-id: option<string>
  }

  record response-result-op {
    elements: option<list<response-result-op-elements-item>>,
    next-page: option<string>
  }

  record response-result-op-elements-item {
    created-date: string,
    custom-headers: list<response-result-op-elements-item-custom-headers-entry>,
    embedded-data: string,
    headers: response-result-op-elements-item-headers,
    id: string,
    message: response-result-op-elements-item-message,
    modified-date: string,
    organization-id: string,
    owner-id: string,
    parent-distribution-id: string,
    recipients: response-result-op-elements-item-recipients,
    request-status: string,
    request-type: string,
    send-date: string,
    stats: response-result-op-elements-item-stats,
    survey-link: response-result-op-elements-item-survey-link
  }

  /// one entry of a string-keyed map (free-form object)
  record response-result-op-elements-item-custom-headers-entry {
    key: string,
    value: string
  }

  record response-result-op-elements-item-headers {
    from-email: option<string>,
    from-name: option<string>,
    reply-to-email: option<string>
  }

  record response-result-op-elements-item-message {
    library-id: option<string>,
    message-id: option<string>,
    message-text: option<string>
  }

  record response-result-op-elements-item-recipients {
    contact-id: option<string>,
    library-id: option<string>,
    mailing-list-id: option<string>,
    sample-id: option<string>
  }

  record response-result-op-elements-item-stats {
    blocked: option<s32>,
    bounced: option<s32>,
    complaints: option<s32>,
    failed: option<s32>,
    finished: option<s32>,
    opened: option<s32>,
    sent: option<s32>,
    skipped: option<s32>,
    started: option<s32>
  }

  record response-result-op-elements-item-survey-link {
    expiration-date: option<string>,
    link-type: option<string>,
    survey-id: option<string>
  }

  record retrieve-distribution-links-response {
    meta: option<retrieve-distribution-links-response-meta>,
    result-op: option<retrieve-distribution-links-response-result-op>
  }

  record retrieve-distribution-links-response-meta {
    http-status: option<string>,
    request-id: option<string>
  }

  record retrieve-distribution-links-response-result-op {
    elements: option<list<retrieve-distribution-links-response-result-op-elements-item>>,
    next-page: option<string>
  }

  record retrieve-distribution-links-response-result-op-elements-item {
    contact-id: string,
    email: string,
    exceeded-contact-frequency: bool,
    external-data-reference: string,
    first-name: string,
    last-name: string,
    link: string,
    link-expiration: string,
    status: string,
    transaction-id: string,
    unsubscribed: bool
  }

  /// Get distributions for survey
  record get-distributions-params {
    /// The survey for which to load the distributions
    survey-id: string
  }
  get-distributions: func(params: get-distributions-params) -> result<response, string>;

  /// Generate distribution links
  record generate-distribution-links-params {
    action: option<string>,
    description: option<string>,
    expiration-date: option<string>,
    link-type: option<string>,
    mailing-list-id: option<string>,
    survey-id: option<string>
  }
  generate-distribution-links: func(params: generate-distribution-links-params) -> result<string, string>;

  /// Retrieve distribution links
  record retrievedistributionlinks-params {
    /// ID of the survey (eg: SV_123)
    survey-id: string,
    /// ID of the distribution list
    distribution-id: string
  }
  retrievedistributionlinks: func(params: retrievedistributionlinks-params) -> result<retrieve-distribution-links-response, string>;

}

interface eventsubscriptions {
  record event-subscriptions-response {
    meta: option<event-subscriptions-response-meta>,
    result-op: option<event-subscriptions-response-result-op>
  }

  record event-subscriptions-response-meta {
    http-status: option<string>,
    request-id: option<string>
  }

  record event-subscriptions-response-result-op {
    meta: option<event-subscriptions-response-result-op-meta>,
    result-op: option<event-subscriptions-response-result-op-result-op>
  }

  record event-subscriptions-response-result-op-meta {
    http-status: option<string>
  }

  record event-subscriptions-response-result-op-result-op {
    id: option<string>
  }

  /// Triggers when a response is submitted to a qualtrics survey
  record when-a-response-is-received-params {
    encrypt: option<bool>,
    /// The internal publication URL - will be generated by PowerAutomate
    publication-url: string,
    /// The topics to subscribe to. Must follow the format surveyengine.completedResponse.[SurveyID]
    topics: string
  }
  when-a-response-is-received: func(params: when-a-response-is-received-params) -> result<event-subscriptions-response, string>;

  /// Remove subscription to response event
  record webhook-delete-params {
    encrypt: option<bool>,
    /// The internal publication URL - will be generated by PowerAutomate
    publication-url: string,
    /// The topics to subscribe to. Must follow the format surveyengine.completedResponse.[SurveyID]
    topics: string
  }
  webhook-delete: func(params: webhook-delete-params) -> result<event-subscriptions-response, string>;

  /// Get event subscriptions
  record get-event-subscriptions-params {
    /// ID of event subscription - can be obtained from web hook response
    subscription-id: string
  }
  get-event-subscriptions: func(params: get-event-subscriptions-params) -> result<event-subscriptions-response, string>;

}

interface survey-definitions {
  /// one entry of a string-keyed map (free-form object)
  record survey-response-entry {
    key: string,
    value: string
  }

  /// Get survey
  record get-survey-params {
    /// ID of survey (eg. SV_123)
    survey-id: string
  }
  get-survey: func(params: get-survey-params) -> result<list<survey-response-entry>, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export directories;
  export distributions;
  export eventsubscriptions;
  export survey-definitions;
}
