/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `Authorization` | header `Authorization` |
package autostamp:sendgrid@0.3.0;

interface ip-access-management {
  record post-access-settings-whitelist-body-ips-item {
    /// An IP address that you want to allow.
    ip: string
  }

  /// Retrieve all recent access attempts
  record get-access-settings-activity-params {
    /// Limits the number of IPs to return.
    limit: option<s32>,
    on-behalf-of: option<string>
  }
  get-access-settings-activity: func(params: get-access-settings-activity-params) -> result<string, string>;

  /// Retrieve a list of currently allowed IPs
  record get-access-settings-whitelist-params {
    on-behalf-of: option<string>
  }
  get-access-settings-whitelist: func(params: get-access-settings-whitelist-params) -> result<string, string>;

  /// Add one or more IPs to the allow list
  record post-access-settings-whitelist-params {
    on-behalf-of: option<string>,
    /// An array containing the IP(s) you want to allow.
    ips: list<post-access-settings-whitelist-body-ips-item>
  }
  post-access-settings-whitelist: func(params: post-access-settings-whitelist-params) -> result<string, string>;

  /// Remove one or more IPs from the allow list
  record delete-access-settings-whitelist-params {
    on-behalf-of: option<string>,
    /// An array of the IDs of the IP address that you want to remove from your allow list.
    ids: option<list<s32>>
  }
  delete-access-settings-whitelist: func(params: delete-access-settings-whitelist-params) -> result<string, string>;

  /// Retrieve a specific allowed IP
  record get-access-settings-whitelist-rule-id-params {
    on-behalf-of: option<string>
  }
  get-access-settings-whitelist-rule-id: func(params: get-access-settings-whitelist-rule-id-params) -> result<string, string>;

  /// Remove a specific IP from the allowed list
  record delete-access-settings-whitelist-rule-id-params {
    on-behalf-of: option<string>
  }
  delete-access-settings-whitelist-rule-id: func(params: delete-access-settings-whitelist-rule-id-params) -> result<string, string>;

}


interface alerts {
  enum post-alerts-body-type-op-enum {
    stats-notification,
    usage-limit,
  }

  /// Retrieve all alerts
  record get-alerts-params {
    on-behalf-of: option<string>
  }
  get-alerts: func(params: get-alerts-params) -> result<string, string>;

  /// Create a new Alert
  record post-alerts-params {
    on-behalf-of: option<string>,
    /// The email address the alert will be sent to.
    /// Example: test@example.com
    email-to: string,
    /// Required for stats_notification. How frequently the alert will be sent.
    /// Example: daily
    frequency: option<string>,
    /// Required for usage_alert. When this usage threshold is reached, the alert will be sent.
    /// Example: 90
    percentage: option<s32>,
    /// The type of alert you want to create. Can be either usage_limit or stats_notification.
    /// Example: usage_limit
    type-op: post-alerts-body-type-op-enum
  }
  post-alerts: func(params: post-alerts-params) -> result<string, string>;

  /// Retrieve a specific alert
  record get-alerts-alert-id-params {
    on-behalf-of: option<string>
  }
  get-alerts-alert-id: func(params: get-alerts-alert-id-params) -> result<string, string>;

  /// Update an alert
  record patch-alerts-alert-id-params {
    on-behalf-of: option<string>,
    /// The new email address you want your alert to be sent to.
    /// Example: test@example.com
    email-to: option<string>,
    /// The new frequency at which to send the stats_notification alert.
    /// Example: monthly
    frequency: option<string>,
    /// The new percentage threshold at which the usage_limit alert will be sent.
    /// Example: 90
    percentage: option<s32>
  }
  patch-alerts-alert-id: func(params: patch-alerts-alert-id-params) -> result<string, string>;

  /// Delete an alert
  record delete-alerts-alert-id-params {
    on-behalf-of: option<string>
  }
  delete-alerts-alert-id: func(params: delete-alerts-alert-id-params) -> result<string, string>;

}

interface api-keys {
  /// Retrieve all API Keys belonging to the authenticated user
  record get-api-keys-params {
    limit: option<s32>,
    on-behalf-of: option<string>
  }
  get-api-keys: func(params: get-api-keys-params) -> result<string, string>;

  /// Create API keys
  record create-api-keys-params {
    on-behalf-of: option<string>,
    /// The name you will use to describe this API Key.
    name: string,
    /// The individual permissions that you are giving to this API Key.
    scopes: option<list<string>>
  }
  create-api-keys: func(params: create-api-keys-params) -> result<string, string>;

  /// Retrieve an existing API Key
  record get-api-keys-api-key-id-params {
    on-behalf-of: option<string>
  }
  get-api-keys-api-key-id: func(params: get-api-keys-api-key-id-params) -> result<string, string>;

  /// Update API key name and scopes
  record put-api-keys-api-key-id-params {
    on-behalf-of: option<string>,
    name: string,
    scopes: option<list<string>>
  }
  put-api-keys-api-key-id: func(params: put-api-keys-api-key-id-params) -> result<string, string>;

  /// Update API key name
  record patch-api-keys-api-key-id-params {
    on-behalf-of: option<string>,
    /// The new name of the API Key.
    name: string
  }
  patch-api-keys-api-key-id: func(params: patch-api-keys-api-key-id-params) -> result<string, string>;

  /// Delete API keys
  record delete-api-keys-api-key-id-params {
    on-behalf-of: option<string>
  }
  delete-api-keys-api-key-id: func(params: delete-api-keys-api-key-id-params) -> result<string, string>;

}

interface suppressions-unsubscribe-groups {
  /// Retrieve all suppression groups associated with the user.
  record get-asm-groups-params {
    id: option<s32>,
    on-behalf-of: option<string>
  }
  get-asm-groups: func(params: get-asm-groups-params) -> result<string, string>;

  /// Create a new suppression group
  record post-asm-groups-params {
    on-behalf-of: option<string>,
    /// A brief description of your suppression group. Required when creating a group.
    description: option<string>,
    /// Indicates if you would like this to be your default suppression group.
    is-default: option<bool>,
    /// The name of your suppression group. Required when creating a group.
    name: option<string>
  }
  post-asm-groups: func(params: post-asm-groups-params) -> result<string, string>;

  /// Get information on a single suppression group.
  record get-asm-groups-group-id-params {
    on-behalf-of: option<string>
  }
  get-asm-groups-group-id: func(params: get-asm-groups-group-id-params) -> result<string, string>;

  /// Update a suppression group.
  record patch-asm-groups-group-id-params {
    on-behalf-of: option<string>,
    body: option<string>
  }
  patch-asm-groups-group-id: func(params: patch-asm-groups-group-id-params) -> result<string, string>;

  /// Delete a Suppression Group
  record delete-asm-groups-group-id-params {
    on-behalf-of: option<string>
  }
  delete-asm-groups-group-id: func(params: delete-asm-groups-group-id-params) -> result<string, string>;

}

interface suppressions-suppressions {
  /// Retrieve all suppressions for a suppression group
  record get-asm-groups-group-id-suppressions-params {
    on-behalf-of: option<string>
  }
  get-asm-groups-group-id-suppressions: func(params: get-asm-groups-group-id-suppressions-params) -> result<string, string>;

  /// Add suppressions to a suppression group
  record post-asm-groups-group-id-suppressions-params {
    on-behalf-of: option<string>,
    /// The array of email addresses to add or find.
    recipient-emails: list<string>
  }
  post-asm-groups-group-id-suppressions: func(params: post-asm-groups-group-id-suppressions-params) -> result<string, string>;

  /// Search for suppressions within a group
  record post-asm-groups-group-id-suppressions-search-params {
    on-behalf-of: option<string>,
    /// The array of email addresses to add or find.
    recipient-emails: list<string>
  }
  post-asm-groups-group-id-suppressions-search: func(params: post-asm-groups-group-id-suppressions-search-params) -> result<string, string>;

  /// Delete a suppression from a suppression group
  record delete-asm-groups-group-id-suppressions-email-params {
    on-behalf-of: option<string>
  }
  delete-asm-groups-group-id-suppressions-email: func(params: delete-asm-groups-group-id-suppressions-email-params) -> result<string, string>;

  /// Retrieve all suppressions
  record get-asm-suppressions-params {
    on-behalf-of: option<string>
  }
  get-asm-suppressions: func(params: get-asm-suppressions-params) -> result<string, string>;

  /// Retrieve all suppression groups for an email address
  record get-asm-suppressions-email-params {
    on-behalf-of: option<string>
  }
  get-asm-suppressions-email: func(params: get-asm-suppressions-email-params) -> result<string, string>;

}

interface suppressions-global-suppressions {
  /// Add recipient addresses to the global suppression group.
  record post-asm-suppressions-global-params {
    on-behalf-of: option<string>,
    /// The array of email addresses to add or find.
    recipient-emails: list<string>
  }
  post-asm-suppressions-global: func(params: post-asm-suppressions-global-params) -> result<string, string>;

  /// Retrieve a Global Suppression
  record get-asm-suppressions-global-email-params {
    on-behalf-of: option<string>
  }
  get-asm-suppressions-global-email: func(params: get-asm-suppressions-global-email-params) -> result<string, string>;

  /// Delete a Global Suppression
  record delete-asm-suppressions-global-email-params {
    on-behalf-of: option<string>
  }
  delete-asm-suppressions-global-email: func(params: delete-asm-suppressions-global-email-params) -> result<string, string>;

  /// Retrieve all global suppressions
  record get-suppression-unsubscribes-params {
    /// Refers start of the time range in unix timestamp when an unsubscribe email was created (inclusive).
    start-time: option<s32>,
    /// Refers end of the time range in unix timestamp when an unsubscribe email was created (inclusive).
    end-time: option<s32>,
    /// The number of results to display on each page.
    limit: option<s32>,
    /// The point in the list of results to begin displaying global suppressions.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-suppression-unsubscribes: func(params: get-suppression-unsubscribes-params) -> result<string, string>;

}

interface stats {
  enum get-browsers-stats-aggregated-by-enum {
    day,
    week,
    month,
  }

  enum get-geo-stats-country-enum {
    us,
    ca,
  }

  /// Retrieve email statistics by browser.
  record get-browsers-stats-params {
    /// The browsers to get statistics for. You can include up to 10 different browsers by including this parameter multiple times.
    browsers: option<string>,
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-browsers-stats: func(params: get-browsers-stats-params) -> result<string, string>;

  /// Retrieve email statistics by client type.
  record get-clients-stats-params {
    on-behalf-of: option<string>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>
  }
  get-clients-stats: func(params: get-clients-stats-params) -> result<string, string>;

  /// Retrieve stats by a specific client type.
  record get-clients-client-type-stats-params {
    on-behalf-of: option<string>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>
  }
  get-clients-client-type-stats: func(params: get-clients-client-type-stats-params) -> result<string, string>;

  /// Retrieve email statistics by device type.
  record get-devices-stats-params {
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-devices-stats: func(params: get-devices-stats-params) -> result<string, string>;

  /// Retrieve email statistics by country and state/province.
  record get-geo-stats-params {
    /// The country you would like to see statistics for. Currently only supported for US and CA.
    country: option<get-geo-stats-country-enum>,
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-geo-stats: func(params: get-geo-stats-params) -> result<string, string>;

  /// Retrieve email statistics by mailbox provider.
  record get-mailbox-providers-stats-params {
    /// The mail box providers to get statistics for. You can include up to 10 by including this parameter multiple times.
    mailbox-providers: option<string>,
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-mailbox-providers-stats: func(params: get-mailbox-providers-stats-params) -> result<string, string>;

  /// Retrieve global email statistics
  record get-stats-params {
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-stats: func(params: get-stats-params) -> result<string, string>;

}

interface campaigns-api {
  enum campaign-request-editor-enum {
    code,
    design,
  }

  /// Retrieve all Campaigns
  record get-campaigns-params {
    /// The number of results you would like to receive at a time.
    limit: option<s32>,
    /// The index of the first campaign to return, where 0 is the first campaign.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-campaigns: func(params: get-campaigns-params) -> result<string, string>;

  /// Create a Campaign
  record post-campaigns-params {
    on-behalf-of: option<string>,
    /// The categories you would like associated to this campaign.
    categories: option<list<string>>,
    /// This is the url of the custom unsubscribe page that you provide for customers to unsubscribe from your suppression groups.
    custom-unsubscribe-url: option<string>,
    /// The editor used in the UI.
    editor: option<campaign-request-editor-enum>,
    /// The HTML of your marketing email.
    html-content: option<string>,
    /// The pool of IPs that you would like to send this email from.
    ip-pool: option<string>,
    /// The IDs of the lists you are sending this campaign to. You can have both segment IDs and list IDs
    list-ids: option<list<s32>>,
    /// The plain text content of your emails.
    plain-content: option<string>,
    /// The segment IDs that you are sending this list to. You can have both segment IDs and list IDs. Segments are limited to 10 segment IDs.
    segment-ids: option<list<s32>>,
    /// The ID of the "sender" identity that you have created. Your recipients will see this as the "from" on your marketing emails.
    sender-id: option<s32>,
    /// The subject of your campaign that your recipients will see.
    subject: option<string>,
    /// The suppression group that this marketing email belongs to, allowing recipients to opt-out of emails of this type.
    suppression-group-id: option<s32>,
    /// The display title of your campaign. This will be viewable by you in the Marketing Campaigns UI.
    title: string
  }
  post-campaigns: func(params: post-campaigns-params) -> result<string, string>;

  /// Retrieve a single campaign
  record get-campaigns-campaign-id-params {
    on-behalf-of: option<string>
  }
  get-campaigns-campaign-id: func(params: get-campaigns-campaign-id-params) -> result<string, string>;

  /// Update a Campaign
  record patch-campaigns-campaign-id-params {
    on-behalf-of: option<string>,
    /// The categories you want to tag on this campaign.
    categories: list<string>,
    /// The HTML content of this campaign.
    html-content: string,
    /// The plain content of this campaign.
    plain-content: string,
    /// The subject line for your campaign.
    subject: string,
    /// The title of the campaign.
    title: string
  }
  patch-campaigns-campaign-id: func(params: patch-campaigns-campaign-id-params) -> result<string, string>;

  /// Delete a Campaign
  record delete-campaigns-campaign-id-params {
    on-behalf-of: option<string>
  }
  delete-campaigns-campaign-id: func(params: delete-campaigns-campaign-id-params) -> result<string, string>;

  /// View Scheduled Time of a Campaign
  record get-campaigns-campaign-id-schedules-params {
    on-behalf-of: option<string>
  }
  get-campaigns-campaign-id-schedules: func(params: get-campaigns-campaign-id-schedules-params) -> result<string, string>;

  /// Schedule a Campaign
  record post-campaigns-campaign-id-schedules-params {
    on-behalf-of: option<string>,
    /// The unix timestamp for the date and time you would like your campaign to be sent out.
    send-at: s32
  }
  post-campaigns-campaign-id-schedules: func(params: post-campaigns-campaign-id-schedules-params) -> result<string, string>;

  /// Update a Scheduled Campaign
  record patch-campaigns-campaign-id-schedules-params {
    on-behalf-of: option<string>,
    send-at: s64
  }
  patch-campaigns-campaign-id-schedules: func(params: patch-campaigns-campaign-id-schedules-params) -> result<string, string>;

  /// Unschedule a Scheduled Campaign
  record delete-campaigns-campaign-id-schedules-params {
    on-behalf-of: option<string>
  }
  delete-campaigns-campaign-id-schedules: func(params: delete-campaigns-campaign-id-schedules-params) -> result<string, string>;

  /// Send a Campaign
  record post-campaigns-campaign-id-schedules-now-params {
    on-behalf-of: option<string>
  }
  post-campaigns-campaign-id-schedules-now: func(params: post-campaigns-campaign-id-schedules-now-params) -> result<string, string>;

  /// Send a Test Campaign
  record post-campaigns-campaign-id-schedules-test-params {
    on-behalf-of: option<string>,
    /// The email address that should receive the test campaign.
    to: string
  }
  post-campaigns-campaign-id-schedules-test: func(params: post-campaigns-campaign-id-schedules-test-params) -> result<string, string>;

}

interface categories {
  enum get-categories-stats-aggregated-by-enum {
    day,
    week,
    month,
  }

  enum get-categories-stats-sums-sort-by-direction-enum {
    desc,
    asc,
  }

  /// Retrieve all categories
  record get-categories-params {
    /// The number of categories to display per page.
    limit: option<s32>,
    /// Allows you to perform a prefix search on this particular category.
    category: option<string>,
    /// The point in the list that you would like to begin displaying results.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-categories: func(params: get-categories-params) -> result<string, string>;

  /// Retrieve Email Statistics for Categories
  record get-categories-stats-params {
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// The individual categories that you want to retrieve statistics for. You may include up to 10 different categories.
    categories: string,
    /// The number of results to include.
    limit: option<s32>,
    /// The number of results to skip.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-categories-stats-aggregated-by-enum>,
    on-behalf-of: option<string>
  }
  get-categories-stats: func(params: get-categories-stats-params) -> result<string, string>;

  /// Retrieve sums of email stats for each category [Needs: Stats object defined, has category ID?]
  record get-categories-stats-sums-params {
    /// The metric that you want to sort by.  Must be a single metric.
    sort-by-metric: option<string>,
    /// The direction you want to sort.
    sort-by-direction: option<get-categories-stats-sums-sort-by-direction-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// Limits the number of results returned.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-categories-stats-aggregated-by-enum>,
    on-behalf-of: option<string>
  }
  get-categories-stats-sums: func(params: get-categories-stats-sums-params) -> result<string, string>;

}

interface contacts-api-custom-fields {
  /// Retrieve all custom fields
  record get-contactdb-custom-fields-params {
    on-behalf-of: option<string>
  }
  get-contactdb-custom-fields: func(params: get-contactdb-custom-fields-params) -> result<string, string>;

  /// Create a Custom Field
  record post-contactdb-custom-fields-params {
    on-behalf-of: option<string>,
    name: option<string>,
    type-op: option<string>
  }
  post-contactdb-custom-fields: func(params: post-contactdb-custom-fields-params) -> result<string, string>;

  /// Retrieve a Custom Field
  record get-contactdb-custom-fields-custom-field-id-params {
    on-behalf-of: option<string>
  }
  get-contactdb-custom-fields-custom-field-id: func(params: get-contactdb-custom-fields-custom-field-id-params) -> result<string, string>;

  /// Delete a Custom Field
  record delete-contactdb-custom-fields-custom-field-id-params {
    on-behalf-of: option<string>
  }
  delete-contactdb-custom-fields-custom-field-id: func(params: delete-contactdb-custom-fields-custom-field-id-params) -> result<string, string>;

  /// Retrieve reserved fields
  record get-contactdb-reserved-fields-params {
    on-behalf-of: option<string>
  }
  get-contactdb-reserved-fields: func(params: get-contactdb-reserved-fields-params) -> result<string, string>;

}

interface contacts-api-lists {
  /// Retrieve all lists
  record get-contactdb-lists-params {
    on-behalf-of: option<string>
  }
  get-contactdb-lists: func(params: get-contactdb-lists-params) -> result<string, string>;

  /// Create a List
  record post-contactdb-lists-params {
    on-behalf-of: option<string>,
    name: string
  }
  post-contactdb-lists: func(params: post-contactdb-lists-params) -> result<string, string>;

  /// Delete Multiple lists
  record delete-contactdb-lists-params {
    on-behalf-of: option<string>,
    body: option<list<s32>>
  }
  delete-contactdb-lists: func(params: delete-contactdb-lists-params) -> result<string, string>;

  /// Retrieve a single list
  record get-contactdb-lists-list-id-params {
    /// The ID of the list to retrieve.
    list-id: option<s32>,
    on-behalf-of: option<string>
  }
  get-contactdb-lists-list-id: func(params: get-contactdb-lists-list-id-params) -> result<string, string>;

  /// Update a List
  record patch-contactdb-lists-list-id-params {
    /// The ID of the list you are updating.
    list-id: s32,
    on-behalf-of: option<string>,
    /// The new name for your list. 
    name: string
  }
  patch-contactdb-lists-list-id: func(params: patch-contactdb-lists-list-id-params) -> result<string, string>;

  /// Delete a List
  record delete-contactdb-lists-list-id-params {
    /// Adds the ability to delete all contacts on the list in addition to deleting the list.
    delete-contacts: option<bool>,
    on-behalf-of: option<string>,
    body: option<string>
  }
  delete-contactdb-lists-list-id: func(params: delete-contactdb-lists-list-id-params) -> result<string, string>;

  /// Retrieve all recipients on a List
  record get-contactdb-lists-list-id-recipients-params {
    /// Page index of first recipient to return (must be a positive integer)
    page: option<s32>,
    /// Number of recipients to return at a time (must be a positive integer between 1 and 1000)
    page-size: option<s32>,
    /// The ID of the list whose recipients you are requesting.
    list-id: s32,
    on-behalf-of: option<string>
  }
  get-contactdb-lists-list-id-recipients: func(params: get-contactdb-lists-list-id-recipients-params) -> result<string, string>;

  /// Add Multiple Recipients to a List
  record post-contactdb-lists-list-id-recipients-params {
    on-behalf-of: option<string>,
    body: option<list<s32>>
  }
  post-contactdb-lists-list-id-recipients: func(params: post-contactdb-lists-list-id-recipients-params) -> result<string, string>;

  /// Add a Single Recipient to a List
  record post-contactdb-lists-list-id-recipients-recipient-id-params {
    on-behalf-of: option<string>
  }
  post-contactdb-lists-list-id-recipients-recipient-id: func(params: post-contactdb-lists-list-id-recipients-recipient-id-params) -> result<string, string>;

  /// Delete a Single Recipient from a Single List
  record delete-contactdb-lists-list-id-recipients-recipient-id-params {
    /// The ID of the list you are taking this recipient away from.
    list-id: s32,
    /// The ID of the recipient to take off the list.
    recipient-id: s32,
    on-behalf-of: option<string>,
    body: option<string>
  }
  delete-contactdb-lists-list-id-recipients-recipient-id: func(params: delete-contactdb-lists-list-id-recipients-recipient-id-params) -> result<string, string>;

}

