    valid: bool
  }

  record v200-response-item-v2-subusers-item {
    /// The ID of the subuser that this authenticated domain will be associated with.
    user-id: option<s32>,
    /// The username of the subuser that this authenticated domain is associated with.
    username: option<string>
  }

  record domain-spf {
    /// Indicates if this authenticated domain uses automated security.
    automatic-security: bool,
    /// Indicates if this authenticated domain uses custom SPF.
    custom-spf: bool,
    /// Indicates if this is the default domain.
    default: bool,
    /// The DNS records for this authenticated domain.
    dns: domain-spf-dns,
    /// The domain authenticated.
    domain: string,
    /// The ID of the authenticated domain.
    id: s32,
    /// The IP addresses that are included in the SPF record for this authenticated domain.
    ips: list<string>,
    /// Indicates if this authenticated domain was created using the legacy whitelabel tool. If it is a legacy whitelabel, it will still function, but you'll need to create a new authenticated domain if you need to update it.
    legacy: bool,
    /// The subdomain that was used to create this authenticated domain.
    subdomain: option<string>,
    /// The user_id of the account that this authenticated domain is associated with.
    user-id: s32,
    /// The username of the account that this authenticated domain is associated with.
    username: string,
    /// Indicates if this is a valid authenticated domain .
    valid: bool
  }

  /// The DNS records for this authenticated domain.
  record domain-spf-dns {
    /// The DKIM record for messages sent using this authenticated domain.
    dkim: domain-spf-dns-dkim,
    /// The SPF record for the root domain.
    domain-spf: domain-spf-dns-domain-spf,
    /// Designates which mail server is responsible for accepting messages from a domain.
    mail-server: domain-spf-dns-mail-server,
    /// The SPF record for the subdomain used to create this authenticated domain.
    subdomain-spf: domain-spf-dns-subdomain-spf
  }

  /// The DKIM record for messages sent using this authenticated domain.
  record domain-spf-dns-dkim {
    /// The DKIM record.
    data: string,
    /// The DNS labels for the DKIM signature.
    host: string,
    /// The type of data in the DKIM record.
    type-op: string,
    /// Indicates if the DKIM record is valid.
    valid: bool
  }

  /// The SPF record for the root domain.
  record domain-spf-dns-domain-spf {
    /// The SPF record.
    data: string,
    /// The root domain that this SPF record will be used to authenticate.
    host: string,
    /// The type of data in the SPF record.
    type-op: string,
    /// Indicates if the SPF record is valid.
    valid: bool
  }

  /// Designates which mail server is responsible for accepting messages from a domain.
  record domain-spf-dns-mail-server {
    /// The mail server responsible for accepting messages from the sending domain.
    data: string,
    /// The domain sending the messages.
    host: string,
    /// They type of DNS record.
    type-op: string,
    /// Indicates if this is a valid DNS record.
    valid: bool
  }

  /// The SPF record for the subdomain used to create this authenticated domain.
  record domain-spf-dns-subdomain-spf {
    /// The SPF record.
    data: string,
    /// The domain that this SPF record will be used to authenticate.
    host: string,
    /// The type of data in the SPF record.
    type-op: string,
    /// Indicates if this is a valid SPF record.
    valid: bool
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-whitelabel-domains-subuser-response-entry {
    key: string,
    value: string
  }

  record v200-response-item-v3 {
    /// Indicates if this authenticated domain uses automated security.
    automatic-security: bool,
    /// Indicates whether this authenticated domain uses custom SPF.
    custom-spf: bool,
    /// Indicates if this is the default authenticated domain.
    default: bool,
    /// The DNS records used to authenticate the sending domain.
    dns: v200-response-item-v3-dns,
    /// The domain to be authenticated.
    domain: string,
    /// The ID of the authenticated domain.
    id: f64,
    /// The IPs to be included in the custom SPF record for this authenticated domain.
    ips: list<string>,
    /// Indicates if this authenticated domain was created using the legacy whitelabel tool. If it is a legacy whitelabel, it will still function, but you'll need to create a new authenticated domain if you need to update it.
    legacy: bool,
    /// The subdomain to use for this authenticated domain.
    subdomain: string,
    /// The ID of the user that this domain is associated with.
    user-id: f64,
    /// The username that this domain will be associated with.
    username: string,
    /// Indicates if this is a valid authenticated domain.
    valid: bool,
    /// A Unix epoch timestamp representing the last time of a validation attempt.
    last-validation-attempt-at: option<s32>,
    subusers: option<list<v200-response-item-v3-subusers-item>>
  }

  /// The DNS records used to authenticate the sending domain.
  record v200-response-item-v3-dns {
    /// A DNS record.
    dkim1: v200-response-item-v3-dns-dkim1,
    /// A DNS record.
    dkim2: v200-response-item-v3-dns-dkim2,
    /// The CNAME for your sending domain that points to sendgrid.net.
    mail-cname: v200-response-item-v3-dns-mail-cname
  }

  /// A DNS record.
  record v200-response-item-v3-dns-dkim1 {
    /// The DNS record.
    data: string,
    /// The domain that this DNS record was created for.
    host: string,
    /// The type of DNS record.
    type-op: string,
    /// Indicates if this is a valid DNS record.
    valid: bool
  }

  /// A DNS record.
  record v200-response-item-v3-dns-dkim2 {
    /// The DNS record.
    data: string,
    /// The domain that this DNS record was created for.
    host: string,
    /// The type of DNS record.
    type-op: string,
    /// Indicates if this is a valid DNS record.
    valid: bool
  }

  /// The CNAME for your sending domain that points to sendgrid.net.
  record v200-response-item-v3-dns-mail-cname {
    /// The CNAME record.
    data: string,
    /// The domain that this CNAME is created for.
    host: string,
    /// The type of DNS record.
    type-op: string,
    /// Indicates if this is a valid CNAME.
    valid: bool
  }

  record v200-response-item-v3-subusers-item {
    /// The ID of the subuser that this authenticated domain will be associated with.
    user-id: option<s32>,
    /// The username of the subuser that this authenticated domain is associated with.
    username: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-whitelabel-domains-domain-id-response-entry {
    key: string,
    value: string
  }

  record post-whitelabel-domains-id-validate-response {
    /// The ID of the authenticated domain.
    id: option<s32>,
    /// Indicates if this is a valid authenticated domain.
    valid: option<bool>,
    /// The individual DNS records that are checked when validating, including the reason for any invalid DNS records.
    validation-results: option<post-whitelabel-domains-id-validate-response-validation-results>
  }

  /// The individual DNS records that are checked when validating, including the reason for any invalid DNS records.
  record post-whitelabel-domains-id-validate-response-validation-results {
    /// A DNS record for this authenticated domain.
    dkim1: option<post-whitelabel-domains-id-validate-response-validation-results-dkim1>,
    /// A DNS record for this authenticated domain.
    dkim2: option<post-whitelabel-domains-id-validate-response-validation-results-dkim2>,
    /// The CNAME record for the authenticated domain.
    mail-cname: option<post-whitelabel-domains-id-validate-response-validation-results-mail-cname>,
    /// The SPF record for the authenticated domain.
    spf: option<post-whitelabel-domains-id-validate-response-validation-results-spf>
  }

  /// A DNS record for this authenticated domain.
  record post-whitelabel-domains-id-validate-response-validation-results-dkim1 {
    reason: option<string>,
    /// Indicates if the DNS record is valid.
    valid: option<bool>
  }

  /// A DNS record for this authenticated domain.
  record post-whitelabel-domains-id-validate-response-validation-results-dkim2 {
    reason: option<string>,
    /// Indicates if the DNS record is valid.
    valid: option<bool>
  }

  /// The CNAME record for the authenticated domain.
  record post-whitelabel-domains-id-validate-response-validation-results-mail-cname {
    /// The reason this record is invalid.
    reason: option<string>,
    /// Indicates if this DNS record is valid.
    valid: option<bool>
  }

  /// The SPF record for the authenticated domain.
  record post-whitelabel-domains-id-validate-response-validation-results-spf {
    reason: option<string>,
    /// Indicates if the SPF record is valid.
    valid: option<bool>
  }

  variant post-whitelabel-domains-id-validate-error {
    internal-server-error(string),
    other(string)
  }

  /// List all authenticated domains
  record get-whitelabel-domains-params {
    /// Number of domains to return.
    limit: option<s32>,
    /// Paging offset.
    offset: option<s32>,
    /// Exclude subuser domains from the result.
    exclude-subusers: option<bool>,
    /// The username associated with an authenticated domain.
    username: option<string>,
    /// Search for authenticated domains.
    domain: option<string>,
    on-behalf-of: option<string>
  }
  get-whitelabel-domains: func(params: get-whitelabel-domains-params) -> result<list<v200-response-item>, string>;

  /// Authenticate a domain
  record post-whitelabel-domains-params {
    on-behalf-of: option<string>,
    /// Whether to allow SendGrid to manage your SPF records, DKIM keys, and DKIM key rotation.
    automatic-security: option<bool>,
    /// Add a custom DKIM selector. Accepts three letters or numbers.
    custom-dkim-selector: option<string>,
    /// Specify whether to use a custom SPF or allow SendGrid to manage your SPF. This option is only available to authenticated domains set up for manual security.
    custom-spf: option<bool>,
    /// Whether to use this authenticated domain as the fallback if no authenticated domains match the sender's domain.
    default: option<bool>,
    /// Domain being authenticated.
    domain: string,
    /// The IP addresses that will be included in the custom SPF record for this authenticated domain.
    ips: option<list<string>>,
    /// The subdomain to use for this authenticated domain.
    subdomain: option<string>,
    /// The username associated with this domain.
    username: option<string>
  }
  post-whitelabel-domains: func(params: post-whitelabel-domains-params) -> result<authentication-domain, string>;

  /// Get the default authentication
  record get-whitelabel-domains-default-params {
    /// The domain to find a default authentication.
    domain: option<string>,
    on-behalf-of: option<string>
  }
  get-whitelabel-domains-default: func(params: get-whitelabel-domains-default-params) -> result<list<v200-response-item-v2>, string>;

  /// List the authenticated domain associated with the given user.
  record get-whitelabel-domains-subuser-params {
    /// Username for the subuser to find associated authenticated domain.
    username: string
  }
  get-whitelabel-domains-subuser: func(params: get-whitelabel-domains-subuser-params) -> result<domain-spf, string>;

  /// Disassociate an authenticated domain from a given user.
  record delete-whitelabel-domains-subuser-params {
    /// Username for the subuser to find associated authenticated domain.
    username: option<string>
  }
  delete-whitelabel-domains-subuser: func(params: delete-whitelabel-domains-subuser-params) -> result<list<delete-whitelabel-domains-subuser-response-entry>, string>;

  /// Retrieve an authenticated domain
  record get-whitelabel-domains-domain-id-params {
    domain-id: string,
    on-behalf-of: option<string>
  }
  get-whitelabel-domains-domain-id: func(params: get-whitelabel-domains-domain-id-params) -> result<authentication-domain, string>;

  /// Update an authenticated domain
  record patch-whitelabel-domains-domain-id-params {
    domain-id: string,
    on-behalf-of: option<string>,
    /// Indicates whether to generate a custom SPF record for manual security.
    custom-spf: option<bool>,
    /// Indicates whether this is the default authenticated domain.
    default: option<bool>
  }
  patch-whitelabel-domains-domain-id: func(params: patch-whitelabel-domains-domain-id-params) -> result<list<v200-response-item-v3>, string>;

  /// Delete an authenticated domain.
  record delete-whitelabel-domains-domain-id-params {
    domain-id: string,
    on-behalf-of: option<string>
  }
  delete-whitelabel-domains-domain-id: func(params: delete-whitelabel-domains-domain-id-params) -> result<list<delete-whitelabel-domains-domain-id-response-entry>, string>;

  /// Associate an authenticated domain with a given user.
  record post-whitelabel-domains-domain-id-subuser-params {
    /// ID of the authenticated domain to associate with the subuser
    domain-id: string,
    /// Username to associate with the authenticated domain.
    username: string
  }
  post-whitelabel-domains-domain-id-subuser: func(params: post-whitelabel-domains-domain-id-subuser-params) -> result<domain-spf, string>;

  /// Add an IP to an authenticated domain
  record post-whitelabel-domains-id-ips-params {
    /// ID of the domain to which you are adding an IP
    id: string,
    on-behalf-of: option<string>,
    /// IP to associate with the domain. Used for manually specifying IPs for custom SPF.
    ip: string
  }
  post-whitelabel-domains-id-ips: func(params: post-whitelabel-domains-id-ips-params) -> result<domain-spf, string>;

  /// Remove an IP from an authenticated domain.
  record delete-whitelabel-domains-id-ips-ip-params {
    /// ID of the domain to delete the IP from.
    id: string,
    /// IP to remove from the domain.
    ip: string,
    on-behalf-of: option<string>
  }
  delete-whitelabel-domains-id-ips-ip: func(params: delete-whitelabel-domains-id-ips-ip-params) -> result<domain-spf, string>;

  /// Validate a domain authentication.
  record post-whitelabel-domains-id-validate-params {
    /// ID of the domain to validate.
    id: string,
    on-behalf-of: option<string>
  }
  post-whitelabel-domains-id-validate: func(params: post-whitelabel-domains-id-validate-params) -> result<post-whitelabel-domains-id-validate-response, post-whitelabel-domains-id-validate-error>;

}

interface reverse-dns {
  record reverse-dns {
    a-record: reverse-dns-a-record,
    /// The root, or sending, domain.
    domain: string,
    /// The ID of the Reverse DNS.
    id: s32,
    /// The IP address that this Reverse DNS was created for.
    ip: string,
    /// A Unix epoch timestamp representing the last time of a validation attempt.
    last-validation-attempt-at: option<s32>,
    /// Indicates if this Reverse DNS was created using the legacy whitelabel tool. If it is a legacy whitelabel, it will still function, but you'll need to create a new Reverse DNS if you need to update it.
    legacy: bool,
    /// The reverse DNS record for the IP address. This points to the Reverse DNS subdomain.
    rdns: string,
    /// The subdomain created for this reverse DNS. This is where the rDNS record points.
    subdomain: option<string>,
    /// The users who are able to send mail from the IP address.
    users: list<reverse-dns-users-item>,
    /// Indicates if this is a valid Reverse DNS.
    valid: bool
  }

  record reverse-dns-a-record {
    /// The IP address being set up with Reverse DNS.
    data: string,
    /// This is the web address that will be mapped to the IP address.
    host: string,
    /// The type of DNS record.
    type-op: string,
    /// Indicates if the a_record is valid.
    valid: bool
  }

  record reverse-dns-users-item {
    /// The ID of a user who can send mail from the IP address.
    user-id: s32,
    /// The username of a user who can send mail from the IP address.
    username: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-whitelabel-ips-id-response-entry {
    key: string,
    value: string
  }

  record post-whitelabel-ips-id-validate-response {
    /// The ID of the reverse DNS record.
    id: s32,
    /// Indicates if the reverse DNS record is valid.
    valid: bool,
    /// The specific results of the validation.
    validation-results: post-whitelabel-ips-id-validate-response-validation-results
  }

  /// The specific results of the validation.
  record post-whitelabel-ips-id-validate-response-validation-results {
    a-record: option<post-whitelabel-ips-id-validate-response-validation-results-a-record>
  }

  record post-whitelabel-ips-id-validate-response-validation-results-a-record {
    /// The reason the reverse DNS record could not be validated. Is `null` if the reverse DNS record was validated.
    reason: string,
    /// Indicates if the reverse DNS record could be validated.
    valid: bool
  }

  variant post-whitelabel-ips-id-validate-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Retrieve all reverse DNS records
  record get-whitelabel-ips-params {
    /// The maximum number of results to retrieve.
    limit: option<s32>,
    /// The point in the list of results to begin retrieving IP addresses from.
    offset: option<s32>,
    /// The IP address segment that you'd like to use in a prefix search.
    ip: option<string>,
    on-behalf-of: option<string>
  }
  get-whitelabel-ips: func(params: get-whitelabel-ips-params) -> result<list<reverse-dns>, string>;

  /// Set up reverse DNS
  record post-whitelabel-ips-params {
    on-behalf-of: option<string>,
    /// The root, or sending, domain that will be used to send message from the IP address.
    domain: string,
    /// The IP address for which you want to set up reverse DNS.
    ip: string,
    /// The subdomain that will be used to send emails from the IP address. This should be the same as the subdomain used to set up an authenticated domain.
    subdomain: option<string>
  }
  post-whitelabel-ips: func(params: post-whitelabel-ips-params) -> result<reverse-dns, string>;

  /// Retrieve a reverse DNS record
  record get-whitelabel-ips-id-params {
    /// The ID of the reverse DNS record that you would like to retrieve.
    id: string,
    on-behalf-of: option<string>
  }
  get-whitelabel-ips-id: func(params: get-whitelabel-ips-id-params) -> result<reverse-dns, string>;

  /// Delete a reverse DNS record
  record delete-whitelabel-ips-id-params {
    /// The ID of the reverse DNS record that you would like to retrieve.
    id: string,
    on-behalf-of: option<string>
  }
  delete-whitelabel-ips-id: func(params: delete-whitelabel-ips-id-params) -> result<list<delete-whitelabel-ips-id-response-entry>, string>;

  /// Validate a reverse DNS record
  record post-whitelabel-ips-id-validate-params {
    /// The ID of the reverse DNS record that you would like to validate.
    id: string,
    on-behalf-of: option<string>
  }
  post-whitelabel-ips-id-validate: func(params: post-whitelabel-ips-id-validate-params) -> result<post-whitelabel-ips-id-validate-response, post-whitelabel-ips-id-validate-error>;

}

interface link-branding {
  enum v200-response-dns-domain-cname-type-op-enum {
    cname,
    txt,
    mx,
  }

  record v200-response {
    /// Indicates if this is the default link branding.
    default: bool,
    /// The DNS records generated for this link branding.
    dns: v200-response-dns,
    /// The root domain of the branded link.
    domain: string,
    /// The ID of the branded link.
    id: s32,
    /// Indicates if this link branding was created using the legacy whitelabel tool. If it is a legacy whitelabel, it will still function, but you'll need to create new link branding if you need to update it.
    legacy: bool,
    /// The subdomain used to generate the DNS records for this link branding. This subdomain must be different from the subdomain used for your authenticated domain.
    subdomain: option<string>,
    /// The ID of the user that this link branding is associated with.
    user-id: s32,
    /// The username of the account that this link branding is associated with.
    username: string,
    /// Indicates if this link branding is valid.
    valid: bool
  }

  /// The DNS records generated for this link branding.
  record v200-response-dns {
    /// The DNS record generated to point to your link branding subdomain.
    domain-cname: v200-response-dns-domain-cname,
    /// The DNS record generated to verify who created the link branding.
    owner-cname: option<v200-response-dns-owner-cname>
  }

  /// The DNS record generated to point to your link branding subdomain.
  record v200-response-dns-domain-cname {
    /// The domain that the DNS record points to.
    data: string,
    /// The domain that this link branding will use for the links in your email.
    host: string,
    /// The type of DNS record that was generated.
    type-op: v200-response-dns-domain-cname-type-op-enum,
    /// Indicates if the DNS record is valid.
    valid: bool
  }

  /// The DNS record generated to verify who created the link branding.
  record v200-response-dns-owner-cname {
    /// The domain that the DNS record points to.
    data: string,
    /// Used to verify the link branding. The subdomain of this domain is the ID of the user who created the link branding.
    host: string,
    /// The type of DNS record generated.
    type-op: option<v200-response-dns-domain-cname-type-op-enum>,
    /// Indicates if the DNS record is valid.
    valid: bool
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-whitelabel-links-subuser-response-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-whitelabel-links-id-response-entry {
    key: string,
    value: string
  }

  record post-whitelabel-links-id-validate-response {
    /// The ID of the branded link.
    id: s32,
    /// Indicates if the link branding is valid.
    valid: bool,
    /// The individual validation results for each of the DNS records associated with this branded link.
    validation-results: post-whitelabel-links-id-validate-response-validation-results
  }

  /// The individual validation results for each of the DNS records associated with this branded link.
  record post-whitelabel-links-id-validate-response-validation-results {
    /// The DNS record generated for the sending domain used for this branded link.
    domain-cname: post-whitelabel-links-id-validate-response-validation-results-domain-cname,
    /// The DNS record created to verify the branded link.
    owner-cname: option<post-whitelabel-links-id-validate-response-validation-results-owner-cname>
  }

  /// The DNS record generated for the sending domain used for this branded link.
  record post-whitelabel-links-id-validate-response-validation-results-domain-cname {
    /// Null if the DNS record is valid. If the DNS record is invalid, this will explain why.
    reason: string,
    /// Indicates if this DNS record is valid.
    valid: bool
  }

  /// The DNS record created to verify the branded link.
  record post-whitelabel-links-id-validate-response-validation-results-owner-cname {
    /// Null if valid. If the DNS record is invalid, this will explain why.
    reason: string,
    /// Indicates if the DNS record is valid.
    valid: bool
  }

  variant post-whitelabel-links-id-validate-error {
    internal-server-error(string),
    other(string)
  }

  /// Retrieve all branded links
  record get-whitelabel-links-params {
    /// Limits the number of results returned per page.
    limit: option<s32>,
    on-behalf-of: option<string>
  }
  get-whitelabel-links: func(params: get-whitelabel-links-params) -> result<list<v200-response>, string>;

  /// Create a branded link
  record post-whitelabel-links-params {
    on-behalf-of: option<string>,
    /// Indicates if you want to use this link branding as the default or fallback. When setting a new default, the existing default link branding will have its default status removed automatically.
    default: option<bool>,
    /// The root domain for the subdomain that you are creating the link branding for. This should match your FROM email address.
    domain: string,
    /// The subdomain to create the link branding for. Must be different from the subdomain you used for authenticating your domain.
    subdomain: option<string>
  }
  post-whitelabel-links: func(params: post-whitelabel-links-params) -> result<v200-response, string>;

  /// Retrieve the default branded link
  record get-whitelabel-links-default-params {
    /// The domain to match against when finding the default branded link.
    domain: option<string>,
    on-behalf-of: option<string>
  }
  get-whitelabel-links-default: func(params: get-whitelabel-links-default-params) -> result<v200-response, string>;

  /// Retrieve a subuser's branded link
  record get-whitelabel-links-subuser-params {
    /// The username of the subuser to retrieve associated branded links for.
    username: string
  }
  get-whitelabel-links-subuser: func(params: get-whitelabel-links-subuser-params) -> result<v200-response, string>;

  /// Disassociate a branded link from a subuser
  record delete-whitelabel-links-subuser-params {
    /// The username of the subuser account that you want to disassociate a branded link from.
    username: string
  }
  delete-whitelabel-links-subuser: func(params: delete-whitelabel-links-subuser-params) -> result<list<delete-whitelabel-links-subuser-response-entry>, string>;

  /// Retrieve a branded link
  record get-whitelabel-links-id-params {
    /// The ID of the branded link you want to retrieve.
    id: string,
    on-behalf-of: option<string>
  }
  get-whitelabel-links-id: func(params: get-whitelabel-links-id-params) -> result<v200-response, string>;

  /// Update a branded link
  record patch-whitelabel-links-id-params {
    /// The ID of the branded link you want to retrieve.
    id: string,
    on-behalf-of: option<string>,
    /// Indicates if the branded link is set as the default. When setting a new default, the existing default link branding will have its default status removed automatically.
    default: option<bool>
  }
  patch-whitelabel-links-id: func(params: patch-whitelabel-links-id-params) -> result<v200-response, string>;

  /// Delete a branded link
  record delete-whitelabel-links-id-params {
    /// The ID of the branded link you want to retrieve.
    id: string,
    on-behalf-of: option<string>
  }
  delete-whitelabel-links-id: func(params: delete-whitelabel-links-id-params) -> result<list<delete-whitelabel-links-id-response-entry>, string>;

  /// Validate a branded link
  record post-whitelabel-links-id-validate-params {
    /// The ID of the branded link that you want to validate.
    id: string,
    on-behalf-of: option<string>
  }
  post-whitelabel-links-id-validate: func(params: post-whitelabel-links-id-validate-params) -> result<post-whitelabel-links-id-validate-response, post-whitelabel-links-id-validate-error>;

  /// Associate a branded link with a subuser
  record post-whitelabel-links-link-id-subuser-params {
    /// The ID of the branded link you want to associate.
    link-id: string,
    /// The username of the subuser account that you want to associate the branded link with.
    username: option<string>
  }
  post-whitelabel-links-link-id-subuser: func(params: post-whitelabel-links-link-id-subuser-params) -> result<v200-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
