    on-behalf-of: option<string>
  }
  post-whitelabel-links-id-validate: func(params: post-whitelabel-links-id-validate-params) -> result<string, string>;

  /// Associate a branded link with a subuser
  record post-whitelabel-links-link-id-subuser-params {
    /// The username of the subuser account that you want to associate the branded link with.
    username: option<string>
  }
  post-whitelabel-links-link-id-subuser: func(params: post-whitelabel-links-link-id-subuser-params) -> result<string, string>;

}
