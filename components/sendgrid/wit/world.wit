interface ip-warmup {
  /// Retrieve all IPs currently in warmup
  get-ips-warmup: func() -> result<string, string>;

  /// Start warming up an IP address
  record post-ips-warmup-params {
    /// The IP address that you want to begin warming up.
    ip: option<string>
  }
  post-ips-warmup: func(params: post-ips-warmup-params) -> result<string, string>;

  /// Retrieve the warmup status for a specific IP address
  get-ips-warmup-ip-address: func() -> result<string, string>;

  /// Stop warming up an IP address
  delete-ips-warmup-ip-address: func() -> result<string, string>;

}

interface cancel-scheduled-sends {
  enum post-user-scheduled-sends-body-status-enum {
    pause,
    cancel,
  }

  enum patch-user-scheduled-sends-batch-id-body-status-enum {
    cancel,
    pause,
  }

  /// Create a batch ID
  record post-mail-batch-params {
    on-behalf-of: option<string>
  }
  post-mail-batch: func(params: post-mail-batch-params) -> result<string, string>;

  /// Validate batch ID
  record get-mail-batch-batch-id-params {
    on-behalf-of: option<string>
  }
  get-mail-batch-batch-id: func(params: get-mail-batch-batch-id-params) -> result<string, string>;

  /// Retrieve all scheduled sends
  record get-user-scheduled-sends-params {
    on-behalf-of: option<string>
  }
  get-user-scheduled-sends: func(params: get-user-scheduled-sends-params) -> result<string, string>;

  /// Cancel or pause a scheduled send
  record post-user-scheduled-sends-params {
    on-behalf-of: option<string>,
    /// The batch ID is the identifier that your scheduled mail sends share.
    batch-id: string,
    /// The status of the send you would like to implement. This can be pause or cancel. To delete a pause or cancel status see DELETE /v3/user/scheduled_sends/{batch_id}
    status: post-user-scheduled-sends-body-status-enum
  }
  post-user-scheduled-sends: func(params: post-user-scheduled-sends-params) -> result<string, string>;

  /// Retrieve scheduled send
  record get-user-scheduled-sends-batch-id-params {
    on-behalf-of: option<string>
  }
  get-user-scheduled-sends-batch-id: func(params: get-user-scheduled-sends-batch-id-params) -> result<string, string>;

  /// Update a scheduled send
  record patch-user-scheduled-sends-batch-id-params {
    on-behalf-of: option<string>,
    /// The status you would like the scheduled send to have.
    status: patch-user-scheduled-sends-batch-id-body-status-enum
  }
  patch-user-scheduled-sends-batch-id: func(params: patch-user-scheduled-sends-batch-id-params) -> result<string, string>;

  /// Delete a cancellation or pause from a scheduled send
  record delete-user-scheduled-sends-batch-id-params {
    on-behalf-of: option<string>
  }
  delete-user-scheduled-sends-batch-id: func(params: delete-user-scheduled-sends-batch-id-params) -> result<string, string>;

}

interface mail-send {
  enum post-mail-send-body-attachments-item-disposition-enum {
    inline,
    attachment,
  }

  /// An object allowing you to specify how to handle unsubscribes.
  record post-mail-send-body-asm {
    /// The unsubscribe group to associate with this email.
    group-id: s32,
    /// An array containing the unsubscribe groups that you would like to be displayed on the unsubscribe preferences page.
    groups-to-display: option<list<s32>>
  }

  record post-mail-send-body-attachments-item {
    /// The Base64 encoded content of the attachment.
    content: string,
    /// The attachment's content ID. This is used when the disposition is set to `“inline”` and the attachment is an image, allowing the file to be displayed within the body of your email.
    content-id: option<string>,
    /// The attachment's content-disposition, specifying how you would like the attachment to be displayed. For example, `“inline”` results in the attached file are displayed automatically within the message while `“attachment”` results in the attached file require some action to be taken before it is displayed, such as opening or downloading the file.
    disposition: option<post-mail-send-body-attachments-item-disposition-enum>,
    /// The attachment's filename.
    filename: string,
    /// The MIME type of the content you are attaching (e.g., `“text/plain”` or `“text/html”`).
    type-op: option<string>
  }

  record post-mail-send-body-content-item {
    /// The MIME type of the content you are including in your email (e.g., `“text/plain”` or `“text/html”`).
    type-op: string,
    /// The actual content of the specified MIME type that you are including in your email.
    value: string
  }

  record from-email-object {
    /// The 'From' email address used to deliver the message. This address should be a verified sender in your Twilio SendGrid account.
    email: string,
    /// A name or title associated with the sending email address.
    name: option<string>
  }

  /// An object containing key/value pairs of header names and the value to substitute for them. The key/value pairs must be strings. You must ensure these are properly encoded if they contain unicode characters. These headers cannot be one of the reserved headers.
  record post-mail-send-body-headers {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A collection of different mail settings that you can use to specify how you would like this email to be handled.
  record post-mail-send-body-mail-settings {
    /// Allows you to bypass the bounce list to ensure that the email is delivered to recipients. Spam report and unsubscribe lists will still be checked; addresses on these other lists will not receive the message. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
    bypass-bounce-management: option<post-mail-send-body-mail-settings-bypass-bounce-management>,
    /// Allows you to bypass all unsubscribe groups and suppressions to ensure that the email is delivered to every single recipient. This should only be used in emergencies when it is absolutely necessary that every recipient receives your email. This filter cannot be combined with any other bypass filters. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
    bypass-list-management: option<post-mail-send-body-mail-settings-bypass-list-management>,
    /// Allows you to bypass the spam report list to ensure that the email is delivered to recipients. Bounce and unsubscribe lists will still be checked; addresses on these other lists will not receive the message. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
    bypass-spam-management: option<post-mail-send-body-mail-settings-bypass-spam-management>,
    /// Allows you to bypass the global unsubscribe list to ensure that the email is delivered to recipients. Bounce and spam report lists will still be checked; addresses on these other lists will not receive the message. This filter applies only to global unsubscribes and will not bypass group unsubscribes. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
    bypass-unsubscribe-management: option<post-mail-send-body-mail-settings-bypass-unsubscribe-management>,
    /// The default footer that you would like included on every email.
    footer: option<post-mail-send-body-mail-settings-footer>,
    /// Sandbox Mode allows you to send a test email to ensure that your request body is valid and formatted correctly.
    sandbox-mode: option<post-mail-send-body-mail-settings-sandbox-mode>
  }

  /// Allows you to bypass the bounce list to ensure that the email is delivered to recipients. Spam report and unsubscribe lists will still be checked; addresses on these other lists will not receive the message. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
  record post-mail-send-body-mail-settings-bypass-bounce-management {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  /// Allows you to bypass all unsubscribe groups and suppressions to ensure that the email is delivered to every single recipient. This should only be used in emergencies when it is absolutely necessary that every recipient receives your email. This filter cannot be combined with any other bypass filters. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
  record post-mail-send-body-mail-settings-bypass-list-management {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  /// Allows you to bypass the spam report list to ensure that the email is delivered to recipients. Bounce and unsubscribe lists will still be checked; addresses on these other lists will not receive the message. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
  record post-mail-send-body-mail-settings-bypass-spam-management {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  /// Allows you to bypass the global unsubscribe list to ensure that the email is delivered to recipients. Bounce and spam report lists will still be checked; addresses on these other lists will not receive the message. This filter applies only to global unsubscribes and will not bypass group unsubscribes. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
  record post-mail-send-body-mail-settings-bypass-unsubscribe-management {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  /// The default footer that you would like included on every email.
  record post-mail-send-body-mail-settings-footer {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// The HTML content of your footer.
    html: option<string>,
    /// The plain text content of your footer.
    text: option<string>
  }

  /// Sandbox Mode allows you to send a test email to ensure that your request body is valid and formatted correctly.
  record post-mail-send-body-mail-settings-sandbox-mode {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  record post-mail-send-body-personalizations-item {
    /// An array of recipients who will receive a blind carbon copy of your email. Each object in this array must contain the recipient's email address. Each object in the array may optionally contain the recipient's name.
    bcc: option<list<cc-bcc-email-object>>,
    /// An array of recipients who will receive a copy of your email. Each object in this array must contain the recipient's email address. Each object in the array may optionally contain the recipient's name.
    cc: option<list<cc-bcc-email-object>>,
    /// Values that are specific to this personalization that will be carried along with the email and its activity data. Substitutions will not be made on custom arguments, so any string that is entered into this parameter will be assumed to be the custom argument that you would like to be used. This field may not exceed 10,000 bytes.
    custom-args: option<post-mail-send-body-personalizations-item-custom-args>,
    /// Dynamic template data is available using Handlebars syntax in Dynamic Transactional Templates. This field should be used in combination with a Dynamic Transactional Template, which can be identified by a `template_id` starting with `d-`. This field is a collection of key/value pairs following the pattern "variable_name":"value to insert".
    dynamic-template-data: option<post-mail-send-body-personalizations-item-dynamic-template-data>,
    from-op: option<from-email-object>,
    /// A collection of JSON key/value pairs allowing you to specify handling instructions for your email. You may not overwrite the following headers: `x-sg-id`, `x-sg-eid`, `received`, `dkim-signature`, `Content-Type`, `Content-Transfer-Encoding`, `To`, `From`, `Subject`, `Reply-To`, `CC`, `BCC`
    headers: option<post-mail-send-body-personalizations-item-headers>,
    /// A unix timestamp allowing you to specify when your email should be delivered. Scheduling delivery more than 72 hours in advance is forbidden.
    send-at: option<s32>,
    /// The subject of your email. See character length requirements according to [RFC 2822](http://stackoverflow.com/questions/1592291/what-is-the-email-subject-length-limit#answer-1592310).
    subject: option<string>,
    /// Substitutions allow you to insert data without using Dynamic Transactional Templates. This field should **not** be used in combination with a Dynamic Transactional Template, which can be identified by a `template_id` starting with `d-`. This field is a collection of key/value pairs following the pattern "substitution_tag":"value to substitute". The key/value pairs must be strings. These substitutions will apply to the text and html content of the body of your email, in addition to the `subject` and `reply-to` parameters. The total collective size of your substitutions may not exceed 10,000 bytes per personalization object.
    substitutions: option<post-mail-send-body-personalizations-item-substitutions>,
    to: to-email-array
  }

  record cc-bcc-email-object {
    /// The intended recipient's email address.
    email: string,
    /// The intended recipient's name.
    name: option<string>
  }

  /// Values that are specific to this personalization that will be carried along with the email and its activity data. Substitutions will not be made on custom arguments, so any string that is entered into this parameter will be assumed to be the custom argument that you would like to be used. This field may not exceed 10,000 bytes.
  record post-mail-send-body-personalizations-item-custom-args {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Dynamic template data is available using Handlebars syntax in Dynamic Transactional Templates. This field should be used in combination with a Dynamic Transactional Template, which can be identified by a `template_id` starting with `d-`. This field is a collection of key/value pairs following the pattern "variable_name":"value to insert".
  record post-mail-send-body-personalizations-item-dynamic-template-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A collection of JSON key/value pairs allowing you to specify handling instructions for your email. You may not overwrite the following headers: `x-sg-id`, `x-sg-eid`, `received`, `dkim-signature`, `Content-Type`, `Content-Transfer-Encoding`, `To`, `From`, `Subject`, `Reply-To`, `CC`, `BCC`
  record post-mail-send-body-personalizations-item-headers {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Substitutions allow you to insert data without using Dynamic Transactional Templates. This field should **not** be used in combination with a Dynamic Transactional Template, which can be identified by a `template_id` starting with `d-`. This field is a collection of key/value pairs following the pattern "substitution_tag":"value to substitute". The key/value pairs must be strings. These substitutions will apply to the text and html content of the body of your email, in addition to the `subject` and `reply-to` parameters. The total collective size of your substitutions may not exceed 10,000 bytes per personalization object.
  record post-mail-send-body-personalizations-item-substitutions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record to-email-array {
    /// opaque schema; raw JSON
    value: string
  }

  record reply-to-email-object {
    /// The email address where any replies or bounces will be returned.
    email: string,
    /// A name or title associated with the `reply_to` email address.
    name: option<string>
  }

  record post-mail-send-body-reply-to-list-item {
    /// The email address where any replies or bounces will be returned.
    email: string,
    /// A name or title associated with the `reply_to_list` email address.
    name: option<string>
  }

  /// Settings to determine how you would like to track the metrics of how your recipients interact with your email.
  record post-mail-send-body-tracking-settings {
    /// Allows you to track if a recipient clicked a link in your email.
    click-tracking: option<post-mail-send-body-tracking-settings-click-tracking>,
    /// Allows you to enable tracking provided by Google Analytics.
    ganalytics: option<post-mail-send-body-tracking-settings-ganalytics>,
    /// Allows you to track if the email was opened by including a single pixel image in the body of the content. When the pixel is loaded, Twilio SendGrid can log that the email was opened.
    open-tracking: option<post-mail-send-body-tracking-settings-open-tracking>,
    /// Allows you to insert a subscription management link at the bottom of the text and HTML bodies of your email. If you would like to specify the location of the link within your email, you may use the `substitution_tag`.
    subscription-tracking: option<post-mail-send-body-tracking-settings-subscription-tracking>
  }

  /// Allows you to track if a recipient clicked a link in your email.
  record post-mail-send-body-tracking-settings-click-tracking {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// Indicates if this setting should be included in the `text/plain` portion of your email.
    enable-text: option<bool>
  }

  /// Allows you to enable tracking provided by Google Analytics.
  record post-mail-send-body-tracking-settings-ganalytics {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// The name of the campaign.
    utm-campaign: option<string>,
    /// Used to differentiate your campaign from advertisements.
    utm-content: option<string>,
    /// Name of the marketing medium. (e.g. Email)
    utm-medium: option<string>,
    /// Name of the referrer source. (e.g. Google, SomeDomain.com, or Marketing Email)
    utm-source: option<string>,
    /// Used to identify any paid keywords.
    utm-term: option<string>
  }

  /// Allows you to track if the email was opened by including a single pixel image in the body of the content. When the pixel is loaded, Twilio SendGrid can log that the email was opened.
  record post-mail-send-body-tracking-settings-open-tracking {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// Allows you to specify a substitution tag that you can insert in the body of your email at a location that you desire. This tag will be replaced by the open tracking pixel.
    substitution-tag: option<string>
  }

  /// Allows you to insert a subscription management link at the bottom of the text and HTML bodies of your email. If you would like to specify the location of the link within your email, you may use the `substitution_tag`.
  record post-mail-send-body-tracking-settings-subscription-tracking {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// HTML to be appended to the email with the subscription tracking link. You may control where the link is by using the tag <% %>
    html: option<string>,
    /// A tag that will be replaced with the unsubscribe URL. for example: `[unsubscribe_url]`. If this parameter is used, it will override both the `text` and `html` parameters. The URL of the link will be placed at the substitution tag’s location with no additional formatting.
    substitution-tag: option<string>,
    /// Text to be appended to the email with the subscription tracking link. You may control where the link is by using the tag <% %>
    text: option<string>
  }

  /// v3 Mail Send
  record post-mail-send-params {
    /// An object allowing you to specify how to handle unsubscribes.
    asm: option<post-mail-send-body-asm>,
    /// An array of objects where you can specify any attachments you want to include.
    attachments: option<list<post-mail-send-body-attachments-item>>,
    /// An ID representing a batch of emails to be sent at the same time. Including a `batch_id` in your request allows you include this email in that batch. It also enables you to cancel or pause the delivery of that batch. For more information, see the [Cancel Scheduled Sends API](https://sendgrid.com/docs/api-reference/).
    batch-id: option<string>,
    /// An array of category names for this message. Each category name may not exceed 255 characters. 
    categories: option<list<string>>,
    /// An array where you can specify the content of your email. You can include multiple [MIME types](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types) of content, but you must specify at least one MIME type. To include more than one MIME type, add another object to the array containing the `type` and `value` parameters.
    content: list<post-mail-send-body-content-item>,
    /// Values that are specific to the entire send that will be carried along with the email and its activity data.  Key/value pairs must be strings. Substitutions will not be made on custom arguments, so any string that is entered into this parameter will be assumed to be the custom argument that you would like to be used. This parameter is overridden by `custom_args` set at the personalizations level. Total `custom_args` size may not exceed 10,000 bytes.
    custom-args: option<string>,
    from-op: from-email-object,
    /// An object containing key/value pairs of header names and the value to substitute for them. The key/value pairs must be strings. You must ensure these are properly encoded if they contain unicode characters. These headers cannot be one of the reserved headers.
    headers: option<post-mail-send-body-headers>,
    /// The IP Pool that you would like to send this email from.
    ip-pool-name: option<string>,
    /// A collection of different mail settings that you can use to specify how you would like this email to be handled.
    mail-settings: option<post-mail-send-body-mail-settings>,
    /// An array of messages and their metadata. Each object within personalizations can be thought of as an envelope - it defines who should receive an individual message and how that message should be handled. See our [Personalizations documentation](https://sendgrid.com/docs/for-developers/sending-email/personalizations/) for examples.
    personalizations: list<post-mail-send-body-personalizations-item>,
    reply-to: option<reply-to-email-object>,
    /// An array of recipients who will receive replies and/or bounces. Each object in this array must contain the recipient's email address. Each object in the array may optionally contain the recipient's name. You can either choose to use “reply_to” field or “reply_to_list” but not both.
    reply-to-list: option<list<post-mail-send-body-reply-to-list-item>>,
    /// A unix timestamp allowing you to specify when you want your email to be delivered. This may be overridden by the `send_at` parameter set at the personalizations level. Delivery cannot be scheduled more than 72 hours in advance. If you have the flexibility, it's better to schedule mail for off-peak times. Most emails are scheduled and sent at the top of the hour or half hour. Scheduling email to avoid peak times — for example, scheduling at 10:53 — can result in lower deferral rates due to the reduced traffic during off-peak times.
    send-at: option<s32>,
    /// The global or 'message level' subject of your email. This may be overridden by subject lines set in personalizations.
    subject: string,
    /// An email template ID. A template that contains a subject and content — either text or html — will override any subject and content values specified at the personalizations or message level.
    template-id: option<string>,
    /// Settings to determine how you would like to track the metrics of how your recipients interact with your email.
    tracking-settings: option<post-mail-send-body-tracking-settings>
  }
  post-mail-send: func(params: post-mail-send-params) -> result<string, string>;

}

interface settings-mail {
  /// Retrieve all mail settings
  record get-mail-settings-params {
    /// The number of settings to return.
    limit: option<s32>,
    /// Where in the list of results to begin displaying settings.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-mail-settings: func(params: get-mail-settings-params) -> result<string, string>;

  /// Retrieve address whitelist mail settings
  record get-mail-settings-address-whitelist-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-address-whitelist: func(params: get-mail-settings-address-whitelist-params) -> result<string, string>;

  /// Update address whitelist mail settings
  record patch-mail-settings-address-whitelist-params {
    on-behalf-of: option<string>,
    /// Indicates if your email address whitelist is enabled.
    enabled: option<bool>,
    /// Either a single email address that you want whitelisted or a domain, for which all email addresses belonging to this domain will be whitelisted.
    list-op: option<list<string>>
  }
  patch-mail-settings-address-whitelist: func(params: patch-mail-settings-address-whitelist-params) -> result<string, string>;

  /// Retrieve bounce purge mail settings
  record get-mail-settings-bounce-purge-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-bounce-purge: func(params: get-mail-settings-bounce-purge-params) -> result<string, string>;

  /// Update bounce purge mail settings
  record patch-mail-settings-bounce-purge-params {
    on-behalf-of: option<string>,
    /// Indicates if the bounce purge mail setting is enabled.
    enabled: option<bool>,
    /// The number of days after which SendGrid will purge all contacts from your hard bounces suppression lists.
    hard-bounces: option<s32>,
    /// The number of days after which SendGrid will purge all contacts from your soft bounces suppression lists.
    soft-bounces: option<s32>
  }
  patch-mail-settings-bounce-purge: func(params: patch-mail-settings-bounce-purge-params) -> result<string, string>;

  /// Retrieve footer mail settings
  record get-mail-settings-footer-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-footer: func(params: get-mail-settings-footer-params) -> result<string, string>;

  /// Update footer mail settings
  record patch-mail-settings-footer-params {
    on-behalf-of: option<string>,
    /// Indicates if the Footer mail setting is currently enabled.
    enabled: option<bool>,
    /// The custom HTML content of your email footer.
    html-content: option<string>,
    /// The plain text content of your email footer.
    plain-content: option<string>
  }
  patch-mail-settings-footer: func(params: patch-mail-settings-footer-params) -> result<string, string>;

  /// Retrieve forward bounce mail settings
  record get-mail-settings-forward-bounce-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-forward-bounce: func(params: get-mail-settings-forward-bounce-params) -> result<string, string>;

  /// Update forward bounce mail settings
  record patch-mail-settings-forward-bounce-params {
    on-behalf-of: option<string>,
    /// The email address that you would like your bounce reports forwarded to.
    email: option<string>,
    /// Indicates if the bounce forwarding mail setting is enabled.
    enabled: option<bool>
  }
  patch-mail-settings-forward-bounce: func(params: patch-mail-settings-forward-bounce-params) -> result<string, string>;

  /// Retrieve forward spam mail settings
  record get-mail-settings-forward-spam-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-forward-spam: func(params: get-mail-settings-forward-spam-params) -> result<string, string>;

  /// Update forward spam mail settings
  record patch-mail-settings-forward-spam-params {
    on-behalf-of: option<string>,
    /// The email address where you would like the spam reports to be forwarded.
    email: option<string>,
    /// Indicates if the Forward Spam setting is enabled.
    enabled: option<bool>
  }
  patch-mail-settings-forward-spam: func(params: patch-mail-settings-forward-spam-params) -> result<string, string>;

  /// Retrieve legacy template mail settings
  record get-mail-settings-template-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-template: func(params: get-mail-settings-template-params) -> result<string, string>;

  /// Update template mail settings
  record patch-mail-settings-template-params {
    on-behalf-of: option<string>,
    /// Indicates if you want to enable the legacy email template mail setting.
    enabled: option<bool>,
    /// The new HTML content for your legacy email template.
    html-content: option<string>
  }
  patch-mail-settings-template: func(params: patch-mail-settings-template-params) -> result<string, string>;

}

interface contacts {
  enum post-mc-contacts-exports-body-file-type-enum {
    csv,
    json,
  }

  enum put-mc-contacts-imports-body-file-type-enum {
    csv,
  }

  record contact-request {
    /// The first line of the address.
    address-line-v1: option<string>,
    /// An optional second line for the address.
    address-line-v2: option<string>,
    /// Additional emails associated with the contact.
    alternate-emails: option<list<string>>,
    /// The contact's city.
    city: option<string>,
    /// The contact's country. Can be a full name or an abbreviation.
    country: option<string>,
    custom-fields: option<custom-fields-by-id>,
    /// The contact's primary email. This is required to be a valid email.
    email: string,
    /// The contact's personal name.
    first-name: option<string>,
    /// The contact's family name.
    last-name: option<string>,
    /// The contact's ZIP code or other postal code.
    postal-code: option<string>,
    /// The contact's state, province, or region.
    state-province-region: option<string>
  }

  record custom-fields-by-id {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-mc-contacts-exports-body-notifications {
    email: option<bool>
  }

  /// Get Sample Contacts
  get-mc-contats: func() -> result<string, string>;

  /// Add or Update a Contact
  record put-mc-contacts-params {
    /// One or more contacts objects that you intend to upsert. The available fields for a contact, including the required `email` field are described below.
    contacts: list<contact-request>,
    /// An array of List ID strings that this contact will be added to.
    list-ids: option<list<string>>
  }
  put-mc-contacts: func(params: put-mc-contacts-params) -> result<string, string>;

  /// Delete Contacts
  record delete-mc-contacts-params {
    /// Must be set to `"true"` to delete all contacts.
    delete-all-contacts: option<string>,
    /// A comma-separated list of contact IDs.
    ids: option<string>
  }
  delete-mc-contacts: func(params: delete-mc-contacts-params) -> result<string, string>;

  /// Get Batched Contacts by IDs
  record post-marketing-contacts-batch-params {
    ids: list<string>
  }
  post-marketing-contacts-batch: func(params: post-marketing-contacts-batch-params) -> result<string, string>;

  /// Get Total Contact Count
  get-mc-contacts-count: func() -> result<string, string>;

  /// Get All Existing Exports
  get-marketing-contacts-exports: func() -> result<string, string>;

  /// Export Contacts
  record post-mc-contacts-exports-params {
    /// File type for export file. Choose from `json` or `csv`.
    file-type: option<post-mc-contacts-exports-body-file-type-enum>,
    /// IDs of the contact lists you want to export.
    list-ids: option<list<string>>,
    /// The maximum size of an export file in MB. Note that when this option is specified, multiple output files may be returned from the export.
    max-file-size: option<s32>,
    notifications: option<post-mc-contacts-exports-body-notifications>,
    /// IDs of the contact segments you want to export.
    segment-ids: option<list<string>>
  }
  post-mc-contacts-exports: func(params: post-mc-contacts-exports-params) -> result<string, string>;

  /// Export Contacts Status
  get-mc-contacts-exports-id: func() -> result<string, string>;

  /// Import Contacts
  record put-mc-contacts-imports-params {
    /// Import file header to reserved/custom field mapping.
    field-mappings: list<string>,
    /// Upload file type.
    file-type: put-mc-contacts-imports-body-file-type-enum,
    /// All contacts will be added to each of the specified lists.
    list-ids: option<list<string>>
  }
  put-mc-contacts-imports: func(params: put-mc-contacts-imports-params) -> result<string, string>;

  /// Import Contacts Status
  get-marketing-contacts-imports-id: func() -> result<string, string>;

  /// Search Contacts
  record post-mc-contacts-search-params {
    query: string
  }
  post-mc-contacts-search: func(params: post-mc-contacts-search-params) -> result<string, string>;

  /// Get Contacts by Emails
  record post-marketing-contacts-search-emails-params {
    /// One or more primary emails and/or alternate emails to search through your contacts for.
    emails: list<string>
  }
  post-marketing-contacts-search-emails: func(params: post-marketing-contacts-search-emails-params) -> result<string, string>;

  /// Get a Contact by ID
  get-mc-contacts-id: func() -> result<string, string>;

}

interface custom-fields {
  enum post-mc-field-definitions-body-field-type-enum {
    text,
    number,
    date,
  }

  /// Get All Field Definitions
  get-mc-field-definitions: func() -> result<string, string>;

  /// Create Custom Field Definition
  record post-mc-field-definitions-params {
    field-type: post-mc-field-definitions-body-field-type-enum,
    name: string
  }
  post-mc-field-definitions: func(params: post-mc-field-definitions-params) -> result<string, string>;

  /// Update Custom Field Definition
  record patch-mc-field-definitions-custom-field-id-params {
    name: string
  }
  patch-mc-field-definitions-custom-field-id: func(params: patch-mc-field-definitions-custom-field-id-params) -> result<string, string>;

  /// Delete Custom Field Definition
  delete-mc-field-definitions-custom-field-id: func() -> result<string, string>;

}

interface lists {
  /// Get All Lists
  record get-mc-lists-params {
    /// Maximum number of elements to return. Defaults to 100, returns 1000 max
    page-size: option<f64>,
    page-token: option<string>
  }
  get-mc-lists: func(params: get-mc-lists-params) -> result<string, string>;

  /// Create List
  record post-mc-lists-params {
    /// Your name for your list
    name: string
  }
  post-mc-lists: func(params: post-mc-lists-params) -> result<string, string>;

  /// Get a List by ID
  record get-mc-lists-id-params {
    /// Setting this parameter to the true  will cause the contact_sample to be returned
    contact-sample: option<bool>
  }
  get-mc-lists-id: func(params: get-mc-lists-id-params) -> result<string, string>;

  /// Update List
  record patch-mc-lists-id-params {
    /// Your name for your list.
    name: option<string>
  }
  patch-mc-lists-id: func(params: patch-mc-lists-id-params) -> result<string, string>;

  /// Delete a list
  record delete-lists-id-params {
    /// Flag indicates that all contacts on the list are also to be deleted.
    delete-contacts: option<bool>
  }
  delete-lists-id: func(params: delete-lists-id-params) -> result<string, string>;

  /// Remove Contacts from a List
  record delete-mc-lists-id-contacts-params {
    /// comma separated list of contact ids
    contact-ids: string
  }
  delete-mc-lists-id-contacts: func(params: delete-mc-lists-id-contacts-params) -> result<string, string>;

  /// Get List Contact Count
  get-mc-lists-id-contacts-count: func() -> result<string, string>;

}

interface segmenting-contacts {
  /// Get List of Segments
  record get-marketing-segments-params {
    /// A comma separated list of list ids to be used when searching for segments with the specified parent_list_id, no more than 50 is allowed
    parent-list-ids: option<string>,
    /// If set to `true` segments with an empty value of `parent_list_id` will be returned in the filter.  If the value is not present it defaults to 'false'.
    no-parent-list-id: option<bool>
  }
  get-marketing-segments: func(params: get-marketing-segments-params) -> result<string, string>;

  /// Create Segment
  record post-marketing-segments-params {
    body: option<string>
  }
  post-marketing-segments: func(params: post-marketing-segments-params) -> result<string, string>;

  /// Bulk Delete Segments
  record post-marketing-segments-delete-params {
    ids: option<list<string>>
  }
  post-marketing-segments-delete: func(params: post-marketing-segments-delete-params) -> result<string, string>;

  /// Get Segment by ID
  record get-marketing-segments-segment-id-params {
    /// Defaults to `false`.  Set to `true` to return the parsed SQL AST as a JSON object in the field `query_json`
    query-json: option<bool>
  }
  get-marketing-segments-segment-id: func(params: get-marketing-segments-segment-id-params) -> result<string, string>;

  /// Update Segment
  record patch-marketing-segments-segment-id-params {
    /// Name of the segment.
    name: string,
    /// The array of list ids to filter contacts on when building this segment. It allows only one such list id for now. We will support more in future
    parent-list-ids: option<list<string>>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: string
  }
  patch-marketing-segments-segment-id: func(params: patch-marketing-segments-segment-id-params) -> result<string, string>;

  /// Delete Segment
  delete-marketing-segments-segment-id: func() -> result<string, string>;

}

interface segmenting-contacts-v2-beta {
  /// Get List of Segments
  record get-segments-params {
    /// A comma separated list up to 50 in size, to filter segments on.  Only segments that have any of these list ids as the parent list will be retrieved. This is different from the parameter of the same name used when creating a segment.
    parent-list-ids: option<string>,
    /// If set to `true` segments with an empty value of `parent_list_id` will be returned in the filter.  If the value is not present it defaults to 'false'.
    no-parent-list-id: option<bool>
  }
  get-segments: func(params: get-segments-params) -> result<string, string>;

  /// Create Segment
  record post-segments-params {
    /// Name of the segment.
    name: string,
    /// The array of list ids to filter contacts on when building this segment. It allows only one such list id for now. We will support more in future
    parent-list-ids: option<list<string>>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: string
  }
  post-segments: func(params: post-segments-params) -> result<string, string>;

  /// Get Segment by ID
  record get-segments-segment-id-params {
    /// Defaults to `true`. Set to `false` to exclude the contacts_sample in the response.
    contacts-sample: option<bool>
  }
  get-segments-segment-id: func(params: get-segments-segment-id-params) -> result<string, string>;

  /// Update Segment
  record patch-segments-segment-id-params {
    /// Name of the segment.
    name: option<string>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: option<string>
  }
  patch-segments-segment-id: func(params: patch-segments-segment-id-params) -> result<string, string>;

  /// Delete segment
  delete-segments-segment-id: func() -> result<string, string>;

}

interface senders {
  record post-marketing-senders-body-from-op {
    /// This is where the email will appear to originate from for your recipient
    email: string,
    /// This is the name appended to the from email field. IE - Your name or company name.
    name: string
  }

  record post-marketing-senders-body-reply-to {
    /// This is the email that your recipient will reply to.
    email: string,
    /// This is the name appended to the reply to email field. IE - Your name or company name.
    name: option<string>
  }

  /// Create a Sender Identity
  record post-marketing-senders-params {
    on-behalf-of: option<string>,
    /// The physical address of the sender identity.
    address: string,
    /// Additional sender identity address information.
    address-v2: option<string>,
    /// The city of the sender identity.
    city: string,
    /// The country of the sender identity.
    country: string,
    from-op: post-marketing-senders-body-from-op,
    /// A nickname for the sender identity. Not used for sending.
    nickname: string,
    reply-to: option<post-marketing-senders-body-reply-to>,
    /// The state of the sender identity.
    state: option<string>,
    /// The zipcode of the sender identity.
    zip: option<string>
  }
  post-marketing-senders: func(params: post-marketing-senders-params) -> result<string, string>;

}

interface single-sends {
  enum singlesend-request-email-config-editor-enum {
    code,
    design,
  }

  enum singlesend-search-status-item-enum {
    draft,
    scheduled,
    triggered,
  }

  enum put-marketing-singlesends-id-schedule-body-send-at-enum {
    now,
  }

  record singlesend-request-email-config {
    /// The URL allowing recipients to unsubscribe — you must provide this or the `suppression_group_id`.
    custom-unsubscribe-url: option<string>,
    /// A `design_id` can be used in place of `html_content`, `plain_content`, and/or `subject`. You can retrieve a design's ID from the ["List Designs" endpoint](https://sendgrid.api-docs.io/v3.0/designs-api/list-designs) or by pulling it from the design's detail page URL in the Marketing Campaigns App.
    design-id: option<string>,
    /// The editor — `"design"` or `"code"` — used to modify the Single Send's design in the Marketing Campaigns App.
    editor: option<singlesend-request-email-config-editor-enum>,
    /// If set to `true`, `plain_content` is always generated from `html_content`. If set to false, `plain_content` is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the Single Send. Do not include this field when using a `design_id`.
    html-content: option<string>,
    /// The name of the IP Pool from which the Single Send emails are sent.
    ip-pool: option<string>,
    /// The plain text content of the Single Send. Do not include this field when using a `design_id`.
    plain-content: option<string>,
    /// The ID of the verified Sender. You can retrieve a verified Sender's ID from the ["Get Verified Senders" endpoint](https://sendgrid.api-docs.io/v3.0/sender-verification/get-verified-senders) or by pulling it from the Sender's detail page URL in the SendGrid App.
    sender-id: option<s32>,
    /// The subject line of the Single Send. Do not include this field when using a `design_id`.
    subject: option<string>,
    /// The ID of the Suppression Group to allow recipients to unsubscribe — you must provide this or the `custom_unsubscribe_url`.
    suppression-group-id: option<s32>
  }

  record singlesend-request-send-to {
    /// Set to `true` to send to All Contacts. If set to `false`, at least one `list_ids` or `segment_ids` value must be provided before the Single Send is scheduled to be sent to recipients.
    all: option<bool>,
    /// The recipient List IDs that will receive the Single Send.
    list-ids: option<list<string>>,
    /// The recipient Segment IDs that will receive the Single Send.
    segment-ids: option<list<string>>
  }

  /// Get All Single Sends
  record get-marketing-singlesends-params {
    page-size: option<s32>,
    page-token: option<string>
  }
  get-marketing-singlesends: func(params: get-marketing-singlesends-params) -> result<string, string>;

  /// Create Single Send
  record post-marketing-singlesends-params {
    /// The categories to associate with this Single Send.
    categories: option<list<string>>,
    email-config: option<singlesend-request-email-config>,
    /// The name of the Single Send.
    name: string,
    /// The ISO 8601 time at which to send the Single Send — this must be set for a future time.
    send-at: option<string>,
    send-to: option<singlesend-request-send-to>
  }
  post-marketing-singlesends: func(params: post-marketing-singlesends-params) -> result<string, string>;

  /// Bulk Delete Single Sends
  record delete-marketing-singlesends-params {
    /// Single Send IDs to delete
    ids: option<list<string>>
  }
  delete-marketing-singlesends: func(params: delete-marketing-singlesends-params) -> result<string, string>;

  /// Get All Categories
  get-marketing-singlesends-categories: func() -> result<string, string>;

  /// Get Single Sends Search
  record post-marketing-singlesends-search-params {
    page-size: option<s32>,
    page-token: option<string>,
    /// categories to associate with this Single Send, match any single send that has at least one of the categories
    categories: option<list<string>>,
    /// leading and trailing wildcard search on name of the Single Send
    name: option<string>,
    /// current status of the Single Send
    status: option<list<singlesend-search-status-item-enum>>
  }
  post-marketing-singlesends-search: func(params: post-marketing-singlesends-search-params) -> result<string, string>;

  /// Get Single Send by ID
  get-marketing-singlesends-id: func() -> result<string, string>;

  /// Duplicate Single Send
  record post-marketing-singlesends-id-params {
    /// The name of the duplicate Single Send. If you choose to leave the name field blank, your duplicate will be assigned the name of the Single Send it was copied from with the text 'Copy of ' prepended to it. The end of the new Single Send name, including 'Copy of ', will be trimmed if the name exceeds the character limit.
    name: option<string>
  }
  post-marketing-singlesends-id: func(params: post-marketing-singlesends-id-params) -> result<string, string>;

  /// Update Single Send
  record patch-marketing-singlesends-id-params {
    /// The categories to associate with this Single Send.
    categories: option<list<string>>,
    email-config: option<singlesend-request-email-config>,
    /// The name of the Single Send.
    name: string,
    /// The ISO 8601 time at which to send the Single Send — this must be set for a future time.
    send-at: option<string>,
    send-to: option<singlesend-request-send-to>
  }
  patch-marketing-singlesends-id: func(params: patch-marketing-singlesends-id-params) -> result<string, string>;

  /// Delete Single Send by ID
  delete-marketing-singlesends-id: func() -> result<string, string>;

  /// Schedule Single Send
  record put-marketing-singlesends-id-schedule-params {
    /// This is the ISO 8601 time at which to send the Single Send; must be in future, or the string "now"
    send-at: put-marketing-singlesends-id-schedule-body-send-at-enum
  }
  put-marketing-singlesends-id-schedule: func(params: put-marketing-singlesends-id-schedule-params) -> result<string, string>;

  /// Delete Single Send Schedule
  delete-marketing-singlesends-id-schedule: func() -> result<string, string>;

}

interface marketing-campaigns-stats {
  enum get-automation-stat-group-by-item-enum {
    step-id,
  }

  enum get-automation-stat-aggregated-by-enum {
    day,
    total,
  }

  enum get-singlesend-stat-group-by-item-enum {
    ab-variation,
    ab-phase,
  }

  enum get-singlesend-link-stat-ab-phase-id-enum {
    test,
    send,
  }

  /// Get All Automation Stats
  record getall-automation-stats-params {
    /// This endpoint returns all automation IDs if no `automation_ids` are specified.
    automation-ids: option<list<string>>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>
  }
  getall-automation-stats: func(params: getall-automation-stats-params) -> result<string, string>;

  /// Export Automation Stats
  record get-automations-stats-export-params {
    /// The IDs of Automations for which to export stats.
    ids: option<list<string>>,
    /// The [IANA Area/Region](https://en.wikipedia.org/wiki/Tz_database#Names_of_time_zones) string representing the timezone in which the stats are to be presented; i.e. `"America/Chicago"`. This parameter changes the timezone format only; it does not alter which stats are returned.
    timezone: option<string>
  }
  get-automations-stats-export: func(params: get-automations-stats-export-params) -> result<string, string>;

  /// Get Automation Stats by ID
  record get-automation-stat-params {
    /// Automations can have multiple steps. Including `step_id` as a `group_by` metric allows further granularity of stats.
    group-by: option<list<get-automation-stat-group-by-item-enum>>,
    /// Comma-separated list of `step_ids` that you want the link stats for.
    step-ids: option<list<string>>,
    /// Dictates how the stats are time-sliced. Currently, `"total"` and `"day"` are supported.
    aggregated-by: option<get-automation-stat-aggregated-by-enum>,
    /// Format: `YYYY-MM-DD`. If this parameter is included, the stats' start date is included in the search.
    start-date: option<string>,
    /// Format: `YYYY-MM-DD`.If this parameter is included, the stats' end date is included in the search.
    end-date: option<string>,
    /// [IANA Area/Region](https://en.wikipedia.org/wiki/Tz_database#Names_of_time_zones) string representing the timezone in which the stats are to be presented, e.g., "America/Chicago".
    timezone: option<string>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>
  }
  get-automation-stat: func(params: get-automation-stat-params) -> result<string, string>;

  /// Get Automation Click Tracking Stats by ID
  record get-automation-link-stat-params {
    /// Automations can have multiple steps. Including `step_id` as a `group_by` metric allows further granularity of stats.
    group-by: option<list<get-automation-stat-group-by-item-enum>>,
    /// Comma-separated list of `step_ids` that you want the link stats for.
    step-ids: option<list<string>>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>
  }
  get-automation-link-stat: func(params: get-automation-link-stat-params) -> result<string, string>;

  /// Get All Single Sends Stats
  record getall-singlesend-stats-params {
    /// This endpoint returns all Single Send IDs if no IDs are included in `singlesend_ids`.
    singlesend-ids: option<list<string>>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>
  }
  getall-singlesend-stats: func(params: getall-singlesend-stats-params) -> result<string, string>;

  /// Export Single Send Stats
  record get-singlesend-stats-export-params {
    /// The IDs of Single Sends for which to export stats.
    ids: option<list<string>>,
    /// The [IANA Area/Region](https://en.wikipedia.org/wiki/Tz_database#Names_of_time_zones) string representing the timezone in which the stats are to be presented; i.e. `"America/Chicago"`. This parameter changes the timezone format only; it does not alter which stats are returned.
    timezone: option<string>
  }
  get-singlesend-stats-export: func(params: get-singlesend-stats-export-params) -> result<string, string>;

  /// Get Single Send Stats by ID
  record get-singlesend-stat-params {
    /// Dictates how the stats are time-sliced. Currently, `"total"` and `"day"` are supported.
    aggregated-by: option<get-automation-stat-aggregated-by-enum>,
    /// Format: `YYYY-MM-DD`. If this parameter is included, the stats' start date is included in the search.
    start-date: option<string>,
    /// Format: `YYYY-MM-DD`.If this parameter is included, the stats' end date is included in the search.
    end-date: option<string>,
    /// [IANA Area/Region](https://en.wikipedia.org/wiki/Tz_database#Names_of_time_zones) string representing the timezone in which the stats are to be presented, e.g., "America/Chicago".
    timezone: option<string>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>,
    /// A/B Single Sends have multiple variation IDs and phase IDs. Including these additional fields allows further granularity of stats by these fields.
    group-by: option<list<get-singlesend-stat-group-by-item-enum>>
  }
  get-singlesend-stat: func(params: get-singlesend-stat-params) -> result<string, string>;

  /// Get Single Send Click Tracking Stats by ID
  record get-singlesend-link-stat-params {
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>,
    /// A/B Single Sends have multiple variation IDs and phase IDs. Including these additional fields allows further granularity of stats by these fields.
    group-by: option<list<get-singlesend-stat-group-by-item-enum>>,
    ab-variation-id: option<string>,
    ab-phase-id: option<get-singlesend-link-stat-ab-phase-id-enum>
  }
  get-singlesend-link-stat: func(params: get-singlesend-link-stat-params) -> result<string, string>;

}

interface send-test-email {
  /// Send a Test Marketing Email
  record post-marketing-test-send-email-params {
    /// A custom unsubscribe URL.
    custom-unsubscribe-url: option<string>,
    /// An array of email addresses you want to send the test message to.
    emails: list<string>,
    /// You can either specify this address or specify a verified sender ID.
    from-address: option<string>,
    /// This ID must belong to a verified sender. Alternatively, you may supply a `from_address` email.
    sender-id: option<s32>,
    suppression-group-id: option<s32>,
    /// The ID of the template that you would like to use. If you use a template that contains a subject and content (either text or HTML), then those values specified at the personalizations or message level will not be used.
    template-id: string,
    ///  You can override the active template with an alternative template version by passing the version ID in this field. If this field is blank, the active template version will be used.
    version-id-override: option<string>
  }
  post-marketing-test-send-email: func(params: post-marketing-test-send-email-params) -> result<string, string>;

}

interface query {
  /// Filter all messages
  record get-messages-params {
    /// Use the query syntax  to filter your email activity.
    query: string,
    /// The number of messages returned. This parameter must be greater than 0 and less than or equal to 1000
    limit: option<f64>,
    x-query-id: option<string>,
    x-cursor: option<string>
  }
  get-messages: func(params: get-messages-params) -> result<string, string>;

  /// Filter messages by message ID
  get-v3-messages-msg-id: func() -> result<string, string>;

}

interface csv-ui-only {
