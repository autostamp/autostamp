    /// The CNAME for your sending domain that points to sendgrid.net.
    mail-cname: v200-response-item-v2-dns-mail-cname
  }

  /// A DNS record.
  record v200-response-item-v2-dns-dkim1 {
    /// The DNS record.
    data: string,
    /// The domain that this DNS record was created for.
    host: string,
    /// The type of DNS record.
    type-op: string,
    /// Indicates if this is a valid DNS record.
    valid: bool
  }

  /// A DNS record.
  record v200-response-item-v2-dns-dkim2 {
    /// The DNS record.
    data: string,
    /// The domain that this DNS record was created for.
    host: string,
    /// The type of DNS record.
    type-op: string,
    /// Indicates if this is a valid DNS record.
    valid: bool
  }

  /// The CNAME for your sending domain that points to sendgrid.net.
  record v200-response-item-v2-dns-mail-cname {
    /// The CNAME record.
    data: string,
    /// The domain that this CNAME is created for.
    host: string,
    /// The type of DNS record.
    type-op: string,
