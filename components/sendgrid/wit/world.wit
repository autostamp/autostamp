    /// The ID of the recipient that you want to retrieve.
    recipient-id: string,
    on-behalf-of: option<string>
  }
  get-contactdb-recipients-recipient-id: func(params: get-contactdb-recipients-recipient-id-params) -> result<contactdb-recipient, get-contactdb-recipients-recipient-id-error>;

  /// Delete a Recipient
