  record get-scopes-params {
    on-behalf-of: option<string>
  }
  get-scopes: func(params: get-scopes-params) -> result<string, string>;

}

interface teammates {
  /// Retrieve access requests
  record get-v3-scopes-requests-params {
    /// Optional field to limit the number of results returned.
    limit: option<s32>,
    /// Optional beginning point in the list to retrieve from.
    offset: option<s32>
  }
  get-v3-scopes-requests: func(params: get-v3-scopes-requests-params) -> result<string, string>;

  /// Deny access request
  delete-v3-scopes-requests-request-id: func() -> result<string, string>;

  /// Approve access request
  patch-v3-scopes-requests-approve-id: func() -> result<string, string>;

  /// Retrieve all teammates
  record get-v3-teammates-params {
    /// Number of items to return
    limit: option<s32>,
    /// Paging offset
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-v3-teammates: func(params: get-v3-teammates-params) -> result<string, string>;

  /// Invite teammate
  record post-v3-teammates-params {
    on-behalf-of: option<string>,
    /// New teammate's email
    email: string,
    /// Set to true if teammate should be an admin user
    is-admin: bool,
    /// Set to specify list of scopes that teammate should have. Should be empty if teammate is an admin.
    scopes: list<string>
  }
  post-v3-teammates: func(params: post-v3-teammates-params) -> result<string, string>;

  /// Retrieve all pending teammates
  record get-v3-teammates-pending-params {
    on-behalf-of: option<string>
  }
  get-v3-teammates-pending: func(params: get-v3-teammates-pending-params) -> result<string, string>;

  /// Delete pending teammate
  record delete-v3-teammates-pending-token-params {
    on-behalf-of: option<string>
  }
  delete-v3-teammates-pending-token: func(params: delete-v3-teammates-pending-token-params) -> result<string, string>;

  /// Resend teammate invite
  record post-v3-teammates-pending-token-resend-params {
    on-behalf-of: option<string>
  }
  post-v3-teammates-pending-token-resend: func(params: post-v3-teammates-pending-token-resend-params) -> result<string, string>;

  /// Retrieve specific teammate
  record get-v3-teammates-username-params {
    on-behalf-of: option<string>
  }
  get-v3-teammates-username: func(params: get-v3-teammates-username-params) -> result<string, string>;

  /// Update teammate's permissions
  record patch-v3-teammates-username-params {
    on-behalf-of: option<string>,
    /// Set to True if this teammate should be promoted to an admin user. If True, scopes should be an empty array.
    is-admin: bool,
    /// Provide list of scopes that should be given to teammate. If specifying list of scopes, is_admin should be set to False.
    scopes: list<string>
  }
  patch-v3-teammates-username: func(params: patch-v3-teammates-username-params) -> result<string, string>;

  /// Delete teammate
  record delete-v3-teammates-username-params {
    on-behalf-of: option<string>
  }
  delete-v3-teammates-username: func(params: delete-v3-teammates-username-params) -> result<string, string>;

}

