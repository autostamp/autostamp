  }
  patch-whitelabel-links-id: func(params: patch-whitelabel-links-id-params) -> result<string, string>;

  /// Delete a branded link
  record delete-whitelabel-links-id-params {
    on-behalf-of: option<string>
  }
  delete-whitelabel-links-id: func(params: delete-whitelabel-links-id-params) -> result<string, string>;

  /// Validate a branded link
