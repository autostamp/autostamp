    field-name: option<string>,
    on-behalf-of: option<string>
  }
  get-contactdb-recipients-search: func(params: get-contactdb-recipients-search-params) -> result<string, string>;

  /// Search recipients
  record post-contactdb-recipients-search-params {
    conditions: list<string>,
    list-id: s32
  }
  post-contactdb-recipients-search: func(params: post-contactdb-recipients-search-params) -> result<string, string>;

  /// Retrieve a single recipient
  record get-contactdb-recipients-recipient-id-params {
    on-behalf-of: option<string>
  }
  get-contactdb-recipients-recipient-id: func(params: get-contactdb-recipients-recipient-id-params) -> result<string, string>;

  /// Delete a Recipient
  record delete-contactdb-recipients-recipient-id-params {
    on-behalf-of: option<string>
  }
  delete-contactdb-recipients-recipient-id: func(params: delete-contactdb-recipients-recipient-id-params) -> result<string, string>;

  /// Retrieve the lists that a recipient is on
  record get-contactdb-recipients-recipient-id-lists-params {
    on-behalf-of: option<string>
  }
  get-contactdb-recipients-recipient-id-lists: func(params: get-contactdb-recipients-recipient-id-lists-params) -> result<string, string>;

  /// Get Recipient Upload Status
  record get-contactdb-status-params {
    on-behalf-of: option<string>
  }
  get-contactdb-status: func(params: get-contactdb-status-params) -> result<string, string>;

}

interface contacts-api-segments {
  enum contactdb-segments-conditions-and-or-enum {
    and,
    or,
    empty,
  }

  enum contactdb-segments-conditions-operator-enum {
    eq,
    ne,
    lt,
    gt,
    contains,
  }

  record contactdb-segments-conditions {
    and-or: option<contactdb-segments-conditions-and-or-enum>,
    field: string,
    operator: contactdb-segments-conditions-operator-enum,
    value: string
  }

  /// Retrieve all segments
  record get-contactdb-segments-params {
    on-behalf-of: option<string>
  }
  get-contactdb-segments: func(params: get-contactdb-segments-params) -> result<string, string>;

  /// Create a Segment
  record post-contactdb-segments-params {
    on-behalf-of: option<string>,
    /// The conditions for a recipient to be included in this segment.
    conditions: list<contactdb-segments-conditions>,
    /// The list id from which to make this segment. Not including this ID will mean your segment is created from the main contactdb rather than a list.
    list-id: option<s32>,
    /// The name of this segment.
    name: string,
    /// The count of recipients in this list. This is not included on creation of segments.
    recipient-count: option<f64>
  }
  post-contactdb-segments: func(params: post-contactdb-segments-params) -> result<string, string>;

  /// Retrieve a segment
  record get-contactdb-segments-segment-id-params {
    /// The ID of the segment you want to request.
    segment-id: s32,
    on-behalf-of: option<string>
  }
  get-contactdb-segments-segment-id: func(params: get-contactdb-segments-segment-id-params) -> result<string, string>;

  /// Update a segment
  record patch-contactdb-segments-segment-id-params {
    /// The ID of the segment you are updating.
    segment-id: option<string>,
    on-behalf-of: option<string>,
    /// The conditions by which this segment should be created.
    conditions: option<list<contactdb-segments-conditions>>,
    /// The list ID you would like this segment to be built from.
    list-id: option<f64>,
    name: string
  }
  patch-contactdb-segments-segment-id: func(params: patch-contactdb-segments-segment-id-params) -> result<string, string>;

  /// Delete a segment
  record delete-contactdb-segments-segment-id-params {
    /// True to delete all contacts matching the segment in addition to deleting the segment
    delete-contacts: option<bool>,
    on-behalf-of: option<string>,
    body: option<string>
  }
  delete-contactdb-segments-segment-id: func(params: delete-contactdb-segments-segment-id-params) -> result<string, string>;

  /// Retrieve recipients on a segment
  record get-contactdb-segments-segment-id-recipients-params {
    page: option<s32>,
    page-size: option<s32>,
    on-behalf-of: option<string>
  }
  get-contactdb-segments-segment-id-recipients: func(params: get-contactdb-segments-segment-id-recipients-params) -> result<string, string>;

}

interface designs-api {
  enum design-duplicate-input-editor-enum {
    code,
    design,
  }

  /// List Designs
  record list-designs-params {
    /// number of results to return
    page-size: option<s32>,
    /// token corresponding to a specific page of results, as provided by metadata
    page-token: option<string>,
    /// set to false to return all fields
    summary: option<bool>
  }
  list-designs: func(params: list-designs-params) -> result<string, string>;

  /// Create Design
  record post-designs-params {
    /// opaque schema; raw JSON
    value: string
  }
  post-designs: func(params: post-designs-params) -> result<string, string>;

  /// List SendGrid Pre-built Designs
  record list-sendgrid-pre-built-designs-params {
    /// number of results to return
    page-size: option<s32>,
    /// token corresponding to a specific page of results, as provided by metadata
    page-token: option<string>,
    /// set to false to return all fields
    summary: option<bool>
  }
  list-sendgrid-pre-built-designs: func(params: list-sendgrid-pre-built-designs-params) -> result<string, string>;

  /// Get SendGrid Pre-built Design
  get-sendgrid-pre-built-design: func() -> result<string, string>;

  /// Duplicate SendGrid Pre-built Design
  record post-sendgrid-pre-built-design-params {
    /// The editor used in the UI.
    editor: option<design-duplicate-input-editor-enum>,
    /// The name of the new design.
    name: option<string>
  }
  post-sendgrid-pre-built-design: func(params: post-sendgrid-pre-built-design-params) -> result<string, string>;

  /// Get Design
  get-design: func() -> result<string, string>;

  /// Duplicate Design
  record post-design-params {
    /// The editor used in the UI.
    editor: option<design-duplicate-input-editor-enum>,
    /// The name of the new design.
    name: option<string>
  }
  post-design: func(params: post-design-params) -> result<string, string>;

  /// Update Design
  record put-design-params {
    /// The list of categories applied to the design
    categories: option<list<string>>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the Design.
    html-content: option<string>,
    /// Name of the Design.
    name: option<string>,
    /// Plain text content of the Design.
    plain-content: option<string>,
    /// Subject of the Design.
    subject: option<string>
  }
  put-design: func(params: put-design-params) -> result<string, string>;

  /// Delete Design
  delete-design: func() -> result<string, string>;

}

interface ip-addresses {
  enum get-ips-sort-by-direction-enum {
    desc,
    asc,
  }

  /// Retrieve all IP addresses
  record get-ips-params {
    /// The IP address to get
    ip: option<string>,
    /// Should we exclude reverse DNS records (whitelabels)?
    exclude-whitelabels: option<bool>,
    /// The number of IPs you want returned at the same time.
    limit: option<s32>,
    /// The offset for the number of IPs that you are requesting.
    offset: option<s32>,
    /// The subuser you are requesting for.
    subuser: option<string>,
    /// The direction to sort the results.
    sort-by-direction: option<get-ips-sort-by-direction-enum>
  }
  get-ips: func(params: get-ips-params) -> result<string, string>;

  /// Add IPs
  record post-ips-params {
    /// The amount of IPs to add to the account.
    count: s32,
    /// Array of usernames to be assigned a send IP.
    subusers: option<list<string>>,
    /// Whether or not to warmup the IPs being added.
    warmup: option<bool>
  }
  post-ips: func(params: post-ips-params) -> result<string, string>;

  /// Retrieve all assigned IPs
  get-ips-assigned: func() -> result<string, string>;

  /// Get remaining IPs count
  get-ips-remaining: func() -> result<string, string>;

  /// Retrieve all IP pools an IP address belongs to
  get-ips-ip-address: func() -> result<string, string>;

}

interface ip-pools {
  /// Retrieve all IP pools
  get-ips-pools: func() -> result<string, string>;

  /// Create an IP pool
  record post-ips-pools-params {
    /// The name of your new IP pool.
    name: string
  }
  post-ips-pools: func(params: post-ips-pools-params) -> result<string, string>;

  /// Retrieve all the IPs in a specified pool
  get-ips-pools-pool-name: func() -> result<string, string>;

  /// Rename an IP pool
  record put-ips-pools-pool-name-params {
    /// The new name for your IP pool.
    name: option<string>
  }
  put-ips-pools-pool-name: func(params: put-ips-pools-pool-name-params) -> result<string, string>;

  /// Delete an IP pool
  delete-ips-pools-pool-name: func() -> result<string, string>;

  /// Add an IP address to a pool
  record post-ips-pools-pool-name-ips-params {
    /// The IP address that you want to add to the named pool.
    ip: option<string>
  }
  post-ips-pools-pool-name-ips: func(params: post-ips-pools-pool-name-ips-params) -> result<string, string>;

