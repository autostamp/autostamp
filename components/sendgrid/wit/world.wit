/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `Authorization` | header `Authorization` |
package autostamp:sendgrid@0.6.0;

interface ip-access-management {
  record get-access-settings-activity-response {
    /// An array containing the IPs that recently attempted to access your account.
    result-op: list<get-access-settings-activity-response-result-op-item>
  }

  record get-access-settings-activity-response-result-op-item {
    /// Indicates if the IP address was granted access to the account.
    allowed: bool,
    /// The authentication method used when attempting access.
    auth-method: string,
    /// A Unix timestamp indicating when the first access attempt was made.
    first-at: s32,
    /// The IP addressed used during the access attempt.
    ip: string,
    /// A Unix timestamp indicating when the most recent access attempt was made
    last-at: s32,
    /// The geographic location from which the access attempt originated.
    location: string
  }

  record ip-access-response {
    /// An array listing all of your allowed IPs.
    result-op: option<list<ip-access-response-result-op-item>>
  }

  record ip-access-response-result-op-item {
    /// A Unix timestamp indicating when the IP was added to the allow list.
    created-at: option<s32>,
    /// The ID of the allowed IP.
    id: option<s32>,
    /// The allowed IP.
    ip: option<string>,
    /// A Unix timestamp indicating when the IPs allow status was most recently updated.
    updated-at: option<s32>
  }

  record post-access-settings-whitelist-body-ips-item {
    /// An IP address that you want to allow.
    ip: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-access-settings-whitelist-response-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-access-settings-whitelist-rule-id-response-entry {
    key: string,
    value: string
  }

  variant get-access-settings-activity-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-access-settings-whitelist-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-access-settings-whitelist-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-access-settings-whitelist-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Retrieve all recent access attempts
  record get-access-settings-activity-params {
    /// Limits the number of IPs to return.
    limit: option<s32>,
    on-behalf-of: option<string>
  }
  get-access-settings-activity: func(params: get-access-settings-activity-params) -> result<get-access-settings-activity-response, get-access-settings-activity-error>;

  /// Retrieve a list of currently allowed IPs
  record get-access-settings-whitelist-params {
    on-behalf-of: option<string>
  }
  get-access-settings-whitelist: func(params: get-access-settings-whitelist-params) -> result<ip-access-response, get-access-settings-whitelist-error>;

  /// Add one or more IPs to the allow list
  record post-access-settings-whitelist-params {
    on-behalf-of: option<string>,
    /// An array containing the IP(s) you want to allow.
    ips: list<post-access-settings-whitelist-body-ips-item>
  }
  post-access-settings-whitelist: func(params: post-access-settings-whitelist-params) -> result<ip-access-response, post-access-settings-whitelist-error>;

  /// Remove one or more IPs from the allow list
  record delete-access-settings-whitelist-params {
    on-behalf-of: option<string>,
    /// An array of the IDs of the IP address that you want to remove from your allow list.
    ids: option<list<s32>>
  }
  delete-access-settings-whitelist: func(params: delete-access-settings-whitelist-params) -> result<list<delete-access-settings-whitelist-response-entry>, delete-access-settings-whitelist-error>;

  /// Retrieve a specific allowed IP
  record get-access-settings-whitelist-rule-id-params {
    /// The ID of the allowed IP address that you want to retrieve.
    rule-id: string,
    on-behalf-of: option<string>
  }
  get-access-settings-whitelist-rule-id: func(params: get-access-settings-whitelist-rule-id-params) -> result<ip-access-response, string>;

  /// Remove a specific IP from the allowed list
  record delete-access-settings-whitelist-rule-id-params {
    /// The ID of the allowed IP address that you want to retrieve.
    rule-id: string,
    on-behalf-of: option<string>
  }
  delete-access-settings-whitelist-rule-id: func(params: delete-access-settings-whitelist-rule-id-params) -> result<list<delete-access-settings-whitelist-rule-id-response-entry>, string>;

}


interface alerts {
  enum get-alerts-response-item-type-op-enum {
    usage-limit,
    stats-notification,
  }

  enum post-alerts-body-type-op-enum {
    stats-notification,
    usage-limit,
  }

  enum get-alerts-alert-id-response-type-op-enum {
    usage-alert,
    stats-notification,
  }

  record get-alerts-response-item {
    /// A Unix timestamp indicating when the alert was created.
    created-at: s32,
    /// The email address that the alert will be sent to.
    email-to: string,
    /// If the alert is of type stats_notification, this indicates how frequently the stats notifications will be sent. For example, "daily", "weekly", or "monthly".
    frequency: option<string>,
    /// The ID of the alert.
    id: s32,
    /// If the alert is of type usage_limit, this indicates the percentage of email usage that must be reached before the alert will be sent.
    percentage: option<s32>,
    /// The type of alert.
    type-op: get-alerts-response-item-type-op-enum,
    /// A Unix timestamp indicating when the alert was last modified.
    updated-at: option<s32>
  }

  record post-alerts-response {
    /// A Unix timestamp indicating when the alert was created.
    created-at: s32,
    /// The email address that the alert will be sent to.
    email-to: string,
    /// If the alert is of type stats_notification, this indicates how frequently the stats notifications will be sent. For example, "daily", "weekly", or "monthly".
    frequency: option<string>,
    /// The ID of the alert.
    id: s32,
    /// "If the alert is of type usage_limit, this indicates the percentage of email usage that must be reached before the alert will be sent.
    percentage: option<s32>,
    /// The type of alert.
    type-op: string,
    /// A Unix timestamp indicating when the alert was last modified.
    updated-at: s32
  }

  record get-alerts-alert-id-response {
    /// A Unix timestamp indicating when the alert was created.
    created-at: s32,
    /// The email address that the alert will be sent to.
    email-to: string,
    /// If the alert is of type stats_notification, this indicates how frequently the stats notifications will be sent. For example: "daily", "weekly", or "monthly".
    frequency: option<string>,
    /// The ID of the alert.
    id: s32,
    /// If the alert is of type usage_limit, this indicates the percentage of email usage that must be reached before the alert will be sent.
    percentage: option<s32>,
    /// The type of alert.
    type-op: get-alerts-alert-id-response-type-op-enum,
    /// A Unix timestamp indicating when the alert was last modified.
    updated-at: s32
  }

  record patch-alerts-alert-id-response {
    /// A Unix timestamp indicating when the alert was created.
    created-at: s32,
    /// The email address that the alert will be sent to.
    email-to: string,
    /// If the alert is of type stats_notification, this indicates how frequently the stats notifications will be sent. For example: "daily", "weekly", or "monthly".
    frequency: option<string>,
    /// The ID of the alert.
    id: s32,
    /// If the alert is of type usage_limit, this indicates the percentage of email usage that must be reached before the alert will be sent.
    percentage: option<s32>,
    /// The type of alert.
    type-op: get-alerts-alert-id-response-type-op-enum,
    /// A Unix timestamp indicating when the alert was last modified.
    updated-at: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-alerts-alert-id-response-entry {
    key: string,
    value: string
  }

  variant post-alerts-error {
    bad-request(string),
    other(string)
  }

  /// Retrieve all alerts
  record get-alerts-params {
    on-behalf-of: option<string>
  }
  get-alerts: func(params: get-alerts-params) -> result<list<get-alerts-response-item>, string>;

  /// Create a new Alert
  record post-alerts-params {
    on-behalf-of: option<string>,
    /// The email address the alert will be sent to.
    /// Example: test@example.com
    email-to: string,
    /// Required for stats_notification. How frequently the alert will be sent.
    /// Example: daily
    frequency: option<string>,
    /// Required for usage_alert. When this usage threshold is reached, the alert will be sent.
    /// Example: 90
    percentage: option<s32>,
    /// The type of alert you want to create. Can be either usage_limit or stats_notification.
    /// Example: usage_limit
    type-op: post-alerts-body-type-op-enum
  }
  post-alerts: func(params: post-alerts-params) -> result<post-alerts-response, post-alerts-error>;

  /// Retrieve a specific alert
  record get-alerts-alert-id-params {
    /// The ID of the alert you would like to retrieve.
    alert-id: string,
    on-behalf-of: option<string>
  }
  get-alerts-alert-id: func(params: get-alerts-alert-id-params) -> result<get-alerts-alert-id-response, string>;

  /// Update an alert
  record patch-alerts-alert-id-params {
    /// The ID of the alert you would like to retrieve.
    alert-id: string,
    on-behalf-of: option<string>,
    /// The new email address you want your alert to be sent to.
    /// Example: test@example.com
    email-to: option<string>,
    /// The new frequency at which to send the stats_notification alert.
    /// Example: monthly
    frequency: option<string>,
    /// The new percentage threshold at which the usage_limit alert will be sent.
    /// Example: 90
    percentage: option<s32>
  }
  patch-alerts-alert-id: func(params: patch-alerts-alert-id-params) -> result<patch-alerts-alert-id-response, string>;

  /// Delete an alert
  record delete-alerts-alert-id-params {
    /// The ID of the alert you would like to retrieve.
    alert-id: string,
    on-behalf-of: option<string>
  }
  delete-alerts-alert-id: func(params: delete-alerts-alert-id-params) -> result<list<delete-alerts-alert-id-response-entry>, string>;

}

interface api-keys {
  record get-api-keys-response {
    result-op: option<list<api-key-name-id>>
  }

  record api-key-name-id {
    /// The ID of your API Key. 
    api-key-id: option<string>,
    /// The name of your API Key.
    name: option<string>
  }

  record create-api-keys-response {
    api-key: option<string>,
    api-key-id: option<string>,
    name: option<string>,
    scopes: option<list<string>>
  }

  record get-api-keys-api-key-id-response {
    result-op: option<list<api-key-name-id-scopes>>
  }

  record api-key-name-id-scopes {
    /// The permissions this API Key has access to.
    scopes: option<list<string>>,
    /// The ID of your API Key. 
    api-key-id: option<string>,
    /// The name of your API Key.
    name: option<string>
  }

  variant get-api-keys-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant create-api-keys-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-api-keys-api-key-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant put-api-keys-api-key-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-api-keys-api-key-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-api-keys-api-key-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Retrieve all API Keys belonging to the authenticated user
  record get-api-keys-params {
    limit: option<s32>,
    on-behalf-of: option<string>
  }
  get-api-keys: func(params: get-api-keys-params) -> result<get-api-keys-response, get-api-keys-error>;

  /// Create API keys
  record create-api-keys-params {
    on-behalf-of: option<string>,
    /// The name you will use to describe this API Key.
    name: string,
    /// The individual permissions that you are giving to this API Key.
    scopes: option<list<string>>
  }
  create-api-keys: func(params: create-api-keys-params) -> result<create-api-keys-response, create-api-keys-error>;

  /// Retrieve an existing API Key
  record get-api-keys-api-key-id-params {
    api-key-id: string,
    on-behalf-of: option<string>
  }
  get-api-keys-api-key-id: func(params: get-api-keys-api-key-id-params) -> result<get-api-keys-api-key-id-response, get-api-keys-api-key-id-error>;

  /// Update API key name and scopes
  record put-api-keys-api-key-id-params {
    api-key-id: string,
    on-behalf-of: option<string>,
    name: string,
    scopes: option<list<string>>
  }
  put-api-keys-api-key-id: func(params: put-api-keys-api-key-id-params) -> result<api-key-name-id-scopes, put-api-keys-api-key-id-error>;

  /// Update API key name
  record patch-api-keys-api-key-id-params {
    api-key-id: string,
    on-behalf-of: option<string>,
    /// The new name of the API Key.
    name: string
  }
  patch-api-keys-api-key-id: func(params: patch-api-keys-api-key-id-params) -> result<api-key-name-id, patch-api-keys-api-key-id-error>;

  /// Delete API keys
  record delete-api-keys-api-key-id-params {
    api-key-id: string,
    on-behalf-of: option<string>
  }
  delete-api-keys-api-key-id: func(params: delete-api-keys-api-key-id-params) -> result<string, delete-api-keys-api-key-id-error>;

}

interface suppressions-unsubscribe-groups {
  record suppression-group {
    /// A description of the suppression group.
    description: string,
    /// The id of the suppression group.
    id: f64,
    /// Indicates if this is the default suppression group.
    is-default: option<bool>,
    last-email-sent-at: option<string>,
    /// The name of the suppression group. Each group created by a user must have a unique name.
    name: string,
    /// The unsubscribes associated with this group.
    unsubscribes: option<s32>
  }

  record post-asm-groups-response {
    /// A brief description of the suppression group.
    description: string,
    /// The ID of the suppression group.
    id: s32,
    /// Indicates if this is the default suppression group.
    is-default: bool,
    /// The name of the suppression group.
    name: string
  }

  record get-asm-groups-group-id-response {
    /// A brief description of your suppression group. Required when creating a group.
    description: option<string>,
    /// Indicates if you would like this to be your default suppression group.
    is-default: option<bool>,
    /// The name of your suppression group. Required when creating a group.
    name: option<string>,
    /// The ID of the suppression group.
    id: s32,
    last-email-sent-at: option<string>,
    /// The number of unsubscribes, or suppressions, in this group.
    unsubscribes: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-asm-groups-group-id-response-entry {
    key: string,
    value: string
  }

  /// Retrieve all suppression groups associated with the user.
  record get-asm-groups-params {
    id: option<s32>,
    on-behalf-of: option<string>
  }
  get-asm-groups: func(params: get-asm-groups-params) -> result<list<suppression-group>, string>;

  /// Create a new suppression group
  record post-asm-groups-params {
    on-behalf-of: option<string>,
    /// A brief description of your suppression group. Required when creating a group.
    description: option<string>,
    /// Indicates if you would like this to be your default suppression group.
    is-default: option<bool>,
    /// The name of your suppression group. Required when creating a group.
    name: option<string>
  }
  post-asm-groups: func(params: post-asm-groups-params) -> result<post-asm-groups-response, string>;

  /// Get information on a single suppression group.
  record get-asm-groups-group-id-params {
    /// The ID of the suppression group you would like to retrieve.
    group-id: string,
    on-behalf-of: option<string>
  }
  get-asm-groups-group-id: func(params: get-asm-groups-group-id-params) -> result<get-asm-groups-group-id-response, string>;

  /// Update a suppression group.
  record patch-asm-groups-group-id-params {
    /// The ID of the suppression group you would like to retrieve.
    group-id: string,
    on-behalf-of: option<string>,
    /// A brief description of your suppression group. Required when creating a group.
    description: option<string>,
    /// Indicates if you would like this to be your default suppression group.
    is-default: option<bool>,
    /// The name of your suppression group. Required when creating a group.
    name: option<string>
  }
  patch-asm-groups-group-id: func(params: patch-asm-groups-group-id-params) -> result<suppression-group, string>;

  /// Delete a Suppression Group
  record delete-asm-groups-group-id-params {
    /// The ID of the suppression group you would like to retrieve.
    group-id: string,
    on-behalf-of: option<string>
  }
  delete-asm-groups-group-id: func(params: delete-asm-groups-group-id-params) -> result<list<delete-asm-groups-group-id-response-entry>, string>;

}

interface suppressions-suppressions {
  record post-asm-groups-group-id-suppressions-response {
    /// The email addresses you added to the unsubscribe group
    recipient-emails: option<list<string>>
  }

  record get-asm-suppressions-response-item {
    /// A UNIX timestamp indicating when the suppression was created.
    created-at: s32,
    /// The email address that was suppressed.
    email: string,
    /// The id of the suppression group that this email address belongs to.
    group-id: s32,
    /// The name of the suppression group that this email address belongs to.
    group-name: string
  }

  record get-asm-suppressions-email-response {
    /// The array of suppression groups.
    suppressions: list<get-asm-suppressions-email-response-suppressions-item>
  }

  record get-asm-suppressions-email-response-suppressions-item {
    /// The description of the suppression group.
    description: string,
    /// The id of the suppression group.
    id: s32,
    /// Indicates if the suppression group  is set as the default.
    is-default: bool,
    /// The name of the suppression group.
    name: string,
    /// Indicates if the given email address is suppressed for this group.
    suppressed: bool
  }

  /// Retrieve all suppressions for a suppression group
  record get-asm-groups-group-id-suppressions-params {
    /// The id of the unsubscribe group that you are adding suppressions to.
    group-id: string,
    on-behalf-of: option<string>
  }
  get-asm-groups-group-id-suppressions: func(params: get-asm-groups-group-id-suppressions-params) -> result<list<string>, string>;

  /// Add suppressions to a suppression group
  record post-asm-groups-group-id-suppressions-params {
    /// The id of the unsubscribe group that you are adding suppressions to.
    group-id: string,
    on-behalf-of: option<string>,
    /// The array of email addresses to add or find.
    recipient-emails: list<string>
  }
  post-asm-groups-group-id-suppressions: func(params: post-asm-groups-group-id-suppressions-params) -> result<post-asm-groups-group-id-suppressions-response, string>;

  /// Search for suppressions within a group
  record post-asm-groups-group-id-suppressions-search-params {
    /// The ID of the suppression group that you would like to search.
    group-id: string,
    on-behalf-of: option<string>,
    /// The array of email addresses to add or find.
    recipient-emails: list<string>
  }
  post-asm-groups-group-id-suppressions-search: func(params: post-asm-groups-group-id-suppressions-search-params) -> result<list<string>, string>;

  /// Delete a suppression from a suppression group
  record delete-asm-groups-group-id-suppressions-email-params {
    /// The id of the suppression group that you are removing an email address from.
    group-id: string,
    /// The email address that you want to remove from the suppression group.
    email: string,
    on-behalf-of: option<string>
  }
  delete-asm-groups-group-id-suppressions-email: func(params: delete-asm-groups-group-id-suppressions-email-params) -> result<string, string>;

  /// Retrieve all suppressions
  record get-asm-suppressions-params {
    on-behalf-of: option<string>
  }
  get-asm-suppressions: func(params: get-asm-suppressions-params) -> result<list<get-asm-suppressions-response-item>, string>;

  /// Retrieve all suppression groups for an email address
  record get-asm-suppressions-email-params {
    /// The email address that you want to search suppression groups for.
    email: string,
    on-behalf-of: option<string>
  }
  get-asm-suppressions-email: func(params: get-asm-suppressions-email-params) -> result<get-asm-suppressions-email-response, string>;

}

interface suppressions-global-suppressions {
  record post-asm-suppressions-global-response {
    /// The email addresses that are globally suppressed
    recipient-emails: list<string>
  }

  record get-asm-suppressions-global-email-response {
    /// The email address that is globally suppressed. This will be an empty object if the email address you included in your call is not globally suppressed.
    recipient-email: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-asm-suppressions-global-email-response-entry {
    key: string,
    value: string
  }

  record get-suppression-unsubscribes-response-item {
    /// A Unix timestamp indicating when the recipient was added to the global suppression list.
    created: s32,
    /// The email address of the recipient who is globally suppressed.
    email: string
  }

  /// Add recipient addresses to the global suppression group.
  record post-asm-suppressions-global-params {
    on-behalf-of: option<string>,
    /// The array of email addresses to add or find.
    recipient-emails: list<string>
  }
  post-asm-suppressions-global: func(params: post-asm-suppressions-global-params) -> result<post-asm-suppressions-global-response, string>;

  /// Retrieve a Global Suppression
  record get-asm-suppressions-global-email-params {
    /// The email address of the global suppression you want to retrieve. Or, if you want to check if an email address is on the global suppressions list, enter that email address here.
    email: string,
    on-behalf-of: option<string>
  }
  get-asm-suppressions-global-email: func(params: get-asm-suppressions-global-email-params) -> result<get-asm-suppressions-global-email-response, string>;

  /// Delete a Global Suppression
  record delete-asm-suppressions-global-email-params {
    /// The email address of the global suppression you want to retrieve. Or, if you want to check if an email address is on the global suppressions list, enter that email address here.
    email: string,
    on-behalf-of: option<string>
  }
  delete-asm-suppressions-global-email: func(params: delete-asm-suppressions-global-email-params) -> result<list<delete-asm-suppressions-global-email-response-entry>, string>;

  /// Retrieve all global suppressions
  record get-suppression-unsubscribes-params {
    /// Refers start of the time range in unix timestamp when an unsubscribe email was created (inclusive).
    start-time: option<s32>,
    /// Refers end of the time range in unix timestamp when an unsubscribe email was created (inclusive).
    end-time: option<s32>,
    /// The number of results to display on each page.
    limit: option<s32>,
    /// The point in the list of results to begin displaying global suppressions.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-suppression-unsubscribes: func(params: get-suppression-unsubscribes-params) -> result<list<get-suppression-unsubscribes-response-item>, string>;

}

interface stats {
  enum get-browsers-stats-aggregated-by-enum {
    day,
    week,
    month,
  }

  enum get-geo-stats-country-enum {
    us,
    ca,
  }

  record get-browsers-stats-response-item {
    /// The date that the statistics were gathered.
    date: option<string>,
    /// The list of statistics.
    stats: option<list<get-browsers-stats-response-item-stats-item>>
  }

  record get-browsers-stats-response-item-stats-item {
    metrics: option<advanced-stats-clicks>,
    /// The name of the specific segmentation.
    name: option<string>,
    /// The type of segmentation.
    type-op: option<string>
  }

  /// The individual events and their stats.
  record advanced-stats-clicks {
    /// The number of links that were clicked in your emails.
    clicks: option<s32>,
    /// The number of unique recipients who clicked links in your emails.
    unique-clicks: option<s32>
  }

  record get-clients-stats-response-item {
    /// The date that the statistics were gathered.
    date: option<string>,
    /// The list of statistics.
    stats: option<list<get-clients-stats-response-item-stats-item>>
  }

  record get-clients-stats-response-item-stats-item {
    metrics: option<advanced-stats-opens>,
    /// The name of the specific segmentation.
    name: option<string>,
    /// The type of segmentation.
    type-op: option<string>
  }

  /// The individual events and their stats.
  record advanced-stats-opens {
    /// The total number of times your emails were opened by recipients.
    opens: option<s32>,
    /// The number of unique recipients who opened your emails.
    unique-opens: option<s32>
  }

  record get-clients-client-type-stats-response-item {
    /// The date that the statistics were gathered.
    date: option<string>,
    /// The list of statistics.
    stats: option<list<get-clients-client-type-stats-response-item-stats-item>>
  }

  record get-clients-client-type-stats-response-item-stats-item {
    metrics: option<advanced-stats-opens>,
    /// The name of the specific segmentation.
    name: option<string>,
    /// The type of segmentation.
    type-op: option<string>
  }

  record get-devices-stats-response-item {
    /// The date that the statistics were gathered.
    date: option<string>,
    /// The list of statistics.
    stats: option<list<get-devices-stats-response-item-stats-item>>
  }

  record get-devices-stats-response-item-stats-item {
    metrics: option<advanced-stats-opens>,
    /// The name of the specific segmentation.
    name: option<string>,
    /// The type of segmentation.
    type-op: option<string>
  }

  record get-geo-stats-response-item {
    /// The date that the statistics were gathered.
    date: option<string>,
    /// The list of statistics.
    stats: option<list<get-geo-stats-response-item-stats-item>>
  }

  record get-geo-stats-response-item-stats-item {
    metrics: option<advanced-stats-clicks-opens>,
    /// The name of the specific segmentation.
    name: option<string>,
    /// The type of segmentation.
    type-op: option<string>
  }

  /// The individual events and their stats.
  record advanced-stats-clicks-opens {
    /// The number of links that were clicked in your emails.
    clicks: option<s32>,
    /// The number of unique recipients who clicked links in your emails.
    unique-clicks: option<s32>,
    /// The total number of times your emails were opened by recipients.
    opens: option<s32>,
    /// The number of unique recipients who opened your emails.
    unique-opens: option<s32>
  }

  record get-mailbox-providers-stats-response-item {
    /// The date that the statistics were gathered.
    date: option<string>,
    /// The list of statistics.
    stats: option<list<get-mailbox-providers-stats-response-item-stats-item>>
  }

  record get-mailbox-providers-stats-response-item-stats-item {
    metrics: option<advanced-stats-mailbox-provider>,
    /// The name of the specific segmentation.
    name: option<string>,
    /// The type of segmentation.
    type-op: option<string>
  }

  /// The individual events and their stats.
  record advanced-stats-mailbox-provider {
    /// The number of links that were clicked in your emails.
    clicks: option<s32>,
    /// The number of unique recipients who clicked links in your emails.
    unique-clicks: option<s32>,
    /// The total number of times your emails were opened by recipients.
    opens: option<s32>,
    /// The number of unique recipients who opened your emails.
    unique-opens: option<s32>,
    /// The number of emails that were not allowed to be delivered by ISPs.
    blocks: option<s32>,
    /// The number of emails that bounced instead of being delivered.
    bounces: option<s32>,
    /// The number of emails that temporarily could not be delivered.
    deferred: option<s32>,
    /// The number of emails SendGrid was able to confirm were actually delivered to a recipient.
    delivered: option<s32>,
    /// The number of emails that were not delivered due to the recipient email address being on a suppression list.
    drops: option<s32>,
    /// Requests from your website, application, or mail client via SMTP Relay or the Web API that SendGrid processed.
    processed: option<s32>,
    /// The number of emails that were requested to be delivered.
    requests: option<s32>,
    /// The number of recipients who marked your email as spam.
    spam-reports: option<s32>
  }

  record get-stats-response-item {
    /// The date the stats were gathered.
    date: string,
    /// The individual email activity stats.
    stats: list<get-stats-response-item-stats-item>
  }

  record get-stats-response-item-stats-item {
    metrics: option<advanced-global-stats>
  }

  record advanced-global-stats {
    /// The number of links that were clicked in your emails.
    clicks: option<s32>,
    /// The number of unique recipients who clicked links in your emails.
    unique-clicks: option<s32>,
    /// The total number of times your emails were opened by recipients.
    opens: option<s32>,
    /// The number of unique recipients who opened your emails.
    unique-opens: option<s32>,
    /// The number of emails that were not allowed to be delivered by ISPs.
    blocks: option<s32>,
    /// The number of emails that were dropped because of a bounce.
    bounce-drops: option<s32>,
    /// The number of emails that bounced instead of being delivered.
    bounces: option<s32>,
    /// The number of emails that temporarily could not be delivered. 
    deferred: option<s32>,
    /// The number of emails SendGrid was able to confirm were actually delivered to a recipient.
    delivered: option<s32>,
    /// The number of recipients who had malformed email addresses or whose mail provider reported the address as invalid.
    invalid-emails: option<s32>,
    /// Requests from your website, application, or mail client via SMTP Relay or the API that SendGrid processed.
    processed: option<s32>,
    /// The number of emails that were requested to be delivered.
    requests: option<s32>,
    /// The number of emails that were dropped due to a recipient previously marking your emails as spam.
    spam-report-drops: option<s32>,
    /// The number of recipients who marked your email as spam.
    spam-reports: option<s32>,
    /// The number of emails dropped due to a recipient unsubscribing from your emails.
    unsubscribe-drops: option<s32>,
    /// The number of recipients who unsubscribed from your emails.
    unsubscribes: option<s32>
  }

  /// Retrieve email statistics by browser.
  record get-browsers-stats-params {
    /// The browsers to get statistics for. You can include up to 10 different browsers by including this parameter multiple times.
    browsers: option<string>,
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-browsers-stats: func(params: get-browsers-stats-params) -> result<list<get-browsers-stats-response-item>, string>;

  /// Retrieve email statistics by client type.
  record get-clients-stats-params {
    on-behalf-of: option<string>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>
  }
  get-clients-stats: func(params: get-clients-stats-params) -> result<list<get-clients-stats-response-item>, string>;

  /// Retrieve stats by a specific client type.
  record get-clients-client-type-stats-params {
    /// Specifies the type of client to retrieve stats for. Must be either "phone", "tablet", "webmail", or "desktop".
    client-type: string,
    on-behalf-of: option<string>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>
  }
  get-clients-client-type-stats: func(params: get-clients-client-type-stats-params) -> result<list<get-clients-client-type-stats-response-item>, string>;

  /// Retrieve email statistics by device type.
  record get-devices-stats-params {
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-devices-stats: func(params: get-devices-stats-params) -> result<list<get-devices-stats-response-item>, string>;

  /// Retrieve email statistics by country and state/province.
  record get-geo-stats-params {
    /// The country you would like to see statistics for. Currently only supported for US and CA.
    country: option<get-geo-stats-country-enum>,
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-geo-stats: func(params: get-geo-stats-params) -> result<list<get-geo-stats-response-item>, string>;

  /// Retrieve email statistics by mailbox provider.
  record get-mailbox-providers-stats-params {
    /// The mail box providers to get statistics for. You can include up to 10 by including this parameter multiple times.
    mailbox-providers: option<string>,
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-mailbox-providers-stats: func(params: get-mailbox-providers-stats-params) -> result<list<get-mailbox-providers-stats-response-item>, string>;

  /// Retrieve global email statistics
  record get-stats-params {
    on-behalf-of: option<string>,
    /// The number of results to return.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-browsers-stats-aggregated-by-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>
  }
  get-stats: func(params: get-stats-params) -> result<list<get-stats-response-item>, string>;

}

interface campaigns-api {
  enum campaign-response-editor-enum {
    code,
    design,
  }

  enum post-campaigns-campaign-id-schedules-response-status-enum {
    scheduled,
  }

  record get-campaigns-response {
    result-op: option<list<campaign-response>>
  }

  record campaign-response {
    /// The categories you would like associated to this campaign.
    categories: option<list<string>>,
    /// This is the url of the custom unsubscribe page that you provide for customers to unsubscribe from your suppression groups.
    custom-unsubscribe-url: option<string>,
    /// The editor used in the UI.
    editor: option<campaign-response-editor-enum>,
    /// The HTML of your marketing email.
    html-content: option<string>,
    /// The pool of IPs that you would like to send this email from.
    ip-pool: option<string>,
    /// The IDs of the lists you are sending this campaign to. You can have both segment IDs and list IDs
    list-ids: option<list<s32>>,
    /// The plain text content of your emails.
    plain-content: option<string>,
    /// The segment IDs that you are sending this list to. You can have both segment IDs and list IDs. Segments are limited to 10 segment IDs.
    segment-ids: option<list<s32>>,
    /// The ID of the "sender" identity that you have created. Your recipients will see this as the "from" on your marketing emails.
    sender-id: option<s32>,
    /// The subject of your campaign that your recipients will see.
    subject: option<string>,
    /// The suppression group that this marketing email belongs to, allowing recipients to opt-out of emails of this type.
    suppression-group-id: option<s32>,
    /// The display title of your campaign. This will be viewable by you in the Marketing Campaigns UI.
    title: string,
    id: option<s32>,
    /// The status of your campaign.
    status: string
  }

  record get-campaigns-campaign-id-response {
    categories: option<list<string>>,
    custom-unsubscribe-url: option<string>,
    html-content: option<string>,
    id: option<s32>,
    ip-pool: option<string>,
    list-ids: option<list<s32>>,
    plain-content: option<string>,
    segment-ids: option<list<s32>>,
    sender-id: option<s32>,
    status: option<string>,
    subject: option<string>,
    suppression-group-id: option<s32>,
    title: option<string>
  }

  record get-campaigns-campaign-id-schedules-response {
    send-at: s64
  }

  record post-campaigns-campaign-id-schedules-response {
    /// The campaign ID.
    id: s32,
    /// The date time you scheduled your campaign to be sent.
    send-at: s32,
    /// The status of your campaign.
    status: post-campaigns-campaign-id-schedules-response-status-enum
  }

  record patch-campaigns-campaign-id-schedules-response {
    /// The campaign ID
    id: s32,
    /// The unix timestamp to send the campaign.
    send-at: s32,
    /// The status of the schedule.
    status: string
  }

  record post-campaigns-campaign-id-schedules-now-response {
    id: s64,
    status: string
  }

  record post-campaigns-campaign-id-schedules-test-response {
    to: string
  }

  variant post-campaigns-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-campaigns-campaign-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant patch-campaigns-campaign-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-campaigns-campaign-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-campaigns-campaign-id-schedules-error {
    not-found(string),
    other(string)
  }

  variant post-campaigns-campaign-id-schedules-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant patch-campaigns-campaign-id-schedules-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-campaigns-campaign-id-schedules-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant post-campaigns-campaign-id-schedules-now-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant post-campaigns-campaign-id-schedules-test-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  /// Retrieve all Campaigns
  record get-campaigns-params {
    /// The number of results you would like to receive at a time.
    limit: option<s32>,
    /// The index of the first campaign to return, where 0 is the first campaign.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-campaigns: func(params: get-campaigns-params) -> result<get-campaigns-response, string>;

  /// Create a Campaign
  record post-campaigns-params {
    on-behalf-of: option<string>,
    /// The categories you would like associated to this campaign.
    categories: option<list<string>>,
    /// This is the url of the custom unsubscribe page that you provide for customers to unsubscribe from your suppression groups.
    custom-unsubscribe-url: option<string>,
    /// The editor used in the UI.
    editor: option<campaign-response-editor-enum>,
    /// The HTML of your marketing email.
    html-content: option<string>,
    /// The pool of IPs that you would like to send this email from.
    ip-pool: option<string>,
    /// The IDs of the lists you are sending this campaign to. You can have both segment IDs and list IDs
    list-ids: option<list<s32>>,
    /// The plain text content of your emails.
    plain-content: option<string>,
    /// The segment IDs that you are sending this list to. You can have both segment IDs and list IDs. Segments are limited to 10 segment IDs.
    segment-ids: option<list<s32>>,
    /// The ID of the "sender" identity that you have created. Your recipients will see this as the "from" on your marketing emails.
    sender-id: option<s32>,
    /// The subject of your campaign that your recipients will see.
    subject: option<string>,
    /// The suppression group that this marketing email belongs to, allowing recipients to opt-out of emails of this type.
    suppression-group-id: option<s32>,
    /// The display title of your campaign. This will be viewable by you in the Marketing Campaigns UI.
    title: string
  }
  post-campaigns: func(params: post-campaigns-params) -> result<campaign-response, post-campaigns-error>;

  /// Retrieve a single campaign
  record get-campaigns-campaign-id-params {
    /// The id of the campaign you would like to retrieve.
    campaign-id: string,
    on-behalf-of: option<string>
  }
  get-campaigns-campaign-id: func(params: get-campaigns-campaign-id-params) -> result<get-campaigns-campaign-id-response, get-campaigns-campaign-id-error>;

  /// Update a Campaign
  record patch-campaigns-campaign-id-params {
    /// The id of the campaign you would like to retrieve.
    campaign-id: string,
    on-behalf-of: option<string>,
    /// The categories you want to tag on this campaign.
    categories: list<string>,
    /// The HTML content of this campaign.
    html-content: string,
    /// The plain content of this campaign.
    plain-content: string,
    /// The subject line for your campaign.
    subject: string,
    /// The title of the campaign.
    title: string
  }
  patch-campaigns-campaign-id: func(params: patch-campaigns-campaign-id-params) -> result<campaign-response, patch-campaigns-campaign-id-error>;

  /// Delete a Campaign
  record delete-campaigns-campaign-id-params {
    /// The id of the campaign you would like to retrieve.
    campaign-id: string,
    on-behalf-of: option<string>
  }
  delete-campaigns-campaign-id: func(params: delete-campaigns-campaign-id-params) -> result<string, delete-campaigns-campaign-id-error>;

  /// View Scheduled Time of a Campaign
  record get-campaigns-campaign-id-schedules-params {
    campaign-id: string,
    on-behalf-of: option<string>
  }
  get-campaigns-campaign-id-schedules: func(params: get-campaigns-campaign-id-schedules-params) -> result<get-campaigns-campaign-id-schedules-response, get-campaigns-campaign-id-schedules-error>;

  /// Schedule a Campaign
  record post-campaigns-campaign-id-schedules-params {
    campaign-id: string,
    on-behalf-of: option<string>,
    /// The unix timestamp for the date and time you would like your campaign to be sent out.
    send-at: s32
  }
  post-campaigns-campaign-id-schedules: func(params: post-campaigns-campaign-id-schedules-params) -> result<post-campaigns-campaign-id-schedules-response, post-campaigns-campaign-id-schedules-error>;

  /// Update a Scheduled Campaign
  record patch-campaigns-campaign-id-schedules-params {
    campaign-id: string,
    on-behalf-of: option<string>,
    send-at: s64
  }
  patch-campaigns-campaign-id-schedules: func(params: patch-campaigns-campaign-id-schedules-params) -> result<patch-campaigns-campaign-id-schedules-response, patch-campaigns-campaign-id-schedules-error>;

  /// Unschedule a Scheduled Campaign
  record delete-campaigns-campaign-id-schedules-params {
    campaign-id: string,
    on-behalf-of: option<string>
  }
  delete-campaigns-campaign-id-schedules: func(params: delete-campaigns-campaign-id-schedules-params) -> result<string, delete-campaigns-campaign-id-schedules-error>;

  /// Send a Campaign
  record post-campaigns-campaign-id-schedules-now-params {
    campaign-id: string,
    on-behalf-of: option<string>
  }
  post-campaigns-campaign-id-schedules-now: func(params: post-campaigns-campaign-id-schedules-now-params) -> result<post-campaigns-campaign-id-schedules-now-response, post-campaigns-campaign-id-schedules-now-error>;

  /// Send a Test Campaign
  record post-campaigns-campaign-id-schedules-test-params {
    campaign-id: string,
    on-behalf-of: option<string>,
    /// The email address that should receive the test campaign.
    to: string
  }
  post-campaigns-campaign-id-schedules-test: func(params: post-campaigns-campaign-id-schedules-test-params) -> result<post-campaigns-campaign-id-schedules-test-response, post-campaigns-campaign-id-schedules-test-error>;

}

interface categories {
  enum get-categories-stats-aggregated-by-enum {
    day,
    week,
    month,
  }

  enum get-categories-stats-sums-sort-by-direction-enum {
    desc,
    asc,
  }

  record get-categories-response-item {
    /// A category used to group emails by broad topic.
    category: string
  }

  record category-stats {
    /// The date the statistics were gathered.
    date: string,
    stats: option<list<category-stats-stats-item>>
  }

  record category-stats-stats-item {
    metrics: option<category-stats-stats-item-metrics>,
    /// The name of the category.
    name: option<string>,
    /// How you are segmenting your statistics.
    type-op: string
  }

  record category-stats-stats-item-metrics {
    /// The number of emails that were not allowed to be delivered by ISPs.
    blocks: s32,
    /// The number of emails that were dropped because of a bounce.
    bounce-drops: s32,
    /// The number of emails that bounced instead of being delivered.
    bounces: s32,
    /// The number of links that were clicked.
    clicks: s32,
    /// The number of emails that temporarily could not be delivered.
    deferred: s32,
    /// The number of emails SendGrid was able to confirm were actually delivered to a recipient.
    delivered: s32,
    /// The number of recipients who had malformed email addresses or whose mail provider reported the address as invalid.
    invalid-emails: s32,
    /// The total number of times your emails were opened by recipients.
    opens: s32,
    /// Requests from your website, application, or mail client via SMTP Relay or the API that SendGrid processed.
    processed: s32,
    /// The number of emails that were requested to be delivered.
    requests: s32,
    /// The number of emails that were dropped due to a recipient previously marking your emails as spam.
    spam-report-drops: s32,
    /// The number of recipients who marked your email as spam.
    spam-reports: s32,
    /// The number of unique recipients who clicked links in your emails.
    unique-clicks: s32,
    /// The number of unique recipients who opened your emails.
    unique-opens: s32,
    /// The number of emails dropped due to a recipient unsubscribing from your emails.
    unsubscribe-drops: s32,
    /// The number of recipients who unsubscribed from your emails.
    unsubscribes: s32
  }

  variant get-categories-error {
    bad-request(string),
    other(string)
  }

  /// Retrieve all categories
  record get-categories-params {
    /// The number of categories to display per page.
    limit: option<s32>,
    /// Allows you to perform a prefix search on this particular category.
    category: option<string>,
    /// The point in the list that you would like to begin displaying results.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-categories: func(params: get-categories-params) -> result<list<get-categories-response-item>, get-categories-error>;

  /// Retrieve Email Statistics for Categories
  record get-categories-stats-params {
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// The individual categories that you want to retrieve statistics for. You may include up to 10 different categories.
    categories: string,
    /// The number of results to include.
    limit: option<s32>,
    /// The number of results to skip.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-categories-stats-aggregated-by-enum>,
    on-behalf-of: option<string>
  }
  get-categories-stats: func(params: get-categories-stats-params) -> result<list<category-stats>, string>;

  /// Retrieve sums of email stats for each category [Needs: Stats object defined, has category ID?]
  record get-categories-stats-sums-params {
    /// The metric that you want to sort by.  Must be a single metric.
    sort-by-metric: option<string>,
    /// The direction you want to sort.
    sort-by-direction: option<get-categories-stats-sums-sort-by-direction-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// Limits the number of results returned.
    limit: option<s32>,
    /// The point in the list to begin retrieving results.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-categories-stats-aggregated-by-enum>,
    on-behalf-of: option<string>
  }
  get-categories-stats-sums: func(params: get-categories-stats-sums-params) -> result<category-stats, string>;

}

interface contacts-api-custom-fields {
  enum contactdb-custom-field-with-id-type-op-enum {
    date,
    text,
    number,
  }

  record get-contactdb-custom-fields-response {
    custom-fields: list<contactdb-custom-field-with-id>
  }

  record contactdb-custom-field-with-id {
    /// The name of the field
    name: option<string>,
    /// The type of the field.
    type-op: option<contactdb-custom-field-with-id-type-op-enum>,
    /// The ID of the custom field.
    id: option<f64>
  }

  record global-error-response-schema {
    errors: option<list<global-error-response-schema-errors-item>>,
    id: option<string>
  }

  record global-error-response-schema-errors-item {
    /// the field that generated the error
    field: option<string>,
    /// helper text or docs for troubleshooting
    help: option<list<global-error-response-schema-errors-item-help-entry>>,
    /// the error message
    message: string
  }

  /// one entry of a string-keyed map (free-form object)
  record global-error-response-schema-errors-item-help-entry {
    key: string,
    value: string
  }

  record get-contactdb-reserved-fields-response {
    reserved-fields: option<list<get-contactdb-reserved-fields-response-reserved-fields-item>>
  }

  record get-contactdb-reserved-fields-response-reserved-fields-item {
    name: option<string>,
    type-op: option<string>
  }

  variant get-contactdb-custom-fields-error {
    unauthorized(string),
    other(string)
  }

  variant post-contactdb-custom-fields-error {
    bad-request(string),
    other(string)
  }

  variant get-contactdb-custom-fields-custom-field-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-contactdb-custom-fields-custom-field-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-contactdb-reserved-fields-error {
    unauthorized(string),
    other(string)
  }

  /// Retrieve all custom fields
  record get-contactdb-custom-fields-params {
    on-behalf-of: option<string>
  }
  get-contactdb-custom-fields: func(params: get-contactdb-custom-fields-params) -> result<get-contactdb-custom-fields-response, get-contactdb-custom-fields-error>;

  /// Create a Custom Field
  record post-contactdb-custom-fields-params {
    on-behalf-of: option<string>,
    name: option<string>,
    type-op: option<string>
  }
  post-contactdb-custom-fields: func(params: post-contactdb-custom-fields-params) -> result<contactdb-custom-field-with-id, post-contactdb-custom-fields-error>;

  /// Retrieve a Custom Field
  record get-contactdb-custom-fields-custom-field-id-params {
    /// The ID of the custom field that you want to retrieve.
    custom-field-id: string,
    on-behalf-of: option<string>
  }
  get-contactdb-custom-fields-custom-field-id: func(params: get-contactdb-custom-fields-custom-field-id-params) -> result<contactdb-custom-field-with-id, get-contactdb-custom-fields-custom-field-id-error>;

  /// Delete a Custom Field
  record delete-contactdb-custom-fields-custom-field-id-params {
    /// The ID of the custom field that you want to retrieve.
    custom-field-id: string,
    on-behalf-of: option<string>
  }
  delete-contactdb-custom-fields-custom-field-id: func(params: delete-contactdb-custom-fields-custom-field-id-params) -> result<global-error-response-schema, delete-contactdb-custom-fields-custom-field-id-error>;

  /// Retrieve reserved fields
  record get-contactdb-reserved-fields-params {
    on-behalf-of: option<string>
  }
  get-contactdb-reserved-fields: func(params: get-contactdb-reserved-fields-params) -> result<get-contactdb-reserved-fields-response, get-contactdb-reserved-fields-error>;

}

interface contacts-api-lists {
  enum contactdb-custom-field-with-id-value-type-op-enum {
    date,
    text,
    number,
  }

  record get-contactdb-lists-response {
    lists: list<contactdb-list>
  }

  record contactdb-list {
    /// The reference ID of your list.
    id: s32,
    /// The name of your list. Must be unique against all other list and segment names.
    name: string,
    /// The count of recipients currently in the list.
    recipient-count: s32
  }

  record patch-contactdb-lists-list-id-response {
    /// The ID of the list
    id: option<s32>,
    /// The new name for the list
    name: option<string>,
    /// The number of recipients on the list
    recipient-count: option<s32>
  }

  record get-contactdb-lists-list-id-recipients-response {
    recipients: option<list<contactdb-recipient>>
  }

  record contactdb-recipient {
    recipients: option<list<contactdb-recipient-recipients-item>>
  }

  record contactdb-recipient-recipients-item {
    /// The time this record was created in your contactdb, in unixtime.
    created-at: option<f64>,
    /// The custom fields assigned to this recipient and their values.
    custom-fields: option<list<contactdb-custom-field-with-id-value>>,
    /// The email address of this recipient. This is a default custom field that SendGrid provides.
    email: string,
    /// The first name of this recipient. This is a default custom field that SendGrid provides.
    first-name: option<string>,
    /// The ID of this recipient.
    id: option<string>,
    /// The last time this recipient clicked a link from one of your campaigns, in unixtime.
    last-clicked: option<f64>,
    /// The last time this user was emailed by one of your campaigns, in unixtime.
    last-emailed: option<f64>,
    /// The last name of the recipient.
    last-name: option<string>,
    /// The last time this recipient opened an email from you, in unixtime.
    last-opened: option<f64>,
    /// The last update date for this recipient's record.
    updated-at: option<f64>
  }

  record contactdb-custom-field-with-id-value {
    /// The name of the field
    name: option<string>,
    /// The type of the field.
    type-op: option<contactdb-custom-field-with-id-value-type-op-enum>,
    /// The ID of the custom field.
    id: option<f64>,
    /// The value of this recipient's custom field
    value: option<string>
  }

  variant post-contactdb-lists-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-contactdb-lists-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-contactdb-lists-list-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant patch-contactdb-lists-list-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant delete-contactdb-lists-list-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-contactdb-lists-list-id-recipients-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant post-contactdb-lists-list-id-recipients-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant post-contactdb-lists-list-id-recipients-recipient-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-contactdb-lists-list-id-recipients-recipient-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Retrieve all lists
  record get-contactdb-lists-params {
    on-behalf-of: option<string>
  }
  get-contactdb-lists: func(params: get-contactdb-lists-params) -> result<get-contactdb-lists-response, string>;

  /// Create a List
  record post-contactdb-lists-params {
    on-behalf-of: option<string>,
    name: string
  }
  post-contactdb-lists: func(params: post-contactdb-lists-params) -> result<contactdb-list, post-contactdb-lists-error>;

  /// Delete Multiple lists
  record delete-contactdb-lists-params {
    on-behalf-of: option<string>,
    body: option<list<s32>>
  }
  delete-contactdb-lists: func(params: delete-contactdb-lists-params) -> result<string, delete-contactdb-lists-error>;

  /// Retrieve a single list
  record get-contactdb-lists-list-id-params {
    list-id: string,
    /// The ID of the list to retrieve.
    list-id-v2: option<s32>,
    on-behalf-of: option<string>
  }
  get-contactdb-lists-list-id: func(params: get-contactdb-lists-list-id-params) -> result<contactdb-list, get-contactdb-lists-list-id-error>;

  /// Update a List
  record patch-contactdb-lists-list-id-params {
    list-id: string,
    /// The ID of the list you are updating.
    list-id-v2: s32,
    on-behalf-of: option<string>,
    /// The new name for your list. 
    name: string
  }
  patch-contactdb-lists-list-id: func(params: patch-contactdb-lists-list-id-params) -> result<patch-contactdb-lists-list-id-response, patch-contactdb-lists-list-id-error>;

  /// Delete a List
  record delete-contactdb-lists-list-id-params {
    list-id: string,
    /// Adds the ability to delete all contacts on the list in addition to deleting the list.
    delete-contacts: option<bool>,
    on-behalf-of: option<string>,
    body: option<string>
  }
  delete-contactdb-lists-list-id: func(params: delete-contactdb-lists-list-id-params) -> result<string, delete-contactdb-lists-list-id-error>;

  /// Retrieve all recipients on a List
  record get-contactdb-lists-list-id-recipients-params {
    /// The id of the list of recipients you want to retrieve.
    list-id: string,
    /// Page index of first recipient to return (must be a positive integer)
    page: option<s32>,
    /// Number of recipients to return at a time (must be a positive integer between 1 and 1000)
    page-size: option<s32>,
    /// The ID of the list whose recipients you are requesting.
    list-id-v2: s32,
    on-behalf-of: option<string>
  }
  get-contactdb-lists-list-id-recipients: func(params: get-contactdb-lists-list-id-recipients-params) -> result<get-contactdb-lists-list-id-recipients-response, get-contactdb-lists-list-id-recipients-error>;

  /// Add Multiple Recipients to a List
  record post-contactdb-lists-list-id-recipients-params {
    /// The id of the list of recipients you want to retrieve.
    list-id: string,
    on-behalf-of: option<string>,
    body: option<list<s32>>
  }
  post-contactdb-lists-list-id-recipients: func(params: post-contactdb-lists-list-id-recipients-params) -> result<string, post-contactdb-lists-list-id-recipients-error>;

  /// Add a Single Recipient to a List
  record post-contactdb-lists-list-id-recipients-recipient-id-params {
    /// The ID of the list that you want to add the recipient to.
    list-id: string,
    /// The ID of the recipient you are adding to the list.
    recipient-id: string,
    on-behalf-of: option<string>
  }
  post-contactdb-lists-list-id-recipients-recipient-id: func(params: post-contactdb-lists-list-id-recipients-recipient-id-params) -> result<string, post-contactdb-lists-list-id-recipients-recipient-id-error>;

  /// Delete a Single Recipient from a Single List
  record delete-contactdb-lists-list-id-recipients-recipient-id-params {
    /// The ID of the list that you want to add the recipient to.
    list-id: string,
    /// The ID of the recipient you are adding to the list.
    recipient-id: string,
    /// The ID of the list you are taking this recipient away from.
    list-id-v2: s32,
    /// The ID of the recipient to take off the list.
    recipient-id-v2: s32,
    on-behalf-of: option<string>,
    body: option<string>
  }
  delete-contactdb-lists-list-id-recipients-recipient-id: func(params: delete-contactdb-lists-list-id-recipients-recipient-id-params) -> result<string, delete-contactdb-lists-list-id-recipients-recipient-id-error>;

}

interface contacts-api-recipients {
  enum contactdb-custom-field-with-id-value-type-op-enum {
    date,
    text,
    number,
  }

  record get-contactdb-recipients-response {
    recipients: list<list<get-contactdb-recipients-response-recipients-item-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record get-contactdb-recipients-response-recipients-item-entry {
    key: string,
    value: string
  }

  record post-contactdb-recipients-body-item {
    age: option<s32>,
    /// The email address of the recipient.
    email: string,
    /// The first name of the recipient.
    first-name: option<string>,
    /// The last name of the recipient.
    last-name: option<string>
  }

  record contactdb-recipient-response {
    /// The number of errors found while adding recipients.
    error-count: f64,
    /// The indices of the recipient(s) sent that caused the error. 
    error-indices: option<list<f64>>,
    errors: option<list<contactdb-recipient-response-errors-item>>,
    /// The count of new recipients added to the contactdb.
    new-count: f64,
    /// The recipient IDs of the recipients that already existed from this request.
    persisted-recipients: list<string>,
    /// The recipients who were updated from this request.
    updated-count: f64
  }

  record contactdb-recipient-response-errors-item {
    error-indices: option<list<f64>>,
    message: option<string>
  }

  record patch-contactdb-recipients-body-item {
    email: string,
    /// The first name of the recipient. This is one of the default custom fields.
    first-name: option<string>,
    /// The last name of the recipient. This is one of the default custom fields.
    last-name: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-contactdb-recipients-response-entry {
    key: string,
    value: string
  }

  record contactdb-recipient-count {
    /// The count of recipients.
    recipient-count: f64
  }

  record get-contactdb-recipients-search-response {
    recipients: option<list<contactdb-recipient>>
  }

  record contactdb-recipient {
    recipients: option<list<contactdb-recipient-recipients-item>>
  }

  record contactdb-recipient-recipients-item {
    /// The time this record was created in your contactdb, in unixtime.
    created-at: option<f64>,
    /// The custom fields assigned to this recipient and their values.
    custom-fields: option<list<contactdb-custom-field-with-id-value>>,
    /// The email address of this recipient. This is a default custom field that SendGrid provides.
    email: string,
    /// The first name of this recipient. This is a default custom field that SendGrid provides.
    first-name: option<string>,
    /// The ID of this recipient.
    id: option<string>,
    /// The last time this recipient clicked a link from one of your campaigns, in unixtime.
    last-clicked: option<f64>,
    /// The last time this user was emailed by one of your campaigns, in unixtime.
    last-emailed: option<f64>,
    /// The last name of the recipient.
    last-name: option<string>,
    /// The last time this recipient opened an email from you, in unixtime.
    last-opened: option<f64>,
    /// The last update date for this recipient's record.
    updated-at: option<f64>
  }

  record contactdb-custom-field-with-id-value {
    /// The name of the field
    name: option<string>,
    /// The type of the field.
    type-op: option<contactdb-custom-field-with-id-value-type-op-enum>,
    /// The ID of the custom field.
    id: option<f64>,
    /// The value of this recipient's custom field
    value: option<string>
  }

  record post-contactdb-recipients-search-response {
    recipient-count: option<s32>,
    recipients: option<list<post-contactdb-recipients-search-response-recipients-item>>
  }

  record post-contactdb-recipients-search-response-recipients-item {
    created-at: option<s32>,
    custom-fields: option<list<post-contactdb-recipients-search-response-recipients-item-custom-fields-item>>,
    email: option<string>,
    first-name: option<string>,
    id: option<string>,
    last-clicked: option<s32>,
    last-emailed: option<s32>,
    last-opened: option<s32>,
    updated-at: option<s32>
  }

  record post-contactdb-recipients-search-response-recipients-item-custom-fields-item {
    id: option<s32>,
    name: option<string>,
    type-op: option<string>,
    value: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-contactdb-recipients-recipient-id-response-entry {
    key: string,
    value: string
  }

  record get-contactdb-recipients-recipient-id-lists-response {
    lists: option<list<contactdb-list>>
  }

  record contactdb-list {
    /// The reference ID of your list.
    id: s32,
    /// The name of your list. Must be unique against all other list and segment names.
    name: string,
    /// The count of recipients currently in the list.
    recipient-count: s32
  }

  record get-contactdb-status-response {
    status: option<list<get-contactdb-status-response-status-item>>
  }

  record get-contactdb-status-response-status-item {
    x: option<string>,
    /// Valid values are "worker_delay" and "worker_delay_seconds" (the second value appears only if "worker_delay" has a value of "delayed").
    id: option<string>,
    /// Valid values for the ID "worker_delay" are "OK" or "Delayed". Valid values for the ID "worker_delay_seconds" is the time of delay to upload.
    value: option<string>
  }

  variant get-contactdb-recipients-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant post-contactdb-recipients-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant patch-contactdb-recipients-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-contactdb-recipients-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-contactdb-recipients-billable-count-error {
    unauthorized(string),
    other(string)
  }

  variant get-contactdb-recipients-count-error {
    unauthorized(string),
    other(string)
  }

  variant get-contactdb-recipients-search-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant post-contactdb-recipients-search-error {
    bad-request(string),
    other(string)
  }

  variant get-contactdb-recipients-recipient-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-contactdb-recipients-recipient-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-contactdb-recipients-recipient-id-lists-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

