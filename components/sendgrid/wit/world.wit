interface transactional-templates {
  enum get-templates-generations-enum {
    legacy,
    dynamic,
    legacy-dynamic,
  }

  enum post-templates-body-generation-enum {
    legacy,
    dynamic,
  }

  /// Retrieve paged transactional templates.
  record get-templates-params {
    /// Comma-delimited list specifying which generations of templates to return. Options are `legacy`, `dynamic` or `legacy,dynamic`.
    generations: option<get-templates-generations-enum>,
    /// The number of templates to be returned in each page of results
    page-size: f64,
    /// A token corresponding to a specific page of results, as provided by metadata
    page-token: option<string>,
    on-behalf-of: option<string>
  }
  get-templates: func(params: get-templates-params) -> result<string, string>;

  /// Create a transactional template.
  record post-templates-params {
    on-behalf-of: option<string>,
    /// Defines whether the template supports dynamic replacement.
    generation: option<post-templates-body-generation-enum>,
    /// The name for the new transactional template.
    name: string
  }
  post-templates: func(params: post-templates-params) -> result<string, string>;

  /// Retrieve a single transactional template.
  record get-templates-template-id-params {
    on-behalf-of: option<string>
  }
  get-templates-template-id: func(params: get-templates-template-id-params) -> result<string, string>;

  /// Duplicate a transactional template.
  record post-templates-template-id-params {
    on-behalf-of: option<string>,
    /// The name for the new transactional template.
    name: option<string>
  }
  post-templates-template-id: func(params: post-templates-template-id-params) -> result<string, string>;

  /// Edit a transactional template.
  record patch-templates-template-id-params {
    on-behalf-of: option<string>,
    /// The name of the transactional template.
    name: option<string>
  }
  patch-templates-template-id: func(params: patch-templates-template-id-params) -> result<string, string>;

  /// Delete a template.
  record delete-templates-template-id-params {
    on-behalf-of: option<string>
  }
  delete-templates-template-id: func(params: delete-templates-template-id-params) -> result<string, string>;

}

interface transactional-templates-versions {
  enum transactional-template-version-create-editor-enum {
    code,
    design,
  }

  /// Create a new transactional template version.
  record post-templates-template-id-versions-params {
    on-behalf-of: option<string>,
    /// Set the version as the active version associated with the template (0 is inactive, 1 is active). Only one version of a template can be active. The first version created for a template will automatically be set to Active.
    active: option<s32>,
    /// The editor used in the UI.
    editor: option<transactional-template-version-create-editor-enum>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the version. Maximum of 1048576 bytes allowed.
    html-content: option<string>,
    /// Name of the transactional template version.
    name: string,
    /// Text/plain content of the transactional template version. Maximum of 1048576 bytes allowed.
    plain-content: option<string>,
    /// Subject of the new transactional template version.
    subject: string,
    /// For dynamic templates only, the mock json data that will be used for template preview and test sends.
    test-data: option<string>
  }
  post-templates-template-id-versions: func(params: post-templates-template-id-versions-params) -> result<string, string>;

  /// Retrieve a specific transactional template version.
  record get-templates-template-id-versions-version-id-params {
    on-behalf-of: option<string>
  }
  get-templates-template-id-versions-version-id: func(params: get-templates-template-id-versions-version-id-params) -> result<string, string>;

  /// Edit a transactional template version.
  record patch-templates-template-id-versions-version-id-params {
    on-behalf-of: option<string>,
    /// Set the version as the active version associated with the template (0 is inactive, 1 is active). Only one version of a template can be active. The first version created for a template will automatically be set to Active.
    active: option<s32>,
    /// The editor used in the UI.
    editor: option<transactional-template-version-create-editor-enum>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the version. Maximum of 1048576 bytes allowed.
    html-content: option<string>,
    /// Name of the transactional template version.
    name: string,
    /// Text/plain content of the transactional template version. Maximum of 1048576 bytes allowed.
    plain-content: option<string>,
    /// Subject of the new transactional template version.
    subject: string,
    /// For dynamic templates only, the mock json data that will be used for template preview and test sends.
    test-data: option<string>
  }
  patch-templates-template-id-versions-version-id: func(params: patch-templates-template-id-versions-version-id-params) -> result<string, string>;

  /// Delete a transactional template version.
  record delete-templates-template-id-versions-version-id-params {
    on-behalf-of: option<string>
  }
  delete-templates-template-id-versions-version-id: func(params: delete-templates-template-id-versions-version-id-params) -> result<string, string>;

  /// Activate a transactional template version.
  record post-templates-template-id-versions-version-id-activate-params {
    on-behalf-of: option<string>
  }
  post-templates-template-id-versions-version-id-activate: func(params: post-templates-template-id-versions-version-id-activate-params) -> result<string, string>;

}

