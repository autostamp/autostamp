    /// The frequency at which to forward monitoring emails. An email will be sent when your subuser sends this many (e.g., 1,000) emails.
    frequency: f64
  }
  put-subusers-subuser-name-monitor: func(params: put-subusers-subuser-name-monitor-params) -> result<string, string>;

  /// Delete monitor settings
  delete-subusers-subuser-name-monitor: func() -> result<string, string>;

}

