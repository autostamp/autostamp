  record get-contactdb-recipients-params {
    /// Page index of first recipients to return (must be a positive integer)
    page: option<s32>,
    /// Number of recipients to return at a time (must be a positive integer between 1 and 1000)
    page-size: option<s32>,
    on-behalf-of: option<string>
  }
  get-contactdb-recipients: func(params: get-contactdb-recipients-params) -> result<get-contactdb-recipients-response, get-contactdb-recipients-error>;

  /// Add recipients
  record post-contactdb-recipients-params {
    on-behalf-of: option<string>,
    body: option<list<post-contactdb-recipients-body-item>>
  }
  post-contactdb-recipients: func(params: post-contactdb-recipients-params) -> result<contactdb-recipient-response, post-contactdb-recipients-error>;

  /// Update Recipient
  record patch-contactdb-recipients-params {
    on-behalf-of: option<string>,
    body: option<list<patch-contactdb-recipients-body-item>>
  }
  patch-contactdb-recipients: func(params: patch-contactdb-recipients-params) -> result<contactdb-recipient-response, patch-contactdb-recipients-error>;

  /// Delete Recipients
  record delete-contactdb-recipients-params {
    on-behalf-of: option<string>,
    body: option<list<string>>
  }
  delete-contactdb-recipients: func(params: delete-contactdb-recipients-params) -> result<list<delete-contactdb-recipients-response-entry>, delete-contactdb-recipients-error>;

  /// Retrieve the count of billable recipients
  record get-contactdb-recipients-billable-count-params {
    on-behalf-of: option<string>
  }
  get-contactdb-recipients-billable-count: func(params: get-contactdb-recipients-billable-count-params) -> result<contactdb-recipient-count, get-contactdb-recipients-billable-count-error>;

