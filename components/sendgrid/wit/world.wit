    /// The email address of a specific spam report that you want to retrieve.
    email: string,
    on-behalf-of: option<string>
  }
  delete-suppression-spam-reports-email: func(params: delete-suppression-spam-reports-email-params) -> result<list<delete-suppression-spam-reports-email-response-entry>, string>;

}

interface transactional-templates {
  enum get-templates-generations-enum {
    legacy,
    dynamic,
    legacy-dynamic,
  }

  enum template-lean-generation-enum {
    legacy,
    dynamic,
  }

  enum version-output-lean-editor-enum {
    code,
    design,
  }

  record get-templates-response {
    metadata: option<metadata>,
    result-op: option<list<template-lean>>
  }

  record metadata {
    count: option<s32>,
    next: option<string>,
    prev: option<string>,
    self: option<string>
  }

  record template-lean {
    /// Defines the generation of the template.
    generation: template-lean-generation-enum,
    /// The ID of the transactional template.
    id: string,
    /// The name for the transactional template.
    name: string,
    /// The date and time that this transactional template version was updated.
    updated-at: string,
    /// The different versions of this transactional template.
    versions: option<list<version-output-lean>>
  }

  record version-output-lean {
    /// Set the version as the active version associated with the template. Only one version of a template can be active. The first version created for a template will automatically be set to Active.
    active: option<s32>,
    /// The editor used in the UI.
    editor: option<version-output-lean-editor-enum>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// ID of the transactional template version.
    id: option<string>,
    /// Name of the transactional template version.
    name: option<string>,
    /// Subject of the new transactional template version.
    subject: option<string>,
    /// ID of the transactional template.
    template-id: option<string>,
    /// A Thumbnail preview of the template's html content.
    thumbnail-url: option<string>,
    /// The date and time that this transactional template version was updated.
    updated-at: option<string>
  }

  record transactional-template {
    /// Defines the generation of the template.
    generation: template-lean-generation-enum,
    /// The ID of the transactional template.
    id: string,
    /// The name for the transactional template.
    name: string,
    /// The date and time that this transactional template version was updated.
    updated-at: string,
    /// The different versions of this transactional template.
    versions: option<list<version-output-lean>>,
    warning: option<transactional-template-warning>
  }

  record transactional-template-warning {
    /// Warning message for the user
    message: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-templates-template-id-response-entry {
    key: string,
    value: string
  }

  variant get-templates-error {
    bad-request(string),
    other(string)
  }

  /// Retrieve paged transactional templates.
  record get-templates-params {
    /// Comma-delimited list specifying which generations of templates to return. Options are `legacy`, `dynamic` or `legacy,dynamic`.
    generations: option<get-templates-generations-enum>,
    /// The number of templates to be returned in each page of results
    page-size: f64,
    /// A token corresponding to a specific page of results, as provided by metadata
    page-token: option<string>,
    on-behalf-of: option<string>
  }
  get-templates: func(params: get-templates-params) -> result<get-templates-response, get-templates-error>;

  /// Create a transactional template.
  record post-templates-params {
    on-behalf-of: option<string>,
    /// Defines whether the template supports dynamic replacement.
    generation: option<template-lean-generation-enum>,
    /// The name for the new transactional template.
    name: string
  }
  post-templates: func(params: post-templates-params) -> result<transactional-template, string>;

  /// Retrieve a single transactional template.
  record get-templates-template-id-params {
    template-id: string,
    on-behalf-of: option<string>
  }
  get-templates-template-id: func(params: get-templates-template-id-params) -> result<transactional-template, string>;

  /// Duplicate a transactional template.
  record post-templates-template-id-params {
    template-id: string,
    on-behalf-of: option<string>,
    /// The name for the new transactional template.
    name: option<string>
  }
  post-templates-template-id: func(params: post-templates-template-id-params) -> result<transactional-template, string>;

  /// Edit a transactional template.
  record patch-templates-template-id-params {
    template-id: string,
    on-behalf-of: option<string>,
    /// The name of the transactional template.
    name: option<string>
  }
  patch-templates-template-id: func(params: patch-templates-template-id-params) -> result<transactional-template, string>;

  /// Delete a template.
  record delete-templates-template-id-params {
    template-id: string,
    on-behalf-of: option<string>
  }
  delete-templates-template-id: func(params: delete-templates-template-id-params) -> result<list<delete-templates-template-id-response-entry>, string>;

}

interface transactional-templates-versions {
  enum transactional-template-version-create-editor-enum {
    code,
    design,
  }

  record transactional-template-version-output {
    warnings: option<list<transactional-template-warning>>,
    /// Set the version as the active version associated with the template (0 is inactive, 1 is active). Only one version of a template can be active. The first version created for a template will automatically be set to Active.
    active: option<s32>,
    /// The editor used in the UI.
    editor: option<transactional-template-version-create-editor-enum>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the version. Maximum of 1048576 bytes allowed.
    html-content: option<string>,
    /// Name of the transactional template version.
    name: string,
    /// Text/plain content of the transactional template version. Maximum of 1048576 bytes allowed.
    plain-content: option<string>,
    /// Subject of the new transactional template version.
    subject: string,
    /// For dynamic templates only, the mock json data that will be used for template preview and test sends.
    test-data: option<string>,
    /// ID of the transactional template version.
    id: option<string>,
    /// ID of the transactional template.
    template-id: option<string>,
    /// A Thumbnail preview of the template's html content.
    thumbnail-url: option<string>,
    /// The date and time that this transactional template version was updated.
    updated-at: option<string>
  }

  record transactional-template-warning {
    /// Warning message for the user
    message: option<string>
  }

  /// Create a new transactional template version.
  record post-templates-template-id-versions-params {
    template-id: string,
    on-behalf-of: option<string>,
    /// Set the version as the active version associated with the template (0 is inactive, 1 is active). Only one version of a template can be active. The first version created for a template will automatically be set to Active.
    active: option<s32>,
    /// The editor used in the UI.
    editor: option<transactional-template-version-create-editor-enum>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the version. Maximum of 1048576 bytes allowed.
    html-content: option<string>,
    /// Name of the transactional template version.
    name: string,
    /// Text/plain content of the transactional template version. Maximum of 1048576 bytes allowed.
    plain-content: option<string>,
    /// Subject of the new transactional template version.
    subject: string,
    /// For dynamic templates only, the mock json data that will be used for template preview and test sends.
    test-data: option<string>
  }
  post-templates-template-id-versions: func(params: post-templates-template-id-versions-params) -> result<transactional-template-version-output, string>;

  /// Retrieve a specific transactional template version.
  record get-templates-template-id-versions-version-id-params {
    ///  The ID of the original template
    template-id: string,
    /// The ID of the template version
    version-id: string,
    on-behalf-of: option<string>
  }
  get-templates-template-id-versions-version-id: func(params: get-templates-template-id-versions-version-id-params) -> result<transactional-template-version-output, string>;

  /// Edit a transactional template version.
  record patch-templates-template-id-versions-version-id-params {
    ///  The ID of the original template
    template-id: string,
    /// The ID of the template version
    version-id: string,
    on-behalf-of: option<string>,
    /// Set the version as the active version associated with the template (0 is inactive, 1 is active). Only one version of a template can be active. The first version created for a template will automatically be set to Active.
    active: option<s32>,
    /// The editor used in the UI.
    editor: option<transactional-template-version-create-editor-enum>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the version. Maximum of 1048576 bytes allowed.
    html-content: option<string>,
    /// Name of the transactional template version.
    name: string,
    /// Text/plain content of the transactional template version. Maximum of 1048576 bytes allowed.
    plain-content: option<string>,
    /// Subject of the new transactional template version.
    subject: string,
    /// For dynamic templates only, the mock json data that will be used for template preview and test sends.
    test-data: option<string>
  }
  patch-templates-template-id-versions-version-id: func(params: patch-templates-template-id-versions-version-id-params) -> result<transactional-template-version-output, string>;

  /// Delete a transactional template version.
  record delete-templates-template-id-versions-version-id-params {
    ///  The ID of the original template
    template-id: string,
    /// The ID of the template version
    version-id: string,
    on-behalf-of: option<string>
  }
  delete-templates-template-id-versions-version-id: func(params: delete-templates-template-id-versions-version-id-params) -> result<string, string>;

  /// Activate a transactional template version.
  record post-templates-template-id-versions-version-id-activate-params {
    /// The ID of the original template
    template-id: string,
    /// The ID of the template version
    version-id: string,
    on-behalf-of: option<string>
  }
  post-templates-template-id-versions-version-id-activate: func(params: post-templates-template-id-versions-version-id-activate-params) -> result<transactional-template-version-output, string>;

}

interface settings-tracking {
  record get-tracking-settings-response {
    /// The list of all tracking settings.
    result-op: option<list<get-tracking-settings-response-result-op-item>>
  }

  record get-tracking-settings-response-result-op-item {
    /// A description about the event that is being tracked.
    description: option<string>,
    /// Indicates if this tracking setting is currently enabled.
    enabled: option<bool>,
    /// The name of the event being tracked.
    name: option<string>,
    /// The title of the tracking setting.
    title: option<string>
  }

  record click-tracking {
    /// Indicates if click tracking is enabled for plain text emails.
    enable-text: bool,
    /// Indicates if click tracking is enabled or disabled.
    enabled: bool
  }

  record google-analytics-settings {
    /// Indicates if Google Analytics is enabled.
    enabled: option<bool>,
    /// The name of the campaign.
    utm-campaign: option<string>,
    /// Used to differentiate ads
    utm-content: option<string>,
    /// Name of the marketing medium (e.g. "Email").
    utm-medium: option<string>,
    /// Name of the referrer source. 
    utm-source: option<string>,
    /// Any paid keywords.
    utm-term: option<string>
  }

  record get-tracking-settings-open-response {
    /// Indicates if open tracking is enabled.
    enabled: bool
  }

  record patch-tracking-settings-open-response {
    /// Indicates if open tracking is enabled.
    enabled: bool
  }

  record subscription-tracking-settings {
    /// Indicates if subscription tracking is enabled.
    enabled: option<bool>,
    /// The information and HTML for your unsubscribe link. 
    html-content: option<string>,
    /// The HTML that will be displayed on the page that your customers will see after clicking unsubscribe, hosted on SendGrid’s server.
    landing: option<string>,
    /// The information in plain text for your unsubscribe link. You should have the “<% %>” tag in your content, otherwise the user will have no URL for unsubscribing.
    plain-content: option<string>,
    /// Your custom defined replacement tag for your templates. Use this tag to place your unsubscribe content anywhere in your emailtemplate.
    replace: option<string>,
    /// The URL where you would like your users sent to unsubscribe.
    url: option<string>
  }

  /// Retrieve Tracking Settings
  record get-tracking-settings-params {
    on-behalf-of: option<string>
  }
  get-tracking-settings: func(params: get-tracking-settings-params) -> result<get-tracking-settings-response, string>;

  /// Retrieve Click Track Settings
  record get-tracking-settings-click-params {
    on-behalf-of: option<string>
  }
  get-tracking-settings-click: func(params: get-tracking-settings-click-params) -> result<click-tracking, string>;

  /// Update Click Tracking Settings
  record patch-tracking-settings-click-params {
    on-behalf-of: option<string>,
    /// The setting you want to use for click tracking.
    enabled: option<bool>
  }
  patch-tracking-settings-click: func(params: patch-tracking-settings-click-params) -> result<click-tracking, string>;

  /// Retrieve Google Analytics Settings
  record get-tracking-settings-google-analytics-params {
    on-behalf-of: option<string>
  }
  get-tracking-settings-google-analytics: func(params: get-tracking-settings-google-analytics-params) -> result<google-analytics-settings, string>;

  /// Update Google Analytics Settings
  record patch-tracking-settings-google-analytics-params {
    on-behalf-of: option<string>,
    /// Indicates if Google Analytics is enabled.
    enabled: option<bool>,
    /// The name of the campaign.
    utm-campaign: option<string>,
    /// Used to differentiate ads
    utm-content: option<string>,
    /// Name of the marketing medium (e.g. "Email").
    utm-medium: option<string>,
    /// Name of the referrer source. 
    utm-source: option<string>,
    /// Any paid keywords.
    utm-term: option<string>
  }
  patch-tracking-settings-google-analytics: func(params: patch-tracking-settings-google-analytics-params) -> result<google-analytics-settings, string>;

  /// Get Open Tracking Settings
  record get-tracking-settings-open-params {
    on-behalf-of: option<string>
  }
  get-tracking-settings-open: func(params: get-tracking-settings-open-params) -> result<get-tracking-settings-open-response, string>;

  /// Update Open Tracking Settings
  record patch-tracking-settings-open-params {
    on-behalf-of: option<string>,
    /// The new status that you want to set for open tracking.
    enabled: option<bool>
  }
  patch-tracking-settings-open: func(params: patch-tracking-settings-open-params) -> result<patch-tracking-settings-open-response, string>;

  /// Retrieve Subscription Tracking Settings
  record get-tracking-settings-subscription-params {
    on-behalf-of: option<string>
  }
  get-tracking-settings-subscription: func(params: get-tracking-settings-subscription-params) -> result<subscription-tracking-settings, string>;

  /// Update Subscription Tracking Settings
  record patch-tracking-settings-subscription-params {
    on-behalf-of: option<string>,
    /// Indicates if subscription tracking is enabled.
    enabled: option<bool>,
    /// The information and HTML for your unsubscribe link. 
    html-content: option<string>,
    /// The HTML that will be displayed on the page that your customers will see after clicking unsubscribe, hosted on SendGrid’s server.
    landing: option<string>,
    /// The information in plain text for your unsubscribe link. You should have the “<% %>” tag in your content, otherwise the user will have no URL for unsubscribing.
    plain-content: option<string>,
    /// Your custom defined replacement tag for your templates. Use this tag to place your unsubscribe content anywhere in your emailtemplate.
    replace: option<string>,
    /// The URL where you would like your users sent to unsubscribe.
    url: option<string>
  }
  patch-tracking-settings-subscription: func(params: patch-tracking-settings-subscription-params) -> result<subscription-tracking-settings, string>;

}

interface users-api {
  enum get-user-account-response-type-op-enum {
    free,
    paid,
  }

  record get-user-account-response {
    /// The sender reputation for this user.
    reputation: f64,
    /// The type of account for this user.
    type-op: get-user-account-response-type-op-enum
  }

  record get-user-credits-response {
    /// The date that your credit balance was last reset.
    last-reset: string,
    /// The next date that your credit balance will be reset.
    next-reset: string,
    /// The number of overdrawn credits for your account.
    overage: s32,
    /// The remaining number of credits available on your account.
    remain: s32,
    /// The frequency at which your credit balance will be reset.
    reset-frequency: string,
    /// The total number of credits assigned to your account.
    total: s32,
    /// The number of credits that you have used.
    used: s32
  }

  record get-user-email-response {
    /// The email address currently on file for your account.
    email: string
  }

  record put-user-email-response {
    /// The current email address on file for your account.
    email: string
  }

  /// one entry of a string-keyed map (free-form object)
  record put-user-password-response-entry {
    key: string,
    value: string
  }

  record get-user-profile-response {
    /// The user's address.
    address: string,
    /// The second line of the user's address.
    address2: option<string>,
    /// The user's city.
    city: string,
    /// The name of the user's company.
    company: string,
    /// The user's country.
    country: string,
    /// The user's first name.
    first-name: string,
    /// The user's last name.
    last-name: string,
    /// The user's phone number.
    phone: string,
    /// The user's state.
    state: string,
    /// The user's website URL.
    website: string,
    /// The user's zip code.
    zip: string
  }

  record user-profile {
    /// The street address for this user profile.
    address: option<string>,
    /// An optional second line for the street address of this user profile.
    address2: option<string>,
    /// The city for the user profile.
    city: option<string>,
    /// That company that this user profile is associated with.
    company: option<string>,
    /// Th country of this user profile.
    country: option<string>,
    /// The first name of the user.
    first-name: option<string>,
    /// The last name of the user.
    last-name: option<string>,
    /// The phone number for the user.
    phone: option<string>,
    /// The state for this user.
    state: option<string>,
    /// The website associated with this user.
    website: option<string>,
    /// The zip code for this user.
    zip: option<string>
  }

  record get-user-username-response {
    /// The user ID for your account.
    user-id: s32,
    /// Your account username.
    username: string
  }

  record put-user-username-response {
    /// The current username on file for your account.
    username: string
  }

  variant patch-user-profile-error {
    unauthorized(string),
    other(string)
  }

  /// Get a user's account information.
  record get-user-account-params {
    on-behalf-of: option<string>
  }
  get-user-account: func(params: get-user-account-params) -> result<get-user-account-response, string>;

  /// Retrieve your credit balance
  record get-user-credits-params {
    on-behalf-of: option<string>
  }
  get-user-credits: func(params: get-user-credits-params) -> result<get-user-credits-response, string>;

  /// Retrieve your account email address
  record get-user-email-params {
    on-behalf-of: option<string>
  }
  get-user-email: func(params: get-user-email-params) -> result<get-user-email-response, string>;

  /// Update your account email address
  record put-user-email-params {
    on-behalf-of: option<string>,
    /// The new email address that you would like to use for your account.
    email: option<string>
  }
  put-user-email: func(params: put-user-email-params) -> result<put-user-email-response, string>;

  /// Update your password
  record put-user-password-params {
    on-behalf-of: option<string>,
    /// The new password you would like to use for your account.
    new-password: string,
    /// The old password for your account.
    old-password: string
  }
  put-user-password: func(params: put-user-password-params) -> result<list<put-user-password-response-entry>, string>;

  /// Get a user's profile
  record get-user-profile-params {
    on-behalf-of: option<string>
  }
  get-user-profile: func(params: get-user-profile-params) -> result<get-user-profile-response, string>;

  /// Update a user's profile
  record patch-user-profile-params {
    on-behalf-of: option<string>,
    /// The street address for this user profile.
    address: option<string>,
    /// An optional second line for the street address of this user profile.
    address2: option<string>,
    /// The city for the user profile.
    city: option<string>,
    /// That company that this user profile is associated with.
    company: option<string>,
    /// Th country of this user profile.
    country: option<string>,
    /// The first name of the user.
    first-name: option<string>,
    /// The last name of the user.
    last-name: option<string>,
    /// The phone number for the user.
    phone: option<string>,
    /// The state for this user.
    state: option<string>,
    /// The website associated with this user.
    website: option<string>,
    /// The zip code for this user.
    zip: option<string>
  }
  patch-user-profile: func(params: patch-user-profile-params) -> result<user-profile, patch-user-profile-error>;

  /// Retrieve your username
  record get-user-username-params {
    on-behalf-of: option<string>
  }
  get-user-username: func(params: get-user-username-params) -> result<get-user-username-response, string>;

  /// Update your username
  record put-user-username-params {
    on-behalf-of: option<string>,
    /// The new username you would like to use for your account.
    username: option<string>
  }
  put-user-username: func(params: put-user-username-params) -> result<put-user-username-response, string>;

}

interface settings-enforced-tls {
  record enforced-tls-request-response {
    /// Indicates if you want to require your recipients to support TLS. 
    require-tls: option<bool>,
    /// Indicates if you want to require your recipients to have a valid certificate.
    require-valid-cert: option<bool>
  }

  variant get-user-settings-enforced-tls-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-user-settings-enforced-tls-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Retrieve current Enforced TLS settings.
  record get-user-settings-enforced-tls-params {
    on-behalf-of: option<string>
  }
  get-user-settings-enforced-tls: func(params: get-user-settings-enforced-tls-params) -> result<enforced-tls-request-response, get-user-settings-enforced-tls-error>;

  /// Update Enforced TLS settings
  record patch-user-settings-enforced-tls-params {
    on-behalf-of: option<string>,
    /// Indicates if you want to require your recipients to support TLS. 
    require-tls: option<bool>,
    /// Indicates if you want to require your recipients to have a valid certificate.
    require-valid-cert: option<bool>
  }
  patch-user-settings-enforced-tls: func(params: patch-user-settings-enforced-tls-params) -> result<enforced-tls-request-response, patch-user-settings-enforced-tls-error>;

}

interface webhooks {
  enum get-user-webhooks-parse-stats-aggregated-by-enum {
    day,
    week,
    month,
  }

  record event-webhook-response {
    /// Receiving server could not or would not accept message.
    bounce: bool,
    /// Recipient clicked on a link within the message. You need to enable Click Tracking for getting this type of event.
    click: bool,
    /// Recipient's email server temporarily rejected message.
    deferred: bool,
    /// Message has been successfully delivered to the receiving server.
    delivered: bool,
    /// You may see the following drop reasons: Invalid SMTPAPI header, Spam Content (if spam checker app enabled), Unsubscribed Address, Bounced Address, Spam Reporting Address, Invalid, Recipient List over Package Quota
    dropped: bool,
    /// Indicates if the event webhook is enabled.
    enabled: bool,
    /// Recipient resubscribes to specific group by updating preferences. You need to enable Subscription Tracking for getting this type of event.
    group-resubscribe: bool,
    /// Recipient unsubscribe from specific group, by either direct link or updating preferences. You need to enable Subscription Tracking for getting this type of event.
    group-unsubscribe: bool,
    /// The client ID Twilio SendGrid sends to your OAuth server or service provider to generate an OAuth access token.
    oauth-client-id: option<string>,
    /// The URL where Twilio SendGrid sends the Client ID and Client Secret to generate an access token. This should be your OAuth server or service provider.
    oauth-token-url: option<string>,
    /// Recipient has opened the HTML message. You need to enable Open Tracking for getting this type of event.
    open: bool,
    /// Message has been received and is ready to be delivered.
    processed: bool,
    /// Recipient marked a message as spam.
    spam-report: bool,
    /// Recipient clicked on message's subscription management link. You need to enable Subscription Tracking for getting this type of event.
    unsubscribe: bool,
    /// The URL that you want the event webhook to POST to.
    url: string
  }

  record get-user-webhooks-event-settings-signed-response {
    /// The public key you can use to verify the Twilio SendGrid signature.
    public-key: string
  }

  record patch-user-webhooks-event-settings-signed-response {
    /// The public key you can use to verify the Twilio SendGrid signature.
    public-key: string
  }

  record get-user-webhooks-parse-settings-response {
    /// The list of your current inbound parse settings.
    result-op: option<list<parse-setting>>
  }

  record parse-setting {
    /// A specific and unique domain or subdomain that you have created to use exclusively to parse your incoming email. For example, `parse.yourdomain.com`.
    hostname: option<string>,
    /// Indicates if you would like SendGrid to post the original MIME-type content of your parsed email. When this parameter is set to `true`, SendGrid will send a JSON payload of the content of your email.
    send-raw: option<bool>,
    /// Indicates if you would like SendGrid to check the content parsed from your emails for spam before POSTing them to your domain.
    spam-check: option<bool>,
    /// The public URL where you would like SendGrid to POST the data parsed from your email. Any emails sent with the given hostname provided (whose MX records have been updated to point to SendGrid) will be parsed and POSTed to this URL.
    url: option<string>
  }

  record get-user-webhooks-parse-stats-response-item {
    /// The date that the stats were collected.
    date: string,
    /// The Parse Webhook usage statistics.
    stats: list<get-user-webhooks-parse-stats-response-item-stats-item>
  }

  record get-user-webhooks-parse-stats-response-item-stats-item {
    metrics: option<get-user-webhooks-parse-stats-response-item-stats-item-metrics>
  }

  record get-user-webhooks-parse-stats-response-item-stats-item-metrics {
    /// The number of emails received and parsed by the Parse Webhook.
    received: f64
  }

  variant patch-user-webhooks-event-settings-signed-error {
    bad-request(string),
    unauthorized(string),
    internal-server-error(string),
    other(string)
  }

  variant get-user-webhooks-parse-settings-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Retrieve Event Webhook settings
  record get-user-webhooks-event-settings-params {
    on-behalf-of: option<string>
  }
  get-user-webhooks-event-settings: func(params: get-user-webhooks-event-settings-params) -> result<event-webhook-response, string>;

  /// Update Event Notification Settings
  record patch-user-webhooks-event-settings-params {
    on-behalf-of: option<string>,
    /// Receiving server could not or would not accept message.
    bounce: bool,
    /// Recipient clicked on a link within the message. You need to enable Click Tracking for getting this type of event.
    click: bool,
    /// Recipient's email server temporarily rejected message.
    deferred: bool,
    /// Message has been successfully delivered to the receiving server.
    delivered: bool,
    /// You may see the following drop reasons: Invalid SMTPAPI header, Spam Content (if spam checker app enabled), Unsubscribed Address, Bounced Address, Spam Reporting Address, Invalid, Recipient List over Package Quota
    dropped: bool,
    /// Indicates if the event webhook is enabled.
    enabled: bool,
    /// Recipient resubscribes to specific group by updating preferences. You need to enable Subscription Tracking for getting this type of event.
    group-resubscribe: bool,
    /// Recipient unsubscribe from specific group, by either direct link or updating preferences. You need to enable Subscription Tracking for getting this type of event.
    group-unsubscribe: bool,
    /// The client ID Twilio SendGrid sends to your OAuth server or service provider to generate an OAuth access token. When passing data in this field, you must also include the oauth_token_url field.
    oauth-client-id: option<string>,
    /// This secret is needed only once to create an access token. SendGrid will store this secret, allowing you to update your Client ID and Token URL without passing the secret to SendGrid again.  When passing data in this field, you must also include the oauth_client_id and oauth_token_url fields.
    oauth-client-secret: option<string>,
    /// The URL where Twilio SendGrid sends the Client ID and Client Secret to generate an access token. This should be your OAuth server or service provider. When passing data in this field, you must also include the oauth_client_id field.
    oauth-token-url: option<string>,
    /// Recipient has opened the HTML message. You need to enable Open Tracking for getting this type of event.
    open: bool,
    /// Message has been received and is ready to be delivered.
    processed: bool,
    /// Recipient marked a message as spam.
    spam-report: bool,
    /// Recipient clicked on message's subscription management link. You need to enable Subscription Tracking for getting this type of event.
    unsubscribe: bool,
    /// The URL that you want the event webhook to POST to.
    url: string
  }
  patch-user-webhooks-event-settings: func(params: patch-user-webhooks-event-settings-params) -> result<event-webhook-response, string>;

  /// Retrieve Signed Webhook Public Key
  record get-user-webhooks-event-settings-signed-params {
    on-behalf-of: option<string>
  }
  get-user-webhooks-event-settings-signed: func(params: get-user-webhooks-event-settings-signed-params) -> result<get-user-webhooks-event-settings-signed-response, string>;

  /// Enable/Disable Signed Webhook
  record patch-user-webhooks-event-settings-signed-params {
    on-behalf-of: option<string>,
    enabled: bool
  }
  patch-user-webhooks-event-settings-signed: func(params: patch-user-webhooks-event-settings-signed-params) -> result<patch-user-webhooks-event-settings-signed-response, patch-user-webhooks-event-settings-signed-error>;

  /// Test Event Notification Settings
  record post-user-webhooks-event-test-params {
    on-behalf-of: option<string>,
    /// The client ID Twilio SendGrid sends to your OAuth server or service provider to generate an OAuth access token. When passing data in this field, you must also include the oauth_client_secret and oauth_token_url fields.
    oauth-client-id: option<string>,
    /// This secret is needed only once to create an access token. SendGrid will store this secret, allowing you to update your Client ID and Token URL without passing the secret to SendGrid again.  When passing data in this field, you must also include the oauth_client_id and oauth_token_url fields.
    oauth-client-secret: option<string>,
    /// The URL where Twilio SendGrid sends the Client ID and Client Secret to generate an access token. This should be your OAuth server or service provider.  When passing data in this field, you must also include the oauth_client_id and oauth_client_secret fields.
    oauth-token-url: option<string>,
    /// The URL where you would like the test notification to be sent.
    url: option<string>
  }
  post-user-webhooks-event-test: func(params: post-user-webhooks-event-test-params) -> result<string, string>;

  /// Retrieve all parse settings
