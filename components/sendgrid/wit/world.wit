    on-behalf-of: option<string>
  }
  delete-contactdb-recipients-recipient-id: func(params: delete-contactdb-recipients-recipient-id-params) -> result<list<delete-contactdb-recipients-recipient-id-response-entry>, delete-contactdb-recipients-recipient-id-error>;

  /// Retrieve the lists that a recipient is on
  record get-contactdb-recipients-recipient-id-lists-params {
    /// The ID of the recipient for whom you are retrieving lists.
    recipient-id: string,
    on-behalf-of: option<string>
  }
  get-contactdb-recipients-recipient-id-lists: func(params: get-contactdb-recipients-recipient-id-lists-params) -> result<get-contactdb-recipients-recipient-id-lists-response, get-contactdb-recipients-recipient-id-lists-error>;

  /// Get Recipient Upload Status
  record get-contactdb-status-params {
    on-behalf-of: option<string>
  }
  get-contactdb-status: func(params: get-contactdb-status-params) -> result<get-contactdb-status-response, string>;

}

interface contacts-api-segments {
  enum contactdb-segments-conditions-and-or-enum {
    and,
    or,
    empty,
  }

  enum contactdb-segments-conditions-operator-enum {
    eq,
    ne,
    lt,
    gt,
    contains,
  }

  enum contactdb-custom-field-with-id-value-type-op-enum {
    date,
    text,
    number,
  }

  record get-contactdb-segments-response {
    segments: list<contactdb-segments>
  }

  record contactdb-segments {
    /// The conditions for a recipient to be included in this segment.
    conditions: list<contactdb-segments-conditions>,
    /// The list id from which to make this segment. Not including this ID will mean your segment is created from the main contactdb rather than a list.
    list-id: option<s32>,
    /// The name of this segment.
    name: string,
    /// The count of recipients in this list. This is not included on creation of segments.
    recipient-count: option<f64>
  }

  record contactdb-segments-conditions {
    and-or: option<contactdb-segments-conditions-and-or-enum>,
    field: string,
    operator: contactdb-segments-conditions-operator-enum,
    value: string
  }

  record contactdb-segments-with-id {
    /// The ID of the segment.
    id: f64,
    /// The conditions for a recipient to be included in this segment.
    conditions: list<contactdb-segments-conditions>,
    /// The list id from which to make this segment. Not including this ID will mean your segment is created from the main contactdb rather than a list.
    list-id: option<s32>,
    /// The name of this segment.
    name: string,
    /// The count of recipients in this list. This is not included on creation of segments.
    recipient-count: option<f64>
  }

  record get-contactdb-segments-segment-id-recipients-response {
    recipients: list<contactdb-recipient>
  }

  record contactdb-recipient {
    recipients: option<list<contactdb-recipient-recipients-item>>
  }

  record contactdb-recipient-recipients-item {
    /// The time this record was created in your contactdb, in unixtime.
    created-at: option<f64>,
    /// The custom fields assigned to this recipient and their values.
    custom-fields: option<list<contactdb-custom-field-with-id-value>>,
    /// The email address of this recipient. This is a default custom field that SendGrid provides.
    email: string,
    /// The first name of this recipient. This is a default custom field that SendGrid provides.
    first-name: option<string>,
    /// The ID of this recipient.
    id: option<string>,
    /// The last time this recipient clicked a link from one of your campaigns, in unixtime.
    last-clicked: option<f64>,
    /// The last time this user was emailed by one of your campaigns, in unixtime.
    last-emailed: option<f64>,
    /// The last name of the recipient.
    last-name: option<string>,
    /// The last time this recipient opened an email from you, in unixtime.
    last-opened: option<f64>,
    /// The last update date for this recipient's record.
    updated-at: option<f64>
  }

  record contactdb-custom-field-with-id-value {
    /// The name of the field
    name: option<string>,
    /// The type of the field.
    type-op: option<contactdb-custom-field-with-id-value-type-op-enum>,
    /// The ID of the custom field.
    id: option<f64>,
    /// The value of this recipient's custom field
    value: option<string>
  }

  variant get-contactdb-segments-error {
    unauthorized(string),
    other(string)
  }

  variant post-contactdb-segments-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-contactdb-segments-segment-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant patch-contactdb-segments-segment-id-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-contactdb-segments-segment-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-contactdb-segments-segment-id-recipients-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Retrieve all segments
  record get-contactdb-segments-params {
    on-behalf-of: option<string>
  }
  get-contactdb-segments: func(params: get-contactdb-segments-params) -> result<get-contactdb-segments-response, get-contactdb-segments-error>;

  /// Create a Segment
  record post-contactdb-segments-params {
    on-behalf-of: option<string>,
    /// The conditions for a recipient to be included in this segment.
    conditions: list<contactdb-segments-conditions>,
    /// The list id from which to make this segment. Not including this ID will mean your segment is created from the main contactdb rather than a list.
    list-id: option<s32>,
    /// The name of this segment.
    name: string,
    /// The count of recipients in this list. This is not included on creation of segments.
    recipient-count: option<f64>
  }
  post-contactdb-segments: func(params: post-contactdb-segments-params) -> result<contactdb-segments-with-id, post-contactdb-segments-error>;

  /// Retrieve a segment
  record get-contactdb-segments-segment-id-params {
    segment-id: string,
    /// The ID of the segment you want to request.
    segment-id-v2: s32,
    on-behalf-of: option<string>
  }
  get-contactdb-segments-segment-id: func(params: get-contactdb-segments-segment-id-params) -> result<contactdb-segments, get-contactdb-segments-segment-id-error>;

  /// Update a segment
  record patch-contactdb-segments-segment-id-params {
    segment-id: string,
    /// The ID of the segment you are updating.
    segment-id-v2: option<string>,
    on-behalf-of: option<string>,
    /// The conditions by which this segment should be created.
    conditions: option<list<contactdb-segments-conditions>>,
    /// The list ID you would like this segment to be built from.
    list-id: option<f64>,
    name: string
  }
  patch-contactdb-segments-segment-id: func(params: patch-contactdb-segments-segment-id-params) -> result<contactdb-segments, patch-contactdb-segments-segment-id-error>;

  /// Delete a segment
  record delete-contactdb-segments-segment-id-params {
    segment-id: string,
    /// True to delete all contacts matching the segment in addition to deleting the segment
    delete-contacts: option<bool>,
    on-behalf-of: option<string>,
    body: option<string>
  }
  delete-contactdb-segments-segment-id: func(params: delete-contactdb-segments-segment-id-params) -> result<string, delete-contactdb-segments-segment-id-error>;

  /// Retrieve recipients on a segment
  record get-contactdb-segments-segment-id-recipients-params {
    /// The ID of the segment from which you want to retrieve recipients.
    segment-id: string,
    page: option<s32>,
    page-size: option<s32>,
    on-behalf-of: option<string>
  }
  get-contactdb-segments-segment-id-recipients: func(params: get-contactdb-segments-segment-id-recipients-params) -> result<get-contactdb-segments-segment-id-recipients-response, get-contactdb-segments-segment-id-recipients-error>;

}

interface designs-api {
  enum design-output-summary-editor-enum {
    code,
    design,
  }

  record list-designs-response {
    metadata: option<metadata>,
    result-op: option<list<design-output-summary>>
  }

  record metadata {
    count: option<s32>,
    next: option<string>,
    prev: option<string>,
    self: option<string>
  }

  record design-output-summary {
    /// Datetime that Design was created.
    created-at: option<string>,
    /// ID of the Design.
    id: option<string>,
    /// A Thumbnail preview of the template's html content.
    thumbnail-url: option<string>,
    /// Datetime that Design was last updated.
    updated-at: option<string>,
    /// The editor used in the UI.
    editor: option<design-output-summary-editor-enum>,
    /// The name of the new design.
    name: option<string>,
    /// The list of categories applied to the design
    categories: option<list<string>>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// Subject of the Design.
    subject: option<string>
  }

  record design-output {
    /// Datetime that Design was created.
    created-at: option<string>,
    /// ID of the Design.
    id: option<string>,
    /// A Thumbnail preview of the template's html content.
    thumbnail-url: option<string>,
    /// Datetime that Design was last updated.
    updated-at: option<string>,
    /// The editor used in the UI.
    editor: option<design-output-summary-editor-enum>,
    /// The name of the new design.
    name: option<string>,
    /// The list of categories applied to the design
    categories: option<list<string>>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// Subject of the Design.
    subject: option<string>,
    /// The HTML content of the Design.
    html-content: string,
    /// Plain text content of the Design.
    plain-content: option<string>
  }

  record list-sendgrid-pre-built-designs-response {
    metadata: option<metadata>,
    result-op: option<list<design-output-summary>>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-design-response-entry {
    key: string,
    value: string
  }

  variant post-designs-error {
    bad-request(string),
    other(string)
  }

  variant get-sendgrid-pre-built-design-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant post-sendgrid-pre-built-design-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant get-design-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant post-design-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant put-design-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant delete-design-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  /// List Designs
  record list-designs-params {
    /// number of results to return
    page-size: option<s32>,
    /// token corresponding to a specific page of results, as provided by metadata
    page-token: option<string>,
    /// set to false to return all fields
    summary: option<bool>
  }
  list-designs: func(params: list-designs-params) -> result<list-designs-response, string>;

  /// Create Design
  record post-designs-params {
    /// The editor used in the UI.
    editor: option<design-output-summary-editor-enum>,
    /// The name of the new design.
    name: option<string>,
    /// The list of categories applied to the design
    categories: option<list<string>>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// Subject of the Design.
    subject: option<string>,
    /// The HTML content of the Design.
    html-content: string,
    /// Plain text content of the Design.
    plain-content: option<string>
  }
  post-designs: func(params: post-designs-params) -> result<design-output, post-designs-error>;

  /// List SendGrid Pre-built Designs
  record list-sendgrid-pre-built-designs-params {
    /// number of results to return
    page-size: option<s32>,
    /// token corresponding to a specific page of results, as provided by metadata
    page-token: option<string>,
    /// set to false to return all fields
    summary: option<bool>
  }
  list-sendgrid-pre-built-designs: func(params: list-sendgrid-pre-built-designs-params) -> result<list-sendgrid-pre-built-designs-response, string>;

  /// Get SendGrid Pre-built Design
  record get-sendgrid-pre-built-design-params {
    /// The ID of the pre-built Design you want to duplicate.
    id: string
  }
  get-sendgrid-pre-built-design: func(params: get-sendgrid-pre-built-design-params) -> result<design-output, get-sendgrid-pre-built-design-error>;

  /// Duplicate SendGrid Pre-built Design
  record post-sendgrid-pre-built-design-params {
    /// The ID of the pre-built Design you want to duplicate.
    id: string,
    /// The editor used in the UI.
    editor: option<design-output-summary-editor-enum>,
    /// The name of the new design.
    name: option<string>
  }
  post-sendgrid-pre-built-design: func(params: post-sendgrid-pre-built-design-params) -> result<design-output, post-sendgrid-pre-built-design-error>;

  /// Get Design
  record get-design-params {
    /// The ID of the Design you want to duplicate.
    id: string
  }
  get-design: func(params: get-design-params) -> result<design-output, get-design-error>;

  /// Duplicate Design
  record post-design-params {
    /// The ID of the Design you want to duplicate.
    id: string,
    /// The editor used in the UI.
    editor: option<design-output-summary-editor-enum>,
    /// The name of the new design.
    name: option<string>
  }
  post-design: func(params: post-design-params) -> result<design-output, post-design-error>;

  /// Update Design
  record put-design-params {
    /// The ID of the Design you want to duplicate.
    id: string,
    /// The list of categories applied to the design
    categories: option<list<string>>,
    /// If true, plain_content is always generated from html_content. If false, plain_content is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the Design.
    html-content: option<string>,
    /// Name of the Design.
    name: option<string>,
    /// Plain text content of the Design.
    plain-content: option<string>,
    /// Subject of the Design.
    subject: option<string>
  }
  put-design: func(params: put-design-params) -> result<design-output, put-design-error>;

  /// Delete Design
  record delete-design-params {
    /// The ID of the Design you want to duplicate.
    id: string
  }
  delete-design: func(params: delete-design-params) -> result<list<delete-design-response-entry>, delete-design-error>;

}

interface ip-addresses {
  enum get-ips-sort-by-direction-enum {
    desc,
    asc,
  }

  record get-ips-response-item {
    /// The date that the IP address was assigned to the user.
    assigned-at: s32,
    /// An IP address.
    ip: string,
    /// The IP pools that this IP has been added to.
    pools: list<string>,
    /// The reverse DNS record for this IP address.
    rdns: option<string>,
    /// The date that the IP address was entered into warmup.
    start-date: f64,
    /// The subusers that are able to send email from this IP.
    subusers: list<string>,
    /// Indicates if this IP address is currently warming up.
    warmup: bool,
    /// Indicates if this IP address is associated with a reverse DNS record.
    whitelabeled: bool
  }

  record post-ips-response {
    /// List of IP objects.
    ips: list<post-ips-response-ips-item>,
    /// The number of IPs that can still be added to the user.
    remaining-ips: s32,
    /// Whether or not the IPs are being warmed up.
    warmup: bool
  }

  record post-ips-response-ips-item {
    /// IP added to account.
    ip: string,
    /// Array of usernames assigned a send IP.
    subusers: list<string>
  }

  record get-ips-assigned-response-item {
    /// The IP address.
    ip: string,
    /// The IP pools that this IP address has been added to.
    pools: list<string>,
    /// The start date that this IP address was entered into warmup.
    start-date: s32,
    /// Indicates if this IP address is currently warming up.
    warmup: bool
  }

  record get-ips-remaining-response {
    results: list<get-ips-remaining-response-results-item>
  }

  record get-ips-remaining-response-results-item {
    /// The length of time until user can add more IPs.
    period: string,
    /// The current cost to add an IP.
    price-per-ip: f64,
    /// The number of IPs that can still be added to the user.
    remaining: s32
  }

  record get-ips-ip-address-response {
    /// The IP address.
    ip: string,
    /// The list of IP pools that this IP address belongs to.
    pools: list<string>,
    /// The reverse DNS record for this IP address.
    rdns: string,
    /// The date that the IP address was entered into warmup.
    start-date: s32,
    /// The subusers that can send email using this IP address.
    subusers: list<string>,
    /// Indicates if this IP address is currently warming up.
    warmup: bool,
    /// Indicates if this IP address is associated with a reverse DNS record.
    whitelabeled: bool
  }

  variant post-ips-error {
    bad-request(string),
    other(string)
  }

  /// Retrieve all IP addresses
  record get-ips-params {
    /// The IP address to get
    ip: option<string>,
    /// Should we exclude reverse DNS records (whitelabels)?
    exclude-whitelabels: option<bool>,
    /// The number of IPs you want returned at the same time.
    limit: option<s32>,
    /// The offset for the number of IPs that you are requesting.
    offset: option<s32>,
    /// The subuser you are requesting for.
    subuser: option<string>,
    /// The direction to sort the results.
    sort-by-direction: option<get-ips-sort-by-direction-enum>
  }
  get-ips: func(params: get-ips-params) -> result<list<get-ips-response-item>, string>;

  /// Add IPs
  record post-ips-params {
    /// The amount of IPs to add to the account.
    count: s32,
    /// Array of usernames to be assigned a send IP.
    subusers: option<list<string>>,
    /// Whether or not to warmup the IPs being added.
    warmup: option<bool>
  }
  post-ips: func(params: post-ips-params) -> result<post-ips-response, post-ips-error>;

  /// Retrieve all assigned IPs
  get-ips-assigned: func() -> result<list<get-ips-assigned-response-item>, string>;

  /// Get remaining IPs count
  get-ips-remaining: func() -> result<get-ips-remaining-response, string>;

  /// Retrieve all IP pools an IP address belongs to
  record get-ips-ip-address-params {
    /// The IP address you are retrieving the IP pools for.
    ip-address: string
  }
  get-ips-ip-address: func(params: get-ips-ip-address-params) -> result<get-ips-ip-address-response, string>;

}

interface ip-pools {
  record ip-pool-response {
    /// The name of the IP pool.
    name: option<string>
  }

  record get-ips-pools-pool-name-response {
    /// The IP addresses that belong to this pool.
    ips: option<list<string>>,
    /// The name of the IP pool.
    pool-name: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-ips-pools-pool-name-response-entry {
    key: string,
    value: string
  }

  record post-ips-pools-pool-name-ips-response {
    /// The IP address.
    ip: string,
    /// The IP pools that this IP address has been added to.
    pools: list<string>,
    /// A Unix timestamp indicating when the warmup process began for the added IP address.
    start-date: s32,
    /// Indicates if the IP address is in warmup.
    warmup: bool
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-ips-pools-pool-name-ips-ip-response-entry {
    key: string,
    value: string
  }

  variant get-ips-pools-pool-name-error {
    not-found(string),
    other(string)
  }

  variant put-ips-pools-pool-name-error {
    not-found(string),
    other(string)
  }

  variant delete-ips-pools-pool-name-error {
    not-found(string),
    other(string)
  }

  variant post-ips-pools-pool-name-ips-error {
    not-found(string),
    other(string)
  }

  variant delete-ips-pools-pool-name-ips-ip-error {
    not-found(string),
    other(string)
  }

  /// Retrieve all IP pools
  get-ips-pools: func() -> result<list<ip-pool-response>, string>;

  /// Create an IP pool
  record post-ips-pools-params {
    /// The name of your new IP pool.
    name: string
  }
  post-ips-pools: func(params: post-ips-pools-params) -> result<ip-pool-response, string>;

  /// Retrieve all the IPs in a specified pool
  record get-ips-pools-pool-name-params {
    /// The name of the IP pool that you want to retrieve the IP addresses for.
    pool-name: string
  }
  get-ips-pools-pool-name: func(params: get-ips-pools-pool-name-params) -> result<get-ips-pools-pool-name-response, get-ips-pools-pool-name-error>;

  /// Rename an IP pool
  record put-ips-pools-pool-name-params {
    /// The name of the IP pool that you want to retrieve the IP addresses for.
    pool-name: string,
    /// The new name for your IP pool.
    name: option<string>
  }
  put-ips-pools-pool-name: func(params: put-ips-pools-pool-name-params) -> result<ip-pool-response, put-ips-pools-pool-name-error>;

  /// Delete an IP pool
  record delete-ips-pools-pool-name-params {
    /// The name of the IP pool that you want to retrieve the IP addresses for.
    pool-name: string
  }
  delete-ips-pools-pool-name: func(params: delete-ips-pools-pool-name-params) -> result<list<delete-ips-pools-pool-name-response-entry>, delete-ips-pools-pool-name-error>;

  /// Add an IP address to a pool
  record post-ips-pools-pool-name-ips-params {
    /// The name of the IP pool you want to add the address to. If the name contains spaces, they must be URL encoded (e.g., "Test Pool" becomes "Test%20Pool").
    pool-name: string,
    /// The IP address that you want to add to the named pool.
    ip: option<string>
  }
  post-ips-pools-pool-name-ips: func(params: post-ips-pools-pool-name-ips-params) -> result<post-ips-pools-pool-name-ips-response, post-ips-pools-pool-name-ips-error>;

  /// Remove an IP address from a pool
  record delete-ips-pools-pool-name-ips-ip-params {
    /// The name of the IP pool that you are removing the IP address from.
    pool-name: string,
    /// The IP address that you wish to remove.
    ip: string
  }
  delete-ips-pools-pool-name-ips-ip: func(params: delete-ips-pools-pool-name-ips-ip-params) -> result<list<delete-ips-pools-pool-name-ips-ip-response-entry>, delete-ips-pools-pool-name-ips-ip-error>;

}

interface ip-warmup {
  record response-item {
    /// The IP address.
    ip: string,
    /// A Unix timestamp indicating when the IP address entered warmup mode.
    start-date: s32
  }

  record response-item-v2 {
    /// The IP address.
    ip: string,
    /// A Unix timestamp indicating when the IP address entered warmup mode.
    start-date: s32
  }

  record response-item-v3 {
    /// The IP address.
    ip: string,
    /// A Unix timestamp indicating when the IP address entered warmup mode.
    start-date: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-ips-warmup-ip-address-response-entry {
    key: string,
    value: string
  }

  variant post-ips-warmup-error {
    not-found(string),
    other(string)
  }

  variant get-ips-warmup-ip-address-error {
    not-found(string),
    other(string)
  }

  variant delete-ips-warmup-ip-address-error {
    not-found(string),
    other(string)
  }

  /// Retrieve all IPs currently in warmup
  get-ips-warmup: func() -> result<list<response-item>, string>;

  /// Start warming up an IP address
  record post-ips-warmup-params {
    /// The IP address that you want to begin warming up.
    ip: option<string>
  }
  post-ips-warmup: func(params: post-ips-warmup-params) -> result<list<response-item-v2>, post-ips-warmup-error>;

  /// Retrieve the warmup status for a specific IP address
  record get-ips-warmup-ip-address-params {
    /// The IP address that you want to retrieve the warmup status for.
    ip-address: string
  }
  get-ips-warmup-ip-address: func(params: get-ips-warmup-ip-address-params) -> result<list<response-item-v3>, get-ips-warmup-ip-address-error>;

  /// Stop warming up an IP address
  record delete-ips-warmup-ip-address-params {
    /// The IP address that you want to retrieve the warmup status for.
    ip-address: string
  }
  delete-ips-warmup-ip-address: func(params: delete-ips-warmup-ip-address-params) -> result<list<delete-ips-warmup-ip-address-response-entry>, delete-ips-warmup-ip-address-error>;

}

interface cancel-scheduled-sends {
  enum user-scheduled-send-status-status-enum {
    cancel,
    pause,
  }

  enum post-user-scheduled-sends-body-status-enum {
    pause,
    cancel,
  }

  record mail-batch-id {
    batch-id: string
  }

  record user-scheduled-send-status {
    batch-id: string,
    /// The status of the scheduled send.
    status: user-scheduled-send-status-status-enum
  }

  variant post-mail-batch-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mail-batch-batch-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-user-scheduled-sends-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-user-scheduled-sends-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-user-scheduled-sends-batch-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-user-scheduled-sends-batch-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-user-scheduled-sends-batch-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Create a batch ID
  record post-mail-batch-params {
    on-behalf-of: option<string>
  }
  post-mail-batch: func(params: post-mail-batch-params) -> result<mail-batch-id, post-mail-batch-error>;

  /// Validate batch ID
  record get-mail-batch-batch-id-params {
    batch-id: string,
    on-behalf-of: option<string>
  }
  get-mail-batch-batch-id: func(params: get-mail-batch-batch-id-params) -> result<mail-batch-id, get-mail-batch-batch-id-error>;

  /// Retrieve all scheduled sends
  record get-user-scheduled-sends-params {
    on-behalf-of: option<string>
  }
  get-user-scheduled-sends: func(params: get-user-scheduled-sends-params) -> result<list<user-scheduled-send-status>, get-user-scheduled-sends-error>;

  /// Cancel or pause a scheduled send
  record post-user-scheduled-sends-params {
    on-behalf-of: option<string>,
    /// The batch ID is the identifier that your scheduled mail sends share.
    batch-id: string,
    /// The status of the send you would like to implement. This can be pause or cancel. To delete a pause or cancel status see DELETE /v3/user/scheduled_sends/{batch_id}
    status: post-user-scheduled-sends-body-status-enum
  }
  post-user-scheduled-sends: func(params: post-user-scheduled-sends-params) -> result<user-scheduled-send-status, post-user-scheduled-sends-error>;

  /// Retrieve scheduled send
  record get-user-scheduled-sends-batch-id-params {
    batch-id: string,
    on-behalf-of: option<string>
  }
  get-user-scheduled-sends-batch-id: func(params: get-user-scheduled-sends-batch-id-params) -> result<list<user-scheduled-send-status>, get-user-scheduled-sends-batch-id-error>;

  /// Update a scheduled send
  record patch-user-scheduled-sends-batch-id-params {
    batch-id: string,
    on-behalf-of: option<string>,
    /// The status you would like the scheduled send to have.
    status: user-scheduled-send-status-status-enum
  }
  patch-user-scheduled-sends-batch-id: func(params: patch-user-scheduled-sends-batch-id-params) -> result<string, patch-user-scheduled-sends-batch-id-error>;

  /// Delete a cancellation or pause from a scheduled send
  record delete-user-scheduled-sends-batch-id-params {
    batch-id: string,
    on-behalf-of: option<string>
  }
  delete-user-scheduled-sends-batch-id: func(params: delete-user-scheduled-sends-batch-id-params) -> result<string, delete-user-scheduled-sends-batch-id-error>;

}

interface mail-send {
  enum post-mail-send-body-attachments-item-disposition-enum {
    inline,
    attachment,
  }

  /// An object allowing you to specify how to handle unsubscribes.
  record post-mail-send-body-asm {
    /// The unsubscribe group to associate with this email.
    group-id: s32,
    /// An array containing the unsubscribe groups that you would like to be displayed on the unsubscribe preferences page.
    groups-to-display: option<list<s32>>
  }

  record post-mail-send-body-attachments-item {
    /// The Base64 encoded content of the attachment.
    content: string,
    /// The attachment's content ID. This is used when the disposition is set to `“inline”` and the attachment is an image, allowing the file to be displayed within the body of your email.
    content-id: option<string>,
    /// The attachment's content-disposition, specifying how you would like the attachment to be displayed. For example, `“inline”` results in the attached file are displayed automatically within the message while `“attachment”` results in the attached file require some action to be taken before it is displayed, such as opening or downloading the file.
    disposition: option<post-mail-send-body-attachments-item-disposition-enum>,
    /// The attachment's filename.
    filename: string,
    /// The MIME type of the content you are attaching (e.g., `“text/plain”` or `“text/html”`).
    type-op: option<string>
  }

  record post-mail-send-body-content-item {
    /// The MIME type of the content you are including in your email (e.g., `“text/plain”` or `“text/html”`).
    type-op: string,
    /// The actual content of the specified MIME type that you are including in your email.
    value: string
  }

  record from-email-object {
    /// The 'From' email address used to deliver the message. This address should be a verified sender in your Twilio SendGrid account.
    email: string,
    /// A name or title associated with the sending email address.
    name: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-mail-send-body-headers-entry {
    key: string,
    value: string
  }

  /// A collection of different mail settings that you can use to specify how you would like this email to be handled.
  record post-mail-send-body-mail-settings {
    /// Allows you to bypass the bounce list to ensure that the email is delivered to recipients. Spam report and unsubscribe lists will still be checked; addresses on these other lists will not receive the message. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
    bypass-bounce-management: option<post-mail-send-body-mail-settings-bypass-bounce-management>,
    /// Allows you to bypass all unsubscribe groups and suppressions to ensure that the email is delivered to every single recipient. This should only be used in emergencies when it is absolutely necessary that every recipient receives your email. This filter cannot be combined with any other bypass filters. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
    bypass-list-management: option<post-mail-send-body-mail-settings-bypass-list-management>,
    /// Allows you to bypass the spam report list to ensure that the email is delivered to recipients. Bounce and unsubscribe lists will still be checked; addresses on these other lists will not receive the message. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
    bypass-spam-management: option<post-mail-send-body-mail-settings-bypass-spam-management>,
    /// Allows you to bypass the global unsubscribe list to ensure that the email is delivered to recipients. Bounce and spam report lists will still be checked; addresses on these other lists will not receive the message. This filter applies only to global unsubscribes and will not bypass group unsubscribes. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
    bypass-unsubscribe-management: option<post-mail-send-body-mail-settings-bypass-unsubscribe-management>,
    /// The default footer that you would like included on every email.
    footer: option<post-mail-send-body-mail-settings-footer>,
    /// Sandbox Mode allows you to send a test email to ensure that your request body is valid and formatted correctly.
    sandbox-mode: option<post-mail-send-body-mail-settings-sandbox-mode>
  }

  /// Allows you to bypass the bounce list to ensure that the email is delivered to recipients. Spam report and unsubscribe lists will still be checked; addresses on these other lists will not receive the message. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
  record post-mail-send-body-mail-settings-bypass-bounce-management {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  /// Allows you to bypass all unsubscribe groups and suppressions to ensure that the email is delivered to every single recipient. This should only be used in emergencies when it is absolutely necessary that every recipient receives your email. This filter cannot be combined with any other bypass filters. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
  record post-mail-send-body-mail-settings-bypass-list-management {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  /// Allows you to bypass the spam report list to ensure that the email is delivered to recipients. Bounce and unsubscribe lists will still be checked; addresses on these other lists will not receive the message. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
  record post-mail-send-body-mail-settings-bypass-spam-management {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  /// Allows you to bypass the global unsubscribe list to ensure that the email is delivered to recipients. Bounce and spam report lists will still be checked; addresses on these other lists will not receive the message. This filter applies only to global unsubscribes and will not bypass group unsubscribes. This filter cannot be combined with the `bypass_list_management` filter. See our [documentation](https://sendgrid.com/docs/ui/sending-email/index-suppressions/#bypass-suppressions) for more about bypass filters.
  record post-mail-send-body-mail-settings-bypass-unsubscribe-management {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  /// The default footer that you would like included on every email.
  record post-mail-send-body-mail-settings-footer {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// The HTML content of your footer.
    html: option<string>,
    /// The plain text content of your footer.
    text: option<string>
  }

  /// Sandbox Mode allows you to send a test email to ensure that your request body is valid and formatted correctly.
  record post-mail-send-body-mail-settings-sandbox-mode {
    /// Indicates if this setting is enabled.
    enable: option<bool>
  }

  record post-mail-send-body-personalizations-item {
    /// An array of recipients who will receive a blind carbon copy of your email. Each object in this array must contain the recipient's email address. Each object in the array may optionally contain the recipient's name.
    bcc: option<list<cc-bcc-email-object>>,
    /// An array of recipients who will receive a copy of your email. Each object in this array must contain the recipient's email address. Each object in the array may optionally contain the recipient's name.
    cc: option<list<cc-bcc-email-object>>,
    /// Values that are specific to this personalization that will be carried along with the email and its activity data. Substitutions will not be made on custom arguments, so any string that is entered into this parameter will be assumed to be the custom argument that you would like to be used. This field may not exceed 10,000 bytes.
    custom-args: option<list<post-mail-send-body-personalizations-item-custom-args-entry>>,
    /// Dynamic template data is available using Handlebars syntax in Dynamic Transactional Templates. This field should be used in combination with a Dynamic Transactional Template, which can be identified by a `template_id` starting with `d-`. This field is a collection of key/value pairs following the pattern "variable_name":"value to insert".
    dynamic-template-data: option<list<post-mail-send-body-personalizations-item-dynamic-template-data-entry>>,
    from-op: option<from-email-object>,
    /// A collection of JSON key/value pairs allowing you to specify handling instructions for your email. You may not overwrite the following headers: `x-sg-id`, `x-sg-eid`, `received`, `dkim-signature`, `Content-Type`, `Content-Transfer-Encoding`, `To`, `From`, `Subject`, `Reply-To`, `CC`, `BCC`
    headers: option<list<post-mail-send-body-personalizations-item-headers-entry>>,
    /// A unix timestamp allowing you to specify when your email should be delivered. Scheduling delivery more than 72 hours in advance is forbidden.
    send-at: option<s32>,
    /// The subject of your email. See character length requirements according to [RFC 2822](http://stackoverflow.com/questions/1592291/what-is-the-email-subject-length-limit#answer-1592310).
    subject: option<string>,
    /// Substitutions allow you to insert data without using Dynamic Transactional Templates. This field should **not** be used in combination with a Dynamic Transactional Template, which can be identified by a `template_id` starting with `d-`. This field is a collection of key/value pairs following the pattern "substitution_tag":"value to substitute". The key/value pairs must be strings. These substitutions will apply to the text and html content of the body of your email, in addition to the `subject` and `reply-to` parameters. The total collective size of your substitutions may not exceed 10,000 bytes per personalization object.
    substitutions: option<list<post-mail-send-body-personalizations-item-substitutions-entry>>,
    to: list<to-email-array-item>
  }

  record cc-bcc-email-object {
    /// The intended recipient's email address.
    email: string,
    /// The intended recipient's name.
    name: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-mail-send-body-personalizations-item-custom-args-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-mail-send-body-personalizations-item-dynamic-template-data-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-mail-send-body-personalizations-item-headers-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-mail-send-body-personalizations-item-substitutions-entry {
    key: string,
    value: string
  }

  record to-email-array-item {
    /// The intended recipient's email address.
    email: string,
    /// The intended recipient's name.
    name: option<string>
  }

  record reply-to-email-object {
    /// The email address where any replies or bounces will be returned.
    email: string,
    /// A name or title associated with the `reply_to` email address.
    name: option<string>
  }

  record post-mail-send-body-reply-to-list-item {
    /// The email address where any replies or bounces will be returned.
    email: string,
    /// A name or title associated with the `reply_to_list` email address.
    name: option<string>
  }

  /// Settings to determine how you would like to track the metrics of how your recipients interact with your email.
  record post-mail-send-body-tracking-settings {
    /// Allows you to track if a recipient clicked a link in your email.
    click-tracking: option<post-mail-send-body-tracking-settings-click-tracking>,
    /// Allows you to enable tracking provided by Google Analytics.
    ganalytics: option<post-mail-send-body-tracking-settings-ganalytics>,
    /// Allows you to track if the email was opened by including a single pixel image in the body of the content. When the pixel is loaded, Twilio SendGrid can log that the email was opened.
    open-tracking: option<post-mail-send-body-tracking-settings-open-tracking>,
    /// Allows you to insert a subscription management link at the bottom of the text and HTML bodies of your email. If you would like to specify the location of the link within your email, you may use the `substitution_tag`.
    subscription-tracking: option<post-mail-send-body-tracking-settings-subscription-tracking>
  }

  /// Allows you to track if a recipient clicked a link in your email.
  record post-mail-send-body-tracking-settings-click-tracking {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// Indicates if this setting should be included in the `text/plain` portion of your email.
    enable-text: option<bool>
  }

  /// Allows you to enable tracking provided by Google Analytics.
  record post-mail-send-body-tracking-settings-ganalytics {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// The name of the campaign.
    utm-campaign: option<string>,
    /// Used to differentiate your campaign from advertisements.
    utm-content: option<string>,
    /// Name of the marketing medium. (e.g. Email)
    utm-medium: option<string>,
    /// Name of the referrer source. (e.g. Google, SomeDomain.com, or Marketing Email)
    utm-source: option<string>,
    /// Used to identify any paid keywords.
    utm-term: option<string>
  }

  /// Allows you to track if the email was opened by including a single pixel image in the body of the content. When the pixel is loaded, Twilio SendGrid can log that the email was opened.
  record post-mail-send-body-tracking-settings-open-tracking {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// Allows you to specify a substitution tag that you can insert in the body of your email at a location that you desire. This tag will be replaced by the open tracking pixel.
    substitution-tag: option<string>
  }

  /// Allows you to insert a subscription management link at the bottom of the text and HTML bodies of your email. If you would like to specify the location of the link within your email, you may use the `substitution_tag`.
  record post-mail-send-body-tracking-settings-subscription-tracking {
    /// Indicates if this setting is enabled.
    enable: option<bool>,
    /// HTML to be appended to the email with the subscription tracking link. You may control where the link is by using the tag <% %>
    html: option<string>,
    /// A tag that will be replaced with the unsubscribe URL. for example: `[unsubscribe_url]`. If this parameter is used, it will override both the `text` and `html` parameters. The URL of the link will be placed at the substitution tag’s location with no additional formatting.
    substitution-tag: option<string>,
    /// Text to be appended to the email with the subscription tracking link. You may control where the link is by using the tag <% %>
    text: option<string>
  }

  variant post-mail-send-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    payload-too-large(string),
    internal-server-error(string),
    other(string)
  }

  /// v3 Mail Send
  record post-mail-send-params {
    /// An object allowing you to specify how to handle unsubscribes.
    asm: option<post-mail-send-body-asm>,
    /// An array of objects where you can specify any attachments you want to include.
    attachments: option<list<post-mail-send-body-attachments-item>>,
    /// An ID representing a batch of emails to be sent at the same time. Including a `batch_id` in your request allows you include this email in that batch. It also enables you to cancel or pause the delivery of that batch. For more information, see the [Cancel Scheduled Sends API](https://sendgrid.com/docs/api-reference/).
    batch-id: option<string>,
    /// An array of category names for this message. Each category name may not exceed 255 characters. 
    categories: option<list<string>>,
    /// An array where you can specify the content of your email. You can include multiple [MIME types](https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types) of content, but you must specify at least one MIME type. To include more than one MIME type, add another object to the array containing the `type` and `value` parameters.
    content: list<post-mail-send-body-content-item>,
    /// Values that are specific to the entire send that will be carried along with the email and its activity data.  Key/value pairs must be strings. Substitutions will not be made on custom arguments, so any string that is entered into this parameter will be assumed to be the custom argument that you would like to be used. This parameter is overridden by `custom_args` set at the personalizations level. Total `custom_args` size may not exceed 10,000 bytes.
    custom-args: option<string>,
    from-op: from-email-object,
    /// An object containing key/value pairs of header names and the value to substitute for them. The key/value pairs must be strings. You must ensure these are properly encoded if they contain unicode characters. These headers cannot be one of the reserved headers.
    headers: option<list<post-mail-send-body-headers-entry>>,
    /// The IP Pool that you would like to send this email from.
    ip-pool-name: option<string>,
    /// A collection of different mail settings that you can use to specify how you would like this email to be handled.
    mail-settings: option<post-mail-send-body-mail-settings>,
    /// An array of messages and their metadata. Each object within personalizations can be thought of as an envelope - it defines who should receive an individual message and how that message should be handled. See our [Personalizations documentation](https://sendgrid.com/docs/for-developers/sending-email/personalizations/) for examples.
    personalizations: list<post-mail-send-body-personalizations-item>,
    reply-to: option<reply-to-email-object>,
    /// An array of recipients who will receive replies and/or bounces. Each object in this array must contain the recipient's email address. Each object in the array may optionally contain the recipient's name. You can either choose to use “reply_to” field or “reply_to_list” but not both.
    reply-to-list: option<list<post-mail-send-body-reply-to-list-item>>,
    /// A unix timestamp allowing you to specify when you want your email to be delivered. This may be overridden by the `send_at` parameter set at the personalizations level. Delivery cannot be scheduled more than 72 hours in advance. If you have the flexibility, it's better to schedule mail for off-peak times. Most emails are scheduled and sent at the top of the hour or half hour. Scheduling email to avoid peak times — for example, scheduling at 10:53 — can result in lower deferral rates due to the reduced traffic during off-peak times.
    send-at: option<s32>,
    /// The global or 'message level' subject of your email. This may be overridden by subject lines set in personalizations.
    subject: string,
    /// An email template ID. A template that contains a subject and content — either text or html — will override any subject and content values specified at the personalizations or message level.
    template-id: option<string>,
    /// Settings to determine how you would like to track the metrics of how your recipients interact with your email.
    tracking-settings: option<post-mail-send-body-tracking-settings>
  }
  post-mail-send: func(params: post-mail-send-params) -> result<string, post-mail-send-error>;

}

interface settings-mail {
  record get-mail-settings-response {
    /// The list of all mail settings.
    result-op: list<get-mail-settings-response-result-op-item>
  }

  record get-mail-settings-response-result-op-item {
    /// A description of the mail setting.
    description: string,
    /// Indicates if this mail setting is currently enabled.
    enabled: bool,
    /// The name of the mail setting.
    name: string,
    /// The title of the mail setting.
    title: string
  }

  record mail-settings-address-whitelabel {
    /// Indicates if you have an email address whitelist enabled. 
    enabled: option<bool>,
    /// All email addresses that are currently on the whitelist.
    list-op: option<list<string>>
  }

  record mail-settings-bounce-purge {
    /// Indicates if the bounce purge mail setting is enabled.
    enabled: option<bool>,
    /// The number of days after which SendGrid will purge all contacts from your hard bounces suppression lists.
    hard-bounces: option<s32>,
    /// The number of days after which SendGrid will purge all contacts from your soft bounces suppression lists.
    soft-bounces: option<s32>
  }

  record mail-settings-footer {
    /// Indicates if the Footer mail setting is currently enabled.
    enabled: option<bool>,
    /// The custom HTML content of your email footer.
    html-content: option<string>,
    /// The plain text content of your email footer.
    plain-content: option<string>
  }

  record mail-settings-forward-bounce {
    /// The email address that you would like your bounce reports forwarded to.
    email: option<string>,
    /// Indicates if the bounce forwarding mail setting is enabled.
    enabled: option<bool>
  }

  record mail-settings-forward-spam {
    /// The email address where you would like the spam reports to be forwarded.
    email: option<string>,
    /// Indicates if the Forward Spam setting is enabled.
    enabled: option<bool>
  }

  record mail-settings-template {
    /// Indicates if the legacy email template setting is enabled.
    enabled: option<bool>,
    /// The HTML content that you want to use for your legacy email template.
    html-content: option<string>
  }

  record patch-mail-settings-template-response {
    /// Indicates if the legacy email template mail setting is enabled.
    enabled: bool,
    /// The HTML content of your legacy email template.
    html-content: string
  }

  variant get-mail-settings-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mail-settings-address-whitelist-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-mail-settings-address-whitelist-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mail-settings-bounce-purge-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-mail-settings-bounce-purge-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mail-settings-footer-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-mail-settings-footer-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mail-settings-forward-bounce-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-mail-settings-forward-bounce-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mail-settings-forward-spam-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-mail-settings-forward-spam-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mail-settings-template-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-mail-settings-template-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Retrieve all mail settings
  record get-mail-settings-params {
    /// The number of settings to return.
    limit: option<s32>,
    /// Where in the list of results to begin displaying settings.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-mail-settings: func(params: get-mail-settings-params) -> result<get-mail-settings-response, get-mail-settings-error>;

  /// Retrieve address whitelist mail settings
  record get-mail-settings-address-whitelist-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-address-whitelist: func(params: get-mail-settings-address-whitelist-params) -> result<mail-settings-address-whitelabel, get-mail-settings-address-whitelist-error>;

  /// Update address whitelist mail settings
  record patch-mail-settings-address-whitelist-params {
    on-behalf-of: option<string>,
    /// Indicates if your email address whitelist is enabled.
    enabled: option<bool>,
    /// Either a single email address that you want whitelisted or a domain, for which all email addresses belonging to this domain will be whitelisted.
    list-op: option<list<string>>
  }
  patch-mail-settings-address-whitelist: func(params: patch-mail-settings-address-whitelist-params) -> result<mail-settings-address-whitelabel, patch-mail-settings-address-whitelist-error>;

  /// Retrieve bounce purge mail settings
  record get-mail-settings-bounce-purge-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-bounce-purge: func(params: get-mail-settings-bounce-purge-params) -> result<mail-settings-bounce-purge, get-mail-settings-bounce-purge-error>;

  /// Update bounce purge mail settings
  record patch-mail-settings-bounce-purge-params {
    on-behalf-of: option<string>,
    /// Indicates if the bounce purge mail setting is enabled.
    enabled: option<bool>,
    /// The number of days after which SendGrid will purge all contacts from your hard bounces suppression lists.
    hard-bounces: option<s32>,
    /// The number of days after which SendGrid will purge all contacts from your soft bounces suppression lists.
    soft-bounces: option<s32>
  }
  patch-mail-settings-bounce-purge: func(params: patch-mail-settings-bounce-purge-params) -> result<mail-settings-bounce-purge, patch-mail-settings-bounce-purge-error>;

  /// Retrieve footer mail settings
  record get-mail-settings-footer-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-footer: func(params: get-mail-settings-footer-params) -> result<mail-settings-footer, get-mail-settings-footer-error>;

  /// Update footer mail settings
  record patch-mail-settings-footer-params {
    on-behalf-of: option<string>,
    /// Indicates if the Footer mail setting is currently enabled.
    enabled: option<bool>,
    /// The custom HTML content of your email footer.
    html-content: option<string>,
    /// The plain text content of your email footer.
    plain-content: option<string>
  }
  patch-mail-settings-footer: func(params: patch-mail-settings-footer-params) -> result<mail-settings-footer, patch-mail-settings-footer-error>;

  /// Retrieve forward bounce mail settings
  record get-mail-settings-forward-bounce-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-forward-bounce: func(params: get-mail-settings-forward-bounce-params) -> result<mail-settings-forward-bounce, get-mail-settings-forward-bounce-error>;

  /// Update forward bounce mail settings
  record patch-mail-settings-forward-bounce-params {
    on-behalf-of: option<string>,
    /// The email address that you would like your bounce reports forwarded to.
    email: option<string>,
    /// Indicates if the bounce forwarding mail setting is enabled.
    enabled: option<bool>
  }
  patch-mail-settings-forward-bounce: func(params: patch-mail-settings-forward-bounce-params) -> result<mail-settings-forward-bounce, patch-mail-settings-forward-bounce-error>;

  /// Retrieve forward spam mail settings
  record get-mail-settings-forward-spam-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-forward-spam: func(params: get-mail-settings-forward-spam-params) -> result<mail-settings-forward-spam, get-mail-settings-forward-spam-error>;

  /// Update forward spam mail settings
  record patch-mail-settings-forward-spam-params {
    on-behalf-of: option<string>,
    /// The email address where you would like the spam reports to be forwarded.
    email: option<string>,
    /// Indicates if the Forward Spam setting is enabled.
    enabled: option<bool>
  }
  patch-mail-settings-forward-spam: func(params: patch-mail-settings-forward-spam-params) -> result<mail-settings-forward-spam, patch-mail-settings-forward-spam-error>;

  /// Retrieve legacy template mail settings
  record get-mail-settings-template-params {
    on-behalf-of: option<string>
  }
  get-mail-settings-template: func(params: get-mail-settings-template-params) -> result<mail-settings-template, get-mail-settings-template-error>;

  /// Update template mail settings
  record patch-mail-settings-template-params {
    on-behalf-of: option<string>,
    /// Indicates if you want to enable the legacy email template mail setting.
    enabled: option<bool>,
    /// The new HTML content for your legacy email template.
    html-content: option<string>
  }
  patch-mail-settings-template: func(params: patch-mail-settings-template-params) -> result<patch-mail-settings-template-response, patch-mail-settings-template-error>;

}

interface contacts {
  enum post-mc-contacts-exports-body-file-type-enum {
    csv,
    json,
  }

  enum contact-export-status-enum {
    pending,
    ready,
    failure,
  }

  enum put-mc-contacts-imports-body-file-type-enum {
    csv,
  }

  record get-mc-contats-response {
    metadata: option<selfmetadata>,
    contact-count: option<s32>,
    result-op: option<list<contact-details3>>
  }

  record selfmetadata {
    /// A link to this object.
    self: option<string>
  }

  record contact-details3 {
    metadata: option<selfmetadata>,
    address-line-v1: option<string>,
    address-line-v2: option<string>,
    alternate-emails: option<list<string>>,
    city: option<string>,
    country: option<string>,
    created-at: string,
    custom-fields: option<list<contact-details3-custom-fields-entry>>,
    email: option<string>,
    facebook: option<string>,
    first-name: option<string>,
    id: string,
    last-name: option<string>,
    line: option<string>,
    list-ids: list<string>,
    phone-number: option<string>,
    postal-code: option<string>,
    segment-ids: list<string>,
    state-province-region: option<string>,
    unique-name: option<string>,
    updated-at: string,
    whatsapp: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record contact-details3-custom-fields-entry {
    key: string,
    value: string
  }

  record contact-request {
    /// The first line of the address.
    address-line-v1: option<string>,
    /// An optional second line for the address.
    address-line-v2: option<string>,
    /// Additional emails associated with the contact.
    alternate-emails: option<list<string>>,
    /// The contact's city.
    city: option<string>,
    /// The contact's country. Can be a full name or an abbreviation.
    country: option<string>,
    custom-fields: option<list<custom-fields-by-id-entry>>,
    /// The contact's primary email. This is required to be a valid email.
    email: string,
    /// The contact's personal name.
    first-name: option<string>,
    /// The contact's family name.
    last-name: option<string>,
    /// The contact's ZIP code or other postal code.
    postal-code: option<string>,
    /// The contact's state, province, or region.
    state-province-region: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record custom-fields-by-id-entry {
    key: string,
    value: string
  }

  record put-mc-contacts-response {
    /// Indicates that the contacts are queued for processing. Check the job status with the "Import Contacts Status" endpoint.
    job-id: option<string>
  }

  /// The deletion job has been accepted and is being processed.
  record delete-mc-contacts-response {
    /// The deletion job ID.
    job-id: list<delete-mc-contacts-response-job-id-entry>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-mc-contacts-response-job-id-entry {
    key: string,
    value: string
  }

  record post-marketing-contacts-batch-response {
    result-op: option<list<contact-details3>>
  }

  record get-mc-contacts-count-response {
    /// `billable_breakdown` will only appear to the parent user in an account with subusers.
    billable-breakdown: option<get-mc-contacts-count-response-billable-breakdown>,
    /// The count of contacts this month for billing purposes.
    billable-count: option<s32>,
    /// The total number of contacts.
    contact-count: s32
  }

  /// `billable_breakdown` will only appear to the parent user in an account with subusers.
  record get-mc-contacts-count-response-billable-breakdown {
    /// A map of each subuser's billable contact usage. Each key is the subuser's ID and each value is the usage thus far this month.
    breakdown: option<list<get-mc-contacts-count-response-billable-breakdown-breakdown-entry>>,
    /// The sum of all the subuser's billable contacts
    total: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record get-mc-contacts-count-response-billable-breakdown-breakdown-entry {
    key: string,
    value: string
  }

  record get-marketing-contacts-exports-response {
    metadata: option<get-marketing-contacts-exports-response-metadata>,
    result-op: option<list<get-marketing-contacts-exports-response-result-op-item>>
  }

  record get-marketing-contacts-exports-response-metadata {
    /// Link to next page.
    next: option<string>,
    prev: option<string>,
    /// Link to this page.
    self: option<string>
  }

  record get-marketing-contacts-exports-response-result-op-item {
    metadata: option<get-marketing-contacts-exports-response-result-op-item-metadata>,
    /// This ISO8601 timestamp when the export was completed.
    completed-at: option<string>,
    /// This ISO8601 timestamp when the export was created.
    created-at: option<string>,
    /// This ISO8601 timestamp when the export expires.
    expires-at: option<string>,
    /// Allowed types: `contacts_export`, `list_export`, or `segment_export`.
    export-type: option<string>,
    /// Export jobs ID.
    id: option<string>,
    lists: option<list<get-marketing-contacts-exports-response-result-op-item-lists-item>>,
    segments: option<list<get-marketing-contacts-exports-response-result-op-item-segments-item>>,
    /// Allowed values: `pending`, `ready`, or `failure`.
    status: option<string>,
    /// One or more download URLs for the contact file(s) if the status is `ready`.
    urls: option<list<string>>,
    /// User ID.
    user-id: option<string>
  }

  record get-marketing-contacts-exports-response-result-op-item-metadata {
    next: option<string>,
    prev: option<string>,
    self: option<string>
  }

  record get-marketing-contacts-exports-response-result-op-item-lists-item {
    id: option<string>,
    name: option<string>
  }

  record get-marketing-contacts-exports-response-result-op-item-segments-item {
    id: option<string>,
    name: option<string>
  }

  record post-mc-contacts-exports-body-notifications {
    email: option<bool>
  }

  record post-mc-contacts-exports-response {
    metadata: metadata,
    /// The ID of the export job.
    id: option<string>
  }

  record metadata {
    /// The number of items in the entire list, i.e., across all pages.
    count: option<f64>,
    /// The URL of the next page of results. If this field isn't present, you're at the end of the list.
    next: option<string>,
    /// The URL of the previous page of results. If this field isn't present, you're at the start of the list.
    prev: option<string>,
    /// The URL of the current page of results.
    self: option<string>
  }

  record contact-export {
    metadata: option<metadata>,
    /// The ISO8601 timestamp when the export was completed.
    completed-at: option<string>,
    /// The total number of exported contacts.
    contact-count: option<s32>,
    /// The ISO8601 timestamp when the export was begun.
    created-at: string,
    /// The ISO8601 timestamp when the exported file on S3 will expire.
    expires-at: string,
    id: string,
    /// A human readable message if the status is `failure`.
    message: option<string>,
    /// The export job's status. Allowed values: `pending`, `ready`, or `failure`.
    status: contact-export-status-enum,
    /// The ISO8601 timestamp when the export was updated.
    updated-at: string,
    /// One or more download URLs for the contact file if the status is `ready`.
    urls: option<list<string>>
  }

  record put-mc-contacts-imports-response {
    /// The ID of the import job.
    job-id: option<string>,
    /// A list of headers that must be included in PUT request.
    upload-headers: option<list<put-mc-contacts-imports-response-upload-headers-item>>,
    /// The URI to PUT the upload file to.
    upload-uri: option<string>
  }

  record put-mc-contacts-imports-response-upload-headers-item {
    header: string,
    value: string
  }

  record contact-import {
    /// The ISO8601 timestamp when the job was finished.
    finished-at: option<string>,
    /// The job ID.
    id: option<string>,
    /// The job type. Allowed values: `upsert`, or `delete`.
    job-type: option<string>,
    /// Result map of the import job.
    results: option<contact-import-results>,
    /// The ISO8601 timestamp when the job was created.
    started-at: option<string>,
    /// The job state. Allowed values: `pending`, `completed`, `errored`, or `failed`.
    status: option<string>
  }

  /// Result map of the import job.
  record contact-import-results {
    /// Created contact count from the import.
    created-count: option<f64>,
    /// Count of deleted contacts that resulted in error.
    deleted-count: option<f64>,
    /// Count of imported contacts that resulted in error.
    errored-count: option<f64>,
    /// The download URL of the file which provides information about any errors.
    errors-url: option<string>,
    /// Requested contact count from the import.
    requested-count: option<f64>,
    /// Updated contact count from the import.
    updated-count: option<f64>
  }

  record post-mc-contacts-search-response {
    metadata: option<selfmetadata>,
    /// The total number of contacts matched.
    contact-count: f64,
    result-op: option<list<contact-details3>>
  }

  record post-marketing-contacts-search-emails-response {
    result-op: option<post-marketing-contacts-search-emails-response-result-op>
  }

  record post-marketing-contacts-search-emails-response-result-op {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-mc-contats-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant put-mc-contacts-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-mc-contacts-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-marketing-contacts-batch-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mc-contacts-count-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-marketing-contacts-exports-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-mc-contacts-exports-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mc-contacts-exports-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant put-mc-contacts-imports-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-marketing-contacts-imports-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-mc-contacts-search-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    request-timeout(string),
    internal-server-error(string),
    other(string)
  }

  variant post-marketing-contacts-search-emails-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mc-contacts-id-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get Sample Contacts
  get-mc-contats: func() -> result<get-mc-contats-response, get-mc-contats-error>;

  /// Add or Update a Contact
  record put-mc-contacts-params {
    /// One or more contacts objects that you intend to upsert. The available fields for a contact, including the required `email` field are described below.
    contacts: list<contact-request>,
    /// An array of List ID strings that this contact will be added to.
    list-ids: option<list<string>>
  }
  put-mc-contacts: func(params: put-mc-contacts-params) -> result<put-mc-contacts-response, put-mc-contacts-error>;

  /// Delete Contacts
  record delete-mc-contacts-params {
    /// Must be set to `"true"` to delete all contacts.
    delete-all-contacts: option<string>,
    /// A comma-separated list of contact IDs.
    ids: option<string>
  }
  delete-mc-contacts: func(params: delete-mc-contacts-params) -> result<delete-mc-contacts-response, delete-mc-contacts-error>;

  /// Get Batched Contacts by IDs
  record post-marketing-contacts-batch-params {
    ids: list<string>
  }
  post-marketing-contacts-batch: func(params: post-marketing-contacts-batch-params) -> result<post-marketing-contacts-batch-response, post-marketing-contacts-batch-error>;

  /// Get Total Contact Count
  get-mc-contacts-count: func() -> result<get-mc-contacts-count-response, get-mc-contacts-count-error>;

  /// Get All Existing Exports
  get-marketing-contacts-exports: func() -> result<get-marketing-contacts-exports-response, get-marketing-contacts-exports-error>;

  /// Export Contacts
  record post-mc-contacts-exports-params {
    /// File type for export file. Choose from `json` or `csv`.
    file-type: option<post-mc-contacts-exports-body-file-type-enum>,
    /// IDs of the contact lists you want to export.
    list-ids: option<list<string>>,
    /// The maximum size of an export file in MB. Note that when this option is specified, multiple output files may be returned from the export.
    max-file-size: option<s32>,
    notifications: option<post-mc-contacts-exports-body-notifications>,
    /// IDs of the contact segments you want to export.
    segment-ids: option<list<string>>
  }
  post-mc-contacts-exports: func(params: post-mc-contacts-exports-params) -> result<post-mc-contacts-exports-response, post-mc-contacts-exports-error>;

  /// Export Contacts Status
  record get-mc-contacts-exports-id-params {
    id: string
  }
  get-mc-contacts-exports-id: func(params: get-mc-contacts-exports-id-params) -> result<contact-export, get-mc-contacts-exports-id-error>;

  /// Import Contacts
  record put-mc-contacts-imports-params {
    /// Import file header to reserved/custom field mapping.
    field-mappings: list<string>,
    /// Upload file type.
    file-type: put-mc-contacts-imports-body-file-type-enum,
    /// All contacts will be added to each of the specified lists.
    list-ids: option<list<string>>
  }
  put-mc-contacts-imports: func(params: put-mc-contacts-imports-params) -> result<put-mc-contacts-imports-response, put-mc-contacts-imports-error>;

  /// Import Contacts Status
  record get-marketing-contacts-imports-id-params {
    id: string
  }
  get-marketing-contacts-imports-id: func(params: get-marketing-contacts-imports-id-params) -> result<contact-import, get-marketing-contacts-imports-id-error>;

  /// Search Contacts
  record post-mc-contacts-search-params {
    query: string
  }
  post-mc-contacts-search: func(params: post-mc-contacts-search-params) -> result<post-mc-contacts-search-response, post-mc-contacts-search-error>;

  /// Get Contacts by Emails
  record post-marketing-contacts-search-emails-params {
    /// One or more primary emails and/or alternate emails to search through your contacts for.
    emails: list<string>
  }
  post-marketing-contacts-search-emails: func(params: post-marketing-contacts-search-emails-params) -> result<post-marketing-contacts-search-emails-response, post-marketing-contacts-search-emails-error>;

  /// Get a Contact by ID
  record get-mc-contacts-id-params {
    id: string
  }
  get-mc-contacts-id: func(params: get-mc-contacts-id-params) -> result<contact-details3, get-mc-contacts-id-error>;

}

interface custom-fields {
  enum custom-field-definitions-response-field-type-enum {
    text,
    number,
    date,
  }

  record get-mc-field-definitions-response {
    metadata: option<metadata>,
    custom-fields: list<custom-field-definitions-response>,
    reserved-fields: reserved-field-definitions-response
  }

  record metadata {
    count: option<s32>,
    next: option<string>,
    prev: option<string>,
    self: option<string>
  }

  record custom-field-definitions-response {
    field-type: custom-field-definitions-response-field-type-enum,
    id: string,
    name: string
  }

  record reserved-field-definitions-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-mc-field-definitions-response {
    field-type: custom-field-definitions-response-field-type-enum,
    id: string,
    name: string,
    metadata: option<metadata>
  }

  record patch-mc-field-definitions-custom-field-id-response {
    field-type: custom-field-definitions-response-field-type-enum,
    id: string,
    name: string,
    metadata: option<metadata>
  }

  variant post-mc-field-definitions-error {
    bad-request(string),
    other(string)
  }

  variant patch-mc-field-definitions-custom-field-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant delete-mc-field-definitions-custom-field-id-error {
    not-found(string),
    other(string)
  }

  /// Get All Field Definitions
  get-mc-field-definitions: func() -> result<get-mc-field-definitions-response, string>;

  /// Create Custom Field Definition
  record post-mc-field-definitions-params {
    field-type: custom-field-definitions-response-field-type-enum,
    name: string
  }
  post-mc-field-definitions: func(params: post-mc-field-definitions-params) -> result<post-mc-field-definitions-response, post-mc-field-definitions-error>;

  /// Update Custom Field Definition
  record patch-mc-field-definitions-custom-field-id-params {
    custom-field-id: string,
    name: string
  }
  patch-mc-field-definitions-custom-field-id: func(params: patch-mc-field-definitions-custom-field-id-params) -> result<patch-mc-field-definitions-custom-field-id-response, patch-mc-field-definitions-custom-field-id-error>;

  /// Delete Custom Field Definition
  record delete-mc-field-definitions-custom-field-id-params {
    custom-field-id: string
  }
  delete-mc-field-definitions-custom-field-id: func(params: delete-mc-field-definitions-custom-field-id-params) -> result<string, delete-mc-field-definitions-custom-field-id-error>;

}

interface lists {
  record get-mc-lists-response {
    metadata: option<metadata>,
    result-op: option<list<list-op>>
  }

  record metadata {
    /// The number of items in the entire list, i.e., across all pages.
    count: option<f64>,
    /// The URL of the next page of results. If this field isn't present, you're at the end of the list.
    next: option<string>,
    /// The URL of the previous page of results. If this field isn't present, you're at the start of the list.
    prev: option<string>,
    /// The URL of the current page of results.
    self: option<string>
  }

  record list-op {
    metadata: option<selfmetadata>,
    /// The number of contacts currently stored on the list.
    contact-count: option<s32>,
    /// The generated ID for your list.
    id: option<string>,
    /// The name you gave your list.
    name: option<string>
  }

  record selfmetadata {
    /// A link to this object.
    self: option<string>
  }

  record get-mc-lists-id-response {
    metadata: option<selfmetadata>,
    /// The number of contacts currently stored on the list.
    contact-count: option<s32>,
    /// The generated ID for your list.
    id: option<string>,
    /// The name you gave your list.
    name: option<string>,
    contact-sample: option<contact-details2>
  }

  record contact-details2 {
    metadata: option<selfmetadata>,
    address-line-v1: option<string>,
    address-line-v2: option<string>,
    alternate-emails: option<list<string>>,
    city: option<string>,
    country: option<string>,
    created-at: string,
    custom-fields: option<list<contact-details2-custom-fields-entry>>,
    email: option<string>,
    facebook: option<string>,
    first-name: option<string>,
    id: string,
    last-name: option<string>,
    line: option<string>,
    list-ids: list<string>,
    phone-number: option<string>,
    postal-code: option<string>,
    segment-ids: option<list<string>>,
    state-province-region: option<string>,
    unique-name: option<string>,
    updated-at: string,
    whatsapp: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record contact-details2-custom-fields-entry {
    key: string,
    value: string
  }

  /// The delete has been accepted and is processing.
  record delete-lists-id-response {
    /// job_id of the async job
    job-id: option<string>
  }

  /// The removal is accepted and processing.
  record delete-mc-lists-id-contacts-response {
    /// job_id of the async job
    job-id: option<string>
  }

  record get-mc-lists-id-contacts-count-response {
    billable-count: option<s32>,
    contact-count: option<s32>
  }

  variant post-mc-lists-error {
    bad-request(string),
    other(string)
  }

  variant get-mc-lists-id-error {
    not-found(string),
    other(string)
  }

  variant patch-mc-lists-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant delete-lists-id-error {
    not-found(string),
    other(string)
  }

  variant delete-mc-lists-id-contacts-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant get-mc-lists-id-contacts-count-error {
    not-found(string),
    other(string)
  }

  /// Get All Lists
  record get-mc-lists-params {
    /// Maximum number of elements to return. Defaults to 100, returns 1000 max
    page-size: option<f64>,
    page-token: option<string>
  }
  get-mc-lists: func(params: get-mc-lists-params) -> result<get-mc-lists-response, string>;

  /// Create List
  record post-mc-lists-params {
    /// Your name for your list
    name: string
  }
  post-mc-lists: func(params: post-mc-lists-params) -> result<list-op, post-mc-lists-error>;

  /// Get a List by ID
  record get-mc-lists-id-params {
    id: string,
    /// Setting this parameter to the true  will cause the contact_sample to be returned
    contact-sample: option<bool>
  }
  get-mc-lists-id: func(params: get-mc-lists-id-params) -> result<get-mc-lists-id-response, get-mc-lists-id-error>;

  /// Update List
  record patch-mc-lists-id-params {
    id: string,
    /// Your name for your list.
    name: option<string>
  }
  patch-mc-lists-id: func(params: patch-mc-lists-id-params) -> result<list-op, patch-mc-lists-id-error>;

  /// Delete a list
  record delete-lists-id-params {
    id: string,
    /// Flag indicates that all contacts on the list are also to be deleted.
    delete-contacts: option<bool>
  }
  delete-lists-id: func(params: delete-lists-id-params) -> result<delete-lists-id-response, delete-lists-id-error>;

  /// Remove Contacts from a List
  record delete-mc-lists-id-contacts-params {
    id: string,
    /// comma separated list of contact ids
    contact-ids: string
  }
  delete-mc-lists-id-contacts: func(params: delete-mc-lists-id-contacts-params) -> result<delete-mc-lists-id-contacts-response, delete-mc-lists-id-contacts-error>;

  /// Get List Contact Count
  record get-mc-lists-id-contacts-count-params {
    id: string
  }
  get-mc-lists-id-contacts-count: func(params: get-mc-lists-id-contacts-count-params) -> result<get-mc-lists-id-contacts-count-response, get-mc-lists-id-contacts-count-error>;

}

interface segmenting-contacts {
  record get-marketing-segments-response {
    results: list<segment-summary>
  }

  record segment-summary {
    contacts-count: s32,
    /// ISO8601 of created timestamp
    created-at: string,
    id: string,
    name: option<string>,
    /// ISO8601 string that is equal to `sample_updated_at` plus an internally calculated offset that depends on how often contacts enter or exit segments as the scheduled pipeline updates the samples.
    next-sample-update: option<string>,
    /// The id of the list if this segment is a child of a list.  This implies the query `AND CONTAINS(list_ids, ${parent_list_id})`
    parent-list-id: option<string>,
    /// ISO8601 timestamp the sample was last updated
    sample-updated-at: string,
    /// ISO8601 timestamp the object was last updated
    updated-at: string
  }

  record full-segment {
    contacts-count: s32,
    /// ISO8601 of created timestamp
    created-at: string,
    id: string,
    name: option<string>,
    /// ISO8601 string that is equal to `sample_updated_at` plus an internally calculated offset that depends on how often contacts enter or exit segments as the scheduled pipeline updates the samples.
    next-sample-update: option<string>,
    /// The id of the list if this segment is a child of a list.  This implies the query `AND CONTAINS(list_ids, ${parent_list_id})`
    parent-list-id: option<string>,
    /// ISO8601 timestamp the sample was last updated
    sample-updated-at: string,
    /// ISO8601 timestamp the object was last updated
    updated-at: string,
    contacts-sample: list<contact-response>,
    /// AST representation of the query DSL
    query-json: option<list<full-segment-query-json-entry>>,
    /// The array of list ids to filter contacts on when building this segment. It allows only one such list id for now. We will support more in future
    parent-list-ids: option<list<string>>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: string
  }

  record contact-response {
    /// First line of address of the contact. This is a reserved field.
    address-line-v1: string,
    /// Second line of address of the contact. This is a reserved field.
    address-line-v2: string,
    /// Alternate emails of the contact. This is a reserved field.
    alternate-emails: list<string>,
    /// City associated with the contact. This is a reserved field.
    city: string,
    /// Country associated with the address of the contact. This is a reserved field.
    country: string,
    /// The user may choose to create up to 120 custom fields or none at all. This is not a reserved field.
    custom-fields: contact-response-custom-fields,
    /// Email of the contact. This is a reserved field.
    email: string,
    /// First name of the contact. This is a reserved field.
    first-name: string,
    /// ID assigned to a contact when added to the system.
    id: string,
    /// Last name of the contact. This is a reserved field.
    last-name: string,
    /// IDs of all lists the contact is part of
    list-ids: option<list<string>>,
    /// Zipcode associated with the address of the contact. This is a reserved field.
    postal-code: s32,
    /// IDs of all segments the contact is part of
    segment-ids: option<list<string>>,
    /// State associated with the contact. This is a reserved field.
    state-province-region: string
  }

  /// The user may choose to create up to 120 custom fields or none at all. This is not a reserved field.
  record contact-response-custom-fields {
    x: option<string>,
    custom-field-name1: option<string>,
    custom-field-name2: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record full-segment-query-json-entry {
    key: string,
    value: string
  }

  record post-marketing-segments-delete-response {
    errors: option<list<post-marketing-segments-delete-response-errors-item>>
  }

  record post-marketing-segments-delete-response-errors-item {
    /// error message that indicates why segment cannot be deleted ("in-use", "segment not found", "invalid uuid")
    error: option<string>,
    /// Segment ID
    id: option<string>,
    /// resources in which segment is being used
    resources: option<post-marketing-segments-delete-response-errors-item-resources>
  }

  /// resources in which segment is being used
  record post-marketing-segments-delete-response-errors-item-resources {
    /// the resource ids
    ids: option<list<string>>,
    /// the type of resource in use (e.g., "automation")
    type-op: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-marketing-segments-segment-id-response-entry {
    key: string,
    value: string
  }

  variant get-marketing-segments-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-marketing-segments-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-marketing-segments-delete-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-marketing-segments-segment-id-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-marketing-segments-segment-id-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-marketing-segments-segment-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get List of Segments
  record get-marketing-segments-params {
    /// A comma separated list of list ids to be used when searching for segments with the specified parent_list_id, no more than 50 is allowed
    parent-list-ids: option<string>,
    /// If set to `true` segments with an empty value of `parent_list_id` will be returned in the filter.  If the value is not present it defaults to 'false'.
    no-parent-list-id: option<bool>
  }
  get-marketing-segments: func(params: get-marketing-segments-params) -> result<get-marketing-segments-response, get-marketing-segments-error>;

  /// Create Segment
  record post-marketing-segments-params {
    /// Name of the segment.
    name: string,
    /// The array of list ids to filter contacts on when building this segment. It allows only one such list id for now. We will support more in future
    parent-list-ids: option<list<string>>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: string,
    /// The id of the list if this segment is a child of a list.  This implies the query is rewritten as `(${query_dsl}) AND CONTAINS(list_ids, ${parent_list_id})`
    parent-list-id: option<string>
  }
  post-marketing-segments: func(params: post-marketing-segments-params) -> result<full-segment, post-marketing-segments-error>;

  /// Bulk Delete Segments
  record post-marketing-segments-delete-params {
    ids: option<list<string>>
  }
  post-marketing-segments-delete: func(params: post-marketing-segments-delete-params) -> result<post-marketing-segments-delete-response, post-marketing-segments-delete-error>;

  /// Get Segment by ID
  record get-marketing-segments-segment-id-params {
    segment-id: string,
    /// Defaults to `false`.  Set to `true` to return the parsed SQL AST as a JSON object in the field `query_json`
    query-json: option<bool>
  }
  get-marketing-segments-segment-id: func(params: get-marketing-segments-segment-id-params) -> result<full-segment, get-marketing-segments-segment-id-error>;

  /// Update Segment
  record patch-marketing-segments-segment-id-params {
    segment-id: string,
    /// Name of the segment.
    name: string,
    /// The array of list ids to filter contacts on when building this segment. It allows only one such list id for now. We will support more in future
    parent-list-ids: option<list<string>>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: string
  }
  patch-marketing-segments-segment-id: func(params: patch-marketing-segments-segment-id-params) -> result<full-segment, patch-marketing-segments-segment-id-error>;

  /// Delete Segment
  record delete-marketing-segments-segment-id-params {
    segment-id: string
  }
  delete-marketing-segments-segment-id: func(params: delete-marketing-segments-segment-id-params) -> result<list<delete-marketing-segments-segment-id-response-entry>, delete-marketing-segments-segment-id-error>;

}

interface segmenting-contacts-v2-beta {
  record all-segments-response {
    metadata: option<metadata>,
    /// Total number of contacts present in the segment
    contacts-count: s32,
    /// ISO8601 timestamp of when the object was created
    created-at: string,
    /// ID assigned to the segment when created.
    id: string,
    /// Name of the segment.
    name: string,
    /// ISO8601 timestamp of when the samples will be next updated
    next-sample-update: string,
    /// The array of list ids to filter contacts on when building this segment. It allows only one such list id for now. We will support more in future
    parent-list-ids: list<string>,
    /// If not set, segment contains a query for use with Segment v1 APIs. If set to '2', segment contains a SQL query for use in v2.
    query-version: string,
    /// ISO8601 timestamp of when the samples were last updated
    sample-updated-at: string,
    status: segment-status-response,
    /// ISO8601 timestamp of when the object was last updated
    updated-at: string
  }

  record metadata {
    count: option<s32>,
    next: option<string>,
    prev: option<string>,
    self: option<string>
  }

  /// Segment status indicates whether the segment's contacts will be updated periodically
  record segment-status-response {
    /// Describes any errors that were encountered during query validation
    error-message: option<string>,
    /// Status of query validation. PENDING, VALID, or INVALID
    query-validation: string
  }

  record segment-response {
    /// Total number of contacts present in the segment
    contacts-count: s32,
    /// A subset of all contacts that are in this segment
    contacts-sample: list<contact-response>,
    /// ISO8601 timestamp of when the object was created
    created-at: string,
    /// ID assigned to the segment when created.
    id: string,
    /// Name of the segment.
    name: string,
    /// ISO8601 timestamp of when the samples will be next updated
    next-sample-update: string,
    /// The array of list ids to filter contacts on when building this segment. It allows only one such list id for now. We will support more in future
    parent-list-ids: list<string>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: string,
    /// If not set, segment contains a Query for use with Segment v1 APIs. If set to '2', segment contains a SQL query for use in v2.
    query-version: string,
    /// ISO8601 timestamp of when the samples were last updated
    sample-updated-at: string,
    status: segment-status-response,
    /// ISO8601 timestamp of when the object was last updated
    updated-at: string
  }

  record contact-response {
    /// First line of address of the contact. This is a reserved field.
    address-line-v1: string,
    /// Second line of address of the contact. This is a reserved field.
    address-line-v2: string,
    /// Alternate emails of the contact. This is a reserved field.
    alternate-emails: list<string>,
    /// City associated with the contact. This is a reserved field.
    city: string,
    /// Country associated with the address of the contact. This is a reserved field.
    country: string,
    /// The user may choose to create up to 120 custom fields or none at all. This is not a reserved field.
    custom-fields: contact-response-custom-fields,
    /// Email of the contact. This is a reserved field.
    email: string,
    /// First name of the contact. This is a reserved field.
    first-name: string,
    /// ID assigned to a contact when added to the system.
    id: string,
    /// Last name of the contact. This is a reserved field.
    last-name: string,
    /// IDs of all lists the contact is part of
    list-ids: option<list<string>>,
    /// Zipcode associated with the address of the contact. This is a reserved field.
    postal-code: s32,
    /// IDs of all segments the contact is part of
    segment-ids: option<list<string>>,
    /// State associated with the contact. This is a reserved field.
    state-province-region: string
  }

  /// The user may choose to create up to 120 custom fields or none at all. This is not a reserved field.
  record contact-response-custom-fields {
    x: option<string>,
    custom-field-name1: option<string>,
    custom-field-name2: option<string>
  }

  variant get-segments-error {
    bad-request(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-segments-error {
    bad-request(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-segments-segment-id-error {
    bad-request(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-segments-segment-id-error {
    bad-request(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-segments-segment-id-error {
    bad-request(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get List of Segments
  record get-segments-params {
    /// A comma separated list up to 50 in size, to filter segments on.  Only segments that have any of these list ids as the parent list will be retrieved. This is different from the parameter of the same name used when creating a segment.
    parent-list-ids: option<string>,
    /// If set to `true` segments with an empty value of `parent_list_id` will be returned in the filter.  If the value is not present it defaults to 'false'.
    no-parent-list-id: option<bool>
  }
  get-segments: func(params: get-segments-params) -> result<all-segments-response, get-segments-error>;

  /// Create Segment
  record post-segments-params {
    /// Name of the segment.
    name: string,
    /// The array of list ids to filter contacts on when building this segment. It allows only one such list id for now. We will support more in future
    parent-list-ids: option<list<string>>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: string
  }
  post-segments: func(params: post-segments-params) -> result<segment-response, post-segments-error>;

  /// Get Segment by ID
  record get-segments-segment-id-params {
    segment-id: string,
    /// Defaults to `true`. Set to `false` to exclude the contacts_sample in the response.
    contacts-sample: option<bool>
  }
  get-segments-segment-id: func(params: get-segments-segment-id-params) -> result<segment-response, get-segments-segment-id-error>;

  /// Update Segment
  record patch-segments-segment-id-params {
    segment-id: string,
    /// Name of the segment.
    name: option<string>,
    /// SQL query which will filter contacts based on the conditions provided
    query-dsl: option<string>
  }
  patch-segments-segment-id: func(params: patch-segments-segment-id-params) -> result<segment-response, patch-segments-segment-id-error>;

  /// Delete segment
  record delete-segments-segment-id-params {
    segment-id: string
  }
  delete-segments-segment-id: func(params: delete-segments-segment-id-params) -> result<string, delete-segments-segment-id-error>;

}

interface senders {
  record post-marketing-senders-body-from-op {
    /// This is where the email will appear to originate from for your recipient
    email: string,
    /// This is the name appended to the from email field. IE - Your name or company name.
    name: string
  }

  record post-marketing-senders-body-reply-to {
    /// This is the email that your recipient will reply to.
    email: string,
    /// This is the name appended to the reply to email field. IE - Your name or company name.
    name: option<string>
  }

  record sender-id {
    /// The physical address of the sender identity.
    address: option<string>,
    /// Additional sender identity address information.
    address-v2: option<string>,
    /// The city of the sender identity.
    city: option<string>,
    /// The country of the sender identity.
    country: option<string>,
    from-op: option<sender-id-from-op>,
    /// A nickname for the sender identity. Not used for sending.
    nickname: option<string>,
    reply-to: option<sender-id-reply-to>,
    /// The state of the sender identity.
    state: option<string>,
    /// The zipcode of the sender identity.
    zip: option<string>,
    /// The time the sender identity was created.
    created-at: option<s32>,
    /// The unique identifier of the sender identity.
    id: option<s32>,
    /// True when the sender id is associated to a campaign in the Draft, Scheduled, or In Progress status. You cannot update or delete a locked sender identity.
    locked: option<bool>,
    /// The time the sender identity was last updated.
    updated-at: option<s32>,
    /// If the sender identity is verified or not. Only verified sender identities can be used to send email.
    verified: option<bool>
  }

  record sender-id-from-op {
    /// The email address from which your recipient will receive emails.
    email: option<string>,
    /// The name appended to the from email field. Typically your name or company name.
    name: option<string>
  }

  record sender-id-reply-to {
    /// The email address to which your recipient will reply.
    email: option<string>,
    /// The name appended to the reply to email field. Typically your name or company name.
    name: option<string>
  }

  variant post-marketing-senders-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Create a Sender Identity
  record post-marketing-senders-params {
    on-behalf-of: option<string>,
    /// The physical address of the sender identity.
    address: string,
    /// Additional sender identity address information.
    address-v2: option<string>,
    /// The city of the sender identity.
    city: string,
    /// The country of the sender identity.
    country: string,
    from-op: post-marketing-senders-body-from-op,
    /// A nickname for the sender identity. Not used for sending.
    nickname: string,
    reply-to: option<post-marketing-senders-body-reply-to>,
    /// The state of the sender identity.
    state: option<string>,
    /// The zipcode of the sender identity.
    zip: option<string>
  }
  post-marketing-senders: func(params: post-marketing-senders-params) -> result<sender-id, post-marketing-senders-error>;

}

interface single-sends {
  enum abtest-summary-type-op-enum {
    subject,
    content,
  }

  enum abtest-summary-winner-criteria-enum {
    open,
    click,
    manual,
  }

  enum singlesend-response-short-status-enum {
    draft,
    scheduled,
    triggered,
  }

  enum singlesend-request-email-config-editor-enum {
    code,
    design,
  }

  enum put-marketing-singlesends-id-schedule-body-send-at-enum {
    now,
  }

  enum put-marketing-singlesends-id-schedule-response-status-enum {
    scheduled,
  }

  record get-marketing-singlesends-response {
    metadata: option<metadata>,
    result-op: option<list<singlesend-response-short>>
  }

  record metadata {
    count: option<s32>,
    next: option<string>,
    prev: option<string>,
    self: option<string>
  }

  record singlesend-response-short {
    abtest: abtest-summary,
    /// categories to associate with this Single Send
    categories: list<string>,
    /// the ISO 8601 time at which the Single Send was created
    created-at: string,
    id: string,
    /// true if the Single Send's AB Test functionality has been toggled on
    is-abtest: bool,
    /// name of the Single Send
    name: string,
    /// the ISO 8601 time at which to send the Single Send; must be in future
    send-at: option<string>,
    /// current status of the Single Send
    status: singlesend-response-short-status-enum,
    /// the ISO 8601 time at which the Single Send was last updated
    updated-at: string
  }

  record abtest-summary {
    /// How long the A/B Testing will last
    duration: string,
    /// Last day to select an A/B Test Winner
    expiration-date: string,
    /// What percentage of your recipient will be included in your A/B testing
    test-percentage: s32,
    /// What differs between the A/B tests
    type-op: abtest-summary-type-op-enum,
    /// How the winner will be decided
    winner-criteria: abtest-summary-winner-criteria-enum,
    /// When the winner was selected
    winner-selected-at: string,
    /// Winner of the A/B Test
    winning-template-id: string
  }

  record singlesend-request-email-config {
    /// The URL allowing recipients to unsubscribe — you must provide this or the `suppression_group_id`.
    custom-unsubscribe-url: option<string>,
    /// A `design_id` can be used in place of `html_content`, `plain_content`, and/or `subject`. You can retrieve a design's ID from the ["List Designs" endpoint](https://sendgrid.api-docs.io/v3.0/designs-api/list-designs) or by pulling it from the design's detail page URL in the Marketing Campaigns App.
    design-id: option<string>,
    /// The editor — `"design"` or `"code"` — used to modify the Single Send's design in the Marketing Campaigns App.
    editor: option<singlesend-request-email-config-editor-enum>,
    /// If set to `true`, `plain_content` is always generated from `html_content`. If set to false, `plain_content` is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the Single Send. Do not include this field when using a `design_id`.
    html-content: option<string>,
    /// The name of the IP Pool from which the Single Send emails are sent.
    ip-pool: option<string>,
    /// The plain text content of the Single Send. Do not include this field when using a `design_id`.
    plain-content: option<string>,
    /// The ID of the verified Sender. You can retrieve a verified Sender's ID from the ["Get Verified Senders" endpoint](https://sendgrid.api-docs.io/v3.0/sender-verification/get-verified-senders) or by pulling it from the Sender's detail page URL in the SendGrid App.
    sender-id: option<s32>,
    /// The subject line of the Single Send. Do not include this field when using a `design_id`.
    subject: option<string>,
    /// The ID of the Suppression Group to allow recipients to unsubscribe — you must provide this or the `custom_unsubscribe_url`.
    suppression-group-id: option<s32>
  }

  record singlesend-request-send-to {
    /// Set to `true` to send to All Contacts. If set to `false`, at least one `list_ids` or `segment_ids` value must be provided before the Single Send is scheduled to be sent to recipients.
    all: option<bool>,
    /// The recipient List IDs that will receive the Single Send.
    list-ids: option<list<string>>,
    /// The recipient Segment IDs that will receive the Single Send.
    segment-ids: option<list<string>>
  }

  record singlesend-response {
    /// The categories to associate with this Single Send.
    categories: option<list<string>>,
    email-config: option<singlesend-response-email-config>,
    /// The name of the Single Send.
    name: string,
    /// The ISO 8601 time at which to send the Single Send — this must be set for a future time.
    send-at: option<string>,
    send-to: option<singlesend-response-send-to>,
    /// the ISO 8601 time at which the Single Send was created
    created-at: string,
    id: string,
    /// current status of the Single Send
    status: singlesend-response-short-status-enum,
    /// the ISO 8601 time at which the Single Send was last updated
    updated-at: option<string>,
    warnings: option<list<singlesend-response-warnings-item>>
  }

  record singlesend-response-email-config {
    /// The URL allowing recipients to unsubscribe — you must provide this or the `suppression_group_id`.
    custom-unsubscribe-url: option<string>,
    /// A `design_id` can be used in place of `html_content`, `plain_content`, and/or `subject`. You can retrieve a design's ID from the ["List Designs" endpoint](https://sendgrid.api-docs.io/v3.0/designs-api/list-designs) or by pulling it from the design's detail page URL in the Marketing Campaigns App.
    design-id: option<string>,
    /// The editor — `"design"` or `"code"` — used to modify the Single Send's design in the Marketing Campaigns App.
    editor: option<singlesend-request-email-config-editor-enum>,
    /// If set to `true`, `plain_content` is always generated from `html_content`. If set to false, `plain_content` is not altered.
    generate-plain-content: option<bool>,
    /// The HTML content of the Single Send. Do not include this field when using a `design_id`.
    html-content: option<string>,
    /// The name of the IP Pool from which the Single Send emails are sent.
    ip-pool: option<string>,
    /// The plain text content of the Single Send. Do not include this field when using a `design_id`.
    plain-content: option<string>,
    /// The ID of the verified Sender. You can retrieve a verified Sender's ID from the ["Get Verified Senders" endpoint](https://sendgrid.api-docs.io/v3.0/sender-verification/get-verified-senders) or by pulling it from the Sender's detail page URL in the SendGrid App.
    sender-id: option<s32>,
    /// The subject line of the Single Send. Do not include this field when using a `design_id`.
    subject: option<string>,
    /// The ID of the Suppression Group to allow recipients to unsubscribe — you must provide this or the `custom_unsubscribe_url`.
    suppression-group-id: option<s32>
  }

  record singlesend-response-send-to {
    /// Set to `true` to send to All Contacts. If set to `false`, at least one `list_ids` or `segment_ids` value must be provided before the Single Send is scheduled to be sent to recipients.
    all: option<bool>,
    /// The recipient List IDs that will receive the Single Send.
    list-ids: option<list<string>>,
    /// The recipient Segment IDs that will receive the Single Send.
    segment-ids: option<list<string>>
  }

  record singlesend-response-warnings-item {
    field: option<string>,
    message: option<string>,
    warning-id: option<string>
  }

  record get-marketing-singlesends-categories-response {
    /// list of latest one thousand unique categories associated with all Single Sends in ascending order
    categories: option<list<string>>
  }

  record post-marketing-singlesends-search-response {
    metadata: option<metadata>,
    result-op: option<list<singlesend-response-short>>
  }

  record put-marketing-singlesends-id-schedule-response {
    send-at: option<string>,
    status: option<put-marketing-singlesends-id-schedule-response-status-enum>
  }

  record singlesend-schedule {
    /// This is the ISO 8601 time at which to send the Single Send; must be in future, or the string "now"
    send-at: string,
    status: option<singlesend-response-short-status-enum>
  }

  variant get-marketing-singlesends-error {
    internal-server-error(string),
    other(string)
  }

  variant post-marketing-singlesends-error {
    bad-request(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-marketing-singlesends-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-marketing-singlesends-categories-error {
    internal-server-error(string),
    other(string)
  }

  variant post-marketing-singlesends-search-error {
    not-found(string),
    other(string)
  }

  variant get-marketing-singlesends-id-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant post-marketing-singlesends-id-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-marketing-singlesends-id-error {
    bad-request(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-marketing-singlesends-id-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant put-marketing-singlesends-id-schedule-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-marketing-singlesends-id-schedule-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get All Single Sends
  record get-marketing-singlesends-params {
    page-size: option<s32>,
    page-token: option<string>
  }
  get-marketing-singlesends: func(params: get-marketing-singlesends-params) -> result<get-marketing-singlesends-response, get-marketing-singlesends-error>;

  /// Create Single Send
  record post-marketing-singlesends-params {
    /// The categories to associate with this Single Send.
    categories: option<list<string>>,
    email-config: option<singlesend-request-email-config>,
    /// The name of the Single Send.
    name: string,
    /// The ISO 8601 time at which to send the Single Send — this must be set for a future time.
    send-at: option<string>,
    send-to: option<singlesend-request-send-to>
  }
  post-marketing-singlesends: func(params: post-marketing-singlesends-params) -> result<singlesend-response, post-marketing-singlesends-error>;

  /// Bulk Delete Single Sends
  record delete-marketing-singlesends-params {
    /// Single Send IDs to delete
    ids: option<list<string>>
  }
  delete-marketing-singlesends: func(params: delete-marketing-singlesends-params) -> result<string, delete-marketing-singlesends-error>;

  /// Get All Categories
  get-marketing-singlesends-categories: func() -> result<get-marketing-singlesends-categories-response, get-marketing-singlesends-categories-error>;

  /// Get Single Sends Search
  record post-marketing-singlesends-search-params {
    page-size: option<s32>,
    page-token: option<string>,
    /// categories to associate with this Single Send, match any single send that has at least one of the categories
    categories: option<list<string>>,
    /// leading and trailing wildcard search on name of the Single Send
    name: option<string>,
    /// current status of the Single Send
    status: option<list<singlesend-response-short-status-enum>>
  }
  post-marketing-singlesends-search: func(params: post-marketing-singlesends-search-params) -> result<post-marketing-singlesends-search-response, post-marketing-singlesends-search-error>;

  /// Get Single Send by ID
  record get-marketing-singlesends-id-params {
    id: string
  }
  get-marketing-singlesends-id: func(params: get-marketing-singlesends-id-params) -> result<singlesend-response, get-marketing-singlesends-id-error>;

  /// Duplicate Single Send
  record post-marketing-singlesends-id-params {
    id: string,
    /// The name of the duplicate Single Send. If you choose to leave the name field blank, your duplicate will be assigned the name of the Single Send it was copied from with the text 'Copy of ' prepended to it. The end of the new Single Send name, including 'Copy of ', will be trimmed if the name exceeds the character limit.
    name: option<string>
  }
  post-marketing-singlesends-id: func(params: post-marketing-singlesends-id-params) -> result<singlesend-response, post-marketing-singlesends-id-error>;

  /// Update Single Send
  record patch-marketing-singlesends-id-params {
    id: string,
    /// The categories to associate with this Single Send.
    categories: option<list<string>>,
    email-config: option<singlesend-request-email-config>,
    /// The name of the Single Send.
    name: string,
    /// The ISO 8601 time at which to send the Single Send — this must be set for a future time.
    send-at: option<string>,
    send-to: option<singlesend-request-send-to>
  }
  patch-marketing-singlesends-id: func(params: patch-marketing-singlesends-id-params) -> result<singlesend-response, patch-marketing-singlesends-id-error>;

  /// Delete Single Send by ID
  record delete-marketing-singlesends-id-params {
    id: string
  }
  delete-marketing-singlesends-id: func(params: delete-marketing-singlesends-id-params) -> result<string, delete-marketing-singlesends-id-error>;

  /// Schedule Single Send
  record put-marketing-singlesends-id-schedule-params {
    id: string,
    /// This is the ISO 8601 time at which to send the Single Send; must be in future, or the string "now"
    send-at: put-marketing-singlesends-id-schedule-body-send-at-enum
  }
  put-marketing-singlesends-id-schedule: func(params: put-marketing-singlesends-id-schedule-params) -> result<put-marketing-singlesends-id-schedule-response, put-marketing-singlesends-id-schedule-error>;

  /// Delete Single Send Schedule
  record delete-marketing-singlesends-id-schedule-params {
    id: string
  }
  delete-marketing-singlesends-id-schedule: func(params: delete-marketing-singlesends-id-schedule-params) -> result<singlesend-schedule, delete-marketing-singlesends-id-schedule-error>;

}

interface marketing-campaigns-stats {
  enum get-automation-stat-group-by-item-enum {
    step-id,
  }

  enum get-automation-stat-aggregated-by-enum {
    day,
    total,
  }

  enum singlesends-response-results-item-ab-phase-enum {
    send,
    test,
    all,
  }

  enum get-singlesend-stat-group-by-item-enum {
    ab-variation,
    ab-phase,
  }

  enum get-singlesend-link-stat-ab-phase-id-enum {
    test,
    send,
  }

  record automations-response {
    metadata: option<metadata>,
    results: list<automations-response-results-item>
  }

  record metadata {
    /// The number of items in the entire list, i.e., across all pages.
    count: option<f64>,
    /// The URL of the next page of results. If this field isn't present, you're at the end of the list.
    next: option<string>,
    /// The URL of the previous page of results. If this field isn't present, you're at the start of the list.
    prev: option<string>,
    /// The URL of the current page of results.
    self: option<string>
  }

  record automations-response-results-item {
    /// This describes the time unit to which the stat is rolled up. It is based on the `aggregated_by` parameter included in the request. It can be "total" or the date (in YYYY-MM-DD format) the stats are for.
    aggregation: string,
    /// This is the ID of the Automation you are requesting stats for.
    id: string,
    stats: option<metrics>,
    /// This is the ID of the step if the stats were requested to be grouped by `step_id`.
    step-id: string
  }

  record metrics {
    bounce-drops: s32,
    bounces: s32,
    clicks: s32,
    delivered: s32,
    invalid-emails: s32,
    opens: s32,
    requests: s32,
    spam-report-drops: s32,
    spam-reports: s32,
    unique-clicks: s32,
    unique-opens: s32,
    unsubscribes: s32
  }

  record automations-link-stats-response {
    metadata: link-tracking-metadata,
    results: list<automations-link-stats-response-results-item>,
    total-clicks: s32
  }

  record link-tracking-metadata {
    /// The number of items in the entire list, i.e., across all pages.
    count: option<f64>,
    /// The URL of the next page of results. If this field isn't present, you're at the end of the list.
    next: option<string>,
    /// The URL of the previous page of results. If this field isn't present, you're at the start of the list.
    prev: option<string>,
    /// The URL of the current page of results.
    self: option<string>
  }

  record automations-link-stats-response-results-item {
    /// The number of clicks on this particular link.
    clicks: s32,
    /// This is the ID of the step if the stats were requested to be grouped by `step_id`.
    step-id: string,
    /// This is the URL of the link clicked. If `{{custom_fields}}` are part of the URL, they will be included.
    url: string,
    /// This is the location of the link clicked in each Automation step. Links are located according to their position within the message; the topmost link has index `0`.
    url-location: option<s32>
  }

  record singlesends-response {
    metadata: metadata,
    results: list<singlesends-response-results-item>
  }

  record singlesends-response-results-item {
    /// This is the A/B phase of the Single Send stat returned. If the `group_by` parameter doesn't include `ab_phase` in the request, then the value is "all".
    ab-phase: singlesends-response-results-item-ab-phase-enum,
    /// This is the A/B variation of the Single Send stat returned. If the `group_by` parameter doesn't include `ab_variation` in the request, then the value is "all".
    ab-variation: string,
    /// This describes the time unit to which the stat is rolled up. It is based on the `aggregated_by` parameter included in the request. It can be "total" or the date (in YYYY-MM-DD format) the stats are for.
    aggregation: option<string>,
    /// This is the ID of the Single Dend you require stats for.
    id: string,
    stats: option<metrics>
  }

  record singlesends-link-stats-response {
    metadata: link-tracking-metadata,
    /// This is the index of the link's location in the email contents.
    results: list<singlesends-link-stats-response-results-item>,
    total-clicks: option<s32>
  }

  record singlesends-link-stats-response-results-item {
    /// This is the A/B phase of the Single Send stat returned. If the `ab_phase` query parameter was not provided, it will return `"all"`.
    ab-phase: singlesends-response-results-item-ab-phase-enum,
    /// This is the A/B variation of the Single Send stat returned. It is set to `"all"` if the `ab_variation` query parameter was not set in the request and `group_by` doesn't contain `ab_variation`.
    ab-variation: string,
    /// the number of clicks on this particular link
    clicks: s32,
    /// This is the URL of the link clicked. If `{{custom_fields}}` are part of the URL, they will be included.
    url: string,
    /// This is the location of the link clicked in each Single Send A/B variation, or in the Single Send itself if there are no variations. Links are numbered from the top down; the topmost link is index `0`.
    url-location: option<s32>
  }

  variant getall-automation-stats-error {
    bad-request(string),
    other(string)
  }

  variant get-automations-stats-export-error {
    bad-request(string),
    other(string)
  }

  variant get-automation-stat-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant get-automation-link-stat-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant getall-singlesend-stats-error {
    bad-request(string),
    other(string)
  }

  variant get-singlesend-stats-export-error {
    bad-request(string),
    other(string)
  }

  variant get-singlesend-stat-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant get-singlesend-link-stat-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  /// Get All Automation Stats
  record getall-automation-stats-params {
    /// This endpoint returns all automation IDs if no `automation_ids` are specified.
    automation-ids: option<list<string>>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>
  }
  getall-automation-stats: func(params: getall-automation-stats-params) -> result<automations-response, getall-automation-stats-error>;

  /// Export Automation Stats
  record get-automations-stats-export-params {
    /// The IDs of Automations for which to export stats.
    ids: option<list<string>>,
    /// The [IANA Area/Region](https://en.wikipedia.org/wiki/Tz_database#Names_of_time_zones) string representing the timezone in which the stats are to be presented; i.e. `"America/Chicago"`. This parameter changes the timezone format only; it does not alter which stats are returned.
    timezone: option<string>
  }
  get-automations-stats-export: func(params: get-automations-stats-export-params) -> result<string, get-automations-stats-export-error>;

  /// Get Automation Stats by ID
  record get-automation-stat-params {
    id: string,
    /// Automations can have multiple steps. Including `step_id` as a `group_by` metric allows further granularity of stats.
    group-by: option<list<get-automation-stat-group-by-item-enum>>,
    /// Comma-separated list of `step_ids` that you want the link stats for.
    step-ids: option<list<string>>,
    /// Dictates how the stats are time-sliced. Currently, `"total"` and `"day"` are supported.
    aggregated-by: option<get-automation-stat-aggregated-by-enum>,
    /// Format: `YYYY-MM-DD`. If this parameter is included, the stats' start date is included in the search.
    start-date: option<string>,
    /// Format: `YYYY-MM-DD`.If this parameter is included, the stats' end date is included in the search.
    end-date: option<string>,
    /// [IANA Area/Region](https://en.wikipedia.org/wiki/Tz_database#Names_of_time_zones) string representing the timezone in which the stats are to be presented, e.g., "America/Chicago".
    timezone: option<string>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>
  }
  get-automation-stat: func(params: get-automation-stat-params) -> result<automations-response, get-automation-stat-error>;

  /// Get Automation Click Tracking Stats by ID
  record get-automation-link-stat-params {
    /// The ID of the Automation you want to get click tracking stats for. 
    id: string,
    /// Automations can have multiple steps. Including `step_id` as a `group_by` metric allows further granularity of stats.
    group-by: option<list<get-automation-stat-group-by-item-enum>>,
    /// Comma-separated list of `step_ids` that you want the link stats for.
    step-ids: option<list<string>>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>
  }
  get-automation-link-stat: func(params: get-automation-link-stat-params) -> result<automations-link-stats-response, get-automation-link-stat-error>;

  /// Get All Single Sends Stats
  record getall-singlesend-stats-params {
    /// This endpoint returns all Single Send IDs if no IDs are included in `singlesend_ids`.
    singlesend-ids: option<list<string>>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>
  }
  getall-singlesend-stats: func(params: getall-singlesend-stats-params) -> result<singlesends-response, getall-singlesend-stats-error>;

  /// Export Single Send Stats
  record get-singlesend-stats-export-params {
    /// The IDs of Single Sends for which to export stats.
    ids: option<list<string>>,
    /// The [IANA Area/Region](https://en.wikipedia.org/wiki/Tz_database#Names_of_time_zones) string representing the timezone in which the stats are to be presented; i.e. `"America/Chicago"`. This parameter changes the timezone format only; it does not alter which stats are returned.
    timezone: option<string>
  }
  get-singlesend-stats-export: func(params: get-singlesend-stats-export-params) -> result<string, get-singlesend-stats-export-error>;

  /// Get Single Send Stats by ID
  record get-singlesend-stat-params {
    id: string,
    /// Dictates how the stats are time-sliced. Currently, `"total"` and `"day"` are supported.
    aggregated-by: option<get-automation-stat-aggregated-by-enum>,
    /// Format: `YYYY-MM-DD`. If this parameter is included, the stats' start date is included in the search.
    start-date: option<string>,
    /// Format: `YYYY-MM-DD`.If this parameter is included, the stats' end date is included in the search.
    end-date: option<string>,
    /// [IANA Area/Region](https://en.wikipedia.org/wiki/Tz_database#Names_of_time_zones) string representing the timezone in which the stats are to be presented, e.g., "America/Chicago".
    timezone: option<string>,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>,
    /// A/B Single Sends have multiple variation IDs and phase IDs. Including these additional fields allows further granularity of stats by these fields.
    group-by: option<list<get-singlesend-stat-group-by-item-enum>>
  }
  get-singlesend-stat: func(params: get-singlesend-stat-params) -> result<singlesends-response, get-singlesend-stat-error>;

  /// Get Single Send Click Tracking Stats by ID
  record get-singlesend-link-stat-params {
    id: string,
    /// The number of elements you want returned on each page.
    page-size: option<s32>,
    /// The stats endpoints are paginated. To get the next page, call the passed `_metadata.next` URL. If `_metadata.prev` doesn't exist, you're at the first page. Similarly, if `_metadata.next` is not present, you're at the last page.
    page-token: option<string>,
    /// A/B Single Sends have multiple variation IDs and phase IDs. Including these additional fields allows further granularity of stats by these fields.
    group-by: option<list<get-singlesend-stat-group-by-item-enum>>,
    ab-variation-id: option<string>,
    ab-phase-id: option<get-singlesend-link-stat-ab-phase-id-enum>
  }
  get-singlesend-link-stat: func(params: get-singlesend-link-stat-params) -> result<singlesends-link-stats-response, get-singlesend-link-stat-error>;

}

interface send-test-email {
  /// one entry of a string-keyed map (free-form object)
  record post-marketing-test-send-email-response-entry {
    key: string,
    value: string
  }

  variant post-marketing-test-send-email-error {
    bad-request(string),
    other(string)
  }

  /// Send a Test Marketing Email
  record post-marketing-test-send-email-params {
    /// A custom unsubscribe URL.
    custom-unsubscribe-url: option<string>,
    /// An array of email addresses you want to send the test message to.
    emails: list<string>,
    /// You can either specify this address or specify a verified sender ID.
    from-address: option<string>,
    /// This ID must belong to a verified sender. Alternatively, you may supply a `from_address` email.
    sender-id: option<s32>,
    suppression-group-id: option<s32>,
    /// The ID of the template that you would like to use. If you use a template that contains a subject and content (either text or HTML), then those values specified at the personalizations or message level will not be used.
    template-id: string,
    ///  You can override the active template with an alternative template version by passing the version ID in this field. If this field is blank, the active template version will be used.
    version-id-override: option<string>
  }
  post-marketing-test-send-email: func(params: post-marketing-test-send-email-params) -> result<list<post-marketing-test-send-email-response-entry>, post-marketing-test-send-email-error>;

}

interface query {
  enum get-messages-response-messages-item-status-enum {
    processed,
    delivered,
    not-delivered,
  }

  enum get-v3-messages-msg-id-response-events-item-bounce-type-enum {
    bounced,
    blocked,
    expired,
  }

  enum get-v3-messages-msg-id-response-events-item-event-name-enum {
    bounced,
    opened,
    clicked,
    processed,
    dropped,
    delivered,
    deferred,
    spam-report,
    unsubscribe,
    group-unsubscribe,
    group-resubscribe,
  }

  enum get-v3-messages-msg-id-response-outbound-ip-type-enum {
    dedicated,
    shared,
  }

  enum get-v3-messages-msg-id-response-status-enum {
    processed,
    not-delivered,
    delivered,
  }

  record get-messages-response {
    messages: option<list<get-messages-response-messages-item>>
  }

  record get-messages-response-messages-item {
    clicks-count: s32,
    from-email: string,
    /// iso 8601 format
    last-event-time: string,
    msg-id: string,
    opens-count: s32,
    status: get-messages-response-messages-item-status-enum,
    subject: string,
    to-email: string
  }

  record get-v3-messages-msg-id-response {
    api-key-id: string,
    asm-group-id: s32,
    /// Categories users associated to the message
    categories: list<string>,
    /// List of events related to email message
    events: list<get-v3-messages-msg-id-response-events-item>,
    from-email: string,
    msg-id: string,
    /// This is the IP of the user who sent the message.
    originating-ip: string,
    /// IP used to send to the remote MTA. Used by UI to display IP in detailed view
    outbound-ip: string,
    /// Whether or not the outbound IP is dedicated vs shared
    outbound-ip-type: get-v3-messages-msg-id-response-outbound-ip-type-enum,
    /// Quick summary of the status of a message
    status: get-v3-messages-msg-id-response-status-enum,
    subject: string,
    /// Teammate's username
    teammate: string,
    template-id: string,
    to-email: string,
    /// JSON hash of arbitrary key-value pairs
    unique-args: string
  }

  record get-v3-messages-msg-id-response-events-item {
    /// Used with "deferred" events to indicate the attempt number out of 10. One "deferred" entry will exists under events array for each time a message was deferred with error message from the server. 
    attempt-num: option<s32>,
    /// Use to distinguish between types of bounces
    bounce-type: get-v3-messages-msg-id-response-events-item-bounce-type-enum,
    /// Name of event
    event-name: get-v3-messages-msg-id-response-events-item-event-name-enum,
    /// Client recipient used to click or open message
    http-user-agent: string,
    /// For example mx.gmail.com
    mx-server: string,
    /// Date of when event occurred
    processed: string,
    /// Explanation of what caused "bounced", "deferred", or "blocked". Usually contains error message from the server - e.g. message from gmail why mail was deferred
    reason: option<string>,
    /// Used with "clicked" event to indicate which url the user clicked.
    url: string
  }

  variant get-messages-error {
    bad-request(string),
    too-many-requests(string),
    other(string)
  }

  variant get-v3-messages-msg-id-error {
    bad-request(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  /// Filter all messages
  record get-messages-params {
    /// Use the query syntax  to filter your email activity.
    query: string,
    /// The number of messages returned. This parameter must be greater than 0 and less than or equal to 1000
    limit: option<f64>,
    x-query-id: option<string>,
    x-cursor: option<string>
  }
  get-messages: func(params: get-messages-params) -> result<get-messages-response, get-messages-error>;

  /// Filter messages by message ID
  record get-v3-messages-msg-id-params {
    /// The ID of the message you are requesting details for.
    msg-id: string
  }
  get-v3-messages-msg-id: func(params: get-v3-messages-msg-id-params) -> result<get-v3-messages-msg-id-response, get-v3-messages-msg-id-error>;

}

interface csv-ui-only {
  enum post-v3-messages-download-response-status-enum {
    pending,
  }

  record post-v3-messages-download-response {
    message: option<string>,
    status: option<post-v3-messages-download-response-status-enum>
  }

  record get-v3-messages-download-download-uuid-response {
    /// Returns the aws signed link to the csv file which mako UI should perform a get on to trigger the csv download for the user
    csv: string,
    /// A signed link that will allow you to download the CSV file requested by the Request a CSV endpoint.
    presigned-url: option<string>
  }

  variant post-v3-messages-download-error {
    bad-request(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-v3-messages-download-download-uuid-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Request CSV
  record post-v3-messages-download-params {
    /// Uses a SQL like syntax to indicate which messages to include in the CSV
    query: option<string>
  }
  post-v3-messages-download: func(params: post-v3-messages-download-params) -> result<post-v3-messages-download-response, post-v3-messages-download-error>;

  /// Download CSV
  record get-v3-messages-download-download-uuid-params {
    /// UUID used to locate the download csv request entry in the DB.
    /// 
    download-uuid: string
  }
  get-v3-messages-download-download-uuid: func(params: get-v3-messages-download-download-uuid-params) -> result<get-v3-messages-download-download-uuid-response, get-v3-messages-download-download-uuid-error>;

}

interface settings-partner {
  record get-partner-settings-response {
    result-op: option<list<get-partner-settings-response-result-op-item>>
  }

  record get-partner-settings-response-result-op-item {
    /// A description of this partner setting.
    description: string,
    /// Indicates if this partner setting has been enabled.
    enabled: bool,
    /// The name of the partner setting.
    name: string,
    /// The title of the partner.
    title: string
  }

  record partner-settings-new-relic {
    /// Indicates if your subuser statistics will be sent to your New Relic Dashboard.
    enable-subuser-statistics: option<bool>,
    /// Indicates if this setting is enabled. 
    enabled: bool,
    /// The license key provided with your New Relic account.
    license-key: string
  }

  /// Returns a list of all partner settings.
  record get-partner-settings-params {
    /// The number of settings to return per page.
    limit: option<s32>,
    /// The paging offset.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-partner-settings: func(params: get-partner-settings-params) -> result<get-partner-settings-response, string>;

  /// Returns all New Relic partner settings.
  record get-partner-settings-new-relic-params {
    on-behalf-of: option<string>
  }
  get-partner-settings-new-relic: func(params: get-partner-settings-new-relic-params) -> result<partner-settings-new-relic, string>;

  /// Updates New Relic partner settings.
  record patch-partner-settings-new-relic-params {
    on-behalf-of: option<string>,
    /// Indicates if your subuser statistics will be sent to your New Relic Dashboard.
    enable-subuser-statistics: option<bool>,
    /// Indicates if this partner setting is enabled.
    enabled: option<bool>,
    /// The license key for your New Relic account.
    license-key: option<string>
  }
  patch-partner-settings-new-relic: func(params: patch-partner-settings-new-relic-params) -> result<partner-settings-new-relic, string>;

}

interface api-key-permissions {
  record get-scopes-response {
    /// The list of scopes for which this user has access.
    scopes: list<string>
  }

  variant get-scopes-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Retrieve a list of scopes for which this user has access.
  record get-scopes-params {
    on-behalf-of: option<string>
  }
  get-scopes: func(params: get-scopes-params) -> result<get-scopes-response, get-scopes-error>;

}

interface teammates {
  enum get-v3-teammates-response-result-op-item-user-type-enum {
    admin,
    owner,
    teammate,
  }

  record get-v3-scopes-requests-response-item {
    /// Teammate's email
    email: option<string>,
    /// Teammate's first name
    first-name: option<string>,
    /// Request ID
    id: option<s32>,
    /// Teammate's last name
    last-name: option<string>,
    /// Name of group of scopes associated to page teammate is requesting access to
    scope-group-name: option<string>,
    /// Teammate's username
    username: option<string>
  }

  record patch-v3-scopes-requests-approve-id-response {
    /// name of feature teammate will be given access to
    scope-group-name: option<string>
  }

  record get-v3-teammates-response {
    result-op: option<list<get-v3-teammates-response-result-op-item>>
  }

  record get-v3-teammates-response-result-op-item {
    /// (optional) Teammate's address
    address: option<string>,
    /// (optional) Teammate's address
    address2: option<string>,
    /// (optional) Teammate's city
    city: option<string>,
    /// (optional) Teammate's country
    country: option<string>,
    /// Teammate's email
    email: option<string>,
    /// Teammate's first name
    first-name: option<string>,
    /// Set to true if teammate has admin privileges
    is-admin: option<bool>,
    /// Teammate's last name
    last-name: option<string>,
    /// (optional) Teammate's phone number
    phone: option<string>,
    /// (optional) Teammate's state
    state: option<string>,
    /// Indicate the type of user: owner user, teammate admin user, or normal teammate
    user-type: option<get-v3-teammates-response-result-op-item-user-type-enum>,
    /// Teammate's username
    username: option<string>,
    /// (optional) Teammate's website
    website: option<string>,
    /// (optional) Teammate's zip
    zip: option<string>
  }

  record post-v3-teammates-response {
    /// Teammate's email address
    email: option<string>,
    /// Set to true if teammate should have admin privileges
    is-admin: option<bool>,
    /// Initial set of permissions to give to teammate if they accept the invite
    scopes: option<list<string>>,
    /// Token to identify invite
    token: option<string>
  }

  record get-v3-teammates-pending-response {
    result-op: option<list<get-v3-teammates-pending-response-result-op-item>>
  }

  record get-v3-teammates-pending-response-result-op-item {
    /// Email address teammate invite will be sent to
    email: option<string>,
    /// timestamp indicates when invite will expire. Expiration is 7 days after invite creation
    expiration-date: option<s32>,
    /// Set to true to indicate teammate should have the same set of permissions as parent user
    is-admin: option<bool>,
    /// List of permissions to give teammate if they accept
    scopes: option<list<string>>,
    /// Invitation token used to identify user
    token: option<string>
  }

  record post-v3-teammates-pending-token-resend-response {
    /// Teammate's email address
    email: option<string>,
    /// Set to true if teammate should have admin privileges
    is-admin: option<bool>,
    /// Initial set of permissions to give to teammate if they accept the invite
    scopes: option<list<string>>,
    /// ID to identify invite
    token: option<string>
  }

  record get-v3-teammates-username-response {
    /// (optional) Teammate's address
    address: option<string>,
    /// (optional) Teammate's address
    address2: option<string>,
    /// (optional) Teammate's city
    city: option<string>,
    /// (optional) Teammate's country
    country: option<string>,
    /// Teammate's email
    email: option<string>,
    /// Teammate's first name
    first-name: option<string>,
    /// Set to true if teammate has admin privileges
    is-admin: option<bool>,
    /// Teammate's last name
    last-name: option<string>,
    /// (optional) Teammate's phone number
    phone: option<string>,
    /// Scopes associated to teammate
    scopes: option<list<string>>,
    /// (optional) Teammate's state
    state: option<string>,
    /// Indicate the type of user: account owner, teammate admin user, or normal teammate
    user-type: option<get-v3-teammates-response-result-op-item-user-type-enum>,
    /// Teammate's username
    username: option<string>,
    /// (optional) Teammate's website
    website: option<string>,
    /// (optional) Teammate's zip
    zip: option<string>
  }

  record patch-v3-teammates-username-response {
    /// (optional) Teammate's address
    address: option<string>,
    /// (optional) Teammate's address
    address2: option<string>,
    /// (optional) Teammate's city
    city: option<string>,
    /// (optional) Teammate's country
    country: option<string>,
    /// Teammate's email address
    email: option<string>,
    /// Teammate's first name
    first-name: option<string>,
    /// Set to true if teammate has admin priveleges
    is-admin: option<bool>,
    /// Teammate's last name
    last-name: option<string>,
    /// (optional) Teammate's phone number
    phone: option<string>,
    /// Scopes given to teammate
    scopes: option<list<string>>,
    /// (optional) Teammate's state
    state: option<string>,
    /// Indicate the type of user: owner user, teammate admin user, or normal teammate
    user-type: option<get-v3-teammates-response-result-op-item-user-type-enum>,
    /// Teammate's username
    username: option<string>,
    /// (optional) Teammate's website
    website: option<string>,
    /// (optional) Teammate's zip
    zip: option<string>
  }

  record delete-v3-teammates-username-response {
    errors: option<list<delete-v3-teammates-username-response-errors-item>>
  }

  record delete-v3-teammates-username-response-errors-item {
    field: option<string>,
    message: option<string>
  }

  variant delete-v3-scopes-requests-request-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant patch-v3-scopes-requests-approve-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant post-v3-teammates-error {
    bad-request(string),
    other(string)
  }

  variant delete-v3-teammates-pending-token-error {
    not-found(string),
    other(string)
  }

  variant post-v3-teammates-pending-token-resend-error {
    not-found(string),
    other(string)
  }

  variant patch-v3-teammates-username-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant delete-v3-teammates-username-error {
    not-found(string),
    other(string)
  }

  /// Retrieve access requests
  record get-v3-scopes-requests-params {
    /// Optional field to limit the number of results returned.
    limit: option<s32>,
    /// Optional beginning point in the list to retrieve from.
    offset: option<s32>
  }
  get-v3-scopes-requests: func(params: get-v3-scopes-requests-params) -> result<list<get-v3-scopes-requests-response-item>, string>;

  /// Deny access request
  record delete-v3-scopes-requests-request-id-params {
    /// The ID of the request that you want to deny.
    request-id: string
  }
  delete-v3-scopes-requests-request-id: func(params: delete-v3-scopes-requests-request-id-params) -> result<string, delete-v3-scopes-requests-request-id-error>;

  /// Approve access request
  record patch-v3-scopes-requests-approve-id-params {
    /// The ID of the request that you want to approve.
    request-id: string
  }
  patch-v3-scopes-requests-approve-id: func(params: patch-v3-scopes-requests-approve-id-params) -> result<patch-v3-scopes-requests-approve-id-response, patch-v3-scopes-requests-approve-id-error>;

  /// Retrieve all teammates
  record get-v3-teammates-params {
    /// Number of items to return
    limit: option<s32>,
    /// Paging offset
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-v3-teammates: func(params: get-v3-teammates-params) -> result<get-v3-teammates-response, string>;

  /// Invite teammate
  record post-v3-teammates-params {
    on-behalf-of: option<string>,
    /// New teammate's email
    email: string,
    /// Set to true if teammate should be an admin user
    is-admin: bool,
    /// Set to specify list of scopes that teammate should have. Should be empty if teammate is an admin.
    scopes: list<string>
  }
  post-v3-teammates: func(params: post-v3-teammates-params) -> result<post-v3-teammates-response, post-v3-teammates-error>;

  /// Retrieve all pending teammates
  record get-v3-teammates-pending-params {
    on-behalf-of: option<string>
  }
  get-v3-teammates-pending: func(params: get-v3-teammates-pending-params) -> result<get-v3-teammates-pending-response, string>;

  /// Delete pending teammate
  record delete-v3-teammates-pending-token-params {
    /// The token for the invite you want to delete.
    token: string,
    on-behalf-of: option<string>
  }
  delete-v3-teammates-pending-token: func(params: delete-v3-teammates-pending-token-params) -> result<string, delete-v3-teammates-pending-token-error>;

  /// Resend teammate invite
  record post-v3-teammates-pending-token-resend-params {
    /// The token for the invite that you want to resend.
    token: string,
    on-behalf-of: option<string>
  }
  post-v3-teammates-pending-token-resend: func(params: post-v3-teammates-pending-token-resend-params) -> result<post-v3-teammates-pending-token-resend-response, post-v3-teammates-pending-token-resend-error>;

  /// Retrieve specific teammate
  record get-v3-teammates-username-params {
    /// The username of the teammate that you want to retrieve.
    username: string,
    on-behalf-of: option<string>
  }
  get-v3-teammates-username: func(params: get-v3-teammates-username-params) -> result<get-v3-teammates-username-response, string>;

  /// Update teammate's permissions
  record patch-v3-teammates-username-params {
    /// The username of the teammate that you want to retrieve.
    username: string,
    on-behalf-of: option<string>,
    /// Set to True if this teammate should be promoted to an admin user. If True, scopes should be an empty array.
    is-admin: bool,
    /// Provide list of scopes that should be given to teammate. If specifying list of scopes, is_admin should be set to False.
    scopes: list<string>
  }
  patch-v3-teammates-username: func(params: patch-v3-teammates-username-params) -> result<patch-v3-teammates-username-response, patch-v3-teammates-username-error>;

  /// Delete teammate
  record delete-v3-teammates-username-params {
    /// The username of the teammate that you want to retrieve.
    username: string,
    on-behalf-of: option<string>
  }
  delete-v3-teammates-username: func(params: delete-v3-teammates-username-params) -> result<delete-v3-teammates-username-response, delete-v3-teammates-username-error>;

}

interface sender-identities-api {
  record get-v3-senders-response {
    result-op: option<list<sender-id>>
  }

  record sender-id {
    /// The physical address of the sender identity.
    address: option<string>,
    /// Additional sender identity address information.
    address-v2: option<string>,
    /// The city of the sender identity.
    city: option<string>,
    /// The country of the sender identity.
    country: option<string>,
    from-op: option<sender-id-from-op>,
    /// A nickname for the sender identity. Not used for sending.
    nickname: option<string>,
    reply-to: option<sender-id-reply-to>,
    /// The state of the sender identity.
    state: option<string>,
    /// The zipcode of the sender identity.
    zip: option<string>,
    /// The time the sender identity was created.
    created-at: option<s32>,
    /// The unique identifier of the sender identity.
    id: option<s32>,
    /// True when the sender id is associated to a campaign in the Draft, Scheduled, or In Progress status. You cannot update or delete a locked sender identity.
    locked: option<bool>,
    /// The time the sender identity was last updated.
    updated-at: option<s32>,
    /// If the sender identity is verified or not. Only verified sender identities can be used to send email.
    verified: option<bool>
  }

  record sender-id-from-op {
    /// The email address from which your recipient will receive emails.
    email: option<string>,
    /// The name appended to the from email field. Typically your name or company name.
    name: option<string>
  }

  record sender-id-reply-to {
    /// The email address to which your recipient will reply.
    email: option<string>,
    /// The name appended to the reply to email field. Typically your name or company name.
    name: option<string>
  }

  record post-senders-body-from-op {
    /// The email address from which your recipient will receive emails.
    email: option<string>,
    /// The name appended to the from email field. Typically your name or company name.
    name: option<string>
  }

  record post-senders-body-reply-to {
    /// The email address to which your recipient will reply.
    email: option<string>,
    /// The name appended to the reply to email field. Typically your name or company name.
    name: option<string>
  }

  record sender-id-request-from-op {
    /// The email address from which your recipient will receive emails.
    email: option<string>,
    /// The name appended to the from email field. Typically your name or company name.
    name: option<string>
  }

  record sender-id-request-reply-to {
    /// The email address to which your recipient will reply.
    email: option<string>,
    /// The name appended to the reply to email field. Typically your name or company name.
    name: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-v3-senders-sender-id-response-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-v3-senders-sender-id-resend-verification-response-entry {
    key: string,
    value: string
  }

  variant post-senders-error {
    bad-request(string),
    other(string)
  }

  variant get-v3-senders-sender-id-error {
    not-found(string),
    other(string)
  }

  variant patch-v3-senders-sender-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-v3-senders-sender-id-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant post-v3-senders-sender-id-resend-verification-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  /// Get all Sender Identities
  record get-v3-senders-params {
    on-behalf-of: option<string>
  }
  get-v3-senders: func(params: get-v3-senders-params) -> result<get-v3-senders-response, string>;

  /// Create a Sender Identity
  record post-senders-params {
    on-behalf-of: option<string>,
    /// The physical address of the sender identity.
    address: option<string>,
    /// Additional sender identity address information.
    address-v2: option<string>,
    /// The city of the sender identity.
    city: option<string>,
    /// The country of the sender identity.
    country: option<string>,
    from-op: option<post-senders-body-from-op>,
    /// A nickname for the sender identity. Not used for sending.
    nickname: option<string>,
    reply-to: option<post-senders-body-reply-to>,
    /// The state of the sender identity.
    state: option<string>,
    /// The zipcode of the sender identity.
    zip: option<string>
  }
  post-senders: func(params: post-senders-params) -> result<sender-id, post-senders-error>;

  /// View a Sender Identity
  record get-v3-senders-sender-id-params {
    /// The ID of the sender identity that you want to retrieve.
    sender-id: string,
    on-behalf-of: option<string>
  }
  get-v3-senders-sender-id: func(params: get-v3-senders-sender-id-params) -> result<sender-id, get-v3-senders-sender-id-error>;

  /// Update a Sender Identity
  record patch-v3-senders-sender-id-params {
    /// The ID of the sender identity that you want to retrieve.
    sender-id: string,
    on-behalf-of: option<string>,
    /// The physical address of the sender identity.
    address: option<string>,
    /// Additional sender identity address information.
    address-v2: option<string>,
    /// The city of the sender identity.
    city: option<string>,
    /// The country of the sender identity.
    country: option<string>,
    from-op: option<sender-id-request-from-op>,
    /// A nickname for the sender identity. Not used for sending.
    nickname: option<string>,
    reply-to: option<sender-id-request-reply-to>,
    /// The state of the sender identity.
    state: option<string>,
    /// The zipcode of the sender identity.
    zip: option<string>
  }
  patch-v3-senders-sender-id: func(params: patch-v3-senders-sender-id-params) -> result<sender-id, patch-v3-senders-sender-id-error>;

  /// Delete a Sender Identity
  record delete-v3-senders-sender-id-params {
    /// The ID of the sender identity that you want to retrieve.
    sender-id: string,
    on-behalf-of: option<string>
  }
  delete-v3-senders-sender-id: func(params: delete-v3-senders-sender-id-params) -> result<list<delete-v3-senders-sender-id-response-entry>, delete-v3-senders-sender-id-error>;

  /// Resend Sender Identity Verification
  record post-v3-senders-sender-id-resend-verification-params {
    /// The ID of the sender identity for which you would like to resend a verification email.
    sender-id: string,
    on-behalf-of: option<string>
  }
  post-v3-senders-sender-id-resend-verification: func(params: post-v3-senders-sender-id-resend-verification-params) -> result<list<post-v3-senders-sender-id-resend-verification-response-entry>, post-v3-senders-sender-id-resend-verification-error>;

}

interface certificates {
  record sso-certificate-body {
    /// A unique ID assigned to the certificate by SendGrid.
    id: option<f64>,
    /// An ID that matches a certificate to a specific IdP integration.
    intergration-id: option<string>,
    /// A unix timestamp (e.g., 1603915954) that indicates the time after which the certificate is no longer valid.
    not-after: option<f64>,
    /// A unix timestamp (e.g., 1603915954) that indicates the time before which the certificate is not valid.
    not-before: option<f64>,
    /// This certificate is used by Twilio SendGrid to verify that SAML requests are coming from Okta. This is called the X509 certificate in the Twilio SendGrid UI.
    public-certificate: option<string>
  }

  variant post-sso-certificates-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-sso-certificates-cert-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-sso-certificates-cert-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-sso-certificates-cert-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-sso-integrations-integration-id-certificates-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// Create an SSO Certificate
  record post-sso-certificates-params {
    /// Indicates if the certificate is enabled.
    enabled: option<bool>,
    /// An ID that matches a certificate to a specific IdP integration. This is the `id` returned by the "Get All SSO Integrations" endpoint.
    integration-id: string,
    /// This public certificate allows SendGrid to verify that SAML requests it receives are signed by an IdP that it recognizes.
    public-certificate: string
  }
  post-sso-certificates: func(params: post-sso-certificates-params) -> result<sso-certificate-body, post-sso-certificates-error>;

  /// Get an SSO Certificate
  record get-sso-certificates-cert-id-params {
    cert-id: string
  }
  get-sso-certificates-cert-id: func(params: get-sso-certificates-cert-id-params) -> result<sso-certificate-body, get-sso-certificates-cert-id-error>;

  /// Update SSO Certificate
  record patch-sso-certificates-cert-id-params {
    cert-id: string,
    /// Indicates whether or not the certificate is enabled.
    enabled: option<bool>,
    /// An ID that matches a certificate to a specific IdP integration.
    integration-id: option<string>,
    /// This public certificate allows SendGrid to verify that SAML requests it receives are signed by an IdP that it recognizes.
    public-certificate: option<string>
  }
  patch-sso-certificates-cert-id: func(params: patch-sso-certificates-cert-id-params) -> result<string, patch-sso-certificates-cert-id-error>;

  /// Delete an SSO Certificate
  record delete-sso-certificates-cert-id-params {
    cert-id: string
  }
  delete-sso-certificates-cert-id: func(params: delete-sso-certificates-cert-id-params) -> result<sso-certificate-body, delete-sso-certificates-cert-id-error>;

  /// Get All SSO Certificates by Integration
  record get-sso-integrations-integration-id-certificates-params {
    /// An ID that matches a certificate to a specific IdP integration.
    integration-id: string
  }
  get-sso-integrations-integration-id-certificates: func(params: get-sso-integrations-integration-id-certificates-params) -> result<list<sso-certificate-body>, get-sso-integrations-integration-id-certificates-error>;

}

interface single-sign-on-settings {
  record sso-integration {
    /// Indicates if the integration is complete.
    completed-integration: option<bool>,
    /// Indicates if the integration is enabled.
    enabled: bool,
    /// An identifier provided by your IdP to identify Twilio SendGrid in the SAML interaction. This is called the "SAML Issuer ID" in the Twilio SendGrid UI.
    entity-id: string,
    /// The name of your integration. This name can be anything that makes sense for your organization (eg. Twilio SendGrid)
    name: string,
    /// The IdP's SAML POST endpoint. This endpoint should receive requests and initiate an SSO login flow. This is called the "Embed Link" in the Twilio SendGrid UI.
    signin-url: string,
    /// This URL is relevant only for an IdP-initiated authentication flow. If a user authenticates from their IdP, this URL will return them to their IdP when logging out.
    signout-url: string,
    /// The URL where your IdP should POST its SAML response. This is the Twilio SendGrid URL that is responsible for receiving and parsing a SAML assertion. This is the same URL as the Single Sign-On URL when using SendGrid.
    audience-url: option<string>,
    /// A unique ID assigned to the configuration by SendGrid.
    id: option<string>,
    /// A timestamp representing the last time the configuration was modified.
    last-updated: f64,
    /// The URL where your IdP should POST its SAML response. This is the Twilio SendGrid URL that is responsible for receiving and parsing a SAML assertion. This is the same URL as the Audience URL when using SendGrid.
    single-signon-url: option<string>
  }

  variant get-sso-integrations-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant post-sso-integrations-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-sso-integrations-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-sso-integrations-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-sso-integrations-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// Get All SSO Integrations
  record get-sso-integrations-params {
    /// If this parameter is set to `true`, the response will include the `completed_integration` field.
    si: option<bool>
  }
  get-sso-integrations: func(params: get-sso-integrations-params) -> result<list<sso-integration>, get-sso-integrations-error>;

  /// Create an SSO Integration
  record post-sso-integrations-params {
    /// Indicates if the integration is complete.
    completed-integration: option<bool>,
    /// Indicates if the integration is enabled.
    enabled: bool,
    /// An identifier provided by your IdP to identify Twilio SendGrid in the SAML interaction. This is called the "SAML Issuer ID" in the Twilio SendGrid UI.
    entity-id: string,
    /// The name of your integration. This name can be anything that makes sense for your organization (eg. Twilio SendGrid)
    name: string,
    /// The IdP's SAML POST endpoint. This endpoint should receive requests and initiate an SSO login flow. This is called the "Embed Link" in the Twilio SendGrid UI.
    signin-url: string,
    /// This URL is relevant only for an IdP-initiated authentication flow. If a user authenticates from their IdP, this URL will return them to their IdP when logging out.
    signout-url: string
  }
  post-sso-integrations: func(params: post-sso-integrations-params) -> result<sso-integration, post-sso-integrations-error>;

  /// Get an SSO Integration
  record get-sso-integrations-id-params {
    id: string,
    /// If this parameter is set to `true`, the response will include the `completed_integration` field.
    si: option<bool>
  }
  get-sso-integrations-id: func(params: get-sso-integrations-id-params) -> result<sso-integration, get-sso-integrations-id-error>;

  /// Update an SSO Integration
  record patch-sso-integrations-id-params {
    id: string,
    /// If this parameter is set to `true`, the response will include the `completed_integration` field.
    si: option<bool>,
    /// Indicates if the integration is complete.
    completed-integration: option<bool>,
    /// Indicates if the integration is enabled.
    enabled: bool,
    /// An identifier provided by your IdP to identify Twilio SendGrid in the SAML interaction. This is called the "SAML Issuer ID" in the Twilio SendGrid UI.
    entity-id: string,
    /// The name of your integration. This name can be anything that makes sense for your organization (eg. Twilio SendGrid)
    name: string,
    /// The IdP's SAML POST endpoint. This endpoint should receive requests and initiate an SSO login flow. This is called the "Embed Link" in the Twilio SendGrid UI.
    signin-url: string,
    /// This URL is relevant only for an IdP-initiated authentication flow. If a user authenticates from their IdP, this URL will return them to their IdP when logging out.
    signout-url: string
  }
  patch-sso-integrations-id: func(params: patch-sso-integrations-id-params) -> result<sso-integration, patch-sso-integrations-id-error>;

  /// Delete an SSO Integration
  record delete-sso-integrations-id-params {
    id: string
  }
  delete-sso-integrations-id: func(params: delete-sso-integrations-id-params) -> result<string, delete-sso-integrations-id-error>;

}

interface single-sign-on-teammates {
  enum sso-teammates-patch-response-user-type-enum {
    admin,
    owner,
    teammate,
  }

  record sso-teammate-response {
    /// The Teammate’s email address. This email address will also function as the Teammate’s username and must match the address assigned to the user in your IdP. This address cannot be changed after the Teammate is created.
    email: string,
    /// The Teammate’s first name.
    first-name: string,
    /// Indicates if the Teammate has admin permissions.
    is-admin: option<bool>,
    /// Indicates if the Teammate has read_only permissions.
    is-read-only: option<bool>,
    /// The Teammate’s last name.
    last-name: string,
    /// Indicates if the Teammate authenticates with SendGrid using SSO or with a username and password.
    is-sso: option<bool>,
    /// This should be set to the Teammate's email address.
    username: option<string>
  }

  record sso-teammates-patch-response {
    /// The Teammate’s email address. This email address will also function as the Teammate’s username and must match the address assigned to the user in your IdP. This address cannot be changed after the Teammate is created.
    email: string,
    /// The Teammate’s first name.
    first-name: string,
    /// Indicates if the Teammate has admin permissions.
    is-admin: option<bool>,
    /// Indicates if the Teammate has read_only permissions.
    is-read-only: option<bool>,
    /// The Teammate’s last name.
    last-name: string,
    /// Indicates if the Teammate authenticates with SendGrid using SSO or with a username and password.
    is-sso: option<bool>,
    /// This should be set to the Teammate's email address.
    username: option<string>,
    /// The Teammate’s street address.
    address: option<string>,
    /// The Teammate’s apartment number, suite number, or other secondary address information that is not part of the physical street address.
    address2: option<string>,
    /// The Teammate's city.
    city: option<string>,
    /// The Teammate’s company name.
    company: option<string>,
    /// The Teammate’s country of residence.
    country: option<string>,
    /// The Teammate’s stored phone number.
    phone: option<string>,
    /// The permission scopes assigned to the Teammate.
    scopes: option<list<string>>,
    /// The Teammate’s state or province.
    state: option<string>,
    /// A Teammate can be an “admin,” “owner,” or “teammate.” Each role is associated with the scope of the Teammate’s permissions.
    user-type: option<sso-teammates-patch-response-user-type-enum>,
    /// A website associated with the Teammate
    website: option<string>,
    /// The Teammate’s zip code.
    zip: option<string>
  }

  variant post-sso-teammates-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-sso-teammates-username-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// Create SSO Teammate
  record post-sso-teammates-params {
    /// The Teammate’s email address. This email address will also function as the Teammate’s username and must match the address assigned to the user in your IdP. This address cannot be changed after the Teammate is created.
    email: string,
    /// The Teammate’s first name.
    first-name: string,
    /// Indicates if the Teammate has admin permissions.
    is-admin: option<bool>,
    /// Indicates if the Teammate has read_only permissions.
    is-read-only: option<bool>,
    /// The Teammate’s last name.
    last-name: string,
    /// The permission scopes assigned to the Teammate.
    scopes: list<string>
  }
  post-sso-teammates: func(params: post-sso-teammates-params) -> result<sso-teammate-response, post-sso-teammates-error>;

  /// Edit an SSO Teammate
  record patch-sso-teammates-username-params {
    /// This email address must be the same address assigned to the teammate in your IdP
    username: string,
    first-name: option<string>,
    is-admin: option<bool>,
    last-name: option<string>,
    scopes: option<list<string>>
  }
  patch-sso-teammates-username: func(params: patch-sso-teammates-username-params) -> result<sso-teammates-patch-response, patch-sso-teammates-username-error>;

}

interface subusers-api {
  record subuser {
    /// Whether or not the user is enabled or disabled.
    disabled: bool,
    /// The email address to contact this subuser.
    email: string,
    /// The ID of this subuser.
    id: f64,
    /// The name by which this subuser will be referred.
    username: string
  }

  record subuser-post {
    authorization-token: option<string>,
    credit-allocation: option<subuser-post-credit-allocation>,
    /// The email address for this subuser.
    email: string,
    signup-session-token: option<string>,
    /// The user ID for this subuser.
    user-id: f64,
    /// The username of the subuser.
    username: string
  }

  record subuser-post-credit-allocation {
    type-op: option<string>
  }

  record get-subusers-reputations-response-item {
    /// The sender reputation this subuser has attained.
    reputation: f64,
    /// The subuser that has this reputation.f
    username: string
  }

  /// one entry of a string-keyed map (free-form object)
  record patch-subusers-subuser-name-response-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-subusers-subuser-name-response-entry {
    key: string,
    value: string
  }

  record put-subusers-subuser-name-ips-response {
    /// The IP addresses that are assigned to the subuser.
    ips: option<list<string>>
  }

  variant get-subusers-error {
    unauthorized(string),
    other(string)
  }

  variant post-subusers-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    internal-server-error(string),
    other(string)
  }

  variant patch-subusers-subuser-name-error {
    bad-request(string),
    unauthorized(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-subusers-subuser-name-error {
    unauthorized(string),
    other(string)
  }

  variant put-subusers-subuser-name-ips-error {
    unauthorized(string),
    other(string)
  }

  /// List all Subusers
  record get-subusers-params {
    /// The username of this subuser.
    username: option<string>,
    /// The number of results you would like to get in each request.
    limit: option<s32>,
    /// The number of subusers to skip.
    offset: option<s32>
  }
  get-subusers: func(params: get-subusers-params) -> result<list<subuser>, get-subusers-error>;

  /// Create Subuser
  record post-subusers-params {
    /// The email address of the subuser.
    email: string,
    /// The IP addresses that should be assigned to this subuser.
    ips: list<string>,
    /// The password this subuser will use when logging into SendGrid.
    password: string,
    /// The username for this subuser.
    username: string
  }
  post-subusers: func(params: post-subusers-params) -> result<subuser-post, post-subusers-error>;

  /// Retrieve Subuser Reputations
  record get-subusers-reputations-params {
    usernames: option<string>
  }
  get-subusers-reputations: func(params: get-subusers-reputations-params) -> result<list<get-subusers-reputations-response-item>, string>;

  /// Enable/disable a subuser
  record patch-subusers-subuser-name-params {
    subuser-name: string,
    /// Whether or not this subuser is disabled. True means disabled, False means enabled.
    disabled: option<bool>
  }
  patch-subusers-subuser-name: func(params: patch-subusers-subuser-name-params) -> result<list<patch-subusers-subuser-name-response-entry>, patch-subusers-subuser-name-error>;

  /// Delete a subuser
  record delete-subusers-subuser-name-params {
    subuser-name: string
  }
  delete-subusers-subuser-name: func(params: delete-subusers-subuser-name-params) -> result<list<delete-subusers-subuser-name-response-entry>, delete-subusers-subuser-name-error>;

  /// Update IPs assigned to a subuser
  record put-subusers-subuser-name-ips-params {
    subuser-name: string,
    body: option<list<string>>
  }
  put-subusers-subuser-name-ips: func(params: put-subusers-subuser-name-ips-params) -> result<put-subusers-subuser-name-ips-response, put-subusers-subuser-name-ips-error>;

}

interface subuser-statistics {
  enum get-subusers-stats-aggregated-by-enum {
    day,
    week,
    month,
  }

  enum get-subusers-stats-monthly-sort-by-metric-enum {
    blocks,
    bounces,
    clicks,
    delivered,
    opens,
    requests,
    unique-clicks,
    unique-opens,
    unsubscribes,
  }

  enum get-subusers-stats-monthly-sort-by-direction-enum {
    desc,
    asc,
  }

  record category-stats {
    /// The date the statistics were gathered.
    date: string,
    stats: option<list<category-stats-stats-item>>
  }

  record category-stats-stats-item {
    metrics: option<category-stats-stats-item-metrics>,
    /// The name of the category.
    name: option<string>,
    /// How you are segmenting your statistics.
    type-op: string
  }

  record category-stats-stats-item-metrics {
    /// The number of emails that were not allowed to be delivered by ISPs.
    blocks: s32,
    /// The number of emails that were dropped because of a bounce.
    bounce-drops: s32,
    /// The number of emails that bounced instead of being delivered.
    bounces: s32,
    /// The number of links that were clicked.
    clicks: s32,
    /// The number of emails that temporarily could not be delivered.
    deferred: s32,
    /// The number of emails SendGrid was able to confirm were actually delivered to a recipient.
    delivered: s32,
    /// The number of recipients who had malformed email addresses or whose mail provider reported the address as invalid.
    invalid-emails: s32,
    /// The total number of times your emails were opened by recipients.
    opens: s32,
    /// Requests from your website, application, or mail client via SMTP Relay or the API that SendGrid processed.
    processed: s32,
    /// The number of emails that were requested to be delivered.
    requests: s32,
    /// The number of emails that were dropped due to a recipient previously marking your emails as spam.
    spam-report-drops: s32,
    /// The number of recipients who marked your email as spam.
    spam-reports: s32,
    /// The number of unique recipients who clicked links in your emails.
    unique-clicks: s32,
    /// The number of unique recipients who opened your emails.
    unique-opens: s32,
    /// The number of emails dropped due to a recipient unsubscribing from your emails.
    unsubscribe-drops: s32,
    /// The number of recipients who unsubscribed from your emails.
    unsubscribes: s32
  }

  record subuser-stats {
    /// The date the statistics were gathered.
    date: option<string>,
    /// The list of statistics.
    stats: option<list<subuser-stats-stats-item>>
  }

  record subuser-stats-stats-item {
    /// The first name of the subuser.
    first-name: option<string>,
    /// The last name of the subuser.
    last-name: option<string>,
    metrics: option<subuser-stats-stats-item-metrics>,
    /// The username of the subuser.
    name: option<string>,
    /// The type of account.
    type-op: option<string>
  }

  record subuser-stats-stats-item-metrics {
    /// The number of emails that were not allowed to be delivered by ISPs.
    blocks: option<s32>,
    /// The number of emails that were dropped because of a bounce.
    bounce-drops: option<s32>,
    /// The number of emails that bounced instead of being delivered.
    bounces: option<s32>,
    /// The number of links that were clicked in your emails.
    clicks: option<s32>,
    /// The number of emails that temporarily could not be delivered.
    deferred: option<s32>,
    /// The number of emails SendGrid was able to confirm were actually delivered to a recipient.
    delivered: option<s32>,
    /// The number of recipients who had malformed email addresses or whose mail provider reported the address as invalid.
    invalid-emails: option<s32>,
    /// The total number of times your emails were opened by recipients.
    opens: option<s32>,
    /// Requests from your website, application, or mail client via SMTP Relay or the API that SendGrid processed.
    processed: option<s32>,
    /// The number of emails that were requested to be delivered.
    requests: option<s32>,
    /// The number of emails that were dropped due to a recipient previously marking your emails as spam.
    spam-report-drops: option<s32>,
    /// The number of recipients who marked your email as spam.
    spam-reports: option<s32>,
    /// The number of unique recipients who clicked links in your emails.
    unique-clicks: option<s32>,
    /// The number of unique recipients who opened your emails.
    unique-opens: option<s32>,
    /// The number of emails dropped due to a recipient unsubscribing from your emails.
    unsubscribe-drops: option<s32>,
    /// The number of recipients who unsubscribed from your emails.
    unsubscribes: option<s32>
  }

  /// Retrieve email statistics for your subusers.
  record get-subusers-stats-params {
    /// Limits the number of results returned per page.
    limit: option<s32>,
    /// The point in the list to begin retrieving results from.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-subusers-stats-aggregated-by-enum>,
    /// The subuser you want to retrieve statistics for. You may include this parameter up to 10 times to retrieve statistics for multiple subusers.
    subusers: string,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today.
    end-date: option<string>
  }
  get-subusers-stats: func(params: get-subusers-stats-params) -> result<category-stats, string>;

  /// Retrieve monthly stats for all subusers
  record get-subusers-stats-monthly-params {
    /// The date of the month to retrieve statistics for. Must be formatted YYYY-MM-DD
    date: string,
    /// A substring search of your subusers.
    subuser: option<string>,
    /// The metric that you want to sort by. Metrics that you can sort by are: `blocks`, `bounces`, `clicks`, `delivered`, `opens`, `requests`, `unique_clicks`, `unique_opens`, and `unsubscribes`.'
    sort-by-metric: option<get-subusers-stats-monthly-sort-by-metric-enum>,
    /// The direction you want to sort.
    sort-by-direction: option<get-subusers-stats-monthly-sort-by-direction-enum>,
    /// Optional field to limit the number of results returned.
    limit: option<s32>,
    /// Optional beginning point in the list to retrieve from.
    offset: option<s32>
  }
  get-subusers-stats-monthly: func(params: get-subusers-stats-monthly-params) -> result<subuser-stats, string>;

  /// Retrieve the totals for each email statistic metric for all subusers.
  record get-subusers-stats-sums-params {
    /// The direction you want to sort. 
    sort-by-direction: option<get-subusers-stats-monthly-sort-by-direction-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// Limits the number of results returned per page.
    limit: option<s32>,
    /// The point in the list to begin retrieving results from.
    offset: option<s32>,
    /// How to group the statistics. Defaults to today. Must follow format YYYY-MM-DD.
    aggregated-by: option<string>,
    /// The metric that you want to sort by.  Must be a single metric.
    sort-by-metric: option<string>
  }
  get-subusers-stats-sums: func(params: get-subusers-stats-sums-params) -> result<category-stats, string>;

  /// Retrieve the monthly email statistics for a single subuser
  record get-subusers-subuser-name-stats-monthly-params {
    subuser-name: string,
    /// The date of the month to retrieve statistics for. Must be formatted YYYY-MM-DD
    date: string,
    /// The metric that you want to sort by. Metrics that you can sort by are: `blocks`, `bounces`, `clicks`, `delivered`, `opens`, `requests`, `unique_clicks`, `unique_opens`, and `unsubscribes`.'
    sort-by-metric: option<string>,
    /// The direction you want to sort.
    sort-by-direction: option<get-subusers-stats-monthly-sort-by-direction-enum>,
    /// Optional field to limit the number of results returned.
    limit: option<s32>,
    /// Optional beginning point in the list to retrieve from.
    offset: option<s32>
  }
  get-subusers-subuser-name-stats-monthly: func(params: get-subusers-subuser-name-stats-monthly-params) -> result<subuser-stats, string>;

}

interface subuser-monitor-settings {
  record monitor {
    /// The email address to which Sendgrid should send emails for monitoring.
    email: string,
    /// The frequency at which to forward monitoring emails. An email will be sent when your subuser sends this many (e.g., 1,000) emails.
    frequency: f64
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-subusers-subuser-name-monitor-response-entry {
    key: string,
    value: string
  }

  variant get-subusers-subuser-name-monitor-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant post-subusers-subuser-name-monitor-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant put-subusers-subuser-name-monitor-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-subusers-subuser-name-monitor-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Retrieve monitor settings for a subuser
  record get-subusers-subuser-name-monitor-params {
    /// The name of the subuser for which to retrieve monitor settings.
    subuser-name: string
  }
  get-subusers-subuser-name-monitor: func(params: get-subusers-subuser-name-monitor-params) -> result<monitor, get-subusers-subuser-name-monitor-error>;

  /// Create monitor settings
  record post-subusers-subuser-name-monitor-params {
    /// The name of the subuser for which to retrieve monitor settings.
    subuser-name: string,
    /// The email address to which Sendgrid should send emails for monitoring.
    email: string,
    /// The frequency at which to forward monitoring emails. An email will be sent when your subuser sends this many (e.g., 1,000) emails.
    frequency: f64
  }
  post-subusers-subuser-name-monitor: func(params: post-subusers-subuser-name-monitor-params) -> result<monitor, post-subusers-subuser-name-monitor-error>;

  /// Update Monitor Settings for a subuser
  record put-subusers-subuser-name-monitor-params {
    /// The name of the subuser for which to retrieve monitor settings.
    subuser-name: string,
    /// The email address to which Sendgrid should send emails for monitoring.
    email: string,
    /// The frequency at which to forward monitoring emails. An email will be sent when your subuser sends this many (e.g., 1,000) emails.
    frequency: f64
  }
  put-subusers-subuser-name-monitor: func(params: put-subusers-subuser-name-monitor-params) -> result<monitor, put-subusers-subuser-name-monitor-error>;

  /// Delete monitor settings
  record delete-subusers-subuser-name-monitor-params {
    /// The name of the subuser for which to retrieve monitor settings.
    subuser-name: string
  }
  delete-subusers-subuser-name-monitor: func(params: delete-subusers-subuser-name-monitor-params) -> result<list<delete-subusers-subuser-name-monitor-response-entry>, delete-subusers-subuser-name-monitor-error>;

}

interface blocks-api {
  record blocks-response-item {
    /// A Unix timestamp indicating when the email address was added to the blocks list.
    created: s32,
    /// The email address that was added to the block list.
    email: string,
    /// An explanation for the reason of the block.
    reason: string,
    /// The status of the block.
    status: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-suppression-blocks-response-entry {
    key: string,
    value: string
  }

  record blocks-response-item-v2 {
    /// A Unix timestamp indicating when the email address was added to the blocks list.
    created: s32,
    /// The email address that was added to the block list.
    email: string,
    /// An explanation for the reason of the block.
    reason: string,
    /// The status of the block.
    status: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-suppression-blocks-email-response-entry {
    key: string,
    value: string
  }

  /// Retrieve all blocks
  record get-suppression-blocks-params {
    /// The start of the time range when a blocked email was created (inclusive). This is a unix timestamp.
    start-time: option<s32>,
    /// The end of the time range when a blocked email was created (inclusive). This is a unix timestamp.
    end-time: option<s32>,
    /// Limit the number of results to be displayed per page.
    limit: option<s32>,
    /// The point in the list to begin displaying results.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-suppression-blocks: func(params: get-suppression-blocks-params) -> result<list<blocks-response-item>, string>;

  /// Delete blocks
  record delete-suppression-blocks-params {
    on-behalf-of: option<string>,
    /// Indicates if you want to delete all blocked email addresses.
    delete-all: option<bool>,
    /// The specific blocked email addresses that you want to delete.
    emails: option<list<string>>
  }
  delete-suppression-blocks: func(params: delete-suppression-blocks-params) -> result<list<delete-suppression-blocks-response-entry>, string>;

  /// Retrieve a specific block
  record get-suppression-blocks-email-params {
    /// The email address of the specific block.
    email: string,
    on-behalf-of: option<string>
  }
  get-suppression-blocks-email: func(params: get-suppression-blocks-email-params) -> result<list<blocks-response-item-v2>, string>;

  /// Delete a specific block
  record delete-suppression-blocks-email-params {
    /// The email address of the specific block.
    email: string,
    on-behalf-of: option<string>
  }
  delete-suppression-blocks-email: func(params: delete-suppression-blocks-email-params) -> result<list<delete-suppression-blocks-email-response-entry>, string>;

}

interface bounces-api {
  record bounce-response {
    /// The unix timestamp for when the bounce record was created at SendGrid.
    created: option<f64>,
    /// The email address that was added to the bounce list.
    email: option<string>,
    /// The reason for the bounce. This typically will be a bounce code, an enhanced code, and a description.
    reason: option<string>,
    /// Enhanced SMTP bounce response
    status: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-suppression-bounces-email-response-entry {
    key: string,
    value: string
  }

  variant get-suppression-bounces-error {
    unauthorized(string),
    other(string)
  }

  variant delete-suppression-bounces-error {
    unauthorized(string),
    other(string)
  }

  variant delete-suppression-bounces-email-error {
    unauthorized(string),
    other(string)
  }

  /// Retrieve all bounces
  record get-suppression-bounces-params {
    /// Refers start of the time range in unix timestamp when a bounce was created (inclusive).
    start-time: option<s32>,
    /// Refers end of the time range in unix timestamp when a bounce was created (inclusive).
    end-time: option<s32>,
    accept: string,
    on-behalf-of: option<string>
  }
  get-suppression-bounces: func(params: get-suppression-bounces-params) -> result<list<bounce-response>, get-suppression-bounces-error>;

  /// Delete bounces
  record delete-suppression-bounces-params {
    on-behalf-of: option<string>,
    /// This parameter allows you to delete **every** email in your bounce list. This should not be used with the emails parameter.
    delete-all: option<bool>,
    /// Delete multiple emails from your bounce list at the same time. This should not be used with the delete_all parameter.
    emails: option<list<string>>
  }
  delete-suppression-bounces: func(params: delete-suppression-bounces-params) -> result<string, delete-suppression-bounces-error>;

  /// Retrieve a Bounce
  record get-suppression-bounces-email-params {
    email: string,
    on-behalf-of: option<string>
  }
  get-suppression-bounces-email: func(params: get-suppression-bounces-email-params) -> result<list<bounce-response>, string>;

  /// Delete a bounce
  record delete-suppression-bounces-email-params {
    email: string,
    /// The email address you would like to remove from the bounce list.
    email-address: string,
    on-behalf-of: option<string>,
    body: option<string>
  }
  delete-suppression-bounces-email: func(params: delete-suppression-bounces-email-params) -> result<list<delete-suppression-bounces-email-response-entry>, delete-suppression-bounces-email-error>;

}

interface invalid-emails-api {
  record invalid-email {
    /// A Unix timestamp indicating when the email address was added to the invalid emails list.
    created: option<s32>,
    /// The email address that was marked as invalid.
    email: option<string>,
    /// The reason that the email address was marked as invalid.
    reason: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-suppression-invalid-emails-response-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-suppression-invalid-emails-email-response-entry {
    key: string,
    value: string
  }

  /// Retrieve all invalid emails
  record get-suppression-invalid-emails-params {
    /// Refers start of the time range in unix timestamp when an invalid email was created (inclusive).
    start-time: option<s32>,
    /// Refers end of the time range in unix timestamp when an invalid email was created (inclusive).
    end-time: option<s32>,
    /// Limit the number of results to be displayed per page.
    limit: option<s32>,
    /// Paging offset. The point in the list to begin displaying results.
    offset: option<s32>,
    on-behalf-of: option<string>
  }
  get-suppression-invalid-emails: func(params: get-suppression-invalid-emails-params) -> result<list<invalid-email>, string>;

  /// Delete invalid emails
  record delete-suppression-invalid-emails-params {
    on-behalf-of: option<string>,
    /// Indicates if you want to remove all email address from the invalid emails list.
    delete-all: option<bool>,
    /// The list of specific email addresses that you want to remove.
    emails: option<list<string>>
  }
  delete-suppression-invalid-emails: func(params: delete-suppression-invalid-emails-params) -> result<list<delete-suppression-invalid-emails-response-entry>, string>;

  /// Retrieve a specific invalid email
  record get-suppression-invalid-emails-email-params {
    /// The specific email address of the invalid email entry that you want to retrieve.
    email: string,
    on-behalf-of: option<string>
  }
  get-suppression-invalid-emails-email: func(params: get-suppression-invalid-emails-email-params) -> result<list<invalid-email>, string>;

  /// Delete a specific invalid email
  record delete-suppression-invalid-emails-email-params {
    /// The specific email address of the invalid email entry that you want to retrieve.
    email: string,
    on-behalf-of: option<string>
  }
  delete-suppression-invalid-emails-email: func(params: delete-suppression-invalid-emails-email-params) -> result<list<delete-suppression-invalid-emails-email-response-entry>, string>;

}

interface spam-reports-api {
  record spam-reports-response-item {
    /// A Unix timestamp that indicates when the recipient marked your message as spam.
    created: s32,
    /// The email address of the recipient that marked your message as spam.
    email: string,
    /// The IP address that the message was sent from.
    ip: string
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-suppression-spam-reports-response-entry {
    key: string,
    value: string
  }

  record spam-reports-response-item-v2 {
    /// A Unix timestamp that indicates when the recipient marked your message as spam.
    created: s32,
    /// The email address of the recipient that marked your message as spam.
    email: string,
    /// The IP address that the message was sent from.
    ip: string
  }

  /// one entry of a string-keyed map (free-form object)
