  }
  post-v3-senders-sender-id-resend-verification: func(params: post-v3-senders-sender-id-resend-verification-params) -> result<string, string>;

}

interface certificates {
  /// Create an SSO Certificate
  record post-sso-certificates-params {
    /// Indicates if the certificate is enabled.
    enabled: option<bool>,
    /// An ID that matches a certificate to a specific IdP integration. This is the `id` returned by the "Get All SSO Integrations" endpoint.
    integration-id: string,
    /// This public certificate allows SendGrid to verify that SAML requests it receives are signed by an IdP that it recognizes.
    public-certificate: string
  }
  post-sso-certificates: func(params: post-sso-certificates-params) -> result<string, string>;

  /// Get an SSO Certificate
  get-sso-certificates-cert-id: func() -> result<string, string>;

  /// Update SSO Certificate
  record patch-sso-certificates-cert-id-params {
    /// Indicates whether or not the certificate is enabled.
    enabled: option<bool>,
    /// An ID that matches a certificate to a specific IdP integration.
    integration-id: option<string>,
    /// This public certificate allows SendGrid to verify that SAML requests it receives are signed by an IdP that it recognizes.
    public-certificate: option<string>
  }
  patch-sso-certificates-cert-id: func(params: patch-sso-certificates-cert-id-params) -> result<string, string>;

  /// Delete an SSO Certificate
  delete-sso-certificates-cert-id: func() -> result<string, string>;

  /// Get All SSO Certificates by Integration
  get-sso-integrations-integration-id-certificates: func() -> result<string, string>;

}

interface single-sign-on-settings {
  /// Get All SSO Integrations
  record get-sso-integrations-params {
    /// If this parameter is set to `true`, the response will include the `completed_integration` field.
    si: option<bool>
  }
  get-sso-integrations: func(params: get-sso-integrations-params) -> result<string, string>;

  /// Create an SSO Integration
  record post-sso-integrations-params {
    /// Indicates if the integration is complete.
    completed-integration: option<bool>,
    /// Indicates if the integration is enabled.
    enabled: bool,
    /// An identifier provided by your IdP to identify Twilio SendGrid in the SAML interaction. This is called the "SAML Issuer ID" in the Twilio SendGrid UI.
    entity-id: string,
    /// The name of your integration. This name can be anything that makes sense for your organization (eg. Twilio SendGrid)
    name: string,
    /// The IdP's SAML POST endpoint. This endpoint should receive requests and initiate an SSO login flow. This is called the "Embed Link" in the Twilio SendGrid UI.
    signin-url: string,
    /// This URL is relevant only for an IdP-initiated authentication flow. If a user authenticates from their IdP, this URL will return them to their IdP when logging out.
    signout-url: string
  }
  post-sso-integrations: func(params: post-sso-integrations-params) -> result<string, string>;

  /// Get an SSO Integration
  record get-sso-integrations-id-params {
    /// If this parameter is set to `true`, the response will include the `completed_integration` field.
    si: option<bool>
  }
  get-sso-integrations-id: func(params: get-sso-integrations-id-params) -> result<string, string>;

  /// Update an SSO Integration
  record patch-sso-integrations-id-params {
    /// If this parameter is set to `true`, the response will include the `completed_integration` field.
    si: option<bool>,
    /// Indicates if the integration is complete.
    completed-integration: option<bool>,
    /// Indicates if the integration is enabled.
    enabled: bool,
    /// An identifier provided by your IdP to identify Twilio SendGrid in the SAML interaction. This is called the "SAML Issuer ID" in the Twilio SendGrid UI.
    entity-id: string,
    /// The name of your integration. This name can be anything that makes sense for your organization (eg. Twilio SendGrid)
    name: string,
    /// The IdP's SAML POST endpoint. This endpoint should receive requests and initiate an SSO login flow. This is called the "Embed Link" in the Twilio SendGrid UI.
    signin-url: string,
    /// This URL is relevant only for an IdP-initiated authentication flow. If a user authenticates from their IdP, this URL will return them to their IdP when logging out.
    signout-url: string
  }
  patch-sso-integrations-id: func(params: patch-sso-integrations-id-params) -> result<string, string>;

  /// Delete an SSO Integration
  delete-sso-integrations-id: func() -> result<string, string>;

}

