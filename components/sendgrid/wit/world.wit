interface email-address-validation {
  enum post-validations-email-response-result-op-verdict-enum {
    valid,
    risky,
    invalid,
  }

  record post-validations-email-response {
    result-op: post-validations-email-response-result-op
  }

  record post-validations-email-response-result-op {
    /// Granular checks for email address validity.
    checks: post-validations-email-response-result-op-checks,
    /// The email being validated
    email: string,
    /// The domain of the email address.
    host: string,
    /// The IP address associated with this email.
    ip-address: string,
    /// The local part of the email address.
    local: string,
    /// A numeric representation of the email validity.
    score: f64,
    /// The source of the validation, as per the API request.
    source: option<string>,
    /// A suggested correction in the event of domain name typos (e.g., gmial.com)
    suggestion: option<string>,
    /// A generic classification of whether or not the email address is valid.
    verdict: post-validations-email-response-result-op-verdict-enum
  }

  /// Granular checks for email address validity.
  record post-validations-email-response-result-op-checks {
    /// Additional checks on the email address.
    additional: post-validations-email-response-result-op-checks-additional,
    /// Checks on the domain portion of the email address.
    domain: post-validations-email-response-result-op-checks-domain,
    /// Checks on the local part of the email address.
    local-part: post-validations-email-response-result-op-checks-local-part
  }

  /// Additional checks on the email address.
  record post-validations-email-response-result-op-checks-additional {
    /// WHether email sent to this address from your account has bounced.
    has-known-bounces: bool,
    /// Whether our model predicts that the email address might bounce.
    has-suspected-bounces: bool
  }

  /// Checks on the domain portion of the email address.
  record post-validations-email-response-result-op-checks-domain {
    /// Whether the email has appropriate DNS records to deliver a message. 
    has-mx-or-a-record: bool,
    /// Whether the email address syntax is valid.
    has-valid-address-syntax: bool,
    /// Whether the domain appears to be from a disposable email address service.
    is-suspected-disposable-address: bool
  }

  /// Checks on the local part of the email address.
  record post-validations-email-response-result-op-checks-local-part {
    /// Whether the local part of email appears to be a role or group (e.g., hr, admin)
    is-suspected-role-address: bool
  }

  /// Validate an email
  record post-validations-email-params {
    /// The email address that you want to validate.
    email: string,
    /// A one-word classifier for where this validation originated.
    source: option<string>
  }
  post-validations-email: func(params: post-validations-email-params) -> result<post-validations-email-response, string>;

}

