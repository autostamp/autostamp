interface subuser-statistics {
  enum get-subusers-stats-aggregated-by-enum {
    day,
    week,
    month,
  }

  enum get-subusers-stats-monthly-sort-by-metric-enum {
    blocks,
    bounces,
    clicks,
    delivered,
    opens,
    requests,
    unique-clicks,
    unique-opens,
    unsubscribes,
  }

  enum get-subusers-stats-monthly-sort-by-direction-enum {
    desc,
    asc,
  }

  /// Retrieve email statistics for your subusers.
  record get-subusers-stats-params {
    /// Limits the number of results returned per page.
    limit: option<s32>,
    /// The point in the list to begin retrieving results from.
    offset: option<s32>,
    /// How to group the statistics. Must be either "day", "week", or "month".
    aggregated-by: option<get-subusers-stats-aggregated-by-enum>,
    /// The subuser you want to retrieve statistics for. You may include this parameter up to 10 times to retrieve statistics for multiple subusers.
    subusers: string,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today.
    end-date: option<string>
  }
  get-subusers-stats: func(params: get-subusers-stats-params) -> result<string, string>;

  /// Retrieve monthly stats for all subusers
  record get-subusers-stats-monthly-params {
    /// The date of the month to retrieve statistics for. Must be formatted YYYY-MM-DD
    date: string,
    /// A substring search of your subusers.
    subuser: option<string>,
    /// The metric that you want to sort by. Metrics that you can sort by are: `blocks`, `bounces`, `clicks`, `delivered`, `opens`, `requests`, `unique_clicks`, `unique_opens`, and `unsubscribes`.'
    sort-by-metric: option<get-subusers-stats-monthly-sort-by-metric-enum>,
    /// The direction you want to sort.
    sort-by-direction: option<get-subusers-stats-monthly-sort-by-direction-enum>,
    /// Optional field to limit the number of results returned.
    limit: option<s32>,
    /// Optional beginning point in the list to retrieve from.
    offset: option<s32>
  }
  get-subusers-stats-monthly: func(params: get-subusers-stats-monthly-params) -> result<string, string>;

  /// Retrieve the totals for each email statistic metric for all subusers.
  record get-subusers-stats-sums-params {
    /// The direction you want to sort. 
    sort-by-direction: option<get-subusers-stats-monthly-sort-by-direction-enum>,
    /// The starting date of the statistics to retrieve. Must follow format YYYY-MM-DD.
    start-date: string,
    /// The end date of the statistics to retrieve. Defaults to today. Must follow format YYYY-MM-DD.
    end-date: option<string>,
    /// Limits the number of results returned per page.
    limit: option<s32>,
    /// The point in the list to begin retrieving results from.
    offset: option<s32>,
    /// How to group the statistics. Defaults to today. Must follow format YYYY-MM-DD.
    aggregated-by: option<string>,
    /// The metric that you want to sort by.  Must be a single metric.
    sort-by-metric: option<string>
  }
  get-subusers-stats-sums: func(params: get-subusers-stats-sums-params) -> result<string, string>;

  /// Retrieve the monthly email statistics for a single subuser
  record get-subusers-subuser-name-stats-monthly-params {
    /// The date of the month to retrieve statistics for. Must be formatted YYYY-MM-DD
    date: string,
    /// The metric that you want to sort by. Metrics that you can sort by are: `blocks`, `bounces`, `clicks`, `delivered`, `opens`, `requests`, `unique_clicks`, `unique_opens`, and `unsubscribes`.'
    sort-by-metric: option<string>,
    /// The direction you want to sort.
    sort-by-direction: option<get-subusers-stats-monthly-sort-by-direction-enum>,
    /// Optional field to limit the number of results returned.
    limit: option<s32>,
    /// Optional beginning point in the list to retrieve from.
    offset: option<s32>
  }
  get-subusers-subuser-name-stats-monthly: func(params: get-subusers-subuser-name-stats-monthly-params) -> result<string, string>;

}

interface subuser-monitor-settings {
