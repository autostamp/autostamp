    field-name: option<string>,
    on-behalf-of: option<string>
  }
  get-contactdb-recipients-search: func(params: get-contactdb-recipients-search-params) -> result<get-contactdb-recipients-search-response, get-contactdb-recipients-search-error>;

  /// Search recipients
  record post-contactdb-recipients-search-params {
    conditions: list<string>,
    list-id: s32
  }
  post-contactdb-recipients-search: func(params: post-contactdb-recipients-search-params) -> result<post-contactdb-recipients-search-response, post-contactdb-recipients-search-error>;

  /// Retrieve a single recipient
