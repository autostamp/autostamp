interface stores {
  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<store>
  }

  record store {
    domain: option<string>,
    games-count: option<s32>,
    id: option<s32>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  record store-single {
    description: option<string>,
    domain: option<string>,
    games-count: option<s32>,
    id: option<s32>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  /// Get a list of video game storefronts.
  record list-op-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Get details of the store.
  record read-params {
    /// A unique integer value identifying this Store.
    id: string
  }
  read: func(params: read-params) -> result<store-single, string>;

}

interface tags {
  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<tag>
  }

  record tag {
    games-count: option<s32>,
    id: option<s32>,
    image-background: option<string>,
    language: option<string>,
    name: string,
    slug: option<string>
  }

  record tag-single {
    description: option<string>,
    games-count: option<s32>,
    id: option<s32>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  /// Get a list of tags.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Get details of the tag.
  record read-params {
    /// A unique integer value identifying this Tag.
    id: string
  }
  read: func(params: read-params) -> result<tag-single, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export creator-roles;
  export creators;
  export developers;
  export games;
