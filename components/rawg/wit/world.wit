package autostamp:rawg@0.6.0;

interface creator-roles {
  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<position>
  }

  record position {
    id: option<s32>,
    name: option<string>,
    slug: option<string>
  }

  /// Get a list of creator positions (jobs).
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

}


interface creators {
  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<person>
  }

  record person {
    games-count: option<s32>,
    id: option<s32>,
    image: option<string>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  record person-single {
    description: option<string>,
    games-count: option<s32>,
    id: option<s32>,
    image: option<string>,
    image-background: option<string>,
    name: string,
    rating: option<string>,
    rating-top: option<s32>,
    reviews-count: option<s32>,
    slug: option<string>,
    updated: option<string>
  }

  /// Get a list of game creators.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Get details of the creator.
  record read-params {
    id: string
  }
  read: func(params: read-params) -> result<person-single, string>;

}

interface developers {
  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<developer>
  }

  record developer {
    games-count: option<s32>,
    id: option<s32>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  record developer-single {
    description: option<string>,
    games-count: option<s32>,
    id: option<s32>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  /// Get a list of game developers.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Get details of the developer.
  record read-params {
    /// A unique integer value identifying this Developer.
    id: string
  }
  read: func(params: read-params) -> result<developer-single, string>;

}

interface games {
  enum game-esrb-rating-name-enum {
    everyone,
    everyone-v10,
    teen,
    mature,
    adults-only,
    rating-pending,
  }

  enum game-esrb-rating-slug-enum {
    everyone,
    everyone-v10-plus,
    teen,
    mature,
    adults-only,
    rating-pending,
  }

  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<game>
  }

  record game {
    added: option<s32>,
    added-by-status: option<list<game-added-by-status-entry>>,
    background-image: option<string>,
    esrb-rating: option<game-esrb-rating>,
    id: option<s32>,
    metacritic: option<s32>,
    name: option<string>,
    platforms: option<list<game-platforms-item>>,
    /// in hours
    playtime: option<s32>,
    rating: f64,
    rating-top: option<s32>,
    ratings: option<list<game-ratings-entry>>,
    ratings-count: option<s32>,
    released: option<string>,
    reviews-text-count: option<string>,
    slug: option<string>,
    suggestions-count: option<s32>,
    tba: option<bool>,
    updated: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record game-added-by-status-entry {
    key: string,
    value: string
  }

  record game-esrb-rating {
    id: option<s32>,
    name: option<game-esrb-rating-name-enum>,
    slug: option<game-esrb-rating-slug-enum>
  }

  record game-platforms-item {
    platform: option<game-platforms-item-platform>,
    released-at: option<string>,
    requirements: option<game-platforms-item-requirements>
  }

  record game-platforms-item-platform {
    id: option<s32>,
    name: option<string>,
    slug: option<string>
  }

  record game-platforms-item-requirements {
    minimum: option<string>,
    recommended: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record game-ratings-entry {
    key: string,
    value: string
  }

  record additions-list-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<game>
  }

  record development-team-list-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<game-person-list>
  }

  record game-person-list {
    games-count: option<s32>,
    id: option<s32>,
    image: option<string>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  record game-series-list-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<game>
  }

  record parent-games-list-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<game>
  }

  record screenshots-list-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<screen-shot>
  }

  record screen-shot {
    height: option<s32>,
    /// Set image as hidden or visible.
    hidden: option<bool>,
    id: option<s32>,
    /// An image file with size up to 20 MB.
    image: option<string>,
    width: option<s32>
  }

  record stores-list-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<game-store-full>
  }

  record game-store-full {
    game-id: option<string>,
    id: option<s32>,
    store-id: option<string>,
    url: string
  }

  record game-single {
    achievements-count: option<s32>,
    added: option<s32>,
    added-by-status: option<list<game-single-added-by-status-entry>>,
    additions-count: option<s32>,
    alternative-names: option<list<string>>,
    background-image: option<string>,
    background-image-additional: option<string>,
    creators-count: option<s32>,
    description: option<string>,
    esrb-rating: option<game-single-esrb-rating>,
    game-series-count: option<s32>,
    id: option<s32>,
    metacritic: option<s32>,
    metacritic-platforms: option<list<game-platform-metacritic>>,
    /// For example "http://www.metacritic.com/game/playstation-4/the-witcher-3-wild-hunt"
    metacritic-url: option<string>,
    movies-count: option<s32>,
    name: option<string>,
    name-original: option<string>,
    parent-achievements-count: option<string>,
    parents-count: option<s32>,
    platforms: option<list<game-single-platforms-item>>,
    /// in hours
    playtime: option<s32>,
    rating: f64,
    rating-top: option<s32>,
    ratings: option<list<game-single-ratings-entry>>,
    ratings-count: option<s32>,
    reactions: option<list<game-single-reactions-entry>>,
    reddit-count: option<s32>,
    reddit-description: option<string>,
    reddit-logo: option<string>,
    reddit-name: option<string>,
    /// For example "https://www.reddit.com/r/uncharted/" or "uncharted"
    reddit-url: option<string>,
    released: option<string>,
    reviews-text-count: option<string>,
    screenshots-count: option<s32>,
    slug: option<string>,
    suggestions-count: option<s32>,
    tba: option<bool>,
    twitch-count: option<string>,
    updated: option<string>,
    website: option<string>,
    youtube-count: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record game-single-added-by-status-entry {
    key: string,
    value: string
  }

  record game-single-esrb-rating {
    id: option<s32>,
    name: option<game-esrb-rating-name-enum>,
    slug: option<game-esrb-rating-slug-enum>
  }

  record game-platform-metacritic {
    metascore: option<s32>,
    url: option<string>
  }

  record game-single-platforms-item {
    platform: option<game-single-platforms-item-platform>,
    released-at: option<string>,
    requirements: option<game-single-platforms-item-requirements>
  }

  record game-single-platforms-item-platform {
    id: option<s32>,
    name: option<string>,
    slug: option<string>
  }

  record game-single-platforms-item-requirements {
    minimum: option<string>,
    recommended: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record game-single-ratings-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record game-single-reactions-entry {
    key: string,
    value: string
  }

  record parent-achievement {
    description: option<string>,
    id: option<s32>,
    image: option<string>,
    name: option<string>,
    percent: option<string>
  }

  record movie {
    data: option<list<movie-data-entry>>,
    id: option<s32>,
    name: option<string>,
    preview: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record movie-data-entry {
    key: string,
    value: string
  }

  record reddit {
    created: option<string>,
    id: option<s32>,
    image: option<string>,
    name: option<string>,
    text: option<string>,
    url: option<string>,
    username: option<string>,
    username-url: option<string>
  }

  record twitch {
    created: option<string>,
    description: option<string>,
    external-id: option<s32>,
    id: option<s32>,
    language: option<string>,
    name: option<string>,
    published: option<string>,
    thumbnail: option<string>,
    view-count: option<s32>
  }

  record youtube {
    channel-id: option<string>,
    channel-title: option<string>,
    comments-count: option<s32>,
    created: option<string>,
    description: option<string>,
    dislike-count: option<s32>,
    external-id: option<string>,
    favorite-count: option<s32>,
    id: option<s32>,
    like-count: option<s32>,
    name: option<string>,
    thumbnails: option<list<youtube-thumbnails-entry>>,
    view-count: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record youtube-thumbnails-entry {
    key: string,
    value: string
  }

  /// Get a list of games.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>,
    /// Search query.
    search: option<string>,
    /// Disable fuzziness for the search query.
    search-precise: option<bool>,
    /// Mark the search query as exact.
    search-exact: option<bool>,
    /// Filter by parent platforms, for example: `1,2,3`.
    parent-platforms: option<string>,
    /// Filter by platforms, for example: `4,5`.
    platforms: option<string>,
    /// Filter by stores, for example: `5,6`.
    stores: option<string>,
    /// Filter by developers, for example: `1612,18893` or `valve-software,feral-interactive`.
    developers: option<string>,
    /// Filter by publishers, for example: `354,20987` or `electronic-arts,microsoft-studios`.
    publishers: option<string>,
    /// Filter by genres, for example: `4,51` or `action,indie`.
    genres: option<string>,
    /// Filter by tags, for example: `31,7` or `singleplayer,multiplayer`.
    tags: option<string>,
    /// Filter by creators, for example: `78,28` or `cris-velasco,mike-morasky`.
    creators: option<string>,
    /// Filter by a release date, for example: `2010-01-01,2018-12-31.1960-01-01,1969-12-31`.
    dates: option<string>,
    /// Filter by an update date, for example: `2020-12-01,2020-12-31`.
    updated: option<string>,
    /// Filter by platforms count, for example: `1`.
    platforms-count: option<s32>,
    /// Filter by a metacritic rating, for example: `80,100`.
    metacritic: option<string>,
    /// Exclude games from a particular collection, for example: `123`.
    exclude-collection: option<s32>,
    /// Exclude additions.
    exclude-additions: option<bool>,
    /// Exclude games which have additions.
    exclude-parents: option<bool>,
    /// Exclude games which included in a game series.
    exclude-game-series: option<bool>,
    /// Exclude stores, for example: `5,6`.
    exclude-stores: option<string>,
    /// Available fields: `name`, `released`, `added`, `created`, `updated`, `rating`, `metacritic`. You can reverse the sort order adding a hyphen, for example: `-released`.
    ordering: option<string>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Get a list of DLC's for the game, GOTY and other editions, companion apps, etc.
  record additions-list-params {
    game-pk: string,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  additions-list: func(params: additions-list-params) -> result<additions-list-response, string>;

  /// Get a list of individual creators that were part of the development team.
  record development-team-list-params {
    game-pk: string,
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  development-team-list: func(params: development-team-list-params) -> result<development-team-list-response, string>;

  /// Get a list of games that are part of the same series.
  record game-series-list-params {
    game-pk: string,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  game-series-list: func(params: game-series-list-params) -> result<game-series-list-response, string>;

  /// Get a list of parent games for DLC's and editions.
  record parent-games-list-params {
    game-pk: string,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  parent-games-list: func(params: parent-games-list-params) -> result<parent-games-list-response, string>;

  /// Get screenshots for the game.
  record screenshots-list-params {
    game-pk: string,
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  screenshots-list: func(params: screenshots-list-params) -> result<screenshots-list-response, string>;

  /// Get links to the stores that sell the game.
  record stores-list-params {
    game-pk: string,
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  stores-list: func(params: stores-list-params) -> result<stores-list-response, string>;

  /// Get details of the game.
  record read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  read: func(params: read-params) -> result<game-single, string>;

  /// Get a list of game achievements.
  record achievements-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  achievements-read: func(params: achievements-read-params) -> result<parent-achievement, string>;

  /// Get a list of game trailers.
  record movies-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  movies-read: func(params: movies-read-params) -> result<movie, string>;

  /// Get a list of most recent posts from the game's subreddit.
  record reddit-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  reddit-read: func(params: reddit-read-params) -> result<reddit, string>;

  /// Get a list of visually similar games, available only for business and enterprise API users.
  record suggested-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  suggested-read: func(params: suggested-read-params) -> result<game-single, string>;

  /// Get streams on Twitch associated with the game, available only for business and enterprise API users.
  record twitch-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  twitch-read: func(params: twitch-read-params) -> result<twitch, string>;

  /// Get videos from YouTube associated with the game, available only for business and enterprise API users.
  record youtube-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  youtube-read: func(params: youtube-read-params) -> result<youtube, string>;

}

interface genres {
  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<genre>
  }

  record genre {
    games-count: option<s32>,
    id: option<s32>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  record genre-single {
    description: option<string>,
    games-count: option<s32>,
    id: option<s32>,
    image-background: option<string>,
    name: string,
    slug: option<string>
  }

  /// Get a list of video game genres.
  record list-op-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Get details of the genre.
  record read-params {
    /// A unique integer value identifying this Genre.
    id: string
  }
  read: func(params: read-params) -> result<genre-single, string>;

}

interface platforms {
  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<platform>
  }

  record platform {
    games-count: option<s32>,
    id: option<s32>,
    image: option<string>,
    image-background: option<string>,
    name: string,
    slug: option<string>,
    year-end: option<s32>,
    year-start: option<s32>
  }

  record lists-parents-list-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
    results: list<platform-parent-single>
  }

  record platform-parent-single {
    id: option<s32>,
    name: string,
    platforms: list<platform>,
    slug: option<string>
  }

  record platform-single {
    description: option<string>,
    games-count: option<s32>,
    id: option<s32>,
    image: option<string>,
    image-background: option<string>,
    name: string,
    slug: option<string>,
    year-end: option<s32>,
    year-start: option<s32>
  }

  /// Get a list of video game platforms.
  record list-op-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Get a list of parent platforms.
  record lists-parents-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  lists-parents-list: func(params: lists-parents-list-params) -> result<lists-parents-list-response, string>;

  /// Get details of the platform.
  record read-params {
    /// A unique integer value identifying this Platform.
    id: string
  }
  read: func(params: read-params) -> result<platform-single, string>;

}

interface publishers {
  record list-op-response {
    count: s32,
    next: option<string>,
    previous: option<string>,
