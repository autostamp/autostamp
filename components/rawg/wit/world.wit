package autostamp:rawg@0.2.0;

interface creator-roles {
  /// Get a list of creator positions (jobs).
  record creator-roles-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  creator-roles-list: func(params: creator-roles-list-params) -> result<string, string>;

}


interface creators {
  /// Get a list of game creators.
  record creators-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  creators-list: func(params: creators-list-params) -> result<string, string>;

  /// Get details of the creator.
  record creators-read-params {
    id: string
  }
  creators-read: func(params: creators-read-params) -> result<string, string>;

}

interface developers {
  /// Get a list of game developers.
  record developers-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  developers-list: func(params: developers-list-params) -> result<string, string>;

  /// Get details of the developer.
  developers-read: func() -> result<string, string>;

}

interface games {
  /// Get a list of games.
  record games-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>,
    /// Search query.
    search: option<string>,
    /// Disable fuzziness for the search query.
    search-precise: option<bool>,
    /// Mark the search query as exact.
    search-exact: option<bool>,
    /// Filter by parent platforms, for example: `1,2,3`.
    parent-platforms: option<string>,
    /// Filter by platforms, for example: `4,5`.
    platforms: option<string>,
    /// Filter by stores, for example: `5,6`.
    stores: option<string>,
    /// Filter by developers, for example: `1612,18893` or `valve-software,feral-interactive`.
    developers: option<string>,
    /// Filter by publishers, for example: `354,20987` or `electronic-arts,microsoft-studios`.
    publishers: option<string>,
    /// Filter by genres, for example: `4,51` or `action,indie`.
    genres: option<string>,
    /// Filter by tags, for example: `31,7` or `singleplayer,multiplayer`.
    tags: option<string>,
    /// Filter by creators, for example: `78,28` or `cris-velasco,mike-morasky`.
    creators: option<string>,
    /// Filter by a release date, for example: `2010-01-01,2018-12-31.1960-01-01,1969-12-31`.
    dates: option<string>,
    /// Filter by an update date, for example: `2020-12-01,2020-12-31`.
    updated: option<string>,
    /// Filter by platforms count, for example: `1`.
    platforms-count: option<s32>,
    /// Filter by a metacritic rating, for example: `80,100`.
    metacritic: option<string>,
    /// Exclude games from a particular collection, for example: `123`.
    exclude-collection: option<s32>,
    /// Exclude additions.
    exclude-additions: option<bool>,
    /// Exclude games which have additions.
    exclude-parents: option<bool>,
    /// Exclude games which included in a game series.
    exclude-game-series: option<bool>,
    /// Exclude stores, for example: `5,6`.
    exclude-stores: option<string>,
    /// Available fields: `name`, `released`, `added`, `created`, `updated`, `rating`, `metacritic`. You can reverse the sort order adding a hyphen, for example: `-released`.
    ordering: option<string>
  }
  games-list: func(params: games-list-params) -> result<string, string>;

  /// Get a list of DLC's for the game, GOTY and other editions, companion apps, etc.
  record games-additions-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  games-additions-list: func(params: games-additions-list-params) -> result<string, string>;

  /// Get a list of individual creators that were part of the development team.
  record games-development-team-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  games-development-team-list: func(params: games-development-team-list-params) -> result<string, string>;

  /// Get a list of games that are part of the same series.
  record games-game-series-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  games-game-series-list: func(params: games-game-series-list-params) -> result<string, string>;

  /// Get a list of parent games for DLC's and editions.
  record games-parent-games-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  games-parent-games-list: func(params: games-parent-games-list-params) -> result<string, string>;

  /// Get screenshots for the game.
  record games-screenshots-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  games-screenshots-list: func(params: games-screenshots-list-params) -> result<string, string>;

  /// Get links to the stores that sell the game.
  record games-stores-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  games-stores-list: func(params: games-stores-list-params) -> result<string, string>;

  /// Get details of the game.
  record games-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  games-read: func(params: games-read-params) -> result<string, string>;

  /// Get a list of game achievements.
  record games-achievements-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  games-achievements-read: func(params: games-achievements-read-params) -> result<string, string>;

  /// Get a list of game trailers.
  record games-movies-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  games-movies-read: func(params: games-movies-read-params) -> result<string, string>;

  /// Get a list of most recent posts from the game's subreddit.
  record games-reddit-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  games-reddit-read: func(params: games-reddit-read-params) -> result<string, string>;

  /// Get a list of visually similar games, available only for business and enterprise API users.
  record games-suggested-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  games-suggested-read: func(params: games-suggested-read-params) -> result<string, string>;

  /// Get streams on Twitch associated with the game, available only for business and enterprise API users.
  record games-twitch-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  games-twitch-read: func(params: games-twitch-read-params) -> result<string, string>;

  /// Get videos from YouTube associated with the game, available only for business and enterprise API users.
  record games-youtube-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  games-youtube-read: func(params: games-youtube-read-params) -> result<string, string>;

}

interface genres {
  /// Get a list of video game genres.
  record genres-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  genres-list: func(params: genres-list-params) -> result<string, string>;

  /// Get details of the genre.
  genres-read: func() -> result<string, string>;

}

interface platforms {
  /// Get a list of video game platforms.
  record platforms-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  platforms-list: func(params: platforms-list-params) -> result<string, string>;

  /// Get a list of parent platforms.
  record platforms-lists-parents-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  platforms-lists-parents-list: func(params: platforms-lists-parents-list-params) -> result<string, string>;

  /// Get details of the platform.
  platforms-read: func() -> result<string, string>;

}

interface publishers {
  /// Get a list of video game publishers.
  record publishers-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  publishers-list: func(params: publishers-list-params) -> result<string, string>;

  /// Get details of the publisher.
  publishers-read: func() -> result<string, string>;

}

interface stores {
  /// Get a list of video game storefronts.
  record stores-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  stores-list: func(params: stores-list-params) -> result<string, string>;

  /// Get details of the store.
  stores-read: func() -> result<string, string>;

}

interface tags {
  /// Get a list of tags.
  record tags-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  tags-list: func(params: tags-list-params) -> result<string, string>;

  /// Get details of the tag.
  tags-read: func() -> result<string, string>;

}
/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export creator-roles;
  export creators;
  export developers;
  export games;
  export genres;
  export platforms;
  export publishers;
  export stores;
  export tags;
}
