package autostamp:rawg@0.3.0;

interface creator-roles {
  /// Get a list of creator positions (jobs).
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

}


interface creators {
  /// Get a list of game creators.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get details of the creator.
  record read-params {
    id: string
  }
  read: func(params: read-params) -> result<string, string>;

}

interface developers {
  /// Get a list of game developers.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get details of the developer.
  read: func() -> result<string, string>;

}

interface games {
  /// Get a list of games.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>,
    /// Search query.
    search: option<string>,
    /// Disable fuzziness for the search query.
    search-precise: option<bool>,
    /// Mark the search query as exact.
    search-exact: option<bool>,
    /// Filter by parent platforms, for example: `1,2,3`.
    parent-platforms: option<string>,
    /// Filter by platforms, for example: `4,5`.
    platforms: option<string>,
    /// Filter by stores, for example: `5,6`.
    stores: option<string>,
    /// Filter by developers, for example: `1612,18893` or `valve-software,feral-interactive`.
    developers: option<string>,
    /// Filter by publishers, for example: `354,20987` or `electronic-arts,microsoft-studios`.
    publishers: option<string>,
    /// Filter by genres, for example: `4,51` or `action,indie`.
    genres: option<string>,
    /// Filter by tags, for example: `31,7` or `singleplayer,multiplayer`.
    tags: option<string>,
    /// Filter by creators, for example: `78,28` or `cris-velasco,mike-morasky`.
    creators: option<string>,
    /// Filter by a release date, for example: `2010-01-01,2018-12-31.1960-01-01,1969-12-31`.
    dates: option<string>,
    /// Filter by an update date, for example: `2020-12-01,2020-12-31`.
    updated: option<string>,
    /// Filter by platforms count, for example: `1`.
    platforms-count: option<s32>,
    /// Filter by a metacritic rating, for example: `80,100`.
    metacritic: option<string>,
    /// Exclude games from a particular collection, for example: `123`.
    exclude-collection: option<s32>,
    /// Exclude additions.
    exclude-additions: option<bool>,
    /// Exclude games which have additions.
    exclude-parents: option<bool>,
    /// Exclude games which included in a game series.
    exclude-game-series: option<bool>,
    /// Exclude stores, for example: `5,6`.
    exclude-stores: option<string>,
    /// Available fields: `name`, `released`, `added`, `created`, `updated`, `rating`, `metacritic`. You can reverse the sort order adding a hyphen, for example: `-released`.
    ordering: option<string>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get a list of DLC's for the game, GOTY and other editions, companion apps, etc.
  record additions-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  additions-list: func(params: additions-list-params) -> result<string, string>;

  /// Get a list of individual creators that were part of the development team.
  record development-team-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  development-team-list: func(params: development-team-list-params) -> result<string, string>;

  /// Get a list of games that are part of the same series.
  record game-series-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  game-series-list: func(params: game-series-list-params) -> result<string, string>;

  /// Get a list of parent games for DLC's and editions.
  record parent-games-list-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  parent-games-list: func(params: parent-games-list-params) -> result<string, string>;

  /// Get screenshots for the game.
  record screenshots-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  screenshots-list: func(params: screenshots-list-params) -> result<string, string>;

  /// Get links to the stores that sell the game.
  record stores-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  stores-list: func(params: stores-list-params) -> result<string, string>;

  /// Get details of the game.
  record read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  read: func(params: read-params) -> result<string, string>;

  /// Get a list of game achievements.
  record achievements-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  achievements-read: func(params: achievements-read-params) -> result<string, string>;

  /// Get a list of game trailers.
  record movies-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  movies-read: func(params: movies-read-params) -> result<string, string>;

  /// Get a list of most recent posts from the game's subreddit.
  record reddit-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  reddit-read: func(params: reddit-read-params) -> result<string, string>;

  /// Get a list of visually similar games, available only for business and enterprise API users.
  record suggested-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  suggested-read: func(params: suggested-read-params) -> result<string, string>;

  /// Get streams on Twitch associated with the game, available only for business and enterprise API users.
  record twitch-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  twitch-read: func(params: twitch-read-params) -> result<string, string>;

  /// Get videos from YouTube associated with the game, available only for business and enterprise API users.
  record youtube-read-params {
    /// An ID or a slug identifying this Game.
    id: string
  }
  youtube-read: func(params: youtube-read-params) -> result<string, string>;

}

interface genres {
  /// Get a list of video game genres.
  record list-op-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get details of the genre.
  read: func() -> result<string, string>;

}

interface platforms {
  /// Get a list of video game platforms.
  record list-op-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get a list of parent platforms.
  record lists-parents-list-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  lists-parents-list: func(params: lists-parents-list-params) -> result<string, string>;

  /// Get details of the platform.
  read: func() -> result<string, string>;

}

interface publishers {
  /// Get a list of video game publishers.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get details of the publisher.
  read: func() -> result<string, string>;

}

interface stores {
  /// Get a list of video game storefronts.
  record list-op-params {
    /// Which field to use when ordering the results.
    ordering: option<string>,
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get details of the store.
  read: func() -> result<string, string>;

}

interface tags {
  /// Get a list of tags.
  record list-op-params {
    /// A page number within the paginated result set.
    page: option<s32>,
    /// Number of results to return per page.
    page-size: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get details of the tag.
  read: func() -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export creator-roles;
  export creators;
  export developers;
  export games;
  export genres;
  export platforms;
  export publishers;
  export stores;
  export tags;
}
