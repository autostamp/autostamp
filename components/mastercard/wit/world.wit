package autostamp:mastercard@0.6.0;

interface bin-table-listing-service {
  record bin-table-response {
    /// BIN Table Listing file.
    data: string
  }

  variant get-binlisting-error {
    not-found(string),
    other(string)
  }

  /// BIN Table Listing file
  get-binlisting: func() -> result<bin-table-response, get-binlisting-error>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export bin-table-listing-service;
}
