  /// Update Collection
  record update-collection-params {
    collection-uid: string,
    collection: option<update-collection-body-collection>
  }
  update-collection: func(params: update-collection-params) -> result<update-collection-response, update-collection-error>;

  /// Delete Collection
  record delete-collection-params {
    collection-uid: string
  }
  delete-collection: func(params: delete-collection-params) -> result<delete-collection-response, delete-collection-error>;

}

interface environments {
