  /// Get all APIs
  record get-all-ap-is-params {
    /// Only return APIs that are inside the given workspace.
    workspace: option<string>,
    /// Only return APIs that have been updated after this time. Time is represented using the ISO 8601 date and time format.
    since: option<string>,
    /// Only return APIs that have been updated before this time. Time is represented using the ISO 8601 date and time format.
    until: option<string>,
    /// Only return APIs that have been created by the user ID represented by the given value.
    created-by: option<string>,
    /// Only return APIs that have been updated by the user ID represented by the given value.
    updated-by: option<string>,
    /// Only return APIs with the corresponding privacy state. Public APIs have the isPublic value true; private APIs have the isPublic value false.
    is-public: option<string>,
    /// Only return APIs whose name includes the given value. Matching is case insensitive.
    name: option<string>,
    /// Only return APIs whose summary includes the given value. Matching is case insensitive.
    summary: option<string>,
    /// Only return APIs whose description includes the given value. Matching is case insensitive.
    description: option<string>,
    /// The value of sort can be one of the names of the fields included in the response.
    sort: option<string>,
    /// The sorting direction, which can be ascending or descending. The value can be asc to specify an ascending direction or desc to specify a descending direction. If none is specified, the default sorting direction is descending for timestamp and numeric fields and ascending otherwise. An ID is not considered a numeric field.
    direction: option<string>
  }
  get-all-ap-is: func(params: get-all-ap-is-params) -> result<string, string>;

  /// Create API
  record create-api-params {
    workspace: option<string>,
    api: option<create-api-body-api>
  }
  create-api: func(params: create-api-params) -> result<create-api-response, string>;

  /// Single API
  record single-api-params {
    api-id: string
  }
  single-api: func(params: single-api-params) -> result<single-api-response, string>;

  /// Update an API
  record update-an-api-params {
    api-id: string,
    api: option<update-an-api-body-api>
  }
  update-an-api: func(params: update-an-api-params) -> result<update-an-api-response, string>;

  /// Delete an API
  record delete-an-api-params {
    api-id: string
  }
  delete-an-api: func(params: delete-an-api-params) -> result<delete-an-api-response, string>;

  /// Get All API Versions
  record get-all-api-versions-params {
    api-id: string
  }
  get-all-api-versions: func(params: get-all-api-versions-params) -> result<get-all-api-versions-response, string>;

  /// Create API Version
  record create-api-version-params {
    api-id: string,
    version: option<create-api-version-body-version>
  }
  create-api-version: func(params: create-api-version-params) -> result<create-api-version-response, string>;

  /// Get an API Version
  record get-an-api-version-params {
    api-id: string,
    api-version-id: string
  }
  get-an-api-version: func(params: get-an-api-version-params) -> result<get-an-api-version-response, string>;

  /// Update an API Version
  record update-an-api-version-params {
    api-id: string,
    api-version-id: string,
    version: option<update-an-api-version-body-version>
  }
  update-an-api-version: func(params: update-an-api-version-params) -> result<update-an-api-version-response, string>;

  /// Delete an API Version
  record delete-an-api-version-params {
    api-id: string,
    api-version-id: string
  }
  delete-an-api-version: func(params: delete-an-api-version-params) -> result<delete-an-api-version-response, string>;

  /// Get contract test relations
  record get-contract-test-relations-params {
    api-id: string,
    api-version-id: string
  }
  get-contract-test-relations: func(params: get-contract-test-relations-params) -> result<get-contract-test-relations-response, string>;

  /// Get  documentation relations
  record get-documentation-relations-params {
    api-id: string,
    api-version-id: string
  }
  get-documentation-relations: func(params: get-documentation-relations-params) -> result<get-documentation-relations-response, string>;

  /// Get environment relations
  record get-environment-relations-params {
    api-id: string,
    api-version-id: string
  }
  get-environment-relations: func(params: get-environment-relations-params) -> result<get-environment-relations-response, string>;

  /// Get integration test relations
  record get-integration-test-relations-params {
    api-id: string,
    api-version-id: string
  }
  get-integration-test-relations: func(params: get-integration-test-relations-params) -> result<get-integration-test-relations-response, string>;

  /// Get monitor relations
  record get-monitor-relations-params {
    api-id: string,
    api-version-id: string
  }
  get-monitor-relations: func(params: get-monitor-relations-params) -> result<get-monitor-relations-response, string>;

  /// Get linked relations
  record get-linked-relations-params {
    api-id: string,
    api-version-id: string
  }
  get-linked-relations: func(params: get-linked-relations-params) -> result<get-linked-relations-response, string>;

  /// Create relations
  record create-relations-params {
    api-id: string,
    api-version-id: string,
    contracttest: option<list<string>>,
    documentation: option<list<string>>,
    mock: option<list<string>>,
    testsuite: option<list<string>>
  }
  create-relations: func(params: create-relations-params) -> result<create-relations-response, string>;

  /// Create Schema
  record create-schema-params {
    api-id: string,
    api-version-id: string,
    schema: option<create-schema-body-schema>
  }
  create-schema: func(params: create-schema-params) -> result<create-schema-response, string>;

  /// Get Schema
  record get-schema-params {
    api-id: string,
    api-version-id: string,
    schema-id: string
  }
  get-schema: func(params: get-schema-params) -> result<get-schema-response, string>;

  /// Update Schema
  record update-schema-params {
    api-id: string,
    api-version-id: string,
    schema-id: string,
    schema: option<update-schema-body-schema>
  }
  update-schema: func(params: update-schema-params) -> result<update-schema-response, string>;

  /// Create collection from schema
  record create-collection-from-schema-params {
    api-id: string,
    api-version-id: string,
    schema-id: string,
    workspace: option<string>,
    name: option<string>,
    relations: option<list<create-collection-from-schema-body-relations-item>>
  }
  create-collection-from-schema: func(params: create-collection-from-schema-params) -> result<create-collection-from-schema-response, string>;

  /// Get test suite relations
  record get-test-suite-relations-params {
    api-id: string,
    api-version-id: string
  }
  get-test-suite-relations: func(params: get-test-suite-relations-params) -> result<get-test-suite-relations-response, string>;

  /// Sync relations with schema
  record sync-relations-with-schema-params {
    /// Id of the API
    api-id: string,
    /// Id of the API version
    api-version-id: string,
    /// Relation type (e.g documentation, contracttest, integrationtest, testsuite, mock, monitor)
    entity-type: string,
    /// Relation id
    entity-id: string
  }
  sync-relations-with-schema: func(params: sync-relations-with-schema-params) -> result<sync-relations-with-schema-response, sync-relations-with-schema-error>;

}


