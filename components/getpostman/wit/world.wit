  }
  create-collection: func(params: create-collection-params) -> result<create-collection-response, create-collection-error>;

  /// Create a Fork
  record create-a-fork-params {
    collection-uid: string,
    /// Workspace ID is required to create a fork
    workspace: option<string>,
    name: option<string>
  }
  create-a-fork: func(params: create-a-fork-params) -> result<string, string>;

  /// Merge a Fork
  record merge-a-fork-params {
    destination: option<string>,
    source: option<string>,
    strategy: option<string>
