  }
  single-workspace: func(params: single-workspace-params) -> result<single-workspace-response, single-workspace-error>;

  /// Update Workspace
  record update-workspace-params {
    workspace-id: string,
    workspace: option<update-workspace-body-workspace>
  }
  update-workspace: func(params: update-workspace-params) -> result<update-workspace-response, update-workspace-error>;

  /// Delete Workspace
  record delete-workspace-params {
    workspace-id: string
  }
  delete-workspace: func(params: delete-workspace-params) -> result<delete-workspace-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export api;
  export collections;
  export environments;
  export import-op;
  export user;
  export mocks;
  export monitors;
  export webhooks;
  export workspaces;
}
