    /// The PEM-formatted private key for the SSL certificate set in the `ssl_cert` field.
    /// 
    ssl-key: option<string>,
    /// Controls how session stickiness is handled on this port.
    /// * If set to `none` connections will always be assigned a backend based on the algorithm configured.
    stickiness: option<node-balancer-config-stickiness-enum>,
    /// The NodeBalancer Node(s) that serve this Config.
    /// 
    nodes: list<rebuild-node-balancer-config-body-nodes-item>
  }
  rebuild-node-balancer-config: func(params: rebuild-node-balancer-config-params) -> result<node-balancer-config, string>;

  /// NodeBalancer Statistics View
  record get-nodebalancers-node-balancer-id-stats-params {
    /// The ID of the NodeBalancer to access.
    node-balancer-id: string
  }
  get-nodebalancers-node-balancer-id-stats: func(params: get-nodebalancers-node-balancer-id-stats-params) -> result<node-balancer-stats, string>;

}

interface object-storage {
  enum create-object-storage-bucket-body-acl-enum {
    private,
    public-read,
    authenticated-read,
    public-read-write,
  }

  enum modify-object-storage-bucket-access-body-acl-enum {
    private,
    public-read,
    authenticated-read,
    public-read-write,
    custom,
  }

  enum cluster-status-enum {
    available,
    unavailable,
  }

  enum key-bucket-access-item-permissions-enum {
    read-write,
    read-only,
  }

  record get-object-storage-buckets-response {
    data: option<list<bucket>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An Object Storage Bucket. This should be accessed primarily through the S3 API; [click here for more information](https://docs.ceph.com/en/latest/radosgw/s3/#api).
  record bucket {
    /// The ID of the Object Storage Cluster this bucket is in.
    cluster: option<string>,
    /// When this bucket was created.
    created: option<string>,
    /// The hostname where this bucket can be accessed. This hostname can be accessed through a browser if the bucket is made public.
    hostname: option<string>,
    /// The name of this bucket.
    label: option<string>,
    /// The number of objects stored in this bucket.
    objects: option<s32>,
    /// The size of the bucket in bytes.
    size: option<s32>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  record get-object-storage-bucketin-cluster-response {
    data: option<list<bucket>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  record delete-object-storage-bucket-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record modify-object-storage-bucket-access-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record update-object-storage-bucket-access-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record view-object-storage-bucket-acl-response {
    /// The Access Control Level of the bucket, as a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: option<modify-object-storage-bucket-access-body-acl-enum>,
    /// The full XML of the object's ACL policy.
    acl-xml: option<string>
  }

  record update-object-storage-bucket-acl-response {
    /// The Access Control Level of the bucket, as a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: option<modify-object-storage-bucket-access-body-acl-enum>,
    /// The full XML of the object's ACL policy.
    acl-xml: option<string>
  }

  record get-object-storage-bucket-content-response {
    /// This page of objects in the bucket.
    data: option<list<object>>
  }

  /// An Object in Object Storage, or a "prefix" that contains one or more objects when a `delimiter` is used.
  record object {
    /// An MD-5 hash of the object. `null` if this object represents a prefix.
    etag: option<string>,
    /// Designates if there is another page of bucket objects.
    is-truncated: option<bool>,
    /// The date and time this object was last modified. `null` if this object represents a prefix.
    last-modified: option<string>,
    /// The name of this object or prefix.
    name: option<string>,
    /// Returns the value you should pass to the `marker` query parameter to get the next page of objects. If there is no next page, `null` will be returned.
    next-marker: option<string>,
    /// The owner of this object, as a UUID. `null` if this object represents a prefix.
    owner: option<string>,
    /// The size of this object, in bytes. `null` if this object represents a prefix.
    size: option<s32>
  }

  record create-object-storage-object-url-response {
    /// The signed URL to perform the request at.
    url: option<string>
  }

  /// If this Object Storage bucket has a corresponding TLS/SSL Certificate.
  record ssl-response {
    /// A boolean indicating if this Bucket has a corresponding TLS/SSL certificate that was uploaded by an Account user.
    ssl: option<bool>
  }

  record delete-object-storage-ssl-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record cancel-object-storage-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-object-storage-clusters-response {
    data: option<list<cluster>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An Object Storage Cluster
  record cluster {
    /// The base URL for this cluster, used for connecting with third-party clients.
    domain: option<string>,
    /// The unique ID for this cluster.
    id: option<string>,
    /// The region where this cluster is located.
    region: option<string>,
    /// The base URL for this cluster used when hosting static sites.
    static-site-domain: option<string>,
    /// This cluster's status.
    status: option<cluster-status-enum>
  }

  record get-object-storage-keys-response {
    data: option<list<key>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A keypair used to communicate with the Object Storage S3 API.
  record key {
    /// This keypair's access key. This is not secret.
    access-key: option<string>,
    /// Defines this key as a Limited Access Key. Limited Access Keys restrict this Object Storage key's access to only the bucket(s) declared in this array and define their bucket-level permissions.
    /// 
    bucket-access: option<list<key-bucket-access-item>>,
    /// This keypair's unique ID
    id: option<s32>,
    /// The label given to this key. For display purposes only.
    label: option<string>,
    /// Whether or not this key is a limited access key. Will return `false` if this key grants full access to all buckets on the user's account.
    limited: option<bool>,
    /// This keypair's secret key. Only returned on key creation.
    secret-key: option<string>
  }

  record key-bucket-access-item {
    /// The unique label of the bucket to which the key will grant limited access.
    bucket-name: option<string>,
    /// The Object Storage cluster where a bucket to which the key is granting access is hosted.
    cluster: option<string>,
    /// This Limited Access Key's permissions for the selected bucket.
    permissions: option<key-bucket-access-item-permissions-enum>
  }

  record delete-object-storage-key-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-object-storage-transfer-response {
    /// The amount of outbound data transfer used by your account's Object Storage buckets, in bytes, for the current month's billing cycle.
    used: option<s32>
  }

  /// Object Storage Buckets List
  get-object-storage-buckets: func() -> result<get-object-storage-buckets-response, string>;

  /// Object Storage Bucket Create
  record create-object-storage-bucket-params {
    /// The Access Control Level of the bucket using a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: option<create-object-storage-bucket-body-acl-enum>,
    /// The ID of the Object Storage Cluster where this bucket should be created.
    cluster: string,
    /// If true, the bucket will be created with CORS enabled for all origins. For more fine-grained controls of CORS, use the S3 API directly.
    cors-enabled: option<bool>,
    /// The name for this bucket. Must be unique in the cluster you are creating the bucket in, or an error will be returned. Labels will be reserved only for the cluster that active buckets are created and stored in. If you want to reserve this bucket's label in another cluster, you must create a new bucket with the same label in the new cluster.
    label: string
  }
  create-object-storage-bucket: func(params: create-object-storage-bucket-params) -> result<bucket, string>;

  /// Object Storage Buckets in Cluster List
  record get-object-storage-bucketin-cluster-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string
  }
  get-object-storage-bucketin-cluster: func(params: get-object-storage-bucketin-cluster-params) -> result<get-object-storage-bucketin-cluster-response, string>;

  /// Object Storage Bucket View
  record get-object-storage-bucket-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string
  }
  get-object-storage-bucket: func(params: get-object-storage-bucket-params) -> result<bucket, string>;

  /// Object Storage Bucket Remove
  record delete-object-storage-bucket-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string
  }
  delete-object-storage-bucket: func(params: delete-object-storage-bucket-params) -> result<delete-object-storage-bucket-response, string>;

  /// Object Storage Bucket Access Modify
  record modify-object-storage-bucket-access-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string,
    /// The Access Control Level of the bucket, as a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: option<modify-object-storage-bucket-access-body-acl-enum>,
    /// If true, the bucket will be created with CORS enabled for all origins. For more fine-grained controls of CORS, use the S3 API directly.
    cors-enabled: option<bool>
  }
  modify-object-storage-bucket-access: func(params: modify-object-storage-bucket-access-params) -> result<modify-object-storage-bucket-access-response, string>;

  /// Object Storage Bucket Access Update
  record update-object-storage-bucket-access-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string,
    /// The Access Control Level of the bucket, as a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: option<modify-object-storage-bucket-access-body-acl-enum>,
    /// If true, the bucket will be created with CORS enabled for all origins. For more fine-grained controls of CORS, use the S3 API directly.
    cors-enabled: option<bool>
  }
  update-object-storage-bucket-access: func(params: update-object-storage-bucket-access-params) -> result<update-object-storage-bucket-access-response, string>;

  /// Object Storage Object ACL Config View
  record view-object-storage-bucket-acl-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string,
    /// The `name` of the object for which to retrieve its Access Control List (ACL). Use the [Object Storage Bucket Contents List](/docs/api/object-storage/#object-storage-bucket-contents-list) endpoint to access all object names in a bucket.
    name: string
  }
  view-object-storage-bucket-acl: func(params: view-object-storage-bucket-acl-params) -> result<view-object-storage-bucket-acl-response, string>;

  /// Object Storage Object ACL Config Update
  record update-object-storage-bucket-acl-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string,
    /// The Access Control Level of the bucket, as a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: modify-object-storage-bucket-access-body-acl-enum,
    /// The `name` of the object for which to update its Access Control List (ACL). Use the [Object Storage Bucket Contents List](/docs/api/object-storage/#object-storage-bucket-contents-list) endpoint to access all object names in a bucket.
    name: string
  }
  update-object-storage-bucket-acl: func(params: update-object-storage-bucket-acl-params) -> result<update-object-storage-bucket-acl-response, string>;

  /// Object Storage Bucket Contents List
  record get-object-storage-bucket-content-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string,
    /// The "marker" for this request, which can be used to paginate through large buckets. Its value should be the value of the `next_marker` property returned with the last page. Listing bucket contents *does not* support arbitrary page access. See the `next_marker` property in the responses section for more details.
    marker: option<string>,
    /// The delimiter for object names; if given, object names will be returned up to the first occurrence of this character. This is most commonly used with the `/` character to allow bucket transversal in a manner similar to a filesystem, however any delimiter may be used. Use in conjunction with `prefix` to see object names past the first occurrence of the delimiter.
    delimiter: option<string>,
    /// Filters objects returned to only those whose name start with the given prefix. Commonly used in conjunction with `delimiter` to allow transversal of bucket contents in a manner similar to a filesystem.
    prefix: option<string>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-object-storage-bucket-content: func(params: get-object-storage-bucket-content-params) -> result<get-object-storage-bucket-content-response, string>;

  /// Object Storage Object URL Create
  record create-object-storage-object-url-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string,
    /// The expected `Content-type` header of the request this signed URL will be valid for.  If provided, the `Content-type` header _must_ be sent with the request when this URL is used, and _must_ be the same as it was when the signed URL was created. Required for all methods *except* "GET" or "DELETE".
    content-type: option<string>,
    /// How long this signed URL will be valid for, in seconds.  If omitted, the URL will be valid for 3600 seconds (1 hour).
    expires-in: option<s32>,
    /// The HTTP method allowed to be used with the pre-signed URL.
    method: string,
    /// The name of the object that will be accessed with the pre-signed URL. This object need not exist, and no error will be returned if it doesn't. This behavior is useful for generating pre-signed URLs to upload new objects to by setting the `method` to "PUT".
    name: string
  }
  create-object-storage-object-url: func(params: create-object-storage-object-url-params) -> result<create-object-storage-object-url-response, string>;

  /// Object Storage TLS/SSL Cert View
  record get-object-storage-ssl-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string
  }
  get-object-storage-ssl: func(params: get-object-storage-ssl-params) -> result<ssl-response, string>;

  /// Object Storage TLS/SSL Cert Upload
  record create-object-storage-ssl-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string,
    /// Your Base64 encoded and PEM formatted SSL certificate.
    /// 
    certificate: string,
    /// The private key associated with this TLS/SSL certificate.
    /// 
    private-key: string
  }
  create-object-storage-ssl: func(params: create-object-storage-ssl-params) -> result<ssl-response, string>;

  /// Object Storage TLS/SSL Cert Delete
  record delete-object-storage-ssl-params {
    /// The ID of the cluster this bucket exists in.
    cluster-id: string,
    /// The bucket name.
    bucket: string
  }
  delete-object-storage-ssl: func(params: delete-object-storage-ssl-params) -> result<delete-object-storage-ssl-response, string>;

  /// Object Storage Cancel
  cancel-object-storage: func() -> result<cancel-object-storage-response, string>;

  /// Clusters List
  get-object-storage-clusters: func() -> result<get-object-storage-clusters-response, string>;

  /// Cluster View
  record get-object-storage-cluster-params {
    /// The ID of the Cluster.
    cluster-id: string
  }
  get-object-storage-cluster: func(params: get-object-storage-cluster-params) -> result<cluster, string>;

  /// Object Storage Keys List
  get-object-storage-keys: func() -> result<get-object-storage-keys-response, string>;

  /// Object Storage Key Create
  record create-object-storage-keys-params {
    /// This keypair's access key. This is not secret.
    access-key: option<string>,
    /// Defines this key as a Limited Access Key. Limited Access Keys restrict this Object Storage key's access to only the bucket(s) declared in this array and define their bucket-level permissions.
    /// 
    bucket-access: option<list<key-bucket-access-item>>,
    /// This keypair's unique ID
    id: option<s32>,
    /// The label given to this key. For display purposes only.
    label: option<string>,
    /// Whether or not this key is a limited access key. Will return `false` if this key grants full access to all buckets on the user's account.
    limited: option<bool>,
    /// This keypair's secret key. Only returned on key creation.
    secret-key: option<string>
  }
  create-object-storage-keys: func(params: create-object-storage-keys-params) -> result<key, string>;

  /// Object Storage Key View
  record get-object-storage-key-params {
    /// The key to look up.
    key-id: string
  }
  get-object-storage-key: func(params: get-object-storage-key-params) -> result<key, string>;

  /// Object Storage Key Update
  record update-object-storage-key-params {
    /// The key to look up.
    key-id: string,
    /// The label for this keypair, for display purposes only.
    label: option<string>
  }
  update-object-storage-key: func(params: update-object-storage-key-params) -> result<key, string>;

  /// Object Storage Key Revoke
  record delete-object-storage-key-params {
    /// The key to look up.
    key-id: string
  }
  delete-object-storage-key: func(params: delete-object-storage-key-params) -> result<delete-object-storage-key-response, string>;

  /// Object Storage Transfer View
  get-object-storage-transfer: func() -> result<get-object-storage-transfer-response, string>;

}

interface profile {
  enum profile-authentication-type-enum {
    password,
    github,
  }

  enum profile-lish-auth-method-enum {
    password-keys,
    keys-only,
    disabled,
  }

  enum grant-permissions-enum {
    read-only,
    read-write,
  }

  enum login-status-enum {
    successful,
    failed,
  }

  /// A Profile represents your User in our system. This is where you can change information about your User. This information is available to any OAuth Client regardless of requested scopes, and can be used to populate User information in third-party applications.
  record profile {
    /// This account's Cloud Manager authentication type. Authentication types are chosen through
    /// Cloud Manager and authorized when logging into your account. These authentication types are either
    authentication-type: option<profile-authentication-type-enum>,
    /// The list of SSH Keys authorized to use Lish for your User. This value is ignored if `lish_auth_method` is "disabled."
    authorized-keys: option<list<string>>,
    /// Your email address.  This address will be used for communication with Linode as necessary.
    email: option<string>,
    /// If true, you will receive email notifications about account activity.  If false, you may still receive business-critical communications through email.
    email-notifications: option<bool>,
    /// If true, logins for your User will only be allowed from whitelisted IPs. This setting is currently deprecated, and cannot be enabled.
    /// 
    ip-whitelist-enabled: option<bool>,
    /// The authentication methods that are allowed when connecting to [the Linode Shell (Lish)](/docs/guides/lish/).
    /// * `keys_only` is the most secure if you intend to use Lish.
    lish-auth-method: option<profile-lish-auth-method-enum>,
    /// Information about your status in our referral program.
    /// 
    referrals: option<profile-referrals>,
    /// If true, your User has restrictions on what can be accessed on your Account. To get details on what entities/actions you can access/perform, see [/profile/grants](/docs/api/profile/#grants-list).
    restricted: option<bool>,
    /// The timezone you prefer to see times in. This is not used by the API directly. It is provided for the benefit of clients such as the Linode Cloud Manager and other clients built on the API. All times returned by the API are in UTC.
    timezone: option<string>,
    /// If true, logins from untrusted computers will require Two Factor Authentication.  See [/profile/tfa-enable](/docs/api/profile/#two-factor-secret-create) to enable Two Factor Authentication.
    two-factor-auth: option<bool>,
    /// Your unique ID in our system. This value will never change, and can safely be used to identify your User.
    uid: option<s32>,
    /// Your username, used for logging in to our system.
    username: option<string>,
    /// The phone number verified for this Profile with the **Phone Number Verify** ([POST /profile/phone-number/verify](/docs/api/profile/#phone-number-verify)) command.
    /// 
    verified-phone-number: option<string>
  }

  /// Information about your status in our referral program.
  /// 
  /// This information becomes accessible after this Profile's Account has established at least $25.00 USD of total payments.
  record profile-referrals {
    /// Your referral code.  If others use this when signing up for Linode, you will receive account credit.
    code: option<string>,
    /// The number of completed signups with your referral code.
    completed: option<s32>,
    /// The amount of account credit in US Dollars issued to you through the referral program.
    credit: option<s32>,
    /// The number of pending signups with your referral code.  You will not receive credit for these signups until they are completed.
    pending: option<s32>,
    /// The number of users who have signed up with your referral code.
    total: option<s32>,
    /// Your referral url, used to direct others to sign up for Linode with your referral code.
    url: option<string>
  }

  record get-profile-apps-response {
    data: option<list<authorized-app>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An application you have authorized access to your Account through OAuth.
  record authorized-app {
    /// When this app was authorized.
    created: option<string>,
    /// When the app's access to your account expires. If `null`, the app's access must be revoked manually.
    expiry: option<string>,
    /// This authorization's ID, used for revoking access.
    id: option<s32>,
    /// The name of the application you've authorized.
    label: option<string>,
    /// The OAuth scopes this app was authorized with.  This defines what parts of your Account the app is allowed to access.
    scopes: option<string>,
    /// The URL at which this app's thumbnail may be accessed.
    thumbnail-url: option<string>,
    /// The website where you can get more information about this app.
    website: option<string>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-profile-app-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-devices-response {
    data: option<list<trusted-device>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A trusted device object represents an active Remember Me session with <a target="_top" href="https://login.linode.com">login.linode.com</a>.
  record trusted-device {
    /// When this Remember Me session was started.  This corresponds to the time of login with the "Remember Me" box checked.
    created: option<string>,
    /// When this TrustedDevice session expires.  Sessions typically last 30 days.
    expiry: option<string>,
    /// The unique ID for this TrustedDevice
    id: option<s32>,
    /// The last time this TrustedDevice was successfully used to authenticate to <a target="_top" href="https://login.linode.com">login.linode.com</a>.
    last-authenticated: option<string>,
    /// The last IP Address to successfully authenticate with this TrustedDevice.
    last-remote-addr: option<string>,
    /// The User Agent of the browser that created this TrustedDevice session.
    user-agent: option<string>
  }

  record revoke-trusted-device-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A structure representing all grants a restricted User has on the Account. Not available for unrestricted users, as they have access to everything without grants. If retrieved from the `/profile/grants` endpoint, entities to which a User has no access will be omitted.
  record grants-response {
    /// The grants this User has for each Database that is owned by this Account.
    database: option<list<grant>>,
    /// The grants this User has for each Domain that is owned by this Account.
    domain: option<list<grant>>,
    /// A structure containing the Account-level grants a User has.
    global: option<grants-response-global>,
    /// The grants this User has for each Image that is owned by this Account.
    image: option<list<grant>>,
    /// The grants this User has for each Linode that is owned by this Account.
    linode: option<list<grant>>,
    /// The grants this User has for each Longview Client that is owned by this Account.
    longview: option<list<grant>>,
    /// The grants this User has for each NodeBalancer that is owned by this Account.
    nodebalancer: option<list<grant>>,
    /// The grants this User has for each StackScript that is owned by this Account.
    stackscript: option<list<grant>>,
    /// The grants this User has for each Block Storage Volume that is owned by this Account.
    volume: option<list<grant>>
  }

  /// Represents the level of access a restricted User has to a specific resource on the Account.
  record grant {
    /// The ID of the entity this grant applies to.
    id: option<s32>,
    /// The current label of the entity this grant applies to, for display purposes.
    label: option<string>,
    /// The level of access this User has to this entity.  If null, this User has no access.
    permissions: option<grant-permissions-enum>
  }

  /// A structure containing the Account-level grants a User has.
  record grants-response-global {
    /// The level of access this User has to Account-level actions, like billing information. A restricted User will never be able to manage users.
    account-access: option<grant-permissions-enum>,
    /// if true, this User may add Managed Databases.
    add-databases: option<bool>,
    /// If true, this User may add Domains.
    add-domains: option<bool>,
    /// If true, this User may add Firewalls.
    add-firewalls: option<bool>,
    /// If true, this User may add Images.
    add-images: option<bool>,
    /// If true, this User may create Linodes.
    add-linodes: option<bool>,
    /// If true, this User may create Longview clients and view the current plan.
    add-longview: option<bool>,
    /// If true, this User may add NodeBalancers.
    add-nodebalancers: option<bool>,
    /// If true, this User may add StackScripts.
    add-stackscripts: option<bool>,
    /// If true, this User may add Volumes.
    add-volumes: option<bool>,
    /// If true, this User may cancel the entire Account.
    cancel-account: option<bool>,
    /// If true, this User may manage the Account's Longview subscription.
    longview-subscription: option<bool>
  }

  record get-profile-logins-response {
    data: option<list<login>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An object representing a previous successful login for a User.
  record login {
    /// When the login was initiated.
    datetime: option<string>,
    /// The unique ID of this login object.
    id: option<s32>,
    /// The remote IP address that requested the login.
    ip: option<string>,
    /// True if the User that attempted the login was a restricted User, false otherwise.
    restricted: option<bool>,
    /// Whether the login attempt succeeded or failed.
    status: option<login-status-enum>,
    /// The username of the User that attempted the login.
    username: option<string>
  }

  record post-profile-phone-number-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record delete-profile-phone-number-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-profile-phone-number-verify-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A dictionary of user preferences.
  record get-user-preferences-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// An object of user preferences.
  record update-user-preferences-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Security questions and responses object for GET operation.
  record security-questions-get {
    security-questions: option<list<security-questions-get-security-questions-item>>
  }

  /// Single security question and response object for GET operation.
  record security-questions-get-security-questions-item {
    id: option<security-question-properties-id>,
    question: option<security-question-properties-question>,
    response: option<security-question-properties-response>
  }

  /// The ID representing the security question.
  record security-question-properties-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The security question.
  record security-question-properties-question {
    /// opaque schema; raw JSON
    value: string
  }

  /// The security question response.
  record security-question-properties-response {
    /// opaque schema; raw JSON
    value: string
  }

  /// Security questions and responses object for POST operation.
  record security-questions-post {
    security-questions: option<list<security-questions-post-security-questions-item>>
  }

  /// Single security question and response object for POST operation.
  record security-questions-post-security-questions-item {
    question-id: option<security-question-properties-id>,
    response: option<security-question-properties-response>,
    security-question: option<security-question-properties-question>
  }

  record get-ssh-keys-response {
    data: option<list<ssh-key>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A credential object for authenticating a User's secure shell connection to a Linode.
  record ssh-key {
    /// The date this key was added.
    created: option<string>,
    /// The unique identifier of an SSH Key object.
    id: option<s32>,
    /// A label for the SSH Key.
    label: option<string>,
    /// The public SSH Key, which is used to authenticate to the root user of the Linodes you deploy.
    /// 
    ssh-key: option<string>
  }

  /// A label for the SSH Key.
  record ssh-key-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-ssh-key-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record tfa-disable-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record tfa-enable-response {
    /// When this Two Factor secret expires.
    expiry: option<string>,
    /// Your Two Factor secret. This is used to generate time-based two factor codes required for logging in. Doing this will be required to confirm TFA an actually enable it.
    secret: option<string>
  }

  record tfa-confirm-response {
    /// A one-use code that can be used in place of your Two Factor code, in case you are unable to generate one.  Keep this in a safe place to avoid being locked out of your Account.
    scratch: option<string>
  }

  record get-personal-access-tokens-response {
    data: option<list<personal-access-token>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A Personal Access Token is a token generated manually to access the API without going through an OAuth login.  Personal Access Tokens can have scopes just like OAuth tokens do, and are commonly used to give access to command-line tools like the Linode CLI, or when writing your own integrations.
  record personal-access-token {
    /// The date and time this token was created.
    created: option<string>,
    /// When this token will expire.  Personal Access Tokens cannot be renewed, so after this time the token will be completely unusable and a new token will need to be generated.  Tokens may be created with "null" as their expiry and will never expire unless revoked.
    expiry: option<string>,
    /// This token's unique ID, which can be used to revoke it.
    id: option<s32>,
    /// This token's label.  This is for display purposes only, but can be used to more easily track what you're using each token for.
    label: option<string>,
    /// The scopes this token was created with. These define what parts of the Account the token can be used to access. Many command-line tools, such as the <a target="_top" href="https://github.com/linode/linode-cli">Linode CLI</a>, require tokens with access to `*`. Tokens with more restrictive scopes are generally more secure.
    scopes: option<string>,
    /// The token used to access the API.  When the token is created, the full token is returned here.  Otherwise, only the first 16 characters are returned.
    token: option<string>
  }

  /// This token's label.  This is for display purposes only, but can be used to more easily track what you're using each token for.
  record personal-access-token-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-personal-access-token-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Profile View
  get-profile: func() -> result<profile, string>;

  /// Profile Update
  record update-profile-params {
    /// This account's Cloud Manager authentication type. Authentication types are chosen through
    /// Cloud Manager and authorized when logging into your account. These authentication types are either
    authentication-type: option<profile-authentication-type-enum>,
    /// The list of SSH Keys authorized to use Lish for your User. This value is ignored if `lish_auth_method` is "disabled."
    authorized-keys: option<list<string>>,
    /// Your email address.  This address will be used for communication with Linode as necessary.
    email: option<string>,
    /// If true, you will receive email notifications about account activity.  If false, you may still receive business-critical communications through email.
    email-notifications: option<bool>,
    /// If true, logins for your User will only be allowed from whitelisted IPs. This setting is currently deprecated, and cannot be enabled.
    /// 
    ip-whitelist-enabled: option<bool>,
    /// The authentication methods that are allowed when connecting to [the Linode Shell (Lish)](/docs/guides/lish/).
    /// * `keys_only` is the most secure if you intend to use Lish.
    lish-auth-method: option<profile-lish-auth-method-enum>,
    /// Information about your status in our referral program.
    /// 
    referrals: option<profile-referrals>,
    /// If true, your User has restrictions on what can be accessed on your Account. To get details on what entities/actions you can access/perform, see [/profile/grants](/docs/api/profile/#grants-list).
    restricted: option<bool>,
    /// The timezone you prefer to see times in. This is not used by the API directly. It is provided for the benefit of clients such as the Linode Cloud Manager and other clients built on the API. All times returned by the API are in UTC.
    timezone: option<string>,
    /// If true, logins from untrusted computers will require Two Factor Authentication.  See [/profile/tfa-enable](/docs/api/profile/#two-factor-secret-create) to enable Two Factor Authentication.
    two-factor-auth: option<bool>,
    /// Your unique ID in our system. This value will never change, and can safely be used to identify your User.
    uid: option<s32>,
    /// Your username, used for logging in to our system.
    username: option<string>,
    /// The phone number verified for this Profile with the **Phone Number Verify** ([POST /profile/phone-number/verify](/docs/api/profile/#phone-number-verify)) command.
    /// 
    verified-phone-number: option<string>
  }
  update-profile: func(params: update-profile-params) -> result<profile, string>;

  /// Authorized Apps List
  record get-profile-apps-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-profile-apps: func(params: get-profile-apps-params) -> result<get-profile-apps-response, string>;

  /// Authorized App View
  record get-profile-app-params {
    /// The authorized app ID to manage.
    app-id: string
  }
  get-profile-app: func(params: get-profile-app-params) -> result<authorized-app, string>;

  /// App Access Revoke
  record delete-profile-app-params {
    /// The authorized app ID to manage.
    app-id: string
  }
  delete-profile-app: func(params: delete-profile-app-params) -> result<delete-profile-app-response, string>;

  /// Trusted Devices List
  get-devices: func() -> result<get-devices-response, string>;

  /// Trusted Device View
  record get-trusted-device-params {
    /// The ID of the TrustedDevice
    device-id: string
  }
  get-trusted-device: func(params: get-trusted-device-params) -> result<trusted-device, string>;

  /// Trusted Device Revoke
  record revoke-trusted-device-params {
    /// The ID of the TrustedDevice
    device-id: string
  }
  revoke-trusted-device: func(params: revoke-trusted-device-params) -> result<revoke-trusted-device-response, string>;

  /// Grants List
  get-profile-grants: func() -> result<grants-response, string>;

  /// Logins List
  get-profile-logins: func() -> result<get-profile-logins-response, string>;

  /// Login View
  record get-profile-login-params {
    /// The ID of the login object to access.
    login-id: string
  }
  get-profile-login: func(params: get-profile-login-params) -> result<login, string>;

  /// Phone Number Verification Code Send
  record post-profile-phone-number-params {
    /// The two-letter ISO 3166 country code associated with the phone number.
    iso-code: string,
    /// A valid phone number.
    phone-number: string
  }
  post-profile-phone-number: func(params: post-profile-phone-number-params) -> result<post-profile-phone-number-response, string>;

  /// Phone Number Delete
  delete-profile-phone-number: func() -> result<delete-profile-phone-number-response, string>;

  /// Phone Number Verify
  record post-profile-phone-number-verify-params {
    /// The one-time code received via SMS message after accessing the **Phone Verification Code Send** ([POST /profile/phone-number](/docs/api/profile/#phone-number-verification-code-send)) command.
    otp-code: string
  }
  post-profile-phone-number-verify: func(params: post-profile-phone-number-verify-params) -> result<post-profile-phone-number-verify-response, string>;

  /// User Preferences View
  get-user-preferences: func() -> result<get-user-preferences-response, string>;

  /// User Preferences Update
  record update-user-preferences-params {
    body: string
  }
  update-user-preferences: func(params: update-user-preferences-params) -> result<update-user-preferences-response, string>;

  /// Security Questions List
  get-security-questions: func() -> result<security-questions-get, string>;

  /// Security Questions Answer
  record post-security-questions-params {
    security-questions: option<list<security-questions-post-security-questions-item>>
  }
  post-security-questions: func(params: post-security-questions-params) -> result<security-questions-post, string>;

  /// SSH Keys List
  record get-ssh-keys-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-ssh-keys: func(params: get-ssh-keys-params) -> result<get-ssh-keys-response, string>;

  /// SSH Key Add
  record add-ssh-key-params {
    /// The date this key was added.
    created: option<string>,
    /// The unique identifier of an SSH Key object.
    id: option<s32>,
    /// A label for the SSH Key.
    label: option<string>,
    /// The public SSH Key, which is used to authenticate to the root user of the Linodes you deploy.
    /// 
    ssh-key: option<string>
  }
  add-ssh-key: func(params: add-ssh-key-params) -> result<ssh-key, string>;

  /// SSH Key View
  record get-ssh-key-params {
    /// The ID of the SSHKey
    ssh-key-id: string
  }
  get-ssh-key: func(params: get-ssh-key-params) -> result<ssh-key, string>;

  /// SSH Key Update
  record update-ssh-key-params {
    /// The ID of the SSHKey
    ssh-key-id: string,
    label: option<ssh-key-properties-label>
  }
  update-ssh-key: func(params: update-ssh-key-params) -> result<ssh-key, string>;

  /// SSH Key Delete
  record delete-ssh-key-params {
    /// The ID of the SSHKey
    ssh-key-id: string
  }
  delete-ssh-key: func(params: delete-ssh-key-params) -> result<delete-ssh-key-response, string>;

  /// Two Factor Authentication Disable
  tfa-disable: func() -> result<tfa-disable-response, string>;

  /// Two Factor Secret Create
  tfa-enable: func() -> result<tfa-enable-response, string>;

  /// Two Factor Authentication Confirm/Enable
  record tfa-confirm-params {
    /// The Two Factor code you generated with your Two Factor secret. These codes are time-based, so be sure it is current.
    tfa-code: option<string>
  }
  tfa-confirm: func(params: tfa-confirm-params) -> result<tfa-confirm-response, string>;

  /// Personal Access Tokens List
  get-personal-access-tokens: func() -> result<get-personal-access-tokens-response, string>;

  /// Personal Access Token Create
  record create-personal-access-token-params {
    /// When this token should be valid until.  If omitted, the new token will be valid until it is manually revoked.
    expiry: option<string>,
    label: option<personal-access-token-properties-label>,
    /// The access [scopes](/docs/api#oauth-reference) to grant to the created token. These cannot be changed after creation, and may not exceed the scopes of the acting token.
    /// 
    scopes: option<string>
  }
  create-personal-access-token: func(params: create-personal-access-token-params) -> result<personal-access-token, string>;

  /// Personal Access Token View
  record get-personal-access-token-params {
    /// The ID of the token to access.
    token-id: string
  }
  get-personal-access-token: func(params: get-personal-access-token-params) -> result<personal-access-token, string>;

  /// Personal Access Token Update
  record update-personal-access-token-params {
    /// The ID of the token to access.
    token-id: string,
    /// The date and time this token was created.
    created: option<string>,
    /// When this token will expire.  Personal Access Tokens cannot be renewed, so after this time the token will be completely unusable and a new token will need to be generated.  Tokens may be created with "null" as their expiry and will never expire unless revoked.
    expiry: option<string>,
    /// This token's unique ID, which can be used to revoke it.
    id: option<s32>,
    /// This token's label.  This is for display purposes only, but can be used to more easily track what you're using each token for.
    label: option<string>,
    /// The scopes this token was created with. These define what parts of the Account the token can be used to access. Many command-line tools, such as the <a target="_top" href="https://github.com/linode/linode-cli">Linode CLI</a>, require tokens with access to `*`. Tokens with more restrictive scopes are generally more secure.
    scopes: option<string>,
    /// The token used to access the API.  When the token is created, the full token is returned here.  Otherwise, only the first 16 characters are returned.
    token: option<string>
  }
  update-personal-access-token: func(params: update-personal-access-token-params) -> result<personal-access-token, string>;

  /// Personal Access Token Revoke
  record delete-personal-access-token-params {
    /// The ID of the token to access.
    token-id: string
  }
  delete-personal-access-token: func(params: delete-personal-access-token-params) -> result<delete-personal-access-token-response, string>;

}

interface regions {
  enum region-status-enum {
    ok,
    outage,
  }

  record get-regions-response {
    data: option<list<region>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An area where Linode services are available.
  record region {
    /// A list of capabilities of this region.
    capabilities: option<list<string>>,
    /// The country where this Region resides.
    country: option<string>,
    /// The unique ID of this Region.
    id: option<string>,
    /// Detailed location information for this Region, including city, state or region, and country.
    label: option<string>,
    resolvers: option<region-resolvers>,
    /// This region's current operational status.
    status: option<region-status-enum>
  }

  record region-resolvers {
    /// The IPv4 addresses for this region's DNS resolvers, separated by commas.
    ipv4: option<string>,
    /// The IPv6 addresses for this region's DNS resolvers, separated by commas.
    ipv6: option<string>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  /// Regions List
  get-regions: func() -> result<get-regions-response, string>;

  /// Region View
  record get-region-params {
    /// ID of the Region to look up.
    region-id: string
  }
  get-region: func(params: get-region-params) -> result<region, string>;

}

interface support {
  enum ticket-status-enum {
    closed,
    new,
    open,
  }

  record get-tickets-response {
    data: option<list<ticket>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A Support Ticket opened on your Account.
  record ticket {
    /// A list of filenames representing attached files associated with this Ticket.
    attachments: option<list<string>>,
    /// Whether the Support Ticket may be closed.
    closable: option<bool>,
    /// The date and time this Ticket was closed.
    closed: option<string>,
    /// The full details of the issue or question.
    description: option<string>,
    /// The entity this Ticket was opened for.
    entity: option<ticket-entity>,
    /// The Gravatar ID of the User who opened this Ticket.
    gravatar-id: option<string>,
    /// The ID of the Support Ticket.
    id: option<s32>,
    /// The date and time this Ticket was created.
    opened: option<string>,
    /// The User who opened this Ticket.
    opened-by: option<string>,
    /// The current status of this Ticket.
    status: option<ticket-status-enum>,
    /// The summary or title for this Ticket.
    summary: option<string>,
    /// The date and time this Ticket was last updated.
    updated: option<string>,
    /// The User who last updated this Ticket.
    updated-by: option<string>
  }

  /// The entity this Ticket was opened for.
  record ticket-entity {
    /// The unique ID for this Ticket's entity.
    id: option<s32>,
    /// The current label of this entity.
    label: option<string>,
    /// The type of entity this is related to.
    type-op: option<string>,
    /// The URL where you can access the object this event is for. If a relative URL, it is relative to the domain you retrieved the entity from.
    url: option<string>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  record create-ticket-attachment-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record close-ticket-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-ticket-replies-response {
    data: option<list<ticket-reply>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An object representing a reply to a Support Ticket.
  record ticket-reply {
    /// The date and time this Ticket reply was created.
    created: option<string>,
    /// The User who submitted this reply.
    created-by: option<string>,
    /// The body of this Support Ticket reply.
    description: option<string>,
    /// If set to true, this reply came from a Linode employee.
    from-linode: option<bool>,
    /// The Gravatar ID of the User who created this reply.
    gravatar-id: option<string>,
    /// The unique ID of this Support Ticket reply.
    id: option<s32>
  }

  /// Support Tickets List
  record get-tickets-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-tickets: func(params: get-tickets-params) -> result<get-tickets-response, string>;

  /// Support Ticket Open
  record create-ticket-params {
    /// The ID of the Managed Database this ticket is regarding, if relevant.
    database-id: option<s32>,
    /// The full details of the issue or question.
    description: string,
    /// The ID of the Domain this ticket is regarding, if relevant.
    domain-id: option<s32>,
    /// The ID of the Firewall this ticket is regarding, if relevant.
    firewall-id: option<s32>,
    /// The ID of the Linode this ticket is regarding, if relevant.
    linode-id: option<s32>,
    /// The ID of the Kubernetes cluster this ticket is regarding, if relevant.
    lkecluster-id: option<s32>,
    /// The ID of the Longview client this ticket is regarding, if relevant.
    longviewclient-id: option<s32>,
    /// Designates if this ticket is related to a [Managed service](https://www.linode.com/products/managed/). If `true`, the following constraints will apply:
    /// * No ID attributes (i.e. `linode_id`, `domain_id`, etc.) should be provided with this request.
    managed-issue: option<bool>,
    /// The ID of the NodeBalancer this ticket is regarding, if relevant.
    nodebalancer-id: option<s32>,
    /// The [Region](/docs/api/regions/) ID for the associated VLAN this ticket is regarding.
    /// 
    region: option<string>,
    /// The summary or title for this SupportTicket.
    summary: string,
    /// The label of the VLAN this ticket is regarding, if relevant. To view your VLANs, use the VLANs List ([GET /networking/vlans](/docs/api/networking/#vlans-list)) endpoint.
    /// 
    vlan: option<string>,
    /// The ID of the Volume this ticket is regarding, if relevant.
    volume-id: option<s32>
  }
  create-ticket: func(params: create-ticket-params) -> result<ticket, string>;

  /// Support Ticket View
  record get-ticket-params {
    /// The ID of the Support Ticket.
    ticket-id: string
  }
  get-ticket: func(params: get-ticket-params) -> result<ticket, string>;

  /// Support Ticket Attachment Create
  record create-ticket-attachment-params {
    /// The ID of the Support Ticket.
    ticket-id: string,
    /// The local, absolute path to the file you want to attach to your Support Ticket.
    file: string
  }
  create-ticket-attachment: func(params: create-ticket-attachment-params) -> result<create-ticket-attachment-response, string>;

  /// Support Ticket Close
  record close-ticket-params {
    /// The ID of the Support Ticket.
    ticket-id: string
  }
  close-ticket: func(params: close-ticket-params) -> result<close-ticket-response, string>;

  /// Replies List
  record get-ticket-replies-params {
    /// The ID of the Support Ticket.
    ticket-id: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-ticket-replies: func(params: get-ticket-replies-params) -> result<get-ticket-replies-response, string>;

  /// Reply Create
  record create-ticket-reply-params {
    /// The ID of the Support Ticket.
    ticket-id: string,
    /// The content of your reply.
    description: string
  }
  create-ticket-reply: func(params: create-ticket-reply-params) -> result<ticket-reply, string>;

}

interface tags {
  record get-tags-response {
    data: option<list<tag>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A tag that has been applied to an object on your Account. Tags are currently for organizational purposes only.
  record tag {
    /// A Label used for organization of objects on your Account.
    label: option<string>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  record get-tagged-objects-response {
    data: option<list<get-tagged-objects-response-data-item>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  record get-tagged-objects-response-data-item {
    data: option<string>,
    type-op: option<string>
  }

  record delete-tag-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Tags List
  record get-tags-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-tags: func(params: get-tags-params) -> result<get-tags-response, string>;

  /// New Tag Create
  record create-tag-params {
    /// A list of Domain IDs to apply the new Tag to.  You must be allowed to `read_write` all of the requested Domains, or the Tag will not be created and an error will be returned.
    domains: option<list<s32>>,
    /// The new Tag.
    label: string,
    /// A list of Linode IDs to apply the new Tag to.  You must be allowed to `read_write` all of the requested Linodes, or the Tag will not be created and an error will be returned.
    linodes: option<list<s32>>,
    /// A list of NodeBalancer IDs to apply the new Tag to. You must be allowed to `read_write` all of the requested NodeBalancers, or the Tag will not be created and an error will be returned.
    nodebalancers: option<list<s32>>,
    /// A list of Volume IDs to apply the new Tag to.  You must be allowed to `read_write` all of the requested Volumes, or the Tag will not be created and an error will be returned.
    volumes: option<list<s32>>
  }
  create-tag: func(params: create-tag-params) -> result<tag, string>;

  /// Tagged Objects List
  record get-tagged-objects-params {
    label: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-tagged-objects: func(params: get-tagged-objects-params) -> result<get-tagged-objects-response, string>;

  /// Tag Delete
  record delete-tag-params {
    label: string
  }
  delete-tag: func(params: delete-tag-params) -> result<delete-tag-response, string>;

}

interface volumes {
  enum volume-hardware-type-enum {
    hdd,
    nvme,
  }

  enum volume-status-enum {
    creating,
    active,
    resizing,
  }

  record get-volumes-response {
    data: option<list<volume>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A Block Storage Volume associated with your Account.
  record volume {
    /// When this Volume was created.
    created: option<string>,
    /// The full filesystem path for the Volume based on the Volume's label. Path is /dev/disk/by-id/scsi-0Linode_Volume_ + Volume label.
    filesystem-path: option<string>,
    /// The storage type of this Volume.
    hardware-type: option<volume-hardware-type-enum>,
    /// The unique ID of this Volume.
    id: option<s32>,
    /// The Volume's label is for display purposes only.
    label: option<string>,
    /// If a Volume is attached to a specific Linode, the ID of that Linode will be displayed here.
    linode-id: option<s32>,
    /// If a Volume is attached to a specific Linode, the label of that Linode will be displayed here.
    linode-label: option<string>,
    region: option<region-properties-id>,
    /// The Volume's size, in GiB.
    size: option<s32>,
    /// The current status of the volume.  Can be one of:
    /// 
    status: option<volume-status-enum>,
    /// An array of Tags applied to this object.  Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// When this Volume was last updated.
    updated: option<string>
  }

  /// The unique ID of this Region.
  record region-properties-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-volume-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The Volume's label is for display purposes only.
  record volume-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  record detach-volume-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The Volume's size, in GiB.
  record volume-properties-size {
    /// opaque schema; raw JSON
    value: string
  }

  /// Volumes List
  record get-volumes-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-volumes: func(params: get-volumes-params) -> result<get-volumes-response, string>;

  /// Volume Create
  record create-volume-params {
    /// When creating a Volume attached to a Linode, the ID of the Linode Config to include the new Volume in. This Config must belong to the Linode referenced by `linode_id`. Must _not_ be provided if `linode_id` is not sent. If a `linode_id` is sent without a `config_id`, the volume will be attached:
    /// 
    config-id: option<s32>,
    /// The Volume's label, which is also used in the `filesystem_path` of the resulting volume.
    label: string,
    /// The Linode this volume should be attached to upon creation. If not given, the volume will be created without an attachment.
    linode-id: option<s32>,
    /// The Region to deploy this Volume in. This is only required if a linode_id is not given.
    region: option<string>,
    /// The initial size of this volume, in GB.  Be aware that volumes may only be resized up after creation.
    size: option<s32>,
    /// An array of Tags applied to this object.  Tags are for organizational purposes only.
    tags: option<list<string>>
  }
  create-volume: func(params: create-volume-params) -> result<volume, string>;

  /// Volume View
  record get-volume-params {
    /// ID of the Volume to look up.
    volume-id: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-volume: func(params: get-volume-params) -> result<volume, string>;

  /// Volume Update
  record update-volume-params {
    /// ID of the Volume to look up.
    volume-id: string,
    /// When this Volume was created.
    created: option<string>,
    /// The full filesystem path for the Volume based on the Volume's label. Path is /dev/disk/by-id/scsi-0Linode_Volume_ + Volume label.
    filesystem-path: option<string>,
    /// The storage type of this Volume.
    hardware-type: option<volume-hardware-type-enum>,
    /// The unique ID of this Volume.
    id: option<s32>,
    /// The Volume's label is for display purposes only.
    label: option<string>,
    /// If a Volume is attached to a specific Linode, the ID of that Linode will be displayed here.
    linode-id: option<s32>,
    /// If a Volume is attached to a specific Linode, the label of that Linode will be displayed here.
    linode-label: option<string>,
    region: option<region-properties-id>,
    /// The Volume's size, in GiB.
    size: option<s32>,
    /// The current status of the volume.  Can be one of:
    /// 
    status: option<volume-status-enum>,
    /// An array of Tags applied to this object.  Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// When this Volume was last updated.
    updated: option<string>
  }
  update-volume: func(params: update-volume-params) -> result<volume, string>;

  /// Volume Delete
  record delete-volume-params {
    /// ID of the Volume to look up.
    volume-id: string
  }
  delete-volume: func(params: delete-volume-params) -> result<delete-volume-response, string>;

  /// Volume Attach
  record attach-volume-params {
    /// ID of the Volume to attach.
    volume-id: string,
    /// The ID of the Linode Config to include this Volume in. Must belong to the Linode referenced by `linode_id`. If not given, the last booted Config will be chosen.
    config-id: option<s32>,
    /// The ID of the Linode to attach the volume to.
    linode-id: s32,
    /// Defaults to true, if false is provided, the Volume will not be attached to the Linode Config. In this case more than 8 Volumes may be attached to a Linode if a Linode has 16GB of RAM or more. The number of volumes that can be attached is equal to the number of GB of RAM that the Linode has, up to a maximum of 64. `config_id` should not be passed if this is set to false and linode_id must be passed. The Linode must be running.
    persist-across-boots: option<bool>
  }
  attach-volume: func(params: attach-volume-params) -> result<volume, string>;

  /// Volume Clone
  record clone-volume-params {
    /// ID of the Volume to clone.
    volume-id: string,
    label: volume-properties-label
  }
  clone-volume: func(params: clone-volume-params) -> result<volume, string>;

  /// Volume Detach
  record detach-volume-params {
    /// ID of the Volume to detach.
    volume-id: string
  }
  detach-volume: func(params: detach-volume-params) -> result<detach-volume-response, string>;

  /// Volume Resize
  record resize-volume-params {
    /// ID of the Volume to resize.
    volume-id: string,
    size: volume-properties-size
  }
  resize-volume: func(params: resize-volume-params) -> result<volume, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export account;
  export databases;
  export domains;
  export images;
  export linode-instances;
  export stack-scripts;
  export linode-types;
  export linode-kubernetes-engine-lke;
  export longview;
  export managed;
  export networking;
  export node-balancers;
  export object-storage;
  export profile;
  export regions;
  export support;
  export tags;
  export volumes;
}
