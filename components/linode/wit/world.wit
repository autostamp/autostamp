  update-longview-plan: func(params: update-longview-plan-params) -> result<string, string>;

  /// Longview Subscriptions List
  get-longview-subscriptions: func() -> result<string, string>;

  /// Longview Subscription View
  get-longview-subscription: func() -> result<string, string>;

}

interface managed {
  enum managed-service-service-type-enum {
    url,
    tcp,
  }

  enum managed-service-status-enum {
    disabled,
    pending,
    ok,
    problem,
  }

  /// Information about how to reach this Contact by phone.
  record managed-contact-phone {
    /// This Contact's primary phone number.
    primary: option<string>,
    /// This Contact's secondary phone number.
    secondary: option<string>
  }

  /// The SSH settings for this Linode.
  record managed-linode-settings-ssh {
    /// If true, Linode special forces may access this Linode over ssh to respond to Issues.
    access: option<bool>,
    /// The IP Linode special forces should use to access this Linode
    /// when responding to an Issue.
    ip: option<string>,
    /// The port Linode special forces should use to access this Linode
    /// over ssh to respond to an Issue.
    port: option<s32>,
    /// The specific user, if any, Linode's special forces should use when accessing this
    /// Linode to respond to an issue.
    user: option<string>
  }

  /// Managed Contacts List
  get-managed-contacts: func() -> result<string, string>;

  /// Managed Contact Create
  record create-managed-contact-params {
    /// The address to email this Contact to alert them of issues.
    email: option<string>,
    /// A grouping for this Contact. This is for display purposes only.
    group: option<string>,
    /// This Contact's unique ID.
    id: option<s32>,
    /// The name of this Contact.
    name: option<string>,
    /// Information about how to reach this Contact by phone.
    phone: option<managed-contact-phone>,
    /// When this Contact was last updated.
    updated: option<string>
  }
  create-managed-contact: func(params: create-managed-contact-params) -> result<string, string>;

  /// Managed Contact View
  get-managed-contact: func() -> result<string, string>;

  /// Managed Contact Update
  record update-managed-contact-params {
    /// The address to email this Contact to alert them of issues.
    email: option<string>,
    /// A grouping for this Contact. This is for display purposes only.
    group: option<string>,
    /// This Contact's unique ID.
    id: option<s32>,
    /// The name of this Contact.
    name: option<string>,
    /// Information about how to reach this Contact by phone.
    phone: option<managed-contact-phone>,
    /// When this Contact was last updated.
    updated: option<string>
  }
  update-managed-contact: func(params: update-managed-contact-params) -> result<string, string>;

  /// Managed Contact Delete
  delete-managed-contact: func() -> result<string, string>;

  /// Managed Credentials List
  get-managed-credentials: func() -> result<string, string>;

  /// Managed Credential Create
  record create-managed-credential-params {
    body: option<string>
  }
  create-managed-credential: func(params: create-managed-credential-params) -> result<string, string>;

  /// Managed SSH Key View
  view-managed-ssh-key: func() -> result<string, string>;

  /// Managed Credential View
  get-managed-credential: func() -> result<string, string>;

  /// Managed Credential Update
  record update-managed-credential-params {
    /// This Credential's unique ID.
    id: option<s32>,
    /// The unique label for this Credential. This is for display purposes only.
    label: option<string>,
    /// The date this Credential was last decrypted by a member of Linode special forces.
    last-decrypted: option<string>
  }
  update-managed-credential: func(params: update-managed-credential-params) -> result<string, string>;

  /// Managed Credential Delete
  delete-managed-credential: func() -> result<string, string>;

  /// Managed Credential Username and Password Update
  record update-managed-credential-username-password-params {
    /// The password to use when accessing the Managed Service.
    password: string,
    /// The username to use when accessing the Managed Service.
    username: option<string>
  }
  update-managed-credential-username-password: func(params: update-managed-credential-username-password-params) -> result<string, string>;

  /// Managed Issues List
  get-managed-issues: func() -> result<string, string>;

  /// Managed Issue View
  get-managed-issue: func() -> result<string, string>;

  /// Managed Linode Settings List
  get-managed-linode-settings: func() -> result<string, string>;

  /// Linode's Managed Settings View
  get-managed-linode-setting: func() -> result<string, string>;

  /// Linode's Managed Settings Update
  record update-managed-linode-setting-params {
    /// The group of the Linode these Settings are for. This is for display purposes only.
    group: option<string>,
    /// The ID of the Linode these Settings are for.
    id: option<s32>,
    /// The label of the Linode these Settings are for.
    label: option<string>,
    /// The SSH settings for this Linode.
    ssh: option<managed-linode-settings-ssh>
  }
  update-managed-linode-setting: func(params: update-managed-linode-setting-params) -> result<string, string>;

  /// Managed Services List
  get-managed-services: func() -> result<string, string>;

  /// Managed Service Create
  record create-managed-service-params {
    body: option<string>
  }
  create-managed-service: func(params: create-managed-service-params) -> result<string, string>;

  /// Managed Service View
  get-managed-service: func() -> result<string, string>;

  /// Managed Service Update
  record update-managed-service-params {
    /// The URL at which this Service is monitored.
    /// 
    address: option<string>,
    /// What to expect to find in the response body for the Service to be considered up.
    body: option<string>,
    /// The group of ManagedContacts who should be notified or consulted with when an Issue is detected.
    consultation-group: option<string>,
    /// When this Managed Service was created.
    created: option<string>,
    /// An array of ManagedCredential IDs that should be used when attempting to resolve issues with this Service.
    credentials: option<list<s32>>,
    /// This Service's unique ID.
    id: option<s32>,
    /// The label for this Service. This is for display purposes only.
    label: option<string>,
    /// Any information relevant to the Service that Linode special forces should know when attempting to resolve Issues.
    notes: option<string>,
    /// The Region in which this Service is located. This is required if address is a private IP, and may not be set otherwise.
    region: option<string>,
    /// How this Service is monitored.
    service-type: option<managed-service-service-type-enum>,
    /// The current status of this Service.
    status: option<managed-service-status-enum>,
    /// How long to wait, in seconds, for a response before considering the Service to be down.
    timeout: option<s32>,
    /// When this Managed Service was last updated.
    updated: option<string>
  }
  update-managed-service: func(params: update-managed-service-params) -> result<string, string>;

  /// Managed Service Delete
  delete-managed-service: func() -> result<string, string>;

  /// Managed Service Disable
  disable-managed-service: func() -> result<string, string>;

  /// Managed Service Enable
  enable-managed-service: func() -> result<string, string>;

  /// Managed Stats List
  get-managed-stats: func() -> result<string, string>;

}

interface networking {
  enum update-firewall-body-status-enum {
    enabled,
    disabled,
  }

  enum allocate-ip-body-type-op-enum {
    ipv4,
  }

  /// Devices to create for this Firewall.
  /// When a Device is created, the Firewall is assigned to its associated service.
  /// Currently, Devices can only be created for Linode instances.
  record create-firewalls-body-devices {
    /// An array of Linode IDs. A Firewall Device is created for each ID.
    linodes: option<list<s32>>
  }

  record create-firewalls-body-rules {
    inbound: option<string>,
    outbound: option<string>
  }

  /// The Firewall's label, for display purposes only.
  /// 
  /// Firewall labels have the following constraints:
  /// 
  ///   * Must begin and end with an alphanumeric character.
  ///   * May only consist of alphanumeric characters, dashes (`-`), underscores (`_`) or periods (`.`).
  ///   * Cannot have two dashes (`--`), underscores (`__`) or periods (`..`) in a row.
  ///   * Must be between 3 and 32 characters.
  ///   * Must be unique.
  record firewall-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// An array of tags applied to this object. Tags are for organizational purposes only.
  record firewall-properties-tags {
    /// opaque schema; raw JSON
    value: string
  }

  /// Firewalls List
  get-firewalls: func() -> result<string, string>;

  /// Firewall Create
  record create-firewalls-params {
    /// Devices to create for this Firewall.
    /// When a Device is created, the Firewall is assigned to its associated service.
    devices: option<create-firewalls-body-devices>,
    rules: create-firewalls-body-rules
  }
  create-firewalls: func(params: create-firewalls-params) -> result<string, string>;

  /// Firewall View
  get-firewall: func() -> result<string, string>;

  /// Firewall Update
  record update-firewall-params {
    label: option<firewall-properties-label>,
    /// The status to be applied to this Firewall.
    ///  
    status: option<update-firewall-body-status-enum>,
    tags: option<firewall-properties-tags>
  }
  update-firewall: func(params: update-firewall-params) -> result<string, string>;

  /// Firewall Delete
  delete-firewall: func() -> result<string, string>;

  /// Firewall Devices List
  get-firewall-devices: func() -> result<string, string>;

  /// Firewall Device Create
  record create-firewall-device-params {
    body: option<string>
  }
  create-firewall-device: func(params: create-firewall-device-params) -> result<string, string>;

  /// Firewall Device View
  get-firewall-device: func() -> result<string, string>;

  /// Firewall Device Delete
  delete-firewall-device: func() -> result<string, string>;

  /// Firewall Rules List
  get-firewall-rules: func() -> result<string, string>;

  /// Firewall Rules Update
  record update-firewall-rules-params {
    inbound: option<string>,
    outbound: option<string>
  }
  update-firewall-rules: func(params: update-firewall-rules-params) -> result<string, string>;

  /// IP Addresses List
  get-i-ps: func() -> result<string, string>;

  /// IP Address Allocate
  record allocate-ip-params {
    /// The ID of a Linode you you have access to that this address will be allocated to.
    linode-id: s32,
    /// Whether to create a public or private IPv4 address.
    public: bool,
    /// The type of address you are requesting. Only IPv4 addresses may be allocated through this endpoint.
    type-op: allocate-ip-body-type-op-enum
  }
  allocate-ip: func(params: allocate-ip-params) -> result<string, string>;

  /// IP Addresses Assign
  record assign-i-ps-params {
    /// The list of assignments to make. You must have read_write access to all IPs being assigned and all Linodes being assigned to in order for the assignments to succeed.
    assignments: string,
    /// The ID of the Region in which these assignments are to take place. All IPs and Linodes must exist in this Region.
    region: string
  }
  assign-i-ps: func(params: assign-i-ps-params) -> result<string, string>;

  /// IP Addresses Share
  record share-i-ps-params {
    /// A list of secondary Linode IPs to share with the primary Linode.
    /// * Can include both IPv4 addresses and IPv6 ranges (omit /56 and /64 prefix lengths)
    ips: list<string>,
    /// The ID of the primary Linode that the addresses will be shared with.
    linode-id: s32
  }
  share-i-ps: func(params: share-i-ps-params) -> result<string, string>;

  /// IP Address View
  get-ip: func() -> result<string, string>;

  /// IP Address RDNS Update
  record update-ip-params {
    /// The reverse DNS assigned to this address. For public IPv4 addresses, this will be set to a default value provided by Linode if not explicitly set.
    rdns: string
  }
  update-ip: func(params: update-ip-params) -> result<string, string>;

  /// Linodes Assign IPv4s
  record assign-i-pv4s-params {
    /// The list of assignments to make. You must have read_write access to all IPs being assigned and all Linodes being assigned to in order for the assignments to succeed.
    assignments: string,
    /// The ID of the Region in which these assignments are to take place. All IPs and Linodes must exist in this Region.
    region: string
  }
  assign-i-pv4s: func(params: assign-i-pv4s-params) -> result<string, string>;

  /// IPv4 Sharing Configure
  record share-i-pv4s-params {
    /// A list of secondary Linode IPs to share with the primary Linode.
    /// * Can include both IPv4 addresses and IPv6 ranges (omit /56 and /64 prefix lengths)
    ips: list<string>,
    /// The ID of the primary Linode that the addresses will be shared with.
    linode-id: s32
  }
  share-i-pv4s: func(params: share-i-pv4s-params) -> result<string, string>;

  /// IPv6 Pools List
  get-i-pv6-pools: func() -> result<string, string>;

  /// IPv6 Ranges List
  get-i-pv6-ranges: func() -> result<string, string>;

  /// IPv6 Range Create
  record post-i-pv6-range-params {
    /// The ID of the Linode to assign this range to. The SLAAC address for the provided Linode is used as the range's `route_target`.
    /// 
    linode-id: option<s32>,
    /// The prefix length of the IPv6 range.
    prefix-length: s32,
    /// The IPv6 SLAAC address to assign this range to.
    /// 
    route-target: option<string>
  }
  post-i-pv6-range: func(params: post-i-pv6-range-params) -> result<string, string>;

  /// IPv6 Range View
  get-i-pv6-range: func() -> result<string, string>;

  /// IPv6 Range Delete
  delete-i-pv6-range: func() -> result<string, string>;

  /// VLANs List
  get-vla-ns: func() -> result<string, string>;

}

interface node-balancers {
  enum node-balancer-config-algorithm-enum {
    roundrobin,
    leastconn,
    source,
  }

  enum node-balancer-config-check-enum {
    none,
    connection,
    http,
    http-body,
  }

  enum node-balancer-config-cipher-suite-enum {
    recommended,
    legacy,
  }

  enum node-balancer-config-protocol-enum {
    http,
    https,
    tcp,
  }

  enum node-balancer-config-proxy-protocol-enum {
    none,
    v1,
    v2,
  }

  enum node-balancer-config-stickiness-enum {
    none,
    table,
    http-cookie,
  }

  enum node-balancer-node-mode-enum {
    accept,
    reject,
    drain,
    backup,
  }

  enum node-balancer-node-status-enum {
    unknown,
    up,
    down,
  }

  /// Throttle connections per second.  Set to 0 (zero) to disable throttling.
  record node-balancer-properties-client-conn-throttle {
    /// opaque schema; raw JSON
    value: string
  }

  /// This NodeBalancer's label. These must be unique on your Account.
  record node-balancer-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// Information about the amount of transfer this NodeBalancer has had so far this month.
  record node-balancer-transfer {
    /// The total outbound transfer, in MB, used for this NodeBalancer this month.
    in: option<f64>,
    /// The total inbound transfer, in MB, used for this NodeBalancer this month.
    out: option<f64>,
    /// The total transfer, in MB, used by this NodeBalancer this month.
    total: option<f64>
  }

  /// A structure containing information about the health of the backends for this port.  This information is updated periodically as checks are performed against backends.
  record node-balancer-config-nodes-status {
    /// The number of backends considered to be "DOWN" and unhealthy.  These are not in rotation, and not serving requests.
    down: option<s32>,
    /// The number of backends considered to be "UP" and healthy, and that are serving requests.
    up: option<s32>
  }

  /// NodeBalancers List
  get-node-balancers: func() -> result<string, string>;

  /// NodeBalancer Create
  record create-node-balancer-params {
    client-conn-throttle: option<node-balancer-properties-client-conn-throttle>,
    /// The port Config(s) to create for this NodeBalancer.
    /// 
    configs: option<string>,
    label: option<node-balancer-properties-label>,
    /// The ID of the Region to create this NodeBalancer in.
    region: string
  }
  create-node-balancer: func(params: create-node-balancer-params) -> result<string, string>;

  /// NodeBalancer View
  get-node-balancer: func() -> result<string, string>;

  /// NodeBalancer Update
  record update-node-balancer-params {
    /// Throttle connections per second.  Set to 0 (zero) to disable throttling.
    client-conn-throttle: option<s32>,
    /// When this NodeBalancer was created.
    created: option<string>,
    /// This NodeBalancer's hostname, beginning with its IP address and ending with _.ip.linodeusercontent.com_.
    hostname: option<string>,
    /// This NodeBalancer's unique ID.
    id: option<s32>,
    /// This NodeBalancer's public IPv4 address.
    ipv4: option<string>,
    /// This NodeBalancer's public IPv6 address.
    ipv6: option<string>,
    /// This NodeBalancer's label. These must be unique on your Account.
    label: option<string>,
    /// The Region where this NodeBalancer is located. NodeBalancers only support backends in the same Region.
    region: option<string>,
    /// An array of Tags applied to this object.  Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// Information about the amount of transfer this NodeBalancer has had so far this month.
    transfer: option<node-balancer-transfer>,
    /// When this NodeBalancer was last updated.
    updated: option<string>
  }
  update-node-balancer: func(params: update-node-balancer-params) -> result<string, string>;

  /// NodeBalancer Delete
  delete-node-balancer: func() -> result<string, string>;

  /// Configs List
  get-node-balancer-configs: func() -> result<string, string>;

  /// Config Create
  record create-node-balancer-config-params {
    /// What algorithm this NodeBalancer should use for routing traffic to backends.
    algorithm: option<node-balancer-config-algorithm-enum>,
    /// The type of check to perform against backends to ensure they are serving requests. This is used to determine if backends are up or down.
    /// * If `none` no check is performed.
    check: option<node-balancer-config-check-enum>,
    /// How many times to attempt a check before considering a backend to be down.
    check-attempts: option<s32>,
    /// This value must be present in the response body of the check in order for it to pass. If this value is not present in the response body of a check request, the backend is considered to be down.
    check-body: option<string>,
    /// How often, in seconds, to check that backends are up and serving requests.
    /// 
    check-interval: option<s32>,
    /// If true, any response from this backend with a `5xx` status code will be enough for it to be considered unhealthy and taken out of rotation.
    check-passive: option<bool>,
    /// The URL path to check on each backend. If the backend does not respond to this request it is considered to be down.
    check-path: option<string>,
    /// How long, in seconds, to wait for a check attempt before considering it failed.
    /// 
    check-timeout: option<s32>,
    /// What ciphers to use for SSL connections served by this NodeBalancer.
    /// 
    cipher-suite: option<node-balancer-config-cipher-suite-enum>,
    /// This config's unique ID
    id: option<s32>,
    /// The ID for the NodeBalancer this config belongs to.
    nodebalancer-id: option<s32>,
    /// A structure containing information about the health of the backends for this port.  This information is updated periodically as checks are performed against backends.
    nodes-status: option<node-balancer-config-nodes-status>,
    /// The port this Config is for. These values must be unique across configs on a single NodeBalancer (you can't have two configs for port 80, for example).  While some ports imply some protocols, no enforcement is done and you may configure your NodeBalancer however is useful to you. For example, while port 443 is generally used for HTTPS, you do not need SSL configured to have a NodeBalancer listening on port 443.
    port: option<s32>,
    /// The protocol this port is configured to serve.
    /// 
    protocol: option<node-balancer-config-protocol-enum>,
    /// ProxyProtocol is a TCP extension that sends initial TCP connection information such as source/destination IPs and ports to backend devices. This information would be lost otherwise. Backend devices must be configured to work with ProxyProtocol if enabled.
    /// 
    proxy-protocol: option<node-balancer-config-proxy-protocol-enum>,
    /// The PEM-formatted public SSL certificate (or the combined PEM-formatted SSL
    /// certificate and Certificate Authority chain) that should be served on this
    ssl-cert: option<string>,
    /// The read-only common name automatically derived from the SSL certificate assigned to this NodeBalancerConfig. Please refer to this field to verify that the appropriate certificate is assigned to your NodeBalancerConfig.
    ssl-commonname: option<string>,
    /// The read-only SHA1-encoded fingerprint automatically derived from the SSL certificate assigned to this NodeBalancerConfig. Please refer to this field to verify that the appropriate certificate is assigned to your NodeBalancerConfig.
    ssl-fingerprint: option<string>,
    /// The PEM-formatted private key for the SSL certificate set in the `ssl_cert` field.
    /// 
    ssl-key: option<string>,
    /// Controls how session stickiness is handled on this port.
    /// * If set to `none` connections will always be assigned a backend based on the algorithm configured.
    stickiness: option<node-balancer-config-stickiness-enum>
  }
  create-node-balancer-config: func(params: create-node-balancer-config-params) -> result<string, string>;

  /// Config View
  get-node-balancer-config: func() -> result<string, string>;

  /// Config Update
  record update-node-balancer-config-params {
    /// What algorithm this NodeBalancer should use for routing traffic to backends.
    algorithm: option<node-balancer-config-algorithm-enum>,
    /// The type of check to perform against backends to ensure they are serving requests. This is used to determine if backends are up or down.
    /// * If `none` no check is performed.
    check: option<node-balancer-config-check-enum>,
    /// How many times to attempt a check before considering a backend to be down.
    check-attempts: option<s32>,
    /// This value must be present in the response body of the check in order for it to pass. If this value is not present in the response body of a check request, the backend is considered to be down.
    check-body: option<string>,
    /// How often, in seconds, to check that backends are up and serving requests.
    /// 
    check-interval: option<s32>,
    /// If true, any response from this backend with a `5xx` status code will be enough for it to be considered unhealthy and taken out of rotation.
    check-passive: option<bool>,
    /// The URL path to check on each backend. If the backend does not respond to this request it is considered to be down.
    check-path: option<string>,
    /// How long, in seconds, to wait for a check attempt before considering it failed.
    /// 
    check-timeout: option<s32>,
    /// What ciphers to use for SSL connections served by this NodeBalancer.
    /// 
    cipher-suite: option<node-balancer-config-cipher-suite-enum>,
    /// This config's unique ID
    id: option<s32>,
    /// The ID for the NodeBalancer this config belongs to.
    nodebalancer-id: option<s32>,
    /// A structure containing information about the health of the backends for this port.  This information is updated periodically as checks are performed against backends.
    nodes-status: option<node-balancer-config-nodes-status>,
    /// The port this Config is for. These values must be unique across configs on a single NodeBalancer (you can't have two configs for port 80, for example).  While some ports imply some protocols, no enforcement is done and you may configure your NodeBalancer however is useful to you. For example, while port 443 is generally used for HTTPS, you do not need SSL configured to have a NodeBalancer listening on port 443.
    port: option<s32>,
    /// The protocol this port is configured to serve.
    /// 
    protocol: option<node-balancer-config-protocol-enum>,
    /// ProxyProtocol is a TCP extension that sends initial TCP connection information such as source/destination IPs and ports to backend devices. This information would be lost otherwise. Backend devices must be configured to work with ProxyProtocol if enabled.
    /// 
    proxy-protocol: option<node-balancer-config-proxy-protocol-enum>,
    /// The PEM-formatted public SSL certificate (or the combined PEM-formatted SSL
    /// certificate and Certificate Authority chain) that should be served on this
    ssl-cert: option<string>,
    /// The read-only common name automatically derived from the SSL certificate assigned to this NodeBalancerConfig. Please refer to this field to verify that the appropriate certificate is assigned to your NodeBalancerConfig.
    ssl-commonname: option<string>,
    /// The read-only SHA1-encoded fingerprint automatically derived from the SSL certificate assigned to this NodeBalancerConfig. Please refer to this field to verify that the appropriate certificate is assigned to your NodeBalancerConfig.
    ssl-fingerprint: option<string>,
    /// The PEM-formatted private key for the SSL certificate set in the `ssl_cert` field.
    /// 
    ssl-key: option<string>,
    /// Controls how session stickiness is handled on this port.
    /// * If set to `none` connections will always be assigned a backend based on the algorithm configured.
    stickiness: option<node-balancer-config-stickiness-enum>
  }
  update-node-balancer-config: func(params: update-node-balancer-config-params) -> result<string, string>;

  /// Config Delete
  delete-node-balancer-config: func() -> result<string, string>;

  /// Nodes List
  get-node-balancer-config-nodes: func() -> result<string, string>;

  /// Node Create
  record create-node-balancer-node-params {
    body: string
  }
  create-node-balancer-node: func(params: create-node-balancer-node-params) -> result<string, string>;

  /// Node View
  get-node-balancer-node: func() -> result<string, string>;

  /// Node Update
  record update-node-balancer-node-params {
    /// The private IP Address where this backend can be reached. This _must_ be a private IP address.
    address: option<string>,
    /// The NodeBalancer Config ID that this Node belongs to.
    config-id: option<s32>,
    /// This node's unique ID.
    id: option<s32>,
    /// The label for this node.  This is for display purposes only.
    label: option<string>,
    /// The mode this NodeBalancer should use when sending traffic to this backend.
    /// * If set to `accept` this backend is accepting traffic.
    mode: option<node-balancer-node-mode-enum>,
    /// The NodeBalancer ID that this Node belongs to.
    nodebalancer-id: option<s32>,
    /// The current status of this node, based on the configured checks of its NodeBalancer Config.
    status: option<node-balancer-node-status-enum>,
    /// Used when picking a backend to serve a request and is not pinned to a single backend yet.  Nodes with a higher weight will receive more traffic.
    weight: option<s32>
  }
  update-node-balancer-node: func(params: update-node-balancer-node-params) -> result<string, string>;

  /// Node Delete
  delete-node-balancer-config-node: func() -> result<string, string>;

  /// Config Rebuild
  record rebuild-node-balancer-config-params {
    body: string
  }
  rebuild-node-balancer-config: func(params: rebuild-node-balancer-config-params) -> result<string, string>;

  /// NodeBalancer Statistics View
  get-nodebalancers-node-balancer-id-stats: func() -> result<string, string>;

}

interface object-storage {
  enum create-object-storage-bucket-body-acl-enum {
    private,
    public-read,
    authenticated-read,
    public-read-write,
  }

  enum modify-object-storage-bucket-access-body-acl-enum {
    private,
    public-read,
    authenticated-read,
    public-read-write,
    custom,
  }

  enum object-storage-key-bucket-access-item-permissions-enum {
    read-write,
    read-only,
  }

  record object-storage-key-bucket-access-item {
    /// The unique label of the bucket to which the key will grant limited access.
    bucket-name: option<string>,
    /// The Object Storage cluster where a bucket to which the key is granting access is hosted.
    cluster: option<string>,
    /// This Limited Access Key's permissions for the selected bucket.
    permissions: option<object-storage-key-bucket-access-item-permissions-enum>
  }

  /// Object Storage Buckets List
  get-object-storage-buckets: func() -> result<string, string>;

  /// Object Storage Bucket Create
  record create-object-storage-bucket-params {
    /// The Access Control Level of the bucket using a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: option<create-object-storage-bucket-body-acl-enum>,
    /// The ID of the Object Storage Cluster where this bucket should be created.
    cluster: string,
    /// If true, the bucket will be created with CORS enabled for all origins. For more fine-grained controls of CORS, use the S3 API directly.
    cors-enabled: option<bool>,
    /// The name for this bucket. Must be unique in the cluster you are creating the bucket in, or an error will be returned. Labels will be reserved only for the cluster that active buckets are created and stored in. If you want to reserve this bucket's label in another cluster, you must create a new bucket with the same label in the new cluster.
    label: string
  }
  create-object-storage-bucket: func(params: create-object-storage-bucket-params) -> result<string, string>;

  /// Object Storage Buckets in Cluster List
  get-object-storage-bucketin-cluster: func() -> result<string, string>;

  /// Object Storage Bucket View
  get-object-storage-bucket: func() -> result<string, string>;

  /// Object Storage Bucket Remove
  delete-object-storage-bucket: func() -> result<string, string>;

  /// Object Storage Bucket Access Modify
  record modify-object-storage-bucket-access-params {
    /// The Access Control Level of the bucket, as a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: option<modify-object-storage-bucket-access-body-acl-enum>,
    /// If true, the bucket will be created with CORS enabled for all origins. For more fine-grained controls of CORS, use the S3 API directly.
    cors-enabled: option<bool>
  }
  modify-object-storage-bucket-access: func(params: modify-object-storage-bucket-access-params) -> result<string, string>;

  /// Object Storage Bucket Access Update
  record update-object-storage-bucket-access-params {
    /// The Access Control Level of the bucket, as a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: option<modify-object-storage-bucket-access-body-acl-enum>,
    /// If true, the bucket will be created with CORS enabled for all origins. For more fine-grained controls of CORS, use the S3 API directly.
    cors-enabled: option<bool>
  }
  update-object-storage-bucket-access: func(params: update-object-storage-bucket-access-params) -> result<string, string>;

  /// Object Storage Object ACL Config View
  record view-object-storage-bucket-acl-params {
    /// The `name` of the object for which to retrieve its Access Control List (ACL). Use the [Object Storage Bucket Contents List](/docs/api/object-storage/#object-storage-bucket-contents-list) endpoint to access all object names in a bucket.
    name: string
  }
  view-object-storage-bucket-acl: func(params: view-object-storage-bucket-acl-params) -> result<string, string>;

  /// Object Storage Object ACL Config Update
  record update-object-storage-bucket-acl-params {
    /// The Access Control Level of the bucket, as a canned ACL string. For more fine-grained control of ACLs, use the S3 API directly.
    acl: modify-object-storage-bucket-access-body-acl-enum,
    /// The `name` of the object for which to update its Access Control List (ACL). Use the [Object Storage Bucket Contents List](/docs/api/object-storage/#object-storage-bucket-contents-list) endpoint to access all object names in a bucket.
    name: string
  }
  update-object-storage-bucket-acl: func(params: update-object-storage-bucket-acl-params) -> result<string, string>;

  /// Object Storage Bucket Contents List
  record get-object-storage-bucket-content-params {
    /// The "marker" for this request, which can be used to paginate through large buckets. Its value should be the value of the `next_marker` property returned with the last page. Listing bucket contents *does not* support arbitrary page access. See the `next_marker` property in the responses section for more details.
    marker: option<string>,
    /// The delimiter for object names; if given, object names will be returned up to the first occurrence of this character. This is most commonly used with the `/` character to allow bucket transversal in a manner similar to a filesystem, however any delimiter may be used. Use in conjunction with `prefix` to see object names past the first occurrence of the delimiter.
    delimiter: option<string>,
    /// Filters objects returned to only those whose name start with the given prefix. Commonly used in conjunction with `delimiter` to allow transversal of bucket contents in a manner similar to a filesystem.
    prefix: option<string>
  }
  get-object-storage-bucket-content: func(params: get-object-storage-bucket-content-params) -> result<string, string>;

  /// Object Storage Object URL Create
  record create-object-storage-object-url-params {
    /// The expected `Content-type` header of the request this signed URL will be valid for.  If provided, the `Content-type` header _must_ be sent with the request when this URL is used, and _must_ be the same as it was when the signed URL was created. Required for all methods *except* "GET" or "DELETE".
    content-type: option<string>,
    /// How long this signed URL will be valid for, in seconds.  If omitted, the URL will be valid for 3600 seconds (1 hour).
    expires-in: option<s32>,
    /// The HTTP method allowed to be used with the pre-signed URL.
    method: string,
    /// The name of the object that will be accessed with the pre-signed URL. This object need not exist, and no error will be returned if it doesn't. This behavior is useful for generating pre-signed URLs to upload new objects to by setting the `method` to "PUT".
    name: string
  }
  create-object-storage-object-url: func(params: create-object-storage-object-url-params) -> result<string, string>;

  /// Object Storage TLS/SSL Cert View
  get-object-storage-ssl: func() -> result<string, string>;

  /// Object Storage TLS/SSL Cert Upload
  record create-object-storage-ssl-params {
    /// Your Base64 encoded and PEM formatted SSL certificate.
    /// 
    certificate: string,
    /// The private key associated with this TLS/SSL certificate.
    /// 
    private-key: string
  }
  create-object-storage-ssl: func(params: create-object-storage-ssl-params) -> result<string, string>;

  /// Object Storage TLS/SSL Cert Delete
  delete-object-storage-ssl: func() -> result<string, string>;

  /// Object Storage Cancel
  cancel-object-storage: func() -> result<string, string>;

  /// Clusters List
  get-object-storage-clusters: func() -> result<string, string>;

  /// Cluster View
  get-object-storage-cluster: func() -> result<string, string>;

  /// Object Storage Keys List
  get-object-storage-keys: func() -> result<string, string>;

  /// Object Storage Key Create
  record create-object-storage-keys-params {
    /// This keypair's access key. This is not secret.
    access-key: option<string>,
    /// Defines this key as a Limited Access Key. Limited Access Keys restrict this Object Storage key's access to only the bucket(s) declared in this array and define their bucket-level permissions.
    /// 
    bucket-access: option<list<object-storage-key-bucket-access-item>>,
    /// This keypair's unique ID
    id: option<s32>,
    /// The label given to this key. For display purposes only.
    label: option<string>,
    /// Whether or not this key is a limited access key. Will return `false` if this key grants full access to all buckets on the user's account.
    limited: option<bool>,
    /// This keypair's secret key. Only returned on key creation.
    secret-key: option<string>
  }
  create-object-storage-keys: func(params: create-object-storage-keys-params) -> result<string, string>;

  /// Object Storage Key View
  get-object-storage-key: func() -> result<string, string>;

  /// Object Storage Key Update
  record update-object-storage-key-params {
    /// The label for this keypair, for display purposes only.
    label: option<string>
  }
  update-object-storage-key: func(params: update-object-storage-key-params) -> result<string, string>;

  /// Object Storage Key Revoke
  delete-object-storage-key: func() -> result<string, string>;

  /// Object Storage Transfer View
  get-object-storage-transfer: func() -> result<string, string>;

}

interface profile {
  enum profile-authentication-type-enum {
    password,
    github,
  }

  enum profile-lish-auth-method-enum {
    password-keys,
    keys-only,
    disabled,
  }

  /// Information about your status in our referral program.
  /// 
  /// This information becomes accessible after this Profile's Account has established at least $25.00 USD of total payments.
  record profile-referrals {
    /// Your referral code.  If others use this when signing up for Linode, you will receive account credit.
    code: option<string>,
    /// The number of completed signups with your referral code.
    completed: option<s32>,
    /// The amount of account credit in US Dollars issued to you through the referral program.
    credit: option<s32>,
    /// The number of pending signups with your referral code.  You will not receive credit for these signups until they are completed.
    pending: option<s32>,
    /// The number of users who have signed up with your referral code.
    total: option<s32>,
    /// Your referral url, used to direct others to sign up for Linode with your referral code.
    url: option<string>
  }

  /// Single security question and response object for POST operation.
  record security-questions-post-security-questions-item {
    question-id: option<security-question-properties-id>,
    response: option<security-question-properties-response>,
    security-question: option<security-question-properties-question>
  }

  /// The ID representing the security question.
  record security-question-properties-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The security question response.
  record security-question-properties-response {
    /// opaque schema; raw JSON
    value: string
  }

  /// The security question.
  record security-question-properties-question {
    /// opaque schema; raw JSON
    value: string
  }

  /// A label for the SSH Key.
  record ssh-key-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// This token's label.  This is for display purposes only, but can be used to more easily track what you're using each token for.
  record personal-access-token-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// Profile View
  get-profile: func() -> result<string, string>;

  /// Profile Update
  record update-profile-params {
    /// This account's Cloud Manager authentication type. Authentication types are chosen through
    /// Cloud Manager and authorized when logging into your account. These authentication types are either
    authentication-type: option<profile-authentication-type-enum>,
    /// The list of SSH Keys authorized to use Lish for your User. This value is ignored if `lish_auth_method` is "disabled."
    authorized-keys: option<list<string>>,
    /// Your email address.  This address will be used for communication with Linode as necessary.
    email: option<string>,
    /// If true, you will receive email notifications about account activity.  If false, you may still receive business-critical communications through email.
    email-notifications: option<bool>,
    /// If true, logins for your User will only be allowed from whitelisted IPs. This setting is currently deprecated, and cannot be enabled.
    /// 
    ip-whitelist-enabled: option<bool>,
    /// The authentication methods that are allowed when connecting to [the Linode Shell (Lish)](/docs/guides/lish/).
    /// * `keys_only` is the most secure if you intend to use Lish.
    lish-auth-method: option<profile-lish-auth-method-enum>,
    /// Information about your status in our referral program.
    /// 
    referrals: option<profile-referrals>,
    /// If true, your User has restrictions on what can be accessed on your Account. To get details on what entities/actions you can access/perform, see [/profile/grants](/docs/api/profile/#grants-list).
    restricted: option<bool>,
    /// The timezone you prefer to see times in. This is not used by the API directly. It is provided for the benefit of clients such as the Linode Cloud Manager and other clients built on the API. All times returned by the API are in UTC.
    timezone: option<string>,
    /// If true, logins from untrusted computers will require Two Factor Authentication.  See [/profile/tfa-enable](/docs/api/profile/#two-factor-secret-create) to enable Two Factor Authentication.
    two-factor-auth: option<bool>,
    /// Your unique ID in our system. This value will never change, and can safely be used to identify your User.
    uid: option<s32>,
    /// Your username, used for logging in to our system.
    username: option<string>,
    /// The phone number verified for this Profile with the **Phone Number Verify** ([POST /profile/phone-number/verify](/docs/api/profile/#phone-number-verify)) command.
    /// 
    verified-phone-number: option<string>
  }
  update-profile: func(params: update-profile-params) -> result<string, string>;

  /// Authorized Apps List
  get-profile-apps: func() -> result<string, string>;

  /// Authorized App View
  get-profile-app: func() -> result<string, string>;

  /// App Access Revoke
  delete-profile-app: func() -> result<string, string>;

  /// Trusted Devices List
  get-devices: func() -> result<string, string>;

  /// Trusted Device View
  get-trusted-device: func() -> result<string, string>;

  /// Trusted Device Revoke
  revoke-trusted-device: func() -> result<string, string>;

  /// Grants List
  get-profile-grants: func() -> result<string, string>;

  /// Logins List
  get-profile-logins: func() -> result<string, string>;

  /// Login View
  get-profile-login: func() -> result<string, string>;

  /// Phone Number Verification Code Send
  record post-profile-phone-number-params {
    /// The two-letter ISO 3166 country code associated with the phone number.
    iso-code: string,
    /// A valid phone number.
    phone-number: string
  }
  post-profile-phone-number: func(params: post-profile-phone-number-params) -> result<string, string>;

  /// Phone Number Delete
  delete-profile-phone-number: func() -> result<string, string>;

  /// Phone Number Verify
  record post-profile-phone-number-verify-params {
    /// The one-time code received via SMS message after accessing the **Phone Verification Code Send** ([POST /profile/phone-number](/docs/api/profile/#phone-number-verification-code-send)) command.
    otp-code: string
  }
  post-profile-phone-number-verify: func(params: post-profile-phone-number-verify-params) -> result<string, string>;

  /// User Preferences View
  get-user-preferences: func() -> result<string, string>;

  /// User Preferences Update
  record update-user-preferences-params {
    body: string
  }
  update-user-preferences: func(params: update-user-preferences-params) -> result<string, string>;

  /// Security Questions List
  get-security-questions: func() -> result<string, string>;

  /// Security Questions Answer
  record post-security-questions-params {
    security-questions: option<list<security-questions-post-security-questions-item>>
  }
  post-security-questions: func(params: post-security-questions-params) -> result<string, string>;

  /// SSH Keys List
  get-ssh-keys: func() -> result<string, string>;

  /// SSH Key Add
  record add-ssh-key-params {
    /// The date this key was added.
    created: option<string>,
    /// The unique identifier of an SSH Key object.
    id: option<s32>,
    /// A label for the SSH Key.
    label: option<string>,
    /// The public SSH Key, which is used to authenticate to the root user of the Linodes you deploy.
    /// 
    ssh-key: option<string>
  }
  add-ssh-key: func(params: add-ssh-key-params) -> result<string, string>;

  /// SSH Key View
  get-ssh-key: func() -> result<string, string>;

  /// SSH Key Update
  record update-ssh-key-params {
    label: option<ssh-key-properties-label>
  }
  update-ssh-key: func(params: update-ssh-key-params) -> result<string, string>;

  /// SSH Key Delete
  delete-ssh-key: func() -> result<string, string>;

  /// Two Factor Authentication Disable
  tfa-disable: func() -> result<string, string>;

  /// Two Factor Secret Create
  tfa-enable: func() -> result<string, string>;

  /// Two Factor Authentication Confirm/Enable
  record tfa-confirm-params {
    /// The Two Factor code you generated with your Two Factor secret. These codes are time-based, so be sure it is current.
    tfa-code: option<string>
  }
  tfa-confirm: func(params: tfa-confirm-params) -> result<string, string>;

  /// Personal Access Tokens List
  get-personal-access-tokens: func() -> result<string, string>;

  /// Personal Access Token Create
  record create-personal-access-token-params {
    /// When this token should be valid until.  If omitted, the new token will be valid until it is manually revoked.
    expiry: option<string>,
    label: option<personal-access-token-properties-label>,
    /// The access [scopes](/docs/api#oauth-reference) to grant to the created token. These cannot be changed after creation, and may not exceed the scopes of the acting token.
    /// 
    scopes: option<string>
  }
  create-personal-access-token: func(params: create-personal-access-token-params) -> result<string, string>;

  /// Personal Access Token View
  get-personal-access-token: func() -> result<string, string>;

  /// Personal Access Token Update
  record update-personal-access-token-params {
    /// The date and time this token was created.
    created: option<string>,
    /// When this token will expire.  Personal Access Tokens cannot be renewed, so after this time the token will be completely unusable and a new token will need to be generated.  Tokens may be created with "null" as their expiry and will never expire unless revoked.
    expiry: option<string>,
    /// This token's unique ID, which can be used to revoke it.
    id: option<s32>,
    /// This token's label.  This is for display purposes only, but can be used to more easily track what you're using each token for.
    label: option<string>,
    /// The scopes this token was created with. These define what parts of the Account the token can be used to access. Many command-line tools, such as the <a target="_top" href="https://github.com/linode/linode-cli">Linode CLI</a>, require tokens with access to `*`. Tokens with more restrictive scopes are generally more secure.
    scopes: option<string>,
    /// The token used to access the API.  When the token is created, the full token is returned here.  Otherwise, only the first 16 characters are returned.
    token: option<string>
  }
  update-personal-access-token: func(params: update-personal-access-token-params) -> result<string, string>;

  /// Personal Access Token Revoke
  delete-personal-access-token: func() -> result<string, string>;

}

interface regions {
  /// Regions List
  get-regions: func() -> result<string, string>;

  /// Region View
  get-region: func() -> result<string, string>;

}

interface support {
  /// Support Tickets List
  get-tickets: func() -> result<string, string>;

  /// Support Ticket Open
  record create-ticket-params {
    /// The ID of the Managed Database this ticket is regarding, if relevant.
    database-id: option<s32>,
    /// The full details of the issue or question.
    description: string,
    /// The ID of the Domain this ticket is regarding, if relevant.
    domain-id: option<s32>,
    /// The ID of the Firewall this ticket is regarding, if relevant.
    firewall-id: option<s32>,
    /// The ID of the Linode this ticket is regarding, if relevant.
    linode-id: option<s32>,
    /// The ID of the Kubernetes cluster this ticket is regarding, if relevant.
    lkecluster-id: option<s32>,
    /// The ID of the Longview client this ticket is regarding, if relevant.
    longviewclient-id: option<s32>,
    /// Designates if this ticket is related to a [Managed service](https://www.linode.com/products/managed/). If `true`, the following constraints will apply:
    /// * No ID attributes (i.e. `linode_id`, `domain_id`, etc.) should be provided with this request.
    managed-issue: option<bool>,
    /// The ID of the NodeBalancer this ticket is regarding, if relevant.
    nodebalancer-id: option<s32>,
    /// The [Region](/docs/api/regions/) ID for the associated VLAN this ticket is regarding.
    /// 
    region: option<string>,
    /// The summary or title for this SupportTicket.
    summary: string,
    /// The label of the VLAN this ticket is regarding, if relevant. To view your VLANs, use the VLANs List ([GET /networking/vlans](/docs/api/networking/#vlans-list)) endpoint.
    /// 
    vlan: option<string>,
    /// The ID of the Volume this ticket is regarding, if relevant.
    volume-id: option<s32>
  }
  create-ticket: func(params: create-ticket-params) -> result<string, string>;

  /// Support Ticket View
  get-ticket: func() -> result<string, string>;

  /// Support Ticket Attachment Create
  create-ticket-attachment: func() -> result<string, string>;

  /// Support Ticket Close
  close-ticket: func() -> result<string, string>;

  /// Replies List
  get-ticket-replies: func() -> result<string, string>;

  /// Reply Create
  record create-ticket-reply-params {
    /// The content of your reply.
    description: string
  }
  create-ticket-reply: func(params: create-ticket-reply-params) -> result<string, string>;

}

interface tags {
  /// Tags List
  get-tags: func() -> result<string, string>;

  /// New Tag Create
  record create-tag-params {
    /// A list of Domain IDs to apply the new Tag to.  You must be allowed to `read_write` all of the requested Domains, or the Tag will not be created and an error will be returned.
    domains: option<list<s32>>,
    /// The new Tag.
    label: string,
    /// A list of Linode IDs to apply the new Tag to.  You must be allowed to `read_write` all of the requested Linodes, or the Tag will not be created and an error will be returned.
    linodes: option<list<s32>>,
    /// A list of NodeBalancer IDs to apply the new Tag to. You must be allowed to `read_write` all of the requested NodeBalancers, or the Tag will not be created and an error will be returned.
    nodebalancers: option<list<s32>>,
    /// A list of Volume IDs to apply the new Tag to.  You must be allowed to `read_write` all of the requested Volumes, or the Tag will not be created and an error will be returned.
    volumes: option<list<s32>>
  }
  create-tag: func(params: create-tag-params) -> result<string, string>;

  /// Tagged Objects List
  get-tagged-objects: func() -> result<string, string>;

  /// Tag Delete
  delete-tag: func() -> result<string, string>;

}

interface volumes {
  /// The Volume's label is for display purposes only.
  record volume-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// The Volume's size, in GiB.
  record volume-properties-size {
    /// opaque schema; raw JSON
    value: string
  }

  /// Volumes List
  get-volumes: func() -> result<string, string>;

  /// Volume Create
  record create-volume-params {
    /// When creating a Volume attached to a Linode, the ID of the Linode Config to include the new Volume in. This Config must belong to the Linode referenced by `linode_id`. Must _not_ be provided if `linode_id` is not sent. If a `linode_id` is sent without a `config_id`, the volume will be attached:
    /// 
    config-id: option<s32>,
    /// The Volume's label, which is also used in the `filesystem_path` of the resulting volume.
    label: string,
    /// The Linode this volume should be attached to upon creation. If not given, the volume will be created without an attachment.
    linode-id: option<s32>,
    /// The Region to deploy this Volume in. This is only required if a linode_id is not given.
    region: option<string>,
    /// The initial size of this volume, in GB.  Be aware that volumes may only be resized up after creation.
    size: option<s32>,
    /// An array of Tags applied to this object.  Tags are for organizational purposes only.
    tags: option<list<string>>
  }
  create-volume: func(params: create-volume-params) -> result<string, string>;

  /// Volume View
  get-volume: func() -> result<string, string>;

  /// Volume Update
  record update-volume-params {
    body: string
  }
  update-volume: func(params: update-volume-params) -> result<string, string>;

  /// Volume Delete
  delete-volume: func() -> result<string, string>;

  /// Volume Attach
  record attach-volume-params {
    /// The ID of the Linode Config to include this Volume in. Must belong to the Linode referenced by `linode_id`. If not given, the last booted Config will be chosen.
    config-id: option<s32>,
    /// The ID of the Linode to attach the volume to.
    linode-id: s32,
    /// Defaults to true, if false is provided, the Volume will not be attached to the Linode Config. In this case more than 8 Volumes may be attached to a Linode if a Linode has 16GB of RAM or more. The number of volumes that can be attached is equal to the number of GB of RAM that the Linode has, up to a maximum of 64. `config_id` should not be passed if this is set to false and linode_id must be passed. The Linode must be running.
    persist-across-boots: option<bool>
  }
  attach-volume: func(params: attach-volume-params) -> result<string, string>;

  /// Volume Clone
  record clone-volume-params {
    label: volume-properties-label
  }
  clone-volume: func(params: clone-volume-params) -> result<string, string>;

  /// Volume Detach
  detach-volume: func() -> result<string, string>;

  /// Volume Resize
  record resize-volume-params {
    size: volume-properties-size
  }
  resize-volume: func(params: resize-volume-params) -> result<string, string>;

}
/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export account;
  export databases;
  export domains;
  export images;
  export linode-instances;
  export stack-scripts;
  export linode-types;
  export linode-kubernetes-engine-lke;
  export longview;
  export managed;
  export networking;
  export node-balancers;
  export object-storage;
  export profile;
  export regions;
  export support;
  export tags;
  export volumes;
}
