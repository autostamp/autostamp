  record post-databases-postgre-sql-instance-backup-restore-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-databases-postgre-sql-instance-credentials-reset-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-databases-postgre-sql-instance-patch-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-databases-types-response {
    /// The current [page](/docs/api/#pagination).
    page: option<s32>,
    /// The total number of [pages](/docs/api/#pagination).
    pages: option<s32>,
    /// The total number of results.
    results: option<s32>,
    data: option<list<database-type>>
  }

  /// Managed Database plan type object.
  record database-type {
    /// The compute class category.
    class: option<string>,
    /// Whether this Database plan type has been deprecated and is no longer available.
    deprecated: option<bool>,
    /// The amount of disk space set aside for Databases of this plan type. The value is represented in megabytes.
    disk: option<s32>,
    engines: option<database-type-engines>,
    /// The ID representing the Managed Database node plan type.
    id: option<string>,
    /// A human-readable string that describes each plan type. For display purposes only.
    label: option<string>,
    /// The amount of RAM allocated to Database created of this plan type. The value is represented in megabytes.
    memory: option<s32>,
    /// The integer of number CPUs allocated to databases of this plan type.
    vcpus: option<s32>
  }

  record database-type-engines {
    /// Pricing details for MongoDB Managed Databases.
    mongodb: option<list<database-type-engine>>,
    /// Pricing details for MySQL Managed Databases.
    mysql: option<list<database-type-engine>>,
    /// Pricing details for PostgreSQL Managed Databases.
    postgresql: option<list<database-type-engine>>
  }

  record database-type-engine {
    /// Cost in US dollars, broken down into hourly and monthly charges.
    price: option<database-type-engine-price>,
    /// The number of nodes for the Managed Database cluster for this subscription tier.
    quantity: option<s32>
  }

  /// Cost in US dollars, broken down into hourly and monthly charges.
  record database-type-engine-price {
    /// Cost (in US dollars) per hour for this subscription tier.
    hourly: option<f64>,
    /// Maximum cost (in US dollars) per month for this subscription tier.
    monthly: option<f64>
  }

  /// Managed Database Engines List
  record get-databases-engines-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-databases-engines: func(params: get-databases-engines-params) -> result<get-databases-engines-response, string>;

  /// Managed Database Engine View
  record get-databases-engine-params {
    /// The ID of the Managed Database engine.
    engine-id: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-databases-engine: func(params: get-databases-engine-params) -> result<database-engine, string>;

  /// Managed Databases List All
  record get-databases-instances-params {
