  /// User's Grants Update
  record update-user-grants-params {
    /// The username to look up.
    username: string,
    /// The grants this User has for each Database that is owned by this Account.
    database: option<list<grant>>,
    /// The grants this User has for each Domain that is owned by this Account.
    domain: option<list<grant>>,
    /// A structure containing the Account-level grants a User has.
    global: option<grants-response-global>,
    /// The grants this User has for each Image that is owned by this Account.
    image: option<list<grant>>,
    /// The grants this User has for each Linode that is owned by this Account.
    linode: option<list<grant>>,
    /// The grants this User has for each Longview Client that is owned by this Account.
    longview: option<list<grant>>,
    /// The grants this User has for each NodeBalancer that is owned by this Account.
    nodebalancer: option<list<grant>>,
    /// The grants this User has for each StackScript that is owned by this Account.
    stackscript: option<list<grant>>,
    /// The grants this User has for each Block Storage Volume that is owned by this Account.
    volume: option<list<grant>>
  }
  update-user-grants: func(params: update-user-grants-params) -> result<grants-response, string>;

}


interface databases {
  enum database-engine-enum {
    mongodb,
    mysql,
    postgresql,
  }

  enum database-status-enum {
    provisioning,
    active,
    suspending,
    suspended,
    resuming,
    restoring,
    failed,
    degraded,
    updating,
    backing-up,
  }

  enum database-updates-frequency-enum {
    weekly,
    monthly,
  }

  enum database-mongo-db-compression-type-enum {
    none,
    snappy,
    zlip,
  }

  enum database-mongo-db-storage-engine-enum {
    mmapv1,
    wiredtiger,
  }

  enum database-backup-type-op-enum {
    snapshot,
    auto,
  }

  enum database-backup-snapshot-target-enum {
    primary,
    secondary,
  }

  enum database-my-sql-replication-type-enum {
    none,
    asynch,
    semi-synch,
  }

  enum database-postgre-sql-replication-commit-type-enum {
    on,
    local,
    remote-write,
    remote-apply,
    off,
  }

  record get-databases-engines-response {
    /// The current [page](/docs/api/#pagination).
    page: option<s32>,
    /// The total number of [pages](/docs/api/#pagination).
    pages: option<s32>,
    /// The total number of results.
    results: option<s32>,
    data: option<list<database-engine>>
  }

  /// Managed Database engine object.
  record database-engine {
    /// The Managed Database engine type.
    engine: option<string>,
    /// The Managed Database engine ID in engine/version format.
    id: option<string>,
    /// The Managed Database engine version.
    version: option<string>
  }

  record get-databases-instances-response {
    /// The current [page](/docs/api/#pagination).
    page: option<s32>,
    /// The total number of [pages](/docs/api/#pagination).
    pages: option<s32>,
    /// The total number of results.
    results: option<s32>,
    data: option<list<database>>
  }

  /// A general Managed Database instance object containing properties that are identical for all database types.
  record database {
    /// A list of IP addresses that can access the Managed Database. Each item can be a single IP address or a range in CIDR format.
    /// 
    allow-list: option<list<string>>,
    /// The number of Linode Instance nodes deployed to the Managed Database.
    /// 
    cluster-size: option<s32>,
    /// When this Managed Database was created.
    created: option<string>,
    /// Whether the Managed Databases is encrypted.
    encrypted: option<bool>,
    /// The Managed Database engine type.
    engine: option<database-engine-enum>,
    /// The primary and secondary hosts for the Managed Database. These are assigned after provisioning is complete.
    hosts: option<database-hosts>,
    /// A unique ID that can be used to identify and reference the Managed Database.
    id: option<s32>,
    /// Append this to `https://api.linode.com` to run commands for the Managed Database.
    instance-uri: option<string>,
    /// A unique, user-defined string referring to the Managed Database.
    label: option<string>,
    /// The [Region](/docs/api/regions/) ID for the Managed Database.
    region: option<string>,
    /// The operating status of the Managed Database.
    status: option<database-status-enum>,
    /// The Linode Instance type used by the Managed Database for its nodes.
    type-op: option<string>,
    /// When this Managed Database was last updated.
    updated: option<string>,
    /// Configuration settings for automated patch update maintenance for the Managed Database.
    updates: option<database-updates>,
    /// The Managed Database engine version.
    version: option<string>
  }

  /// The primary and secondary hosts for the Managed Database. These are assigned after provisioning is complete.
  record database-hosts {
    /// The primary host for the Managed Database.
    primary: option<string>,
    /// The secondary/private network host for the Managed Database.
    /// 
    secondary: option<string>
  }

  /// Configuration settings for automated patch update maintenance for the Managed Database.
  record database-updates {
    /// The day to perform maintenance. 1=Monday, 2=Tuesday, etc.
    day-of-week: option<s32>,
    /// The maximum maintenance window time in hours.
    duration: option<s32>,
    /// Whether maintenance occurs on a weekly or monthly basis.
    frequency: option<database-updates-frequency-enum>,
    /// The hour to begin maintenance based in UTC time.
    hour-of-day: option<s32>,
    /// The week of the month to perform `monthly` frequency updates. Defaults to `null`.
    /// 
    week-of-month: option<s32>
  }

  record get-databases-mongo-db-instances-response {
    /// The current [page](/docs/api/#pagination).
    page: option<s32>,
    /// The total number of [pages](/docs/api/#pagination).
    pages: option<s32>,
    /// The total number of results.
    results: option<s32>,
    data: option<list<database-mongo-db>>
  }

  /// Managed MongoDB Databases object.
  record database-mongo-db {
    allow-list: option<database-properties-allow-list>,
    cluster-size: option<database-properties-cluster-size>,
    /// The type of data compression for this Database.
    /// 
    compression-type: option<database-mongo-db-compression-type-enum>,
    created: option<database-properties-created>,
    encrypted: option<database-properties-encrypted>,
    /// The Managed Database engine type.
    engine: option<string>,
    /// The primary and secondary hosts for the Managed Database. These are assigned after provisioning is complete.
    hosts: option<database-mongo-db-hosts>,
    id: option<database-properties-id>,
    label: option<database-properties-label>,
    /// An array of peer addresses for this Database.
    peers: option<list<string>>,
    /// The access port for this Managed Database.
    port: option<s32>,
    region: option<database-properties-region>,
    /// Label for configuring a MongoDB [replica set](https://www.mongodb.com/docs/manual/replication/). Choose the same label on multiple Databases to include them in the same replica set.
    /// 
    replica-set: option<string>,
    /// Whether to require SSL credentials to establish a connection to the Managed Database.
    /// 
    ssl-connection: option<bool>,
    status: option<database-properties-status>,
    /// The type of storage engine for this Database.
    /// 
    storage-engine: option<database-mongo-db-storage-engine-enum>,
    type-op: option<database-properties-type>,
    updated: option<database-properties-updated>,
    updates: option<database-properties-updates>,
    /// The Managed Database engine version.
    version: option<string>
  }

  /// A list of IP addresses that can access the Managed Database. Each item can be a single IP address or a range in CIDR format.
  /// 
  /// By default, this is an empty array (`[]`), which blocks all connections (both public and private) to the Managed Database.
  /// 
  /// If `0.0.0.0/0` is a value in this list, then all IP addresses can access the Managed Database.
  record database-properties-allow-list {
    /// opaque schema; raw JSON
    value: string
  }

  /// The number of Linode Instance nodes deployed to the Managed Database.
  /// 
  /// Choosing 3 nodes creates a high availability cluster consisting of 1 primary node and 2 replica nodes.
  record database-properties-cluster-size {
    /// opaque schema; raw JSON
    value: string
  }

  /// When this Managed Database was created.
  record database-properties-created {
    /// opaque schema; raw JSON
    value: string
  }

  /// Whether the Managed Databases is encrypted.
  record database-properties-encrypted {
    /// opaque schema; raw JSON
    value: string
  }

  /// The primary and secondary hosts for the Managed Database. These are assigned after provisioning is complete.
  record database-mongo-db-hosts {
    /// The primary host for the Managed Database.
    primary: option<string>,
    /// The secondary/private network host for the Managed Database.
    /// 
    secondary: option<string>
  }

  /// A unique ID that can be used to identify and reference the Managed Database.
  record database-properties-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// A unique, user-defined string referring to the Managed Database.
  record database-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// The [Region](/docs/api/regions/) ID for the Managed Database.
  record database-properties-region {
    /// opaque schema; raw JSON
    value: string
  }

  /// The operating status of the Managed Database.
  record database-properties-status {
    /// opaque schema; raw JSON
    value: string
  }

  /// The Linode Instance type used by the Managed Database for its nodes.
  record database-properties-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// When this Managed Database was last updated.
  record database-properties-updated {
    /// opaque schema; raw JSON
    value: string
  }

  /// Configuration settings for automated patch update maintenance for the Managed Database.
  record database-properties-updates {
    /// The day to perform maintenance. 1=Monday, 2=Tuesday, etc.
    day-of-week: option<s32>,
    /// The maximum maintenance window time in hours.
    duration: option<s32>,
    /// Whether maintenance occurs on a weekly or monthly basis.
    frequency: option<database-updates-frequency-enum>,
    /// The hour to begin maintenance based in UTC time.
    hour-of-day: option<s32>,
    /// The week of the month to perform `monthly` frequency updates. Defaults to `null`.
    /// 
    week-of-month: option<s32>
  }

  /// A list of IP addresses that can access the Managed Database. Each item can be a single IP address or a range in CIDR format.
  /// 
  /// By default, this is an empty array (`[]`), which blocks all connections (both public and private) to the Managed Database.
  /// 
  /// If `0.0.0.0/0` is a value in this list, then all IP addresses can access the Managed Database.
  record database-mongo-db-request-properties-allow-list {
    /// opaque schema; raw JSON
    value: string
  }

  /// A unique, user-defined string referring to the Managed Database.
  record database-mongo-db-request-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// Configuration settings for automated patch update maintenance for the Managed Database.
  record database-mongo-db-properties-updates {
    /// The day to perform maintenance. 1=Monday, 2=Tuesday, etc.
    day-of-week: option<s32>,
    /// The maximum maintenance window time in hours.
    duration: option<s32>,
    /// Whether maintenance occurs on a weekly or monthly basis.
    frequency: option<database-updates-frequency-enum>,
    /// The hour to begin maintenance based in UTC time.
    hour-of-day: option<s32>,
    /// The week of the month to perform `monthly` frequency updates. Defaults to `null`.
    /// 
    week-of-month: option<s32>
  }

  record delete-databases-mongo-db-instance-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-databases-mongo-db-instance-backups-response {
    /// The current [page](/docs/api/#pagination).
    page: option<s32>,
    /// The total number of [pages](/docs/api/#pagination).
    pages: option<s32>,
    /// The total number of results.
    results: option<s32>,
    data: option<list<database-backup>>
  }

  /// A database backup object.
  record database-backup {
    /// A time value given in a combined date and time format that represents when the database backup was created.
    created: option<string>,
    /// The ID of the database backup object.
    id: option<s32>,
    /// The database backup's label, for display purposes only.
    /// 
    label: option<string>,
    /// The type of database backup, determined by how the backup was created.
    type-op: option<database-backup-type-op-enum>
  }

  record post-databases-mongo-db-instance-backup-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record delete-database-mongo-db-instance-backup-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-databases-mongo-db-instance-backup-restore-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Managed Database object for database credentials.
  record database-credentials {
    /// The randomly-generated root password for the Managed Database instance.
    password: option<string>,
    /// The root username for the Managed Database instance.
    username: option<string>
  }

  record post-databases-mongo-db-instance-credentials-reset-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-databases-mongo-db-instance-patch-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Managed Database SSL object.
  record database-ssl {
    /// The base64-encoded SSL CA certificate for the Managed Database instance.
    ca-certificate: option<string>
  }

  record get-databases-my-sql-instances-response {
    /// The current [page](/docs/api/#pagination).
    page: option<s32>,
    /// The total number of [pages](/docs/api/#pagination).
    pages: option<s32>,
    /// The total number of results.
    results: option<s32>,
    data: option<list<database-my-sql>>
  }

  /// Managed MySQL Databases object.
  record database-my-sql {
    allow-list: option<database-properties-allow-list>,
    cluster-size: option<database-properties-cluster-size>,
    created: option<database-properties-created>,
    encrypted: option<database-properties-encrypted>,
    /// The Managed Database engine type.
    engine: option<string>,
    hosts: option<database-properties-hosts>,
    id: option<database-properties-id>,
    label: option<database-properties-label>,
    /// The access port for this Managed Database.
    port: option<s32>,
    region: option<database-properties-region>,
    /// The replication method used for the Managed Database.
    /// 
    replication-type: option<database-my-sql-replication-type-enum>,
    /// Whether to require SSL credentials to establish a connection to the Managed Database.
    /// 
    ssl-connection: option<bool>,
    status: option<database-properties-status>,
    type-op: option<database-properties-type>,
    updated: option<database-properties-updated>,
    updates: option<database-properties-updates>,
    /// The Managed Database engine version.
    version: option<string>
  }

  /// The primary and secondary hosts for the Managed Database. These are assigned after provisioning is complete.
  record database-properties-hosts {
    /// The primary host for the Managed Database.
    primary: option<string>,
    /// The secondary/private network host for the Managed Database.
    /// 
    secondary: option<string>
  }

  /// A list of IP addresses that can access the Managed Database. Each item can be a single IP address or a range in CIDR format.
  /// 
  /// By default, this is an empty array (`[]`), which blocks all connections (both public and private) to the Managed Database.
  /// 
  /// If `0.0.0.0/0` is a value in this list, then all IP addresses can access the Managed Database.
  record database-my-sql-properties-allow-list {
    /// opaque schema; raw JSON
    value: string
  }

  /// The number of Linode Instance nodes deployed to the Managed Database.
  /// 
  /// Choosing 3 nodes creates a high availability cluster consisting of 1 primary node and 2 replica nodes.
  record database-my-sql-properties-cluster-size {
    /// opaque schema; raw JSON
    value: string
  }

  /// Whether the Managed Databases is encrypted.
  record database-my-sql-properties-encrypted {
    /// opaque schema; raw JSON
    value: string
  }

  /// A unique, user-defined string referring to the Managed Database.
  record database-my-sql-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// The [Region](/docs/api/regions/) ID for the Managed Database.
  record database-my-sql-properties-region {
    /// opaque schema; raw JSON
    value: string
  }

  /// The replication method used for the Managed Database.
  /// 
  /// Defaults to `none` for a single cluster and `semi_synch` for a high availability cluster.
  /// 
  /// Must be `none` for a single node cluster.
  /// 
  /// Must be `asynch` or `semi_synch` for a high availability cluster.
  record database-my-sql-properties-replication-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Whether to require SSL credentials to establish a connection to the Managed Database.
  /// 
  /// Use the **Managed MySQL Database Credentials View** ([GET /databases/mysql/instances/{instanceId}/credentials](/docs/api/databases/#managed-mysql-database-credentials-view)) command for access information.
