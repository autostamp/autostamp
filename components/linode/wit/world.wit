  /// CPU, IO, IPv4, and IPv6 statistics. Graph data, if available, is in "[timestamp, reading]" array format. Timestamp is a UNIX timestamp in EST.
  record linode-stats {
    /// Percentage of CPU used.
    cpu: option<list<list<f64>>>,
    /// Input/Output statistics.
    io: option<linode-stats-io>,
    /// IPv4 statistics.
    netv4: option<linode-stats-netv4>,
    /// IPv6 statistics.
    netv6: option<linode-stats-netv6>,
    /// The title for this data set.
    title: option<string>
  }

  /// Input/Output statistics.
  record linode-stats-io {
    /// Block/s written.
    io: option<list<list<f64>>>,
    /// Block/s written.
    swap: option<list<list<f64>>>
  }

  /// IPv4 statistics.
  record linode-stats-netv4 {
    /// Input stats for IPv4, measured in bits/s (bits/second).
    in: option<list<list<f64>>>,
    /// Output stats for IPv4, measured in bits/s (bits/second).
    out: option<list<list<f64>>>,
    /// Private IPv4 input statistics, measured in bits/s (bits/second).
    private-in: option<list<list<f64>>>,
    /// Private IPv4 output statistics, measured in bits/s (bits/second).
    private-out: option<list<list<f64>>>
  }

  /// IPv6 statistics.
  record linode-stats-netv6 {
    /// Input stats for IPv6, measured in bits/s (bits/second).
    in: option<list<list<f64>>>,
    /// Output stats for IPv6, measured in bits/s (bits/second).
    out: option<list<list<f64>>>,
    /// Private IPv6 input statistics, measured in bits/s (bits/second).
    private-in: option<list<list<f64>>>,
    /// Private IPv6 output statistics, measured in bits/s (bits/second).
    private-out: option<list<list<f64>>>
  }

  record get-linode-transfer-response {
    /// The amount of network transfer this Linode has used, in GB, past your monthly quota.
    billable: option<s32>,
    /// The amount of network transfer this Linode adds to your transfer pool, in GB, for the current month's billing cycle.
    quota: option<s32>,
    /// The amount of network transfer used by this Linode, in bytes, for the current month's billing cycle.
    used: option<s32>
  }

  record get-linode-transfer-by-year-month-response {
    /// The amount of inbound public network traffic received by this Linode, in bytes, for a specific year/month.
    bytes-in: option<s32>,
    /// The amount of outbound public network traffic sent by this Linode, in bytes, for a specific year/month.
    bytes-out: option<s32>,
    /// The total amount of public network traffic sent and received by this Linode, in bytes, for a specific year/month.
    bytes-total: option<s32>
  }

  record get-linode-volumes-response {
    data: option<list<volume>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A Block Storage Volume associated with your Account.
  record volume {
    /// When this Volume was created.
    created: option<string>,
    /// The full filesystem path for the Volume based on the Volume's label. Path is /dev/disk/by-id/scsi-0Linode_Volume_ + Volume label.
    filesystem-path: option<string>,
    /// The storage type of this Volume.
    hardware-type: option<volume-hardware-type-enum>,
    /// The unique ID of this Volume.
    id: option<s32>,
    /// The Volume's label is for display purposes only.
    label: option<string>,
    /// If a Volume is attached to a specific Linode, the ID of that Linode will be displayed here.
    linode-id: option<s32>,
    /// If a Volume is attached to a specific Linode, the label of that Linode will be displayed here.
    linode-label: option<string>,
    region: option<region-properties-id>,
    /// The Volume's size, in GiB.
    size: option<s32>,
    /// The current status of the volume.  Can be one of:
    /// 
    status: option<volume-status-enum>,
    /// An array of Tags applied to this object.  Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// When this Volume was last updated.
    updated: option<string>
  }

  /// The unique ID of this Region.
  record region-properties-id {
    /// opaque schema; raw JSON
    value: string
  }

  record get-kernels-response {
    data: option<list<kernel>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// Linux kernel object
  record kernel {
    /// The architecture of this Kernel.
    architecture: option<kernel-architecture-enum>,
    /// The date on which this Kernel was built.
    built: option<string>,
    /// If this Kernel is marked as deprecated, this field has a value of true; otherwise, this field is false.
    deprecated: option<bool>,
    /// The unique ID of this Kernel.
    id: option<string>,
    /// If this Kernel is suitable for KVM Linodes.
    kvm: option<bool>,
    /// The friendly name of this Kernel.
    label: option<string>,
    /// If this Kernel is suitable for paravirtualized operations.
    pvops: option<bool>,
    /// Linux Kernel version.
    version: option<string>,
    /// If this Kernel is suitable for Xen Linodes.
    xen: option<bool>
  }

  /// Linodes List
  record get-linode-instances-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-linode-instances: func(params: get-linode-instances-params) -> result<get-linode-instances-response, string>;

  /// Linode Create
  record create-linode-instance-params {
    body: string
  }
  create-linode-instance: func(params: create-linode-instance-params) -> result<linode, string>;

  /// Linode View
  record get-linode-instance-params {
    /// ID of the Linode to look up
    linode-id: string
  }
  get-linode-instance: func(params: get-linode-instance-params) -> result<linode, string>;

  /// Linode Update
  record update-linode-instance-params {
    /// ID of the Linode to look up
    linode-id: string,
    alerts: option<linode-alerts>,
    /// Information about this Linode's backups status. For information about available backups, see [/linode/instances/{linodeId}/backups](/docs/api/linode-instances/#backups-list).
    backups: option<linode-backups>,
    /// When this Linode was created.
    created: option<string>,
    /// A deprecated property denoting a group label for this Linode.
    group: option<string>,
    /// The Linode's host machine, as a UUID.
    host-uuid: option<string>,
    /// The virtualization software powering this Linode.
    hypervisor: option<linode-hypervisor-enum>,
    /// This Linode's ID which must be provided for all operations impacting this Linode.
    id: option<s32>,
    image: option<disk-request-properties-image>,
    /// This Linode's IPv4 Addresses. Each Linode is assigned a single public IPv4 address
    /// upon creation, and may get a single private IPv4 address if needed. You may need to
    ipv4: option<list<string>>,
    /// This Linode's IPv6 SLAAC address. This address is specific to a Linode, and may not be shared. If the Linode has not been assigned an IPv6 address, the return value will be `null`.
    ipv6: option<string>,
    /// The Linode's label is for display purposes only. If no label is provided for a Linode,
    /// a default will be assigned.
    label: option<string>,
    /// This is the [Region](/docs/api/regions/#regions-list) where the Linode was deployed. A Linode's region can only be changed by initiating a [cross data center migration](/docs/api/linode-instances/#dc-migrationpending-host-migration-initiate).
    region: option<string>,
    /// Information about the resources available to this Linode.
    specs: option<linode-specs>,
    /// A brief description of this Linode's current state. This field may change without direct action from you. For example, when a Linode goes into maintenance mode its status will display "stopped".
    status: option<linode-status-enum>,
    /// An array of tags applied to this object.  Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// This is the [Linode Type](/docs/api/linode-types/#types-list) that this Linode was deployed with.
    /// To change a Linode's Type, use [POST /linode/instances/{linodeId}/resize](/docs/api/linode-instances/#linode-resize).
    type-op: option<string>,
    /// When this Linode was last updated.
    updated: option<string>,
    /// The watchdog, named Lassie, is a Shutdown Watchdog that monitors your Linode and will reboot it if it powers off unexpectedly. It works by issuing a boot job when your Linode powers off without a shutdown job being responsible.
    /// To prevent a loop, Lassie will give up if there have been more than 5 boot jobs issued within 15 minutes.
    watchdog-enabled: option<bool>
  }
  update-linode-instance: func(params: update-linode-instance-params) -> result<linode, string>;

  /// Linode Delete
  record delete-linode-instance-params {
    /// ID of the Linode to look up
    linode-id: string
  }
  delete-linode-instance: func(params: delete-linode-instance-params) -> result<delete-linode-instance-response, string>;

  /// Backups List
  record get-backups-params {
    /// The ID of the Linode the backups belong to.
    linode-id: string
  }
  get-backups: func(params: get-backups-params) -> result<get-backups-response, string>;

  /// Snapshot Create
  record create-snapshot-params {
    /// The ID of the Linode the backups belong to.
    linode-id: string,
    /// The label for the new snapshot.
    label: string
  }
  create-snapshot: func(params: create-snapshot-params) -> result<backup, string>;

  /// Backups Cancel
  record cancel-backups-params {
    /// The ID of the Linode to cancel backup service for.
    linode-id: string
  }
  cancel-backups: func(params: cancel-backups-params) -> result<cancel-backups-response, string>;

  /// Backups Enable
  record enable-backups-params {
    /// The ID of the Linode to enable backup service for.
    linode-id: string
  }
  enable-backups: func(params: enable-backups-params) -> result<enable-backups-response, string>;

  /// Backup View
  record get-backup-params {
    /// The ID of the Linode the Backup belongs to.
    linode-id: string,
    /// The ID of the Backup to look up.
    backup-id: string
  }
  get-backup: func(params: get-backup-params) -> result<backup, string>;

  /// Backup Restore
  record restore-backup-params {
    /// The ID of the Linode that the Backup belongs to.
    linode-id: string,
    /// The ID of the Backup to restore.
    backup-id: string,
    /// The ID of the Linode to restore a Backup to.
    linode-id-v2: s32,
    /// If True, deletes all Disks and Configs on the target Linode
    /// before restoring.
    overwrite: option<bool>
  }
  restore-backup: func(params: restore-backup-params) -> result<restore-backup-response, string>;

  /// Linode Boot
  record boot-linode-instance-params {
    /// The ID of the Linode to boot.
    linode-id: string,
    /// The Linode Config ID to boot into.
    config-id: option<s32>
  }
  boot-linode-instance: func(params: boot-linode-instance-params) -> result<boot-linode-instance-response, string>;

  /// Linode Clone
  record clone-linode-instance-params {
    /// ID of the Linode to clone.
    linode-id: string,
    /// If this field is set to `true`, the created Linode will
    /// automatically be enrolled in the Linode Backup service. This
    backups-enabled: option<bool>,
    /// An array of configuration profile IDs.
    /// * If the `configs` parameter **is not provided**, then **all configuration profiles and their associated disks will be cloned** from the source Linode. Any disks specified by the `disks` parameter will also be cloned.
    configs: option<list<s32>>,
    /// An array of disk IDs.
    /// * If the `disks` parameter **is not provided**, then **no extra disks will be cloned** from the source Linode. All disks associated with the configuration profiles specified by the `configs` parameter will still be cloned.
    disks: option<list<s32>>,
    /// A label used to group Linodes for display. Linodes are not required to have a group.
    group: option<string>,
    /// The label to assign this Linode when cloning to a new Linode.
    /// * Can only be provided when cloning to a new Linode.
    label: option<string>,
    /// If an existing Linode is the target for the clone, the ID of that Linode. The existing Linode must have enough resources to accept the clone.
    linode-id-v2: option<s32>,
    /// If true, the created Linode will have private networking enabled and assigned a private IPv4 address.
    /// * Can only be provided when cloning to a new Linode.
    private-ip: option<bool>,
    /// This is the Region where the Linode will be deployed.
    /// To view all available Regions you can deploy to see [/regions](/docs/api/regions/#regions-list).
    region: option<string>,
    /// A Linode's Type determines what resources are available to
    /// it, including disk space, memory, and virtual cpus. The
    type-op: option<string>
  }
  clone-linode-instance: func(params: clone-linode-instance-params) -> result<linode, string>;

  /// Configuration Profiles List
  record get-linode-configs-params {
    /// ID of the Linode to look up Configuration profiles for.
    linode-id: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-linode-configs: func(params: get-linode-configs-params) -> result<get-linode-configs-response, string>;

  /// Configuration Profile Create
  record add-linode-config-params {
    /// ID of the Linode to look up Configuration profiles for.
    linode-id: string,
    body: string
  }
  add-linode-config: func(params: add-linode-config-params) -> result<linode-config, string>;

  /// Configuration Profile View
  record get-linode-config-params {
    /// The ID of the Linode whose Configuration profile to look up.
    linode-id: string,
    /// The ID of the Configuration profile to look up.
    config-id: string
  }
  get-linode-config: func(params: get-linode-config-params) -> result<linode-config, string>;

  /// Configuration Profile Update
  record update-linode-config-params {
    /// The ID of the Linode whose Configuration profile to look up.
    linode-id: string,
    /// The ID of the Configuration profile to look up.
    config-id: string,
    /// Optional field for arbitrary User comments on this Config.
    comments: option<string>,
    devices: option<devices>,
    /// Helpers enabled when booting to this Linode Config.
    helpers: option<linode-config-helpers>,
    /// The ID of this Config.
    id: option<s32>,
    interfaces: option<linode-config-interfaces>,
    /// A Kernel ID to boot a Linode with. Defaults to "linode/latest-64bit".
    kernel: option<string>,
    /// The Config's label is for display purposes only.
    label: option<string>,
    /// Defaults to the total RAM of the Linode.
    memory-limit: option<s32>,
    /// The root device to boot.
    /// * If no value or an invalid value is provided, root device will default to `/dev/sda`.
    root-device: option<string>,
    /// Defines the state of your Linode after booting. Defaults to `default`.
    run-level: option<linode-config-run-level-enum>,
    /// Controls the virtualization mode. Defaults to `paravirt`.
    /// * `paravirt` is suitable for most cases. Linodes running in paravirt mode
    virt-mode: option<linode-config-virt-mode-enum>
  }
  update-linode-config: func(params: update-linode-config-params) -> result<linode-config, string>;

  /// Configuration Profile Delete
  record delete-linode-config-params {
    /// The ID of the Linode whose Configuration profile to look up.
    linode-id: string,
    /// The ID of the Configuration profile to look up.
    config-id: string
  }
  delete-linode-config: func(params: delete-linode-config-params) -> result<delete-linode-config-response, string>;

  /// Disks List
  record get-linode-disks-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-linode-disks: func(params: get-linode-disks-params) -> result<get-linode-disks-response, string>;

  /// Disk Create
  record add-linode-disk-params {
    /// ID of the Linode to look up.
    linode-id: string,
    body: string
  }
  add-linode-disk: func(params: add-linode-disk-params) -> result<disk, string>;

  /// Disk View
  record get-linode-disk-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// ID of the Disk to look up.
    disk-id: string
  }
  get-linode-disk: func(params: get-linode-disk-params) -> result<disk, string>;

  /// Disk Update
  record update-disk-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// ID of the Disk to look up.
    disk-id: string,
    /// When this Disk was created.
    created: option<string>,
    /// The Disk filesystem can be one of:
    /// 
    filesystem: option<disk-filesystem-enum>,
    /// This Disk's ID which must be provided for all operations impacting this Disk.
    id: option<s32>,
    /// The Disk's label is for display purposes only.
    label: option<string>,
    /// The size of the Disk in MB.
    size: option<s32>,
    /// A brief description of this Disk's current state. This field may change without direct action from you, as a result of operations performed to the Disk or the Linode containing the Disk.
    status: option<disk-status-enum>,
    /// When this Disk was last updated.
    updated: option<string>
  }
  update-disk: func(params: update-disk-params) -> result<disk, string>;

  /// Disk Delete
  record delete-disk-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// ID of the Disk to look up.
    disk-id: string
  }
  delete-disk: func(params: delete-disk-params) -> result<delete-disk-response, string>;

  /// Disk Clone
  record clone-linode-disk-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// ID of the Disk to clone.
    disk-id: string
  }
  clone-linode-disk: func(params: clone-linode-disk-params) -> result<disk, string>;

  /// Disk Root Password Reset
  record reset-disk-password-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// ID of the Disk to look up.
    disk-id: string,
    /// The new root password for the OS installed on this Disk.
    /// The password must meet the complexity strength validation requirements for a strong password.
    password: string
  }
  reset-disk-password: func(params: reset-disk-password-params) -> result<reset-disk-password-response, string>;

  /// Disk Resize
  record resize-disk-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// ID of the Disk to look up.
    disk-id: string,
    /// The desired size, in MB, of the disk.
    size: s32
  }
  resize-disk: func(params: resize-disk-params) -> result<resize-disk-response, string>;

  /// Firewalls List
  record get-linode-firewalls-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-linode-firewalls: func(params: get-linode-firewalls-params) -> result<get-linode-firewalls-response, string>;

  /// Networking Information List
  record get-linode-i-ps-params {
    /// ID of the Linode to look up.
    linode-id: string
  }
  get-linode-i-ps: func(params: get-linode-i-ps-params) -> result<get-linode-i-ps-response, string>;

  /// IPv4 Address Allocate
  record add-linode-ip-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// Whether to create a public or private IPv4 address.
    public: bool,
    /// The type of address you are allocating. Only IPv4 addresses may be allocated through this endpoint.
    type-op: add-linode-ip-body-type-op-enum
  }
  add-linode-ip: func(params: add-linode-ip-params) -> result<ip-address, string>;

  /// IP Address View
  record get-linode-ip-params {
    /// The ID of the Linode to look up.
    linode-id: string,
    /// The IP address to look up.
    address: string
  }
  get-linode-ip: func(params: get-linode-ip-params) -> result<ip-address, string>;

  /// IP Address Update
  record update-linode-ip-params {
    /// The ID of the Linode to look up.
    linode-id: string,
    /// The IP address to look up.
    address: string,
    /// The reverse DNS assigned to this address. For public IPv4 addresses, this will be set to a default value provided by Linode if not explicitly set.
    rdns: string
  }
  update-linode-ip: func(params: update-linode-ip-params) -> result<ip-address, string>;

  /// IPv4 Address Delete
  record remove-linode-ip-params {
    /// The ID of the Linode to look up.
    linode-id: string,
    /// The IP address to look up.
    address: string
  }
  remove-linode-ip: func(params: remove-linode-ip-params) -> result<remove-linode-ip-response, string>;

  /// DC Migration/Pending Host Migration Initiate
  record migrate-linode-instance-params {
    /// ID of the Linode to migrate.
    linode-id: string,
    /// The region to which the Linode will be migrated. Must be a valid region slug. A list of regions can be viewed by using the [GET /regions](/docs/api/regions/#regions-list) endpoint. A cross data center migration will cancel a pending migration that has not yet been initiated.
    /// A cross data center migration will initiate a `linode_migrate_datacenter_create` event.
    region: option<string>,
    /// When initiating a cross DC migration, setting this value to true will also ensure that the Linode is upgraded to the latest generation of hardware that corresponds to your Linode's Type, if any free upgrades are available for it.
    /// If no free upgrades are available, and this value is set to true, then the endpoint will return a 400 error code and the migration will not be performed.
    upgrade: option<bool>
  }
  migrate-linode-instance: func(params: migrate-linode-instance-params) -> result<migrate-linode-instance-response, string>;

  /// Linode Upgrade
  record mutate-linode-instance-params {
    /// ID of the Linode to mutate.
    linode-id: string,
    /// Automatically resize disks when resizing a Linode. When resizing down to a smaller plan your Linode's data must fit within the smaller disk size.
    allow-auto-disk-resize: option<bool>
  }
  mutate-linode-instance: func(params: mutate-linode-instance-params) -> result<mutate-linode-instance-response, string>;

  /// Linode NodeBalancers View
  record get-linode-node-balancers-params {
    /// ID of the Linode to look up
    linode-id: string
  }
  get-linode-node-balancers: func(params: get-linode-node-balancers-params) -> result<get-linode-node-balancers-response, string>;

  /// Linode Root Password Reset
  record reset-linode-password-params {
    /// ID of the Linode for which to reset its root password.
    linode-id: string,
    /// The root user's password on this Linode. Linode passwords must meet a password strength score requirement that is calculated internally by the API. If the strength requirement is not met, you will receive a Password does not meet strength requirement error.
    root-pass: string
  }
  reset-linode-password: func(params: reset-linode-password-params) -> result<reset-linode-password-response, string>;

  /// Linode Reboot
  record reboot-linode-instance-params {
    /// ID of the linode to reboot.
    linode-id: string,
    /// The Linode Config ID to reboot into.  If null or omitted, the last booted config will be used.  If there was no last booted config and this Linode only has one config, it will be used.  If a config cannot be determined, an error will be returned.
    config-id: option<s32>
  }
  reboot-linode-instance: func(params: reboot-linode-instance-params) -> result<reboot-linode-instance-response, string>;

  /// Linode Rebuild
  record rebuild-linode-instance-params {
    /// ID of the Linode to rebuild.
    linode-id: string,
    body: string
  }
  rebuild-linode-instance: func(params: rebuild-linode-instance-params) -> result<linode, string>;

  /// Linode Boot into Rescue Mode
  record rescue-linode-instance-params {
    /// ID of the Linode to rescue.
    linode-id: string,
    devices: option<rescue-devices>
  }
  rescue-linode-instance: func(params: rescue-linode-instance-params) -> result<rescue-linode-instance-response, string>;

  /// Linode Resize
  record resize-linode-instance-params {
    /// ID of the Linode to resize.
    linode-id: string,
    /// Automatically resize disks when resizing a Linode. When resizing down to a smaller plan your Linode's data must fit within the smaller disk size.
    allow-auto-disk-resize: option<bool>,
    /// The ID representing the Linode Type.
    type-op: string
  }
  resize-linode-instance: func(params: resize-linode-instance-params) -> result<resize-linode-instance-response, string>;

  /// Linode Shut Down
  record shutdown-linode-instance-params {
    /// ID of the Linode to shutdown.
    linode-id: string
  }
  shutdown-linode-instance: func(params: shutdown-linode-instance-params) -> result<shutdown-linode-instance-response, string>;

  /// Linode Statistics View
  record get-linode-stats-params {
    /// ID of the Linode to look up.
    linode-id: string
  }
  get-linode-stats: func(params: get-linode-stats-params) -> result<linode-stats, string>;

  /// Statistics View (year/month)
  record get-linode-stats-by-year-month-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// Numeric value representing the year to look up.
    year: string,
    /// Numeric value representing the month to look up.
    month: string
  }
  get-linode-stats-by-year-month: func(params: get-linode-stats-by-year-month-params) -> result<linode-stats, string>;

  /// Network Transfer View
  record get-linode-transfer-params {
    /// ID of the Linode to look up.
    linode-id: string
  }
  get-linode-transfer: func(params: get-linode-transfer-params) -> result<get-linode-transfer-response, string>;

  /// Network Transfer View (year/month)
  record get-linode-transfer-by-year-month-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// Numeric value representing the year to look up.
    year: string,
    /// Numeric value representing the month to look up.
    month: string
  }
  get-linode-transfer-by-year-month: func(params: get-linode-transfer-by-year-month-params) -> result<get-linode-transfer-by-year-month-response, string>;

  /// Linode's Volumes List
  record get-linode-volumes-params {
    /// ID of the Linode to look up.
    linode-id: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-linode-volumes: func(params: get-linode-volumes-params) -> result<get-linode-volumes-response, string>;

  /// Kernels List
  record get-kernels-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-kernels: func(params: get-kernels-params) -> result<get-kernels-response, string>;

  /// Kernel View
  record get-kernel-params {
    /// ID of the Kernel to look up.
    kernel-id: string
  }
  get-kernel: func(params: get-kernel-params) -> result<kernel, string>;

}

interface stack-scripts {
  record get-stack-scripts-response {
    data: option<list<stack-script>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A StackScript enables you to quickly deploy a fully-configured application in an automated manner.
  record stack-script {
    /// The date this StackScript was created.
    created: option<string>,
    /// Count of currently active, deployed Linodes created from this StackScript.
    deployments-active: option<s32>,
    /// The total number of times this StackScript has been deployed.
    deployments-total: option<s32>,
    /// A description for the StackScript.
    description: option<string>,
    /// The unique ID of this StackScript.
    id: option<s32>,
    /// An array of Image IDs. These are the Images that can be deployed with this StackScript.
    /// 
    images: option<list<string>>,
    /// This determines whether other users can use your StackScript. **Once a StackScript is made public, it cannot be made private.**
    is-public: option<bool>,
    /// The StackScript's label is for display purposes only.
    label: option<string>,
    /// Returns `true` if this StackScript is owned by the account of the user making the request, and the user
    /// making the request is unrestricted or has access to this StackScript.
    mine: option<bool>,
    /// This field allows you to add notes for the set of revisions made to this StackScript.
    rev-note: option<string>,
    /// The script to execute when provisioning a new Linode with this StackScript.
    script: option<string>,
    /// The date this StackScript was last updated.
    updated: option<string>,
    /// This is a list of fields defined with a special syntax inside this StackScript that allow for supplying customized parameters during deployment. See [Declare User-Defined Fields (UDFs)](/docs/products/tools/stackscripts/guides/write-a-custom-script/#declare-user-defined-fields-udfs) for more information.
    user-defined-fields: option<list<user-defined-field>>,
    /// The Gravatar ID for the User who created the StackScript.
    user-gravatar-id: option<string>,
    /// The User who created the StackScript.
    username: option<string>
  }

  /// A custom field defined by the User with a special syntax within a StackScript. Derived from the contents of the script.
  record user-defined-field {
    /// The default value.  If not specified, this value will be used.
    default: option<string>,
    /// An example value for the field.
    example: string,
    /// A human-readable label for the field that will serve as the input prompt for entering the value during deployment.
    label: string,
    /// A list of acceptable values for the field in any quantity, combination or order.
    many-of: option<string>,
    /// The name of the field.
    name: string,
    /// A list of acceptable single values for the field.
    one-of: option<string>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-stack-script-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// StackScripts List
  record get-stack-scripts-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-stack-scripts: func(params: get-stack-scripts-params) -> result<get-stack-scripts-response, string>;

  /// StackScript Create
  record add-stack-script-params {
    body: string
  }
  add-stack-script: func(params: add-stack-script-params) -> result<stack-script, string>;

  /// StackScript View
  record get-stack-script-params {
    /// The ID of the StackScript to look up.
    stackscript-id: string
  }
  get-stack-script: func(params: get-stack-script-params) -> result<stack-script, string>;

  /// StackScript Update
  record update-stack-script-params {
    /// The ID of the StackScript to look up.
    stackscript-id: string,
    /// The date this StackScript was created.
    created: option<string>,
    /// Count of currently active, deployed Linodes created from this StackScript.
    deployments-active: option<s32>,
    /// The total number of times this StackScript has been deployed.
    deployments-total: option<s32>,
    /// A description for the StackScript.
    description: option<string>,
    /// The unique ID of this StackScript.
    id: option<s32>,
    /// An array of Image IDs. These are the Images that can be deployed with this StackScript.
    /// 
    images: option<list<string>>,
    /// This determines whether other users can use your StackScript. **Once a StackScript is made public, it cannot be made private.**
    is-public: option<bool>,
    /// The StackScript's label is for display purposes only.
    label: option<string>,
    /// Returns `true` if this StackScript is owned by the account of the user making the request, and the user
    /// making the request is unrestricted or has access to this StackScript.
    mine: option<bool>,
    /// This field allows you to add notes for the set of revisions made to this StackScript.
    rev-note: option<string>,
    /// The script to execute when provisioning a new Linode with this StackScript.
    script: option<string>,
    /// The date this StackScript was last updated.
    updated: option<string>,
    /// This is a list of fields defined with a special syntax inside this StackScript that allow for supplying customized parameters during deployment. See [Declare User-Defined Fields (UDFs)](/docs/products/tools/stackscripts/guides/write-a-custom-script/#declare-user-defined-fields-udfs) for more information.
    user-defined-fields: option<list<user-defined-field>>,
    /// The Gravatar ID for the User who created the StackScript.
    user-gravatar-id: option<string>,
    /// The User who created the StackScript.
    username: option<string>
  }
  update-stack-script: func(params: update-stack-script-params) -> result<stack-script, string>;

  /// StackScript Delete
  record delete-stack-script-params {
    /// The ID of the StackScript to look up.
    stackscript-id: string
  }
  delete-stack-script: func(params: delete-stack-script-params) -> result<delete-stack-script-response, string>;

}

interface linode-types {
  enum linode-type-class-enum {
    nanode,
    standard,
    dedicated,
    gpu,
    highmem,
  }

  record get-linode-types-response {
    data: option<list<linode-type>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// Returns collection of Linode types, including pricing and specifications for each type. These are used when [creating](/docs/api/linode-instances/#linode-create) or [resizing](/docs/api/linode-instances/#linode-resize) Linodes.
  record linode-type {
    /// A list of optional add-on services for Linodes and their associated costs.
    addons: option<linode-type-addons>,
    /// The class of the Linode Type. We currently offer five classes of Linodes:
    /// 
    class: option<linode-type-class-enum>,
    /// The Disk size, in MB, of the Linode Type.
    disk: option<s32>,
    /// The number of GPUs this Linode Type offers.
    gpus: option<s32>,
    /// The ID representing the Linode Type.
    id: option<string>,
    /// The Linode Type's label is for display purposes only.
    label: option<string>,
    /// Amount of RAM included in this Linode Type.
    memory: option<s32>,
    /// The Mbits outbound bandwidth allocation.
    network-out: option<s32>,
    /// Cost in US dollars, broken down into hourly and monthly charges.
    price: option<linode-type-price>,
    /// The Linode Type that a [mutate](/docs/api/linode-instances/#linode-upgrade) will upgrade to for a Linode of this type.  If "null", a Linode of this type may not mutate.
    successor: option<string>,
    /// The monthly outbound transfer amount, in MB.
    transfer: option<s32>,
    /// The number of VCPU cores this Linode Type offers.
    vcpus: option<s32>
  }

  /// A list of optional add-on services for Linodes and their associated costs.
  record linode-type-addons {
    /// Information about the optional Backup service offered for Linodes.
    backups: option<linode-type-addons-backups>
  }

  /// Information about the optional Backup service offered for Linodes.
  record linode-type-addons-backups {
    /// Cost of enabling Backups for this Linode Type.
    price: option<linode-type-addons-backups-price>
  }

  /// Cost of enabling Backups for this Linode Type.
  record linode-type-addons-backups-price {
    /// The cost (in US dollars) per hour to add Backups service.
    hourly: option<f64>,
    /// The cost (in US dollars) per month to add Backups service.
    monthly: option<f64>
  }

  /// Cost in US dollars, broken down into hourly and monthly charges.
  record linode-type-price {
    /// Cost (in US dollars) per hour.
    hourly: option<f64>,
    /// Cost (in US dollars) per month.
    monthly: option<f64>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  /// Types List
  get-linode-types: func() -> result<get-linode-types-response, string>;

  /// Type View
  record get-linode-type-params {
    /// The ID of the Linode Type to look up.
    type-id: string
  }
  get-linode-type: func(params: get-linode-type-params) -> result<linode-type, string>;

}

interface linode-kubernetes-engine-lke {
  enum get-lke-cluster-node-response-status-enum {
    ready,
    not-ready,
  }

  enum lke-node-pool-disks-item-type-op-enum {
    raw,
    ext4,
  }

  record get-lke-clusters-response {
    data: option<list<lke-cluster>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A Kubernetes cluster.
  record lke-cluster {
    /// Defines settings for the Kubernetes Control Plane. Allows for the enabling of High Availability (HA) for Control Plane Components. Enabling High Avaialability for LKE is an **irreversible** change.
    control-plane: option<lke-cluster-control-plane>,
    /// When this Kubernetes cluster was created.
    created: option<string>,
    /// This Kubernetes cluster's unique ID.
    id: option<s32>,
    /// The desired Kubernetes version for this Kubernetes cluster in the format of &lt;major&gt;.&lt;minor&gt;, and the latest supported patch version will be deployed.
    k8s-version: option<string>,
    /// This Kubernetes cluster's unique label for display purposes only.
    /// Labels have the following constraints:
    label: option<string>,
    /// This Kubernetes cluster's location.
    region: option<string>,
    /// An array of tags applied to the Kubernetes cluster. Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// When this Kubernetes cluster was updated.
    updated: option<string>
  }

  /// Defines settings for the Kubernetes Control Plane. Allows for the enabling of High Availability (HA) for Control Plane Components. Enabling High Avaialability for LKE is an **irreversible** change.
  record lke-cluster-control-plane {
    /// Defines whether High Availability is enabled for the Control Plane Components of the cluster. Defaults to `false`.
    high-availability: option<bool>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  /// Defines settings for the Kubernetes Control Plane. Allows for the enabling of High Availability (HA) for Control Plane Components. Enabling High Availability for LKE is an **irreversible** change.
  record create-lke-cluster-body-control-plane {
    /// Defines whether High Availability is enabled for the Control Plane Components of the cluster. Defaults to `false`.
    high-availability: option<bool>
  }

  /// The desired Kubernetes version for this Kubernetes cluster in the format of &lt;major&gt;.&lt;minor&gt;, and the latest supported patch version will be deployed.
  record lke-cluster-properties-k8s-version {
    /// opaque schema; raw JSON
    value: string
  }

  /// This Kubernetes cluster's unique label for display purposes only.
  /// Labels have the following constraints:
  /// 
  ///   * UTF-8 characters will be returned by the API using escape
  ///     sequences of their Unicode code points. For example, the
  ///     Japanese character *か* is 3 bytes in UTF-8 (`0xE382AB`). Its
  ///     Unicode code point is 2 bytes (`0x30AB`). APIv4 supports this
  ///     character and the API will return it as the escape sequence
  ///     using six 1 byte characters which represent 2 bytes of Unicode
  ///     code point (`"\u30ab"`).
  ///   * 4 byte UTF-8 characters are not supported.
  ///   * If the label is entirely composed of UTF-8 characters, the API
  ///     response will return the code points using up to 193 1 byte
  ///     characters.
  record lke-cluster-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// This Kubernetes cluster's location.
  record lke-cluster-properties-region {
    /// opaque schema; raw JSON
    value: string
  }

  /// An array of tags applied to the Kubernetes cluster. Tags are for organizational purposes only.
  record lke-cluster-properties-tags {
    /// opaque schema; raw JSON
    value: string
  }

  /// Defines settings for the Kubernetes Control Plane. Allows for the enabling of High Availability (HA) for Control Plane Components.
  /// 
  /// Enabling High Availability for LKE is an **irreversible** change.
  /// 
  /// When upgrading pre-existing LKE clusters to use the HA Control Plane, the following changes will additionally occur:
  /// 
  /// - All nodes will be deleted and new nodes will be created to replace them.
  /// 
  /// - Any local storage (such as `hostPath` volumes) will be erased.
  /// 
  /// - The upgrade process may take several minutes to complete, as nodes will be replaced on a rolling basis.
  record put-lke-cluster-body-control-plane {
    /// Defines whether High Availability is enabled for the Control Plane Components of the cluster. Defaults to `false`.
    high-availability: option<bool>
  }

  record put-lke-cluster-response {
    created: option<lke-cluster-properties-created>,
    k8s-version: option<lke-cluster-properties-k8s-version>,
    label: option<lke-cluster-properties-label>,
    region: option<lke-cluster-properties-region>,
    /// An array of tags applied to the Kubernetes cluster. Tags are for organizational purposes only. To delete a tag, exclude it from your `tags` array.
    tags: option<list<string>>,
    updated: option<lke-cluster-properties-updated>
  }

  /// When this Kubernetes cluster was created.
  record lke-cluster-properties-created {
    /// opaque schema; raw JSON
    value: string
  }

  /// When this Kubernetes cluster was updated.
  record lke-cluster-properties-updated {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-lke-cluster-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-lke-cluster-api-endpoints-response {
    data: option<list<get-lke-cluster-api-endpoints-response-data-item>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// The Kubernetes API server endpoints for this cluster.
  record get-lke-cluster-api-endpoints-response-data-item {
    /// A Kubernetes API server endpoint for this cluster.
    endpoint: option<string>
  }

  record get-lke-cluster-dashboard-response {
    /// The Cluster Dashboard access URL.
    url: option<string>
  }

  record get-lke-cluster-kubeconfig-response {
    /// The Base64-encoded Kubeconfig file for this Cluster.
    kubeconfig: option<string>
  }

  record delete-lke-cluster-kubeconfig-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-lke-cluster-node-response {
    /// The Node's ID.
    id: option<string>,
    /// The Linode's ID. If no Linode is currently provisioned for this Node, this is `null`.
    instance-id: option<s32>,
    /// The creation status of this Node. This status is distinct from this Node's readiness as a Kubernetes Node Object as determined by the command `kubectl get nodes`.
    /// 
    status: option<get-lke-cluster-node-response-status-enum>
  }

  record delete-lke-cluster-node-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-lke-cluster-node-recycle-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-lke-cluster-pools-response {
    data: option<list<lke-node-pool>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// The set of Node Pools which are members of the Kubernetes cluster. Node Pools consist of a Linode type, the number of Linodes to deploy of that type, and additional status information.
  record lke-node-pool {
    /// When enabled, the number of nodes autoscales within the defined minimum and maximum values.
    autoscaler: option<lke-node-pool-autoscaler>,
    /// The number of nodes in the Node Pool.
    count: option<s32>,
    /// This Node Pool's custom disk layout.
    disks: option<list<lke-node-pool-disks-item>>,
    /// This Node Pool's unique ID.
    id: option<s32>,
    /// Status information for the Nodes which are members of this Node Pool. If a Linode has not been provisioned for a given Node slot, the instance_id will be returned as null.
    nodes: option<list<lke-node-status>>,
    /// An array of tags applied to this object. Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// The Linode Type for all of the nodes in the Node Pool.
    type-op: option<string>
  }

  /// When enabled, the number of nodes autoscales within the defined minimum and maximum values.
  record lke-node-pool-autoscaler {
    /// Whether autoscaling is enabled for this Node Pool. Defaults to `false`.
    enabled: option<bool>,
    /// The maximum number of nodes to autoscale to. Defaults to the Node Pool's `count`.
    max: option<s32>,
    /// The minimum number of nodes to autoscale to. Defaults to the Node Pool's `count`.
    min: option<s32>
  }

  /// The values to assign to each partition in this Node Pool's custom disk layout.
  record lke-node-pool-disks-item {
    /// The size of this custom disk partition in MB.
    /// 
    size: option<s32>,
    /// This custom disk partition's filesystem type.
    type-op: option<lke-node-pool-disks-item-type-op-enum>
  }

  /// Status information for a Node which is a member of a Kubernetes cluster.
  record lke-node-status {
    /// The Node's ID.
    id: option<string>,
    /// The Linode's ID. When no Linode is currently provisioned for this Node, this will be null.
    instance-id: option<string>,
    /// The Node's status as it pertains to being a Kubernetes node.
    status: option<get-lke-cluster-node-response-status-enum>
  }

  /// When enabled, the number of nodes autoscales within the defined minimum and maximum values.
  /// 
  /// When making a request, `max` and `min` require each other.
  record lke-node-pool-request-body-properties-autoscaler {
    /// Whether autoscaling is enabled for this Node Pool. Defaults to `false`.
    enabled: option<bool>,
    /// The maximum number of nodes to autoscale to. Defaults to the Node Pool's `count`. Defaults to the value provided by the `count` field.
    max: option<s32>,
    /// The minimum number of nodes to autoscale to. Defaults to the Node Pool's `count`.
    min: option<s32>
  }

  /// The number of nodes in the Node Pool.
  record lke-node-pool-request-body-properties-count {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-lke-node-pool-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-lke-cluster-pool-recycle-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-lke-cluster-recycle-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-lke-cluster-regenerate-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-lkec-service-token-delete-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-lke-versions-response {
    data: option<list<lke-version>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// LKE versions
  record lke-version {
    /// A Kubernetes version number available for deployment to a Kubernetes cluster in the format of &lt;major&gt;.&lt;minor&gt;, and the latest supported patch version.
    id: option<string>
  }

  /// Kubernetes Clusters List
  get-lke-clusters: func() -> result<get-lke-clusters-response, string>;

  /// Kubernetes Cluster Create
  record create-lke-cluster-params {
    /// Defines settings for the Kubernetes Control Plane. Allows for the enabling of High Availability (HA) for Control Plane Components. Enabling High Availability for LKE is an **irreversible** change.
    control-plane: option<create-lke-cluster-body-control-plane>,
    k8s-version: lke-cluster-properties-k8s-version,
    label: lke-cluster-properties-label,
    node-pools: string,
    region: lke-cluster-properties-region,
    tags: option<lke-cluster-properties-tags>
  }
  create-lke-cluster: func(params: create-lke-cluster-params) -> result<lke-cluster, string>;

  /// Kubernetes Cluster View
  record get-lke-cluster-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string
  }
  get-lke-cluster: func(params: get-lke-cluster-params) -> result<lke-cluster, string>;

  /// Kubernetes Cluster Update
  record put-lke-cluster-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string,
    /// Defines settings for the Kubernetes Control Plane. Allows for the enabling of High Availability (HA) for Control Plane Components.
    /// 
    control-plane: option<put-lke-cluster-body-control-plane>,
    /// The desired Kubernetes version for this Kubernetes cluster in the format of &lt;major&gt;.&lt;minor&gt;. New and recycled Nodes in this cluster will be installed with the latest available patch for the Cluster's Kubernetes version.
    /// 
    k8s-version: option<string>,
    label: option<lke-cluster-properties-label>,
    /// An array of tags applied to the Kubernetes cluster. Tags are for organizational purposes only. To delete a tag, exclude it from your `tags` array.
    tags: option<list<string>>
  }
  put-lke-cluster: func(params: put-lke-cluster-params) -> result<put-lke-cluster-response, string>;

  /// Kubernetes Cluster Delete
  record delete-lke-cluster-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string
  }
  delete-lke-cluster: func(params: delete-lke-cluster-params) -> result<delete-lke-cluster-response, string>;

  /// Kubernetes API Endpoints List
  record get-lke-cluster-api-endpoints-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string
  }
  get-lke-cluster-api-endpoints: func(params: get-lke-cluster-api-endpoints-params) -> result<get-lke-cluster-api-endpoints-response, string>;

  /// Kubernetes Cluster Dashboard URL View
  record get-lke-cluster-dashboard-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string
  }
  get-lke-cluster-dashboard: func(params: get-lke-cluster-dashboard-params) -> result<get-lke-cluster-dashboard-response, string>;

  /// Kubeconfig View
  record get-lke-cluster-kubeconfig-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string
  }
  get-lke-cluster-kubeconfig: func(params: get-lke-cluster-kubeconfig-params) -> result<get-lke-cluster-kubeconfig-response, string>;

  /// Kubeconfig Delete
  record delete-lke-cluster-kubeconfig-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string
  }
  delete-lke-cluster-kubeconfig: func(params: delete-lke-cluster-kubeconfig-params) -> result<delete-lke-cluster-kubeconfig-response, string>;

  /// Node View
  record get-lke-cluster-node-params {
    /// ID of the Kubernetes cluster containing the Node.
    cluster-id: string,
    /// ID of the Node to look up.
    node-id: string
  }
  get-lke-cluster-node: func(params: get-lke-cluster-node-params) -> result<get-lke-cluster-node-response, string>;

  /// Node Delete
  record delete-lke-cluster-node-params {
    /// ID of the Kubernetes cluster containing the Node.
    cluster-id: string,
    /// ID of the Node to look up.
    node-id: string
  }
  delete-lke-cluster-node: func(params: delete-lke-cluster-node-params) -> result<delete-lke-cluster-node-response, string>;

  /// Node Recycle
  record post-lke-cluster-node-recycle-params {
    /// ID of the Kubernetes cluster containing the Node.
    cluster-id: string,
    /// ID of the Node to be recycled.
    node-id: string
  }
  post-lke-cluster-node-recycle: func(params: post-lke-cluster-node-recycle-params) -> result<post-lke-cluster-node-recycle-response, string>;

  /// Node Pools List
  record get-lke-cluster-pools-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string
  }
  get-lke-cluster-pools: func(params: get-lke-cluster-pools-params) -> result<get-lke-cluster-pools-response, string>;

  /// Node Pool Create
  record post-lke-cluster-pools-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string,
    body: string
  }
  post-lke-cluster-pools: func(params: post-lke-cluster-pools-params) -> result<lke-node-pool, string>;

  /// Node Pool View
  record get-lke-node-pool-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string,
    /// ID of the Pool to look up
    pool-id: string
  }
  get-lke-node-pool: func(params: get-lke-node-pool-params) -> result<lke-node-pool, string>;

  /// Node Pool Update
  record put-lke-node-pool-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string,
    /// ID of the Pool to look up
    pool-id: string,
    autoscaler: option<lke-node-pool-request-body-properties-autoscaler>,
    count: option<lke-node-pool-request-body-properties-count>
  }
  put-lke-node-pool: func(params: put-lke-node-pool-params) -> result<lke-node-pool, string>;

  /// Node Pool Delete
  record delete-lke-node-pool-params {
    /// ID of the Kubernetes cluster to look up.
    cluster-id: string,
    /// ID of the Pool to look up
    pool-id: string
  }
  delete-lke-node-pool: func(params: delete-lke-node-pool-params) -> result<delete-lke-node-pool-response, string>;

  /// Node Pool Recycle
  record post-lke-cluster-pool-recycle-params {
    /// ID of the Kubernetes cluster this Node Pool is attached to.
    cluster-id: string,
    /// ID of the Node Pool to be recycled.
    pool-id: string
  }
  post-lke-cluster-pool-recycle: func(params: post-lke-cluster-pool-recycle-params) -> result<post-lke-cluster-pool-recycle-response, string>;

  /// Cluster Nodes Recycle
  record post-lke-cluster-recycle-params {
    /// ID of the Kubernetes cluster which contains nodes to be recycled.
    cluster-id: string
  }
  post-lke-cluster-recycle: func(params: post-lke-cluster-recycle-params) -> result<post-lke-cluster-recycle-response, string>;

  /// Kubernetes Cluster Regenerate
  record post-lke-cluster-regenerate-params {
    /// ID of the target Kubernetes cluster.
    cluster-id: string,
    /// Whether to delete and regenerate the Kubeconfig file for this Cluster.
    kubeconfig: option<bool>,
    /// Whether to delete and regenerate the service access token for this Cluster.
    servicetoken: option<bool>
  }
  post-lke-cluster-regenerate: func(params: post-lke-cluster-regenerate-params) -> result<post-lke-cluster-regenerate-response, string>;

  /// Service Token Delete
  record post-lkec-service-token-delete-params {
    /// ID of the target Kubernetes cluster.
    cluster-id: string
  }
  post-lkec-service-token-delete: func(params: post-lkec-service-token-delete-params) -> result<post-lkec-service-token-delete-response, string>;

  /// Kubernetes Versions List
  get-lke-versions: func() -> result<get-lke-versions-response, string>;

  /// Kubernetes Version View
  record get-lke-version-params {
    /// The LKE version to view.
    version: string
  }
  get-lke-version: func(params: get-lke-version-params) -> result<lke-version, string>;

}

interface longview {
  enum subscription-id-enum {
    longview-v3,
    longview-v10,
    longview-v40,
    longview-v100,
  }

  record get-longview-clients-response {
    data: option<list<client>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A LongviewClient is a single monitor set up to track statistics about one of your servers.
  record client {
    /// The API key for this Client, used when configuring the Longview
    /// Client application on your Linode.
    api-key: option<string>,
    /// The apps this Client is monitoring on your Linode. This is configured when you install the Longview Client application, and is present here for information purposes only.
    apps: option<client-apps>,
    /// When this Longview Client was created.
    created: option<string>,
    /// This Client's unique ID.
    id: option<s32>,
    /// The install code for this Client, used when configuring the Longview
    /// Client application on your Linode.
    install-code: option<string>,
    /// This Client's unique label. This is for display purposes only.
    label: option<string>,
    /// When this Longview Client was last updated.
    updated: option<string>
  }

  /// The apps this Client is monitoring on your Linode. This is configured when you install the Longview Client application, and is present here for information purposes only.
  record client-apps {
    /// If True, the Apache Longview Client module is monitoring Apache on your server.
    apache: option<bool>,
    /// If True, the MySQL Longview Client modules is monitoring MySQL on your server.
    mysql: option<bool>,
    /// If True, the Nginx Longview Client module is monitoring Nginx on your server.
    nginx: option<bool>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-longview-client-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A Longview Subscription represents a tier of Longview service you can subscribe to.
  record subscription {
    /// The number of Longview Clients that may be created with this Subscription tier.
    clients-included: option<s32>,
    /// The unique ID of this Subscription tier.
    id: option<subscription-id-enum>,
    /// A display name for this Subscription tier.
    label: option<string>,
    /// Pricing information about this Subscription tier.
    price: option<subscription-price>
  }

  /// Pricing information about this Subscription tier.
  record subscription-price {
    /// The hourly price, in US dollars, for this Subscription tier.
    hourly: option<f64>,
    /// The maximum monthly price in US Dollars for this Subscription tier. You will never be charged more than this amount per month for this subscription.
    monthly: option<f64>
  }

  record get-longview-subscriptions-response {
    data: option<list<subscription>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// Longview Clients List
  record get-longview-clients-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-longview-clients: func(params: get-longview-clients-params) -> result<get-longview-clients-response, string>;

  /// Longview Client Create
  record create-longview-client-params {
    /// The API key for this Client, used when configuring the Longview
    /// Client application on your Linode.
    api-key: option<string>,
    /// The apps this Client is monitoring on your Linode. This is configured when you install the Longview Client application, and is present here for information purposes only.
    apps: option<client-apps>,
    /// When this Longview Client was created.
    created: option<string>,
    /// This Client's unique ID.
    id: option<s32>,
    /// The install code for this Client, used when configuring the Longview
    /// Client application on your Linode.
    install-code: option<string>,
    /// This Client's unique label. This is for display purposes only.
    label: option<string>,
    /// When this Longview Client was last updated.
    updated: option<string>
  }
  create-longview-client: func(params: create-longview-client-params) -> result<client, string>;

  /// Longview Client View
  record get-longview-client-params {
    /// The Longview Client ID to access.
    client-id: string
  }
  get-longview-client: func(params: get-longview-client-params) -> result<client, string>;

  /// Longview Client Update
  record update-longview-client-params {
    /// The Longview Client ID to access.
    client-id: string,
    /// The API key for this Client, used when configuring the Longview
    /// Client application on your Linode.
    api-key: option<string>,
    /// The apps this Client is monitoring on your Linode. This is configured when you install the Longview Client application, and is present here for information purposes only.
    apps: option<client-apps>,
    /// When this Longview Client was created.
    created: option<string>,
    /// This Client's unique ID.
    id: option<s32>,
    /// The install code for this Client, used when configuring the Longview
    /// Client application on your Linode.
    install-code: option<string>,
    /// This Client's unique label. This is for display purposes only.
    label: option<string>,
    /// When this Longview Client was last updated.
    updated: option<string>
  }
  update-longview-client: func(params: update-longview-client-params) -> result<client, string>;

  /// Longview Client Delete
  record delete-longview-client-params {
    /// The Longview Client ID to access.
    client-id: string
  }
  delete-longview-client: func(params: delete-longview-client-params) -> result<delete-longview-client-response, string>;

  /// Longview Plan View
  get-longview-plan: func() -> result<subscription, string>;

  /// Longview Plan Update
  record update-longview-plan-params {
    /// The subscription ID for a particular Longview plan. A value of `null` corresponds to Longview Free.
    /// 
    longview-subscription: option<subscription-id-enum>
  }
  update-longview-plan: func(params: update-longview-plan-params) -> result<subscription, string>;

  /// Longview Subscriptions List
  record get-longview-subscriptions-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-longview-subscriptions: func(params: get-longview-subscriptions-params) -> result<get-longview-subscriptions-response, string>;

  /// Longview Subscription View
  record get-longview-subscription-params {
    /// The Longview Subscription to look up.
    subscription-id: string
  }
  get-longview-subscription: func(params: get-longview-subscription-params) -> result<subscription, string>;

}

interface managed {
  enum issue-entity-type-op-enum {
    ticket,
  }

  enum service-service-type-enum {
    url,
    tcp,
  }

  enum service-status-enum {
    disabled,
    pending,
    ok,
    problem,
  }

  record get-managed-contacts-response {
    data: option<list<contact>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// Information about someone Linode's special forces may contact in case an issue is detected with a manager service.
  record contact {
    /// The address to email this Contact to alert them of issues.
    email: option<string>,
    /// A grouping for this Contact. This is for display purposes only.
    group: option<string>,
    /// This Contact's unique ID.
    id: option<s32>,
    /// The name of this Contact.
    name: option<string>,
    /// Information about how to reach this Contact by phone.
    phone: option<contact-phone>,
    /// When this Contact was last updated.
    updated: option<string>
  }

  /// Information about how to reach this Contact by phone.
  record contact-phone {
    /// This Contact's primary phone number.
    primary: option<string>,
    /// This Contact's secondary phone number.
    secondary: option<string>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-managed-contact-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-managed-credentials-response {
    data: option<list<credential>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A securely-stored Credential that allows Linode's special forces to access a Managed server to respond to Issues.
  record credential {
    /// This Credential's unique ID.
    id: option<s32>,
    /// The unique label for this Credential. This is for display purposes only.
    label: option<string>,
    /// The date this Credential was last decrypted by a member of Linode special forces.
    last-decrypted: option<string>
  }

  /// A unique SSH public key that allows Linode's special forces to access a Managed server to respond to Issues.
  record view-managed-ssh-key-response {
    /// The unique SSH public key assigned to your Linode account's Managed service.
    ssh-key: option<string>
  }

  record delete-managed-credential-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record update-managed-credential-username-password-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-managed-issues-response {
    data: option<list<issue>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An Issue that was detected with a service Linode is managing.
  record issue {
    /// When this Issue was created. Issues are created in response to issues detected with Managed Services, so this is also when the Issue was detected.
    created: option<string>,
    /// The ticket this Managed Issue opened.
    entity: option<issue-entity>,
    /// This Issue's unique ID.
    id: option<s32>,
    /// An array of Managed Service IDs that were affected by this Issue.
    services: option<list<s32>>
  }

  /// The ticket this Managed Issue opened.
  record issue-entity {
    /// This ticket's ID
    id: option<s32>,
    /// The summary for this Ticket.
    label: option<string>,
    /// The type of entity this is. In this case, it is always a Ticket.
    type-op: option<issue-entity-type-op-enum>,
    /// The relative URL where you can access this Ticket.
    url: option<string>
  }

  record get-managed-linode-settings-response {
    data: option<list<linode-settings>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// Settings for a specific Linode related to Managed Services. There is one ManagedLinodeSettings object for each Linode on your Account.
  record linode-settings {
    /// The group of the Linode these Settings are for. This is for display purposes only.
    group: option<string>,
    /// The ID of the Linode these Settings are for.
    id: option<s32>,
    /// The label of the Linode these Settings are for.
    label: option<string>,
    /// The SSH settings for this Linode.
    ssh: option<linode-settings-ssh>
  }

  /// The SSH settings for this Linode.
  record linode-settings-ssh {
    /// If true, Linode special forces may access this Linode over ssh to respond to Issues.
    access: option<bool>,
    /// The IP Linode special forces should use to access this Linode
    /// when responding to an Issue.
    ip: option<string>,
    /// The port Linode special forces should use to access this Linode
    /// over ssh to respond to an Issue.
    port: option<s32>,
    /// The specific user, if any, Linode's special forces should use when accessing this
    /// Linode to respond to an issue.
    user: option<string>
  }

  record get-managed-services-response {
    data: option<list<service>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A service that Linode is monitoring as part of your Managed services. If issues are detected with this service, a ManagedIssue will be opened and, optionally, Linode special forces will attempt to resolve the Issue.
  record service {
    /// The URL at which this Service is monitored.
    /// 
    address: option<string>,
    /// What to expect to find in the response body for the Service to be considered up.
    body: option<string>,
    /// The group of ManagedContacts who should be notified or consulted with when an Issue is detected.
    consultation-group: option<string>,
    /// When this Managed Service was created.
    created: option<string>,
    /// An array of ManagedCredential IDs that should be used when attempting to resolve issues with this Service.
    credentials: option<list<s32>>,
    /// This Service's unique ID.
    id: option<s32>,
    /// The label for this Service. This is for display purposes only.
    label: option<string>,
    /// Any information relevant to the Service that Linode special forces should know when attempting to resolve Issues.
    notes: option<string>,
    /// The Region in which this Service is located. This is required if address is a private IP, and may not be set otherwise.
    region: option<string>,
    /// How this Service is monitored.
    service-type: option<service-service-type-enum>,
    /// The current status of this Service.
    status: option<service-status-enum>,
    /// How long to wait, in seconds, for a response before considering the Service to be down.
    timeout: option<s32>,
    /// When this Managed Service was last updated.
    updated: option<string>
  }

  record delete-managed-service-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-managed-stats-response {
    data: option<string>
  }

  /// Managed Contacts List
  record get-managed-contacts-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-managed-contacts: func(params: get-managed-contacts-params) -> result<get-managed-contacts-response, string>;

  /// Managed Contact Create
  record create-managed-contact-params {
    /// The address to email this Contact to alert them of issues.
    email: option<string>,
    /// A grouping for this Contact. This is for display purposes only.
    group: option<string>,
    /// This Contact's unique ID.
    id: option<s32>,
    /// The name of this Contact.
    name: option<string>,
    /// Information about how to reach this Contact by phone.
    phone: option<contact-phone>,
    /// When this Contact was last updated.
    updated: option<string>
  }
  create-managed-contact: func(params: create-managed-contact-params) -> result<contact, string>;

  /// Managed Contact View
  record get-managed-contact-params {
    /// The ID of the contact to access.
    contact-id: string
  }
  get-managed-contact: func(params: get-managed-contact-params) -> result<contact, string>;

  /// Managed Contact Update
  record update-managed-contact-params {
    /// The ID of the contact to access.
    contact-id: string,
    /// The address to email this Contact to alert them of issues.
    email: option<string>,
    /// A grouping for this Contact. This is for display purposes only.
    group: option<string>,
    /// This Contact's unique ID.
    id: option<s32>,
    /// The name of this Contact.
    name: option<string>,
    /// Information about how to reach this Contact by phone.
    phone: option<contact-phone>,
    /// When this Contact was last updated.
    updated: option<string>
  }
  update-managed-contact: func(params: update-managed-contact-params) -> result<contact, string>;

  /// Managed Contact Delete
  record delete-managed-contact-params {
    /// The ID of the contact to access.
    contact-id: string
  }
  delete-managed-contact: func(params: delete-managed-contact-params) -> result<delete-managed-contact-response, string>;

  /// Managed Credentials List
  record get-managed-credentials-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-managed-credentials: func(params: get-managed-credentials-params) -> result<get-managed-credentials-response, string>;

  /// Managed Credential Create
  record create-managed-credential-params {
    body: option<string>
  }
  create-managed-credential: func(params: create-managed-credential-params) -> result<credential, string>;

  /// Managed SSH Key View
  view-managed-ssh-key: func() -> result<view-managed-ssh-key-response, string>;

  /// Managed Credential View
  record get-managed-credential-params {
    /// The ID of the Credential to access.
    credential-id: string
  }
  get-managed-credential: func(params: get-managed-credential-params) -> result<credential, string>;

  /// Managed Credential Update
  record update-managed-credential-params {
    /// The ID of the Credential to access.
    credential-id: string,
    /// This Credential's unique ID.
    id: option<s32>,
    /// The unique label for this Credential. This is for display purposes only.
    label: option<string>,
    /// The date this Credential was last decrypted by a member of Linode special forces.
    last-decrypted: option<string>
  }
  update-managed-credential: func(params: update-managed-credential-params) -> result<credential, string>;

  /// Managed Credential Delete
  record delete-managed-credential-params {
    /// The ID of the Credential to access.
    credential-id: string
  }
  delete-managed-credential: func(params: delete-managed-credential-params) -> result<delete-managed-credential-response, string>;

  /// Managed Credential Username and Password Update
  record update-managed-credential-username-password-params {
    /// The ID of the Credential to update.
    credential-id: string,
    /// The password to use when accessing the Managed Service.
    password: string,
    /// The username to use when accessing the Managed Service.
    username: option<string>
  }
  update-managed-credential-username-password: func(params: update-managed-credential-username-password-params) -> result<update-managed-credential-username-password-response, string>;

  /// Managed Issues List
  record get-managed-issues-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-managed-issues: func(params: get-managed-issues-params) -> result<get-managed-issues-response, string>;

  /// Managed Issue View
  record get-managed-issue-params {
    /// The Issue to look up.
    issue-id: string
  }
  get-managed-issue: func(params: get-managed-issue-params) -> result<issue, string>;

  /// Managed Linode Settings List
  record get-managed-linode-settings-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-managed-linode-settings: func(params: get-managed-linode-settings-params) -> result<get-managed-linode-settings-response, string>;

  /// Linode's Managed Settings View
  record get-managed-linode-setting-params {
    /// The Linode ID whose settings we are accessing.
    linode-id: string
  }
  get-managed-linode-setting: func(params: get-managed-linode-setting-params) -> result<linode-settings, string>;

  /// Linode's Managed Settings Update
  record update-managed-linode-setting-params {
    /// The Linode ID whose settings we are accessing.
    linode-id: string,
    /// The group of the Linode these Settings are for. This is for display purposes only.
    group: option<string>,
    /// The ID of the Linode these Settings are for.
    id: option<s32>,
    /// The label of the Linode these Settings are for.
    label: option<string>,
    /// The SSH settings for this Linode.
    ssh: option<linode-settings-ssh>
  }
  update-managed-linode-setting: func(params: update-managed-linode-setting-params) -> result<linode-settings, string>;

  /// Managed Services List
  get-managed-services: func() -> result<get-managed-services-response, string>;

  /// Managed Service Create
  record create-managed-service-params {
    body: option<string>
  }
  create-managed-service: func(params: create-managed-service-params) -> result<service, string>;

  /// Managed Service View
  record get-managed-service-params {
    /// The ID of the Managed Service to access.
    service-id: string
  }
  get-managed-service: func(params: get-managed-service-params) -> result<service, string>;

  /// Managed Service Update
  record update-managed-service-params {
    /// The ID of the Managed Service to access.
    service-id: string,
    /// The URL at which this Service is monitored.
    /// 
    address: option<string>,
    /// What to expect to find in the response body for the Service to be considered up.
    body: option<string>,
    /// The group of ManagedContacts who should be notified or consulted with when an Issue is detected.
    consultation-group: option<string>,
    /// When this Managed Service was created.
    created: option<string>,
    /// An array of ManagedCredential IDs that should be used when attempting to resolve issues with this Service.
    credentials: option<list<s32>>,
    /// This Service's unique ID.
    id: option<s32>,
    /// The label for this Service. This is for display purposes only.
    label: option<string>,
    /// Any information relevant to the Service that Linode special forces should know when attempting to resolve Issues.
    notes: option<string>,
    /// The Region in which this Service is located. This is required if address is a private IP, and may not be set otherwise.
    region: option<string>,
    /// How this Service is monitored.
    service-type: option<service-service-type-enum>,
    /// The current status of this Service.
    status: option<service-status-enum>,
    /// How long to wait, in seconds, for a response before considering the Service to be down.
    timeout: option<s32>,
    /// When this Managed Service was last updated.
    updated: option<string>
  }
  update-managed-service: func(params: update-managed-service-params) -> result<service, string>;

  /// Managed Service Delete
  record delete-managed-service-params {
    /// The ID of the Managed Service to access.
    service-id: string
  }
  delete-managed-service: func(params: delete-managed-service-params) -> result<delete-managed-service-response, string>;

  /// Managed Service Disable
  record disable-managed-service-params {
    /// The ID of the Managed Service to disable.
    service-id: string
  }
  disable-managed-service: func(params: disable-managed-service-params) -> result<service, string>;

  /// Managed Service Enable
  record enable-managed-service-params {
    /// The ID of the Managed Service to enable.
    service-id: string
  }
  enable-managed-service: func(params: enable-managed-service-params) -> result<service, string>;

  /// Managed Stats List
  get-managed-stats: func() -> result<get-managed-stats-response, string>;

}

interface networking {
  enum firewall-rule-config-action-enum {
    accept,
    drop,
  }

  enum firewall-rule-config-protocol-enum {
    tcp,
    udp,
    icmp,
    ipencap,
  }

  enum firewall-status-enum {
    enabled,
    disabled,
    deleted,
  }

  enum update-firewall-body-status-enum {
    enabled,
    disabled,
  }

  enum firewall-devices-entity-type-op-enum {
    linode,
  }

  enum ip-address-type-op-enum {
    ipv4,
    ipv6,
    ipv6-pool,
    ipv6-range,
  }

  enum allocate-ip-body-type-op-enum {
    ipv4,
  }

  record get-firewalls-response {
    data: option<list<firewall>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A resource that controls incoming and outgoing network traffic to a Linode service. Only one Firewall can be attached to a Linode at any given time. [Create a Firewall Device](/docs/api/networking/#firewall-create) to assign a Firewall to a Linode service. Currently, Firewalls can only be assigned to Linode instances.
  record firewall {
    /// When this Firewall was created.
    created: option<string>,
    /// The Firewall's unique ID.
    id: option<s32>,
    /// The Firewall's label, for display purposes only.
    /// 
    label: option<string>,
    /// The inbound and outbound access rules to apply to the Firewall.
    /// 
    rules: option<firewall-rules>,
    /// The status of this Firewall.
    /// 
    status: option<firewall-status-enum>,
    /// An array of tags applied to this object. Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// When this Firewall was last updated.
    updated: option<string>
  }

  /// The inbound and outbound access rules to apply to the Firewall.
  /// 
  /// A Firewall may have up to 25 rules across its inbound and outbound rulesets.
  record firewall-rules {
    /// The inbound rules for the firewall, as a JSON array.
    inbound: option<list<firewall-rule-config>>,
    /// The default behavior for inbound traffic. This setting can be overridden by [updating](/docs/api/networking/#firewall-rules-update) the `inbound.action` property of the Firewall Rule.
    inbound-policy: option<firewall-rule-config-action-enum>,
    /// The outbound rules for the firewall, as a JSON array.
    outbound: option<list<firewall-rule-config>>,
    /// The default behavior for outbound traffic. This setting can be overridden by [updating](/docs/api/networking/#firewall-rules-update) the `outbound.action` property of the Firewall Rule.
    outbound-policy: option<firewall-rule-config-action-enum>
  }

  /// One of a Firewall's inbound or outbound access rules. The `ports` property can be used to allow traffic on a comma-separated list of different ports.
  record firewall-rule-config {
    /// Controls whether traffic is accepted or dropped by this rule. Overrides the Firewall's `inbound_policy` if this is an inbound rule, or the `outbound_policy` if this is an outbound rule.
    action: option<firewall-rule-config-action-enum>,
    /// Allowed IPv4 or IPv6 addresses. A Rule can have up to 255 addresses or networks listed across its IPv4 and IPv6 arrays. A network and a single IP are treated as equivalent when accounting for this limit.
    addresses: option<firewall-rule-config-addresses>,
    /// Used to describe this rule. For display purposes only.
    description: option<string>,
    /// Used to identify this rule. For display purposes only.
    label: option<string>,
    /// A string representing the port or ports on which traffic will be allowed:
    /// 
    ports: option<string>,
    /// The type of network traffic to allow.
    protocol: option<firewall-rule-config-protocol-enum>
  }

  /// Allowed IPv4 or IPv6 addresses. A Rule can have up to 255 addresses or networks listed across its IPv4 and IPv6 arrays. A network and a single IP are treated as equivalent when accounting for this limit.
  record firewall-rule-config-addresses {
    /// A list of IPv4 addresses or networks. Must be in IP/mask format.
    ipv4: option<list<string>>,
    /// A list of IPv6 addresses or networks. Must be in IP/mask format.
    ipv6: option<list<string>>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  /// Devices to create for this Firewall.
  /// When a Device is created, the Firewall is assigned to its associated service.
  /// Currently, Devices can only be created for Linode instances.
  record create-firewalls-body-devices {
    /// An array of Linode IDs. A Firewall Device is created for each ID.
    linodes: option<list<s32>>
  }

  record create-firewalls-body-rules {
    inbound: option<string>,
    outbound: option<string>
  }

  /// The Firewall's label, for display purposes only.
  /// 
  /// Firewall labels have the following constraints:
  /// 
  ///   * Must begin and end with an alphanumeric character.
  ///   * May only consist of alphanumeric characters, dashes (`-`), underscores (`_`) or periods (`.`).
  ///   * Cannot have two dashes (`--`), underscores (`__`) or periods (`..`) in a row.
  ///   * Must be between 3 and 32 characters.
  ///   * Must be unique.
  record firewall-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// An array of tags applied to this object. Tags are for organizational purposes only.
  record firewall-properties-tags {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-firewall-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-firewall-devices-response {
    data: option<list<firewall-devices>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// Associates a Firewall with a Linode service. A Firewall can be assigned to a single Linode service at a time. Additional disabled Firewalls can be assigned to a service, but they cannot be enabled if another active Firewall is already assigned to the same service.
  record firewall-devices {
    /// When this Device was created.
    created: option<string>,
    /// The Linode service that this Firewall has been applied to.
    entity: option<firewall-devices-entity>,
    /// The Device's unique ID
    id: option<s32>,
    /// When this Device was last updated.
    updated: option<string>
  }

  /// The Linode service that this Firewall has been applied to.
  record firewall-devices-entity {
    /// The entity's ID
    id: option<s32>,
    /// The entity's label.
    label: option<string>,
    /// The entity's type.
    type-op: option<firewall-devices-entity-type-op-enum>,
    /// The URL you can use to access this entity.
    url: option<string>
  }

  record delete-firewall-device-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The inbound and outbound access rules to apply to the Firewall.
  /// 
  /// A Firewall may have up to 25 rules across its inbound and outbound rulesets.
  record firewall-properties-rules {
    /// The inbound rules for the firewall, as a JSON array.
    inbound: option<list<firewall-rule-config>>,
    /// The default behavior for inbound traffic. This setting can be overridden by [updating](/docs/api/networking/#firewall-rules-update) the `inbound.action` property of the Firewall Rule.
    inbound-policy: option<firewall-rule-config-action-enum>,
    /// The outbound rules for the firewall, as a JSON array.
    outbound: option<list<firewall-rule-config>>,
    /// The default behavior for outbound traffic. This setting can be overridden by [updating](/docs/api/networking/#firewall-rules-update) the `outbound.action` property of the Firewall Rule.
    outbound-policy: option<firewall-rule-config-action-enum>
  }

  record get-i-ps-response {
    data: option<list<ip-address>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An IP address that exists in Linode's system, either IPv4 or IPv6.
  record ip-address {
    /// The IP address.
    address: option<string>,
    /// The default gateway for this address.
    gateway: option<string>,
    /// The ID of the Linode this address currently belongs to. For IPv4 addresses, this is by default the Linode that this address was assigned to on creation, and these addresses my be moved using the [/networking/ipv4/assign](/docs/api/networking/#ips-to-linodes-assign) endpoint. For SLAAC and link-local addresses, this value may not be changed.
    linode-id: option<s32>,
    /// The number of bits set in the subnet mask.
    prefix: option<s32>,
    /// Whether this is a public or private IP address.
    public: option<bool>,
    /// The reverse DNS assigned to this address. For public IPv4 addresses, this will be set to a default value provided by Linode if not explicitly set.
    rdns: option<string>,
    /// The Region this IP address resides in.
    region: option<string>,
    /// The mask that separates host bits from network bits for this address.
    subnet-mask: option<string>,
    /// The type of address this is.
    type-op: option<ip-address-type-op-enum>
  }

  record assign-i-ps-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record share-i-ps-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record assign-i-pv4s-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record share-i-pv4s-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-i-pv6-pools-response {
    data: option<list<i-pv6-pool>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An object representing an IPv6 pool.
  record i-pv6-pool {
    /// The prefix length of the address, denoting how many addresses can be assigned from this pool calculated as 2 <sup>128-prefix</sup>.
    prefix: option<s32>,
    /// The IPv6 range of addresses in this pool.
    range: option<string>,
    /// The region for this pool of IPv6 addresses.
    region: option<string>,
    /// The last address in this block of IPv6 addresses.
    route-target: option<string>
  }

  record get-i-pv6-ranges-response {
    data: option<list<i-pv6-range>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// An object representing an IPv6 range.
  record i-pv6-range {
    /// The prefix length of the address, denoting how many addresses can be assigned from this range calculated as 2 <sup>128-prefix</sup>.
    prefix: option<s32>,
    /// The IPv6 range of addresses in this pool.
    range: option<string>,
    /// The region for this range of IPv6 addresses.
    region: option<string>,
    /// The last address in this block of IPv6 addresses.
    route-target: option<string>
  }

  record post-i-pv6-range-response {
    /// The IPv6 network range, including subnet and prefix length.
    range: option<string>,
    /// The route target IPV6 SLAAC address for this range. Does not include the prefix length.
    route-target: option<string>
  }

  /// An object representing an IPv6 range.
  record i-pv6-range-bgp {
    /// Whether this IPv6 range is shared.
    is-bgp: option<bool>,
    /// A list of Linodes targeted by this IPv6 range. Includes Linodes with IP sharing.
    linodes: option<list<s32>>,
    /// The prefix length of the address, denoting how many addresses can be assigned from this range calculated as 2 <sup>128-prefix</sup>.
    prefix: option<s32>,
    /// The IPv6 range of addresses in this pool.
    range: option<string>,
    /// The region for this range of IPv6 addresses.
    region: option<string>
  }

  record delete-i-pv6-range-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-vla-ns-response {
    data: option<list<vlans>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// A virtual local area network (VLAN) associated with your Account.
  record vlans {
    /// The date this VLAN was created.
    created: option<string>,
    /// The name of this VLAN.
    label: option<string>,
    /// An array of Linode IDs attached to this VLAN.
    linodes: option<list<s32>>,
    /// This VLAN's data center region.
    /// 
    region: option<string>
  }

  /// Firewalls List
  record get-firewalls-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-firewalls: func(params: get-firewalls-params) -> result<get-firewalls-response, string>;

  /// Firewall Create
  record create-firewalls-params {
    /// Devices to create for this Firewall.
    /// When a Device is created, the Firewall is assigned to its associated service.
    devices: option<create-firewalls-body-devices>,
    rules: create-firewalls-body-rules
  }
  create-firewalls: func(params: create-firewalls-params) -> result<firewall, string>;

  /// Firewall View
  record get-firewall-params {
    /// ID of the Firewall to access.
    firewall-id: string
  }
  get-firewall: func(params: get-firewall-params) -> result<firewall, string>;

  /// Firewall Update
  record update-firewall-params {
    /// ID of the Firewall to access.
    firewall-id: string,
    label: option<firewall-properties-label>,
    /// The status to be applied to this Firewall.
    ///  
    status: option<update-firewall-body-status-enum>,
    tags: option<firewall-properties-tags>
  }
  update-firewall: func(params: update-firewall-params) -> result<firewall, string>;

  /// Firewall Delete
  record delete-firewall-params {
    /// ID of the Firewall to access.
    firewall-id: string
  }
  delete-firewall: func(params: delete-firewall-params) -> result<delete-firewall-response, string>;

  /// Firewall Devices List
  record get-firewall-devices-params {
    /// ID of the Firewall to access.
    firewall-id: string,
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-firewall-devices: func(params: get-firewall-devices-params) -> result<get-firewall-devices-response, string>;

  /// Firewall Device Create
  record create-firewall-device-params {
    /// ID of the Firewall to access.
    firewall-id: string,
    body: option<string>
  }
  create-firewall-device: func(params: create-firewall-device-params) -> result<firewall-devices, string>;

  /// Firewall Device View
  record get-firewall-device-params {
    /// ID of the Firewall to access.
    firewall-id: string,
    /// ID of the Firewall Device to access.
    device-id: string
  }
  get-firewall-device: func(params: get-firewall-device-params) -> result<firewall-devices, string>;

  /// Firewall Device Delete
  record delete-firewall-device-params {
    /// ID of the Firewall to access.
    firewall-id: string,
    /// ID of the Firewall Device to access.
    device-id: string
  }
  delete-firewall-device: func(params: delete-firewall-device-params) -> result<delete-firewall-device-response, string>;

  /// Firewall Rules List
  record get-firewall-rules-params {
    /// ID of the Firewall to access.
    firewall-id: string
  }
  get-firewall-rules: func(params: get-firewall-rules-params) -> result<firewall-properties-rules, string>;

  /// Firewall Rules Update
  record update-firewall-rules-params {
    /// ID of the Firewall to access.
    firewall-id: string,
    inbound: option<string>,
    outbound: option<string>
  }
  update-firewall-rules: func(params: update-firewall-rules-params) -> result<firewall-properties-rules, string>;

  /// IP Addresses List
  get-i-ps: func() -> result<get-i-ps-response, string>;

  /// IP Address Allocate
  record allocate-ip-params {
    /// The ID of a Linode you you have access to that this address will be allocated to.
    linode-id: s32,
    /// Whether to create a public or private IPv4 address.
    public: bool,
    /// The type of address you are requesting. Only IPv4 addresses may be allocated through this endpoint.
    type-op: allocate-ip-body-type-op-enum
  }
  allocate-ip: func(params: allocate-ip-params) -> result<ip-address, string>;

  /// IP Addresses Assign
  record assign-i-ps-params {
    /// The list of assignments to make. You must have read_write access to all IPs being assigned and all Linodes being assigned to in order for the assignments to succeed.
    assignments: string,
    /// The ID of the Region in which these assignments are to take place. All IPs and Linodes must exist in this Region.
    region: string
  }
  assign-i-ps: func(params: assign-i-ps-params) -> result<assign-i-ps-response, string>;

  /// IP Addresses Share
  record share-i-ps-params {
    /// A list of secondary Linode IPs to share with the primary Linode.
    /// * Can include both IPv4 addresses and IPv6 ranges (omit /56 and /64 prefix lengths)
    ips: list<string>,
    /// The ID of the primary Linode that the addresses will be shared with.
    linode-id: s32
  }
  share-i-ps: func(params: share-i-ps-params) -> result<share-i-ps-response, string>;

  /// IP Address View
  record get-ip-params {
    /// The address to operate on.
    address: string
  }
  get-ip: func(params: get-ip-params) -> result<ip-address, string>;

  /// IP Address RDNS Update
  record update-ip-params {
    /// The address to operate on.
    address: string,
    /// The reverse DNS assigned to this address. For public IPv4 addresses, this will be set to a default value provided by Linode if not explicitly set.
    rdns: string
  }
  update-ip: func(params: update-ip-params) -> result<ip-address, string>;

  /// Linodes Assign IPv4s
  record assign-i-pv4s-params {
    /// The list of assignments to make. You must have read_write access to all IPs being assigned and all Linodes being assigned to in order for the assignments to succeed.
    assignments: string,
    /// The ID of the Region in which these assignments are to take place. All IPs and Linodes must exist in this Region.
    region: string
  }
  assign-i-pv4s: func(params: assign-i-pv4s-params) -> result<assign-i-pv4s-response, string>;

  /// IPv4 Sharing Configure
  record share-i-pv4s-params {
    /// A list of secondary Linode IPs to share with the primary Linode.
    /// * Can include both IPv4 addresses and IPv6 ranges (omit /56 and /64 prefix lengths)
    ips: list<string>,
    /// The ID of the primary Linode that the addresses will be shared with.
    linode-id: s32
  }
  share-i-pv4s: func(params: share-i-pv4s-params) -> result<share-i-pv4s-response, string>;

  /// IPv6 Pools List
  record get-i-pv6-pools-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-i-pv6-pools: func(params: get-i-pv6-pools-params) -> result<get-i-pv6-pools-response, string>;

  /// IPv6 Ranges List
  record get-i-pv6-ranges-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-i-pv6-ranges: func(params: get-i-pv6-ranges-params) -> result<get-i-pv6-ranges-response, string>;

  /// IPv6 Range Create
  record post-i-pv6-range-params {
    /// The ID of the Linode to assign this range to. The SLAAC address for the provided Linode is used as the range's `route_target`.
    /// 
    linode-id: option<s32>,
    /// The prefix length of the IPv6 range.
    prefix-length: s32,
    /// The IPv6 SLAAC address to assign this range to.
    /// 
    route-target: option<string>
  }
  post-i-pv6-range: func(params: post-i-pv6-range-params) -> result<post-i-pv6-range-response, string>;

  /// IPv6 Range View
  record get-i-pv6-range-params {
    /// The IPv6 range to access. Corresponds to the `range` property of objects returned from the IPv6 Ranges List ([GET /networking/ipv6/ranges](/docs/api/networking/#ipv6-ranges-list)) command.
    /// 
    range: string
  }
  get-i-pv6-range: func(params: get-i-pv6-range-params) -> result<i-pv6-range-bgp, string>;

  /// IPv6 Range Delete
  record delete-i-pv6-range-params {
    /// The IPv6 range to access. Corresponds to the `range` property of objects returned from the IPv6 Ranges List ([GET /networking/ipv6/ranges](/docs/api/networking/#ipv6-ranges-list)) command.
    /// 
    range: string
  }
  delete-i-pv6-range: func(params: delete-i-pv6-range-params) -> result<delete-i-pv6-range-response, string>;

  /// VLANs List
  record get-vla-ns-params {
    /// The page of a collection to return.
    page: option<s32>,
    /// The number of items to return per page.
    page-size: option<s32>
  }
  get-vla-ns: func(params: get-vla-ns-params) -> result<get-vla-ns-response, string>;

}

interface node-balancers {
  enum node-balancer-config-algorithm-enum {
    roundrobin,
    leastconn,
    source,
  }

  enum node-balancer-config-check-enum {
    none,
    connection,
    http,
    http-body,
  }

  enum node-balancer-config-cipher-suite-enum {
    recommended,
    legacy,
  }

  enum node-balancer-config-protocol-enum {
    http,
    https,
    tcp,
  }

  enum node-balancer-config-proxy-protocol-enum {
    none,
    v1,
    v2,
  }

  enum node-balancer-config-stickiness-enum {
    none,
    table,
    http-cookie,
  }

  enum node-balancer-node-mode-enum {
    accept,
    reject,
    drain,
    backup,
  }

  enum node-balancer-node-status-enum {
    unknown,
    up,
    down,
  }

  record get-node-balancers-response {
    data: option<list<node-balancer>>,
    page: option<pagination-envelope-properties-page>,
    pages: option<pagination-envelope-properties-pages>,
    results: option<pagination-envelope-properties-results>
  }

  /// Linode's load balancing solution.  Can handle multiple ports, SSL termination, and any number of backends.  NodeBalancer ports are configured with NodeBalancer Configs, and each config is given one or more NodeBalancer Node that accepts traffic.  The traffic should be routed to the  NodeBalancer's ip address, the NodeBalancer will handle routing individual requests to backends.
  record node-balancer {
    /// Throttle connections per second.  Set to 0 (zero) to disable throttling.
    client-conn-throttle: option<s32>,
    /// When this NodeBalancer was created.
    created: option<string>,
    /// This NodeBalancer's hostname, beginning with its IP address and ending with _.ip.linodeusercontent.com_.
    hostname: option<string>,
    /// This NodeBalancer's unique ID.
    id: option<s32>,
    /// This NodeBalancer's public IPv4 address.
    ipv4: option<string>,
    /// This NodeBalancer's public IPv6 address.
    ipv6: option<string>,
    /// This NodeBalancer's label. These must be unique on your Account.
    label: option<string>,
    /// The Region where this NodeBalancer is located. NodeBalancers only support backends in the same Region.
    region: option<string>,
    /// An array of Tags applied to this object.  Tags are for organizational purposes only.
    tags: option<list<string>>,
    /// Information about the amount of transfer this NodeBalancer has had so far this month.
    transfer: option<node-balancer-transfer>,
    /// When this NodeBalancer was last updated.
    updated: option<string>
  }

  /// Information about the amount of transfer this NodeBalancer has had so far this month.
  record node-balancer-transfer {
    /// The total outbound transfer, in MB, used for this NodeBalancer this month.
    in: option<f64>,
    /// The total inbound transfer, in MB, used for this NodeBalancer this month.
    out: option<f64>,
    /// The total transfer, in MB, used by this NodeBalancer this month.
    total: option<f64>
  }

  /// The current [page](/docs/api/#pagination).
  record pagination-envelope-properties-page {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of [pages](/docs/api/#pagination).
  record pagination-envelope-properties-pages {
    /// opaque schema; raw JSON
    value: string
  }

  /// The total number of results.
  record pagination-envelope-properties-results {
    /// opaque schema; raw JSON
    value: string
  }

  /// Throttle connections per second.  Set to 0 (zero) to disable throttling.
  record node-balancer-properties-client-conn-throttle {
    /// opaque schema; raw JSON
    value: string
  }

  /// This NodeBalancer's label. These must be unique on your Account.
  record node-balancer-properties-label {
    /// opaque schema; raw JSON
    value: string
  }

