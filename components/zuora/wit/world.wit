  }
  post-custom-object-definitions: func(params: post-custom-object-definitions-params) -> result<string, string>;

  /// Retrieve a custom object definition
  record get-custom-object-definition-by-type-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string
  }
  get-custom-object-definition-by-type: func(params: get-custom-object-definition-by-type-params) -> result<string, string>;

  /// Delete a custom object definition
  record delete-custom-object-definition-by-type-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string
  }
  delete-custom-object-definition-by-type: func(params: delete-custom-object-definition-by-type-params) -> result<string, string>;

  /// Update a custom object definition
  record post-update-custom-object-definition-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>
  }
  post-update-custom-object-definition: func(params: post-update-custom-object-definition-params) -> result<string, string>;

}

interface custom-object-jobs {
  /// List all custom object bulk jobs
  record get-all-custom-object-bulk-jobs-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Page size of the result. The maximum page size is 100. The defaut page size is 25.
    page-size: option<s32>,
    /// The `cursor` points to the last job of the previous result set. The cursor job is not included in this query result. The call returns the first page if `cursor` is not provided and `pageSize` is valid.
    cursor: option<string>
  }
  get-all-custom-object-bulk-jobs: func(params: get-all-custom-object-bulk-jobs-params) -> result<string, string>;

  /// Submit a custom object bulk job
  record post-custom-object-bulk-job-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>
  }
  post-custom-object-bulk-job: func(params: post-custom-object-bulk-job-params) -> result<string, string>;

  /// Retrieve a custom object bulk job
  record get-custom-object-bulk-job-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// The ID of the custom object bulk job to be retrieved.
    id: string
  }
  get-custom-object-bulk-job: func(params: get-custom-object-bulk-job-params) -> result<string, string>;

  /// List all errors for a custom object bulk job
  record get-custom-object-bulk-job-errors-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// The ID of the custom object bulk job that you retrieve errors for.
    id: string
  }
  get-custom-object-bulk-job-errors: func(params: get-custom-object-bulk-job-errors-params) -> result<string, string>;

  /// Upload a file for a custom object bulk job
  record post-upload-file-for-custom-object-bulk-job-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// The `Content-Type` of the request must be `text/csv`.
    content-type: string,
    /// The ID of the custom object bulk job that the file is uploaded to.
    id: string
  }
  post-upload-file-for-custom-object-bulk-job: func(params: post-upload-file-for-custom-object-bulk-job-params) -> result<string, string>;

}

interface data-queries {
  enum get-data-query-jobs-query-status-enum {
    accepted,
    in-progress,
    completed,
    failed,
    cancelled,
  }

  /// List data query jobs
  record get-data-query-jobs-params {
    /// Filters the list of query jobs by status.
    query-status: option<get-data-query-jobs-query-status-enum>,
    /// Specifies the maximum number of query jobs to return.
    page-size: option<s32>
  }
  get-data-query-jobs: func(params: get-data-query-jobs-params) -> result<string, string>;

  /// Submit a data query
  post-data-query-job: func() -> result<string, string>;

  /// Retrieve a data query job
  record get-data-query-job-params {
    /// Internal identifier of the query job.
    job-id: string
  }
  get-data-query-job: func(params: get-data-query-job-params) -> result<string, string>;

  /// Cancel a data query job
  record delete-data-query-job-params {
    /// Internal identifier of the query job.
    job-id: string
  }
  delete-data-query-job: func(params: delete-data-query-job-params) -> result<string, string>;

}

interface settings {
  enum children-setting-value-request-method-enum {
    get,
    head,
    post,
    put,
    patch,
    delete,
    options,
    trace,
  }

  record setting-value-request {
    body: option<body-in-setting-value-request>,
    /// An array of requests that can only be executed after its parent request has been executed successfully.
    children: option<list<children-setting-value-request>>,
    /// The id of the request. You can set it to any string. It must be unique within the whole batch.
    id: option<string>,
    /// One of the HTTP methods supported by the setting endpoint, for example, GET,PUT,POST or DELETE.
    method: option<children-setting-value-request-method-enum>,
    /// The relative URL of the setting. It is the same as in the `pathPattern` field in the response body of [Listing all Settings](https://www.zuora.com/developer/api-reference/#operation/GET_ListAllSettings). For example, `/billing-rules`.
    url: option<string>
  }

  /// Request payload if any
  record body-in-setting-value-request {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record children-setting-value-request {
    body: option<body-in-setting-value-request>,
    /// The id of the request. You can set it to any string. It must be unique within the whole batch.
    id: option<string>,
    /// One of the HTTP methods supported by the setting endpoint, for example, GET,PUT,POST or DELETE.
    method: option<children-setting-value-request-method-enum>,
    /// The relative URL of the setting. It is the same as in the `pathPattern` field in the response body of [Listing all settings](https://www.zuora.com/developer/api-reference/#operation/GET_ListAllSettings). For example, `/billing-rules`.
    url: option<string>
  }

  /// Submit settings requests
  record post-process-settings-batch-request-params {
    requests: option<list<setting-value-request>>
  }
  post-process-settings-batch-request: func(params: post-process-settings-batch-request-params) -> result<string, string>;

  /// List all settings
  record get-list-all-settings-params {
    /// Specifies response media type. If you omit the `Accept` header parameter, the response body is by default in JSON format. If you include `Accept` header parameter and set it to `application/csv`, the response body is in csv format.
    accept: option<string>
  }
  get-list-all-settings: func(params: get-list-all-settings-params) -> result<string, string>;

}

interface accounting-codes {
  /// List all accounting codes
  get-all-accounting-codes: func() -> result<string, string>;

  /// Create an accounting code
  post-accounting-code: func() -> result<string, string>;

  /// Retrieve an accounting code
  record get-accounting-code-params {
    /// ID of the accounting code you want to query.
    ac-id: string
  }
  get-accounting-code: func(params: get-accounting-code-params) -> result<string, string>;

  /// Update an accounting code
  record put-accounting-code-params {
    /// ID of the accounting code you want to update.
    ac-id: string
  }
  put-accounting-code: func(params: put-accounting-code-params) -> result<string, string>;

  /// Delete an accounting code
  record delete-accounting-code-params {
    /// ID of the accounting code you want to delete.
    ac-id: string
  }
  delete-accounting-code: func(params: delete-accounting-code-params) -> result<string, string>;

  /// Activate an accounting code
  record put-activate-accounting-code-params {
    /// ID of the accounting code you want to activate.
    ac-id: string
  }
  put-activate-accounting-code: func(params: put-activate-accounting-code-params) -> result<string, string>;

  /// Deactivate an accounting code
  record put-deactivate-accounting-code-params {
    /// ID of the accounting code you want to deactivate.
    ac-id: string
  }
  put-deactivate-accounting-code: func(params: put-deactivate-accounting-code-params) -> result<string, string>;

}

interface accounting-periods {
  /// List all accounting periods
  get-all-accounting-periods: func() -> result<string, string>;

  /// Create an accounting period
  post-accounting-period: func() -> result<string, string>;

  /// Retrieve an accounting period
  record get-accounting-period-params {
    /// ID of the accounting period you want to get.
    ap-id: string
  }
  get-accounting-period: func(params: get-accounting-period-params) -> result<string, string>;

  /// Update an accounting period
  record put-update-accounting-period-params {
    /// ID of the accounting period you want to update.
    ap-id: string
  }
  put-update-accounting-period: func(params: put-update-accounting-period-params) -> result<string, string>;

  /// Delete an accounting period
  record delete-accounting-period-params {
    /// ID of the accounting period you want to delete.
    ap-id: string
  }
  delete-accounting-period: func(params: delete-accounting-period-params) -> result<string, string>;

  /// Close an accounting period
  record put-close-accounting-period-params {
    /// ID of the accounting period you want to close.
    ap-id: string
  }
  put-close-accounting-period: func(params: put-close-accounting-period-params) -> result<string, string>;

  /// Set an accounting period to pending close
  record put-pending-close-accounting-period-params {
    /// ID of the accounting period you want to set to pending close.
    ap-id: string
  }
  put-pending-close-accounting-period: func(params: put-pending-close-accounting-period-params) -> result<string, string>;

  /// Reopen an accounting period
  record put-reopen-accounting-period-params {
    /// ID of the accounting period that you want to re-open.
    ap-id: string
  }
  put-reopen-accounting-period: func(params: put-reopen-accounting-period-params) -> result<string, string>;

  /// Run trial balance
  record put-run-trial-balance-params {
    /// ID of the accounting period for which you want to run a trial balance.
    ap-id: string
  }
  put-run-trial-balance: func(params: put-run-trial-balance-params) -> result<string, string>;

}

interface accounts {
  /// Create an account
  record post-account-params {
    /// The minor version of the Zuora REST API. 
    /// 
    zuora-version: option<string>
  }
  post-account: func(params: post-account-params) -> result<string, string>;

  /// Retrieve an account
  record get-account-params {
    /// Account number or account ID.
    account-key: string
  }
  get-account: func(params: get-account-params) -> result<string, string>;

  /// Update an account
  record put-account-params {
    /// Account number or account ID.
    account-key: string
  }
  put-account: func(params: put-account-params) -> result<string, string>;

  /// Retrieve an account summary
  record get-account-summary-params {
    /// Account number or account ID.
    account-key: string
  }
  get-account-summary: func(params: get-account-summary-params) -> result<string, string>;

  /// CRUD: Create an account
