    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a credit memo. For example, 8a8082e65b27f6c3015ba45ff82c7172.
    credit-memo-id: string,
    /// Container for taxation items.
    taxation-items: option<list<post-taxation-item-for-cm-type>>
  }
  post-cm-taxation-items: func(params: post-cm-taxation-items-params) -> result<string, string>;

  /// Unapply a credit memo
  record put-unapply-credit-memo-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a credit memo. For example, 8a8082e65b27f6c3015ba45ff82c7172.
    credit-memo-id: string,
    /// Container for debit memos that the credit memo is unapplied from. The maximum number of debit memos is 1,000.
    debit-memos: option<list<credit-memo-unapply-debit-memo-request-type>>,
    /// The date when the credit memo is unapplied.
    effective-date: option<string>,
    /// Container for invoices that the credit memo is unapplied from. The maximum number of invoices is 1,000.
    invoices: option<list<credit-memo-unapply-invoice-request-type>>
  }
  put-unapply-credit-memo: func(params: put-unapply-credit-memo-params) -> result<string, string>;

  /// Unpost a credit memo
  record put-unpost-credit-memo-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a credit memo. For example, 8a8082e65b27f6c3015ba45ff82c7172.
    credit-memo-id: string
  }
  put-unpost-credit-memo: func(params: put-unpost-credit-memo-params) -> result<string, string>;

  /// Refund a credit memo
  record post-refund-credit-memo-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a credit memo. For example, 8a8082e65b27f6c3015ba45ff82c7172.
    creditmemo-id: string,
    /// Comments about the refund.
    comment: option<string>,
    /// Container for the finance information related to the refund.
    finance-information: option<post-non-ref-refund-type-finance-information>,
    /// The ID of the gateway instance that processes the refund. This field can be specified only for electronic refunds. The ID must be a valid gateway instance ID, and this gateway must support the specific payment method. 
    /// 
    gateway-id: option<string>,
    /// The field used to pass gateway-specific parameters and parameter values.
    gateway-options: option<post-non-ref-refund-type-gateway-options>,
    /// Container for credit memo items. The maximum number of items is 1,000.
    /// 
    items: option<list<refund-credit-memo-item-type>>,
    /// How an external refund was issued to a customer. This field is required for an external refund and must be left empty for an electronic refund. You can issue an external refund on a credit memo.
    method-type: option<post-non-ref-refund-type-method-type-enum>,
    /// The ID of the payment method used for the refund. This field is required for an electronic refund, and the value must be an electronic payment method ID. This field must be left empty for an external refund. 
    payment-method-id: option<string>,
    /// A code identifying the reason for the transaction. The value must be an existing reason code or empty. If you do not specify a value, Zuora uses the default reason code.
    reason-code: option<string>,
    /// The transaction ID returned by the payment gateway for an electronic refund. Use this field to reconcile refunds between your gateway and Zuora Payments.
    reference-id: option<string>,
    /// The date when the refund takes effect, in `yyyy-mm-dd` format. The date of the refund cannot be before the credit memo date. Specify this field only for external refunds. Zuora automatically generates this field for electronic refunds.
    refund-date: option<string>,
    /// The transaction ID returned by the payment gateway if there is an additional transaction for the refund. Use this field to reconcile payments between your gateway and Zuora Payments.
    second-refund-reference-id: option<string>,
    /// A payment gateway-specific field that maps to Zuora for the gateways, Orbital, Vantiv and Verifi.
    soft-descriptor: option<string>,
    /// A payment gateway-specific field that maps to Zuora for the gateways, Orbital, Vantiv and Verifi.
    soft-descriptor-phone: option<string>,
    /// The total amount of the refund. The amount cannot exceed the unapplied amount of the associated credit memo. If the original credit memo was applied to one or more invoices or debit memos, you have to unapply a full or partial credit memo from the invoices or debit memos, and then refund the full or partial unapplied credit memo to your customers.
    total-amount: f64,
    /// The type of the refund.
    type-op: post-non-ref-refund-type-type-op-enum,
    /// ID of the corresponding object in NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    integration-id-ns: option<string>,
    /// Status of the refund's synchronization with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    integration-status-ns: option<string>,
    /// Origin of the corresponding object in NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    origin-ns: option<string>,
    /// Date when the refund was synchronized with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    sync-date-ns: option<string>,
    /// Specifies whether the refund should be synchronized with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    syncto-net-suite-ns: option<string>
  }
  post-refund-credit-memo: func(params: post-refund-credit-memo-params) -> result<string, string>;

}

interface custom-exchange-rates {
  /// List custom exchange rates by currency
  record get-custom-exchange-rates-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The target base currency of the tenant. The exchange rates in the response are calculated in relation to the target currency.
    /// 
    currency: string,
    /// Start date of the date range for which you want to get exchange rates.
    /// 
    start-date: string,
    /// End date of the date range for which you want to get exchange rates.
    /// 
    end-date: string
  }
  get-custom-exchange-rates: func(params: get-custom-exchange-rates-params) -> result<string, string>;

}

interface debit-memos {
  enum get-debit-memos-status-enum {
    draft,
    posted,
    canceled,
    error,
    pending-for-tax,
    generating,
    cancel-in-progress,
  }

  enum put-debit-memo-tax-item-type-tax-rate-type-enum {
    percentage,
    flat-fee,
  }

  enum put-debit-memo-type-transferred-to-accounting-enum {
    processing,
    yes,
    no,
    error,
    ignore,
  }

  record debit-memo-from-charge-detail-type {
    /// The amount of the debit memo item.
    /// 
    amount: option<f64>,
    /// The ID of the product rate plan charge that the debit memo is created from.
    /// 
    charge-id: string,
    /// Comments about the product rate plan charge.
    /// 
    comment: option<string>,
    /// The description of the product rate plan charge.
    /// 
    description: option<string>,
    /// Container for the finance information related to the product rate plan charge associated with the debit memo.
    finance-information: option<debit-memo-from-charge-detail-type-finance-information>,
    /// The amount of the debit memo item.
    /// 
    memo-item-amount: option<f64>,
    /// The ID of the product rate plan charge that the debit memo is created from.
    /// 
    product-rate-plan-charge-id: string,
    /// The number of units for the debit memo item.
    quantity: option<f64>,
    /// The service end date of the debit memo item. If not specified, the effective end date of the corresponding product rate plan will be used.
    service-end-date: option<string>,
    /// The service start date of the debit memo item. If not specified, the effective start date of the corresponding product rate plan will be used.
    service-start-date: option<string>
  }

  /// Container for the finance information related to the product rate plan charge associated with the debit memo.
  record debit-memo-from-charge-detail-type-finance-information {
    /// The accounting code for the deferred revenue, such as Monthly Recurring Liability.
    deferred-revenue-accounting-code: option<string>,
    /// The accounting code for the recognized revenue, such as Monthly Recurring Charges or Overage Charges.
    recognized-revenue-accounting-code: option<string>,
    /// The name of the revenue recognition rule governing the revenue schedule.
    revenue-recognition-rule-name: option<string>
  }

  record batch-debit-memo-type {
    /// The date by which the payment for the debit memo is due, in `yyyy-mm-dd` format.
    due-date: option<string>,
    /// The ID of the debit memo to be updated.
    id: option<string>
  }

  record put-debit-memo-item-type {
    /// The amount of the debit memo item. For tax-inclusive debit memo items, the amount indicates the debit memo item amount including tax. For tax-exclusive debit memo items, the amount indicates the debit memo item amount excluding tax.
    amount: option<f64>,
    /// Comments about the debit memo item.
    comment: option<string>,
    /// Container for the finance information related to the debit memo item.
    finance-information: option<put-debit-memo-item-type-finance-information>,
    /// The ID of the debit memo item.
    id: string,
    /// The number of units for the debit memo item.
    quantity: option<f64>,
    /// The service end date of the debit memo item.
    service-end-date: option<string>,
    /// The service start date of the debit memo item. 
    service-start-date: option<string>,
    /// The name of the SKU.
    sku-name: option<string>,
    /// Container for debit memo taxation items.
    tax-items: option<list<put-debit-memo-tax-item-type>>,
    /// The definable unit that you measure when determining charges.
    unit-of-measure: option<string>
  }

  /// Container for the finance information related to the debit memo item.
  record put-debit-memo-item-type-finance-information {
    /// The accounting code for the deferred revenue, such as Monthly Recurring Liability.
    deferred-revenue-accounting-code: option<string>,
    /// The accounting code for the recognized revenue, such as Monthly Recurring Charges or Overage Charges.
    recognized-revenue-accounting-code: option<string>,
    /// The name of the revenue recognition rule governing the revenue schedule.
    revenue-recognition-rule-name: option<string>
  }

  record put-debit-memo-tax-item-type {
    /// The amount of the taxation item in the debit memo item.
    amount: option<f64>,
    /// Container for the finance information related to the taxation item in the debit memo item.
    finance-information: option<put-debit-memo-tax-item-type-finance-information>,
    /// The ID of the taxation item in the debit memo item.
    id: string,
    /// The jurisdiction that applies the tax or VAT. This value is typically a state, province, county, or city.
    jurisdiction: option<string>,
    /// The identifier for the location based on the value of the `taxCode` field.
    location-code: option<string>,
    /// The tax code identifies which tax rules and tax rates to apply to a specific debit memo.
    tax-code: option<string>,
    /// The description of the tax code.
    tax-code-description: option<string>,
    /// The date that the tax is applied to the debit memo, in `yyyy-mm-dd` format.
    tax-date: option<string>,
    /// The amount of taxes or VAT for which the customer has an exemption.
    tax-exempt-amount: option<f64>,
    /// The name of taxation.
    tax-name: option<string>,
    /// The tax rate applied to the debit memo.
    tax-rate: option<f64>,
    /// The description of the tax rate.
    tax-rate-description: option<string>,
    /// The type of the tax rate applied to the debit memo.
    tax-rate-type: option<put-debit-memo-tax-item-type-tax-rate-type-enum>
  }

  /// Container for the finance information related to the taxation item in the debit memo item.
  record put-debit-memo-tax-item-type-finance-information {
    /// The accounting code for the sales taxes payable.
    sales-tax-payable-accounting-code: option<string>
  }

  /// Some detail info that would be used to processed an electronic payment.
  /// The info would only effect when `collect` set to `true`.
  record debit-memo-collect-request-payment {
    /// The ID of the gateway instance that processes the payment. The ID must be a valid gateway instance ID and this gateway must support the specific payment method.
    /// If no gateway ID is specified in the request body, the default gateway for the customer account is used automatically, if this default one is not configured, the default gateway of the tenant would be used.
    gateway-id: option<string>,
    /// The unique ID of the payment method that the customer used to make the payment.
    /// If no payment method ID is specified in the request body, the default payment method for the customer account is used automatically. If the default payment method is different from the type of payments that you want to create, an error occurs.
    payment-method-id: option<string>
  }

  record post-taxation-item-for-dm-type {
    /// The amount of taxes or VAT for which the customer has an exemption.
    exempt-amount: option<f64>,
    /// Container for the finance information related to the taxation item.
    finance-information: option<post-taxation-item-for-dm-type-finance-information>,
    /// The jurisdiction that applies the tax or VAT. This value is typically a state, province, county, or city.
    jurisdiction: string,
    /// The identifier for the location based on the value of the `taxCode` field.
    location-code: option<string>,
    /// The ID of the debit memo that the taxation item is created for.
    memo-item-id: option<string>,
    /// The name of the taxation item.
    name: string,
    /// The ID of the taxation item of the invoice, which the debit memo is created from. 
    /// 
    source-tax-item-id: option<string>,
    /// The amount of the tax applied to the debit memo.
    tax-amount: f64,
    /// The tax code identifies which tax rules and tax rates to apply to a specific debit memo.
    tax-code: option<string>,
    /// The description of the tax code.
    tax-code-description: option<string>,
    /// The date when the tax is applied to the debit memo.
    tax-date: option<string>,
    /// The tax rate applied to the debit memo.
    tax-rate: f64,
    /// The description of the tax rate.
    tax-rate-description: option<string>,
    /// The type of the tax rate applied to the debit memo.
    tax-rate-type: put-debit-memo-tax-item-type-tax-rate-type-enum
  }

  /// Container for the finance information related to the taxation item.
  record post-taxation-item-for-dm-type-finance-information {
    /// The accounting code for the sales taxes payable.
    sales-tax-payable-accounting-code: option<string>
  }

  /// List debit memos
  record get-debit-memos-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Number of rows returned per page.
    page-size: option<s32>,
    /// This parameter filters the response based on the `accountId` field.
    account-id: option<string>,
    /// This parameter filters the response based on the `amount` field.
    amount: option<f64>,
    /// This parameter filters the response based on the `balance` field.
    balance: option<f64>,
    /// This parameter filters the response based on the `beAppliedAmount` field.
    be-applied-amount: option<f64>,
    /// This parameter filters the response based on the `createdById` field.
    created-by-id: option<string>,
    /// This parameter filters the response based on the `createdDate` field.
    created-date: option<string>,
    /// This parameter filters the response based on the `currency` field.
    currency: option<string>,
    /// This parameter filters the response based on the `debitMemoDate` field.
    debit-memo-date: option<string>,
    /// This parameter filters the response based on the `dueDate` field.
    due-date: option<string>,
    /// This parameter filters the response based on the `number` field.
    number: option<string>,
    /// This parameter filters the response based on the `referredInvoiceId` field.
    referred-invoice-id: option<string>,
    /// This parameter filters the response based on the `status` field.
    status: option<get-debit-memos-status-enum>,
    /// This parameter filters the response based on the `targetDate` field.
    target-date: option<string>,
    /// This parameter filters the response based on the `taxAmount` field.
    tax-amount: option<f64>,
    /// This parameter filters the response based on the `totalTaxExemptAmount` field.
    total-tax-exempt-amount: option<f64>,
    /// This parameter filters the response based on the `updatedById` field.
    updated-by-id: option<string>,
    /// This parameter filters the response based on the `updatedDate` field.
    updated-date: option<string>,
    /// This parameter restricts the order of the data returned in the response. You can use this parameter to supply a dimension you want to sort on.
    /// 
    sort: option<string>
  }
  get-debit-memos: func(params: get-debit-memos-params) -> result<string, string>;

  /// Create a debit memo from a charge
  record post-debit-memo-from-prpc-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// 
    /// The minor version of the Zuora REST API. See [Minor Version](https://www.zuora.com/developer/api-reference/#section/API-Versions/Minor-Version) for information about REST API version control. 
    zuora-version: option<string>,
    /// The ID of the account associated with the debit memo.
    /// 
    account-id: option<string>,
    /// The Number of the account associated with the debit memo.
    /// 
    account-number: option<string>,
    /// Whether debit memos are automatically picked up for processing in the corresponding payment run. 
    /// 
    auto-pay: option<bool>,
    /// Whether to automatically post the debit memo after it is created. 
    /// 
    auto-post: option<bool>,
    /// Container for product rate plan charges. The maximum number of items is 1,000.
    charges: option<list<debit-memo-from-charge-detail-type>>,
    /// Comments about the debit memo.
    comment: option<string>,
    /// The date by which the payment for the debit memo is due, in `yyyy-mm-dd` format.
    due-date: option<string>,
    /// The date when the debit memo takes effect.
    effective-date: option<string>,
    /// A code identifying the reason for the transaction. The value must be an existing reason code or empty. If you do not specify a value, Zuora uses the default reason code.
    reason-code: option<string>,
    /// ID of the corresponding object in NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    integration-id-ns: option<string>,
    /// Status of the debit memo's synchronization with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    integration-status-ns: option<string>,
    /// Date when the debit memo was synchronized with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    sync-date-ns: option<string>
  }
  post-debit-memo-from-prpc: func(params: post-debit-memo-from-prpc-params) -> result<string, string>;

  /// Update debit memos
  record put-batch-update-debit-memos-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Container for debit memo update details.
    debit-memos: option<list<batch-debit-memo-type>>
  }
  put-batch-update-debit-memos: func(params: put-batch-update-debit-memos-params) -> result<string, string>;

  /// Retrieve a debit memo
  record get-debit-memo-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a debit memo. For example, 8a8082e65b27f6c3015ba419f3c2644e.
    debit-memo-id: string
  }
  get-debit-memo: func(params: get-debit-memo-params) -> result<string, string>;

  /// Update a debit memo
  record put-debit-memo-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a debit memo. For example, 8a8082e65b27f6c3015ba419f3c2644e.
    debit-memo-id: string,
    /// Whether debit memos are automatically picked up for processing in the corresponding payment run. 
    /// 
    auto-pay: option<bool>,
    /// Comments about the debit memo.
    comment: option<string>,
    /// The date by which the payment for the debit memo is due, in `yyyy-mm-dd` format.
    due-date: option<string>,
    /// The date when the debit memo takes effect.
    effective-date: option<string>,
    /// Container for debit memo items.
    items: option<list<put-debit-memo-item-type>>,
    /// A code identifying the reason for the transaction. The value must be an existing reason code or empty. If you do not specify a value, Zuora uses the default reason code
    reason-code: option<string>,
