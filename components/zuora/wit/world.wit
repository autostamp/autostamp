    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a specific payment part. You can get the payment part ID from the response of [List all parts of a payment](https://www.zuora.com/developer/api-reference/#operation/GET_PaymentParts).
    partid: string,
    /// The unique ID of a specific payment part item. You can get the payment part item ID from the response of [List all payment part items](https://www.zuora.com/developer/api-reference/#operation/GET_PaymentItemParts).
    itempartid: string,
    /// The unique ID of a payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  get-payment-item-part: func(params: get-payment-item-part-params) -> result<string, string>;

  /// Refund a payment
  record post-refund-payment-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of an unapplied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string,
    /// Comments about the refund.
    comment: option<string>,
    /// Container for the finance information related to the refund.
    finance-information: option<post-refund-type-finance-information>,
    /// The field used to pass gateway-specific parameters and parameter values.
    gateway-options: option<post-refund-type-gateway-options>,
    /// How an external refund was issued to a customer. This field is required for an external refund and must be left empty for an electronic refund. You can issue an external refund on an electronic payment.
    method-type: option<post-refund-type-method-type-enum>,
    /// A code identifying the reason for the transaction. The value must be an existing reason code or empty. If you do not specify a value, Zuora uses the default reason code.
    reason-code: option<string>,
    /// The transaction ID returned by the payment gateway for an electronic refund. Use this field to reconcile refunds between your gateway and Zuora Payments.
    reference-id: option<string>,
    /// The date when the refund takes effect, in `yyyy-mm-dd` format. The date of the refund cannot be before the payment date. Specify this field only for external refunds. Zuora automatically generates this field for electronic refunds.
    refund-date: option<string>,
    /// The transaction ID returned by the payment gateway if there is an additional transaction for the refund. Use this field to reconcile payments between your gateway and Zuora Payments.
    second-refund-reference-id: option<string>,
    /// A payment gateway-specific field that maps to Zuora for the gateways, Orbital, Vantiv and Verifi.
    soft-descriptor: option<string>,
    /// A payment gateway-specific field that maps to Zuora for the gateways, Orbital, Vantiv and Verifi.
    soft-descriptor-phone: option<string>,
    /// The total amount of the refund. The amount cannot exceed the unapplied amount of the associated payment. If the original payment was applied to one or more invoices or debit memos, you have to unapply a full or partial payment from the invoices or debit memos, and then refund the full or partial unapplied payment to your customers. 
    total-amount: f64,
    /// The type of the refund.
    type-op: proxy-create-payment-type-op-enum,
    /// ID of the corresponding object in NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    integration-id-ns: option<string>,
    /// Status of the refund's synchronization with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    integration-status-ns: option<string>,
    /// Origin of the corresponding object in NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    origin-ns: option<string>,
    /// Date when the refund was synchronized with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    sync-date-ns: option<string>,
    /// Specifies whether the refund should be synchronized with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    syncto-net-suite-ns: option<string>
  }
  post-refund-payment: func(params: post-refund-payment-params) -> result<string, string>;

  /// Transfer a payment
  record put-transfer-payment-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of an unapplied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string,
    /// The ID of the customer account that the payment is transferred to.
    account-id: option<string>
  }
  put-transfer-payment: func(params: put-transfer-payment-params) -> result<string, string>;

  /// Unapply a payment
  record put-unapply-payment-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of an applied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string,
    /// Container for debit memos. The maximum number of debit memos is 1,000.
    debit-memos: option<list<payment-debit-memo-application-unapply-request-type>>,
    /// The date when the payment is unapplied, in `yyyy-mm-dd` format.
    effective-date: option<string>,
    /// Container for invoices. The maximum number of invoice is 1,000.
    invoices: option<list<payment-invoice-application-unapply-request-type>>
  }
  put-unapply-payment: func(params: put-unapply-payment-params) -> result<string, string>;

}

interface payment-methods {
  enum post-payment-method-request-mit-consent-agreement-src-enum {
    external,
  }

  enum post-payment-method-request-mit-profile-action-enum {
    activate,
    persist,
  }

  enum post-payment-method-request-mit-profile-type-enum {
    recurring,
    unscheduled,
  }

  enum post-payment-method-request-bank-account-type-enum {
    business-checking,
    checking,
    saving,
  }

  enum post-payment-method-decryption-mit-profile-type-enum {
    recurring,
  }

  enum post-delay-authorize-capture-mit-transaction-source-enum {
    c-unscheduled,
    m-recurring,
    m-unscheduled,
  }

  enum create-stored-credential-profile-request-status-enum {
    agreed,
    active,
  }

  /// Container for cardholder information. If provided, Zuora will
  /// only use this information for this card. Otherwise, Zuora will use
  /// the account''s existing bill-to contact information for this card.
  record create-payment-method-cardholder-info {
    /// First address line, 255 characters or less.
    address-line1: option<string>,
    /// Second address line, 255 characters or less.
    address-line2: option<string>,
    /// The card holder's full name as it appears on the card, e.g., "John J Smith", 50 characters or less.
    card-holder-name: string,
    /// City, 40 characters or less.
    city: option<string>,
    /// Country, must be a valid country name or abbreviation.
    country: option<string>,
    /// Card holder's email address, 80 characters or less.
    email: option<string>,
    /// Phone number, 40 characters or less.
    phone: option<string>,
    /// State; must be a valid state name or 2-character abbreviation.
    state: option<string>,
    /// Zip code, 20 characters or less.
    zip-code: option<string>
  }

  record post-payment-method-request-account-holder-info {
    /// The full name of the bank account holder.
    account-holder-name: string,
    /// The first line of the address for the account holder.
    address-line1: option<string>,
    /// The second line of the address for the account holder. 
    address-line2: option<string>,
    /// The city where the account holder stays.
    city: option<string>,
    /// The email address of the account holder.
    email: option<string>,
    /// The first name of the account holder.
    first-name: option<string>,
    /// The last name of the account holder.
    last-name: option<string>,
    /// The phone number of the account holder.
    phone: option<string>,
    /// The state where the account holder stays.
    state: option<string>,
    /// The zip code for the address of the account holder.
    zip-code: option<string>
  }

  /// The field used to pass gateway-specific parameters and parameter values.
  record post-payment-method-type-gateway-options {
    /// The name of a gateway-specific parameter.
    key: option<string>,
    /// The value of the gateway-specific parameter.
    value: option<string>
  }

  /// The field used to pass gateway-specific parameters and parameter values.
  record put-payment-method-type-gateway-options {
    /// The name of a gateway-specific parameter.
    key: option<string>,
    /// The value of the gateway-specific parameter.
    value: option<string>
  }

  /// Container for cardholder information. If provided, Zuora will only use this information for this card. If not provided, Zuora will use the account's existing bill-to contact information for this card.
  record post-payment-method-decryption-card-holder-info {
    /// First address line, 255 characters or less.
    address-line1: option<string>,
    /// Second address line, 255 characters or less.
    address-line2: option<string>,
    /// The card holder's full name as it appears on the card, e.g., "John J Smith", 50 characters or less.
    card-holder-name: option<string>,
    /// City, 40 characters or less.
    city: option<string>,
    /// Country, must be a valid country name or abbreviation.
    country: option<string>,
    /// Card holder's email address, 80 characters or less.
    email: option<string>,
    /// Phone number, 40 characters or less.
    phone: option<string>,
    /// State; must be a valid state name or 2-character abbreviation.
    state: option<string>,
    /// Zip code, 20 characters or less.
    zip-code: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-method-decryption-payment-token-entry {
    key: string,
    value: string
  }

  record putpm-account-holder-info {
    /// The first line of the address for the account holder.
    address-line1: option<string>,
    /// The second line of the address for the account holder. 
    address-line2: option<string>,
    /// The city where the account holder stays.
    city: option<string>,
    /// The country where the account holder stays.
    country: option<string>,
    /// The email address of the account holder.
    email: option<string>,
    /// The phone number of the account holder. 
    phone: option<string>,
    /// The state where the account holder stays.
    state: option<string>,
    /// The zip code for the address of the account holder.
    zip-code: option<string>
  }

  /// The field used to pass gateway-specific parameters and parameter values.
  record put-payment-method-request-gateway-options {
    /// The name of a gateway-specific parameter.
    key: option<string>,
    /// The value of the gateway-specific parameter.
    value: option<string>
  }

  record post-authorize-response {
    /// The order ID for the gateway.
    gateway-order-id: option<string>,
    /// The result code of the request. 0 indicates the call succeeded, and other values indicate the call failed.
    result-code: option<string>,
    /// The corresponding request ID.
    result-message: option<string>,
    /// Indicates whether the call succeeded.
    success: option<bool>,
    /// The ID of the transaction.
    transaction-id: option<string>
  }

  /// The field used to pass gateway-specific parameters and parameter values.
  record put-verify-payment-method-type-gateway-options {
    /// The name of a gateway-specific parameter.
    key: option<string>,
    /// The value of the gateway-specific parameter.
    value: option<string>
  }

  record post-void-authorize-response {
    /// The order ID for the gateway.
    gateway-order-id: option<string>,
    /// The result code of the request. 0 indicates the call succeeded, and other values indicate the call failed.
    result-code: option<string>,
    /// The corresponding request ID.
    result-message: option<string>,
    /// Indicates whether the call succeeded.
    success: option<bool>,
    /// The ID of the transaction.
    transaction-id: option<string>
  }

  variant object-post-payment-method-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant object-get-payment-method-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant object-put-payment-method-error {
    unauthorized(string),
    other(string)
  }

  variant object-delete-payment-method-error {
    unauthorized(string),
    other(string)
  }

  /// CRUD: Create a payment method
  record object-post-payment-method-params {
    /// Specifies whether the call fails if the request body contains unknown fields.
    /// With `rejectUnknownFields` set to `true`, Zuora returns a 400 response if
    reject-unknown-fields: option<bool>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  object-post-payment-method: func(params: object-post-payment-method-params) -> result<string, object-post-payment-method-error>;

  /// CRUD: Retrieve a payment method
  record object-get-payment-method-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object fields to return
    fields: option<string>,
    /// Object id
    id: string
  }
  object-get-payment-method: func(params: object-get-payment-method-params) -> result<string, object-get-payment-method-error>;

  /// CRUD: Update a payment method
  record object-put-payment-method-params {
    /// Specifies whether the call fails if the request body contains unknown fields.
    /// With `rejectUnknownFields` set to `true`, Zuora returns a 400 response if
    reject-unknown-fields: option<bool>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object id
    id: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  object-put-payment-method: func(params: object-put-payment-method-params) -> result<string, object-put-payment-method-error>;

  /// CRUD: Delete a payment method
  record object-delete-payment-method-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object id
    id: string
  }
  object-delete-payment-method: func(params: object-delete-payment-method-params) -> result<string, object-delete-payment-method-error>;

  /// Create a payment method
  record post-payment-methods-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Type of the payment method. Possible values include:
    /// 
    type-op: string,
    /// ID of a PayPal billing agreement. For example, I-1TJ3GAGG82Y9.
    baid: option<string>,
    /// Email address associated with the payment method. This field is required if you want to create a PayPal Express Checkout payment method or a PayPal Adaptive payment method.
    email: option<string>,
    /// The PayPal preapproval key.
    preapproval-key: option<string>,
    card-holder-info: option<create-payment-method-cardholder-info>,
    /// Credit card number.
    card-number: option<string>,
    /// The type of the credit card.
    /// 
    card-type: option<string>,
    /// Indicates whether the duplication check is performed when you create a new credit card payment method. The default value is `false`.
    /// 
    check-duplicated: option<bool>,
    /// One or two digit expiration month (1-12) of the credit card.
    expiration-month: option<s32>,
    /// Four-digit expiration year of the credit card.
    expiration-year: option<s32>,
    /// Specifies your reference for the stored credential consent agreement that you have established with the customer. Only applicable if you set the `mitProfileAction` field.
    mit-consent-agreement-ref: option<string>,
    /// Required if you set the `mitProfileAction` field.
    mit-consent-agreement-src: option<post-payment-method-request-mit-consent-agreement-src-enum>,
    /// Specifies the ID of a network transaction. Only applicable if you set the `mitProfileAction` field to `Persist`.
    mit-network-transaction-id: option<string>,
    /// If you set this field, Zuora creates a stored credential profile within the payment method.
    /// 
    mit-profile-action: option<post-payment-method-request-mit-profile-action-enum>,
    /// The date on which the profile is agreed. The date format is `yyyy-mm-dd`.
    mit-profile-agreed-on: option<string>,
    /// Required if you set the `mitProfileAction` field. Indicates the type of the stored credential profile to process recurring or unsecheduled transactions.
    mit-profile-type: option<post-payment-method-request-mit-profile-type-enum>,
    /// CVV or CVV2 security code of the credit card.
    /// 
    security-code: option<string>,
    /// First address line, 255 characters or less.
    address-line1: option<string>,
    /// Second address line, 255 characters or less.
    address-line2: option<string>,
    /// The nine-digit routing number or ABA number used by banks. This field is only required if the `type` field is set to `ACH`.
    bank-aba-code: option<string>,
    /// The name of the account holder, which can be either a person or a company. This field is only required if the `type` field is set to `ACH`.
    bank-account-name: option<string>,
    /// The bank account number associated with the ACH payment. This field is only required if the `type` field is set to `ACH`.
    bank-account-number: option<string>,
    /// The type of bank account associated with the ACH payment. This field is only required if the `type` field is set to `ACH`.
    bank-account-type: option<post-payment-method-request-bank-account-type-enum>,
    /// The name of the bank where the ACH payment account is held. This field is only required if the `type` field is set to `ACH`.
    bank-name: option<string>,
    /// City, 40 characters or less.
    ///     
    city: option<string>,
    /// Country, must be a valid country name or abbreviation.
    country: option<string>,
    /// Phone number, 40 characters or less.
    phone: option<string>,
    /// State, must be a valid state name or 2-character abbreviation.
    state: option<string>,
    /// Zip code, 20 characters or less.
    zip-code: option<string>,
    /// Internal ID of the customer account that will own the payment method. 
    /// 
    account-key: option<string>,
    /// Internal ID of the payment gateway that Zuora will use to authorize the payments that are made with the payment method.
    /// 
    auth-gateway: option<string>,
    /// Specifies whether the payment method will be the default payment method of the customer account that owns the payment method. Only applicable if the `accountKey` field is set.
    make-default: option<bool>,
    /// The International Bank Account Number. This field is used to create the SEPA payment method.
    iban: option<string>,
    account-holder-info: option<post-payment-method-request-account-holder-info>,
    /// The number of the customer's bank account. Use this field for direct debit payment methods.
    account-number: option<string>,
    /// The sort code or number that identifies the bank. This is also known as the sort code. 
    bank-code: option<string>,
    /// The branch code of the bank used for direct debit.  
    branch-code: option<string>,
    /// The BIC code used for SEPA.
    business-identification-code: option<string>,
    /// The currency used for payment method authorization.
    /// 
    currency-code: option<string>,
    /// The identity number used for Bank Transfer.
    identity-number: option<string>
  }
  post-payment-methods: func(params: post-payment-methods-params) -> result<string, string>;

  /// Create a credit card payment method
  record post-payment-methods-credit-card-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// ID of the customer account.
    /// To create an orphan payment method that is not associated with any customer account, you do not need to specify this field during creation. However, you must associate the orphan payment method with a customer account within 10 days. Otherwise, this orphan payment method will be deleted.
    account-key: option<string>,
    card-holder-info: option<create-payment-method-cardholder-info>,
    /// Credit card number, a string of up to 16 characters. This field can only be set when creating a new payment method; it cannot be queried or updated.
    credit-card-number: string,
    /// The type of the credit card.
    /// 
    credit-card-type: string,
    /// Specify true to make this card the default payment method; otherwise, omit this parameter to keep the current default payment method.
    default-payment-method: option<bool>,
    /// One or two digits expiration month (1-12).
    expiration-month: s32,
    /// Four-digit expiration year.
    expiration-year: s32,
    /// The field used to pass gateway-specific parameters and parameter values.
    gateway-options: option<post-payment-method-type-gateway-options>,
    /// Specifies your reference for the stored credential consent agreement that you have established with the customer. Only applicable if you set the `mitProfileAction` field.
    mit-consent-agreement-ref: option<string>,
    /// Required if you set the `mitProfileAction` field.
    mit-consent-agreement-src: option<post-payment-method-request-mit-consent-agreement-src-enum>,
    /// Specifies the ID of a network transaction. Only applicable if you set the `mitProfileAction` field to `Persist`.
    mit-network-transaction-id: option<string>,
    /// If you set this field, Zuora creates a stored credential profile within the payment method.
    /// 
    mit-profile-action: option<post-payment-method-request-mit-profile-action-enum>,
    /// The date on which the profile is agreed. The date format is `yyyy-mm-dd`.  
    mit-profile-agreed-on: option<string>,
