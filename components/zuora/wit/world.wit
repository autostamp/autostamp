    /// Object id
    id: string
  }
  object-put-refund: func(params: object-put-refund-params) -> result<string, string>;

  /// CRUD: Delete a refund
  record object-delete-refund-params {
    /// Object id
    id: string
  }
  object-delete-refund: func(params: object-delete-refund-params) -> result<string, string>;

  /// List refunds
  record get-refunds-params {
    /// This parameter filters the response based on the `accountId` field.
    account-id: option<string>,
    /// This parameter filters the response based on the `amount` field.
    amount: option<f64>,
    /// This parameter filters the response based on the `createdById` field.
    created-by-id: option<string>,
    /// This parameter filters the response based on the `createdDate` field.
    created-date: option<string>,
    /// This parameter filters the response based on the `methodType` field.
    method-type: option<get-refunds-method-type-enum>,
    /// This parameter filters the response based on the `number` field.
    number: option<string>,
    /// This parameter filters the response based on the `paymentId` field.
    payment-id: option<string>,
    /// This parameter filters the response based on the `refundDate` field.
    refund-date: option<string>,
    /// This parameter filters the response based on the `status` field.
    status: option<get-refunds-status-enum>,
    /// This parameter filters the response based on the `type` field.
    type-op: option<get-refunds-type-op-enum>,
    /// This parameter filters the response based on the `updatedById` field.
    updated-by-id: option<string>,
    /// This parameter filters the response based on the `updatedDate` field.
    updated-date: option<string>,
    /// This parameter restricts the order of the data returned in the response. You can use this parameter to supply a dimension you want to sort on.
    /// 
    sort: option<string>
  }
  get-refunds: func(params: get-refunds-params) -> result<string, string>;

  /// Retrieve a refund
  record get-refund-params {
    /// The unique ID of a refund. For example, 4028905f5a87c0ff015a889e590e00c9.
    refund-id: string
  }
  get-refund: func(params: get-refund-params) -> result<string, string>;

  /// Update a refund
  record put-update-refund-params {
    /// The unique ID of a refund. For example, 4028905f5a87c0ff015a889e590e00c9.
    refund-id: string
  }
  put-update-refund: func(params: put-update-refund-params) -> result<string, string>;

  /// Delete a refund
  record delete-refund-params {
    /// The unique ID of a refund. For example, 4028905f5a87c0ff015a889e590e00c9.
    refund-id: string
  }
  delete-refund: func(params: delete-refund-params) -> result<string, string>;

  /// Cancel a refund
  record put-cancel-refund-params {
    /// The unique ID of a refund. For example, 4028905f5a87c0ff015a889e590e00c9.      
    refund-id: string
  }
  put-cancel-refund: func(params: put-cancel-refund-params) -> result<string, string>;

  /// List all parts of a refund
  record get-refund-parts-params {
    /// The unique ID of a refund. For example, 4028905f5a87c0ff015a889e590e00c9.
    refund-id: string
  }
  get-refund-parts: func(params: get-refund-parts-params) -> result<string, string>;

  /// Retrieve a refund part
  record get-refund-part-params {
    /// The unique ID of a specific refund part. You can get the refund part ID from the response of [List all parts of a refund](https://www.zuora.com/developer/api-reference/#operation/GET_RefundParts).
    refundpartid: string,
    /// The unique ID of a refund. For example, 4028905f5a87c0ff015a889e590e00c9.
    refund-id: string
  }
  get-refund-part: func(params: get-refund-part-params) -> result<string, string>;

  /// List all refund part items
  record get-refund-item-parts-params {
    /// The unique ID of a specific refund part. You can get the refund part ID from the response of [List all parts of a refund](https://www.zuora.com/developer/api-reference/#operation/GET_RefundParts).
    refundpartid: string,
    /// The unique ID of a refund. For example, 4028905f5a87c0ff015a889e590e00c9.
    refund-id: string
  }
  get-refund-item-parts: func(params: get-refund-item-parts-params) -> result<string, string>;

  /// Retrieve a refund part item
  record get-refund-item-part-params {
    /// The unique ID of a specific refund part item. You can get the refund part item ID from the response of [Get refund part items](https://www.zuora.com/developer/api-reference/#operation/GET_RefundItemParts).
    itempartid: string,
    /// The unique ID of a specific refund part. You can get the refund part ID from the response of [List all parts of a refund](https://www.zuora.com/developer/api-reference/#operation/GET_RefundParts).
    refundpartid: string,
    /// The unique ID of a refund. For example, 4028905f5a87c0ff015a889e590e00c9.
    refund-id: string
  }
  get-refund-item-part: func(params: get-refund-item-part-params) -> result<string, string>;

