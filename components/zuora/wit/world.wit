    /// A description of the usage record.
    description: option<string>,
    ///  The end date and time of a range of time when usage is tracked. Use this field for reporting; this field doesn't affect usage calculation.
    /// **Character limit**: 29 **Values**: a valid date and time value. 
    end-date-time: option<string>,
    ///  Indicates the number of units used.
    /// **Character limit**: 16 **Values**: a valid decimal amount equal to or greater than 0 
    quantity: f64,
    ///  The start date and time of a range of time when usage is tracked. Zuora uses this field value to determine the usage date. Unlike the `EndDateTime`, the `StartDateTime` field does affect usage calculation.
    /// **Character limit**: 29 **Values**: a valid date and time value 
    start-date-time: string,
    ///  The date when usage was submitted.
    /// **Character limit**: 29 **Values**: automatically generated 
    submission-date-time: option<string>,
    /// The ID of the subscription that contains the fees related to the usage data.
    /// 
    subscription-id: option<string>,
    /// The unique identifier number of the subscription that contains the fees related to the usage data.
    /// 
    subscription-number: option<string>,
    ///  Specifies the units to measure usage. Units of measure are configured in the web-based UI. Your values depend on your configuration in **Billing Settings**.
    /// **Character limit**: **Values**: a valid unit of measure 
    uom: string
  }
  object-post-usage: func(params: object-post-usage-params) -> result<string, object-post-usage-error>;

  /// CRUD: Retrieve a usage record
  record object-get-usage-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object fields to return
    fields: option<string>,
    /// Object id
    id: string
  }
  object-get-usage: func(params: object-get-usage-params) -> result<string, object-get-usage-error>;

  /// CRUD: Update a usage record
  record object-put-usage-params {
    /// Specifies whether the call fails if the request body contains unknown fields.
    /// With `rejectUnknownFields` set to `true`, Zuora returns a 400 response if
    reject-unknown-fields: option<bool>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object id
    id: string,
    ///  The end date and time of a range of time when usage is tracked. Use this field for reporting; this field doesn't affect usage calculation.
    /// **Character limit**: 29 **Values**: a valid date and time value 
    end-date-time: option<string>,
    ///  Indicates the number of units used.
    /// **Character limit**: 16 **Values**: a valid decimal amount equal to or greater than 0 
    quantity: option<f64>,
    ///  Indicates if the rating and billing engine (RBE) processed usage data for an invoice.
    /// **Character limit**: 9 **Values**: automatically generated to be one of the following values: `Importing`, `Pending`, `Processed` 
    rbe-status: option<string>,
    ///  The start date and time of a range of time when usage is tracked. Zuora uses this field value to determine the usage date. Unlike the `EndDateTime`, the `StartDateTime` field does affect usage calculation.
    /// **Character limit**: 29 **Values**: a valid date and time value 
    start-date-time: option<string>,
    ///  The date when usage was submitted.
    /// **Character limit**: 29 **Values**: automatically generated 
    submission-date-time: option<string>,
    ///  Specifies the units to measure usage. Units of measure are configured in the web-based UI. Your values depend on your configuration in **Billing Settings**.
    /// **Character limit**: **Values**: a valid unit of measure 
    uom: option<string>
  }
  object-put-usage: func(params: object-put-usage-params) -> result<proxy-create-or-modify-response, object-put-usage-error>;

  /// CRUD: Delete a usage record
  record object-delete-usage-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object id
    id: string
  }
  object-delete-usage: func(params: object-delete-usage-params) -> result<proxy-delete-response, object-delete-usage-error>;

  /// Upload a usage file
  record post-usage-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The usage data to import.
    file: string
  }
  post-usage: func(params: post-usage-params) -> result<string, string>;

  /// Retrieve a usage record
  record get-usage-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Number of rows returned per page.
    page-size: option<s32>,
    /// Account number or account ID.
    account-key: string
  }
  get-usage: func(params: get-usage-params) -> result<string, string>;

}

interface operations {
  /// Generate a billing preview
  record post-billing-preview-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// ID of the customer account to which the billing preview applies.
    account-id: string,
    /// Indicates whether to generate a preview of future invoice items and credit memo items with the assumption that the subscriptions are renewed.
    /// 
    assume-renewal: option<string>,
    /// The charge types to exclude from the billing preview.
    /// 
    charge-type-to-exclude: option<string>,
    /// Indicates if evergreen subscriptions are included in the billingPreview call.
    including-evergreen-subscription: option<bool>,
    /// The target date for the billingPreview call. The billingPreview call generates preview invoice item data and credit memo item data from the first day of the customer's next billing period to the TargetDate. 
    /// 
    target-date: string
  }
  post-billing-preview: func(params: post-billing-preview-params) -> result<string, string>;

  /// Invoice and collect
  record post-transaction-invoice-payment-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// 
    /// The minor version of the Zuora REST API. 
    zuora-version: option<string>,
    /// Customer account ID or account number.
    account-key: string,
    /// The date that should appear on the invoice and credit memo being generated,
    /// in `yyyy-mm-dd` format. If this field is omitted
    document-date: option<string>,
    /// **Note:** This field has been replaced by the `documentDate` field in Zuora REST API version `215.0` and later. The
    /// `invoiceDate` field is only available for backward
    invoice-date: option<string>,
    /// The ID of an existing invoice for which to collect payment using
    /// the account's default payment method. If this value is specified, no new
    invoice-id: option<string>,
    /// **Note:** This field has been replaced by the `targetDate` field in Zuora REST API version `215.0` and later. The
    /// `invoiceTargetDate` field is only available for backward
    invoice-target-date: option<string>,
    /// The name of the gateway that will be used for the payment. Must be a valid gateway name and the gateway must support the specific payment method. If a value is not specified, the default gateway on the Account will be used.
    payment-gateway: option<string>,
    /// The date through which to calculate charges on this account if an invoice or a credit memo is generated, 
    /// in `yyyy-mm-dd` format. If this field is omitted
    target-date: option<string>
  }
  post-transaction-invoice-payment: func(params: post-transaction-invoice-payment-params) -> result<string, string>;

}

interface order-line-items {
  enum post-order-line-item-update-type-item-state-enum {
    executing,
    sent-to-billing,
    complete,
    cancelled,
  }

  enum post-order-line-item-update-type-item-type-enum {
    product,
    fee,
    services,
  }

  enum post-order-line-item-update-type-tax-mode-enum {
    tax-inclusive,
    tax-exclusive,
  }

  record post-order-line-item-update-type {
    /// The sytem generated Id for the Order Line Item(OLI). Use this field to specify which OLI to update.
    id: string,
    /// Specifies the units to measure usage.
    /// 
    uom: option<string>,
    /// The accountingCode for the Order Line Item (OLI).
    /// 
    accounting-code: option<string>,
    /// The actual charged amount per unit for the Order Line Item (OLI).
    /// 
    amount-per-unit: option<f64>,
    /// The target date for the Order Line Item (OLI) to be picked up by bill run for generating invoice.
    /// 
    bill-target-date: option<string>,
    custom-fields: option<list<order-line-item-custom-fields-entry>>,
    /// The deferred revenue accounting code for the Order Line Item (OLI).
    /// 
    deferred-revenue-accounting-code: option<string>,
    /// The description of the Order Line Item (OLI).
    /// 
    description: option<string>,
    /// The name of the Order Line Item (OLI).
    /// 
    item-name: option<string>,
    /// The number for the Order Line Item (OLI).
    /// 
    item-number: option<string>,
    /// The state of the Order Line Item (OLI). See [Order Line Item states, Order states, and state transitions](https://knowledgecenter.zuora.com/Billing/Subscriptions/Orders/Order_Line_Items/AB_Order_Line_Item_States_and_Order_States) for more information.
    /// 
    item-state: option<post-order-line-item-update-type-item-state-enum>,
    /// The type of the Order Line Item (OLI). 
    /// 
    item-type: option<post-order-line-item-update-type-item-type-enum>,
    /// The list price per unit for the Order Line Item (OLI).
    /// 
    list-price-per-unit: option<f64>,
    /// The product code for the Order Line Item (OLI).
    /// 
    product-code: option<string>,
    /// Used by customers to specify the Purchase Order Number provided by the buyer.
    /// 
    purchase-order-number: option<string>,
    /// The quantity of units, such as the number of authors in a hosted wiki service.
    /// 
    quantity: option<f64>,
    /// The recognized revenue accounting code for the Order Line Item (OLI).
    /// 
    recognized-revenue-accounting-code: option<string>,
    /// The Revenue Recognition rule for the Order Line Item (OLI).
    /// 
    revenue-recognition-rule: option<string>,
    /// The tax code for the Order Line Item (OLI).
    /// 
    tax-code: option<string>,
    /// The tax mode for the Order Line Item (OLI).
    /// 
    tax-mode: option<post-order-line-item-update-type-tax-mode-enum>,
    /// The transaction date of the Order Line Item (OLI).
    /// 
    transaction-date: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record order-line-item-custom-fields-entry {
    key: string,
    value: string
  }

  /// Invoice or Payment.
  record processing-options {
    /// The priority order to apply credit memos and/or unapplied payments to an invoice. Possible item values are: `CreditMemo`, `UnappliedPayment`.
    /// 
    application-order: option<list<string>>,
    /// Whether to automatically apply credit memos or unapplied payments, or both to an invoice.
    /// 
    apply-credit: option<bool>,
    /// Indicates if any credit balance on a customer's account is automatically applied to invoices. If no value is specified then this field defaults to false. This feature is not available if you have enabled the Invoice Settlement feature.
    apply-credit-balance: option<bool>,
    billing-options: option<billing-options>,
    /// Indicates if the current request needs to collect payments. This value can not be 'true' when 'runBilling' flag is 'false'.
    collect-payment: option<bool>,
    /// Container for the electronic payment options.
    electronic-payment-options: option<processing-options-electronic-payment-options>,
    /// Indicates if the current request needs to generate an invoice. The invoice will be generated against all subscriptions included in this order.
    run-billing: option<bool>
  }

  record billing-options {
    /// The invoice date displayed on the invoice.
    document-date: option<string>,
    /// Date through which to calculate charges if an invoice is generated. See [What is a Target Date?](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/J_Billing_Operations/G_Bill_Runs/Creating_Bill_Runs#What_is_a_Target_Date.3F).
    target-date: option<string>
  }

  /// Container for the electronic payment options.
  record processing-options-electronic-payment-options {
    /// Specifies an electronic payment method. It can be one that has already been associated with an invoice owner, or an orphan payment method, which is not associated with any invoice owner. For an orphan payment method, this operation will then associate it with the account that this order will be created under.
    payment-method-id: option<string>
  }

  record get-order-line-item-response-type {
    /// The Id of the process that handle the operation.
    process-id: option<string>,
    reasons: option<list<get-order-line-item-response-type-reasons-item>>,
    /// Indicates whether the call succeeded.
    success: option<bool>,
    order-line-item: option<order-line-item>
  }

  record get-order-line-item-response-type-reasons-item {
    /// The error code of response.
    code: option<string>,
    /// The detail information of the error response
    message: option<string>
  }

  record order-line-item {
    /// The calculated gross amount for the Order Line Item.
    amount: option<f64>,
    /// The sytem generated Id for the Order Line Item.
    id: option<string>,
    /// Specifies the units to measure usage.
    uom: option<string>,
    /// The accountingCode for the Order Line Item.
    accounting-code: option<string>,
    /// The actual charged amount per unit for the Order Line Item.
    amount-per-unit: option<f64>,
    /// The target date for the Order Line Item to be picked up by bill run for billing.
    bill-target-date: option<string>,
    custom-fields: option<list<order-line-item-custom-fields-retrieve-order-line-item-entry>>,
    /// The deferred revenue accounting code for the Order Line Item.
    deferred-revenue-accounting-code: option<string>,
    /// The description of the Order Line Item.
    description: option<string>,
    /// The name of the Order Line Item.
    item-name: option<string>,
    /// The number for the Order Line Item.
    item-number: option<string>,
    /// The state of the Order Line Item. See [Order Line Item states, Order states, and state transitions](https://knowledgecenter.zuora.com/Billing/Subscriptions/Orders/Order_Line_Items/AB_Order_Line_Item_States_and_Order_States) for more information.
    item-state: option<post-order-line-item-update-type-item-state-enum>,
    /// The type of the Order Line Item. 
    item-type: option<post-order-line-item-update-type-item-type-enum>,
    /// The list price per unit for the Order Line Item.
    list-price-per-unit: option<f64>,
    /// The product code for the Order Line Item.
    product-code: option<string>,
    /// Id of a Product Rate Plan Charge. Only one-time charges are supported.
    product-rate-plan-charge-id: option<string>,
    /// Used by customers to specify the Purchase Order Number provided by the buyer.
    purchase-order-number: option<string>,
    /// The quantity of units, such as the number of authors in a hosted wiki service.
    quantity: option<f64>,
    /// The recognized revenue accounting code for the Order Line Item.
    recognized-revenue-accounting-code: option<string>,
    /// The Revenue Recognition rule for the Order Line Item.
    revenue-recognition-rule: option<string>,
    /// The Id of an existing account which is set as the sold-to contact of the Order Line Item (OLI).
    sold-to: option<string>,
    sold-to-data: option<order-contact-retrieve-order-line-item>,
    /// The tax code for the Order Line Item.
    tax-code: option<string>,
    /// The tax mode for the Order Line Item.
    tax-mode: option<post-order-line-item-update-type-tax-mode-enum>,
    /// The transaction date of the Order Line Item.
    transaction-date: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record order-line-item-custom-fields-retrieve-order-line-item-entry {
    key: string,
    value: string
  }

  /// A new account created as the sold-to contact of the Order Line Item (OLI). 
  record order-contact-retrieve-order-line-item {
    /// First line of the contact's address. This is often a street address or a business name.
    address1: option<string>,
    /// Second line of the contact's address.
    address2: option<string>,
    /// City of the contact's address.
    city: option<string>,
    /// Country; must be a valid country name or abbreviation. If using [Zuora Tax](https://knowledgecenter.zuora.com/Billing/Taxes/A_Zuora_Tax), you must specify a country in the bill-to contact to calculate tax.
    country: option<string>,
    /// County of the contact's address.
    county: option<string>,
    /// First name of the contact.
    first-name: option<string>,
    /// Last name of the contact.
    last-name: option<string>,
    /// ZIP code or other postal code of the contact's address.
    postal-code: option<string>,
    /// State or province of the contact's address.
    state: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record order-line-item-custom-fields-entry-v2 {
    key: string,
    value: string
  }

  /// Update order line items
  record post-order-line-items-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    order-line-items: option<list<post-order-line-item-update-type>>,
    processing-options: option<processing-options>
  }
  post-order-line-items: func(params: post-order-line-items-params) -> result<get-order-line-item-response-type, string>;

  /// Retrieve an order line item
  record get-order-line-item-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The id of the Order Line Item to retrieve.
    item-id: string
  }
  get-order-line-item: func(params: get-order-line-item-params) -> result<string, string>;

  /// Update an order line item
  record put-order-line-item-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The id of the Order Line Item to update.
    item-id: string,
    /// Specifies the units to measure usage.
    /// 
    uom: option<string>,
    /// The accountingCode for the Order Line Item (OLI).
    /// 
    accounting-code: option<string>,
    /// The actual charged amount per unit for the Order Line Item (OLI).
    /// 
    amount-per-unit: option<f64>,
    /// The target date for the Order Line Item (OLI) to be picked up by bill run for generating invoice.
    /// 
    bill-target-date: option<string>,
    custom-fields: option<list<order-line-item-custom-fields-entry-v2>>,
    /// The deferred revenue accounting code for the Order Line Item (OLI).
    /// 
    deferred-revenue-accounting-code: option<string>,
    /// The description of the Order Line Item (OLI).
    /// 
    description: option<string>,
    /// The name of the Order Line Item (OLI).
    /// 
    item-name: option<string>,
    /// The number for the Order Line Item (OLI).
    /// 
    item-number: option<string>,
    /// The state of the Order Line Item (OLI). See [Order Line Item states, Order states, and state transitions](https://knowledgecenter.zuora.com/Billing/Subscriptions/Orders/Order_Line_Items/AB_Order_Line_Item_States_and_Order_States) for more information.
    /// 
    item-state: option<post-order-line-item-update-type-item-state-enum>,
    /// The type of the Order Line Item (OLI). 
    /// 
    item-type: option<post-order-line-item-update-type-item-type-enum>,
    /// The list price per unit for the Order Line Item (OLI).
    /// 
    list-price-per-unit: option<f64>,
    /// The product code for the Order Line Item (OLI).
    /// 
    product-code: option<string>,
    /// Used by customers to specify the Purchase Order Number provided by the buyer.
    /// 
    purchase-order-number: option<string>,
    /// The quantity of units, such as the number of authors in a hosted wiki service.
    /// 
    quantity: option<f64>,
    /// The recognized revenue accounting code for the Order Line Item (OLI).
    /// 
    recognized-revenue-accounting-code: option<string>,
    /// The Revenue Recognition rule for the Order Line Item (OLI).
    /// 
    revenue-recognition-rule: option<string>,
    /// The tax code for the Order Line Item (OLI).
    /// 
    tax-code: option<string>,
    /// The tax mode for the Order Line Item (OLI).
    /// 
    tax-mode: option<post-order-line-item-update-type-tax-mode-enum>,
    /// The transaction date of the Order Line Item (OLI).
    /// 
    transaction-date: option<string>
  }
  put-order-line-item: func(params: put-order-line-item-params) -> result<string, string>;

}

interface ramps {
  /// List ramp metrics by order number
  record get-ramp-metrics-by-order-number-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The number of the existing order.
    order-number: string
  }
  get-ramp-metrics-by-order-number: func(params: get-ramp-metrics-by-order-number-params) -> result<string, string>;

  /// Retrieve a ramp
  record get-ramp-by-ramp-number-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The automatically generated number of a ramp. For example, R-00000268.
    ramp-number: string
  }
  get-ramp-by-ramp-number: func(params: get-ramp-by-ramp-number-params) -> result<string, string>;

  /// List all ramp metrics of a ramp
  record get-ramp-metrics-by-ramp-number-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The automatically generated number of a ramp. For example, R-00000268.
    ramp-number: string
  }
  get-ramp-metrics-by-ramp-number: func(params: get-ramp-metrics-by-ramp-number-params) -> result<string, string>;

  /// List ramp metrics by subscription key
  record get-ramp-metrics-by-subscription-key-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The ID or number of an existing subscription.
    subscription-key: string
  }
  get-ramp-metrics-by-subscription-key: func(params: get-ramp-metrics-by-subscription-key-params) -> result<string, string>;

  /// Retrieve a ramp by subscription key
  record get-ramps-by-subscription-key-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The ID or number of an existing subscription.
    subscription-key: string
  }
  get-ramps-by-subscription-key: func(params: get-ramps-by-subscription-key-params) -> result<string, string>;

}

interface payment-runs {
  enum get-payment-runs-status-enum {
    pending,
    processing,
    completed,
    error,
    canceled,
  }

  enum post-payment-run-data-element-request-document-type-enum {
    invoice,
    debit-memo,
  }

  enum get-payment-run-data-element-response-result-op-enum {
    processed,
    error,
  }

  enum get-payment-run-data-transaction-element-response-status-enum {
    processed,
    processing,
    error,
  }

  enum get-payment-run-data-transaction-element-response-type-op-enum {
    payment,
    credit-memo,
    unapplied-payment,
    credit-balance-adjustment,
  }

  record get-payment-run-collection-type {
    /// The URL for requesting the next page of the response, if it exists; otherwise absent.
    next-page: option<string>,
    /// Container for payment runs.
    payment-runs: option<list<get-payment-run-type>>,
    /// Returns `true` if the request was processed successfully.
    success: option<bool>
  }

  record get-payment-run-type {
    /// The ID of the customer account associated with the payment run.
    account-id: option<string>,
    /// **Note:** This field is only available if you have the Credit Balance feature enabled and the Invoice Settlement feature disabled.
    /// 
    apply-credit-balance: option<bool>,
    /// **Note:** This field is only available if you have [Invoice Settlement](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement) enabled. The Invoice Settlement feature is generally available as of Zuora Billing Release 296 (March 2021). This feature includes Unapplied Payments, Credit and Debit Memo, and Invoice Item Settlement. If you want to enable Invoice Settlement, see [Invoice Settlement Enablement and Checklist Guide](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement/Invoice_Settlement_Migration_Checklist_and_Guide) for more information.
    /// 
    auto-apply-credit-memo: option<bool>,
    /// **Note:** This field is only available if you have [Invoice Settlement](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement) enabled. The Invoice Settlement feature is generally available as of Zuora Billing Release 296 (March 2021). This feature includes Unapplied Payments, Credit and Debit Memo, and Invoice Item Settlement. If you want to enable Invoice Settlement, see [Invoice Settlement Enablement and Checklist Guide](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement/Invoice_Settlement_Migration_Checklist_and_Guide) for more information.
    /// 
    auto-apply-unapplied-payment: option<bool>,
    /// The alias name given to a batch.
    batch: option<string>,
    /// The billing cycle day (BCD), the day of the month when a bill run generates invoices for the account. 
    bill-cycle-day: option<string>,
    /// The ID of the bill run.
    billing-run-id: option<string>,
    /// Whether to process electronic payments during the execution of payment runs. 
    collect-payment: option<bool>,
    /// The date and time when the payment run is completed, in `yyyy-mm-dd hh:mm:ss` format. For example, 2017-03-01 11:39:58.
    completed-on: option<string>,
    /// **Note:** The **Process Electronic Payment** permission also needs to be allowed for a Manage Payment Runs role to work. See [Payments Roles](https://knowledgecenter.zuora.com/CF_Users_and_Administrators/A_Administrator_Settings/User_Roles/e_Payments_Roles) for more information. 
    /// 
    consolidated-payment: option<bool>,
    /// The ID of the Zuora user who created the payment run.
    created-by-id: option<string>,
    /// The date and time when the payment run was created, in `yyyy-mm-dd hh:mm:ss` format. For example, 2017-03-01 15:31:10.
    created-date: option<string>,
    /// A currency defined in the web-based UI administrative settings.
    currency: option<string>,
    /// The date and time when the payment run is executed, in `yyyy-mm-dd hh:mm:ss` format. For example, 2017-03-01 11:30:37.
    executed-on: option<string>,
    /// The ID of the payment run.
    id: option<string>,
    /// The identification number of the payment run.
    number: option<string>,
    /// The ID of the gateway instance that processes the payment.
    payment-gateway-id: option<string>,
    /// **Note:** The **Process Electronic Payment** permission also needs to be allowed for a Manage Payment Runs role to work. See [Payments Roles](https://knowledgecenter.zuora.com/CF_Users_and_Administrators/A_Administrator_Settings/User_Roles/e_Payments_Roles) for more information. 
    /// 
    process-payment-with-closed-pm: option<bool>,
    /// The date and time when the scheduled payment run is to be executed for collecting payments.
    run-date: option<string>,
    /// The status of the created payment run.
    status: option<get-payment-runs-status-enum>,
    /// Returns `true` if the request was processed successfully.
    success: option<bool>,
    /// The target date used to determine which receivables to be collected in the payment run. 
    target-date: option<string>,
    /// The ID of the Zuora user who last updated the payment run.
    updated-by-id: option<string>,
    /// The date and time when the payment run was last updated, in `yyyy-mm-dd hh:mm:ss` format. For example, 2017-03-02 15:36:10.
    updated-date: option<string>
  }

  record post-payment-run-data-element-request {
    /// A valid account ID associated with the payment run.
    /// 
    account-id: string,
    /// The amount to be collected for the specified invoice/debit memo. `amount` must be a positive numeric value no more than the balance of the specified invoice/debit memo.
    /// 
    amount: option<f64>,
    /// Additional comments.
    comment: option<string>,
    /// The ID of a billing document associated with the payment run. `documentId` must be valid and match with `documentType`.
    /// 
    document-id: option<string>,
    /// The type of a billing document associated with the payment run. The value can be `Invoice` or `DebitMemo`, but `DebitMemo` is only supported if the Invoice Settlement feature is enabled.
    /// 
    document-type: option<post-payment-run-data-element-request-document-type-enum>,
    /// The ID of the payment gateway for collecting invoices/debit memos. The specified payment gateway must be valid and active. If it is not specified, the default payment gateway of the account is used. If no payment gateway is configured for the account, the default payment gateway of the tenant is used.
    /// 
    payment-gateway-id: option<string>,
    /// The ID of the payment method for collecting invoices/debit memos. The specified payment method must be a valid non-system payment method. If it is not specified, the default payment method of the account is used regardless of the `autoPay` value of the account.
    /// 
    payment-method-id: option<string>
  }

  record common-response-type {
    /// The Id of the process that handle the operation.
    process-id: option<string>,
    reasons: option<list<common-response-type-reasons-item>>,
    /// Indicates whether the call succeeded.
    success: option<bool>
  }

  record common-response-type-reasons-item {
    /// The error code of response.
    code: option<string>,
    /// The detail information of the error response
    message: option<string>
  }

  record get-payment-run-data-array-response {
    /// Container for payment run data. Each element in the array is a record processed by the payment run.
    data: option<list<get-payment-run-data-element-response>>,
    /// Returns `true` if the request was processed successfully.
    success: option<bool>
  }

  record get-payment-run-data-element-response {
    /// The customer account ID specified in the `data` field when creating the payment run.
    account-id: option<string>,
    /// The amount specified in the `data` field when creating the payment run. `null` is returned if it was not specified.
    amount: option<f64>,
    /// The amount that is collected.
    amount-collected: option<f64>,
    /// The amount to be collected.
    amount-to-collect: option<f64>,
    /// The comment specified in the `data` field when creating the payment run. `null` is returned if it was not specified.
    comment: option<string>,
    /// The billing document ID specified in the `data` field when creating the payment run. `null` is returned if it was not specified.
    document-id: option<string>,
    /// The billing document type specified in the `data` field when creating the payment run. `null` is returned if it was not specified.
    document-type: option<post-payment-run-data-element-request-document-type-enum>,
    /// The error code of the response.
    error-code: option<string>,
    /// The detailed information of the error response.
    error-message: option<string>,
    /// The payment gateway ID specified in the `data` field when creating the payment run. `null` is returned if it was not specified.
    payment-gateway-id: option<string>,
    /// The payment method ID specified in the `data` field when creating the payment run. `null` is returned if it was not specified.
    payment-method-id: option<string>,
    /// Indicates whether the data is processed successfully or not.
    result-op: option<get-payment-run-data-element-response-result-op-enum>,
    /// Container for transactions that apply to the current request. Each element contains an array of the settlement/payment applied to the record.
    transactions: option<list<get-payment-run-data-transaction-element-response>>
  }

  record get-payment-run-data-transaction-element-response {
    /// The total amount of the newly generated payment.
    /// 
    amount: option<f64>,
    /// The amount applied to the record.
    applied-amount: option<f64>,
    /// The error code of the response.
    /// 
    error-code: option<string>,
    /// The detailed information of the error response.
    /// 
    error-message: option<string>,
    /// The ID of the current transaction.
    id: option<string>,
    /// The status of the newly generated payment.
    /// 
    status: option<get-payment-run-data-transaction-element-response-status-enum>,
    /// The type of the current transaction.
    type-op: option<get-payment-run-data-transaction-element-response-type-op-enum>
  }

  record get-payment-run-summary-response {
    /// **Note:** This field is only available if you have the Credit Balance feature enabled.
    /// 
    number-of-credit-balance-adjustments: option<s32>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    number-of-credit-memos: option<s32>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    number-of-debit-memos: option<s32>,
    /// The number of input data that are processed with errors.
    number-of-error-input-data: option<s32>,
    /// The number of payments with the status of `Error` and `Processing`.
    number-of-errors: option<s32>,
    /// The total number of input data.
    number-of-input-data: option<s32>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    number-of-invoices: option<s32>,
    /// The number of payments that are successfully processed in the payment run.
    number-of-payments: option<s32>,
    /// The number of input data that are successfully processed.
    number-of-processed-input-data: option<s32>,
    /// The total number of receivables that are picked up for processing in the payment run.
    /// 
    number-of-receivables: option<s32>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    number-of-unapplied-payments: option<s32>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    number-of-unprocessed-debit-memos: option<s32>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    number-of-unprocessed-invoices: option<s32>,
    /// The number of receivables with remaining positive balances after the payment run is completed.
    number-of-unprocessed-receivables: option<s32>,
    /// Returns `true` if the request was processed successfully.
    success: option<bool>,
    /// Container for total values.
    total-values: option<list<get-payment-run-summary-total-values>>
  }

  record get-payment-run-summary-total-values {
    /// **Note:** This field is only available if you have the Credit Balance feature enabled.
    /// 
    total-value-of-credit-balance: option<string>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    total-value-of-credit-memos: option<string>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    total-value-of-debit-memos: option<string>,
    /// The total amount of receivables associated with the payments with the status of `Error` and `Processing`.
    total-value-of-errors: option<string>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    total-value-of-invoices: option<string>,
    /// The total amount of payments that are successfully processed in the payment run.
    total-value-of-payments: option<string>,
    /// The total amount of receivables associated with the payment run.
    /// 
    total-value-of-receivables: option<string>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    total-value-of-unapplied-payments: option<s32>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    total-value-of-unprocessed-debit-memos: option<string>,
    /// **Note:** This field is only available if you have the Invoice Settlement feature enabled.
    /// 
    total-value-of-unprocessed-invoices: option<string>,
    /// The total amount of receivables with remaining positive balances after the payment run is completed.
    total-value-of-unprocessed-receivables: option<string>
  }

  /// List payment runs
  record get-payment-runs-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Number of rows returned per page.
    page-size: option<s32>,
    /// This parameter filters the response based on the `createdById` field.
    created-by-id: option<string>,
    /// This parameter filters the response based on the `createdDate` field.
    created-date: option<string>,
    /// This parameter filters the response based on the `status` field.
    status: option<get-payment-runs-status-enum>,
    /// This parameter filters the response based on the `targetDate` field.
    target-date: option<string>,
    /// This parameter filters the response based on the `updatedById` field.
    updated-by-id: option<string>,
    /// This parameter filters the response based on the `updatedDate` field.
    updated-date: option<string>,
    /// This parameter restricts the order of the data returned in the response. You can use this parameter to supply a dimension you want to sort on.
    /// 
    sort: option<string>
  }
  get-payment-runs: func(params: get-payment-runs-params) -> result<get-payment-run-collection-type, string>;

  /// Create a payment run
  record post-payment-run-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The ID of the customer account associated with the payment run.
    /// 
    account-id: option<string>,
    /// **Note:** This field is only available if you have the Credit Balance feature enabled and the Invoice Settlement feature disabled.
    /// 
    apply-credit-balance: option<bool>,
    /// **Note:** This field is only available if you have [Invoice Settlement](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement) enabled. The Invoice Settlement feature is generally available as of Zuora Billing Release 296 (March 2021). This feature includes Unapplied Payments, Credit and Debit Memo, and Invoice Item Settlement. If you want to enable Invoice Settlement, see [Invoice Settlement Enablement and Checklist Guide](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement/Invoice_Settlement_Migration_Checklist_and_Guide) for more information.
    /// 
    auto-apply-credit-memo: option<bool>,
    /// **Note:** This field is only available if you have [Invoice Settlement](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement) enabled. The Invoice Settlement feature is generally available as of Zuora Billing Release 296 (March 2021). This feature includes Unapplied Payments, Credit and Debit Memo, and Invoice Item Settlement. If you want to enable Invoice Settlement, see [Invoice Settlement Enablement and Checklist Guide](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement/Invoice_Settlement_Migration_Checklist_and_Guide) for more information.
    /// 
    auto-apply-unapplied-payment: option<bool>,
    /// The alias name given to a batch. The batch name is a string of 50 characters or less.
    /// 
    batch: option<string>,
    /// The billing cycle day (BCD), the day of the month when a bill run generates invoices for the account. The value must be equal to or less then 31, and 31 is mean the EOM.
    /// 
    bill-cycle-day: option<string>,
    /// The ID of a bill run.
    /// 
    billing-run-id: option<string>,
    /// Whether to process electronic payments during the execution of payment runs. 
    /// 
    collect-payment: option<bool>,
    /// **Note:** The **Process Electronic Payment** permission also needs to be allowed for a Manage Payment Runs role to work. See [Payments Roles](https://knowledgecenter.zuora.com/CF_Users_and_Administrators/A_Administrator_Settings/User_Roles/e_Payments_Roles) for more information. 
    /// 
    consolidated-payment: option<bool>,
    /// A currency defined in the web-based UI administrative settings.
    /// 
    currency: option<string>,
    /// 
    /// The array of data for specifying records of accounts and invoices/debit memos that will be collected and processed by a payment run. A maximum of 50K records are allowed to be passed into the `data` array.
    data: option<list<post-payment-run-data-element-request>>,
    /// The ID of the gateway instance that processes the payment.
    /// 
    payment-gateway-id: option<string>,
    /// **Note:** The **Process Electronic Payment** permission also needs to be allowed for a Manage Payment Runs role to work. See [Payments Roles](https://knowledgecenter.zuora.com/CF_Users_and_Administrators/A_Administrator_Settings/User_Roles/e_Payments_Roles) for more information. 
    /// 
    process-payment-with-closed-pm: option<bool>,
    /// The date and time when the scheduled payment run is to be executed, in `yyyy-mm-dd hh:mm:ss` format. The backend will ignore mintues and seconds in the field value. For example, if you specify `2017-03-01 11:30:37` for this value, this payment run will be run at 2017-03-01 11:00:00.
    /// 
    run-date: option<string>,
    /// The target date used to determine which receivables to be paid in the payment run. The payments are collected for all receivables with the due date no later than the target date.
    /// 
    target-date: option<string>
  }
  post-payment-run: func(params: post-payment-run-params) -> result<string, string>;

  /// Retrieve a payment run
  record get-payment-run-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a payment run. For example, 402890245f097f39015f0f074a2e0566.
    payment-run-id: string
  }
  get-payment-run: func(params: get-payment-run-params) -> result<get-payment-run-type, string>;

  /// Update a payment run
  record put-payment-run-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The unique ID of a payment run. For example, 402890245f097f39015f0f074a2e0566.
    payment-run-id: string,
    /// The ID of the customer account associated with the payment run.
    /// 
    account-id: option<string>,
    /// **Note:** This field is only available if you have the Credit Balance feature enabled and the Invoice Settlement feature disabled.
    /// 
    apply-credit-balance: option<bool>,
    /// **Note:** This field is only available if you have [Invoice Settlement](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement) enabled. The Invoice Settlement feature is generally available as of Zuora Billing Release 296 (March 2021). This feature includes Unapplied Payments, Credit and Debit Memo, and Invoice Item Settlement. If you want to enable Invoice Settlement, see [Invoice Settlement Enablement and Checklist Guide](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement/Invoice_Settlement_Migration_Checklist_and_Guide) for more information.
    /// 
    auto-apply-credit-memo: option<bool>,
    /// **Note:** This field is only available if you have [Invoice Settlement](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement) enabled. The Invoice Settlement feature is generally available as of Zuora Billing Release 296 (March 2021). This feature includes Unapplied Payments, Credit and Debit Memo, and Invoice Item Settlement. If you want to enable Invoice Settlement, see [Invoice Settlement Enablement and Checklist Guide](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement/Invoice_Settlement_Migration_Checklist_and_Guide) for more information.
    /// 
    auto-apply-unapplied-payment: option<bool>,
    /// The alias name given to a batch. The batch name is a string of 50 characters or less.
    /// 
    batch: option<string>,
    /// The billing cycle day (BCD), the day of the month when a bill run generates invoices for the account. The value must be equal to or less then 31, and 31 is mean the EOM.
    /// 
    bill-cycle-day: option<string>,
    /// The ID of a bill run.
    /// 
    billing-run-id: option<string>,
    /// Whether to process electronic payments during the execution of payment runs. 
    /// 
    collect-payment: option<bool>,
    /// **Note:** The **Process Electronic Payment** permission also needs to be allowed for a Manage Payment Runs role to work. See [Payments Roles](https://knowledgecenter.zuora.com/CF_Users_and_Administrators/A_Administrator_Settings/User_Roles/e_Payments_Roles) for more information. 
    /// 
    consolidated-payment: option<bool>,
    /// A currency defined in the web-based UI administrative settings.
    /// 
    currency: option<string>,
    /// The ID of the gateway instance that processes the payment.
    /// 
    payment-gateway-id: option<string>,
    /// **Note:** The **Process Electronic Payment** permission also needs to be allowed for a Manage Payment Runs role to work. See [Payments Roles](https://knowledgecenter.zuora.com/CF_Users_and_Administrators/A_Administrator_Settings/User_Roles/e_Payments_Roles) for more information. 
    /// 
    process-payment-with-closed-pm: option<bool>,
    /// The date and time when the scheduled payment run is to be executed, in `yyyy-mm-dd hh:mm:ss` format. The backend will ignore mintues and seconds in the field value. For example, if you specify `2017-03-01 11:30:37` for this value, this payment run will be run at 2017-03-01 11:00:00.
    run-date: option<string>,
    /// The target date used to determine which receivables to be paid in the payment run. The payments are collected for all receivables with the due date no later than the target date.
    target-date: option<string>
  }
