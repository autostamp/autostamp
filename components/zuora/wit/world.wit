interface summary-journal-entries {
  enum post-journal-entry-item-type-accounting-code-type-enum {
    accounts-receivable,
    on-account-receivable,
    cash,
    other-assets,
    customer-cash-on-account,
    deferred-revenue,
    sales-tax-payable,
    other-liabilities,
    sales-revenue,
    sales-discounts,
    other-revenue,
    other-equity,
    bad-debt,
    other-expenses,
  }

  enum post-journal-entry-item-type-type-op-enum {
    credit,
    debit,
  }

  enum post-journal-entry-type-transferred-to-accounting-enum {
    no,
    processing,
    yes,
    error,
    ignore,
  }

  record post-journal-entry-item-type {
    /// Name of the accounting code.
    accounting-code-name: string,
    /// Accounting code type. This field is required if `accountingCodeName` is not unique.
    /// 
    accounting-code-type: option<post-journal-entry-item-type-accounting-code-type-enum>,
    /// Journal entry item amount in transaction currency.
    amount: string,
    /// Journal entry item amount in home currency.
    /// 
    home-currency-amount: option<string>,
    /// Type of journal entry item. 
    type-op: post-journal-entry-item-type-type-op-enum
  }

  record post-journal-entry-segment-type {
    /// Name of segment. You must use the segment name that has already been specified in the default segment rule. In addition, segments need to be passed in the order where they were defined in the segmentation rule. If multiple segments are configured in the default rule, you need to specify all of them in order. 
    segment-name: string,
    /// Value of segment in this summary journal entry.
    segment-value: string
  }

  record put-journal-entry-item-type {
    /// Name of the accounting code.
    /// 
    accounting-code-name: string,
    /// Accounting code type.
    /// 
    accounting-code-type: option<post-journal-entry-item-type-accounting-code-type-enum>,
    /// Type of journal entry item. 
    type-op: post-journal-entry-item-type-type-op-enum
  }

  /// Create a summary journal entry
  record post-summary-journal-entry-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Name of the accounting period. The open-ended accounting period is named `Open-Ended`.
    accounting-period-name: string,
    /// The type of currency used. Currency must be active.
    currency: string,
    /// Date of the journal entry.
    journal-entry-date: string,
    /// Key name that represents the list of journal entry items.
    journal-entry-items: list<post-journal-entry-item-type>,
    /// The number associated with the revenue event.
    /// 
    notes: option<string>,
    /// List of segments that apply to the summary journal entry.
    segments: option<list<post-journal-entry-segment-type>>,
    /// Status shows whether the journal entry has been transferred to an accounting system.
    transferred-to-accounting: option<post-journal-entry-type-transferred-to-accounting-enum>
  }
  post-summary-journal-entry: func(params: post-summary-journal-entry-params) -> result<string, string>;

  /// List all summary journal entries in a journal run
  record get-all-summary-journal-entries-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Number of rows returned per page.
    page-size: option<s32>,
    /// Journal run number.
    jr-number: string
  }
  get-all-summary-journal-entries: func(params: get-all-summary-journal-entries-params) -> result<string, string>;

  /// Retrieve a summary journal entry
  record get-summary-journal-entry-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    je-number: string
  }
  get-summary-journal-entry: func(params: get-summary-journal-entry-params) -> result<string, string>;

  /// Delete a summary journal entry
  record delete-summary-journal-entry-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Journal entry number in the format JE-00000001.
    je-number: string
  }
  delete-summary-journal-entry: func(params: delete-summary-journal-entry-params) -> result<string, string>;

  /// Update a summary journal entry
  record put-basic-summary-journal-entry-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Journal entry number in the format JE-00000001.
    je-number: string,
    /// Key name that represents the list of journal entry items.
    journal-entry-items: option<list<put-journal-entry-item-type>>,
    /// Additional information about this record.
    /// 
    notes: option<string>,
    /// Status shows whether the journal entry has been transferred to an accounting system. 
    /// 
    transferred-to-accounting: option<post-journal-entry-type-transferred-to-accounting-enum>
  }
  put-basic-summary-journal-entry: func(params: put-basic-summary-journal-entry-params) -> result<string, string>;

  /// Cancel a summary journal entry
  record put-summary-journal-entry-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Journal entry number in the format JE-00000001.
    je-number: string
  }
  put-summary-journal-entry: func(params: put-summary-journal-entry-params) -> result<string, string>;

}

interface journal-runs {
  enum post-journal-run-transaction-type-type-op-enum {
    invoice-item,
    taxation-item,
    invoice-item-adjustment-invoice,
    invoice-item-adjustment-tax,
    invoice-adjustment,
    electronic-payment,
    external-payment,
    electronic-refund,
    external-refund,
    electronic-credit-balance-payment,
    external-credit-balance-payment,
    electronic-credit-balance-refund,
    external-credit-balance-refund,
    credit-balance-adjustment-applied-from-credit-balance,
    credit-balance-adjustment-transferred-to-credit-balance,
    revenue-event-item,
    debit-memo-item-charge,
    debit-memo-item-tax,
    credit-memo-item-charge,
    credit-memo-item-tax,
    credit-memo-application-item,
    electronic-payment-application,
    external-payment-application,
    electronic-refund-application,
    external-refund-application,
    electronic-payment-application-item,
    external-payment-application-item,
    electronic-refund-application-item,
    external-refund-application-item,
  }

  record post-journal-run-transaction-type {
    /// Transaction type. Invoice Adjustment is deprecated on Production. Zuora recommends that you use the Invoice Item Adjustment instead.
    /// 
    type-op: post-journal-run-transaction-type-type-op-enum
  }

  /// Create a journal run
  record post-journal-run-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
