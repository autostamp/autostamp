interface custom-object-definitions {
  enum get-all-custom-object-definitions-in-namespace-select-enum {
    type-op,
  }

  enum custom-object-all-fields-definition-created-by-id-format-enum {
    uuid,
  }

  enum custom-object-all-fields-definition-created-by-id-origin-enum {
    system,
  }

  enum custom-object-all-fields-definition-created-by-id-type-op-enum {
    string-op,
  }

  enum custom-object-all-fields-definition-created-date-format-enum {
    date-time,
  }

  enum custom-object-definition-schema-relationships-item-cardinality-enum {
    many-to-one,
    one-to-many,
  }

  enum custom-object-definition-schema-type-op-enum {
    object,
  }

  enum post-custom-object-definitions-request-definition-relationships-item-cardinality-enum {
    many-to-one,
  }

  enum custom-object-custom-field-definition-update-origin-enum {
    custom,
  }

  enum custom-object-definition-update-action-request-type-op-enum {
    add-field,
    delete-field,
    update-field,
    update-object,
    rename-field,
    add-relationship,
    delete-relationship,
  }

  record get-all-custom-object-definitions-in-namespace-response {
    /// The number of objects in the `definitions` object. The value of this field is the number of custom object definitions in the namespace.
    count: option<s32>,
    definitions: option<list<custom-object-definitions-entry>>
  }

  record custom-object-definition {
    /// The creator's Id
    created-by-id: option<string>,
    /// The creation time of the custom object definition in date-time format.
    created-date: option<string>,
    /// The unique Id of the custom object definition
    id: option<string>,
    /// The modifier's Id
    updated-by-id: option<string>,
    /// The update time of the custom object definition in date-time format.
    updated-date: option<string>,
    /// The schema of the custom object definition
    schema: option<custom-object-definition-schema>,
    /// The API name of the custom object
    type-op: option<string>
  }

  /// The schema of the custom object definition
  record custom-object-definition-schema {
    /// The set of fields that are allowed to be queried on. Queries on non-filterable fields will be rejected. You can not change a non-filterable field to filterable.
    filterable: option<list<string>>,
    /// A label for the custom object
    label: option<string>,
    /// The API name of the custom object
    object: option<string>,
    properties: option<custom-object-all-fields-definition>,
    /// An array of relationships with Zuora objects or other custom objects
    relationships: option<list<custom-object-definition-schema-relationships-item>>,
    /// The required fields of the custom object definition. You can change required fields to optional. However, you can only change optional fields to required on the custom objects with no records.
    required: option<list<string>>,
    /// The custom object definition type. Can only be `object` currently.
    type-op: option<custom-object-definition-schema-type-op-enum>
  }

  /// The definitions of all the fields in the custom object definition
  record custom-object-all-fields-definition {
    /// The `CreatedById` field definition
    created-by-id: option<custom-object-all-fields-definition-created-by-id>,
    /// The `CreatedDate` field definition
    created-date: option<custom-object-all-fields-definition-created-date>,
    /// The `Id` field definition
    id: option<custom-object-all-fields-definition-id>,
    /// The `UpdatedById` field definition
    updated-by-id: option<custom-object-all-fields-definition-updated-by-id>,
    /// The `UpdatedDate` field definition
    updated-date: option<custom-object-all-fields-definition-updated-date>
  }

  /// The `CreatedById` field definition
  record custom-object-all-fields-definition-created-by-id {
    /// The field data format
    format: option<custom-object-all-fields-definition-created-by-id-format-enum>,
    /// The UI name of the field
    label: option<string>,
    /// Specifies whether the field is a system field or a custom field
    origin: option<custom-object-all-fields-definition-created-by-id-origin-enum>,
    /// The field data type
    type-op: option<custom-object-all-fields-definition-created-by-id-type-op-enum>
  }

  /// The `CreatedDate` field definition
  record custom-object-all-fields-definition-created-date {
    /// The field data format
    format: option<custom-object-all-fields-definition-created-date-format-enum>,
    /// Specifies the field is a system field
    origin: option<custom-object-all-fields-definition-created-by-id-origin-enum>,
    /// The field data type
    type-op: option<custom-object-all-fields-definition-created-by-id-type-op-enum>
  }

  /// The `Id` field definition
  record custom-object-all-fields-definition-id {
    /// The field data format
    format: option<custom-object-all-fields-definition-created-by-id-format-enum>,
    /// The UI name of the field
    label: option<string>,
    /// Specifies whether the field is a system field or a custom field
    origin: option<custom-object-all-fields-definition-created-by-id-origin-enum>,
    /// The field data type
    type-op: option<custom-object-all-fields-definition-created-by-id-type-op-enum>
  }

  /// The `UpdatedById` field definition
  record custom-object-all-fields-definition-updated-by-id {
    /// The field data format
    format: option<custom-object-all-fields-definition-created-by-id-format-enum>,
    /// The UI name of the field
    label: option<string>,
    /// Specifies whether the field is a system field or a custom field
    origin: option<custom-object-all-fields-definition-created-by-id-origin-enum>,
    /// The field data type
    type-op: option<custom-object-all-fields-definition-created-by-id-type-op-enum>
  }

  /// The `UpdatedDate` field definition
  record custom-object-all-fields-definition-updated-date {
    /// The field data format
    format: option<custom-object-all-fields-definition-created-date-format-enum>,
    /// Specifies the field is a system field
    origin: option<custom-object-all-fields-definition-created-by-id-origin-enum>,
    /// The field data type
    type-op: option<custom-object-all-fields-definition-created-by-id-type-op-enum>
  }

  record custom-object-definition-schema-relationships-item {
    /// The cardinality of the relationship from this object to another object.
    /// 
    cardinality: option<custom-object-definition-schema-relationships-item-cardinality-enum>,
    fields: option<list<fields-additional-properties-entry>>,
    /// The namespace where the related object is located
    namespace: option<string>,
    /// The API name of the related object
    object: option<string>,
    /// Specifies contraints to apply to custom object records.
    record-constraints: option<custom-object-definition-schema-relationships-item-record-constraints>
  }

  /// one entry of a string-keyed map (free-form object)
  record fields-additional-properties-entry {
    key: string,
    value: string
  }

  /// Specifies contraints to apply to custom object records.
  record custom-object-definition-schema-relationships-item-record-constraints {
    create: option<custom-object-definition-schema-relationships-item-record-constraints-create>
  }

  record custom-object-definition-schema-relationships-item-record-constraints-create {
    /// Specifies whether Zuora validates the values of mapped fields
    /// in custom object records.
    enforce-valid-mapping: option<bool>
  }

  /// one entry of a string-keyed map (free-form object)
  record custom-object-definitions-entry {
    key: string,
    value: custom-object-definition
  }

  record post-custom-object-definitions-request-definition {
    /// The set of fields that are allowed to be queried on. Queries on non-filterable fields will be rejected. You can not change a non-filterable field to filterable.
    filterable: option<list<string>>,
    /// A UI label for the custom object
    label: string,
    /// The API name of the custom object
    object: string,
    properties: option<list<post-custom-object-definition-fields-definition-request-entry>>,
    /// An array of relationships with Zuora objects or other custom objects. You can add at most 2 `manyToOne` relationships when creating a custom field definition.
    relationships: option<list<post-custom-object-definitions-request-definition-relationships-item>>,
    /// The required fields of the custom object. You can change required fields to optional. However, you can only change optional fields to required on the custom objects with no records.
    required: option<list<string>>
  }

  record post-custom-object-definition-field-definition-request {
    /// The data format of the custom field
    format: option<string>,
    /// The UI label of the custom field
    label: string,
    /// The data type of the custom field
    type-op: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-custom-object-definition-fields-definition-request-entry {
    key: string,
    value: post-custom-object-definition-field-definition-request
  }

  record post-custom-object-definitions-request-definition-relationships-item {
    /// The cardinality of the relationship from this object to another object.
    /// 
    cardinality: option<post-custom-object-definitions-request-definition-relationships-item-cardinality-enum>,
    fields: list<fields-additional-properties-for-post-definition-entry>,
    /// The namespace where the related object is located
    namespace: string,
    /// The API name of the related object
    object: string,
    /// Specifies contraints to apply to custom object records.
    record-constraints: option<post-custom-object-definitions-request-definition-relationships-item-record-constraints>
  }

  /// one entry of a string-keyed map (free-form object)
  record fields-additional-properties-for-post-definition-entry {
    key: string,
    value: string
  }

  /// Specifies contraints to apply to custom object records.
  record post-custom-object-definitions-request-definition-relationships-item-record-constraints {
    create: option<post-custom-object-definitions-request-definition-relationships-item-record-constraints-create>
  }

  record post-custom-object-definitions-request-definition-relationships-item-record-constraints-create {
    /// Specifies whether Zuora validates the values of mapped fields
    /// in custom object records.
    enforce-valid-mapping: option<bool>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-custom-object-definitions-request-definitions-entry {
    key: string,
    value: post-custom-object-definitions-request-definition
  }

  record custom-object-definition-update-action-request {
    /// Optional property for `updateObject` action
    description: option<string>,
    field: option<update-custom-object-cusotm-field>,
    /// Optional property for `updateObject` action
    label: option<string>,
    /// The namespace of the custom object definition to be updated
    namespace: string,
    /// The API name of the custom object definition to be updated
    object: string,
    relationship: option<custom-object-definition-update-action-request-relationship>,
    /// The type of the updating action on a custom object definition
    type-op: custom-object-definition-update-action-request-type-op-enum
  }

  /// A reference to a field.
  record update-custom-object-cusotm-field {
    definition: option<custom-object-custom-field-definition-update>,
    /// Indicates whether the field is filterable or not. Applicable to `addField` and `updateField` actions.
    /// 
    filterable: option<bool>,
    /// The name of the custom field to be updated
    name: option<string>,
    /// Indicates whether the field is required or optional.
    /// 
    required: option<bool>,
    /// Required if the `type` of the action is `renameField`
    target-name: option<string>
  }

  /// The custom field definition in the custom object
  record custom-object-custom-field-definition-update {
    /// Applicable if the `type` of the action is  `updateField`
    default: option<string>,
    /// Applicable if the `type` of the action is  `updateField`
    description: option<string>,
    /// The data format of the custom field
    format: option<string>,
    /// The UI label of the custom field
    label: option<string>,
    /// Specifies that this is a custom field
    origin: option<custom-object-custom-field-definition-update-origin-enum>,
    /// The data type of the custom field
    type-op: option<string>
  }

  record custom-object-definition-update-action-request-relationship {
    /// The cardinality of the relationship from this object to another object.
    /// 
    cardinality: option<post-custom-object-definitions-request-definition-relationships-item-cardinality-enum>,
    fields: list<fields-additional-properties-entry-v2>,
    /// The namespace where the related object is located
    namespace: string,
    /// The API name of the related object
    object: string,
    /// Specifies contraints to apply to custom object records.
    record-constraints: option<custom-object-definition-update-action-request-relationship-record-constraints>
  }

  /// one entry of a string-keyed map (free-form object)
  record fields-additional-properties-entry-v2 {
    key: string,
    value: string
  }

  /// Specifies contraints to apply to custom object records.
  record custom-object-definition-update-action-request-relationship-record-constraints {
    create: option<custom-object-definition-update-action-request-relationship-record-constraints-create>
  }

  record custom-object-definition-update-action-request-relationship-record-constraints-create {
    /// Specifies whether Zuora validates the values of mapped fields
    /// in custom object records.
    enforce-valid-mapping: option<bool>
  }

  record migration-update-custom-object-definitions-response {
    /// The actions of updating custom object definitions, to be performed as parts of the migration.  Currently only one action per migration is supported.
    actions: option<list<custom-object-definition-update-action-response>>
  }

  record custom-object-definition-update-action-response {
    /// Optional property for `updateObject` action
    description: option<string>,
    field: option<update-custom-object-cusotm-field>,
    /// Optional property for `updateObject` action
    label: option<string>,
    /// The namespace of the custom object definition to be updated
    namespace: option<string>,
    /// The API name of the custom object definition to be updated
    object: option<string>,
    relationship: option<custom-object-definition-update-action-response-relationship>,
    /// The type of the updating action on a custom object definition
    type-op: option<custom-object-definition-update-action-request-type-op-enum>
  }

  record custom-object-definition-update-action-response-relationship {
    /// The cardinality of the relationship from this object to another object.
    /// 
    cardinality: option<custom-object-definition-schema-relationships-item-cardinality-enum>,
    fields: option<list<fields-additional-properties-entry-v3>>,
    /// The namespace where the related object is located
    namespace: option<string>,
    /// The API name of the related object
    object: option<string>,
    /// Specifies contraints to apply to custom object records.
    record-constraints: option<custom-object-definition-update-action-response-relationship-record-constraints>
  }

  /// one entry of a string-keyed map (free-form object)
  record fields-additional-properties-entry-v3 {
    key: string,
    value: string
  }

  /// Specifies contraints to apply to custom object records.
  record custom-object-definition-update-action-response-relationship-record-constraints {
    create: option<custom-object-definition-update-action-response-relationship-record-constraints-create>
  }

  record custom-object-definition-update-action-response-relationship-record-constraints-create {
    /// Specifies whether Zuora validates the values of mapped fields
    /// in custom object records.
    enforce-valid-mapping: option<bool>
  }

  variant post-custom-object-definitions-error {
    bad-request(string),
    other(string)
  }

  variant get-custom-object-definition-by-type-error {
    not-found(string),
    other(string)
  }

  /// List custom object definitions
  record get-all-custom-object-definitions-in-namespace-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// If you set `select` to `type`, the response will only contain the `type` of each custom object.
    select: option<get-all-custom-object-definitions-in-namespace-select-enum>
  }
  get-all-custom-object-definitions-in-namespace: func(params: get-all-custom-object-definitions-in-namespace-params) -> result<get-all-custom-object-definitions-in-namespace-response, string>;

  /// Create custom object definitions
