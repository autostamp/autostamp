package autostamp:zuora@0.2.1;

interface charge-metrics {
  /// List charge metrics by time range
  record get-charge-metrics-params {
    /// The starting date and time of a time range when changes are made to charge metrics, in `yyyy-mm-ddThh:mm:ssZ` format. For example, `2020-08-18T09:01:11Z`. The timestamp maps to the `UpdatedOn` timestamp of the to-be-exported object.
    from-timestamp: string,
    /// The end date and time of a time range when changes are made to charge metrics, in `yyyy-mm-ddThh:mm:ssZ` format. For example, `2020-08-20T09:01:11Z`. The timestamp maps to the `UpdatedOn` timestamp of the to-be-exported object.
    to-timestamp: string
  }
  get-charge-metrics: func(params: get-charge-metrics-params) -> result<string, string>;

  /// List discount allocation details by time range
  record get-charge-metrics-discount-allocation-details-params {
    /// The starting date and time of a time range when changes are made to charge metrics, in `yyyy-mm-ddThh:mm:ssZ` format. For example, `2020-08-18T09:01:11Z`. The timestamp maps to the `UpdatedOn` timestamp of the to-be-exported object.
    from-timestamp: string,
    /// The end date and time of a time range when changes are made to charge metrics, in `yyyy-mm-ddThh:mm:ssZ` format. For example, `2020-08-20T09:01:11Z`. The timestamp maps to the `UpdatedOn` timestamp of the to-be-exported object.
    to-timestamp: string
  }
  get-charge-metrics-discount-allocation-details: func(params: get-charge-metrics-discount-allocation-details-params) -> result<string, string>;

}


interface event-triggers {
  /// List event triggers
  record get-event-triggers-params {
    /// The Zuora object that trigger condition is defined upon. Should be specified in the pattern: ^[A-Z][\\w\\-]*$
    base-object: option<string>,
    /// The event type name. Should be specified in the pattern: ^[A-Za-z]{1,}[\w\-]*$
    event-type-name: option<string>,
    /// The status of the event trigger.
    active: option<string>,
    /// The first index of the query result. Default to 0 if absent, and the minimum is 0.
    start: option<s32>,
    /// The maximum number of data records to be returned. Default to 10 if absent.
    limit: option<s32>
  }
  get-event-triggers: func(params: get-event-triggers-params) -> result<string, string>;

  /// Create an event trigger
  post-event-trigger: func() -> result<string, string>;

  /// Retrieve an event trigger
  record get-event-trigger-params {
    id: string
  }
  get-event-trigger: func(params: get-event-trigger-params) -> result<string, string>;

  /// Update an event trigger
  record put-event-trigger-params {
    id: string
  }
  put-event-trigger: func(params: put-event-trigger-params) -> result<string, string>;

  /// Delete an event trigger
  record delete-event-trigger-params {
    id: string
  }
  delete-event-trigger: func(params: delete-event-trigger-params) -> result<string, string>;

}

interface notifications {
  /// List email templates
  record get-query-email-templates-params {
    /// The first index of the query result.
    start: option<s32>,
    /// The maximum number of results the query should return.
    limit: option<s32>,
    /// The name of the event.
    event-type-name: option<string>,
    /// The name of the email template.
    name: option<string>
  }
  get-query-email-templates: func(params: get-query-email-templates-params) -> result<string, string>;

  /// Create an email template
  post-create-email-template: func() -> result<string, string>;

  /// Retrieve an email template
  record get-get-email-template-params {
    /// The ID of the email template.
    id: string
  }
  get-get-email-template: func(params: get-get-email-template-params) -> result<string, string>;

  /// Update an email template
  record put-update-email-template-params {
    /// The ID of the email template to be updated.
    id: string
  }
  put-update-email-template: func(params: put-update-email-template-params) -> result<string, string>;

  /// Delete an email template
  record delete-delete-email-template-params {
    /// The ID of the email template to be deleted.
    id: string
  }
  delete-delete-email-template: func(params: delete-delete-email-template-params) -> result<string, string>;

  /// Delete notification histories for an account
  record delete-delete-notification-history-for-account-params {
    /// The ID of the account whose notification histories are to be deleted.
    account-id: string
  }
  delete-delete-notification-history-for-account: func(params: delete-delete-notification-history-for-account-params) -> result<string, string>;

  /// Retrieve a notification history deletion task
  record get-get-notification-history-deletion-task-params {
    /// The ID of the notification history deletion task. You can get the deletion task ID from the 202 response body of the [Delete notification histories for an account](https://www.zuora.com/developer/api-reference/#operation/DELETE_Delete_Notification_History_For_Account) operation.
    id: string
  }
  get-get-notification-history-deletion-task: func(params: get-get-notification-history-deletion-task-params) -> result<string, string>;

  /// List notification definitions
  record get-query-notification-definitions-params {
    /// The first index of the query result.
    start: option<s32>,
    /// The maximum number of results the query should return.
    limit: option<s32>,
    /// Id of the profile.
    profile-id: option<string>,
    /// The name of the event.
    event-type-name: option<string>,
    /// The ID of the email template.
    email-template-id: option<string>
  }
  get-query-notification-definitions: func(params: get-query-notification-definitions-params) -> result<string, string>;

  /// Create a notification definition
  post-create-notification-definition: func() -> result<string, string>;

  /// Retrieve a notification definition
  record get-get-notification-definition-params {
    /// The ID of the notification definition.
    id: string
  }
  get-get-notification-definition: func(params: get-get-notification-definition-params) -> result<string, string>;

  /// Update a notification definition
  record put-update-notification-definition-params {
    /// The ID of the notification definition to be updated.
    id: string
  }
  put-update-notification-definition: func(params: put-update-notification-definition-params) -> result<string, string>;

  /// Delete a notification definition
  record delete-delete-notification-definition-params {
    /// The ID of the notification definition to be deleted.
    id: string
  }
  delete-delete-notification-definition: func(params: delete-delete-notification-definition-params) -> result<string, string>;

  /// List callout notification histories
  record get-callout-history-params {
    /// The final date and time of records to be returned. Defaults to now. Use format yyyy-MM-ddTHH:mm:ss.
    end-time: option<string>,
    /// The initial date and time of records to be returned. Defaults to (end time - 1 day). Use format yyyy-MM-ddTHH:mm:ss.
    start-time: option<string>,
    /// The ID of an object that triggered a callout notification. 
    /// 
    object-id: option<string>,
    /// If `true`, only return failed records. If `false`, return all records in the given date range. The default value is `true`.
    /// 
    failed-only: option<bool>,
    /// Category of records to be returned by event category.
    /// 
    event-category: option<string>,
    include-response-content: option<bool>
  }
  get-callout-history: func(params: get-callout-history-params) -> result<string, string>;

  /// List email notification histories
  record get-email-history-params {
    /// The end date and time of records to be returned. Defaults to now. Use format yyyy-MM-ddTHH:mm:ss. The maximum date range (endTime - startTime) is three days.
    end-time: option<string>,
    /// The initial date and time of records to be returned. Defaults to (end time - 1 day). Use format yyyy-MM-ddTHH:mm:ss. The maximum date range (endTime - startTime) is three days.
    start-time: option<string>,
    /// The Id of an object that triggered an email notification.
    /// 
    object-id: option<string>,
    /// If `true`, only returns failed records. When `false`, returns all records in the given date range. Defaults to `true` when not specified.
    /// 
    failed-only: option<bool>,
    /// Category of records to be returned by event category.
    /// 
    event-category: option<string>
  }
  get-email-history: func(params: get-email-history-params) -> result<string, string>;

}

interface o-auth {
  /// Create an OAuth token
  create-token: func() -> result<string, string>;

}

interface custom-object-records {
  /// Update or delete custom object records
  record post-custom-object-records-batch-update-or-delete-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string
  }
  post-custom-object-records-batch-update-or-delete: func(params: post-custom-object-records-batch-update-or-delete-params) -> result<string, string>;

  /// List records for a custom object
  record get-all-records-for-custom-object-type-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string,
    /// The query string to filter the records of a custom object. See the [Query syntax of custom object records](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Data_Model/Custom_object_records/Query_syntax_of_custom_object_records) for more information.
    /// 
    q: option<string>,
    /// UUIDs of the records to be queried. For example:
    /// 
    ids: option<string>,
    /// Page size. The value must be between 1 and 1000.
    page-size: option<s32>,
    /// The `cursor` points to the last record of the previous result set. The cursor record is not included in the query result. The call returns the first page if `cursor` is not provided and `pageSize` is valid.
    cursor: option<string>
  }
  get-all-records-for-custom-object-type: func(params: get-all-records-for-custom-object-type-params) -> result<string, string>;

  /// Create custom object records
  record post-custom-object-records-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string
  }
  post-custom-object-records: func(params: post-custom-object-records-params) -> result<string, string>;

  /// Retrieve a custom object record
  record get-custom-object-record-by-id-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string,
    /// Id identifier in uuid form
    id: string
  }
  get-custom-object-record-by-id: func(params: get-custom-object-record-by-id-params) -> result<string, string>;

  /// Update a custom object record
  record put-custom-object-record-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string,
    /// Id identifier in uuid form
    id: string
  }
  put-custom-object-record: func(params: put-custom-object-record-params) -> result<string, string>;

  /// Partially update a custom object record
  record patch-partial-update-custom-object-record-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string,
    /// Id identifier in uuid form
    id: string
  }
  patch-partial-update-custom-object-record: func(params: patch-partial-update-custom-object-record-params) -> result<string, string>;

  /// Delete a custom object record
  record delete-custom-object-record-by-id-params {
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Specifies the custom object's API name as object. It is case-sensitive.
    object: string,
    /// Id identifier in uuid form
    id: string
  }
  delete-custom-object-record-by-id: func(params: delete-custom-object-record-by-id-params) -> result<string, string>;

}

interface custom-object-definitions {
  enum get-all-custom-object-definitions-in-namespace-select-enum {
    type-op,
  }

  /// List custom object definitions
  record get-all-custom-object-definitions-in-namespace-params {
