package autostamp:zuora@0.6.0;

interface charge-metrics {
  record discount-allocation-detail-response {
    /// The amendment id that result in the discount allocation detail record.
    amendment-id: option<string>,
    /// The ID of the corresponding amendment that result in the discount allocation detail record.
    amendment-type: option<string>,
    /// The ID of the corresponding charge metrics record.
    charge-metrics-id: option<string>,
    /// The corresponding charge number of the discount allocation details record.
    charge-number: option<string>,
    /// The date and time when the discount allocation detail record.
    created-on: option<string>,
    /// The currency of the discount allocation detail record.
    currency: option<string>,
    /// Whether the discount allocation detail record is deleted.
    deleted: option<bool>,
    /// The number of the corresponding discount charge that leads to the discount allocation detail record.
    discount-charge-number: option<string>,
    /// The discount amount for the MRR of the discount allocation detail record.
    /// 
    discount-mrr: option<f64>,
    /// The discount amount for the TCV of the discount allocation detail record.
    discount-tcv: option<f64>,
    /// The end date of the discount allocation detail record.
    end-date: option<string>,
    /// The ID of the discount allocation details record.
    id: option<string>,
    /// The account number of the corresponding invoice owner.
    invoice-owner-account-number: option<string>,
    /// The corresponding product ID of the discount allocation details record.
    product-id: option<string>,
    /// The corresponding product rate plan charge ID of the discount allocation detail record.
    product-rate-plan-charge-id: option<string>,
    /// The corresponding product rate plan ID of the discount allocation details record.
    product-rate-plan-id: option<string>,
    /// The corresponding rate plan charge ID of the discount allocation details record.
    rate-plan-charge-id: option<string>,
    /// The start date of the discount allocation detail record.
    start-date: option<string>,
    /// The name of the corresponding subscription.
    subscription-name: option<string>,
    /// The account number of the corresponding subscription owner.
    subscription-owner-account-number: option<string>,
    /// The date and time when the discount allocation detail record.
    updated-on: option<string>
  }

  variant get-charge-metrics-error {
    bad-request(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-charge-metrics-discount-allocation-details-error {
    bad-request(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List charge metrics by time range
  record get-charge-metrics-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Expressed as MIME types that the client is able to understand. Using content negotiation, the server then selects one of the proposals, uses it and informs the client of its choice with the `Content-Type` response header. The possible response MIME types are `application/json-seq` compatible with http://jsonlines.org/, and `text/csv` compatible with RFC 4180. `application/json-seq` is the default response MIME type. If the `Accept` header is not sepecified, or set */*, the response body is returned in application/json-seq MIME type.
    accept: option<string>,
    /// The starting date and time of a time range when changes are made to charge metrics, in `yyyy-mm-ddThh:mm:ssZ` format. For example, `2020-08-18T09:01:11Z`. The timestamp maps to the `UpdatedOn` timestamp of the to-be-exported object.
    from-timestamp: string,
    /// The end date and time of a time range when changes are made to charge metrics, in `yyyy-mm-ddThh:mm:ssZ` format. For example, `2020-08-20T09:01:11Z`. The timestamp maps to the `UpdatedOn` timestamp of the to-be-exported object.
    to-timestamp: string
  }
  get-charge-metrics: func(params: get-charge-metrics-params) -> result<string, get-charge-metrics-error>;

  /// List discount allocation details by time range
  record get-charge-metrics-discount-allocation-details-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Expressed as MIME types that the client is able to understand. Using content negotiation, the server then selects one of the proposals, uses it and informs the client of its choice with the `Content-Type` response header. The possible response MIME types are `application/json-seq` compatible with http://jsonlines.org/, and `text/csv` compatible with RFC 4180. `application/json-seq` is the default response MIME type. If the `Accept` header is not sepecified, or set */*, the response body is returned in application/json-seq MIME type.
    accept: option<string>,
    /// The starting date and time of a time range when changes are made to charge metrics, in `yyyy-mm-ddThh:mm:ssZ` format. For example, `2020-08-18T09:01:11Z`. The timestamp maps to the `UpdatedOn` timestamp of the to-be-exported object.
    from-timestamp: string,
    /// The end date and time of a time range when changes are made to charge metrics, in `yyyy-mm-ddThh:mm:ssZ` format. For example, `2020-08-20T09:01:11Z`. The timestamp maps to the `UpdatedOn` timestamp of the to-be-exported object.
    to-timestamp: string
  }
  get-charge-metrics-discount-allocation-details: func(params: get-charge-metrics-discount-allocation-details-params) -> result<discount-allocation-detail-response, get-charge-metrics-discount-allocation-details-error>;

}


interface event-triggers {
  record event-type {
    /// The description of the event type.
    description: option<string>,
    /// The display name for the event type.
    display-name: string,
    /// The name of the event. Should be unique, contain no space, and be in the pattern: ^[A-Za-z]{1,}[\\w\\-]*$
    name: string
  }

  /// The type of events to be triggered.
  record put-event-trigger-request-event-type {
    /// The description for the event type.
    description: option<string>,
    /// The display name for the event type.
    display-name: option<string>
  }

  variant get-event-triggers-error {
    bad-request(string),
    internal-server-error(string),
    other(string)
  }

  variant post-event-trigger-error {
    bad-request(string),
    internal-server-error(string),
    other(string)
  }

  variant get-event-trigger-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant put-event-trigger-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-event-trigger-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// List event triggers
  record get-event-triggers-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The Zuora object that trigger condition is defined upon. Should be specified in the pattern: ^[A-Z][\\w\\-]*$
    base-object: option<string>,
    /// The event type name. Should be specified in the pattern: ^[A-Za-z]{1,}[\w\-]*$
    event-type-name: option<string>,
    /// The status of the event trigger.
    active: option<string>,
    /// The first index of the query result. Default to 0 if absent, and the minimum is 0.
    start: option<s32>,
    /// The maximum number of data records to be returned. Default to 10 if absent.
    limit: option<s32>
  }
  get-event-triggers: func(params: get-event-triggers-params) -> result<string, get-event-triggers-error>;

  /// Create an event trigger
  record post-event-trigger-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The status of the event trigger.
    active: bool,
    /// The base object that the trigger rule is defined upon. Should be specified in the pattern: ^[A-Z][\\w\\-]*$
    base-object: string,
    /// The JEXL expression to be evaluated against object changes. See above for more information and an example.
    condition: string,
    /// The description of the event trigger.
    description: option<string>,
    event-type: event-type
  }
  post-event-trigger: func(params: post-event-trigger-params) -> result<string, post-event-trigger-error>;

  /// Retrieve an event trigger
  record get-event-trigger-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    id: string
  }
  get-event-trigger: func(params: get-event-trigger-params) -> result<string, get-event-trigger-error>;

  /// Update an event trigger
  record put-event-trigger-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    id: string,
    /// The status of the trigger.
    active: option<bool>,
    /// The JEXL expression to be evaluated against object changes. See above for more information and an example.
    condition: option<string>,
    /// The description of the trigger.
    description: option<string>,
    /// The type of events to be triggered.
    event-type: option<put-event-trigger-request-event-type>
  }
  put-event-trigger: func(params: put-event-trigger-params) -> result<string, put-event-trigger-error>;

  /// Delete an event trigger
  record delete-event-trigger-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    id: string
  }
  delete-event-trigger: func(params: delete-event-trigger-params) -> result<string, delete-event-trigger-error>;

}

interface notifications {
  enum get-public-email-template-response-cc-email-type-enum {
    bill-to-contact,
    sold-to-contact,
    specific-emails,
    tenant-admin,
    bill-to-and-sold-to-contacts,
    run-owner,
    all-contacts,
    invoice-owner-bill-to-contact,
    invoice-owner-sold-to-contact,
    invoice-owner-bill-to-and-sold-to-contacts,
    invoice-owner-all-contacts,
  }

  enum get-public-email-template-response-encoding-type-enum {
    utf8,
    shift-jis,
    iso-v2022-jp,
    euc-jp,
    x-sjis-v0213,
  }

  enum get-public-email-template-response-from-email-type-enum {
    tenant-email,
    specific-email,
  }

  enum get-public-notification-definition-response-callout-http-method-enum {
    get,
    put,
    post,
    delete,
  }

  enum filter-rule-parameter-definition-value-type-enum {
    string-op,
    byte,
    short,
    character,
    integer,
    long,
    float,
    double,
    boolean,
    big-integer,
    big-decimal,
    local-date,
    local-date-time,
    timestamp,
    byte-array,
    short-array,
    character-array,
    integer-array,
    float-array,
    double-array,
    boolean-array,
    string-array,
    big-integer-array,
    big-decimal-array,
    local-date-array,
    local-date-time-array,
    timestamp-array,
  }

  record get-query-email-templates-response {
    data: option<list<get-public-email-template-response>>,
    /// The URI to query the next page of data, e.g. '/notification-definitions?start=1&limit=10'. The start equals request's start+limit, and the limit equals the request's limit. If the current page is the last page, this value is null.
    next: option<string>
  }

  record get-public-email-template-response {
    /// The status of the email template.
    active: option<bool>,
    /// Email BCC address.
    bcc-email-address: option<string>,
    /// Email CC address.
    cc-email-address: option<string>,
    /// Email cc type.
    cc-email-type: option<get-public-email-template-response-cc-email-type-enum>,
    /// The ID of the user who created the notification definition.
    created-by: option<string>,
    /// The time when the notification definition was created. Specified in the UTC timezone in the ISO860 format (YYYY-MM-DDThh:mm:ss.sTZD). E.g. 1997-07-16T19:20:30.45+00:00
    created-on: option<string>,
    /// The description of the email template.
    description: option<string>,
    /// The email body. You can add merge fields in the email object using angle brackets. 
    /// User can also embed html tags if 'isHtml' is true.
    email-body: option<string>,
    /// The email subject. You can add merge fields in the email subject using angle brackets.
    email-subject: option<string>,
    /// The endcode type of the email body.
    encoding-type: option<get-public-email-template-response-encoding-type-enum>,
    /// The name of the event type.
    event-type-name: option<string>,
    /// The namespace of the `eventTypeName` field. 
    event-type-namespace: option<string>,
    /// If formEmailType is SpecificEmail, this field is required.
    from-email-address: option<string>,
    /// The from email type.
    from-email-type: option<get-public-email-template-response-from-email-type-enum>,
    /// The name of email sender.
    from-name: option<string>,
    /// The filter rule associated with this notification definition.
    id: option<string>,
    /// Specified whether the style of email body is HTML.
    is-html: option<bool>,
    /// The name of the email template.
    name: option<string>,
    /// If replyToEmailType is SpecificEmail, this field is required
    reply-to-email-address: option<string>,
    /// The reply email type.
    reply-to-email-type: option<get-public-email-template-response-from-email-type-enum>,
    /// If toEmailType is SpecificEmail, this field is required.
    to-email-address: option<string>,
    /// Email receive type.
    to-email-type: option<get-public-email-template-response-cc-email-type-enum>,
    /// The ID of the user who updated the notification definition.
    updated-by: option<string>,
    /// The time when the notification definition was updated. Specified in the UTC timezone in the ISO860 format (YYYY-MM-DDThh:mm:ss.sTZD). E.g. 1997-07-16T19:20:30.45+00:00
    updated-on: option<string>
  }

  record get-query-notification-definitions-response {
    data: option<list<get-public-notification-definition-response>>,
    /// The URI to query the next page of data, e.g. '/notification-definitions?start=1&limit=10'. The start equals request's start+limit, and the limit equals the request's limit. If the current page is the last page, this value is null.
    next: option<string>
  }

  record get-public-notification-definition-response {
    /// The status of the notification definition. The default value is true.
    active: option<bool>,
    callout: option<get-public-notification-definition-response-callout>,
    /// The status of the callout action. The default value is false.
    callout-active: option<bool>,
    /// The profile that the notification definition belongs to.
    communication-profile-id: option<string>,
    /// The ID of the user who created the notification definition.
    created-by: option<string>,
    /// The time when the notification definition was created. Specified in the UTC timezone in the ISO860 format (YYYY-MM-DDThh:mm:ss.sTZD). E.g. 1997-07-16T19:20:30.45+00:00
    created-on: option<string>,
    /// Description of the notification definition
    description: option<string>,
    /// The status of the email action. The default value is false.
    email-active: option<bool>,
    /// The ID of the email template. In the request, there should be at least one email template or callout.
    email-template-id: option<string>,
    /// The name of the event type.
    event-type-name: option<string>,
    /// The namespace of the `eventTypeName` field. 
    event-type-namespace: option<string>,
    filter-rule: option<get-public-notification-definition-response-filter-rule>,
    filter-rule-params: option<list<filter-rule-parameter-values-entry>>,
    /// The filter rule associated with this notification definition.
    id: option<string>,
    /// The name of the notification definition.
    name: option<string>,
    /// The ID of the user who updated the notification definition.
    updated-by: option<string>,
    /// The time when the notification was updated. Specified in the UTC timezone in the ISO860 format (YYYY-MM-DDThh:mm:ss.sTZD). E.g. 1997-07-16T19:20:30.45+00:00
    updated-on: option<string>
  }

  record get-public-notification-definition-response-callout {
    /// The status of the callout. The default is true.
    active: option<bool>,
    callout-auth: option<callout-auth>,
    /// The callout URL. It must start with 'https://'
    callout-baseurl: option<string>,
    callout-params: option<list<callout-merge-fields-entry>>,
    /// Specified whether to retry the callout when the callout fails. The default is true.
    callout-retry: option<bool>,
    /// Description for the callout.
    description: option<string>,
    /// The name of the event type.
    event-type-name: option<string>,
    /// The HTTP method of the callout.
    http-method: option<get-public-notification-definition-response-callout-http-method-enum>,
    /// The ID of the callout. If `calloutActive` is true, a callout is required. The eventTypeName of the callout MUST be the same as the eventTypeName.
    id: option<string>,
    /// The name of the created callout.
    name: option<string>,
    /// Specifies whether the callout requires auth.
    required-auth: option<bool>
  }

  /// If requiredAuth is true, this object is required.
  record callout-auth {
    /// The domain of the callout auth.
    domain: option<string>,
    /// The field is required when requiredAuth is true.
    password: option<string>,
    /// Set this field to `true` if you want to enable the preemptive authentication.
    preemptive: option<bool>,
    /// The field is required when requiredAuth is true.
    username: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record callout-merge-fields-entry {
    key: string,
    value: string
  }

  record get-public-notification-definition-response-filter-rule {
    /// The filter rule conditions, written in [JEXL](http://commons.apache.org/proper/commons-jexl/).
    /// The rule might contain event context merge fields and data source merge fields. Data source merge fields must be from [the base object of the event or from the joined objects of the base object](https://knowledgecenter.zuora.com/DC_Developers/M_Export_ZOQL#Data_Sources_and_Objects). Notifications with invalid merge fields will fail to evaluate, thus will not be invoked. For example, to trigger an event when an invoice is posted with the amount over 1000, you would define the following condition on the `Invoice` object:
    condition: option<string>,
    /// The description of the filter rule.
    description: option<string>,
    /// The value is `null`.
    event-type-name: option<string>,
    /// The ID of the filter rule. If not specified or null, the notification definition is always qualified to process events of "eventType".
    id: option<string>,
    parameters: option<list<filter-rule-parameter-definitions-entry>>
  }

  /// Definition of a filter rule parameter.
  record filter-rule-parameter-definition {
    description: option<string>,
    /// The display name of the parameter.
    display-name: option<string>,
    /// The option values of the parameter.
    options: option<list<string>>,
    /// The type of the value.
    value-type: option<filter-rule-parameter-definition-value-type-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record filter-rule-parameter-definitions-entry {
    key: string,
    value: filter-rule-parameter-definition
  }

  /// one entry of a string-keyed map (free-form object)
  record filter-rule-parameter-values-entry {
    key: string,
    value: string
  }

  record post-public-notification-definition-request-callout {
    /// The status of the callout. The default is true.
    active: option<bool>,
    callout-auth: option<callout-auth>,
    /// The callout URL. It must start with 'https://'
    callout-baseurl: string,
    callout-params: option<list<callout-merge-fields-entry-v2>>,
    /// Specified whether to retry the callout when the callout fails. The default is true.
    callout-retry: option<bool>,
    /// Description for the callout.
    description: option<string>,
    /// The name of the event type.
    event-type-name: string,
    /// The HTTP method of the callout.
    http-method: get-public-notification-definition-response-callout-http-method-enum,
    /// The name of the created callout.
    name: string,
    /// Specifies whether the callout requires auth.
    required-auth: bool
  }

  /// one entry of a string-keyed map (free-form object)
  record callout-merge-fields-entry-v2 {
    key: string,
    value: string
  }

  record post-public-notification-definition-request-filter-rule {
    /// The filter rule conditions, written in [JEXL](http://commons.apache.org/proper/commons-jexl/).
    /// The rule might contain event context merge fields and data source merge fields. Data source merge fields must be from [the base object of the event or from the joined objects of the base object](https://knowledgecenter.zuora.com/DC_Developers/M_Export_ZOQL#Data_Sources_and_Objects). Notifications with invalid merge fields will fail to evaluate, thus will not be invoked. For example, to filter an invoice posted notification to only invoices with an amount over 1000, you would define the following condition:
    condition: string,
    /// The description of the filter rule.
    description: option<string>,
    parameters: list<filter-rule-parameter-definitions-entry-v2>
  }

  /// one entry of a string-keyed map (free-form object)
  record filter-rule-parameter-definitions-entry-v2 {
    key: string,
    value: filter-rule-parameter-definition
  }

  /// one entry of a string-keyed map (free-form object)
  record filter-rule-parameter-values-entry-v2 {
    key: string,
    value: string
  }

  record put-public-notification-definition-request-callout {
    /// The status of the callout. The default is true.
    active: option<bool>,
    callout-auth: option<callout-auth>,
    /// The callout URL. It must start with 'https://'
    callout-baseurl: string,
    callout-params: option<list<callout-merge-fields-entry-v3>>,
    /// Specified whether to retry the callout when the callout fails. The default is true.
    callout-retry: option<bool>,
    /// Description for the callout.
    description: option<string>,
    /// The HTTP method of the callout.
    http-method: get-public-notification-definition-response-callout-http-method-enum,
    /// The name of the created callout.
    name: string,
