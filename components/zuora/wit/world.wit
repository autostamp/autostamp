interface refunds {
  enum get-refunds-method-type-enum {
    ach,
    cash,
    check,
    credit-card,
    pay-pal,
    wire-transfer,
    debit-card,
    credit-card-reference-transaction,
    bank-transfer,
    other,
  }

  enum get-refunds-status-enum {
    processed,
    canceled,
    error,
    processing,
  }

  enum get-refunds-type-op-enum {
    external,
    electronic,
  }

  enum put-refund-type-finance-information-transferred-to-accounting-enum {
    processing,
    yes,
    no,
    error,
    ignore,
