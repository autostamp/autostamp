interface payments {
  enum proxy-create-payment-gateway-state-enum {
    marked-for-submission,
    submitted,
    settled,
    not-submitted,
    failed-to-settle,
  }

  enum proxy-create-payment-status-enum {
    processed,
    error,
    voided,
    canceled,
  }

  enum proxy-create-payment-type-op-enum {
    external,
    electronic,
  }

  enum proxy-modify-payment-transferred-to-accounting-enum {
    processing,
    yes,
    error,
    ignore,
  }

  enum get-retrieve-all-payments-status-enum {
    draft,
    processing,
    processed,
    error,
    canceled,
    posted,
  }

  enum create-payment-type-finance-information-transferred-to-accounting-enum {
    processing,
    yes,
    no,
    error,
    ignore,
  }

  enum create-payment-type-mit-transaction-source-enum {
    c-unscheduled,
    m-recurring,
    m-unscheduled,
  }

  enum post-refund-type-method-type-enum {
    ach,
    cash,
    check,
    credit-card,
    pay-pal,
    wire-transfer,
    debit-card,
    credit-card-reference-transaction,
    bank-transfer,
    other,
  }

  /// A field used to pass gateway options. Zuora allows you to pass in special gateway-specific parameters for payments that go through the Adyen, Autorize.et, CyberSource, Merchant eSolutions, Orbital (Chase Paymentech), QValent, Vantiv, and Verifi gateways.
  /// 
  /// For each of these special parameters, you supply the name-value pair and Zuora passes it to the gateway. This allows you to add functionality that's supported by a specific gateway but currently not supported by Zuora.
  record proxy-create-payment-gateway-option-data {
    gateway-option: list<gateway-option>
  }

  record gateway-option {
    /// The name of a gateway-specific parameter. This field is optional, but you must pass value for this field when using the `GatewayOptionData` field. Otherwise, the additional payment gateway parameter will not be mapped.
    name: option<string>,
    /// The value of the gateway-specific parameter. This field is optional, but you must pass value for this field when using the `GatewayOptionData` field. Otherwise, the additional payment gateway parameter will not be mapped.
    value: option<string>
  }

  /// Container for the invoice payment data. This field is only required if you apply a payment to multiple invoices.
  record proxy-create-payment-invoice-payment-data {
    invoice-payment: list<invoice-payment>
  }

  record invoice-payment {
    /// The amount of the payment to apply to an invoice.
    amount: string,
    /// The ID of the invoice that the payment is applied to.
    invoice-id: string,
    /// The ID of the payment.
    payment-id: option<string>
  }

  record payment-debit-memo-application-create-request-type {
    /// The amount of the payment associated with the debit memo.
    amount: f64,
    /// The unique ID of the debit memo that the payment is created on.
    debit-memo-id: option<string>,
    /// Container for debit memo items. The maximum number of items is 1,000.
    /// 
    items: option<list<payment-debit-memo-application-item-create-request-type>>
  }

  record payment-debit-memo-application-item-create-request-type {
    /// The amount of the payment associated with the specific debit memo or taxation item.
    amount: f64,
    /// The ID of the specific debit memo item.
    debit-memo-item-id: option<string>,
    /// The ID of the specific taxation item.
    tax-item-id: option<string>
  }

  /// Container for the finance information related to the payment.
  record create-payment-type-finance-information {
    /// The accounting code that maps to a bank account in your accounting system.
    bank-account-accounting-code: option<string>,
    /// Whether the payment was transferred to an external accounting system. Use this field for integration with accounting systems, such as NetSuite. 
    transferred-to-accounting: option<create-payment-type-finance-information-transferred-to-accounting-enum>,
    /// The accounting code for the unapplied payment.
    unapplied-payment-accounting-code: option<string>
  }

  /// The field used to pass gateway-specific parameters and parameter values.
  record create-payment-type-gateway-options {
    /// The name of a gateway-specific parameter.
    key: option<string>,
    /// The value of the gateway-specific parameter.
    value: option<string>
  }

  record payment-invoice-application-create-request-type {
    /// The amount of the payment associated with the invoice.
    amount: f64,
    /// The unique ID of the invoice that the payment is created on.
    invoice-id: option<string>,
    /// Container for invoice items. The maximum number of items is 1,000.
    /// 
    items: option<list<payment-invoice-application-item-create-request-type>>
  }

  record payment-invoice-application-item-create-request-type {
    /// The amount of the payment associated with the specific invoice or taxation item.
    amount: f64,
    /// The ID of the specific invoice item.
    invoice-item-id: option<string>,
    /// The ID of the specific taxation item.
    tax-item-id: option<string>
  }

  /// Container for the finance information related to the payment.
  /// 
  /// For a standalone payment, the finance information cannot be updated.
  record update-payment-type-finance-information {
    /// The accounting code that maps to a bank account in your accounting system.
    bank-account-accounting-code: option<string>,
    /// Whether the payment was transferred to an external accounting system. Use this field for integration with accounting systems, such as NetSuite. 
    transferred-to-accounting: option<create-payment-type-finance-information-transferred-to-accounting-enum>,
    /// The accounting code for the unapplied payment.
    unapplied-payment-accounting-code: option<string>
  }

  record payment-debit-memo-application-apply-request-type {
    /// The amount that is applied from the payment to the debit memo.
    amount: f64,
    /// The unique ID of the debit memo that the payment is applied to.
    debit-memo-id: option<string>,
    /// Container for debit memo items. The maximum number of items is 1,000.
    /// 
    items: option<list<payment-debit-memo-application-item-apply-request-type>>
  }

  record payment-debit-memo-application-item-apply-request-type {
    /// The amount of the payment that is applied to the specific debit memo or taxation item.
    amount: f64,
    /// The ID of the specific debit memo item.
    debit-memo-item-id: option<string>,
    /// The ID of the specific taxation item.
    tax-item-id: option<string>
  }

  record payment-invoice-application-apply-request-type {
    /// The amount that is applied from the payment to the invoice.
    amount: f64,
    /// The unique ID of the invoice that the payment is applied to.
    invoice-id: option<string>,
    /// Container for invoice items. The maximum number of items is 1,000.
    /// 
    items: option<list<payment-invoice-application-item-apply-request-type>>
  }

  record payment-invoice-application-item-apply-request-type {
    /// The amount of the payment that is applied to the specific invoice or taxation item.
    amount: f64,
    /// The ID of the specific invoice item.
    invoice-item-id: option<string>,
    /// The ID of the specific taxation item.
    tax-item-id: option<string>
  }

  /// Container for the finance information related to the refund.
  record post-refund-type-finance-information {
    /// The accounting code that maps to a bank account in your accounting system.
    bank-account-accounting-code: option<string>,
    /// Whether the refund was transferred to an external accounting system. Use this field for integration with accounting systems, such as NetSuite. 
    transferred-to-accounting: option<create-payment-type-finance-information-transferred-to-accounting-enum>,
    /// The accounting code for the unapplied payment.
    unapplied-payment-accounting-code: option<string>
  }

  /// The field used to pass gateway-specific parameters and parameter values.
  record post-refund-type-gateway-options {
    /// The name of a gateway-specific parameter.
    key: option<string>,
    /// The value of the gateway-specific parameter.
    value: option<string>
  }

  record payment-debit-memo-application-unapply-request-type {
    /// The amount of the payment that is unapplied from the debit memo.
    amount: f64,
    /// The unique ID of the debit memo that the payment is unapplied from.
    debit-memo-id: option<string>,
    /// Container for debit memo items. The maximum number of items is 1,000.
    /// 
    items: option<list<payment-debit-memo-application-item-unapply-request-type>>
  }

  record payment-debit-memo-application-item-unapply-request-type {
    /// The amount of the payment that is unapplied from the specific debit mem or taxation item.
    amount: f64,
    /// The ID of the specific debit memo item.
    debit-memo-item-id: option<string>,
    /// The ID of the specific taxation item.
    tax-item-id: option<string>
  }

  record payment-invoice-application-unapply-request-type {
    /// The amount of the payment that is unapplied from the invoice.
    amount: f64,
    /// The unique ID of the invoice that the payment is unapplied from.
    invoice-id: option<string>,
    /// Container for invoice items. The maximum number of items is 1,000.
    /// 
    items: option<list<payment-invoice-application-item-unapply-request-type>>
  }

  record payment-invoice-application-item-unapply-request-type {
    /// The amount of the payment that is unapplied from the specific invoice or taxation item.
    amount: f64,
    /// The ID of the specific invoice item.
    invoice-item-id: option<string>,
    /// The ID of the specific taxation item.
    tax-item-id: option<string>
  }

  variant object-post-payment-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant object-get-payment-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant object-put-payment-error {
    unauthorized(string),
    other(string)
  }

  variant object-delete-payment-error {
    unauthorized(string),
    other(string)
  }

  /// CRUD: Create a payment
  record object-post-payment-params {
    /// Specifies whether the call fails if the request body contains unknown fields.
    /// With `rejectUnknownFields` set to `true`, Zuora returns a 400 response if
    reject-unknown-fields: option<bool>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The unique account ID for the customer that the payment is for.
    account-id: string,
    /// The accounting code for the payment. Accounting codes group transactions that contain similar accounting attributes.
    accounting-code: option<string>,
    /// The amount of the payment.
    /// 
    amount: option<string>,
    /// If you have the Invoice Settlement feature disabled, the value of this field is the amount of the payment to apply to a credit balance. This field is only required if the `AppliedInvoiceAmount` field value is null.
    /// 
    applied-credit-balance-amount: option<string>,
    /// The amount of the payment to apply to an invoice. This field is only required if either the `InvoiceId` or `InvoiceNumber` field is not null.
    applied-invoice-amount: option<string>,
    /// The authorization transaction ID from the payment gateway. Use this field for electronic payments, such as credit cards.
    auth-transaction-id: option<string>,
