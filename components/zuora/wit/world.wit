interface subscriptions {
  /// CRUD: Retrieve a subscription
  record object-get-subscription-params {
    /// Object fields to return
    fields: option<string>,
    /// Object id
    id: string
  }
  object-get-subscription: func(params: object-get-subscription-params) -> result<string, string>;

  /// CRUD: Update a subscription
  record object-put-subscription-params {
    /// Object id
    id: string
  }
  object-put-subscription: func(params: object-put-subscription-params) -> result<string, string>;

  /// CRUD: Delete a subscription
  record object-delete-subscription-params {
    /// Object id
    id: string
  }
  object-delete-subscription: func(params: object-delete-subscription-params) -> result<string, string>;

  /// Create a subscription
  record post-subscription-params {
    /// The minor version of the Zuora REST API. 
    /// 
    zuora-version: option<string>
  }
  post-subscription: func(params: post-subscription-params) -> result<string, string>;

  /// List subscriptions by account key
  record get-subscriptions-by-account-params {
    /// 
    /// Possible values are:
    account-key: string,
    /// The segmented rate plan charges.
    /// 
    charge-detail: option<string>
  }
  get-subscriptions-by-account: func(params: get-subscriptions-by-account-params) -> result<string, string>;

  /// Preview a subscription
  record post-preview-subscription-params {
    /// 
    /// The minor version of the Zuora REST API. 
    zuora-version: option<string>
  }
  post-preview-subscription: func(params: post-preview-subscription-params) -> result<string, string>;

  /// Retrieve a subscription by key
  record get-subscriptions-by-key-params {
    /// Possible values are:
    ///   * a subscription number
    subscription-key: string,
    /// 
    /// The segmented rate plan charges. When an amendment results in a change to a charge, Zuora creates a segmented rate plan charge. Use this field to track segment charges.
    charge-detail: option<string>
  }
  get-subscriptions-by-key: func(params: get-subscriptions-by-key-params) -> result<string, string>;

  /// Update a subscription
  record put-subscription-params {
    /// 
    /// The minor version of the Zuora REST API. 
    zuora-version: option<string>,
    /// Subscription number or ID.
    subscription-key: string
  }
  put-subscription: func(params: put-subscription-params) -> result<string, string>;

  /// Cancel a subscription
  record put-cancel-subscription-params {
    /// The minor version of the Zuora REST API. 
    /// 
    zuora-version: option<string>,
    /// Subscription number or ID. Subscription status must be `Active`.
    subscription-key: string
  }
  put-cancel-subscription: func(params: put-cancel-subscription-params) -> result<string, string>;

  /// Renew a subscription
  record put-renew-subscription-params {
    /// The minor version of the Zuora REST API. 
    /// 
    zuora-version: option<string>,
    /// Subscription number or ID
    subscription-key: string
  }
  put-renew-subscription: func(params: put-renew-subscription-params) -> result<string, string>;

  /// Resume a subscription
  record put-resume-subscription-params {
    /// The minor version of the Zuora REST API. 
    /// 
    zuora-version: option<string>,
    /// Subscription number or ID. Subscription status must be Suspended.
    subscription-key: string
  }
  put-resume-subscription: func(params: put-resume-subscription-params) -> result<string, string>;

  /// Suspend a subscription
  record put-suspend-subscription-params {
    /// The minor version of the Zuora REST API. 
    /// 
    zuora-version: option<string>,
    /// Subscription number or ID. Subscription status must be Active.
    subscription-key: string
  }
  put-suspend-subscription: func(params: put-suspend-subscription-params) -> result<string, string>;

  /// Retrieve a subscription by key and version
  record get-subscriptions-by-key-and-version-params {
    /// Subscription number. For example, A-S00000135.
    subscription-key: string,
    /// Subscription version. For example, 1.
    version: string,
    /// 
    /// The segmented rate plan charges. When an amendment results in a change to a charge, Zuora creates a segmented rate plan charge. Use this field to track segment charges.
    charge-detail: option<string>
  }
  get-subscriptions-by-key-and-version: func(params: get-subscriptions-by-key-and-version-params) -> result<string, string>;

  /// Update subscription custom fields of a subscription version
  record put-update-subscription-custom-fields-of-a-specified-version-params {
    /// The subscription number to be updated.
    subscription-number: string,
    /// The subscription version to be updated.
    version: string
  }
  put-update-subscription-custom-fields-of-a-specified-version: func(params: put-update-subscription-custom-fields-of-a-specified-version-params) -> result<string, string>;

}

