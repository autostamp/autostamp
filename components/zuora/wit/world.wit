    debit-card,
    credit-card-reference-transaction,
    bank-transfer,
    other,
  }

  enum get-refunds-status-enum {
    processed,
    canceled,
    error,
    processing,
  }

  enum get-refunds-type-op-enum {
    external,
    electronic,
  }

  /// CRUD: Create a refund
