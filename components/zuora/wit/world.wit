    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The ID of the contact that you want to scrub sensitive data from.
    contact-id: string
  }
  put-scrub-contact: func(params: put-scrub-contact-params) -> result<string, string>;

  /// CRUD: Create a contact
  record object-post-contact-params {
    /// Specifies whether the call fails if the request body contains unknown fields.
    /// With `rejectUnknownFields` set to `true`, Zuora returns a 400 response if
    reject-unknown-fields: option<bool>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    ///  The Zuora account ID associated with this contact. This field is not required when you use the Subscribe call. This field is required for all other calls.
    /// **Character limit: **32 **Values: **a valid account ID 
    account-id: string,
    ///  The first line of the contact's address, which is often a street address or business name.
    /// **Character limit**: 255 **Values**: a string of 255 characters or fewer 
    address1: option<string>,
    ///  The second line of the contact's address.
    /// **Character limit**: 255 **Values**: a string of 255 characters or fewer 
    address2: option<string>,
    ///  The city of the contact's address.
    /// **Character limit**: 40 **Values: **a string of 40 characters or fewer 
    city: option<string>,
    ///  The country of the contact's address. 
    country: option<string>,
    ///  The county. May optionally be used by Zuora Tax to calculate county tax.
    /// **Character limit**: 32 **Values**: a string of 32 characters or fewer 
    county: option<string>,
    ///  A description for the contact.
    /// **Character limit**: 100 **Values**: a string of 100 characters or fewer 
    description: option<string>,
    ///  The contact's fax number.
    /// **Character limit**: 40 **Values**: a string of 40 characters or fewer 
    fax: option<string>,
    ///  The contact's first name.
    /// **Character limit**: 100 **Values**: a string of the contact's first name 
    first-name: string,
    ///  The contact's home phone number.
    /// **Character limit**: 40 **Values**: a string of 40 characters or fewer 
    home-phone: option<string>,
    ///  The contact's last name.
    /// **Character limit**: 100 **Values**: a string of 100 characters or fewer 
    last-name: string,
    ///  The contact's mobile phone number.
    /// **Character limit**: 40 **Values**: a string of 40 characters or fewer 
    mobile-phone: option<string>,
    ///  A nickname for the contact.
    /// **Character limit**: 100 **Values**: a string of 100 characters or fewer 
    nick-name: option<string>,
    ///  An additional phone number for the contact.
    /// **Character limit**: 40 **Values**: a string of 40 characters or fewer 
    other-phone: option<string>,
    /// The type of the `OtherPhone`. **Character limit**: 20 **Values**: `Work`, `Mobile`, `Home`, `Other` 
    other-phone-type: option<string>,
    ///  The contact's personal email address.
    /// **Character limit**: 80 **Values**: a string of 80 characters or fewer 
    personal-email: option<string>,
    ///  The zip code for the contact's address.
    /// **Character limit:** 20 **Values: **a string of 20 characters or fewer 
    postal-code: option<string>,
    ///  The state or province of the contact's address. 
    state: option<string>,
    /// If using Zuora Tax rules 
    tax-region: option<string>,
    ///  The contact's business email address.
    /// **Character limit**: 80 **Values**: a string of 80 characters or fewer 
    work-email: option<string>,
    ///  The contact's business phone number.
    /// **Character limit**: 40 **notes**: -- **Values**: a string of 40 characters or fewer 
    work-phone: option<string>
  }
  object-post-contact: func(params: object-post-contact-params) -> result<string, object-post-contact-error>;

  /// CRUD: Retrieve a contact
  record object-get-contact-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object fields to return
    fields: option<string>,
    /// Object id
    id: string
  }
  object-get-contact: func(params: object-get-contact-params) -> result<string, object-get-contact-error>;

  /// CRUD: Update a contact
  record object-put-contact-params {
    /// Specifies whether the call fails if the request body contains unknown fields.
    /// With `rejectUnknownFields` set to `true`, Zuora returns a 400 response if
    reject-unknown-fields: option<bool>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object id
    id: string,
    ///  The Zuora account ID associated with this contact. This field is not required when you use the Subscribe call. This field is required for all other calls.
    /// **Character limit: **32 **Values: **a valid account ID 
    account-id: option<string>,
    ///  The first line of the contact's address, which is often a street address or business name.
    /// **Character limit**: 255 **Values**: a string of 255 characters or fewer 
    address1: option<string>,
    ///  The second line of the contact's address.
    /// **Character limit**: 255 **Values**: a string of 255 characters or fewer 
    address2: option<string>,
    ///  The city of the contact's address.
    /// **Character limit**: 40 **Values: **a string of 40 characters or fewer 
    city: option<string>,
    ///  The country of the contact's address. 
    country: option<string>,
    ///  The county. May optionally be used by Zuora Tax to calculate county tax.
    /// **Character limit**: 32 **Values**: a string of 32 characters or fewer 
    county: option<string>,
    ///  A description for the contact.
    /// **Character limit**: 100 **Values**: a string of 100 characters or fewer 
    description: option<string>,
    ///  The contact's fax number.
    /// **Character limit**: 40 **Values**: a string of 40 characters or fewer 
    fax: option<string>,
    ///  The contact's first name.
    /// **Character limit**: 100 **Values**: a string of the contact's first name 
    first-name: option<string>,
    ///  The contact's home phone number.
    /// **Character limit**: 40 **Values**: a string of 40 characters or fewer 
    home-phone: option<string>,
    ///  The contact's last name.
    /// **Character limit**: 100 **Values**: a string of 100 characters or fewer 
    last-name: option<string>,
    ///  The contact's mobile phone number.
    /// **Character limit**: 40 **Values**: a string of 40 characters or fewer 
    mobile-phone: option<string>,
    ///  A nickname for the contact.
    /// **Character limit**: 100 **Values**: a string of 100 characters or fewer 
    nick-name: option<string>,
    ///  An additional phone number for the contact.
    /// **Character limit**: 40 **Values**: a string of 40 characters or fewer 
    other-phone: option<string>,
    /// The type of the `OtherPhone`. **Character limit**: 20 **Values**: `Work`, `Mobile`, `Home`, `Other` 
    other-phone-type: option<string>,
    ///  The contact's personal email address.
    /// **Character limit**: 80 **Values**: a string of 80 characters or fewer 
    personal-email: option<string>,
    ///  The zip code for the contact's address.
    /// **Character limit:** 20 **Values: **a string of 20 characters or fewer 
    postal-code: option<string>,
    ///  The state or province of the contact's address. 
    state: option<string>,
    /// If using Zuora Tax rules 
    tax-region: option<string>,
    ///  The contact's business email address.
    /// **Character limit**: 80 **Values**: a string of 80 characters or fewer 
    work-email: option<string>,
    ///  The contact's business phone number.
    /// **Character limit**: 40 **notes**: -- **Values**: a string of 40 characters or fewer 
    work-phone: option<string>
  }
  object-put-contact: func(params: object-put-contact-params) -> result<string, object-put-contact-error>;

  /// CRUD: Delete a contact
  record object-delete-contact-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Object id
    id: string
  }
  object-delete-contact: func(params: object-delete-contact-params) -> result<string, object-delete-contact-error>;

}

interface credit-memos {
  enum get-credit-memos-status-enum {
    draft,
    posted,
    canceled,
    error,
    pending-for-tax,
    generating,
    cancel-in-progress,
  }

  enum get-credit-memos-transferred-to-accounting-enum {
    processing,
    yes,
    no,
    error,
    ignore,
  }

  enum put-credit-memo-tax-item-type-tax-rate-type-enum {
    percentage,
    flat-fee,
  }

  enum post-non-ref-refund-type-method-type-enum {
    ach,
    cash,
    check,
    credit-card,
    pay-pal,
    wire-transfer,
    debit-card,
    credit-card-reference-transaction,
    bank-transfer,
    other,
  }

  enum post-non-ref-refund-type-type-op-enum {
    external,
    electronic,
  }

  record credit-memo-from-charge-detail-type {
    /// The amount of the credit memo item.
    /// 
    amount: option<f64>,
    /// The ID of the product rate plan charge that the credit memo is created from.
    /// 
    charge-id: string,
    /// Comments about the product rate plan charge.
    /// 
    comment: option<string>,
    /// The description of the product rate plan charge.
    /// 
    description: option<string>,
    /// Container for the finance information related to the product rate plan charge associated with the credit memo.
    finance-information: option<credit-memo-from-charge-detail-type-finance-information>,
    /// The amount of the credit memo item.
    /// 
    memo-item-amount: option<f64>,
    /// The ID of the product rate plan charge that the credit memo is created from.
    /// 
    product-rate-plan-charge-id: string,
    /// The number of units for the credit memo item.
    quantity: option<f64>,
    /// The service end date of the credit memo item. If not specified, the effective end date of the corresponding product rate plan will be used.
    service-end-date: option<string>,
    /// The service start date of the credit memo item. If not specified, the effective start date of the corresponding product rate plan will be used.
    service-start-date: option<string>
  }

  /// Container for the finance information related to the product rate plan charge associated with the credit memo.
  record credit-memo-from-charge-detail-type-finance-information {
    /// The accounting code for the deferred revenue, such as Monthly Recurring Liability.
    deferred-revenue-accounting-code: option<string>,
    /// The accounting code that maps to an on account in your accounting system.
    on-account-accounting-code: option<string>,
    /// The accounting code for the recognized revenue, such as Monthly Recurring Charges or Overage Charges.
    recognized-revenue-accounting-code: option<string>,
    /// The name of the revenue recognition rule governing the revenue schedule.
    revenue-recognition-rule-name: option<string>
  }

  record put-credit-memo-item-type {
    /// The amount of the credit memo item. For tax-inclusive credit memo items, the amount indicates the credit memo item amount including tax. For tax-exclusive credit memo items, the amount indicates the credit memo item amount excluding tax
    amount: option<f64>,
    /// Comments about the credit memo item.
    comment: option<string>,
    /// Container for the finance information related to the credit memo item.
    finance-information: option<put-credit-memo-item-type-finance-information>,
    /// The ID of the credit memo item.
    id: string,
    /// The number of units for the credit memo item.
    quantity: option<f64>,
    /// The service end date of the credit memo item.
    service-end-date: option<string>,
    /// The service start date of the credit memo item.
    service-start-date: option<string>,
    /// The name of the SKU.
    sku-name: option<string>,
    /// Container for credit memo taxation items.
    tax-items: option<list<put-credit-memo-tax-item-type>>,
    /// The definable unit that you measure when determining charges.
    unit-of-measure: option<string>
  }

  /// Container for the finance information related to the credit memo item.
  record put-credit-memo-item-type-finance-information {
    /// The accounting code for the deferred revenue, such as Monthly Recurring Liability.
    deferred-revenue-accounting-code: option<string>,
    /// The accounting code that maps to an on account in your accounting system.
    on-account-accounting-code: option<string>,
    /// The accounting code for the recognized revenue, such as Monthly Recurring Charges or Overage Charges.
    recognized-revenue-accounting-code: option<string>,
    /// The name of the revenue recognition rule governing the revenue schedule.
    revenue-recognition-rule-name: option<string>
  }

  record put-credit-memo-tax-item-type {
    /// The amount of the taxation item in the credit memo item.
    amount: option<f64>,
    /// Container for the finance information related to the taxation item in the credit memo item.
    finance-information: option<put-credit-memo-tax-item-type-finance-information>,
    /// The ID of the taxation item in the credit memo item.
    id: string,
    /// The jurisdiction that applies the tax or VAT. This value is typically a state, province, county, or city.
    jurisdiction: option<string>,
    /// The identifier for the location based on the value of the `taxCode` field.
    location-code: option<string>,
    /// The tax code identifies which tax rules and tax rates to apply to a specific credit memo.
    tax-code: option<string>,
    /// The description of the tax code.
    tax-code-description: option<string>,
    /// The date that the tax is applied to the credit memo, in `yyyy-mm-dd` format.
    tax-date: option<string>,
    /// The amount of taxes or VAT for which the customer has an exemption.
    tax-exempt-amount: option<f64>,
    /// The name of taxation.
    tax-name: option<string>,
    /// The tax rate applied to the credit memo.
    tax-rate: option<f64>,
    /// The description of the tax rate. 
    tax-rate-description: option<string>,
    /// The type of the tax rate applied to the credit memo.
    tax-rate-type: option<put-credit-memo-tax-item-type-tax-rate-type-enum>
  }

  /// Container for the finance information related to the taxation item in the credit memo item.
  record put-credit-memo-tax-item-type-finance-information {
    /// The accounting code that maps to an on account in your accounting system.
    on-account-accounting-code: option<string>,
    /// The accounting code for the sales taxes payable.
    sales-tax-payable-accounting-code: option<string>
  }

  record credit-memo-apply-debit-memo-request-type {
    /// The credit memo amount to be applied to the debit memo.
    amount: f64,
    /// The unique ID of the debit memo that the credit memo is applied to.
    debit-memo-id: string,
    /// Container for items. The maximum number of items is 1,000.
    items: option<list<credit-memo-apply-debit-memo-item-request-type>>
  }

  record credit-memo-apply-debit-memo-item-request-type {
    /// The amount that is applied to the specific item. 
    amount: f64,
    /// The ID of the credit memo item.
    credit-memo-item-id: option<string>,
    /// The ID of the credit memo taxation item.
    credit-tax-item-id: option<string>,
    /// The ID of the debit memo item that the credit memo item is applied to.
    debit-memo-item-id: option<string>,
    /// The ID of the debit memo taxation item that the credit memo taxation item is applied to.
    tax-item-id: option<string>
  }

  record credit-memo-apply-invoice-request-type {
    /// The credit memo amount to be applied to the invoice.
    amount: f64,
    /// The unique ID of the invoice that the credit memo is applied to.
    invoice-id: string,
    /// Container for items. The maximum number of items is 1,000.
    items: option<list<credit-memo-apply-invoice-item-request-type>>
  }

  record credit-memo-apply-invoice-item-request-type {
    /// The amount that is applied to the specific item. 
    amount: f64,
    /// The ID of the credit memo item.
    credit-memo-item-id: option<string>,
    /// The ID of the credit memo taxation item.
    credit-tax-item-id: option<string>,
    /// The ID of the invoice item that the credit memo item is applied to.
    invoice-item-id: option<string>,
    /// The ID of the invoice taxation item that the credit memo taxation item is applied to.
    tax-item-id: option<string>
  }

  record post-taxation-item-for-cm-type {
    /// The amount of taxes or VAT for which the customer has an exemption.
    exempt-amount: option<f64>,
    /// Container for the finance information related to the taxation item.
    finance-information: option<post-taxation-item-for-cm-type-finance-information>,
    /// The jurisdiction that applies the tax or VAT. This value is typically a state, province, county, or city.
    jurisdiction: string,
    /// The identifier for the location based on the value of the `taxCode` field.
    location-code: option<string>,
    /// The ID of the credit memo that the taxation item is created for.
    memo-item-id: option<string>,
    /// The name of the taxation item.
    name: string,
    /// The ID of the taxation item of the invoice, which the credit memo is created from. 
    /// 
    source-tax-item-id: option<string>,
    /// The amount of the tax applied to the credit memo.
    tax-amount: f64,
    /// The tax code identifies which tax rules and tax rates to apply to a specific credit memo.
    tax-code: option<string>,
    /// The description of the tax code.
    tax-code-description: option<string>,
    /// The date when the tax is applied to the credit memo.
    tax-date: option<string>,
    /// The tax rate applied to the credit memo.
    tax-rate: f64,
    /// The description of the tax rate.
    tax-rate-description: option<string>,
    /// The type of the tax rate applied to the credit memo.
    tax-rate-type: put-credit-memo-tax-item-type-tax-rate-type-enum
  }

  /// Container for the finance information related to the taxation item.
  record post-taxation-item-for-cm-type-finance-information {
    /// The accounting code that maps to an on account in your accounting system.
    on-account-accounting-code: option<string>,
    /// The accounting code for the sales taxes payable.
    sales-tax-payable-accounting-code: option<string>
  }

  record credit-memo-unapply-debit-memo-request-type {
    /// The credit memo amount to be unapplied from the debit memo.
    amount: f64,
    /// The unique ID of the debit memo that the credit memo is unapplied from.
    debit-memo-id: string,
    /// Container for items. The maximum number of items is 1,000.
    items: option<list<credit-memo-unapply-debit-memo-item-request-type>>
  }

  record credit-memo-unapply-debit-memo-item-request-type {
    /// The amount that is unapplied from the specific item. 
    amount: f64,
    /// The ID of the credit memo item.
    credit-memo-item-id: option<string>,
    /// The ID of the credit memo taxation item.
    credit-tax-item-id: option<string>,
    /// The ID of the debit memo item that the credit memo item is unapplied from.
    debit-memo-item-id: option<string>,
    /// The ID of the debit memo taxation item that the credit memo taxation item is unapplied from.
    tax-item-id: option<string>
  }

  record credit-memo-unapply-invoice-request-type {
    /// The credit memo amount to be unapplied from the invoice.
    amount: f64,
    /// The unique ID of the invoice that the credit memo is unapplied from.
    invoice-id: string,
    /// Container for items. The maximum number of items is 1,000.
    items: option<list<credit-memo-unapply-invoice-item-request-type>>
  }

  record credit-memo-unapply-invoice-item-request-type {
    /// The amount that is unapplied from the specific item. 
    amount: f64,
    /// The ID of the credit memo item.
    credit-memo-item-id: option<string>,
    /// The ID of the credit memo taxation item.
    credit-tax-item-id: option<string>,
    /// The ID of the invoice item that the credit memo item is unapplied from.
    invoice-item-id: option<string>,
    /// The ID of the invoice taxation item that the credit memo taxation item is unapplied from.
    tax-item-id: option<string>
  }

  /// Container for the finance information related to the refund.
  record post-non-ref-refund-type-finance-information {
    /// The accounting code that maps to a bank account in your accounting system.
    bank-account-accounting-code: option<string>,
    /// The accounting code that maps to an on account in your accounting system.
    on-account-accounting-code: option<string>,
    /// Whether the refund was transferred to an external accounting system. Use this field for integration with accounting systems, such as NetSuite. 
    transferred-to-accounting: option<get-credit-memos-transferred-to-accounting-enum>,
    /// The accounting code for the unapplied payment.
    unapplied-payment-accounting-code: option<string>
  }

  /// The field used to pass gateway-specific parameters and parameter values.
  record post-non-ref-refund-type-gateway-options {
    /// The name of a gateway-specific parameter.
    key: option<string>,
    /// The value of the gateway-specific parameter.
    value: option<string>
  }

  record refund-credit-memo-item-type {
    /// The amount of the refund on the specific item.
    amount: f64,
    /// The ID of the credit memo item that is refunded.
    credit-memo-item-id: option<string>,
    /// The ID of the credit memo taxation item that is refunded.
    credit-tax-item-id: option<string>
  }

  /// List credit memos
  record get-credit-memos-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Number of rows returned per page.
    page-size: option<s32>,
    /// This parameter filters the response based on the `accountId` field. 
    account-id: option<string>,
    /// This parameter filters the response based on the `amount` field. 
    amount: option<f64>,
    /// This parameter filters the response based on the `appliedAmount` field. 
    applied-amount: option<f64>,
    /// This parameter filters the response based on the `autoApplyUponPosting` field. 
    auto-apply-upon-posting: option<bool>,
    /// This parameter filters the response based on the `createdById` field. 
    created-by-id: option<string>,
    /// This parameter filters the response based on the `createdDate` field. 
    created-date: option<string>,
    /// This parameter filters the response based on the `creditMemoDate` field. 
    credit-memo-date: option<string>,
    /// This parameter filters the response based on the `currency` field. 
    currency: option<string>,
    /// This parameter filters the response based on the `excludeFromAutoApplyRules` field. 
    exclude-from-auto-apply-rules: option<bool>,
    /// This parameter filters the response based on the `number` field. 
    number: option<string>,
    /// This parameter filters the response based on the `referredInvoiceId` field. 
    referred-invoice-id: option<string>,
    /// This parameter filters the response based on the `refundAmount` field. 
    refund-amount: option<f64>,
    /// This parameter filters the response based on the `status` field. 
    status: option<get-credit-memos-status-enum>,
    /// This parameter filters the response based on the `targetDate` field. 
    target-date: option<string>,
    /// This parameter filters the response based on the `taxAmount` field. 
    tax-amount: option<f64>,
    /// This parameter filters the response based on the `totalTaxExemptAmount` field.
    total-tax-exempt-amount: option<f64>,
    /// This parameter filters the response based on the `transferredToAccounting` field. 
    transferred-to-accounting: option<get-credit-memos-transferred-to-accounting-enum>,
    /// This parameter filters the response based on the `unappliedAmount` field. 
    unapplied-amount: option<f64>,
    /// This parameter filters the response based on the `updatedById` field. 
    updated-by-id: option<string>,
    /// This parameter filters the response based on the `updatedDate` field.
