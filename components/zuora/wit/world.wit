  }
  get-payment-run-data: func(params: get-payment-run-data-params) -> result<string, string>;

  /// Retrieve a payment run summary
  record get-payment-run-summary-params {
    /// The unique ID of a payment run. For example, 402890245f097f39015f0f074a2e0566.
    payment-run-id: string
  }
  get-payment-run-summary: func(params: get-payment-run-summary-params) -> result<string, string>;

}

