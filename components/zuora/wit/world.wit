    /// 
    object-id: option<string>,
    /// If `true`, only returns failed records. When `false`, returns all records in the given date range. Defaults to `true` when not specified.
    /// 
    failed-only: option<bool>,
    /// Category of records to be returned by event category.
    /// 
    event-category: option<string>
  }
  get-email-history: func(params: get-email-history-params) -> result<string, string>;

}

interface o-auth {
  enum create-token-body-grant-type-enum {
    client-credentials,
  }

  variant create-token-error {
    too-many-requests(string),
    other(string)
  }

  /// Create an OAuth token
  record create-token-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The Client ID of the OAuth client.
    client-id: string,
    /// The Client Secret that was displayed when the OAuth client was created.
    client-secret: string,
    /// The OAuth grant type that will be used to generate the token. The value of this parameter must be `client_credentials`.
    grant-type: create-token-body-grant-type-enum
  }
  create-token: func(params: create-token-params) -> result<string, create-token-error>;

}

interface custom-object-records {
  enum custom-object-record-batch-action-type-op-enum {
    delete,
    update,
  }

  /// The batch action on custom object records
  record custom-object-record-batch-action {
    /// Indicates whether the records that pass the schema validation should be updated when not all records in the request pass the schema validation.
    /// 
    allow-partial-success: option<bool>,
    /// Ids of the custom object records that you want to delete. Only applicable when `type` is `delete`.
    ids: option<list<string>>,
    records: option<list<custom-object-record-batch-update-mapping-entry>>,
    /// The type of the batch action
    type-op: custom-object-record-batch-action-type-op-enum
  }

  /// one entry of a string-keyed map (free-form object)
  record custom-object-record-batch-update-mapping-value-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record custom-object-record-batch-update-mapping-entry {
    key: string,
    value: list<custom-object-record-batch-update-mapping-value-entry>
  }

  record batch-update-partial-success-response {
    error: option<error-response>
  }

  record error-response {
    code: option<s32>,
    details: option<list<with-error>>,
    message: option<string>
  }

  record with-error {
    /// See [Custom Objects API error code](https://knowledgecenter.zuora.com/Central_Platform/Custom_Objects/Z_Custom_Objects_API#Custom_Objects_API_error_code) for details.
    code: option<s32>,
    message: option<string>,
    record-op: option<custom-object-record-with-all-fields>
  }

  /// Record data from an object
  record custom-object-record-with-all-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record query-custom-object-records-response {
    /// The record count of the given custom object type
    count: s32,
    records: list<custom-object-record-with-all-fields>
  }

  /// one entry of a string-keyed map (free-form object)
  record custom-object-record-with-only-custom-fields-entry {
    key: string,
    value: string
  }

  record post-custom-object-records-response {
    error: option<error-response>,
    /// The custom object records that are succesfully created and stored
    records: option<list<custom-object-record-with-all-fields>>
  }

  /// one entry of a string-keyed map (free-form object)
  record custom-object-record-with-only-custom-fields-entry-v2 {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record custom-object-record-with-only-custom-fields-entry-v3 {
    key: string,
    value: string
  }

  variant post-custom-object-records-batch-update-or-delete-error {
    bad-request(string),
    unauthorized(string),
    internal-server-error(string),
    other(string)
  }

  variant post-custom-object-records-error {
    bad-request(string),
    unauthorized(string),
    internal-server-error(string),
    other(string)
  }

  variant get-custom-object-record-by-id-error {
    not-found(string),
    other(string)
  }

  variant put-custom-object-record-error {
    not-found(string),
    other(string)
  }

  variant patch-partial-update-custom-object-record-error {
    not-found(string),
    other(string)
  }

  /// Update or delete custom object records
  record post-custom-object-records-batch-update-or-delete-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
