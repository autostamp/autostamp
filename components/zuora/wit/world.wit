    zuora-version: option<string>,
    /// If you set `select` to `type`, the response will only contain the `type` of each custom object.
    select: option<get-all-custom-object-definitions-in-namespace-select-enum>
  }
  get-all-custom-object-definitions-in-namespace: func(params: get-all-custom-object-definitions-in-namespace-params) -> result<string, string>;

