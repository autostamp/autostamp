interface revenue-schedules {
  /// Retrieve a revenue schedule by credit memo item ID
  record get-r-sby-credit-memo-item-params {
    /// The unique ID of a credit memo item. You can get the credit memo item ID from the response of [Get credit memo items](https://www.zuora.com/developer/api-reference/#operation/GET_CreditMemoItems).
    cmi-id: string
  }
  get-r-sby-credit-memo-item: func(params: get-r-sby-credit-memo-item-params) -> result<string, string>;

  /// Create a revenue schedule for a credit memo item (manual distribution)
  record post-r-sfor-credit-memo-item-manual-distribution-params {
    /// The unique ID of a credit memo item. You can get the credit memo item ID from the response of [Get credit memo items](https://www.zuora.com/developer/api-reference/#operation/GET_CreditMemoItems).
    cmi-id: string
  }
  post-r-sfor-credit-memo-item-manual-distribution: func(params: post-r-sfor-credit-memo-item-manual-distribution-params) -> result<string, string>;

  /// Create a revenue schedule for a credit memo item (distribute by date range)
  record post-r-sfor-credit-memo-item-distribute-by-date-range-params {
    /// The unique ID of a credit memo item. You can get the credit memo item ID from the response of [Get credit memo items](https://www.zuora.com/developer/api-reference/#operation/GET_CreditMemoItems).
    cmi-id: string
  }
  post-r-sfor-credit-memo-item-distribute-by-date-range: func(params: post-r-sfor-credit-memo-item-distribute-by-date-range-params) -> result<string, string>;

  /// Retrieve a revenue schedule by debit memo item ID
  record get-r-sby-debit-memo-item-params {
    /// The unique ID of a debit memo item. You can get the debit memo item ID from the response of [Get debit memo items](https://www.zuora.com/developer/api-reference/#operation/GET_DebitMemoItems).
    dmi-id: string
  }
  get-r-sby-debit-memo-item: func(params: get-r-sby-debit-memo-item-params) -> result<string, string>;

  /// Create a revenue schedule for a debit memo item (distribute by date range)
  record post-r-sfor-debit-memo-item-manual-distribution-params {
    /// The unique ID of a debit memo item. You can get the debit memo item ID from the response of [Get debit memo items](https://www.zuora.com/developer/api-reference/#operation/GET_DebitMemoItems).
    dmi-id: string
  }
  post-r-sfor-debit-memo-item-manual-distribution: func(params: post-r-sfor-debit-memo-item-manual-distribution-params) -> result<string, string>;

  /// Create a revenue schedule for a debit memo item (distribute by date range)
  record post-r-sfor-debit-memo-item-distribute-by-date-range-params {
    /// The unique ID of a debit memo item. You can get the debit memo item ID from the response of [Get debit memo items](https://www.zuora.com/developer/api-reference/#operation/GET_DebitMemoItems).
    dmi-id: string
  }
  post-r-sfor-debit-memo-item-distribute-by-date-range: func(params: post-r-sfor-debit-memo-item-distribute-by-date-range-params) -> result<string, string>;

  /// Retrieve a revenue schedule by invoice item adjustment key
  record get-r-sby-invoice-item-adjustment-params {
    /// ID of the Invoice Item Adjustment, for example, e20b07fd416dcfcf0141c81164fd0a72.
    invoice-item-adj-key: string
  }
  get-r-sby-invoice-item-adjustment: func(params: get-r-sby-invoice-item-adjustment-params) -> result<string, string>;

  /// Create a revenue schedule for an invoice item adjustment (manual distribution)
  record post-r-sfor-invoice-item-adjustment-manual-distribution-params {
    /// ID or number of the Invoice Item Adjustment, for example, e20b07fd416dcfcf0141c81164fd0a72.
    /// If the specified Invoice Item Adjustment is already associated with a revenue schedule, the call will fail.
    invoice-item-adj-key: string
  }
  post-r-sfor-invoice-item-adjustment-manual-distribution: func(params: post-r-sfor-invoice-item-adjustment-manual-distribution-params) -> result<string, string>;

  /// Create a revenue schedule for an invoice item adjustment (distribute by date range)
  record post-r-sfor-invoice-item-adjustment-distribute-by-date-range-params {
    /// ID or number of the Invoice Item Adjustment, for example, e20b07fd416dcfcf0141c81164fd0a72.
    /// If the specified Invoice Item Adjustment is already associated with a revenue schedule, the call will fail.
    invoice-item-adj-key: string
  }
  post-r-sfor-invoice-item-adjustment-distribute-by-date-range: func(params: post-r-sfor-invoice-item-adjustment-distribute-by-date-range-params) -> result<string, string>;

  /// Retrieve a revenue schedule by invoice item ID
  record get-r-sby-invoice-item-params {
    /// A valid Invoice Item ID.
    invoice-item-id: string
  }
  get-r-sby-invoice-item: func(params: get-r-sby-invoice-item-params) -> result<string, string>;

  /// Create a revenue schedule for an invoice item (manual distribution)
  record post-r-sfor-invoice-item-manual-distribution-params {
    /// ID of the Invoice Item, for example, e20b07fd416dcfcf0141c81164fd0a75.
    /// If the specified Invoice Item is already associated with a revenue schedule, the call will fail.
    invoice-item-id: string
  }
  post-r-sfor-invoice-item-manual-distribution: func(params: post-r-sfor-invoice-item-manual-distribution-params) -> result<string, string>;

  /// Create a revenue schedule for an invoice item (distribute by date range)
  record post-r-sfor-invoice-item-distribute-by-date-range-params {
    /// ID of the Invoice Item, for example, e20b07fd416dcfcf0141c81164fd0a75.
    /// If the specified Invoice Item is already associated with a revenue schedule, the call will fail.
    invoice-item-id: string
  }
  post-r-sfor-invoice-item-distribute-by-date-range: func(params: post-r-sfor-invoice-item-distribute-by-date-range-params) -> result<string, string>;

  /// List revenue schedules of a product charge by charge ID and account key
  record get-r-sby-product-charge-and-billing-account-params {
    /// The account number or account ID.
    account-key: string,
    /// The unique ID of a product rate plan charge. For example, 8a8082e65ba86084015bb323d3c61d82.
    charge-key: string
  }
  get-r-sby-product-charge-and-billing-account: func(params: get-r-sby-product-charge-and-billing-account-params) -> result<string, string>;

  /// List revenue schedules by subscription charge key
  record get-r-sfor-subsc-charge-params {
    /// ID of the subscription rate plan charge; for example, 402892793e173340013e173b81000012.
    charge-key: string
  }
  get-r-sfor-subsc-charge: func(params: get-r-sfor-subsc-charge-params) -> result<string, string>;

  /// Create a revenue schedule by subscription charge key
  record post-r-sfor-subsc-charge-params {
    /// ID of the subscription rate plan charge; for example, 402892793e173340013e173b81000012.
    charge-key: string
  }
  post-r-sfor-subsc-charge: func(params: post-r-sfor-subsc-charge-params) -> result<string, string>;

  /// List all details of a revenue schedule
  record get-rs-params {
    /// Revenue schedule number. The revenue schedule number is always prefixed with "RS", for example, "RS-00000001".
    rs-number: string
  }
  get-rs: func(params: get-rs-params) -> result<string, string>;

  /// Delete a revenue schedule
  record delete-rs-params {
    /// 
    /// Revenue schedule number of the revenue schedule you want to delete, for example, RS-00000256. To be deleted, the revenue schedule:
    rs-number: string
  }
  delete-rs: func(params: delete-rs-params) -> result<string, string>;

  /// Update a revenue schedule
  record put-rs-basic-info-params {
    /// Revenue schedule number. The revenue schedule number is always prefixed with "RS", for example, "RS-00000001".
    rs-number: string
  }
  put-rs-basic-info: func(params: put-rs-basic-info-params) -> result<string, string>;

  /// Distribute revenue across accounting periods
  record put-revenue-across-ap-params {
    /// Revenue schedule number. The revenue schedule number is always prefixed with "RS", for example, "RS-00000001".
    rs-number: string
  }
  put-revenue-across-ap: func(params: put-revenue-across-ap-params) -> result<string, string>;

  /// Distribute revenue on a specific date
  record put-revenue-specific-date-params {
    /// Revenue schedule number. The revenue schedule number is always prefixed with "RS", for example, "RS-00000001".
    rs-number: string
  }
  put-revenue-specific-date: func(params: put-revenue-specific-date-params) -> result<string, string>;

  /// Distribute revenue in a recognition period
  record put-revenue-by-recognition-startand-end-dates-params {
    /// Revenue schedule number. Specify the revenue schedule whose revenue you want to distribute.
    ///   
    rs-number: string
  }
  put-revenue-by-recognition-startand-end-dates: func(params: put-revenue-by-recognition-startand-end-dates-params) -> result<string, string>;

}

interface zuora-revenue-integration {
  /// Update a Zuora Revenue accounting code
  put-rev-pro-accounting-codes: func() -> result<string, string>;

}

interface rsa-signatures {
  /// Generate an RSA signature
  post-rsa-signatures: func() -> result<string, string>;

  /// Decrypt an RSA signature
  post-decrypt-rsa-signatures: func() -> result<string, string>;

}

interface sequence-sets {
  /// List sequence sets
  record get-sequence-sets-params {
    /// The name of a specific sequence set.
    name: option<string>
  }
  get-sequence-sets: func(params: get-sequence-sets-params) -> result<string, string>;

  /// Create sequence sets
  post-sequence-sets: func() -> result<string, string>;

  /// Retrieve a sequence set
  record get-sequence-set-params {
    /// The ID of the sequence set to retrieve information about.
    id: string
  }
  get-sequence-set: func(params: get-sequence-set-params) -> result<string, string>;

  /// Update a sequence set
  record put-sequence-set-params {
    /// The ID of the sequence set to update.
    id: string
  }
  put-sequence-set: func(params: put-sequence-set-params) -> result<string, string>;

  /// Delete a sequence set
  record delete-sequence-set-params {
    /// The ID of the sequence set to delete.
    id: string
  }
  delete-sequence-set: func(params: delete-sequence-set-params) -> result<string, string>;

}

interface transactions {
  /// List all invoices for an account
  record get-transaction-invoice-params {
    /// Account number or account ID.
    account-key: string
  }
  get-transaction-invoice: func(params: get-transaction-invoice-params) -> result<string, string>;

  /// List all payments for an account
  record get-transaction-payment-params {
    /// Account number or account ID.
    account-key: string
  }
  get-transaction-payment: func(params: get-transaction-payment-params) -> result<string, string>;

}

interface users {
  /// Multi-entity: Accept user access
  record put-accept-user-access-params {
    /// Specify the login name of the user that you want to accept the access request for.
    username: string
  }
  put-accept-user-access: func(params: put-accept-user-access-params) -> result<string, string>;

  /// Multi-entity: List all entities that a user can access
  record get-entities-user-accessible-params {
    /// Specify the login user name that you want to retrieve.
    username: string
  }
  get-entities-user-accessible: func(params: get-entities-user-accessible-params) -> result<string, string>;

  /// Multi-entity: Deny user access
  record put-deny-user-access-params {
    /// Specify the login name of the user that you want to deny the access.
    username: string
  }
  put-deny-user-access: func(params: put-deny-user-access-params) -> result<string, string>;

  /// Multi-entity: Send user access requests
  record put-send-user-access-requests-params {
    /// Specify the login name of the user who wants to access other entities.
    username: string
  }
  put-send-user-access-requests: func(params: put-send-user-access-requests-params) -> result<string, string>;

}

interface workflows {
  /// List workflows
  record get-workflows-params {
    /// If set to true, the operation retrieves workflows that have the callout trigger enabled. If set to false, the operation retrieves workflows that have the callout trigger disabled. If not specified, the operation will not use this filter.
    callout-trigger: option<bool>,
    /// A CRON expession that specifies a schedule (for example, `0 0 * * *`). If specified, the operation retrieves the workflow that is run based on the specified schedule.
    interval: option<string>,
    /// If specified, the operation retrieves the workflow that is in the specified name.
    name: option<string>,
    /// If set to true, the operation retrieves workflows that have the ondemand trigger enabled. If set to false, the operation retrieves workflows that have the ondemand trigger disabled. If not specified, the operation will not use this filter.
    ondemand-trigger: option<bool>,
    /// If set to true, the operation retrieves workflows that have the scheduled trigger enabled. If set to false, the operation retrieves workflows that have the scheduled trigger disabled. If not specfied, the operation will not use this filter.
    scheduled-trigger: option<bool>,
    /// If you want to retrieve only the workflows on a specific page, you can specify the `page` number in the query.
    page: option<s32>,
    /// The number of workflows shown in a single call. If the `page` parameter is not specified, the operation will return only the first page of results. If there are multiple pages of results, use it with the `page` parameter to get the results on subsequent pages.
    page-length: option<s32>
  }
  get-workflows: func(params: get-workflows-params) -> result<string, string>;

  /// Import a workflow
  post-workflow-import: func() -> result<string, string>;

  /// Retrieve workflow task usage
  record get-workflows-usages-params {
    /// The start date of the usage data that you want to get. For example, 2019-01-01.
    start-date: string,
    /// The end date of the usage data that you want to get. For example, 2019-12-31.
    end-date: string,
    /// The type of metric that you want to get. Currently, only `taskCount` is supported. `taskCount` is the amount of task runs.
    metrics: string
  }
  get-workflows-usages: func(params: get-workflows-usages-params) -> result<string, string>;

  /// List workflow tasks
  record get-workflows-tasks-params {
    /// If specified, the operation retrieves the task that is with specified id.
    id: option<string>,
    /// If specified, the operation retrieves tasks that is in the specified name.
    name: option<string>,
    /// If set to true, the operation retrieves workflows that have the scheduled trigger enabled. If set to false, the operation retrieves workflows that have the scheduled trigger disabled. If not specfied, the operation will not use this filter.
    instance: option<bool>,
    /// If specified, the operation retrieves tasks that is the specified type.
    action-type: option<string>,
    /// If specified, the operation retrieves tasks with the specified object.
    object: option<string>,
    /// If specified, the operation retrieves tasks with the specified object id.
    object-id: option<string>,
    /// If specified, the operation retrieves tasks with the specified api call type used.
    call-type: option<string>,
    /// If specified, the operation retrieves tasks that for the specified workflow id.
    workflow-id: option<string>,
    /// If specified, the operation retrieves tasks that with the specified filter tags.
    tags: option<string>,
    /// If you want to retrieve only the workflows on a specific page, you can specify the `page` number in the query.
    page: option<s32>,
    /// The number of workflows shown in a single call. If the `page` parameter is not specified, the operation will return only the first page of results. If there are multiple pages of results, use it with the `page` parameter to get the results on subsequent pages.
    page-length: option<s32>
  }
  get-workflows-tasks: func(params: get-workflows-tasks-params) -> result<string, string>;

  /// Update workflow tasks
  put-workflows-tasks-update: func() -> result<string, string>;

  /// Retrieve a workflow task
  record get-workflows-task-params {
    /// The unique ID of the task.
    task-id: string
  }
  get-workflows-task: func(params: get-workflows-task-params) -> result<string, string>;

  /// Rerun a workflow task
  record post-workflows-task-rerun-params {
    /// The unique ID of the task.
    task-id: string
  }
  post-workflows-task-rerun: func(params: post-workflows-task-rerun-params) -> result<string, string>;

  /// Retrieve a workflow
  record get-workflow-params {
    /// The unique ID of a workflow. For example, 19080.
    workflow-id: string
  }
  get-workflow: func(params: get-workflow-params) -> result<string, string>;

  /// Update a workflow definition
  record patch-update-workflow-params {
    /// The unique ID of a workflow. For example, 19080.
    workflow-id: string
  }
  patch-update-workflow: func(params: patch-update-workflow-params) -> result<string, string>;

  /// Delete a workflow
  record delete-workflow-params {
    /// The unique ID of a workflow. For example, 19080.
    workflow-id: string
  }
  delete-workflow: func(params: delete-workflow-params) -> result<string, string>;

  /// Export a workflow
  record get-workflow-export-params {
    /// The ID of the workflow to export.
    workflow-id: string
  }
  get-workflow-export: func(params: get-workflow-export-params) -> result<string, string>;

  /// Run a workflow
  record post-run-workflow-params {
    /// The ID of the workflow you want to run.
    workflow-id: string
  }
  post-run-workflow: func(params: post-run-workflow-params) -> result<string, string>;

}
