    item-id: string
  }
  get-taxation-items-of-invoice-item: func(params: get-taxation-items-of-invoice-item-params) -> result<string, string>;

  /// Reverse an invoice
  record put-reverse-invoice-params {
    /// The ID of the invoice. For example, 2c92c8955bd63cc1015bd7c151af02ab.
    invoice-id: string
  }
  put-reverse-invoice: func(params: put-reverse-invoice-params) -> result<string, string>;

  /// Write off an invoice
  record put-write-off-invoice-params {
    /// The unique ID of an invoice. For example, 2c92c8955bd63cc1015bd7c151af02ab.
    invoice-id: string
  }
  put-write-off-invoice: func(params: put-write-off-invoice-params) -> result<string, string>;

  /// CRUD: Retrieve an invoice
  record object-get-invoice-params {
    /// Object fields to return
    fields: option<string>,
    /// Object id
    id: string
  }
  object-get-invoice: func(params: object-get-invoice-params) -> result<string, string>;

  /// CRUD: Update an invoice
  record object-put-invoice-params {
    /// Object id
    id: string
  }
  object-put-invoice: func(params: object-put-invoice-params) -> result<string, string>;

  /// CRUD: Delete an invoice
  record object-delete-invoice-params {
    /// Object id
    id: string
  }
  object-delete-invoice: func(params: object-delete-invoice-params) -> result<string, string>;

}

