interface payments {
  enum get-retrieve-all-payments-status-enum {
    draft,
    processing,
    processed,
    error,
    canceled,
    posted,
  }

  enum get-retrieve-all-payments-type-op-enum {
    external,
    electronic,
  }

  /// CRUD: Create a payment
  object-post-payment: func() -> result<string, string>;

  /// CRUD: Retrieve a payment
  record object-get-payment-params {
    /// The unique ID of a payment. For example, 2c92c095592623ea01596621ada84352.
    id: string
  }
  object-get-payment: func(params: object-get-payment-params) -> result<string, string>;

  /// CRUD: Update a payment
  record object-put-payment-params {
    /// The unique ID of a payment. For example, 2c92c095592623ea01596621ada84352.
    id: string
  }
  object-put-payment: func(params: object-put-payment-params) -> result<string, string>;

  /// CRUD: Delete a payment
  record object-delete-payment-params {
    /// The unique ID of the payment to be deleted. For example, 2c92c0f85d4e95ae015d4f7e5d690622.
    id: string
  }
  object-delete-payment: func(params: object-delete-payment-params) -> result<string, string>;

  /// List payments
  record get-retrieve-all-payments-params {
    /// This parameter filters the response based on the `accountId` field.
    account-id: option<string>,
    /// This parameter filters the response based on the `amount` field.
    amount: option<f64>,
    /// This parameter filters the response based on the `appliedAmount` field.
    applied-amount: option<f64>,
    /// This parameter filters the response based on the `createdById` field.
    created-by-id: option<string>,
    /// This parameter filters the response based on the `createdDate` field.
    created-date: option<string>,
    /// This parameter filters the response based on the `creditBalanceAmount` field.
    credit-balance-amount: option<f64>,
    /// This parameter filters the response based on the `currency` field.
    currency: option<string>,
    /// This parameter filters the response based on the `effectiveDate` field.
    effective-date: option<string>,
    /// This parameter filters the response based on the `number` field.
    number: option<string>,
    /// This parameter filters the response based on the `refundAmount` field.
    refund-amount: option<f64>,
    /// This parameter filters the response based on the `status` field.
    status: option<get-retrieve-all-payments-status-enum>,
    /// This parameter filters the response based on the `type` field.
    type-op: option<get-retrieve-all-payments-type-op-enum>,
    /// This parameter filters the response based on the `unappliedAmount` field.
    unapplied-amount: option<f64>,
    /// This parameter filters the response based on the `updatedById` field.
    updated-by-id: option<string>,
    /// This parameter filters the response based on the `updatedDate` field.
    updated-date: option<string>,
    /// This parameter restricts the order of the data returned in the response. You can use this parameter to supply a dimension you want to sort on.
    /// 
    sort: option<string>
  }
  get-retrieve-all-payments: func(params: get-retrieve-all-payments-params) -> result<string, string>;

  /// Create a payment
  post-create-payment: func() -> result<string, string>;

  /// Retrieve a payment
  record get-payment-params {
    /// The unique ID of a payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  get-payment: func(params: get-payment-params) -> result<string, string>;

  /// Update a payment
  record put-update-payment-params {
    /// The unique ID of an unapplied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  put-update-payment: func(params: put-update-payment-params) -> result<string, string>;

  /// Delete a payment
  record delete-payment-params {
    /// The unique ID of an unapplied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  delete-payment: func(params: delete-payment-params) -> result<string, string>;

  /// Apply a payment
  record put-apply-payment-params {
    /// The unique ID of an unapplied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  put-apply-payment: func(params: put-apply-payment-params) -> result<string, string>;

  /// Cancel a payment
  record put-cancel-payment-params {
    /// The unique ID of an unapplied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  put-cancel-payment: func(params: put-cancel-payment-params) -> result<string, string>;

  /// List all parts of a payment
  record get-payment-parts-params {
    /// The unique ID of a payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  get-payment-parts: func(params: get-payment-parts-params) -> result<string, string>;

  /// Retrieve a payment part
  record get-payment-part-params {
    /// The unique ID of a specific payment part. You can get the payment part ID from the response of [List all parts of a payment](https://www.zuora.com/developer/api-reference/#operation/GET_PaymentParts).
    partid: string,
    /// The unique ID of a payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  get-payment-part: func(params: get-payment-part-params) -> result<string, string>;

  /// List all payment part items
  record get-payment-item-parts-params {
    /// The unique ID of a specific payment part. You can get the payment part ID from the response of [List all parts of a payment](https://www.zuora.com/developer/api-reference/#operation/GET_PaymentParts).
    partid: string,
    /// The unique ID of a payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  get-payment-item-parts: func(params: get-payment-item-parts-params) -> result<string, string>;

  /// Retrieve a payment part item
  record get-payment-item-part-params {
    /// The unique ID of a specific payment part. You can get the payment part ID from the response of [List all parts of a payment](https://www.zuora.com/developer/api-reference/#operation/GET_PaymentParts).
    partid: string,
    /// The unique ID of a specific payment part item. You can get the payment part item ID from the response of [List all payment part items](https://www.zuora.com/developer/api-reference/#operation/GET_PaymentItemParts).
    itempartid: string,
    /// The unique ID of a payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  get-payment-item-part: func(params: get-payment-item-part-params) -> result<string, string>;

  /// Refund a payment
  record post-refund-payment-params {
    /// The unique ID of an unapplied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  post-refund-payment: func(params: post-refund-payment-params) -> result<string, string>;

  /// Transfer a payment
  record put-transfer-payment-params {
    /// The unique ID of an unapplied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  put-transfer-payment: func(params: put-transfer-payment-params) -> result<string, string>;

  /// Unapply a payment
  record put-unapply-payment-params {
    /// The unique ID of an applied payment. For example, 8a8082e65b27f6c3015b89e4344c16b1.
    payment-id: string
  }
  put-unapply-payment: func(params: put-unapply-payment-params) -> result<string, string>;

}

interface payment-methods {
  /// CRUD: Create a payment method
  object-post-payment-method: func() -> result<string, string>;

  /// CRUD: Retrieve a payment method
  record object-get-payment-method-params {
    /// Object fields to return
    fields: option<string>,
    /// Object id
    id: string
  }
  object-get-payment-method: func(params: object-get-payment-method-params) -> result<string, string>;

  /// CRUD: Update a payment method
  record object-put-payment-method-params {
    /// Object id
    id: string
  }
  object-put-payment-method: func(params: object-put-payment-method-params) -> result<string, string>;

  /// CRUD: Delete a payment method
  record object-delete-payment-method-params {
    /// Object id
    id: string
  }
  object-delete-payment-method: func(params: object-delete-payment-method-params) -> result<string, string>;

  /// Create a payment method
  post-payment-methods: func() -> result<string, string>;

  /// Create a credit card payment method
  post-payment-methods-credit-card: func() -> result<string, string>;

  /// List all credit card payment methods of an account
  record get-payment-methods-credit-card-params {
    /// Account number or account ID.
    account-key: string
  }
  get-payment-methods-credit-card: func(params: get-payment-methods-credit-card-params) -> result<string, string>;

  /// Update a credit card payment method
  record put-payment-methods-credit-card-params {
    /// Unique ID of the payment method to update.
    payment-method-id: string
  }
  put-payment-methods-credit-card: func(params: put-payment-methods-credit-card-params) -> result<string, string>;

  /// Create an Apple Pay payment method
  post-payment-methods-decryption: func() -> result<string, string>;

  /// Retrieve a payment method
  record get-payment-method-params {
    /// Unique ID of the payment method to update.
    payment-method-id: string
  }
  get-payment-method: func(params: get-payment-method-params) -> result<string, string>;

  /// Update a payment method
  record put-payment-method-params {
    /// Unique ID of the payment method to update.
    payment-method-id: string
  }
  put-payment-method: func(params: put-payment-method-params) -> result<string, string>;

  /// Delete a payment method
  record delete-payment-methods-params {
    /// Unique identifier of a payment method. (Since this ID is unique, and linked to a customer account in the system, no customer identifier is needed.)
    payment-method-id: string
  }
  delete-payment-methods: func(params: delete-payment-methods-params) -> result<string, string>;

  /// Create authorization
  record post-create-authorization-params {
    /// The unique ID of the payment method where the authorization is created.
    payment-method-id: string
  }
  post-create-authorization: func(params: post-create-authorization-params) -> result<string, string>;

  /// List stored credential profiles of a payment method
  record get-stored-credential-profiles-params {
    /// ID of a payment method.
    payment-method-id: string,
    /// Specifies whether to retrieve all the stored credential profiles within the payment method.
    /// 
    include-all: option<bool>
  }
  get-stored-credential-profiles: func(params: get-stored-credential-profiles-params) -> result<string, string>;

  /// Create a stored credential profile
  record post-create-stored-credential-profile-params {
    /// ID of a payment method.
    payment-method-id: string
  }
  post-create-stored-credential-profile: func(params: post-create-stored-credential-profile-params) -> result<string, string>;

  /// Cancel a stored credential profile
  record post-cancel-stored-credential-profile-params {
    /// ID of a payment method.
    payment-method-id: string,
    /// Number that identifies a stored credential profile within the payment method.
    profile-number: string
  }
  post-cancel-stored-credential-profile: func(params: post-cancel-stored-credential-profile-params) -> result<string, string>;

  /// Expire a stored credential profile
  record post-expire-stored-credential-profile-params {
    /// ID of a payment method.
    payment-method-id: string,
    /// Number that identifies a stored credential profile within the payment method.
    profile-number: string
  }
  post-expire-stored-credential-profile: func(params: post-expire-stored-credential-profile-params) -> result<string, string>;

  /// Scrub a payment method
  record put-scrub-payment-methods-params {
    /// The ID of the payment method where you want to scrub the sensitive data.
    payment-method-id: string
  }
  put-scrub-payment-methods: func(params: put-scrub-payment-methods-params) -> result<string, string>;

  /// Verify a payment method
  record put-verify-payment-methods-params {
    /// The ID of the payment method to be verified.
    payment-method-id: string
  }
  put-verify-payment-methods: func(params: put-verify-payment-methods-params) -> result<string, string>;

  /// Cancel authorization
  record post-cancel-authorization-params {
    /// The unique ID of the payment method where the authorization is cancelled.
    payment-method-id: string
  }
  post-cancel-authorization: func(params: post-cancel-authorization-params) -> result<string, string>;

}

