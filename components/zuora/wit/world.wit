interface payment-gateway-reconciliation {
  enum post-reconcile-refund-request-action-enum {
    settle,
    reject,
  }

  enum post-reconcile-refund-response-finance-information-transferred-to-accounting-enum {
    processing,
    yes,
    no,
    error,
    ignore,
  }

  enum post-reconcile-refund-response-gateway-state-enum {
    settled,
    failed-to-settle,
  }

  enum post-reconcile-refund-response-method-type-enum {
    ach,
    cash,
    check,
    credit-card,
    pay-pal,
    wire-transfer,
    debit-card,
    credit-card-reference-transaction,
    bank-transfer,
    other,
  }

  enum post-reconcile-refund-response-type-op-enum {
    external,
    electronic,
  }

  record post-reconcile-refund-response {
    /// The ID of the customer account that the refund is for.
    account-id: option<string>,
    /// The total amount of the refund.
    amount: option<f64>,
    /// The date and time when the transaction was cancelled, in `yyyy-mm-dd hh:mm:ss` format.
    cancelled-on: option<string>,
    /// Comments about the refund.
    comment: option<string>,
    /// The ID of the Zuora user who created the refund.
    created-by-id: option<string>,
    /// The date and time when the refund is created, in `yyyy-mm-dd hh:mm:ss` format.
    created-date: option<string>,
    /// The ID of the credit memo that is refunded.
    credit-memo-id: option<string>,
    /// Container for the finance information related to the refund.
    finance-information: option<post-reconcile-refund-response-finance-information>,
    /// The ID of the gateway instance that processes the refund.
    gateway-id: option<string>,
    /// The reason of gateway reconciliation.
    gateway-reconciliation-reason: option<string>,
    /// The status of gateway reconciliation.
    gateway-reconciliation-status: option<string>,
    /// The message returned from the payment gateway for the refund. This message is gateway-dependent.
    gateway-response: option<string>,
    /// The code returned from the payment gateway for the refund. This code is gateway-dependent.
    gateway-response-code: option<string>,
    /// The status of the refund in the gateway; used for reconciliation.
    gateway-state: option<post-reconcile-refund-response-gateway-state-enum>,
    /// The ID of the refund.
    id: option<string>,
    /// The date and time when a refund was marked and waiting for batch submission to the payment process, in `yyyy-mm-dd hh:mm:ss` format.
    marked-for-submission-on: option<string>,
    /// How an external refund was issued to a customer. 
    method-type: option<post-reconcile-refund-response-method-type-enum>,
    /// The unique identification number of the refund. For example, R-00000001.
    number: option<string>,
    /// The ID of the payment that is refunded.
    payment-id: option<string>,
    /// The unique ID of the payment method that the customer used to make the refund.
    payment-method-id: option<string>,
    /// The unique ID of the payment method snapshot which is a copy of the particular Payment Method used in a transaction.
    payment-method-snapshot-id: option<string>,
    /// The payout ID of the refund from the gateway side.
    payout-id: option<string>,
    /// A code identifying the reason for the transaction.      
    reason-code: option<string>,
    /// The transaction ID returned by the payment gateway for an electronic refund. Use this field to reconcile refunds between your gateway and Zuora Payments.
    reference-id: option<string>,
    /// The date when the refund takes effect, in `yyyy-mm-dd` format. For example, 2020-03-01.       
    refund-date: option<string>,
    /// The date and time when the refund was issued, in `yyyy-mm-dd hh:mm:ss` format.
    refund-transaction-time: option<string>,
    /// The transaction ID returned by the payment gateway if there is an additional refund. 
    second-refund-reference-id: option<string>,
    /// The date and time when the transaction is settled, in `yyyy-mm-dd hh:mm:ss` format.
    settled-on: option<string>,
    /// A payment gateway-specific field that maps Zuora to other gateways.
    soft-descriptor: option<string>,
    /// A payment gateway-specific field that maps Zuora to other gateways.          
    soft-descriptor-phone: option<string>,
    /// The status of the refund.
    status: option<string>,
    /// The date and time when the refund was submitted, in yyyy-mm-dd hh:mm:ss format.
    submitted-on: option<string>,
    /// Indicates if the request is processed successfully.
    success: option<bool>,
    /// The type of the refund.
    type-op: option<post-reconcile-refund-response-type-op-enum>,
    /// The ID of the Zuora user who last updated the refund.
    updated-by-id: option<string>,
    /// The date and time when the refund was last updated, in `yyyy-mm-dd hh:mm:ss` format.
    updated-date: option<string>
  }

  /// Container for the finance information related to the refund.
  record post-reconcile-refund-response-finance-information {
    /// The accounting code that maps to a bank account in your accounting system.
    bank-account-accounting-code: option<string>,
    /// The type of the accounting code that maps to a bank account in your accounting system.
    ///   
    bank-account-accounting-code-type: option<string>,
    /// Whether the refund was transferred to an external accounting system. Use this field for integration with accounting systems, such as NetSuite. 
    transferred-to-accounting: option<post-reconcile-refund-response-finance-information-transferred-to-accounting-enum>,
    /// The accounting code for the unapplied payment.
    unapplied-payment-accounting-code: option<string>,
    /// The type of the accounting code for the unapplied payment.
    ///   
    unapplied-payment-accounting-code-type: option<string>
  }

  /// Reverse a payment
  record post-reverse-payment-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Unique ID of the payment.
    payment-id: string,
    /// The amount that needs to be reversed (chargeback). It cannot be greater than the total Payment amount. 
    amount: f64,
    /// The transaction response returned by the gateway for this transaction. If the transaction was declined, this reason is provided in the message.
    gateway-response: option<string>,
    /// Response message Code returned by the gateway about the transaction status.
    gateway-response-code: option<string>,
    /// Unique Id generated by the gateway for each transaction. Use this ID to find the respective Zuora Payment ID. 
    reference-id: option<string>,
    /// The second reference Id. Some gateways use two unique transaction IDs.
    second-reference-id: option<string>,
    /// The date and time of the transaction settlement. The format is `yyyy-mm-dd hh:mm:ss`.
    settled-on: option<string>
  }
  post-reverse-payment: func(params: post-reverse-payment-params) -> result<string, string>;

  /// Reject a payment
  record post-reject-payment-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Unique ID of the payment.
    payment-id: string,
    /// The transaction response returned by the gateway for this transaction. If the transaction was declined, this reason is provided in the message.
    gateway-response: option<string>,
    /// Response message Code returned by the gateway about the transaction status.
    gateway-response-code: option<string>,
    /// Unique Id generated by the gateway for each transaction. Use this ID to find the respective Zuora Payment ID. 
    reference-id: option<string>,
    /// The second reference Id. Some gateway uses two unique transaction IDs.
    second-reference-id: option<string>,
    /// The date and time of the transaction settlement. The format is `yyyy-mm-dd hh:mm:ss`.
    settled-on: option<string>
  }
  post-reject-payment: func(params: post-reject-payment-params) -> result<string, string>;

  /// Settle a payment
  record post-settle-payment-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Unique ID of the payment.
    payment-id: string,
    /// The date and time of the transaction settlement. The format is `yyyy-mm-dd hh:mm:ss`.
    settled-on: option<string>
  }
  post-settle-payment: func(params: post-settle-payment-params) -> result<string, string>;

  /// Reconcile a refund
  record post-reconcile-refund-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Unique ID of the refund.
    refund-id: string,
    /// The action of the refund reconciliation.
    ///   - `settle`: Sets the gatewayState to "Settled" and returns the refund object as response.
    action: option<post-reconcile-refund-request-action-enum>,
    /// The date and time of the refund reconciliation action, in `yyyy-mm-dd hh:mm:ss` format.
    action-date: option<string>,
    /// The reason of gateway reconciliation.
    gateway-reconciliation-reason: option<string>,
    /// The status of gateway reconciliation.
    gateway-reconciliation-status: option<string>,
    /// The payout ID of the refund from the gateway side.
    payout-id: option<string>
  }
  post-reconcile-refund: func(params: post-reconcile-refund-params) -> result<post-reconcile-refund-response, string>;

}

interface hmac-signatures {
  /// Generate an HMAC signature
  record post-hmac-signatures-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Customer account number or ID.
    /// 
    account-key: option<string>,
    /// Possible values are: 'GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'.
    method: string,
    /// Account name.
    /// 
    name: option<string>,
    /// The page id of your Payment Pages 2.0 form. Click **Show Page Id** next to the Payment Page name in the Hosted Page List to retrieve the page id.
    /// 
    page-id: option<string>,
    /// The URI of the API object the customer will make a CORS enabled call to.
    /// e.g. "https://rest.zuora.com/v1/payment-methods/credit-cards"
    uri: string
  }
  post-hmac-signatures: func(params: post-hmac-signatures-params) -> result<string, string>;

}

interface hosted-pages {
  /// List hosted pages
  record get-hosted-pages-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// Version of the Payment Pages for which you want to retrieve the configuration information. Specify 1 for Payment Pages 1.0 or 2 for Payment Pages 2.0. If omitted, information for all versions of Payment Pages are returned.
    /// 
    version-number: option<string>
  }
  get-hosted-pages: func(params: get-hosted-pages-params) -> result<string, string>;

}

interface invoices {
  enum post-invoice-item-type-rev-rec-trigger-condition-enum {
    contract-effective-date,
    service-activation-date,
    customer-acceptance-date,
  }

  enum post-taxation-item-type-tax-mode-enum {
    tax-inclusive,
    tax-exclusive,
  }

  enum post-taxation-item-type-tax-rate-type-enum {
    percentage,
    flat-fee,
  }

  enum post-invoice-type-status-enum {
    draft,
    posted,
  }

  enum batch-invoice-type-transferred-to-accounting-enum {
    processing,
    yes,
    error,
    ignore,
  }

  enum credit-memo-item-from-invoice-item-type-tax-mode-enum {
    tax-exclusive,
    tax-inclusive,
  }

  record post-invoice-item-type {
    /// The accounting code associated with the invoice item.
    accounting-code: option<string>,
    /// The amount of the invoice item. 
    /// 
    amount: string,
    /// The booking reference of the invoice item.
    booking-reference: option<string>,
    /// The date when the invoice item is charged.
    charge-date: option<string>,
    /// The name of the charge associated with the invoice item. 
    /// 
    charge-name: option<string>,
    /// The accounting code for the deferred revenue, such as Monthly Recurring Liability.
    /// 
    deferred-revenue-accounting-code: option<string>,
    /// The description of the invoice item.
    description: option<string>,
    /// The type of the invoice item.
    item-type: option<string>,
    /// The ID of the product rate plan charge that the invoice item is created from.
    /// 
    product-rate-plan-charge-id: option<string>,
    /// The purchase order number associated with the invoice item.
    purchase-order-number: option<string>,
    /// The number of units for the invoice item.
    quantity: option<string>,
    /// The accounting code for the recognized revenue, such as Monthly Recurring Charges or Overage Charges.
    /// 
    recognized-revenue-accounting-code: option<string>,
    /// The revenue recognition code.
    rev-rec-code: option<string>,
    /// The date when revenue recognition is triggered.
    rev-rec-trigger-condition: option<post-invoice-item-type-rev-rec-trigger-condition-enum>,
    /// The name of the revenue recognition rule governing the revenue schedule.
    /// 
    revenue-recognition-rule-name: option<string>,
    /// The service end date of the invoice item.
    service-end-date: option<string>,
    /// The service start date of the invoice item.
    service-start-date: string,
    /// The SKU of the invoice item.
    sku: option<string>,
    /// The tax code identifies which tax rules and tax rates to apply to the invoice item.
    /// 
    tax-code: option<string>,
    /// Container for taxation items. The maximum number of taxation items is 5.
    tax-items: option<list<post-taxation-item-type>>,
    /// The tax mode of the invoice item, indicating whether the amount of the invoice item includes tax.
    /// 
    tax-mode: option<post-taxation-item-type-tax-mode-enum>,
    /// The per-unit price of the invoice item.
    unit-price: option<string>,
    /// The unit of measure.
    uom: option<string>,
    /// ID of the corresponding object in NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    integration-id-ns: option<string>,
    /// Status of the invoice item's synchronization with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    integration-status-ns: option<string>,
    /// Date when the invoice item was synchronized with NetSuite. Only available if you have installed the [Zuora Connector for NetSuite](https://www.zuora.com/connect/app/?appId=265).
    sync-date-ns: option<string>
  }

  record post-taxation-item-type {
    /// The amount of taxes or VAT, for which your customer has an exemption.
    exempt-amount: option<string>,
    /// The jurisdiction that applies the tax or VAT. This value is typically a state, province, county, or city.
    jurisdiction: option<string>,
    /// The identifier for the location based on the value of the `taxCode` field.
    location-code: option<string>,
    /// The name of taxation.
    name: string,
    /// The amount of the taxation item in the invoice item.
    tax-amount: string,
    /// The tax code identifies which tax rules and tax rates to apply to a specific invoice item.
    tax-code: string,
    /// The description of the tax code.
    tax-code-description: option<string>,
    /// The date that the tax is applied to the invoice item, in `yyyy-mm-dd` format.
    tax-date: string,
    /// The tax mode of the invoice item, indicating whether the amount of the invoice item includes tax.
    tax-mode: post-taxation-item-type-tax-mode-enum,
    /// The tax rate applied to the invoice item.
    tax-rate: string,
    /// The description of the tax rate.
    tax-rate-description: option<string>,
    /// The type of the tax rate applied to the invoice item.
    tax-rate-type: post-taxation-item-type-tax-rate-type-enum
  }

  record batch-invoice-type {
    /// Whether invoices are automatically picked up for processing in the corresponding payment run.
