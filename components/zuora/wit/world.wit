    zuora-entity-ids: option<string>,
    /// The type of the request. Set it to POST.
    method: string,
    /// The page id of your Payment Pages 2.0 form. Click **Show Page Id** next to the Payment Page name in the Hosted Page List to retrieve the page id.
    page-id: string,
    /// The URL that the Payment Page will be served from.
    /// * For US Production environment: Use https://www.zuora.com/apps/PublicHostedPageLite.do
    uri: string
  }
  post-rsa-signatures: func(params: post-rsa-signatures-params) -> result<string, string>;

  /// Decrypt an RSA signature
  record post-decrypt-rsa-signatures-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// The type of the request. Set it to POST.
    method: string,
    /// The public key generated by Zuora.
    public-key: string,
    /// The signature generated by Zuora.
    signature: string
  }
  post-decrypt-rsa-signatures: func(params: post-decrypt-rsa-signatures-params) -> result<string, string>;

}

interface sequence-sets {
  record post-sequence-set-request {
    credit-memo: credit-memo-entity-prefix,
    debit-memo: debit-memo-entity-prefix,
    invoice: invoice-entity-prefix,
    /// The name of the sequence set to configure for billing documents, payments, and refunds.
    name: string,
    payment: option<payment-entity-prefix>,
    refund: option<refund-entity-prefix>
  }

  /// Container for the prefix and starting document number of credit memos.
  /// 
  /// **Note:** This field is only available if you have the Invoice Settlement feature enabled. The Invoice Settlement feature is generally available as of Zuora Billing Release 296 (March 2021). This feature includes Unapplied Payments, Credit and Debit Memo, and Invoice Item Settlement. If you want to enable Invoice Settlement, see [Invoice Settlement Enablement and Checklist Guide](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement/Invoice_Settlement_Migration_Checklist_and_Guide) for more information.
  record credit-memo-entity-prefix {
    /// The prefix of credit memos.
    prefix: option<string>,
    /// The starting document number of credit memos.
    start-number: option<s32>
  }

  /// Container for the prefix and starting document number of debit memos.
  /// 
  /// **Note:** This field is only available if you have the Invoice Settlement feature enabled. The Invoice Settlement feature is generally available as of Zuora Billing Release 296 (March 2021). This feature includes Unapplied Payments, Credit and Debit Memo, and Invoice Item Settlement. If you want to enable Invoice Settlement, see [Invoice Settlement Enablement and Checklist Guide](https://knowledgecenter.zuora.com/Billing/Billing_and_Payments/Invoice_Settlement/Invoice_Settlement_Migration_Checklist_and_Guide) for more information.
  record debit-memo-entity-prefix {
    /// The prefix of debit memos.
    prefix: option<string>,
    /// The starting document number of debit memos.
    start-number: option<s32>
  }

  /// Container for the prefix and starting document number of invoices.
  record invoice-entity-prefix {
    /// The prefix of invoices.
    prefix: option<string>,
    /// The starting document number of invoices.
    start-number: option<s32>
  }

  /// Container for the prefix and starting number of payments.
  record payment-entity-prefix {
    /// The prefix of payments.
    prefix: option<string>,
    /// The starting number of payments.
    start-number: option<s32>
  }

  /// Container for the prefix and starting number of refunds.
  record refund-entity-prefix {
    /// The prefix of refunds.
    prefix: option<string>,
    /// The starting number of refunds.
    start-number: option<s32>
  }

  /// List sequence sets
  record get-sequence-sets-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Number of rows returned per page.
    page-size: option<s32>,
    /// Page number.
    page: option<s32>,
    /// The name of a specific sequence set.
    name: option<string>
  }
  get-sequence-sets: func(params: get-sequence-sets-params) -> result<string, string>;

  /// Create sequence sets
  record post-sequence-sets-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Array of sequence sets configured for billing documents, payments, and refunds.
    sequence-sets: option<list<post-sequence-set-request>>
  }
  post-sequence-sets: func(params: post-sequence-sets-params) -> result<string, string>;

  /// Retrieve a sequence set
  record get-sequence-set-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The ID of the sequence set to retrieve information about.
    id: string
  }
  get-sequence-set: func(params: get-sequence-set-params) -> result<string, string>;

  /// Update a sequence set
  record put-sequence-set-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The ID of the sequence set to update.
    id: string,
    credit-memo: option<credit-memo-entity-prefix>,
    debit-memo: option<debit-memo-entity-prefix>,
    invoice: option<invoice-entity-prefix>,
    /// The name of the sequence set configured for billing documents, payments, and refunds.
    name: option<string>,
    payment: option<payment-entity-prefix>,
    refund: option<refund-entity-prefix>
  }
  put-sequence-set: func(params: put-sequence-set-params) -> result<string, string>;

  /// Delete a sequence set
  record delete-sequence-set-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The ID of the sequence set to delete.
    id: string
  }
  delete-sequence-set: func(params: delete-sequence-set-params) -> result<string, string>;

}

