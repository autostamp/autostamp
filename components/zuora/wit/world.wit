interface custom-object-jobs {
  enum custom-object-bulk-job-response-namespace-enum {
    default,
    com-zuora,
  }

  enum custom-object-bulk-job-response-operation-enum {
    delete,
    create,
  }

  enum custom-object-bulk-job-response-status-enum {
    open,
    pending,
    in-progress,
    completed,
    failed,
    cancelled,
  }

  enum custom-object-bulk-delete-filter-condition-operator-enum {
    eq,
    gt,
    lt,
    ge,
    le,
  }

  record custom-object-bulk-job-response-collection {
    /// The number of custom object bulk jobs returned in the result page set.
    count: option<s32>,
    /// The `cursor` points to the last job record of the current page.
    cursor: option<string>,
    /// All custom object bulk jobs returned in the result page set.
    jobs: list<custom-object-bulk-job-response>
  }

  record custom-object-bulk-job-response {
    /// The ID of the user who creates the job.
    created-by-id: option<string>,
    /// The time when the bulk job is created.
    created-date: option<string>,
    /// The custom object bulk job ID.
    id: option<string>,
    /// The ID of the user who updates the job.
    updated-by-id: option<string>,
    /// The time when the bulk job is updated.
    updated-date: option<string>,
    error: option<custom-object-bulk-job-response-error>,
    /// The namespace of the object. Custom objects belong to the `default` namespace. Zuora standard objects belong to the `com_zuora` namespace. Bulk job operations on the following Zuora standard objects are supported:
    /// * SavedQuery
    namespace: option<custom-object-bulk-job-response-namespace-enum>,
    /// The object to that the bulk operation performs on.
    object: option<string>,
    /// The operation that the bulk job performs. Only the users that have the "Delete Custom Objects" permission can submit a `delete` bulk job request. Only the users that have the "Edit Custom Objects" permission can submit a `create` or `update` bulk job request. See [Platform Permissions](https://knowledgecenter.zuora.com/Billing/Tenant_Management/A_Administrator_Settings/User_Roles/h_Platform_Roles#Platform_Permissions) for more information.
    operation: option<custom-object-bulk-job-response-operation-enum>,
    /// The amount of time elapsed, in milliseconds, from the submission to the completion of the bulk job.
    processing-time: option<s32>,
    /// The number of object records processed by the bulk job.
    records-processed: option<s32>,
    /// The status of the bulk job.
    status: option<custom-object-bulk-job-response-status-enum>
  }

  record custom-object-bulk-job-response-error {
    /// The error code.
    code: option<s32>,
    /// The error message.
    message: option<string>
  }

  /// Filters to determine which records to be deleted in the bulk delete operation.
  record custom-object-bulk-delete-filter {
    /// Group of field filter conditions that are evaluated in conjunction with each other using the AND operator. The minimum number of conditions is 1 and the maximum is 2.
    conditions: list<custom-object-bulk-delete-filter-condition>
  }

  /// Condition evaluated on a single object field
  record custom-object-bulk-delete-filter-condition {
    /// The object field that is evaluated. Only filterable fields can be evaluated in the filter.
    field: string,
    operator: custom-object-bulk-delete-filter-condition-operator-enum,
    /// The value that the filterable `field` is evaluated against in the filter. The data type of `value` is consistent with that of the `field`.
    value: string
  }

  record custom-object-bulk-job-error-response-collection {
    /// All errors for a custom object bulk job.
    errors: list<custom-object-bulk-job-error-response>
  }

  record custom-object-bulk-job-error-response {
    /// The error code.
    code: option<s32>,
    /// The error message.
    message: option<string>,
    record-op: option<custom-object-record-with-all-fields>,
    /// The CSV record row number. The custom object record data starts at the second row because the first row is the CSV header.
    row: option<s32>
  }

  /// Record data from an object
  record custom-object-record-with-all-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-custom-object-bulk-job-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant get-custom-object-bulk-job-error {
    not-found(string),
    other(string)
  }

  variant get-custom-object-bulk-job-errors-error {
    not-found(string),
    other(string)
  }

  variant post-upload-file-for-custom-object-bulk-job-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// List all custom object bulk jobs
  record get-all-custom-object-bulk-jobs-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// Page size of the result. The maximum page size is 100. The defaut page size is 25.
    page-size: option<s32>,
    /// The `cursor` points to the last job of the previous result set. The cursor job is not included in this query result. The call returns the first page if `cursor` is not provided and `pageSize` is valid.
    cursor: option<string>
  }
  get-all-custom-object-bulk-jobs: func(params: get-all-custom-object-bulk-jobs-params) -> result<custom-object-bulk-job-response-collection, string>;

  /// Submit a custom object bulk job
  record post-custom-object-bulk-job-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    filter: option<custom-object-bulk-delete-filter>,
    /// The namespace of the object. Custom objects belong to the `default` namespace. Zuora standard objects belong to the `com_zuora` namespace. Bulk job operations on the following Zuora standard objects are supported:
    /// * SavedQuery
    namespace: custom-object-bulk-job-response-namespace-enum,
    /// The object that the bulk operation performs on.
    object: string,
    /// The operation that the bulk job performs. Only the users that have the "Delete Custom Objects" permission can submit a `delete` bulk job request. Only the users that have the "Edit Custom Objects" permission can submit a `create` or `update` bulk job request. See [Platform Permissions](https://knowledgecenter.zuora.com/Billing/Tenant_Management/A_Administrator_Settings/User_Roles/h_Platform_Roles#Platform_Permissions) for more information.
    operation: custom-object-bulk-job-response-operation-enum
  }
  post-custom-object-bulk-job: func(params: post-custom-object-bulk-job-params) -> result<custom-object-bulk-job-response, post-custom-object-bulk-job-error>;

  /// Retrieve a custom object bulk job
  record get-custom-object-bulk-job-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// The ID of the custom object bulk job to be retrieved.
    id: string
  }
  get-custom-object-bulk-job: func(params: get-custom-object-bulk-job-params) -> result<custom-object-bulk-job-response, get-custom-object-bulk-job-error>;

  /// List all errors for a custom object bulk job
  record get-custom-object-bulk-job-errors-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// The ID of the custom object bulk job that you retrieve errors for.
    id: string
  }
  get-custom-object-bulk-job-errors: func(params: get-custom-object-bulk-job-errors-params) -> result<custom-object-bulk-job-error-response-collection, get-custom-object-bulk-job-errors-error>;

  /// Upload a file for a custom object bulk job
  record post-upload-file-for-custom-object-bulk-job-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// API version that determines the response schema. The default version is used if this parameter is not included. Specify `Zuora-Version` in the request header if you expect a specific response schema.
    zuora-version: option<string>,
    /// The `Content-Type` of the request must be `text/csv`.
    content-type: string,
    /// The ID of the custom object bulk job that the file is uploaded to.
    id: string,
    body: string
  }
  post-upload-file-for-custom-object-bulk-job: func(params: post-upload-file-for-custom-object-bulk-job-params) -> result<string, post-upload-file-for-custom-object-bulk-job-error>;

}

interface data-queries {
  enum get-data-query-jobs-query-status-enum {
    accepted,
    in-progress,
    completed,
    failed,
    cancelled,
  }

  enum submit-data-query-request-compression-enum {
    none,
    gzip,
    zip,
  }

  enum submit-data-query-request-output-target-enum {
    s3,
  }

  enum submit-data-query-request-output-format-enum {
    json,
    csv,
    tsv,
    dsv,
  }

  enum submit-data-query-request-source-data-enum {
    datahub,
    live,
  }

  /// Additional information about the query results.
  record submit-data-query-request-output {
    /// Set this field to `S3`.
    target: submit-data-query-request-output-target-enum
  }

  variant post-data-query-job-error {
    bad-request(string),
    other(string)
  }

  variant get-data-query-job-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-data-query-job-error {
    bad-request(string),
    other(string)
  }

  /// List data query jobs
  record get-data-query-jobs-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Filters the list of query jobs by status.
    query-status: option<get-data-query-jobs-query-status-enum>,
    /// Specifies the maximum number of query jobs to return.
    page-size: option<s32>
  }
  get-data-query-jobs: func(params: get-data-query-jobs-params) -> result<string, string>;

  /// Submit a data query
  record post-data-query-job-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The column separator. Only applicable if the `outputFormat` is `DSV`.
    column-separator: option<string>,
    /// Specifies whether Zuora compresses the query results.
    compression: submit-data-query-request-compression-enum,
    /// Base-64 encoded public key of an RSA key-pair. 
    /// 
    encryption-key: option<string>,
    /// Additional information about the query results.
    output: submit-data-query-request-output,
    /// Specifies the format of the query results.
    /// 
    output-format: submit-data-query-request-output-format-enum,
    /// The query to perform. See [SQL Queries in Data Query](https://knowledgecenter.zuora.com/DC_Developers/BA_Data_Query/BA_SQL_Queries_in_Data_Query) for more information.
    query: string,
    /// Indicates whether the query will retrieve only the deleted record. If `readDeleted` is set to `false` or it is not included in the request body, the query will retrieve only the non-deleted records. If it is set to `true`, only the deleted records will be retrieved.
    /// 
    read-deleted: option<bool>,
    /// Specifiy that data queries run against the live transactional databases at Zuora (Data Query Live), or run against the optimized, replicated database at 12 hours freshness for high volume extraction (Data Query Unlimited).
    /// 
    source-data: option<submit-data-query-request-source-data-enum>,
    /// Indicates whether to use Index Join. Index join is useful when you have a specific reference value in your WHERE clause to index another large table by. See [Use Index Join](https://knowledgecenter.zuora.com/DC_Developers/BA_Data_Query/Best_practices_of_Data_Query#Use_Index_Join) for more information.
    use-index-join: option<bool>
  }
  post-data-query-job: func(params: post-data-query-job-params) -> result<string, post-data-query-job-error>;

  /// Retrieve a data query job
  record get-data-query-job-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Internal identifier of the query job.
    job-id: string
  }
  get-data-query-job: func(params: get-data-query-job-params) -> result<string, get-data-query-job-error>;

  /// Cancel a data query job
  record delete-data-query-job-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Internal identifier of the query job.
    job-id: string
  }
  delete-data-query-job: func(params: delete-data-query-job-params) -> result<string, delete-data-query-job-error>;

}

interface settings {
  enum children-setting-value-request-method-enum {
    get,
    head,
    post,
    put,
    patch,
    delete,
    options,
    trace,
  }

  enum setting-item-with-operations-information-context-enum {
    tenant,
    entity,
    user,
    none,
  }

  record setting-value-request {
    body: option<list<body-in-setting-value-request-entry>>,
    /// An array of requests that can only be executed after its parent request has been executed successfully.
    children: option<list<children-setting-value-request>>,
    /// The id of the request. You can set it to any string. It must be unique within the whole batch.
    id: option<string>,
    /// One of the HTTP methods supported by the setting endpoint, for example, GET,PUT,POST or DELETE.
    method: option<children-setting-value-request-method-enum>,
    /// The relative URL of the setting. It is the same as in the `pathPattern` field in the response body of [Listing all Settings](https://www.zuora.com/developer/api-reference/#operation/GET_ListAllSettings). For example, `/billing-rules`.
    url: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record body-in-setting-value-request-entry {
    key: string,
    value: string
  }

  record children-setting-value-request {
    body: option<list<body-in-setting-value-request-entry-v2>>,
    /// The id of the request. You can set it to any string. It must be unique within the whole batch.
    id: option<string>,
    /// One of the HTTP methods supported by the setting endpoint, for example, GET,PUT,POST or DELETE.
    method: option<children-setting-value-request-method-enum>,
    /// The relative URL of the setting. It is the same as in the `pathPattern` field in the response body of [Listing all settings](https://www.zuora.com/developer/api-reference/#operation/GET_ListAllSettings). For example, `/billing-rules`.
    url: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record body-in-setting-value-request-entry-v2 {
    key: string,
    value: string
  }

  record batch-response {
    responses: option<list<setting-value-response-wrapper>>
  }

  record setting-value-response-wrapper {
    /// The Id of the corresponding request.
    id: option<string>,
    /// The HTTP method. It is the same as that of the corresponding request.
    method: option<children-setting-value-request-method-enum>,
    response: option<setting-value-response>,
    /// The url as specified in the corresponding request.
    url: option<string>
  }

  record setting-value-response {
    body: option<list<body-in-setting-value-reponse-entry>>,
    /// An array of error messages if errors occur when executing the request.
    error-messages: option<list<string>>,
    /// User readable response status, for example, 502 BAD_GATEWAY.
    status: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record body-in-setting-value-reponse-entry {
    key: string,
    value: string
  }

  record list-all-settings-response {
    settings: option<list<setting-item-with-operations-information>>
  }

  record setting-item-with-operations-information {
    /// The context where this setting item is effective.
    context: option<setting-item-with-operations-information-context-enum>,
    /// The description of the setting item as you see from Zuora UI.
    description: option<string>,
    /// An array of HTTP operation methods that are supported on this setting endpoint.
    http-operations: option<list<setting-item-http-operation>>,
    /// The unique key to distinguish the setting item.
    key: option<string>,
    /// The path pattern of the setting endpoint, relative to `/settings`. For example, `/billing-rules`.
    path-pattern: option<string>
  }

  record setting-item-http-operation {
    /// One of the HTTP methods supported by the setting endpoint, for example, GET,PUT,POST or DELETE.
    method: option<children-setting-value-request-method-enum>,
    /// An array of paramters required by this operation.
    parameters: option<list<setting-item-http-request-parameter>>,
    /// JSON Schema for the request body of this operation.
    request-type: option<list<setting-item-http-operation-request-type-entry>>,
    /// JSON Schema for the response body of this operation.
    response-type: option<list<setting-item-http-operation-response-type-entry>>,
    /// The endpoint url of the operation method. For example, `/settings/billing-rules`.
    url: option<string>
  }

  record setting-item-http-request-parameter {
    /// The description of the paramter.
    description: option<string>,
    /// The name of the parameter.
    name: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record setting-item-http-operation-request-type-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record setting-item-http-operation-response-type-entry {
    key: string,
    value: string
  }

  /// Submit settings requests
  record post-process-settings-batch-request-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    requests: option<list<setting-value-request>>
  }
  post-process-settings-batch-request: func(params: post-process-settings-batch-request-params) -> result<batch-response, string>;

  /// List all settings
  record get-list-all-settings-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// Specifies response media type. If you omit the `Accept` header parameter, the response body is by default in JSON format. If you include `Accept` header parameter and set it to `application/csv`, the response body is in csv format.
    accept: option<string>
  }
  get-list-all-settings: func(params: get-list-all-settings-params) -> result<list-all-settings-response, string>;

}

interface accounting-codes {
  enum post-accounting-code-type-type-op-enum {
