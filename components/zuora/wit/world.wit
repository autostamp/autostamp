    target-entity-ids: list<string>
  }
  put-send-user-access-requests: func(params: put-send-user-access-requests-params) -> result<string, string>;

}

interface workflows {
  enum task-action-type-enum {
    approval,
    attachment,
    billing-bill-run,
    billing-currency-conversion,
    billing-custom-invoice,
    callout,
    cancel,
    create,
    custom-object-create,
    custom-object-delete,
    custom-object-query,
    custom-object-update,
    data-billing-preview-run,
    data-link,
    delay,
    delete,
    download-sftp,
    email,
    export-op,
    file-custom-pdf-custom-document,
    if,
    invoice-generate,
    iterate,
    logic-csv-translator,
    logic-case,
    logic-custom-code,
    logic-json-transform,
    logic-lambda,
    logic-response-formatter,
    logic-xml-transform,
    new-product,
    notifications-google-cloud-print,
    notifications-phone-call,
    notifications-sms,
    payment-gateway-reconciliation,
    payment-payment-run,
    query,
    remove-product,
    reporting-report-data,
    reporting-run-report,
    resume,
    suspend,
    ui-page,
    ui-stop,
    update,
    upload-ftp,
    upload-sftp,
    write-off,
  }

  enum task-status-enum {
    queued,
    processing,
    pending,
    success,
    stopped,
    error,
  }

  enum workflow-type-op-enum {
    workflow-setup,
    workflow-instance,
  }

  /// Used to represent the relationship between workflow tasks
  record linkage {
    linkage-type: option<string>,
    /// the task that spawned the target task
    source-task-id: option<s32>,
    /// the workflow the target task is associated with
    source-workflow-id: option<s32>,
    /// the task that the source task is linked to.
    target-task-id: option<s32>
  }

  /// A task.
  record task {
    /// The type of the task.
    action-type: option<task-action-type-enum>,
    /// The type of API used.
    call-type: option<string>,
    /// the number of concurrent tasks that are allowed to run simultaneously
    concurrent-limit: option<s32>,
    /// The data payload for the task.
    data: option<list<task-data-entry>>,
    /// If **Instance** is **true**, the end time of the task instance.
    end-time: option<string>,
    /// If **Instance** is **true** and **status** is **Error**, the error reason of the task instance failure.
    error: option<string>,
    /// If **Instance** is **true** and **status** is **Error**, the error class of the task instance failure.
    error-class: option<string>,
    /// If **Instance** is **true** and **status** is **Error**, the error details of the task instance failure.
    error-details: option<string>,
    /// The unique ID of the task.
    id: option<s32>,
    /// Indicates whether this task belongs to an instance of a workflow.
    instance: option<bool>,
    /// The name of the task.
    name: option<string>,
    /// The selected object for the task.
    object: option<string>,
    /// The id of the selected object of the task.
    object-id: option<string>,
    /// If **Instance** is **true**, the ID of the original task in the original workflow.
    original-task-id: option<s32>,
    /// If **Instance** is **true**, the ID of the original workflow.
    original-workflow-id: option<s32>,
    /// The configuration of the task.
    parameters: option<list<task-parameters-entry>>,
    /// If **Instance** is **true**, the start time of the task instance.
    start-time: option<string>,
    /// If **Instance** is **true**, the status of the task instance.
    status: option<task-status-enum>,
    /// The array of filter tags.
    tags: option<list<string>>,
    /// the id of this task's parent task. Will be null if this is the first task of the workflow
    task-id: option<s32>,
    /// The ID of the workflow that the task belongs to.
    workflow-id: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record task-data-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record task-parameters-entry {
    key: string,
    value: string
  }

  /// A workflow.
  record workflow {
    /// Indicates whether the callout trigger is enabled for the retrieved workflow.
    callout-trigger: option<bool>,
    /// The date and time when the workflow is created, in the `YYYY-MM-DD HH:MM:SS` format.
    created-at: option<string>,
    /// The description of the workflow.
    description: option<string>,
    /// The unique ID of the workflow.
    id: option<s32>,
    /// The schedule of the workflow, in a CRON expression. Returns null if the schedued trigger is disabled.
    interval: option<string>,
    /// The name of the workflow.
    name: option<string>,
    /// Indicates whether the ondemand trigger is enabled for the workflow.
    ondemand-trigger: option<bool>,
    /// Indicates whether the scheduled trigger is enabled for the workflow.
    scheduled-trigger: option<bool>,
    /// The timezone that is configured for the scheduler of the workflow. Returns null if the scheduled trigger is disabled.
    timezone: option<string>,
    /// The type of the workflow. Currently the only valid value is 'Workflow::Setup'.
    type-op: option<workflow-type-op-enum>,
    /// The date and time when the workflow is updated the last time, in the `YYYY-MM-DD HH:MM:SS` format.
    updated-at: option<string>
  }

  /// A task.
  record update-task {
    /// The type of task.
    action-type: option<string>,
    /// The type of the API used.
    call-type: option<string>,
    /// The maximum number of this task that can run concurrently.
    concurrent-limit: option<s32>,
    /// The unique ID of the task.
    id: s32,
    /// The name of the task.
    name: option<string>,
    /// The selected object for the task.
    object: option<string>,
    /// The ID of the selected object of the task.
    object-id: option<string>,
    /// The status of the task instance.
    status: option<task-status-enum>,
    /// The array of filter tags.
    tags: option<list<string>>,
    /// The ID of the workflow the task belongs too.
    workflow-id: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-run-workflow-body-entry {
    key: string,
    value: string
  }

  variant put-workflows-tasks-update-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant patch-update-workflow-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-workflow-error {
    not-found(string),
    other(string)
  }

  variant post-run-workflow-error {
    bad-request(string),
    not-acceptable(string),
    conflict(string),
    other(string)
  }

  /// List workflows
  record get-workflows-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// If set to true, the operation retrieves workflows that have the callout trigger enabled. If set to false, the operation retrieves workflows that have the callout trigger disabled. If not specified, the operation will not use this filter.
    callout-trigger: option<bool>,
    /// A CRON expession that specifies a schedule (for example, `0 0 * * *`). If specified, the operation retrieves the workflow that is run based on the specified schedule.
    interval: option<string>,
    /// If specified, the operation retrieves the workflow that is in the specified name.
    name: option<string>,
    /// If set to true, the operation retrieves workflows that have the ondemand trigger enabled. If set to false, the operation retrieves workflows that have the ondemand trigger disabled. If not specified, the operation will not use this filter.
    ondemand-trigger: option<bool>,
    /// If set to true, the operation retrieves workflows that have the scheduled trigger enabled. If set to false, the operation retrieves workflows that have the scheduled trigger disabled. If not specfied, the operation will not use this filter.
    scheduled-trigger: option<bool>,
    /// If you want to retrieve only the workflows on a specific page, you can specify the `page` number in the query.
    page: option<s32>,
    /// The number of workflows shown in a single call. If the `page` parameter is not specified, the operation will return only the first page of results. If there are multiple pages of results, use it with the `page` parameter to get the results on subsequent pages.
    page-length: option<s32>
  }
  get-workflows: func(params: get-workflows-params) -> result<string, string>;

  /// Import a workflow
  record post-workflow-import-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    linkages: option<list<linkage>>,
    tasks: option<list<task>>,
    workflow: option<workflow>
  }
  post-workflow-import: func(params: post-workflow-import-params) -> result<string, string>;

  /// Retrieve workflow task usage
  record get-workflows-usages-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The start date of the usage data that you want to get. For example, 2019-01-01.
    start-date: string,
    /// The end date of the usage data that you want to get. For example, 2019-12-31.
    end-date: string,
    /// The type of metric that you want to get. Currently, only `taskCount` is supported. `taskCount` is the amount of task runs.
    metrics: string
  }
  get-workflows-usages: func(params: get-workflows-usages-params) -> result<string, string>;

  /// List workflow tasks
  record get-workflows-tasks-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// If specified, the operation retrieves the task that is with specified id.
    id: option<string>,
    /// If specified, the operation retrieves tasks that is in the specified name.
    name: option<string>,
    /// If set to true, the operation retrieves workflows that have the scheduled trigger enabled. If set to false, the operation retrieves workflows that have the scheduled trigger disabled. If not specfied, the operation will not use this filter.
    instance: option<bool>,
    /// If specified, the operation retrieves tasks that is the specified type.
    action-type: option<string>,
    /// If specified, the operation retrieves tasks with the specified object.
    object: option<string>,
    /// If specified, the operation retrieves tasks with the specified object id.
    object-id: option<string>,
    /// If specified, the operation retrieves tasks with the specified api call type used.
    call-type: option<string>,
    /// If specified, the operation retrieves tasks that for the specified workflow id.
    workflow-id: option<string>,
    /// If specified, the operation retrieves tasks that with the specified filter tags.
    tags: option<string>,
    /// If you want to retrieve only the workflows on a specific page, you can specify the `page` number in the query.
    page: option<s32>,
    /// The number of workflows shown in a single call. If the `page` parameter is not specified, the operation will return only the first page of results. If there are multiple pages of results, use it with the `page` parameter to get the results on subsequent pages.
    page-length: option<s32>
  }
  get-workflows-tasks: func(params: get-workflows-tasks-params) -> result<string, string>;

  /// Update workflow tasks
  record put-workflows-tasks-update-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The list of tasks to update.
    data: option<list<update-task>>
  }
  put-workflows-tasks-update: func(params: put-workflows-tasks-update-params) -> result<string, put-workflows-tasks-update-error>;

  /// Retrieve a workflow task
  record get-workflows-task-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The unique ID of the task.
    task-id: string
  }
  get-workflows-task: func(params: get-workflows-task-params) -> result<string, string>;

  /// Rerun a workflow task
  record post-workflows-task-rerun-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The unique ID of the task.
    task-id: string
  }
  post-workflows-task-rerun: func(params: post-workflows-task-rerun-params) -> result<string, string>;

  /// Retrieve a workflow
  record get-workflow-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The unique ID of a workflow. For example, 19080.
    workflow-id: string
  }
  get-workflow: func(params: get-workflow-params) -> result<string, string>;

  /// Update a workflow definition
  record patch-update-workflow-params {
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// The unique ID of a workflow. For example, 19080.
    workflow-id: string,
    /// If true, the workflow will run upon an API callout. This field must be `true` for integrating with the Configurable Payment Retry feature or the Collections Window feature in Collect.
    callout-trigger: option<bool>,
    /// The description of the workflow defintion
    description: option<string>,
    /// The cron expression for workflows with scheduled_trigger as `true`
    interval: option<string>,
    /// The name of the workflow definition
    name: option<string>,
    /// If true, the workflow will run when manually initiated.
    ondemand-trigger: option<bool>,
    /// Can be `High`, `Medium`, or `Low`. Higher-priority workflows take precedence over lower-priority workflows. When a workflow of higher priority is initiated, it will be placed ahead of lower-priority workflows that are running. Depending on the available resources, lower-priority workflows may be paused until resources are released.
    priority: option<string>,
    /// If true, the workflow will run based on the configured schedule with the interval field.
    scheduled-trigger: option<bool>,
    /// Can be `Active` or `Inactive`. Active workfow definitions run like normal. Inactive workflow definitions cannot be run.
    status: option<string>,
    /// The timezone that corresponds with the cron expression in the interval field. See the [list of accepted timezone values](https://docs.google.com/spreadsheets/d/1skhepi-q5l9LyaMUPZjU_V9gzTphNMqNyV6ST5mygEo/edit?usp=sharing).
    timezone: option<string>
  }
  patch-update-workflow: func(params: patch-update-workflow-params) -> result<string, patch-update-workflow-error>;

  /// Delete a workflow
  record delete-workflow-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The unique ID of a workflow. For example, 19080.
    workflow-id: string
  }
  delete-workflow: func(params: delete-workflow-params) -> result<string, delete-workflow-error>;

  /// Export a workflow
  record get-workflow-export-params {
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The ID of the workflow to export.
    workflow-id: string
  }
  get-workflow-export: func(params: get-workflow-export-params) -> result<string, string>;

  /// Run a workflow
  record post-run-workflow-params {
    /// `Bearer {token}` for a valid OAuth token.
    authorization: string,
    /// An entity ID. If you have [Zuora Multi-entity](https://knowledgecenter.zuora.com/BB_Introducing_Z_Business/Multi-entity) enabled and the OAuth token is valid for more than one entity, you must use this header to specify which entity to perform the operation in. If the OAuth token is only valid for a single entity, or you do not have Zuora Multi-entity enabled, you do not need to set this header.
    zuora-entity-ids: option<string>,
    /// A custom identifier for tracing the API call. If you set a value for this header, Zuora returns the same value in the response headers. This header enables you to associate your system process identifiers with Zuora API calls, to assist with troubleshooting in the event of an issue.
    /// 
    zuora-track-id: option<string>,
    /// The ID of the workflow you want to run.
    workflow-id: string,
    body: option<list<post-run-workflow-body-entry>>
  }
  post-run-workflow: func(params: post-run-workflow-params) -> result<string, post-run-workflow-error>;

}
