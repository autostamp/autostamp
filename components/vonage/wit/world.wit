/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `bearerAuth` | `Authorization: Bearer <secret>` |
package autostamp:vonage@0.3.0;

interface api {
  /// Get account data by ID
  record account-ctrl-get-account-services-by-account-id-params {
    /// The Vonage Business Cloud account ID
    account-id: string
  }
  account-ctrl-get-account-services-by-account-id: func(params: account-ctrl-get-account-services-by-account-id-params) -> result<string, string>;

  /// Get account locations data by account ID
  record account-ctrl-get-locations-by-account-id-params {
    /// The Vonage Business Cloud account ID
    account-id: string
  }
  account-ctrl-get-locations-by-account-id: func(params: account-ctrl-get-locations-by-account-id-params) -> result<string, string>;

  /// Get location data by account ID and location ID
  record account-ctrl-get-location-by-id-params {
    /// The Vonage Business Cloud account ID
    account-id: string,
    /// The Vonage Business Cloud location ID
    location-id: string
  }
  account-ctrl-get-location-by-id: func(params: account-ctrl-get-location-by-id-params) -> result<string, string>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export api;
}
