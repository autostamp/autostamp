    data: option<list<string>>
  }

  record user-ratings-data-no-links {
    data: option<list<user-ratings>>
  }

  variant get-user-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-user-favorites-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant put-user-favorites-id-error {
    unauthorized(string),
    not-found(string),
