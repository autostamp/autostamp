    other(string)
  }

  variant delete-user-favorites-id-error {
    unauthorized(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-user-ratings-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-user-ratings-query-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-user-ratings-query-params-v2-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-user-ratings-item-type-item-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant put-user-ratings-item-type-item-id-item-rating-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  get-user: func() -> result<user-data, get-user-error>;

  get-user-favorites: func() -> result<user-favorites-data, get-user-favorites-error>;

  record put-user-favorites-id-params {
    /// ID of the series
    id: string
  }
  put-user-favorites-id: func(params: put-user-favorites-id-params) -> result<user-favorites-data, put-user-favorites-id-error>;

  record delete-user-favorites-id-params {
    /// ID of the series
    id: string
  }
  delete-user-favorites-id: func(params: delete-user-favorites-id-params) -> result<user-favorites-data, delete-user-favorites-id-error>;

  get-user-ratings: func() -> result<user-ratings-data, get-user-ratings-error>;

  record get-user-ratings-query-params {
    /// Item to query. Can be either 'series', 'episode', or 'banner'
    item-type: option<string>
  }
  get-user-ratings-query: func(params: get-user-ratings-query-params) -> result<user-ratings-data, get-user-ratings-query-error>;

  get-user-ratings-query-params-v2: func() -> result<user-ratings-query-params, get-user-ratings-query-params-v2-error>;

  record delete-user-ratings-item-type-item-id-params {
    /// Item to update. Can be either 'series', 'episode', or 'image'
    item-type: string,
    /// ID of the ratings record that you wish to modify
    item-id: string
  }
  delete-user-ratings-item-type-item-id: func(params: delete-user-ratings-item-type-item-id-params) -> result<user-ratings-data-no-links-empty-array, delete-user-ratings-item-type-item-id-error>;

  record put-user-ratings-item-type-item-id-item-rating-params {
    /// Item to update. Can be either 'series', 'episode', or 'image'
    item-type: string,
    /// ID of the ratings record that you wish to modify
    item-id: string,
    /// The updated rating number
    item-rating: string
  }
  put-user-ratings-item-type-item-id-item-rating: func(params: put-user-ratings-item-type-item-id-item-rating-params) -> result<user-ratings-data-no-links, put-user-ratings-item-type-item-id-item-rating-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export episodes;
  export languages;
  export authentication;
  export movies;
  export search;
  export series;
  export updates;
  export users;
}
