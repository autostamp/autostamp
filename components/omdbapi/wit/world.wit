package autostamp:omdbapi@0.6.0;

interface om-db {
  enum get-om-db-search-type-op-enum {
    movie,
    series,
    episode,
  }

  enum get-om-db-search-plot-enum {
    short,
    full,
  }

  enum get-om-db-search-r-enum {
    json,
    xml,
  }

  record combined-result {
    actors: option<string>,
    awards: option<string>,
    box-office: option<string>,
    country: option<string>,
    dvd: option<string>,
    director: option<string>,
    genre: option<string>,
    language: option<string>,
    metascore: option<string>,
    plot: option<string>,
    poster: option<string>,
    production: option<string>,
    rated: option<string>,
    released: option<string>,
    response: string,
    runtime: option<string>,
    search: option<list<combined-result-search-item>>,
    title: option<string>,
    type-op: option<string>,
    website: option<string>,
    writer: option<string>,
    year: option<string>,
    imdb-id: option<string>,
    imdb-rating: option<string>,
    imdb-votes: option<string>,
    tomato-consensus: option<string>,
    tomato-fresh: option<string>,
    tomato-image: option<string>,
    tomato-meter: option<string>,
    tomato-rating: option<string>,
    tomato-reviews: option<string>,
    tomato-rotten: option<string>,
    tomato-url: option<string>,
    tomato-user-meter: option<string>,
    tomato-user-rating: option<string>,
    tomato-user-reviews: option<string>,
    total-results: option<string>,
    total-seasons: option<string>
  }

  record combined-result-search-item {
    poster: string,
    title: string,
    type-op: string,
    year: string,
    imdb-id: string
  }

  /// OMDb Search
  record get-om-db-search-params {
    /// Movie title to search for. One of t, i or s is required.
    t: option<string>,
    /// A valid IMDb ID (e.g. tt1285016). One of t, i or s is required.
    i: option<string>,
    /// Movie title to search for. One of t, i or s is required.
    s: option<string>,
    /// Year of release.
    y: option<s32>,
    /// Type of result to return.
    type-op: option<get-om-db-search-type-op-enum>,
    /// Return short or full plot.
    plot: option<get-om-db-search-plot-enum>,
    /// Include Rotten Tomatoes ratings.
    tomatoes: option<bool>,
    /// The data type to return.
    r: get-om-db-search-r-enum,
    /// API version (reserved for future use).
    v: option<s32>,
    /// Page number to return.
    page: option<s32>,
    /// JSONP callback name.
    callback: option<string>
  }
  get-om-db-search: func(params: get-om-db-search-params) -> result<combined-result, string>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export om-db;
}
