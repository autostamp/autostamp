/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `cookieAuth` | header `portal` |
package autostamp:interactivebrokers@0.2.1;

interface account-portfolio {
  /// Brokerage Accounts
  record get-accounts-params {
    /// Account Number
    account: string
  }
  get-accounts: func(params: get-accounts-params) -> result<string, string>;

  /// Account Positions
  record get-accounts-account-positions-params {
    /// Account Number
    account: string
  }
  get-accounts-account-positions: func(params: get-accounts-account-positions-params) -> result<string, string>;

  /// Account Values Summary
  record get-accounts-account-summary-params {
    /// Account Number
    account: string
  }
  get-accounts-account-summary: func(params: get-accounts-account-summary-params) -> result<string, string>;

}


interface order-margin-requirements {
  /// Market = '1'
  /// Limit = '2'
  /// Stop = '3'
  /// StopLimit = '4'
  record order-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Defines order's active lifetime.
  /// Day = '0'
  /// GTC (Good till Cancel) = '1'
  /// IOC (Immediate or Cancel) = '3'
  /// Open = '2'
  /// Close = '7'
  record time-in-force {
    /// opaque schema; raw JSON
    value: string
  }

  /// Return margin impact info
  record post-accounts-account-order-impact-params {
    /// Required price to support Stop and Stop Limit orders
    aux-price: option<f64>,
    /// The internal IB identifier for the trading product specified as an integer (can be obtained in response to /secdef request)
    contract-id: option<f64>,
    /// The currency in which the FX pair trades (only for InstrumentType=CASH)
    currency: option<string>,
    /// The order ID assigned by the customer.
    customer-order-id: option<string>,
    /// The instrument type of the contract
    instrument-type: option<string>,
    /// The exchange on which the trading product is listed (only for InstrumentType=STK)
    listing-exchange: option<string>,
    order-type: option<order-type>,
    /// The order price
    price: option<f64>,
    /// The number of units in the order; contracts or shares
    quantity: option<f64>,
    /// Buy = '1', Sell = '2'
    side: option<f64>,
    /// The symbol that identifies the trading product
    ticker: option<string>,
    time-in-force: option<time-in-force>
  }
  post-accounts-account-order-impact: func(params: post-accounts-account-order-impact-params) -> result<string, string>;

}

interface orders {
  /// Market = '1'
  /// Limit = '2'
  /// Stop = '3'
  /// StopLimit = '4'
  record order-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Defines order's active lifetime.
  /// Day = '0'
  /// GTC (Good till Cancel) = '1'
  /// IOC (Immediate or Cancel) = '3'
  /// Open = '2'
  /// Close = '7'
  record time-in-force {
    /// opaque schema; raw JSON
    value: string
  }

  /// Open Orders
  get-accounts-account-orders: func() -> result<string, string>;

  /// Place Order
  record post-accounts-account-orders-params {
    /// Required Price to support Stop and Stop Limit orders
    aux-price: option<f64>,
    /// The internal IB identifier for the trading product specified as an integer (can be obtained in response to /secdef request)
    contract-id: option<f64>,
    /// The currency in which the FX pair trades (only for InstrumentType=CASH)
    currency: option<string>,
    /// The order ID assigned by the customer.
    customer-order-id: option<string>,
    /// By setting this bool to false the customer attests that the order is not subject to German HFT Act, was not generated using any automated algorithm, and no algorithm determined or changed financial instrument, side, quantity, order type, limit or other price, trading venue or timing of this order. Currently we cannot accept orders where this flag is set to true. Such orders will be rejected.
    german-hft-algo: option<bool>,
    /// The instrument type of the contract
    instrument-type: option<string>,
    /// The exchange on which the trading product is listed (only for InstrumentType=STK)
    listing-exchange: option<string>,
    /// This field permits specification of the user's preregistered (via account management) MiFID II short code for algos that are responsible for investment decisions
    mifid2-algo: option<string>,
    /// This field permits specification of the user's preregistered (via account management) MiFID II short code for decision makers.
    mifid2-decision-maker: option<string>,
    /// This field permits specification of the user's preregistered (via account management) MiFID II short code for algos that are responsible for handling/routing of the order.
    mifid2-execution-algo: option<string>,
    /// This field permits specification of the user's preregistered (via account management) MiFID II person responsible for handling/routing of the order
    mifid2-execution-trader: option<string>,
    order-type: option<order-type>,
    /// MultiValueString representing the restrictions associated with
    /// an order. If more than one restriction is applicable to an
    order-restrictions: option<f64>,
    /// Indicates if order is active outside regular trading hours, where defined. 0 = no (default), 1 = yes
    outside-rth: option<f64>,
    /// The order price
    price: option<f64>,
    /// The number of units in the order; contracts or shares
    quantity: option<f64>,
    /// Buy = '1', Sell = '2'
    side: option<f64>,
    /// The symbol that identifies the trading product
    ticker: option<string>,
    time-in-force: option<time-in-force>
  }
  post-accounts-account-orders: func(params: post-accounts-account-orders-params) -> result<string, string>;

  /// Return specific order info
  get-accounts-account-orders-customer-order-id: func() -> result<string, string>;

  /// Modify Order
  record put-accounts-account-orders-customer-order-id-params {
    /// Required Price to support Stop and Stop Limit orders
    aux-price: option<f64>,
    /// The new order ID assigned by the customer for the modification.
    customer-order-id: option<string>,
    /// By setting this bool to false the customer attests that the order is not subject to German HFT Act, was not generated using any automated algorithm, and no algorithm determined or changed financial instrument, side, quantity, order type, limit or other price, trading venue or timing of this order. Currently we cannot accept orders where this flag is set to true. Such orders will be rejected.
    german-hft-algo: option<bool>,
    /// This field permits specification of the user's preregistered (via account management) MiFID II short code for algos that are responsible for investment decisions
    mifid2-algo: option<string>,
    /// This field permits specification of the user's preregistered (via account management) MiFID II short code for decision makers.
    mifid2-decision-maker: option<string>,
    /// This field permits specification of the user's preregistered (via account management) MiFID II short code for algos that are responsible for handling/routing of the order.
    mifid2-execution-algo: option<string>,
    /// This field permits specification of the user's preregistered (via account management) MiFID II person responsible for handling/routing of the order
    mifid2-execution-trader: option<string>,
    order-type: option<order-type>,
    /// The order ID assigned by the customer
    orig-customer-order-id: option<string>,
    /// Indicates if order is active outside regular trading hours, where defined. 0 = no (default), 1 = yes
    outside-rth: option<f64>,
    /// The order price
    price: option<f64>,
    /// The number of units in the order; contracts or shares
    quantity: option<f64>,
    /// Buy = '1', Sell = '2'
    side: option<f64>,
    time-in-force: option<time-in-force>
  }
  put-accounts-account-orders-customer-order-id: func(params: put-accounts-account-orders-customer-order-id-params) -> result<string, string>;

  /// Cancel Order
  delete-accounts-account-orders-customer-order-id: func() -> result<string, string>;

}

interface trades {
  /// Returns trades in account
  record get-accounts-account-trades-params {
    body: option<string>
  }
  get-accounts-account-trades: func(params: get-accounts-account-trades-params) -> result<string, string>;

}

interface market-data {
  record get-marketdata-snapshot-body-item {
    /// The internal IB identifier for the trading product specified as an integer.
    conid: option<f64>,
    /// The currency in which the given pair trades.
    currency: option<string>,
    /// The exchange on which the trading product is listed (required for type=STK).
    exchange: option<string>,
    /// The symbol that identifies the trading product.
    symbol: option<string>,
    /// The instrument type of the contract (CASH).
    type-op: option<string>
  }

  /// Exchange Components
  get-marketdata-exchange-components: func() -> result<string, string>;

  /// Market Data Snapshot
  record get-marketdata-snapshot-params {
    body: list<get-marketdata-snapshot-body-item>
  }
  get-marketdata-snapshot: func(params: get-marketdata-snapshot-params) -> result<string, string>;

}

interface o-auth {
  /// Obtain a access token
  record post-oauth-access-token-params {
    /// The 25-character hexadecimal string that was obtained from Interactive Brokers during the OAuth consumer registration process.
    oauth-consumer-key: option<string>,
    /// A random string uniquely generated for each request.
    oauth-nonce: option<string>,
    /// The signature for the request generated using the method specified in the oauth_signature_method parameter. See section 9 of the OAuth v1.0a specification for more details on signing requests.
    oauth-signature: option<string>,
    /// The signature method used to sign the request. Currently only 'RSA-SHA256' is supported.
    oauth-signature-method: option<string>,
    /// Timestamp expressed in seconds since 1/1/1970 00:00:00 GMT. Must be a positive integer and greater than or equal to any timestamp used in previous requests.
    oauth-timestamp: option<string>,
    /// The request token obtained from IB via /request_token.
    oauth-token: option<string>,
    /// The verification code received from IB after the user has granted authorization.
    oauth-verifier: option<string>
  }
  post-oauth-access-token: func(params: post-oauth-access-token-params) -> result<string, string>;

  /// Obtain a live session token
  record post-oauth-live-session-token-params {
    /// Challenge value calculated using the Diffie-Hellman prime and generated provided during the registration process. See the "OAuth at Interactive Brokers" document for more details. 
    diffie-hellman-challenge: option<string>,
    /// The 25-character hexadecimal string that was obtained from Interactive Brokers during the OAuth consumer registration process.
    oauth-consumer-key: option<string>,
    /// A random string uniquely generated for each request.
    oauth-nonce: option<string>,
    /// The signature for the request generated using the method specified in the oauth_signature_method parameter. See section 9 of the OAuth v1.0a specification for more details on signing requests.
    oauth-signature: option<string>,
    /// The signature method used to sign the request. Currently only 'RSA-SHA256' is supported.
    oauth-signature-method: option<string>,
    /// Timestamp expressed in seconds since 1/1/1970 00:00:00 GMT. Must be a positive integer and greater than or equal to any timestamp used in previous requests.
    oauth-timestamp: option<string>,
    /// The request token obtained from IB via /request_token.
    oauth-token: option<string>
  }
  post-oauth-live-session-token: func(params: post-oauth-live-session-token-params) -> result<string, string>;

  /// Obtain a request token
  record post-oauth-request-token-params {
    /// An absolute URL to which IB will redirect the user. This URL is provided by the consumer during registration. This parameter must be set to 'oob'.  
    oauth-callback: option<string>,
    /// The 25-character hexadecimal string that was obtained from Interactive Brokers during the OAuth consumer registration process.
    oauth-consumer-key: option<string>,
    /// A random string uniquely generated for each request.
    oauth-nonce: option<string>,
    /// The signature for the request generated using the method specified in the oauth_signature_method parameter. See section 9 of the OAuth v1.0a specification for more details on signing requests.
    oauth-signature: option<string>,
    /// The signature method used to sign the request. Currently only 'RSA-SHA256' is supported.
    oauth-signature-method: option<string>,
    /// Timestamp expressed in seconds since 1/1/1970 00:00:00 GMT. Must be a positive integer and greater than or equal to any timestamp used in previous requests.
    oauth-timestamp: option<string>
  }
  post-oauth-request-token: func(params: post-oauth-request-token-params) -> result<string, string>;

}

interface financial-instrument-definitions {
  /// Get security definition
  record get-secdef-params {
    /// The internal IB identifier for the trading product specified as an integer.
    conid: option<f64>,
    /// The currency in which the given pair trades.
    currency: option<string>,
    /// The exchange on which the trading product is listed (required for type=STK).
    exchange: option<string>,
    /// The symbol that identifies the trading product.
    symbol: option<string>,
    /// The instrument type of the contract (CASH).
    type-op: option<string>
  }
  get-secdef: func(params: get-secdef-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export account-portfolio;
  export order-margin-requirements;
  export orders;
  export trades;
  export market-data;
  export o-auth;
  export financial-instrument-definitions;
}
