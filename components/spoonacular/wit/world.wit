  }
  get-recipe-information: func(params: get-recipe-information-params) -> result<string, string>;

  /// Ingredients by ID Widget
  record visualize-recipe-ingredients-by-id-params {
    /// The recipe id.
    id: string,
    /// Whether the default CSS should be added to the response.
