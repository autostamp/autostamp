    include-nutrition: option<bool>
  }
  get-recipe-information-bulk: func(params: get-recipe-information-bulk-params) -> result<string, string>;

  /// Parse Ingredients
  record parse-ingredients-params {
    /// The content type.
    content-type: option<analyze-recipe-instructions-content-type-enum>,
    /// The language of the input. Either 'en' or 'de'.
    language: option<compute-glycemic-load-language-enum>
  }
  parse-ingredients: func(params: parse-ingredients-params) -> result<string, string>;

