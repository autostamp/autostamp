interface products {
  enum classify-grocery-product-locale-enum {
    en-us,
    en-gb,
  }

  enum visualize-product-nutrition-by-id-accept-enum {
    application-json,
    text-html,
    media,
  }

  record classify-grocery-product-bulk-body-item {
    plu-code: string,
    title: string,
    upc: string
  }

  /// Classify Grocery Product
  record classify-grocery-product-params {
    /// The display name of the returned category, supported is en_US (for American English) and en_GB (for British English).
    locale: option<classify-grocery-product-locale-enum>,
    plu-code: string,
    title: string,
    upc: string
  }
  classify-grocery-product: func(params: classify-grocery-product-params) -> result<string, string>;

  /// Classify Grocery Product Bulk
  record classify-grocery-product-bulk-params {
    /// The display name of the returned category, supported is en_US (for American English) and en_GB (for British English).
    locale: option<string>,
    body: list<classify-grocery-product-bulk-body-item>
  }
  classify-grocery-product-bulk: func(params: classify-grocery-product-bulk-params) -> result<string, string>;

  /// Search Grocery Products
  record search-grocery-products-params {
    /// The (natural language) search query.
    query: option<string>,
    /// The minimum amount of calories the product must have.
    min-calories: option<f64>,
    /// The maximum amount of calories the product can have.
    max-calories: option<f64>,
    /// The minimum amount of carbohydrates in grams the product must have.
    min-carbs: option<f64>,
    /// The maximum amount of carbohydrates in grams the product can have.
    max-carbs: option<f64>,
    /// The minimum amount of protein in grams the product must have.
    min-protein: option<f64>,
    /// The maximum amount of protein in grams the product can have.
    max-protein: option<f64>,
    /// The minimum amount of fat in grams the product must have.
    min-fat: option<f64>,
    /// The maximum amount of fat in grams the product can have.
    max-fat: option<f64>,
    /// If set to true, you get more information about the products returned.
    add-product-information: option<bool>,
    /// The number of results to skip (between 0 and 900).
    offset: option<s32>,
    /// The maximum number of items to return (between 1 and 100). Defaults to 10.
    number: option<s32>
  }
  search-grocery-products: func(params: search-grocery-products-params) -> result<string, string>;

  /// Autocomplete Product Search
  record autocomplete-product-search-params {
    /// The (partial) search query.
    query: string,
    /// The number of results to return (between 1 and 25).
    number: option<s32>
  }
  autocomplete-product-search: func(params: autocomplete-product-search-params) -> result<string, string>;

  /// Search Grocery Products by UPC
  record search-grocery-products-by-upc-params {
    /// The product's UPC.
    upc: string
  }
  search-grocery-products-by-upc: func(params: search-grocery-products-by-upc-params) -> result<string, string>;

  /// Get Comparable Products
  record get-comparable-products-params {
    /// The UPC of the product for which you want to find comparable products.
    upc: string
  }
  get-comparable-products: func(params: get-comparable-products-params) -> result<string, string>;

  /// Get Product Information
  record get-product-information-params {
    /// The id of the packaged food.
    id: string
  }
  get-product-information: func(params: get-product-information-params) -> result<string, string>;

  /// Product Nutrition Label Widget
  record product-nutrition-label-widget-params {
    /// The product id.
    id: string,
    /// Whether the default CSS should be added to the response.
    default-css: option<bool>,
    /// Whether to show optional nutrients.
    show-optional-nutrients: option<bool>,
    /// Whether to show zero values.
    show-zero-values: option<bool>,
    /// Whether to show a list of ingredients.
    show-ingredients: option<bool>
  }
  product-nutrition-label-widget: func(params: product-nutrition-label-widget-params) -> result<string, string>;

  /// Product Nutrition Label Image
  record product-nutrition-label-image-params {
    /// The product id.
    id: string,
    /// Whether to show optional nutrients.
    show-optional-nutrients: option<bool>,
    /// Whether to show zero values.
    show-zero-values: option<bool>,
    /// Whether to show a list of ingredients.
    show-ingredients: option<bool>
  }
  product-nutrition-label-image: func(params: product-nutrition-label-image-params) -> result<string, string>;

  /// Product Nutrition by ID Widget
  record visualize-product-nutrition-by-id-params {
    /// The id of the product.
    id: string,
    /// Whether the default CSS should be added to the response.
    default-css: option<bool>,
    /// Accept header.
    accept: option<visualize-product-nutrition-by-id-accept-enum>
  }
  visualize-product-nutrition-by-id: func(params: visualize-product-nutrition-by-id-params) -> result<string, string>;

  /// Product Nutrition by ID Image
  record product-nutrition-by-id-image-params {
    /// The id of the product.
    id: string
  }
  product-nutrition-by-id-image: func(params: product-nutrition-by-id-image-params) -> result<string, string>;

}

interface food {
  /// Search Restaurants
  record search-restaurants-params {
    /// The search query.
    query: option<string>,
    /// The latitude of the user's location.
    lat: option<f64>,
    /// The longitude of the user's location.".
    lng: option<f64>,
    /// The distance around the location in miles.
    distance: option<f64>,
    /// The user's budget for a meal in USD.
    budget: option<f64>,
    /// The cuisine of the restaurant.
    cuisine: option<string>,
    /// The minimum rating of the restaurant between 0 and 5.
    min-rating: option<f64>,
    /// Whether the restaurant must be open at the time of search.
    is-open: option<bool>,
    /// How to sort the results, one of the following 'cheapest', 'fastest', 'rating', 'distance' or the default 'relevance'.
    sort: option<string>,
    /// The page number of results.
    page: option<f64>
  }
  search-restaurants: func(params: search-restaurants-params) -> result<string, string>;

}

interface wine {
  /// Wine Description
  record get-wine-description-params {
    /// The name of the wine that should be paired, e.g. "merlot", "riesling", or "malbec".
    wine: string
  }
  get-wine-description: func(params: get-wine-description-params) -> result<string, string>;

  /// Dish Pairing for Wine
  record get-dish-pairing-for-wine-params {
    /// The type of wine that should be paired, e.g. "merlot", "riesling", or "malbec".
    wine: string
  }
  get-dish-pairing-for-wine: func(params: get-dish-pairing-for-wine-params) -> result<string, string>;

  /// Wine Pairing
  record get-wine-pairing-params {
    /// The food to get a pairing for. This can be a dish ("steak"), an ingredient ("salmon"), or a cuisine ("italian").
    food: string,
    /// The maximum price for the specific wine recommendation in USD.
    max-price: option<f64>
  }
  get-wine-pairing: func(params: get-wine-pairing-params) -> result<string, string>;

  /// Wine Recommendation
  record get-wine-recommendation-params {
    /// The type of wine to get a specific product recommendation for.
    wine: string,
    /// The maximum price for the specific wine recommendation in USD.
    max-price: option<f64>,
    /// The minimum rating of the recommended wine between 0 and 1. For example, 0.8 equals 4 out of 5 stars.
    min-rating: option<f64>,
    /// The number of wine recommendations expected (between 1 and 100).
    number: option<f64>
  }
  get-wine-recommendation: func(params: get-wine-recommendation-params) -> result<string, string>;

}

interface meal-planning {
  record add-to-meal-plan-body-value {
    ingredients: list<add-to-meal-plan-body-value-ingredients-item>
  }

  record add-to-meal-plan-body-value-ingredients-item {
    name: string
  }

  /// Generate Meal Plan
  record generate-meal-plan-params {
    /// Either for one "day" or an entire "week".
    time-frame: option<string>,
    /// What is the caloric target for one day? The meal plan generator will try to get as close as possible to that goal.
    target-calories: option<f64>,
    /// Enter a diet that the meal plan has to adhere to. See a full list of supported diets.
    diet: option<string>,
    /// A comma-separated list of allergens or ingredients that must be excluded.
    exclude: option<string>
  }
  generate-meal-plan: func(params: generate-meal-plan-params) -> result<string, string>;

  /// Clear Meal Plan Day
  record clear-meal-plan-day-params {
    /// The username.
    username: string,
    /// The date in the format yyyy-mm-dd.
    date: string,
    /// The private hash for the username.
    hash: string
  }
  clear-meal-plan-day: func(params: clear-meal-plan-day-params) -> result<string, string>;

  /// Add to Meal Plan
  record add-to-meal-plan-params {
    /// The username.
    username: string,
    /// The private hash for the username.
    hash: string,
    date: f64,
    position: s32,
    slot: s32,
    type-op: string,
    value: add-to-meal-plan-body-value
  }
  add-to-meal-plan: func(params: add-to-meal-plan-params) -> result<string, string>;

  /// Delete from Meal Plan
  record delete-from-meal-plan-params {
    /// The username.
    username: string,
    /// The shopping list item id.
    id: string,
    /// The private hash for the username.
    hash: string
  }
  delete-from-meal-plan: func(params: delete-from-meal-plan-params) -> result<string, string>;

  /// Get Shopping List
  record get-shopping-list-params {
    /// The username.
    username: string,
    /// The private hash for the username.
    hash: string
  }
  get-shopping-list: func(params: get-shopping-list-params) -> result<string, string>;

  /// Add to Shopping List
  record add-to-shopping-list-params {
    /// The username.
    username: string,
    /// The private hash for the username.
    hash: string,
    aisle: string,
    item: string,
    parse: bool
  }
  add-to-shopping-list: func(params: add-to-shopping-list-params) -> result<string, string>;

  /// Delete from Shopping List
  record delete-from-shopping-list-params {
    /// The username.
    username: string,
    /// The shopping list item id.
    id: string,
    /// The private hash for the username.
    hash: string
  }
  delete-from-shopping-list: func(params: delete-from-shopping-list-params) -> result<string, string>;

  /// Generate Shopping List
  record generate-shopping-list-params {
    /// The username.
    username: string,
    /// The start date in the format yyyy-mm-dd.
    start-date: string,
    /// The end date in the format yyyy-mm-dd.
    end-date: string,
    /// The private hash for the username.
    hash: string
  }
  generate-shopping-list: func(params: generate-shopping-list-params) -> result<string, string>;

  /// Get Meal Plan Templates
  record get-meal-plan-templates-params {
    /// The username.
    username: string,
    /// The private hash for the username.
    hash: string
  }
  get-meal-plan-templates: func(params: get-meal-plan-templates-params) -> result<string, string>;

  /// Add Meal Plan Template
  record add-meal-plan-template-params {
    /// The username.
    username: string,
    /// The private hash for the username.
    hash: string
  }
  add-meal-plan-template: func(params: add-meal-plan-template-params) -> result<string, string>;

  /// Get Meal Plan Template
  record get-meal-plan-template-params {
    /// The username.
    username: string,
    /// The shopping list item id.
    id: string,
    /// The private hash for the username.
    hash: string
  }
  get-meal-plan-template: func(params: get-meal-plan-template-params) -> result<string, string>;

  /// Delete Meal Plan Template
  record delete-meal-plan-template-params {
    /// The username.
    username: string,
    /// The shopping list item id.
    id: string,
    /// The private hash for the username.
    hash: string
  }
  delete-meal-plan-template: func(params: delete-meal-plan-template-params) -> result<string, string>;

  /// Get Meal Plan Week
  record get-meal-plan-week-params {
    /// The username.
    username: string,
    /// The start date of the meal planned week in the format yyyy-mm-dd.
    start-date: string,
    /// The private hash for the username.
    hash: string
  }
  get-meal-plan-week: func(params: get-meal-plan-week-params) -> result<string, string>;

  /// Connect User
  record connect-user-params {
    email: string,
    first-name: string,
    last-name: string,
    username: string
  }
  connect-user: func(params: connect-user-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export misc;
  export ingredients;
  export recipes;
  export menu-items;
  export products;
  export food;
  export wine;
  export meal-planning;
}
