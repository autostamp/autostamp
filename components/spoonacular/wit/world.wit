  }
  get-menu-item-information: func(params: get-menu-item-information-params) -> result<string, string>;

  /// Menu Item Nutrition Label Widget
  record menu-item-nutrition-label-widget-params {
    /// The menu item id.
    id: string,
    /// Whether the default CSS should be added to the response.
    default-css: option<bool>,
    /// Whether to show optional nutrients.
    show-optional-nutrients: option<bool>,
    /// Whether to show zero values.
    show-zero-values: option<bool>,
    /// Whether to show a list of ingredients.
    show-ingredients: option<bool>
  }
  menu-item-nutrition-label-widget: func(params: menu-item-nutrition-label-widget-params) -> result<string, string>;

  /// Menu Item Nutrition Label Image
  record menu-item-nutrition-label-image-params {
    /// The menu item id.
    id: string,
    /// Whether to show optional nutrients.
    show-optional-nutrients: option<bool>,
    /// Whether to show zero values.
