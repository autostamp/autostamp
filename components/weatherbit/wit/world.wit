/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export alerts;
  export bulk-downloads;
  export current-air-quality;
  export current-weather-data;
  export air-quality-forecast;
  export v16-day-daily-forecast;
  export forecast-degree-day-api;
  export v240-hour-hourly-forecast;
  export historical-air-quality;
  export daily-historical-weather-data;
  export historical-degree-day-api;
  export hourly-historical-weather-data;
  export sub-hourly-historical-weather-data;
}
