/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `key` | query `key` |
package autostamp:weatherbit@0.6.0;

interface alerts {
  record weather-alert {
    alerts: option<list<weather-alert-group>>,
    /// Latitude
    lat: option<f64>,
    /// Longitude
    lon: option<f64>
  }

  record weather-alert-group {
    alerts: option<list<string>>,
    /// Full description of weather alert
    description: option<string>,
    /// Issued time local
    effective-local: option<string>,
    /// Issued time UTC
    effective-utc: option<string>,
    /// Expiration time local
    expires-local: option<string>,
    /// Expiration time UTC
    expires-utc: option<string>,
    /// Severity of weather. (Advisory | Watch | Warning)
    severity: option<string>,
    /// Brief description of weather alert
    title: option<string>,
    /// URI to weather alert
    uri: option<string>
  }

  /// Returns severe weather alerts issued by meteorological agencies - Given a lat/lon.
  record get-alerts-lat-lat-lon-lon-params {
    /// Latitude component of location.
    lat: string,
    /// Longitude component of location.
    lon: string,
    /// Wraps return in jsonp callback - Example - callback=func
    callback: option<string>
  }
  get-alerts-lat-lat-lon-lon: func(params: get-alerts-lat-lat-lon-lon-params) -> result<weather-alert, string>;

}


interface bulk-downloads {
  /// Download pre-generated bulk datasets
  record get-bulk-files-file-params {
    /// Filename (ie. current.csv.gz)
    file: string
  }
  get-bulk-files-file: func(params: get-bulk-files-file-params) -> result<string, string>;

}

interface current-air-quality {
  record aq-current-group {
    /// City Name
    city-name: option<string>,
    /// Country Abbreviation
    country-code: option<string>,
    data: option<list<aq-current>>,
    /// Latitude
    lat: option<string>,
    /// Longitude
    lon: option<string>,
    /// State Abbreviation
    state-code: option<string>,
    /// Local IANA time zone
    timezone: option<string>
  }

  record aq-current {
    /// Cloud cover as a percentage (%)
    aqi: option<s32>,
    /// Concentration of NO2 (µg/m³)
    no2: option<f64>,
    /// Concentration of O3 (µg/m³)
    o3: option<f64>,
    /// Concentration of PM 10 (µg/m³)
    pm10: option<f64>,
    /// Concentration of PM 2.5 (µg/m³)
    pm25: option<f64>,
    /// Concentration of SO2 (µg/m³)
    so2: option<f64>
  }

  /// Returns current air quality conditions - Given City and/or State, Country.
  record get-current-airquality-city-city-country-country-params {
    /// City search.. Example - &city=Raleigh,NC or &city=Berlin,DE or city=Paris&country=FR
    city: string,
    /// Full name of state.
    state: option<string>,
    /// Country Code (2 letter).
    country: string,
    /// Wraps return in jsonp callback. Example: callback=func
    callback: option<string>
  }
  get-current-airquality-city-city-country-country: func(params: get-current-airquality-city-city-country-country-params) -> result<aq-current-group, string>;

  /// Returns current air quality conditions - Given a City ID.
  record get-current-airquality-city-id-city-id-params {
    /// City ID. Example: 4487042
    city-id: string,
    /// Wraps return in jsonp callback. Example - callback=func
    callback: option<string>
  }
  get-current-airquality-city-id-city-id: func(params: get-current-airquality-city-id-city-id-params) -> result<aq-current-group, string>;

  /// Returns current air quality conditions - Given a lat/lon.
  record get-current-airquality-lat-lat-lon-lon-params {
    /// Latitude component of location.
    lat: string,
    /// Longitude component of location.
    lon: string,
    /// Wraps return in jsonp callback. Example - callback=func
    callback: option<string>
  }
  get-current-airquality-lat-lat-lon-lon: func(params: get-current-airquality-lat-lat-lon-lon-params) -> result<aq-current-group, string>;

  /// Returns current air quality conditions - Given a Postal Code.
  record get-current-airquality-postal-code-postal-code-params {
    /// Postal Code. Example: 28546
    postal-code: string,
    /// Country Code (2 letter).
    country: option<string>,
    /// Wraps return in jsonp callback. Example - callback=func
    callback: option<string>
  }
  get-current-airquality-postal-code-postal-code: func(params: get-current-airquality-postal-code-postal-code-params) -> result<aq-current-group, string>;

}

interface current-weather-data {
  enum get-current-cities-cities-units-enum {
    s,
    i,
  }

  enum get-current-cities-cities-marine-enum {
    t,
  }

  enum get-current-cities-cities-lang-enum {
    ar,
    az,
    be,
    bg,
    bs,
    ca,
    cs,
    de,
    fi,
    fr,
    el,
    es,
    et,
    hr,
    hu,
    id,
    it,
    is,
    kw,
    nb,
    nl,
    pl,
    pt,
    ro,
    ru,
    sk,
    sl,
    sr,
    sv,
    tr,
    uk,
    zh,
    zh-tw,
  }

  enum get-current-city-city-country-country-include-op-enum {
    minutely,
  }

  record current-obs-group {
    /// Count of found observations
    count: option<s32>,
    data: option<list<current-obs>>
  }

  record current-obs {
    /// Apparent temperature - Default (C)
    app-temp: option<f64>,
    /// Air quality index (US EPA standard 0 to +500)
    aqi: option<f64>,
    /// City name (closest)
    city-name: option<string>,
    /// Cloud cover (%)
    clouds: option<s32>,
    /// Country abbreviation
    country-code: option<string>,
    /// Cycle Hour (UTC) of observation
    datetime: option<string>,
    /// Dew point temperature - default (C)
    dewpt: option<f64>,
    /// Diffuse horizontal irradiance (W/m^2)
    dhi: option<f64>,
    /// Direct normal irradiance (W/m^2)
    dni: option<f64>,
    /// Current solar elevation angle (Degrees)
    elev-angle: option<f64>,
    /// Global horizontal irradiance (W/m^2)
    ghi: option<f64>,
    /// Wind gust speed - Default (m/s)
    gust: option<f64>,
    /// Current solar hour angle (Degrees)
    hour-angle: option<f64>,
    /// Latitude
    lat: option<f64>,
    /// Longitude
    lon: option<f64>,
    /// Full time (UTC) of observation (YYYY-MM-DD HH:MM)
    ob-time: option<string>,
    /// Part of the day (d = day, n = night)
    pod: option<string>,
    /// Precipitation in last hour - Default (mm)
    precip: option<f64>,
    /// Pressure (mb)
    pres: option<f64>,
    /// Relative humidity (%)
    rh: option<s32>,
    /// Mean sea level pressure in millibars (mb)
    slp: option<f64>,
    /// Snowfall in last hour - Default (mm)
    snow: option<f64>,
    /// Estimated solar radiation (W/m^2)
    solar-rad: option<f64>,
    /// List of data sources used in response
    sources: option<list<string>>,
    /// State abbreviation
    state-code: option<string>,
    /// Source Station ID
    station: option<string>,
    /// Time (UTC) of Sunrise (HH:MM)
    sunrise: option<string>,
    /// Time (UTC) of Sunset (HH:MM)
    sunset: option<string>,
    /// Temperature - Default (C)
    temp: option<f64>,
    /// Local IANA time zone
    timezone: option<string>,
    /// Unix Timestamp
    ts: option<f64>,
    /// UV Index
    uv: option<f64>,
    /// Visibility - default (M)
    vis: option<s32>,
    weather: option<current-obs-weather>,
    /// Cardinal wind direction
    wind-cdir: option<string>,
    /// Cardinal wind direction (text)
    wind-cdir-full: option<string>,
    /// Wind direction (degrees)
    wind-dir: option<s32>,
    /// Wind speed - Default (m/s)
    wind-speed: option<f64>
  }

  record current-obs-weather {
    /// Weather Condition code
    code: option<string>,
    /// Weather Condition description
    description: option<string>,
    /// Icon code for forecast image display
    icon: option<string>
  }

  /// Returns a group of observations given a list of cities
  record get-current-cities-cities-params {
    /// Comma separated list of City ID's. Example: 4487042, 4494942, 4504871
    cities: string,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-current-cities-cities-units-enum>,
    /// Marine stations only (buoys, oil platforms, etc)
    marine: option<get-current-cities-cities-marine-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-current-cities-cities-lang-enum>,
    /// Wraps return in jsonp callback - Example - callback=func
    callback: option<string>
  }
  get-current-cities-cities: func(params: get-current-cities-cities-params) -> result<current-obs-group, string>;

  /// Returns a Current Observation - Given City and/or State, Country.
  record get-current-city-city-country-country-params {
    /// City search.. Example - &city=Raleigh,NC or &city=Berlin,DE or city=Paris&country=FR
    city: string,
    /// Include 1 hour - minutely forecast in the response
    include-op: option<get-current-city-city-country-country-include-op-enum>,
    /// Full name of state.
    state: option<string>,
    /// Country Code (2 letter).
    country: string,
    /// Marine stations only (buoys, oil platforms, etc)
    marine: option<get-current-cities-cities-marine-enum>,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-current-cities-cities-units-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-current-cities-cities-lang-enum>,
    /// Wraps return in jsonp callback - Example - callback=func
    callback: option<string>
  }
  get-current-city-city-country-country: func(params: get-current-city-city-country-country-params) -> result<current-obs-group, string>;

  /// Returns a current observation by city id.
  record get-current-city-id-city-id-params {
    /// City ID. Example: 4487042
    city-id: string,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-current-cities-cities-units-enum>,
    /// Include 1 hour - minutely forecast in the response
    include-op: option<get-current-city-city-country-country-include-op-enum>,
    /// Marine stations only (buoys, oil platforms, etc)
    marine: option<get-current-cities-cities-marine-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-current-cities-cities-lang-enum>,
    /// Wraps return in jsonp callback - Example - callback=func
    callback: option<string>
  }
  get-current-city-id-city-id: func(params: get-current-city-id-city-id-params) -> result<current-obs-group, string>;

  /// Returns a Current Observation - Given a lat/lon.
  record get-current-lat-lat-lon-lon-params {
    /// Latitude component of location.
    lat: string,
    /// Longitude component of location.
    lon: string,
    /// Include 1 hour - minutely forecast in the response
    include-op: option<get-current-city-city-country-country-include-op-enum>,
    /// Marine stations only (buoys, oil platforms, etc)
    marine: option<get-current-cities-cities-marine-enum>,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-current-cities-cities-units-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-current-cities-cities-lang-enum>,
    /// Wraps return in jsonp callback - Example - callback=func
    callback: option<string>
  }
  get-current-lat-lat-lon-lon: func(params: get-current-lat-lat-lon-lon-params) -> result<current-obs-group, string>;

  /// Returns a group of observations given a list of points in the format (lat1, lon1), (lat2, lon2), (latN, lonN), ...
  record get-current-points-points-params {
    /// Comma separated list of points. Example: (35.5, -75.5),(45, 65),(45.12, -130.5)
    points: string,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-current-cities-cities-units-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-current-cities-cities-lang-enum>,
    /// Wraps return in jsonp callback. Example: callback=func
    callback: option<string>
  }
  get-current-points-points: func(params: get-current-points-points-params) -> result<current-obs-group, string>;

  /// Returns a current observation by postal code.
  record get-current-postal-code-postal-code-params {
    /// Postal Code. Example: 28546
    postal-code: string,
    /// Country Code (2 letter).
    country: option<string>,
    /// Include 1 hour - minutely forecast in the response
    include-op: option<get-current-city-city-country-country-include-op-enum>,
    /// Marine stations only (buoys, oil platforms, etc)
    marine: option<get-current-cities-cities-marine-enum>,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-current-cities-cities-units-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-current-cities-cities-lang-enum>,
    /// Wraps return in jsonp callback - Example - callback=func
    callback: option<string>
  }
  get-current-postal-code-postal-code: func(params: get-current-postal-code-postal-code-params) -> result<current-obs-group, string>;

  /// Returns a Current Observation. - Given a station ID.
  record get-current-station-station-params {
    /// Station Call ID.
    station: string,
    /// Include 1 hour - minutely forecast in the response
    include-op: option<get-current-city-city-country-country-include-op-enum>,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-current-cities-cities-units-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-current-cities-cities-lang-enum>,
    /// Wraps return in jsonp callback. Example: callback=func
    callback: option<string>
  }
  get-current-station-station: func(params: get-current-station-station-params) -> result<current-obs-group, string>;

  /// Returns a group of observations given a list of stations
  record get-current-stations-stations-params {
    /// Comma separated list of Station Call ID's. Example: KRDU,KBFI,KVNY
    stations: string,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-current-cities-cities-units-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-current-cities-cities-lang-enum>,
    /// Wraps return in jsonp callback. Example: callback=func
    callback: option<string>
  }
  get-current-stations-stations: func(params: get-current-stations-stations-params) -> result<current-obs-group, string>;

}

interface air-quality-forecast {
  record aq-hourly {
    /// City Name
    city-name: option<string>,
    /// Country Abbreviation
    country-code: option<string>,
    data: option<list<aq-hour>>,
    /// Latitude
    lat: option<string>,
    /// Longitude
    lon: option<string>,
    /// State Abbreviation
    state-code: option<string>,
    /// Local IANA time zone
    timezone: option<string>
  }

  record aq-hour {
    /// Cloud cover as a percentage (%)
    aqi: option<s32>,
    /// Concentration of NO2 (µg/m³)
    no2: option<f64>,
    /// Concentration of O3 (µg/m³)
    o3: option<f64>,
    /// Concentration of PM 10 (µg/m³)
    pm10: option<f64>,
    /// Concentration of PM 2.5 (µg/m³)
    pm25: option<f64>,
    /// Concentration of SO2 (µg/m³)
    so2: option<f64>,
    /// Timestamp in local time
    timestamp-local: option<string>,
    /// Timestamp UTC
    timestamp-utc: option<string>,
    /// Unix Timestamp
    ts: option<f64>
  }

  /// Returns 72 hour (hourly) Air Quality forecast - Given City and/or State, Country.
  record get-forecast-airquality-city-city-country-country-params {
    /// City search.. Example - &city=Raleigh,NC or &city=Berlin,DE or city=Paris&country=FR
    city: string,
    /// Full name of state.
    state: option<string>,
    /// Country Code (2 letter).
    country: string,
    /// Wraps return in jsonp callback. Example: callback=func
    callback: option<string>,
    /// Number of hours to return.
    hours: option<s32>
  }
  get-forecast-airquality-city-city-country-country: func(params: get-forecast-airquality-city-city-country-country-params) -> result<aq-hourly, string>;

  /// Returns 72 hour (hourly) Air Quality forecast - Given a City ID.
  record get-forecast-airquality-city-id-city-id-params {
    /// City ID. Example: 4487042
    city-id: string,
    /// Wraps return in jsonp callback. Example - callback=func
    callback: option<string>,
    /// Number of hours to return.
    hours: option<s32>
  }
  get-forecast-airquality-city-id-city-id: func(params: get-forecast-airquality-city-id-city-id-params) -> result<aq-hourly, string>;

  /// Returns 72 hour (hourly) Air Quality forecast - Given a lat/lon.
  record get-forecast-airquality-lat-lat-lon-lon-params {
    /// Latitude component of location.
    lat: string,
    /// Longitude component of location.
    lon: string,
    /// Wraps return in jsonp callback. Example - callback=func
    callback: option<string>,
    /// Number of hours to return.
    hours: option<s32>
  }
  get-forecast-airquality-lat-lat-lon-lon: func(params: get-forecast-airquality-lat-lat-lon-lon-params) -> result<aq-hourly, string>;

  /// Returns 72 hour (hourly) Air Quality forecast - Given a Postal Code.
  record get-forecast-airquality-postal-code-postal-code-params {
    /// Postal Code. Example: 28546
    postal-code: string,
    /// Country Code (2 letter).
    country: option<string>,
    /// Wraps return in jsonp callback. Example - callback=func
    callback: option<string>,
    /// Number of hours to return.
    hours: option<s32>
  }
  get-forecast-airquality-postal-code-postal-code: func(params: get-forecast-airquality-postal-code-postal-code-params) -> result<aq-hourly, string>;

}

interface v16-day-daily-forecast {
  enum get-forecast-daily-city-city-country-country-units-enum {
    s,
    i,
  }

  enum get-forecast-daily-city-city-country-country-lang-enum {
    ar,
    az,
    be,
    bg,
    bs,
    ca,
    cs,
    de,
    fi,
    fr,
    el,
    es,
    et,
    hr,
    hu,
    id,
    it,
    is,
    kw,
    nb,
    nl,
    pl,
    pt,
    ro,
    ru,
    sk,
    sl,
    sr,
    sv,
    tr,
    uk,
    zh,
    zh-tw,
  }

  record forecast-day {
    /// City Name
    city-name: option<string>,
    /// Country Abbreviation
    country-code: option<string>,
    data: option<list<forecast>>,
    /// Latitude
    lat: option<string>,
    /// Longitude
    lon: option<string>,
    /// State Abbreviation
    state-code: option<string>,
    /// Local IANA time zone
    timezone: option<string>
  }

  record forecast {
    /// Apparent Maximum daily Temperature - default (C)
    app-max-temp: option<f64>,
    /// Apparent Minimum daily Temperature - default (C)
    app-min-temp: option<f64>,
    /// Cloud cover as a percentage (%)
    clouds: option<s32>,
    /// Date in format "YYYY-MM-DD:HH". All datetime is in (UTC)
    datetime: option<string>,
    /// Dewpoint (Average) - default (C)
    dewpt: option<f64>,
    /// [Deprecated] Max direct component of solar insolation (W/m^2)
    max-dhi: option<f64>,
    /// Maximum daily Temperature - default (C)
    max-temp: option<f64>,
    /// Minimum daily Temperature - default (C)
    min-temp: option<f64>,
    /// Moon phase
    moon-phase: option<f64>,
    /// Moonrise unix timestamp
    moonrise-ts: option<s32>,
    /// Moonset unix timestamp
    moonset-ts: option<s32>,
    /// Part of the day (d = day, n = night)
    pod: option<string>,
    /// Chance of Precipitation as a percentage (%)
    pop: option<f64>,
    /// Accumulated precipitation since last forecast point - default (mm)
    precip: option<f64>,
    /// Pressure (mb)
    pres: option<f64>,
    /// Relative Humidity as a percentage (%)
    rh: option<s32>,
    /// Mean Sea level pressure (mb)
    slp: option<f64>,
    /// Accumulated snowfall since last forecast point - default (mm)
    snow: option<f64>,
    /// Snow Depth - default (mm)
    snow-depth: option<f64>,
    /// Sunrise unix timestamp
    sunrise-ts: option<s32>,
    /// Sunset unix timestamp
    sunset-ts: option<s32>,
    /// Temperature (Average) - default (C)
    temp: option<f64>,
    /// Timestamp in local time
    timestamp-local: option<string>,
    /// Timestamp UTC
    timestamp-utc: option<string>,
    /// Unix Timestamp
    ts: option<f64>,
    /// UV Index
    uv: option<f64>,
    /// Average Visibility default (KM)
    vis: option<f64>,
    weather: option<forecast-weather>,
    /// Cardinal wind direction
    wind-cdir: option<string>,
    /// Cardinal wind direction (text)
    wind-cdir-full: option<string>,
    /// Wind direction
    wind-dir: option<s32>,
    /// Wind Speed (default m/s)
    wind-spd: option<f64>
  }

  record forecast-weather {
    /// Weather Condition code
    code: option<string>,
    /// Weather Condition description
    description: option<string>,
    /// Icon code for forecast image display
    icon: option<string>
  }

  /// Returns a daily forecast - Given City and/or State, Country.
  record get-forecast-daily-city-city-country-country-params {
    /// City search.. Example - &city=Raleigh,NC or &city=Berlin,DE or city=Paris&country=FR
    city: string,
    /// Full name of state.
    state: option<string>,
    /// Country Code (2 letter).
    country: string,
    /// Number of days to return. Default 16.
    days: option<f64>,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-forecast-daily-city-city-country-country-units-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-forecast-daily-city-city-country-country-lang-enum>,
    /// Wraps return in jsonp callback. Example - callback=func
    callback: option<string>
  }
  get-forecast-daily-city-city-country-country: func(params: get-forecast-daily-city-city-country-country-params) -> result<forecast-day, string>;

  /// Returns a daily forecast - Given a City ID.
  record get-forecast-daily-city-id-city-id-params {
    /// City ID. Example: 4487042
    city-id: string,
    /// Number of days to return. Default 16.
    days: option<f64>,
    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-forecast-daily-city-city-country-country-units-enum>,
    /// Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>
    lang: option<get-forecast-daily-city-city-country-country-lang-enum>,
    /// Wraps return in jsonp callback. Example: callback=func
    callback: option<string>
  }
  get-forecast-daily-city-id-city-id: func(params: get-forecast-daily-city-id-city-id-params) -> result<forecast-day, string>;

  /// Returns a daily forecast - Given Lat/Lon.
  record get-forecast-daily-lat-lat-lon-lon-params {
    /// Latitude component of location.
    lat: string,
    /// Longitude component of location.
    lon: string,
    /// Number of days to return. Default 16.
    days: option<f64>,
