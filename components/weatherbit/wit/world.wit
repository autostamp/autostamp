    /// Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>
    units: option<get-forecast-energy-lat-lat-lon-lon-units-enum>,
    /// Time period (default: daily)
    tp: option<get-forecast-energy-lat-lat-lon-lon-tp-enum>,
    /// Wraps return in jsonp callback. Example: callback=func
    callback: option<string>,
    /// Your registered API key.
    key: string
  }
  get-forecast-energy-lat-lat-lon-lon: func(params: get-forecast-energy-lat-lat-lon-lon-params) -> result<string, string>;

}

