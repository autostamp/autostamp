/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `api-key` | query `apiKey` |
package autostamp:languagetool@0.6.0;

interface check {
  enum post-check-body-level-enum {
    default,
    picky,
  }

  record post-check-response {
    /// The language used for checking the text.
    language: option<post-check-response-language>,
    matches: option<list<post-check-response-matches-item>>,
    software: option<post-check-response-software>
  }

  /// The language used for checking the text.
  record post-check-response-language {
    /// ISO 639-1 code like 'en', 'en-US', or 'ca-ES-valencia'
    code: string,
    /// The automatically detected text language (might be different from the language actually used for checking).
    detected-language: post-check-response-language-detected-language,
    /// Language name like 'French' or 'English (US)'.
    name: string
  }

  /// The automatically detected text language (might be different from the language actually used for checking).
  record post-check-response-language-detected-language {
    /// ISO 639-1 code like 'en', 'en-US', or 'ca-ES-valencia'.
    code: string,
    /// Language name like 'French' or 'English (US)'.
    name: string
  }

  record post-check-response-matches-item {
    context: post-check-response-matches-item-context,
    /// The length of the error in characters.
    length: s32,
    /// Message about the error displayed to the user.
    message: string,
    /// The 0-based character offset of the error in the text.
    offset: s32,
    /// Replacements that might correct the error. The array can be empty, in this case there is no suggested replacement.
    replacements: list<post-check-response-matches-item-replacements-item>,
    rule: option<post-check-response-matches-item-rule>,
    /// The sentence the error occurred in (since LanguageTool 4.0 or later)
    sentence: string,
    /// An optional shorter version of 'message'.
    short-message: option<string>
  }

  record post-check-response-matches-item-context {
    /// The length of the error in characters in the context.
    length: s32,
    /// The 0-based character offset of the error in the context text.
    offset: s32,
    /// Context of the error, i.e. the error and some text to the left and to the left.
    text: string
  }

  record post-check-response-matches-item-replacements-item {
    /// the replacement string
    value: option<string>
  }

  record post-check-response-matches-item-rule {
    category: post-check-response-matches-item-rule-category,
    description: string,
    /// An rule's identifier that's unique for this language.
    id: string,
    /// The <a href="http://www.w3.org/International/multilingualweb/lt/drafts/its20/its20.html#lqissue-typevalues">Localization Quality Issue Type</a>. This is not defined for all languages, in which case it will always be 'Uncategorized'.
    issue-type: option<string>,
    /// An optional sub identifier of the rule, used when several rules are grouped.
    sub-id: option<string>,
    /// An optional array of URLs with a more detailed description of the error.
    urls: option<list<post-check-response-matches-item-rule-urls-item>>
  }

  record post-check-response-matches-item-rule-category {
    /// A category's identifier that's unique for this language.
    id: option<string>,
    /// A short description of the category.
    name: option<string>
  }

  record post-check-response-matches-item-rule-urls-item {
    /// the URL
    value: option<string>
  }

  record post-check-response-software {
    /// Version of this API response. We don't expect to make incompatible changes, so this can also be increased for newly added fields.
    api-version: s32,
    /// Date when the software was built, e.g. '2016-05-25'.
    build-date: string,
    /// Usually 'LanguageTool'.
    name: string,
    /// true if you're using a Premium account with all the premium text checks (since LanguageTool 4.2)
    premium: option<bool>,
    /// An optional warning, e.g. when the API format is not stable.
    status: option<string>,
    /// A version string like '3.3' or '3.4-SNAPSHOT'.
    version: string
  }

  /// Check a text
  record post-check-params {
    /// The text to be checked. This or 'data' is required.
    text: option<string>,
    /// The text to be checked, given as a JSON document that specifies what's text and what's markup. This or 'text' is required. Markup will be ignored when looking for errors. Example text: <pre>A &lt;b>test&lt;/b></pre>JSON for the example text: <pre>{"annotation":[
    ///  {"text": "A "},
    data: option<string>,
    /// A language code like `en-US`, `de-DE`, `fr`, or `auto` to guess the language automatically (see `preferredVariants` below). For languages with variants (English, German, Portuguese) spell checking will only be activated when you specify the variant, e.g. `en-GB` instead of just `en`.
    language: string,
    /// Set to get Premium API access: Your username/email as used to log in at languagetool.org.
    username: option<string>,
    /// Set to get Premium API access: <a target='_blank' href='https://languagetool.org/editor/settings/access-tokens'>your API key</a>
    api-key: option<string>,
    /// Comma-separated list of dictionaries to include words from; uses special default dictionary if this is unset
    dicts: option<string>,
    /// A language code of the user's native language, enabling false friends checks for some language pairs.
    mother-tongue: option<string>,
    /// Comma-separated list of preferred language variants. The language detector used with `language=auto` can detect e.g. English, but it cannot decide whether British English or American English is used. Thus this parameter can be used to specify the preferred variants like `en-GB` and `de-AT`. Only available with `language=auto`. You should set variants for at least German and English, as otherwise the spell checking will not work for those, as no spelling dictionary can be selected for just `en` or `de`.
    preferred-variants: option<string>,
    /// IDs of rules to be enabled, comma-separated
    enabled-rules: option<string>,
    /// IDs of rules to be disabled, comma-separated
    disabled-rules: option<string>,
    /// IDs of categories to be enabled, comma-separated
    enabled-categories: option<string>,
    /// IDs of categories to be disabled, comma-separated
    disabled-categories: option<string>,
    /// If true, only the rules and categories whose IDs are specified with `enabledRules` or `enabledCategories` are enabled.
    enabled-only: option<bool>,
    /// If set to `picky`, additional rules will be activated, i.e. rules that you might only find useful when checking formal text.
    level: option<post-check-body-level-enum>
  }
  post-check: func(params: post-check-params) -> result<post-check-response, string>;

}


interface languages {
  record get-languages-response-item {
    /// a language code like 'en'
    code: string,
    /// a language code like 'en-US' or 'ca-ES-valencia'
    long-code: string,
    /// a language name like 'French' or 'English (Australia)'
    name: string
  }

  /// Get a list of supported languages.
  get-languages: func() -> result<list<get-languages-response-item>, string>;

}

interface words {
  record get-words-response {
    /// array of words
    words: option<list<string>>
  }

  record post-words-add-response {
    /// true if the word has been added. false means the word hasn't been added because it had been added before.
    added: option<bool>
  }

  record post-words-delete-response {
    /// true if the word has been removed. false means the word hasn't been removed because it was not in the dictionary.
    deleted: option<bool>
  }

  /// List words in dictionaries
  record get-words-params {
    /// Offset of where to start in the list of words. Defaults to 0.
    offset: option<s32>,
    /// Maximum number of words to return. Defaults to 10.
    limit: option<s32>,
    /// Your username as used to log in at languagetool.org.
    username: string,
    /// Comma-separated list of dictionaries to include words from; uses special default dictionary if this is unset
    dicts: option<string>
  }
  get-words: func(params: get-words-params) -> result<get-words-response, string>;

  /// Add word to a dictionary
  record post-words-add-params {
    /// The word to be added. Must not be a phrase, i.e. cannot contain white space. The word is added to a global dictionary that applies to all languages.
    word: string,
    /// Your username as used to log in at languagetool.org.
    username: string,
    /// <a target='_blank' href='https://languagetool.org/editor/settings/access-tokens'>Your API key</a>
    api-key: string,
    /// Name of the dictionary to add the word to; non-existent dictionaries are created after calling this; if unset, adds to special default dictionary
    dict: option<string>
  }
  post-words-add: func(params: post-words-add-params) -> result<post-words-add-response, string>;

  /// Remove word from a dictionary
  record post-words-delete-params {
    /// The word to be removed.
    word: string,
    /// Your username as used to log in at languagetool.org.
    username: string,
    /// <a target='_blank' href='https://languagetool.org/editor/settings/access-tokens'>Your API key</a>
    api-key: string,
    /// Name of the dictionary to remove the word from; if the dictionary is empty upon calling this, it is deleted; if unset, removes from special default dictionary
    dict: option<string>
  }
  post-words-delete: func(params: post-words-delete-params) -> result<post-words-delete-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export check;
  export languages;
  export words;
}
