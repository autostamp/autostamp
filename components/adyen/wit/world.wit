  enum kyc-check-status-data-status-enum {
    awaiting-data,
    data-provided,
    failed,
    invalid-data,
    passed,
    pending,
    pending-review,
    retry-limit-reached,
    unchecked,
  }

  enum kyc-check-status-data-type-op-enum {
    bank-account-verification,
    card-verification,
    company-verification,
    identity-verification,
    legal-arrangement-verification,
    nonprofit-verification,
    passport-verification,
    payout-method-verification,
    pci-verification,
  }

  record generic-response {
    /// The reference of a request. Can be used to uniquely identify the request.
    psp-reference: option<string>,
    /// The result code.
    result-code: option<string>,
    /// Indicates whether the request is processed asynchronously. Depending on the request's platform settings, the following scenarios may be applied:
    /// * **true**: The request is queued and will be executed when the providing service is available in the order in which the requests are received.
    submitted-async: option<bool>
  }

  record legal-arrangement-request-wrapper {
    legal-arrangement-request: option<legal-arrangement-request>
  }

  record legal-arrangement-request {
    /// The code of the legal arrangement to be deleted. If you also send `legalArrangementEntityCodes`, only the entities listed will be deleted.
    legal-arrangement-code: string,
    /// List of legal arrangement entities to be deleted.
    legal-arrangement-entity-codes: option<list<string>>
  }

  record get-uploaded-documents-response {
    /// A list of the documents and their details.
    document-details: option<list<document-detail-wrapper>>,
    /// The reference of a request. Can be used to uniquely identify the request.
    psp-reference: option<string>,
    /// The result code.
    result-code: option<string>,
    /// Indicates whether the request is processed asynchronously. Depending on the request's platform settings, the following scenarios may be applied:
    /// * **true**: The request is queued and will be executed when the providing service is available in the order in which the requests are received.
    submitted-async: option<bool>
  }

  record document-detail-wrapper {
    document-detail: option<document-detail>
  }

  record document-detail {
    /// The code of account holder, to which the document applies.
    account-holder-code: option<string>,
    /// The Adyen-generated [`bankAccountUUID`](https://docs.adyen.com/api-explorer/#/Account/latest/post/createAccountHolder__resParam_accountHolderDetails-bankAccountDetails-bankAccountUUID) to which the document must be linked. Refer to [Bank account check](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-checks/bank-account-check#uploading-a-bank-statement) for details on when a document should be submitted.
    /// >Required if the `documentType` is **BANK_STATEMENT**, where a document is being submitted in order to verify a bank account.
    bank-account-uuid: option<string>,
    /// Description of the document.
    description: option<string>,
    /// The type of the document. Refer to [Verification checks](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-checks) for details on when each document type should be submitted and for the accepted file formats.
    /// 
    document-type: document-detail-document-type-enum,
    /// Filename of the document.
    filename: option<string>,
    /// The Adyen-generated [`shareholderCode`](https://docs.adyen.com/api-explorer/#/Account/latest/post/createAccountHolder__resParam_accountHolderDetails-businessDetails-shareholders-shareholderCode) to which the document must be linked. Refer to [Verification checks](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-checks) for details on when a document should be submitted.
    /// >Required if the account holder has a `legalEntity` of type **Business** and the `documentType` is either **PASSPORT**, **ID_CARD_FRONT**, **ID_CARD_BACK**, **DRIVING_LICENCE_FRONT**, or **DRIVING_LICENCE_BACK**. 
    shareholder-code: option<string>,
    /// The Adyen-generated [`signatoryCode`](https://docs.adyen.com/api-explorer/#/Account/v6/post/createAccountHolder__resParam_accountHolderDetails-businessDetails-signatories-signatoryCode) to which the document must be linked.
    signatory-code: option<string>
  }

  record update-account-holder-response {
    /// The code of the account holder.
    account-holder-code: option<string>,
    account-holder-details: option<account-holder-details>,
    account-holder-status: option<account-holder-status>,
    /// in case the account holder has not been updated, contains account holder fields, that did not pass the validation.
    invalid-fields: option<list<error-field-type-wrapper>>,
    /// The reference of a request. Can be used to uniquely identify the request.
    psp-reference: option<string>,
    /// The result code.
    result-code: option<string>,
    /// Indicates whether the request is processed asynchronously. Depending on the request's platform settings, the following scenarios may be applied:
    /// * **true**: The request is queued and will be executed when the providing service is available in the order in which the requests are received.
    submitted-async: option<bool>,
    /// A list of the fields updated through the request.
    updated-fields: option<list<field-type-wrapper>>,
    verification: option<kyc-verification-result>
  }

  record account-holder-details {
    address: vias-address,
    /// Array of bank accounts associated with the account holder. For details about the required `bankAccountDetail` fields, see [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information).
    bank-account-details: option<list<bank-account-detail-wrapper>>,
    business-details: option<business-details>,
    /// The email address of the account holder.
    email: option<string>,
    /// The phone number of the account holder provided as a single string. It will be handled as a landline phone.
    /// **Examples:** "0031 6 11 22 33 44", "+316/1122-3344", "(0031) 611223344"
    full-phone-number: option<string>,
    individual-details: option<individual-details>,
    /// Date when you last reviewed the account holder's information, in ISO-8601 YYYY-MM-DD format. For example, **2020-01-31**.
    last-review-date: option<string>,
    /// The Merchant Category Code of the account holder.
    /// > If not specified in the request, this will be derived from the platform account (which is configured by Adyen).
    merchant-category-code: option<string>,
    /// A set of key and value pairs for general use by the account holder or merchant.
    /// The keys do not have specific names and may be used for storing miscellaneous data as desired.
    metadata: option<list<account-holder-details-metadata-entry>>,
    principal-business-address: option<vias-address>,
    /// The URL of the website of the account holder.
    web-address: option<string>
  }

  record vias-address {
    /// The name of the city. Required if the `houseNumberOrName`, `street`, `postalCode`, or `stateOrProvince` are provided.
    city: option<string>,
    /// The two-character country code of the address in ISO-3166-1 alpha-2 format. For example, **NL**.
    country: string,
    /// The number or name of the house.
    house-number-or-name: option<string>,
    /// The postal code. Required if the `houseNumberOrName`, `street`, `city`, or `stateOrProvince` are provided.
    /// 
    postal-code: option<string>,
    /// The abbreviation of the state or province. Required if the `houseNumberOrName`, `street`, `city`, or `postalCode` are provided. 
    /// 
    state-or-province: option<string>,
    /// The name of the street. Required if the `houseNumberOrName`, `city`, `postalCode`, or `stateOrProvince` are provided.
    street: option<string>
  }

  record bank-account-detail-wrapper {
    bank-account-detail: option<bank-account-detail>
  }

  record bank-account-detail {
    /// The bank account number (without separators).
    /// >Refer to [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information) for details on field requirements.
    account-number: option<string>,
    /// The type of bank account.
    /// Only applicable to bank accounts held in the USA.
    account-type: option<string>,
    /// The name of the bank account.
    bank-account-name: option<string>,
    /// The unique identifier (UUID) of the Bank Account.
    /// >If, during an account holder create or update request, this field is left blank (but other fields provided), a new Bank Account will be created with a procedurally-generated UUID.
    bank-account-uuid: option<string>,
    /// The bank identifier code.
    /// >Refer to [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information) for details on field requirements.
    bank-bic-swift: option<string>,
    /// The city in which the bank branch is located.
    /// 
    bank-city: option<string>,
    /// The bank code of the banking institution with which the bank account is registered.
    /// 
    bank-code: option<string>,
    /// The name of the banking institution with which the bank account is held.
    /// 
    bank-name: option<string>,
    /// The branch code of the branch under which the bank account is registered. The value to be specified in this parameter depends on the country of the bank account:
    /// * United States - Routing number
    branch-code: option<string>,
    /// The check code of the bank account.
    /// 
    check-code: option<string>,
    /// The two-letter country code in which the bank account is registered.
    /// >The permitted country codes are defined in ISO-3166-1 alpha-2 (e.g. 'NL').
    country-code: option<string>,
    /// The currency in which the bank account deals.
    /// >The permitted currency codes are defined in ISO-4217 (e.g. 'EUR').
    currency-code: option<string>,
    /// The international bank account number.
    /// >The IBAN standard is defined in ISO-13616.
    iban: option<string>,
    /// The city of residence of the bank account owner.
    /// >Refer to [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information) for details on field requirements.
    owner-city: option<string>,
    /// The country code of the country of residence of the bank account owner.
    /// >The permitted country codes are defined in ISO-3166-1 alpha-2 (e.g. 'NL').
    owner-country-code: option<string>,
    /// The date of birth of the bank account owner.
    /// The date should be in ISO-8601 format yyyy-mm-dd (e.g. 2000-01-31).
    owner-date-of-birth: option<string>,
    /// The house name or number of the residence of the bank account owner.
    /// >Refer to [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information) for details on field requirements.
    owner-house-number-or-name: option<string>,
    /// The name of the bank account owner.
    /// >Refer to [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information) for details on field requirements.
    owner-name: option<string>,
    /// The country code of the country of nationality of the bank account owner.
    /// >The permitted country codes are defined in ISO-3166-1 alpha-2 (e.g. 'NL').
    owner-nationality: option<string>,
    /// The postal code of the residence of the bank account owner.
    /// >Refer to [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information) for details on field requirements.
    owner-postal-code: option<string>,
    /// The state of residence of the bank account owner.
    /// >Refer to [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information) for details on field requirements.
    owner-state: option<string>,
    /// The street name of the residence of the bank account owner.
    /// >Refer to [Required information](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process/required-information) for details on field requirements.
    owner-street: option<string>,
    /// If set to true, the bank account is a primary account.
    primary-account: option<bool>,
    /// The tax ID number.
    /// 
    tax-id: option<string>,
    /// The URL to be used for bank account verification.
    /// This may be generated on bank account creation.
    url-for-verification: option<string>
  }

  record business-details {
    /// The registered name of the company (if it differs from the legal name of the company).
    doing-business-as: option<string>,
    /// The legal name of the company.
    legal-business-name: option<string>,
    /// Information about the parent public company. Required if the account holder is 100% owned by a publicly listed company.
    listed-ultimate-parent-company: option<list<ultimate-parent-company-wrapper>>,
    /// Array containing information about individuals associated with the account holder either through ownership or control. For details about how you can identify them, refer to [our verification guide](https://docs.adyen.com/marketplaces-and-platforms/classic/verification-process#identify-ubos).
    shareholders: option<list<shareholder-contact-wrapper>>,
    /// Signatories associated with the company.
    /// Each array entry should represent one signatory.
    signatories: option<list<signatory-contact-wrapper>>,
    /// The tax ID of the company.
    tax-id: option<string>
  }

  record ultimate-parent-company-wrapper {
    ultimate-parent-company: option<ultimate-parent-company>
  }

  record ultimate-parent-company {
    address: option<vias-address>,
    business-details: option<ultimate-parent-company-business-details>,
    /// Adyen-generated unique alphanumeric identifier (UUID) for the entry, returned in the response when you create an ultimate parent company. Required when updating an existing entry in an `/updateAccountHolder` request.
    ultimate-parent-company-code: option<string>
  }

  record ultimate-parent-company-business-details {
    /// The legal name of the company.
    legal-business-name: option<string>,
    /// The registration number of the company.
    registration-number: option<string>,
    /// Market Identifier Code (MIC).
    stock-exchange: option<string>,
    /// International Securities Identification Number (ISIN).
    stock-number: option<string>,
    /// Stock Ticker symbol.
    stock-ticker: option<string>
  }

  record shareholder-contact-wrapper {
    shareholder-contact: option<shareholder-contact>
  }

  record shareholder-contact {
    address: option<vias-address>,
    /// The e-mail address of the person.
    email: option<string>,
    /// The phone number of the person provided as a single string.  It will be handled as a landline phone.
    /// Examples: "0031 6 11 22 33 44", "+316/1122-3344", "(0031) 611223344"
    full-phone-number: option<string>,
    /// Job title of the person. Required when the `shareholderType` is **Controller**.
    /// 
    job-title: option<string>,
    name: option<vias-name>,
    personal-data: option<vias-personal-data>,
    phone-number: option<vias-phone-number>,
    /// The unique identifier (UUID) of the shareholder entry.
    /// >**If, during an Account Holder create or update request, this field is left blank (but other fields provided), a new Shareholder will be created with a procedurally-generated UUID.**
    shareholder-code: option<string>,
    /// Specifies how the person is associated with the account holder. 
    /// 
    shareholder-type: option<shareholder-contact-shareholder-type-enum>,
    /// The URL of the person's website.
    web-address: option<string>
  }

  record vias-name {
    /// The first name.
    first-name: option<string>,
    /// The gender.
    /// >The following values are permitted: `MALE`, `FEMALE`, `UNKNOWN`.
    gender: option<vias-name-gender-enum>,
    /// The name's infix, if applicable.
    /// >A maximum length of twenty (20) characters is imposed.
    infix: option<string>,
    /// The last name.
    last-name: option<string>
  }

  record vias-personal-data {
    /// The person's date of birth, in ISO-8601 YYYY-MM-DD format. For example, **2000-01-31**.
    date-of-birth: option<string>,
    /// Array that contains information about the person's identification document. You can submit only one entry per document type.
    document-data: option<list<personal-document-data-wrapper>>,
    /// An ID number of the person.
    id-number: option<string>,
    /// The nationality of the person represented by a two-character country code,  in [ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2) format. For example, **NL**.
    nationality: option<string>
  }

  record personal-document-data-wrapper {
    personal-document-data: option<personal-document-data>
  }

  record personal-document-data {
    /// The expiry date of the document, 
    ///  in ISO-8601 YYYY-MM-DD format. For example, **2000-01-31**.
    expiration-date: option<string>,
    /// The country where the document was issued, in the two-character 
    /// [ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2) format. For example, **NL**.
    issuer-country: option<string>,
    /// The state where the document was issued (if applicable).
    issuer-state: option<string>,
    /// The number in the document.
    number: option<string>,
    /// The type of the document. Possible values: **ID**, **DRIVINGLICENSE**, **PASSPORT**, **SOCIALSECURITY**, **VISA**.
    /// 
    type-op: personal-document-data-type-op-enum
  }

  record vias-phone-number {
    /// The two-character country code of the phone number.
    /// >The permitted country codes are defined in ISO-3166-1 alpha-2 (e.g. 'NL').
    phone-country-code: option<string>,
    /// The phone number.
    /// >The inclusion of the phone number country code is not necessary.
    phone-number: option<string>,
    /// The type of the phone number.
    /// >The following values are permitted: `Landline`, `Mobile`, `SIP`, `Fax`.
    phone-type: option<vias-phone-number-phone-type-enum>
  }

  record signatory-contact-wrapper {
    signatory-contact: option<signatory-contact>
  }

  record signatory-contact {
    address: option<vias-address>,
    /// The e-mail address of the person.
    email: option<string>,
    /// The phone number of the person provided as a single string.  It will be handled as a landline phone.
    /// Examples: "0031 6 11 22 33 44", "+316/1122-3344", "(0031) 611223344"
    full-phone-number: option<string>,
    /// Job title of the signatory.
    /// 
    job-title: option<string>,
    name: option<vias-name>,
    personal-data: option<vias-personal-data>,
    phone-number: option<vias-phone-number>,
    /// The unique identifier (UUID) of the signatory.
    /// >**If, during an Account Holder create or update request, this field is left blank (but other fields provided), a new Signatory will be created with a procedurally-generated UUID.**
    signatory-code: option<string>,
    /// Your reference for the signatory.
    signatory-reference: option<string>,
    /// The URL of the person's website.
    web-address: option<string>
  }

  record individual-details {
    name: option<vias-name>,
    personal-data: option<vias-personal-data>
  }

  /// one entry of a string-keyed map (free-form object)
  record account-holder-details-metadata-entry {
    key: string,
    value: string
  }

  record account-holder-status {
    /// A list of events scheduled for the account holder.
    events: option<list<account-event-wrapper>>,
    payout-state: option<account-payout-state>,
    processing-state: option<account-processing-state>,
    /// The status of the account holder.
    /// >Permitted values: `Active`, `Inactive`, `Suspended`, `Closed`.
    status: account-holder-status-status-enum,
    /// The reason why the status was assigned to the account holder.
    status-reason: option<string>
  }

  record account-event-wrapper {
    account-event: option<account-event>
  }

  record account-event {
    /// The event.
    /// >Permitted values: `InactivateAccount`, `RefundNotPaidOutTransfers`.
    event: option<account-event-event-enum>,
    /// The date on which the event will take place.
    execution-date: option<string>,
    /// The reason why this event has been created.
    reason: option<string>
  }

  record account-payout-state {
    /// Indicates whether payouts are allowed. This field is the overarching payout status, and is the aggregate of multiple conditions (e.g., KYC status, disabled flag, etc). If this field is false, no payouts will be permitted for any of the account holder's accounts. If this field is true, payouts will be permitted for any of the account holder's accounts.
    allow-payout: option<bool>,
    /// The reason why payouts (to all of the account holder's accounts) have been disabled (by the platform). If the `disabled` field is true, this field can be used to explain why.
    disable-reason: option<string>,
    /// Indicates whether payouts have been disabled (by the platform) for all of the account holder's accounts. A platform may enable and disable this field at their discretion. If this field is true, `allowPayout` will be false and no payouts will be permitted for any of the account holder's accounts. If this field is false, `allowPayout` may or may not be enabled, depending on other factors.
    disabled: option<bool>,
    payout-limit: option<amount>,
    /// The payout tier that the account holder occupies.
    tier-number: option<s32>
  }

  record amount {
    /// The three-character [ISO currency code](https://docs.adyen.com/development-resources/currency-codes).
    currency: string,
    /// The amount of the transaction, in [minor units](https://docs.adyen.com/development-resources/currency-codes).
    value: s64
  }

  record account-processing-state {
    /// The reason why processing has been disabled.
    disable-reason: option<string>,
    /// Indicates whether the processing of payments is allowed.
    disabled: option<bool>,
    processed-from: option<amount>,
    processed-to: option<amount>,
    /// The processing tier that the account holder occupies.
    tier-number: option<s32>
  }

  record error-field-type-wrapper {
    error-field-type: option<error-field-type>
  }

  record error-field-type {
    /// The validation error code.
    error-code: option<s32>,
    /// A description of the validation error.
    error-description: option<string>,
    field-type: option<field-type>
  }

  record field-type {
    /// The full name of the property.
    field: option<string>,
    /// The type of the field.
    field-name: option<field-type-field-name-enum>,
    /// The code of the shareholder that the field belongs to. If empty, the field belongs to an account holder.
    shareholder-code: option<string>
  }

  record field-type-wrapper {
    field-type: option<field-type>
  }

  record kyc-verification-result {
    account-holder: option<kyc-check-result>,
    /// The results of the checks on the bank accounts.
    bank-accounts: option<list<kyc-bank-account-check-result>>,
    /// The results of the checks on the shareholders.
    shareholders: option<list<kyc-shareholder-check-result>>,
    /// The results of the checks on the signatories.
    signatories: option<list<kyc-signatory-check-result>>
  }

  record kyc-check-result {
    /// A list of the checks and their statuses.
    checks: option<list<kyc-check-status-data>>
  }

  record kyc-check-status-data {
    /// A list of the fields required for execution of the check.
    required-fields: option<list<string>>,
    /// The status of the check.
    /// 
    status: kyc-check-status-data-status-enum,
    summary: option<kyc-check-summary>,
    /// The type of check.
    /// 
    type-op: kyc-check-status-data-type-op-enum
  }

  record kyc-check-summary {
    /// The code of the check.
    code: s32,
    /// A description of the check.
    description: option<string>
  }

  record kyc-bank-account-check-result {
    /// The unique ID of the bank account to which the check applies.
    bank-account-uuid: option<string>,
    /// A list of the checks and their statuses.
    checks: option<list<kyc-check-status-data>>
  }

  record kyc-shareholder-check-result {
    /// A list of the checks and their statuses.
    checks: option<list<kyc-check-status-data>>,
    /// The code of the shareholder to which the check applies.
    shareholder-code: option<string>
  }

  record kyc-signatory-check-result {
    /// A list of the checks and their statuses.
    checks: option<list<kyc-check-status-data>>,
    /// The code of the signatory to which the check applies.
    signatory-code: option<string>
  }

  variant post-delete-bank-accounts-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant post-delete-legal-arrangements-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant post-delete-shareholders-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant post-delete-signatories-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant post-get-uploaded-documents-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant post-upload-document-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  /// Delete bank accounts
  record post-delete-bank-accounts-params {
    /// The code of the Account Holder from which to delete the Bank Account(s).
    account-holder-code: string,
    /// The code(s) of the Bank Accounts to be deleted.
    bank-account-uui-ds: list<string>
  }
  post-delete-bank-accounts: func(params: post-delete-bank-accounts-params) -> result<generic-response, post-delete-bank-accounts-error>;

  /// Delete legal arrangements
  record post-delete-legal-arrangements-params {
    /// The code of the account holder.
    account-holder-code: string,
    /// List of legal arrangements.
    legal-arrangements: list<legal-arrangement-request-wrapper>
  }
  post-delete-legal-arrangements: func(params: post-delete-legal-arrangements-params) -> result<generic-response, post-delete-legal-arrangements-error>;

  /// Delete shareholders
  record post-delete-shareholders-params {
    /// The code of the Account Holder from which to delete the Shareholders.
    account-holder-code: string,
    /// The code(s) of the Shareholders to be deleted.
    shareholder-codes: list<string>
  }
  post-delete-shareholders: func(params: post-delete-shareholders-params) -> result<generic-response, post-delete-shareholders-error>;

  /// Delete signatories
  record post-delete-signatories-params {
    /// The code of the account holder from which to delete the signatories.
    account-holder-code: string,
    /// Array of codes of the signatories to be deleted.
    signatory-codes: list<string>
  }
  post-delete-signatories: func(params: post-delete-signatories-params) -> result<generic-response, post-delete-signatories-error>;

  /// Get documents
  record post-get-uploaded-documents-params {
    /// The code of the Account Holder for which to retrieve the documents.
    account-holder-code: string,
    /// The code of the Bank Account for which to retrieve the documents.
    bank-account-uuid: option<string>,
    /// The code of the Shareholder for which to retrieve the documents.
    shareholder-code: option<string>
  }
  post-get-uploaded-documents: func(params: post-get-uploaded-documents-params) -> result<get-uploaded-documents-response, post-get-uploaded-documents-error>;

  /// Upload a document
  record post-upload-document-params {
    /// The code of the account holder, for which the document is submitted.
    account-holder-code: option<string>,
    /// The unique ID of the bank account, for which the document is submitted.
    /// >Required if the document is being submitted in order to verify a bank account.
    bank-account-uuid: option<string>,
    /// The content of the document, in Base64-encoded string format.
    /// 
    document-content: string,
    document-detail: document-detail,
    /// The code of the shareholder, for which the document is submitted.
    /// >Required if the document is being submitted in order to verify a shareholder.
    shareholder-code: option<string>
  }
  post-upload-document: func(params: post-upload-document-params) -> result<update-account-holder-response, post-upload-document-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export accounts;
  export account-holders;
  export verification;
}
