package autostamp:wikimedia@0.6.0;

interface feed-content-availability {
  record availability {
    /// domains for wikis with this feature enabled, or [ '*.<project>.org' ] for all wikis in a project
    in-the-news: list<string>,
    /// domains for wikis with this feature enabled, or [ '*.<project>.org' ] for all wikis in a project
    most-read: list<string>,
    /// domains for wikis with this feature enabled, or [ '*.<project>.org' ] for all wikis in a project
    on-this-day: list<string>,
    /// domains for wikis with this feature enabled, or [ '*.<project>.org' ] for all wikis in a project
    picture-of-the-day: list<string>,
    /// domains for wikis with this feature enabled, or [ '*.<project>.org' ] for all wikis in a project
    todays-featured-article: list<string>
  }

  /// Gets availability of featured feed content for the apps by wiki domain.
  get-feed-availability: func() -> result<availability, string>;

}


interface math {
  variant post-media-math-check-type-error {
    bad-request(string),
    other(string)
  }

  variant get-media-math-formula-hash-error {
    not-found(string),
    other(string)
  }

  variant get-media-math-render-format-hash-error {
    not-found(string),
    other(string)
  }

  /// Check and normalize a TeX formula.
  record post-media-math-check-type-params {
    /// The input type of the given formula; can be tex or inline-tex
    type-op: string,
    /// The formula to check
    q: string
  }
  post-media-math-check-type: func(params: post-media-math-check-type-params) -> result<string, post-media-math-check-type-error>;

  /// Get a previously-stored formula
  record get-media-math-formula-hash-params {
    /// The hash string of the previous POST data
    hash: string
  }
  get-media-math-formula-hash: func(params: get-media-math-formula-hash-params) -> result<string, get-media-math-formula-hash-error>;

  /// Get rendered formula in the given format.
  record get-media-math-render-format-hash-params {
    /// The output format; can be svg or mml
    format: string,
    /// The hash string of the previous POST data
    hash: string
  }
  get-media-math-render-format-hash: func(params: get-media-math-render-format-hash-params) -> result<string, get-media-math-render-format-hash-error>;

}

interface bytes-difference-data {
