package autostamp:wikimedia@0.2.0;

interface feed-content-availability {
  /// Gets availability of featured feed content for the apps by wiki domain.
  get-feed-availability: func() -> result<string, string>;

}


interface math {
  /// Check and normalize a TeX formula.
  record post-media-math-check-type-params {
    /// The input type of the given formula; can be tex or inline-tex
    type-op: string,
    /// The formula to check
    q: string
  }
  post-media-math-check-type: func(params: post-media-math-check-type-params) -> result<string, string>;

  /// Get a previously-stored formula
  record get-media-math-formula-hash-params {
    /// The hash string of the previous POST data
    hash: string
  }
  get-media-math-formula-hash: func(params: get-media-math-formula-hash-params) -> result<string, string>;

  /// Get rendered formula in the given format.
  record get-media-math-render-format-hash-params {
    /// The output format; can be svg or mml
    format: string,
    /// The hash string of the previous POST data
    hash: string
  }
  get-media-math-render-format-hash: func(params: get-media-math-render-format-hash-params) -> result<string, string>;

}

interface bytes-difference-data {
  /// Get the sum of absolute value of text bytes difference between current edit and
  /// previous one.
  record get-metrics-bytes-difference-absolute-aggregate-project-editor-type-page-type-granularity-start-end-params {
    /// The name of any Wikimedia project formatted like {language code}.{project name},
    /// for example en.wikipedia. You may pass en.wikipedia.org and the .org will be stripped
    project: string,
    /// If you want to filter by editor-type, use one of anonymous, group-bot (registered
    /// accounts belonging to the bot group), name-bot (registered accounts not belonging to
    editor-type: string,
    /// If you want to filter by page-type, use one of content (edits on pages in content
    /// namespaces) or non-content (edits on pages in non-content namespaces). If you are
    page-type: string,
    /// Time unit for the response data. As of today, supported values are daily and monthly
    granularity: string,
    /// The date of the first day to include, in YYYYMMDD format
    start: string,
    /// The date of the last day to include, in YYYYMMDD format
    end: string
  }
  get-metrics-bytes-difference-absolute-aggregate-project-editor-type-page-type-granularity-start-end: func(params: get-metrics-bytes-difference-absolute-aggregate-project-editor-type-page-type-granularity-start-end-params) -> result<string, string>;

  /// Get the sum of absolute text bytes difference per page.
