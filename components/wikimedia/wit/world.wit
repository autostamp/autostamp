    /// The name of any Wikimedia project formatted like {language code}.{project name},
    /// for example en.wikipedia. You may pass en.wikipedia.org and the .org will be stripped
    project: string,
    /// The page-title to request absolute bytes-difference for. Should be prefixed with the
    /// page canonical namespace.
    page-title: string,
    /// If you want to filter by editor-type, use one of anonymous, group-bot (registered
    /// accounts belonging to the bot group), name-bot (registered accounts not belonging to
    editor-type: string,
    /// Time unit for the response data. As of today, supported values are daily and monthly
    granularity: string,
    /// The date of the first day to include, in YYYYMMDD format
    start: string,
    /// The date of the last day to include, in YYYYMMDD format
    end: string
  }
  get-metrics-bytes-difference-absolute-per-page-project-page-title-editor-type-granularity-start-end: func(params: get-metrics-bytes-difference-absolute-per-page-project-page-title-editor-type-granularity-start-end-params) -> result<string, string>;

  /// Get the sum of net text bytes difference between current edit and previous one.
  record get-metrics-bytes-difference-net-aggregate-project-editor-type-page-type-granularity-start-end-params {
    /// The name of any Wikimedia project formatted like {language code}.{project name},
    /// for example en.wikipedia. You may pass en.wikipedia.org and the .org will be stripped
    project: string,
    /// If you want to filter by editor-type, use one of anonymous, group-bot (registered
    /// accounts belonging to the bot group), name-bot (registered accounts not belonging to
    editor-type: string,
    /// If you want to filter by page-type, use one of content (edits on pages in content
    /// namespaces) or non-content (edits on pages in non-content namespaces). If you are
    page-type: string,
    /// Time unit for the response data. As of today, supported values are daily and monthly
    granularity: string,
    /// The date of the first day to include, in YYYYMMDD format
    start: string,
    /// The date of the last day to include, in YYYYMMDD format
    end: string
  }
  get-metrics-bytes-difference-net-aggregate-project-editor-type-page-type-granularity-start-end: func(params: get-metrics-bytes-difference-net-aggregate-project-editor-type-page-type-granularity-start-end-params) -> result<string, string>;

  /// Get the sum of net text bytes difference per page.
  record get-metrics-bytes-difference-net-per-page-project-page-title-editor-type-granularity-start-end-params {
    /// The name of any Wikimedia project formatted like {language code}.{project name},
    /// for example en.wikipedia. You may pass en.wikipedia.org and the .org will be stripped
    project: string,
    /// The page-title to request net bytes-difference for. Should be prefixed with the
    /// page canonical namespace.
    page-title: string,
    /// If you want to filter by editor-type, use one of anonymous, group-bot (registered
    /// accounts belonging to the bot group), name-bot (registered accounts not belonging to
    editor-type: string,
    /// Time unit for the response data. As of today, supported values are daily and monthly
    granularity: string,
    /// The date of the first day to include, in YYYYMMDD format
    start: string,
    /// The date of the last day to include, in YYYYMMDD format
    end: string
  }
  get-metrics-bytes-difference-net-per-page-project-page-title-editor-type-granularity-start-end: func(params: get-metrics-bytes-difference-net-per-page-project-page-title-editor-type-granularity-start-end-params) -> result<string, string>;

}

