interface transform {
  record cx-mt {
    /// the translated content
    contents: option<string>
  }

  record cx-languagepairs {
    /// the list of available source languages
    source: option<list<string>>,
    /// the list of available destination languages
    target: option<list<string>>
  }

  record cx-list-tools {
    /// the list of tools available for the given language pair
    tools: option<list<string>>
  }

  /// one entry of a string-keyed map (free-form object)
  record cx-list-pairs-for-tool-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record cx-list-pairs-for-tool-entry-v2 {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record cx-list-pairs-for-tool-entry-v3 {
    key: string,
    value: string
  }

  record cx-dict {
    /// the original word to look up
    source: option<string>,
    /// the translations found
    translations: option<list<cx-dict-translations-item>>
  }

  record cx-dict-translations-item {
    /// extra information about the phrase
    info: option<string>,
    /// the translated phrase
    phrase: option<string>,
    /// the source dictionary used for the translation
    sources: option<string>
  }

  /// Machine-translate content
  record post-transform-html-from-from-lang-to-to-lang-params {
    /// The source language code
    from-lang: string,
    /// The target language code
    to-lang: string,
    /// The HTML content to translate
    html: string
  }
  post-transform-html-from-from-lang-to-to-lang: func(params: post-transform-html-from-from-lang-to-to-lang-params) -> result<cx-mt, string>;

  /// Machine-translate content
  record post-transform-html-from-from-lang-to-to-lang-provider-params {
    /// The source language code
    from-lang: string,
    /// The target language code
    to-lang: string,
    /// The machine translation provider id
    provider: string,
    /// The HTML content to translate
    html: string
  }
  post-transform-html-from-from-lang-to-to-lang-provider: func(params: post-transform-html-from-from-lang-to-to-lang-provider-params) -> result<cx-mt, string>;

  /// Lists the language pairs supported by the back-end
  get-transform-list-languagepairs: func() -> result<cx-languagepairs, string>;

  /// Lists the tools available for a language pair
  record get-transform-list-pair-from-to-params {
    /// The source language code
    from-op: string,
    /// The target language code
    to: string
  }
  get-transform-list-pair-from-to: func(params: get-transform-list-pair-from-to-params) -> result<cx-list-tools, string>;

  /// Lists the tools and language pairs available for the given tool category
  record get-transform-list-tool-tool-params {
    /// The tool category to list tools and language pairs for
    tool: string
  }
  get-transform-list-tool-tool: func(params: get-transform-list-tool-tool-params) -> result<list<cx-list-pairs-for-tool-entry>, string>;

  /// Lists the tools and language pairs available for the given tool category
  record get-transform-list-tool-tool-from-params {
    /// The tool category to list tools and language pairs for
    tool: string,
    /// The source language code
    from-op: string
  }
  get-transform-list-tool-tool-from: func(params: get-transform-list-tool-tool-from-params) -> result<list<cx-list-pairs-for-tool-entry-v2>, string>;

  /// Lists the tools and language pairs available for the given tool category
  record get-transform-list-tool-tool-from-to-params {
    /// The tool category to list tools and language pairs for
    tool: string,
    /// The source language code
    from-op: string,
    /// The target language code
    to: string
  }
  get-transform-list-tool-tool-from-to: func(params: get-transform-list-tool-tool-from-to-params) -> result<list<cx-list-pairs-for-tool-entry-v3>, string>;

  /// Fetch the dictionary meaning of a word
  record get-transform-word-from-from-lang-to-to-lang-word-params {
    /// The source language code
    from-lang: string,
    /// The target language code
    to-lang: string,
    /// The word to lookup
    word: string
  }
  get-transform-word-from-from-lang-to-to-lang-word: func(params: get-transform-word-from-from-lang-to-to-lang-word-params) -> result<cx-dict, string>;

  /// Fetch the dictionary meaning of a word
  record get-transform-word-from-from-lang-to-to-lang-word-provider-params {
    /// The source language code
    from-lang: string,
    /// The target language code
    to-lang: string,
    /// The word to lookup
    word: string,
    /// The dictionary provider id
    provider: string
  }
  get-transform-word-from-from-lang-to-to-lang-word-provider: func(params: get-transform-word-from-from-lang-to-to-lang-word-provider-params) -> result<cx-dict, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export feed-content-availability;
  export math;
  export bytes-difference-data;
  export edited-pages-data;
  export editors-data;
  export edits-data;
  export legacy-data;
  export pageviews-data;
  export registered-users-data;
  export unique-devices-data;
  export transform;
}
