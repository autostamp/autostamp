    editor-type: option<string>,
    granularity: option<string>,
    page-type: option<string>,
    project: option<string>,
    results: option<list<net-bytes-difference-items-item-results-item>>
  }

  record net-bytes-difference-items-item-results-item {
    net-bytes-diff: option<s64>,
    timestamp: option<string>
  }

  record net-bytes-difference-per-page {
    items: option<list<net-bytes-difference-per-page-items-item>>
  }

  record net-bytes-difference-per-page-items-item {
    editor-type: option<string>,
    granularity: option<string>,
