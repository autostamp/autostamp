    end: string
  }
  get-metrics-bytes-difference-net-per-page-project-page-title-editor-type-granularity-start-end: func(params: get-metrics-bytes-difference-net-per-page-project-page-title-editor-type-granularity-start-end-params) -> result<net-bytes-difference-per-page, string>;

