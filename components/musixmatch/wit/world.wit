    status-code: option<f64>
  }

  record get-matcher-subtitle-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The song title
    q-track: option<string>,
    /// 	The song artist
    q-artist: option<string>,
    /// Filter by subtitle length in seconds
    f-subtitle-length: option<f64>,
    /// Max deviation for a subtitle length in seconds
    f-subtitle-length-max-deviation: option<f64>
  }
  get-matcher-subtitle-get: func(params: get-matcher-subtitle-get-params) -> result<get-matcher-subtitle-get-response, string>;

  record get-track-subtitle-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The musiXmatch track id
    track-id: string
  }
  get-track-subtitle-get: func(params: get-track-subtitle-get-params) -> result<get-track-subtitle-get-response, string>;

}

interface snippet {
  record get-track-snippet-get-response {
    message: option<get-track-snippet-get-response-message>
  }

  record get-track-snippet-get-response-message {
    body: option<get-track-snippet-get-response-message-body>,
    header: option<get-track-snippet-get-response-message-header>
  }

  record get-track-snippet-get-response-message-body {
    snippet: option<snippet>
  }

  /// Snippet of lyrics text in the Musixmatch database.
  record snippet {
    html-tracking-url: option<string>,
    instrumental: option<f64>,
    pixel-tracking-url: option<string>,
    restricted: option<f64>,
    script-tracking-url: option<string>,
    snippet-body: option<string>,
    snippet-id: option<f64>,
    snippet-language: option<string>,
    updated-time: option<string>
  }

  record get-track-snippet-get-response-message-header {
    execute-time: option<f64>,
    status-code: option<f64>
  }

  record get-track-snippet-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The musiXmatch track id
    track-id: string
  }
  get-track-snippet-get: func(params: get-track-snippet-get-params) -> result<get-track-snippet-get-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export album;
  export track;
  export artist;
  export lyrics;
  export subtitle;
  export snippet;
}
