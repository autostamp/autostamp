package autostamp:musixmatch@0.6.0;

interface album {
  record get-album-get-response {
    message: option<get-album-get-response-message>
  }

  record get-album-get-response-message {
    body: option<get-album-get-response-message-body>,
    header: option<get-album-get-response-message-header>
  }

  record get-album-get-response-message-body {
    album: option<album>
  }

  /// a album of songs in the Musixmatch database.
  record album {
    album-copyright: option<string>,
    album-coverart-v100x100: option<string>,
    album-coverart-v350x350: option<string>,
    album-coverart-v500x500: option<string>,
    album-coverart-v800x800: option<string>,
    album-edit-url: option<string>,
    album-id: option<f64>,
    album-label: option<string>,
    album-mbid: option<string>,
    album-name: option<string>,
    album-pline: option<string>,
    album-rating: option<f64>,
    album-release-date: option<string>,
    album-release-type: option<string>,
    album-track-count: option<f64>,
    album-vanity-id: option<string>,
    artist-id: option<f64>,
    artist-name: option<string>,
    primary-genres: option<album-primary-genres>,
    restricted: option<f64>,
    secondary-genres: option<album-secondary-genres>,
    updated-time: option<string>
  }

  record album-primary-genres {
    music-genre-list: option<list<album-primary-genres-music-genre-list-item>>
  }

  record album-primary-genres-music-genre-list-item {
    music-genre: option<album-primary-genres-music-genre-list-item-music-genre>
  }

  record album-primary-genres-music-genre-list-item-music-genre {
    music-genre-id: option<f64>,
    music-genre-name: option<string>,
    music-genre-name-extended: option<string>,
    music-genre-parent-id: option<f64>,
    music-genre-vanity: option<string>
  }

  record album-secondary-genres {
    music-genre-list: option<list<string>>
  }

  record get-album-get-response-message-header {
    execute-time: option<f64>,
    status-code: option<f64>
  }

  record get-artist-albums-get-response {
    message: option<get-artist-albums-get-response-message>
  }

  record get-artist-albums-get-response-message {
    body: option<get-artist-albums-get-response-message-body>,
    header: option<get-artist-albums-get-response-message-header>
  }

  record get-artist-albums-get-response-message-body {
    /// A list of albums
    album-list: option<list<get-artist-albums-get-response-message-body-album-list-item>>
  }

  record get-artist-albums-get-response-message-body-album-list-item {
    album: option<album>
  }

  record get-artist-albums-get-response-message-header {
    available: option<f64>,
    execute-time: option<f64>,
    status-code: option<f64>
  }

  record get-album-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The musiXmatch album id
    album-id: string
  }
  get-album-get: func(params: get-album-get-params) -> result<get-album-get-response, string>;

  record get-artist-albums-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The musiXmatch artist id
    artist-id: string,
    /// Sort by release date (asc|desc)
    s-release-date: option<string>,
    /// Group by Album Name
    g-album-name: option<string>,
    /// Define the page size for paginated results.Range is 1 to 100.
    page-size: option<f64>,
    /// Define the page number for paginated results
    page: option<f64>
  }
  get-artist-albums-get: func(params: get-artist-albums-get-params) -> result<get-artist-albums-get-response, string>;

}


interface track {
  record get-album-tracks-get-response {
    message: option<get-album-tracks-get-response-message>
  }

  record get-album-tracks-get-response-message {
    body: option<get-album-tracks-get-response-message-body>,
    header: option<get-album-tracks-get-response-message-header>
  }

  record get-album-tracks-get-response-message-body {
    /// A list of tracks
    track-list: option<list<track>>
  }

  /// a song in the Musixmatch database
  record track {
    album-coverart-v100x100: option<string>,
    album-coverart-v350x350: option<string>,
    album-coverart-v500x500: option<string>,
    album-coverart-v800x800: option<string>,
    album-id: option<f64>,
    album-name: option<string>,
    artist-id: option<f64>,
    artist-mbid: option<string>,
    artist-name: option<string>,
    commontrack-id: option<f64>,
    commontrack-vanity-id: option<string>,
    explicit: option<f64>,
    first-release-date: option<string>,
    has-lyrics: option<f64>,
    has-subtitles: option<f64>,
    instrumental: option<f64>,
    lyrics-id: option<f64>,
    num-favourite: option<f64>,
    primary-genres: option<track-primary-genres>,
    restricted: option<f64>,
    secondary-genres: option<track-secondary-genres>,
    subtitle-id: option<f64>,
    track-edit-url: option<string>,
    track-id: option<f64>,
    track-isrc: option<string>,
    track-length: option<f64>,
    track-mbid: option<string>,
    track-name: option<string>,
    track-name-translation-list: option<list<string>>,
    track-rating: option<f64>,
    track-share-url: option<string>,
    track-soundcloud-id: option<f64>,
    track-spotify-id: option<string>,
    track-xboxmusic-id: option<string>,
    updated-time: option<string>
  }

  record track-primary-genres {
    music-genre-list: option<list<track-primary-genres-music-genre-list-item>>
  }

  record track-primary-genres-music-genre-list-item {
    music-genre: option<track-primary-genres-music-genre-list-item-music-genre>
  }

  record track-primary-genres-music-genre-list-item-music-genre {
    music-genre-id: option<f64>,
    music-genre-name: option<string>,
    music-genre-name-extended: option<string>,
    music-genre-parent-id: option<f64>,
    music-genre-vanity: option<string>
  }

  record track-secondary-genres {
    music-genre-list: option<list<track-secondary-genres-music-genre-list-item>>
  }

  record track-secondary-genres-music-genre-list-item {
    music-genre: option<track-secondary-genres-music-genre-list-item-music-genre>
  }

  record track-secondary-genres-music-genre-list-item-music-genre {
    music-genre-id: option<f64>,
    music-genre-name: option<string>,
    music-genre-name-extended: option<string>,
    music-genre-parent-id: option<f64>,
    music-genre-vanity: option<string>
  }

  record get-album-tracks-get-response-message-header {
    available: option<f64>,
    execute-time: option<f64>,
    status-code: option<f64>
  }

  record get-chart-tracks-get-response {
    message: option<get-chart-tracks-get-response-message>
  }

  record get-chart-tracks-get-response-message {
    body: option<get-chart-tracks-get-response-message-body>,
    header: option<get-chart-tracks-get-response-message-header>
  }

  record get-chart-tracks-get-response-message-body {
    /// A list of tracks
    track-list: option<list<get-chart-tracks-get-response-message-body-track-list-item>>
  }

  record get-chart-tracks-get-response-message-body-track-list-item {
    track: option<track>
  }

  record get-chart-tracks-get-response-message-header {
    available: option<f64>,
    execute-time: option<f64>,
    status-code: option<f64>
  }

  record get-matcher-track-get-response {
    message: option<get-matcher-track-get-response-message>
  }

  record get-matcher-track-get-response-message {
    body: option<get-matcher-track-get-response-message-body>,
    header: option<get-matcher-track-get-response-message-header>
  }

  record get-matcher-track-get-response-message-body {
    track: option<track>
  }

  record get-matcher-track-get-response-message-header {
    execute-time: option<f64>,
    status-code: option<f64>
  }

  record get-track-get-response {
    message: option<get-track-get-response-message>
  }

  record get-track-get-response-message {
    body: option<get-track-get-response-message-body>,
    header: option<get-track-get-response-message-header>
  }

  record get-track-get-response-message-body {
    track: option<track>
  }

  record get-track-get-response-message-header {
    execute-time: option<f64>,
    status-code: option<f64>
  }

  record get-track-search-response {
    message: option<get-track-search-response-message>
  }

  record get-track-search-response-message {
    body: option<get-track-search-response-message-body>,
    header: option<get-track-search-response-message-header>
  }

  record get-track-search-response-message-body {
    /// A list of tracks
    track-list: option<list<get-track-search-response-message-body-track-list-item>>
  }

  record get-track-search-response-message-body-track-list-item {
    track: option<track>
  }

  record get-track-search-response-message-header {
    available: option<f64>,
    execute-time: option<f64>,
    status-code: option<f64>
  }

  record get-album-tracks-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The musiXmatch album id
    album-id: string,
    /// When set, filter only contents with lyrics
    f-has-lyrics: option<string>,
    /// Define the page number for paginated results
    page: option<f64>,
    /// Define the page size for paginated results.Range is 1 to 100.
    page-size: option<f64>
  }
  get-album-tracks-get: func(params: get-album-tracks-get-params) -> result<get-album-tracks-get-response, string>;

  record get-chart-tracks-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// Define the page number for paginated results
    page: option<f64>,
    /// Define the page size for paginated results.Range is 1 to 100.
    page-size: option<f64>,
    /// A valid ISO 3166 country code
    country: option<string>,
    /// When set, filter only contents with lyrics
    f-has-lyrics: option<string>
  }
  get-chart-tracks-get: func(params: get-chart-tracks-get-params) -> result<get-chart-tracks-get-response, string>;

  record get-matcher-track-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The song artist
    q-artist: option<string>,
    /// The song title
    q-track: option<string>,
    /// When set, filter only contents with lyrics
    f-has-lyrics: option<f64>,
    /// When set, filter only contents with subtitles
    f-has-subtitle: option<f64>
  }
  get-matcher-track-get: func(params: get-matcher-track-get-params) -> result<get-matcher-track-get-response, string>;

  record get-track-get-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The musiXmatch track id
    track-id: string
  }
  get-track-get: func(params: get-track-get-params) -> result<get-track-get-response, string>;

  record get-track-search-params {
    /// output format: json, jsonp, xml.
    format: option<string>,
    /// jsonp callback
    callback: option<string>,
    /// The song title
    q-track: option<string>,
    /// The song artist
    q-artist: option<string>,
    /// Any word in the lyrics
    q-lyrics: option<string>,
    /// When set, filter by this artist id
    f-artist-id: option<f64>,
    /// When set, filter by this music category id
    f-music-genre-id: option<f64>,
    /// Filter by the lyrics language (en,it,..)
    f-lyrics-language: option<f64>,
    /// When set, filter only contents with lyrics
    f-has-lyrics: option<f64>,
    /// Sort by our popularity index for artists (asc|desc)
    s-artist-rating: option<string>,
    /// Sort by our popularity index for tracks (asc|desc)
    s-track-rating: option<string>,
    /// Search only a part of the given query string.Allowed range is (0.1 – 0.9)
    quorum-factor: option<f64>,
    /// Define the page size for paginated results.Range is 1 to 100.
    page-size: option<f64>,
    /// Define the page number for paginated results
    page: option<f64>
  }
  get-track-search: func(params: get-track-search-params) -> result<get-track-search-response, string>;

}

