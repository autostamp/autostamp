interface sections {
  record get-sections-for-project-response {
    data: option<list<section-compact>>
  }

  record section-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the section (i.e. the text displayed as the section header).
    name: option<string>
  }

  record section-request {
    /// An existing section within this project after which the added section should be inserted. Cannot be provided together with insert_before.
    insert-after: option<string>,
    /// An existing section within this project before which the added section should be inserted. Cannot be provided together with insert_after.
    insert-before: option<string>,
    /// The text to be displayed as the section name. This cannot be an empty string.
    name: string
  }

  record create-section-for-project-response {
    data: option<section-response>
  }

  record section-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the section (i.e. the text displayed as the section header).
    name: option<string>,
    /// The time at which this resource was created.
    created-at: option<string>,
    project: option<project-compact>,
    /// *Deprecated - please use project instead*
    projects: option<list<project-compact>>
  }

  record project-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the project. This is generally a short sentence fragment that fits on a line in the UI for maximum readability. However, it can be longer.
    name: option<string>
  }

  record project-section-insert-request {
    /// Insert the given section immediately after the section specified by this parameter.
    after-section: option<string>,
    /// Insert the given section immediately before the section specified by this parameter.
    before-section: option<string>,
    /// The project in which to reorder the given section.
    project: string,
    /// The section to reorder.
    section: string
  }

  record insert-section-for-project-response {
    data: option<list<empty-response-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record empty-response-entry {
    key: string,
    value: string
  }

  record get-section-response {
    data: option<section-response>
  }

  record update-section-response {
    data: option<section-response>
  }

  record delete-section-response {
    data: option<list<empty-response-entry-v2>>
  }

  /// one entry of a string-keyed map (free-form object)
  record empty-response-entry-v2 {
    key: string,
    value: string
  }

  record section-task-insert-request {
    /// An existing task within this section after which the added task should be inserted. Cannot be provided together with insert_before.
    insert-after: option<string>,
    /// An existing task within this section before which the added task should be inserted. Cannot be provided together with insert_after.
    insert-before: option<string>,
    /// The task to add to this section.
    task: string
  }

  record add-task-for-section-response {
    data: option<list<empty-response-entry-v3>>
  }

  /// one entry of a string-keyed map (free-form object)
  record empty-response-entry-v3 {
    key: string,
    value: string
  }

  variant get-sections-for-project-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant create-section-for-project-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant insert-section-for-project-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-section-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant update-section-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-section-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant add-task-for-section-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get sections in a project
