interface status-updates {
  enum status-update-compact-resource-subtype-enum {
    project-status-update,
    portfolio-status-update,
    goal-status-update,
  }

  enum status-update-request-status-type-enum {
    on-track,
    at-risk,
    off-track,
    on-hold,
    complete,
    achieved,
    partial,
    missed,
    dropped,
  }

  record get-statuses-for-object-response {
    data: option<list<status-update-compact>>
  }

  record status-update-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    /// The `resource_subtype`s for `status` objects represent the type of their parent.
    resource-subtype: option<status-update-compact-resource-subtype-enum>,
    /// The title of the status update.
    title: option<string>
  }

  record status-update-request {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    /// The `resource_subtype`s for `status` objects represent the type of their parent.
    resource-subtype: option<status-update-compact-resource-subtype-enum>,
    /// The title of the status update.
    title: option<string>,
    /// [Opt In](/docs/input-output-options). The text content of the status update with formatting as HTML.
    html-text: option<string>,
    /// The type associated with the status update. This represents the current state of the object this object is on.
    status-type: status-update-request-status-type-enum,
    /// The text content of the status update.
    text: string,
    parent: string
  }

  record create-status-for-object-response {
    data: option<status-update-response>
  }

  record status-update-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    /// The `resource_subtype`s for `status` objects represent the type of their parent.
    resource-subtype: option<status-update-compact-resource-subtype-enum>,
    /// The title of the status update.
    title: option<string>,
    /// [Opt In](/docs/input-output-options). The text content of the status update with formatting as HTML.
    html-text: option<string>,
    /// The type associated with the status update. This represents the current state of the object this object is on.
    status-type: status-update-request-status-type-enum,
    /// The text content of the status update.
    text: string,
    author: option<user-compact>,
    /// The time at which this resource was created.
    created-at: option<string>,
    created-by: option<user-compact>,
    /// *Deprecated - please use liked instead* True if the status is hearted by the authorized user, false if not.
    hearted: option<bool>,
    /// *Deprecated - please use likes instead* Array of likes for users who have hearted this status.
    hearts: option<list<like>>,
    /// True if the status is liked by the authorized user, false if not.
    liked: option<bool>,
    /// Array of likes for users who have liked this status.
    likes: option<list<like>>,
    /// The time at which this project status was last modified.
    /// *Note: This does not currently reflect any changes in associations such as comments that may have been added or removed from the status.*
    modified-at: option<string>,
    /// *Deprecated - please use likes instead* The number of users who have hearted this status.
    num-hearts: option<s32>,
    /// The number of users who have liked this status.
    num-likes: option<s32>,
    parent: option<status-update-response-parent>
  }

  record user-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Read-only except when same user as requester*. The user’s name.
    name: option<string>
  }

  /// An object to represent a user's like.
  record like {
    /// Globally unique identifier of the object, as a string.
    gid: option<string>,
    user: option<user-compact>
  }

  record status-update-response-parent {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the project. This is generally a short sentence fragment that fits on a line in the UI for maximum readability. However, it can be longer.
    name: option<string>
  }

  record get-status-response {
    data: option<status-update-response>
  }

  record delete-status-response {
    data: option<list<empty-response-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record empty-response-entry {
    key: string,
    value: string
  }

  variant get-statuses-for-object-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant create-status-for-object-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-status-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-status-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get status updates from an object
  record get-statuses-for-object-params {
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>,
    /// Results per page.
    /// The number of objects to return per page. The value must be between 1 and 100.
    limit: option<s32>,
    /// Offset token.
    /// An offset to the next page returned by the API. A pagination request will return an offset token, which can be used as an input parameter to the next request. If an offset is not passed in, the API will return the first page of results.
    offset: option<string>,
    /// Globally unique identifier for object to fetch statuses from. Must be a GID for a project, portfolio, or goal.
    parent: string,
    /// Only return statuses that have been created since the given time.
    created-since: option<string>
  }
  get-statuses-for-object: func(params: get-statuses-for-object-params) -> result<get-statuses-for-object-response, get-statuses-for-object-error>;

  /// Create a status update
  record create-status-for-object-params {
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>,
    /// Results per page.
    /// The number of objects to return per page. The value must be between 1 and 100.
    limit: option<s32>,
    /// Offset token.
    /// An offset to the next page returned by the API. A pagination request will return an offset token, which can be used as an input parameter to the next request. If an offset is not passed in, the API will return the first page of results.
    offset: option<string>,
    data: option<status-update-request>
  }
  create-status-for-object: func(params: create-status-for-object-params) -> result<create-status-for-object-response, create-status-for-object-error>;

  /// Get a status update
  record get-status-params {
    /// The status update to get.
    status-gid: string,
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>
  }
  get-status: func(params: get-status-params) -> result<get-status-response, get-status-error>;

  /// Delete a status update
  record delete-status-params {
    /// The status update to get.
    status-gid: string,
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>
  }
  delete-status: func(params: delete-status-params) -> result<delete-status-response, delete-status-error>;

}

interface stories {
  enum story-response-sticker-name-enum {
    green-checkmark,
    people-dancing,
    dancing-unicorn,
    heart,
    party-popper,
    people-waving-flags,
    splashing-narwhal,
    trophy,
    yeti-riding-unicorn,
    celebrating-people,
    determined-climbers,
    phoenix-spreading-love,
  }

  enum custom-field-compact-resource-subtype-enum {
    text,
    enum-op,
    multi-enum,
    number,
    date,
    people,
  }

  enum custom-field-compact-type-op-enum {
    text,
    enum-op,
    multi-enum,
    number,
  }

  enum task-compact-resource-subtype-enum {
    default-task,
    milestone,
    section,
    approval,
  }

  enum story-response-source-enum {
    web,
    email,
    mobile,
    api,
    unknown,
  }

  enum story-response-type-op-enum {
    comment,
    system,
  }

  record get-story-response {
    data: option<story-response>
  }

  record story-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The time at which this resource was created.
    created-at: option<string>,
    /// [Opt In](/docs/input-output-options). HTML formatted text for a comment. This will not include the name of the creator.
    html-text: option<string>,
    /// *Conditional*. Whether the story should be pinned on the resource.
    is-pinned: option<bool>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    resource-subtype: option<string>,
    /// The name of the sticker in this story. `null` if there is no sticker.
    sticker-name: option<story-response-sticker-name-enum>,
    /// The plain text of the comment to add. Cannot be used with html_text.
    text: option<string>,
    assignee: option<user-compact>,
    created-by: option<user-compact>,
    custom-field: option<custom-field-compact>,
    dependency: option<task-compact>,
    duplicate-of: option<task-compact>,
    duplicated-from: option<task-compact>,
    follower: option<user-compact>,
    /// *Deprecated - please use likes instead*
    /// *Conditional*. True if the story is hearted by the authorized user, false if not.
    hearted: option<bool>,
    /// *Deprecated - please use likes instead*
    /// 
    hearts: option<list<like>>,
    /// *Conditional*. Whether the text of the story can be edited after creation.
    is-editable: option<bool>,
    /// *Conditional*. Whether the text of the story has been edited after creation.
    is-edited: option<bool>,
    /// *Conditional*. True if the story is liked by the authorized user, false if not.
    liked: option<bool>,
    /// *Conditional*. Array of likes for users who have liked this story.
    likes: option<list<like>>,
    /// *Conditional*. The new value of approval status.
    new-approval-status: option<string>,
    new-date-value: option<story-response-new-date-value>,
    new-dates: option<story-response-dates>,
    new-enum-value: option<enum-option>,
    /// *Conditional*. The new value of a multi-enum custom field story.
    new-multi-enum-values: option<list<enum-option>>,
    /// *Conditional*
    new-name: option<string>,
    /// *Conditional*
    new-number-value: option<s32>,
    /// *Conditional*. The new value of a people custom field story.
    new-people-value: option<list<user-compact>>,
    /// *Conditional*
    new-resource-subtype: option<string>,
    new-section: option<section-compact>,
    /// *Conditional*
    new-text-value: option<string>,
    /// *Deprecated - please use likes instead*
    /// 
    num-hearts: option<s32>,
    /// *Conditional*. The number of users who have liked this story.
    num-likes: option<s32>,
    /// *Conditional*. The old value of approval status.
    old-approval-status: option<string>,
    old-date-value: option<story-response-old-date-value>,
    old-dates: option<story-response-dates>,
    old-enum-value: option<enum-option>,
    /// *Conditional*. The old value of a multi-enum custom field story.
    old-multi-enum-values: option<list<enum-option>>,
    /// *Conditional*'
    old-name: option<string>,
    /// *Conditional*
    old-number-value: option<s32>,
    /// *Conditional*. The old value of a people custom field story.
    old-people-value: option<list<user-compact>>,
    /// *Conditional*
    old-resource-subtype: option<string>,
    old-section: option<section-compact>,
    /// *Conditional*
    old-text-value: option<string>,
    /// *Conditional*. A collection of previews to be displayed in the story.
    /// 
    previews: option<list<preview>>,
    project: option<project-compact>,
    /// The component of the Asana product the user used to trigger the story.
    source: option<story-response-source-enum>,
    story: option<story-compact>,
    tag: option<tag-compact>,
    target: option<story-response-target>,
    task: option<task-compact>,
    type-op: option<story-response-type-op-enum>
  }

  record user-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Read-only except when same user as requester*. The user’s name.
    name: option<string>
  }

  record custom-field-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Conditional*. Only relevant for custom fields of type `date`. This object reflects the chosen date (and optionally, time) value of a `date` custom field. If no date is selected, the value of `date_value` will be `null`.
    date-value: option<custom-field-compact-date-value>,
    /// A string representation for the value of the custom field. Integrations that don't require the underlying type should use this field to read values. Using this field will future-proof an app against new custom field types.
    display-value: option<string>,
    /// *Conditional*. Determines if the custom field is enabled or not.
    enabled: option<bool>,
    /// *Conditional*. Only relevant for custom fields of type `enum`. This array specifies the possible values which an `enum` custom field can adopt. To modify the enum options, refer to [working with enum options](/docs/create-an-enum-option).
    enum-options: option<list<enum-option>>,
    enum-value: option<custom-field-compact-enum-value>,
    /// *Conditional*. Only relevant for custom fields of type `multi_enum`. This object is the chosen values of a `multi_enum` custom field.
    multi-enum-values: option<list<enum-option>>,
    /// The name of the custom field.
    name: option<string>,
    /// *Conditional*. This number is the value of a `number` custom field.
    number-value: option<f64>,
    /// The type of the custom field. Must be one of the given values.
    resource-subtype: option<custom-field-compact-resource-subtype-enum>,
    /// *Conditional*. This string is the value of a `text` custom field.
    text-value: option<string>,
    /// *Deprecated: new integrations should prefer the resource_subtype field.* The type of the custom field. Must be one of the given values.
    type-op: option<custom-field-compact-type-op-enum>
  }

  /// *Conditional*. Only relevant for custom fields of type `date`. This object reflects the chosen date (and optionally, time) value of a `date` custom field. If no date is selected, the value of `date_value` will be `null`.
  record custom-field-compact-date-value {
    /// A string representing the date in YYYY-MM-DD format.
    date: option<string>,
    /// A string representing the date in ISO 8601 format. If no time value is selected, the value of `date-time` will be `null`.
    date-time: option<string>
  }

  record enum-option {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The color of the enum option. Defaults to ‘none’.
    color: option<string>,
    /// Whether or not the enum option is a selectable value for the custom field.
    enabled: option<bool>,
    /// The name of the enum option.
    name: option<string>
  }

  record custom-field-compact-enum-value {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The color of the enum option. Defaults to ‘none’.
    color: option<string>,
    /// Whether or not the enum option is a selectable value for the custom field.
    enabled: option<bool>,
    /// The name of the enum option.
    name: option<string>
  }

  record task-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the task.
    name: option<string>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    /// The resource_subtype `milestone` represent a single moment in time. This means tasks with this subtype cannot have a start_date.
    resource-subtype: option<task-compact-resource-subtype-enum>
  }

  /// An object to represent a user's like.
  record like {
    /// Globally unique identifier of the object, as a string.
    gid: option<string>,
    user: option<user-compact>
  }

  record story-response-new-date-value {
    /// The UTC date and time on which this task is due, or null if the task has no due time. This takes an ISO 8601 date string in UTC and should not be used together with `due_on`.
    due-at: option<string>,
    /// The localized day on which this goal is due. This takes a date with format `YYYY-MM-DD`.
    due-on: option<string>,
    /// The day on which work for this goal begins, or null if the goal has no start date. This takes a date with `YYYY-MM-DD` format, and cannot be set unless there is an accompanying due date.
    start-on: option<string>
  }

  /// *Conditional*
  record story-response-dates {
    /// The UTC date and time on which this task is due, or null if the task has no due time. This takes an ISO 8601 date string in UTC and should not be used together with `due_on`.
    due-at: option<string>,
    /// The localized day on which this goal is due. This takes a date with format `YYYY-MM-DD`.
    due-on: option<string>,
    /// The day on which work for this goal begins, or null if the goal has no start date. This takes a date with `YYYY-MM-DD` format, and cannot be set unless there is an accompanying due date.
    start-on: option<string>
  }

  record section-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the section (i.e. the text displayed as the section header).
    name: option<string>
  }

  record story-response-old-date-value {
    /// The UTC date and time on which this task is due, or null if the task has no due time. This takes an ISO 8601 date string in UTC and should not be used together with `due_on`.
    due-at: option<string>,
    /// The localized day on which this goal is due. This takes a date with format `YYYY-MM-DD`.
    due-on: option<string>,
    /// The day on which work for this goal begins, or null if the goal has no start date. This takes a date with `YYYY-MM-DD` format, and cannot be set unless there is an accompanying due date.
    start-on: option<string>
  }

  /// A collection of rich text that will be displayed as a preview to another app.
  /// 
  /// This is read-only except for a small group of whitelisted apps.
  record preview {
    /// Some fallback text to display if unable to display the full preview.
    fallback: option<string>,
    /// Text to display in the footer.
    footer: option<string>,
    /// Text to display in the header.
    header: option<string>,
    /// Where the header will link to.
    header-link: option<string>,
    /// HTML formatted text for the body of the preview.
    html-text: option<string>,
    /// Text for the body of the preview.
    text: option<string>,
    /// Text to display as the title.
    title: option<string>,
    /// Where to title will link to.
    title-link: option<string>
  }

  record project-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the project. This is generally a short sentence fragment that fits on a line in the UI for maximum readability. However, it can be longer.
    name: option<string>
  }

  record story-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The time at which this resource was created.
    created-at: option<string>,
    created-by: option<user-compact>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    resource-subtype: option<string>,
    /// *Create-only*. Human-readable text for the story or comment.
    /// This will not include the name of the creator.
    text: option<string>
  }

  record tag-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the tag. This is generally a short sentence fragment that fits on a line in the UI for maximum readability. However, it can be longer.
    name: option<string>
  }

  record story-response-target {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the task.
    name: option<string>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    /// The resource_subtype `milestone` represent a single moment in time. This means tasks with this subtype cannot have a start_date.
    resource-subtype: option<task-compact-resource-subtype-enum>
  }

  record story-request {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The time at which this resource was created.
    created-at: option<string>,
    /// [Opt In](/docs/input-output-options). HTML formatted text for a comment. This will not include the name of the creator.
    html-text: option<string>,
    /// *Conditional*. Whether the story should be pinned on the resource.
    is-pinned: option<bool>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    resource-subtype: option<string>,
    /// The name of the sticker in this story. `null` if there is no sticker.
    sticker-name: option<story-response-sticker-name-enum>,
    /// The plain text of the comment to add. Cannot be used with html_text.
    text: option<string>
  }

  record update-story-response {
    data: option<story-response>
  }

  record delete-story-response {
    data: option<list<empty-response-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record empty-response-entry {
    key: string,
    value: string
  }

  record get-stories-for-task-response {
    data: option<string>
  }

  record create-story-for-task-response {
    data: option<story-response>
  }

  variant get-story-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant update-story-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-story-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-stories-for-task-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant create-story-for-task-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get a story
  record get-story-params {
    /// Globally unique identifier for the story.
    story-gid: string,
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>,
    /// Results per page.
    /// The number of objects to return per page. The value must be between 1 and 100.
    limit: option<s32>,
    /// Offset token.
    /// An offset to the next page returned by the API. A pagination request will return an offset token, which can be used as an input parameter to the next request. If an offset is not passed in, the API will return the first page of results.
    offset: option<string>
  }
  get-story: func(params: get-story-params) -> result<get-story-response, get-story-error>;

  /// Update a story
  record update-story-params {
    /// Globally unique identifier for the story.
    story-gid: string,
    /// Provides “pretty” output.
