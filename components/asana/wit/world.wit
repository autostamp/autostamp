interface custom-field-settings {
  enum custom-field-setting-response-custom-field-resource-subtype-enum {
    text,
    enum-op,
    multi-enum,
    number,
    date,
    people,
  }

  enum custom-field-setting-response-custom-field-type-op-enum {
    text,
    enum-op,
    multi-enum,
    number,
  }

  enum custom-field-setting-response-custom-field-asana-created-field-enum {
    a-v-requirements,
    account-name,
