/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export attachments;
  export batch-api;
  export custom-fields;
  export events;
  export goal-relationships;
  export goals;
  export jobs;
  export organization-exports;
  export portfolio-memberships;
  export portfolios;
  export custom-field-settings;
  export project-briefs;
  export project-memberships;
  export project-statuses;
  export project-templates;
  export projects;
  export sections;
  export tasks;
  export status-updates;
  export stories;
  export tags;
  export team-memberships;
  export teams;
  export users;
  export time-periods;
  export user-task-lists;
  export workspace-memberships;
  export webhooks;
  export workspaces;
  export audit-log-api;
  export typeahead;
}
