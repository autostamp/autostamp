    data: option<tag-response>
  }

  record update-tag-response {
    data: option<tag-response>
  }

  record delete-tag-response {
    data: option<list<empty-response-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record empty-response-entry {
    key: string,
    value: string
  }

  record get-tags-for-task-response {
    data: option<list<tag-compact>>
  }

  record get-tags-for-workspace-response {
    data: option<list<tag-compact>>
  }

  record create-tag-for-workspace-response {
    data: option<tag-response>
  }

