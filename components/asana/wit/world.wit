  update-section: func(params: update-section-params) -> result<update-section-response, update-section-error>;

  /// Delete a section
  record delete-section-params {
    /// The globally unique identifier for the section.
    section-gid: string,
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>
  }
  delete-section: func(params: delete-section-params) -> result<delete-section-response, delete-section-error>;

  /// Add task to section
  record add-task-for-section-params {
    /// The globally unique identifier for the section.
    section-gid: string,
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>,
    data: option<section-task-insert-request>
  }
  add-task-for-section: func(params: add-task-for-section-params) -> result<add-task-for-section-response, add-task-for-section-error>;

}

interface tasks {
  enum task-compact-resource-subtype-enum {
    default-task,
    milestone,
    section,
    approval,
  }

  enum task-request-approval-status-enum {
    pending,
    approved,
    rejected,
    changes-requested,
  }

  enum task-request-assignee-status-enum {
    today,
    upcoming,
    later,
    new,
    inbox,
  }

  enum custom-field-response-resource-subtype-enum {
    text,
    enum-op,
    multi-enum,
    number,
    date,
    people,
  }

  enum custom-field-response-type-op-enum {
    text,
    enum-op,
    multi-enum,
    number,
  }

  enum custom-field-response-asana-created-field-enum {
    a-v-requirements,
