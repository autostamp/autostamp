interface goals {
  enum status-update-compact-resource-subtype-enum {
    project-status-update,
    portfolio-status-update,
    goal-status-update,
  }

  enum goal-response-metric-progress-source-enum {
    manual,
    subgoal-progress,
    project-task-completion,
    project-milestone-completion,
    external,
  }

  enum goal-response-metric-resource-subtype-enum {
    number,
  }

  enum goal-response-metric-unit-enum {
    none,
    currency,
    percentage,
  }

  enum goal-response-time-period-period-enum {
    fy,
    h1,
    h2,
    q1,
    q2,
    q3,
    q4,
  }

  record get-goals-response {
    data: option<list<goal-compact>>
  }

  record goal-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the goal.
    name: option<string>,
    owner: option<goal-compact-owner>
  }

  record goal-compact-owner {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Read-only except when same user as requester*. The user’s name.
    name: option<string>
  }

  record goal-request {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The localized day on which this goal is due. This takes a date with format `YYYY-MM-DD`.
    due-on: option<string>,
    /// The notes of the goal with formatting as HTML.
    html-notes: option<string>,
    /// *Conditional*. This property is only present when the `workspace` provided is an organization. Whether the goal belongs to the `workspace` (and is listed as part of the workspace’s goals) or not. If it isn’t a workspace-level goal, it is a team-level goal, and is associated with the goal’s team.
    is-workspace-level: option<bool>,
    /// True if the goal is liked by the authorized user, false if not.
    liked: option<bool>,
    /// The name of the goal.
    name: option<string>,
    /// Free-form textual information associated with the goal (i.e. its description).
    notes: option<string>,
    /// The day on which work for this goal begins, or null if the goal has no start date. This takes a date with `YYYY-MM-DD` format, and cannot be set unless there is an accompanying due date.
    start-on: option<string>,
    /// The current status of this goal. When the goal is open, its status can be `green`, `yellow`, and `red` to reflect "On Track", "At Risk", and "Off Track", respectively. When the goal is closed, the value can be `missed`, `achieved`, `partial`, or `dropped`.
    /// *Note* you can only write to this property if `metric` is set.
    status: option<string>,
    followers: option<list<string>>,
    /// The `gid` of a user.
    owner: option<string>,
    /// *Conditional*. This property is only present when the `workspace` provided is an organization.
    team: option<string>,
    /// The `gid` of a time period.
    time-period: option<string>,
    /// The `gid` of a workspace.
    workspace: option<string>
  }

  record create-goal-response {
    data: option<goal-response>
  }

  record goal-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The localized day on which this goal is due. This takes a date with format `YYYY-MM-DD`.
    due-on: option<string>,
    /// The notes of the goal with formatting as HTML.
    html-notes: option<string>,
    /// *Conditional*. This property is only present when the `workspace` provided is an organization. Whether the goal belongs to the `workspace` (and is listed as part of the workspace’s goals) or not. If it isn’t a workspace-level goal, it is a team-level goal, and is associated with the goal’s team.
    is-workspace-level: option<bool>,
    /// True if the goal is liked by the authorized user, false if not.
    liked: option<bool>,
    /// The name of the goal.
    name: option<string>,
    /// Free-form textual information associated with the goal (i.e. its description).
    notes: option<string>,
    /// The day on which work for this goal begins, or null if the goal has no start date. This takes a date with `YYYY-MM-DD` format, and cannot be set unless there is an accompanying due date.
    start-on: option<string>,
    /// The current status of this goal. When the goal is open, its status can be `green`, `yellow`, and `red` to reflect "On Track", "At Risk", and "Off Track", respectively. When the goal is closed, the value can be `missed`, `achieved`, `partial`, or `dropped`.
    /// *Note* you can only write to this property if `metric` is set.
    status: option<string>,
    /// The latest `status_update` posted to this goal.
    current-status-update: option<status-update-compact>,
    /// Array of users who are members of this goal.
    followers: option<list<user-compact>>,
    /// Array of likes for users who have liked this goal.
    likes: option<list<like>>,
    metric: option<goal-response-metric>,
    /// The number of users who have liked this goal.
    num-likes: option<s32>,
    owner: option<goal-response-owner>,
    /// *Conditional*. This property is only present when the `workspace` provided is an organization.
    team: option<goal-response-team>,
    time-period: option<goal-response-time-period>,
    workspace: option<goal-response-workspace>
  }

  record status-update-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    /// The `resource_subtype`s for `status` objects represent the type of their parent.
    resource-subtype: option<status-update-compact-resource-subtype-enum>,
    /// The title of the status update.
    title: option<string>
  }

  record user-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Read-only except when same user as requester*. The user’s name.
    name: option<string>
  }

  /// An object to represent a user's like.
  record like {
    /// Globally unique identifier of the object, as a string.
    gid: option<string>,
    user: option<user-compact>
  }

  record goal-response-metric {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// ISO 4217 currency code to format this custom field. This will be null if the `unit` is not `currency`.
    currency-code: option<string>,
    /// This string is the current value of a goal metric of type string.
    current-display-value: option<string>,
    /// This number is the current value of a goal metric of type number.
    current-number-value: option<f64>,
    /// This number is the start value of a goal metric of type number.
    initial-number-value: option<f64>,
    /// *Conditional*. Only relevant for goal metrics of type ‘Number’. This field dictates the number of places after the decimal to round to, i.e. 0 is integer values, 1 rounds to the nearest tenth, and so on. Must be between 0 and 6, inclusive.
    /// For percentage format, this may be unintuitive, as a value of 0.25 has a precision of 0, while a value of 0.251 has a precision of 1. This is due to 0.25 being displayed as 25%.
    precision: option<s32>,
    /// This field defines how the progress value of a goal metric is being calculated. A goal's progress can be provided manually by the user, calculated automatically from contributing subgoals or projects, or managed by an integration with an external data source, such as Salesforce.
    progress-source: option<goal-response-metric-progress-source-enum>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    resource-subtype: option<goal-response-metric-resource-subtype-enum>,
    /// This number is the end value of a goal metric of type number. This number cannot equal `initial_number_value`.
    target-number-value: option<f64>,
    /// A supported unit of measure for the goal metric, or none.
    unit: option<goal-response-metric-unit-enum>,
    /// *Conditional*. Only relevant for `progress_source` of type `external`. This boolean indicates whether the requester has the ability to update the current value of this metric. This returns `true` if the external metric was created by the requester, `false` otherwise.
    can-manage: option<bool>
  }

  record goal-response-owner {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Read-only except when same user as requester*. The user’s name.
    name: option<string>
  }

  /// *Conditional*. This property is only present when the `workspace` provided is an organization.
  record goal-response-team {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the team.
    name: option<string>
  }

  record goal-response-time-period {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// A string representing the cadence code and the fiscal year.
    display-name: option<string>,
    /// The localized end date of the time period in `YYYY-MM-DD` format.
    end-on: option<string>,
    /// The cadence and index of the time period. The value is one of: `FY`, `H1`, `H2`, `Q1`, `Q2`, `Q3`, or `Q4`.
    period: option<goal-response-time-period-period-enum>,
    /// The localized start date of the time period in `YYYY-MM-DD` format.
    start-on: option<string>
  }

  record goal-response-workspace {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the workspace.
    name: option<string>
  }

  record get-goal-response {
    data: option<goal-response>
  }

  record update-goal-response {
    data: option<goal-response>
  }

  record delete-goal-response {
    data: option<list<empty-response-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record empty-response-entry {
    key: string,
    value: string
  }

  record task-add-followers-request {
    /// An array of strings identifying users. These can either be the string "me", an email, or the gid of a user.
    followers: list<string>
  }

  record add-followers-response {
    data: option<goal-response>
  }

  record get-parent-goals-for-goal-response {
    data: option<list<goal-compact>>
  }

  record remove-followers-response {
    data: option<goal-response>
  }

  record goal-metric-request {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// ISO 4217 currency code to format this custom field. This will be null if the `unit` is not `currency`.
    currency-code: option<string>,
    /// This string is the current value of a goal metric of type string.
    current-display-value: option<string>,
    /// This number is the current value of a goal metric of type number.
    current-number-value: option<f64>,
    /// This number is the start value of a goal metric of type number.
    initial-number-value: option<f64>,
    /// *Conditional*. Only relevant for goal metrics of type ‘Number’. This field dictates the number of places after the decimal to round to, i.e. 0 is integer values, 1 rounds to the nearest tenth, and so on. Must be between 0 and 6, inclusive.
    /// For percentage format, this may be unintuitive, as a value of 0.25 has a precision of 0, while a value of 0.251 has a precision of 1. This is due to 0.25 being displayed as 25%.
    precision: option<s32>,
    /// This field defines how the progress value of a goal metric is being calculated. A goal's progress can be provided manually by the user, calculated automatically from contributing subgoals or projects, or managed by an integration with an external data source, such as Salesforce.
    progress-source: option<goal-response-metric-progress-source-enum>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    resource-subtype: option<goal-response-metric-resource-subtype-enum>,
    /// This number is the end value of a goal metric of type number. This number cannot equal `initial_number_value`.
    target-number-value: option<f64>,
    /// A supported unit of measure for the goal metric, or none.
    unit: option<goal-response-metric-unit-enum>
  }

  record create-goal-metric-response {
    data: option<goal-response>
  }

  record goal-metric-current-value-request {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Conditional*. This number is the current value of a goal metric of type number.
    current-number-value: option<f64>
  }

  record update-goal-metric-response {
    data: option<goal-response>
  }

  variant get-goals-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant create-goal-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-goal-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant update-goal-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-goal-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant add-followers-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-parent-goals-for-goal-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant remove-followers-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant create-goal-metric-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant update-goal-metric-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get goals
  record get-goals-params {
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
