interface project-templates {
  enum project-template-response-color-enum {
    dark-pink,
    dark-green,
    dark-blue,
    dark-red,
    dark-teal,
    dark-brown,
    dark-orange,
    dark-purple,
    dark-warm-gray,
    light-pink,
    light-green,
    light-blue,
    light-red,
    light-teal,
    light-brown,
    light-orange,
    light-purple,
    light-warm-gray,
  }

  enum task-compact-resource-subtype-enum {
    default-task,
    milestone,
    section,
    approval,
  }

  enum job-response-status-enum {
    not-started,
    in-progress,
    succeeded,
    failed,
  }

  record get-project-templates-response {
    data: option<list<project-template-compact>>
  }

  record project-template-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the project template.
    name: option<string>
  }

  record get-project-template-response {
    data: option<project-template-response>
  }

  record project-template-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the project template.
    name: option<string>,
    /// Color of the project template.
    color: option<project-template-response-color-enum>,
    /// Free-form textual information associated with the project template
    description: option<string>,
    /// The description of the project template with formatting as HTML.
    html-description: option<string>,
    /// The current owner of the project template, may be null.
    owner: option<user-compact>,
    /// True if the project template is public to its team.
    public: option<bool>,
    /// Array of date variables in this project template. Calendar dates must be provided for these variables when instantiating a project.
    requested-dates: option<list<date-variable-compact>>,
    team: option<team-compact>
  }

  record user-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Read-only except when same user as requester*. The user’s name.
    name: option<string>
  }

  record date-variable-compact {
    /// The description of what the date variable is used for when instantiating a project.
    description: option<string>,
    /// Globally unique identifier of the date field in the project template. A value of `1` refers to the project start date, while `2` refers to the project due date.
    gid: option<string>,
    /// The name of the date variable.
    name: option<string>
  }

  record team-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the team.
    name: option<string>
  }

  record project-template-instantiate-project-request {
    /// *Optional*. If set to `true`, the endpoint returns an "Unprocessable Entity" error if you fail to provide a calendar date value for any date variable. If set to `false`, a default date is used for each unfulfilled date variable (e.g., the current date is used as the Start Date of a project).
    is-strict: option<bool>,
    /// The name of the new project.
    name: string,
    /// Sets the project to public to its team.
    public: bool,
    /// Array of mappings of date variables to calendar dates.
    requested-dates: option<list<date-variable-request>>,
    /// *Conditional*. Sets the team of the new project. If the project template exists in an _organization_, you must specify a value for `team` and not `workspace`.
    team: option<string>,
    /// *Conditional*. Sets the workspace of the new project. If the project template exists in a _workspace_, you must specify a value for `workspace` and not `team`.
    workspace: option<string>
  }

  record date-variable-request {
    /// Globally unique identifier of the date field in the project template. A value of `1` refers to the project start date, while `2` refers to the project due date.
    gid: option<string>,
    /// The date with which the date variable should be replaced when instantiating a project. This takes a date with `YYYY-MM-DD` format.
    value: option<string>
  }

  record instantiate-project-response {
    data: option<job-response>
  }

  record job-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    new-project: option<project-compact>,
    new-project-template: option<project-template-compact>,
    new-task: option<task-compact>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    resource-subtype: option<string>,
    /// The current status of this job. The value is one of: `not_started`, `in_progress`, `succeeded`, or `failed`.
    status: option<job-response-status-enum>
  }

  record project-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the project. This is generally a short sentence fragment that fits on a line in the UI for maximum readability. However, it can be longer.
    name: option<string>
  }

  record task-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the task.
    name: option<string>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    /// The resource_subtype `milestone` represent a single moment in time. This means tasks with this subtype cannot have a start_date.
    resource-subtype: option<task-compact-resource-subtype-enum>
  }

  record get-project-templates-for-team-response {
    data: option<list<project-template-compact>>
  }

  variant get-project-templates-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-project-template-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant instantiate-project-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-project-templates-for-team-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get multiple project templates
  record get-project-templates-params {
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
