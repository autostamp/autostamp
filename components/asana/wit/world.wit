/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `personalAccessToken` | `Authorization: Bearer <secret>` |
package autostamp:asana@0.6.0;

interface attachments {
  enum attachment-request-resource-subtype-enum {
    asana,
    dropbox,
    gdrive,
    onedrive,
    box,
    vimeo,
    external,
  }

  enum attachment-response-parent-resource-subtype-enum {
    default-task,
    milestone,
    section,
    approval,
  }

  record get-attachments-for-object-response {
    data: option<list<attachment-compact>>
  }

  record attachment-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the file.
    name: option<string>,
    /// The service hosting the attachment. Valid values are `asana`, `dropbox`, `gdrive`, `onedrive`, `box`, `vimeo`, and `external`.
    resource-subtype: option<string>
  }

  record create-attachment-for-object-response {
    data: option<attachment-response>
  }

  record attachment-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the file.
    name: option<string>,
    /// The service hosting the attachment. Valid values are `asana`, `dropbox`, `gdrive`, `onedrive`, `box`, `vimeo`, and `external`.
    resource-subtype: option<string>,
    /// Whether the attachment is connected to the app making the request for the purposes of showing an app components widget. Only present when the `resource_subtype` is `external` or `gdrive`.
    connected-to-app: option<bool>,
    /// The time at which this resource was created.
    created-at: option<string>,
    /// The URL containing the content of the attachment.
    /// *Note:* May be null if the attachment is hosted by [Box](https://www.box.com/) and will be null if the attachment is a Video Message hosted by [Vimeo](https://vimeo.com/). If present, this URL may only be valid for two minutes from the time of retrieval. You should avoid persisting this URL somewhere and just refresh it on demand to ensure you do not keep stale URLs.
    download-url: option<string>,
    /// The service hosting the attachment. Valid values are `asana`, `dropbox`, `gdrive`, `box`, and `vimeo`.
    host: option<string>,
    parent: option<attachment-response-parent>,
    permanent-url: option<string>,
    /// The size of the attachment in bytes. Only present when the `resource_subtype` is `asana`.
    size: option<s32>,
    /// The URL where the attachment can be viewed, which may be friendlier to users in a browser than just directing them to a raw file. May be null if no view URL exists for the service.
    view-url: option<string>
  }

  record attachment-response-parent {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the task.
    name: option<string>,
    /// The subtype of this resource. Different subtypes retain many of the same fields and behavior, but may render differently in Asana or represent resources with different semantic meaning.
    /// The resource_subtype `milestone` represent a single moment in time. This means tasks with this subtype cannot have a start_date.
    resource-subtype: option<attachment-response-parent-resource-subtype-enum>
  }

  record get-attachment-response {
    data: option<attachment-response>
  }

  record delete-attachment-response {
    data: option<list<empty-response-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record empty-response-entry {
    key: string,
    value: string
  }

  variant get-attachments-for-object-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant create-attachment-for-object-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-attachment-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    failed-dependency(string),
    internal-server-error(string),
    not-implemented(string),
    service-unavailable(string),
    gateway-timeout(string),
    other(string)
  }

  variant delete-attachment-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Get attachments from an object
  record get-attachments-for-object-params {
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>,
    /// Results per page.
    /// The number of objects to return per page. The value must be between 1 and 100.
    limit: option<s32>,
    /// Offset token.
    /// An offset to the next page returned by the API. A pagination request will return an offset token, which can be used as an input parameter to the next request. If an offset is not passed in, the API will return the first page of results.
    offset: option<string>,
    /// Globally unique identifier for object to fetch statuses from. Must be a GID for a `project`, `project_brief`, or `task`.
    parent: string
  }
  get-attachments-for-object: func(params: get-attachments-for-object-params) -> result<get-attachments-for-object-response, get-attachments-for-object-error>;

  /// Upload an attachment
  record create-attachment-for-object-params {
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>,
    /// *Optional*. Only relevant for external attachments with a parent task. A boolean indicating whether the current app should be connected with the attachment for the purposes of showing an app components widget. Requires the app to have been added to a project the parent task is in.
    connect-to-app: option<bool>,
    /// Required for `asana` attachments.
    file: option<string>,
    /// The name of the external resource being attached. Required for attachments of type `external`.
    name: option<string>,
    /// Required identifier of the parent task, project, or project_brief, as a string.
    parent: option<string>,
    /// The type of the attachment. Must be one of the given values. If not specified, a file attachment of type `asana` will be assumed. Note that if the value of `resource_subtype` is `external`, a `parent`, `name`, and `url` must also be provided.
    resource-subtype: option<attachment-request-resource-subtype-enum>,
    /// The URL of the external resource being attached. Required for attachments of type `external`.
    url: option<string>
  }
  create-attachment-for-object: func(params: create-attachment-for-object-params) -> result<create-attachment-for-object-response, create-attachment-for-object-error>;

  /// Get an attachment
  record get-attachment-params {
    /// Globally unique identifier for the attachment.
    attachment-gid: string,
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>
  }
  get-attachment: func(params: get-attachment-params) -> result<get-attachment-response, get-attachment-error>;

  /// Delete an attachment
  record delete-attachment-params {
    /// Globally unique identifier for the attachment.
    attachment-gid: string,
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>
  }
  delete-attachment: func(params: delete-attachment-params) -> result<delete-attachment-response, delete-attachment-error>;

}


interface batch-api {
  enum batch-request-action-method-enum {
    get,
    post,
    put,
    delete,
    patch,
    head,
  }

  /// A request object for use in a batch request.
  record batch-request {
    actions: option<list<batch-request-action>>
  }

  /// An action object for use in a batch request.
  record batch-request-action {
    /// For `GET` requests, this should be a map of query parameters you would have normally passed in the URL. Options and pagination are not accepted here; put them in `options` instead. For `POST`, `PATCH`, and `PUT` methods, this should be the content you would have normally put in the data field of the body.
    data: option<list<batch-request-action-data-entry>>,
    /// The HTTP method you wish to emulate for the action.
    method: batch-request-action-method-enum,
    /// Pagination (`limit` and `offset`) and output options (`fields` or `expand`) for the action. “Pretty” JSON output is not an available option on individual actions; if you want pretty output, specify that option on the parent request.
    options: option<batch-request-action-options>,
    /// The path of the desired endpoint relative to the API’s base URL. Query parameters are not accepted here; put them in `data` instead.
    relative-path: string
  }

  /// one entry of a string-keyed map (free-form object)
  record batch-request-action-data-entry {
    key: string,
    value: string
  }

  /// Pagination (`limit` and `offset`) and output options (`fields` or `expand`) for the action. “Pretty” JSON output is not an available option on individual actions; if you want pretty output, specify that option on the parent request.
  record batch-request-action-options {
    /// The fields to retrieve in the request.
    fields: option<list<string>>,
    /// Pagination limit for the request.
    limit: option<s32>,
    /// Pagination offset for the request.
    offset: option<s32>
  }

  record create-batch-request-response {
    data: option<list<batch-response>>
  }

  /// A response object returned from a batch request.
  record batch-response {
    /// The JSON body that the invoked endpoint returned.
    body: option<list<batch-response-body-entry>>,
    /// A map of HTTP headers specific to this result. This is primarily used for returning a `Location` header to accompany a `201 Created` result.  The parent HTTP response will contain all common headers.
    headers: option<list<batch-response-headers-entry>>,
    /// The HTTP status code that the invoked endpoint returned.
    status-code: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record batch-response-body-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record batch-response-headers-entry {
    key: string,
    value: string
  }

  variant create-batch-request-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Submit parallel requests
  record create-batch-request-params {
    /// Provides “pretty” output.
    /// Provides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging.
    opt-pretty: option<bool>,
    /// Defines fields to return.
    /// Some requests return *compact* representations of objects in order to conserve resources and complete the request more efficiently. Other times requests return more information than you may need. This option allows you to list the exact set of fields that the API should be sure to return for the objects. The field names should be provided as paths, described below.
    opt-fields: option<list<string>>,
    data: option<batch-request>
  }
  create-batch-request: func(params: create-batch-request-params) -> result<create-batch-request-response, create-batch-request-error>;

}

interface custom-fields {
  enum custom-field-request-resource-subtype-enum {
    text,
    enum-op,
    multi-enum,
    number,
    date,
    people,
  }

  enum custom-field-request-type-op-enum {
    text,
    enum-op,
    multi-enum,
    number,
  }

  enum custom-field-request-asana-created-field-enum {
    a-v-requirements,
    account-name,
    actionable,
    align-shipping-link,
    align-status,
    allotted-time,
    appointment,
    approval-stage,
    approved,
    article-series,
    board-committee,
    browser,
    campaign-audience,
    campaign-project-status,
    campaign-regions,
    channel-primary,
    client-topic-type,
    complete-by,
    contact,
    contact-email-address,
    content-channels,
    content-channels-needed,
    content-stage,
    content-type,
    contract,
    contract-status,
    cost,
    creation-stage,
    creative-channel,
    creative-needed,
    creative-needs,
    data-sensitivity,
    deal-size,
    delivery-appt,
    delivery-appt-date,
    department,
    department-responsible,
    design-request-needed,
    design-request-type,
    discussion-category,
    do-this-task,
    editorial-content-status,
    editorial-content-tag,
    editorial-content-type,
    effort,
    effort-level,
    est-completion-date,
    estimated-time,
    estimated-value,
    expected-cost,
    external-steps-needed,
    favorite-idea,
    feedback-type,
    financial,
    funding-amount,
    grant-application-process,
    hiring-candidate-status,
    idea-status,
    ids-link,
    ids-patient-link,
    implementation-stage,
    insurance,
    interview-area,
    interview-question-score,
    itero-scan-link,
    job-s-applied-to,
    lab,
    launch-status,
    lead-status,
    localization-language,
    localization-market-team,
    localization-status,
    meeting-minutes,
    meeting-needed,
    minutes,
    mrr,
    must-localize,
    name-of-foundation,
    need-to-follow-up,
    next-appointment,
    next-steps-sales,
    num-people,
    number-of-user-reports,
    office-location,
    onboarding-activity,
    owner,
    participants-needed,
    patient-date-of-birth,
    patient-email,
    patient-phone,
    patient-status,
    phone-number,
    planning-category,
    point-of-contact,
    position,
    post-format,
    prescription,
    priority,
    priority-level,
    product,
    product-stage,
    progress,
    project-size,
    project-status,
    proposed-budget,
    publish-status,
    reason-for-scan,
    referral,
    request-type,
    research-status,
    responsible-department,
    responsible-team,
    risk-assessment-status,
    room-name,
    sales-counterpart,
    sentiment,
    shipping-link,
    social-channels,
    stage,
    status,
    status-design,
    status-of-initiative,
    system-setup,
    task-progress,
    team,
    team-marketing,
    team-responsible,
    time-it-takes-to-complete-tasks,
    timeframe,
    treatment-type,
    type-work-requests-it,
    use-agency,
    user-name,
    vendor-category,
    vendor-type,
    word-count,
  }

  enum custom-field-request-custom-label-position-enum {
    prefix,
    suffix,
  }

  enum custom-field-request-format-enum {
    currency,
    identifier,
    percentage,
    custom,
    none,
  }

  record custom-field-request {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Conditional*. Only relevant for custom fields of type `date`. This object reflects the chosen date (and optionally, time) value of a `date` custom field. If no date is selected, the value of `date_value` will be `null`.
    date-value: option<custom-field-request-date-value>,
    /// A string representation for the value of the custom field. Integrations that don't require the underlying type should use this field to read values. Using this field will future-proof an app against new custom field types.
    display-value: option<string>,
    /// *Conditional*. Determines if the custom field is enabled or not.
    enabled: option<bool>,
    /// *Conditional*. Only relevant for custom fields of type `enum`. This array specifies the possible values which an `enum` custom field can adopt. To modify the enum options, refer to [working with enum options](/docs/create-an-enum-option).
    enum-options: option<list<enum-option>>,
    enum-value: option<custom-field-request-enum-value>,
    /// *Conditional*. Only relevant for custom fields of type `multi_enum`. This object is the chosen values of a `multi_enum` custom field.
    multi-enum-values: option<list<enum-option>>,
    /// The name of the custom field.
    name: option<string>,
    /// *Conditional*. This number is the value of a `number` custom field.
    number-value: option<f64>,
    /// The type of the custom field. Must be one of the given values.
    resource-subtype: option<custom-field-request-resource-subtype-enum>,
    /// *Conditional*. This string is the value of a `text` custom field.
    text-value: option<string>,
    /// *Deprecated: new integrations should prefer the resource_subtype field.* The type of the custom field. Must be one of the given values.
    type-op: option<custom-field-request-type-op-enum>,
    /// *Conditional*. A unique identifier to associate this field with the template source of truth.
    asana-created-field: option<custom-field-request-asana-created-field-enum>,
    /// ISO 4217 currency code to format this custom field. This will be null if the `format` is not `currency`.
    currency-code: option<string>,
    /// This is the string that appears next to the custom field value. This will be null if the `format` is not `custom`.
    custom-label: option<string>,
    /// Only relevant for custom fields with `custom` format. This depicts where to place the custom label. This will be null if the `format` is not `custom`.
    custom-label-position: option<custom-field-request-custom-label-position-enum>,
    /// [Opt In](/docs/input-output-options). The description of the custom field.
    description: option<string>,
    /// The format of this custom field.
    format: option<custom-field-request-format-enum>,
    /// *Conditional*. This flag describes whether a follower of a task with this field should receive inbox notifications from changes to this field.
    has-notifications-enabled: option<bool>,
    /// This flag describes whether this custom field is available to every container in the workspace. Before project-specific custom fields, this field was always true.
    is-global-to-workspace: option<bool>,
    /// Only relevant for custom fields of type ‘Number’. This field dictates the number of places after the decimal to round to, i.e. 0 is integer values, 1 rounds to the nearest tenth, and so on. Must be between 0 and 6, inclusive.
    /// For percentage format, this may be unintuitive, as a value of 0.25 has a precision of 0, while a value of 0.251 has a precision of 1. This is due to 0.25 being displayed as 25%.
    precision: option<s32>,
    /// *Conditional*. Only relevant for custom fields of type `people`. This array of user GIDs reflects the users to be written to a `people` custom field. Note that *write* operations will replace existing users (if any) in the custom field with the users specified in this array.
    people-value: option<list<string>>,
    /// *Create-Only* The workspace to create a custom field in.
    workspace: string
  }

  /// *Conditional*. Only relevant for custom fields of type `date`. This object reflects the chosen date (and optionally, time) value of a `date` custom field. If no date is selected, the value of `date_value` will be `null`.
  record custom-field-request-date-value {
    /// A string representing the date in YYYY-MM-DD format.
    date: option<string>,
    /// A string representing the date in ISO 8601 format. If no time value is selected, the value of `date-time` will be `null`.
    date-time: option<string>
  }

  record enum-option {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The color of the enum option. Defaults to ‘none’.
    color: option<string>,
    /// Whether or not the enum option is a selectable value for the custom field.
    enabled: option<bool>,
    /// The name of the enum option.
    name: option<string>
  }

  record custom-field-request-enum-value {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The color of the enum option. Defaults to ‘none’.
    color: option<string>,
    /// Whether or not the enum option is a selectable value for the custom field.
    enabled: option<bool>,
    /// The name of the enum option.
    name: option<string>
  }

  record create-custom-field-response {
    data: option<custom-field-response>
  }

  record custom-field-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Conditional*. Only relevant for custom fields of type `date`. This object reflects the chosen date (and optionally, time) value of a `date` custom field. If no date is selected, the value of `date_value` will be `null`.
    date-value: option<custom-field-response-date-value>,
    /// A string representation for the value of the custom field. Integrations that don't require the underlying type should use this field to read values. Using this field will future-proof an app against new custom field types.
    display-value: option<string>,
    /// *Conditional*. Determines if the custom field is enabled or not.
    enabled: option<bool>,
    /// *Conditional*. Only relevant for custom fields of type `enum`. This array specifies the possible values which an `enum` custom field can adopt. To modify the enum options, refer to [working with enum options](/docs/create-an-enum-option).
    enum-options: option<list<enum-option>>,
    enum-value: option<custom-field-response-enum-value>,
    /// *Conditional*. Only relevant for custom fields of type `multi_enum`. This object is the chosen values of a `multi_enum` custom field.
    multi-enum-values: option<list<enum-option>>,
    /// The name of the custom field.
    name: option<string>,
    /// *Conditional*. This number is the value of a `number` custom field.
    number-value: option<f64>,
    /// The type of the custom field. Must be one of the given values.
    resource-subtype: option<custom-field-request-resource-subtype-enum>,
    /// *Conditional*. This string is the value of a `text` custom field.
    text-value: option<string>,
    /// *Deprecated: new integrations should prefer the resource_subtype field.* The type of the custom field. Must be one of the given values.
    type-op: option<custom-field-request-type-op-enum>,
    /// *Conditional*. A unique identifier to associate this field with the template source of truth.
    asana-created-field: option<custom-field-request-asana-created-field-enum>,
    /// ISO 4217 currency code to format this custom field. This will be null if the `format` is not `currency`.
    currency-code: option<string>,
    /// This is the string that appears next to the custom field value. This will be null if the `format` is not `custom`.
    custom-label: option<string>,
    /// Only relevant for custom fields with `custom` format. This depicts where to place the custom label. This will be null if the `format` is not `custom`.
    custom-label-position: option<custom-field-request-custom-label-position-enum>,
    /// [Opt In](/docs/input-output-options). The description of the custom field.
    description: option<string>,
    /// The format of this custom field.
    format: option<custom-field-request-format-enum>,
    /// *Conditional*. This flag describes whether a follower of a task with this field should receive inbox notifications from changes to this field.
    has-notifications-enabled: option<bool>,
    /// This flag describes whether this custom field is available to every container in the workspace. Before project-specific custom fields, this field was always true.
    is-global-to-workspace: option<bool>,
    /// Only relevant for custom fields of type ‘Number’. This field dictates the number of places after the decimal to round to, i.e. 0 is integer values, 1 rounds to the nearest tenth, and so on. Must be between 0 and 6, inclusive.
    /// For percentage format, this may be unintuitive, as a value of 0.25 has a precision of 0, while a value of 0.251 has a precision of 1. This is due to 0.25 being displayed as 25%.
    precision: option<s32>,
    created-by: option<user-compact>,
    /// *Conditional*. Only relevant for custom fields of type `people`. This array of [compact user](/docs/user-compact) objects reflects the values of a `people` custom field.
    people-value: option<list<user-compact>>
  }

  /// *Conditional*. Only relevant for custom fields of type `date`. This object reflects the chosen date (and optionally, time) value of a `date` custom field. If no date is selected, the value of `date_value` will be `null`.
  record custom-field-response-date-value {
    /// A string representing the date in YYYY-MM-DD format.
    date: option<string>,
    /// A string representing the date in ISO 8601 format. If no time value is selected, the value of `date-time` will be `null`.
    date-time: option<string>
  }

  record custom-field-response-enum-value {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
