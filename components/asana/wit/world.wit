interface tags {
  enum tag-request-color-enum {
    dark-pink,
    dark-green,
    dark-blue,
    dark-red,
    dark-teal,
    dark-brown,
    dark-orange,
    dark-purple,
    dark-warm-gray,
    light-pink,
    light-green,
    light-blue,
    light-red,
    light-teal,
    light-brown,
    light-orange,
    light-purple,
    light-warm-gray,
  }

  record get-tags-response {
    data: option<list<tag-compact>>
  }

  record tag-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the tag. This is generally a short sentence fragment that fits on a line in the UI for maximum readability. However, it can be longer.
    name: option<string>
  }

  record tag-request {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the tag. This is generally a short sentence fragment that fits on a line in the UI for maximum readability. However, it can be longer.
    name: option<string>,
    /// Color of the tag.
    color: option<tag-request-color-enum>,
    /// Free-form textual information associated with the tag (i.e. its description).
    notes: option<string>,
    /// An array of strings identifying users. These can either be the string "me", an email, or the gid of a user.
    followers: option<list<string>>,
    /// Gid of an object.
    workspace: option<string>
  }

  record create-tag-response {
    data: option<tag-response>
  }

  record tag-response {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// Name of the tag. This is generally a short sentence fragment that fits on a line in the UI for maximum readability. However, it can be longer.
    name: option<string>,
    /// Color of the tag.
    color: option<tag-request-color-enum>,
    /// Free-form textual information associated with the tag (i.e. its description).
    notes: option<string>,
    /// The time at which this resource was created.
    created-at: option<string>,
    /// Array of users following this tag.
    followers: option<list<user-compact>>,
    /// A url that points directly to the object within Asana.
    permalink-url: option<string>,
    workspace: option<workspace-compact>
  }

  record user-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// *Read-only except when same user as requester*. The user’s name.
    name: option<string>
  }

  record workspace-compact {
    /// Globally unique identifier of the resource, as a string.
    gid: option<string>,
    /// The base type of this resource.
    resource-type: option<string>,
    /// The name of the workspace.
    name: option<string>
  }

