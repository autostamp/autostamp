/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `personalAccessToken` | `Authorization: Bearer <secret>` |
package autostamp:asana@0.2.1;

interface attachments {
  /// Get attachments from an object
  record get-attachments-for-object-params {
    /// Globally unique identifier for object to fetch statuses from. Must be a GID for a `project`, `project_brief`, or `task`.
    parent: string
  }
  get-attachments-for-object: func(params: get-attachments-for-object-params) -> result<string, string>;

  /// Upload an attachment
  create-attachment-for-object: func() -> result<string, string>;

  /// Get an attachment
  get-attachment: func() -> result<string, string>;

  /// Delete an attachment
  delete-attachment: func() -> result<string, string>;

}


interface batch-api {
  enum batch-request-action-method-enum {
    get,
    post,
    put,
    delete,
    patch,
    head,
  }

  /// A request object for use in a batch request.
  record batch-request {
    actions: option<list<batch-request-action>>
  }

  /// An action object for use in a batch request.
  record batch-request-action {
    /// For `GET` requests, this should be a map of query parameters you would have normally passed in the URL. Options and pagination are not accepted here; put them in `options` instead. For `POST`, `PATCH`, and `PUT` methods, this should be the content you would have normally put in the data field of the body.
    data: option<batch-request-action-data>,
    /// The HTTP method you wish to emulate for the action.
    method: batch-request-action-method-enum,
    /// Pagination (`limit` and `offset`) and output options (`fields` or `expand`) for the action. “Pretty” JSON output is not an available option on individual actions; if you want pretty output, specify that option on the parent request.
    options: option<batch-request-action-options>,
    /// The path of the desired endpoint relative to the API’s base URL. Query parameters are not accepted here; put them in `data` instead.
    relative-path: string
  }

  /// For `GET` requests, this should be a map of query parameters you would have normally passed in the URL. Options and pagination are not accepted here; put them in `options` instead. For `POST`, `PATCH`, and `PUT` methods, this should be the content you would have normally put in the data field of the body.
  record batch-request-action-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Pagination (`limit` and `offset`) and output options (`fields` or `expand`) for the action. “Pretty” JSON output is not an available option on individual actions; if you want pretty output, specify that option on the parent request.
  record batch-request-action-options {
    /// The fields to retrieve in the request.
    fields: option<list<string>>,
    /// Pagination limit for the request.
    limit: option<s32>,
    /// Pagination offset for the request.
    offset: option<s32>
  }

  /// Submit parallel requests
  record create-batch-request-params {
    data: option<batch-request>
  }
  create-batch-request: func(params: create-batch-request-params) -> result<string, string>;

}

interface custom-fields {
  record custom-field-request {
    /// opaque schema; raw JSON
    value: string
  }

  record enum-option-request {
    /// opaque schema; raw JSON
    value: string
  }

  record enum-option-insert-request {
    /// An existing enum option within this custom field after which the new enum option should be inserted. Cannot be provided together with before_enum_option.
    after-enum-option: option<string>,
    /// An existing enum option within this custom field before which the new enum option should be inserted. Cannot be provided together with after_enum_option.
    before-enum-option: option<string>,
    /// The gid of the enum option to relocate.
    enum-option: string
  }

  /// Create a custom field
  record create-custom-field-params {
    data: option<custom-field-request>
  }
  create-custom-field: func(params: create-custom-field-params) -> result<string, string>;

  /// Get a custom field
  get-custom-field: func() -> result<string, string>;

  /// Update a custom field
  record update-custom-field-params {
    data: option<custom-field-request>
  }
  update-custom-field: func(params: update-custom-field-params) -> result<string, string>;

  /// Delete a custom field
  delete-custom-field: func() -> result<string, string>;

  /// Create an enum option
  record create-enum-option-for-custom-field-params {
    data: option<enum-option-request>
  }
  create-enum-option-for-custom-field: func(params: create-enum-option-for-custom-field-params) -> result<string, string>;

  /// Reorder a custom field's enum
  record insert-enum-option-for-custom-field-params {
    data: option<enum-option-insert-request>
  }
  insert-enum-option-for-custom-field: func(params: insert-enum-option-for-custom-field-params) -> result<string, string>;

  /// Update an enum option
  record update-enum-option-params {
    data: option<enum-option-request>
  }
  update-enum-option: func(params: update-enum-option-params) -> result<string, string>;

  /// Get a workspace's custom fields
  get-custom-fields-for-workspace: func() -> result<string, string>;

}

interface events {
  /// Get events on a resource
  get-events: func() -> result<string, string>;

}

interface goal-relationships {
  record goal-relationship-request {
    /// opaque schema; raw JSON
    value: string
  }

  record goal-add-supporting-relationship-request {
    /// The weight that the supporting resource's progress will contribute to the supported goal's progress. This can only be 0 or 1.
    contribution-weight: option<f64>,
    /// An id of a subgoal of this parent goal. The new subgoal will be added after the one specified here. `insert_before` and `insert_after` parameters cannot both be specified. Currently only supported when adding a subgoal.
    insert-after: option<string>,
    /// An id of a subgoal of this parent goal. The new subgoal will be added before the one specified here. `insert_before` and `insert_after` parameters cannot both be specified. Currently only supported when adding a subgoal.
    insert-before: option<string>,
    /// The gid of the supporting resource to add to the parent goal. Must be the gid of a goal, project, or portfolio.
    supporting-resource: string
  }

  record goal-remove-supporting-relationship-request {
    /// The gid of the supporting resource to remove from the parent goal. Must be the gid of a goal, project, or portfolio.
    supporting-resource: string
  }

  /// Get goal relationships
  record get-goal-relationships-params {
    /// Globally unique identifier for the supported goal in the goal relationship.
    supported-goal: string,
    /// If provided, filter to goal relationships with a given resource_subtype.
    resource-subtype: option<string>
  }
  get-goal-relationships: func(params: get-goal-relationships-params) -> result<string, string>;

  /// Get a goal relationship
  get-goal-relationship: func() -> result<string, string>;

  /// Update a goal relationship
  record update-goal-relationship-params {
    data: option<goal-relationship-request>
  }
  update-goal-relationship: func(params: update-goal-relationship-params) -> result<string, string>;

  /// Add a supporting goal relationship
  record add-supporting-relationship-params {
    data: option<goal-add-supporting-relationship-request>
  }
  add-supporting-relationship: func(params: add-supporting-relationship-params) -> result<string, string>;

  /// Removes a supporting goal relationship
  record remove-supporting-relationship-params {
    data: option<goal-remove-supporting-relationship-request>
  }
  remove-supporting-relationship: func(params: remove-supporting-relationship-params) -> result<string, string>;

}

interface goals {
  record goal-request {
    /// opaque schema; raw JSON
    value: string
  }

  record task-add-followers-request {
    /// An array of strings identifying users. These can either be the string "me", an email, or the gid of a user.
    followers: list<string>
  }

  record goal-metric-request {
    /// opaque schema; raw JSON
    value: string
  }

  record goal-metric-current-value-request {
    /// opaque schema; raw JSON
    value: string
  }

  /// Get goals
  record get-goals-params {
    /// Globally unique identifier for supporting portfolio.
    portfolio: option<string>,
    /// Globally unique identifier for supporting project.
    project: option<string>,
    /// Filter to goals with is_workspace_level set to query value. Must be used with the workspace parameter.
    is-workspace-level: option<bool>,
    /// Globally unique identifier for the team.
    team: option<string>,
    /// Globally unique identifier for the workspace.
    workspace: option<string>,
    /// Globally unique identifiers for the time periods.
    time-periods: option<list<string>>
  }
  get-goals: func(params: get-goals-params) -> result<string, string>;

  /// Create a goal
  record create-goal-params {
    data: option<goal-request>
  }
  create-goal: func(params: create-goal-params) -> result<string, string>;

  /// Get a goal
  get-goal: func() -> result<string, string>;

  /// Update a goal
  record update-goal-params {
    data: option<goal-request>
  }
  update-goal: func(params: update-goal-params) -> result<string, string>;

  /// Delete a goal
  delete-goal: func() -> result<string, string>;

  /// Add a collaborator to a goal
  record add-followers-params {
    data: option<task-add-followers-request>
  }
  add-followers: func(params: add-followers-params) -> result<string, string>;

  /// Get parent goals from a goal
  get-parent-goals-for-goal: func() -> result<string, string>;

  /// Remove a collaborator from a goal
  record remove-followers-params {
    data: option<task-add-followers-request>
  }
  remove-followers: func(params: remove-followers-params) -> result<string, string>;

  /// Create a goal metric
  record create-goal-metric-params {
    data: option<goal-metric-request>
  }
  create-goal-metric: func(params: create-goal-metric-params) -> result<string, string>;

  /// Update a goal metric
  record update-goal-metric-params {
    data: option<goal-metric-current-value-request>
  }
  update-goal-metric: func(params: update-goal-metric-params) -> result<string, string>;

}

interface jobs {
  /// Get a job by id
  get-job: func() -> result<string, string>;

}

interface organization-exports {
  /// An *organization_export* request starts a job to export the complete data of the given Organization.
  record organization-export-request {
    /// Globally unique identifier for the workspace or organization.
    organization: option<string>
  }

  /// Create an organization export request
  record create-organization-export-params {
    data: option<organization-export-request>
  }
  create-organization-export: func(params: create-organization-export-params) -> result<string, string>;

  /// Get details on an org export request
  get-organization-export: func() -> result<string, string>;

}

interface portfolio-memberships {
  /// Get multiple portfolio memberships
  get-portfolio-memberships: func() -> result<string, string>;

  /// Get a portfolio membership
  get-portfolio-membership: func() -> result<string, string>;

  /// Get memberships from a portfolio
  get-portfolio-memberships-for-portfolio: func() -> result<string, string>;

}

interface portfolios {
  record portfolio-request {
    /// opaque schema; raw JSON
    value: string
  }

  record add-custom-field-setting-request {
    /// The custom field to associate with this container.
    custom-field: string,
    /// A gid of a Custom Field Setting on this container, after which the new Custom Field Setting will be added.  `insert_before` and `insert_after` parameters cannot both be specified.
    insert-after: option<string>,
    /// A gid of a Custom Field Setting on this container, before which the new Custom Field Setting will be added.  `insert_before` and `insert_after` parameters cannot both be specified.
    insert-before: option<string>,
    /// Whether this field should be considered important to this container (for instance, to display in the list view of items in the container).
    is-important: option<bool>
  }

  record portfolio-add-item-request {
    /// An id of an item in this portfolio. The new item will be added after the one specified here. `insert_before` and `insert_after` parameters cannot both be specified.
    insert-after: option<string>,
    /// An id of an item in this portfolio. The new item will be added before the one specified here. `insert_before` and `insert_after` parameters cannot both be specified.
    insert-before: option<string>,
    /// The item to add to the portfolio.
    item: string
  }

  record add-members-request {
    /// An array of strings identifying users. These can either be the string "me", an email, or the gid of a user.
    members: string
  }

  record remove-custom-field-setting-request {
    /// The custom field to remove from this portfolio.
    custom-field: string
  }

  record portfolio-remove-item-request {
    /// The item to remove from the portfolio.
    item: string
  }

  record remove-members-request {
    /// An array of strings identifying users. These can either be the string "me", an email, or the gid of a user.
    members: string
  }

  /// Get multiple portfolios
  record get-portfolios-params {
    /// The workspace or organization to filter portfolios on.
    workspace: string,
    /// The user who owns the portfolio. Currently, API users can only get a list of portfolios that they themselves own.
    owner: string
  }
  get-portfolios: func(params: get-portfolios-params) -> result<string, string>;

  /// Create a portfolio
  record create-portfolio-params {
    data: option<portfolio-request>
  }
  create-portfolio: func(params: create-portfolio-params) -> result<string, string>;

  /// Get a portfolio
  get-portfolio: func() -> result<string, string>;

  /// Update a portfolio
  record update-portfolio-params {
    data: option<portfolio-request>
  }
  update-portfolio: func(params: update-portfolio-params) -> result<string, string>;

  /// Delete a portfolio
  delete-portfolio: func() -> result<string, string>;

  /// Add a custom field to a portfolio
  record add-custom-field-setting-for-portfolio-params {
    data: option<add-custom-field-setting-request>
  }
  add-custom-field-setting-for-portfolio: func(params: add-custom-field-setting-for-portfolio-params) -> result<string, string>;

  /// Add a portfolio item
  record add-item-for-portfolio-params {
    data: option<portfolio-add-item-request>
  }
  add-item-for-portfolio: func(params: add-item-for-portfolio-params) -> result<string, string>;

  /// Add users to a portfolio
  record add-members-for-portfolio-params {
    data: option<add-members-request>
  }
  add-members-for-portfolio: func(params: add-members-for-portfolio-params) -> result<string, string>;

  /// Get portfolio items
  get-items-for-portfolio: func() -> result<string, string>;

  /// Remove a custom field from a portfolio
  record remove-custom-field-setting-for-portfolio-params {
    data: option<remove-custom-field-setting-request>
  }
  remove-custom-field-setting-for-portfolio: func(params: remove-custom-field-setting-for-portfolio-params) -> result<string, string>;

  /// Remove a portfolio item
  record remove-item-for-portfolio-params {
    data: option<portfolio-remove-item-request>
  }
  remove-item-for-portfolio: func(params: remove-item-for-portfolio-params) -> result<string, string>;

  /// Remove users from a portfolio
  record remove-members-for-portfolio-params {
    data: option<remove-members-request>
  }
  remove-members-for-portfolio: func(params: remove-members-for-portfolio-params) -> result<string, string>;

}

