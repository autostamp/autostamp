    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The key of the project.
    project-key: option<string>
  }
  get-all-screen-tab-fields: func(params: get-all-screen-tab-fields-params) -> result<list<screenable-field>, get-all-screen-tab-fields-error>;

  /// Add screen tab field
  record add-screen-tab-field-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The ID of the field to add.
    field-id: string
  }
  add-screen-tab-field: func(params: add-screen-tab-field-params) -> result<screenable-field, add-screen-tab-field-error>;

  /// Remove screen tab field
  record remove-screen-tab-field-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The ID of the field.
    id: string
  }
  remove-screen-tab-field: func(params: remove-screen-tab-field-params) -> result<string, remove-screen-tab-field-error>;

  /// Move screen tab field
  record move-screen-tab-field-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The ID of the field.
    id: string,
    /// The ID of the screen tab field after which to place the moved screen tab field. Required if `position` isn't provided.
    after: option<string>,
    /// The named position to which the screen tab field should be moved. Required if `after` isn't provided.
    position: option<move-field-bean-position-enum>
  }
  move-screen-tab-field: func(params: move-screen-tab-field-params) -> result<string, move-screen-tab-field-error>;

}

interface screen-schemes {
  enum get-screen-schemes-order-by-enum {
    name,
    name-v2,
    name-v3,
    id,
    id-v2,
    id-v3,
  }

  /// A page of items.
  record page-bean-screen-scheme {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<screen-scheme>>
  }

  /// A screen scheme.
  record screen-scheme {
    /// The description of the screen scheme.
    description: option<string>,
    /// The ID of the screen scheme.
    id: option<s64>,
    /// Details of the issue type screen schemes associated with the screen scheme.
    issue-type-screen-schemes: option<page-bean-issue-type-screen-scheme>,
    /// The name of the screen scheme.
    name: option<string>,
    /// The IDs of the screens for the screen types of the screen scheme.
    screens: option<screen-types>
  }

  /// A page of items.
  record page-bean-issue-type-screen-scheme {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<issue-type-screen-scheme>>
  }

  /// Details of an issue type screen scheme.
  record issue-type-screen-scheme {
    /// The description of the issue type screen scheme.
    description: option<string>,
    /// The ID of the issue type screen scheme.
    id: string,
    /// The name of the issue type screen scheme.
    name: string
  }

  /// The IDs of the screens for the screen types of the screen scheme.
  record screen-types {
    /// The ID of the create screen.
    create: option<s64>,
    /// The ID of the default screen. Required when creating a screen scheme.
    default: option<s64>,
    /// The ID of the edit screen.
    edit: option<s64>,
    /// The ID of the view screen.
    view: option<s64>
  }

  /// The ID of a screen scheme.
  record screen-scheme-id {
    /// The ID of the screen scheme.
    id: s64
  }

  /// The IDs of the screens for the screen types of the screen scheme.
  record update-screen-types {
    /// The ID of the create screen. To remove the screen association, pass a null.
    create: option<string>,
    /// The ID of the default screen. When specified, must include a screen ID as a default screen is required.
    default: option<string>,
    /// The ID of the edit screen. To remove the screen association, pass a null.
    edit: option<string>,
    /// The ID of the view screen. To remove the screen association, pass a null.
    view: option<string>
  }

  variant get-screen-schemes-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-screen-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-screen-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-screen-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get screen schemes
  record get-screen-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of screen scheme IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`.
    id: option<list<s64>>,
    /// Use [expand](#expansion) include additional information in the response. This parameter accepts `issueTypeScreenSchemes` that, for each screen schemes, returns information about the issue type screen scheme the screen scheme is assigned to.
    expand: option<string>,
    /// String used to perform a case-insensitive partial match with screen scheme name.
    query-string: option<string>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-screen-schemes-order-by-enum>
  }
  get-screen-schemes: func(params: get-screen-schemes-params) -> result<page-bean-screen-scheme, get-screen-schemes-error>;

  /// Create screen scheme
  record create-screen-scheme-params {
    /// The description of the screen scheme. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the screen scheme. The name must be unique. The maximum length is 255 characters.
    name: string,
    /// The IDs of the screens for the screen types of the screen scheme. Only screens used in classic projects are accepted.
    screens: screen-types
  }
  create-screen-scheme: func(params: create-screen-scheme-params) -> result<screen-scheme-id, create-screen-scheme-error>;

  /// Update screen scheme
  record update-screen-scheme-params {
    /// The ID of the screen scheme.
    screen-scheme-id: string,
    /// The description of the screen scheme. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the screen scheme. The name must be unique. The maximum length is 255 characters.
    name: option<string>,
    /// The IDs of the screens for the screen types of the screen scheme. Only screens used in classic projects are accepted.
    screens: option<update-screen-types>
  }
  update-screen-scheme: func(params: update-screen-scheme-params) -> result<string, update-screen-scheme-error>;

  /// Delete screen scheme
  record delete-screen-scheme-params {
    /// The ID of the screen scheme.
    screen-scheme-id: string
  }
  delete-screen-scheme: func(params: delete-screen-scheme-params) -> result<string, delete-screen-scheme-error>;

}

interface server-info {
  /// Details about the Jira instance.
  record server-information {
    /// The base URL of the Jira instance.
    base-url: option<string>,
    /// The timestamp when the Jira version was built.
    build-date: option<string>,
    /// The build number of the Jira version.
    build-number: option<s32>,
    /// The type of server deployment. This is always returned as *Cloud*.
    deployment-type: option<string>,
    /// Jira instance health check results. Deprecated and no longer returned.
    health-checks: option<list<health-check-result>>,
    /// The unique identifier of the Jira version.
    scm-info: option<string>,
    /// The time in Jira when this request was responded to.
    server-time: option<string>,
    /// The name of the Jira instance.
    server-title: option<string>,
    /// The version of Jira.
    version: option<string>,
    /// The major, minor, and revision version numbers of the Jira version.
    version-numbers: option<list<s32>>
  }

  /// Jira instance health check results. Deprecated and no longer returned.
  record health-check-result {
    /// The description of the Jira health check item.
    description: option<string>,
    /// The name of the Jira health check item.
    name: option<string>,
    /// Whether the Jira health check item passed or failed.
    passed: option<bool>
  }

  variant get-server-info-error {
    unauthorized(string),
    other(string)
  }

  /// Get Jira instance info
  get-server-info: func() -> result<server-information, get-server-info-error>;

}

