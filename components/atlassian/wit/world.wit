interface workflow-statuses {
  /// A status.
  record status-details {
    /// The description of the status.
    description: option<string>,
    /// The URL of the icon used to represent the status.
    icon-url: option<string>,
    /// The ID of the status.
    id: option<string>,
    /// The name of the status.
    name: option<string>,
    /// The URL of the status.
    self: option<string>,
    /// The category assigned to the status.
    status-category: option<status-category>
  }

  /// A status category.
  record status-category {
    /// The name of the color used to represent the status category.
    color-name: option<string>,
    /// The ID of the status category.
    id: option<s64>,
    /// The key of the status category.
    key: option<string>,
    /// The name of the status category.
    name: option<string>,
    /// The URL of the status category.
    self: option<string>
  }

  variant get-statuses-error {
    unauthorized(string),
    other(string)
  }

  variant get-status-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get all statuses
  get-statuses: func() -> result<list<status-details>, get-statuses-error>;

  /// Get status
  record get-status-params {
    /// The ID or name of the status.
    id-or-name: string
  }
  get-status: func(params: get-status-params) -> result<status-details, get-status-error>;

}

interface workflow-status-categories {
  /// A status category.
  record status-category {
    /// The name of the color used to represent the status category.
    color-name: option<string>,
    /// The ID of the status category.
    id: option<s64>,
    /// The key of the status category.
    key: option<string>,
    /// The name of the status category.
    name: option<string>,
    /// The URL of the status category.
    self: option<string>
