  variant get-status-categories-error {
    unauthorized(string),
    other(string)
  }

  variant get-status-category-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get all status categories
  get-status-categories: func() -> result<list<status-category>, get-status-categories-error>;

  /// Get status category
  record get-status-category-params {
    /// The ID or key of the status category.
    id-or-key: string
  }
  get-status-category: func(params: get-status-category-params) -> result<status-category, get-status-category-error>;

