    property-key: string
  }
  get-issue-type-property: func(params: get-issue-type-property-params) -> result<string, string>;

  /// Set issue type property
  record set-issue-type-property-params {
    /// The ID of the issue type.
    issue-type-id: string,
    /// The key of the issue type property. The maximum length is 255 characters.
    property-key: string,
    body: string
  }
  set-issue-type-property: func(params: set-issue-type-property-params) -> result<string, string>;

  /// Delete issue type property
  record delete-issue-type-property-params {
    /// The ID of the issue type.
    issue-type-id: string,
    /// The key of the property. Use [Get issue type property keys](#api-rest-api-3-issuetype-issueTypeId-properties-get) to get a list of all issue type property keys.
    property-key: string
  }
  delete-issue-type-property: func(params: delete-issue-type-property-params) -> result<string, string>;

}

interface issue-type-schemes {
  enum get-all-issue-type-schemes-order-by-enum {
    name,
    name-v2,
    name-v3,
    id,
    id-v2,
    id-v3,
  }

  enum order-of-issue-types-position-enum {
    first,
    last,
  }

  /// Get all issue type schemes
  record get-all-issue-type-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of issue type schemes IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`.
    id: option<list<s64>>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-all-issue-type-schemes-order-by-enum>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// String used to perform a case-insensitive partial match with issue type scheme name.
    query-string: option<string>
  }
  get-all-issue-type-schemes: func(params: get-all-issue-type-schemes-params) -> result<string, string>;

  /// Create issue type scheme
  record create-issue-type-scheme-params {
    /// The ID of the default issue type of the issue type scheme. This ID must be included in `issueTypeIds`.
    default-issue-type-id: option<string>,
    /// The description of the issue type scheme. The maximum length is 4000 characters.
    description: option<string>,
    /// The list of issue types IDs of the issue type scheme. At least one standard issue type ID is required.
    issue-type-ids: list<string>,
    /// The name of the issue type scheme. The name must be unique. The maximum length is 255 characters.
    name: string
  }
  create-issue-type-scheme: func(params: create-issue-type-scheme-params) -> result<string, string>;

  /// Get issue type scheme items
  record get-issue-type-schemes-mapping-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of issue type scheme IDs. To include multiple IDs, provide an ampersand-separated list. For example, `issueTypeSchemeId=10000&issueTypeSchemeId=10001`.
    issue-type-scheme-id: option<list<s64>>
  }
  get-issue-type-schemes-mapping: func(params: get-issue-type-schemes-mapping-params) -> result<string, string>;

  /// Get issue type schemes for projects
  record get-issue-type-scheme-for-projects-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of project IDs. To include multiple project IDs, provide an ampersand-separated list. For example, `projectId=10000&projectId=10001`.
    project-id: list<s64>
  }
  get-issue-type-scheme-for-projects: func(params: get-issue-type-scheme-for-projects-params) -> result<string, string>;

  /// Assign issue type scheme to project
  record assign-issue-type-scheme-to-project-params {
    /// The ID of the issue type scheme.
    issue-type-scheme-id: string,
    /// The ID of the project.
    project-id: string
  }
  assign-issue-type-scheme-to-project: func(params: assign-issue-type-scheme-to-project-params) -> result<string, string>;

  /// Update issue type scheme
  record update-issue-type-scheme-params {
    /// The ID of the issue type scheme.
    issue-type-scheme-id: string,
    /// The ID of the default issue type of the issue type scheme.
    default-issue-type-id: option<string>,
    /// The description of the issue type scheme. The maximum length is 4000 characters.
    description: option<string>,
    /// The name of the issue type scheme. The name must be unique. The maximum length is 255 characters.
    name: option<string>
  }
  update-issue-type-scheme: func(params: update-issue-type-scheme-params) -> result<string, string>;

  /// Delete issue type scheme
  record delete-issue-type-scheme-params {
    /// The ID of the issue type scheme.
    issue-type-scheme-id: string
  }
  delete-issue-type-scheme: func(params: delete-issue-type-scheme-params) -> result<string, string>;

  /// Add issue types to issue type scheme
  record add-issue-types-to-issue-type-scheme-params {
    /// The ID of the issue type scheme.
    issue-type-scheme-id: string,
    /// The list of issue type IDs.
    issue-type-ids: list<string>
  }
  add-issue-types-to-issue-type-scheme: func(params: add-issue-types-to-issue-type-scheme-params) -> result<string, string>;

  /// Change order of issue types
  record reorder-issue-types-in-issue-type-scheme-params {
    /// The ID of the issue type scheme.
    issue-type-scheme-id: string,
    /// The ID of the issue type to place the moved issue types after. Required if `position` isn't provided.
    after: option<string>,
    /// A list of the issue type IDs to move. The order of the issue type IDs in the list is the order they are given after the move.
    issue-type-ids: list<string>,
    /// The position the issue types should be moved to. Required if `after` isn't provided.
    position: option<order-of-issue-types-position-enum>
  }
  reorder-issue-types-in-issue-type-scheme: func(params: reorder-issue-types-in-issue-type-scheme-params) -> result<string, string>;

  /// Remove issue type from issue type scheme
  record remove-issue-type-from-issue-type-scheme-params {
    /// The ID of the issue type scheme.
    issue-type-scheme-id: string,
    /// The ID of the issue type.
    issue-type-id: string
  }
  remove-issue-type-from-issue-type-scheme: func(params: remove-issue-type-from-issue-type-scheme-params) -> result<string, string>;

}

interface issue-type-screen-schemes {
  enum get-issue-type-screen-schemes-order-by-enum {
    name,
    name-v2,
    name-v3,
    id,
    id-v2,
    id-v3,
  }

  /// The IDs of the screen schemes for the issue type IDs.
  record issue-type-screen-scheme-mapping {
    /// The ID of the issue type or *default*. Only issue types used in classic projects are accepted. An entry for *default* must be provided and defines the mapping for all issue types without a screen scheme.
    issue-type-id: string,
    /// The ID of the screen scheme. Only screen schemes used in classic projects are accepted.
    screen-scheme-id: string
  }

  /// Get issue type screen schemes
  record get-issue-type-screen-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of issue type screen scheme IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`.
    id: option<list<s64>>,
    /// String used to perform a case-insensitive partial match with issue type screen scheme name.
    query-string: option<string>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-issue-type-screen-schemes-order-by-enum>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts `projects` that, for each issue type screen schemes, returns information about the projects the issue type screen scheme is assigned to.
    expand: option<string>
  }
  get-issue-type-screen-schemes: func(params: get-issue-type-screen-schemes-params) -> result<string, string>;

  /// Create issue type screen scheme
  record create-issue-type-screen-scheme-params {
    /// The description of the issue type screen scheme. The maximum length is 255 characters.
    description: option<string>,
    /// The IDs of the screen schemes for the issue type IDs and *default*. A *default* entry is required to create an issue type screen scheme, it defines the mapping for all issue types without a screen scheme.
    issue-type-mappings: list<issue-type-screen-scheme-mapping>,
    /// The name of the issue type screen scheme. The name must be unique. The maximum length is 255 characters.
    name: string
  }
  create-issue-type-screen-scheme: func(params: create-issue-type-screen-scheme-params) -> result<string, string>;

  /// Get issue type screen scheme items
  record get-issue-type-screen-scheme-mappings-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of issue type screen scheme IDs. To include multiple issue type screen schemes, separate IDs with ampersand: `issueTypeScreenSchemeId=10000&issueTypeScreenSchemeId=10001`.
    issue-type-screen-scheme-id: option<list<s64>>
  }
  get-issue-type-screen-scheme-mappings: func(params: get-issue-type-screen-scheme-mappings-params) -> result<string, string>;

  /// Get issue type screen schemes for projects
  record get-issue-type-screen-scheme-project-associations-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of project IDs. To include multiple projects, separate IDs with ampersand: `projectId=10000&projectId=10001`.
    project-id: list<s64>
  }
  get-issue-type-screen-scheme-project-associations: func(params: get-issue-type-screen-scheme-project-associations-params) -> result<string, string>;

  /// Assign issue type screen scheme to project
  record assign-issue-type-screen-scheme-to-project-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: option<string>,
    /// The ID of the project.
    project-id: option<string>
  }
  assign-issue-type-screen-scheme-to-project: func(params: assign-issue-type-screen-scheme-to-project-params) -> result<string, string>;

  /// Update issue type screen scheme
  record update-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The description of the issue type screen scheme. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the issue type screen scheme. The name must be unique. The maximum length is 255 characters.
    name: option<string>
  }
  update-issue-type-screen-scheme: func(params: update-issue-type-screen-scheme-params) -> result<string, string>;

  /// Delete issue type screen scheme
  record delete-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string
  }
  delete-issue-type-screen-scheme: func(params: delete-issue-type-screen-scheme-params) -> result<string, string>;

  /// Append mappings to issue type screen scheme
  record append-mappings-for-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The list of issue type to screen scheme mappings. A *default* entry cannot be specified because a default entry is added when an issue type screen scheme is created.
    issue-type-mappings: list<issue-type-screen-scheme-mapping>
  }
  append-mappings-for-issue-type-screen-scheme: func(params: append-mappings-for-issue-type-screen-scheme-params) -> result<string, string>;

  /// Update issue type screen scheme default screen scheme
  record update-default-screen-scheme-v2-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The ID of the screen scheme.
    screen-scheme-id: string
  }
  update-default-screen-scheme-v2: func(params: update-default-screen-scheme-v2-params) -> result<string, string>;

  /// Remove mappings from issue type screen scheme
  record remove-mappings-from-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The list of issue type IDs.
    issue-type-ids: list<string>
  }
  remove-mappings-from-issue-type-screen-scheme: func(params: remove-mappings-from-issue-type-screen-scheme-params) -> result<string, string>;

  /// Get issue type screen scheme projects
  record get-projects-for-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    query: option<string>
  }
  get-projects-for-issue-type-screen-scheme: func(params: get-projects-for-issue-type-screen-scheme-params) -> result<string, string>;

}

interface jql {
  enum parse-jql-queries-validation-enum {
    strict,
    warn,
    none,
  }

  /// The JQL query to sanitize for the account ID. If the account ID is null, sanitizing is performed for an anonymous user.
  record jql-query-to-sanitize {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The query to sanitize.
    query: string
  }

  /// Get field reference data (GET)
  get-auto-complete: func() -> result<string, string>;

  /// Get field reference data (POST)
  record get-auto-complete-post-params {
    /// Include collapsed fields for fields that have non-unique names.
    include-collapsed-fields: option<bool>,
    /// List of project IDs used to filter the visible field details returned.
    project-ids: option<list<s64>>
  }
  get-auto-complete-post: func(params: get-auto-complete-post-params) -> result<string, string>;

  /// Get field auto complete suggestions
  record get-field-auto-complete-for-query-string-params {
    /// The name of the field.
    field-name: option<string>,
    /// The partial field item name entered by the user.
    field-value: option<string>,
    /// The name of the [ CHANGED operator predicate](https://confluence.atlassian.com/x/hQORLQ#Advancedsearching-operatorsreference-CHANGEDCHANGED) for which the suggestions are generated. The valid predicate operators are *by*, *from*, and *to*.
    predicate-name: option<string>,
    /// The partial predicate item name entered by the user.
    predicate-value: option<string>
  }
  get-field-auto-complete-for-query-string: func(params: get-field-auto-complete-for-query-string-params) -> result<string, string>;

  /// Parse JQL query
  record parse-jql-queries-params {
    /// How to validate the JQL query and treat the validation results. Validation options include:
    /// 
    validation: option<parse-jql-queries-validation-enum>,
    /// A list of queries to parse.
    queries: string
  }
  parse-jql-queries: func(params: parse-jql-queries-params) -> result<string, string>;

  /// Convert user identifiers to account IDs in JQL queries
  record migrate-queries-params {
    /// A list of queries with user identifiers. Maximum of 100 queries.
    query-strings: option<list<string>>
  }
  migrate-queries: func(params: migrate-queries-params) -> result<string, string>;

  /// Sanitize JQL queries
  record sanitise-jql-queries-params {
    /// The list of JQL queries to sanitize. Must contain unique values. Maximum of 20 queries.
    queries: list<jql-query-to-sanitize>
  }
  sanitise-jql-queries: func(params: sanitise-jql-queries-params) -> result<string, string>;

}

interface jql-functions-apps {
  /// Precomputation id and its new value.
  record jql-function-precomputation-update-bean {
    id: s64,
    value: string
  }

  /// Get precomputations (apps)
  record get-precomputations-params {
    /// The function key in format:
    /// 
    function-key: option<list<string>>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Not supported yet.
    order-by: option<string>,
    /// Not supported yet.
    filter: option<string>
  }
  get-precomputations: func(params: get-precomputations-params) -> result<string, string>;

  /// Update precomputations (apps)
  record update-precomputations-params {
    values: option<list<jql-function-precomputation-update-bean>>
  }
  update-precomputations: func(params: update-precomputations-params) -> result<string, string>;

}

interface labels {
  /// Get all labels
  record get-all-labels-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-all-labels: func(params: get-all-labels-params) -> result<string, string>;

}

interface license-metrics {
  /// Get approximate license count
  get-approximate-license-count: func() -> result<string, string>;

  /// Get approximate application license count
  record get-approximate-application-license-count-params {
    application-key: string
  }
  get-approximate-application-license-count: func(params: get-approximate-application-license-count-params) -> result<string, string>;

}

interface permissions {
  /// Details of project permissions and associated issues and projects to look up.
  record bulk-project-permissions {
    /// List of issue IDs.
    issues: option<list<s64>>,
    /// List of project permissions.
    permissions: list<string>,
    /// List of project IDs.
    projects: option<list<s64>>
  }

  /// Get my permissions
  record get-my-permissions-params {
    /// The key of project. Ignored if `projectId` is provided.
    project-key: option<string>,
    /// The ID of project.
    project-id: option<string>,
    /// The key of the issue. Ignored if `issueId` is provided.
    issue-key: option<string>,
    /// The ID of the issue.
    issue-id: option<string>,
    /// A list of permission keys. (Required) This parameter accepts a comma-separated list. To get the list of available permissions, use [Get all permissions](#api-rest-api-3-permissions-get).
    permissions: option<string>,
    project-uuid: option<string>,
    project-configuration-uuid: option<string>,
    /// The ID of the comment.
    comment-id: option<string>
  }
  get-my-permissions: func(params: get-my-permissions-params) -> result<string, string>;

  /// Get all permissions
  get-all-permissions: func() -> result<string, string>;

  /// Get bulk permissions
  record get-bulk-permissions-params {
    /// The account ID of a user.
    account-id: option<string>,
    /// Global permissions to look up.
    global-permissions: option<list<string>>,
    /// Project permissions with associated projects and issues to look up.
    project-permissions: option<list<bulk-project-permissions>>
  }
  get-bulk-permissions: func(params: get-bulk-permissions-params) -> result<string, string>;

  /// Get permitted projects
  record get-permitted-projects-params {
    /// A list of permission keys.
    permissions: list<string>
  }
  get-permitted-projects: func(params: get-permitted-projects-params) -> result<string, string>;

}

interface myself {
  /// Get preference
  record get-preference-params {
    /// The key of the preference.
    key: string
  }
  get-preference: func(params: get-preference-params) -> result<string, string>;

  /// Set preference
  record set-preference-params {
    /// The key of the preference. The maximum length is 255 characters.
    key: string,
    body: string
  }
  set-preference: func(params: set-preference-params) -> result<string, string>;

  /// Delete preference
  record remove-preference-params {
    /// The key of the preference.
    key: string
  }
  remove-preference: func(params: remove-preference-params) -> result<string, string>;

  /// Get locale
  get-locale: func() -> result<string, string>;

  /// Set locale
  record set-locale-params {
    /// The locale code. The Java the locale format is used: a two character language code (ISO 639), an underscore, and two letter country code (ISO 3166). For example, en\_US represents a locale of English (United States). Required on create.
    locale: option<string>
  }
  set-locale: func(params: set-locale-params) -> result<string, string>;

  /// Delete locale
  delete-locale: func() -> result<string, string>;

  /// Get current user
  record get-current-user-params {
    /// Use [expand](#expansion) to include additional information about user in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-current-user: func(params: get-current-user-params) -> result<string, string>;

}

interface issue-notification-schemes {
  /// Details of a notification scheme event.
  record notification-scheme-event-details {
    /// The ID of the event.
    event: string,
    /// The list of notifications mapped to a specified event.
    notifications: string
  }

  /// Get notification schemes paginated
  record get-notification-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of notification schemes IDs to be filtered by
    id: option<list<string>>,
    /// The list of projects IDs to be filtered by
    project-id: option<list<string>>,
    /// When set to true, returns only the default notification scheme. If you provide project IDs not associated with the default, returns an empty page. The default value is false.
    only-default: option<bool>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-notification-schemes: func(params: get-notification-schemes-params) -> result<string, string>;

  /// Create notification scheme
  record create-notification-scheme-params {
    /// The description of the notification scheme.
    description: option<string>,
    /// The name of the notification scheme. Must be unique (case-insensitive).
    name: string,
    /// The list of notifications which should be added to the notification scheme.
    notification-scheme-events: option<list<notification-scheme-event-details>>
  }
  create-notification-scheme: func(params: create-notification-scheme-params) -> result<string, string>;

  /// Get projects using notification schemes paginated
  record get-notification-scheme-to-project-mappings-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of notifications scheme IDs to be filtered out
    notification-scheme-id: option<list<string>>,
    /// The list of project IDs to be filtered out
    project-id: option<list<string>>
  }
  get-notification-scheme-to-project-mappings: func(params: get-notification-scheme-to-project-mappings-params) -> result<string, string>;

  /// Get notification scheme
  record get-notification-scheme-params {
    /// The ID of the notification scheme. Use [Get notification schemes paginated](#api-rest-api-3-notificationscheme-get) to get a list of notification scheme IDs.
    id: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-notification-scheme: func(params: get-notification-scheme-params) -> result<string, string>;

  /// Update notification scheme
  record update-notification-scheme-params {
    /// The ID of the notification scheme.
    id: string,
    /// The description of the notification scheme.
    description: option<string>,
    /// The name of the notification scheme. Must be unique.
    name: option<string>
  }
  update-notification-scheme: func(params: update-notification-scheme-params) -> result<string, string>;

  /// Add notifications to notification scheme
  record add-notifications-params {
    /// The ID of the notification scheme.
    id: string,
    /// The list of notifications which should be added to the notification scheme.
    notification-scheme-events: list<notification-scheme-event-details>
  }
  add-notifications: func(params: add-notifications-params) -> result<string, string>;

  /// Delete notification scheme
  record delete-notification-scheme-params {
    /// The ID of the notification scheme.
    notification-scheme-id: string
  }
  delete-notification-scheme: func(params: delete-notification-scheme-params) -> result<string, string>;

  /// Remove notification from notification scheme
  record remove-notification-from-notification-scheme-params {
    /// The ID of the notification scheme.
    notification-scheme-id: string,
    /// The ID of the notification.
    notification-id: string
  }
  remove-notification-from-notification-scheme: func(params: remove-notification-from-notification-scheme-params) -> result<string, string>;

}

interface permission-schemes {
  /// Details about a permission granted to a user or group.
  record permission-grant {
    /// The user or group being granted the permission. It consists of a `type`, a type-dependent `parameter` and a type-dependent `value`. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
    holder: option<string>,
    /// The ID of the permission granted details.
    id: option<s64>,
    /// The permission to grant. This permission can be one of the built-in permissions or a custom permission added by an app. See [Built-in permissions](../api-group-permission-schemes/#built-in-permissions) in *Get all permission schemes* for more information about the built-in permissions. See the [project permission](https://developer.atlassian.com/cloud/jira/platform/modules/project-permission/) and [global permission](https://developer.atlassian.com/cloud/jira/platform/modules/global-permission/) module documentation for more information about custom permissions.
    permission: option<string>,
    /// The URL of the permission granted details.
    self: option<string>
  }

  /// Get all permission schemes
  record get-all-permission-schemes-params {
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-all-permission-schemes: func(params: get-all-permission-schemes-params) -> result<string, string>;

  /// Create permission scheme
  record create-permission-scheme-params {
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>,
    /// A description for the permission scheme.
    description: option<string>,
    /// The ID of the permission scheme.
    id: option<s64>,
    /// The name of the permission scheme. Must be unique.
    name: string,
    /// The permission scheme to create or update. See [About permission schemes and grants](../api-group-permission-schemes/#about-permission-schemes-and-grants) for more information.
    permissions: option<list<permission-grant>>,
    /// The scope of the permission scheme.
    scope: option<string>,
    /// The URL of the permission scheme.
    self: option<string>
  }
  create-permission-scheme: func(params: create-permission-scheme-params) -> result<string, string>;

  /// Get permission scheme
  record get-permission-scheme-params {
    /// The ID of the permission scheme to return.
    scheme-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-permission-scheme: func(params: get-permission-scheme-params) -> result<string, string>;

  /// Update permission scheme
  record update-permission-scheme-params {
    /// The ID of the permission scheme to update.
    scheme-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>,
    /// A description for the permission scheme.
    description: option<string>,
    /// The ID of the permission scheme.
    id: option<s64>,
    /// The name of the permission scheme. Must be unique.
    name: string,
    /// The permission scheme to create or update. See [About permission schemes and grants](../api-group-permission-schemes/#about-permission-schemes-and-grants) for more information.
    permissions: option<list<permission-grant>>,
    /// The scope of the permission scheme.
    scope: option<string>,
    /// The URL of the permission scheme.
    self: option<string>
  }
  update-permission-scheme: func(params: update-permission-scheme-params) -> result<string, string>;

  /// Delete permission scheme
  record delete-permission-scheme-params {
    /// The ID of the permission scheme being deleted.
    scheme-id: string
  }
  delete-permission-scheme: func(params: delete-permission-scheme-params) -> result<string, string>;

  /// Get permission scheme grants
  record get-permission-scheme-grants-params {
    /// The ID of the permission scheme.
    scheme-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-permission-scheme-grants: func(params: get-permission-scheme-grants-params) -> result<string, string>;

  /// Create permission grant
  record create-permission-grant-params {
    /// The ID of the permission scheme in which to create a new permission grant.
    scheme-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>,
    /// The user or group being granted the permission. It consists of a `type`, a type-dependent `parameter` and a type-dependent `value`. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
    holder: option<string>,
    /// The ID of the permission granted details.
    id: option<s64>,
    /// The permission to grant. This permission can be one of the built-in permissions or a custom permission added by an app. See [Built-in permissions](../api-group-permission-schemes/#built-in-permissions) in *Get all permission schemes* for more information about the built-in permissions. See the [project permission](https://developer.atlassian.com/cloud/jira/platform/modules/project-permission/) and [global permission](https://developer.atlassian.com/cloud/jira/platform/modules/global-permission/) module documentation for more information about custom permissions.
    permission: option<string>,
    /// The URL of the permission granted details.
    self: option<string>
  }
  create-permission-grant: func(params: create-permission-grant-params) -> result<string, string>;

  /// Get permission scheme grant
  record get-permission-scheme-grant-params {
    /// The ID of the permission scheme.
    scheme-id: string,
    /// The ID of the permission grant.
    permission-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-permission-scheme-grant: func(params: get-permission-scheme-grant-params) -> result<string, string>;

  /// Delete permission scheme grant
  record delete-permission-scheme-entity-params {
    /// The ID of the permission scheme to delete the permission grant from.
    scheme-id: string,
    /// The ID of the permission grant to delete.
    permission-id: string
  }
  delete-permission-scheme-entity: func(params: delete-permission-scheme-entity-params) -> result<string, string>;

}

interface issue-priorities {
  enum create-priority-details-icon-url-enum {
    images-icons-priorities-blocker-png,
    images-icons-priorities-critical-png,
    images-icons-priorities-high-png,
    images-icons-priorities-highest-png,
    images-icons-priorities-low-png,
    images-icons-priorities-lowest-png,
    images-icons-priorities-major-png,
    images-icons-priorities-medium-png,
    images-icons-priorities-minor-png,
    images-icons-priorities-trivial-png,
  }

  /// Get priorities
  get-priorities: func() -> result<string, string>;

  /// Create priority
  record create-priority-params {
    /// The description of the priority.
    description: option<string>,
    /// The URL of an icon for the priority. Accepted protocols are HTTP and HTTPS. Built in icons can also be used.
    icon-url: option<create-priority-details-icon-url-enum>,
    /// The name of the priority. Must be unique.
    name: string,
    /// The status color of the priority in 3-digit or 6-digit hexadecimal format.
    status-color: string
  }
  create-priority: func(params: create-priority-params) -> result<string, string>;

  /// Set default priority
  record set-default-priority-params {
    /// The ID of the new default issue priority. Must be an existing ID or null. Setting this to null erases the default priority setting.
    id: string
  }
  set-default-priority: func(params: set-default-priority-params) -> result<string, string>;

  /// Move priorities
  record move-priorities-params {
    /// The ID of the priority. Required if `position` isn't provided.
    after: option<string>,
    /// The list of issue IDs to be reordered. Cannot contain duplicates nor after ID.
    ids: list<string>,
    /// The position for issue priorities to be moved to. Required if `after` isn't provided.
    position: option<string>
  }
  move-priorities: func(params: move-priorities-params) -> result<string, string>;

  /// Search priorities
  record search-priorities-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of priority IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=2&id=3`.
    id: option<list<string>>,
    /// Whether only the default priority is returned.
    only-default: option<bool>
  }
  search-priorities: func(params: search-priorities-params) -> result<string, string>;

  /// Get priority
  record get-priority-params {
    /// The ID of the issue priority.
    id: string
  }
  get-priority: func(params: get-priority-params) -> result<string, string>;

  /// Update priority
  record update-priority-params {
    /// The ID of the issue priority.
    id: string,
    /// The description of the priority.
    description: option<string>,
    /// The URL of an icon for the priority. Accepted protocols are HTTP and HTTPS. Built in icons can also be used.
    icon-url: option<create-priority-details-icon-url-enum>,
    /// The name of the priority. Must be unique.
    name: option<string>,
    /// The status color of the priority in 3-digit or 6-digit hexadecimal format.
    status-color: option<string>
  }
  update-priority: func(params: update-priority-params) -> result<string, string>;

  /// Delete priority
  record delete-priority-params {
    /// The ID of the issue priority.
    id: string,
    /// The ID of the issue priority that will replace the currently selected resolution.
    replace-with: string
  }
  delete-priority: func(params: delete-priority-params) -> result<string, string>;

}

interface projects {
  enum create-project-details-assignee-type-enum {
    project-lead,
    unassigned,
  }

  enum create-project-details-project-template-key-enum {
    com-pyxis-greenhopper-jira-gh-simplified-agility-kanban,
    com-pyxis-greenhopper-jira-gh-simplified-agility-scrum,
    com-pyxis-greenhopper-jira-gh-simplified-basic,
    com-pyxis-greenhopper-jira-gh-simplified-kanban-classic,
    com-pyxis-greenhopper-jira-gh-simplified-scrum-classic,
    com-atlassian-servicedesk-simplified-it-service-management,
    com-atlassian-servicedesk-simplified-general-service-desk,
    com-atlassian-servicedesk-simplified-general-service-desk-it,
    com-atlassian-servicedesk-simplified-general-service-desk-business,
    com-atlassian-servicedesk-simplified-internal-service-desk,
    com-atlassian-servicedesk-simplified-external-service-desk,
    com-atlassian-servicedesk-simplified-hr-service-desk,
    com-atlassian-servicedesk-simplified-facilities-service-desk,
    com-atlassian-servicedesk-simplified-legal-service-desk,
    com-atlassian-servicedesk-simplified-marketing-service-desk,
    com-atlassian-servicedesk-simplified-finance-service-desk,
    com-atlassian-servicedesk-simplified-analytics-service-desk,
    com-atlassian-servicedesk-simplified-design-service-desk,
    com-atlassian-servicedesk-simplified-sales-service-desk,
    com-atlassian-servicedesk-simplified-halp-service-desk,
    com-atlassian-servicedesk-simplified-custom-project-service-desk,
    com-atlassian-jira-core-project-templates-jira-core-simplified-content-management,
    com-atlassian-jira-core-project-templates-jira-core-simplified-document-approval,
    com-atlassian-jira-core-project-templates-jira-core-simplified-lead-tracking,
    com-atlassian-jira-core-project-templates-jira-core-simplified-process-control,
    com-atlassian-jira-core-project-templates-jira-core-simplified-procurement,
    com-atlassian-jira-core-project-templates-jira-core-simplified-project-management,
    com-atlassian-jira-core-project-templates-jira-core-simplified-recruitment,
    com-atlassian-jira-core-project-templates-jira-core-simplified-task,
  }

  enum create-project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum search-projects-order-by-enum {
    category,
    category-v2,
    category-v3,
    key,
    key-v2,
    key-v3,
    name,
    name-v2,
    name-v3,
    owner,
    owner-v2,
    owner-v3,
    issue-count,
    issue-count-v2,
    issue-count-v3,
    last-issue-updated-date,
    last-issue-updated-date-v2,
    last-issue-updated-date-v3,
    archived-date,
    archived-date-v2,
    archived-date-v3,
    deleted-date,
    deleted-date-v2,
    deleted-date-v3,
  }

  enum search-projects-action-enum {
    view,
    browse,
    edit,
  }

  enum search-projects-status-item-enum {
    live,
    archived,
    deleted,
  }

  record string-list {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Get all projects
  record get-all-projects-params {
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expanded options include:
    /// 
    expand: option<string>,
    /// Returns the user's most recently accessed projects. You may specify the number of results to return up to a maximum of 20. If access is anonymous, then the recently accessed projects are based on the current HTTP session.
    recent: option<s32>,
    /// A list of project properties to return for the project. This parameter accepts a comma-separated list.
    properties: option<list<string>>
  }
  get-all-projects: func(params: get-all-projects-params) -> result<string, string>;

  /// Create project
  record create-project-params {
    /// The default assignee when creating issues for this project.
    assignee-type: option<create-project-details-assignee-type-enum>,
    /// An integer value for the project's avatar.
    avatar-id: option<s64>,
    /// The ID of the project's category. A complete list of category IDs is found using the [Get all project categories](#api-rest-api-3-projectCategory-get) operation.
    category-id: option<s64>,
    /// A brief description of the project.
    description: option<string>,
    /// The ID of the field configuration scheme for the project. Use the [Get all field configuration schemes](#api-rest-api-3-fieldconfigurationscheme-get) operation to get a list of field configuration scheme IDs. If you specify the field configuration scheme you cannot specify the project template key.
    field-configuration-scheme: option<s64>,
    /// The ID of the issue security scheme for the project, which enables you to control who can and cannot view issues. Use the [Get issue security schemes](#api-rest-api-3-issuesecurityschemes-get) resource to get all issue security scheme IDs.
    issue-security-scheme: option<s64>,
    /// The ID of the issue type scheme for the project. Use the [Get all issue type schemes](#api-rest-api-3-issuetypescheme-get) operation to get a list of issue type scheme IDs. If you specify the issue type scheme you cannot specify the project template key.
    issue-type-scheme: option<s64>,
    /// The ID of the issue type screen scheme for the project. Use the [Get all issue type screen schemes](#api-rest-api-3-issuetypescreenscheme-get) operation to get a list of issue type screen scheme IDs. If you specify the issue type screen scheme you cannot specify the project template key.
    issue-type-screen-scheme: option<s64>,
    /// Project keys must be unique and start with an uppercase letter followed by one or more uppercase alphanumeric characters. The maximum length is 10 characters.
    key: string,
    /// This parameter is deprecated because of privacy changes. Use `leadAccountId` instead. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details. The user name of the project lead. Either `lead` or `leadAccountId` must be set when creating a project. Cannot be provided with `leadAccountId`.
    lead: option<string>,
    /// The account ID of the project lead. Either `lead` or `leadAccountId` must be set when creating a project. Cannot be provided with `lead`.
    lead-account-id: option<string>,
    /// The name of the project.
    name: string,
    /// The ID of the notification scheme for the project. Use the [Get notification schemes](#api-rest-api-3-notificationscheme-get) resource to get a list of notification scheme IDs.
    notification-scheme: option<s64>,
    /// The ID of the permission scheme for the project. Use the [Get all permission schemes](#api-rest-api-3-permissionscheme-get) resource to see a list of all permission scheme IDs.
    permission-scheme: option<s64>,
    /// A predefined configuration for a project. The type of the `projectTemplateKey` must match with the type of the `projectTypeKey`.
    project-template-key: option<create-project-details-project-template-key-enum>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes), which defines the application-specific feature set. If you don't specify the project template you have to specify the project type.
    project-type-key: option<create-project-details-project-type-key-enum>,
    /// A link to information about this project, such as project documentation
    url: option<string>,
    /// The ID of the workflow scheme for the project. Use the [Get all workflow schemes](#api-rest-api-3-workflowscheme-get) operation to get a list of workflow scheme IDs. If you specify the workflow scheme you cannot specify the project template key.
    workflow-scheme: option<s64>
  }
  create-project: func(params: create-project-params) -> result<string, string>;

  /// Get recent projects
  record get-recent-params {
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expanded options include:
    /// 
    expand: option<string>,
    /// EXPERIMENTAL. A list of project properties to return for the project. This parameter accepts a comma-separated list. Invalid property names are ignored.
    properties: option<list<string-list>>
  }
  get-recent: func(params: get-recent-params) -> result<string, string>;

  /// Get projects paginated
  record search-projects-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// [Order](#ordering) the results by a field.
    /// 
    order-by: option<search-projects-order-by-enum>,
    /// The project IDs to filter the results by. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`. Up to 50 project IDs can be provided.
    id: option<list<s64>>,
    /// The project keys to filter the results by. To include multiple keys, provide an ampersand-separated list. For example, `keys=PA&keys=PB`. Up to 50 project keys can be provided.
    keys: option<list<string>>,
    /// Filter the results using a literal string. Projects with a matching `key` or `name` are returned (case insensitive).
    query: option<string>,
    /// Orders results by the [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes). This parameter accepts a comma-separated list. Valid values are `business`, `service_desk`, and `software`.
    type-key: option<string>,
    /// The ID of the project's category. A complete list of category IDs is found using the [Get all project categories](#api-rest-api-3-projectCategory-get) operation.
    category-id: option<s64>,
    /// Filter results by projects for which the user can:
    /// 
    action: option<search-projects-action-enum>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expanded options include:
    /// 
    expand: option<string>,
    /// EXPERIMENTAL. Filter results by project status:
    /// 
    status: option<list<search-projects-status-item-enum>>,
    /// EXPERIMENTAL. A list of project properties to return for the project. This parameter accepts a comma-separated list.
    properties: option<list<string-list>>,
    /// EXPERIMENTAL. A query string used to search properties. The query string cannot be specified using a JSON object. For example, to search for the value of `nested` from `{"something":{"nested":1,"other":2}}` use `[thepropertykey].something.nested=1`. Note that the propertyQuery key is enclosed in square brackets to enable searching where the propertyQuery key includes dot (.) or equals (=) characters. Note that `thepropertykey` is only returned when included in `properties`.
    property-query: option<string>
  }
  search-projects: func(params: search-projects-params) -> result<string, string>;

  /// Get project
  record get-project-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Note that the project description, issue types, and project lead are included in all responses by default. Expand options include:
    /// 
    expand: option<string>,
    /// A list of project properties to return for the project. This parameter accepts a comma-separated list.
    properties: option<list<string>>
  }
  get-project: func(params: get-project-params) -> result<string, string>;

  /// Update project
  record update-project-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Note that the project description, issue types, and project lead are included in all responses by default. Expand options include:
    /// 
    expand: option<string>,
    /// The default assignee when creating issues for this project.
    assignee-type: option<create-project-details-assignee-type-enum>,
    /// An integer value for the project's avatar.
    avatar-id: option<s64>,
    /// The ID of the project's category. A complete list of category IDs is found using the [Get all project categories](#api-rest-api-3-projectCategory-get) operation. To remove the project category from the project, set the value to `-1.`
    category-id: option<s64>,
    /// A brief description of the project.
    description: option<string>,
    /// The ID of the issue security scheme for the project, which enables you to control who can and cannot view issues. Use the [Get issue security schemes](#api-rest-api-3-issuesecurityschemes-get) resource to get all issue security scheme IDs.
    issue-security-scheme: option<s64>,
    /// Project keys must be unique and start with an uppercase letter followed by one or more uppercase alphanumeric characters. The maximum length is 10 characters.
    key: option<string>,
    /// This parameter is deprecated because of privacy changes. Use `leadAccountId` instead. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details. The user name of the project lead. Cannot be provided with `leadAccountId`.
    lead: option<string>,
    /// The account ID of the project lead. Cannot be provided with `lead`.
    lead-account-id: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The ID of the notification scheme for the project. Use the [Get notification schemes](#api-rest-api-3-notificationscheme-get) resource to get a list of notification scheme IDs.
    notification-scheme: option<s64>,
    /// The ID of the permission scheme for the project. Use the [Get all permission schemes](#api-rest-api-3-permissionscheme-get) resource to see a list of all permission scheme IDs.
    permission-scheme: option<s64>,
    /// A link to information about this project, such as project documentation
    url: option<string>
  }
  update-project: func(params: update-project-params) -> result<string, string>;

  /// Delete project
  record delete-project-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// Whether this project is placed in the Jira recycle bin where it will be available for restoration.
    enable-undo: option<bool>
  }
  delete-project: func(params: delete-project-params) -> result<string, string>;

  /// Archive project
  record archive-project-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  archive-project: func(params: archive-project-params) -> result<string, string>;

  /// Delete project asynchronously
  record delete-project-asynchronously-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  delete-project-asynchronously: func(params: delete-project-asynchronously-params) -> result<string, string>;

  /// Restore deleted or archived project
  record restore-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  restore: func(params: restore-params) -> result<string, string>;

  /// Get all statuses for project
  record get-all-statuses-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  get-all-statuses: func(params: get-all-statuses-params) -> result<string, string>;

  /// Update project type
  record update-project-type-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The key of the new project type.
    new-project-type-key: string
  }
  update-project-type: func(params: update-project-type-params) -> result<string, string>;

  /// Get project issue type hierarchy
  record get-hierarchy-params {
    /// The ID of the project.
    project-id: string
  }
  get-hierarchy: func(params: get-hierarchy-params) -> result<string, string>;

  /// Get project notification scheme
  record get-notification-scheme-for-project-params {
    /// The project ID or project key (case sensitive).
    project-key-or-id: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-notification-scheme-for-project: func(params: get-notification-scheme-for-project-params) -> result<string, string>;

}

