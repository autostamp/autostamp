  /// Get issue security schemes
  get-issue-security-schemes: func() -> result<security-schemes, get-issue-security-schemes-error>;

  /// Create issue security scheme
  record create-issue-security-scheme-params {
    /// The description of the issue security scheme.
    description: option<string>,
    /// The list of scheme levels which should be added to the security scheme.
    levels: option<list<security-scheme-level-bean>>,
    /// The name of the issue security scheme. Must be unique (case-insensitive).
    name: string
  }
  create-issue-security-scheme: func(params: create-issue-security-scheme-params) -> result<security-scheme-id, create-issue-security-scheme-error>;

  /// Get issue security levels
  record get-security-levels-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of issue security scheme level IDs. To include multiple issue security levels, separate IDs with an ampersand: `id=10000&id=10001`.
    id: option<list<string>>,
    /// The list of issue security scheme IDs. To include multiple issue security schemes, separate IDs with an ampersand: `schemeId=10000&schemeId=10001`.
    scheme-id: option<list<string>>,
    /// When set to true, returns multiple default levels for each security scheme containing a default. If you provide scheme and level IDs not associated with the default, returns an empty page. The default value is false.
    only-default: option<bool>
  }
  get-security-levels: func(params: get-security-levels-params) -> result<page-bean-security-level, get-security-levels-error>;

  /// Set default issue security levels
  record set-default-levels-params {
    /// List of objects with issue security scheme ID and new default level ID.
    default-values: string
  }
  set-default-levels: func(params: set-default-levels-params) -> result<string, set-default-levels-error>;

  /// Get issue security level members
  record get-security-level-members-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of issue security level member IDs. To include multiple issue security level members separate IDs with an ampersand: `id=10000&id=10001`.
    id: option<list<string>>,
    /// The list of issue security scheme IDs. To include multiple issue security schemes separate IDs with an ampersand: `schemeId=10000&schemeId=10001`.
    scheme-id: option<list<string>>,
    /// The list of issue security level IDs. To include multiple issue security levels separate IDs with an ampersand: `levelId=10000&levelId=10001`.
    level-id: option<list<string>>,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-security-level-members: func(params: get-security-level-members-params) -> result<page-bean-security-level-member, get-security-level-members-error>;

  /// Get projects using issue security schemes
  record search-projects-using-security-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of security scheme IDs to be filtered out.
    issue-security-scheme-id: option<list<string>>,
    /// The list of project IDs to be filtered out.
    project-id: option<list<string>>
  }
  search-projects-using-security-schemes: func(params: search-projects-using-security-schemes-params) -> result<page-bean-issue-security-scheme-to-project-mapping, search-projects-using-security-schemes-error>;

  /// Search issue security schemes
  record search-security-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of issue security scheme IDs. To include multiple issue security scheme IDs, separate IDs with an ampersand: `id=10000&id=10001`.
    id: option<list<string>>,
    /// The list of project IDs. To include multiple project IDs, separate IDs with an ampersand: `projectId=10000&projectId=10001`.
    project-id: option<list<string>>
  }
  search-security-schemes: func(params: search-security-schemes-params) -> result<page-bean-security-scheme-with-projects, search-security-schemes-error>;

  /// Get issue security scheme
  record get-issue-security-scheme-params {
    /// The ID of the issue security scheme. Use the [Get issue security schemes](#api-rest-api-3-issuesecurityschemes-get) operation to get a list of issue security scheme IDs.
    id: string
  }
  get-issue-security-scheme: func(params: get-issue-security-scheme-params) -> result<security-scheme, get-issue-security-scheme-error>;

  /// Update issue security scheme
  record update-issue-security-scheme-params {
    /// The ID of the issue security scheme.
    id: string,
    /// The description of the security scheme scheme.
    description: option<string>,
    /// The name of the security scheme scheme. Must be unique.
    name: option<string>
  }
  update-issue-security-scheme: func(params: update-issue-security-scheme-params) -> result<string, update-issue-security-scheme-error>;

  /// Delete issue security scheme
  record delete-security-scheme-params {
    /// The ID of the issue security scheme.
    scheme-id: string
  }
  delete-security-scheme: func(params: delete-security-scheme-params) -> result<string, delete-security-scheme-error>;

  /// Add issue security levels
  record add-security-level-params {
    /// The ID of the issue security scheme.
    scheme-id: string,
    /// The list of scheme levels which should be added to the security scheme.
    levels: option<list<security-scheme-level-bean>>
  }
  add-security-level: func(params: add-security-level-params) -> result<string, add-security-level-error>;

  /// Update issue security level
  record update-security-level-params {
    /// The ID of the issue security scheme level belongs to.
    scheme-id: string,
    /// The ID of the issue security level to update.
    level-id: string,
    /// The description of the issue security scheme level.
    description: option<string>,
    /// The name of the issue security scheme level. Must be unique.
    name: option<string>
  }
  update-security-level: func(params: update-security-level-params) -> result<string, update-security-level-error>;

  /// Remove issue security level
  record remove-level-params {
    /// The ID of the issue security scheme.
    scheme-id: string,
    /// The ID of the issue security level to remove.
    level-id: string,
    /// The ID of the issue security level that will replace the currently selected level.
    replace-with: option<string>
  }
  remove-level: func(params: remove-level-params) -> result<string, remove-level-error>;

  /// Add issue security level members
  record add-security-level-members-params {
    /// The ID of the issue security scheme.
    scheme-id: string,
    /// The ID of the issue security level.
    level-id: string,
    /// The list of level members which should be added to the issue security scheme level.
    members: option<list<security-scheme-level-member-bean>>
  }
  add-security-level-members: func(params: add-security-level-members-params) -> result<string, add-security-level-members-error>;

  /// Remove member from issue security level
  record remove-member-from-security-level-params {
    /// The ID of the issue security scheme.
    scheme-id: string,
    /// The ID of the issue security level.
    level-id: string,
    /// The ID of the issue security level member to be removed.
    member-id: string
  }
  remove-member-from-security-level: func(params: remove-member-from-security-level-params) -> result<string, remove-member-from-security-level-error>;

}

interface issue-security-level {
  /// A page of items.
  record page-bean-issue-security-level-member {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<member>>
  }

  /// Issue security level member.
  record member {
    /// The user or group being granted the permission. It consists of a `type` and a type-dependent `parameter`. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
    holder: permission-holder,
    /// The ID of the issue security level member.
    id: s64,
    /// The ID of the issue security level.
    issue-security-level-id: s64
  }

  /// Details of a user, group, field, or project role that holds a permission. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
  record permission-holder {
    /// Expand options that include additional permission holder details in the response.
    expand: option<string>,
    /// As a group's name can change, use of `value` is recommended. The identifier associated withthe `type` value that defines the holder of the permission.
    parameter: option<string>,
    /// The type of permission holder.
    type-op: string,
    /// The identifier associated with the `type` value that defines the holder of the permission.
    value: option<string>
  }

  /// Details of an issue level security item.
  record security-level {
    /// The description of the issue level security item.
    description: option<string>,
    /// The ID of the issue level security item.
    id: option<string>,
    /// Whether the issue level security item is the default.
    is-default: option<bool>,
    /// The ID of the issue level security scheme.
    issue-security-scheme-id: option<string>,
    /// The name of the issue level security item.
    name: option<string>,
    /// The URL of the issue level security item.
    self: option<string>
  }

  variant get-issue-security-level-members-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-issue-security-level-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get issue security level members
  record get-issue-security-level-members-params {
    /// The ID of the issue security scheme. Use the [Get issue security schemes](#api-rest-api-3-issuesecurityschemes-get) operation to get a list of issue security scheme IDs.
    issue-security-scheme-id: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of issue security level IDs. To include multiple issue security levels separate IDs with ampersand: `issueSecurityLevelId=10000&issueSecurityLevelId=10001`.
    issue-security-level-id: option<list<s64>>,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-issue-security-level-members: func(params: get-issue-security-level-members-params) -> result<page-bean-issue-security-level-member, get-issue-security-level-members-error>;

  /// Get issue security level
  record get-issue-security-level-params {
    /// The ID of the issue security level.
    id: string
  }
  get-issue-security-level: func(params: get-issue-security-level-params) -> result<security-level, get-issue-security-level-error>;

}

interface issue-types {
  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum issue-type-create-bean-type-op-enum {
    subtask,
    standard,
  }

  /// Details about an issue type.
  record issue-type-details {
    /// The ID of the issue type's avatar.
    avatar-id: option<s64>,
    /// The description of the issue type.
    description: option<string>,
    /// Unique ID for next-gen projects.
    entity-id: option<string>,
    /// Hierarchy level of the issue type.
    hierarchy-level: option<s32>,
    /// The URL of the issue type's avatar.
    icon-url: option<string>,
    /// The ID of the issue type.
    id: option<string>,
    /// The name of the issue type.
    name: option<string>,
    /// Details of the next-gen projects the issue type is available in.
    scope: option<scope>,
    /// The URL of these issue type details.
    self: option<string>,
    /// Whether this issue type is used to create subtasks.
    subtask: option<bool>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// Details of an avatar.
  record avatar {
    /// The file name of the avatar icon. Returned for system avatars.
    file-name: option<string>,
    /// The ID of the avatar.
    id: string,
    /// Whether the avatar can be deleted.
    is-deletable: option<bool>,
    /// Whether the avatar is used in Jira. For example, shown as a project's avatar.
    is-selected: option<bool>,
    /// Whether the avatar is a system avatar.
    is-system-avatar: option<bool>,
    /// The owner of the avatar. For a system avatar the owner is null (and nothing is returned). For non-system avatars this is the appropriate identifier, such as the ID for a project or the account ID for a user.
    owner: option<string>,
    /// The list of avatar icon URLs.
    urls: option<avatar-urls>
  }

  /// The list of avatar icon URLs.
  record avatar-urls {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-issue-all-types-error {
    unauthorized(string),
    other(string)
  }

  variant create-issue-type-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    conflict(string),
    other(string)
  }

  variant get-issue-types-for-project-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-issue-type-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-issue-type-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant delete-issue-type-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-alternative-issue-types-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-issue-type-avatar-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all issue types for user
  get-issue-all-types: func() -> result<list<issue-type-details>, get-issue-all-types-error>;

  /// Create issue type
  record create-issue-type-params {
    /// The description of the issue type.
    description: option<string>,
    /// The hierarchy level of the issue type. Use:
    /// 
    hierarchy-level: option<s32>,
    /// The unique name for the issue type. The maximum length is 60 characters.
    name: string,
    /// Deprecated. Use `hierarchyLevel` instead. See the [deprecation notice](https://community.developer.atlassian.com/t/deprecation-of-the-epic-link-parent-link-and-other-related-fields-in-rest-apis-and-webhooks/54048) for details.
    /// 
    type-op: option<issue-type-create-bean-type-op-enum>
  }
  create-issue-type: func(params: create-issue-type-params) -> result<issue-type-details, create-issue-type-error>;

  /// Get issue types for project
  record get-issue-types-for-project-params {
    /// The ID of the project.
    project-id: s64,
    /// The level of the issue type to filter by. Use:
    /// 
    level: option<s32>
  }
  get-issue-types-for-project: func(params: get-issue-types-for-project-params) -> result<list<issue-type-details>, get-issue-types-for-project-error>;

  /// Get issue type
  record get-issue-type-params {
    /// The ID of the issue type.
    id: string
  }
  get-issue-type: func(params: get-issue-type-params) -> result<issue-type-details, get-issue-type-error>;

  /// Update issue type
  record update-issue-type-params {
    /// The ID of the issue type.
    id: string,
    /// The ID of an issue type avatar.
    avatar-id: option<s64>,
    /// The description of the issue type.
    description: option<string>,
    /// The unique name for the issue type. The maximum length is 60 characters.
    name: option<string>
  }
  update-issue-type: func(params: update-issue-type-params) -> result<issue-type-details, update-issue-type-error>;

  /// Delete issue type
  record delete-issue-type-params {
    /// The ID of the issue type.
    id: string,
    /// The ID of the replacement issue type.
    alternative-issue-type-id: option<string>
  }
  delete-issue-type: func(params: delete-issue-type-params) -> result<string, delete-issue-type-error>;

  /// Get alternative issue types
  record get-alternative-issue-types-params {
    /// The ID of the issue type.
    id: string
  }
  get-alternative-issue-types: func(params: get-alternative-issue-types-params) -> result<list<issue-type-details>, get-alternative-issue-types-error>;

  /// Load issue type avatar
  record create-issue-type-avatar-params {
    /// The ID of the issue type.
    id: string,
    /// The X coordinate of the top-left corner of the crop region.
    x: option<s32>,
    /// The Y coordinate of the top-left corner of the crop region.
    y: option<s32>,
    /// The length of each side of the crop region.
    size: s32,
    body: string
  }
  create-issue-type-avatar: func(params: create-issue-type-avatar-params) -> result<avatar, create-issue-type-avatar-error>;

}

