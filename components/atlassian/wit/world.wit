    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get events
  get-events: func() -> result<list<issue-event>, get-events-error>;

  /// Create issue
  record create-issue-params {
    /// Whether the project in which the issue is created is added to the user's **Recently viewed** project list, as shown under **Projects** in Jira. When provided, the issue type and request type are added to the user's history for a project. These values are then used to provide defaults on the issue create screen.
    update-history: option<bool>,
    /// List of issue screen fields to update, specifying the sub-field to update and its value for each field. This field provides a straightforward option when setting a sub-field. When multiple sub-fields or other operations are required, use `update`. Fields included in here cannot be included in `update`.
    fields: option<issue-update-details-fields>,
    /// Additional issue history details.
    history-metadata: option<history-metadata>,
    /// Details of issue properties to be add or update.
    properties: option<list<entity-property>>,
    /// Details of a transition. Required when performing a transition, optional when creating or editing an issue.
    transition: option<issue-transition>,
    /// A Map containing the field field name and a list of operations to perform on the issue screen field. Note that fields included in here cannot be included in `fields`.
    update: option<issue-update-details-update>
  }
  create-issue: func(params: create-issue-params) -> result<created-issue, create-issue-error>;

  /// Bulk create issue
  record create-issues-params {
    issue-updates: option<list<issue-update-details>>
  }
  create-issues: func(params: create-issues-params) -> result<created-issues, create-issues-error>;

  /// Get create issue metadata
  record get-create-issue-meta-params {
    /// List of project IDs. This parameter accepts a comma-separated list. Multiple project IDs can also be provided using an ampersand-separated list. For example, `projectIds=10000,10001&projectIds=10020,10021`. This parameter may be provided with `projectKeys`.
    project-ids: option<list<string>>,
    /// List of project keys. This parameter accepts a comma-separated list. Multiple project keys can also be provided using an ampersand-separated list. For example, `projectKeys=proj1,proj2&projectKeys=proj3`. This parameter may be provided with `projectIds`.
    project-keys: option<list<string>>,
    /// List of issue type IDs. This parameter accepts a comma-separated list. Multiple issue type IDs can also be provided using an ampersand-separated list. For example, `issuetypeIds=10000,10001&issuetypeIds=10020,10021`. This parameter may be provided with `issuetypeNames`.
    issuetype-ids: option<list<string>>,
    /// List of issue type names. This parameter accepts a comma-separated list. Multiple issue type names can also be provided using an ampersand-separated list. For example, `issuetypeNames=name1,name2&issuetypeNames=name3`. This parameter may be provided with `issuetypeIds`.
    issuetype-names: option<list<string>>,
    /// Use [expand](#expansion) to include additional information about issue metadata in the response. This parameter accepts `projects.issuetypes.fields`, which returns information about the fields in the issue creation screen for each issue type. Fields hidden from the screen are not returned. Use the information to populate the `fields` and `update` fields in [Create issue](#api-rest-api-3-issue-post) and [Create issues](#api-rest-api-3-issue-bulk-post).
    expand: option<string>
  }
  get-create-issue-meta: func(params: get-create-issue-meta-params) -> result<issue-create-metadata, get-create-issue-meta-error>;

  /// Get issue
  record get-issue-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// A list of fields to return for the issue. This parameter accepts a comma-separated list. Use it to retrieve a subset of fields. Allowed values:
    /// 
    fields: option<list<string>>,
    /// Whether fields in `fields` are referenced by keys rather than IDs. This parameter is useful where fields have been added by a connect app and a field's key may differ from its ID.
    fields-by-keys: option<bool>,
    /// Use [expand](#expansion) to include additional information about the issues in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// A list of issue properties to return for the issue. This parameter accepts a comma-separated list. Allowed values:
    /// 
    properties: option<list<string>>,
    /// Whether the project in which the issue is created is added to the user's **Recently viewed** project list, as shown under **Projects** in Jira. This also populates the [JQL issues search](#api-rest-api-3-search-get) `lastViewed` field.
    update-history: option<bool>
  }
  get-issue: func(params: get-issue-params) -> result<issue-bean, get-issue-error>;

  /// Edit issue
  record edit-issue-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// Whether a notification email about the issue update is sent to all watchers. To disable the notification, administer Jira or administer project permissions are required. If the user doesn't have the necessary permission the request is ignored.
    notify-users: option<bool>,
    /// Whether screen security is overridden to enable hidden fields to be edited. Available to Connect app users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg) and Forge apps acting on behalf of users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-screen-security: option<bool>,
    /// Whether screen security is overridden to enable uneditable fields to be edited. Available to Connect app users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg) and Forge apps acting on behalf of users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-editable-flag: option<bool>,
    /// List of issue screen fields to update, specifying the sub-field to update and its value for each field. This field provides a straightforward option when setting a sub-field. When multiple sub-fields or other operations are required, use `update`. Fields included in here cannot be included in `update`.
    fields: option<issue-update-details-fields>,
    /// Additional issue history details.
    history-metadata: option<history-metadata>,
    /// Details of issue properties to be add or update.
    properties: option<list<entity-property>>,
    /// Details of a transition. Required when performing a transition, optional when creating or editing an issue.
    transition: option<issue-transition>,
    /// A Map containing the field field name and a list of operations to perform on the issue screen field. Note that fields included in here cannot be included in `fields`.
    update: option<issue-update-details-update>
  }
  edit-issue: func(params: edit-issue-params) -> result<string, edit-issue-error>;

  /// Delete issue
  record delete-issue-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// Whether the issue's subtasks are deleted when the issue is deleted.
    delete-subtasks: option<delete-issue-delete-subtasks-enum>
  }
  delete-issue: func(params: delete-issue-params) -> result<string, delete-issue-error>;

  /// Assign issue
  record assign-issue-params {
    /// The ID or key of the issue to be assigned.
    issue-id-or-key: string,
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }
  assign-issue: func(params: assign-issue-params) -> result<string, assign-issue-error>;

  /// Get changelogs
  record get-change-logs-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s32>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-change-logs: func(params: get-change-logs-params) -> result<page-bean-changelog, get-change-logs-error>;

  /// Get changelogs by IDs
  record get-change-logs-by-ids-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The list of changelog IDs.
    changelog-ids: list<s64>
  }
  get-change-logs-by-ids: func(params: get-change-logs-by-ids-params) -> result<page-of-changelogs, get-change-logs-by-ids-error>;

  /// Get edit issue metadata
  record get-edit-issue-meta-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// Whether hidden fields are returned. Available to Connect app users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg) and Forge apps acting on behalf of users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-screen-security: option<bool>,
    /// Whether non-editable fields are returned. Available to Connect app users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg) and Forge apps acting on behalf of users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-editable-flag: option<bool>
  }
  get-edit-issue-meta: func(params: get-edit-issue-meta-params) -> result<issue-update-metadata, get-edit-issue-meta-error>;

  /// Send notification for issue
  record notify-params {
    /// ID or key of the issue that the notification is sent for.
    issue-id-or-key: string,
    /// The HTML body of the email notification for the issue.
    html-body: option<string>,
    /// Restricts the notifications to users with the specified permissions.
    restrict: option<notification-recipients-restrictions>,
    /// The subject of the email notification for the issue. If this is not specified, then the subject is set to the issue key and summary.
    subject: option<string>,
    /// The plain text body of the email notification for the issue.
    text-body: option<string>,
    /// The recipients of the email notification for the issue.
    to: option<notification-recipients>
  }
  notify: func(params: notify-params) -> result<string, notify-error>;

  /// Get transitions
  record get-transitions-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// Use [expand](#expansion) to include additional information about transitions in the response. This parameter accepts `transitions.fields`, which returns information about the fields in the transition screen for each transition. Fields hidden from the screen are not returned. Use this information to populate the `fields` and `update` fields in [Transition issue](#api-rest-api-3-issue-issueIdOrKey-transitions-post).
    expand: option<string>,
    /// The ID of the transition.
    transition-id: option<string>,
    /// Whether transitions with the condition *Hide From User Condition* are included in the response.
    skip-remote-only-condition: option<bool>,
    /// Whether details of transitions that fail a condition are included in the response
    include-unavailable-transitions: option<bool>,
    /// Whether the transitions are sorted by ops-bar sequence value first then category order (Todo, In Progress, Done) or only by ops-bar sequence value.
    sort-by-ops-bar-and-status: option<bool>
  }
  get-transitions: func(params: get-transitions-params) -> result<transitions, get-transitions-error>;

  /// Transition issue
  record do-transition-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// List of issue screen fields to update, specifying the sub-field to update and its value for each field. This field provides a straightforward option when setting a sub-field. When multiple sub-fields or other operations are required, use `update`. Fields included in here cannot be included in `update`.
    fields: option<issue-update-details-fields>,
    /// Additional issue history details.
    history-metadata: option<history-metadata>,
    /// Details of issue properties to be add or update.
    properties: option<list<entity-property>>,
    /// Details of a transition. Required when performing a transition, optional when creating or editing an issue.
    transition: option<issue-transition>,
    /// A Map containing the field field name and a list of operations to perform on the issue screen field. Note that fields included in here cannot be included in `fields`.
    update: option<issue-update-details-update>
  }
  do-transition: func(params: do-transition-params) -> result<string, do-transition-error>;

}

interface jira-expressions {
  enum analyse-expression-check-enum {
    syntax,
    type-op,
    complexity,
  }

  enum jira-expression-validation-error-type-op-enum {
    syntax,
    type-op,
    other,
  }

  enum jexp-jql-issues-validation-enum {
    strict,
    warn,
    none,
  }

  /// Context variables and their types. The type checker assumes that [common context variables](https://developer.atlassian.com/cloud/jira/platform/jira-expressions/#context-variables), such as `issue` or `project`, are available in context and sets their type. Use this property to override the default types or provide details of new variables.
  record jira-expression-for-analysis-context-variables {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about the analysed Jira expression.
  record analysis {
    /// The results of Jira expressions analysis.
    results: list<jira-expression-analysis>
  }

  /// Details about the analysed Jira expression.
  record jira-expression-analysis {
    complexity: option<jira-expression-complexity>,
    /// A list of validation errors. Not included if the expression is valid.
    errors: option<list<jira-expression-validation-error>>,
    /// The analysed expression.
    expression: string,
    /// EXPERIMENTAL. The inferred type of the expression.
    type-op: option<string>,
    /// Whether the expression is valid and the interpreter will evaluate it. Note that the expression may fail at runtime (for example, if it executes too many expensive operations).
    valid: bool
  }

  /// Details about the complexity of the analysed Jira expression.
  record jira-expression-complexity {
    /// Information that can be used to determine how many [expensive operations](https://developer.atlassian.com/cloud/jira/platform/jira-expressions/#expensive-operations) the evaluation of the expression will perform. This information may be a formula or number. For example:
    /// 
    expensive-operations: string,
    /// Variables used in the formula, mapped to the parts of the expression they refer to.
    variables: option<jira-expression-complexity-variables>
  }

  /// Variables used in the formula, mapped to the parts of the expression they refer to.
  record jira-expression-complexity-variables {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about syntax and type errors. The error details apply to the entire expression, unless the object includes:
  /// 
  ///  *  `line` and `column`
  ///  *  `expression`
  record jira-expression-validation-error {
    /// The text column in which the error occurred.
    column: option<s32>,
    /// The part of the expression in which the error occurred.
    expression: option<string>,
    /// The text line in which the error occurred.
    line: option<s32>,
    /// Details about the error.
    message: string,
    /// The error type.
    type-op: jira-expression-validation-error-type-op-enum
  }

  record jira-expression-eval-context-bean {
    /// The ID of the board that is available under the `board` variable when evaluating the expression.
    board: option<s64>,
    /// Custom context variables and their types. These variable types are available for use in a custom context:
    /// 
    custom: option<list<custom-context-variable>>,
    /// The ID of the customer request that is available under the `customerRequest` variable when evaluating the expression. This is the same as the ID of the underlying Jira issue, but the customer request context variable will have a different type.
    customer-request: option<s64>,
    /// The issue that is available under the `issue` variable when evaluating the expression.
    issue: option<id-or-key-bean>,
    /// The collection of issues that is available under the `issues` variable when evaluating the expression.
    issues: option<jexp-issues>,
    /// The project that is available under the `project` variable when evaluating the expression.
    project: option<id-or-key-bean>,
    /// The ID of the service desk that is available under the `serviceDesk` variable when evaluating the expression.
    service-desk: option<s64>,
    /// The ID of the sprint that is available under the `sprint` variable when evaluating the expression.
    sprint: option<s64>
  }

  record custom-context-variable {
    /// Type of custom context variable.
    type-op: string
  }

  record id-or-key-bean {
    /// The ID of the referenced item.
    id: option<s64>,
    /// The key of the referenced item.
    key: option<string>
  }

  /// The JQL specifying the issues available in the evaluated Jira expression under the `issues` context variable.
  record jexp-issues {
    /// The JQL query that specifies the set of issues available in the Jira expression.
    jql: option<jexp-jql-issues>
  }

  /// The JQL specifying the issues available in the evaluated Jira expression under the `issues` context variable. Not all issues returned by the JQL query are loaded, only those described by the `startAt` and `maxResults` properties. To determine whether it is necessary to iterate to ensure all the issues returned by the JQL query are evaluated, inspect `meta.issues.jql.count` in the response.
  record jexp-jql-issues {
    /// The maximum number of issues to return from the JQL query. Inspect `meta.issues.jql.maxResults` in the response to ensure the maximum value has not been exceeded.
    max-results: option<s32>,
    /// The JQL query.
    query: option<string>,
    /// The index of the first issue to return from the JQL query.
    start-at: option<s64>,
    /// Determines how to validate the JQL query and treat the validation results.
    validation: option<jexp-jql-issues-validation-enum>
  }

  /// The result of evaluating a Jira expression.
  record jira-expression-result {
    /// Contains various characteristics of the performed expression evaluation.
    meta: option<jira-expression-evaluation-meta-data-bean>,
    /// The value of the evaluated expression. It may be a primitive JSON value or a Jira REST API object. (Some expressions do not produce any meaningful results—for example, an expression that returns a lambda function—if that's the case a simple string representation is returned. These string representations should not be relied upon and may change without notice.)
    value: string
  }

  record jira-expression-evaluation-meta-data-bean {
    /// Contains information about the expression complexity. For example, the number of steps it took to evaluate the expression.
    complexity: option<complexity-bean>,
    /// Contains information about the `issues` variable in the context. For example, is the issues were loaded with JQL, information about the page will be included here.
    issues: option<issues-meta-bean>
  }

  record complexity-bean {
    /// The number of Jira REST API beans returned in the response.
    beans: complexity-value-bean,
    /// The number of expensive operations executed while evaluating the expression. Expensive operations are those that load additional data, such as entity properties, comments, or custom fields.
    expensive-operations: complexity-value-bean,
    /// The number of primitive values returned in the response.
    primitive-values: complexity-value-bean,
    /// The number of steps it took to evaluate the expression, where a step is a high-level operation performed by the expression. A step is an operation such as arithmetic, accessing a property, accessing a context variable, or calling a function.
    steps: complexity-value-bean
  }

  record complexity-value-bean {
    /// The maximum allowed complexity. The evaluation will fail if this value is exceeded.
    limit: s32,
    /// The complexity value of the current expression.
    value: s32
  }

  /// Meta data describing the `issues` context variable.
  record issues-meta-bean {
    jql: option<issues-jql-meta-data-bean>
  }

  /// The description of the page of issues loaded by the provided JQL query.
  record issues-jql-meta-data-bean {
    /// The number of issues that were loaded in this evaluation.
    count: s32,
    /// The maximum number of issues that could be loaded in this evaluation.
    max-results: s32,
    /// The index of the first issue.
    start-at: s64,
    /// The total number of issues the JQL returned.
    total-count: s64,
    /// Any warnings related to the JQL query. Present only if the validation mode was set to `warn`.
    validation-warnings: option<list<string>>
  }

  variant analyse-expression-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant evaluate-jira-expression-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Analyse Jira expression
  record analyse-expression-params {
    /// The check to perform:
    /// 
    check: option<analyse-expression-check-enum>,
    /// Context variables and their types. The type checker assumes that [common context variables](https://developer.atlassian.com/cloud/jira/platform/jira-expressions/#context-variables), such as `issue` or `project`, are available in context and sets their type. Use this property to override the default types or provide details of new variables.
    context-variables: option<jira-expression-for-analysis-context-variables>,
    /// The list of Jira expressions to analyse.
    expressions: list<string>
  }
  analyse-expression: func(params: analyse-expression-params) -> result<analysis, analyse-expression-error>;

  /// Evaluate Jira expression
  record evaluate-jira-expression-params {
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts `meta.complexity` that returns information about the expression complexity. For example, the number of expensive operations used by the expression and how close the expression is to reaching the [complexity limit](https://developer.atlassian.com/cloud/jira/platform/jira-expressions/#restrictions). Useful when designing and debugging your expressions.
    expand: option<string>,
    /// The context in which the Jira expression is evaluated.
    context: option<jira-expression-eval-context-bean>,
    /// The Jira expression to evaluate.
    expression: string
  }
  evaluate-jira-expression: func(params: evaluate-jira-expression-params) -> result<jira-expression-result, evaluate-jira-expression-error>;

}

interface issue-fields {
  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum custom-field-definition-json-bean-searcher-key-enum {
    com-atlassian-jira-plugin-system-customfieldtypes-cascadingselectsearcher,
    com-atlassian-jira-plugin-system-customfieldtypes-daterange,
    com-atlassian-jira-plugin-system-customfieldtypes-datetimerange,
    com-atlassian-jira-plugin-system-customfieldtypes-exactnumber,
    com-atlassian-jira-plugin-system-customfieldtypes-exacttextsearcher,
    com-atlassian-jira-plugin-system-customfieldtypes-grouppickersearcher,
    com-atlassian-jira-plugin-system-customfieldtypes-labelsearcher,
    com-atlassian-jira-plugin-system-customfieldtypes-multiselectsearcher,
    com-atlassian-jira-plugin-system-customfieldtypes-numberrange,
    com-atlassian-jira-plugin-system-customfieldtypes-projectsearcher,
    com-atlassian-jira-plugin-system-customfieldtypes-textsearcher,
    com-atlassian-jira-plugin-system-customfieldtypes-userpickergroupsearcher,
    com-atlassian-jira-plugin-system-customfieldtypes-versionsearcher,
  }

  enum get-fields-paginated-type-op-item-enum {
    custom,
    system,
  }

  enum get-fields-paginated-order-by-enum {
    contexts-count,
    contexts-count-v2,
    contexts-count-v3,
    last-used,
    last-used-v2,
    last-used-v3,
    name,
    name-v2,
    name-v3,
    screens-count,
    screens-count-v2,
    screens-count-v3,
    projects-count,
    projects-count-v2,
    projects-count-v3,
  }

  enum field-last-used-type-op-enum {
    tracked,
    not-tracked,
    no-information,
  }

  enum get-trashed-fields-paginated-expand-enum {
    name,
    name-v2,
    name-v3,
    trash-date,
    trash-date-v2,
    trash-date-v3,
    planned-deletion-date,
    planned-deletion-date-v2,
    planned-deletion-date-v3,
    projects-count,
    projects-count-v2,
    projects-count-v3,
  }

  /// Details about a field.
  record field-details {
    /// The names that can be used to reference the field in an advanced search. For more information, see [Advanced searching - fields reference](https://confluence.atlassian.com/x/gwORLQ).
    clause-names: option<list<string>>,
    /// Whether the field is a custom field.
    custom: option<bool>,
    /// The ID of the field.
    id: option<string>,
    /// The key of the field.
    key: option<string>,
    /// The name of the field.
    name: option<string>,
    /// Whether the field can be used as a column on the issue navigator.
    navigable: option<bool>,
    /// Whether the content of the field can be used to order lists.
    orderable: option<bool>,
    /// The data schema for the field.
    schema: option<json-type-bean>,
    /// The scope of the field.
    scope: option<scope>,
    /// Whether the content of the field can be searched.
    searchable: option<bool>
  }

  /// The schema of a field.
  record json-type-bean {
    /// If the field is a custom field, the configuration of the field.
    configuration: option<json-type-bean-configuration>,
    /// If the field is a custom field, the URI of the field.
    custom: option<string>,
    /// If the field is a custom field, the custom ID of the field.
    custom-id: option<s64>,
    /// When the data type is an array, the name of the field items within the array.
    items: option<string>,
    /// If the field is a system field, the name of the field.
    system: option<string>,
    /// The data type of the field.
    type-op: string
  }

  /// If the field is a custom field, the configuration of the field.
  record json-type-bean-configuration {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// A page of items.
  record page-bean-field {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<field>>
  }

  /// Details of a field.
  record field {
    /// Number of contexts where the field is used.
    contexts-count: option<s64>,
    /// The description of the field.
    description: option<string>,
    /// The ID of the field.
    id: string,
    /// Whether the field is locked.
    is-locked: option<bool>,
    /// Whether the field is shown on screen or not.
    is-unscreenable: option<bool>,
    /// The key of the field.
    key: option<string>,
    last-used: option<field-last-used>,
    /// The name of the field.
    name: string,
    /// Number of projects where the field is used.
    projects-count: option<s64>,
    schema: json-type-bean,
    /// Number of screens where the field is used.
    screens-count: option<s64>,
    /// The searcher key of the field. Returned for custom fields.
    searcher-key: option<string>
  }

  /// Information about the most recent use of a field.
  record field-last-used {
    /// Last used value type:
    /// 
    type-op: option<field-last-used-type-op-enum>,
    /// The date when the value of the field last changed.
    value: option<string>
  }

  /// A page of items.
  record page-bean-context {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<context>>
  }

  /// A context.
  record context {
    /// The ID of the context.
    id: option<s64>,
    /// The name of the context.
    name: option<string>,
    /// The scope of the context.
    scope: option<scope>
  }

  variant get-fields-error {
    unauthorized(string),
    other(string)
  }

  variant create-custom-field-error {
    bad-request(string),
    other(string)
  }

  variant get-fields-paginated-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-trashed-fields-paginated-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant update-custom-field-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-contexts-for-field-deprecated-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant delete-custom-field-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant restore-custom-field-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant trash-custom-field-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get fields
  get-fields: func() -> result<list<field-details>, get-fields-error>;

  /// Create custom field
  record create-custom-field-params {
    /// The description of the custom field, which is displayed in Jira.
    description: option<string>,
    /// The name of the custom field, which is displayed in Jira. This is not the unique identifier.
    name: string,
    /// The searcher defines the way the field is searched in Jira. For example, *com.atlassian.jira.plugin.system.customfieldtypes:grouppickersearcher*.  
    /// The search UI (basic search and JQL search) will display different operations and values for the field, based on the field searcher. You must specify a searcher that is valid for the field type, as listed below (abbreviated values shown):
    searcher-key: option<custom-field-definition-json-bean-searcher-key-enum>,
    /// The type of the custom field. These built-in custom field types are available:
    /// 
    type-op: string
  }
  create-custom-field: func(params: create-custom-field-params) -> result<field-details, create-custom-field-error>;

  /// Get fields paginated
  record get-fields-paginated-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The type of fields to search.
    type-op: option<list<get-fields-paginated-type-op-item-enum>>,
    /// The IDs of the custom fields to return or, where `query` is specified, filter.
    id: option<list<string>>,
    /// String used to perform a case-insensitive partial match with field names or descriptions.
    query: option<string>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-fields-paginated-order-by-enum>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-fields-paginated: func(params: get-fields-paginated-params) -> result<page-bean-field, get-fields-paginated-error>;

  /// Get fields in trash paginated
  record get-trashed-fields-paginated-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    id: option<list<string>>,
    /// String used to perform a case-insensitive partial match with field names or descriptions.
    query: option<string>,
    expand: option<get-trashed-fields-paginated-expand-enum>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<string>
  }
  get-trashed-fields-paginated: func(params: get-trashed-fields-paginated-params) -> result<page-bean-field, get-trashed-fields-paginated-error>;

  /// Update custom field
  record update-custom-field-params {
    /// The ID of the custom field.
    field-id: string,
    /// The description of the custom field. The maximum length is 40000 characters.
    description: option<string>,
    /// The name of the custom field. It doesn't have to be unique. The maximum length is 255 characters.
    name: option<string>,
    /// The searcher that defines the way the field is searched in Jira. It can be set to `null`, otherwise you must specify the valid searcher for the field type, as listed below (abbreviated values shown):
    /// 
    searcher-key: option<custom-field-definition-json-bean-searcher-key-enum>
  }
  update-custom-field: func(params: update-custom-field-params) -> result<string, update-custom-field-error>;

  /// Get contexts for a field
  record get-contexts-for-field-deprecated-params {
    /// The ID of the field to return contexts for.
    field-id: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-contexts-for-field-deprecated: func(params: get-contexts-for-field-deprecated-params) -> result<page-bean-context, get-contexts-for-field-deprecated-error>;

  /// Delete custom field
  record delete-custom-field-params {
    /// The ID of a custom field.
    id: string
  }
  delete-custom-field: func(params: delete-custom-field-params) -> result<string, delete-custom-field-error>;

  /// Restore custom field from trash
  record restore-custom-field-params {
    /// The ID of a custom field.
    id: string
  }
  restore-custom-field: func(params: restore-custom-field-params) -> result<string, restore-custom-field-error>;

  /// Move custom field to trash
  record trash-custom-field-params {
    /// The ID of a custom field.
    id: string
  }
  trash-custom-field: func(params: trash-custom-field-params) -> result<string, trash-custom-field-error>;

}

interface issue-custom-field-contexts {
  /// A page of items.
  record page-bean-custom-field-context {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<custom-field-context>>
  }

  /// The details of a custom field context.
  record custom-field-context {
    /// The description of the context.
    description: string,
    /// The ID of the context.
    id: string,
    /// Whether the context apply to all issue types.
    is-any-issue-type: bool,
    /// Whether the context is global.
    is-global-context: bool,
    /// The name of the context.
    name: string
  }

  /// The details of a created custom field context.
  record create-custom-field-context {
    /// The description of the context.
    description: option<string>,
    /// The ID of the context.
    id: option<string>,
    /// The list of issue types IDs for the context. If the list is empty, the context refers to all issue types.
    issue-type-ids: option<list<string>>,
    /// The name of the context.
    name: string,
    /// The list of project IDs associated with the context. If the list is empty, the context is global.
    project-ids: option<list<string>>
  }

  /// A page of items.
  record page-bean-custom-field-context-default-value {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<custom-field-context-default-value>>
  }

  record custom-field-context-default-value {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A page of items.
  record page-bean-issue-type-to-context-mapping {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<issue-type-to-context-mapping>>
  }

  /// Mapping of an issue type to a context.
  record issue-type-to-context-mapping {
    /// The ID of the context.
    context-id: string,
    /// Whether the context is mapped to any issue type.
    is-any-issue-type: option<bool>,
    /// The ID of the issue type.
    issue-type-id: option<string>
  }

  /// The project and issue type mapping.
  record project-issue-type-mapping {
    /// The ID of the issue type.
    issue-type-id: string,
    /// The ID of the project.
    project-id: string
  }

  /// A page of items.
  record page-bean-context-for-project-and-issue-type {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<context-for-project-and-issue-type>>
  }

  /// The project and issue type mapping with a matching custom field context.
  record context-for-project-and-issue-type {
    /// The ID of the custom field context.
    context-id: string,
    /// The ID of the issue type.
    issue-type-id: string,
    /// The ID of the project.
    project-id: string
  }

  /// A page of items.
  record page-bean-custom-field-context-project-mapping {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<custom-field-context-project-mapping>>
  }

  /// Details of a context to project association.
  record custom-field-context-project-mapping {
    /// The ID of the context.
    context-id: string,
    /// Whether context is global.
    is-global-context: option<bool>,
    /// The ID of the project.
    project-id: option<string>
  }

  variant get-contexts-for-field-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-custom-field-context-v2-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-default-values-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-default-values-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-issue-type-mappings-for-contexts-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-custom-field-contexts-for-projects-and-issue-types-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-project-context-mapping-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-custom-field-context-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-custom-field-context-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-issue-types-to-context-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant remove-issue-types-from-context-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant assign-projects-to-custom-field-context-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-custom-field-context-from-projects-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get custom field contexts
  record get-contexts-for-field-params {
    /// The ID of the custom field.
    field-id: string,
    /// Whether to return contexts that apply to all issue types.
    is-any-issue-type: option<bool>,
    /// Whether to return contexts that apply to all projects.
    is-global-context: option<bool>,
    /// The list of context IDs. To include multiple contexts, separate IDs with ampersand: `contextId=10000&contextId=10001`.
    context-id: option<list<s64>>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-contexts-for-field: func(params: get-contexts-for-field-params) -> result<page-bean-custom-field-context, get-contexts-for-field-error>;

  /// Create custom field context
  record create-custom-field-context-v2-params {
    /// The ID of the custom field.
    field-id: string,
    /// The description of the context.
    description: option<string>,
    /// The ID of the context.
    id: option<string>,
    /// The list of issue types IDs for the context. If the list is empty, the context refers to all issue types.
    issue-type-ids: option<list<string>>,
    /// The name of the context.
    name: string,
    /// The list of project IDs associated with the context. If the list is empty, the context is global.
    project-ids: option<list<string>>
  }
  create-custom-field-context-v2: func(params: create-custom-field-context-v2-params) -> result<create-custom-field-context, create-custom-field-context-v2-error>;

  /// Get custom field contexts default values
  record get-default-values-params {
    /// The ID of the custom field, for example `customfield\_10000`.
    field-id: string,
    /// The IDs of the contexts.
    context-id: option<list<s64>>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-default-values: func(params: get-default-values-params) -> result<page-bean-custom-field-context-default-value, get-default-values-error>;

  /// Set custom field contexts default values
  record set-default-values-params {
    /// The ID of the custom field.
    field-id: string,
    default-values: option<list<custom-field-context-default-value>>
  }
  set-default-values: func(params: set-default-values-params) -> result<string, set-default-values-error>;

  /// Get issue types for custom field context
  record get-issue-type-mappings-for-contexts-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context. To include multiple contexts, provide an ampersand-separated list. For example, `contextId=10001&contextId=10002`.
    context-id: option<list<s64>>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-issue-type-mappings-for-contexts: func(params: get-issue-type-mappings-for-contexts-params) -> result<page-bean-issue-type-to-context-mapping, get-issue-type-mappings-for-contexts-error>;

  /// Get custom field contexts for projects and issue types
  record get-custom-field-contexts-for-projects-and-issue-types-params {
    /// The ID of the custom field.
    field-id: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The project and issue type mappings.
    mappings: list<project-issue-type-mapping>
  }
  get-custom-field-contexts-for-projects-and-issue-types: func(params: get-custom-field-contexts-for-projects-and-issue-types-params) -> result<page-bean-context-for-project-and-issue-type, get-custom-field-contexts-for-projects-and-issue-types-error>;

  /// Get project mappings for custom field context
  record get-project-context-mapping-params {
    /// The ID of the custom field, for example `customfield\_10000`.
    field-id: string,
    /// The list of context IDs. To include multiple context, separate IDs with ampersand: `contextId=10000&contextId=10001`.
    context-id: option<list<s64>>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-project-context-mapping: func(params: get-project-context-mapping-params) -> result<page-bean-custom-field-context-project-mapping, get-project-context-mapping-error>;

  /// Update custom field context
  record update-custom-field-context-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// The description of the custom field context. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the custom field context. The name must be unique. The maximum length is 255 characters.
    name: option<string>
  }
  update-custom-field-context: func(params: update-custom-field-context-params) -> result<string, update-custom-field-context-error>;

  /// Delete custom field context
  record delete-custom-field-context-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string
  }
  delete-custom-field-context: func(params: delete-custom-field-context-params) -> result<string, delete-custom-field-context-error>;

  /// Add issue types to context
  record add-issue-types-to-context-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// The list of issue type IDs.
    issue-type-ids: list<string>
  }
  add-issue-types-to-context: func(params: add-issue-types-to-context-params) -> result<string, add-issue-types-to-context-error>;

  /// Remove issue types from context
  record remove-issue-types-from-context-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// The list of issue type IDs.
    issue-type-ids: list<string>
  }
  remove-issue-types-from-context: func(params: remove-issue-types-from-context-params) -> result<string, remove-issue-types-from-context-error>;

  /// Assign custom field context to projects
  record assign-projects-to-custom-field-context-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// The IDs of projects.
    project-ids: list<string>
  }
  assign-projects-to-custom-field-context: func(params: assign-projects-to-custom-field-context-params) -> result<string, assign-projects-to-custom-field-context-error>;

  /// Remove custom field context from projects
  record remove-custom-field-context-from-projects-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// The IDs of projects.
    project-ids: list<string>
  }
  remove-custom-field-context-from-projects: func(params: remove-custom-field-context-from-projects-params) -> result<string, remove-custom-field-context-from-projects-error>;

}

interface screens {
  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum get-screens-scope-item-enum {
    global,
    template,
    project,
  }

  enum get-screens-order-by-enum {
    name,
    name-v2,
    name-v3,
    id,
    id-v2,
    id-v3,
  }

  /// A page of items.
  record page-bean-screen-with-tab {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<screen-with-tab>>
  }

  /// A screen with tab details.
  record screen-with-tab {
    /// The description of the screen.
    description: option<string>,
    /// The ID of the screen.
    id: option<s64>,
    /// The name of the screen.
    name: option<string>,
    /// The scope of the screen.
    scope: option<scope>,
    /// The tab for the screen.
    tab: option<screenable-tab>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// A screen tab.
  record screenable-tab {
    /// The ID of the screen tab.
    id: option<s64>,
    /// The name of the screen tab. The maximum length is 255 characters.
    name: string
  }

  /// A page of items.
  record page-bean-screen {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<screen>>
  }

  /// A screen.
  record screen {
    /// The description of the screen.
    description: option<string>,
    /// The ID of the screen.
    id: option<s64>,
    /// The name of the screen.
    name: option<string>,
    /// The scope of the screen.
    scope: option<scope>
  }

  /// A screen tab field.
  record screenable-field {
    /// The ID of the screen tab field.
    id: option<string>,
    /// The name of the screen tab field. Required on create and update. The maximum length is 255 characters.
    name: option<string>
  }

  variant get-screens-for-field-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-screens-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-screen-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant add-field-to-default-screen-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-screen-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-screen-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-available-screen-fields-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get screens for a field
  record get-screens-for-field-params {
    /// The ID of the field to return screens for.
    field-id: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Use [expand](#expansion) to include additional information about screens in the response. This parameter accepts `tab` which returns details about the screen tabs the field is used in.
    expand: option<string>
  }
  get-screens-for-field: func(params: get-screens-for-field-params) -> result<page-bean-screen-with-tab, get-screens-for-field-error>;

  /// Get screens
  record get-screens-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of screen IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`.
    id: option<list<s64>>,
    /// String used to perform a case-insensitive partial match with screen name.
    query-string: option<string>,
    /// The scope filter string. To filter by multiple scope, provide an ampersand-separated list. For example, `scope=GLOBAL&scope=PROJECT`.
    scope: option<list<get-screens-scope-item-enum>>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-screens-order-by-enum>
  }
  get-screens: func(params: get-screens-params) -> result<page-bean-screen, get-screens-error>;

  /// Create screen
  record create-screen-params {
    /// The description of the screen. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the screen. The name must be unique. The maximum length is 255 characters.
    name: string
  }
  create-screen: func(params: create-screen-params) -> result<screen, create-screen-error>;

  /// Add field to default screen
  record add-field-to-default-screen-params {
    /// The ID of the field.
    field-id: string
  }
  add-field-to-default-screen: func(params: add-field-to-default-screen-params) -> result<string, add-field-to-default-screen-error>;

  /// Update screen
  record update-screen-params {
    /// The ID of the screen.
    screen-id: string,
    /// The description of the screen. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the screen. The name must be unique. The maximum length is 255 characters.
    name: option<string>
  }
  update-screen: func(params: update-screen-params) -> result<screen, update-screen-error>;

  /// Delete screen
  record delete-screen-params {
    /// The ID of the screen.
    screen-id: string
  }
  delete-screen: func(params: delete-screen-params) -> result<string, delete-screen-error>;

  /// Get available screen fields
  record get-available-screen-fields-params {
    /// The ID of the screen.
    screen-id: string
  }
  get-available-screen-fields: func(params: get-available-screen-fields-params) -> result<list<screenable-field>, get-available-screen-fields-error>;

}

interface issue-custom-field-options-apps {
  enum issue-field-option-configuration-attributes-item-enum {
    not-selectable,
    default-value,
  }

  /// A page of items.
  record page-bean-issue-field-option {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<issue-field-option>>
  }

  /// Details of the options for a select list issue field.
  record issue-field-option {
    config: option<issue-field-option-configuration>,
    /// The unique identifier for the option. This is only unique within the select field's set of options.
    id: s64,
    /// The properties of the object, as arbitrary key-value pairs. These properties can be searched using JQL, if the extractions (see [Issue Field Option Property Index](https://developer.atlassian.com/cloud/jira/platform/modules/issue-field-option-property-index/)) are defined in the descriptor for the issue field module.
    properties: option<issue-field-option-properties>,
    /// The option's name, which is displayed in Jira.
    value: string
  }

  /// Details of the projects the option is available in.
  record issue-field-option-configuration {
    /// DEPRECATED
    attributes: option<list<issue-field-option-configuration-attributes-item-enum>>,
    /// Defines the projects that the option is available in. If the scope is not defined, then the option is available in all projects.
    scope: option<issue-field-option-scope-bean>
  }

  record issue-field-option-scope-bean {
    /// Defines the behavior of the option within the global context. If this property is set, even if set to an empty object, then the option is available in all projects.
    global: option<global-scope-bean>,
    /// DEPRECATED
    projects: option<list<s64>>,
    /// Defines the projects in which the option is available and the behavior of the option within each project. Specify one object per project. The behavior of the option in a project context overrides the behavior in the global context.
    projects2: option<list<project-scope-bean>>
  }

  record global-scope-bean {
    /// Defines the behavior of the option in the global context.If notSelectable is set, the option cannot be set as the field's value. This is useful for archiving an option that has previously been selected but shouldn't be used anymore.If defaultValue is set, the option is selected by default.
    attributes: option<list<issue-field-option-configuration-attributes-item-enum>>
  }

  record project-scope-bean {
    /// Defines the behavior of the option in the project.If notSelectable is set, the option cannot be set as the field's value. This is useful for archiving an option that has previously been selected but shouldn't be used anymore.If defaultValue is set, the option is selected by default.
    attributes: option<list<issue-field-option-configuration-attributes-item-enum>>,
    /// The ID of the project that the option's behavior applies to.
    id: option<s64>
  }

  /// The properties of the object, as arbitrary key-value pairs. These properties can be searched using JQL, if the extractions (see [Issue Field Option Property Index](https://developer.atlassian.com/cloud/jira/platform/modules/issue-field-option-property-index/)) are defined in the descriptor for the issue field module.
  record issue-field-option-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The properties of the option as arbitrary key-value pairs. These properties can be searched using JQL, if the extractions (see https://developer.atlassian.com/cloud/jira/platform/modules/issue-field-option-property-index/) are defined in the descriptor for the issue field module.
  record issue-field-option-create-bean-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-all-issue-field-options-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant create-issue-field-option-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-selectable-issue-field-options-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-visible-issue-field-options-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-issue-field-option-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-issue-field-option-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-issue-field-option-error {
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant replace-issue-field-option-error {
    see-other(string),
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all issue field options
  record get-all-issue-field-options-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The field key is specified in the following format: **$(app-key)\_\_$(field-key)**. For example, *example-add-on\_\_example-issue-field*. To determine the `fieldKey` value, do one of the following:
    /// 
    field-key: string
  }
  get-all-issue-field-options: func(params: get-all-issue-field-options-params) -> result<page-bean-issue-field-option, get-all-issue-field-options-error>;

  /// Create issue field option
  record create-issue-field-option-params {
    /// The field key is specified in the following format: **$(app-key)\_\_$(field-key)**. For example, *example-add-on\_\_example-issue-field*. To determine the `fieldKey` value, do one of the following:
    /// 
    field-key: string,
    config: option<issue-field-option-configuration>,
    /// The properties of the option as arbitrary key-value pairs. These properties can be searched using JQL, if the extractions (see https://developer.atlassian.com/cloud/jira/platform/modules/issue-field-option-property-index/) are defined in the descriptor for the issue field module.
    properties: option<issue-field-option-create-bean-properties>,
    /// The option's name, which is displayed in Jira.
    value: string
  }
  create-issue-field-option: func(params: create-issue-field-option-params) -> result<issue-field-option, create-issue-field-option-error>;

  /// Get selectable issue field options
  record get-selectable-issue-field-options-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Filters the results to options that are only available in the specified project.
    project-id: option<s64>,
    /// The field key is specified in the following format: **$(app-key)\_\_$(field-key)**. For example, *example-add-on\_\_example-issue-field*. To determine the `fieldKey` value, do one of the following:
    /// 
    field-key: string
  }
  get-selectable-issue-field-options: func(params: get-selectable-issue-field-options-params) -> result<page-bean-issue-field-option, get-selectable-issue-field-options-error>;

  /// Get visible issue field options
  record get-visible-issue-field-options-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Filters the results to options that are only available in the specified project.
    project-id: option<s64>,
    /// The field key is specified in the following format: **$(app-key)\_\_$(field-key)**. For example, *example-add-on\_\_example-issue-field*. To determine the `fieldKey` value, do one of the following:
    /// 
    field-key: string
  }
  get-visible-issue-field-options: func(params: get-visible-issue-field-options-params) -> result<page-bean-issue-field-option, get-visible-issue-field-options-error>;

  /// Get issue field option
  record get-issue-field-option-params {
    /// The field key is specified in the following format: **$(app-key)\_\_$(field-key)**. For example, *example-add-on\_\_example-issue-field*. To determine the `fieldKey` value, do one of the following:
    /// 
    field-key: string,
    /// The ID of the option to be returned.
    option-id: string
  }
  get-issue-field-option: func(params: get-issue-field-option-params) -> result<issue-field-option, get-issue-field-option-error>;

  /// Update issue field option
  record update-issue-field-option-params {
    /// The field key is specified in the following format: **$(app-key)\_\_$(field-key)**. For example, *example-add-on\_\_example-issue-field*. To determine the `fieldKey` value, do one of the following:
    /// 
    field-key: string,
    /// The ID of the option to be updated.
    option-id: string,
    config: option<issue-field-option-configuration>,
    /// The unique identifier for the option. This is only unique within the select field's set of options.
    id: s64,
    /// The properties of the object, as arbitrary key-value pairs. These properties can be searched using JQL, if the extractions (see [Issue Field Option Property Index](https://developer.atlassian.com/cloud/jira/platform/modules/issue-field-option-property-index/)) are defined in the descriptor for the issue field module.
    properties: option<issue-field-option-properties>,
    /// The option's name, which is displayed in Jira.
    value: string
  }
  update-issue-field-option: func(params: update-issue-field-option-params) -> result<issue-field-option, update-issue-field-option-error>;

  /// Delete issue field option
  record delete-issue-field-option-params {
    /// The field key is specified in the following format: **$(app-key)\_\_$(field-key)**. For example, *example-add-on\_\_example-issue-field*. To determine the `fieldKey` value, do one of the following:
    /// 
    field-key: string,
    /// The ID of the option to be deleted.
    option-id: string
  }
  delete-issue-field-option: func(params: delete-issue-field-option-params) -> result<string, delete-issue-field-option-error>;

  /// Replace issue field option
  record replace-issue-field-option-params {
    /// The ID of the option that will replace the currently selected option.
    replace-with: option<s64>,
    /// A JQL query that specifies the issues to be updated. For example, *project=10000*.
    jql: option<string>,
    /// Whether screen security is overridden to enable hidden fields to be edited. Available to Connect and Forge app users with admin permission.
    override-screen-security: option<bool>,
    /// Whether screen security is overridden to enable uneditable fields to be edited. Available to Connect and Forge app users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-editable-flag: option<bool>,
    /// The field key is specified in the following format: **$(app-key)\_\_$(field-key)**. For example, *example-add-on\_\_example-issue-field*. To determine the `fieldKey` value, do one of the following:
    /// 
    field-key: string,
    /// The ID of the option to be deselected.
    option-id: string
  }
  replace-issue-field-option: func(params: replace-issue-field-option-params) -> result<string, replace-issue-field-option-error>;

}

interface issue-field-configurations {
  /// A page of items.
  record page-bean-field-configuration-details {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<field-configuration-details>>
  }

  /// Details of a field configuration.
  record field-configuration-details {
    /// The description of the field configuration.
    description: option<string>,
    /// The name of the field configuration. Must be unique.
    name: string
  }

  /// Details of a field configuration.
  record field-configuration {
    /// The description of the field configuration.
    description: string,
    /// The ID of the field configuration.
    id: s64,
    /// Whether the field configuration is the default.
    is-default: option<bool>,
    /// The name of the field configuration.
    name: string
  }

  /// A page of items.
  record page-bean-field-configuration-item {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<field-configuration-item>>
  }

  /// A field within a field configuration.
  record field-configuration-item {
    /// The description of the field within the field configuration.
    description: option<string>,
    /// The ID of the field within the field configuration.
    id: string,
    /// Whether the field is hidden in the field configuration.
    is-hidden: option<bool>,
    /// Whether the field is required in the field configuration.
    is-required: option<bool>,
    /// The renderer type for the field within the field configuration.
    renderer: option<string>
  }

  /// A page of items.
  record page-bean-field-configuration-scheme {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<field-configuration-scheme>>
  }

  /// Details of a field configuration scheme.
  record field-configuration-scheme {
    /// The description of the field configuration scheme.
    description: option<string>,
    /// The ID of the field configuration scheme.
    id: string,
    /// The name of the field configuration scheme.
    name: string
  }

  /// A page of items.
  record page-bean-field-configuration-issue-type-item {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<field-configuration-issue-type-item>>
  }

  /// The field configuration for an issue type.
  record field-configuration-issue-type-item {
    /// The ID of the field configuration.
    field-configuration-id: string,
    /// The ID of the field configuration scheme.
    field-configuration-scheme-id: string,
    /// The ID of the issue type or *default*. When set to *default* this field configuration issue type item applies to all issue types without a field configuration.
    issue-type-id: string
  }

  /// A page of items.
  record page-bean-field-configuration-scheme-projects {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<field-configuration-scheme-projects>>
  }

  /// Project list with assigned field configuration schema.
  record field-configuration-scheme-projects {
    field-configuration-scheme: option<field-configuration-scheme>,
    /// The IDs of projects using the field configuration scheme.
    project-ids: list<string>
  }

  /// The field configuration to issue type mapping.
  record field-configuration-to-issue-type-mapping {
    /// The ID of the field configuration.
    field-configuration-id: string,
    /// The ID of the issue type or *default*. When set to *default* this field configuration issue type item applies to all issue types without a field configuration. An issue type can be included only once in a request.
    issue-type-id: string
  }

  variant get-all-field-configurations-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-field-configuration-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant update-field-configuration-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-field-configuration-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-field-configuration-items-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-field-configuration-items-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-all-field-configuration-schemes-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-field-configuration-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-field-configuration-scheme-mappings-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-field-configuration-scheme-project-mapping-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant assign-field-configuration-scheme-to-project-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-field-configuration-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-field-configuration-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-field-configuration-scheme-mapping-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-issue-types-from-global-field-configuration-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all field configurations
  record get-all-field-configurations-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of field configuration IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`.
    id: option<list<s64>>,
    /// If *true* returns default field configurations only.
    is-default: option<bool>,
    /// The query string used to match against field configuration names and descriptions.
    query: option<string>
  }
  get-all-field-configurations: func(params: get-all-field-configurations-params) -> result<page-bean-field-configuration-details, get-all-field-configurations-error>;

  /// Create field configuration
  record create-field-configuration-params {
    /// The description of the field configuration.
    description: option<string>,
    /// The name of the field configuration. Must be unique.
    name: string
  }
  create-field-configuration: func(params: create-field-configuration-params) -> result<field-configuration, create-field-configuration-error>;

  /// Update field configuration
  record update-field-configuration-params {
    /// The ID of the field configuration.
    id: string,
    /// The description of the field configuration.
    description: option<string>,
    /// The name of the field configuration. Must be unique.
    name: string
  }
  update-field-configuration: func(params: update-field-configuration-params) -> result<string, update-field-configuration-error>;

  /// Delete field configuration
  record delete-field-configuration-params {
    /// The ID of the field configuration.
    id: string
  }
  delete-field-configuration: func(params: delete-field-configuration-params) -> result<string, delete-field-configuration-error>;

  /// Get field configuration items
  record get-field-configuration-items-params {
    /// The ID of the field configuration.
    id: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-field-configuration-items: func(params: get-field-configuration-items-params) -> result<page-bean-field-configuration-item, get-field-configuration-items-error>;

  /// Update field configuration items
  record update-field-configuration-items-params {
    /// The ID of the field configuration.
    id: string,
    /// Details of fields in a field configuration.
    field-configuration-items: list<field-configuration-item>
  }
  update-field-configuration-items: func(params: update-field-configuration-items-params) -> result<string, update-field-configuration-items-error>;

  /// Get all field configuration schemes
  record get-all-field-configuration-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of field configuration scheme IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`.
    id: option<list<s64>>
  }
  get-all-field-configuration-schemes: func(params: get-all-field-configuration-schemes-params) -> result<page-bean-field-configuration-scheme, get-all-field-configuration-schemes-error>;

  /// Create field configuration scheme
  record create-field-configuration-scheme-params {
    /// The description of the field configuration scheme.
    description: option<string>,
    /// The name of the field configuration scheme. The name must be unique.
    name: string
  }
  create-field-configuration-scheme: func(params: create-field-configuration-scheme-params) -> result<field-configuration-scheme, create-field-configuration-scheme-error>;

  /// Get field configuration issue type items
  record get-field-configuration-scheme-mappings-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of field configuration scheme IDs. To include multiple field configuration schemes separate IDs with ampersand: `fieldConfigurationSchemeId=10000&fieldConfigurationSchemeId=10001`.
    field-configuration-scheme-id: option<list<s64>>
  }
  get-field-configuration-scheme-mappings: func(params: get-field-configuration-scheme-mappings-params) -> result<page-bean-field-configuration-issue-type-item, get-field-configuration-scheme-mappings-error>;

  /// Get field configuration schemes for projects
  record get-field-configuration-scheme-project-mapping-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of project IDs. To include multiple projects, separate IDs with ampersand: `projectId=10000&projectId=10001`.
    project-id: list<s64>
  }
  get-field-configuration-scheme-project-mapping: func(params: get-field-configuration-scheme-project-mapping-params) -> result<page-bean-field-configuration-scheme-projects, get-field-configuration-scheme-project-mapping-error>;

  /// Assign field configuration scheme to project
  record assign-field-configuration-scheme-to-project-params {
    /// The ID of the field configuration scheme. If the field configuration scheme ID is `null`, the operation assigns the default field configuration scheme.
    field-configuration-scheme-id: option<string>,
    /// The ID of the project.
    project-id: string
  }
  assign-field-configuration-scheme-to-project: func(params: assign-field-configuration-scheme-to-project-params) -> result<string, assign-field-configuration-scheme-to-project-error>;

  /// Update field configuration scheme
  record update-field-configuration-scheme-params {
    /// The ID of the field configuration scheme.
    id: string,
    /// The description of the field configuration scheme.
    description: option<string>,
    /// The name of the field configuration scheme. The name must be unique.
    name: string
  }
  update-field-configuration-scheme: func(params: update-field-configuration-scheme-params) -> result<string, update-field-configuration-scheme-error>;

  /// Delete field configuration scheme
  record delete-field-configuration-scheme-params {
    /// The ID of the field configuration scheme.
    id: string
  }
  delete-field-configuration-scheme: func(params: delete-field-configuration-scheme-params) -> result<string, delete-field-configuration-scheme-error>;

  /// Assign issue types to field configurations
  record set-field-configuration-scheme-mapping-params {
    /// The ID of the field configuration scheme.
    id: string,
    /// Field configuration to issue type mappings.
    mappings: list<field-configuration-to-issue-type-mapping>
  }
  set-field-configuration-scheme-mapping: func(params: set-field-configuration-scheme-mapping-params) -> result<string, set-field-configuration-scheme-mapping-error>;

  /// Remove issue types from field configuration scheme
  record remove-issue-types-from-global-field-configuration-scheme-params {
    /// The ID of the field configuration scheme.
    id: string,
    /// The list of issue type IDs. Must contain unique values not longer than 255 characters and not be empty. Maximum of 100 IDs.
    issue-type-ids: list<string>
  }
  remove-issue-types-from-global-field-configuration-scheme: func(params: remove-issue-types-from-global-field-configuration-scheme-params) -> result<string, remove-issue-types-from-global-field-configuration-scheme-error>;

}

interface filters {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  enum project-assignee-type-enum {
    project-lead,
    unassigned,
  }

  enum project-component-assignee-type-enum {
    project-default,
    component-lead,
    project-lead,
    unassigned,
  }

  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum project-style-enum {
    classic,
    next-gen,
  }

  enum role-actor-type-op-enum {
    atlassian-group-role-actor,
    atlassian-user-role-actor,
  }

  enum share-permission-type-op-enum {
    user,
    group,
    project,
    project-role,
    global,
    loggedin,
    authenticated,
    project-unknown,
  }

  enum get-filters-paginated-order-by-enum {
    description,
    description-v2,
    description-v3,
    favourite-count,
    favourite-count-v2,
    favourite-count-v3,
    id,
    id-v2,
    id-v3,
    is-favourite,
    is-favourite-v2,
    is-favourite-v3,
    name,
    name-v2,
    name-v3,
    owner,
    owner-v2,
    owner-v3,
    is-shared,
    is-shared-v2,
    is-shared-v3,
  }

  /// Details about a filter.
  record filter {
    /// A description of the filter.
    description: option<string>,
    /// The groups and projects that can edit the filter.
    edit-permissions: option<list<share-permission>>,
    /// Whether the filter is selected as a favorite.
    favourite: option<bool>,
    /// The count of how many users have selected this filter as a favorite, including the filter owner.
    favourited-count: option<s64>,
    /// The unique identifier for the filter.
    id: option<string>,
    /// The JQL query for the filter. For example, *project = SSP AND issuetype = Bug*.
    jql: option<string>,
    /// The name of the filter. Must be unique.
    name: string,
    /// The user who owns the filter. This is defaulted to the creator of the filter, however Jira administrators can change the owner of a shared filter in the admin settings.
    owner: option<user>,
    /// A URL to view the filter results in Jira, using the [Search for issues using JQL](#api-rest-api-3-filter-search-get) operation with the filter's JQL string to return the filter results. For example, *https://your-domain.atlassian.net/rest/api/3/search?jql=project+%3D+SSP+AND+issuetype+%3D+Bug*.
    search-url: option<string>,
    /// The URL of the filter.
    self: option<string>,
    /// The groups and projects that the filter is shared with.
    share-permissions: option<list<share-permission>>,
    /// A paginated list of the users that the filter is shared with. This includes users that are members of the groups or can browse the projects that the filter is shared with.
    shared-users: option<user-list>,
    /// A paginated list of the users that are subscribed to the filter.
    subscriptions: option<filter-subscriptions-list>,
    /// A URL to view the filter results in Jira, using the ID of the filter. For example, *https://your-domain.atlassian.net/issues/?filter=10100*.
    view-url: option<string>
  }

  /// Details of a share permission for the filter.
  record share-permission {
    /// The group that the filter is shared with. For a request, specify the `groupId` or `name` property for the group. As a group's name can change, use of `groupId` is recommended.
    group: option<group-name>,
    /// The unique identifier of the share permission.
    id: option<s64>,
    /// The project that the filter is shared with. This is similar to the project object returned by [Get project](#api-rest-api-3-project-projectIdOrKey-get) but it contains a subset of the properties, which are: `self`, `id`, `key`, `assigneeType`, `name`, `roles`, `avatarUrls`, `projectType`, `simplified`.  
    /// For a request, specify the `id` for the project.
    project: option<project>,
    /// The project role that the filter is shared with.  
    /// For a request, specify the `id` for the role. You must also specify the `project` object and `id` for the project that the role is in.
    role: option<project-role>,
    /// The type of share permission:
    /// 
    type-op: share-permission-type-op-enum,
    /// The user account ID that the filter is shared with. For a request, specify the `accountId` property for the user.
    user: option<user-bean>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  /// Details about a project.
  record project {
    /// Whether the project is archived.
    archived: option<bool>,
    /// The user who archived the project.
    archived-by: option<user>,
    /// The date when the project was archived.
    archived-date: option<string>,
    /// The default assignee when creating issues for this project.
    assignee-type: option<project-assignee-type-enum>,
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// List of the components contained in the project.
    components: option<list<project-component>>,
    /// Whether the project is marked as deleted.
    deleted: option<bool>,
    /// The user who marked the project as deleted.
    deleted-by: option<user>,
    /// The date when the project was marked as deleted.
    deleted-date: option<string>,
    /// A brief description of the project.
    description: option<string>,
    /// An email address associated with the project.
    email: option<string>,
    /// Expand options that include additional project details in the response.
    expand: option<string>,
    /// Whether the project is selected as a favorite.
    favourite: option<bool>,
    /// The ID of the project.
    id: option<string>,
    /// Insights about the project.
    insight: option<project-insight>,
    /// Whether the project is private.
    is-private: option<bool>,
    /// The issue type hierarchy for the project.
    issue-type-hierarchy: option<hierarchy>,
    /// List of the issue types available in the project.
    issue-types: option<list<issue-type-details>>,
    /// The key of the project.
    key: option<string>,
    /// The project landing page info.
    landing-page-info: option<project-landing-page-info>,
    /// The username of the project lead.
    lead: option<user>,
    /// The name of the project.
    name: option<string>,
    /// User permissions on the project
    permissions: option<project-permissions>,
    /// The category the project belongs to.
    project-category: option<project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// Map of project properties
    properties: option<project-properties>,
    /// The date when the project is deleted permanently.
    retention-till-date: option<string>,
    /// The name and self URL for each role defined in the project. For more information, see [Create project role](#api-rest-api-3-role-post).
    roles: option<project-roles>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether the project is simplified.
    simplified: option<bool>,
    /// The type of the project.
    style: option<project-style-enum>,
    /// A link to information about this project, such as project documentation.
    url: option<string>,
    /// Unique ID for next-gen projects.
    uuid: option<string>,
    /// The versions defined in the project. For more information, see [Create version](#api-rest-api-3-version-post).
    versions: option<list<version>>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a project component.
  record project-component {
    /// The details of the user associated with `assigneeType`, if any. See `realAssignee` for details of the user assigned to issues created with this component.
    assignee: option<user>,
    /// The nominal user type used to determine the assignee for issues created with this component. See `realAssigneeType` for details on how the type of the user, and hence the user, assigned to issues is determined. Can take the following values:
    /// 
    assignee-type: option<project-component-assignee-type-enum>,
    /// The description for the component. Optional when creating or updating a component.
    description: option<string>,
    /// The unique identifier for the component.
    id: option<string>,
    /// Whether a user is associated with `assigneeType`. For example, if the `assigneeType` is set to `COMPONENT_LEAD` but the component lead is not set, then `false` is returned.
    is-assignee-type-valid: option<bool>,
    /// The user details for the component's lead user.
    lead: option<user>,
    /// The accountId of the component's lead user. The accountId uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    lead-account-id: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    lead-user-name: option<string>,
    /// The unique name for the component in the project. Required when creating a component. Optional when updating a component. The maximum length is 255 characters.
    name: option<string>,
    /// The key of the project the component is assigned to. Required when creating a component. Can't be updated.
    project: option<string>,
    /// The ID of the project the component is assigned to.
    project-id: option<s64>,
    /// The user assigned to issues created with this component, when `assigneeType` does not identify a valid assignee.
    real-assignee: option<user>,
    /// The type of the assignee that is assigned to issues created with this component, when an assignee cannot be set from the `assigneeType`. For example, `assigneeType` is set to `COMPONENT_LEAD` but no component lead is set. This property is set to one of the following values:
    /// 
    real-assignee-type: option<project-component-assignee-type-enum>,
    /// The URL of the component.
    self: option<string>
  }

  /// Additional details about a project.
  record project-insight {
    /// The last issue update time.
    last-issue-update-time: option<string>,
    /// Total issue count.
    total-issue-count: option<s64>
  }

  /// The project issue type hierarchy.
  record hierarchy {
    /// The ID of the base level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    base-level-id: option<s64>,
    /// Details about the hierarchy level.
    levels: option<list<simplified-hierarchy-level>>
  }

  record simplified-hierarchy-level {
    /// The ID of the level above this one in the hierarchy. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    above-level-id: option<s64>,
    /// The ID of the level below this one in the hierarchy. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    below-level-id: option<s64>,
    /// The external UUID of the hierarchy level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    external-uuid: option<string>,
    hierarchy-level-number: option<s32>,
    /// The ID of the hierarchy level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    id: option<s64>,
    /// The issue types available in this hierarchy level.
    issue-type-ids: option<list<s64>>,
    /// The level of this item in the hierarchy.
    level: option<s32>,
    /// The name of this hierarchy level.
    name: option<string>,
    /// The ID of the project configuration. This property is deprecated, see [Change oticen: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    project-configuration-id: option<s64>
  }

  /// Details about an issue type.
  record issue-type-details {
    /// The ID of the issue type's avatar.
    avatar-id: option<s64>,
    /// The description of the issue type.
    description: option<string>,
    /// Unique ID for next-gen projects.
    entity-id: option<string>,
    /// Hierarchy level of the issue type.
    hierarchy-level: option<s32>,
    /// The URL of the issue type's avatar.
    icon-url: option<string>,
    /// The ID of the issue type.
    id: option<string>,
    /// The name of the issue type.
    name: option<string>,
    /// Details of the next-gen projects the issue type is available in.
    scope: option<scope>,
    /// The URL of these issue type details.
    self: option<string>,
    /// Whether this issue type is used to create subtasks.
    subtask: option<bool>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  record project-landing-page-info {
    attributes: option<project-landing-page-info-attributes>,
    board-id: option<s64>,
    board-name: option<string>,
    project-key: option<string>,
    project-type: option<string>,
    queue-category: option<string>,
    queue-id: option<s64>,
    queue-name: option<string>,
    simple-board: option<bool>,
    simplified: option<bool>,
    url: option<string>
  }

  record project-landing-page-info-attributes {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Permissions which a user has on a project.
  record project-permissions {
    /// Whether the logged user can edit the project.
    can-edit: option<bool>
  }

  /// A project category.
  record project-category {
    /// The description of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The name of the project category. Required on create, optional on update.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// Map of project properties
  record project-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The name and self URL for each role defined in the project. For more information, see [Create project role](#api-rest-api-3-role-post).
  record project-roles {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a project version.
  record version {
    /// Indicates that the version is archived. Optional when creating or updating a version.
    archived: option<bool>,
    /// The description of the version. Optional when creating or updating a version.
    description: option<string>,
    /// Use [expand](em>#expansion) to include additional information about version in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The ID of the version.
    id: option<string>,
    /// If the expand option `issuesstatus` is used, returns the count of issues in this version for each of the status categories *to do*, *in progress*, *done*, and *unmapped*. The *unmapped* property contains a count of issues with a status other than *to do*, *in progress*, and *done*.
    issues-status-for-fix-version: option<version-issues-status>,
    /// The URL of the self link to the version to which all unfixed issues are moved when a version is released. Not applicable when creating a version. Optional when updating a version.
    move-unfixed-issues-to: option<string>,
    /// The unique name of the version. Required when creating a version. Optional when updating a version. The maximum length is 255 characters.
    name: option<string>,
    /// If the expand option `operations` is used, returns the list of operations available for this version.
    operations: option<list<simple-link>>,
    /// Indicates that the version is overdue.
    overdue: option<bool>,
    /// Deprecated. Use `projectId`.
    project: option<string>,
    /// The ID of the project to which this version is attached. Required when creating a version. Not applicable when updating a version.
    project-id: option<s64>,
    /// The release date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    release-date: option<string>,
    /// Indicates that the version is released. If the version is released a request to release again is ignored. Not applicable when creating a version. Optional when updating a version.
    released: option<bool>,
    /// The URL of the version.
    self: option<string>,
    /// The start date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    start-date: option<string>,
    /// The date on which work on this version is expected to finish, expressed in the instance's *Day/Month/Year Format* date format.
    user-release-date: option<string>,
    /// The date on which work on this version is expected to start, expressed in the instance's *Day/Month/Year Format* date format.
    user-start-date: option<string>
  }

  /// Counts of the number of issues in various statuses.
  record version-issues-status {
    /// Count of issues with status *done*.
    done: option<s64>,
    /// Count of issues with status *in progress*.
    in-progress: option<s64>,
    /// Count of issues with status *to do*.
    to-do: option<s64>,
    /// Count of issues with a status other than *to do*, *in progress*, and *done*.
    unmapped: option<s64>
  }

  /// Details about the operations available in this version.
  record simple-link {
    href: option<string>,
    icon-class: option<string>,
    id: option<string>,
    label: option<string>,
    style-class: option<string>,
    title: option<string>,
    weight: option<s32>
  }

  /// Details about the roles in a project.
  record project-role {
    /// The list of users who act in this role.
    actors: option<list<role-actor>>,
    /// Whether this role is the admin role for the project.
    admin: option<bool>,
    /// Whether the calling user is part of this role.
    current-user-role: option<bool>,
    /// Whether this role is the default role for the project
    default: option<bool>,
    /// The description of the project role.
    description: option<string>,
    /// The ID of the project role.
    id: option<s64>,
    /// The name of the project role.
    name: option<string>,
    /// Whether the roles are configurable for this project.
    role-configurable: option<bool>,
    /// The scope of the role. Indicated for roles associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
    scope: option<scope>,
    /// The URL the project role details.
    self: option<string>,
    /// The translated name of the project role.
    translated-name: option<string>
  }

  /// Details about a user assigned to a project role.
  record role-actor {
    actor-group: option<project-role-group>,
    actor-user: option<project-role-user>,
    /// The avatar of the role actor.
    avatar-url: option<string>,
    /// The display name of the role actor. For users, depending on the user’s privacy setting, this may return an alternative value for the user's name.
    display-name: option<string>,
    /// The ID of the role actor.
    id: option<s64>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The type of role actor.
    type-op: option<role-actor-type-op-enum>
  }

  /// Details of the group associated with the role.
  record project-role-group {
    /// The display name of the group.
    display-name: option<string>,
    /// The ID of the group.
    group-id: option<string>,
    /// The name of the group. As a group's name can change, use of `groupId` is recommended to identify the group.
    name: option<string>
  }

  /// Details of the user associated with the role.
  record project-role-user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Returns *unknown* if the record is deleted and corrupted, for example, as the result of a server import.
    account-id: option<string>
  }

  record user-bean {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<user-bean-avatar-urls>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// This property is deprecated in favor of `accountId` because of privacy changes. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.  
    /// The key of the user.
    key: option<string>,
    /// This property is deprecated in favor of `accountId` because of privacy changes. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.  
    /// The username of the user.
    name: option<string>,
    /// The URL of the user.
    self: option<string>
  }

  record user-bean-avatar-urls {
    /// The URL of the user's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the user's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the user's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the user's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A paginated list of users sharing the filter. This includes users that are members of the groups or can browse the projects that the filter is shared with.
  record user-list {
    /// The index of the last item returned on the page.
    end-index: option<s32>,
    /// The list of items.
    items: option<list<user>>,
    /// The maximum number of results that could be on the page.
    max-results: option<s32>,
    /// The number of items on the page.
    size: option<s32>,
    /// The index of the first item returned on the page.
    start-index: option<s32>
  }

  /// A paginated list of subscriptions to a filter.
  record filter-subscriptions-list {
    /// The index of the last item returned on the page.
    end-index: option<s32>,
    /// The list of items.
    items: option<list<filter-subscription>>,
    /// The maximum number of results that could be on the page.
    max-results: option<s32>,
    /// The number of items on the page.
    size: option<s32>,
    /// The index of the first item returned on the page.
    start-index: option<s32>
  }

  /// Details of a user or group subscribing to a filter.
  record filter-subscription {
    /// The group subscribing to filter.
    group: option<group-name>,
    /// The ID of the filter subscription.
    id: option<s64>,
    /// The user subscribing to filter.
    user: option<user>
  }

  /// A page of items.
  record page-bean-filter-details {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<filter-details>>
  }

  /// Details of a filter.
  record filter-details {
    /// The description of the filter.
    description: option<string>,
    /// The groups and projects that can edit the filter. This can be specified when updating a filter, but not when creating a filter.
    edit-permissions: option<list<share-permission>>,
    /// Expand options that include additional filter details in the response.
    expand: option<string>,
    /// Whether the filter is selected as a favorite by any users, not including the filter owner.
    favourite: option<bool>,
    /// The count of how many users have selected this filter as a favorite, including the filter owner.
    favourited-count: option<s64>,
    /// The unique identifier for the filter.
    id: option<string>,
    /// The JQL query for the filter. For example, *project = SSP AND issuetype = Bug*.
    jql: option<string>,
    /// The name of the filter.
    name: string,
    /// The user who owns the filter. Defaults to the creator of the filter, however, Jira administrators can change the owner of a shared filter in the admin settings.
    owner: option<user>,
    /// A URL to view the filter results in Jira, using the [Search for issues using JQL](#api-rest-api-3-filter-search-get) operation with the filter's JQL string to return the filter results. For example, *https://your-domain.atlassian.net/rest/api/3/search?jql=project+%3D+SSP+AND+issuetype+%3D+Bug*.
    search-url: option<string>,
    /// The URL of the filter.
    self: option<string>,
    /// The groups and projects that the filter is shared with. This can be specified when updating a filter, but not when creating a filter.
    share-permissions: option<list<share-permission>>,
    /// The users that are subscribed to the filter.
    subscriptions: option<list<filter-subscription>>,
    /// A URL to view the filter results in Jira, using the ID of the filter. For example, *https://your-domain.atlassian.net/issues/?filter=10100*.
    view-url: option<string>
  }

  /// Details of an issue navigator column item.
  record column-item {
    /// The issue navigator column label.
    label: option<string>,
    /// The issue navigator column value.
    value: option<string>
  }

  variant create-filter-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-favourite-filters-error {
    unauthorized(string),
    other(string)
  }

  variant get-my-filters-error {
    unauthorized(string),
    other(string)
  }

  variant get-filters-paginated-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-filter-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant update-filter-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-filter-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-columns-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant set-columns-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant reset-columns-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant set-favourite-for-filter-error {
    bad-request(string),
    other(string)
  }

  variant delete-favourite-for-filter-error {
    bad-request(string),
    other(string)
  }

  variant change-filter-owner-v2-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Create filter
  record create-filter-params {
    /// Use [expand](#expansion) to include additional information about filter in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// EXPERIMENTAL: Whether share permissions are overridden to enable filters with any share permissions to be created. Available to users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-share-permissions: option<bool>,
    /// A description of the filter.
    description: option<string>,
    /// The groups and projects that can edit the filter.
    edit-permissions: option<list<share-permission>>,
    /// Whether the filter is selected as a favorite.
    favourite: option<bool>,
    /// The count of how many users have selected this filter as a favorite, including the filter owner.
    favourited-count: option<s64>,
    /// The unique identifier for the filter.
    id: option<string>,
    /// The JQL query for the filter. For example, *project = SSP AND issuetype = Bug*.
    jql: option<string>,
    /// The name of the filter. Must be unique.
    name: string,
    /// The user who owns the filter. This is defaulted to the creator of the filter, however Jira administrators can change the owner of a shared filter in the admin settings.
    owner: option<user>,
    /// A URL to view the filter results in Jira, using the [Search for issues using JQL](#api-rest-api-3-filter-search-get) operation with the filter's JQL string to return the filter results. For example, *https://your-domain.atlassian.net/rest/api/3/search?jql=project+%3D+SSP+AND+issuetype+%3D+Bug*.
    search-url: option<string>,
    /// The URL of the filter.
    self: option<string>,
    /// The groups and projects that the filter is shared with.
    share-permissions: option<list<share-permission>>,
    /// A paginated list of the users that the filter is shared with. This includes users that are members of the groups or can browse the projects that the filter is shared with.
    shared-users: option<user-list>,
    /// A paginated list of the users that are subscribed to the filter.
    subscriptions: option<filter-subscriptions-list>,
    /// A URL to view the filter results in Jira, using the ID of the filter. For example, *https://your-domain.atlassian.net/issues/?filter=10100*.
    view-url: option<string>
  }
  create-filter: func(params: create-filter-params) -> result<filter, create-filter-error>;

  /// Get favorite filters
  record get-favourite-filters-params {
    /// Use [expand](#expansion) to include additional information about filter in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-favourite-filters: func(params: get-favourite-filters-params) -> result<list<filter>, get-favourite-filters-error>;

  /// Get my filters
  record get-my-filters-params {
    /// Use [expand](#expansion) to include additional information about filter in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// Include the user's favorite filters in the response.
    include-favourites: option<bool>
  }
  get-my-filters: func(params: get-my-filters-params) -> result<list<filter>, get-my-filters-error>;

  /// Search for filters
  record get-filters-paginated-params {
    /// String used to perform a case-insensitive partial match with `name`.
    filter-name: option<string>,
    /// User account ID used to return filters with the matching `owner.accountId`. This parameter cannot be used with `owner`.
    account-id: option<string>,
    /// This parameter is deprecated because of privacy changes. Use `accountId` instead. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details. User name used to return filters with the matching `owner.name`. This parameter cannot be used with `accountId`.
    owner: option<string>,
    /// As a group's name can change, use of `groupId` is recommended to identify a group. Group name used to returns filters that are shared with a group that matches `sharePermissions.group.groupname`. This parameter cannot be used with the `groupId` parameter.
    groupname: option<string>,
    /// Group ID used to returns filters that are shared with a group that matches `sharePermissions.group.groupId`. This parameter cannot be used with the `groupname` parameter.
    group-id: option<string>,
    /// Project ID used to returns filters that are shared with a project that matches `sharePermissions.project.id`.
    project-id: option<s64>,
    /// The list of filter IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`. Do not exceed 200 filter IDs.
    id: option<list<s64>>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-filters-paginated-order-by-enum>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Use [expand](#expansion) to include additional information about filter in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// EXPERIMENTAL: Whether share permissions are overridden to enable filters with any share permissions to be returned. Available to users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-share-permissions: option<bool>
  }
  get-filters-paginated: func(params: get-filters-paginated-params) -> result<page-bean-filter-details, get-filters-paginated-error>;

  /// Get filter
  record get-filter-params {
    /// The ID of the filter to return.
    id: string,
    /// Use [expand](#expansion) to include additional information about filter in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// EXPERIMENTAL: Whether share permissions are overridden to enable filters with any share permissions to be returned. Available to users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-share-permissions: option<bool>
  }
  get-filter: func(params: get-filter-params) -> result<filter, get-filter-error>;

  /// Update filter
  record update-filter-params {
    /// The ID of the filter to update.
    id: string,
    /// Use [expand](#expansion) to include additional information about filter in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// EXPERIMENTAL: Whether share permissions are overridden to enable the addition of any share permissions to filters. Available to users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-share-permissions: option<bool>,
    /// A description of the filter.
    description: option<string>,
    /// The groups and projects that can edit the filter.
    edit-permissions: option<list<share-permission>>,
    /// Whether the filter is selected as a favorite.
    favourite: option<bool>,
    /// The count of how many users have selected this filter as a favorite, including the filter owner.
    favourited-count: option<s64>,
    /// The unique identifier for the filter.
    id-v2: option<string>,
    /// The JQL query for the filter. For example, *project = SSP AND issuetype = Bug*.
    jql: option<string>,
    /// The name of the filter. Must be unique.
    name: string,
    /// The user who owns the filter. This is defaulted to the creator of the filter, however Jira administrators can change the owner of a shared filter in the admin settings.
    owner: option<user>,
    /// A URL to view the filter results in Jira, using the [Search for issues using JQL](#api-rest-api-3-filter-search-get) operation with the filter's JQL string to return the filter results. For example, *https://your-domain.atlassian.net/rest/api/3/search?jql=project+%3D+SSP+AND+issuetype+%3D+Bug*.
    search-url: option<string>,
    /// The URL of the filter.
    self: option<string>,
    /// The groups and projects that the filter is shared with.
    share-permissions: option<list<share-permission>>,
    /// A paginated list of the users that the filter is shared with. This includes users that are members of the groups or can browse the projects that the filter is shared with.
    shared-users: option<user-list>,
    /// A paginated list of the users that are subscribed to the filter.
    subscriptions: option<filter-subscriptions-list>,
    /// A URL to view the filter results in Jira, using the ID of the filter. For example, *https://your-domain.atlassian.net/issues/?filter=10100*.
    view-url: option<string>
  }
  update-filter: func(params: update-filter-params) -> result<filter, update-filter-error>;

  /// Delete filter
  record delete-filter-params {
    /// The ID of the filter to delete.
    id: string
  }
  delete-filter: func(params: delete-filter-params) -> result<string, delete-filter-error>;

  /// Get columns
  record get-columns-params {
    /// The ID of the filter.
    id: string
  }
  get-columns: func(params: get-columns-params) -> result<list<column-item>, get-columns-error>;

  /// Set columns
  record set-columns-params {
    /// The ID of the filter.
    id: string,
    body: option<list<string>>
  }
  set-columns: func(params: set-columns-params) -> result<string, set-columns-error>;

  /// Reset columns
  record reset-columns-params {
    /// The ID of the filter.
    id: string
  }
  reset-columns: func(params: reset-columns-params) -> result<string, reset-columns-error>;

  /// Add filter as favorite
  record set-favourite-for-filter-params {
    /// The ID of the filter.
    id: string,
    /// Use [expand](#expansion) to include additional information about filter in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  set-favourite-for-filter: func(params: set-favourite-for-filter-params) -> result<filter, set-favourite-for-filter-error>;

  /// Remove filter as favorite
  record delete-favourite-for-filter-params {
    /// The ID of the filter.
    id: string,
    /// Use [expand](#expansion) to include additional information about filter in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  delete-favourite-for-filter: func(params: delete-favourite-for-filter-params) -> result<filter, delete-favourite-for-filter-error>;

  /// Change filter owner
  record change-filter-owner-v2-params {
    /// The ID of the filter to update.
    id: string,
    /// The account ID of the new owner.
    account-id: string
  }
  change-filter-owner-v2: func(params: change-filter-owner-v2-params) -> result<string, change-filter-owner-v2-error>;

}

interface filter-sharing {
  enum default-share-scope-scope-enum {
    global,
    authenticated,
    private,
  }

  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  enum project-assignee-type-enum {
    project-lead,
    unassigned,
  }

  enum project-component-assignee-type-enum {
    project-default,
    component-lead,
    project-lead,
    unassigned,
  }

  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum project-style-enum {
    classic,
    next-gen,
  }

  enum role-actor-type-op-enum {
    atlassian-group-role-actor,
    atlassian-user-role-actor,
  }

  enum share-permission-type-op-enum {
    user,
    group,
    project,
    project-role,
    global,
    loggedin,
    authenticated,
    project-unknown,
  }

  enum share-permission-input-bean-type-op-enum {
    user,
    project,
    group,
    project-role,
    global,
    authenticated,
  }

  /// Details of the scope of the default sharing for new filters and dashboards.
  record default-share-scope {
    /// The scope of the default sharing for new filters and dashboards:
    /// 
    scope: default-share-scope-scope-enum
  }

  /// Details of a share permission for the filter.
  record share-permission {
    /// The group that the filter is shared with. For a request, specify the `groupId` or `name` property for the group. As a group's name can change, use of `groupId` is recommended.
    group: option<group-name>,
    /// The unique identifier of the share permission.
    id: option<s64>,
    /// The project that the filter is shared with. This is similar to the project object returned by [Get project](#api-rest-api-3-project-projectIdOrKey-get) but it contains a subset of the properties, which are: `self`, `id`, `key`, `assigneeType`, `name`, `roles`, `avatarUrls`, `projectType`, `simplified`.  
    /// For a request, specify the `id` for the project.
    project: option<project>,
    /// The project role that the filter is shared with.  
    /// For a request, specify the `id` for the role. You must also specify the `project` object and `id` for the project that the role is in.
    role: option<project-role>,
    /// The type of share permission:
    /// 
    type-op: share-permission-type-op-enum,
    /// The user account ID that the filter is shared with. For a request, specify the `accountId` property for the user.
    user: option<user-bean>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  /// Details about a project.
  record project {
    /// Whether the project is archived.
    archived: option<bool>,
    /// The user who archived the project.
    archived-by: option<user>,
    /// The date when the project was archived.
    archived-date: option<string>,
    /// The default assignee when creating issues for this project.
    assignee-type: option<project-assignee-type-enum>,
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// List of the components contained in the project.
    components: option<list<project-component>>,
    /// Whether the project is marked as deleted.
    deleted: option<bool>,
    /// The user who marked the project as deleted.
    deleted-by: option<user>,
    /// The date when the project was marked as deleted.
    deleted-date: option<string>,
    /// A brief description of the project.
    description: option<string>,
    /// An email address associated with the project.
    email: option<string>,
    /// Expand options that include additional project details in the response.
    expand: option<string>,
    /// Whether the project is selected as a favorite.
    favourite: option<bool>,
    /// The ID of the project.
    id: option<string>,
    /// Insights about the project.
    insight: option<project-insight>,
    /// Whether the project is private.
    is-private: option<bool>,
    /// The issue type hierarchy for the project.
    issue-type-hierarchy: option<hierarchy>,
    /// List of the issue types available in the project.
    issue-types: option<list<issue-type-details>>,
    /// The key of the project.
    key: option<string>,
    /// The project landing page info.
    landing-page-info: option<project-landing-page-info>,
    /// The username of the project lead.
    lead: option<user>,
    /// The name of the project.
    name: option<string>,
    /// User permissions on the project
    permissions: option<project-permissions>,
    /// The category the project belongs to.
    project-category: option<project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// Map of project properties
    properties: option<project-properties>,
    /// The date when the project is deleted permanently.
    retention-till-date: option<string>,
    /// The name and self URL for each role defined in the project. For more information, see [Create project role](#api-rest-api-3-role-post).
    roles: option<project-roles>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether the project is simplified.
    simplified: option<bool>,
    /// The type of the project.
    style: option<project-style-enum>,
    /// A link to information about this project, such as project documentation.
    url: option<string>,
    /// Unique ID for next-gen projects.
    uuid: option<string>,
    /// The versions defined in the project. For more information, see [Create version](#api-rest-api-3-version-post).
    versions: option<list<version>>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a project component.
  record project-component {
    /// The details of the user associated with `assigneeType`, if any. See `realAssignee` for details of the user assigned to issues created with this component.
    assignee: option<user>,
    /// The nominal user type used to determine the assignee for issues created with this component. See `realAssigneeType` for details on how the type of the user, and hence the user, assigned to issues is determined. Can take the following values:
    /// 
    assignee-type: option<project-component-assignee-type-enum>,
    /// The description for the component. Optional when creating or updating a component.
    description: option<string>,
    /// The unique identifier for the component.
    id: option<string>,
    /// Whether a user is associated with `assigneeType`. For example, if the `assigneeType` is set to `COMPONENT_LEAD` but the component lead is not set, then `false` is returned.
    is-assignee-type-valid: option<bool>,
    /// The user details for the component's lead user.
    lead: option<user>,
    /// The accountId of the component's lead user. The accountId uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    lead-account-id: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    lead-user-name: option<string>,
    /// The unique name for the component in the project. Required when creating a component. Optional when updating a component. The maximum length is 255 characters.
    name: option<string>,
    /// The key of the project the component is assigned to. Required when creating a component. Can't be updated.
    project: option<string>,
    /// The ID of the project the component is assigned to.
    project-id: option<s64>,
    /// The user assigned to issues created with this component, when `assigneeType` does not identify a valid assignee.
    real-assignee: option<user>,
    /// The type of the assignee that is assigned to issues created with this component, when an assignee cannot be set from the `assigneeType`. For example, `assigneeType` is set to `COMPONENT_LEAD` but no component lead is set. This property is set to one of the following values:
    /// 
    real-assignee-type: option<project-component-assignee-type-enum>,
    /// The URL of the component.
    self: option<string>
  }

  /// Additional details about a project.
  record project-insight {
    /// The last issue update time.
    last-issue-update-time: option<string>,
    /// Total issue count.
    total-issue-count: option<s64>
  }

  /// The project issue type hierarchy.
  record hierarchy {
    /// The ID of the base level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    base-level-id: option<s64>,
    /// Details about the hierarchy level.
    levels: option<list<simplified-hierarchy-level>>
  }

  record simplified-hierarchy-level {
    /// The ID of the level above this one in the hierarchy. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    above-level-id: option<s64>,
    /// The ID of the level below this one in the hierarchy. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    below-level-id: option<s64>,
    /// The external UUID of the hierarchy level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    external-uuid: option<string>,
    hierarchy-level-number: option<s32>,
    /// The ID of the hierarchy level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    id: option<s64>,
    /// The issue types available in this hierarchy level.
    issue-type-ids: option<list<s64>>,
    /// The level of this item in the hierarchy.
    level: option<s32>,
    /// The name of this hierarchy level.
    name: option<string>,
    /// The ID of the project configuration. This property is deprecated, see [Change oticen: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    project-configuration-id: option<s64>
  }

  /// Details about an issue type.
  record issue-type-details {
    /// The ID of the issue type's avatar.
    avatar-id: option<s64>,
    /// The description of the issue type.
    description: option<string>,
    /// Unique ID for next-gen projects.
    entity-id: option<string>,
    /// Hierarchy level of the issue type.
    hierarchy-level: option<s32>,
    /// The URL of the issue type's avatar.
    icon-url: option<string>,
    /// The ID of the issue type.
    id: option<string>,
    /// The name of the issue type.
    name: option<string>,
    /// Details of the next-gen projects the issue type is available in.
    scope: option<scope>,
    /// The URL of these issue type details.
    self: option<string>,
    /// Whether this issue type is used to create subtasks.
    subtask: option<bool>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  record project-landing-page-info {
    attributes: option<project-landing-page-info-attributes>,
    board-id: option<s64>,
    board-name: option<string>,
    project-key: option<string>,
    project-type: option<string>,
    queue-category: option<string>,
    queue-id: option<s64>,
    queue-name: option<string>,
    simple-board: option<bool>,
    simplified: option<bool>,
    url: option<string>
  }

  record project-landing-page-info-attributes {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Permissions which a user has on a project.
  record project-permissions {
    /// Whether the logged user can edit the project.
    can-edit: option<bool>
  }

  /// A project category.
  record project-category {
    /// The description of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The name of the project category. Required on create, optional on update.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// Map of project properties
  record project-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The name and self URL for each role defined in the project. For more information, see [Create project role](#api-rest-api-3-role-post).
  record project-roles {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a project version.
  record version {
    /// Indicates that the version is archived. Optional when creating or updating a version.
    archived: option<bool>,
    /// The description of the version. Optional when creating or updating a version.
    description: option<string>,
    /// Use [expand](em>#expansion) to include additional information about version in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The ID of the version.
    id: option<string>,
    /// If the expand option `issuesstatus` is used, returns the count of issues in this version for each of the status categories *to do*, *in progress*, *done*, and *unmapped*. The *unmapped* property contains a count of issues with a status other than *to do*, *in progress*, and *done*.
    issues-status-for-fix-version: option<version-issues-status>,
    /// The URL of the self link to the version to which all unfixed issues are moved when a version is released. Not applicable when creating a version. Optional when updating a version.
    move-unfixed-issues-to: option<string>,
    /// The unique name of the version. Required when creating a version. Optional when updating a version. The maximum length is 255 characters.
    name: option<string>,
    /// If the expand option `operations` is used, returns the list of operations available for this version.
    operations: option<list<simple-link>>,
    /// Indicates that the version is overdue.
    overdue: option<bool>,
    /// Deprecated. Use `projectId`.
    project: option<string>,
    /// The ID of the project to which this version is attached. Required when creating a version. Not applicable when updating a version.
    project-id: option<s64>,
    /// The release date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    release-date: option<string>,
    /// Indicates that the version is released. If the version is released a request to release again is ignored. Not applicable when creating a version. Optional when updating a version.
    released: option<bool>,
    /// The URL of the version.
    self: option<string>,
    /// The start date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    start-date: option<string>,
    /// The date on which work on this version is expected to finish, expressed in the instance's *Day/Month/Year Format* date format.
    user-release-date: option<string>,
    /// The date on which work on this version is expected to start, expressed in the instance's *Day/Month/Year Format* date format.
    user-start-date: option<string>
  }

  /// Counts of the number of issues in various statuses.
  record version-issues-status {
    /// Count of issues with status *done*.
    done: option<s64>,
    /// Count of issues with status *in progress*.
    in-progress: option<s64>,
    /// Count of issues with status *to do*.
    to-do: option<s64>,
    /// Count of issues with a status other than *to do*, *in progress*, and *done*.
    unmapped: option<s64>
  }

  /// Details about the operations available in this version.
  record simple-link {
    href: option<string>,
    icon-class: option<string>,
    id: option<string>,
    label: option<string>,
    style-class: option<string>,
    title: option<string>,
    weight: option<s32>
  }

  /// Details about the roles in a project.
  record project-role {
    /// The list of users who act in this role.
    actors: option<list<role-actor>>,
    /// Whether this role is the admin role for the project.
    admin: option<bool>,
    /// Whether the calling user is part of this role.
    current-user-role: option<bool>,
    /// Whether this role is the default role for the project
    default: option<bool>,
    /// The description of the project role.
    description: option<string>,
    /// The ID of the project role.
    id: option<s64>,
    /// The name of the project role.
    name: option<string>,
    /// Whether the roles are configurable for this project.
    role-configurable: option<bool>,
    /// The scope of the role. Indicated for roles associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
    scope: option<scope>,
    /// The URL the project role details.
    self: option<string>,
    /// The translated name of the project role.
    translated-name: option<string>
  }

  /// Details about a user assigned to a project role.
  record role-actor {
    actor-group: option<project-role-group>,
    actor-user: option<project-role-user>,
    /// The avatar of the role actor.
    avatar-url: option<string>,
    /// The display name of the role actor. For users, depending on the user’s privacy setting, this may return an alternative value for the user's name.
    display-name: option<string>,
    /// The ID of the role actor.
    id: option<s64>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The type of role actor.
    type-op: option<role-actor-type-op-enum>
  }

  /// Details of the group associated with the role.
  record project-role-group {
    /// The display name of the group.
    display-name: option<string>,
    /// The ID of the group.
    group-id: option<string>,
    /// The name of the group. As a group's name can change, use of `groupId` is recommended to identify the group.
    name: option<string>
  }

  /// Details of the user associated with the role.
  record project-role-user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Returns *unknown* if the record is deleted and corrupted, for example, as the result of a server import.
    account-id: option<string>
  }

  record user-bean {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<user-bean-avatar-urls>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// This property is deprecated in favor of `accountId` because of privacy changes. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.  
    /// The key of the user.
    key: option<string>,
    /// This property is deprecated in favor of `accountId` because of privacy changes. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.  
    /// The username of the user.
    name: option<string>,
    /// The URL of the user.
    self: option<string>
  }

  record user-bean-avatar-urls {
    /// The URL of the user's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the user's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the user's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the user's 48x48 pixel avatar.
    v48x48: option<string>
  }

  variant get-default-share-scope-error {
    unauthorized(string),
    other(string)
  }

  variant set-default-share-scope-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-share-permissions-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-share-permission-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-share-permission-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-share-permission-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get default share scope
  get-default-share-scope: func() -> result<default-share-scope, get-default-share-scope-error>;

  /// Set default share scope
  record set-default-share-scope-params {
    /// The scope of the default sharing for new filters and dashboards:
    /// 
    scope: default-share-scope-scope-enum
  }
  set-default-share-scope: func(params: set-default-share-scope-params) -> result<default-share-scope, set-default-share-scope-error>;

  /// Get share permissions
  record get-share-permissions-params {
    /// The ID of the filter.
    id: string
  }
  get-share-permissions: func(params: get-share-permissions-params) -> result<list<share-permission>, get-share-permissions-error>;

  /// Add share permission
  record add-share-permission-params {
    /// The ID of the filter.
    id: string,
    /// The user account ID that the filter is shared with. For a request, specify the `accountId` property for the user.
    account-id: option<string>,
    /// The ID of the group, which uniquely identifies the group across all Atlassian products.For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*. Cannot be provided with `groupname`.
    group-id: option<string>,
    /// The name of the group to share the filter with. Set `type` to `group`. Please note that the name of a group is mutable, to reliably identify a group use `groupId`.
    groupname: option<string>,
    /// The ID of the project to share the filter with. Set `type` to `project`.
    project-id: option<string>,
    /// The ID of the project role to share the filter with. Set `type` to `projectRole` and the `projectId` for the project that the role is in.
    project-role-id: option<string>,
    /// The rights for the share permission.
    rights: option<s32>,
    /// The type of the share permission.Specify the type as follows:
    /// 
    type-op: share-permission-input-bean-type-op-enum
  }
  add-share-permission: func(params: add-share-permission-params) -> result<list<share-permission>, add-share-permission-error>;

  /// Get share permission
  record get-share-permission-params {
    /// The ID of the filter.
    id: string,
    /// The ID of the share permission.
    permission-id: string
  }
  get-share-permission: func(params: get-share-permission-params) -> result<share-permission, get-share-permission-error>;

  /// Delete share permission
  record delete-share-permission-params {
    /// The ID of the filter.
    id: string,
    /// The ID of the share permission.
    permission-id: string
  }
  delete-share-permission: func(params: delete-share-permission-params) -> result<string, delete-share-permission-error>;

}

interface groups {
  enum group-label-type-op-enum {
    admin,
    single,
    multiple,
  }

  record group {
    /// Expand options that include additional group details in the response.
    expand: option<string>,
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>,
    /// A paginated list of the users that are members of the group. A maximum of 50 users is returned in the list, to access additional users append `[start-index:end-index]` to the expand request. For example, to access the next 50 users, use`?expand=users[51:100]`.
    users: option<paged-list-user-details-application-user>
  }

  /// A paged list. To access additional details append `[start-index:end-index]` to the expand request. For example, `?expand=sharedUsers[10:40]` returns a list starting at item 10 and finishing at item 40.
  record paged-list-user-details-application-user {
    /// The index of the last item returned on the page.
    end-index: option<s32>,
    /// The list of items.
    items: option<list<user-details>>,
    /// The maximum number of results that could be on the page.
    max-results: option<s32>,
    /// The number of items on the page.
    size: option<s32>,
    /// The index of the first item returned on the page.
    start-index: option<s32>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A page of items.
  record page-bean-group-details {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<group-details>>
  }

  /// Details about a group.
  record group-details {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of the group.
    name: option<string>
  }

  /// A page of items.
  record page-bean-user-details {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<user-details>>
  }

  /// The list of groups found in a search, including header text (Showing X of Y matching groups) and total of matched groups.
  record found-groups {
    groups: option<list<found-group>>,
    /// Header text indicating the number of groups in the response and the total number of groups found in the search.
    header: option<string>,
    /// The total number of groups found in the search.
    total: option<s32>
  }

  /// A group found in a search.
  record found-group {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The group name with the matched query string highlighted with the HTML bold tag.
    html: option<string>,
    labels: option<list<group-label>>,
    /// The name of the group. The name of a group is mutable, to reliably identify a group use ``groupId`.`
    name: option<string>
  }

  /// A group label.
  record group-label {
    /// The group label name.
    text: option<string>,
    /// The title of the group label.
    title: option<string>,
    /// The type of the group label.
    type-op: option<group-label-type-op-enum>
  }

  variant get-group-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-group-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant remove-group-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant bulk-get-groups-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    internal-server-error(string),
    other(string)
  }

  variant get-users-from-group-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-user-to-group-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-user-from-group-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get group
  record get-group-params {
    /// As a group's name can change, use of `groupId` is recommended to identify a group.  
    /// The name of the group. This parameter cannot be used with the `groupId` parameter.
    groupname: option<string>,
    /// The ID of the group. This parameter cannot be used with the `groupName` parameter.
    group-id: option<string>,
    /// List of fields to expand.
    expand: option<string>
  }
  get-group: func(params: get-group-params) -> result<group, get-group-error>;

  /// Create group
  record create-group-params {
    /// The name of the group.
    name: string
  }
  create-group: func(params: create-group-params) -> result<group, create-group-error>;

  /// Remove group
  record remove-group-params {
    groupname: option<string>,
    /// The ID of the group. This parameter cannot be used with the `groupname` parameter.
    group-id: option<string>,
    /// As a group's name can change, use of `swapGroupId` is recommended to identify a group.  
    /// The group to transfer restrictions to. Only comments and worklogs are transferred. If restrictions are not transferred, comments and worklogs are inaccessible after the deletion. This parameter cannot be used with the `swapGroupId` parameter.
    swap-group: option<string>,
    /// The ID of the group to transfer restrictions to. Only comments and worklogs are transferred. If restrictions are not transferred, comments and worklogs are inaccessible after the deletion. This parameter cannot be used with the `swapGroup` parameter.
    swap-group-id: option<string>
  }
  remove-group: func(params: remove-group-params) -> result<string, remove-group-error>;

  /// Bulk get groups
  record bulk-get-groups-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The ID of a group. To specify multiple IDs, pass multiple `groupId` parameters. For example, `groupId=5b10a2844c20165700ede21g&groupId=5b10ac8d82e05b22cc7d4ef5`.
    group-id: option<list<string>>,
    /// The name of a group. To specify multiple names, pass multiple `groupName` parameters. For example, `groupName=administrators&groupName=jira-software-users`.
    group-name: option<list<string>>,
    /// The access level of a group. Valid values: 'site-admin', 'admin', 'user'.
    access-type: option<string>,
    /// The application key of the product user groups to search for. Valid values: 'jira-servicedesk', 'jira-software', 'jira-product-discovery', 'jira-core'.
    application-key: option<string>
  }
  bulk-get-groups: func(params: bulk-get-groups-params) -> result<page-bean-group-details, bulk-get-groups-error>;

  /// Get users from group
  record get-users-from-group-params {
    /// As a group's name can change, use of `groupId` is recommended to identify a group.  
    /// The name of the group. This parameter cannot be used with the `groupId` parameter.
    groupname: option<string>,
    /// The ID of the group. This parameter cannot be used with the `groupName` parameter.
    group-id: option<string>,
    /// Include inactive users.
    include-inactive-users: option<bool>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-users-from-group: func(params: get-users-from-group-params) -> result<page-bean-user-details, get-users-from-group-error>;

  /// Add user to group
  record add-user-to-group-params {
    /// As a group's name can change, use of `groupId` is recommended to identify a group.  
    /// The name of the group. This parameter cannot be used with the `groupId` parameter.
    groupname: option<string>,
    /// The ID of the group. This parameter cannot be used with the `groupName` parameter.
    group-id: option<string>,
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// This property is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>
  }
  add-user-to-group: func(params: add-user-to-group-params) -> result<group, add-user-to-group-error>;

  /// Remove user from group
  record remove-user-from-group-params {
    /// As a group's name can change, use of `groupId` is recommended to identify a group.  
    /// The name of the group. This parameter cannot be used with the `groupId` parameter.
    groupname: option<string>,
    /// The ID of the group. This parameter cannot be used with the `groupName` parameter.
    group-id: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: string
  }
  remove-user-from-group: func(params: remove-user-from-group-params) -> result<string, remove-user-from-group-error>;

  /// Find groups
  record find-groups-params {
    /// This parameter is deprecated, setting it does not affect the results. To find groups containing a particular user, use [Get user groups](#api-rest-api-3-user-groups-get).
    account-id: option<string>,
    /// The string to find in group names.
    query: option<string>,
    /// As a group's name can change, use of `excludeGroupIds` is recommended to identify a group.  
    /// A group to exclude from the result. To exclude multiple groups, provide an ampersand-separated list. For example, `exclude=group1&exclude=group2`. This parameter cannot be used with the `excludeGroupIds` parameter.
    exclude: option<list<string>>,
    /// A group ID to exclude from the result. To exclude multiple groups, provide an ampersand-separated list. For example, `excludeId=group1-id&excludeId=group2-id`. This parameter cannot be used with the `excludeGroups` parameter.
    exclude-id: option<list<string>>,
    /// The maximum number of groups to return. The maximum number of groups that can be returned is limited by the system property `jira.ajax.autocomplete.limit`.
    max-results: option<s32>,
    /// Whether the search for groups should be case insensitive.
    case-insensitive: option<bool>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    user-name: option<string>
  }
  find-groups: func(params: find-groups-params) -> result<found-groups, string>;

}

interface group-and-user-picker {
  enum find-users-and-groups-avatar-size-enum {
    xsmall,
    xsmall-v2x,
    xsmall-v3x,
    small,
    small-v2x,
    small-v3x,
    medium,
    medium-v2x,
    medium-v3x,
    large,
    large-v2x,
    large-v3x,
    xlarge,
    xlarge-v2x,
    xlarge-v3x,
    xxlarge,
    xxlarge-v2x,
    xxlarge-v3x,
    xxxlarge,
    xxxlarge-v2x,
    xxxlarge-v3x,
  }

  enum group-label-type-op-enum {
    admin,
    single,
    multiple,
  }

  /// List of users and groups found in a search.
  record found-users-and-groups {
    groups: option<found-groups>,
    users: option<found-users>
  }

  /// The list of groups found in a search, including header text (Showing X of Y matching groups) and total of matched groups.
  record found-groups {
    groups: option<list<found-group>>,
    /// Header text indicating the number of groups in the response and the total number of groups found in the search.
    header: option<string>,
    /// The total number of groups found in the search.
    total: option<s32>
  }

  /// A group found in a search.
  record found-group {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The group name with the matched query string highlighted with the HTML bold tag.
    html: option<string>,
    labels: option<list<group-label>>,
    /// The name of the group. The name of a group is mutable, to reliably identify a group use ``groupId`.`
    name: option<string>
  }

  /// A group label.
  record group-label {
    /// The group label name.
    text: option<string>,
    /// The title of the group label.
    title: option<string>,
    /// The type of the group label.
    type-op: option<group-label-type-op-enum>
  }

  /// The list of users found in a search, including header text (Showing X of Y matching users) and total of matched users.
  record found-users {
    /// Header text indicating the number of users in the response and the total number of users found in the search.
    header: option<string>,
    /// The total number of users found in the search.
    total: option<s32>,
    users: option<list<user-picker-user>>
  }

  /// A user found in a search.
  record user-picker-user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The avatar URL of the user.
    avatar-url: option<string>,
    /// The display name of the user. Depending on the user’s privacy setting, this may be returned as null.
    display-name: option<string>,
    /// The display name, email address, and key of the user with the matched query string highlighted with the HTML bold tag.
    html: option<string>,
    /// This property is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available . See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>
  }

  variant find-users-and-groups-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    too-many-requests(string),
    other(string)
  }

  /// Find users and groups
  record find-users-and-groups-params {
    /// The search string.
    query: string,
    /// The maximum number of items to return in each list.
    max-results: option<s32>,
    /// Whether the user avatar should be returned. If an invalid value is provided, the default value is used.
    show-avatar: option<bool>,
    /// The custom field ID of the field this request is for.
    field-id: option<string>,
    /// The ID of a project that returned users and groups must have permission to view. To include multiple projects, provide an ampersand-separated list. For example, `projectId=10000&projectId=10001`. This parameter is only used when `fieldId` is present.
    project-id: option<list<string>>,
    /// The ID of an issue type that returned users and groups must have permission to view. To include multiple issue types, provide an ampersand-separated list. For example, `issueTypeId=10000&issueTypeId=10001`. Special values, such as `-1` (all standard issue types) and `-2` (all subtask issue types), are supported. This parameter is only used when `fieldId` is present.
    issue-type-id: option<list<string>>,
    /// The size of the avatar to return. If an invalid value is provided, the default value is used.
    avatar-size: option<find-users-and-groups-avatar-size-enum>,
    /// Whether the search for groups should be case insensitive.
    case-insensitive: option<bool>,
    /// Whether Connect app users and groups should be excluded from the search results. If an invalid value is provided, the default value is used.
    exclude-connect-addons: option<bool>
  }
  find-users-and-groups: func(params: find-users-and-groups-params) -> result<found-users-and-groups, find-users-and-groups-error>;

}

interface instance-information {
  enum licensed-application-plan-enum {
    unlicensed,
    free,
    paid,
  }

  /// Details about a license for the Jira instance.
  record license {
    /// The applications under this license.
    applications: list<licensed-application>
  }

  /// Details about a licensed Jira application.
  record licensed-application {
    /// The ID of the application.
    id: string,
    /// The licensing plan.
    plan: licensed-application-plan-enum
  }

  variant get-license-error {
    unauthorized(string),
    other(string)
  }

  /// Get license
  get-license: func() -> result<license, get-license-error>;

}

interface issue-search {
  enum search-for-issues-using-jql-validate-query-enum {
    strict,
    warn,
    none,
    true,
    false,
  }

  /// A list of issues suggested for use in auto-completion.
  record issue-picker-suggestions {
    /// A list of issues for an issue type suggested for use in auto-completion.
    sections: option<list<issue-picker-suggestions-issue-type>>
  }

  /// A type of issue suggested for use in auto-completion.
  record issue-picker-suggestions-issue-type {
    /// The ID of the type of issues suggested for use in auto-completion.
    id: option<string>,
    /// A list of issues suggested for use in auto-completion.
    issues: option<list<suggested-issue>>,
    /// The label of the type of issues suggested for use in auto-completion.
    label: option<string>,
    /// If no issue suggestions are found, returns a message indicating no suggestions were found,
    msg: option<string>,
    /// If issue suggestions are found, returns a message indicating the number of issues suggestions found and returned.
    sub: option<string>
  }

  /// An issue suggested for use in the issue picker auto-completion.
  record suggested-issue {
    /// The ID of the issue.
    id: option<s64>,
    /// The URL of the issue type's avatar.
    img: option<string>,
    /// The key of the issue.
    key: option<string>,
    /// The key of the issue in HTML format.
    key-html: option<string>,
    /// The phrase containing the query string in HTML format, with the string highlighted with HTML bold tags.
    summary: option<string>,
    /// The phrase containing the query string, as plain text.
    summary-text: option<string>
  }

  /// A list of matched issues or errors for each JQL query, in the order the JQL queries were passed.
  record issue-matches {
    matches: list<issue-matches-for-jql>
  }

  /// A list of the issues matched to a JQL query or details of errors encountered during matching.
  record issue-matches-for-jql {
    /// A list of errors.
    errors: list<string>,
    /// A list of issue IDs.
    matched-issues: list<s64>
  }

  /// The result of a JQL search.
  record search-results {
    /// Expand options that include additional search result details in the response.
    expand: option<string>,
    /// The list of issues found by the search.
    issues: option<list<issue-bean>>,
    /// The maximum number of results that could be on the page.
    max-results: option<s32>,
    /// The ID and name of each field in the search results.
    names: option<search-results-names>,
    /// The schema describing the field types in the search results.
    schema: option<search-results-schema>,
    /// The index of the first item returned on the page.
    start-at: option<s32>,
    /// The number of results on the page.
    total: option<s32>,
    /// Any warnings related to the JQL query.
    warning-messages: option<list<string>>
  }

  /// Details about an issue.
  record issue-bean {
    /// Details of changelogs associated with the issue.
    changelog: option<page-of-changelogs>,
    /// The metadata for the fields on the issue that can be amended.
    editmeta: option<issue-update-metadata>,
    /// Expand options that include additional issue details in the response.
    expand: option<string>,
    fields: option<issue-bean-fields>,
    fields-to-include: option<included-fields>,
    /// The ID of the issue.
    id: option<string>,
    /// The key of the issue.
    key: option<string>,
    /// The ID and name of each field present on the issue.
    names: option<issue-bean-names>,
    /// The operations that can be performed on the issue.
    operations: option<operations>,
    /// Details of the issue properties identified in the request.
    properties: option<issue-bean-properties>,
    /// The rendered value of each field present on the issue.
    rendered-fields: option<issue-bean-rendered-fields>,
    /// The schema describing each field present on the issue.
    schema: option<issue-bean-schema>,
    /// The URL of the issue details.
    self: option<string>,
    /// The transitions that can be performed on the issue.
    transitions: option<list<issue-transition>>,
    /// The versions of each field on the issue.
    versioned-representations: option<issue-bean-versioned-representations>
  }

  /// A page of changelogs.
  record page-of-changelogs {
    /// The list of changelogs.
    histories: option<list<changelog>>,
    /// The maximum number of results that could be on the page.
    max-results: option<s32>,
    /// The index of the first item returned on the page.
    start-at: option<s32>,
    /// The number of results on the page.
    total: option<s32>
  }

  /// A log of changes made to issue fields. Changelogs related to workflow associations are currently being deprecated.
  record changelog {
    /// The user who made the change.
    author: option<user-details>,
    /// The date on which the change took place.
    created: option<string>,
    /// The history metadata associated with the changed.
    history-metadata: option<history-metadata>,
    /// The ID of the changelog.
    id: option<string>,
    /// The list of items changed.
    items: option<list<change-details>>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// Details of issue history metadata.
  record history-metadata {
    /// The activity described in the history record.
    activity-description: option<string>,
    /// The key of the activity described in the history record.
    activity-description-key: option<string>,
    /// Details of the user whose action created the history record.
    actor: option<history-metadata-participant>,
    /// Details of the cause that triggered the creation the history record.
    cause: option<history-metadata-participant>,
    /// The description of the history record.
    description: option<string>,
    /// The description key of the history record.
    description-key: option<string>,
    /// The description of the email address associated the history record.
    email-description: option<string>,
    /// The description key of the email address associated the history record.
    email-description-key: option<string>,
    /// Additional arbitrary information about the history record.
    extra-data: option<history-metadata-extra-data>,
    /// Details of the system that generated the history record.
    generator: option<history-metadata-participant>,
    /// The type of the history record.
    type-op: option<string>
  }

  /// Details of user or system associated with a issue history metadata item.
  record history-metadata-participant {
    /// The URL to an avatar for the user or system associated with a history record.
    avatar-url: option<string>,
    /// The display name of the user or system associated with a history record.
    display-name: option<string>,
    /// The key of the display name of the user or system associated with a history record.
    display-name-key: option<string>,
    /// The ID of the user or system associated with a history record.
    id: option<string>,
    /// The type of the user or system associated with a history record.
    type-op: option<string>,
    /// The URL of the user or system associated with a history record.
    url: option<string>
  }

  /// Additional arbitrary information about the history record.
  record history-metadata-extra-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A change item.
  record change-details {
    /// The name of the field changed.
    field: option<string>,
    /// The ID of the field changed.
    field-id: option<string>,
    /// The type of the field changed.
    fieldtype: option<string>,
    /// The details of the original value.
    from-op: option<string>,
    /// The details of the original value as a string.
    from-string: option<string>,
    /// The details of the new value.
    to: option<string>
  }

  /// A list of editable field details.
  record issue-update-metadata {
    fields: option<issue-update-metadata-fields>
  }

  record issue-update-metadata-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record issue-bean-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record included-fields {
    actually-included: option<list<string>>,
    excluded: option<list<string>>,
    included: option<list<string>>
  }

  /// The ID and name of each field present on the issue.
  record issue-bean-names {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of the operations that can be performed on the issue.
  record operations {
    /// Details of the link groups defining issue operations.
    link-groups: option<list<link-group>>
  }

  /// Details a link group, which defines issue operations.
  record link-group {
    groups: option<list<string>>,
    header: option<simple-link>,
    id: option<string>,
    links: option<list<simple-link>>,
    style-class: option<string>,
    weight: option<s32>
  }

  /// Details about the operations available in this version.
  record simple-link {
    href: option<string>,
    icon-class: option<string>,
    id: option<string>,
    label: option<string>,
    style-class: option<string>,
    title: option<string>,
    weight: option<s32>
  }

  /// Details of the issue properties identified in the request.
  record issue-bean-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The rendered value of each field present on the issue.
  record issue-bean-rendered-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The schema describing each field present on the issue.
  record issue-bean-schema {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an issue transition.
  record issue-transition {
    /// Expand options that include additional transition details in the response.
    expand: option<string>,
    /// Details of the fields associated with the issue transition screen. Use this information to populate `fields` and `update` in a transition request.
    fields: option<issue-transition-fields>,
    /// Whether there is a screen associated with the issue transition.
    has-screen: option<bool>,
    /// The ID of the issue transition. Required when specifying a transition to undertake.
    id: option<string>,
    /// Whether the transition is available to be performed.
    is-available: option<bool>,
    /// Whether the issue has to meet criteria before the issue transition is applied.
    is-conditional: option<bool>,
    /// Whether the issue transition is global, that is, the transition is applied to issues regardless of their status.
    is-global: option<bool>,
    /// Whether this is the initial issue transition for the workflow.
    is-initial: option<bool>,
    looped: option<bool>,
    /// The name of the issue transition.
    name: option<string>,
    /// Details of the issue status after the transition.
    to: option<status-details>
  }

  /// Details of the fields associated with the issue transition screen. Use this information to populate `fields` and `update` in a transition request.
  record issue-transition-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A status.
  record status-details {
    /// The description of the status.
    description: option<string>,
    /// The URL of the icon used to represent the status.
    icon-url: option<string>,
    /// The ID of the status.
    id: option<string>,
    /// The name of the status.
    name: option<string>,
    /// The URL of the status.
    self: option<string>,
    /// The category assigned to the status.
    status-category: option<status-category>
  }

  /// A status category.
  record status-category {
    /// The name of the color used to represent the status category.
    color-name: option<string>,
    /// The ID of the status category.
    id: option<s64>,
    /// The key of the status category.
    key: option<string>,
    /// The name of the status category.
    name: option<string>,
    /// The URL of the status category.
    self: option<string>
  }

  /// The versions of each field on the issue.
  record issue-bean-versioned-representations {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The ID and name of each field in the search results.
  record search-results-names {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The schema describing the field types in the search results.
  record search-results-schema {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-issue-picker-resource-error {
    unauthorized(string),
    other(string)
  }

  variant match-issues-error {
    bad-request(string),
    other(string)
  }

  variant search-for-issues-using-jql-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant search-for-issues-using-jql-post-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// Get issue picker suggestions
  record get-issue-picker-resource-params {
    /// A string to match against text fields in the issue such as title, description, or comments.
    query: option<string>,
    /// A JQL query defining a list of issues to search for the query term. Note that `username` and `userkey` cannot be used as search terms for this parameter, due to privacy reasons. Use `accountId` instead.
    current-jql: option<string>,
    /// The key of an issue to exclude from search results. For example, the issue the user is viewing when they perform this query.
    current-issue-key: option<string>,
    /// The ID of a project that suggested issues must belong to.
    current-project-id: option<string>,
    /// Indicate whether to include subtasks in the suggestions list.
    show-sub-tasks: option<bool>,
    /// When `currentIssueKey` is a subtask, whether to include the parent issue in the suggestions if it matches the query.
    show-sub-task-parent: option<bool>
  }
  get-issue-picker-resource: func(params: get-issue-picker-resource-params) -> result<issue-picker-suggestions, get-issue-picker-resource-error>;

  /// Check issues against JQL
  record match-issues-params {
    /// A list of issue IDs.
    issue-ids: list<s64>,
    /// A list of JQL queries.
    jqls: list<string>
  }
  match-issues: func(params: match-issues-params) -> result<issue-matches, match-issues-error>;

  /// Search for issues using JQL (GET)
  record search-for-issues-using-jql-params {
    /// The [JQL](https://confluence.atlassian.com/x/egORLQ) that defines the search. Note:
    /// 
    jql: option<string>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s32>,
    /// The maximum number of items to return per page. To manage page size, Jira may return fewer items per page where a large number of fields are requested. The greatest number of items returned per page is achieved when requesting `id` or `key` only.
    max-results: option<s32>,
    /// Determines how to validate the JQL query and treat the validation results. Supported values are:
    /// 
    validate-query: option<search-for-issues-using-jql-validate-query-enum>,
    /// A list of fields to return for each issue, use it to retrieve a subset of fields. This parameter accepts a comma-separated list. Expand options include:
    /// 
    fields: option<list<string>>,
    /// Use [expand](#expansion) to include additional information about issues in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// A list of issue property keys for issue properties to include in the results. This parameter accepts a comma-separated list. Multiple properties can also be provided using an ampersand separated list. For example, `properties=prop1,prop2&properties=prop3`. A maximum of 5 issue property keys can be specified.
    properties: option<list<string>>,
    /// Reference fields by their key (rather than ID).
    fields-by-keys: option<bool>
  }
  search-for-issues-using-jql: func(params: search-for-issues-using-jql-params) -> result<search-results, search-for-issues-using-jql-error>;

  /// Search for issues using JQL (POST)
  record search-for-issues-using-jql-post-params {
    /// Use [expand](em>#expansion) to include additional information about issues in the response. Note that, unlike the majority of instances where `expand` is specified, `expand` is defined as a list of values. The expand options are:
    /// 
    expand: option<list<string>>,
    /// A list of fields to return for each issue, use it to retrieve a subset of fields. This parameter accepts a comma-separated list. Expand options include:
    /// 
    fields: option<list<string>>,
    /// Reference fields by their key (rather than ID). The default is `false`.
    fields-by-keys: option<bool>,
    /// A [JQL](https://confluence.atlassian.com/x/egORLQ) expression.
    jql: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// A list of up to 5 issue properties to include in the results. This parameter accepts a comma-separated list.
    properties: option<list<string>>,
    /// The index of the first item to return in the page of results (page offset). The base index is `0`.
    start-at: option<s32>,
    /// Determines how to validate the JQL query and treat the validation results. Supported values:
    /// 
    validate-query: option<search-for-issues-using-jql-validate-query-enum>
  }
  search-for-issues-using-jql-post: func(params: search-for-issues-using-jql-post-params) -> result<search-results, search-for-issues-using-jql-post-error>;

}

interface issue-properties {
  /// A list of entity property keys and values.
  record issue-entity-properties-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Bulk operation filter details.
  record issue-filter-for-bulk-property-set {
    /// The value of properties to perform the bulk operation on.
    current-value: option<string>,
    /// List of issues to perform the bulk operation on.
    entity-ids: option<list<s64>>,
    /// Whether the bulk operation occurs only when the property is present on or absent from an issue.
    has-property: option<bool>
  }

  /// List of property keys.
  record property-keys {
    /// Property key details.
    keys: option<list<property-key>>
  }

  /// Property key details.
  record property-key {
    /// The key of the property.
    key: option<string>,
    /// The URL of the property.
    self: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  variant bulk-set-issues-properties-list-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant bulk-set-issue-properties-by-issue-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant bulk-set-issue-property-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant bulk-delete-issue-property-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-issue-property-keys-error {
    not-found(string),
    other(string)
  }

  variant get-issue-property-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant set-issue-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-issue-property-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Bulk set issues properties by list
  record bulk-set-issues-properties-list-params {
    /// A list of entity property IDs.
    entities-ids: option<list<s64>>,
    /// A list of entity property keys and values.
    properties: option<issue-entity-properties-properties>
  }
  bulk-set-issues-properties-list: func(params: bulk-set-issues-properties-list-params) -> result<string, bulk-set-issues-properties-list-error>;

  /// Bulk set issue properties by issue
  record bulk-set-issue-properties-by-issue-params {
    /// A list of issue IDs and their respective properties.
    issues: option<string>
  }
  bulk-set-issue-properties-by-issue: func(params: bulk-set-issue-properties-by-issue-params) -> result<string, bulk-set-issue-properties-by-issue-error>;

  /// Bulk set issue property
  record bulk-set-issue-property-params {
    /// The key of the property. The maximum length is 255 characters.
    property-key: string,
    /// EXPERIMENTAL. The Jira expression to calculate the value of the property. The value of the expression must be an object that can be converted to JSON, such as a number, boolean, string, list, or map. The context variables available to the expression are `issue` and `user`. Issues for which the expression returns a value whose JSON representation is longer than 32768 characters are ignored.
    expression: option<string>,
    /// The bulk operation filter.
    filter: option<issue-filter-for-bulk-property-set>,
    /// The value of the property. The value must be a [valid](https://tools.ietf.org/html/rfc4627), non-empty JSON blob. The maximum length is 32768 characters.
    value: option<string>
  }
  bulk-set-issue-property: func(params: bulk-set-issue-property-params) -> result<string, bulk-set-issue-property-error>;

  /// Bulk delete issue property
  record bulk-delete-issue-property-params {
    /// The key of the property.
    property-key: string,
    /// The value of properties to perform the bulk operation on.
    current-value: option<string>,
    /// List of issues to perform the bulk delete operation on.
    entity-ids: option<list<s64>>
  }
  bulk-delete-issue-property: func(params: bulk-delete-issue-property-params) -> result<string, bulk-delete-issue-property-error>;

  /// Get issue property keys
  record get-issue-property-keys-params {
    /// The key or ID of the issue.
    issue-id-or-key: string
  }
  get-issue-property-keys: func(params: get-issue-property-keys-params) -> result<property-keys, get-issue-property-keys-error>;

  /// Get issue property
  record get-issue-property-params {
    /// The key or ID of the issue.
    issue-id-or-key: string,
    /// The key of the property.
    property-key: string
  }
  get-issue-property: func(params: get-issue-property-params) -> result<entity-property, get-issue-property-error>;

  /// Set issue property
  record set-issue-property-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The key of the issue property. The maximum length is 255 characters.
    property-key: string,
    body: string
  }
  set-issue-property: func(params: set-issue-property-params) -> result<string, set-issue-property-error>;

  /// Delete issue property
  record delete-issue-property-params {
    /// The key or ID of the issue.
    issue-id-or-key: string,
    /// The key of the property.
    property-key: string
  }
  delete-issue-property: func(params: delete-issue-property-params) -> result<string, delete-issue-property-error>;

}

interface issue-watchers {
  /// A container for the watch status of a list of issues.
  record bulk-issue-is-watching {
    /// The map of issue ID to boolean watch status.
    issues-is-watching: option<bulk-issue-is-watching-issues-is-watching>
  }

  /// The map of issue ID to boolean watch status.
  record bulk-issue-is-watching-issues-is-watching {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The details of watchers on an issue.
  record watchers {
    /// Whether the calling user is watching this issue.
    is-watching: option<bool>,
    /// The URL of these issue watcher details.
    self: option<string>,
    /// The number of users watching this issue.
    watch-count: option<s32>,
    /// Details of the users watching this issue.
    watchers: option<list<user-details>>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  variant get-is-watching-issue-bulk-error {
    unauthorized(string),
    other(string)
  }

  variant get-issue-watchers-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-watcher-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-watcher-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get is watching issue bulk
  record get-is-watching-issue-bulk-params {
    /// The list of issue IDs.
    issue-ids: list<string>
  }
  get-is-watching-issue-bulk: func(params: get-is-watching-issue-bulk-params) -> result<bulk-issue-is-watching, get-is-watching-issue-bulk-error>;

  /// Get issue watchers
  record get-issue-watchers-params {
    /// The ID or key of the issue.
    issue-id-or-key: string
  }
  get-issue-watchers: func(params: get-issue-watchers-params) -> result<watchers, get-issue-watchers-error>;

  /// Add watcher
  record add-watcher-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    body: string
  }
  add-watcher: func(params: add-watcher-params) -> result<string, add-watcher-error>;

  /// Delete watcher
  record remove-watcher-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required.
    account-id: option<string>
  }
  remove-watcher: func(params: remove-watcher-params) -> result<string, remove-watcher-error>;

}

interface issue-remote-links {
  /// Details of an issue remote link.
  record remote-issue-link {
    /// Details of the remote application the linked item is in.
    application: option<application>,
    /// The global ID of the link, such as the ID of the item on the remote system.
    global-id: option<string>,
    /// The ID of the link.
    id: option<s64>,
    /// Details of the item linked to.
    object: option<remote-object>,
    /// Description of the relationship between the issue and the linked item.
    relationship: option<string>,
    /// The URL of the link.
    self: option<string>
  }

  /// The application the linked item is in.
  record application {
    /// The name of the application. Used in conjunction with the (remote) object icon title to display a tooltip for the link's icon. The tooltip takes the format "\[application name\] icon title". Blank items are excluded from the tooltip title. If both items are blank, the icon tooltop displays as "Web Link". Grouping and sorting of links may place links without an application name last.
    name: option<string>,
    /// The name-spaced type of the application, used by registered rendering apps.
    type-op: option<string>
  }

  /// The linked item.
  record remote-object {
    /// Details of the icon for the item. If no icon is defined, the default link icon is used in Jira.
    icon: option<icon>,
    /// The status of the item.
    status: option<status>,
    /// The summary details of the item.
    summary: option<string>,
    /// The title of the item.
    title: string,
    /// The URL of the item.
    url: string
  }

  /// An icon. If no icon is defined:
  /// 
  ///  *  for a status icon, no status icon displays in Jira.
  ///  *  for the remote object icon, the default link icon displays in Jira.
  record icon {
    /// The URL of the tooltip, used only for a status icon. If not set, the status icon in Jira is not clickable.
    link: option<string>,
    /// The title of the icon. This is used as follows:
    /// 
    title: option<string>,
    /// The URL of an icon that displays at 16x16 pixel in Jira.
    url16x16: option<string>
  }

  /// The status of the item.
  record status {
    /// Details of the icon representing the status. If not provided, no status icon displays in Jira.
    icon: option<icon>,
    /// Whether the item is resolved. If set to "true", the link to the issue is displayed in a strikethrough font, otherwise the link displays in normal font.
    resolved: option<bool>
  }

  /// Details of the identifiers for a created or updated remote issue link.
  record remote-issue-link-identifies {
    /// The ID of the remote issue link, such as the ID of the item on the remote system.
    id: option<s64>,
    /// The URL of the remote issue link.
    self: option<string>
  }

  variant get-remote-issue-links-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-or-update-remote-issue-link-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-remote-issue-link-by-global-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-remote-issue-link-by-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-remote-issue-link-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-remote-issue-link-by-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get remote issue links
  record get-remote-issue-links-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The global ID of the remote issue link.
    global-id: option<string>
  }
  get-remote-issue-links: func(params: get-remote-issue-links-params) -> result<remote-issue-link, get-remote-issue-links-error>;

  /// Create or update remote issue link
  record create-or-update-remote-issue-link-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// Details of the remote application the linked item is in. For example, trello.
    application: option<application>,
    /// An identifier for the remote item in the remote system. For example, the global ID for a remote item in Confluence would consist of the app ID and page ID, like this: `appId=456&pageId=123`.
    /// 
    global-id: option<string>,
    /// Details of the item linked to.
    object: remote-object,
    /// Description of the relationship between the issue and the linked item. If not set, the relationship description "links to" is used in Jira.
    relationship: option<string>
  }
  create-or-update-remote-issue-link: func(params: create-or-update-remote-issue-link-params) -> result<remote-issue-link-identifies, create-or-update-remote-issue-link-error>;

  /// Delete remote issue link by global ID
  record delete-remote-issue-link-by-global-id-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The global ID of a remote issue link.
    global-id: string
  }
  delete-remote-issue-link-by-global-id: func(params: delete-remote-issue-link-by-global-id-params) -> result<string, delete-remote-issue-link-by-global-id-error>;

  /// Get remote issue link by ID
  record get-remote-issue-link-by-id-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the remote issue link.
    link-id: string
  }
  get-remote-issue-link-by-id: func(params: get-remote-issue-link-by-id-params) -> result<remote-issue-link, get-remote-issue-link-by-id-error>;

  /// Update remote issue link by ID
  record update-remote-issue-link-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the remote issue link.
    link-id: string,
    /// Details of the remote application the linked item is in. For example, trello.
    application: option<application>,
    /// An identifier for the remote item in the remote system. For example, the global ID for a remote item in Confluence would consist of the app ID and page ID, like this: `appId=456&pageId=123`.
    /// 
    global-id: option<string>,
    /// Details of the item linked to.
    object: remote-object,
    /// Description of the relationship between the issue and the linked item. If not set, the relationship description "links to" is used in Jira.
    relationship: option<string>
  }
  update-remote-issue-link: func(params: update-remote-issue-link-params) -> result<string, update-remote-issue-link-error>;

  /// Delete remote issue link by ID
  record delete-remote-issue-link-by-id-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of a remote issue link.
    link-id: string
  }
  delete-remote-issue-link-by-id: func(params: delete-remote-issue-link-by-id-params) -> result<string, delete-remote-issue-link-by-id-error>;

}

interface issue-votes {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  /// The details of votes on an issue.
  record votes {
    /// Whether the user making this request has voted on the issue.
    has-voted: option<bool>,
    /// The URL of these issue vote details.
    self: option<string>,
    /// List of the users who have voted on this issue. An empty list is returned when the calling user doesn't have the *View voters and watchers* project permission.
    voters: option<list<user>>,
    /// The number of votes on the issue.
    votes: option<s64>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-votes-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-vote-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant remove-vote-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get votes
  record get-votes-params {
    /// The ID or key of the issue.
    issue-id-or-key: string
  }
  get-votes: func(params: get-votes-params) -> result<votes, get-votes-error>;

  /// Add vote
  record add-vote-params {
    /// The ID or key of the issue.
    issue-id-or-key: string
  }
  add-vote: func(params: add-vote-params) -> result<string, add-vote-error>;

  /// Delete vote
  record remove-vote-params {
    /// The ID or key of the issue.
    issue-id-or-key: string
  }
  remove-vote: func(params: remove-vote-params) -> result<string, remove-vote-error>;

}

interface issue-worklogs {
  enum visibility-type-op-enum {
    group,
    role,
  }

  enum add-worklog-adjust-estimate-enum {
    new,
    leave,
    manual,
    auto,
  }

  /// Paginated list of worklog details
  record page-of-worklogs {
    /// The maximum number of results that could be on the page.
    max-results: option<s32>,
    /// The index of the first item returned on the page.
    start-at: option<s32>,
    /// The number of results on the page.
    total: option<s32>,
    /// List of worklogs.
    worklogs: option<list<worklog>>
  }

  /// Details of a worklog.
  record worklog {
    /// Details of the user who created the worklog.
    author: option<user-details>,
    /// A comment about the worklog in [Atlassian Document Format](https://developer.atlassian.com/cloud/jira/platform/apis/document/structure/). Optional when creating or updating a worklog.
    comment: option<string>,
    /// The datetime on which the worklog was created.
    created: option<string>,
    /// The ID of the worklog record.
    id: option<string>,
    /// The ID of the issue this worklog is for.
    issue-id: option<string>,
    /// Details of properties for the worklog. Optional when creating or updating a worklog.
    properties: option<list<entity-property>>,
    /// The URL of the worklog item.
    self: option<string>,
    /// The datetime on which the worklog effort was started. Required when creating a worklog. Optional when updating a worklog.
    started: option<string>,
    /// The time spent working on the issue as days (\#d), hours (\#h), or minutes (\#m or \#). Required when creating a worklog if `timeSpentSeconds` isn't provided. Optional when updating a worklog. Cannot be provided if `timeSpentSecond` is provided.
    time-spent: option<string>,
    /// The time in seconds spent working on the issue. Required when creating a worklog if `timeSpent` isn't provided. Optional when updating a worklog. Cannot be provided if `timeSpent` is provided.
    time-spent-seconds: option<s64>,
    /// Details of the user who last updated the worklog.
    update-author: option<user-details>,
    /// The datetime on which the worklog was last updated.
    updated: option<string>,
    /// Details about any restrictions in the visibility of the worklog. Optional when creating or updating a worklog.
    visibility: option<visibility>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  /// The group or role to which this item is visible.
  record visibility {
    /// The ID of the group or the name of the role that visibility of this item is restricted to.
    identifier: option<string>,
    /// Whether visibility of this item is restricted to a group or role.
    type-op: option<visibility-type-op-enum>,
    /// The name of the group or role that visibility of this item is restricted to. Please note that the name of a group is mutable, to reliably identify a group use `identifier`.
    value: option<string>
  }

  /// List of changed worklogs.
  record changed-worklogs {
    last-page: option<bool>,
    /// The URL of the next list of changed worklogs.
    next-page: option<string>,
    /// The URL of this changed worklogs list.
    self: option<string>,
    /// The datetime of the first worklog item in the list.
    since: option<s64>,
    /// The datetime of the last worklog item in the list.
    until: option<s64>,
    /// Changed worklog list.
    values: option<list<changed-worklog>>
  }

  /// Details of a changed worklog.
  record changed-worklog {
    /// Details of properties associated with the change.
    properties: option<list<entity-property>>,
    /// The datetime of the change.
    updated-time: option<s64>,
    /// The ID of the worklog.
    worklog-id: option<s64>
  }

  variant get-issue-worklog-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-worklog-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-worklog-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-worklog-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-worklog-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-ids-of-worklogs-deleted-since-error {
    unauthorized(string),
    other(string)
  }

  variant get-worklogs-for-ids-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-ids-of-worklogs-modified-since-error {
    unauthorized(string),
    other(string)
  }

  /// Get issue worklogs
  record get-issue-worklog-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The worklog start date and time, as a UNIX timestamp in milliseconds, after which worklogs are returned.
    started-after: option<s64>,
    /// The worklog start date and time, as a UNIX timestamp in milliseconds, before which worklogs are returned.
    started-before: option<s64>,
    /// Use [expand](#expansion) to include additional information about worklogs in the response. This parameter accepts`properties`, which returns worklog properties.
    expand: option<string>
  }
  get-issue-worklog: func(params: get-issue-worklog-params) -> result<page-of-worklogs, get-issue-worklog-error>;

  /// Add worklog
  record add-worklog-params {
    /// The ID or key the issue.
    issue-id-or-key: string,
    /// Whether users watching the issue are notified by email.
    notify-users: option<bool>,
    /// Defines how to update the issue's time estimate, the options are:
    /// 
    adjust-estimate: option<add-worklog-adjust-estimate-enum>,
    /// The value to set as the issue's remaining time estimate, as days (\#d), hours (\#h), or minutes (\#m or \#). For example, *2d*. Required when `adjustEstimate` is `new`.
    new-estimate: option<string>,
    /// The amount to reduce the issue's remaining estimate by, as days (\#d), hours (\#h), or minutes (\#m). For example, *2d*. Required when `adjustEstimate` is `manual`.
    reduce-by: option<string>,
    /// Use [expand](#expansion) to include additional information about work logs in the response. This parameter accepts `properties`, which returns worklog properties.
    expand: option<string>,
    /// Whether the worklog entry should be added to the issue even if the issue is not editable, because jira.issue.editable set to false or missing. For example, the issue is closed. Connect and Forge app users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg) can use this flag.
    override-editable-flag: option<bool>,
    /// Details of the user who created the worklog.
    author: option<user-details>,
    /// A comment about the worklog in [Atlassian Document Format](https://developer.atlassian.com/cloud/jira/platform/apis/document/structure/). Optional when creating or updating a worklog.
    comment: option<string>,
    /// The datetime on which the worklog was created.
    created: option<string>,
    /// The ID of the worklog record.
    id: option<string>,
    /// The ID of the issue this worklog is for.
    issue-id: option<string>,
    /// Details of properties for the worklog. Optional when creating or updating a worklog.
    properties: option<list<entity-property>>,
    /// The URL of the worklog item.
    self: option<string>,
    /// The datetime on which the worklog effort was started. Required when creating a worklog. Optional when updating a worklog.
    started: option<string>,
    /// The time spent working on the issue as days (\#d), hours (\#h), or minutes (\#m or \#). Required when creating a worklog if `timeSpentSeconds` isn't provided. Optional when updating a worklog. Cannot be provided if `timeSpentSecond` is provided.
    time-spent: option<string>,
    /// The time in seconds spent working on the issue. Required when creating a worklog if `timeSpent` isn't provided. Optional when updating a worklog. Cannot be provided if `timeSpent` is provided.
    time-spent-seconds: option<s64>,
    /// Details of the user who last updated the worklog.
    update-author: option<user-details>,
    /// The datetime on which the worklog was last updated.
    updated: option<string>,
    /// Details about any restrictions in the visibility of the worklog. Optional when creating or updating a worklog.
    visibility: option<visibility>
  }
  add-worklog: func(params: add-worklog-params) -> result<worklog, add-worklog-error>;

  /// Get worklog
  record get-worklog-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the worklog.
    id: string,
    /// Use [expand](#expansion) to include additional information about work logs in the response. This parameter accepts
    /// 
    expand: option<string>
  }
  get-worklog: func(params: get-worklog-params) -> result<worklog, get-worklog-error>;

  /// Update worklog
  record update-worklog-params {
    /// The ID or key the issue.
    issue-id-or-key: string,
    /// The ID of the worklog.
    id: string,
    /// Whether users watching the issue are notified by email.
    notify-users: option<bool>,
    /// Defines how to update the issue's time estimate, the options are:
    /// 
    adjust-estimate: option<add-worklog-adjust-estimate-enum>,
    /// The value to set as the issue's remaining time estimate, as days (\#d), hours (\#h), or minutes (\#m or \#). For example, *2d*. Required when `adjustEstimate` is `new`.
    new-estimate: option<string>,
    /// Use [expand](#expansion) to include additional information about worklogs in the response. This parameter accepts `properties`, which returns worklog properties.
    expand: option<string>,
    /// Whether the worklog should be added to the issue even if the issue is not editable. For example, because the issue is closed. Connect and Forge app users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg) can use this flag.
    override-editable-flag: option<bool>,
    /// Details of the user who created the worklog.
    author: option<user-details>,
    /// A comment about the worklog in [Atlassian Document Format](https://developer.atlassian.com/cloud/jira/platform/apis/document/structure/). Optional when creating or updating a worklog.
    comment: option<string>,
    /// The datetime on which the worklog was created.
    created: option<string>,
    /// The ID of the worklog record.
    id-v2: option<string>,
    /// The ID of the issue this worklog is for.
    issue-id: option<string>,
    /// Details of properties for the worklog. Optional when creating or updating a worklog.
    properties: option<list<entity-property>>,
    /// The URL of the worklog item.
    self: option<string>,
    /// The datetime on which the worklog effort was started. Required when creating a worklog. Optional when updating a worklog.
    started: option<string>,
    /// The time spent working on the issue as days (\#d), hours (\#h), or minutes (\#m or \#). Required when creating a worklog if `timeSpentSeconds` isn't provided. Optional when updating a worklog. Cannot be provided if `timeSpentSecond` is provided.
    time-spent: option<string>,
    /// The time in seconds spent working on the issue. Required when creating a worklog if `timeSpent` isn't provided. Optional when updating a worklog. Cannot be provided if `timeSpent` is provided.
    time-spent-seconds: option<s64>,
    /// Details of the user who last updated the worklog.
    update-author: option<user-details>,
    /// The datetime on which the worklog was last updated.
    updated: option<string>,
    /// Details about any restrictions in the visibility of the worklog. Optional when creating or updating a worklog.
    visibility: option<visibility>
  }
  update-worklog: func(params: update-worklog-params) -> result<worklog, update-worklog-error>;

  /// Delete worklog
  record delete-worklog-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the worklog.
    id: string,
    /// Whether users watching the issue are notified by email.
    notify-users: option<bool>,
    /// Defines how to update the issue's time estimate, the options are:
    /// 
    adjust-estimate: option<add-worklog-adjust-estimate-enum>,
    /// The value to set as the issue's remaining time estimate, as days (\#d), hours (\#h), or minutes (\#m or \#). For example, *2d*. Required when `adjustEstimate` is `new`.
    new-estimate: option<string>,
    /// The amount to increase the issue's remaining estimate by, as days (\#d), hours (\#h), or minutes (\#m or \#). For example, *2d*. Required when `adjustEstimate` is `manual`.
    increase-by: option<string>,
    /// Whether the work log entry should be added to the issue even if the issue is not editable, because jira.issue.editable set to false or missing. For example, the issue is closed. Connect and Forge app users with admin permission can use this flag.
    override-editable-flag: option<bool>
  }
  delete-worklog: func(params: delete-worklog-params) -> result<string, delete-worklog-error>;

  /// Get IDs of deleted worklogs
  record get-ids-of-worklogs-deleted-since-params {
    /// The date and time, as a UNIX timestamp in milliseconds, after which deleted worklogs are returned.
    since: option<s64>
  }
  get-ids-of-worklogs-deleted-since: func(params: get-ids-of-worklogs-deleted-since-params) -> result<changed-worklogs, get-ids-of-worklogs-deleted-since-error>;

  /// Get worklogs
  record get-worklogs-for-ids-params {
    /// Use [expand](#expansion) to include additional information about worklogs in the response. This parameter accepts `properties` that returns the properties of each worklog.
    expand: option<string>,
    /// A list of worklog IDs.
    ids: list<s64>
  }
  get-worklogs-for-ids: func(params: get-worklogs-for-ids-params) -> result<list<worklog>, get-worklogs-for-ids-error>;

  /// Get IDs of updated worklogs
  record get-ids-of-worklogs-modified-since-params {
    /// The date and time, as a UNIX timestamp in milliseconds, after which updated worklogs are returned.
    since: option<s64>,
    /// Use [expand](#expansion) to include additional information about worklogs in the response. This parameter accepts `properties` that returns the properties of each worklog.
    expand: option<string>
  }
  get-ids-of-worklogs-modified-since: func(params: get-ids-of-worklogs-modified-since-params) -> result<changed-worklogs, get-ids-of-worklogs-modified-since-error>;

}

interface issue-worklog-properties {
  /// List of property keys.
  record property-keys {
    /// Property key details.
    keys: option<list<property-key>>
  }

  /// Property key details.
  record property-key {
    /// The key of the property.
    key: option<string>,
    /// The URL of the property.
    self: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  variant get-worklog-property-keys-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-worklog-property-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant set-worklog-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-worklog-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get worklog property keys
  record get-worklog-property-keys-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the worklog.
    worklog-id: string
  }
  get-worklog-property-keys: func(params: get-worklog-property-keys-params) -> result<property-keys, get-worklog-property-keys-error>;

  /// Get worklog property
  record get-worklog-property-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the worklog.
    worklog-id: string,
    /// The key of the property.
    property-key: string
  }
  get-worklog-property: func(params: get-worklog-property-params) -> result<entity-property, get-worklog-property-error>;

  /// Set worklog property
  record set-worklog-property-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the worklog.
    worklog-id: string,
    /// The key of the issue property. The maximum length is 255 characters.
    property-key: string,
    body: string
  }
  set-worklog-property: func(params: set-worklog-property-params) -> result<string, set-worklog-property-error>;

  /// Delete worklog property
  record delete-worklog-property-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the worklog.
    worklog-id: string,
    /// The key of the property.
    property-key: string
  }
  delete-worklog-property: func(params: delete-worklog-property-params) -> result<string, delete-worklog-property-error>;

}

interface issue-links {
  enum visibility-type-op-enum {
    group,
    role,
  }

  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  /// A comment.
  record comment {
    /// The ID of the user who created the comment.
    author: option<user-details>,
    /// The comment text in [Atlassian Document Format](https://developer.atlassian.com/cloud/jira/platform/apis/document/structure/).
    body: option<string>,
    /// The date and time at which the comment was created.
    created: option<string>,
    /// The ID of the comment.
    id: option<string>,
    /// Whether the comment was added from an email sent by a person who is not part of the issue. See [Allow external emails to be added as comments on issues](https://support.atlassian.com/jira-service-management-cloud/docs/allow-external-emails-to-be-added-as-comments-on-issues/)for information on setting up this feature.
    jsd-author-can-see-request: option<bool>,
    /// Whether the comment is visible in Jira Service Desk. Defaults to true when comments are created in the Jira Cloud Platform. This includes when the site doesn't use Jira Service Desk or the project isn't a Jira Service Desk project and, therefore, there is no Jira Service Desk for the issue to be visible on. To create a comment with its visibility in Jira Service Desk set to false, use the Jira Service Desk REST API [Create request comment](https://developer.atlassian.com/cloud/jira/service-desk/rest/#api-rest-servicedeskapi-request-issueIdOrKey-comment-post) operation.
    jsd-public: option<bool>,
    /// A list of comment properties. Optional on create and update.
    properties: option<list<entity-property>>,
    /// The rendered version of the comment.
    rendered-body: option<string>,
    /// The URL of the comment.
    self: option<string>,
    /// The ID of the user who updated the comment last.
    update-author: option<user-details>,
    /// The date and time at which the comment was updated last.
    updated: option<string>,
    /// The group or role to which this comment is visible. Optional on create and update.
    visibility: option<visibility>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  /// The group or role to which this item is visible.
  record visibility {
    /// The ID of the group or the name of the role that visibility of this item is restricted to.
    identifier: option<string>,
    /// Whether visibility of this item is restricted to a group or role.
    type-op: option<visibility-type-op-enum>,
    /// The name of the group or role that visibility of this item is restricted to. Please note that the name of a group is mutable, to reliably identify a group use `identifier`.
    value: option<string>
  }

  /// The ID or key of a linked issue.
  record linked-issue {
    /// The fields associated with the issue.
    fields: option<fields>,
    /// The ID of an issue. Required if `key` isn't provided.
    id: option<string>,
    /// The key of an issue. Required if `id` isn't provided.
    key: option<string>,
    /// The URL of the issue.
    self: option<string>
  }

  /// Key fields from the linked issue.
  record fields {
    /// The assignee of the linked issue.
    assignee: option<user-details>,
    /// The type of the linked issue.
    issue-type: option<issue-type-details>,
    issuetype: option<issue-type-details>,
    /// The priority of the linked issue.
    priority: option<priority>,
    /// The status of the linked issue.
    status: option<status-details>,
    /// The summary description of the linked issue.
    summary: option<string>,
    /// The time tracking of the linked issue.
    timetracking: option<time-tracking-details>
  }

  /// Details about an issue type.
  record issue-type-details {
    /// The ID of the issue type's avatar.
    avatar-id: option<s64>,
    /// The description of the issue type.
    description: option<string>,
    /// Unique ID for next-gen projects.
    entity-id: option<string>,
    /// Hierarchy level of the issue type.
    hierarchy-level: option<s32>,
    /// The URL of the issue type's avatar.
    icon-url: option<string>,
    /// The ID of the issue type.
    id: option<string>,
    /// The name of the issue type.
    name: option<string>,
    /// Details of the next-gen projects the issue type is available in.
    scope: option<scope>,
    /// The URL of these issue type details.
    self: option<string>,
    /// Whether this issue type is used to create subtasks.
    subtask: option<bool>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// An issue priority.
  record priority {
    /// The description of the issue priority.
    description: option<string>,
    /// The URL of the icon for the issue priority.
    icon-url: option<string>,
    /// The ID of the issue priority.
    id: option<string>,
    /// Whether this priority is the default.
    is-default: option<bool>,
    /// The name of the issue priority.
    name: option<string>,
    /// The URL of the issue priority.
    self: option<string>,
    /// The color used to indicate the issue priority.
    status-color: option<string>
  }

  /// A status.
  record status-details {
    /// The description of the status.
    description: option<string>,
    /// The URL of the icon used to represent the status.
    icon-url: option<string>,
    /// The ID of the status.
    id: option<string>,
    /// The name of the status.
    name: option<string>,
    /// The URL of the status.
    self: option<string>,
    /// The category assigned to the status.
    status-category: option<status-category>
  }

  /// A status category.
  record status-category {
    /// The name of the color used to represent the status category.
    color-name: option<string>,
    /// The ID of the status category.
    id: option<s64>,
    /// The key of the status category.
    key: option<string>,
    /// The name of the status category.
    name: option<string>,
    /// The URL of the status category.
    self: option<string>
  }

  /// Time tracking details.
  record time-tracking-details {
    /// The original estimate of time needed for this issue in readable format.
    original-estimate: option<string>,
    /// The original estimate of time needed for this issue in seconds.
    original-estimate-seconds: option<s64>,
    /// The remaining estimate of time needed for this issue in readable format.
    remaining-estimate: option<string>,
    /// The remaining estimate of time needed for this issue in seconds.
    remaining-estimate-seconds: option<s64>,
    /// Time worked on this issue in readable format.
    time-spent: option<string>,
    /// Time worked on this issue in seconds.
    time-spent-seconds: option<s64>
  }

  /// This object is used as follows:
  /// 
  ///  *  In the [ issueLink](#api-rest-api-3-issueLink-post) resource it defines and reports on the type of link between the issues. Find a list of issue link types with [Get issue link types](#api-rest-api-3-issueLinkType-get).
  ///  *  In the [ issueLinkType](#api-rest-api-3-issueLinkType-post) resource it defines and reports on issue link types.
  record issue-link-type {
    /// The ID of the issue link type and is used as follows:
    /// 
    id: option<string>,
    /// The description of the issue link type inward link and is used as follows:
    /// 
    inward: option<string>,
    /// The name of the issue link type and is used as follows:
    /// 
    name: option<string>,
    /// The description of the issue link type outward link and is used as follows:
    /// 
    outward: option<string>,
    /// The URL of the issue link type. Read only.
    self: option<string>
  }

  /// Details of a link between issues.
  record issue-link {
    /// The ID of the issue link.
    id: option<string>,
    /// Provides details about the linked issue. If presenting this link in a user interface, use the `inward` field of the issue link type to label the link.
    inward-issue: linked-issue,
    /// Provides details about the linked issue. If presenting this link in a user interface, use the `outward` field of the issue link type to label the link.
    outward-issue: linked-issue,
    /// The URL of the issue link.
    self: option<string>,
    /// The type of link between the issues.
    type-op: issue-link-type
  }

  variant link-issues-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-issue-link-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-issue-link-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Create issue link
  record link-issues-params {
    comment: option<comment>,
    inward-issue: linked-issue,
    outward-issue: linked-issue,
    type-op: issue-link-type
  }
  link-issues: func(params: link-issues-params) -> result<string, link-issues-error>;

  /// Get issue link
  record get-issue-link-params {
    /// The ID of the issue link.
    link-id: string
  }
  get-issue-link: func(params: get-issue-link-params) -> result<issue-link, get-issue-link-error>;

  /// Delete issue link
  record delete-issue-link-params {
    /// The ID of the issue link.
    link-id: string
  }
  delete-issue-link: func(params: delete-issue-link-params) -> result<string, delete-issue-link-error>;

}

interface issue-link-types {
  /// A list of issue link type beans.
  record issue-link-types {
    /// The issue link type bean.
    issue-link-types: option<list<issue-link-type>>
  }

  /// This object is used as follows:
  /// 
  ///  *  In the [ issueLink](#api-rest-api-3-issueLink-post) resource it defines and reports on the type of link between the issues. Find a list of issue link types with [Get issue link types](#api-rest-api-3-issueLinkType-get).
  ///  *  In the [ issueLinkType](#api-rest-api-3-issueLinkType-post) resource it defines and reports on issue link types.
  record issue-link-type {
    /// The ID of the issue link type and is used as follows:
    /// 
    id: option<string>,
    /// The description of the issue link type inward link and is used as follows:
    /// 
    inward: option<string>,
    /// The name of the issue link type and is used as follows:
    /// 
    name: option<string>,
    /// The description of the issue link type outward link and is used as follows:
    /// 
    outward: option<string>,
    /// The URL of the issue link type. Read only.
    self: option<string>
  }

  variant get-issue-link-types-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-issue-link-type-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-issue-link-type-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-issue-link-type-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-issue-link-type-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get issue link types
  get-issue-link-types: func() -> result<issue-link-types, get-issue-link-types-error>;

  /// Create issue link type
  record create-issue-link-type-params {
    /// The ID of the issue link type and is used as follows:
    /// 
    id: option<string>,
    /// The description of the issue link type inward link and is used as follows:
    /// 
    inward: option<string>,
    /// The name of the issue link type and is used as follows:
    /// 
    name: option<string>,
    /// The description of the issue link type outward link and is used as follows:
    /// 
    outward: option<string>,
    /// The URL of the issue link type. Read only.
    self: option<string>
  }
  create-issue-link-type: func(params: create-issue-link-type-params) -> result<issue-link-type, create-issue-link-type-error>;

  /// Get issue link type
  record get-issue-link-type-params {
    /// The ID of the issue link type.
    issue-link-type-id: string
  }
  get-issue-link-type: func(params: get-issue-link-type-params) -> result<issue-link-type, get-issue-link-type-error>;

  /// Update issue link type
  record update-issue-link-type-params {
    /// The ID of the issue link type.
    issue-link-type-id: string,
    /// The ID of the issue link type and is used as follows:
    /// 
    id: option<string>,
    /// The description of the issue link type inward link and is used as follows:
    /// 
    inward: option<string>,
    /// The name of the issue link type and is used as follows:
    /// 
    name: option<string>,
    /// The description of the issue link type outward link and is used as follows:
    /// 
    outward: option<string>,
    /// The URL of the issue link type. Read only.
    self: option<string>
  }
  update-issue-link-type: func(params: update-issue-link-type-params) -> result<issue-link-type, update-issue-link-type-error>;

  /// Delete issue link type
  record delete-issue-link-type-params {
    /// The ID of the issue link type.
    issue-link-type-id: string
  }
  delete-issue-link-type: func(params: delete-issue-link-type-params) -> result<string, delete-issue-link-type-error>;

}

interface issue-security-schemes {
  /// List of security schemes.
  record security-schemes {
    /// List of security schemes.
    issue-security-schemes: option<list<security-scheme>>
  }

  /// Details about a security scheme.
  record security-scheme {
    /// The ID of the default security level.
    default-security-level-id: option<s64>,
    /// The description of the issue security scheme.
    description: option<string>,
    /// The ID of the issue security scheme.
    id: option<s64>,
    levels: option<list<security-level>>,
    /// The name of the issue security scheme.
    name: option<string>,
    /// The URL of the issue security scheme.
    self: option<string>
  }

  /// Details of an issue level security item.
  record security-level {
    /// The description of the issue level security item.
    description: option<string>,
    /// The ID of the issue level security item.
    id: option<string>,
    /// Whether the issue level security item is the default.
    is-default: option<bool>,
    /// The ID of the issue level security scheme.
    issue-security-scheme-id: option<string>,
    /// The name of the issue level security item.
    name: option<string>,
    /// The URL of the issue level security item.
    self: option<string>
  }

  record security-scheme-level-bean {
    /// The description of the issue security scheme level.
    description: option<string>,
    /// Specifies whether the level is the default level. False by default.
    is-default: option<bool>,
    /// The list of level members which should be added to the issue security scheme level.
    members: option<list<security-scheme-level-member-bean>>,
    /// The name of the issue security scheme level. Must be unique.
    name: string
  }

  record security-scheme-level-member-bean {
    /// The value corresponding to the specified member type.
    parameter: option<string>,
    /// The issue security level member type, e.g `reporter`, `group`, `user`.
    type-op: string
  }

  /// The ID of the issue security scheme.
  record security-scheme-id {
    /// The ID of the issue security scheme.
    id: string
  }

  /// A page of items.
  record page-bean-security-level {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<security-level>>
  }

  /// A page of items.
  record page-bean-security-level-member {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<security-level-member>>
  }

  /// Issue security level member.
  record security-level-member {
    /// The user or group being granted the permission. It consists of a `type` and a type-dependent `parameter`. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
    holder: permission-holder,
    /// The ID of the issue security level member.
    id: string,
    /// The ID of the issue security level.
    issue-security-level-id: string,
    /// The ID of the issue security scheme.
    issue-security-scheme-id: string
  }

  /// Details of a user, group, field, or project role that holds a permission. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
  record permission-holder {
    /// Expand options that include additional permission holder details in the response.
    expand: option<string>,
    /// As a group's name can change, use of `value` is recommended. The identifier associated withthe `type` value that defines the holder of the permission.
    parameter: option<string>,
    /// The type of permission holder.
    type-op: string,
    /// The identifier associated with the `type` value that defines the holder of the permission.
    value: option<string>
  }

  /// A page of items.
  record page-bean-issue-security-scheme-to-project-mapping {
    /// Whether this is the last page.
