    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of issue type screen scheme IDs. To include multiple issue type screen schemes, separate IDs with ampersand: `issueTypeScreenSchemeId=10000&issueTypeScreenSchemeId=10001`.
    issue-type-screen-scheme-id: option<list<s64>>
  }
  get-issue-type-screen-scheme-mappings: func(params: get-issue-type-screen-scheme-mappings-params) -> result<page-bean-issue-type-screen-scheme-item, get-issue-type-screen-scheme-mappings-error>;

  /// Get issue type screen schemes for projects
  record get-issue-type-screen-scheme-project-associations-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of project IDs. To include multiple projects, separate IDs with ampersand: `projectId=10000&projectId=10001`.
    project-id: list<s64>
  }
  get-issue-type-screen-scheme-project-associations: func(params: get-issue-type-screen-scheme-project-associations-params) -> result<page-bean-issue-type-screen-schemes-projects, get-issue-type-screen-scheme-project-associations-error>;

  /// Assign issue type screen scheme to project
  record assign-issue-type-screen-scheme-to-project-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: option<string>,
    /// The ID of the project.
    project-id: option<string>
  }
  assign-issue-type-screen-scheme-to-project: func(params: assign-issue-type-screen-scheme-to-project-params) -> result<string, assign-issue-type-screen-scheme-to-project-error>;

  /// Update issue type screen scheme
  record update-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The description of the issue type screen scheme. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the issue type screen scheme. The name must be unique. The maximum length is 255 characters.
    name: option<string>
  }
  update-issue-type-screen-scheme: func(params: update-issue-type-screen-scheme-params) -> result<string, update-issue-type-screen-scheme-error>;

  /// Delete issue type screen scheme
  record delete-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string
  }
  delete-issue-type-screen-scheme: func(params: delete-issue-type-screen-scheme-params) -> result<string, delete-issue-type-screen-scheme-error>;

  /// Append mappings to issue type screen scheme
  record append-mappings-for-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The list of issue type to screen scheme mappings. A *default* entry cannot be specified because a default entry is added when an issue type screen scheme is created.
    issue-type-mappings: list<issue-type-screen-scheme-mapping>
  }
  append-mappings-for-issue-type-screen-scheme: func(params: append-mappings-for-issue-type-screen-scheme-params) -> result<string, append-mappings-for-issue-type-screen-scheme-error>;

  /// Update issue type screen scheme default screen scheme
  record update-default-screen-scheme-v2-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The ID of the screen scheme.
    screen-scheme-id: string
  }
  update-default-screen-scheme-v2: func(params: update-default-screen-scheme-v2-params) -> result<string, update-default-screen-scheme-v2-error>;

  /// Remove mappings from issue type screen scheme
  record remove-mappings-from-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The list of issue type IDs.
    issue-type-ids: list<string>
  }
  remove-mappings-from-issue-type-screen-scheme: func(params: remove-mappings-from-issue-type-screen-scheme-params) -> result<string, remove-mappings-from-issue-type-screen-scheme-error>;

  /// Get issue type screen scheme projects
  record get-projects-for-issue-type-screen-scheme-params {
    /// The ID of the issue type screen scheme.
    issue-type-screen-scheme-id: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    query: option<string>
  }
  get-projects-for-issue-type-screen-scheme: func(params: get-projects-for-issue-type-screen-scheme-params) -> result<page-bean-project-details, get-projects-for-issue-type-screen-scheme-error>;

}

interface jql {
  enum field-reference-data-auto-enum {
    true,
    false,
  }

  enum parse-jql-queries-validation-enum {
    strict,
    warn,
    none,
  }

  /// Lists of JQL reference data.
  record reference-data {
    /// List of JQL query reserved words.
    jql-reserved-words: option<list<string>>,
    /// List of fields usable in JQL queries.
    visible-field-names: option<list<field-reference-data>>,
    /// List of functions usable in JQL queries.
    visible-function-names: option<list<function-reference-data>>
  }

  /// Details of a field that can be used in advanced searches.
  record field-reference-data {
    /// Whether the field provide auto-complete suggestions.
    auto: option<field-reference-data-auto-enum>,
    /// If the item is a custom field, the ID of the custom field.
    cfid: option<string>,
    /// Whether this field has been deprecated.
    deprecated: option<field-reference-data-auto-enum>,
    /// The searcher key of the field, only passed when the field is deprecated.
    deprecated-searcher-key: option<string>,
    /// The display name contains the following:
    /// 
    display-name: option<string>,
    /// The valid search operators for the field.
    operators: option<list<string>>,
    /// Whether the field can be used in a query's `ORDER BY` clause.
    orderable: option<field-reference-data-auto-enum>,
    /// Whether the content of this field can be searched.
    searchable: option<field-reference-data-auto-enum>,
    /// The data types of items in the field.
    types: option<list<string>>,
    /// The field identifier.
    value: option<string>
  }

  /// Details of functions that can be used in advanced searches.
  record function-reference-data {
    /// The display name of the function.
    display-name: option<string>,
    /// Whether the function can take a list of arguments.
    is-list: option<field-reference-data-auto-enum>,
    /// The data types returned by the function.
    types: option<list<string>>,
    /// The function identifier.
    value: option<string>
  }

  /// The results from a JQL query.
  record auto-complete-suggestions {
    /// The list of suggested item.
    results: option<list<auto-complete-suggestion>>
  }

  /// A field auto-complete suggestion.
  record auto-complete-suggestion {
    /// The display name of a suggested item. If `fieldValue` or `predicateValue` are provided, the matching text is highlighted with the HTML bold tag.
    display-name: option<string>,
    /// The value of a suggested item.
    value: option<string>
  }

  /// A list of parsed JQL queries.
  record parsed-jql-queries {
    /// A list of parsed JQL queries.
    queries: string
  }

  /// The converted JQL queries.
  record converted-jql-queries {
    /// List of queries containing user information that could not be mapped to an existing user
    queries-with-unknown-users: option<list<query-with-unknown-users>>,
    /// The list of converted query strings with account IDs in place of user identifiers.
    query-strings: option<list<string>>
  }

  /// JQL queries that contained users that could not be found
  record query-with-unknown-users {
    /// The converted query, with accountIDs instead of user identifiers, or 'unknown' for users that could not be found
    converted-query: option<string>,
    /// The original query, for reference
    original-query: option<string>
  }

  /// The JQL query to sanitize for the account ID. If the account ID is null, sanitizing is performed for an anonymous user.
  record query-to-sanitize {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The query to sanitize.
    query: string
  }

  /// The sanitized JQL queries for the given account IDs.
  record sanitized-jql-queries {
    /// The list of sanitized JQL queries.
    queries: option<list<sanitized-jql-query>>
  }

  /// Details of the sanitized JQL query.
  record sanitized-jql-query {
    /// The account ID of the user for whom sanitization was performed.
    account-id: option<string>,
    /// The list of errors.
    errors: option<error-collection>,
    /// The initial query.
    initial-query: option<string>,
    /// The sanitized query, if there were no errors.
    sanitized-query: option<string>
  }

  /// Error messages from an operation.
  record error-collection {
    /// The list of error messages produced by this operation. For example, "input parameter 'key' must be provided"
    error-messages: option<list<string>>,
    /// The list of errors by parameter returned by the operation. For example,"projectKey": "Project keys must start with an uppercase letter, followed by one or more uppercase alphanumeric characters."
    errors: option<error-collection-errors>,
    status: option<s32>
  }

  /// The list of errors by parameter returned by the operation. For example,"projectKey": "Project keys must start with an uppercase letter, followed by one or more uppercase alphanumeric characters."
  record error-collection-errors {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-auto-complete-error {
    unauthorized(string),
    other(string)
  }

  variant get-auto-complete-post-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-field-auto-complete-for-query-string-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant parse-jql-queries-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant migrate-queries-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant sanitise-jql-queries-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  /// Get field reference data (GET)
  get-auto-complete: func() -> result<reference-data, get-auto-complete-error>;

  /// Get field reference data (POST)
  record get-auto-complete-post-params {
    /// Include collapsed fields for fields that have non-unique names.
    include-collapsed-fields: option<bool>,
    /// List of project IDs used to filter the visible field details returned.
    project-ids: option<list<s64>>
  }
  get-auto-complete-post: func(params: get-auto-complete-post-params) -> result<reference-data, get-auto-complete-post-error>;

  /// Get field auto complete suggestions
  record get-field-auto-complete-for-query-string-params {
    /// The name of the field.
    field-name: option<string>,
    /// The partial field item name entered by the user.
    field-value: option<string>,
    /// The name of the [ CHANGED operator predicate](https://confluence.atlassian.com/x/hQORLQ#Advancedsearching-operatorsreference-CHANGEDCHANGED) for which the suggestions are generated. The valid predicate operators are *by*, *from*, and *to*.
    predicate-name: option<string>,
    /// The partial predicate item name entered by the user.
    predicate-value: option<string>
  }
  get-field-auto-complete-for-query-string: func(params: get-field-auto-complete-for-query-string-params) -> result<auto-complete-suggestions, get-field-auto-complete-for-query-string-error>;

  /// Parse JQL query
  record parse-jql-queries-params {
    /// How to validate the JQL query and treat the validation results. Validation options include:
    /// 
    validation: option<parse-jql-queries-validation-enum>,
    /// A list of queries to parse.
    queries: string
  }
  parse-jql-queries: func(params: parse-jql-queries-params) -> result<parsed-jql-queries, parse-jql-queries-error>;

  /// Convert user identifiers to account IDs in JQL queries
  record migrate-queries-params {
    /// A list of queries with user identifiers. Maximum of 100 queries.
    query-strings: option<list<string>>
  }
  migrate-queries: func(params: migrate-queries-params) -> result<converted-jql-queries, migrate-queries-error>;

  /// Sanitize JQL queries
  record sanitise-jql-queries-params {
    /// The list of JQL queries to sanitize. Must contain unique values. Maximum of 20 queries.
    queries: list<query-to-sanitize>
  }
  sanitise-jql-queries: func(params: sanitise-jql-queries-params) -> result<sanitized-jql-queries, sanitise-jql-queries-error>;

}

interface jql-functions-apps {
  /// A page of items.
  record page-bean-jql-function-precomputation-bean {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<jql-function-precomputation-bean>>
  }

  /// Jql function precomputation.
  record jql-function-precomputation-bean {
    arguments: option<list<string>>,
    created: option<string>,
    field: option<string>,
    function-key: option<string>,
    function-name: option<string>,
    id: option<string>,
    operator: option<string>,
    updated: option<string>,
    used: option<string>,
    value: option<string>
  }

  /// Precomputation id and its new value.
  record jql-function-precomputation-update-bean {
    id: s64,
    value: string
  }

  variant get-precomputations-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-precomputations-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get precomputations (apps)
  record get-precomputations-params {
    /// The function key in format:
    /// 
    function-key: option<list<string>>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Not supported yet.
    order-by: option<string>,
    /// Not supported yet.
    filter: option<string>
  }
  get-precomputations: func(params: get-precomputations-params) -> result<page-bean-jql-function-precomputation-bean, get-precomputations-error>;

  /// Update precomputations (apps)
  record update-precomputations-params {
    values: option<list<jql-function-precomputation-update-bean>>
  }
  update-precomputations: func(params: update-precomputations-params) -> result<string, update-precomputations-error>;

}

interface labels {
  /// A page of items.
  record page-bean-string {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<string>>
  }

  /// Get all labels
  record get-all-labels-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-all-labels: func(params: get-all-labels-params) -> result<page-bean-string, string>;

}

interface license-metrics {
  /// A license metric
  record license-metric {
    /// The key of the license metric.
    key: option<string>,
    /// The value for the license metric.
    value: option<string>
  }

  variant get-approximate-license-count-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-approximate-application-license-count-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  /// Get approximate license count
  get-approximate-license-count: func() -> result<license-metric, get-approximate-license-count-error>;

  /// Get approximate application license count
  record get-approximate-application-license-count-params {
    application-key: string
  }
  get-approximate-application-license-count: func(params: get-approximate-application-license-count-params) -> result<license-metric, get-approximate-application-license-count-error>;

}

interface permissions {
  /// Details about permissions.
  record permissions {
    /// List of permissions.
    permissions: option<permissions-permissions>
  }

  /// List of permissions.
  record permissions-permissions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of project permissions and associated issues and projects to look up.
  record bulk-project-permissions {
    /// List of issue IDs.
    issues: option<list<s64>>,
    /// List of project permissions.
    permissions: list<string>,
    /// List of project IDs.
    projects: option<list<s64>>
  }

  /// Details of global and project permissions granted to the user.
  record bulk-permission-grants {
    /// List of permissions granted to the user.
    global-permissions: list<string>,
    /// List of project permissions and the projects and issues those permissions provide access to.
    project-permissions: list<bulk-project-permission-grants>
  }

  /// List of project permissions and the projects and issues those permissions grant access to.
  record bulk-project-permission-grants {
    /// IDs of the issues the user has the permission for.
    issues: list<s64>,
    /// A project permission,
    permission: string,
    /// IDs of the projects the user has the permission for.
    projects: list<s64>
  }

  /// A list of projects in which a user is granted permissions.
  record permitted-projects {
    /// A list of projects.
    projects: option<list<project-identifier-bean>>
  }

  /// The identifiers for a project.
  record project-identifier-bean {
    /// The ID of the project.
    id: option<s64>,
    /// The key of the project.
    key: option<string>
  }

  variant get-my-permissions-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-all-permissions-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-bulk-permissions-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant get-permitted-projects-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// Get my permissions
  record get-my-permissions-params {
    /// The key of project. Ignored if `projectId` is provided.
    project-key: option<string>,
    /// The ID of project.
    project-id: option<string>,
    /// The key of the issue. Ignored if `issueId` is provided.
    issue-key: option<string>,
    /// The ID of the issue.
    issue-id: option<string>,
    /// A list of permission keys. (Required) This parameter accepts a comma-separated list. To get the list of available permissions, use [Get all permissions](#api-rest-api-3-permissions-get).
    permissions: option<string>,
    project-uuid: option<string>,
    project-configuration-uuid: option<string>,
    /// The ID of the comment.
    comment-id: option<string>
  }
  get-my-permissions: func(params: get-my-permissions-params) -> result<permissions, get-my-permissions-error>;

  /// Get all permissions
  get-all-permissions: func() -> result<permissions, get-all-permissions-error>;

  /// Get bulk permissions
  record get-bulk-permissions-params {
    /// The account ID of a user.
    account-id: option<string>,
    /// Global permissions to look up.
    global-permissions: option<list<string>>,
    /// Project permissions with associated projects and issues to look up.
    project-permissions: option<list<bulk-project-permissions>>
  }
  get-bulk-permissions: func(params: get-bulk-permissions-params) -> result<bulk-permission-grants, get-bulk-permissions-error>;

  /// Get permitted projects
  record get-permitted-projects-params {
    /// A list of permission keys.
    permissions: list<string>
  }
  get-permitted-projects: func(params: get-permitted-projects-params) -> result<permitted-projects, get-permitted-projects-error>;

}

interface myself {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  /// Details of a locale.
  record locale {
    /// The locale code. The Java the locale format is used: a two character language code (ISO 639), an underscore, and two letter country code (ISO 3166). For example, en\_US represents a locale of English (United States). Required on create.
    locale: option<string>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-preference-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant set-preference-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant remove-preference-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-locale-error {
    unauthorized(string),
    other(string)
  }

  variant set-locale-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-locale-error {
    unauthorized(string),
    other(string)
  }

  variant get-current-user-error {
    unauthorized(string),
    other(string)
  }

  /// Get preference
  record get-preference-params {
    /// The key of the preference.
    key: string
  }
  get-preference: func(params: get-preference-params) -> result<string, get-preference-error>;

  /// Set preference
  record set-preference-params {
    /// The key of the preference. The maximum length is 255 characters.
    key: string,
    body: string
  }
  set-preference: func(params: set-preference-params) -> result<string, set-preference-error>;

  /// Delete preference
  record remove-preference-params {
    /// The key of the preference.
    key: string
  }
  remove-preference: func(params: remove-preference-params) -> result<string, remove-preference-error>;

  /// Get locale
  get-locale: func() -> result<locale, get-locale-error>;

  /// Set locale
  record set-locale-params {
    /// The locale code. The Java the locale format is used: a two character language code (ISO 639), an underscore, and two letter country code (ISO 3166). For example, en\_US represents a locale of English (United States). Required on create.
    locale: option<string>
  }
  set-locale: func(params: set-locale-params) -> result<string, set-locale-error>;

  /// Delete locale
  delete-locale: func() -> result<string, delete-locale-error>;

  /// Get current user
  record get-current-user-params {
    /// Use [expand](#expansion) to include additional information about user in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-current-user: func(params: get-current-user-params) -> result<user, get-current-user-error>;

}

interface issue-notification-schemes {
  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum event-notification-notification-type-enum {
    current-assignee,
    reporter,
    current-user,
    project-lead,
    component-lead,
    user,
    group,
    project-role,
    email-address,
    all-watchers,
    user-custom-field,
    group-custom-field,
  }

  enum role-actor-type-op-enum {
    atlassian-group-role-actor,
    atlassian-user-role-actor,
  }

  /// A page of items.
  record page-bean-notification-scheme {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<notification-scheme>>
  }

  /// Details about a notification scheme.
  record notification-scheme {
    /// The description of the notification scheme.
    description: option<string>,
    /// Expand options that include additional notification scheme details in the response.
    expand: option<string>,
    /// The ID of the notification scheme.
    id: option<s64>,
    /// The name of the notification scheme.
    name: option<string>,
    /// The notification events and associated recipients.
    notification-scheme-events: option<list<notification-scheme-event>>,
    /// The list of project IDs associated with the notification scheme.
    projects: option<list<s64>>,
    /// The scope of the notification scheme.
    scope: option<scope>,
    self: option<string>
  }

  /// Details about a notification scheme event.
  record notification-scheme-event {
    event: option<notification-event>,
    notifications: option<list<event-notification>>
  }

  /// Details about a notification event.
  record notification-event {
    /// The description of the event.
    description: option<string>,
    /// The ID of the event. The event can be a [Jira system event](https://confluence.atlassian.com/x/8YdKLg#Creatinganotificationscheme-eventsEvents) or a [custom event](https://confluence.atlassian.com/x/AIlKLg).
    id: option<s64>,
    /// The name of the event.
    name: option<string>,
    /// The template of the event. Only custom events configured by Jira administrators have template.
    template-event: option<string>
  }

  /// Details about a notification associated with an event.
  record event-notification {
    /// The email address.
    email-address: option<string>,
    /// Expand options that include additional event notification details in the response.
    expand: option<string>,
    /// The custom user or group field.
    field: option<field-details>,
    /// The specified group.
    group: option<group-name>,
    /// The ID of the notification.
    id: option<s64>,
    /// Identifies the recipients of the notification.
    notification-type: option<event-notification-notification-type-enum>,
    /// As a group's name can change, use of `recipient` is recommended. The identifier associated with the `notificationType` value that defines the receiver of the notification, where the receiver isn't implied by `notificationType` value. So, when `notificationType` is:
    /// 
    parameter: option<string>,
    /// The specified project role.
    project-role: option<project-role>,
    /// The identifier associated with the `notificationType` value that defines the receiver of the notification, where the receiver isn't implied by the `notificationType` value. So, when `notificationType` is:
    /// 
    recipient: option<string>,
    /// The specified user.
    user: option<user-details>
  }

  /// Details about a field.
  record field-details {
    /// The names that can be used to reference the field in an advanced search. For more information, see [Advanced searching - fields reference](https://confluence.atlassian.com/x/gwORLQ).
    clause-names: option<list<string>>,
    /// Whether the field is a custom field.
    custom: option<bool>,
    /// The ID of the field.
    id: option<string>,
    /// The key of the field.
    key: option<string>,
    /// The name of the field.
    name: option<string>,
    /// Whether the field can be used as a column on the issue navigator.
    navigable: option<bool>,
    /// Whether the content of the field can be used to order lists.
    orderable: option<bool>,
    /// The data schema for the field.
    schema: option<json-type-bean>,
    /// The scope of the field.
    scope: option<scope>,
    /// Whether the content of the field can be searched.
    searchable: option<bool>
  }

  /// The schema of a field.
  record json-type-bean {
    /// If the field is a custom field, the configuration of the field.
    configuration: option<json-type-bean-configuration>,
    /// If the field is a custom field, the URI of the field.
    custom: option<string>,
    /// If the field is a custom field, the custom ID of the field.
    custom-id: option<s64>,
    /// When the data type is an array, the name of the field items within the array.
    items: option<string>,
    /// If the field is a system field, the name of the field.
    system: option<string>,
    /// The data type of the field.
    type-op: string
  }

  /// If the field is a custom field, the configuration of the field.
  record json-type-bean-configuration {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  /// Details about the roles in a project.
  record project-role {
    /// The list of users who act in this role.
    actors: option<list<role-actor>>,
    /// Whether this role is the admin role for the project.
    admin: option<bool>,
    /// Whether the calling user is part of this role.
    current-user-role: option<bool>,
    /// Whether this role is the default role for the project
    default: option<bool>,
    /// The description of the project role.
    description: option<string>,
    /// The ID of the project role.
    id: option<s64>,
    /// The name of the project role.
    name: option<string>,
    /// Whether the roles are configurable for this project.
    role-configurable: option<bool>,
    /// The scope of the role. Indicated for roles associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
    scope: option<scope>,
    /// The URL the project role details.
    self: option<string>,
    /// The translated name of the project role.
    translated-name: option<string>
  }

  /// Details about a user assigned to a project role.
  record role-actor {
    actor-group: option<project-role-group>,
    actor-user: option<project-role-user>,
    /// The avatar of the role actor.
    avatar-url: option<string>,
    /// The display name of the role actor. For users, depending on the user’s privacy setting, this may return an alternative value for the user's name.
    display-name: option<string>,
    /// The ID of the role actor.
    id: option<s64>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The type of role actor.
    type-op: option<role-actor-type-op-enum>
  }

  /// Details of the group associated with the role.
  record project-role-group {
    /// The display name of the group.
    display-name: option<string>,
    /// The ID of the group.
    group-id: option<string>,
    /// The name of the group. As a group's name can change, use of `groupId` is recommended to identify the group.
    name: option<string>
  }

  /// Details of the user associated with the role.
  record project-role-user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Returns *unknown* if the record is deleted and corrupted, for example, as the result of a server import.
    account-id: option<string>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  /// Details of a notification scheme event.
  record notification-scheme-event-details {
    /// The ID of the event.
    event: notification-scheme-event-type-id,
    /// The list of notifications mapped to a specified event.
    notifications: string
  }

  /// The ID of an event that is being mapped to notifications.
  record notification-scheme-event-type-id {
    /// The ID of the notification scheme event.
    id: string
  }

  /// The ID of a notification scheme.
  record notification-scheme-id {
    /// The ID of a notification scheme.
    id: string
  }

  /// A page of items.
  record page-bean-notification-scheme-and-project-mapping-json-bean {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<notification-scheme-and-project-mapping-json-bean>>
  }

  record notification-scheme-and-project-mapping-json-bean {
    notification-scheme-id: option<string>,
    project-id: option<string>
  }

  variant get-notification-schemes-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant create-notification-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-notification-scheme-to-project-mappings-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-notification-scheme-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-notification-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-notifications-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-notification-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-notification-from-notification-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get notification schemes paginated
  record get-notification-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of notification schemes IDs to be filtered by
    id: option<list<string>>,
    /// The list of projects IDs to be filtered by
    project-id: option<list<string>>,
    /// When set to true, returns only the default notification scheme. If you provide project IDs not associated with the default, returns an empty page. The default value is false.
    only-default: option<bool>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-notification-schemes: func(params: get-notification-schemes-params) -> result<page-bean-notification-scheme, get-notification-schemes-error>;

  /// Create notification scheme
  record create-notification-scheme-params {
    /// The description of the notification scheme.
    description: option<string>,
    /// The name of the notification scheme. Must be unique (case-insensitive).
    name: string,
    /// The list of notifications which should be added to the notification scheme.
    notification-scheme-events: option<list<notification-scheme-event-details>>
  }
  create-notification-scheme: func(params: create-notification-scheme-params) -> result<notification-scheme-id, create-notification-scheme-error>;

  /// Get projects using notification schemes paginated
  record get-notification-scheme-to-project-mappings-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of notifications scheme IDs to be filtered out
    notification-scheme-id: option<list<string>>,
    /// The list of project IDs to be filtered out
    project-id: option<list<string>>
  }
  get-notification-scheme-to-project-mappings: func(params: get-notification-scheme-to-project-mappings-params) -> result<page-bean-notification-scheme-and-project-mapping-json-bean, get-notification-scheme-to-project-mappings-error>;

  /// Get notification scheme
  record get-notification-scheme-params {
    /// The ID of the notification scheme. Use [Get notification schemes paginated](#api-rest-api-3-notificationscheme-get) to get a list of notification scheme IDs.
    id: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-notification-scheme: func(params: get-notification-scheme-params) -> result<notification-scheme, get-notification-scheme-error>;

  /// Update notification scheme
  record update-notification-scheme-params {
    /// The ID of the notification scheme.
    id: string,
    /// The description of the notification scheme.
    description: option<string>,
    /// The name of the notification scheme. Must be unique.
    name: option<string>
  }
  update-notification-scheme: func(params: update-notification-scheme-params) -> result<string, update-notification-scheme-error>;

  /// Add notifications to notification scheme
  record add-notifications-params {
    /// The ID of the notification scheme.
    id: string,
    /// The list of notifications which should be added to the notification scheme.
    notification-scheme-events: list<notification-scheme-event-details>
  }
  add-notifications: func(params: add-notifications-params) -> result<string, add-notifications-error>;

  /// Delete notification scheme
  record delete-notification-scheme-params {
    /// The ID of the notification scheme.
    notification-scheme-id: string
  }
  delete-notification-scheme: func(params: delete-notification-scheme-params) -> result<string, delete-notification-scheme-error>;

  /// Remove notification from notification scheme
  record remove-notification-from-notification-scheme-params {
    /// The ID of the notification scheme.
    notification-scheme-id: string,
    /// The ID of the notification.
    notification-id: string
  }
  remove-notification-from-notification-scheme: func(params: remove-notification-from-notification-scheme-params) -> result<string, remove-notification-from-notification-scheme-error>;

}

interface permission-schemes {
  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  /// List of all permission schemes.
  record permission-schemes {
    /// Permission schemes list.
    permission-schemes: option<list<permission-scheme>>
  }

  /// Details of a permission scheme.
  record permission-scheme {
    /// A description for the permission scheme.
    description: option<string>,
    /// The expand options available for the permission scheme.
    expand: option<string>,
    /// The ID of the permission scheme.
    id: option<s64>,
    /// The name of the permission scheme. Must be unique.
    name: string,
    /// The permission scheme to create or update. See [About permission schemes and grants](../api-group-permission-schemes/#about-permission-schemes-and-grants) for more information.
    permissions: option<list<permission-grant>>,
    /// The scope of the permission scheme.
    scope: option<scope>,
    /// The URL of the permission scheme.
    self: option<string>
  }

  /// Details about a permission granted to a user or group.
  record permission-grant {
    /// The user or group being granted the permission. It consists of a `type`, a type-dependent `parameter` and a type-dependent `value`. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
    holder: option<permission-holder>,
    /// The ID of the permission granted details.
    id: option<s64>,
    /// The permission to grant. This permission can be one of the built-in permissions or a custom permission added by an app. See [Built-in permissions](../api-group-permission-schemes/#built-in-permissions) in *Get all permission schemes* for more information about the built-in permissions. See the [project permission](https://developer.atlassian.com/cloud/jira/platform/modules/project-permission/) and [global permission](https://developer.atlassian.com/cloud/jira/platform/modules/global-permission/) module documentation for more information about custom permissions.
    permission: option<string>,
    /// The URL of the permission granted details.
    self: option<string>
  }

  /// Details of a user, group, field, or project role that holds a permission. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
  record permission-holder {
    /// Expand options that include additional permission holder details in the response.
    expand: option<string>,
    /// As a group's name can change, use of `value` is recommended. The identifier associated withthe `type` value that defines the holder of the permission.
    parameter: option<string>,
    /// The type of permission holder.
    type-op: string,
    /// The identifier associated with the `type` value that defines the holder of the permission.
    value: option<string>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// List of permission grants.
  record permission-grants {
    /// Expand options that include additional permission grant details in the response.
    expand: option<string>,
    /// Permission grants list.
    permissions: option<list<permission-grant>>
  }

  variant get-all-permission-schemes-error {
    unauthorized(string),
    other(string)
  }

  variant create-permission-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-permission-scheme-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-permission-scheme-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-permission-scheme-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-permission-scheme-grants-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant create-permission-grant-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-permission-scheme-grant-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-permission-scheme-entity-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  /// Get all permission schemes
  record get-all-permission-schemes-params {
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-all-permission-schemes: func(params: get-all-permission-schemes-params) -> result<permission-schemes, get-all-permission-schemes-error>;

  /// Create permission scheme
  record create-permission-scheme-params {
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>,
    /// A description for the permission scheme.
    description: option<string>,
    /// The expand options available for the permission scheme.
    expand-v2: option<string>,
    /// The ID of the permission scheme.
    id: option<s64>,
    /// The name of the permission scheme. Must be unique.
    name: string,
    /// The permission scheme to create or update. See [About permission schemes and grants](../api-group-permission-schemes/#about-permission-schemes-and-grants) for more information.
    permissions: option<list<permission-grant>>,
    /// The scope of the permission scheme.
    scope: option<scope>,
    /// The URL of the permission scheme.
    self: option<string>
  }
  create-permission-scheme: func(params: create-permission-scheme-params) -> result<permission-scheme, create-permission-scheme-error>;

  /// Get permission scheme
  record get-permission-scheme-params {
    /// The ID of the permission scheme to return.
    scheme-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-permission-scheme: func(params: get-permission-scheme-params) -> result<permission-scheme, get-permission-scheme-error>;

  /// Update permission scheme
  record update-permission-scheme-params {
    /// The ID of the permission scheme to update.
    scheme-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>,
    /// A description for the permission scheme.
    description: option<string>,
    /// The expand options available for the permission scheme.
    expand-v2: option<string>,
    /// The ID of the permission scheme.
    id: option<s64>,
    /// The name of the permission scheme. Must be unique.
    name: string,
    /// The permission scheme to create or update. See [About permission schemes and grants](../api-group-permission-schemes/#about-permission-schemes-and-grants) for more information.
    permissions: option<list<permission-grant>>,
    /// The scope of the permission scheme.
    scope: option<scope>,
    /// The URL of the permission scheme.
    self: option<string>
  }
  update-permission-scheme: func(params: update-permission-scheme-params) -> result<permission-scheme, update-permission-scheme-error>;

  /// Delete permission scheme
  record delete-permission-scheme-params {
    /// The ID of the permission scheme being deleted.
    scheme-id: string
  }
  delete-permission-scheme: func(params: delete-permission-scheme-params) -> result<string, delete-permission-scheme-error>;

  /// Get permission scheme grants
  record get-permission-scheme-grants-params {
    /// The ID of the permission scheme.
    scheme-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-permission-scheme-grants: func(params: get-permission-scheme-grants-params) -> result<permission-grants, get-permission-scheme-grants-error>;

  /// Create permission grant
  record create-permission-grant-params {
    /// The ID of the permission scheme in which to create a new permission grant.
    scheme-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>,
    /// The user or group being granted the permission. It consists of a `type`, a type-dependent `parameter` and a type-dependent `value`. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
    holder: option<permission-holder>,
    /// The ID of the permission granted details.
    id: option<s64>,
    /// The permission to grant. This permission can be one of the built-in permissions or a custom permission added by an app. See [Built-in permissions](../api-group-permission-schemes/#built-in-permissions) in *Get all permission schemes* for more information about the built-in permissions. See the [project permission](https://developer.atlassian.com/cloud/jira/platform/modules/project-permission/) and [global permission](https://developer.atlassian.com/cloud/jira/platform/modules/global-permission/) module documentation for more information about custom permissions.
    permission: option<string>,
    /// The URL of the permission granted details.
    self: option<string>
  }
  create-permission-grant: func(params: create-permission-grant-params) -> result<permission-grant, create-permission-grant-error>;

  /// Get permission scheme grant
  record get-permission-scheme-grant-params {
    /// The ID of the permission scheme.
    scheme-id: string,
    /// The ID of the permission grant.
    permission-id: string,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are always included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-permission-scheme-grant: func(params: get-permission-scheme-grant-params) -> result<permission-grant, get-permission-scheme-grant-error>;

  /// Delete permission scheme grant
  record delete-permission-scheme-entity-params {
    /// The ID of the permission scheme to delete the permission grant from.
    scheme-id: string,
    /// The ID of the permission grant to delete.
    permission-id: string
  }
  delete-permission-scheme-entity: func(params: delete-permission-scheme-entity-params) -> result<string, delete-permission-scheme-entity-error>;

}

interface issue-priorities {
  enum create-priority-details-icon-url-enum {
    images-icons-priorities-blocker-png,
    images-icons-priorities-critical-png,
    images-icons-priorities-high-png,
    images-icons-priorities-highest-png,
    images-icons-priorities-low-png,
    images-icons-priorities-lowest-png,
    images-icons-priorities-major-png,
    images-icons-priorities-medium-png,
    images-icons-priorities-minor-png,
    images-icons-priorities-trivial-png,
  }

  /// An issue priority.
  record priority {
    /// The description of the issue priority.
    description: option<string>,
    /// The URL of the icon for the issue priority.
    icon-url: option<string>,
    /// The ID of the issue priority.
    id: option<string>,
    /// Whether this priority is the default.
    is-default: option<bool>,
    /// The name of the issue priority.
    name: option<string>,
    /// The URL of the issue priority.
    self: option<string>,
    /// The color used to indicate the issue priority.
    status-color: option<string>
  }

  /// The ID of an issue priority.
  record priority-id {
    /// The ID of the issue priority.
    id: string
  }

  /// A page of items.
  record page-bean-priority {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<priority>>
  }

  variant get-priorities-error {
    unauthorized(string),
    other(string)
  }

  variant create-priority-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant set-default-priority-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant move-priorities-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant search-priorities-error {
    unauthorized(string),
    other(string)
  }

  variant get-priority-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-priority-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-priority-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  /// Get priorities
  get-priorities: func() -> result<list<priority>, get-priorities-error>;

  /// Create priority
  record create-priority-params {
    /// The description of the priority.
    description: option<string>,
    /// The URL of an icon for the priority. Accepted protocols are HTTP and HTTPS. Built in icons can also be used.
    icon-url: option<create-priority-details-icon-url-enum>,
    /// The name of the priority. Must be unique.
    name: string,
    /// The status color of the priority in 3-digit or 6-digit hexadecimal format.
    status-color: string
  }
  create-priority: func(params: create-priority-params) -> result<priority-id, create-priority-error>;

  /// Set default priority
  record set-default-priority-params {
    /// The ID of the new default issue priority. Must be an existing ID or null. Setting this to null erases the default priority setting.
    id: string
  }
  set-default-priority: func(params: set-default-priority-params) -> result<string, set-default-priority-error>;

  /// Move priorities
  record move-priorities-params {
    /// The ID of the priority. Required if `position` isn't provided.
    after: option<string>,
    /// The list of issue IDs to be reordered. Cannot contain duplicates nor after ID.
    ids: list<string>,
    /// The position for issue priorities to be moved to. Required if `after` isn't provided.
    position: option<string>
  }
  move-priorities: func(params: move-priorities-params) -> result<string, move-priorities-error>;

  /// Search priorities
  record search-priorities-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of priority IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=2&id=3`.
    id: option<list<string>>,
    /// Whether only the default priority is returned.
    only-default: option<bool>
  }
  search-priorities: func(params: search-priorities-params) -> result<page-bean-priority, search-priorities-error>;

  /// Get priority
  record get-priority-params {
    /// The ID of the issue priority.
    id: string
  }
  get-priority: func(params: get-priority-params) -> result<priority, get-priority-error>;

  /// Update priority
  record update-priority-params {
    /// The ID of the issue priority.
    id: string,
    /// The description of the priority.
    description: option<string>,
    /// The URL of an icon for the priority. Accepted protocols are HTTP and HTTPS. Built in icons can also be used.
    icon-url: option<create-priority-details-icon-url-enum>,
    /// The name of the priority. Must be unique.
    name: option<string>,
    /// The status color of the priority in 3-digit or 6-digit hexadecimal format.
    status-color: option<string>
  }
  update-priority: func(params: update-priority-params) -> result<string, update-priority-error>;

  /// Delete priority
  record delete-priority-params {
    /// The ID of the issue priority.
    id: string,
    /// The ID of the issue priority that will replace the currently selected resolution.
    replace-with: string
  }
  delete-priority: func(params: delete-priority-params) -> result<string, delete-priority-error>;

}

interface projects {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  enum project-assignee-type-enum {
    project-lead,
    unassigned,
  }

  enum project-component-assignee-type-enum {
    project-default,
    component-lead,
    project-lead,
    unassigned,
  }

  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum project-style-enum {
    classic,
    next-gen,
  }

  enum create-project-details-project-template-key-enum {
    com-pyxis-greenhopper-jira-gh-simplified-agility-kanban,
    com-pyxis-greenhopper-jira-gh-simplified-agility-scrum,
    com-pyxis-greenhopper-jira-gh-simplified-basic,
    com-pyxis-greenhopper-jira-gh-simplified-kanban-classic,
    com-pyxis-greenhopper-jira-gh-simplified-scrum-classic,
    com-atlassian-servicedesk-simplified-it-service-management,
    com-atlassian-servicedesk-simplified-general-service-desk,
    com-atlassian-servicedesk-simplified-general-service-desk-it,
    com-atlassian-servicedesk-simplified-general-service-desk-business,
    com-atlassian-servicedesk-simplified-internal-service-desk,
    com-atlassian-servicedesk-simplified-external-service-desk,
    com-atlassian-servicedesk-simplified-hr-service-desk,
    com-atlassian-servicedesk-simplified-facilities-service-desk,
    com-atlassian-servicedesk-simplified-legal-service-desk,
    com-atlassian-servicedesk-simplified-marketing-service-desk,
    com-atlassian-servicedesk-simplified-finance-service-desk,
    com-atlassian-servicedesk-simplified-analytics-service-desk,
    com-atlassian-servicedesk-simplified-design-service-desk,
    com-atlassian-servicedesk-simplified-sales-service-desk,
    com-atlassian-servicedesk-simplified-halp-service-desk,
    com-atlassian-servicedesk-simplified-custom-project-service-desk,
    com-atlassian-jira-core-project-templates-jira-core-simplified-content-management,
    com-atlassian-jira-core-project-templates-jira-core-simplified-document-approval,
    com-atlassian-jira-core-project-templates-jira-core-simplified-lead-tracking,
    com-atlassian-jira-core-project-templates-jira-core-simplified-process-control,
    com-atlassian-jira-core-project-templates-jira-core-simplified-procurement,
    com-atlassian-jira-core-project-templates-jira-core-simplified-project-management,
    com-atlassian-jira-core-project-templates-jira-core-simplified-recruitment,
    com-atlassian-jira-core-project-templates-jira-core-simplified-task,
  }

  enum search-projects-order-by-enum {
    category,
    category-v2,
    category-v3,
    key,
    key-v2,
    key-v3,
    name,
    name-v2,
    name-v3,
    owner,
    owner-v2,
    owner-v3,
    issue-count,
    issue-count-v2,
    issue-count-v3,
    last-issue-updated-date,
    last-issue-updated-date-v2,
    last-issue-updated-date-v3,
    archived-date,
    archived-date-v2,
    archived-date-v3,
    deleted-date,
    deleted-date-v2,
    deleted-date-v3,
  }

  enum search-projects-action-enum {
    view,
    browse,
    edit,
  }

  enum search-projects-status-item-enum {
    live,
    archived,
    deleted,
  }

  enum event-notification-notification-type-enum {
    current-assignee,
    reporter,
    current-user,
    project-lead,
    component-lead,
    user,
    group,
    project-role,
    email-address,
    all-watchers,
    user-custom-field,
    group-custom-field,
  }

  enum role-actor-type-op-enum {
    atlassian-group-role-actor,
    atlassian-user-role-actor,
  }

  /// Details about a project.
  record project {
    /// Whether the project is archived.
    archived: option<bool>,
    /// The user who archived the project.
    archived-by: option<user>,
    /// The date when the project was archived.
    archived-date: option<string>,
    /// The default assignee when creating issues for this project.
    assignee-type: option<project-assignee-type-enum>,
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// List of the components contained in the project.
    components: option<list<project-component>>,
    /// Whether the project is marked as deleted.
    deleted: option<bool>,
    /// The user who marked the project as deleted.
    deleted-by: option<user>,
    /// The date when the project was marked as deleted.
    deleted-date: option<string>,
    /// A brief description of the project.
    description: option<string>,
    /// An email address associated with the project.
    email: option<string>,
    /// Expand options that include additional project details in the response.
    expand: option<string>,
    /// Whether the project is selected as a favorite.
    favourite: option<bool>,
    /// The ID of the project.
    id: option<string>,
    /// Insights about the project.
    insight: option<project-insight>,
    /// Whether the project is private.
    is-private: option<bool>,
    /// The issue type hierarchy for the project.
    issue-type-hierarchy: option<hierarchy>,
    /// List of the issue types available in the project.
    issue-types: option<list<issue-type-details>>,
    /// The key of the project.
    key: option<string>,
    /// The project landing page info.
    landing-page-info: option<project-landing-page-info>,
    /// The username of the project lead.
    lead: option<user>,
    /// The name of the project.
    name: option<string>,
    /// User permissions on the project
    permissions: option<project-permissions>,
    /// The category the project belongs to.
    project-category: option<project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// Map of project properties
    properties: option<project-properties>,
    /// The date when the project is deleted permanently.
    retention-till-date: option<string>,
    /// The name and self URL for each role defined in the project. For more information, see [Create project role](#api-rest-api-3-role-post).
    roles: option<project-roles>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether the project is simplified.
    simplified: option<bool>,
    /// The type of the project.
    style: option<project-style-enum>,
    /// A link to information about this project, such as project documentation.
    url: option<string>,
    /// Unique ID for next-gen projects.
    uuid: option<string>,
    /// The versions defined in the project. For more information, see [Create version](#api-rest-api-3-version-post).
    versions: option<list<version>>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a project component.
  record project-component {
    /// The details of the user associated with `assigneeType`, if any. See `realAssignee` for details of the user assigned to issues created with this component.
    assignee: option<user>,
    /// The nominal user type used to determine the assignee for issues created with this component. See `realAssigneeType` for details on how the type of the user, and hence the user, assigned to issues is determined. Can take the following values:
    /// 
    assignee-type: option<project-component-assignee-type-enum>,
    /// The description for the component. Optional when creating or updating a component.
    description: option<string>,
    /// The unique identifier for the component.
    id: option<string>,
    /// Whether a user is associated with `assigneeType`. For example, if the `assigneeType` is set to `COMPONENT_LEAD` but the component lead is not set, then `false` is returned.
    is-assignee-type-valid: option<bool>,
    /// The user details for the component's lead user.
    lead: option<user>,
    /// The accountId of the component's lead user. The accountId uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    lead-account-id: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    lead-user-name: option<string>,
    /// The unique name for the component in the project. Required when creating a component. Optional when updating a component. The maximum length is 255 characters.
    name: option<string>,
    /// The key of the project the component is assigned to. Required when creating a component. Can't be updated.
    project: option<string>,
    /// The ID of the project the component is assigned to.
    project-id: option<s64>,
    /// The user assigned to issues created with this component, when `assigneeType` does not identify a valid assignee.
    real-assignee: option<user>,
    /// The type of the assignee that is assigned to issues created with this component, when an assignee cannot be set from the `assigneeType`. For example, `assigneeType` is set to `COMPONENT_LEAD` but no component lead is set. This property is set to one of the following values:
    /// 
    real-assignee-type: option<project-component-assignee-type-enum>,
    /// The URL of the component.
    self: option<string>
  }

  /// Additional details about a project.
  record project-insight {
    /// The last issue update time.
    last-issue-update-time: option<string>,
    /// Total issue count.
    total-issue-count: option<s64>
  }

  /// The project issue type hierarchy.
  record hierarchy {
    /// The ID of the base level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    base-level-id: option<s64>,
    /// Details about the hierarchy level.
    levels: option<list<simplified-hierarchy-level>>
  }

  record simplified-hierarchy-level {
    /// The ID of the level above this one in the hierarchy. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    above-level-id: option<s64>,
    /// The ID of the level below this one in the hierarchy. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    below-level-id: option<s64>,
    /// The external UUID of the hierarchy level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    external-uuid: option<string>,
    hierarchy-level-number: option<s32>,
    /// The ID of the hierarchy level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    id: option<s64>,
    /// The issue types available in this hierarchy level.
    issue-type-ids: option<list<s64>>,
    /// The level of this item in the hierarchy.
    level: option<s32>,
    /// The name of this hierarchy level.
    name: option<string>,
    /// The ID of the project configuration. This property is deprecated, see [Change oticen: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    project-configuration-id: option<s64>
  }

  /// Details about an issue type.
  record issue-type-details {
    /// The ID of the issue type's avatar.
    avatar-id: option<s64>,
    /// The description of the issue type.
    description: option<string>,
    /// Unique ID for next-gen projects.
    entity-id: option<string>,
    /// Hierarchy level of the issue type.
    hierarchy-level: option<s32>,
    /// The URL of the issue type's avatar.
    icon-url: option<string>,
    /// The ID of the issue type.
    id: option<string>,
    /// The name of the issue type.
    name: option<string>,
    /// Details of the next-gen projects the issue type is available in.
    scope: option<scope>,
    /// The URL of these issue type details.
    self: option<string>,
    /// Whether this issue type is used to create subtasks.
    subtask: option<bool>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

