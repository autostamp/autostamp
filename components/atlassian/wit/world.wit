  }
  get-all-screen-tabs: func(params: get-all-screen-tabs-params) -> result<list<screenable-tab>, get-all-screen-tabs-error>;

  /// Create screen tab
  record add-screen-tab-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    id: option<s64>,
    /// The name of the screen tab. The maximum length is 255 characters.
    name: string
  }
  add-screen-tab: func(params: add-screen-tab-params) -> result<screenable-tab, add-screen-tab-error>;

  /// Update screen tab
  record rename-screen-tab-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The ID of the screen tab.
    id: option<s64>,
    /// The name of the screen tab. The maximum length is 255 characters.
    name: string
  }
  rename-screen-tab: func(params: rename-screen-tab-params) -> result<screenable-tab, rename-screen-tab-error>;

  /// Delete screen tab
  record delete-screen-tab-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string
  }
  delete-screen-tab: func(params: delete-screen-tab-params) -> result<string, delete-screen-tab-error>;

  /// Move screen tab
  record move-screen-tab-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The position of tab. The base index is 0.
    pos: string
  }
  move-screen-tab: func(params: move-screen-tab-params) -> result<string, move-screen-tab-error>;

}

interface screen-tab-fields {
  enum move-field-bean-position-enum {
    earlier,
    later,
    first,
    last,
  }

  /// A screen tab field.
  record screenable-field {
    /// The ID of the screen tab field.
    id: option<string>,
    /// The name of the screen tab field. Required on create and update. The maximum length is 255 characters.
    name: option<string>
  }

  variant get-all-screen-tab-fields-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-screen-tab-field-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-screen-tab-field-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant move-screen-tab-field-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all screen tab fields
