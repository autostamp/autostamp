interface status {
  enum scope-type-op-enum {
    project,
    global,
  }

  enum jira-status-status-category-enum {
    todo,
    in-progress,
    done,
  }

  /// Details of a status.
  record jira-status {
    /// The description of the status.
    description: option<string>,
    /// The ID of the status.
    id: option<string>,
    /// The name of the status.
    name: option<string>,
    scope: option<scope>,
    /// The category of the status.
    status-category: option<jira-status-status-category-enum>,
    /// Projects and issue types where the status is used. Only available if the `usages` expand is requested.
    usages: option<list<project-issue-types>>
  }

  /// The scope of the status.
  record scope {
    project: option<project-id>,
    /// The scope of the status. `GLOBAL` for company-managed projects and `PROJECT` for team-managed projects.
    type-op: scope-type-op-enum
  }

  /// Project ID details.
  record project-id {
    /// The ID of the project.
    id: string
  }

  /// Projects and issue types where the status is used. Only available if the `usages` expand is requested.
  record project-issue-types {
    /// IDs of the issue types
    issue-types: option<list<string>>,
    project: option<project-id>
  }

  /// Details of the status being created.
  record create {
    /// The description of the status.
    description: option<string>,
    /// The name of the status.
    name: string,
    /// The category of the status.
    status-category: jira-status-status-category-enum
  }

  /// Details of the status being updated.
  record update {
    /// The description of the status.
    description: option<string>,
    /// The ID of the status.
    id: string,
    /// The name of the status.
    name: string,
    /// The category of the status.
    status-category: jira-status-status-category-enum
  }

  record page-of-statuses {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// The URL of the next page of results, if any.
    next-page: option<string>,
    /// The URL of this page.
    self: option<string>,
    /// The index of the first item returned on the page.
    start-at: option<s64>,
    /// Number of items that satisfy the search.
    total: option<s64>,
    /// The list of items.
    values: option<list<jira-status>>
  }

  variant get-statuses-by-id-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant create-statuses-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant update-statuses-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-statuses-by-id-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant search-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// Bulk get statuses
  record get-statuses-by-id-params {
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The list of status IDs. To include multiple IDs, provide an ampersand-separated list. For example, id=10000&id=10001.
    /// 
    id: option<list<string>>
  }
  get-statuses-by-id: func(params: get-statuses-by-id-params) -> result<list<jira-status>, get-statuses-by-id-error>;

  /// Bulk create statuses
  record create-statuses-params {
    scope: scope,
    /// Details of the statuses being created.
    statuses: list<create>
  }
  create-statuses: func(params: create-statuses-params) -> result<list<jira-status>, create-statuses-error>;

  /// Bulk update statuses
  record update-statuses-params {
    /// The list of statuses that will be updated.
    statuses: option<list<update>>
  }
  update-statuses: func(params: update-statuses-params) -> result<string, update-statuses-error>;

  /// Bulk delete Statuses
  record delete-statuses-by-id-params {
    /// The list of status IDs. To include multiple IDs, provide an ampersand-separated list. For example, id=10000&id=10001.
    /// 
    id: option<list<string>>
  }
  delete-statuses-by-id: func(params: delete-statuses-by-id-params) -> result<string, delete-statuses-by-id-error>;

  /// Search statuses paginated
  record search-params {
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The project the status is part of or null for global statuses.
    project-id: option<string>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Term to match status names against or null to search for all statuses in the search scope.
    search-string: option<string>,
    /// Category of the status to filter by. The supported values are: `TODO`, `IN_PROGRESS`, and `DONE`.
    status-category: option<string>
  }
  search: func(params: search-params) -> result<page-of-statuses, search-error>;

}

interface tasks {
  enum task-progress-bean-object-status-enum {
    enqueued,
    running,
    complete,
    failed,
    cancel-requested,
    cancelled,
    dead,
  }

  /// Details about a task.
  record task-progress-bean-object {
    /// The description of the task.
    description: option<string>,
    /// The execution time of the task, in milliseconds.
    elapsed-runtime: s64,
    /// A timestamp recording when the task was finished.
    finished: option<s64>,
    /// The ID of the task.
    id: string,
    /// A timestamp recording when the task progress was last updated.
    last-update: s64,
    /// Information about the progress of the task.
    message: option<string>,
    /// The progress of the task, as a percentage complete.
    progress: s64,
    /// The result of the task execution.
    result-op: option<string>,
    /// The URL of the task.
    self: string,
    /// A timestamp recording when the task was started.
    started: option<s64>,
    /// The status of the task.
    status: task-progress-bean-object-status-enum,
    /// A timestamp recording when the task was submitted.
    submitted: s64,
    /// The ID of the user who submitted the task.
    submitted-by: s64
  }

  variant get-task-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant cancel-task-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get task
  record get-task-params {
    /// The ID of the task.
    task-id: string
  }
  get-task: func(params: get-task-params) -> result<task-progress-bean-object, get-task-error>;

  /// Cancel task
  record cancel-task-params {
    /// The ID of the task.
    task-id: string
  }
  cancel-task: func(params: cancel-task-params) -> result<string, cancel-task-error>;

}

interface ui-modifications-apps {
  /// A page of items.
  record page-bean-ui-modification-details {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<ui-modification-details>>
  }

  /// The details of a UI modification.
  record ui-modification-details {
    /// List of contexts of the UI modification. The maximum number of contexts is 1000.
    contexts: option<list<ui-modification-context-details>>,
    /// The data of the UI modification. The maximum size of the data is 50000 characters.
    data: option<string>,
    /// The description of the UI modification. The maximum length is 255 characters.
    description: option<string>,
    /// The ID of the UI modification.
    id: string,
    /// The name of the UI modification. The maximum length is 255 characters.
    name: string,
    /// The URL of the UI modification.
    self: string
  }

  /// The details of a UI modification's context, which define where to activate the UI modification.
  record ui-modification-context-details {
    /// The ID of the UI modification context.
    id: option<string>,
    /// Whether a context is available. For example, when a project is deleted the context becomes unavailable.
    is-available: option<bool>,
    /// The issue type ID of the context.
    issue-type-id: string,
    /// The project ID of the context.
    project-id: string,
    /// The view type of the context. Only `GIC` (Global Issue Create) is supported.
    view-type: string
  }

  /// Identifiers for a UI modification.
  record ui-modification-identifiers {
    /// The ID of the UI modification.
    id: string,
    /// The URL of the UI modification.
    self: string
  }

  variant get-ui-modifications-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-ui-modification-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-ui-modification-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-ui-modification-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get UI modifications
  record get-ui-modifications-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Use expand to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-ui-modifications: func(params: get-ui-modifications-params) -> result<page-bean-ui-modification-details, get-ui-modifications-error>;

  /// Create UI modification
  record create-ui-modification-params {
    /// List of contexts of the UI modification. The maximum number of contexts is 1000.
    contexts: option<list<ui-modification-context-details>>,
    /// The data of the UI modification. The maximum size of the data is 50000 characters.
    data: option<string>,
    /// The description of the UI modification. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the UI modification. The maximum length is 255 characters.
    name: string
  }
  create-ui-modification: func(params: create-ui-modification-params) -> result<ui-modification-identifiers, create-ui-modification-error>;

  /// Update UI modification
  record update-ui-modification-params {
    /// The ID of the UI modification.
    ui-modification-id: string,
    /// List of contexts of the UI modification. The maximum number of contexts is 1000. If provided, replaces all existing contexts.
    contexts: option<list<ui-modification-context-details>>,
    /// The data of the UI modification. The maximum size of the data is 50000 characters.
    data: option<string>,
    /// The description of the UI modification. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the UI modification. The maximum length is 255 characters.
    name: option<string>
  }
  update-ui-modification: func(params: update-ui-modification-params) -> result<string, update-ui-modification-error>;

  /// Delete UI modification
  record delete-ui-modification-params {
    /// The ID of the UI modification.
    ui-modification-id: string
  }
  delete-ui-modification: func(params: delete-ui-modification-params) -> result<string, delete-ui-modification-error>;

}

interface users {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A page of items.
  record page-bean-user {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<user>>
  }

  record user-migration-bean {
    account-id: option<string>,
    key: option<string>,
    username: option<string>
  }

  /// Details of an issue navigator column item.
  record column-item {
    /// The issue navigator column label.
    label: option<string>,
    /// The issue navigator column value.
    value: option<string>
  }

  record unrestricted-user-email {
    /// The accountId of the user
    account-id: option<string>,
    /// The email of the user
    email: option<string>
  }

  variant get-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-user-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant remove-user-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant bulk-get-users-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant bulk-get-users-migration-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-user-default-columns-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-user-columns-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant reset-user-columns-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-user-email-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant get-user-email-bulk-error {
    bad-request(string),
    unauthorized(string),
    service-unavailable(string),
    other(string)
  }

  variant get-user-groups-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-all-users-default-error {
    bad-request(string),
    forbidden(string),
    conflict(string),
    other(string)
  }

  variant get-all-users-error {
    bad-request(string),
    forbidden(string),
    conflict(string),
    other(string)
  }

  /// Get user
  record get-user-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required.
    account-id: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide) for details.
    username: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide) for details.
    key: option<string>,
    /// Use [expand](#expansion) to include additional information about users in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-user: func(params: get-user-params) -> result<user, get-user-error>;

  /// Create user
  record create-user-params {
    /// Deprecated, do not use.
    application-keys: option<list<string>>,
    /// This property is no longer available. If the user has an Atlassian account, their display name is not changed. If the user does not have an Atlassian account, they are sent an email asking them set up an account.
    display-name: option<string>,
    /// The email address for the user.
    email-address: string,
    /// This property is no longer available. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// This property is no longer available. If the user has an Atlassian account, their password is not changed. If the user does not have an Atlassian account, they are sent an email asking them set up an account.
    password: option<string>,
    /// Products the new user has access to. Valid products are: jira-core, jira-servicedesk, jira-product-discovery, jira-software. If left empty, the user will get default product access. To create a user without product access, set this field to be an empty array.
    products: option<list<string>>,
    /// The URL of the user.
    self: option<string>
  }
  create-user: func(params: create-user-params) -> result<user, create-user-error>;

  /// Delete user
  record remove-user-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: string,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>
  }
  remove-user: func(params: remove-user-params) -> result<string, remove-user-error>;

  /// Bulk get users
  record bulk-get-users-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<list<string>>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<list<string>>,
    /// The account ID of a user. To specify multiple users, pass multiple `accountId` parameters. For example, `accountId=5b10a2844c20165700ede21g&accountId=5b10ac8d82e05b22cc7d4ef5`.
    account-id: string
  }
  bulk-get-users: func(params: bulk-get-users-params) -> result<page-bean-user, bulk-get-users-error>;

  /// Get account IDs for users
  record bulk-get-users-migration-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// Username of a user. To specify multiple users, pass multiple copies of this parameter. For example, `username=fred&username=barney`. Required if `key` isn't provided. Cannot be provided if `key` is present.
    username: option<list<string>>,
    /// Key of a user. To specify multiple users, pass multiple copies of this parameter. For example, `key=fred&key=barney`. Required if `username` isn't provided. Cannot be provided if `username` is present.
    key: option<list<string>>
  }
  bulk-get-users-migration: func(params: bulk-get-users-migration-params) -> result<list<user-migration-bean>, bulk-get-users-migration-error>;

  /// Get user default columns
  record get-user-default-columns-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// This parameter is no longer available See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>
  }
  get-user-default-columns: func(params: get-user-default-columns-params) -> result<list<column-item>, get-user-default-columns-error>;

  /// Set user default columns
  record set-user-columns-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    body: option<list<string>>
  }
  set-user-columns: func(params: set-user-columns-params) -> result<string, set-user-columns-error>;

  /// Reset user default columns
  record reset-user-columns-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>
  }
  reset-user-columns: func(params: reset-user-columns-params) -> result<string, reset-user-columns-error>;

  /// Get user email
  record get-user-email-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, `5b10ac8d82e05b22cc7d4ef5`.
    account-id: string
  }
  get-user-email: func(params: get-user-email-params) -> result<unrestricted-user-email, get-user-email-error>;

  /// Get user email bulk
  record get-user-email-bulk-params {
    /// The account IDs of the users for which emails are required. An `accountId` is an identifier that uniquely identifies the user across all Atlassian products. For example, `5b10ac8d82e05b22cc7d4ef5`. Note, this should be treated as an opaque identifier (that is, do not assume any structure in the value).
    account-id: string
  }
  get-user-email-bulk: func(params: get-user-email-bulk-params) -> result<unrestricted-user-email, get-user-email-bulk-error>;

  /// Get user groups
  record get-user-groups-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: string,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>
  }
  get-user-groups: func(params: get-user-groups-params) -> result<list<group-name>, get-user-groups-error>;

  /// Get all users default
  record get-all-users-default-params {
    /// The index of the first item to return.
    start-at: option<s32>,
    /// The maximum number of items to return.
    max-results: option<s32>
  }
  get-all-users-default: func(params: get-all-users-default-params) -> result<list<user>, get-all-users-default-error>;

  /// Get all users
  record get-all-users-params {
    /// The index of the first item to return.
    start-at: option<s32>,
    /// The maximum number of items to return.
    max-results: option<s32>
  }
  get-all-users: func(params: get-all-users-params) -> result<list<user>, get-all-users-error>;

}

interface user-search {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The list of users found in a search, including header text (Showing X of Y matching users) and total of matched users.
  record found-users {
    /// Header text indicating the number of users in the response and the total number of users found in the search.
    header: option<string>,
    /// The total number of users found in the search.
    total: option<s32>,
    users: option<list<user-picker-user>>
  }

  /// A user found in a search.
  record user-picker-user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The avatar URL of the user.
    avatar-url: option<string>,
    /// The display name of the user. Depending on the user’s privacy setting, this may be returned as null.
    display-name: option<string>,
    /// The display name, email address, and key of the user with the matched query string highlighted with the HTML bold tag.
    html: option<string>,
    /// This property is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available . See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>
  }

  /// A page of items.
  record page-bean-user {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<user>>
  }

  /// A page of items.
  record page-bean-user-key {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<user-key>>
  }

  /// List of user account IDs.
  record user-key {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Returns *unknown* if the record is deleted and corrupted, for example, as the result of a server import.
    account-id: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>
  }

  variant find-bulk-assignable-users-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant find-assignable-users-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant find-users-with-all-permissions-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant find-users-for-picker-error {
    bad-request(string),
    unauthorized(string),
    too-many-requests(string),
    other(string)
  }

  variant find-users-error {
    bad-request(string),
    unauthorized(string),
    too-many-requests(string),
    other(string)
  }

  variant find-users-by-query-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    request-timeout(string),
    other(string)
  }

  variant find-user-keys-by-query-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    request-timeout(string),
    other(string)
  }

  variant find-users-with-browse-permission-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  /// Find users assignable to projects
  record find-bulk-assignable-users-params {
    /// A query string that is matched against user attributes, such as `displayName` and `emailAddress`, to find relevant users. The string can match the prefix of the attribute's value. For example, *query=john* matches a user with a `displayName` of *John Smith* and a user with an `emailAddress` of *johnson@example.com*. Required, unless `accountId` is specified.
    query: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// A query string that is matched exactly against user `accountId`. Required, unless `query` is specified.
    account-id: option<string>,
    /// A list of project keys (case sensitive). This parameter accepts a comma-separated list.
    project-keys: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s32>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  find-bulk-assignable-users: func(params: find-bulk-assignable-users-params) -> result<list<user>, find-bulk-assignable-users-error>;

  /// Find users assignable to issues
  record find-assignable-users-params {
    /// A query string that is matched against user attributes, such as `displayName`, and `emailAddress`, to find relevant users. The string can match the prefix of the attribute's value. For example, *query=john* matches a user with a `displayName` of *John Smith* and a user with an `emailAddress` of *johnson@example.com*. Required, unless `username` or `accountId` is specified.
    query: option<string>,
    /// The sessionId of this request. SessionId is the same until the assignee is set.
    session-id: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// A query string that is matched exactly against user `accountId`. Required, unless `query` is specified.
    account-id: option<string>,
    /// The project ID or project key (case sensitive). Required, unless `issueKey` is specified.
    project: option<string>,
    /// The key of the issue. Required, unless `project` is specified.
    issue-key: option<string>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s32>,
    /// The maximum number of items to return. This operation may return less than the maximum number of items even if more are available. The operation fetches users up to the maximum and then, from the fetched users, returns only the users that can be assigned to the issue.
    max-results: option<s32>,
    /// The ID of the transition.
    action-descriptor-id: option<s32>,
    recommend: option<bool>
  }
  find-assignable-users: func(params: find-assignable-users-params) -> result<list<user>, find-assignable-users-error>;

  /// Find users with permissions
  record find-users-with-all-permissions-params {
    /// A query string that is matched against user attributes, such as `displayName` and `emailAddress`, to find relevant users. The string can match the prefix of the attribute's value. For example, *query=john* matches a user with a `displayName` of *John Smith* and a user with an `emailAddress` of *johnson@example.com*. Required, unless `accountId` is specified.
    query: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// A query string that is matched exactly against user `accountId`. Required, unless `query` is specified.
    account-id: option<string>,
    /// A comma separated list of permissions. Permissions can be specified as any:
    /// 
    permissions: string,
    /// The issue key for the issue.
    issue-key: option<string>,
    /// The project key for the project (case sensitive).
    project-key: option<string>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s32>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  find-users-with-all-permissions: func(params: find-users-with-all-permissions-params) -> result<list<user>, find-users-with-all-permissions-error>;

  /// Find users for picker
  record find-users-for-picker-params {
    /// A query string that is matched against user attributes, such as `displayName`, and `emailAddress`, to find relevant users. The string can match the prefix of the attribute's value. For example, *query=john* matches a user with a `displayName` of *John Smith* and a user with an `emailAddress` of *johnson@example.com*.
    query: string,
    /// The maximum number of items to return. The total number of matched users is returned in `total`.
    max-results: option<s32>,
    /// Include the URI to the user's avatar.
    show-avatar: option<bool>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    exclude: option<list<string>>,
    /// A list of account IDs to exclude from the search results. This parameter accepts a comma-separated list. Multiple account IDs can also be provided using an ampersand-separated list. For example, `excludeAccountIds=5b10a2844c20165700ede21g,5b10a0effa615349cb016cd8&excludeAccountIds=5b10ac8d82e05b22cc7d4ef5`. Cannot be provided with `exclude`.
    exclude-account-ids: option<list<string>>,
    avatar-size: option<string>,
    exclude-connect-users: option<bool>
  }
  find-users-for-picker: func(params: find-users-for-picker-params) -> result<found-users, find-users-for-picker-error>;

  /// Find users
  record find-users-params {
    /// A query string that is matched against user attributes ( `displayName`, and `emailAddress`) to find relevant users. The string can match the prefix of the attribute's value. For example, *query=john* matches a user with a `displayName` of *John Smith* and a user with an `emailAddress` of *johnson@example.com*. Required, unless `accountId` or `property` is specified.
    query: option<string>,
    username: option<string>,
    /// A query string that is matched exactly against a user `accountId`. Required, unless `query` or `property` is specified.
    account-id: option<string>,
    /// The index of the first item to return in a page of filtered results (page offset).
    start-at: option<s32>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// A query string used to search properties. Property keys are specified by path, so property keys containing dot (.) or equals (=) characters cannot be used. The query string cannot be specified using a JSON object. Example: To search for the value of `nested` from `{"something":{"nested":1,"other":2}}` use `thepropertykey.something.nested=1`. Required, unless `accountId` or `query` is specified.
    property: option<string>
  }
  find-users: func(params: find-users-params) -> result<list<user>, find-users-error>;

  /// Find users by query
  record find-users-by-query-params {
    /// The search query.
    query: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  find-users-by-query: func(params: find-users-by-query-params) -> result<page-bean-user, find-users-by-query-error>;

  /// Find user keys by query
  record find-user-keys-by-query-params {
    /// The search query.
    query: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  find-user-keys-by-query: func(params: find-user-keys-by-query-params) -> result<page-bean-user-key, find-user-keys-by-query-error>;

  /// Find users with browse permission
  record find-users-with-browse-permission-params {
    /// A query string that is matched against user attributes, such as `displayName` and `emailAddress`, to find relevant users. The string can match the prefix of the attribute's value. For example, *query=john* matches a user with a `displayName` of *John Smith* and a user with an `emailAddress` of *johnson@example.com*. Required, unless `accountId` is specified.
    query: option<string>,
    /// This parameter is no longer available. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// A query string that is matched exactly against user `accountId`. Required, unless `query` is specified.
    account-id: option<string>,
    /// The issue key for the issue. Required, unless `projectKey` is specified.
    issue-key: option<string>,
    /// The project key for the project (case sensitive). Required, unless `issueKey` is specified.
    project-key: option<string>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s32>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  find-users-with-browse-permission: func(params: find-users-with-browse-permission-params) -> result<list<user>, find-users-with-browse-permission-error>;

}

interface user-properties {
  /// List of property keys.
  record property-keys {
    /// Property key details.
    keys: option<list<property-key>>
  }

  /// Property key details.
  record property-key {
    /// The key of the property.
    key: option<string>,
    /// The URL of the property.
    self: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  variant get-user-property-keys-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-user-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-user-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant delete-user-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get user property keys
  record get-user-property-keys-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    user-key: option<string>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>
  }
  get-user-property-keys: func(params: get-user-property-keys-params) -> result<property-keys, get-user-property-keys-error>;

  /// Get user property
  record get-user-property-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    user-key: option<string>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// The key of the user's property.
    property-key: string
  }
  get-user-property: func(params: get-user-property-params) -> result<entity-property, get-user-property-error>;

  /// Set user property
  record set-user-property-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    user-key: option<string>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// The key of the user's property. The maximum length is 255 characters.
    property-key: string,
    body: string
  }
  set-user-property: func(params: set-user-property-params) -> result<string, set-user-property-error>;

  /// Delete user property
  record delete-user-property-params {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    user-key: option<string>,
    /// This parameter is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    username: option<string>,
    /// The key of the user's property.
    property-key: string
  }
  delete-user-property: func(params: delete-user-property-params) -> result<string, delete-user-property-error>;

}

interface webhooks {
  enum webhook-events-item-enum {
    jira-issue-created,
    jira-issue-updated,
    jira-issue-deleted,
    comment-created,
    comment-updated,
    comment-deleted,
    issue-property-set,
    issue-property-deleted,
  }

  /// A page of items.
  record page-bean-webhook {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<webhook>>
  }

  /// A webhook.
  record webhook {
    /// The Jira events that trigger the webhook.
    events: list<webhook-events-item-enum>,
    /// The date after which the webhook is no longer sent. Use [Extend webhook life](https://developer.atlassian.com/cloud/jira/platform/rest/v3/api-group-webhooks/#api-rest-api-3-webhook-refresh-put) to extend the date.
    expiration-date: option<s64>,
    /// A list of field IDs. When the issue changelog contains any of the fields, the webhook `jira:issue_updated` is sent. If this parameter is not present, the app is notified about all field updates.
    field-ids-filter: option<list<string>>,
    /// The ID of the webhook.
    id: s64,
    /// A list of issue property keys. A change of those issue properties triggers the `issue_property_set` or `issue_property_deleted` webhooks. If this parameter is not present, the app is notified about all issue property updates.
    issue-property-keys-filter: option<list<string>>,
    /// The JQL filter that specifies which issues the webhook is sent for.
    jql-filter: string
  }

  /// A list of webhooks.
  record webhook-details {
    /// The Jira events that trigger the webhook.
    events: list<webhook-events-item-enum>,
    /// A list of field IDs. When the issue changelog contains any of the fields, the webhook `jira:issue_updated` is sent. If this parameter is not present, the app is notified about all field updates.
    field-ids-filter: option<list<string>>,
    /// A list of issue property keys. A change of those issue properties triggers the `issue_property_set` or `issue_property_deleted` webhooks. If this parameter is not present, the app is notified about all issue property updates.
    issue-property-keys-filter: option<list<string>>,
    /// The JQL filter that specifies which issues the webhook is sent for. Only a subset of JQL can be used. The supported elements are:
    /// 
    jql-filter: string
  }

  /// Container for a list of registered webhooks. Webhook details are returned in the same order as the request.
  record container-for-registered-webhooks {
    /// A list of registered webhooks.
    webhook-registration-result: option<list<registered-webhook>>
  }

  /// ID of a registered webhook or error messages explaining why a webhook wasn't registered.
  record registered-webhook {
    /// The ID of the webhook. Returned if the webhook is created.
    created-webhook-id: option<s64>,
    /// Error messages specifying why the webhook creation failed.
    errors: option<list<string>>
  }

  /// A page of failed webhooks.
  record failed-webhooks {
    /// The maximum number of items on the page. If the list of values is shorter than this number, then there are no more pages.
    max-results: s32,
    /// The URL to the next page of results. Present only if the request returned at least one result.The next page may be empty at the time of receiving the response, but new failed webhooks may appear in time. You can save the URL to the next page and query for new results periodically (for example, every hour).
    next: option<string>,
    /// The list of webhooks.
    values: list<failed-webhook>
  }

  /// Details about a failed webhook.
  record failed-webhook {
    /// The webhook body.
    body: option<string>,
    /// The time the webhook was added to the list of failed webhooks (that is, the time of the last failed retry).
    failure-time: s64,
    /// The webhook ID, as sent in the `X-Atlassian-Webhook-Identifier` header with the webhook.
    id: string,
    /// The original webhook destination.
    url: string
  }

  /// The date the refreshed webhooks expire.
  record expiration-date {
    /// The expiration date of all the refreshed webhooks.
    expiration-date: s64
  }

  variant get-dynamic-webhooks-for-app-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant register-dynamic-webhooks-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant delete-webhook-by-id-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant get-failed-webhooks-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant refresh-webhooks-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  /// Get dynamic webhooks for app
  record get-dynamic-webhooks-for-app-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-dynamic-webhooks-for-app: func(params: get-dynamic-webhooks-for-app-params) -> result<page-bean-webhook, get-dynamic-webhooks-for-app-error>;

  /// Register dynamic webhooks
  record register-dynamic-webhooks-params {
    /// The URL that specifies where to send the webhooks. This URL must use the same base URL as the Connect app. Only a single URL per app is allowed to be registered.
    url: string,
    /// A list of webhooks.
    webhooks: list<webhook-details>
  }
  register-dynamic-webhooks: func(params: register-dynamic-webhooks-params) -> result<container-for-registered-webhooks, register-dynamic-webhooks-error>;

  /// Delete webhooks by ID
  record delete-webhook-by-id-params {
    /// A list of webhook IDs.
    webhook-ids: list<s64>
  }
  delete-webhook-by-id: func(params: delete-webhook-by-id-params) -> result<string, delete-webhook-by-id-error>;

  /// Get failed webhooks
  record get-failed-webhooks-params {
    /// The maximum number of webhooks to return per page. If obeying the maxResults directive would result in records with the same failure time being split across pages, the directive is ignored and all records with the same failure time included on the page.
    max-results: option<s32>,
    /// The time after which any webhook failure must have occurred for the record to be returned, expressed as milliseconds since the UNIX epoch.
    after: option<s64>
  }
  get-failed-webhooks: func(params: get-failed-webhooks-params) -> result<failed-webhooks, get-failed-webhooks-error>;

  /// Extend webhook life
  record refresh-webhooks-params {
    /// A list of webhook IDs.
    webhook-ids: list<s64>
  }
  refresh-webhooks: func(params: refresh-webhooks-params) -> result<expiration-date, refresh-webhooks-error>;

}

interface workflows {
  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum create-workflow-condition-operator-enum {
    and,
    or,
  }

  enum create-workflow-transition-details-type-op-enum {
    global,
    initial,
    directed,
  }

  enum get-workflows-paginated-order-by-enum {
    name,
    name-v2,
    name-v3,
    created,
    created-v2,
    created-v3,
    updated,
    updated-v2,
    updated-v3,
  }

  /// Details about a workflow.
  record deprecated-workflow {
    default: option<bool>,
    /// The description of the workflow.
    description: option<string>,
    /// The datetime the workflow was last modified.
    last-modified-date: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    last-modified-user: option<string>,
    /// The account ID of the user that last modified the workflow.
    last-modified-user-account-id: option<string>,
    /// The name of the workflow.
    name: option<string>,
    /// The scope where this workflow applies
    scope: option<scope>,
    /// The number of steps included in the workflow.
    steps: option<s32>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// The details of a transition status.
  record create-workflow-status-details {
    /// The ID of the status.
    id: string,
    /// The properties of the status.
    properties: option<create-workflow-status-details-properties>
  }

  /// The properties of the status.
  record create-workflow-status-details-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The details of a workflow transition.
  record create-workflow-transition-details {
    /// The description of the transition. The maximum length is 1000 characters.
    description: option<string>,
    /// The statuses the transition can start from.
    from-op: option<list<string>>,
    /// The name of the transition. The maximum length is 60 characters.
    name: string,
    /// The properties of the transition.
    properties: option<create-workflow-transition-details-properties>,
    /// The rules of the transition.
    rules: option<create-workflow-transition-rules-details>,
    /// The screen of the transition.
    screen: option<create-workflow-transition-screen-details>,
    /// The status the transition goes to.
    to: string,
    /// The type of the transition.
    type-op: create-workflow-transition-details-type-op-enum
  }

  /// The properties of the transition.
  record create-workflow-transition-details-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The details of a workflow transition rules.
  record create-workflow-transition-rules-details {
    /// The workflow conditions.
    conditions: option<create-workflow-condition>,
    /// The workflow post functions.
    /// 
    post-functions: option<list<create-workflow-transition-rule>>,
    /// The workflow validators.
    /// 
    validators: option<list<create-workflow-transition-rule>>
  }

  /// A workflow transition condition.
  record create-workflow-condition {
    /// The list of workflow conditions.
    conditions: option<list<string>>,
    /// EXPERIMENTAL. The configuration of the transition rule.
    configuration: option<create-workflow-condition-configuration>,
    /// The compound condition operator.
    operator: option<create-workflow-condition-operator-enum>,
    /// The type of the transition rule.
    type-op: option<string>
  }

  /// EXPERIMENTAL. The configuration of the transition rule.
  record create-workflow-condition-configuration {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A workflow transition rule.
  record create-workflow-transition-rule {
    /// EXPERIMENTAL. The configuration of the transition rule.
    configuration: option<create-workflow-transition-rule-configuration>,
    /// The type of the transition rule.
    type-op: string
  }

  /// EXPERIMENTAL. The configuration of the transition rule.
  record create-workflow-transition-rule-configuration {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The details of a transition screen.
  record create-workflow-transition-screen-details {
    /// The ID of the screen.
    id: string
  }

  /// The classic workflow identifiers.
  record workflow-i-ds {
    /// The entity ID of the workflow.
    entity-id: option<string>,
    /// The name of the workflow.
    name: string
  }

  /// A page of items.
  record page-bean-workflow {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<workflow>>
  }

  /// Details about a workflow.
  record workflow {
    /// The creation date of the workflow.
    created: option<string>,
    /// The description of the workflow.
    description: string,
    /// Whether the workflow has a draft version.
    has-draft-workflow: option<bool>,
    id: published-workflow-id,
    /// Whether this is the default workflow.
    is-default: option<bool>,
    operations: option<workflow-operations>,
    /// The projects the workflow is assigned to, through workflow schemes.
    projects: option<list<project-details>>,
    /// The workflow schemes the workflow is assigned to.
    schemes: option<list<workflow-scheme-id-name>>,
    /// The statuses of the workflow.
    statuses: option<list<workflow-status>>,
    /// The transitions of the workflow.
    transitions: option<list<transition>>,
    /// The last edited date of the workflow.
    updated: option<string>
  }

  /// Properties that identify a published workflow.
  record published-workflow-id {
    /// The entity ID of the workflow.
    entity-id: option<string>,
    /// The name of the workflow.
    name: string
  }

  /// Operations allowed on a workflow
  record workflow-operations {
    /// Whether the workflow can be deleted.
    can-delete: bool,
    /// Whether the workflow can be updated.
    can-edit: bool
  }

  /// The ID and the name of the workflow scheme.
  record workflow-scheme-id-name {
    /// The ID of the workflow scheme.
    id: string,
    /// The name of the workflow scheme.
    name: string
  }

  /// Details of a workflow status.
  record workflow-status {
    /// The ID of the issue status.
    id: string,
    /// The name of the status in the workflow.
    name: string,
    /// Additional properties that modify the behavior of issues in this status. Supports the properties `jira.issue.editable` and `issueEditable` (deprecated) that indicate whether issues are editable.
    properties: option<workflow-status-properties>
  }

  /// Additional properties that modify the behavior of issues in this status. Supports the properties `jira.issue.editable` and `issueEditable` (deprecated) that indicate whether issues are editable.
  record workflow-status-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of a workflow transition.
  record transition {
    /// The description of the transition.
    description: string,
    /// The statuses the transition can start from.
    from-op: list<string>,
    /// The ID of the transition.
    id: string,
    /// The name of the transition.
    name: string,
    /// The properties of the transition.
    properties: option<transition-properties>,
    rules: option<workflow-rules>,
    screen: option<transition-screen-details>,
    /// The status the transition goes to.
    to: string,
    /// The type of the transition.
    type-op: create-workflow-transition-details-type-op-enum
  }

  /// The properties of the transition.
  record transition-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A collection of transition rules.
  record workflow-rules {
    conditions-tree: option<workflow-condition>,
    /// The workflow post functions.
    post-functions: option<list<workflow-transition-rule>>,
    /// The workflow validators.
    validators: option<list<workflow-transition-rule>>
  }

  /// The workflow transition rule conditions tree.
  record workflow-condition {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A workflow transition rule.
  record workflow-transition-rule {
    /// EXPERIMENTAL. The configuration of the transition rule.
    configuration: option<string>,
    /// The type of the transition rule.
    type-op: string
  }

  /// The details of a transition screen.
  record transition-screen-details {
    /// The ID of the screen.
    id: string,
    /// The name of the screen.
    name: option<string>
  }

  variant get-all-workflows-error {
    unauthorized(string),
    other(string)
  }

  variant create-workflow-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-workflows-paginated-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant delete-inactive-workflow-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all workflows
  record get-all-workflows-params {
    /// The name of the workflow to be returned. Only one workflow can be specified.
    workflow-name: option<string>
  }
  get-all-workflows: func(params: get-all-workflows-params) -> result<list<deprecated-workflow>, get-all-workflows-error>;

  /// Create workflow
  record create-workflow-params {
    /// The description of the workflow. The maximum length is 1000 characters.
    description: option<string>,
    /// The name of the workflow. The name must be unique. The maximum length is 255 characters. Characters can be separated by a whitespace but the name cannot start or end with a whitespace.
    name: string,
    /// The statuses of the workflow. Any status that does not include a transition is added to the workflow without a transition.
    statuses: list<create-workflow-status-details>,
    /// The transitions of the workflow. For the request to be valid, these transitions must:
    /// 
    transitions: list<create-workflow-transition-details>
  }
  create-workflow: func(params: create-workflow-params) -> result<workflow-i-ds, create-workflow-error>;

  /// Get workflows paginated
  record get-workflows-paginated-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The name of a workflow to return. To include multiple workflows, provide an ampersand-separated list. For example, `workflowName=name1&workflowName=name2`.
    workflow-name: option<list<string>>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// String used to perform a case-insensitive partial match with workflow name.
    query-string: option<string>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-workflows-paginated-order-by-enum>,
    /// Filters active and inactive workflows.
    is-active: option<bool>
  }
  get-workflows-paginated: func(params: get-workflows-paginated-params) -> result<page-bean-workflow, get-workflows-paginated-error>;

  /// Delete inactive workflow
  record delete-inactive-workflow-params {
    /// The entity ID of the workflow.
    entity-id: string
  }
  delete-inactive-workflow: func(params: delete-inactive-workflow-params) -> result<string, delete-inactive-workflow-error>;

}

interface workflow-transition-rules {
  enum get-workflow-transition-rule-configurations-types-item-enum {
    postfunction,
    condition,
    validator,
  }

  /// A page of items.
  record page-bean-workflow-transition-rules {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<workflow-transition-rules>>
  }

  /// A workflow with transition rules.
  record workflow-transition-rules {
    /// The list of conditions within the workflow.
    conditions: option<list<app-workflow-transition-rule>>,
    /// The list of post functions within the workflow.
    post-functions: option<list<app-workflow-transition-rule>>,
    /// The list of validators within the workflow.
    validators: option<list<app-workflow-transition-rule>>,
    workflow-id: workflow-id
  }

  /// A workflow transition rule.
  record app-workflow-transition-rule {
    configuration: rule-configuration,
    /// The ID of the transition rule.
    id: string,
    /// The key of the rule, as defined in the Connect or the Forge app descriptor.
    key: string,
    transition: option<workflow-transition>
  }

  /// A rule configuration.
  record rule-configuration {
    /// EXPERIMENTAL: Whether the rule is disabled.
    disabled: option<bool>,
    /// EXPERIMENTAL: A tag used to filter rules in [Get workflow transition rule configurations](https://developer.atlassian.com/cloud/jira/platform/rest/v3/api-group-workflow-transition-rules/#api-rest-api-3-workflow-rule-config-get).
    tag: option<string>,
    /// Configuration of the rule, as it is stored by the Connect or the Forge app on the rule configuration page.
    value: string
  }

  /// A workflow transition.
  record workflow-transition {
    /// The transition ID.
    id: s32,
    /// The transition name.
    name: string
  }

  /// Properties that identify a workflow.
  record workflow-id {
    /// Whether the workflow is in the draft state.
    draft: bool,
    /// The name of the workflow.
    name: string
  }

  /// Details of any errors encountered while updating workflow transition rules.
  record update-errors {
    /// A list of workflows.
    update-results: list<update-error-details>
  }

  /// Details of any errors encountered while updating workflow transition rules for a workflow.
  record update-error-details {
    /// A list of transition rule update errors, indexed by the transition rule ID. Any transition rule that appears here wasn't updated.
    rule-update-errors: update-error-details-rule-update-errors,
    /// The list of errors that specify why the workflow update failed. The workflow was not updated if the list contains any entries.
    update-errors: list<string>,
    workflow-id: workflow-id
  }

  /// A list of transition rule update errors, indexed by the transition rule ID. Any transition rule that appears here wasn't updated.
  record update-error-details-rule-update-errors {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a workflow configuration update request.
  record details {
    workflow-id: workflow-id,
    /// The list of connect workflow rule IDs.
    workflow-rule-ids: list<string>
  }

  variant get-workflow-transition-rule-configurations-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-workflow-transition-rule-configurations-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant delete-workflow-transition-rule-configurations-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  /// Get workflow transition rule configurations
  record get-workflow-transition-rule-configurations-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The types of the transition rules to return.
    types: list<get-workflow-transition-rule-configurations-types-item-enum>,
    /// The transition rule class keys, as defined in the Connect or the Forge app descriptor, of the transition rules to return.
    keys: option<list<string>>,
    /// EXPERIMENTAL: The list of workflow names to filter by.
    workflow-names: option<string>,
    /// EXPERIMENTAL: The list of `tags` to filter by.
    with-tags: option<string>,
    /// EXPERIMENTAL: Whether draft or published workflows are returned. If not provided, both workflow types are returned.
    draft: option<bool>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts `transition`, which, for each rule, returns information about the transition the rule is assigned to.
    expand: option<string>
  }
  get-workflow-transition-rule-configurations: func(params: get-workflow-transition-rule-configurations-params) -> result<page-bean-workflow-transition-rules, get-workflow-transition-rule-configurations-error>;

  /// Update workflow transition rule configurations
  record update-workflow-transition-rule-configurations-params {
    /// The list of workflows with transition rules to update.
    workflows: list<workflow-transition-rules>
  }
  update-workflow-transition-rule-configurations: func(params: update-workflow-transition-rule-configurations-params) -> result<update-errors, update-workflow-transition-rule-configurations-error>;

  /// Delete workflow transition rule configurations
  record delete-workflow-transition-rule-configurations-params {
    /// The list of workflows with transition rules to delete.
    workflows: list<details>
  }
  delete-workflow-transition-rule-configurations: func(params: delete-workflow-transition-rule-configurations-params) -> result<update-errors, delete-workflow-transition-rule-configurations-error>;

}

interface workflow-transition-properties {
  enum get-workflow-transition-properties-workflow-mode-enum {
    live,
    draft,
  }

  /// Details about the server Jira is running on.
  record workflow-transition-property {
    /// The ID of the transition property.
    id: option<string>,
    /// The key of the transition property. Also known as the name of the transition property.
    key: option<string>,
    /// The value of the transition property.
    value: string
  }

  variant get-workflow-transition-properties-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-workflow-transition-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-workflow-transition-property-error {
    not-modified(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-workflow-transition-property-error {
    not-modified(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get workflow transition properties
  record get-workflow-transition-properties-params {
    /// The ID of the transition. To get the ID, view the workflow in text mode in the Jira administration console. The ID is shown next to the transition.
    transition-id: string,
    /// Some properties with keys that have the *jira.* prefix are reserved, which means they are not editable. To include these properties in the results, set this parameter to *true*.
    include-reserved-keys: option<bool>,
    /// The key of the property being returned, also known as the name of the property. If this parameter is not specified, all properties on the transition are returned.
    key: option<string>,
    /// The name of the workflow that the transition belongs to.
    workflow-name: string,
    /// The workflow status. Set to *live* for active and inactive workflows, or *draft* for draft workflows.
    workflow-mode: option<get-workflow-transition-properties-workflow-mode-enum>
  }
  get-workflow-transition-properties: func(params: get-workflow-transition-properties-params) -> result<workflow-transition-property, get-workflow-transition-properties-error>;

  /// Create workflow transition property
  record create-workflow-transition-property-params {
    /// The ID of the transition. To get the ID, view the workflow in text mode in the Jira admin settings. The ID is shown next to the transition.
    transition-id: string,
    /// The key of the property being added, also known as the name of the property. Set this to the same value as the `key` defined in the request body.
    key: string,
    /// The name of the workflow that the transition belongs to.
    workflow-name: string,
    /// The workflow status. Set to *live* for inactive workflows or *draft* for draft workflows. Active workflows cannot be edited.
    workflow-mode: option<get-workflow-transition-properties-workflow-mode-enum>,
    /// The ID of the transition property.
    id: option<string>,
    /// The key of the transition property. Also known as the name of the transition property.
    key-v2: option<string>,
    /// The value of the transition property.
    value: string
  }
  create-workflow-transition-property: func(params: create-workflow-transition-property-params) -> result<workflow-transition-property, create-workflow-transition-property-error>;

  /// Update workflow transition property
  record update-workflow-transition-property-params {
    /// The ID of the transition. To get the ID, view the workflow in text mode in the Jira admin settings. The ID is shown next to the transition.
    transition-id: string,
    /// The key of the property being updated, also known as the name of the property. Set this to the same value as the `key` defined in the request body.
    key: string,
    /// The name of the workflow that the transition belongs to.
    workflow-name: string,
    /// The workflow status. Set to `live` for inactive workflows or `draft` for draft workflows. Active workflows cannot be edited.
    workflow-mode: option<get-workflow-transition-properties-workflow-mode-enum>,
    /// The ID of the transition property.
    id: option<string>,
    /// The key of the transition property. Also known as the name of the transition property.
    key-v2: option<string>,
    /// The value of the transition property.
    value: string
  }
  update-workflow-transition-property: func(params: update-workflow-transition-property-params) -> result<workflow-transition-property, update-workflow-transition-property-error>;

  /// Delete workflow transition property
  record delete-workflow-transition-property-params {
    /// The ID of the transition. To get the ID, view the workflow in text mode in the Jira admin settings. The ID is shown next to the transition.
    transition-id: string,
    /// The name of the transition property to delete, also known as the name of the property.
    key: string,
    /// The name of the workflow that the transition belongs to.
    workflow-name: string,
    /// The workflow status. Set to `live` for inactive workflows or `draft` for draft workflows. Active workflows cannot be edited.
    workflow-mode: option<get-workflow-transition-properties-workflow-mode-enum>
  }
  delete-workflow-transition-property: func(params: delete-workflow-transition-property-params) -> result<string, delete-workflow-transition-property-error>;

}

interface workflow-schemes {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  /// A page of items.
  record page-bean-workflow-scheme {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<workflow-scheme>>
  }

  /// Details about a workflow scheme.
  record workflow-scheme {
    /// The name of the default workflow for the workflow scheme. The default workflow has *All Unassigned Issue Types* assigned to it in Jira. If `defaultWorkflow` is not specified when creating a workflow scheme, it is set to *Jira Workflow (jira)*.
    default-workflow: option<string>,
    /// The description of the workflow scheme.
    description: option<string>,
    /// Whether the workflow scheme is a draft or not.
    draft: option<bool>,
    /// The ID of the workflow scheme.
    id: option<s64>,
    /// The issue type to workflow mappings, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
    issue-type-mappings: option<workflow-scheme-issue-type-mappings>,
    /// The issue types available in Jira.
    issue-types: option<workflow-scheme-issue-types>,
    /// The date-time that the draft workflow scheme was last modified. A modification is a change to the issue type-project mappings only. This property does not apply to non-draft workflows.
    last-modified: option<string>,
    /// The user that last modified the draft workflow scheme. A modification is a change to the issue type-project mappings only. This property does not apply to non-draft workflows.
    last-modified-user: option<user>,
    /// The name of the workflow scheme. The name must be unique. The maximum length is 255 characters. Required when creating a workflow scheme.
    name: option<string>,
    /// For draft workflow schemes, this property is the name of the default workflow for the original workflow scheme. The default workflow has *All Unassigned Issue Types* assigned to it in Jira.
    original-default-workflow: option<string>,
    /// For draft workflow schemes, this property is the issue type to workflow mappings for the original workflow scheme, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
    original-issue-type-mappings: option<workflow-scheme-original-issue-type-mappings>,
    self: option<string>,
    /// Whether to create or update a draft workflow scheme when updating an active workflow scheme. An active workflow scheme is a workflow scheme that is used by at least one project. The following examples show how this property works:
    /// 
    update-draft-if-needed: option<bool>
  }

  /// The issue type to workflow mappings, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
  record workflow-scheme-issue-type-mappings {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The issue types available in Jira.
  record workflow-scheme-issue-types {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// For draft workflow schemes, this property is the issue type to workflow mappings for the original workflow scheme, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
  record workflow-scheme-original-issue-type-mappings {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about the default workflow.
  record default-workflow {
    /// Whether a draft workflow scheme is created or updated when updating an active workflow scheme. The draft is updated with the new default workflow. Defaults to `false`.
    update-draft-if-needed: option<bool>,
    /// The name of the workflow to set as the default workflow.
    workflow: string
  }

  /// Details about the mapping between an issue type and a workflow.
  record issue-type-workflow-mapping {
    /// The ID of the issue type. Not required if updating the issue type-workflow mapping.
    issue-type: option<string>,
    /// Set to true to create or update the draft of a workflow scheme and update the mapping in the draft, when the workflow scheme cannot be edited. Defaults to `false`. Only applicable when updating the workflow-issue types mapping.
    update-draft-if-needed: option<bool>,
    /// The name of the workflow.
    workflow: option<string>
  }

  /// Details about the mapping between issue types and a workflow.
  record issue-types-workflow-mapping {
    /// Whether the workflow is the default workflow for the workflow scheme.
    default-mapping: option<bool>,
    /// The list of issue type IDs.
    issue-types: option<list<string>>,
    /// Whether a draft workflow scheme is created or updated when updating an active workflow scheme. The draft is updated with the new workflow-issue types mapping. Defaults to `false`.
    update-draft-if-needed: option<bool>,
    /// The name of the workflow. Optional if updating the workflow-issue types mapping.
    workflow: option<string>
  }

  variant get-all-workflow-schemes-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-workflow-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-workflow-scheme-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-workflow-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-workflow-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-default-workflow-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-default-workflow-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-default-workflow-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-workflow-scheme-issue-type-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-workflow-scheme-issue-type-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-workflow-scheme-issue-type-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-workflow-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-workflow-mapping-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-workflow-mapping-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all workflow schemes
  record get-all-workflow-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-all-workflow-schemes: func(params: get-all-workflow-schemes-params) -> result<page-bean-workflow-scheme, get-all-workflow-schemes-error>;

  /// Create workflow scheme
  record create-workflow-scheme-params {
    /// The name of the default workflow for the workflow scheme. The default workflow has *All Unassigned Issue Types* assigned to it in Jira. If `defaultWorkflow` is not specified when creating a workflow scheme, it is set to *Jira Workflow (jira)*.
    default-workflow: option<string>,
    /// The description of the workflow scheme.
    description: option<string>,
    /// Whether the workflow scheme is a draft or not.
    draft: option<bool>,
    /// The ID of the workflow scheme.
    id: option<s64>,
    /// The issue type to workflow mappings, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
    issue-type-mappings: option<workflow-scheme-issue-type-mappings>,
    /// The issue types available in Jira.
    issue-types: option<workflow-scheme-issue-types>,
    /// The date-time that the draft workflow scheme was last modified. A modification is a change to the issue type-project mappings only. This property does not apply to non-draft workflows.
    last-modified: option<string>,
    /// The user that last modified the draft workflow scheme. A modification is a change to the issue type-project mappings only. This property does not apply to non-draft workflows.
    last-modified-user: option<user>,
    /// The name of the workflow scheme. The name must be unique. The maximum length is 255 characters. Required when creating a workflow scheme.
    name: option<string>,
    /// For draft workflow schemes, this property is the name of the default workflow for the original workflow scheme. The default workflow has *All Unassigned Issue Types* assigned to it in Jira.
    original-default-workflow: option<string>,
    /// For draft workflow schemes, this property is the issue type to workflow mappings for the original workflow scheme, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
    original-issue-type-mappings: option<workflow-scheme-original-issue-type-mappings>,
    self: option<string>,
    /// Whether to create or update a draft workflow scheme when updating an active workflow scheme. An active workflow scheme is a workflow scheme that is used by at least one project. The following examples show how this property works:
    /// 
    update-draft-if-needed: option<bool>
  }
  create-workflow-scheme: func(params: create-workflow-scheme-params) -> result<workflow-scheme, create-workflow-scheme-error>;

  /// Get workflow scheme
  record get-workflow-scheme-params {
    /// The ID of the workflow scheme. Find this ID by editing the desired workflow scheme in Jira. The ID is shown in the URL as `schemeId`. For example, *schemeId=10301*.
    id: string,
    /// Returns the workflow scheme's draft rather than scheme itself, if set to true. If the workflow scheme does not have a draft, then the workflow scheme is returned.
    return-draft-if-exists: option<bool>
  }
  get-workflow-scheme: func(params: get-workflow-scheme-params) -> result<workflow-scheme, get-workflow-scheme-error>;

  /// Update workflow scheme
  record update-workflow-scheme-params {
    /// The ID of the workflow scheme. Find this ID by editing the desired workflow scheme in Jira. The ID is shown in the URL as `schemeId`. For example, *schemeId=10301*.
    id: string,
    /// The name of the default workflow for the workflow scheme. The default workflow has *All Unassigned Issue Types* assigned to it in Jira. If `defaultWorkflow` is not specified when creating a workflow scheme, it is set to *Jira Workflow (jira)*.
    default-workflow: option<string>,
    /// The description of the workflow scheme.
    description: option<string>,
    /// Whether the workflow scheme is a draft or not.
    draft: option<bool>,
    /// The ID of the workflow scheme.
    id-v2: option<s64>,
    /// The issue type to workflow mappings, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
    issue-type-mappings: option<workflow-scheme-issue-type-mappings>,
    /// The issue types available in Jira.
    issue-types: option<workflow-scheme-issue-types>,
    /// The date-time that the draft workflow scheme was last modified. A modification is a change to the issue type-project mappings only. This property does not apply to non-draft workflows.
    last-modified: option<string>,
    /// The user that last modified the draft workflow scheme. A modification is a change to the issue type-project mappings only. This property does not apply to non-draft workflows.
    last-modified-user: option<user>,
    /// The name of the workflow scheme. The name must be unique. The maximum length is 255 characters. Required when creating a workflow scheme.
    name: option<string>,
    /// For draft workflow schemes, this property is the name of the default workflow for the original workflow scheme. The default workflow has *All Unassigned Issue Types* assigned to it in Jira.
    original-default-workflow: option<string>,
    /// For draft workflow schemes, this property is the issue type to workflow mappings for the original workflow scheme, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
    original-issue-type-mappings: option<workflow-scheme-original-issue-type-mappings>,
    self: option<string>,
    /// Whether to create or update a draft workflow scheme when updating an active workflow scheme. An active workflow scheme is a workflow scheme that is used by at least one project. The following examples show how this property works:
    /// 
    update-draft-if-needed: option<bool>
  }
  update-workflow-scheme: func(params: update-workflow-scheme-params) -> result<workflow-scheme, update-workflow-scheme-error>;

  /// Delete workflow scheme
  record delete-workflow-scheme-params {
    /// The ID of the workflow scheme. Find this ID by editing the desired workflow scheme in Jira. The ID is shown in the URL as `schemeId`. For example, *schemeId=10301*.
    id: string
  }
  delete-workflow-scheme: func(params: delete-workflow-scheme-params) -> result<string, delete-workflow-scheme-error>;

  /// Get default workflow
  record get-default-workflow-params {
    /// The ID of the workflow scheme.
    id: string,
    /// Set to `true` to return the default workflow for the workflow scheme's draft rather than scheme itself. If the workflow scheme does not have a draft, then the default workflow for the workflow scheme is returned.
    return-draft-if-exists: option<bool>
  }
  get-default-workflow: func(params: get-default-workflow-params) -> result<default-workflow, get-default-workflow-error>;

  /// Update default workflow
  record update-default-workflow-params {
    /// The ID of the workflow scheme.
    id: string,
    /// Whether a draft workflow scheme is created or updated when updating an active workflow scheme. The draft is updated with the new default workflow. Defaults to `false`.
    update-draft-if-needed: option<bool>,
    /// The name of the workflow to set as the default workflow.
    workflow: string
  }
  update-default-workflow: func(params: update-default-workflow-params) -> result<workflow-scheme, update-default-workflow-error>;

  /// Delete default workflow
  record delete-default-workflow-params {
    /// The ID of the workflow scheme.
    id: string,
    /// Set to true to create or update the draft of a workflow scheme and delete the mapping from the draft, when the workflow scheme cannot be edited. Defaults to `false`.
    update-draft-if-needed: option<bool>
  }
  delete-default-workflow: func(params: delete-default-workflow-params) -> result<workflow-scheme, delete-default-workflow-error>;

  /// Get workflow for issue type in workflow scheme
  record get-workflow-scheme-issue-type-params {
    /// The ID of the workflow scheme.
    id: string,
    /// The ID of the issue type.
    issue-type: string,
    /// Returns the mapping from the workflow scheme's draft rather than the workflow scheme, if set to true. If no draft exists, the mapping from the workflow scheme is returned.
    return-draft-if-exists: option<bool>
  }
  get-workflow-scheme-issue-type: func(params: get-workflow-scheme-issue-type-params) -> result<issue-type-workflow-mapping, get-workflow-scheme-issue-type-error>;

  /// Set workflow for issue type in workflow scheme
  record set-workflow-scheme-issue-type-params {
    /// The ID of the workflow scheme.
    id: string,
    /// The ID of the issue type.
    issue-type: string,
    /// The ID of the issue type. Not required if updating the issue type-workflow mapping.
    issue-type-v2: option<string>,
    /// Set to true to create or update the draft of a workflow scheme and update the mapping in the draft, when the workflow scheme cannot be edited. Defaults to `false`. Only applicable when updating the workflow-issue types mapping.
    update-draft-if-needed: option<bool>,
    /// The name of the workflow.
    workflow: option<string>
  }
  set-workflow-scheme-issue-type: func(params: set-workflow-scheme-issue-type-params) -> result<workflow-scheme, set-workflow-scheme-issue-type-error>;

  /// Delete workflow for issue type in workflow scheme
  record delete-workflow-scheme-issue-type-params {
    /// The ID of the workflow scheme.
    id: string,
    /// The ID of the issue type.
    issue-type: string,
    /// Set to true to create or update the draft of a workflow scheme and update the mapping in the draft, when the workflow scheme cannot be edited. Defaults to `false`.
    update-draft-if-needed: option<bool>
  }
  delete-workflow-scheme-issue-type: func(params: delete-workflow-scheme-issue-type-params) -> result<workflow-scheme, delete-workflow-scheme-issue-type-error>;

  /// Get issue types for workflows in workflow scheme
  record get-workflow-params {
    /// The ID of the workflow scheme.
    id: string,
    /// The name of a workflow in the scheme. Limits the results to the workflow-issue type mapping for the specified workflow.
    workflow-name: option<string>,
    /// Returns the mapping from the workflow scheme's draft rather than the workflow scheme, if set to true. If no draft exists, the mapping from the workflow scheme is returned.
    return-draft-if-exists: option<bool>
  }
  get-workflow: func(params: get-workflow-params) -> result<issue-types-workflow-mapping, get-workflow-error>;

  /// Set issue types for workflow in workflow scheme
  record update-workflow-mapping-params {
    /// The ID of the workflow scheme.
    id: string,
    /// The name of the workflow.
    workflow-name: string,
    /// Whether the workflow is the default workflow for the workflow scheme.
    default-mapping: option<bool>,
    /// The list of issue type IDs.
    issue-types: option<list<string>>,
    /// Whether a draft workflow scheme is created or updated when updating an active workflow scheme. The draft is updated with the new workflow-issue types mapping. Defaults to `false`.
    update-draft-if-needed: option<bool>,
    /// The name of the workflow. Optional if updating the workflow-issue types mapping.
    workflow: option<string>
  }
  update-workflow-mapping: func(params: update-workflow-mapping-params) -> result<workflow-scheme, update-workflow-mapping-error>;

  /// Delete issue types for workflow in workflow scheme
  record delete-workflow-mapping-params {
    /// The ID of the workflow scheme.
    id: string,
    /// The name of the workflow.
    workflow-name: string,
    /// Set to true to create or update the draft of a workflow scheme and delete the mapping from the draft, when the workflow scheme cannot be edited. Defaults to `false`.
    update-draft-if-needed: option<bool>
  }
  delete-workflow-mapping: func(params: delete-workflow-mapping-params) -> result<string, delete-workflow-mapping-error>;

}

interface workflow-scheme-project-associations {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  /// A container for a list of workflow schemes together with the projects they are associated with.
  record container-of-workflow-scheme-associations {
    /// A list of workflow schemes together with projects they are associated with.
    values: list<workflow-scheme-associations>
  }

  /// A workflow scheme along with a list of projects that use it.
  record workflow-scheme-associations {
    /// The list of projects that use the workflow scheme.
    project-ids: list<string>,
    /// The workflow scheme.
    workflow-scheme: workflow-scheme
  }

  /// Details about a workflow scheme.
  record workflow-scheme {
    /// The name of the default workflow for the workflow scheme. The default workflow has *All Unassigned Issue Types* assigned to it in Jira. If `defaultWorkflow` is not specified when creating a workflow scheme, it is set to *Jira Workflow (jira)*.
    default-workflow: option<string>,
    /// The description of the workflow scheme.
    description: option<string>,
    /// Whether the workflow scheme is a draft or not.
    draft: option<bool>,
    /// The ID of the workflow scheme.
    id: option<s64>,
    /// The issue type to workflow mappings, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
    issue-type-mappings: option<workflow-scheme-issue-type-mappings>,
    /// The issue types available in Jira.
    issue-types: option<workflow-scheme-issue-types>,
    /// The date-time that the draft workflow scheme was last modified. A modification is a change to the issue type-project mappings only. This property does not apply to non-draft workflows.
    last-modified: option<string>,
    /// The user that last modified the draft workflow scheme. A modification is a change to the issue type-project mappings only. This property does not apply to non-draft workflows.
    last-modified-user: option<user>,
    /// The name of the workflow scheme. The name must be unique. The maximum length is 255 characters. Required when creating a workflow scheme.
    name: option<string>,
    /// For draft workflow schemes, this property is the name of the default workflow for the original workflow scheme. The default workflow has *All Unassigned Issue Types* assigned to it in Jira.
    original-default-workflow: option<string>,
    /// For draft workflow schemes, this property is the issue type to workflow mappings for the original workflow scheme, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
    original-issue-type-mappings: option<workflow-scheme-original-issue-type-mappings>,
    self: option<string>,
    /// Whether to create or update a draft workflow scheme when updating an active workflow scheme. An active workflow scheme is a workflow scheme that is used by at least one project. The following examples show how this property works:
    /// 
    update-draft-if-needed: option<bool>
  }

  /// The issue type to workflow mappings, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
  record workflow-scheme-issue-type-mappings {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The issue types available in Jira.
  record workflow-scheme-issue-types {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// For draft workflow schemes, this property is the issue type to workflow mappings for the original workflow scheme, where each mapping is an issue type ID and workflow name pair. Note that an issue type can only be mapped to one workflow in a workflow scheme.
  record workflow-scheme-original-issue-type-mappings {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-workflow-scheme-project-associations-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant assign-scheme-to-project-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get workflow scheme project associations
  record get-workflow-scheme-project-associations-params {
    /// The ID of a project to return the workflow schemes for. To include multiple projects, provide an ampersand-Jim: oneseparated list. For example, `projectId=10000&projectId=10001`.
    project-id: list<s64>
  }
  get-workflow-scheme-project-associations: func(params: get-workflow-scheme-project-associations-params) -> result<container-of-workflow-scheme-associations, get-workflow-scheme-project-associations-error>;

  /// Assign workflow scheme to project
  record assign-scheme-to-project-params {
    /// The ID of the project.
    project-id: string,
    /// The ID of the workflow scheme. If the workflow scheme ID is `null`, the operation assigns the default workflow scheme.
    workflow-scheme-id: option<string>
  }
  assign-scheme-to-project: func(params: assign-scheme-to-project-params) -> result<string, assign-scheme-to-project-error>;

}

