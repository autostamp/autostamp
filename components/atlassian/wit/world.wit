    board-id: option<s64>,
    board-name: option<string>,
    project-key: option<string>,
    project-type: option<string>,
    queue-category: option<string>,
    queue-id: option<s64>,
    queue-name: option<string>,
    simple-board: option<bool>,
    simplified: option<bool>,
    url: option<string>
