  /// Get all projects
  record get-all-projects-params {
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expanded options include:
    /// 
    expand: option<string>,
    /// Returns the user's most recently accessed projects. You may specify the number of results to return up to a maximum of 20. If access is anonymous, then the recently accessed projects are based on the current HTTP session.
    recent: option<s32>,
    /// A list of project properties to return for the project. This parameter accepts a comma-separated list.
    properties: option<list<string>>
  }
  get-all-projects: func(params: get-all-projects-params) -> result<list<project>, get-all-projects-error>;

  /// Create project
  record create-project-params {
    /// The default assignee when creating issues for this project.
    assignee-type: option<project-assignee-type-enum>,
    /// An integer value for the project's avatar.
    avatar-id: option<s64>,
    /// The ID of the project's category. A complete list of category IDs is found using the [Get all project categories](#api-rest-api-3-projectCategory-get) operation.
    category-id: option<s64>,
    /// A brief description of the project.
    description: option<string>,
    /// The ID of the field configuration scheme for the project. Use the [Get all field configuration schemes](#api-rest-api-3-fieldconfigurationscheme-get) operation to get a list of field configuration scheme IDs. If you specify the field configuration scheme you cannot specify the project template key.
    field-configuration-scheme: option<s64>,
    /// The ID of the issue security scheme for the project, which enables you to control who can and cannot view issues. Use the [Get issue security schemes](#api-rest-api-3-issuesecurityschemes-get) resource to get all issue security scheme IDs.
    issue-security-scheme: option<s64>,
    /// The ID of the issue type scheme for the project. Use the [Get all issue type schemes](#api-rest-api-3-issuetypescheme-get) operation to get a list of issue type scheme IDs. If you specify the issue type scheme you cannot specify the project template key.
    issue-type-scheme: option<s64>,
    /// The ID of the issue type screen scheme for the project. Use the [Get all issue type screen schemes](#api-rest-api-3-issuetypescreenscheme-get) operation to get a list of issue type screen scheme IDs. If you specify the issue type screen scheme you cannot specify the project template key.
    issue-type-screen-scheme: option<s64>,
    /// Project keys must be unique and start with an uppercase letter followed by one or more uppercase alphanumeric characters. The maximum length is 10 characters.
    key: string,
    /// This parameter is deprecated because of privacy changes. Use `leadAccountId` instead. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details. The user name of the project lead. Either `lead` or `leadAccountId` must be set when creating a project. Cannot be provided with `leadAccountId`.
    lead: option<string>,
    /// The account ID of the project lead. Either `lead` or `leadAccountId` must be set when creating a project. Cannot be provided with `lead`.
    lead-account-id: option<string>,
    /// The name of the project.
    name: string,
    /// The ID of the notification scheme for the project. Use the [Get notification schemes](#api-rest-api-3-notificationscheme-get) resource to get a list of notification scheme IDs.
    notification-scheme: option<s64>,
    /// The ID of the permission scheme for the project. Use the [Get all permission schemes](#api-rest-api-3-permissionscheme-get) resource to see a list of all permission scheme IDs.
    permission-scheme: option<s64>,
    /// A predefined configuration for a project. The type of the `projectTemplateKey` must match with the type of the `projectTypeKey`.
    project-template-key: option<create-project-details-project-template-key-enum>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes), which defines the application-specific feature set. If you don't specify the project template you have to specify the project type.
    project-type-key: option<project-details-project-type-key-enum>,
    /// A link to information about this project, such as project documentation
    url: option<string>,
    /// The ID of the workflow scheme for the project. Use the [Get all workflow schemes](#api-rest-api-3-workflowscheme-get) operation to get a list of workflow scheme IDs. If you specify the workflow scheme you cannot specify the project template key.
    workflow-scheme: option<s64>
  }
  create-project: func(params: create-project-params) -> result<project-identifiers, create-project-error>;

  /// Get recent projects
  record get-recent-params {
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expanded options include:
    /// 
    expand: option<string>,
    /// EXPERIMENTAL. A list of project properties to return for the project. This parameter accepts a comma-separated list. Invalid property names are ignored.
    properties: option<list<string-list>>
  }
  get-recent: func(params: get-recent-params) -> result<list<project>, get-recent-error>;

  /// Get projects paginated
  record search-projects-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// [Order](#ordering) the results by a field.
    /// 
    order-by: option<search-projects-order-by-enum>,
    /// The project IDs to filter the results by. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`. Up to 50 project IDs can be provided.
    id: option<list<s64>>,
    /// The project keys to filter the results by. To include multiple keys, provide an ampersand-separated list. For example, `keys=PA&keys=PB`. Up to 50 project keys can be provided.
    keys: option<list<string>>,
    /// Filter the results using a literal string. Projects with a matching `key` or `name` are returned (case insensitive).
    query: option<string>,
    /// Orders results by the [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes). This parameter accepts a comma-separated list. Valid values are `business`, `service_desk`, and `software`.
    type-key: option<string>,
    /// The ID of the project's category. A complete list of category IDs is found using the [Get all project categories](#api-rest-api-3-projectCategory-get) operation.
    category-id: option<s64>,
    /// Filter results by projects for which the user can:
    /// 
    action: option<search-projects-action-enum>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expanded options include:
    /// 
    expand: option<string>,
    /// EXPERIMENTAL. Filter results by project status:
    /// 
    status: option<list<search-projects-status-item-enum>>,
    /// EXPERIMENTAL. A list of project properties to return for the project. This parameter accepts a comma-separated list.
    properties: option<list<string-list>>,
    /// EXPERIMENTAL. A query string used to search properties. The query string cannot be specified using a JSON object. For example, to search for the value of `nested` from `{"something":{"nested":1,"other":2}}` use `[thepropertykey].something.nested=1`. Note that the propertyQuery key is enclosed in square brackets to enable searching where the propertyQuery key includes dot (.) or equals (=) characters. Note that `thepropertykey` is only returned when included in `properties`.
    property-query: option<string>
  }
  search-projects: func(params: search-projects-params) -> result<page-bean-project, search-projects-error>;

  /// Get project
  record get-project-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Note that the project description, issue types, and project lead are included in all responses by default. Expand options include:
    /// 
    expand: option<string>,
    /// A list of project properties to return for the project. This parameter accepts a comma-separated list.
    properties: option<list<string>>
  }
  get-project: func(params: get-project-params) -> result<project, get-project-error>;

  /// Update project
  record update-project-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Note that the project description, issue types, and project lead are included in all responses by default. Expand options include:
    /// 
    expand: option<string>,
    /// The default assignee when creating issues for this project.
    assignee-type: option<project-assignee-type-enum>,
    /// An integer value for the project's avatar.
    avatar-id: option<s64>,
    /// The ID of the project's category. A complete list of category IDs is found using the [Get all project categories](#api-rest-api-3-projectCategory-get) operation. To remove the project category from the project, set the value to `-1.`
    category-id: option<s64>,
    /// A brief description of the project.
    description: option<string>,
    /// The ID of the issue security scheme for the project, which enables you to control who can and cannot view issues. Use the [Get issue security schemes](#api-rest-api-3-issuesecurityschemes-get) resource to get all issue security scheme IDs.
    issue-security-scheme: option<s64>,
    /// Project keys must be unique and start with an uppercase letter followed by one or more uppercase alphanumeric characters. The maximum length is 10 characters.
    key: option<string>,
    /// This parameter is deprecated because of privacy changes. Use `leadAccountId` instead. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details. The user name of the project lead. Cannot be provided with `leadAccountId`.
    lead: option<string>,
    /// The account ID of the project lead. Cannot be provided with `lead`.
    lead-account-id: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The ID of the notification scheme for the project. Use the [Get notification schemes](#api-rest-api-3-notificationscheme-get) resource to get a list of notification scheme IDs.
    notification-scheme: option<s64>,
    /// The ID of the permission scheme for the project. Use the [Get all permission schemes](#api-rest-api-3-permissionscheme-get) resource to see a list of all permission scheme IDs.
    permission-scheme: option<s64>,
    /// A link to information about this project, such as project documentation
    url: option<string>
  }
  update-project: func(params: update-project-params) -> result<project, update-project-error>;

  /// Delete project
  record delete-project-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// Whether this project is placed in the Jira recycle bin where it will be available for restoration.
    enable-undo: option<bool>
  }
  delete-project: func(params: delete-project-params) -> result<string, delete-project-error>;

  /// Archive project
  record archive-project-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  archive-project: func(params: archive-project-params) -> result<string, archive-project-error>;

  /// Delete project asynchronously
  record delete-project-asynchronously-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  delete-project-asynchronously: func(params: delete-project-asynchronously-params) -> result<string, delete-project-asynchronously-error>;

  /// Restore deleted or archived project
  record restore-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  restore: func(params: restore-params) -> result<project, restore-error>;

  /// Get all statuses for project
  record get-all-statuses-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  get-all-statuses: func(params: get-all-statuses-params) -> result<list<issue-type-with-status>, get-all-statuses-error>;

  /// Update project type
  record update-project-type-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The key of the new project type.
    new-project-type-key: string
  }
  update-project-type: func(params: update-project-type-params) -> result<project, update-project-type-error>;

  /// Get project issue type hierarchy
  record get-hierarchy-params {
    /// The ID of the project.
    project-id: string
  }
  get-hierarchy: func(params: get-hierarchy-params) -> result<project-issue-type-hierarchy, get-hierarchy-error>;

  /// Get project notification scheme
  record get-notification-scheme-for-project-params {
    /// The project ID or project key (case sensitive).
    project-key-or-id: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-notification-scheme-for-project: func(params: get-notification-scheme-for-project-params) -> result<notification-scheme, get-notification-scheme-for-project-error>;

}

interface project-types {
  /// Details about a project type.
  record project-type {
    /// The color of the project type.
    color: option<string>,
    /// The key of the project type's description.
    description-i18n-key: option<string>,
    /// The formatted key of the project type.
    formatted-key: option<string>,
    /// The icon of the project type.
    icon: option<string>,
    /// The key of the project type.
    key: option<string>
  }

  variant get-all-project-types-error {
    unauthorized(string),
    other(string)
  }

  variant get-project-type-by-key-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-accessible-project-type-by-key-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get all project types
  get-all-project-types: func() -> result<list<project-type>, get-all-project-types-error>;

  /// Get licensed project types
  get-all-accessible-project-types: func() -> result<list<project-type>, string>;

  /// Get project type by key
  record get-project-type-by-key-params {
    /// The key of the project type.
    project-type-key: string
  }
  get-project-type-by-key: func(params: get-project-type-by-key-params) -> result<project-type, get-project-type-by-key-error>;

  /// Get accessible project type by key
  record get-accessible-project-type-by-key-params {
    /// The key of the project type.
    project-type-key: string
  }
  get-accessible-project-type-by-key: func(params: get-accessible-project-type-by-key-params) -> result<project-type, get-accessible-project-type-by-key-error>;

}

interface project-avatars {
  /// Details of an avatar.
  record avatar {
    /// The file name of the avatar icon. Returned for system avatars.
    file-name: option<string>,
    /// The ID of the avatar.
    id: string,
    /// Whether the avatar can be deleted.
    is-deletable: option<bool>,
    /// Whether the avatar is used in Jira. For example, shown as a project's avatar.
    is-selected: option<bool>,
    /// Whether the avatar is a system avatar.
    is-system-avatar: option<bool>,
    /// The owner of the avatar. For a system avatar the owner is null (and nothing is returned). For non-system avatars this is the appropriate identifier, such as the ID for a project or the account ID for a user.
    owner: option<string>,
    /// The list of avatar icon URLs.
    urls: option<avatar-urls>
  }

  /// The list of avatar icon URLs.
  record avatar-urls {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List of project avatars.
  record project-avatars {
    /// List of avatars added to Jira. These avatars may be deleted.
    custom: option<list<avatar>>,
    /// List of avatars included with Jira. These avatars cannot be deleted.
    system: option<list<avatar>>
  }

  variant update-project-avatar-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-project-avatar-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-project-avatar-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-all-project-avatars-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Set project avatar
  record update-project-avatar-params {
    /// The ID or (case-sensitive) key of the project.
    project-id-or-key: string,
    /// The file name of the avatar icon. Returned for system avatars.
    file-name: option<string>,
    /// The ID of the avatar.
    id: string,
    /// Whether the avatar can be deleted.
    is-deletable: option<bool>,
    /// Whether the avatar is used in Jira. For example, shown as a project's avatar.
    is-selected: option<bool>,
    /// Whether the avatar is a system avatar.
    is-system-avatar: option<bool>,
    /// The owner of the avatar. For a system avatar the owner is null (and nothing is returned). For non-system avatars this is the appropriate identifier, such as the ID for a project or the account ID for a user.
    owner: option<string>,
    /// The list of avatar icon URLs.
    urls: option<avatar-urls>
  }
  update-project-avatar: func(params: update-project-avatar-params) -> result<string, update-project-avatar-error>;

  /// Delete project avatar
  record delete-project-avatar-params {
    /// The project ID or (case-sensitive) key.
    project-id-or-key: string,
    /// The ID of the avatar.
    id: string
  }
  delete-project-avatar: func(params: delete-project-avatar-params) -> result<string, delete-project-avatar-error>;

  /// Load project avatar
  record create-project-avatar-params {
    /// The ID or (case-sensitive) key of the project.
    project-id-or-key: string,
    /// The X coordinate of the top-left corner of the crop region.
    x: option<s32>,
    /// The Y coordinate of the top-left corner of the crop region.
    y: option<s32>,
    /// The length of each side of the crop region.
    size: option<s32>,
    body: string
  }
  create-project-avatar: func(params: create-project-avatar-params) -> result<avatar, create-project-avatar-error>;

  /// Get all project avatars
  record get-all-project-avatars-params {
    /// The ID or (case-sensitive) key of the project.
    project-id-or-key: string
  }
  get-all-project-avatars: func(params: get-all-project-avatars-params) -> result<project-avatars, get-all-project-avatars-error>;

}

interface project-features {
  enum project-feature-state-enum {
    enabled,
    disabled,
    coming-soon,
  }

  /// The list of features on a project.
  record container-for-project-features {
    /// The project features.
    features: option<list<project-feature>>
  }

  /// Details of a project feature.
  record project-feature {
    /// The key of the feature.
    feature: option<string>,
    /// URI for the image representing the feature.
    image-uri: option<string>,
    /// Localized display description for the feature.
    localised-description: option<string>,
    /// Localized display name for the feature.
    localised-name: option<string>,
    /// List of keys of the features required to enable the feature.
    prerequisites: option<list<string>>,
    /// The ID of the project.
    project-id: option<s64>,
    /// The state of the feature. When updating the state of a feature, only ENABLED and DISABLED are supported. Responses can contain all values
    state: option<project-feature-state-enum>,
    /// Whether the state of the feature can be updated.
    toggle-locked: option<bool>
  }

  variant get-features-for-project-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant toggle-feature-for-project-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get project features
  record get-features-for-project-params {
    /// The ID or (case-sensitive) key of the project.
    project-id-or-key: string
  }
  get-features-for-project: func(params: get-features-for-project-params) -> result<container-for-project-features, get-features-for-project-error>;

  /// Set project feature state
  record toggle-feature-for-project-params {
    /// The ID or (case-sensitive) key of the project.
    project-id-or-key: string,
    /// The key of the feature.
    feature-key: string,
    /// The feature state.
    state: option<project-feature-state-enum>
  }
  toggle-feature-for-project: func(params: toggle-feature-for-project-params) -> result<container-for-project-features, toggle-feature-for-project-error>;

}

interface project-properties {
  /// List of property keys.
  record property-keys {
    /// Property key details.
    keys: option<list<property-key>>
  }

  /// Property key details.
  record property-key {
    /// The key of the property.
    key: option<string>,
    /// The URL of the property.
    self: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  variant get-project-property-keys-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-project-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-project-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-project-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get project property keys
  record get-project-property-keys-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  get-project-property-keys: func(params: get-project-property-keys-params) -> result<property-keys, get-project-property-keys-error>;

  /// Get project property
  record get-project-property-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The project property key. Use [Get project property keys](#api-rest-api-3-project-projectIdOrKey-properties-get) to get a list of all project property keys.
    property-key: string
  }
  get-project-property: func(params: get-project-property-params) -> result<entity-property, get-project-property-error>;

  /// Set project property
  record set-project-property-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The key of the project property. The maximum length is 255 characters.
    property-key: string,
    body: string
  }
  set-project-property: func(params: set-project-property-params) -> result<string, set-project-property-error>;

  /// Delete project property
  record delete-project-property-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The project property key. Use [Get project property keys](#api-rest-api-3-project-projectIdOrKey-properties-get) to get a list of all project property keys.
    property-key: string
  }
  delete-project-property: func(params: delete-project-property-params) -> result<string, delete-project-property-error>;

}

interface project-roles {
  enum role-actor-type-op-enum {
    atlassian-group-role-actor,
    atlassian-user-role-actor,
  }

  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  record get-project-roles-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about the roles in a project.
  record project-role {
    /// The list of users who act in this role.
    actors: option<list<role-actor>>,
    /// Whether this role is the admin role for the project.
    admin: option<bool>,
    /// Whether the calling user is part of this role.
    current-user-role: option<bool>,
    /// Whether this role is the default role for the project
    default: option<bool>,
    /// The description of the project role.
    description: option<string>,
    /// The ID of the project role.
    id: option<s64>,
    /// The name of the project role.
    name: option<string>,
    /// Whether the roles are configurable for this project.
    role-configurable: option<bool>,
    /// The scope of the role. Indicated for roles associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
    scope: option<scope>,
    /// The URL the project role details.
    self: option<string>,
    /// The translated name of the project role.
    translated-name: option<string>
  }

  /// Details about a user assigned to a project role.
  record role-actor {
    actor-group: option<project-role-group>,
    actor-user: option<project-role-user>,
    /// The avatar of the role actor.
    avatar-url: option<string>,
    /// The display name of the role actor. For users, depending on the user’s privacy setting, this may return an alternative value for the user's name.
    display-name: option<string>,
    /// The ID of the role actor.
    id: option<s64>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The type of role actor.
    type-op: option<role-actor-type-op-enum>
  }

  /// Details of the group associated with the role.
  record project-role-group {
    /// The display name of the group.
    display-name: option<string>,
    /// The ID of the group.
    group-id: option<string>,
    /// The name of the group. As a group's name can change, use of `groupId` is recommended to identify the group.
    name: option<string>
  }

  /// Details of the user associated with the role.
  record project-role-user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Returns *unknown* if the record is deleted and corrupted, for example, as the result of a server import.
    account-id: option<string>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// Details about a project role.
  record project-role-details {
    /// Whether this role is the admin role for the project.
    admin: option<bool>,
    /// Whether this role is the default role for the project.
    default: option<bool>,
    /// The description of the project role.
    description: option<string>,
    /// The ID of the project role.
    id: option<s64>,
    /// The name of the project role.
    name: option<string>,
    /// Whether the roles are configurable for this project.
    role-configurable: option<bool>,
    /// The scope of the role. Indicated for roles associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
    scope: option<scope>,
    /// The URL the project role details.
    self: option<string>,
    /// The translated name of the project role.
    translated-name: option<string>
  }

  variant get-project-roles-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-project-role-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-project-role-details-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-all-project-roles-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-project-role-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    conflict(string),
    other(string)
  }

  variant get-project-role-by-id-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant partial-update-project-role-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant fully-update-project-role-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-project-role-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  /// Get project roles for project
  record get-project-roles-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  get-project-roles: func(params: get-project-roles-params) -> result<get-project-roles-response, get-project-roles-error>;

  /// Get project role for project
  record get-project-role-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// Exclude inactive users.
    exclude-inactive-users: option<bool>
  }
  get-project-role: func(params: get-project-role-params) -> result<project-role, get-project-role-error>;

  /// Get project role details
  record get-project-role-details-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// Whether the roles should be filtered to include only those the user is assigned to.
    current-member: option<bool>,
    exclude-connect-addons: option<bool>
  }
  get-project-role-details: func(params: get-project-role-details-params) -> result<list<project-role-details>, get-project-role-details-error>;

  /// Get all project roles
  get-all-project-roles: func() -> result<list<project-role>, get-all-project-roles-error>;

  /// Create project role
  record create-project-role-params {
    /// A description of the project role. Required when fully updating a project role. Optional when creating or partially updating a project role.
    description: option<string>,
    /// The name of the project role. Must be unique. Cannot begin or end with whitespace. The maximum length is 255 characters. Required when creating a project role. Optional when partially updating a project role.
    name: option<string>
  }
  create-project-role: func(params: create-project-role-params) -> result<project-role, create-project-role-error>;

  /// Get project role by ID
  record get-project-role-by-id-params {
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string
  }
  get-project-role-by-id: func(params: get-project-role-by-id-params) -> result<project-role, get-project-role-by-id-error>;

  /// Partial update project role
  record partial-update-project-role-params {
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// A description of the project role. Required when fully updating a project role. Optional when creating or partially updating a project role.
    description: option<string>,
    /// The name of the project role. Must be unique. Cannot begin or end with whitespace. The maximum length is 255 characters. Required when creating a project role. Optional when partially updating a project role.
    name: option<string>
  }
  partial-update-project-role: func(params: partial-update-project-role-params) -> result<project-role, partial-update-project-role-error>;

  /// Fully update project role
  record fully-update-project-role-params {
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// A description of the project role. Required when fully updating a project role. Optional when creating or partially updating a project role.
    description: option<string>,
    /// The name of the project role. Must be unique. Cannot begin or end with whitespace. The maximum length is 255 characters. Required when creating a project role. Optional when partially updating a project role.
    name: option<string>
  }
  fully-update-project-role: func(params: fully-update-project-role-params) -> result<project-role, fully-update-project-role-error>;

  /// Delete project role
  record delete-project-role-params {
    /// The ID of the project role to delete. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// The ID of the project role that will replace the one being deleted.
    swap: option<s64>
  }
  delete-project-role: func(params: delete-project-role-params) -> result<string, delete-project-role-error>;

}

interface project-role-actors {
  enum role-actor-type-op-enum {
    atlassian-group-role-actor,
    atlassian-user-role-actor,
  }

  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  /// Details about the roles in a project.
  record project-role {
    /// The list of users who act in this role.
    actors: option<list<role-actor>>,
    /// Whether this role is the admin role for the project.
    admin: option<bool>,
    /// Whether the calling user is part of this role.
    current-user-role: option<bool>,
    /// Whether this role is the default role for the project
    default: option<bool>,
    /// The description of the project role.
    description: option<string>,
    /// The ID of the project role.
    id: option<s64>,
    /// The name of the project role.
    name: option<string>,
    /// Whether the roles are configurable for this project.
    role-configurable: option<bool>,
    /// The scope of the role. Indicated for roles associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
    scope: option<scope>,
    /// The URL the project role details.
    self: option<string>,
    /// The translated name of the project role.
    translated-name: option<string>
  }

  /// Details about a user assigned to a project role.
  record role-actor {
    actor-group: option<project-role-group>,
    actor-user: option<project-role-user>,
    /// The avatar of the role actor.
    avatar-url: option<string>,
    /// The display name of the role actor. For users, depending on the user’s privacy setting, this may return an alternative value for the user's name.
    display-name: option<string>,
    /// The ID of the role actor.
    id: option<s64>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The type of role actor.
    type-op: option<role-actor-type-op-enum>
  }

  /// Details of the group associated with the role.
  record project-role-group {
    /// The display name of the group.
    display-name: option<string>,
    /// The ID of the group.
    group-id: option<string>,
    /// The name of the group. As a group's name can change, use of `groupId` is recommended to identify the group.
    name: option<string>
  }

  /// Details of the user associated with the role.
  record project-role-user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Returns *unknown* if the record is deleted and corrupted, for example, as the result of a server import.
    account-id: option<string>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// The actors to add to the project role.
  /// 
  /// Add groups using:
  /// 
  ///  *  `atlassian-group-role-actor` and a list of group names.
  ///  *  `atlassian-group-role-actor-id` and a list of group IDs.
  /// 
  /// As a group's name can change, use of `atlassian-group-role-actor-id` is recommended. For example, `"atlassian-group-role-actor-id":["eef79f81-0b89-4fca-a736-4be531a10869","77f6ab39-e755-4570-a6ae-2d7a8df0bcb8"]`.
  /// 
  /// Add users using `atlassian-user-role-actor` and a list of account IDs. For example, `"atlassian-user-role-actor":["12345678-9abc-def1-2345-6789abcdef12", "abcdef12-3456-789a-bcde-f123456789ab"]`.
  record update-bean-categorised-actors {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant add-actor-users-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant set-actors-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-actor-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant get-project-role-actors-for-role-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-project-role-actors-to-role-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-project-role-actors-from-role-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Add actors to project role
  record add-actor-users-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// The name of the group to add. This parameter cannot be used with the `groupId` parameter. As a group's name can change, use of `groupId` is recommended.
    group: option<list<string>>,
    /// The ID of the group to add. This parameter cannot be used with the `group` parameter.
    group-id: option<list<string>>,
    /// The user account ID of the user to add.
    user: option<list<string>>
  }
  add-actor-users: func(params: add-actor-users-params) -> result<project-role, add-actor-users-error>;

  /// Set actors for project role
  record set-actors-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// The actors to add to the project role.
    /// 
    categorised-actors: option<update-bean-categorised-actors>,
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id-v2: option<s64>
  }
  set-actors: func(params: set-actors-params) -> result<project-role, set-actors-error>;

  /// Delete actors from project role
  record delete-actor-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// The user account ID of the user to remove from the project role.
    user: option<string>,
    /// The name of the group to remove from the project role. This parameter cannot be used with the `groupId` parameter. As a group's name can change, use of `groupId` is recommended.
    group: option<string>,
    /// The ID of the group to remove from the project role. This parameter cannot be used with the `group` parameter.
    group-id: option<string>
  }
  delete-actor: func(params: delete-actor-params) -> result<string, delete-actor-error>;

  /// Get default actors for project role
  record get-project-role-actors-for-role-params {
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string
  }
  get-project-role-actors-for-role: func(params: get-project-role-actors-for-role-params) -> result<project-role, get-project-role-actors-for-role-error>;

  /// Add default actors to project role
  record add-project-role-actors-to-role-params {
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// The name of the group to add as a default actor. This parameter cannot be used with the `groupId` parameter. As a group's name can change,use of `groupId` is recommended. This parameter accepts a comma-separated list. For example, `"group":["project-admin", "jira-developers"]`.
    group: option<list<string>>,
    /// The ID of the group to add as a default actor. This parameter cannot be used with the `group` parameter This parameter accepts a comma-separated list. For example, `"groupId":["77f6ab39-e755-4570-a6ae-2d7a8df0bcb8", "0c011f85-69ed-49c4-a801-3b18d0f771bc"]`.
    group-id: option<list<string>>,
    /// The account IDs of the users to add as default actors. This parameter accepts a comma-separated list. For example, `"user":["5b10a2844c20165700ede21g", "5b109f2e9729b51b54dc274d"]`.
    user: option<list<string>>
  }
  add-project-role-actors-to-role: func(params: add-project-role-actors-to-role-params) -> result<project-role, add-project-role-actors-to-role-error>;

  /// Delete default actors from project role
  record delete-project-role-actors-from-role-params {
    /// The ID of the project role. Use [Get all project roles](#api-rest-api-3-role-get) to get a list of project role IDs.
    id: string,
    /// The user account ID of the user to remove as a default actor.
    user: option<string>,
    /// The group ID of the group to be removed as a default actor. This parameter cannot be used with the `group` parameter.
    group-id: option<string>,
    /// The group name of the group to be removed as a default actor.This parameter cannot be used with the `groupId` parameter. As a group's name can change, use of `groupId` is recommended.
    group: option<string>
  }
  delete-project-role-actors-from-role: func(params: delete-project-role-actors-from-role-params) -> result<project-role, delete-project-role-actors-from-role-error>;

}

interface project-versions {
  enum get-project-versions-paginated-order-by-enum {
    description,
    description-v2,
    description-v3,
    name,
    name-v2,
    name-v3,
    release-date,
    release-date-v2,
    release-date-v3,
    sequence,
    sequence-v2,
    sequence-v3,
    start-date,
    start-date-v2,
    start-date-v3,
  }

  enum version-move-bean-position-enum {
    earlier,
    later,
    first,
    last,
  }

  /// A page of items.
  record page-bean-version {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<version>>
  }

  /// Details about a project version.
  record version {
    /// Indicates that the version is archived. Optional when creating or updating a version.
    archived: option<bool>,
    /// The description of the version. Optional when creating or updating a version.
    description: option<string>,
    /// Use [expand](em>#expansion) to include additional information about version in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The ID of the version.
    id: option<string>,
    /// If the expand option `issuesstatus` is used, returns the count of issues in this version for each of the status categories *to do*, *in progress*, *done*, and *unmapped*. The *unmapped* property contains a count of issues with a status other than *to do*, *in progress*, and *done*.
    issues-status-for-fix-version: option<version-issues-status>,
    /// The URL of the self link to the version to which all unfixed issues are moved when a version is released. Not applicable when creating a version. Optional when updating a version.
    move-unfixed-issues-to: option<string>,
    /// The unique name of the version. Required when creating a version. Optional when updating a version. The maximum length is 255 characters.
    name: option<string>,
    /// If the expand option `operations` is used, returns the list of operations available for this version.
    operations: option<list<simple-link>>,
    /// Indicates that the version is overdue.
    overdue: option<bool>,
    /// Deprecated. Use `projectId`.
    project: option<string>,
    /// The ID of the project to which this version is attached. Required when creating a version. Not applicable when updating a version.
    project-id: option<s64>,
    /// The release date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    release-date: option<string>,
    /// Indicates that the version is released. If the version is released a request to release again is ignored. Not applicable when creating a version. Optional when updating a version.
    released: option<bool>,
    /// The URL of the version.
    self: option<string>,
    /// The start date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    start-date: option<string>,
    /// The date on which work on this version is expected to finish, expressed in the instance's *Day/Month/Year Format* date format.
    user-release-date: option<string>,
    /// The date on which work on this version is expected to start, expressed in the instance's *Day/Month/Year Format* date format.
    user-start-date: option<string>
  }

  /// Counts of the number of issues in various statuses.
  record version-issues-status {
    /// Count of issues with status *done*.
    done: option<s64>,
    /// Count of issues with status *in progress*.
    in-progress: option<s64>,
    /// Count of issues with status *to do*.
    to-do: option<s64>,
    /// Count of issues with a status other than *to do*, *in progress*, and *done*.
    unmapped: option<s64>
  }

  /// Details about the operations available in this version.
  record simple-link {
    href: option<string>,
    icon-class: option<string>,
    id: option<string>,
    label: option<string>,
    style-class: option<string>,
    title: option<string>,
    weight: option<s32>
  }

  /// Various counts of issues within a version.
  record version-issue-counts {
    /// List of custom fields using the version.
    custom-field-usage: option<list<version-usage-in-custom-field>>,
    /// Count of issues where a version custom field is set to the version.
    issue-count-with-custom-fields-showing-version: option<s64>,
    /// Count of issues where the `affectedVersion` is set to the version.
    issues-affected-count: option<s64>,
    /// Count of issues where the `fixVersion` is set to the version.
    issues-fixed-count: option<s64>,
    /// The URL of these count details.
    self: option<string>
  }

  /// List of custom fields using the version.
  record version-usage-in-custom-field {
    /// The ID of the custom field.
    custom-field-id: option<s64>,
    /// The name of the custom field.
    field-name: option<string>,
    /// Count of the issues where the custom field contains the version.
    issue-count-with-version-in-custom-field: option<s64>
  }

  /// Details about the replacement for a deleted version.
  record custom-field-replacement {
    /// The ID of the custom field in which to replace the version number.
    custom-field-id: option<s64>,
    /// The version number to use as a replacement for the deleted version.
    move-to: option<s64>
  }

  /// Count of a version's unresolved issues.
  record version-unresolved-issues-count {
    /// Count of issues.
    issues-count: option<s64>,
    /// Count of unresolved issues.
    issues-unresolved-count: option<s64>,
    /// The URL of these count details.
    self: option<string>
  }

  variant get-project-versions-paginated-error {
    not-found(string),
    other(string)
  }

  variant get-project-versions-error {
    not-found(string),
    other(string)
  }

  variant create-version-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-version-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-version-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-version-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant merge-versions-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant move-version-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-version-related-issues-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-and-replace-version-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-version-unresolved-issues-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get project versions paginated
  record get-project-versions-paginated-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-project-versions-paginated-order-by-enum>,
    /// Filter the results using a literal string. Versions with matching `name` or `description` are returned (case insensitive).
    query: option<string>,
    /// A list of status values used to filter the results by version status. This parameter accepts a comma-separated list. The status values are `released`, `unreleased`, and `archived`.
    status: option<string>,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-project-versions-paginated: func(params: get-project-versions-paginated-params) -> result<page-bean-version, get-project-versions-paginated-error>;

  /// Get project versions
  record get-project-versions-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts `operations`, which returns actions that can be performed on the version.
    expand: option<string>
  }
  get-project-versions: func(params: get-project-versions-params) -> result<list<version>, get-project-versions-error>;

  /// Create version
  record create-version-params {
    /// Indicates that the version is archived. Optional when creating or updating a version.
    archived: option<bool>,
    /// The description of the version. Optional when creating or updating a version.
    description: option<string>,
    /// Use [expand](em>#expansion) to include additional information about version in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The ID of the version.
    id: option<string>,
    /// If the expand option `issuesstatus` is used, returns the count of issues in this version for each of the status categories *to do*, *in progress*, *done*, and *unmapped*. The *unmapped* property contains a count of issues with a status other than *to do*, *in progress*, and *done*.
    issues-status-for-fix-version: option<version-issues-status>,
    /// The URL of the self link to the version to which all unfixed issues are moved when a version is released. Not applicable when creating a version. Optional when updating a version.
    move-unfixed-issues-to: option<string>,
    /// The unique name of the version. Required when creating a version. Optional when updating a version. The maximum length is 255 characters.
    name: option<string>,
    /// If the expand option `operations` is used, returns the list of operations available for this version.
    operations: option<list<simple-link>>,
    /// Indicates that the version is overdue.
    overdue: option<bool>,
    /// Deprecated. Use `projectId`.
    project: option<string>,
    /// The ID of the project to which this version is attached. Required when creating a version. Not applicable when updating a version.
    project-id: option<s64>,
    /// The release date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    release-date: option<string>,
    /// Indicates that the version is released. If the version is released a request to release again is ignored. Not applicable when creating a version. Optional when updating a version.
    released: option<bool>,
    /// The URL of the version.
    self: option<string>,
    /// The start date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    start-date: option<string>,
    /// The date on which work on this version is expected to finish, expressed in the instance's *Day/Month/Year Format* date format.
    user-release-date: option<string>,
    /// The date on which work on this version is expected to start, expressed in the instance's *Day/Month/Year Format* date format.
    user-start-date: option<string>
  }
  create-version: func(params: create-version-params) -> result<version, create-version-error>;

  /// Get version
  record get-version-params {
    /// The ID of the version.
    id: string,
    /// Use [expand](#expansion) to include additional information about version in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-version: func(params: get-version-params) -> result<version, get-version-error>;

  /// Update version
  record update-version-params {
    /// The ID of the version.
    id: string,
    /// Indicates that the version is archived. Optional when creating or updating a version.
    archived: option<bool>,
    /// The description of the version. Optional when creating or updating a version.
    description: option<string>,
    /// Use [expand](em>#expansion) to include additional information about version in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The ID of the version.
    id-v2: option<string>,
    /// If the expand option `issuesstatus` is used, returns the count of issues in this version for each of the status categories *to do*, *in progress*, *done*, and *unmapped*. The *unmapped* property contains a count of issues with a status other than *to do*, *in progress*, and *done*.
    issues-status-for-fix-version: option<version-issues-status>,
    /// The URL of the self link to the version to which all unfixed issues are moved when a version is released. Not applicable when creating a version. Optional when updating a version.
    move-unfixed-issues-to: option<string>,
    /// The unique name of the version. Required when creating a version. Optional when updating a version. The maximum length is 255 characters.
    name: option<string>,
    /// If the expand option `operations` is used, returns the list of operations available for this version.
    operations: option<list<simple-link>>,
    /// Indicates that the version is overdue.
    overdue: option<bool>,
    /// Deprecated. Use `projectId`.
    project: option<string>,
    /// The ID of the project to which this version is attached. Required when creating a version. Not applicable when updating a version.
    project-id: option<s64>,
    /// The release date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    release-date: option<string>,
    /// Indicates that the version is released. If the version is released a request to release again is ignored. Not applicable when creating a version. Optional when updating a version.
    released: option<bool>,
    /// The URL of the version.
    self: option<string>,
    /// The start date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    start-date: option<string>,
    /// The date on which work on this version is expected to finish, expressed in the instance's *Day/Month/Year Format* date format.
    user-release-date: option<string>,
    /// The date on which work on this version is expected to start, expressed in the instance's *Day/Month/Year Format* date format.
    user-start-date: option<string>
  }
  update-version: func(params: update-version-params) -> result<version, update-version-error>;

  /// Delete version
  record delete-version-params {
    /// The ID of the version.
    id: string,
    /// The ID of the version to update `fixVersion` to when the field contains the deleted version. The replacement version must be in the same project as the version being deleted and cannot be the version being deleted.
    move-fix-issues-to: option<string>,
    /// The ID of the version to update `affectedVersion` to when the field contains the deleted version. The replacement version must be in the same project as the version being deleted and cannot be the version being deleted.
    move-affected-issues-to: option<string>
  }
  delete-version: func(params: delete-version-params) -> result<string, delete-version-error>;

  /// Merge versions
  record merge-versions-params {
    /// The ID of the version to delete.
    id: string,
    /// The ID of the version to merge into.
    move-issues-to: string
  }
  merge-versions: func(params: merge-versions-params) -> result<string, merge-versions-error>;

  /// Move version
  record move-version-params {
    /// The ID of the version to be moved.
    id: string,
    /// The URL (self link) of the version after which to place the moved version. Cannot be used with `position`.
    after: option<string>,
    /// An absolute position in which to place the moved version. Cannot be used with `after`.
    position: option<version-move-bean-position-enum>
  }
  move-version: func(params: move-version-params) -> result<version, move-version-error>;

  /// Get version's related issues count
  record get-version-related-issues-params {
    /// The ID of the version.
    id: string
  }
  get-version-related-issues: func(params: get-version-related-issues-params) -> result<version-issue-counts, get-version-related-issues-error>;

  /// Delete and replace version
  record delete-and-replace-version-params {
    /// The ID of the version.
    id: string,
    /// An array of custom field IDs (`customFieldId`) and version IDs (`moveTo`) to update when the fields contain the deleted version.
    custom-field-replacement-list: option<list<custom-field-replacement>>,
    /// The ID of the version to update `affectedVersion` to when the field contains the deleted version.
    move-affected-issues-to: option<s64>,
    /// The ID of the version to update `fixVersion` to when the field contains the deleted version.
    move-fix-issues-to: option<s64>
  }
  delete-and-replace-version: func(params: delete-and-replace-version-params) -> result<string, delete-and-replace-version-error>;

  /// Get version's unresolved issues count
  record get-version-unresolved-issues-params {
    /// The ID of the version.
    id: string
  }
  get-version-unresolved-issues: func(params: get-version-unresolved-issues-params) -> result<version-unresolved-issues-count, get-version-unresolved-issues-error>;

}

interface project-email {
  /// A project's sender email address.
  record address {
    /// The email address.
    email-address: option<string>,
    /// When using a custom domain, the status of the email address.
    email-address-status: option<list<string>>
  }

  variant get-project-email-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-project-email-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get project's sender email
  record get-project-email-params {
    /// The project ID.
    project-id: string
  }
  get-project-email: func(params: get-project-email-params) -> result<address, get-project-email-error>;

  /// Set project's sender email
  record update-project-email-params {
    /// The project ID.
    project-id: string,
    /// The email address.
    email-address: option<string>,
    /// When using a custom domain, the status of the email address.
    email-address-status: option<list<string>>
  }
  update-project-email: func(params: update-project-email-params) -> result<string, update-project-email-error>;

}

interface project-permission-schemes {
  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  /// Details about a security scheme.
  record security-scheme {
    /// The ID of the default security level.
    default-security-level-id: option<s64>,
    /// The description of the issue security scheme.
    description: option<string>,
    /// The ID of the issue security scheme.
    id: option<s64>,
    levels: option<list<security-level>>,
    /// The name of the issue security scheme.
    name: option<string>,
    /// The URL of the issue security scheme.
    self: option<string>
  }

  /// Details of an issue level security item.
  record security-level {
    /// The description of the issue level security item.
    description: option<string>,
    /// The ID of the issue level security item.
    id: option<string>,
    /// Whether the issue level security item is the default.
    is-default: option<bool>,
    /// The ID of the issue level security scheme.
    issue-security-scheme-id: option<string>,
    /// The name of the issue level security item.
    name: option<string>,
    /// The URL of the issue level security item.
    self: option<string>
  }

  /// Details of a permission scheme.
  record permission-scheme {
    /// A description for the permission scheme.
    description: option<string>,
    /// The expand options available for the permission scheme.
    expand: option<string>,
    /// The ID of the permission scheme.
    id: option<s64>,
    /// The name of the permission scheme. Must be unique.
    name: string,
    /// The permission scheme to create or update. See [About permission schemes and grants](../api-group-permission-schemes/#about-permission-schemes-and-grants) for more information.
    permissions: option<list<permission-grant>>,
    /// The scope of the permission scheme.
    scope: option<scope>,
    /// The URL of the permission scheme.
    self: option<string>
  }

  /// Details about a permission granted to a user or group.
  record permission-grant {
    /// The user or group being granted the permission. It consists of a `type`, a type-dependent `parameter` and a type-dependent `value`. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
    holder: option<permission-holder>,
    /// The ID of the permission granted details.
    id: option<s64>,
    /// The permission to grant. This permission can be one of the built-in permissions or a custom permission added by an app. See [Built-in permissions](../api-group-permission-schemes/#built-in-permissions) in *Get all permission schemes* for more information about the built-in permissions. See the [project permission](https://developer.atlassian.com/cloud/jira/platform/modules/project-permission/) and [global permission](https://developer.atlassian.com/cloud/jira/platform/modules/global-permission/) module documentation for more information about custom permissions.
    permission: option<string>,
    /// The URL of the permission granted details.
    self: option<string>
  }

  /// Details of a user, group, field, or project role that holds a permission. See [Holder object](../api-group-permission-schemes/#holder-object) in *Get all permission schemes* for more information.
  record permission-holder {
    /// Expand options that include additional permission holder details in the response.
    expand: option<string>,
    /// As a group's name can change, use of `value` is recommended. The identifier associated withthe `type` value that defines the holder of the permission.
    parameter: option<string>,
    /// The type of permission holder.
    type-op: string,
    /// The identifier associated with the `type` value that defines the holder of the permission.
    value: option<string>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// List of issue level security items in a project.
  record project-issue-security-levels {
    /// Issue level security items list.
    levels: list<security-level>
  }

  variant get-project-issue-security-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-assigned-permission-scheme-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant assign-permission-scheme-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-security-levels-for-project-error {
    not-found(string),
    other(string)
  }

  /// Get project issue security scheme
  record get-project-issue-security-scheme-params {
    /// The project ID or project key (case sensitive).
    project-key-or-id: string
  }
  get-project-issue-security-scheme: func(params: get-project-issue-security-scheme-params) -> result<security-scheme, get-project-issue-security-scheme-error>;

  /// Get assigned permission scheme
  record get-assigned-permission-scheme-params {
    /// The project ID or project key (case sensitive).
    project-key-or-id: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are included when you specify any value. Expand options include:
    /// 
    expand: option<string>
  }
  get-assigned-permission-scheme: func(params: get-assigned-permission-scheme-params) -> result<permission-scheme, get-assigned-permission-scheme-error>;

  /// Assign permission scheme
  record assign-permission-scheme-params {
    /// The project ID or project key (case sensitive).
    project-key-or-id: string,
    /// Use [expand](#expansion) to include additional information in the response. This parameter accepts a comma-separated list. Note that permissions are included when you specify any value. Expand options include:
    /// 
    expand: option<string>,
    /// The ID of the permission scheme to associate with the project. Use the [Get all permission schemes](#api-rest-api-3-permissionscheme-get) resource to get a list of permission scheme IDs.
    id: s64
  }
  assign-permission-scheme: func(params: assign-permission-scheme-params) -> result<permission-scheme, assign-permission-scheme-error>;

  /// Get project issue security levels
  record get-security-levels-for-project-params {
    /// The project ID or project key (case sensitive).
    project-key-or-id: string
  }
  get-security-levels-for-project: func(params: get-security-levels-for-project-params) -> result<project-issue-security-levels, get-security-levels-for-project-error>;

}

interface project-categories {
  /// A project category.
  record project-category {
    /// The description of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The name of the project category. Required on create, optional on update.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  variant get-all-project-categories-error {
    unauthorized(string),
    other(string)
  }

  variant create-project-category-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    conflict(string),
    other(string)
  }

  variant get-project-category-by-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-project-category-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-project-category-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all project categories
  get-all-project-categories: func() -> result<list<project-category>, get-all-project-categories-error>;

  /// Create project category
  record create-project-category-params {
    /// The description of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The name of the project category. Required on create, optional on update.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }
  create-project-category: func(params: create-project-category-params) -> result<project-category, create-project-category-error>;

  /// Get project category by ID
  record get-project-category-by-id-params {
    /// The ID of the project category.
    id: string
  }
  get-project-category-by-id: func(params: get-project-category-by-id-params) -> result<project-category, get-project-category-by-id-error>;

  /// Update project category
  record update-project-category-params {
    id: string,
    /// The description of the project category.
    description: option<string>,
    /// The ID of the project category.
    id-v2: option<string>,
    /// The name of the project category. Required on create, optional on update.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }
  update-project-category: func(params: update-project-category-params) -> result<updated-project-category, update-project-category-error>;

  /// Delete project category
  record remove-project-category-params {
    /// ID of the project category to delete.
    id: string
  }
  remove-project-category: func(params: remove-project-category-params) -> result<string, remove-project-category-error>;

}

interface project-key-and-name-validation {
  /// Error messages from an operation.
  record error-collection {
    /// The list of error messages produced by this operation. For example, "input parameter 'key' must be provided"
    error-messages: option<list<string>>,
    /// The list of errors by parameter returned by the operation. For example,"projectKey": "Project keys must start with an uppercase letter, followed by one or more uppercase alphanumeric characters."
    errors: option<error-collection-errors>,
    status: option<s32>
  }

  /// The list of errors by parameter returned by the operation. For example,"projectKey": "Project keys must start with an uppercase letter, followed by one or more uppercase alphanumeric characters."
  record error-collection-errors {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant validate-project-key-error {
    unauthorized(string),
    other(string)
  }

  variant get-valid-project-key-error {
    unauthorized(string),
    other(string)
  }

  variant get-valid-project-name-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Validate project key
  record validate-project-key-params {
    /// The project key.
    key: option<string>
  }
  validate-project-key: func(params: validate-project-key-params) -> result<error-collection, validate-project-key-error>;

  /// Get valid project key
  record get-valid-project-key-params {
    /// The project key.
    key: option<string>
  }
  get-valid-project-key: func(params: get-valid-project-key-params) -> result<string, get-valid-project-key-error>;

  /// Get valid project name
  record get-valid-project-name-params {
    /// The project name.
    name: string
  }
  get-valid-project-name: func(params: get-valid-project-name-params) -> result<string, get-valid-project-name-error>;

}

interface issue-resolutions {
  /// Details of an issue resolution.
  record resolution {
    /// The description of the issue resolution.
    description: option<string>,
    /// The ID of the issue resolution.
    id: option<string>,
    /// The name of the issue resolution.
    name: option<string>,
    /// The URL of the issue resolution.
    self: option<string>
  }

  /// The ID of an issue resolution.
  record resolution-id {
    /// The ID of the issue resolution.
    id: string
  }

  /// A page of items.
  record page-bean-resolution-json-bean {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<resolution-json-bean>>
  }

  record resolution-json-bean {
    default: option<bool>,
    description: option<string>,
    icon-url: option<string>,
    id: option<string>,
    name: option<string>,
    self: option<string>
  }

  variant get-resolutions-error {
    unauthorized(string),
    other(string)
  }

  variant create-resolution-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant set-default-resolution-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant move-resolutions-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant search-resolutions-error {
    unauthorized(string),
    other(string)
  }

  variant get-resolution-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-resolution-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-resolution-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  /// Get resolutions
  get-resolutions: func() -> result<list<resolution>, get-resolutions-error>;

  /// Create resolution
  record create-resolution-params {
    /// The description of the resolution.
    description: option<string>,
    /// The name of the resolution. Must be unique (case-insensitive).
    name: string
  }
  create-resolution: func(params: create-resolution-params) -> result<resolution-id, create-resolution-error>;

  /// Set default resolution
  record set-default-resolution-params {
    /// The ID of the new default issue resolution. Must be an existing ID or null. Setting this to null erases the default resolution setting.
    id: string
  }
  set-default-resolution: func(params: set-default-resolution-params) -> result<string, set-default-resolution-error>;

  /// Move resolutions
  record move-resolutions-params {
    /// The ID of the resolution. Required if `position` isn't provided.
    after: option<string>,
    /// The list of resolution IDs to be reordered. Cannot contain duplicates nor after ID.
    ids: list<string>,
    /// The position for issue resolutions to be moved to. Required if `after` isn't provided.
    position: option<string>
  }
  move-resolutions: func(params: move-resolutions-params) -> result<string, move-resolutions-error>;

  /// Search resolutions
  record search-resolutions-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of resolutions IDs to be filtered out
    id: option<list<string>>,
    /// When set to true, return default only, when IDs provided, if none of them is default, return empty page. Default value is false
    only-default: option<bool>
  }
  search-resolutions: func(params: search-resolutions-params) -> result<page-bean-resolution-json-bean, search-resolutions-error>;

  /// Get resolution
  record get-resolution-params {
    /// The ID of the issue resolution value.
    id: string
  }
  get-resolution: func(params: get-resolution-params) -> result<resolution, get-resolution-error>;

  /// Update resolution
  record update-resolution-params {
    /// The ID of the issue resolution.
    id: string,
    /// The description of the resolution.
    description: option<string>,
    /// The name of the resolution. Must be unique.
    name: string
  }
  update-resolution: func(params: update-resolution-params) -> result<string, update-resolution-error>;

  /// Delete resolution
  record delete-resolution-params {
    /// The ID of the issue resolution.
    id: string,
    /// The ID of the issue resolution that will replace the currently selected resolution.
    replace-with: string
  }
  delete-resolution: func(params: delete-resolution-params) -> result<string, delete-resolution-error>;

}

interface screen-tabs {
  /// A screen tab.
  record screenable-tab {
    /// The ID of the screen tab.
    id: option<s64>,
    /// The name of the screen tab. The maximum length is 255 characters.
    name: string
  }

  variant get-all-screen-tabs-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-screen-tab-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant rename-screen-tab-error {
    bad-request(string),
    unauthorized(string),
