/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `basicAuth` | `Authorization: Basic base64(<secret>)` |
package autostamp:atlassian@0.5.0;

interface announcement-banner {
  enum configuration-visibility-enum {
    public,
    private,
  }

  /// Announcement banner configuration.
  record configuration {
    /// Hash of the banner data. The client detects updates by comparing hash IDs.
    hash-id: option<string>,
    /// Flag indicating if the announcement banner can be dismissed by the user.
    is-dismissible: option<bool>,
    /// Flag indicating if the announcement banner is enabled or not.
    is-enabled: option<bool>,
    /// The text on the announcement banner.
    message: option<string>,
    /// Visibility of the announcement banner.
    visibility: option<configuration-visibility-enum>
  }

  variant get-banner-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant set-banner-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  /// Get announcement banner configuration
  get-banner: func() -> result<configuration, get-banner-error>;

  /// Update announcement banner configuration
  record set-banner-params {
    /// Flag indicating if the announcement banner can be dismissed by the user.
    is-dismissible: option<bool>,
    /// Flag indicating if the announcement banner is enabled or not.
    is-enabled: option<bool>,
    /// The text on the announcement banner.
    message: option<string>,
    /// Visibility of the announcement banner. Can be public or private.
    visibility: option<string>
  }
  set-banner: func(params: set-banner-params) -> result<string, set-banner-error>;

}


interface issue-custom-field-values-apps {
  /// A custom field and its new value with a list of issue to update.
  record multiple-custom-field-values-update {
    /// The ID or key of the custom field. For example, `customfield_10010`.
    custom-field: string,
    /// The list of issue IDs.
    issue-ids: list<s64>,
    /// The value for the custom field. The value must be compatible with the [custom field type](https://developer.atlassian.com/platform/forge/manifest-reference/modules/jira-custom-field/#data-types) as follows:
    /// 
    value: string
  }

  /// A list of issue IDs and the value to update a custom field to.
  record custom-field-value-update {
    /// The list of issue IDs.
    issue-ids: list<s64>,
    /// The value for the custom field. The value must be compatible with the [custom field type](https://developer.atlassian.com/platform/forge/manifest-reference/modules/jira-custom-field/#data-types) as follows:
    /// 
    value: string
  }

  variant update-multiple-custom-field-values-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-custom-field-value-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Update custom fields
  record update-multiple-custom-field-values-params {
    /// Whether to generate a changelog for this update.
    generate-changelog: option<bool>,
    updates: option<list<multiple-custom-field-values-update>>
  }
  update-multiple-custom-field-values: func(params: update-multiple-custom-field-values-params) -> result<string, update-multiple-custom-field-values-error>;

  /// Update custom field value
  record update-custom-field-value-params {
    /// The ID or key of the custom field. For example, `customfield_10010`.
    field-id-or-key: string,
    /// Whether to generate a changelog for this update.
    generate-changelog: option<bool>,
    /// The list of custom field update details.
    updates: option<list<custom-field-value-update>>
  }
  update-custom-field-value: func(params: update-custom-field-value-params) -> result<string, update-custom-field-value-error>;

}

interface issue-custom-field-configuration-apps {
  /// A page of items.
  record page-bean-contextual-configuration {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<contextual-configuration>>
  }

  /// Details of the contextual configuration for a custom field.
  record contextual-configuration {
    /// The field configuration.
    configuration: option<string>,
    /// The ID of the field context the configuration is associated with.
    field-context-id: string,
    /// The ID of the configuration.
    id: string,
    /// The field value schema.
    schema: option<string>
  }

  variant get-custom-field-configuration-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-custom-field-configuration-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get custom field configurations
  record get-custom-field-configuration-params {
    /// The ID or key of the custom field, for example `customfield_10000`.
    field-id-or-key: string,
    /// The list of configuration IDs. To include multiple configurations, separate IDs with an ampersand: `id=10000&id=10001`. Can't be provided with `fieldContextId`, `issueId`, `projectKeyOrId`, or `issueTypeId`.
    id: option<list<s64>>,
    /// The list of field context IDs. To include multiple field contexts, separate IDs with an ampersand: `fieldContextId=10000&fieldContextId=10001`. Can't be provided with `id`, `issueId`, `projectKeyOrId`, or `issueTypeId`.
    field-context-id: option<list<s64>>,
    /// The ID of the issue to filter results by. If the issue doesn't exist, an empty list is returned. Can't be provided with `projectKeyOrId`, or `issueTypeId`.
    issue-id: option<s64>,
    /// The ID or key of the project to filter results by. Must be provided with `issueTypeId`. Can't be provided with `issueId`.
    project-key-or-id: option<string>,
    /// The ID of the issue type to filter results by. Must be provided with `projectKeyOrId`. Can't be provided with `issueId`.
    issue-type-id: option<string>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-custom-field-configuration: func(params: get-custom-field-configuration-params) -> result<page-bean-contextual-configuration, get-custom-field-configuration-error>;

  /// Update custom field configurations
  record update-custom-field-configuration-params {
    /// The ID or key of the custom field, for example `customfield_10000`.
    field-id-or-key: string,
    /// The list of custom field configuration details.
    configurations: list<contextual-configuration>
  }
  update-custom-field-configuration: func(params: update-custom-field-configuration-params) -> result<string, update-custom-field-configuration-error>;

}

interface jira-settings {
  enum time-tracking-configuration-default-unit-enum {
    minute,
    hour,
    day,
    week,
  }

  enum time-tracking-configuration-time-format-enum {
    pretty,
    days,
    hours,
  }

  /// Details of an application property.
  record application-property {
    /// The allowed values, if applicable.
    allowed-values: option<list<string>>,
    /// The default value of the application property.
    default-value: option<string>,
    /// The description of the application property.
    desc: option<string>,
    example: option<string>,
    /// The ID of the application property. The ID and key are the same.
    id: option<string>,
    /// The key of the application property. The ID and key are the same.
    key: option<string>,
    /// The name of the application property.
    name: option<string>,
    /// The data type of the application property.
    type-op: option<string>,
    /// The new value.
    value: option<string>
  }

  /// Details about the configuration of Jira.
  record configuration {
    /// Whether the ability to add attachments to issues is enabled.
    attachments-enabled: option<bool>,
    /// Whether the ability to link issues is enabled.
    issue-linking-enabled: option<bool>,
    /// Whether the ability to create subtasks for issues is enabled.
    sub-tasks-enabled: option<bool>,
    /// The configuration of time tracking.
    time-tracking-configuration: option<time-tracking-configuration>,
    /// Whether the ability to track time is enabled. This property is deprecated.
    time-tracking-enabled: option<bool>,
    /// Whether the ability to create unassigned issues is enabled. See [Configuring Jira application options](https://confluence.atlassian.com/x/uYXKM) for details.
    unassigned-issues-allowed: option<bool>,
    /// Whether the ability for users to vote on issues is enabled. See [Configuring Jira application options](https://confluence.atlassian.com/x/uYXKM) for details.
    voting-enabled: option<bool>,
    /// Whether the ability for users to watch issues is enabled. See [Configuring Jira application options](https://confluence.atlassian.com/x/uYXKM) for details.
    watching-enabled: option<bool>
  }

  /// Details of the time tracking configuration.
  record time-tracking-configuration {
    /// The default unit of time applied to logged time.
    default-unit: time-tracking-configuration-default-unit-enum,
    /// The format that will appear on an issue's *Time Spent* field.
    time-format: time-tracking-configuration-time-format-enum,
    /// The number of days in a working week.
    working-days-per-week: f64,
    /// The number of hours in a working day.
    working-hours-per-day: f64
  }

  variant get-application-property-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-advanced-settings-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant set-application-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-configuration-error {
    unauthorized(string),
    other(string)
  }

  /// Get application property
  record get-application-property-params {
    /// The key of the application property.
    key: option<string>,
    /// The permission level of all items being returned in the list.
    permission-level: option<string>,
    /// When a `key` isn't provided, this filters the list of results by the application property `key` using a regular expression. For example, using `jira.lf.*` will return all application properties with keys that start with *jira.lf.*.
    key-filter: option<string>
  }
  get-application-property: func(params: get-application-property-params) -> result<list<application-property>, get-application-property-error>;

  /// Get advanced settings
  get-advanced-settings: func() -> result<list<application-property>, get-advanced-settings-error>;

  /// Set application property
  record set-application-property-params {
    /// The key of the application property to update.
    id: string,
    /// The ID of the application property.
    id-v2: option<string>,
    /// The new value.
    value: option<string>
  }
  set-application-property: func(params: set-application-property-params) -> result<application-property, set-application-property-error>;

  /// Get global settings
  get-configuration: func() -> result<configuration, get-configuration-error>;

}

interface application-roles {
  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  variant get-all-application-roles-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-application-role-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all application roles
  get-all-application-roles: func() -> result<list<application-role>, get-all-application-roles-error>;

  /// Get application role
  record get-application-role-params {
    /// The key of the application role. Use the [Get all application roles](#api-rest-api-3-applicationrole-get) operation to get the key for each application role.
    key: string
  }
  get-application-role: func(params: get-application-role-params) -> result<application-role, get-application-role-error>;

}

interface issue-attachments {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  record get-attachment-content-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of the instance's attachment settings.
  record attachment-settings {
    /// Whether the ability to add attachments is enabled.
    enabled: option<bool>,
    /// The maximum size of attachments permitted, in bytes.
    upload-limit: option<s64>
  }

  record get-attachment-thumbnail-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Metadata for an issue attachment.
  record attachment-metadata {
    /// Details of the user who attached the file.
    author: option<user>,
    /// The URL of the attachment.
    content: option<string>,
    /// The datetime the attachment was created.
    created: option<string>,
    /// The name of the attachment file.
    filename: option<string>,
    /// The ID of the attachment.
    id: option<s64>,
    /// The MIME type of the attachment.
    mime-type: option<string>,
    /// Additional properties of the attachment.
    properties: option<attachment-metadata-properties>,
    /// The URL of the attachment metadata details.
    self: option<string>,
    /// The size of the attachment.
    size: option<s64>,
    /// The URL of a thumbnail representing the attachment.
    thumbnail: option<string>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Additional properties of the attachment.
  record attachment-metadata-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Metadata for an archive (for example a zip) and its contents.
  record attachment-archive-metadata-readable {
    /// The list of the items included in the archive.
    entries: option<list<attachment-archive-item-readable>>,
    /// The ID of the attachment.
    id: option<s64>,
    /// The MIME type of the attachment.
    media-type: option<string>,
    /// The name of the archive file.
    name: option<string>,
    /// The number of items included in the archive.
    total-entry-count: option<s64>
  }

  /// Metadata for an item in an attachment archive.
  record attachment-archive-item-readable {
    /// The position of the item within the archive.
    index: option<s64>,
    /// The label for the archive item.
    label: option<string>,
    /// The MIME type of the archive item.
    media-type: option<string>,
    /// The path of the archive item.
    path: option<string>,
    /// The size of the archive item.
    size: option<string>
  }

  record attachment-archive-impl {
    /// The list of the items included in the archive.
    entries: option<list<attachment-archive-entry>>,
    /// The number of items in the archive.
    total-entry-count: option<s32>
  }

  record attachment-archive-entry {
    abbreviated-name: option<string>,
    entry-index: option<s64>,
    media-type: option<string>,
    name: option<string>,
    size: option<s64>
  }

  /// Details about an attachment.
  record attachment {
    /// Details of the user who added the attachment.
    author: option<user-details>,
    /// The content of the attachment.
    content: option<string>,
    /// The datetime the attachment was created.
    created: option<string>,
    /// The file name of the attachment.
    filename: option<string>,
    /// The ID of the attachment.
    id: option<string>,
    /// The MIME type of the attachment.
    mime-type: option<string>,
    /// The URL of the attachment details response.
    self: option<string>,
    /// The size of the attachment.
    size: option<s64>,
    /// The URL of a thumbnail representing the attachment.
    thumbnail: option<string>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  variant get-attachment-content-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    range-not-satisfiable(string),
    other(string)
  }

  variant get-attachment-meta-error {
    unauthorized(string),
    other(string)
  }

  variant get-attachment-thumbnail-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-attachment-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-attachment-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant expand-attachment-for-humans-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant expand-attachment-for-machines-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant add-attachment-error {
    forbidden(string),
    not-found(string),
    payload-too-large(string),
    other(string)
  }

  /// Get attachment content
  record get-attachment-content-params {
    /// The ID of the attachment.
    id: string,
    /// Whether a redirect is provided for the attachment download. Clients that do not automatically follow redirects can set this to `false` to avoid making multiple requests to download the attachment.
    redirect: option<bool>
  }
  get-attachment-content: func(params: get-attachment-content-params) -> result<get-attachment-content-response, get-attachment-content-error>;

  /// Get Jira attachment settings
  get-attachment-meta: func() -> result<attachment-settings, get-attachment-meta-error>;

  /// Get attachment thumbnail
  record get-attachment-thumbnail-params {
    /// The ID of the attachment.
    id: string,
    /// Whether a redirect is provided for the attachment download. Clients that do not automatically follow redirects can set this to `false` to avoid making multiple requests to download the attachment.
    redirect: option<bool>,
    /// Whether a default thumbnail is returned when the requested thumbnail is not found.
    fallback-to-default: option<bool>,
    /// The maximum width to scale the thumbnail to.
    width: option<s32>,
    /// The maximum height to scale the thumbnail to.
    height: option<s32>
  }
  get-attachment-thumbnail: func(params: get-attachment-thumbnail-params) -> result<get-attachment-thumbnail-response, get-attachment-thumbnail-error>;

  /// Get attachment metadata
  record get-attachment-params {
    /// The ID of the attachment.
    id: string
  }
  get-attachment: func(params: get-attachment-params) -> result<attachment-metadata, get-attachment-error>;

  /// Delete attachment
  record remove-attachment-params {
    /// The ID of the attachment.
    id: string
  }
  remove-attachment: func(params: remove-attachment-params) -> result<string, remove-attachment-error>;

  /// Get all metadata for an expanded attachment
  record expand-attachment-for-humans-params {
    /// The ID of the attachment.
    id: string
  }
  expand-attachment-for-humans: func(params: expand-attachment-for-humans-params) -> result<attachment-archive-metadata-readable, expand-attachment-for-humans-error>;

  /// Get contents metadata for an expanded attachment
  record expand-attachment-for-machines-params {
    /// The ID of the attachment.
    id: string
  }
  expand-attachment-for-machines: func(params: expand-attachment-for-machines-params) -> result<attachment-archive-impl, expand-attachment-for-machines-error>;

  /// Add attachment
  record add-attachment-params {
    /// The ID or key of the issue that attachments are added to.
    issue-id-or-key: string,
    body: option<string>
  }
  add-attachment: func(params: add-attachment-params) -> result<list<attachment>, add-attachment-error>;

}

interface audit-records {
  /// Container for a list of audit records.
  record audit-records {
    /// The requested or default limit on the number of audit items to be returned.
    limit: option<s32>,
    /// The number of audit items skipped before the first item in this list.
    offset: option<s32>,
    /// The list of audit items.
    records: option<list<audit-record-bean>>,
    /// The total number of audit items returned.
    total: option<s64>
  }

  /// An audit record.
  record audit-record-bean {
    /// The list of items associated with the changed record.
    associated-items: option<list<associated-item-bean>>,
    /// Deprecated, use `authorAccountId` instead. The key of the user who created the audit record.
    author-key: option<string>,
    /// The category of the audit record. For a list of these categories, see the help article [Auditing in Jira applications](https://confluence.atlassian.com/x/noXKM).
    category: option<string>,
    /// The list of values changed in the record event.
    changed-values: option<list<changed-value-bean>>,
    /// The date and time on which the audit record was created.
    created: option<string>,
    /// The description of the audit record.
    description: option<string>,
    /// The event the audit record originated from.
    event-source: option<string>,
    /// The ID of the audit record.
    id: option<s64>,
    object-item: option<associated-item-bean>,
    /// The URL of the computer where the creation of the audit record was initiated.
    remote-address: option<string>,
    /// The summary of the audit record.
    summary: option<string>
  }

  /// Details of an item associated with the changed record.
  record associated-item-bean {
    /// The ID of the associated record.
    id: option<string>,
    /// The name of the associated record.
    name: option<string>,
    /// The ID of the associated parent record.
    parent-id: option<string>,
    /// The name of the associated parent record.
    parent-name: option<string>,
    /// The type of the associated record.
    type-name: option<string>
  }

  /// Details of names changed in the record event.
  record changed-value-bean {
    /// The value of the field before the change.
    changed-from: option<string>,
    /// The value of the field after the change.
    changed-to: option<string>,
    /// The name of the field changed.
    field-name: option<string>
  }

  variant get-audit-records-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  /// Get audit records
  record get-audit-records-params {
    /// The number of records to skip before returning the first result.
    offset: option<s32>,
    /// The maximum number of results to return.
    limit: option<s32>,
    /// The strings to match with audit field content, space separated.
    filter: option<string>,
    /// The date and time on or after which returned audit records must have been created. If `to` is provided `from` must be before `to` or no audit records are returned.
    from-op: option<string>,
    /// The date and time on or before which returned audit results must have been created. If `from` is provided `to` must be after `from` or no audit records are returned.
    to: option<string>
  }
  get-audit-records: func(params: get-audit-records-params) -> result<audit-records, get-audit-records-error>;

}

interface avatars {
  enum get-avatar-image-by-type-size-enum {
    xsmall,
    small,
    medium,
    large,
    xlarge,
  }

  enum get-avatar-image-by-type-format-enum {
    png,
    svg,
  }

  /// List of system avatars.
  record system-avatars {
    /// A list of avatar details.
    system: option<list<avatar>>
  }

  /// Details of an avatar.
  record avatar {
    /// The file name of the avatar icon. Returned for system avatars.
    file-name: option<string>,
    /// The ID of the avatar.
    id: string,
    /// Whether the avatar can be deleted.
    is-deletable: option<bool>,
    /// Whether the avatar is used in Jira. For example, shown as a project's avatar.
    is-selected: option<bool>,
    /// Whether the avatar is a system avatar.
    is-system-avatar: option<bool>,
    /// The owner of the avatar. For a system avatar the owner is null (and nothing is returned). For non-system avatars this is the appropriate identifier, such as the ID for a project or the account ID for a user.
    owner: option<string>,
    /// The list of avatar icon URLs.
    urls: option<avatar-urls>
  }

  /// The list of avatar icon URLs.
  record avatar-urls {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about system and custom avatars.
  record avatars {
    /// Custom avatars list.
    custom: option<list<avatar>>,
    /// System avatars list.
    system: option<list<avatar>>
  }

  record get-avatar-image-by-type-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-avatar-image-by-id-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-avatar-image-by-owner-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-all-system-avatars-error {
    unauthorized(string),
    internal-server-error(string),
    other(string)
  }

  variant get-avatars-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant store-avatar-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-avatar-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-avatar-image-by-type-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-avatar-image-by-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-avatar-image-by-owner-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get system avatars by type
  record get-all-system-avatars-params {
    /// The avatar type.
    type-op: string
  }
  get-all-system-avatars: func(params: get-all-system-avatars-params) -> result<system-avatars, get-all-system-avatars-error>;

  /// Get avatars
  record get-avatars-params {
    /// The avatar type.
    type-op: string,
    /// The ID of the item the avatar is associated with.
    entity-id: string
  }
  get-avatars: func(params: get-avatars-params) -> result<avatars, get-avatars-error>;

  /// Load avatar
  record store-avatar-params {
    /// The avatar type.
    type-op: string,
    /// The ID of the item the avatar is associated with.
    entity-id: string,
    /// The X coordinate of the top-left corner of the crop region.
    x: option<s32>,
    /// The Y coordinate of the top-left corner of the crop region.
    y: option<s32>,
    /// The length of each side of the crop region.
    size: s32,
    body: string
  }
  store-avatar: func(params: store-avatar-params) -> result<avatar, store-avatar-error>;

  /// Delete avatar
  record delete-avatar-params {
    /// The avatar type.
    type-op: string,
    /// The ID of the item the avatar is associated with.
    owning-object-id: string,
    /// The ID of the avatar.
    id: string
  }
  delete-avatar: func(params: delete-avatar-params) -> result<string, delete-avatar-error>;

  /// Get avatar image by type
  record get-avatar-image-by-type-params {
    /// The icon type of the avatar.
    type-op: string,
    /// The size of the avatar image. If not provided the default size is returned.
    size: option<get-avatar-image-by-type-size-enum>,
    /// The format to return the avatar image in. If not provided the original content format is returned.
    format: option<get-avatar-image-by-type-format-enum>
  }
  get-avatar-image-by-type: func(params: get-avatar-image-by-type-params) -> result<get-avatar-image-by-type-response, get-avatar-image-by-type-error>;

  /// Get avatar image by ID
  record get-avatar-image-by-id-params {
    /// The icon type of the avatar.
    type-op: string,
    /// The ID of the avatar.
    id: string,
    /// The size of the avatar image. If not provided the default size is returned.
    size: option<get-avatar-image-by-type-size-enum>,
    /// The format to return the avatar image in. If not provided the original content format is returned.
    format: option<get-avatar-image-by-type-format-enum>
  }
  get-avatar-image-by-id: func(params: get-avatar-image-by-id-params) -> result<get-avatar-image-by-id-response, get-avatar-image-by-id-error>;

  /// Get avatar image by owner
  record get-avatar-image-by-owner-params {
    /// The icon type of the avatar.
    type-op: string,
    /// The ID of the project or issue type the avatar belongs to.
    entity-id: string,
    /// The size of the avatar image. If not provided the default size is returned.
    size: option<get-avatar-image-by-type-size-enum>,
    /// The format to return the avatar image in. If not provided the original content format is returned.
    format: option<get-avatar-image-by-type-format-enum>
  }
  get-avatar-image-by-owner: func(params: get-avatar-image-by-owner-params) -> result<get-avatar-image-by-owner-response, get-avatar-image-by-owner-error>;

}

interface issue-comments {
  enum visibility-type-op-enum {
    group,
    role,
  }

  enum get-comments-order-by-enum {
    created,
    created-v2,
    created-v3,
  }

  /// A page of items.
  record page-bean-comment {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<comment>>
  }

  /// A comment.
  record comment {
    /// The ID of the user who created the comment.
    author: option<user-details>,
    /// The comment text in [Atlassian Document Format](https://developer.atlassian.com/cloud/jira/platform/apis/document/structure/).
    body: option<string>,
    /// The date and time at which the comment was created.
    created: option<string>,
    /// The ID of the comment.
    id: option<string>,
    /// Whether the comment was added from an email sent by a person who is not part of the issue. See [Allow external emails to be added as comments on issues](https://support.atlassian.com/jira-service-management-cloud/docs/allow-external-emails-to-be-added-as-comments-on-issues/)for information on setting up this feature.
    jsd-author-can-see-request: option<bool>,
    /// Whether the comment is visible in Jira Service Desk. Defaults to true when comments are created in the Jira Cloud Platform. This includes when the site doesn't use Jira Service Desk or the project isn't a Jira Service Desk project and, therefore, there is no Jira Service Desk for the issue to be visible on. To create a comment with its visibility in Jira Service Desk set to false, use the Jira Service Desk REST API [Create request comment](https://developer.atlassian.com/cloud/jira/service-desk/rest/#api-rest-servicedeskapi-request-issueIdOrKey-comment-post) operation.
    jsd-public: option<bool>,
    /// A list of comment properties. Optional on create and update.
    properties: option<list<entity-property>>,
    /// The rendered version of the comment.
    rendered-body: option<string>,
    /// The URL of the comment.
    self: option<string>,
    /// The ID of the user who updated the comment last.
    update-author: option<user-details>,
    /// The date and time at which the comment was updated last.
    updated: option<string>,
    /// The group or role to which this comment is visible. Optional on create and update.
    visibility: option<visibility>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  /// The group or role to which this item is visible.
  record visibility {
    /// The ID of the group or the name of the role that visibility of this item is restricted to.
    identifier: option<string>,
    /// Whether visibility of this item is restricted to a group or role.
    type-op: option<visibility-type-op-enum>,
    /// The name of the group or role that visibility of this item is restricted to. Please note that the name of a group is mutable, to reliably identify a group use `identifier`.
    value: option<string>
  }

  /// A page of comments.
  record page-of-comments {
    /// The list of comments.
    comments: option<list<comment>>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>
  }

  variant get-comments-by-ids-error {
    bad-request(string),
    other(string)
  }

  variant get-comments-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-comment-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-comment-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-comment-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-comment-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  /// Get comments by IDs
  record get-comments-by-ids-params {
    /// Use [expand](#expansion) to include additional information about comments in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The list of comment IDs. A maximum of 1000 IDs can be specified.
    ids: list<s64>
  }
  get-comments-by-ids: func(params: get-comments-by-ids-params) -> result<page-bean-comment, get-comments-by-ids-error>;

  /// Get comments
  record get-comments-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// [Order](#ordering) the results by a field. Accepts *created* to sort comments by their created date.
    order-by: option<get-comments-order-by-enum>,
    /// Use [expand](#expansion) to include additional information about comments in the response. This parameter accepts `renderedBody`, which returns the comment body rendered in HTML.
    expand: option<string>
  }
  get-comments: func(params: get-comments-params) -> result<page-of-comments, get-comments-error>;

  /// Add comment
  record add-comment-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// Use [expand](#expansion) to include additional information about comments in the response. This parameter accepts `renderedBody`, which returns the comment body rendered in HTML.
    expand: option<string>,
    /// The ID of the user who created the comment.
    author: option<user-details>,
    /// The comment text in [Atlassian Document Format](https://developer.atlassian.com/cloud/jira/platform/apis/document/structure/).
    body: option<string>,
    /// The date and time at which the comment was created.
    created: option<string>,
    /// The ID of the comment.
    id: option<string>,
    /// Whether the comment was added from an email sent by a person who is not part of the issue. See [Allow external emails to be added as comments on issues](https://support.atlassian.com/jira-service-management-cloud/docs/allow-external-emails-to-be-added-as-comments-on-issues/)for information on setting up this feature.
    jsd-author-can-see-request: option<bool>,
    /// Whether the comment is visible in Jira Service Desk. Defaults to true when comments are created in the Jira Cloud Platform. This includes when the site doesn't use Jira Service Desk or the project isn't a Jira Service Desk project and, therefore, there is no Jira Service Desk for the issue to be visible on. To create a comment with its visibility in Jira Service Desk set to false, use the Jira Service Desk REST API [Create request comment](https://developer.atlassian.com/cloud/jira/service-desk/rest/#api-rest-servicedeskapi-request-issueIdOrKey-comment-post) operation.
    jsd-public: option<bool>,
    /// A list of comment properties. Optional on create and update.
    properties: option<list<entity-property>>,
    /// The rendered version of the comment.
    rendered-body: option<string>,
    /// The URL of the comment.
    self: option<string>,
    /// The ID of the user who updated the comment last.
    update-author: option<user-details>,
    /// The date and time at which the comment was updated last.
    updated: option<string>,
    /// The group or role to which this comment is visible. Optional on create and update.
    visibility: option<visibility>
  }
  add-comment: func(params: add-comment-params) -> result<comment, add-comment-error>;

  /// Get comment
  record get-comment-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the comment.
    id: string,
    /// Use [expand](#expansion) to include additional information about comments in the response. This parameter accepts `renderedBody`, which returns the comment body rendered in HTML.
    expand: option<string>
  }
  get-comment: func(params: get-comment-params) -> result<comment, get-comment-error>;

  /// Update comment
  record update-comment-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the comment.
    id: string,
    /// Whether users are notified when a comment is updated.
    notify-users: option<bool>,
    /// Whether screen security is overridden to enable uneditable fields to be edited. Available to Connect app users with the *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg) and Forge apps acting on behalf of users with *Administer Jira* [global permission](https://confluence.atlassian.com/x/x4dKLg).
    override-editable-flag: option<bool>,
    /// Use [expand](#expansion) to include additional information about comments in the response. This parameter accepts `renderedBody`, which returns the comment body rendered in HTML.
    expand: option<string>,
    /// The ID of the user who created the comment.
    author: option<user-details>,
    /// The comment text in [Atlassian Document Format](https://developer.atlassian.com/cloud/jira/platform/apis/document/structure/).
    body: option<string>,
    /// The date and time at which the comment was created.
    created: option<string>,
    /// The ID of the comment.
    id-v2: option<string>,
    /// Whether the comment was added from an email sent by a person who is not part of the issue. See [Allow external emails to be added as comments on issues](https://support.atlassian.com/jira-service-management-cloud/docs/allow-external-emails-to-be-added-as-comments-on-issues/)for information on setting up this feature.
    jsd-author-can-see-request: option<bool>,
    /// Whether the comment is visible in Jira Service Desk. Defaults to true when comments are created in the Jira Cloud Platform. This includes when the site doesn't use Jira Service Desk or the project isn't a Jira Service Desk project and, therefore, there is no Jira Service Desk for the issue to be visible on. To create a comment with its visibility in Jira Service Desk set to false, use the Jira Service Desk REST API [Create request comment](https://developer.atlassian.com/cloud/jira/service-desk/rest/#api-rest-servicedeskapi-request-issueIdOrKey-comment-post) operation.
    jsd-public: option<bool>,
    /// A list of comment properties. Optional on create and update.
    properties: option<list<entity-property>>,
    /// The rendered version of the comment.
    rendered-body: option<string>,
    /// The URL of the comment.
    self: option<string>,
    /// The ID of the user who updated the comment last.
    update-author: option<user-details>,
    /// The date and time at which the comment was updated last.
    updated: option<string>,
    /// The group or role to which this comment is visible. Optional on create and update.
    visibility: option<visibility>
  }
  update-comment: func(params: update-comment-params) -> result<comment, update-comment-error>;

  /// Delete comment
  record delete-comment-params {
    /// The ID or key of the issue.
    issue-id-or-key: string,
    /// The ID of the comment.
    id: string
  }
  delete-comment: func(params: delete-comment-params) -> result<string, delete-comment-error>;

}

interface issue-comment-properties {
  /// List of property keys.
  record property-keys {
    /// Property key details.
    keys: option<list<property-key>>
  }

  /// Property key details.
  record property-key {
    /// The key of the property.
    key: option<string>,
    /// The URL of the property.
    self: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  variant get-comment-property-keys-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-comment-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-comment-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-comment-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get comment property keys
  record get-comment-property-keys-params {
    /// The ID of the comment.
    comment-id: string
  }
  get-comment-property-keys: func(params: get-comment-property-keys-params) -> result<property-keys, get-comment-property-keys-error>;

  /// Get comment property
  record get-comment-property-params {
    /// The ID of the comment.
    comment-id: string,
    /// The key of the property.
    property-key: string
  }
  get-comment-property: func(params: get-comment-property-params) -> result<entity-property, get-comment-property-error>;

  /// Set comment property
  record set-comment-property-params {
    /// The ID of the comment.
    comment-id: string,
    /// The key of the property. The maximum length is 255 characters.
    property-key: string,
    body: string
  }
  set-comment-property: func(params: set-comment-property-params) -> result<string, set-comment-property-error>;

  /// Delete comment property
  record delete-comment-property-params {
    /// The ID of the comment.
    comment-id: string,
    /// The key of the property.
    property-key: string
  }
  delete-comment-property: func(params: delete-comment-property-params) -> result<string, delete-comment-property-error>;

}

interface project-components {
  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  enum project-component-assignee-type-enum {
    project-default,
    component-lead,
    project-lead,
    unassigned,
  }

  enum get-project-components-paginated-order-by-enum {
    description,
    description-v2,
    description-v3,
    issue-count,
    issue-count-v2,
    issue-count-v3,
    lead,
    lead-v2,
    lead-v3,
    name,
    name-v2,
    name-v3,
  }

  /// Details about a project component.
  record project-component {
    /// The details of the user associated with `assigneeType`, if any. See `realAssignee` for details of the user assigned to issues created with this component.
    assignee: option<user>,
    /// The nominal user type used to determine the assignee for issues created with this component. See `realAssigneeType` for details on how the type of the user, and hence the user, assigned to issues is determined. Can take the following values:
    /// 
    assignee-type: option<project-component-assignee-type-enum>,
    /// The description for the component. Optional when creating or updating a component.
    description: option<string>,
    /// The unique identifier for the component.
    id: option<string>,
    /// Whether a user is associated with `assigneeType`. For example, if the `assigneeType` is set to `COMPONENT_LEAD` but the component lead is not set, then `false` is returned.
    is-assignee-type-valid: option<bool>,
    /// The user details for the component's lead user.
    lead: option<user>,
    /// The accountId of the component's lead user. The accountId uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    lead-account-id: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    lead-user-name: option<string>,
    /// The unique name for the component in the project. Required when creating a component. Optional when updating a component. The maximum length is 255 characters.
    name: option<string>,
    /// The key of the project the component is assigned to. Required when creating a component. Can't be updated.
    project: option<string>,
    /// The ID of the project the component is assigned to.
    project-id: option<s64>,
    /// The user assigned to issues created with this component, when `assigneeType` does not identify a valid assignee.
    real-assignee: option<user>,
    /// The type of the assignee that is assigned to issues created with this component, when an assignee cannot be set from the `assigneeType`. For example, `assigneeType` is set to `COMPONENT_LEAD` but no component lead is set. This property is set to one of the following values:
    /// 
    real-assignee-type: option<project-component-assignee-type-enum>,
    /// The URL of the component.
    self: option<string>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Count of issues assigned to a component.
  record component-issues-count {
    /// The count of issues assigned to a component.
    issue-count: option<s64>,
    /// The URL for this count of issues for a component.
    self: option<string>
  }

  /// A page of items.
  record page-bean-component-with-issue-count {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<component-with-issue-count>>
  }

  /// Details about a component with a count of the issues it contains.
  record component-with-issue-count {
    /// The details of the user associated with `assigneeType`, if any. See `realAssignee` for details of the user assigned to issues created with this component.
    assignee: option<user>,
    /// The nominal user type used to determine the assignee for issues created with this component. See `realAssigneeType` for details on how the type of the user, and hence the user, assigned to issues is determined. Takes the following values:
    /// 
    assignee-type: option<project-component-assignee-type-enum>,
    /// The description for the component.
    description: option<string>,
    /// The unique identifier for the component.
    id: option<string>,
    /// Whether a user is associated with `assigneeType`. For example, if the `assigneeType` is set to `COMPONENT_LEAD` but the component lead is not set, then `false` is returned.
    is-assignee-type-valid: option<bool>,
    /// Count of issues for the component.
    issue-count: option<s64>,
    /// The user details for the component's lead user.
    lead: option<user>,
    /// The name for the component.
    name: option<string>,
    /// The key of the project to which the component is assigned.
    project: option<string>,
    /// Not used.
    project-id: option<s64>,
    /// The user assigned to issues created with this component, when `assigneeType` does not identify a valid assignee.
    real-assignee: option<user>,
    /// The type of the assignee that is assigned to issues created with this component, when an assignee cannot be set from the `assigneeType`. For example, `assigneeType` is set to `COMPONENT_LEAD` but no component lead is set. This property is set to one of the following values:
    /// 
    real-assignee-type: option<project-component-assignee-type-enum>,
    /// The URL for this count of the issues contained in the component.
    self: option<string>
  }

  variant create-component-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-component-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-component-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-component-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-component-related-issues-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-project-components-paginated-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-project-components-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Create component
  record create-component-params {
    /// The details of the user associated with `assigneeType`, if any. See `realAssignee` for details of the user assigned to issues created with this component.
    assignee: option<user>,
    /// The nominal user type used to determine the assignee for issues created with this component. See `realAssigneeType` for details on how the type of the user, and hence the user, assigned to issues is determined. Can take the following values:
    /// 
    assignee-type: option<project-component-assignee-type-enum>,
    /// The description for the component. Optional when creating or updating a component.
    description: option<string>,
    /// The unique identifier for the component.
    id: option<string>,
    /// Whether a user is associated with `assigneeType`. For example, if the `assigneeType` is set to `COMPONENT_LEAD` but the component lead is not set, then `false` is returned.
    is-assignee-type-valid: option<bool>,
    /// The user details for the component's lead user.
    lead: option<user>,
    /// The accountId of the component's lead user. The accountId uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    lead-account-id: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    lead-user-name: option<string>,
    /// The unique name for the component in the project. Required when creating a component. Optional when updating a component. The maximum length is 255 characters.
    name: option<string>,
    /// The key of the project the component is assigned to. Required when creating a component. Can't be updated.
    project: option<string>,
    /// The ID of the project the component is assigned to.
    project-id: option<s64>,
    /// The user assigned to issues created with this component, when `assigneeType` does not identify a valid assignee.
    real-assignee: option<user>,
    /// The type of the assignee that is assigned to issues created with this component, when an assignee cannot be set from the `assigneeType`. For example, `assigneeType` is set to `COMPONENT_LEAD` but no component lead is set. This property is set to one of the following values:
    /// 
    real-assignee-type: option<project-component-assignee-type-enum>,
    /// The URL of the component.
    self: option<string>
  }
  create-component: func(params: create-component-params) -> result<project-component, create-component-error>;

  /// Get component
  record get-component-params {
    /// The ID of the component.
    id: string
  }
  get-component: func(params: get-component-params) -> result<project-component, get-component-error>;

  /// Update component
  record update-component-params {
    /// The ID of the component.
    id: string,
    /// The details of the user associated with `assigneeType`, if any. See `realAssignee` for details of the user assigned to issues created with this component.
    assignee: option<user>,
    /// The nominal user type used to determine the assignee for issues created with this component. See `realAssigneeType` for details on how the type of the user, and hence the user, assigned to issues is determined. Can take the following values:
    /// 
    assignee-type: option<project-component-assignee-type-enum>,
    /// The description for the component. Optional when creating or updating a component.
    description: option<string>,
    /// The unique identifier for the component.
    id-v2: option<string>,
    /// Whether a user is associated with `assigneeType`. For example, if the `assigneeType` is set to `COMPONENT_LEAD` but the component lead is not set, then `false` is returned.
    is-assignee-type-valid: option<bool>,
    /// The user details for the component's lead user.
    lead: option<user>,
    /// The accountId of the component's lead user. The accountId uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    lead-account-id: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    lead-user-name: option<string>,
    /// The unique name for the component in the project. Required when creating a component. Optional when updating a component. The maximum length is 255 characters.
    name: option<string>,
    /// The key of the project the component is assigned to. Required when creating a component. Can't be updated.
    project: option<string>,
    /// The ID of the project the component is assigned to.
    project-id: option<s64>,
    /// The user assigned to issues created with this component, when `assigneeType` does not identify a valid assignee.
    real-assignee: option<user>,
    /// The type of the assignee that is assigned to issues created with this component, when an assignee cannot be set from the `assigneeType`. For example, `assigneeType` is set to `COMPONENT_LEAD` but no component lead is set. This property is set to one of the following values:
    /// 
    real-assignee-type: option<project-component-assignee-type-enum>,
    /// The URL of the component.
    self: option<string>
  }
  update-component: func(params: update-component-params) -> result<project-component, update-component-error>;

  /// Delete component
  record delete-component-params {
    /// The ID of the component.
    id: string,
    /// The ID of the component to replace the deleted component. If this value is null no replacement is made.
    move-issues-to: option<string>
  }
  delete-component: func(params: delete-component-params) -> result<string, delete-component-error>;

  /// Get component issues count
  record get-component-related-issues-params {
    /// The ID of the component.
    id: string
  }
  get-component-related-issues: func(params: get-component-related-issues-params) -> result<component-issues-count, get-component-related-issues-error>;

  /// Get project components paginated
  record get-project-components-paginated-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-project-components-paginated-order-by-enum>,
    /// Filter the results using a literal string. Components with a matching `name` or `description` are returned (case insensitive).
    query: option<string>
  }
  get-project-components-paginated: func(params: get-project-components-paginated-params) -> result<page-bean-component-with-issue-count, get-project-components-paginated-error>;

  /// Get project components
  record get-project-components-params {
    /// The project ID or project key (case sensitive).
    project-id-or-key: string
  }
  get-project-components: func(params: get-project-components-params) -> result<list<project-component>, get-project-components-error>;

}

interface time-tracking {
  enum configuration-default-unit-enum {
    minute,
    hour,
    day,
    week,
  }

  enum configuration-time-format-enum {
    pretty,
    days,
    hours,
  }

  /// Details about the time tracking provider.
  record provider {
    /// The key for the time tracking provider. For example, *JIRA*.
    key: string,
    /// The name of the time tracking provider. For example, *JIRA provided time tracking*.
    name: option<string>,
    /// The URL of the configuration page for the time tracking provider app. For example, */example/config/url*. This property is only returned if the `adminPageKey` property is set in the module descriptor of the time tracking provider app.
    url: option<string>
  }

  /// Details of the time tracking configuration.
  record configuration {
    /// The default unit of time applied to logged time.
    default-unit: configuration-default-unit-enum,
    /// The format that will appear on an issue's *Time Spent* field.
    time-format: configuration-time-format-enum,
    /// The number of days in a working week.
    working-days-per-week: f64,
    /// The number of hours in a working day.
    working-hours-per-day: f64
  }

  variant get-selected-time-tracking-implementation-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant select-time-tracking-implementation-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-available-time-tracking-implementations-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-shared-time-tracking-configuration-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant set-shared-time-tracking-configuration-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  /// Get selected time tracking provider
  get-selected-time-tracking-implementation: func() -> result<provider, get-selected-time-tracking-implementation-error>;

  /// Select time tracking provider
  record select-time-tracking-implementation-params {
    /// The key for the time tracking provider. For example, *JIRA*.
    key: string,
    /// The name of the time tracking provider. For example, *JIRA provided time tracking*.
    name: option<string>,
    /// The URL of the configuration page for the time tracking provider app. For example, */example/config/url*. This property is only returned if the `adminPageKey` property is set in the module descriptor of the time tracking provider app.
    url: option<string>
  }
  select-time-tracking-implementation: func(params: select-time-tracking-implementation-params) -> result<string, select-time-tracking-implementation-error>;

  /// Get all time tracking providers
  get-available-time-tracking-implementations: func() -> result<list<provider>, get-available-time-tracking-implementations-error>;

  /// Get time tracking settings
  get-shared-time-tracking-configuration: func() -> result<configuration, get-shared-time-tracking-configuration-error>;

  /// Set time tracking settings
  record set-shared-time-tracking-configuration-params {
    /// The default unit of time applied to logged time.
    default-unit: configuration-default-unit-enum,
    /// The format that will appear on an issue's *Time Spent* field.
    time-format: configuration-time-format-enum,
    /// The number of days in a working week.
    working-days-per-week: f64,
    /// The number of hours in a working day.
    working-hours-per-day: f64
  }
  set-shared-time-tracking-configuration: func(params: set-shared-time-tracking-configuration-params) -> result<configuration, set-shared-time-tracking-configuration-error>;

}

interface issue-custom-field-options {
  enum order-of-custom-field-options-position-enum {
    first,
    last,
  }

  /// Details of a custom option for a field.
  record custom-field-option {
    /// The URL of these custom field option details.
    self: option<string>,
    /// The value of the custom field option.
    value: option<string>
  }

  /// A page of items.
  record page-bean-custom-field-context-option {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<custom-field-context-option>>
  }

  /// Details of the custom field options for a context.
  record custom-field-context-option {
    /// Whether the option is disabled.
    disabled: bool,
    /// The ID of the custom field option.
    id: string,
    /// For cascading options, the ID of the custom field option containing the cascading option.
    option-id: option<string>,
    /// The value of the custom field option.
    value: string
  }

  /// Details of a custom field option to create.
  record custom-field-option-create {
    /// Whether the option is disabled.
    disabled: option<bool>,
    /// For cascading options, the ID of the custom field object containing the cascading option.
    option-id: option<string>,
    /// The value of the custom field option.
    value: string
  }

  /// A list of custom field options for a context.
  record custom-field-created-context-options-list {
    /// The created custom field options.
    options: option<list<custom-field-context-option>>
  }

  /// Details of a custom field option for a context.
  record custom-field-option-update {
    /// Whether the option is disabled.
    disabled: option<bool>,
    /// The ID of the custom field option.
    id: string,
    /// The value of the custom field option.
    value: option<string>
  }

  /// A list of custom field options for a context.
  record custom-field-updated-context-options-list {
    /// The updated custom field options.
    options: option<list<custom-field-option-update>>
  }

  variant get-custom-field-option-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-options-for-context-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-custom-field-option-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-custom-field-option-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant reorder-custom-field-options-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-custom-field-option-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get custom field option
  record get-custom-field-option-params {
    /// The ID of the custom field option.
    id: string
  }
  get-custom-field-option: func(params: get-custom-field-option-params) -> result<custom-field-option, get-custom-field-option-error>;

  /// Get custom field options (context)
  record get-options-for-context-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// The ID of the option.
    option-id: option<s64>,
    /// Whether only options are returned.
    only-options: option<bool>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-options-for-context: func(params: get-options-for-context-params) -> result<page-bean-custom-field-context-option, get-options-for-context-error>;

  /// Create custom field options (context)
  record create-custom-field-option-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// Details of options to create.
    options: option<list<custom-field-option-create>>
  }
  create-custom-field-option: func(params: create-custom-field-option-params) -> result<custom-field-created-context-options-list, create-custom-field-option-error>;

  /// Update custom field options (context)
  record update-custom-field-option-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// Details of the options to update.
    options: option<list<custom-field-option-update>>
  }
  update-custom-field-option: func(params: update-custom-field-option-params) -> result<custom-field-updated-context-options-list, update-custom-field-option-error>;

  /// Reorder custom field options (context)
  record reorder-custom-field-options-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context.
    context-id: string,
    /// The ID of the custom field option or cascading option to place the moved options after. Required if `position` isn't provided.
    after: option<string>,
    /// A list of IDs of custom field options to move. The order of the custom field option IDs in the list is the order they are given after the move. The list must contain custom field options or cascading options, but not both.
    custom-field-option-ids: list<string>,
    /// The position the custom field options should be moved to. Required if `after` isn't provided.
    position: option<order-of-custom-field-options-position-enum>
  }
  reorder-custom-field-options: func(params: reorder-custom-field-options-params) -> result<string, reorder-custom-field-options-error>;

  /// Delete custom field options (context)
  record delete-custom-field-option-params {
    /// The ID of the custom field.
    field-id: string,
    /// The ID of the context from which an option should be deleted.
    context-id: string,
    /// The ID of the option to delete.
    option-id: string
  }
  delete-custom-field-option: func(params: delete-custom-field-option-params) -> result<string, delete-custom-field-option-error>;

}

interface dashboards {
  enum get-all-dashboards-filter-enum {
    my,
    favourite,
  }

  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  enum project-assignee-type-enum {
    project-lead,
    unassigned,
  }

  enum project-component-assignee-type-enum {
    project-default,
    component-lead,
    project-lead,
    unassigned,
  }

  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum project-style-enum {
    classic,
    next-gen,
  }

  enum role-actor-type-op-enum {
    atlassian-group-role-actor,
    atlassian-user-role-actor,
  }

  enum share-permission-type-op-enum {
    user,
    group,
    project,
    project-role,
    global,
    loggedin,
    authenticated,
    project-unknown,
  }

  enum get-dashboards-paginated-order-by-enum {
    description,
    description-v2,
    description-v3,
    favorite-count,
    favorite-count-v2,
    favorite-count-v3,
    id,
    id-v2,
    id-v3,
    is-favorite,
    is-favorite-v2,
    is-favorite-v3,
    name,
    name-v2,
    name-v3,
    owner,
    owner-v2,
    owner-v3,
  }

  enum get-dashboards-paginated-status-enum {
    active,
    archived,
    deleted,
  }

  enum dashboard-gadget-color-enum {
    blue,
    red,
    yellow,
    green,
    cyan,
    purple,
    gray,
    white,
  }

  /// A page containing dashboard details.
  record page-of-dashboards {
    /// List of dashboards.
    dashboards: option<list<dashboard>>,
    /// The maximum number of results that could be on the page.
    max-results: option<s32>,
    /// The URL of the next page of results, if any.
    next: option<string>,
    /// The URL of the previous page of results, if any.
    prev: option<string>,
    /// The index of the first item returned on the page.
    start-at: option<s32>,
    /// The number of results on the page.
    total: option<s32>
  }

  /// Details of a dashboard.
  record dashboard {
    /// The automatic refresh interval for the dashboard in milliseconds.
    automatic-refresh-ms: option<s32>,
    description: option<string>,
    /// The details of any edit share permissions for the dashboard.
    edit-permissions: option<list<share-permission>>,
    /// The ID of the dashboard.
    id: option<string>,
    /// Whether the dashboard is selected as a favorite by the user.
    is-favourite: option<bool>,
    /// Whether the current user has permission to edit the dashboard.
    is-writable: option<bool>,
    /// The name of the dashboard.
    name: option<string>,
    /// The owner of the dashboard.
    owner: option<user-bean>,
    /// The number of users who have this dashboard as a favorite.
    popularity: option<s64>,
    /// The rank of this dashboard.
    rank: option<s32>,
    /// The URL of these dashboard details.
    self: option<string>,
    /// The details of any view share permissions for the dashboard.
    share-permissions: option<list<share-permission>>,
    /// Whether the current dashboard is system dashboard.
    system-dashboard: option<bool>,
    /// The URL of the dashboard.
    view: option<string>
  }

  /// Details of a share permission for the filter.
  record share-permission {
    /// The group that the filter is shared with. For a request, specify the `groupId` or `name` property for the group. As a group's name can change, use of `groupId` is recommended.
    group: option<group-name>,
    /// The unique identifier of the share permission.
    id: option<s64>,
    /// The project that the filter is shared with. This is similar to the project object returned by [Get project](#api-rest-api-3-project-projectIdOrKey-get) but it contains a subset of the properties, which are: `self`, `id`, `key`, `assigneeType`, `name`, `roles`, `avatarUrls`, `projectType`, `simplified`.  
    /// For a request, specify the `id` for the project.
    project: option<project>,
    /// The project role that the filter is shared with.  
    /// For a request, specify the `id` for the role. You must also specify the `project` object and `id` for the project that the role is in.
    role: option<project-role>,
    /// The type of share permission:
    /// 
    type-op: share-permission-type-op-enum,
    /// The user account ID that the filter is shared with. For a request, specify the `accountId` property for the user.
    user: option<user-bean>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  /// Details about a project.
  record project {
    /// Whether the project is archived.
    archived: option<bool>,
    /// The user who archived the project.
    archived-by: option<user>,
    /// The date when the project was archived.
    archived-date: option<string>,
    /// The default assignee when creating issues for this project.
    assignee-type: option<project-assignee-type-enum>,
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// List of the components contained in the project.
    components: option<list<project-component>>,
    /// Whether the project is marked as deleted.
    deleted: option<bool>,
    /// The user who marked the project as deleted.
    deleted-by: option<user>,
    /// The date when the project was marked as deleted.
    deleted-date: option<string>,
    /// A brief description of the project.
    description: option<string>,
    /// An email address associated with the project.
    email: option<string>,
    /// Expand options that include additional project details in the response.
    expand: option<string>,
    /// Whether the project is selected as a favorite.
    favourite: option<bool>,
    /// The ID of the project.
    id: option<string>,
    /// Insights about the project.
    insight: option<project-insight>,
    /// Whether the project is private.
    is-private: option<bool>,
    /// The issue type hierarchy for the project.
    issue-type-hierarchy: option<hierarchy>,
    /// List of the issue types available in the project.
    issue-types: option<list<issue-type-details>>,
    /// The key of the project.
    key: option<string>,
    /// The project landing page info.
    landing-page-info: option<project-landing-page-info>,
    /// The username of the project lead.
    lead: option<user>,
    /// The name of the project.
    name: option<string>,
    /// User permissions on the project
    permissions: option<project-permissions>,
    /// The category the project belongs to.
    project-category: option<project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// Map of project properties
    properties: option<project-properties>,
    /// The date when the project is deleted permanently.
    retention-till-date: option<string>,
    /// The name and self URL for each role defined in the project. For more information, see [Create project role](#api-rest-api-3-role-post).
    roles: option<project-roles>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether the project is simplified.
    simplified: option<bool>,
    /// The type of the project.
    style: option<project-style-enum>,
    /// A link to information about this project, such as project documentation.
    url: option<string>,
    /// Unique ID for next-gen projects.
    uuid: option<string>,
    /// The versions defined in the project. For more information, see [Create version](#api-rest-api-3-version-post).
    versions: option<list<version>>
  }

  /// A user with details as permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Required in requests.
    account-id: option<string>,
    /// The user account type. Can take the following values:
    /// 
    account-type: option<user-account-type-enum>,
    /// Whether the user is active.
    active: option<bool>,
    /// The application roles the user is assigned to.
    application-roles: option<simple-list-wrapper-application-role>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy setting, this may be returned as null.
    email-address: option<string>,
    /// Expand options that include additional user details in the response.
    expand: option<string>,
    /// The groups that the user belongs to.
    groups: option<simple-list-wrapper-group-name>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// The locale of the user. Depending on the user’s privacy setting, this may be returned as null.
    locale: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy setting, this may be returned as null.
    time-zone: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a project component.
  record project-component {
    /// The details of the user associated with `assigneeType`, if any. See `realAssignee` for details of the user assigned to issues created with this component.
    assignee: option<user>,
    /// The nominal user type used to determine the assignee for issues created with this component. See `realAssigneeType` for details on how the type of the user, and hence the user, assigned to issues is determined. Can take the following values:
    /// 
    assignee-type: option<project-component-assignee-type-enum>,
    /// The description for the component. Optional when creating or updating a component.
    description: option<string>,
    /// The unique identifier for the component.
    id: option<string>,
    /// Whether a user is associated with `assigneeType`. For example, if the `assigneeType` is set to `COMPONENT_LEAD` but the component lead is not set, then `false` is returned.
    is-assignee-type-valid: option<bool>,
    /// The user details for the component's lead user.
    lead: option<user>,
    /// The accountId of the component's lead user. The accountId uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    lead-account-id: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    lead-user-name: option<string>,
    /// The unique name for the component in the project. Required when creating a component. Optional when updating a component. The maximum length is 255 characters.
    name: option<string>,
    /// The key of the project the component is assigned to. Required when creating a component. Can't be updated.
    project: option<string>,
    /// The ID of the project the component is assigned to.
    project-id: option<s64>,
    /// The user assigned to issues created with this component, when `assigneeType` does not identify a valid assignee.
    real-assignee: option<user>,
    /// The type of the assignee that is assigned to issues created with this component, when an assignee cannot be set from the `assigneeType`. For example, `assigneeType` is set to `COMPONENT_LEAD` but no component lead is set. This property is set to one of the following values:
    /// 
    real-assignee-type: option<project-component-assignee-type-enum>,
    /// The URL of the component.
    self: option<string>
  }

  /// Additional details about a project.
  record project-insight {
    /// The last issue update time.
    last-issue-update-time: option<string>,
    /// Total issue count.
    total-issue-count: option<s64>
  }

  /// The project issue type hierarchy.
  record hierarchy {
    /// The ID of the base level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    base-level-id: option<s64>,
    /// Details about the hierarchy level.
    levels: option<list<simplified-hierarchy-level>>
  }

  record simplified-hierarchy-level {
    /// The ID of the level above this one in the hierarchy. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    above-level-id: option<s64>,
    /// The ID of the level below this one in the hierarchy. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    below-level-id: option<s64>,
    /// The external UUID of the hierarchy level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    external-uuid: option<string>,
    hierarchy-level-number: option<s32>,
    /// The ID of the hierarchy level. This property is deprecated, see [Change notice: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    id: option<s64>,
    /// The issue types available in this hierarchy level.
    issue-type-ids: option<list<s64>>,
    /// The level of this item in the hierarchy.
    level: option<s32>,
    /// The name of this hierarchy level.
    name: option<string>,
    /// The ID of the project configuration. This property is deprecated, see [Change oticen: Removing hierarchy level IDs from next-gen APIs](https://developer.atlassian.com/cloud/jira/platform/change-notice-removing-hierarchy-level-ids-from-next-gen-apis/).
    project-configuration-id: option<s64>
  }

  /// Details about an issue type.
  record issue-type-details {
    /// The ID of the issue type's avatar.
    avatar-id: option<s64>,
    /// The description of the issue type.
    description: option<string>,
    /// Unique ID for next-gen projects.
    entity-id: option<string>,
    /// Hierarchy level of the issue type.
    hierarchy-level: option<s32>,
    /// The URL of the issue type's avatar.
    icon-url: option<string>,
    /// The ID of the issue type.
    id: option<string>,
    /// The name of the issue type.
    name: option<string>,
    /// Details of the next-gen projects the issue type is available in.
    scope: option<scope>,
    /// The URL of these issue type details.
    self: option<string>,
    /// Whether this issue type is used to create subtasks.
    subtask: option<bool>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  record project-landing-page-info {
    attributes: option<project-landing-page-info-attributes>,
    board-id: option<s64>,
    board-name: option<string>,
    project-key: option<string>,
    project-type: option<string>,
    queue-category: option<string>,
    queue-id: option<s64>,
    queue-name: option<string>,
    simple-board: option<bool>,
    simplified: option<bool>,
    url: option<string>
  }

  record project-landing-page-info-attributes {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Permissions which a user has on a project.
  record project-permissions {
    /// Whether the logged user can edit the project.
    can-edit: option<bool>
  }

  /// A project category.
  record project-category {
    /// The description of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The name of the project category. Required on create, optional on update.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// Map of project properties
  record project-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The name and self URL for each role defined in the project. For more information, see [Create project role](#api-rest-api-3-role-post).
  record project-roles {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a project version.
  record version {
    /// Indicates that the version is archived. Optional when creating or updating a version.
    archived: option<bool>,
    /// The description of the version. Optional when creating or updating a version.
    description: option<string>,
    /// Use [expand](em>#expansion) to include additional information about version in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>,
    /// The ID of the version.
    id: option<string>,
    /// If the expand option `issuesstatus` is used, returns the count of issues in this version for each of the status categories *to do*, *in progress*, *done*, and *unmapped*. The *unmapped* property contains a count of issues with a status other than *to do*, *in progress*, and *done*.
    issues-status-for-fix-version: option<version-issues-status>,
    /// The URL of the self link to the version to which all unfixed issues are moved when a version is released. Not applicable when creating a version. Optional when updating a version.
    move-unfixed-issues-to: option<string>,
    /// The unique name of the version. Required when creating a version. Optional when updating a version. The maximum length is 255 characters.
    name: option<string>,
    /// If the expand option `operations` is used, returns the list of operations available for this version.
    operations: option<list<simple-link>>,
    /// Indicates that the version is overdue.
    overdue: option<bool>,
    /// Deprecated. Use `projectId`.
    project: option<string>,
    /// The ID of the project to which this version is attached. Required when creating a version. Not applicable when updating a version.
    project-id: option<s64>,
    /// The release date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    release-date: option<string>,
    /// Indicates that the version is released. If the version is released a request to release again is ignored. Not applicable when creating a version. Optional when updating a version.
    released: option<bool>,
    /// The URL of the version.
    self: option<string>,
    /// The start date of the version. Expressed in ISO 8601 format (yyyy-mm-dd). Optional when creating or updating a version.
    start-date: option<string>,
    /// The date on which work on this version is expected to finish, expressed in the instance's *Day/Month/Year Format* date format.
    user-release-date: option<string>,
    /// The date on which work on this version is expected to start, expressed in the instance's *Day/Month/Year Format* date format.
    user-start-date: option<string>
  }

  /// Counts of the number of issues in various statuses.
  record version-issues-status {
    /// Count of issues with status *done*.
    done: option<s64>,
    /// Count of issues with status *in progress*.
    in-progress: option<s64>,
    /// Count of issues with status *to do*.
    to-do: option<s64>,
    /// Count of issues with a status other than *to do*, *in progress*, and *done*.
    unmapped: option<s64>
  }

  /// Details about the operations available in this version.
  record simple-link {
    href: option<string>,
    icon-class: option<string>,
    id: option<string>,
    label: option<string>,
    style-class: option<string>,
    title: option<string>,
    weight: option<s32>
  }

  /// Details about the roles in a project.
  record project-role {
    /// The list of users who act in this role.
    actors: option<list<role-actor>>,
    /// Whether this role is the admin role for the project.
    admin: option<bool>,
    /// Whether the calling user is part of this role.
    current-user-role: option<bool>,
    /// Whether this role is the default role for the project
    default: option<bool>,
    /// The description of the project role.
    description: option<string>,
    /// The ID of the project role.
    id: option<s64>,
    /// The name of the project role.
    name: option<string>,
    /// Whether the roles are configurable for this project.
    role-configurable: option<bool>,
    /// The scope of the role. Indicated for roles associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
    scope: option<scope>,
    /// The URL the project role details.
    self: option<string>,
    /// The translated name of the project role.
    translated-name: option<string>
  }

  /// Details about a user assigned to a project role.
  record role-actor {
    actor-group: option<project-role-group>,
    actor-user: option<project-role-user>,
    /// The avatar of the role actor.
    avatar-url: option<string>,
    /// The display name of the role actor. For users, depending on the user’s privacy setting, this may return an alternative value for the user's name.
    display-name: option<string>,
    /// The ID of the role actor.
    id: option<s64>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The type of role actor.
    type-op: option<role-actor-type-op-enum>
  }

  /// Details of the group associated with the role.
  record project-role-group {
    /// The display name of the group.
    display-name: option<string>,
    /// The ID of the group.
    group-id: option<string>,
    /// The name of the group. As a group's name can change, use of `groupId` is recommended to identify the group.
    name: option<string>
  }

  /// Details of the user associated with the role.
  record project-role-user {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*. Returns *unknown* if the record is deleted and corrupted, for example, as the result of a server import.
    account-id: option<string>
  }

  record user-bean {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<user-bean-avatar-urls>,
    /// The display name of the user. Depending on the user’s privacy setting, this may return an alternative value.
    display-name: option<string>,
    /// This property is deprecated in favor of `accountId` because of privacy changes. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.  
    /// The key of the user.
    key: option<string>,
    /// This property is deprecated in favor of `accountId` because of privacy changes. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.  
    /// The username of the user.
    name: option<string>,
    /// The URL of the user.
    self: option<string>
  }

  record user-bean-avatar-urls {
    /// The URL of the user's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the user's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the user's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the user's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// The list of available gadgets.
  record available-dashboard-gadgets-response {
    /// The list of available gadgets.
    gadgets: list<available-dashboard-gadget>
  }

  /// The details of the available dashboard gadget.
  record available-dashboard-gadget {
    /// The module key of the gadget type.
    module-key: option<string>,
    /// The title of the gadget.
    title: string,
    /// The URI of the gadget type.
    uri: option<string>
  }

  /// A page of items.
  record page-bean-dashboard {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<dashboard>>
  }

  /// The list of gadgets on the dashboard.
  record dashboard-gadget-response {
    /// The list of gadgets.
    gadgets: list<dashboard-gadget>
  }

  /// Details of a gadget.
  record dashboard-gadget {
    /// The color of the gadget. Should be one of `blue`, `red`, `yellow`, `green`, `cyan`, `purple`, `gray`, or `white`.
    color: dashboard-gadget-color-enum,
    /// The ID of the gadget instance.
    id: s64,
    /// The module key of the gadget type.
    module-key: option<string>,
    /// The position of the gadget.
    position: dashboard-gadget-position,
    /// The title of the gadget.
    title: string,
    /// The URI of the gadget type.
    uri: option<string>
  }

  /// Details of a gadget position.
  record dashboard-gadget-position {
    the-column-position-of-the-gadget: s32,
    the-row-position-of-the-gadget: s32
  }

  /// List of property keys.
  record property-keys {
    /// Property key details.
    keys: option<list<property-key>>
  }

  /// Property key details.
  record property-key {
    /// The key of the property.
    key: option<string>,
    /// The URL of the property.
    self: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  variant get-all-dashboards-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant create-dashboard-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-all-available-dashboard-gadgets-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-dashboards-paginated-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-all-gadgets-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-gadget-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-gadget-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant remove-gadget-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-dashboard-item-property-keys-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-dashboard-item-property-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant set-dashboard-item-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-dashboard-item-property-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-dashboard-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant update-dashboard-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-dashboard-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant copy-dashboard-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get all dashboards
  record get-all-dashboards-params {
    /// The filter applied to the list of dashboards. Valid values are:
    /// 
    filter: option<get-all-dashboards-filter-enum>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s32>,
    /// The maximum number of items to return per page.
    max-results: option<s32>
  }
  get-all-dashboards: func(params: get-all-dashboards-params) -> result<page-of-dashboards, get-all-dashboards-error>;

  /// Create dashboard
  record create-dashboard-params {
    /// The description of the dashboard.
    description: option<string>,
    /// The edit permissions for the dashboard.
    edit-permissions: list<share-permission>,
    /// The name of the dashboard.
    name: string,
    /// The share permissions for the dashboard.
    share-permissions: list<share-permission>
  }
  create-dashboard: func(params: create-dashboard-params) -> result<dashboard, create-dashboard-error>;

  /// Get available gadgets
  get-all-available-dashboard-gadgets: func() -> result<available-dashboard-gadgets-response, get-all-available-dashboard-gadgets-error>;

  /// Search for dashboards
  record get-dashboards-paginated-params {
    /// String used to perform a case-insensitive partial match with `name`.
    dashboard-name: option<string>,
    /// User account ID used to return dashboards with the matching `owner.accountId`. This parameter cannot be used with the `owner` parameter.
    account-id: option<string>,
    /// This parameter is deprecated because of privacy changes. Use `accountId` instead. See the [migration guide](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details. User name used to return dashboards with the matching `owner.name`. This parameter cannot be used with the `accountId` parameter.
    owner: option<string>,
    /// As a group's name can change, use of `groupId` is recommended. Group name used to return dashboards that are shared with a group that matches `sharePermissions.group.name`. This parameter cannot be used with the `groupId` parameter.
    groupname: option<string>,
    /// Group ID used to return dashboards that are shared with a group that matches `sharePermissions.group.groupId`. This parameter cannot be used with the `groupname` parameter.
    group-id: option<string>,
    /// Project ID used to returns dashboards that are shared with a project that matches `sharePermissions.project.id`.
    project-id: option<s64>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-dashboards-paginated-order-by-enum>,
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The status to filter by. It may be active, archived or deleted.
    status: option<get-dashboards-paginated-status-enum>,
    /// Use [expand](#expansion) to include additional information about dashboard in the response. This parameter accepts a comma-separated list. Expand options include:
    /// 
    expand: option<string>
  }
  get-dashboards-paginated: func(params: get-dashboards-paginated-params) -> result<page-bean-dashboard, get-dashboards-paginated-error>;

  /// Get gadgets
  record get-all-gadgets-params {
    /// The ID of the dashboard.
    dashboard-id: string,
    /// The list of gadgets module keys. To include multiple module keys, separate module keys with ampersand: `moduleKey=key:one&moduleKey=key:two`.
    module-key: option<list<string>>,
    /// The list of gadgets URIs. To include multiple URIs, separate URIs with ampersand: `uri=/rest/example/uri/1&uri=/rest/example/uri/2`.
    uri: option<list<string>>,
    /// The list of gadgets IDs. To include multiple IDs, separate IDs with ampersand: `gadgetId=10000&gadgetId=10001`.
    gadget-id: option<list<s64>>
  }
  get-all-gadgets: func(params: get-all-gadgets-params) -> result<dashboard-gadget-response, get-all-gadgets-error>;

  /// Add gadget to dashboard
  record add-gadget-params {
    /// The ID of the dashboard.
    dashboard-id: string,
    /// The color of the gadget. Should be one of `blue`, `red`, `yellow`, `green`, `cyan`, `purple`, `gray`, or `white`.
    color: option<string>,
    /// Whether to ignore the validation of module key and URI. For example, when a gadget is created that is a part of an application that isn't installed.
    ignore-uri-and-module-key-validation: option<bool>,
    /// The module key of the gadget type. Can't be provided with `uri`.
    module-key: option<string>,
    /// The position of the gadget. When the gadget is placed into the position, other gadgets in the same column are moved down to accommodate it.
    position: option<dashboard-gadget-position>,
    /// The title of the gadget.
    title: option<string>,
    /// The URI of the gadget type. Can't be provided with `moduleKey`.
    uri: option<string>
  }
  add-gadget: func(params: add-gadget-params) -> result<dashboard-gadget, add-gadget-error>;

  /// Update gadget on dashboard
  record update-gadget-params {
    /// The ID of the dashboard.
    dashboard-id: string,
    /// The ID of the gadget.
    gadget-id: string,
    /// The color of the gadget. Should be one of `blue`, `red`, `yellow`, `green`, `cyan`, `purple`, `gray`, or `white`.
    color: option<string>,
    /// The position of the gadget.
    position: option<dashboard-gadget-position>,
    /// The title of the gadget.
    title: option<string>
  }
  update-gadget: func(params: update-gadget-params) -> result<string, update-gadget-error>;

  /// Remove gadget from dashboard
  record remove-gadget-params {
    /// The ID of the dashboard.
    dashboard-id: string,
    /// The ID of the gadget.
    gadget-id: string
  }
  remove-gadget: func(params: remove-gadget-params) -> result<string, remove-gadget-error>;

  /// Get dashboard item property keys
  record get-dashboard-item-property-keys-params {
    /// The ID of the dashboard.
    dashboard-id: string,
    /// The ID of the dashboard item.
    item-id: string
  }
  get-dashboard-item-property-keys: func(params: get-dashboard-item-property-keys-params) -> result<property-keys, get-dashboard-item-property-keys-error>;

  /// Get dashboard item property
  record get-dashboard-item-property-params {
    /// The ID of the dashboard.
    dashboard-id: string,
    /// The ID of the dashboard item.
    item-id: string,
    /// The key of the dashboard item property.
    property-key: string
  }
  get-dashboard-item-property: func(params: get-dashboard-item-property-params) -> result<entity-property, get-dashboard-item-property-error>;

  /// Set dashboard item property
  record set-dashboard-item-property-params {
    /// The ID of the dashboard.
    dashboard-id: string,
    /// The ID of the dashboard item.
    item-id: string,
    /// The key of the dashboard item property. The maximum length is 255 characters. For dashboard items with a spec URI and no complete module key, if the provided propertyKey is equal to "config", the request body's JSON must be an object with all keys and values as strings.
    property-key: string,
    body: string
  }
  set-dashboard-item-property: func(params: set-dashboard-item-property-params) -> result<string, set-dashboard-item-property-error>;

  /// Delete dashboard item property
  record delete-dashboard-item-property-params {
    /// The ID of the dashboard.
    dashboard-id: string,
    /// The ID of the dashboard item.
    item-id: string,
    /// The key of the dashboard item property.
    property-key: string
  }
  delete-dashboard-item-property: func(params: delete-dashboard-item-property-params) -> result<string, delete-dashboard-item-property-error>;

  /// Get dashboard
  record get-dashboard-params {
    /// The ID of the dashboard.
    id: string
  }
  get-dashboard: func(params: get-dashboard-params) -> result<dashboard, get-dashboard-error>;

  /// Update dashboard
  record update-dashboard-params {
    /// The ID of the dashboard to update.
    id: string,
    /// The description of the dashboard.
    description: option<string>,
    /// The edit permissions for the dashboard.
    edit-permissions: list<share-permission>,
    /// The name of the dashboard.
    name: string,
    /// The share permissions for the dashboard.
    share-permissions: list<share-permission>
  }
  update-dashboard: func(params: update-dashboard-params) -> result<dashboard, update-dashboard-error>;

  /// Delete dashboard
  record delete-dashboard-params {
    /// The ID of the dashboard.
    id: string
  }
  delete-dashboard: func(params: delete-dashboard-params) -> result<string, delete-dashboard-error>;

  /// Copy dashboard
  record copy-dashboard-params {
    id: string,
    /// The description of the dashboard.
    description: option<string>,
    /// The edit permissions for the dashboard.
    edit-permissions: list<share-permission>,
    /// The name of the dashboard.
    name: string,
    /// The share permissions for the dashboard.
    share-permissions: list<share-permission>
  }
  copy-dashboard: func(params: copy-dashboard-params) -> result<dashboard, copy-dashboard-error>;

}

interface issues {
  enum project-details-project-type-key-enum {
    software,
    service-desk,
    business,
  }

  enum scope-type-op-enum {
    project,
    template,
  }

  enum delete-issue-delete-subtasks-enum {
    true,
    false,
  }

  enum user-account-type-enum {
    atlassian,
    app,
    customer,
    unknown,
  }

  /// Details about an issue event.
  record issue-event {
    /// The ID of the event.
    id: option<s64>,
    /// The name of the event.
    name: option<string>
  }

  /// Details of an issue update request.
  record issue-update-details {
    /// List of issue screen fields to update, specifying the sub-field to update and its value for each field. This field provides a straightforward option when setting a sub-field. When multiple sub-fields or other operations are required, use `update`. Fields included in here cannot be included in `update`.
    fields: option<issue-update-details-fields>,
    /// Additional issue history details.
    history-metadata: option<history-metadata>,
    /// Details of issue properties to be add or update.
    properties: option<list<entity-property>>,
    /// Details of a transition. Required when performing a transition, optional when creating or editing an issue.
    transition: option<issue-transition>,
    /// A Map containing the field field name and a list of operations to perform on the issue screen field. Note that fields included in here cannot be included in `fields`.
    update: option<issue-update-details-update>
  }

  /// List of issue screen fields to update, specifying the sub-field to update and its value for each field. This field provides a straightforward option when setting a sub-field. When multiple sub-fields or other operations are required, use `update`. Fields included in here cannot be included in `update`.
  record issue-update-details-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of issue history metadata.
  record history-metadata {
    /// The activity described in the history record.
    activity-description: option<string>,
    /// The key of the activity described in the history record.
    activity-description-key: option<string>,
    /// Details of the user whose action created the history record.
    actor: option<history-metadata-participant>,
    /// Details of the cause that triggered the creation the history record.
    cause: option<history-metadata-participant>,
    /// The description of the history record.
    description: option<string>,
    /// The description key of the history record.
    description-key: option<string>,
    /// The description of the email address associated the history record.
    email-description: option<string>,
    /// The description key of the email address associated the history record.
    email-description-key: option<string>,
    /// Additional arbitrary information about the history record.
    extra-data: option<history-metadata-extra-data>,
    /// Details of the system that generated the history record.
    generator: option<history-metadata-participant>,
    /// The type of the history record.
    type-op: option<string>
  }

  /// Details of user or system associated with a issue history metadata item.
  record history-metadata-participant {
    /// The URL to an avatar for the user or system associated with a history record.
    avatar-url: option<string>,
    /// The display name of the user or system associated with a history record.
    display-name: option<string>,
    /// The key of the display name of the user or system associated with a history record.
    display-name-key: option<string>,
    /// The ID of the user or system associated with a history record.
    id: option<string>,
    /// The type of the user or system associated with a history record.
    type-op: option<string>,
    /// The URL of the user or system associated with a history record.
    url: option<string>
  }

  /// Additional arbitrary information about the history record.
  record history-metadata-extra-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// An entity property, for more information see [Entity properties](https://developer.atlassian.com/cloud/jira/platform/jira-entity-properties/).
  record entity-property {
    /// The key of the property. Required on create and update.
    key: option<string>,
    /// The value of the property. Required on create and update.
    value: option<string>
  }

  /// Details of an issue transition.
  record issue-transition {
    /// Expand options that include additional transition details in the response.
    expand: option<string>,
    /// Details of the fields associated with the issue transition screen. Use this information to populate `fields` and `update` in a transition request.
    fields: option<issue-transition-fields>,
    /// Whether there is a screen associated with the issue transition.
    has-screen: option<bool>,
    /// The ID of the issue transition. Required when specifying a transition to undertake.
    id: option<string>,
    /// Whether the transition is available to be performed.
    is-available: option<bool>,
    /// Whether the issue has to meet criteria before the issue transition is applied.
    is-conditional: option<bool>,
    /// Whether the issue transition is global, that is, the transition is applied to issues regardless of their status.
    is-global: option<bool>,
    /// Whether this is the initial issue transition for the workflow.
    is-initial: option<bool>,
    looped: option<bool>,
    /// The name of the issue transition.
    name: option<string>,
    /// Details of the issue status after the transition.
    to: option<status-details>
  }

  /// Details of the fields associated with the issue transition screen. Use this information to populate `fields` and `update` in a transition request.
  record issue-transition-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A status.
  record status-details {
    /// The description of the status.
    description: option<string>,
    /// The URL of the icon used to represent the status.
    icon-url: option<string>,
    /// The ID of the status.
    id: option<string>,
    /// The name of the status.
    name: option<string>,
    /// The URL of the status.
    self: option<string>,
    /// The category assigned to the status.
    status-category: option<status-category>
  }

  /// A status category.
  record status-category {
    /// The name of the color used to represent the status category.
    color-name: option<string>,
    /// The ID of the status category.
    id: option<s64>,
    /// The key of the status category.
    key: option<string>,
    /// The name of the status category.
    name: option<string>,
    /// The URL of the status category.
    self: option<string>
  }

  /// A Map containing the field field name and a list of operations to perform on the issue screen field. Note that fields included in here cannot be included in `fields`.
  record issue-update-details-update {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details about a created issue or subtask.
  record created-issue {
    /// The ID of the created issue or subtask.
    id: option<string>,
    /// The key of the created issue or subtask.
    key: option<string>,
    /// The URL of the created issue or subtask.
    self: option<string>,
    /// The response code and messages related to any requested transition.
    transition: option<nested-response>,
    /// The response code and messages related to any requested watchers.
    watchers: option<nested-response>
  }

  record nested-response {
    error-collection: option<error-collection>,
    status: option<s32>,
    warning-collection: option<warning-collection>
  }

  /// Error messages from an operation.
  record error-collection {
    /// The list of error messages produced by this operation. For example, "input parameter 'key' must be provided"
    error-messages: option<list<string>>,
    /// The list of errors by parameter returned by the operation. For example,"projectKey": "Project keys must start with an uppercase letter, followed by one or more uppercase alphanumeric characters."
    errors: option<error-collection-errors>,
    status: option<s32>
  }

  /// The list of errors by parameter returned by the operation. For example,"projectKey": "Project keys must start with an uppercase letter, followed by one or more uppercase alphanumeric characters."
  record error-collection-errors {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record warning-collection {
    warnings: option<list<string>>
  }

  /// Details about the issues created and the errors for requests that failed.
  record created-issues {
    /// Error details for failed issue creation requests.
    errors: option<list<bulk-operation-error-result>>,
    /// Details of the issues created.
    issues: option<list<created-issue>>
  }

  record bulk-operation-error-result {
    element-errors: option<error-collection>,
    failed-element-number: option<s32>,
    status: option<s32>
  }

  /// The wrapper for the issue creation metadata for a list of projects.
  record issue-create-metadata {
    /// Expand options that include additional project details in the response.
    expand: option<string>,
    /// List of projects and their issue creation metadata.
    projects: option<list<project-issue-create-metadata>>
  }

  /// Details of the issue creation metadata for a project.
  record project-issue-create-metadata {
    /// List of the project's avatars, returning the avatar size and associated URL.
    avatar-urls: option<avatar-urls-bean>,
    /// Expand options that include additional project issue create metadata details in the response.
    expand: option<string>,
    /// The ID of the project.
    id: option<string>,
    /// List of the issue types supported by the project.
    issuetypes: option<list<issue-type-issue-create-metadata>>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The URL of the project.
    self: option<string>
  }

  record avatar-urls-bean {
    /// The URL of the item's 16x16 pixel avatar.
    v16x16: option<string>,
    /// The URL of the item's 24x24 pixel avatar.
    v24x24: option<string>,
    /// The URL of the item's 32x32 pixel avatar.
    v32x32: option<string>,
    /// The URL of the item's 48x48 pixel avatar.
    v48x48: option<string>
  }

  /// Details of the issue creation metadata for an issue type.
  record issue-type-issue-create-metadata {
    /// The ID of the issue type's avatar.
    avatar-id: option<s64>,
    /// The description of the issue type.
    description: option<string>,
    /// Unique ID for next-gen projects.
    entity-id: option<string>,
    /// Expand options that include additional issue type metadata details in the response.
    expand: option<string>,
    /// List of the fields available when creating an issue for the issue type.
    fields: option<issue-type-issue-create-metadata-fields>,
    /// Hierarchy level of the issue type.
    hierarchy-level: option<s32>,
    /// The URL of the issue type's avatar.
    icon-url: option<string>,
    /// The ID of the issue type.
    id: option<string>,
    /// The name of the issue type.
    name: option<string>,
    /// Details of the next-gen projects the issue type is available in.
    scope: option<scope>,
    /// The URL of these issue type details.
    self: option<string>,
    /// Whether this issue type is used to create subtasks.
    subtask: option<bool>
  }

  /// List of the fields available when creating an issue for the issue type.
  record issue-type-issue-create-metadata-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The projects the item is associated with. Indicated for items associated with [next-gen projects](https://confluence.atlassian.com/x/loMyO).
  record scope {
    /// The project the item has scope in.
    project: option<project-details>,
    /// The type of scope.
    type-op: option<scope-type-op-enum>
  }

  /// Details about a project.
  record project-details {
    /// The URLs of the project's avatars.
    avatar-urls: option<avatar-urls-bean>,
    /// The ID of the project.
    id: option<string>,
    /// The key of the project.
    key: option<string>,
    /// The name of the project.
    name: option<string>,
    /// The category the project belongs to.
    project-category: option<updated-project-category>,
    /// The [project type](https://confluence.atlassian.com/x/GwiiLQ#Jiraapplicationsoverview-Productfeaturesandprojecttypes) of the project.
    project-type-key: option<project-details-project-type-key-enum>,
    /// The URL of the project details.
    self: option<string>,
    /// Whether or not the project is simplified.
    simplified: option<bool>
  }

  /// A project category.
  record updated-project-category {
    /// The name of the project category.
    description: option<string>,
    /// The ID of the project category.
    id: option<string>,
    /// The description of the project category.
    name: option<string>,
    /// The URL of the project category.
    self: option<string>
  }

  /// Details about an issue.
  record issue-bean {
    /// Details of changelogs associated with the issue.
    changelog: option<page-of-changelogs>,
    /// The metadata for the fields on the issue that can be amended.
    editmeta: option<issue-update-metadata>,
    /// Expand options that include additional issue details in the response.
    expand: option<string>,
    fields: option<issue-bean-fields>,
    fields-to-include: option<included-fields>,
    /// The ID of the issue.
    id: option<string>,
    /// The key of the issue.
    key: option<string>,
    /// The ID and name of each field present on the issue.
    names: option<issue-bean-names>,
    /// The operations that can be performed on the issue.
    operations: option<operations>,
    /// Details of the issue properties identified in the request.
    properties: option<issue-bean-properties>,
    /// The rendered value of each field present on the issue.
    rendered-fields: option<issue-bean-rendered-fields>,
    /// The schema describing each field present on the issue.
    schema: option<issue-bean-schema>,
    /// The URL of the issue details.
    self: option<string>,
    /// The transitions that can be performed on the issue.
    transitions: option<list<issue-transition>>,
    /// The versions of each field on the issue.
    versioned-representations: option<issue-bean-versioned-representations>
  }

  /// A page of changelogs.
  record page-of-changelogs {
    /// The list of changelogs.
    histories: option<list<changelog>>,
    /// The maximum number of results that could be on the page.
    max-results: option<s32>,
    /// The index of the first item returned on the page.
    start-at: option<s32>,
    /// The number of results on the page.
    total: option<s32>
  }

  /// A log of changes made to issue fields. Changelogs related to workflow associations are currently being deprecated.
  record changelog {
    /// The user who made the change.
    author: option<user-details>,
    /// The date on which the change took place.
    created: option<string>,
    /// The history metadata associated with the changed.
    history-metadata: option<history-metadata>,
    /// The ID of the changelog.
    id: option<string>,
    /// The list of items changed.
    items: option<list<change-details>>
  }

  /// User details permitted by the user's Atlassian Account privacy settings. However, be aware of these exceptions:
  /// 
  ///  *  User record deleted from Atlassian: This occurs as the result of a right to be forgotten request. In this case, `displayName` provides an indication and other parameters have default values or are blank (for example, email is blank).
  ///  *  User record corrupted: This occurs as a results of events such as a server import and can only happen to deleted users. In this case, `accountId` returns *unknown* and all other parameters have fallback values.
  ///  *  User record unavailable: This usually occurs due to an internal service outage. In this case, all parameters have fallback values.
  record user-details {
    /// The account ID of the user, which uniquely identifies the user across all Atlassian products. For example, *5b10ac8d82e05b22cc7d4ef5*.
    account-id: option<string>,
    /// The type of account represented by this user. This will be one of 'atlassian' (normal users), 'app' (application user) or 'customer' (Jira Service Desk customer user)
    account-type: option<string>,
    /// Whether the user is active.
    active: option<bool>,
    /// The avatars of the user.
    avatar-urls: option<avatar-urls-bean>,
    /// The display name of the user. Depending on the user’s privacy settings, this may return an alternative value.
    display-name: option<string>,
    /// The email address of the user. Depending on the user’s privacy settings, this may be returned as null.
    email-address: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    key: option<string>,
    /// This property is no longer available and will be removed from the documentation soon. See the [deprecation notice](https://developer.atlassian.com/cloud/jira/platform/deprecation-notice-user-privacy-api-migration-guide/) for details.
    name: option<string>,
    /// The URL of the user.
    self: option<string>,
    /// The time zone specified in the user's profile. Depending on the user’s privacy settings, this may be returned as null.
    time-zone: option<string>
  }

  /// A change item.
  record change-details {
    /// The name of the field changed.
    field: option<string>,
    /// The ID of the field changed.
    field-id: option<string>,
    /// The type of the field changed.
    fieldtype: option<string>,
    /// The details of the original value.
    from-op: option<string>,
    /// The details of the original value as a string.
    from-string: option<string>,
    /// The details of the new value.
    to: option<string>
  }

  /// A list of editable field details.
  record issue-update-metadata {
    fields: option<issue-update-metadata-fields>
  }

  record issue-update-metadata-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record issue-bean-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record included-fields {
    actually-included: option<list<string>>,
    excluded: option<list<string>>,
    included: option<list<string>>
  }

  /// The ID and name of each field present on the issue.
  record issue-bean-names {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of the operations that can be performed on the issue.
  record operations {
    /// Details of the link groups defining issue operations.
    link-groups: option<list<link-group>>
  }

  /// Details a link group, which defines issue operations.
  record link-group {
    groups: option<list<string>>,
    header: option<simple-link>,
    id: option<string>,
    links: option<list<simple-link>>,
    style-class: option<string>,
    weight: option<s32>
  }

  /// Details about the operations available in this version.
  record simple-link {
    href: option<string>,
    icon-class: option<string>,
    id: option<string>,
    label: option<string>,
    style-class: option<string>,
    title: option<string>,
    weight: option<s32>
  }

  /// Details of the issue properties identified in the request.
  record issue-bean-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The rendered value of each field present on the issue.
  record issue-bean-rendered-fields {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The schema describing each field present on the issue.
  record issue-bean-schema {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The versions of each field on the issue.
  record issue-bean-versioned-representations {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record simple-list-wrapper-application-role {
    callback: option<list-wrapper-callback-application-role>,
    items: option<list<application-role>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-application-role>,
    size: option<s32>
  }

  record list-wrapper-callback-application-role {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Details of an application role.
  record application-role {
    /// The groups that are granted default access for this application role. As a group's name can change, use of `defaultGroupsDetails` is recommended to identify a groups.
    default-groups: option<list<string>>,
    /// The groups that are granted default access for this application role.
    default-groups-details: option<list<group-name>>,
    /// Deprecated.
    defined: option<bool>,
    /// The groups associated with the application role.
    group-details: option<list<group-name>>,
    /// The groups associated with the application role. As a group's name can change, use of `groupDetails` is recommended to identify a groups.
    groups: option<list<string>>,
    has-unlimited-seats: option<bool>,
    /// The key of the application role.
    key: option<string>,
    /// The display name of the application role.
    name: option<string>,
    /// The maximum count of users on your license.
    number-of-seats: option<s32>,
    /// Indicates if the application role belongs to Jira platform (`jira-core`).
    platform: option<bool>,
    /// The count of users remaining on your license.
    remaining-seats: option<s32>,
    /// Determines whether this application role should be selected by default on user creation.
    selected-by-default: option<bool>,
    /// The number of users counting against your license.
    user-count: option<s32>,
    /// The [type of users](https://confluence.atlassian.com/x/lRW3Ng) being counted against your license.
    user-count-description: option<string>
  }

  /// Details about a group.
  record group-name {
    /// The ID of the group, which uniquely identifies the group across all Atlassian products. For example, *952d12c3-5b5b-4d04-bb32-44d383afc4b2*.
    group-id: option<string>,
    /// The name of group.
    name: option<string>,
    /// The URL for these group details.
    self: option<string>
  }

  record simple-list-wrapper-group-name {
    callback: option<list-wrapper-callback-group-name>,
    items: option<list<group-name>>,
    max-results: option<s32>,
    paging-callback: option<list-wrapper-callback-group-name>,
    size: option<s32>
  }

  record list-wrapper-callback-group-name {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A page of items.
  record page-bean-changelog {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<changelog>>
  }

  /// Details of the group membership or permissions needed to receive the notification.
  record notification-recipients-restrictions {
    /// List of groupId memberships required to receive the notification.
    group-ids: option<list<string>>,
    /// List of group memberships required to receive the notification.
    groups: option<list<group-name>>,
    /// List of permissions required to receive the notification.
    permissions: option<list<restricted-permission>>
  }

  /// Details of the permission.
  record restricted-permission {
    /// The ID of the permission. Either `id` or `key` must be specified. Use [Get all permissions](#api-rest-api-3-permissions-get) to get the list of permissions.
    id: option<string>,
    /// The key of the permission. Either `id` or `key` must be specified. Use [Get all permissions](#api-rest-api-3-permissions-get) to get the list of permissions.
    key: option<string>
  }

  /// Details of the users and groups to receive the notification.
  record notification-recipients {
    /// Whether the notification should be sent to the issue's assignees.
    assignee: option<bool>,
    /// List of groupIds to receive the notification.
    group-ids: option<list<string>>,
    /// List of groups to receive the notification.
    groups: option<list<group-name>>,
    /// Whether the notification should be sent to the issue's reporter.
    reporter: option<bool>,
    /// List of users to receive the notification.
    users: option<list<user-details>>,
    /// Whether the notification should be sent to the issue's voters.
    voters: option<bool>,
    /// Whether the notification should be sent to the issue's watchers.
    watchers: option<bool>
  }

  /// List of issue transitions.
  record transitions {
    /// Expand options that include additional transitions details in the response.
    expand: option<string>,
    /// List of issue transitions.
    transitions: option<list<issue-transition>>
  }

  variant get-events-error {
    unauthorized(string),
    forbidden(string),
    other(string)
