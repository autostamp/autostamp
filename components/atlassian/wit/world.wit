interface issue-resolutions {
  /// Get resolutions
  get-resolutions: func() -> result<string, string>;

  /// Create resolution
  record create-resolution-params {
    /// The description of the resolution.
    description: option<string>,
    /// The name of the resolution. Must be unique (case-insensitive).
    name: string
  }
  create-resolution: func(params: create-resolution-params) -> result<string, string>;

  /// Set default resolution
  record set-default-resolution-params {
    /// The ID of the new default issue resolution. Must be an existing ID or null. Setting this to null erases the default resolution setting.
    id: string
  }
  set-default-resolution: func(params: set-default-resolution-params) -> result<string, string>;

  /// Move resolutions
  record move-resolutions-params {
    /// The ID of the resolution. Required if `position` isn't provided.
    after: option<string>,
    /// The list of resolution IDs to be reordered. Cannot contain duplicates nor after ID.
    ids: list<string>,
    /// The position for issue resolutions to be moved to. Required if `after` isn't provided.
    position: option<string>
  }
  move-resolutions: func(params: move-resolutions-params) -> result<string, string>;

  /// Search resolutions
  record search-resolutions-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<string>,
    /// The maximum number of items to return per page.
    max-results: option<string>,
    /// The list of resolutions IDs to be filtered out
    id: option<list<string>>,
    /// When set to true, return default only, when IDs provided, if none of them is default, return empty page. Default value is false
    only-default: option<bool>
  }
  search-resolutions: func(params: search-resolutions-params) -> result<string, string>;

  /// Get resolution
  record get-resolution-params {
    /// The ID of the issue resolution value.
    id: string
  }
  get-resolution: func(params: get-resolution-params) -> result<string, string>;

  /// Update resolution
  record update-resolution-params {
    /// The ID of the issue resolution.
    id: string,
    /// The description of the resolution.
    description: option<string>,
    /// The name of the resolution. Must be unique.
    name: string
  }
  update-resolution: func(params: update-resolution-params) -> result<string, string>;

  /// Delete resolution
  record delete-resolution-params {
    /// The ID of the issue resolution.
    id: string,
    /// The ID of the issue resolution that will replace the currently selected resolution.
    replace-with: string
  }
  delete-resolution: func(params: delete-resolution-params) -> result<string, string>;

}

interface screen-tabs {
  /// Get all screen tabs
  record get-all-screen-tabs-params {
    /// The ID of the screen.
    screen-id: string,
    /// The key of the project.
    project-key: option<string>
  }
  get-all-screen-tabs: func(params: get-all-screen-tabs-params) -> result<string, string>;

  /// Create screen tab
  record add-screen-tab-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    id: option<s64>,
    /// The name of the screen tab. The maximum length is 255 characters.
    name: string
  }
  add-screen-tab: func(params: add-screen-tab-params) -> result<string, string>;

  /// Update screen tab
  record rename-screen-tab-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The ID of the screen tab.
    id: option<s64>,
    /// The name of the screen tab. The maximum length is 255 characters.
    name: string
  }
  rename-screen-tab: func(params: rename-screen-tab-params) -> result<string, string>;

  /// Delete screen tab
  record delete-screen-tab-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string
  }
  delete-screen-tab: func(params: delete-screen-tab-params) -> result<string, string>;

  /// Move screen tab
  record move-screen-tab-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The position of tab. The base index is 0.
    pos: string
  }
  move-screen-tab: func(params: move-screen-tab-params) -> result<string, string>;

}

interface screen-tab-fields {
  enum move-field-bean-position-enum {
    earlier,
    later,
    first,
    last,
  }

  /// Get all screen tab fields
  record get-all-screen-tab-fields-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The key of the project.
    project-key: option<string>
  }
  get-all-screen-tab-fields: func(params: get-all-screen-tab-fields-params) -> result<string, string>;

  /// Add screen tab field
  record add-screen-tab-field-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The ID of the field to add.
    field-id: string
  }
  add-screen-tab-field: func(params: add-screen-tab-field-params) -> result<string, string>;

  /// Remove screen tab field
  record remove-screen-tab-field-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The ID of the field.
    id: string
  }
  remove-screen-tab-field: func(params: remove-screen-tab-field-params) -> result<string, string>;

  /// Move screen tab field
  record move-screen-tab-field-params {
    /// The ID of the screen.
    screen-id: string,
    /// The ID of the screen tab.
    tab-id: string,
    /// The ID of the field.
    id: string,
    /// The ID of the screen tab field after which to place the moved screen tab field. Required if `position` isn't provided.
    after: option<string>,
    /// The named position to which the screen tab field should be moved. Required if `after` isn't provided.
    position: option<move-field-bean-position-enum>
  }
  move-screen-tab-field: func(params: move-screen-tab-field-params) -> result<string, string>;

}

interface screen-schemes {
  enum get-screen-schemes-order-by-enum {
    name,
    name-v2,
    name-v3,
    id,
    id-v2,
    id-v3,
  }

  /// Get screen schemes
  record get-screen-schemes-params {
    /// The index of the first item to return in a page of results (page offset).
    start-at: option<s64>,
    /// The maximum number of items to return per page.
    max-results: option<s32>,
    /// The list of screen scheme IDs. To include multiple IDs, provide an ampersand-separated list. For example, `id=10000&id=10001`.
    id: option<list<s64>>,
    /// Use [expand](#expansion) include additional information in the response. This parameter accepts `issueTypeScreenSchemes` that, for each screen schemes, returns information about the issue type screen scheme the screen scheme is assigned to.
    expand: option<string>,
    /// String used to perform a case-insensitive partial match with screen scheme name.
    query-string: option<string>,
    /// [Order](#ordering) the results by a field:
    /// 
    order-by: option<get-screen-schemes-order-by-enum>
  }
  get-screen-schemes: func(params: get-screen-schemes-params) -> result<string, string>;

  /// Create screen scheme
  record create-screen-scheme-params {
    /// The description of the screen scheme. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the screen scheme. The name must be unique. The maximum length is 255 characters.
    name: string,
    /// The IDs of the screens for the screen types of the screen scheme. Only screens used in classic projects are accepted.
    screens: string
  }
  create-screen-scheme: func(params: create-screen-scheme-params) -> result<string, string>;

  /// Update screen scheme
  record update-screen-scheme-params {
    /// The ID of the screen scheme.
    screen-scheme-id: string,
    /// The description of the screen scheme. The maximum length is 255 characters.
    description: option<string>,
    /// The name of the screen scheme. The name must be unique. The maximum length is 255 characters.
    name: option<string>,
    /// The IDs of the screens for the screen types of the screen scheme. Only screens used in classic projects are accepted.
    screens: option<string>
  }
  update-screen-scheme: func(params: update-screen-scheme-params) -> result<string, string>;

  /// Delete screen scheme
  record delete-screen-scheme-params {
    /// The ID of the screen scheme.
    screen-scheme-id: string
  }
  delete-screen-scheme: func(params: delete-screen-scheme-params) -> result<string, string>;

}

