    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<issue-security-scheme-to-project-mapping>>
  }

  /// Details about an project using security scheme mapping.
  record issue-security-scheme-to-project-mapping {
    issue-security-scheme-id: option<string>,
    project-id: option<string>
  }

  /// A page of items.
  record page-bean-security-scheme-with-projects {
    /// Whether this is the last page.
    is-last: option<bool>,
    /// The maximum number of items that could be returned.
    max-results: option<s32>,
    /// If there is another page of results, the URL of the next page.
    next-page: option<string>,
    /// The URL of the page.
    self: option<string>,
    /// The index of the first item returned.
    start-at: option<s64>,
    /// The number of items returned.
    total: option<s64>,
    /// The list of items.
    values: option<list<security-scheme-with-projects>>
  }

  /// Details about an issue security scheme.
  record security-scheme-with-projects {
    /// The default level ID of the issue security scheme.
    default-level: option<s64>,
    /// The description of the issue security scheme.
    description: option<string>,
    /// The ID of the issue security scheme.
    id: s64,
    /// The name of the issue security scheme.
    name: string,
    /// The list of project IDs associated with the issue security scheme.
    project-ids: option<list<s64>>,
    /// The URL of the issue security scheme.
    self: string
  }

  variant get-issue-security-schemes-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-issue-security-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-security-levels-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant set-default-levels-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-security-level-members-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant search-projects-using-security-schemes-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant search-security-schemes-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-issue-security-scheme-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant update-issue-security-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-security-scheme-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-security-level-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-security-level-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-level-error {
    see-other(string),
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant add-security-level-members-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-member-from-security-level-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
