/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `hmac` | header `Authorization` |
package autostamp:amazonaws@0.2.1;

interface archive-rule {
  record apply-archive-rule-params {
    /// The Amazon resource name (ARN) of the analyzer.
    analyzer-arn: string,
    /// The name of the rule to apply.
    rule-name: string,
    /// A client token.
    client-token: option<string>
  }
  apply-archive-rule: func(params: apply-archive-rule-params) -> result<string, string>;

}


interface policy {
  enum validate-policy-body-locale-enum {
    de,
    en,
    es,
    fr,
    it,
    ja,
    ko,
    pt-br,
    zh-cn,
    zh-tw,
  }

  enum validate-policy-body-policy-type-enum {
    identity-policy,
    resource-policy,
    service-control-policy,
  }

  enum validate-policy-body-validate-policy-resource-type-enum {
    aws-s3-bucket,
    aws-s3-access-point,
    aws-s3-multi-region-access-point,
    aws-s3-object-lambda-access-point,
    aws-iam-assume-role-policy-document,
  }

  /// Contains the ARN details about the IAM entity for which the policy is generated.
  record start-policy-generation-body-policy-generation-details {
    principal-arn: option<string>
  }

  /// Contains information about CloudTrail access.
  record start-policy-generation-body-cloud-trail-details {
    trails: option<string>,
    access-role: option<string>,
    start-time: option<string>,
    end-time: option<string>
  }

  record get-generated-policy-params {
    /// The <code>JobId</code> that is returned by the <code>StartPolicyGeneration</code> operation. The <code>JobId</code> can be used with <code>GetGeneratedPolicy</code> to retrieve the generated policies or used with <code>CancelPolicyGeneration</code> to cancel the policy generation request.
    job-id: string,
    /// <p>The level of detail that you want to generate. You can specify whether to generate policies with placeholders for resource ARNs for actions that support resource level granularity in policies.</p> <p>For example, in the resource section of a policy, you can receive a placeholder such as <code>"Resource":"arn:aws:s3:::${BucketName}"</code> instead of <code>"*"</code>.</p>
    include-resource-placeholders: option<bool>,
    /// <p>The level of detail that you want to generate. You can specify whether to generate service-level policies. </p> <p>IAM Access Analyzer uses <code>iam:servicelastaccessed</code> to identify services that have been used recently to create this service-level template.</p>
    include-service-level-template: option<bool>
  }
  get-generated-policy: func(params: get-generated-policy-params) -> result<string, string>;

  record cancel-policy-generation-params {
    /// The <code>JobId</code> that is returned by the <code>StartPolicyGeneration</code> operation. The <code>JobId</code> can be used with <code>GetGeneratedPolicy</code> to retrieve the generated policies or used with <code>CancelPolicyGeneration</code> to cancel the policy generation request.
    job-id: string
  }
  cancel-policy-generation: func(params: cancel-policy-generation-params) -> result<string, string>;

  record list-policy-generations-params {
    /// The ARN of the IAM entity (user or role) for which you are generating a policy. Use this with <code>ListGeneratedPolicies</code> to filter the results to only include results for a specific principal.
    principal-arn: option<string>,
    /// The maximum number of results to return in the response.
    max-results: option<s32>,
    /// A token used for pagination of results returned.
    next-token: option<string>
  }
  list-policy-generations: func(params: list-policy-generations-params) -> result<string, string>;

  record start-policy-generation-params {
    /// Contains the ARN details about the IAM entity for which the policy is generated.
    policy-generation-details: start-policy-generation-body-policy-generation-details,
    /// Contains information about CloudTrail access.
    cloud-trail-details: option<start-policy-generation-body-cloud-trail-details>,
    /// <p>A unique, case-sensitive identifier that you provide to ensure the idempotency of the request. Idempotency ensures that an API request completes only once. With an idempotent request, if the original request completes successfully, the subsequent retries with the same client token return the result from the original successful request and they have no additional effect.</p> <p>If you do not specify a client token, one is automatically generated by the Amazon Web Services SDK.</p>
    client-token: option<string>
  }
  start-policy-generation: func(params: start-policy-generation-params) -> result<string, string>;

  record validate-policy-params {
    /// The maximum number of results to return in the response.
    max-results: option<s32>,
    /// A token used for pagination of results returned.
    next-token: option<string>,
    /// The locale to use for localizing the findings.
    locale: option<validate-policy-body-locale-enum>,
    /// The JSON policy document to use as the content for the policy.
    policy-document: string,
    /// <p>The type of policy to validate. Identity policies grant permissions to IAM principals. Identity policies include managed and inline policies for IAM roles, users, and groups. They also include service-control policies (SCPs) that are attached to an Amazon Web Services organization, organizational unit (OU), or an account.</p> <p>Resource policies grant permissions on Amazon Web Services resources. Resource policies include trust policies for IAM roles and bucket policies for Amazon S3 buckets. You can provide a generic input such as identity policy or resource policy or a specific input such as managed policy or Amazon S3 bucket policy. </p>
    policy-type: validate-policy-body-policy-type-enum,
    /// <p>The type of resource to attach to your resource policy. Specify a value for the policy validation resource type only if the policy type is <code>RESOURCE_POLICY</code>. For example, to validate a resource policy to attach to an Amazon S3 bucket, you can choose <code>AWS::S3::Bucket</code> for the policy validation resource type.</p> <p>For resource types not supported as valid values, IAM Access Analyzer runs policy checks that apply to all resource policies. For example, to validate a resource policy to attach to a KMS key, do not specify a value for the policy validation resource type and IAM Access Analyzer will run policy checks that apply to all resource policies.</p>
    validate-policy-resource-type: option<validate-policy-body-validate-policy-resource-type-enum>
  }
  validate-policy: func(params: validate-policy-params) -> result<string, string>;

}

interface access-preview {
  /// Access control configuration for your resource that is used to generate the access preview. The access preview includes findings for external access allowed to the resource with the proposed access control configuration. The configuration must contain exactly one element.
  record create-access-preview-body-configurations {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Criteria to filter the returned findings.
  record list-access-preview-findings-body-filter {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record create-access-preview-params {
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the account analyzer</a> used to generate the access preview. You can only create an access preview for analyzers with an <code>Account</code> type and <code>Active</code> status.
    analyzer-arn: string,
    /// Access control configuration for your resource that is used to generate the access preview. The access preview includes findings for external access allowed to the resource with the proposed access control configuration. The configuration must contain exactly one element.
    configurations: create-access-preview-body-configurations,
    /// A client token.
    client-token: option<string>
  }
  create-access-preview: func(params: create-access-preview-params) -> result<string, string>;

  record get-access-preview-params {
    /// The unique ID for the access preview.
    access-preview-id: string,
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> used to generate the access preview.
    analyzer-arn: string
  }
  get-access-preview: func(params: get-access-preview-params) -> result<string, string>;

  record list-access-preview-findings-params {
    /// The unique ID for the access preview.
    access-preview-id: string,
    /// Pagination limit
    max-results: option<string>,
    /// Pagination token
    next-token: option<string>,
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> used to generate the access.
    analyzer-arn: string,
    /// Criteria to filter the returned findings.
    filter: option<list-access-preview-findings-body-filter>
  }
  list-access-preview-findings: func(params: list-access-preview-findings-params) -> result<string, string>;

}

interface analyzer {
  enum list-analyzers-type-op-enum {
    account,
    organization,
  }

  /// An criterion statement in an archive rule. Each archive rule may have multiple criteria.
  record inline-archive-rule {
    rule-name: string,
    filter: string
  }

  /// The tags to apply to the analyzer.
  record create-analyzer-body-tags {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The criteria for the rule.
  record create-archive-rule-body-filter {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A filter to match for the rules to update. Only rules that match the filter are updated.
  record update-archive-rule-body-filter {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record list-analyzers-params {
    /// A token used for pagination of results returned.
    next-token: option<string>,
    /// The maximum number of results to return in the response.
    max-results: option<s32>,
    /// The type of analyzer.
    type-op: option<list-analyzers-type-op-enum>
  }
  list-analyzers: func(params: list-analyzers-params) -> result<string, string>;

  record create-analyzer-params {
    /// The name of the analyzer to create.
    analyzer-name: string,
    /// The type of analyzer to create. Only ACCOUNT and ORGANIZATION analyzers are supported. You can create only one analyzer per account per Region. You can create up to 5 analyzers per organization per Region.
    type-op: list-analyzers-type-op-enum,
    /// Specifies the archive rules to add for the analyzer. Archive rules automatically archive findings that meet the criteria you define for the rule.
    archive-rules: option<list<inline-archive-rule>>,
    /// The tags to apply to the analyzer.
    tags: option<create-analyzer-body-tags>,
    /// A client token.
    client-token: option<string>
  }
  create-analyzer: func(params: create-analyzer-params) -> result<string, string>;

  record list-archive-rules-params {
    /// The name of the analyzer to retrieve rules from.
    analyzer-name: string,
    /// A token used for pagination of results returned.
    next-token: option<string>,
    /// The maximum number of results to return in the request.
    max-results: option<s32>
  }
  list-archive-rules: func(params: list-archive-rules-params) -> result<string, string>;

  record create-archive-rule-params {
    /// The name of the created analyzer.
    analyzer-name: string,
    /// The name of the rule to create.
    rule-name: string,
    /// The criteria for the rule.
    filter: create-archive-rule-body-filter,
    /// A client token.
    client-token: option<string>
  }
  create-archive-rule: func(params: create-archive-rule-params) -> result<string, string>;

  record get-analyzer-params {
    /// The name of the analyzer retrieved.
    analyzer-name: string
  }
  get-analyzer: func(params: get-analyzer-params) -> result<string, string>;

  record delete-analyzer-params {
    /// The name of the analyzer to delete.
    analyzer-name: string,
    /// A client token.
    client-token: option<string>
  }
  delete-analyzer: func(params: delete-analyzer-params) -> result<string, string>;

  record get-archive-rule-params {
    /// The name of the analyzer to retrieve rules from.
    analyzer-name: string,
    /// The name of the rule to retrieve.
    rule-name: string
  }
  get-archive-rule: func(params: get-archive-rule-params) -> result<string, string>;

  record update-archive-rule-params {
    /// The name of the analyzer to update the archive rules for.
    analyzer-name: string,
    /// The name of the rule to update.
    rule-name: string,
    /// A filter to match for the rules to update. Only rules that match the filter are updated.
    filter: update-archive-rule-body-filter,
    /// A client token.
    client-token: option<string>
  }
  update-archive-rule: func(params: update-archive-rule-params) -> result<string, string>;

  record delete-archive-rule-params {
    /// The name of the analyzer that associated with the archive rule to delete.
    analyzer-name: string,
    /// The name of the rule to delete.
    rule-name: string,
    /// A client token.
    client-token: option<string>
  }
  delete-archive-rule: func(params: delete-archive-rule-params) -> result<string, string>;

}

interface analyzed-resource-analyzer-arn-resource-arn {
  record get-analyzed-resource-params {
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> to retrieve information from.
    analyzer-arn: string,
    /// The ARN of the resource to retrieve information about.
    resource-arn: string
  }
  get-analyzed-resource: func(params: get-analyzed-resource-params) -> result<string, string>;

}

interface finding {
  enum update-findings-body-status-enum {
    active,
    archived,
  }

  /// A filter to match for the findings to return.
  record list-findings-body-filter {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The criteria used to sort.
  record list-findings-body-sort {
    attribute-name: option<string>,
    order-by: option<string>
  }

  record finding-id {
    /// opaque schema; raw JSON
    value: string
  }

  record get-finding-params {
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> that generated the finding.
    analyzer-arn: string,
    /// The ID of the finding to retrieve.
    id: string
  }
  get-finding: func(params: get-finding-params) -> result<string, string>;

  record list-findings-params {
    /// Pagination limit
    max-results: option<string>,
    /// Pagination token
    next-token: option<string>,
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> to retrieve findings from.
    analyzer-arn: string,
    /// A filter to match for the findings to return.
    filter: option<list-findings-body-filter>,
    /// The criteria used to sort.
    sort: option<list-findings-body-sort>
  }
  list-findings: func(params: list-findings-params) -> result<string, string>;

  record update-findings-params {
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> that generated the findings to update.
    analyzer-arn: string,
    /// The state represents the action to take to update the finding Status. Use <code>ARCHIVE</code> to change an Active finding to an Archived finding. Use <code>ACTIVE</code> to change an Archived finding to an Active finding.
    status: update-findings-body-status-enum,
    /// The IDs of the findings to update.
    ids: option<list<finding-id>>,
    /// The ARN of the resource identified in the finding.
    resource-arn: option<string>,
    /// A client token.
    client-token: option<string>
  }
  update-findings: func(params: update-findings-params) -> result<string, string>;

}

interface access-preview-analyzer-arn {
  record list-access-previews-params {
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> used to generate the access preview.
    analyzer-arn: string,
    /// A token used for pagination of results returned.
    next-token: option<string>,
    /// The maximum number of results to return in the response.
    max-results: option<s32>
  }
  list-access-previews: func(params: list-access-previews-params) -> result<string, string>;

}

interface analyzed-resource {
  enum list-analyzed-resources-body-resource-type-enum {
    aws-s3-bucket,
    aws-iam-role,
    aws-sqs-queue,
    aws-lambda-function,
    aws-lambda-layer-version,
    aws-kms-key,
    aws-secrets-manager-secret,
    aws-efs-file-system,
    aws-ec2-snapshot,
    aws-ecr-repository,
    aws-rds-db-snapshot,
    aws-rds-db-cluster-snapshot,
    aws-sns-topic,
  }

  record list-analyzed-resources-params {
    /// Pagination limit
    max-results: option<string>,
    /// Pagination token
    next-token: option<string>,
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> to retrieve a list of analyzed resources from.
    analyzer-arn: string,
    /// The type of resource.
    resource-type: option<list-analyzed-resources-body-resource-type-enum>
  }
  list-analyzed-resources: func(params: list-analyzed-resources-params) -> result<string, string>;

}

interface tags {
  /// The tags to add to the resource.
  record tag-resource-body-tags {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record string-op {
    /// opaque schema; raw JSON
    value: string
  }

  record list-tags-for-resource-params {
    /// The ARN of the resource to retrieve tags from.
    resource-arn: string
  }
  list-tags-for-resource: func(params: list-tags-for-resource-params) -> result<string, string>;

  record tag-resource-params {
    /// The ARN of the resource to add the tag to.
    resource-arn: string,
    /// The tags to add to the resource.
    tags: tag-resource-body-tags
  }
  tag-resource: func(params: tag-resource-params) -> result<string, string>;

  record untag-resource-params {
    /// The ARN of the resource to remove the tag from.
    resource-arn: string,
    /// The key for the tag to add.
    tag-keys: list<string-op>
  }
  untag-resource: func(params: untag-resource-params) -> result<string, string>;

}

interface resource-op {
  record start-resource-scan-params {
    /// The <a href="https://docs.aws.amazon.com/IAM/latest/UserGuide/access-analyzer-getting-started.html#permission-resources">ARN of the analyzer</a> to use to scan the policies applied to the specified resource.
    analyzer-arn: string,
    /// The ARN of the resource to scan.
    resource-arn: string,
    /// The Amazon Web Services account ID that owns the resource. For most Amazon Web Services resources, the owning account is the account in which the resource was created.
    resource-owner-account: option<string>
  }
  start-resource-scan: func(params: start-resource-scan-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export archive-rule;
  export policy;
  export access-preview;
  export analyzer;
  export analyzed-resource-analyzer-arn-resource-arn;
  export finding;
  export access-preview-analyzer-arn;
  export analyzed-resource;
  export tags;
  export resource-op;
}
