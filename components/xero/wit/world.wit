  /// Retrieves a history record for a specific receipt
  record get-receipt-history-params {
    /// Unique identifier for a Receipt
    receipt-id: string
  }
  get-receipt-history: func(params: get-receipt-history-params) -> result<string, string>;

  /// Creates a history record for a specific receipt
  record create-receipt-history-params {
    /// Unique identifier for a Receipt
    receipt-id: string,
    history-records: option<list<history-record>>
  }
  create-receipt-history: func(params: create-receipt-history-params) -> result<string, string>;

  /// Retrieves repeating invoices
  record get-repeating-invoices-params {
    /// Filter by an any element
    where: option<string>,
    /// Order by an any element
    order: option<string>
  }
  get-repeating-invoices: func(params: get-repeating-invoices-params) -> result<string, string>;

  /// Retrieves a specific repeating invoice by using a unique repeating invoice Id
  record get-repeating-invoice-params {
    /// Unique identifier for a Repeating Invoice
    repeating-invoice-id: string
  }
  get-repeating-invoice: func(params: get-repeating-invoice-params) -> result<string, string>;

  /// Retrieves attachments from a specific repeating invoice
  record get-repeating-invoice-attachments-params {
    /// Unique identifier for a Repeating Invoice
    repeating-invoice-id: string
  }
  get-repeating-invoice-attachments: func(params: get-repeating-invoice-attachments-params) -> result<string, string>;

  /// Retrieves a specific attachment from a specific repeating invoice
  record get-repeating-invoice-attachment-by-id-params {
    /// Unique identifier for a Repeating Invoice
    repeating-invoice-id: string,
    /// Unique identifier for a Attachment
    attachment-id: string,
    /// The mime type of the attachment file you are retrieving i.e image/jpg, application/pdf
    content-type: string
  }
  get-repeating-invoice-attachment-by-id: func(params: get-repeating-invoice-attachment-by-id-params) -> result<string, string>;

  /// Retrieves a specific attachment from a specific repeating invoices by file name
  record get-repeating-invoice-attachment-by-file-name-params {
    /// Unique identifier for a Repeating Invoice
    repeating-invoice-id: string,
    /// The name of the file being attached to a Repeating Invoice
    file-name: string,
    /// The mime type of the attachment file you are retrieving i.e image/jpg, application/pdf
    content-type: string
  }
  get-repeating-invoice-attachment-by-file-name: func(params: get-repeating-invoice-attachment-by-file-name-params) -> result<string, string>;

  /// Updates a specific attachment from a specific repeating invoices by file name
  record update-repeating-invoice-attachment-by-file-name-params {
    /// Unique identifier for a Repeating Invoice
    repeating-invoice-id: string,
    /// The name of the file being attached to a Repeating Invoice
    file-name: string
  }
  update-repeating-invoice-attachment-by-file-name: func(params: update-repeating-invoice-attachment-by-file-name-params) -> result<string, string>;

  /// Creates an attachment from a specific repeating invoices by file name
  record create-repeating-invoice-attachment-by-file-name-params {
    /// Unique identifier for a Repeating Invoice
    repeating-invoice-id: string,
    /// The name of the file being attached to a Repeating Invoice
    file-name: string
  }
  create-repeating-invoice-attachment-by-file-name: func(params: create-repeating-invoice-attachment-by-file-name-params) -> result<string, string>;

  /// Retrieves history record for a specific repeating invoice
  record get-repeating-invoice-history-params {
    /// Unique identifier for a Repeating Invoice
    repeating-invoice-id: string
  }
  get-repeating-invoice-history: func(params: get-repeating-invoice-history-params) -> result<string, string>;

  /// Creates a  history record for a specific repeating invoice
  record create-repeating-invoice-history-params {
    /// Unique identifier for a Repeating Invoice
    repeating-invoice-id: string,
    history-records: option<list<history-record>>
  }
  create-repeating-invoice-history: func(params: create-repeating-invoice-history-params) -> result<string, string>;

  /// Retrieves report for BAS (only valid for AU orgs)
  get-report-ba-sor-gst-list: func() -> result<string, string>;

  /// Retrieves report for aged payables by contact
  record get-report-aged-payables-by-contact-params {
    /// Unique identifier for a Contact
    contact-id: string,
    /// The date of the Aged Payables By Contact report
    date: option<string>,
    /// The from date of the Aged Payables By Contact report
    from-date: option<string>,
    /// The to date of the Aged Payables By Contact report
    to-date: option<string>
  }
  get-report-aged-payables-by-contact: func(params: get-report-aged-payables-by-contact-params) -> result<string, string>;

  /// Retrieves report for aged receivables by contact
  record get-report-aged-receivables-by-contact-params {
    /// Unique identifier for a Contact
    contact-id: string,
    /// The date of the Aged Receivables By Contact report
    date: option<string>,
    /// The from date of the Aged Receivables By Contact report
    from-date: option<string>,
    /// The to date of the Aged Receivables By Contact report
    to-date: option<string>
  }
  get-report-aged-receivables-by-contact: func(params: get-report-aged-receivables-by-contact-params) -> result<string, string>;

  /// Retrieves report for balancesheet
  record get-report-balance-sheet-params {
    /// The date of the Balance Sheet report
    date: option<string>,
    /// The number of periods for the Balance Sheet report
    periods: option<s32>,
    /// The period size to compare to (MONTH, QUARTER, YEAR)
    timeframe: option<get-report-balance-sheet-timeframe-enum>,
    /// The tracking option 1 for the Balance Sheet report
    tracking-option-id1: option<string>,
    /// The tracking option 2 for the Balance Sheet report
    tracking-option-id2: option<string>,
    /// The standard layout boolean for the Balance Sheet report
    standard-layout: option<bool>,
    /// return a cash basis for the Balance Sheet report
    payments-only: option<bool>
  }
  get-report-balance-sheet: func(params: get-report-balance-sheet-params) -> result<string, string>;

  /// Retrieves report for bank summary
  record get-report-bank-summary-params {
    /// The from date for the Bank Summary report e.g. 2018-03-31
    from-date: option<string>,
    /// The to date for the Bank Summary report e.g. 2018-03-31
    to-date: option<string>
  }
  get-report-bank-summary: func(params: get-report-bank-summary-params) -> result<string, string>;

  /// Retrieves report for budget summary
  record get-report-budget-summary-params {
    /// The date for the Bank Summary report e.g. 2018-03-31
    date: option<string>,
    /// The number of periods to compare (integer between 1 and 12)
    period: option<s32>,
    /// The period size to compare to (1=month, 3=quarter, 12=year)
    timeframe: option<s32>
  }
  get-report-budget-summary: func(params: get-report-budget-summary-params) -> result<string, string>;

  /// Retrieves report for executive summary
  record get-report-executive-summary-params {
    /// The date for the Bank Summary report e.g. 2018-03-31
    date: option<string>
  }
  get-report-executive-summary: func(params: get-report-executive-summary-params) -> result<string, string>;

  /// Retrieves report for profit and loss
  record get-report-profit-and-loss-params {
    /// The from date for the ProfitAndLoss report e.g. 2018-03-31
    from-date: option<string>,
    /// The to date for the ProfitAndLoss report e.g. 2018-03-31
    to-date: option<string>,
    /// The number of periods to compare (integer between 1 and 12)
    periods: option<s32>,
    /// The period size to compare to (MONTH, QUARTER, YEAR)
    timeframe: option<get-report-balance-sheet-timeframe-enum>,
    /// The trackingCategory 1 for the ProfitAndLoss report
    tracking-category-id: option<string>,
    /// The trackingCategory 2 for the ProfitAndLoss report
    tracking-category-id2: option<string>,
    /// The tracking option 1 for the ProfitAndLoss report
    tracking-option-id: option<string>,
    /// The tracking option 2 for the ProfitAndLoss report
    tracking-option-id2: option<string>,
    /// Return the standard layout for the ProfitAndLoss report
    standard-layout: option<bool>,
    /// Return cash only basis for the ProfitAndLoss report
    payments-only: option<bool>
  }
  get-report-profit-and-loss: func(params: get-report-profit-and-loss-params) -> result<string, string>;

  /// Retrieve reports for 1099
  record get-report-ten-ninety-nine-params {
    /// The year of the 1099 report
    report-year: option<string>
  }
  get-report-ten-ninety-nine: func(params: get-report-ten-ninety-nine-params) -> result<string, string>;

  /// Retrieves report for trial balance
  record get-report-trial-balance-params {
    /// The date for the Trial Balance report e.g. 2018-03-31
    date: option<string>,
    /// Return cash only basis for the Trial Balance report
    payments-only: option<bool>
  }
  get-report-trial-balance: func(params: get-report-trial-balance-params) -> result<string, string>;

  /// Retrieves a specific report for BAS using a unique report Id (only valid for AU orgs)
  record get-report-ba-sor-gst-params {
    /// Unique identifier for a Report
    report-id: string
  }
  get-report-ba-sor-gst: func(params: get-report-ba-sor-gst-params) -> result<string, string>;

  /// Sets the chart of accounts, the conversion date and conversion balances
  record post-setup-params {
    accounts: option<list<account>>,
    /// Balance supplied for each account that has a value as at the conversion date.
    conversion-balances: option<list<conversion-balances>>,
    conversion-date: option<conversion-date>
  }
  post-setup: func(params: post-setup-params) -> result<string, string>;

  /// Retrieves tax rates
  record get-tax-rates-params {
    /// Filter by an any element
    where: option<string>,
    /// Order by an any element
    order: option<string>,
    /// Filter by tax type
    tax-type: option<string>
  }
  get-tax-rates: func(params: get-tax-rates-params) -> result<string, string>;

  /// Updates tax rates
  record update-tax-rate-params {
    tax-rates: option<list<tax-rate>>
  }
  update-tax-rate: func(params: update-tax-rate-params) -> result<string, string>;

  /// Creates one or more tax rates
  record create-tax-rates-params {
    tax-rates: option<list<tax-rate>>
  }
  create-tax-rates: func(params: create-tax-rates-params) -> result<string, string>;

  /// Retrieves tracking categories and options
  record get-tracking-categories-params {
    /// Filter by an any element
    where: option<string>,
    /// Order by an any element
    order: option<string>,
    /// e.g. includeArchived=true - Categories and options with a status of ARCHIVED will be included in the response
    include-archived: option<bool>
  }
  get-tracking-categories: func(params: get-tracking-categories-params) -> result<string, string>;

  /// Create tracking categories
  record create-tracking-category-params {
    /// The name of the tracking category e.g. Department, Region (max length = 100)
    name: option<string>,
    /// The option name of the tracking option e.g. East, West (max length = 100)
    option-op: option<string>,
    /// See Tracking Options
    options: option<list<tracking-option>>,
    /// The status of a tracking category
    status: option<account-status-enum>,
    /// The Xero identifier for a tracking category e.g. 297c2dc5-cc47-4afd-8ec8-74990b8761e9
    tracking-category-id: option<string>,
    /// The Xero identifier for a tracking option e.g. dc54c220-0140-495a-b925-3246adc0075f
    tracking-option-id: option<string>
  }
  create-tracking-category: func(params: create-tracking-category-params) -> result<string, string>;

  /// Retrieves specific tracking categories and options using a unique tracking category Id
  record get-tracking-category-params {
    /// Unique identifier for a TrackingCategory
    tracking-category-id: string
  }
  get-tracking-category: func(params: get-tracking-category-params) -> result<string, string>;

  /// Updates a specific tracking category
  record update-tracking-category-params {
    /// Unique identifier for a TrackingCategory
    tracking-category-id: string,
    /// The name of the tracking category e.g. Department, Region (max length = 100)
    name: option<string>,
    /// The option name of the tracking option e.g. East, West (max length = 100)
    option-op: option<string>,
    /// See Tracking Options
    options: option<list<tracking-option>>,
    /// The status of a tracking category
    status: option<account-status-enum>,
    /// The Xero identifier for a tracking option e.g. dc54c220-0140-495a-b925-3246adc0075f
    tracking-option-id: option<string>
  }
  update-tracking-category: func(params: update-tracking-category-params) -> result<string, string>;

  /// Deletes a specific tracking category
  record delete-tracking-category-params {
    /// Unique identifier for a TrackingCategory
    tracking-category-id: string
  }
  delete-tracking-category: func(params: delete-tracking-category-params) -> result<string, string>;

  /// Creates options for a specific tracking category
  record create-tracking-options-params {
    /// Unique identifier for a TrackingCategory
    tracking-category-id: string,
    /// The name of the tracking option e.g. Marketing, East (max length = 100)
    name: option<string>,
    /// The status of a tracking option
    status: option<account-status-enum>,
    /// The Xero identifier for a tracking option e.g. ae777a87-5ef3-4fa0-a4f0-d10e1f13073a
    tracking-option-id: option<string>
  }
  create-tracking-options: func(params: create-tracking-options-params) -> result<string, string>;

  /// Updates a specific option for a specific tracking category
  record update-tracking-options-params {
    /// Unique identifier for a TrackingCategory
    tracking-category-id: string,
    /// Unique identifier for a Tracking Option
    tracking-option-id: string,
    /// The name of the tracking option e.g. Marketing, East (max length = 100)
    name: option<string>,
    /// The status of a tracking option
    status: option<account-status-enum>
  }
  update-tracking-options: func(params: update-tracking-options-params) -> result<string, string>;

  /// Deletes a specific option for a specific tracking category
  record delete-tracking-options-params {
    /// Unique identifier for a TrackingCategory
    tracking-category-id: string,
    /// Unique identifier for a Tracking Option
    tracking-option-id: string
  }
  delete-tracking-options: func(params: delete-tracking-options-params) -> result<string, string>;

  /// Retrieves users
  record get-users-params {
    /// Only records created or modified since this timestamp will be returned
    if-modified-since: option<string>,
    /// Filter by an any element
    where: option<string>,
    /// Order by an any element
    order: option<string>
  }
  get-users: func(params: get-users-params) -> result<string, string>;

  /// Retrieves a specific user
  record get-user-params {
    /// Unique identifier for a User
    user-id: string
  }
  get-user: func(params: get-user-params) -> result<string, string>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export accounting;
}
