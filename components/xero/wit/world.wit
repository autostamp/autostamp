/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `OAuth2` | `Authorization: Bearer <secret>` |
package autostamp:xero@0.3.0;

interface accounting {
  enum account-bank-account-type-enum {
    bank,
    creditcard,
    paypal,
    none,
    empty,
  }

  enum account-class-enum {
    asset,
    equity,
    expense,
    liability,
    revenue,
  }

  enum account-status-enum {
    active,
    archived,
    deleted,
  }

  enum account-system-account-enum {
    debtors,
    creditors,
    bankcurrencygain,
    gst,
    gstonimports,
    historical,
    realisedcurrencygain,
    retainedearnings,
    rounding,
    trackingtransfers,
    unpaidexpclm,
    unrealisedcurrencygain,
    wagepayables,
    cisassets,
    cisasset,
    cislabour,
    cislabourexpense,
    cislabourincome,
    cisliability,
    cismaterials,
    empty,
  }

  enum address-address-type-enum {
    pobox,
    street,
  }

  enum branding-theme-type-op-enum {
    invoice,
  }

  enum contact-group-status-enum {
    active,
    deleted,
  }

  enum contact-contact-status-enum {
    active,
    archived,
    gdprrequest,
  }

  enum phone-phone-type-enum {
    default,
    ddi,
    mobile,
    fax,
    office,
  }

  enum bank-transaction-status-enum {
    authorised,
    deleted,
    voided,
  }

  enum bank-transaction-type-op-enum {
    receive,
    receive-overpayment,
    receive-prepayment,
    spend,
    spend-overpayment,
    spend-prepayment,
    receive-transfer,
    spend-transfer,
  }

  enum overpayment-status-enum {
    authorised,
    paid,
    voided,
  }

  enum overpayment-type-op-enum {
    receive-overpayment,
    spend-overpayment,
    aroverpayment,
  }

  enum prepayment-type-op-enum {
    receive-prepayment,
    spend-prepayment,
    arprepayment,
    apprepayment,
  }

  enum invoice-status-enum {
    draft,
    submitted,
    deleted,
    authorised,
    paid,
    voided,
  }

  enum invoice-type-op-enum {
    accpay,
    accpaycredit,
    apoverpayment,
    apprepayment,
    accrec,
    accreccredit,
    aroverpayment,
    arprepayment,
  }

  enum credit-note-type-op-enum {
    accpaycredit,
    accreccredit,
  }

  enum payment-payment-type-enum {
    accrecpayment,
    accpaypayment,
    arcreditpayment,
    apcreditpayment,
    aroverpaymentpayment,
    arprepaymentpayment,
    apprepaymentpayment,
    apoverpaymentpayment,
  }

  enum payment-status-enum {
    authorised,
    deleted,
  }

  enum batch-payment-type-op-enum {
    paybatch,
    recbatch,
  }

  enum external-link-link-type-enum {
    facebook,
    google-plus,
    linked-in,
    twitter,
    website,
  }

  enum employee-status-enum {
    active,
    archived,
    gdprrequest,
    deleted,
  }

  enum receipt-status-enum {
    draft,
    submitted,
    authorised,
    declined,
    voided,
  }

  enum user-organisation-role-enum {
    readonly,
    invoiceonly,
    standard,
    financialadviser,
    managedclient,
    cashbookclient,
    unknown,
  }

  enum expense-claim-status-enum {
    submitted,
    authorised,
    paid,
    voided,
    deleted,
  }

  enum linked-transaction-source-transaction-type-code-enum {
    accpay,
    spend,
  }

  enum linked-transaction-status-enum {
    approved,
    draft,
    ondraft,
    billed,
    voided,
  }

  enum linked-transaction-type-op-enum {
    billableexpense,
  }

  enum manual-journal-status-enum {
    draft,
    posted,
    deleted,
    voided,
    archived,
  }

  enum get-purchase-orders-status-enum {
    draft,
    submitted,
    authorised,
    billed,
    deleted,
  }

  enum get-report-balance-sheet-timeframe-enum {
    month,
    quarter,
    year,
  }

  enum tax-rate-report-tax-type-enum {
    avalara,
    basexcluded,
    capitalsalesoutput,
    capitalexpensesinput,
    ecoutput,
    ecoutputservices,
    ecinput,
    ecacquisitions,
    exemptexpenses,
    exemptinput,
    exemptoutput,
    gstonimports,
    input,
    inputtaxed,
    mosssales,
    none,
    noneoutput,
    output,
    purchasesinput,
    salesoutput,
    exemptcapital,
    exemptexport,
    capitalexinput,
    gstoncapimports,
    gstoncapitalimports,
    reversecharges,
    payments,
    invoice,
    cash,
    accrual,
    flatratecash,
    flatrateaccrual,
    accruals,
    txca,
    srcas,
    dsoutput,
    blinput2,
    epinput,
    iminput2,
    meinput,
    igdsinput2,
    esn33output,
    opinput,
    osoutput,
    txn33input,
    txessinput,
    txreinput,
    txpetinput,
    nrinput,
    es33output,
    zeroratedinput,
    zeroratedoutput,
    drchargesupply,
    drcharge,
    capinput,
    capimports,
    iminput,
    input2,
    ciuinput,
    srinput,
    output2,
    sroutput,
    capoutput,
    sroutput2,
    ciuoutput,
    zroutput,
    zrexport,
    acc28plus,
    accupto28,
    otheroutput,
    shoutput,
    zrinput,
    baddebt,
    otherinput,
  }

  enum tax-rate-status-enum {
    active,
    deleted,
    archived,
    pending,
  }

  record account {
    /// The Xero identifier for an account – specified as a string following  the endpoint name   e.g. /297c2dc5-cc47-4afd-8ec8-74990b8761e9
    account-id: option<string>,
    /// Boolean – describes whether the account is shown in the watchlist widget on the dashboard
    add-to-watchlist: option<bool>,
    /// For bank accounts only (Account Type BANK)
    bank-account-number: option<string>,
    /// For bank accounts only. See Bank Account types
    bank-account-type: option<account-bank-account-type-enum>,
    /// See Account Class Types
    class: option<account-class-enum>,
    /// Customer defined alpha numeric account code e.g 200 or SALES (max length = 10)
    code: option<string>,
    currency-code: option<currency-code>,
    /// Description of the Account. Valid for all types of accounts except bank accounts (max length = 4000)
    description: option<string>,
    /// Boolean – describes whether account can have payments applied to it
    enable-payments-to-account: option<bool>,
    /// boolean to indicate if an account has an attachment (read only)
    has-attachments: option<bool>,
    /// Name of account (max length = 150)
    name: option<string>,
    /// Shown if set
    reporting-code: option<string>,
    /// Shown if set
    reporting-code-name: option<string>,
    /// Boolean – describes whether account code is available for use with expense claims
    show-in-expense-claims: option<bool>,
    /// Accounts with a status of ACTIVE can be updated to ARCHIVED. See Account Status Codes
    status: option<account-status-enum>,
    /// If this is a system account then this element is returned. See System Account types. Note that non-system accounts may have this element set as either “” or null.
    system-account: option<account-system-account-enum>,
    /// The tax type from TaxRates
    tax-type: option<string>,
    type-op: option<account-type>,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  /// 3 letter alpha code for the currency – see list of currency codes
  record currency-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// See Account Types
  record account-type {
    /// opaque schema; raw JSON
    value: string
  }

  record validation-error {
    /// Validation error message
    message: option<string>
  }

  record bank-transaction {
    bank-account: account,
    /// Xero generated unique identifier for bank transaction
    bank-transaction-id: option<string>,
    contact: option<contact>,
    currency-code: option<currency-code>,
    /// Exchange rate to base currency when money is spent or received. e.g.0.7500 Only used for bank transactions in non base currency. If this isn’t specified for non base currency accounts then either the user-defined rate (preference) or the XE.com day rate will be used. Setting currency is only supported on overpayments.
    currency-rate: option<f64>,
    /// Date of transaction – YYYY-MM-DD
    date: option<string>,
    /// Boolean to indicate if a bank transaction has an attachment
    has-attachments: option<bool>,
    /// Boolean to show if transaction is reconciled
    is-reconciled: option<bool>,
    line-amount-types: option<line-amount-types>,
    /// See LineItems
    line-items: list<line-item>,
    /// Xero generated unique identifier for an Overpayment. This will be returned on BankTransactions with a Type of SPEND-OVERPAYMENT or RECEIVE-OVERPAYMENT
    overpayment-id: option<string>,
    /// Xero generated unique identifier for a Prepayment. This will be returned on BankTransactions with a Type of SPEND-PREPAYMENT or RECEIVE-PREPAYMENT
    prepayment-id: option<string>,
    /// Reference for the transaction. Only supported for SPEND and RECEIVE transactions.
    reference: option<string>,
    /// See Bank Transaction Status Codes
    status: option<bank-transaction-status-enum>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// Total of bank transaction excluding taxes
    sub-total: option<f64>,
    /// Total of bank transaction tax inclusive
    total: option<f64>,
    /// Total tax on bank transaction
    total-tax: option<f64>,
    /// See Bank Transaction Types
    type-op: bank-transaction-type-op-enum,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    /// URL link to a source document – shown as “Go to App Name”
    url: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  record contact {
    /// A user defined account number. This can be updated via the API and the Xero UI (max length = 50)
    account-number: option<string>,
    /// The tax type from TaxRates
    accounts-payable-tax-type: option<string>,
    /// The tax type from TaxRates
    accounts-receivable-tax-type: option<string>,
    /// Store certain address types for a contact – see address types
    addresses: option<list<address>>,
    /// Displays array of attachments from the API
    attachments: option<list<attachment>>,
    balances: option<balances>,
    /// Bank account number of contact
    bank-account-details: option<string>,
    batch-payments: option<batch-payment-details>,
    branding-theme: option<branding-theme>,
    /// Displays which contact groups a contact is included in
    contact-groups: option<list<contact-group>>,
    /// Xero identifier
    contact-id: option<string>,
    /// This can be updated via the API only i.e. This field is read only on the Xero contact screen, used to identify contacts in external systems (max length = 50). If the Contact Number is used, this is displayed as Contact Code in the Contacts UI in Xero.
    contact-number: option<string>,
    /// See contact persons
    contact-persons: option<list<contact-person>>,
    /// Current status of a contact – see contact status types
    contact-status: option<contact-contact-status-enum>,
    default-currency: option<currency-code>,
    /// The default discount rate for the contact (read only)
    discount: option<f64>,
    /// Email address of contact person (umlauts not supported) (max length  = 255)
    email-address: option<string>,
    /// First name of contact person (max length = 255)
    first-name: option<string>,
    /// A boolean to indicate if a contact has an attachment
    has-attachments: option<bool>,
    /// A boolean to indicate if a contact has an validation errors
    has-validation-errors: option<bool>,
    /// true or false – Boolean that describes if a contact has any AR invoices entered against them. Cannot be set via PUT or POST – it is automatically set when an accounts receivable invoice is generated against this contact.
    is-customer: option<bool>,
    /// true or false – Boolean that describes if a contact that has any AP  invoices entered against them. Cannot be set via PUT or POST – it is automatically set when an accounts payable invoice is generated against this contact.
    is-supplier: option<bool>,
    /// Last name of contact person (max length = 255)
    last-name: option<string>,
    /// Full name of contact/organisation (max length = 255)
    name: option<string>,
    payment-terms: option<payment-term>,
    /// Store certain phone types for a contact – see phone types
    phones: option<list<phone>>,
    /// The default purchases account code for contacts
    purchases-default-account-code: option<string>,
    /// The default purchases tracking categories for contacts
    purchases-tracking-categories: option<list<sales-tracking-category>>,
    /// The default sales account code for contacts
    sales-default-account-code: option<string>,
    /// The default sales tracking categories for contacts
    sales-tracking-categories: option<list<sales-tracking-category>>,
    /// Skype user name of contact
    skype-user-name: option<string>,
    /// Status of object
    status-attribute-string: option<string>,
    /// Tax number of contact – this is also known as the ABN (Australia), GST Number (New Zealand), VAT Number (UK) or Tax ID Number (US and global) in the Xero UI depending on which regionalized version of Xero you are using (max length = 50)
    tax-number: option<string>,
    /// The name of the Tracking Category assigned to the contact under SalesTrackingCategories and PurchasesTrackingCategories
    tracking-category-name: option<string>,
    /// The name of the Tracking Option assigned to the contact under SalesTrackingCategories and PurchasesTrackingCategories
    tracking-category-option: option<string>,
    /// UTC timestamp of last update to contact
    updated-date-utc: option<string>,
    /// Displays validation errors returned from the API
    validation-errors: option<list<validation-error>>,
    /// Website address for contact (read only)
    website: option<string>,
    /// Store XeroNetworkKey for contacts.
    xero-network-key: option<string>
  }

  record address {
    /// max length = 500
    address-line1: option<string>,
    /// max length = 500
    address-line2: option<string>,
    /// max length = 500
    address-line3: option<string>,
    /// max length = 500
    address-line4: option<string>,
    /// define the type of address
    address-type: option<address-address-type-enum>,
    /// max length = 255
    attention-to: option<string>,
    /// max length = 255
    city: option<string>,
    /// max length = 50, [A-Z], [a-z] only
    country: option<string>,
    /// max length = 50
    postal-code: option<string>,
    /// max length = 255
    region: option<string>
  }

  record attachment {
    /// Unique ID for the file
    attachment-id: option<string>,
    /// Length of the file content
    content-length: option<s32>,
    /// Name of the file
    file-name: option<string>,
    /// Include the file with the online invoice
    include-online: option<bool>,
    /// Type of file
    mime-type: option<string>,
    /// URL to the file on xero.com
    url: option<string>
  }

  /// The raw AccountsReceivable(sales invoices) and AccountsPayable(bills) outstanding and overdue amounts, not converted to base currency (read only)
  record balances {
    accounts-payable: option<accounts-payable>,
    accounts-receivable: option<accounts-receivable>
  }

  record accounts-payable {
    outstanding: option<f64>,
    overdue: option<f64>
  }

  record accounts-receivable {
    outstanding: option<f64>,
    overdue: option<f64>
  }

  /// Bank details for use on a batch payment stored with each contact
  record batch-payment-details {
    /// Name of bank for use with Batch Payments
    bank-account-name: option<string>,
    /// Bank account number for use with Batch Payments
    bank-account-number: option<string>,
    /// (NZ Only) Optional references for the batch payment transaction. It will also show with the batch payment transaction in the bank reconciliation Find & Match screen. Depending on your individual bank, the detail may also show on the bank statement you import into Xero.
    code: option<string>,
    /// (Non-NZ Only) These details are sent to the org’s bank as a reference for the batch payment transaction. They will also show with the batch payment transaction in the bank reconciliation Find & Match screen. Depending on your individual bank, the detail may also show on the bank statement imported into Xero. Maximum field length = 18
    details: option<string>,
    /// (NZ Only) Optional references for the batch payment transaction. It will also show with the batch payment transaction in the bank reconciliation Find & Match screen. Depending on your individual bank, the detail may also show on the bank statement you import into Xero.
    reference: option<string>
  }

  record branding-theme {
    /// Xero identifier
    branding-theme-id: option<string>,
    /// UTC timestamp of creation date of branding theme
    created-date-utc: option<string>,
    /// The location of the image file used as the logo on this branding theme
    logo-url: option<string>,
    /// Name of branding theme
    name: option<string>,
    /// Integer – ranked order of branding theme. The default branding theme has a value of 0
    sort-order: option<s32>,
    /// Always INVOICE
    type-op: option<branding-theme-type-op-enum>
  }

  record contact-group {
    /// The Xero identifier for an contact group – specified as a string following the endpoint name. e.g. /297c2dc5-cc47-4afd-8ec8-74990b8761e9
    contact-group-id: option<string>,
    /// The ContactID and Name of Contacts in a contact group. Returned on GETs when the ContactGroupID is supplied in the URL.
    contacts: option<list<string>>,
    /// The Name of the contact group. Required when creating a new contact  group
    name: option<string>,
    /// The Status of a contact group. To delete a contact group update the status to DELETED. Only contact groups with a status of ACTIVE are returned on GETs.
    status: option<contact-group-status-enum>
  }

  record contact-person {
    /// Email address of person
    email-address: option<string>,
    /// First name of person
    first-name: option<string>,
    /// boolean to indicate whether contact should be included on emails with invoices etc.
    include-in-emails: option<bool>,
    /// Last name of person
    last-name: option<string>
  }

  record payment-term {
    bills: option<bill>,
    sales: option<bill>
  }

  record bill {
    /// Day of Month (0-31)
    day: option<s32>,
    type-op: option<payment-term-type>
  }

  record payment-term-type {
    /// opaque schema; raw JSON
    value: string
  }

  record phone {
    /// max length = 10
    phone-area-code: option<string>,
    /// max length = 20
    phone-country-code: option<string>,
    /// max length = 50
    phone-number: option<string>,
    phone-type: option<phone-phone-type-enum>
  }

  record sales-tracking-category {
    /// The default sales tracking category name for contacts
    tracking-category-name: option<string>,
    /// The default purchase tracking category name for contacts
    tracking-option-name: option<string>
  }

  /// Line amounts are exclusive of tax by default if you don’t specify this element. See Line Amount Types
  record line-amount-types {
    /// opaque schema; raw JSON
    value: string
  }

  record line-item {
    /// See Accounts
    account-code: option<string>,
    /// Description needs to be at least 1 char long. A line item with just a description (i.e no unit amount or quantity) can be created by specifying just a <Description> element that contains at least 1 character
    description: option<string>,
    /// Discount amount being applied to a line item. Only supported on ACCREC invoices - ACCPAY invoices and credit notes in Xero do not support discounts.
    discount-amount: option<f64>,
    /// Percentage discount being applied to a line item (only supported on  ACCREC invoices – ACC PAY invoices and credit notes in Xero do not support discounts
    discount-rate: option<f64>,
    /// See Items
    item-code: option<string>,
    /// If you wish to omit either of the <Quantity> or <UnitAmount> you can provide a LineAmount and Xero will calculate the missing amount for you. The line amount reflects the discounted price if a DiscountRate has been used . i.e LineAmount = Quantity * Unit Amount * ((100 – DiscountRate)/100)
    line-amount: option<f64>,
    /// LineItem unique ID
    line-item-id: option<string>,
    /// LineItem Quantity
    quantity: option<f64>,
    /// The Xero identifier for a Repeating Invoice
    repeating-invoice-id: option<string>,
    /// The tax amount is auto calculated as a percentage of the line amount (see below) based on the tax rate. This value can be overriden if the calculated <TaxAmount> is not correct.
    tax-amount: option<f64>,
    /// The tax type from TaxRates
    tax-type: option<string>,
    /// Optional Tracking Category – see Tracking.  Any LineItem can have a  maximum of 2 <TrackingCategory> elements.
    tracking: option<list<line-item-tracking>>,
    /// LineItem Unit Amount
    unit-amount: option<f64>
  }

  record line-item-tracking {
    /// The name of the tracking category
    name: option<string>,
    /// See Tracking Options
    option-op: option<string>,
    /// The Xero identifier for a tracking category
    tracking-category-id: option<string>,
    /// The Xero identifier for a tracking category option
    tracking-option-id: option<string>
  }

  record history-record {
    /// Name of branding theme
    changes: option<string>,
    /// UTC timestamp of creation date of branding theme
    date-utc: option<string>,
    /// details
    details: option<string>,
    /// has a value of 0
    user: option<string>
  }

  record bank-transfer {
    /// amount of the transaction
    amount: f64,
    /// The identifier of the Bank Transfer
    bank-transfer-id: option<string>,
    /// UTC timestamp of creation date of bank transfer
    created-date-utc: option<string>,
    /// The currency rate
    currency-rate: option<f64>,
    /// The date of the Transfer YYYY-MM-DD
    date: option<string>,
    from-bank-account: account,
    /// The Bank Transaction ID for the source account
    from-bank-transaction-id: option<string>,
    /// Boolean to indicate if a Bank Transfer has an attachment
    has-attachments: option<bool>,
    to-bank-account: account,
    /// The Bank Transaction ID for the destination account
    to-bank-transaction-id: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  record batch-payment {
    account: option<account>,
    /// The amount of the payment. Must be less than or equal to the outstanding amount owing on the invoice e.g. 200.00
    amount: option<f64>,
    /// The Xero generated unique identifier for the bank transaction (read-only)
    batch-payment-id: option<string>,
    /// (NZ Only) Optional references for the batch payment transaction. It will also show with the batch payment transaction in the bank reconciliation Find & Match screen. Depending on your individual bank, the detail may also show on the bank statement you import into Xero.
    code: option<string>,
    /// Date the payment is being made (YYYY-MM-DD) e.g. 2009-09-06
    date: option<string>,
    /// Date the payment is being made (YYYY-MM-DD) e.g. 2009-09-06
    date-string: option<string>,
    /// (Non-NZ Only) These details are sent to the org’s bank as a reference for the batch payment transaction. They will also show with the batch payment transaction in the bank reconciliation Find & Match screen. Depending on your individual bank, the detail may also show on the bank statement imported into Xero. Maximum field length = 18
    details: option<string>,
    /// Booelan that tells you if the batch payment has been reconciled (read-only)
    is-reconciled: option<string>,
    /// (UK Only) Only shows on the statement line in Xero. Max length =18
    narrative: option<string>,
    /// (NZ Only) Optional references for the batch payment transaction. It will also show with the batch payment transaction in the bank reconciliation Find & Match screen. Depending on your individual bank, the detail may also show on the bank statement you import into Xero.
    particulars: option<string>,
    /// An array of payments
    payments: option<list<payment>>,
    /// (NZ Only) Optional references for the batch payment transaction. It will also show with the batch payment transaction in the bank reconciliation Find & Match screen. Depending on your individual bank, the detail may also show on the bank statement you import into Xero.
    reference: option<string>,
    /// AUTHORISED or DELETED (read-only). New batch payments will have a status of AUTHORISED. It is not possible to delete batch payments via the API.
    status: option<payment-status-enum>,
    /// The total of the payments that make up the batch (read-only)
    total-amount: option<string>,
    /// PAYBATCH for bill payments or RECBATCH for sales invoice payments (read-only)
    type-op: option<batch-payment-type-op-enum>,
    /// UTC timestamp of last update to the payment
    updated-date-utc: option<string>
  }

  record payment {
    account: option<account>,
    /// The amount of the payment. Must be less than or equal to the outstanding amount owing on the invoice e.g. 200.00
    amount: option<f64>,
    /// The suppliers bank account number the payment is being made to
    bank-account-number: option<string>,
    /// Present if the payment was created as part of a batch.
    batch-payment-id: option<string>,
    /// Code of account you are using to make the payment e.g. 001 (note- not all accounts have a code value)
    code: option<string>,
    credit-note: option<credit-note>,
    /// Number of invoice or credit note you are applying payment to e.g. INV-4003
    credit-note-number: option<string>,
    /// Exchange rate when payment is received. Only used for non base currency invoices and credit notes e.g. 0.7500
    currency-rate: option<f64>,
    /// Date the payment is being made (YYYY-MM-DD) e.g. 2009-09-06
    date: option<string>,
    /// The information to appear on the supplier's bank account
    details: option<string>,
    /// A boolean to indicate if a contact has an validation errors
    has-account: option<bool>,
    /// A boolean to indicate if a contact has an validation errors
    has-validation-errors: option<bool>,
    invoice: option<invoice>,
    /// Number of invoice or credit note you are applying payment to e.g.INV-4003
    invoice-number: option<string>,
    /// An optional parameter for the payment. A boolean indicating whether you would like the payment to be created as reconciled when using PUT, or whether a payment has been reconciled when using GET
    is-reconciled: option<bool>,
    overpayment: option<overpayment>,
    /// The suppliers bank account number the payment is being made to
    particulars: option<string>,
    /// The Xero identifier for an Payment e.g. 297c2dc5-cc47-4afd-8ec8-74990b8761e9
    payment-id: option<string>,
    /// See Payment Types.
    payment-type: option<payment-payment-type-enum>,
    prepayment: option<prepayment>,
    /// An optional description for the payment e.g. Direct Debit
    reference: option<string>,
    /// The status of the payment.
    status: option<payment-status-enum>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// UTC timestamp of last update to the payment
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  record credit-note {
    /// See Allocations
    allocations: option<list<allocation>>,
    /// The amount of applied to an invoice
    applied-amount: option<f64>,
    /// See BrandingThemes
    branding-theme-id: option<string>,
    /// CIS deduction for UK contractors
    cis-deduction: option<f64>,
    /// CIS Deduction rate for the organisation
    cis-rate: option<f64>,
    contact: option<contact>,
    /// Xero generated unique identifier
    credit-note-id: option<string>,
    /// ACCRECCREDIT – Unique alpha numeric code identifying credit note (when missing will auto-generate from your Organisation Invoice Settings)
    credit-note-number: option<string>,
    currency-code: option<currency-code>,
    /// The currency rate for a multicurrency invoice. If no rate is specified, the XE.com day rate is used
    currency-rate: option<f64>,
    /// The date the credit note is issued YYYY-MM-DD. If the Date element is not specified then it will default to the current date based on the timezone setting of the organisation
    date: option<string>,
    /// Date invoice is due – YYYY-MM-DD
    due-date: option<string>,
    /// Date when credit note was fully paid(UTC format)
    fully-paid-on-date: option<string>,
    /// boolean to indicate if a credit note has an attachment
    has-attachments: option<bool>,
    /// A boolean to indicate if a credit note has an validation errors
    has-errors: option<bool>,
    line-amount-types: option<line-amount-types>,
    /// See Invoice Line Items
    line-items: option<list<line-item>>,
    /// See Payments
    payments: option<list<string>>,
    /// ACCRECCREDIT only – additional reference number
    reference: option<string>,
    /// The remaining credit balance on the Credit Note
    remaining-credit: option<f64>,
    /// boolean to indicate if a credit note has been sent to a contact via  the Xero app (currently read only)
    sent-to-contact: option<bool>,
    /// See Credit Note Status Codes
    status: option<invoice-status-enum>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// The subtotal of the credit note excluding taxes
    sub-total: option<f64>,
    /// The total of the Credit Note(subtotal + total tax)
    total: option<f64>,
    /// The total tax on the credit note
    total-tax: option<f64>,
    /// See Credit Note Types
    type-op: option<credit-note-type-op-enum>,
    /// UTC timestamp of last update to the credit note
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>,
    /// Displays array of warning messages from the API
    warnings: option<list<validation-error>>
  }

  record allocation {
    /// the amount being applied to the invoice
    amount: f64,
    credit-note: option<string>,
    /// the date the allocation is applied YYYY-MM-DD.
    date: string,
    invoice: invoice,
    overpayment: option<overpayment>,
    prepayment: option<prepayment>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  record invoice {
    /// Sum of all credit notes, over-payments and pre-payments applied to invoice
    amount-credited: option<f64>,
    /// Amount remaining to be paid on invoice
    amount-due: option<f64>,
    /// Sum of payments received for invoice
    amount-paid: option<f64>,
    /// Displays array of attachments from the API
    attachments: option<list<attachment>>,
    /// See BrandingThemes
    branding-theme-id: option<string>,
    /// CIS deduction for UK contractors
    cis-deduction: option<f64>,
    /// CIS Deduction rate for the organisation
    cis-rate: option<f64>,
    contact: option<contact>,
    /// Details of credit notes that have been applied to an invoice
    credit-notes: option<list<string>>,
    currency-code: option<currency-code>,
    /// The currency rate for a multicurrency invoice. If no rate is specified, the XE.com day rate is used. (max length = [18].[6])
    currency-rate: option<f64>,
    /// Date invoice was issued – YYYY-MM-DD. If the Date element is not specified it will default to the current date based on the timezone setting of the organisation
    date: option<string>,
    /// Date invoice is due – YYYY-MM-DD
    due-date: option<string>,
    /// Shown on sales invoices (Accounts Receivable) when this has been set
    expected-payment-date: option<string>,
    /// The date the invoice was fully paid. Only returned on fully paid invoices
    fully-paid-on-date: option<string>,
    /// boolean to indicate if an invoice has an attachment
    has-attachments: option<bool>,
    /// A boolean to indicate if a invoice has an validation errors
    has-errors: option<bool>,
    /// Xero generated unique identifier for invoice
    invoice-id: option<string>,
    /// ACCREC – Unique alpha numeric code identifying invoice (when missing will auto-generate from your Organisation Invoice Settings) (max length = 255)
    invoice-number: option<string>,
    /// boolean to indicate if an invoice has a discount
    is-discounted: option<bool>,
    line-amount-types: option<line-amount-types>,
    /// See LineItems
    line-items: option<list<line-item>>,
    /// See Overpayments
    overpayments: option<list<overpayment>>,
    /// See Payments
    payments: option<list<string>>,
    /// Shown on bills (Accounts Payable) when this has been set
    planned-payment-date: option<string>,
    /// See Prepayments
    prepayments: option<list<prepayment>>,
    /// ACCREC only – additional reference number
    reference: option<string>,
    /// Xero generated unique identifier for repeating invoices
    repeating-invoice-id: option<string>,
    /// Boolean to set whether the invoice in the Xero app should be marked as “sent”. This can be set only on invoices that have been approved
    sent-to-contact: option<bool>,
    /// See Invoice Status Codes
    status: option<invoice-status-enum>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// Total of invoice excluding taxes
    sub-total: option<f64>,
    /// Total of Invoice tax inclusive (i.e. SubTotal + TotalTax). This will be ignored if it doesn’t equal the sum of the LineAmounts
    total: option<f64>,
    /// Total of discounts applied on the invoice line items
    total-discount: option<f64>,
    /// Total tax on invoice
    total-tax: option<f64>,
    /// See Invoice Types
    type-op: option<invoice-type-op-enum>,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    /// URL link to a source document – shown as “Go to [appName]” in the Xero app
    url: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>,
    /// Displays array of warning messages from the API
    warnings: option<list<validation-error>>
  }

  record overpayment {
    /// See Allocations
    allocations: option<list<string>>,
    /// The amount of applied to an invoice
    applied-amount: option<f64>,
    /// See Attachments
    attachments: option<list<attachment>>,
    contact: option<contact>,
    currency-code: option<currency-code>,
    /// The currency rate for a multicurrency overpayment. If no rate is specified, the XE.com day rate is used
    currency-rate: option<f64>,
    /// The date the overpayment is created YYYY-MM-DD
    date: option<string>,
    /// boolean to indicate if a overpayment has an attachment
    has-attachments: option<bool>,
    line-amount-types: option<line-amount-types>,
    /// See Overpayment Line Items
    line-items: option<list<line-item>>,
    /// Xero generated unique identifier
    overpayment-id: option<string>,
    /// See Payments
    payments: option<list<string>>,
    /// The remaining credit balance on the overpayment
    remaining-credit: option<f64>,
    /// See Overpayment Status Codes
    status: option<overpayment-status-enum>,
    /// The subtotal of the overpayment excluding taxes
    sub-total: option<f64>,
    /// The total of the overpayment (subtotal + total tax)
    total: option<f64>,
    /// The total tax on the overpayment
    total-tax: option<f64>,
    /// See Overpayment Types
    type-op: option<overpayment-type-op-enum>,
    /// UTC timestamp of last update to the overpayment
    updated-date-utc: option<string>
  }

  record prepayment {
    /// See Allocations
    allocations: option<list<string>>,
    /// The amount of applied to an invoice
    applied-amount: option<f64>,
    /// See Attachments
    attachments: option<list<attachment>>,
    contact: option<contact>,
    currency-code: option<currency-code>,
    /// The currency rate for a multicurrency prepayment. If no rate is specified, the XE.com day rate is used
    currency-rate: option<f64>,
    /// The date the prepayment is created YYYY-MM-DD
    date: option<string>,
    /// boolean to indicate if a prepayment has an attachment
    has-attachments: option<bool>,
    line-amount-types: option<line-amount-types>,
    /// See Prepayment Line Items
    line-items: option<list<line-item>>,
    /// Xero generated unique identifier
    prepayment-id: option<string>,
    /// Returns Invoice number field. Reference field isn't available.
    reference: option<string>,
    /// The remaining credit balance on the prepayment
    remaining-credit: option<f64>,
    /// See Prepayment Status Codes
    status: option<overpayment-status-enum>,
    /// The subtotal of the prepayment excluding taxes
    sub-total: option<f64>,
    /// The total of the prepayment(subtotal + total tax)
    total: option<f64>,
    /// The total tax on the prepayment
    total-tax: option<f64>,
    /// See Prepayment Types
    type-op: option<prepayment-type-op-enum>,
    /// UTC timestamp of last update to the prepayment
    updated-date-utc: option<string>
  }

  record payment-service {
    /// The text displayed on the Pay Now button in Xero Online Invoicing. If this is not set it will default to Pay by credit card
    pay-now-text: option<string>,
    /// Xero identifier
    payment-service-id: option<string>,
    /// Name of payment service
    payment-service-name: option<string>,
    /// This will always be CUSTOM for payment services created via the API.
    payment-service-type: option<string>,
    /// The custom payment URL
    payment-service-url: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  record employee {
    /// The Xero identifier for an employee e.g. 297c2dc5-cc47-4afd-8ec8-74990b8761e9
    employee-id: option<string>,
    external-link: option<external-link>,
    /// First name of an employee (max length = 255)
    first-name: option<string>,
    /// Last name of an employee (max length = 255)
    last-name: option<string>,
    /// Current status of an employee – see contact status types
    status: option<employee-status-enum>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  record external-link {
    description: option<string>,
    /// See External link types
    link-type: option<external-link-link-type-enum>,
    /// URL for service e.g. http://twitter.com/xeroapi
    url: option<string>
  }

  record expense-claim {
    /// The amount due to be paid for an expense claim
    amount-due: option<f64>,
    /// The amount still to pay for an expense claim
    amount-paid: option<f64>,
    /// Xero generated unique identifier for an expense claim
    expense-claim-id: option<string>,
    /// The date when the expense claim is due to be paid YYYY-MM-DD
    payment-due-date: option<string>,
    /// See Payments
    payments: option<list<payment>>,
    /// The Xero identifier for the Receipt e.g. e59a2c7f-1306-4078-a0f3-73537afcbba9
    receipt-id: option<string>,
    receipts: option<list<receipt>>,
    /// The date the expense claim will be reported in Xero YYYY-MM-DD
    reporting-date: option<string>,
    /// Current status of an expense claim – see status types
    status: option<expense-claim-status-enum>,
    /// The total of an expense claim being paid
    total: option<f64>,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    user: option<user>
  }

  record receipt {
    /// Displays array of attachments from the API
    attachments: option<list<attachment>>,
    contact: option<contact>,
    /// Date of receipt – YYYY-MM-DD
    date: option<string>,
    /// boolean to indicate if a receipt has an attachment
    has-attachments: option<bool>,
    line-amount-types: option<line-amount-types>,
    line-items: option<list<line-item>>,
    /// Xero generated unique identifier for receipt
    receipt-id: option<string>,
    /// Xero generated sequence number for receipt in current claim for a given user
    receipt-number: option<string>,
    /// Additional reference number
    reference: option<string>,
    /// Current status of receipt – see status types
    status: option<receipt-status-enum>,
    /// Total of receipt excluding taxes
    sub-total: option<f64>,
    /// Total of receipt tax inclusive (i.e. SubTotal + TotalTax)
    total: option<f64>,
    /// Total tax on receipt
    total-tax: option<f64>,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    /// URL link to a source document – shown as “Go to [appName]” in the Xero app
    url: option<string>,
    user: option<user>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>,
    /// Displays array of warning messages from the API
    warnings: option<list<validation-error>>
  }

  record user {
    /// Email address of user
    email-address: option<string>,
    /// First name of user
    first-name: option<string>,
    /// Boolean to indicate if user is the subscriber
    is-subscriber: option<bool>,
    /// Last name of user
    last-name: option<string>,
    /// User role that defines permissions in Xero and via API (READONLY, INVOICEONLY, STANDARD, FINANCIALADVISER, etc)
    organisation-role: option<user-organisation-role-enum>,
    /// Timestamp of last change to user
    updated-date-utc: option<string>,
    /// Xero identifier
    user-id: option<string>
  }

  record item {
    /// User defined item code (max length = 30)
    code: string,
    /// The sales description of the item (max length = 4000)
    description: option<string>,
    /// The inventory asset account for the item. The account must be of type INVENTORY. The  COGSAccountCode in PurchaseDetails is also required to create a tracked item
    inventory-asset-account-code: option<string>,
    /// Boolean value, defaults to true. When IsPurchased is true the item is available for purchase transactions in the Xero UI. If IsPurchased is updated to false then PurchaseDescription and PurchaseDetails values will be nulled.
    is-purchased: option<bool>,
    /// Boolean value, defaults to true. When IsSold is true the item will be available on sales transactions in the Xero UI. If IsSold is updated to false then Description and SalesDetails values will be nulled.
    is-sold: option<bool>,
    /// True for items that are tracked as inventory. An item will be tracked as inventory if the InventoryAssetAccountCode and COGSAccountCode are set.
    is-tracked-as-inventory: option<bool>,
    /// The Xero identifier for an Item
    item-id: option<string>,
    /// The name of the item (max length = 50)
    name: option<string>,
    /// The purchase description of the item (max length = 4000)
    purchase-description: option<string>,
    purchase-details: option<purchase>,
    /// The quantity of the item on hand
    quantity-on-hand: option<f64>,
    sales-details: option<purchase>,
    /// Status of object
    status-attribute-string: option<string>,
    /// The value of the item on hand. Calculated using average cost accounting.
    total-cost-pool: option<f64>,
    /// Last modified date in UTC format
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  record purchase {
    /// Default account code to be used for purchased/sale. Not applicable to the purchase details of tracked items
    account-code: option<string>,
    /// Cost of goods sold account. Only applicable to the purchase details of tracked items.
    cogs-account-code: option<string>,
    /// The tax type from TaxRates
    tax-type: option<string>,
    /// Unit Price of the item. By default UnitPrice is rounded to two decimal places. You can use 4 decimal places by adding the unitdp=4 querystring parameter to your request.
    unit-price: option<f64>
  }

  record linked-transaction {
    /// Filter by the combination of ContactID and Status. Get all the linked transactions that have been assigned to a particular customer and have a particular status e.g. GET /LinkedTransactions?ContactID=4bb34b03-3378-4bb2-a0ed-6345abf3224e&Status=APPROVED.
    contact-id: option<string>,
    /// The Xero identifier for an Linked Transaction e.g./LinkedTransactions/297c2dc5-cc47-4afd-8ec8-74990b8761e9
    linked-transaction-id: option<string>,
    /// The line item identifier from the source transaction.
    source-line-item-id: option<string>,
    /// Filter by the SourceTransactionID. Get all the linked transactions created from a particular ACCPAY invoice
    source-transaction-id: option<string>,
    /// The Type of the source tranasction. This will be ACCPAY if the linked transaction was created from an invoice and SPEND if it was created from a bank transaction.
    source-transaction-type-code: option<linked-transaction-source-transaction-type-code-enum>,
    /// Filter by the combination of ContactID and Status. Get all the linked transactions that have been assigned to a particular customer and have a particular status e.g. GET /LinkedTransactions?ContactID=4bb34b03-3378-4bb2-a0ed-6345abf3224e&Status=APPROVED.
    status: option<linked-transaction-status-enum>,
    /// The line item identifier from the target transaction. It is possible  to link multiple billable expenses to the same TargetLineItemID.
    target-line-item-id: option<string>,
    /// Filter by the TargetTransactionID. Get all the linked transactions  allocated to a particular ACCREC invoice
    target-transaction-id: option<string>,
    /// This will always be BILLABLEEXPENSE. More types may be added in future.
    type-op: option<linked-transaction-type-op-enum>,
    /// The last modified date in UTC format
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  record manual-journal {
    /// Displays array of attachments from the API
    attachments: option<list<attachment>>,
    /// Date journal was posted – YYYY-MM-DD
    date: option<string>,
    /// Boolean to indicate if a manual journal has an attachment
    has-attachments: option<bool>,
    /// See JournalLines
    journal-lines: option<list<manual-journal-line>>,
    line-amount-types: option<line-amount-types>,
    /// The Xero identifier for a Manual Journal
    manual-journal-id: option<string>,
    /// Description of journal being posted
    narration: string,
    /// Boolean – default is true if not specified
    show-on-cash-basis-reports: option<bool>,
    /// See Manual Journal Status Codes
    status: option<manual-journal-status-enum>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    /// Url link to a source document – shown as “Go to [appName]” in the Xero app
    url: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>,
    /// Displays array of warning messages from the API
    warnings: option<list<validation-error>>
  }

  record manual-journal-line {
    /// See Accounts
    account-code: option<string>,
    /// See Accounts
    account-id: option<string>,
    /// Description for journal line
    description: option<string>,
    /// is the line blank
    is-blank: option<bool>,
    /// total for line. Debits are positive, credits are negative value
    line-amount: option<f64>,
    /// The calculated tax amount based on the TaxType and LineAmount
    tax-amount: option<f64>,
    /// The tax type from TaxRates
    tax-type: option<string>,
    /// Optional Tracking Category – see Tracking. Any JournalLine can have a maximum of 2 <TrackingCategory> elements.
    tracking: option<list<tracking-category>>
  }

  record tracking-category {
    /// The name of the tracking category e.g. Department, Region (max length = 100)
    name: option<string>,
    /// The option name of the tracking option e.g. East, West (max length = 100)
    option-op: option<string>,
    /// See Tracking Options
    options: option<list<tracking-option>>,
    /// The status of a tracking category
    status: option<account-status-enum>,
    /// The Xero identifier for a tracking category e.g. 297c2dc5-cc47-4afd-8ec8-74990b8761e9
    tracking-category-id: option<string>,
    /// The Xero identifier for a tracking option e.g. dc54c220-0140-495a-b925-3246adc0075f
    tracking-option-id: option<string>
  }

  record tracking-option {
    /// The name of the tracking option e.g. Marketing, East (max length = 100)
    name: option<string>,
    /// The status of a tracking option
    status: option<account-status-enum>,
    /// Filter by a tracking category e.g. 297c2dc5-cc47-4afd-8ec8-74990b8761e9
    tracking-category-id: option<string>,
    /// The Xero identifier for a tracking option e.g. ae777a87-5ef3-4fa0-a4f0-d10e1f13073a
    tracking-option-id: option<string>
  }

  record purchase-order {
    /// Displays array of attachments from the API
    attachments: option<list<attachment>>,
    /// The person that the delivery is going to
    attention-to: option<string>,
    /// See BrandingThemes
    branding-theme-id: option<string>,
    contact: option<contact>,
    currency-code: option<currency-code>,
    /// The currency rate for a multicurrency purchase order. If no rate is specified, the XE.com day rate is used.
    currency-rate: option<f64>,
    /// Date purchase order was issued – YYYY-MM-DD. If the Date element is not specified then it will default to the current date based on the timezone setting of the organisation
    date: option<string>,
    /// The address the goods are to be delivered to
    delivery-address: option<string>,
    /// Date the goods are to be delivered – YYYY-MM-DD
    delivery-date: option<string>,
    /// A free text feild for instructions (500 characters max)
    delivery-instructions: option<string>,
    /// The date the goods are expected to arrive.
    expected-arrival-date: option<string>,
    /// boolean to indicate if a purchase order has an attachment
    has-attachments: option<bool>,
    line-amount-types: option<line-amount-types>,
    /// See LineItems
    line-items: option<list<line-item>>,
    /// Xero generated unique identifier for purchase order
    purchase-order-id: option<string>,
    /// Unique alpha numeric code identifying purchase order (when missing will auto-generate from your Organisation Invoice Settings)
    purchase-order-number: option<string>,
    /// Additional reference number
    reference: option<string>,
    /// Boolean to set whether the purchase order should be marked as “sent”. This can be set only on purchase orders that have been approved or billed
    sent-to-contact: option<bool>,
    /// See Purchase Order Status Codes
    status: option<get-purchase-orders-status-enum>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// Total of purchase order excluding taxes
    sub-total: option<f64>,
    /// The phone number for the person accepting the delivery
    telephone: option<string>,
    /// Total of Purchase Order tax inclusive (i.e. SubTotal + TotalTax)
    total: option<f64>,
    /// Total of discounts applied on the purchase order line items
    total-discount: option<f64>,
    /// Total tax on purchase order
    total-tax: option<f64>,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>,
    /// Displays array of warning messages from the API
    warnings: option<list<validation-error>>
  }

  record quote {
    /// See BrandingThemes
    branding-theme-id: option<string>,
    contact: option<contact>,
    currency-code: option<currency-code>,
    /// The currency rate for a multicurrency quote
    currency-rate: option<f64>,
    /// Date quote was issued – YYYY-MM-DD. If the Date element is not specified it will default to the current date based on the timezone setting of the organisation
    date: option<string>,
    /// Date the quote was issued (YYYY-MM-DD)
    date-string: option<string>,
    /// Date the quote expires – YYYY-MM-DD.
    expiry-date: option<string>,
    /// Date the quote expires – YYYY-MM-DD.
    expiry-date-string: option<string>,
    line-amount-types: option<quote-line-amount-types>,
    /// See LineItems
    line-items: option<list<line-item>>,
    /// QuoteID GUID is automatically generated and is returned after create or GET.
    quote-id: option<string>,
    /// Unique alpha numeric code identifying a quote (Max Length = 255)
    quote-number: option<string>,
    /// Additional reference number
    reference: option<string>,
    status: option<quote-status-codes>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// Total of quote excluding taxes.
    sub-total: option<f64>,
    /// Summary text for the quote
    summary: option<string>,
    /// Terms of the quote
    terms: option<string>,
    /// Title text for the quote
    title: option<string>,
    /// Total of Quote tax inclusive (i.e. SubTotal + TotalTax). This will be ignored if it doesn’t equal the sum of the LineAmounts
    total: option<f64>,
    /// Total of discounts applied on the quote line items
    total-discount: option<f64>,
    /// Total tax on quote
    total-tax: option<f64>,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }

  /// Line amounts are exclusive of tax by default if you don’t specify this element. See Line Amount Types
  record quote-line-amount-types {
    /// opaque schema; raw JSON
    value: string
  }

  /// The status of the quote.
  record quote-status-codes {
    /// opaque schema; raw JSON
    value: string
  }

  /// Balance supplied for each account that has a value as at the conversion date.
  record conversion-balances {
    /// The account code for a account
    account-code: option<string>,
    /// The opening balances of the account. Debits are positive, credits are negative values
    balance: option<f64>,
    balance-details: option<list<balance-details>>
  }

  /// An array to specify multiple currency balances of an account
  record balance-details {
    /// The opening balances of the account. Debits are positive, credits are negative values
    balance: option<f64>,
    /// The currency of the balance (Not required for base currency)
    currency-code: option<string>,
    /// (Optional) Exchange rate to base currency when money is spent or received. If not specified, XE rate for the day is applied
    currency-rate: option<f64>
  }

  /// The date when the organisation starts using Xero
  record conversion-date {
    /// The month the organisation starts using Xero. Value is an integer between 1 and 12
    month: option<s32>,
    /// The year the organisation starts using Xero. Value is an integer greater than 2006
    year: option<s32>
  }

  record tax-rate {
    /// Boolean to describe if tax rate can be used for asset accounts i.e.  true,false
    can-apply-to-assets: option<bool>,
    /// Boolean to describe if tax rate can be used for equity accounts i.e true,false
    can-apply-to-equity: option<bool>,
    /// Boolean to describe if tax rate can be used for expense accounts  i.e. true,false
    can-apply-to-expenses: option<bool>,
    /// Boolean to describe if tax rate can be used for liability accounts  i.e. true,false
    can-apply-to-liabilities: option<bool>,
    /// Boolean to describe if tax rate can be used for revenue accounts i.e. true,false
    can-apply-to-revenue: option<bool>,
    /// Tax Rate (decimal to 4dp) e.g 12.5000
    display-tax-rate: option<f64>,
    /// Effective Tax Rate (decimal to 4dp) e.g 12.5000
    effective-rate: option<f64>,
    /// Name of tax rate
    name: option<string>,
    /// See ReportTaxTypes
    report-tax-type: option<tax-rate-report-tax-type-enum>,
    /// See Status Codes
    status: option<tax-rate-status-enum>,
    /// See TaxComponents
    tax-components: option<list<tax-component>>,
    /// The tax type
    tax-type: option<string>
  }

  record tax-component {
    /// Boolean to describe if Tax rate is compounded.
    is-compound: option<bool>,
    /// Boolean to describe if tax rate is non-recoverable. Non-recoverable rates are only applicable to Canadian organisations
    is-non-recoverable: option<bool>,
    /// Name of Tax Component
    name: option<string>,
    /// Tax Rate (up to 4dp)
    rate: option<f64>
  }

  /// Retrieves the full chart of accounts
  record get-accounts-params {
    /// Only records created or modified since this timestamp will be returned
    if-modified-since: option<string>,
    /// Filter by an any element
    where: option<string>,
    /// Order by an any element
    order: option<string>
  }
  get-accounts: func(params: get-accounts-params) -> result<string, string>;

  /// Creates a new chart of accounts
  record create-account-params {
    /// The Xero identifier for an account – specified as a string following  the endpoint name   e.g. /297c2dc5-cc47-4afd-8ec8-74990b8761e9
    account-id: option<string>,
    /// Boolean – describes whether the account is shown in the watchlist widget on the dashboard
    add-to-watchlist: option<bool>,
    /// For bank accounts only (Account Type BANK)
    bank-account-number: option<string>,
    /// For bank accounts only. See Bank Account types
    bank-account-type: option<account-bank-account-type-enum>,
    /// See Account Class Types
    class: option<account-class-enum>,
    /// Customer defined alpha numeric account code e.g 200 or SALES (max length = 10)
    code: option<string>,
    currency-code: option<currency-code>,
    /// Description of the Account. Valid for all types of accounts except bank accounts (max length = 4000)
    description: option<string>,
    /// Boolean – describes whether account can have payments applied to it
    enable-payments-to-account: option<bool>,
    /// boolean to indicate if an account has an attachment (read only)
    has-attachments: option<bool>,
    /// Name of account (max length = 150)
    name: option<string>,
    /// Shown if set
    reporting-code: option<string>,
    /// Shown if set
    reporting-code-name: option<string>,
    /// Boolean – describes whether account code is available for use with expense claims
    show-in-expense-claims: option<bool>,
    /// Accounts with a status of ACTIVE can be updated to ARCHIVED. See Account Status Codes
    status: option<account-status-enum>,
    /// If this is a system account then this element is returned. See System Account types. Note that non-system accounts may have this element set as either “” or null.
    system-account: option<account-system-account-enum>,
    /// The tax type from TaxRates
    tax-type: option<string>,
    type-op: option<account-type>,
    /// Last modified date UTC format
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }
  create-account: func(params: create-account-params) -> result<string, string>;

  /// Retrieves a single chart of accounts by using a unique account Id
  record get-account-params {
    /// Unique identifier for retrieving single object
    account-id: string
  }
  get-account: func(params: get-account-params) -> result<string, string>;

  /// Updates a chart of accounts
  record update-account-params {
    /// Unique identifier for retrieving single object
    account-id: string,
    accounts: option<list<account>>
  }
  update-account: func(params: update-account-params) -> result<string, string>;

  /// Deletes a chart of accounts
  record delete-account-params {
    /// Unique identifier for retrieving single object
    account-id: string
  }
  delete-account: func(params: delete-account-params) -> result<string, string>;

