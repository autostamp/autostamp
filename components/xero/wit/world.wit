/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `OAuth2` | `Authorization: Bearer <secret>` |
package autostamp:xero@0.5.0;

interface identity {
  record connection {
    /// Identifier shared across connections authorised at the same time
    auth-event-id: option<string>,
    /// The date when the user connected this tenant to your app
    created-date-utc: option<string>,
    /// Xero identifier
    id: option<string>,
    /// Xero identifier of organisation
    tenant-id: option<string>,
    /// Xero tenant name
    tenant-name: option<string>,
    /// Xero tenant type (i.e. ORGANISATION, PRACTICE)
    tenant-type: option<string>,
    /// The date when the user most recently connected this tenant to your app. May differ to the created date if the user has disconnected and subsequently reconnected this tenant to your app.
    updated-date-utc: option<string>
  }

  variant delete-connection-error {
    not-found(string),
    other(string)
  }

  /// Retrieves the connections for this user
  record get-connections-params {
    /// Filter by authEventId
    auth-event-id: option<string>
  }
  get-connections: func(params: get-connections-params) -> result<list<connection>, string>;

  /// Deletes a connection for this user (i.e. disconnect a tenant)
  record delete-connection-params {
    /// Unique identifier for retrieving single object
    id: string
  }
  delete-connection: func(params: delete-connection-params) -> result<string, delete-connection-error>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export identity;
}
