  /// Creates a single payment for invoice or credit notes
  record create-payment-params {
    account: option<account>,
    /// The amount of the payment. Must be less than or equal to the outstanding amount owing on the invoice e.g. 200.00
    amount: option<f64>,
    /// The suppliers bank account number the payment is being made to
    bank-account-number: option<string>,
    /// Present if the payment was created as part of a batch.
    batch-payment-id: option<string>,
    /// Code of account you are using to make the payment e.g. 001 (note- not all accounts have a code value)
    code: option<string>,
    credit-note: option<credit-note>,
    /// Number of invoice or credit note you are applying payment to e.g. INV-4003
    credit-note-number: option<string>,
    /// Exchange rate when payment is received. Only used for non base currency invoices and credit notes e.g. 0.7500
    currency-rate: option<f64>,
    /// Date the payment is being made (YYYY-MM-DD) e.g. 2009-09-06
    date: option<string>,
    /// The information to appear on the supplier's bank account
    details: option<string>,
    /// A boolean to indicate if a contact has an validation errors
    has-account: option<bool>,
    /// A boolean to indicate if a contact has an validation errors
    has-validation-errors: option<bool>,
    invoice: option<invoice>,
    /// Number of invoice or credit note you are applying payment to e.g.INV-4003
    invoice-number: option<string>,
    /// An optional parameter for the payment. A boolean indicating whether you would like the payment to be created as reconciled when using PUT, or whether a payment has been reconciled when using GET
    is-reconciled: option<bool>,
    overpayment: option<overpayment>,
    /// The suppliers bank account number the payment is being made to
    particulars: option<string>,
    /// The Xero identifier for an Payment e.g. 297c2dc5-cc47-4afd-8ec8-74990b8761e9
    payment-id: option<string>,
    /// See Payment Types.
    payment-type: option<payment-payment-type-enum>,
    prepayment: option<prepayment>,
    /// An optional description for the payment e.g. Direct Debit
    reference: option<string>,
    /// The status of the payment.
    status: option<payment-status-enum>,
    /// A string to indicate if a invoice status
    status-attribute-string: option<string>,
    /// UTC timestamp of last update to the payment
    updated-date-utc: option<string>,
    /// Displays array of validation error messages from the API
    validation-errors: option<list<validation-error>>
  }
  create-payment: func(params: create-payment-params) -> result<string, string>;

