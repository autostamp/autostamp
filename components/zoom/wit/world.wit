  /// Update Zoom Room account settings
  record update-zoom-room-acc-settings-params {
    /// The type of setting that you would like to update.<br> `alert`: Alert Settings applied on the Zoom Rooms Account.<br>
    /// `meeting`: Meeting settings of the Zoom Rooms Account.<br>
    setting-type: string,
    body: option<string>
  }
  update-zoom-room-acc-settings: func(params: update-zoom-room-acc-settings-params) -> result<string, string>;

}

interface rooms-location {
  record update-zr-location-profile-body-basic {
    /// Address. Can only be updated for Campus and Building.
    address: option<string>,
    /// Description about the location.
    description: option<string>,
    /// Name of the location type.
    name: option<string>,
    /// Require code to exit out of your Zoom Rooms application to switch between other apps.
    required-code-to-ext: option<bool>,
    /// 1-16 digit number or characters that is used to secure your Zoom Rooms application.
    room-passcode: option<string>,
    /// The email address to be used for reporting Zoom Room issues.
    support-email: option<string>,
    /// The phone number to be used for reporting Zoom Room issues.
    support-phone: option<string>,
    /// Timezone (can only be updated for location type - city).
    timezone: option<string>
  }

  /// List Zoom Room locations
  record list-zr-locations-params {
    /// A unique identifier of the parent location. For instance, if a Zoom Room is located in Floor 1 of Building A, the location of Building A will be the parent location of Floor 1. Use this parameter to filter the response by a specific location hierarchy level.
    parent-location-id: option<string>,
    /// Use this field to filter the response by the type of location. The value can be one of the following:
    /// `country`, `states`, `city`, `campus`, `building`, `floor`. 
    type-op: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-zr-locations: func(params: list-zr-locations-params) -> result<string, string>;

  /// Add a location
  record add-azr-location-params {
    /// Name of the location. The name must be unique and shouldn't have already been used in the same account.
    name: option<string>,
    /// The location ID of the location that is a level higher from the location that is being added.<br><br> For example, to add a City named "City 1" as the child location under a State named "State 1", you must provide the location ID of "State 1". This can be retrieved using the [List Zoom Room Locations](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms-location/listzrlocations) API.
    parent-location-id: option<string>
  }
  add-azr-location: func(params: add-azr-location-params) -> result<string, string>;

  /// Get Zoom Room location structure
  get-zr-location-structure: func() -> result<string, string>;

  /// Update Zoom Rooms location structure
  record update-zoom-rooms-location-structure-params {
    /// Location Structure. The value can be either one or a combination of the following strings separated by comma:
    /// `country`, `state`, `city`, `campus`, `building`, `floor`
    structures: option<list<string>>
  }
  update-zoom-rooms-location-structure: func(params: update-zoom-rooms-location-structure-params) -> result<string, string>;

  /// Get Zoom Room location profile
  record get-zr-location-profile-params {
    /// Unique identifier of the location type. This can be retrieved using the [List Zoom Room Location API](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms-location/listzrlocations) (Id property in the response).
    location-id: string
  }
  get-zr-location-profile: func(params: get-zr-location-profile-params) -> result<string, string>;

  /// Update Zoom Room location profile
  record update-zr-location-profile-params {
    /// Unique Identifier of the location. This can be retrieved from the [List Zoom Room Locations](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms-location/listzrlocations) API.
    location-id: string,
    basic: option<update-zr-location-profile-body-basic>
  }
  update-zr-location-profile: func(params: update-zr-location-profile-params) -> result<string, string>;

  /// Change the assigned parent location
  record change-parent-location-params {
    location-id: string,
    /// Location ID of the new Parent Location under which you the child location will be positioned. This can be retrieved from the [List Zoom Room Locations](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms-location/listzrlocations) API.
    parent-location-id: option<string>
  }
  change-parent-location: func(params: change-parent-location-params) -> result<string, string>;

  /// Get location settings
  record get-zr-location-settings-params {
    /// The type of setting that you would like to retrieve.<br> `alert`: Alert Settings applied on the Zoom Rooms Account.<br>
    /// `meeting`: Meeting settings of the Zoom Rooms Account.<br>
    setting-type: string,
    /// Unique identifier of the location type. This can be retrieved using the [List Zoom Room Location API](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms-location/listzrlocations) (Id property in the response).
    location-id: string
  }
  get-zr-location-settings: func(params: get-zr-location-settings-params) -> result<string, string>;

  /// Update location settings
  record update-zr-location-settings-params {
    /// The type of setting that you would like to update.<br> `alert`: Alert Settings applied on the Zoom Rooms Account.<br>
    /// `meeting`: Meeting settings of the Zoom Rooms Account.<br>
    setting-type: string,
    /// Unique identifier of the location type. This can be retrieved using the [List Zoom Room Location API](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms-location/listzrlocations) (Id property in the response).
    location-id: string,
    body: option<string>
  }
  update-zr-location-settings: func(params: update-zr-location-settings-params) -> result<string, string>;

}

interface rooms-devices {
  enum change-zoom-rooms-app-version-body-action-enum {
    upgrade,
    downgrade,
    cancel,
  }

  /// Change Zoom Rooms' app version
  record change-zoom-rooms-app-version-params {
    /// Unique Identifier of the Zoom Room.
    room-id: string,
    /// Unique Identifier of the Mac or the Windows device. The value of this field can be retrieved from the [List Zoom Room Devices API](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms/listzrdevices).
    device-id: string,
    /// Specify one of the following values for this field:
    /// 
    action: option<change-zoom-rooms-app-version-body-action-enum>
  }
  change-zoom-rooms-app-version: func(params: change-zoom-rooms-app-version-params) -> result<string, string>;

}

interface sip-phone {
  enum create-sip-phone-body-transport-protocol-enum {
    udp,
    tcp,
    tls,
    auto,
  }

  /// List SIP phones
  record list-sip-phones-params {
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// User name or email address of a user. If this parameter is provided, only the SIP phone system integration enabled for that specific user will be returned. Otherwise, all SIP phones on an account will be returned.
    search-key: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-sip-phones: func(params: list-sip-phones-params) -> result<string, string>;

  /// Enable SIP phone
  record create-sip-phone-params {
    /// Authorization name of the user  registered for SIP Phone.
    authorization-name: string,
    /// The name or IP address of your provider’s SIP domain. (example: CDC.WEB).
    domain: string,
    /// The password generated for the user in the SIP account.
    password: string,
    /// IP address of the proxy server for SIP requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address. If you are not using a proxy server, this value can be the same as the Register Server.
    proxy-server: string,
    /// IP address of the proxy server for SIP requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address. If you are not using a proxy server, this value can be the same as the Register Server, or empty.
    proxy-server2: option<string>,
    /// IP address of the proxy server for SIP requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address. If you are not using a proxy server, this value can be the same as the Register Server, or empty.
    proxy-server3: option<string>,
    /// IP address of the server that accepts REGISTER requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address.
    register-server: string,
    /// IP address of the server that accepts REGISTER requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address.
    register-server2: option<string>,
    /// IP address of the server that accepts REGISTER requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address.
    register-server3: option<string>,
    /// The number of minutes after which the SIP registration of the Zoom client user will expire, and the client will auto register to the SIP server.
    registration-expire-time: option<s32>,
    /// Protocols supported by the SIP provider.<br> The value must be either `UDP`, `TCP`, `TLS`, `AUTO`.
    transport-protocol: option<create-sip-phone-body-transport-protocol-enum>,
    /// Protocols supported by the SIP provider.<br> The value must be either `UDP`, `TCP`, `TLS`, `AUTO`.
    transport-protocol2: option<create-sip-phone-body-transport-protocol-enum>,
    /// Protocols supported by the SIP provider.<br> The value must be either `UDP`, `TCP`, `TLS`, `AUTO`.
    transport-protocol3: option<create-sip-phone-body-transport-protocol-enum>,
    /// The email address of the user to associate with the SIP Phone. Can add [.win, .mac, .android, .ipad, .iphone, .linux, .pc, .mobile, .pad] at the end of the email (ex. user@test.com.mac) to add accounts for different platforms for the same user.
    user-email: string,
    /// The phone number associated with the user in the SIP account.
    user-name: string,
    /// The number to dial for checking voicemail.
    voice-mail: string
  }
  create-sip-phone: func(params: create-sip-phone-params) -> result<string, string>;

  /// Update SIP phone
  record update-sip-phone-params {
    /// Unique Identifier of the SIP Phone. This can be retrieved from the List SIP Phones API.
    phone-id: string,
    /// Authorization name of the user  registered for SIP Phone.
    authorization-name: string,
    /// The name or IP address of your provider’s SIP domain. (example: CDC.WEB).
    domain: string,
    /// The password generated for the user in the SIP account.
    password: string,
    /// IP address of the proxy server for SIP requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address. If you are not using a proxy server, this value can be the same as the Register Server.
    proxy-server: string,
    /// IP address of the proxy server for SIP requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address. If you are not using a proxy server, this value can be the same as the Register Server.
    proxy-server2: string,
    /// IP address of the proxy server for SIP requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address. If you are not using a proxy server, this value can be the same as the Register Server.
    proxy-server3: string,
    /// IP address of the server that accepts REGISTER requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address.
    register-server: string,
    /// IP address of the server that accepts REGISTER requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address.
    register-server2: string,
    /// IP address of the server that accepts REGISTER requests. Note that if you are using the UDP transport protocol, the default port is 5060. If you are using UDP with a different port number, that port number must be included with the IP address.
    register-server3: string,
    /// The number of minutes after which the SIP registration of the Zoom client user will expire, and the client will auto register to the SIP server.
    registration-expire-time: option<s32>,
    /// Protocols supported by the SIP provider.<br> The value must be either `UDP`, `TCP`, `TLS`, `AUTO`.
    transport-protocol: option<create-sip-phone-body-transport-protocol-enum>,
    /// Protocols supported by the SIP provider.<br> The value must be either `UDP`, `TCP`, `TLS`, `AUTO`.
    transport-protocol2: option<create-sip-phone-body-transport-protocol-enum>,
    /// Protocols supported by the SIP provider.<br> The value must be either `UDP`, `TCP`, `TLS`, `AUTO`.
    transport-protocol3: option<create-sip-phone-body-transport-protocol-enum>,
    /// The phone number associated with the user in the SIP account.
    user-name: string,
    /// The number to dial for checking voicemail.
    voice-mail: string
  }
  update-sip-phone: func(params: update-sip-phone-params) -> result<string, string>;

  /// Delete SIP phone
  record delete-sip-phone-params {
    /// Unique Identifier of the SIP Phone. It can be retrieved from the List SIP Phones API.
    phone-id: string
  }
  delete-sip-phone: func(params: delete-sip-phone-params) -> result<string, string>;

}

interface tracking-field {
  /// List tracking fields
  trackingfield-list: func() -> result<string, string>;

  /// Create a tracking field
  record trackingfield-create-params {
    /// Label/ Name for the tracking field.
    field: option<string>,
    /// Array of recommended values
    recommended-values: option<list<string>>,
    /// Tracking Field Required
    required: option<bool>,
    /// Tracking Field Visible
    visible: option<bool>
  }
  trackingfield-create: func(params: trackingfield-create-params) -> result<string, string>;

  /// Get a tracking field
  record trackingfield-get-params {
    /// The Tracking Field ID
    field-id: string
  }
  trackingfield-get: func(params: trackingfield-get-params) -> result<string, string>;

  /// Update a tracking field
  record trackingfield-update-params {
    /// The Tracking Field ID
    field-id: string,
    /// Label/ Name for the tracking field.
    field: option<string>,
    /// Array of recommended values
    recommended-values: option<list<string>>,
    /// Tracking Field Required
    required: option<bool>,
    /// Tracking Field Visible
    visible: option<bool>
  }
  trackingfield-update: func(params: trackingfield-update-params) -> result<string, string>;

  /// Delete a tracking field
  record trackingfield-delete-params {
    /// The Tracking Field ID
    field-id: string
  }
  trackingfield-delete: func(params: trackingfield-delete-params) -> result<string, string>;

}

interface tsp {
  enum tsp-update-body-tsp-bridge-enum {
    us-tsp-tb,
    eu-tsp-tb,
  }

  enum user-tsp-create-body-dial-in-numbers-item-type-op-enum {
    toll,
    tollfree,
    media-link,
  }

  record user-tsp-create-body-dial-in-numbers-item {
    /// Country code.
    code: option<string>,
    /// Country Label, if passed, will display in place of code.
    country-label: option<string>,
    /// Dial-in number: length is less than 16.
    number: option<string>,
    /// Dial-in number types:<br>`toll` - Toll number.<br>`tollfree` -Toll free number.<br>
    /// `media_link` - Media link.
    type-op: option<user-tsp-create-body-dial-in-numbers-item-type-op-enum>
  }

  record user-tsp-update-body-dial-in-numbers-item {
    /// Country code.
    code: option<string>,
    /// Country Label, if passed, will display in place of code.
    country-label: option<string>,
    /// Dial-in number: length is less than 16.
    number: option<string>,
    /// Dial-in number types:<br>`toll` - Toll number.<br>`tollfree` -Toll free number.<br>`media_link` - Media Link Phone Number. It is used for PSTN integration instead of paid bridge number.
    type-op: option<user-tsp-create-body-dial-in-numbers-item-type-op-enum>
  }

  /// Get account's TSP information
  tsp: func() -> result<string, string>;

  /// Update account's TSP information
  record tsp-update-params {
    /// Control restriction on account users adding a TSP number outside of account's dial in numbers.
    dial-in-number-unrestricted: option<bool>,
    /// Enable 3rd party audio conferencing for account users
    enable: option<bool>,
    /// For master account, extend its TSP setting to all sub accounts. For sub account, extend TSP setting from master account.
    master-account-setting-extended: option<bool>,
    /// Control restriction on account users being able to modify their TSP credentials.
    modify-credential-forbidden: option<bool>,
    /// Telephony bridge
    tsp-bridge: option<tsp-update-body-tsp-bridge-enum>,
    /// Enable TSP feature for account. This has to be enabled to use any other tsp settings/features.
    tsp-enabled: option<bool>,
    /// 3rd party audio conferencing provider
    tsp-provider: option<string>
  }
  tsp-update: func(params: tsp-update-params) -> result<string, string>;

  /// List user's TSP accounts
  record user-ts-ps-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-ts-ps: func(params: user-ts-ps-params) -> result<string, string>;

  /// Add a user's TSP account
  record user-tsp-create-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// Conference code: numeric value, length is less than 16.
    conference-code: string,
    /// List of dial in numbers.
    dial-in-numbers: option<list<user-tsp-create-body-dial-in-numbers-item>>,
    /// Leader PIN: numeric value, length is less than 16.
    leader-pin: string,
    /// Telephony bridge
    tsp-bridge: option<tsp-update-body-tsp-bridge-enum>
  }
  user-tsp-create: func(params: user-tsp-create-params) -> result<string, string>;

  /// Set global dial-in URL for a TSP user
  record tsp-url-update-params {
    /// The userId or email address of the user.
    user-id: string,
    /// The global dial-in URL for a TSP enabled account. The URL must be valid with a max-length of 512 characters.
    audio-url: option<string>
  }
  tsp-url-update: func(params: tsp-url-update-params) -> result<string, string>;

  /// Get a user's TSP account
  record user-tsp-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// TSP account ID.
    tsp-id: string
  }
  user-tsp: func(params: user-tsp-params) -> result<string, string>;

  /// Update a TSP account
  record user-tsp-update-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// TSP account ID.
    tsp-id: string,
    /// Conference code: numeric value, length is less than 16.
    conference-code: string,
    /// List of dial in numbers.
    dial-in-numbers: option<list<user-tsp-update-body-dial-in-numbers-item>>,
    /// Leader PIN: numeric value, length is less than 16.
    leader-pin: string,
    /// Telephony bridge
    tsp-bridge: option<tsp-update-body-tsp-bridge-enum>
  }
  user-tsp-update: func(params: user-tsp-update-params) -> result<string, string>;

  /// Delete a user's TSP account
  record user-tsp-delete-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// TSP account ID.
    tsp-id: string
  }
  user-tsp-delete: func(params: user-tsp-delete-params) -> result<string, string>;

}

interface pac {
  /// List a user's PAC accounts
  record user-pa-cs-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-pa-cs: func(params: user-pa-cs-params) -> result<string, string>;

}
/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export accounts;
  export billing;
  export phone;
  export cloud-recording;
  export sip-connected-audio;
  export users;
  export chat-channels;
  export contacts;
  export chat-channels-account-level;
  export chat-messages;
  export groups;
  export devices;
  export chatbot-messages;
  export im-chat;
  export im-groups;
  export meetings;
  export dashboards;
  export deprecated-api-endpoints;
  export webinars;
  export phone-auto-receptionists;
  export phone-blocked-list;
  export phone-call-queues;
  export common-area-phones;
  export phone-devices;
  export phone-reports;
  export phone-shared-line-groups;
  export phone-site;
  export reports;
  export roles;
  export rooms;
  export rooms-account;
  export rooms-location;
  export rooms-devices;
  export sip-phone;
  export tracking-field;
  export tsp;
  export pac;
}
