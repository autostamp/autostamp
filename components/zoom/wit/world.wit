  /// Get cloud recording usage report
  record report-cloud-recording-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string
  }
  report-cloud-recording: func(params: report-cloud-recording-params) -> result<string, string>;

  /// Get daily usage report
  record report-daily-params {
    /// Year for this report
    year: option<s32>,
    /// Month for this report
    month: option<s32>
  }
  report-daily: func(params: report-daily-params) -> result<string, string>;

  /// Get meeting detail reports
  record report-meeting-details-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string
  }
  report-meeting-details: func(params: report-meeting-details-params) -> result<string, string>;

  /// Get meeting participant reports
  record report-meeting-participants-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Provide `registrant_id` as the value for this field if you would like to see the registrant ID attribute in the response of this API call. A registrant ID is a unique identifier of a [meeting registrant](https://marketplace.zoom.us/docs/api-reference/zoom-api/meetings/meetingregistrants).<br>
    /// 
    include-fields: option<report-meeting-participants-include-fields-enum>
  }
  report-meeting-participants: func(params: report-meeting-participants-params) -> result<string, string>;

  /// Get meeting poll reports
  record report-meeting-polls-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string
  }
  report-meeting-polls: func(params: report-meeting-polls-params) -> result<string, string>;

  /// Get operation logs report
  record report-operation-logs-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// **Optional**<br>
    /// Filter your response by a category type to see reports for a specific category.
    category-type: option<report-operation-logs-category-type-enum>
  }
  report-operation-logs: func(params: report-operation-logs-params) -> result<string, string>;

  /// Get telephone reports
  record report-telephone-params {
    /// Audio types:<br>`1` - Toll-free Call-in & Call-out.<br>`2` - Toll <br>
    /// `3` - SIP Connected Audio
    type-op: option<string>,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  report-telephone: func(params: report-telephone-params) -> result<string, string>;

  /// Get active/inactive host reports
  record report-users-params {
    /// Active or inactive hosts.<br>`active` - Active hosts. <br>`inactive` - Inactive hosts.
    type-op: option<report-users-type-op-enum>,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The page number of the current page in the returned records.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  report-users: func(params: report-users-params) -> result<string, string>;

  /// Get meeting reports
  record report-meetings-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The meeting types: <br>`past` - Past meetings.<br>`pastOne` - Past one user meetings. 
    type-op: option<report-meetings-type-op-enum>
  }
  report-meetings: func(params: report-meetings-params) -> result<string, string>;

  /// Get webinar detail reports
  record report-webinar-details-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string
  }
  report-webinar-details: func(params: report-webinar-details-params) -> result<string, string>;

  /// Get webinar participant reports
  record report-webinar-participants-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Enter 'registrant_id' as the value for this field if you would like to see the registrant ID attribute included in the response of this API call. A registrant ID is a unique identifier of a [webinar registrant](https://marketplace.zoom.us/docs/api-reference/zoom-api/webinars/webinarregistrants).<br>
    /// 
    include-fields: option<report-meeting-participants-include-fields-enum>
  }
  report-webinar-participants: func(params: report-webinar-participants-params) -> result<string, string>;

  /// Get webinar poll reports
  record report-webinar-polls-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string
  }
  report-webinar-polls: func(params: report-webinar-polls-params) -> result<string, string>;

  /// Get webinar Q&A report
  record report-webinar-qa-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string
  }
  report-webinar-qa: func(params: report-webinar-qa-params) -> result<string, string>;

}

interface roles {
  /// This field will only be displayed to accounts that are enrolled in the partner plan and follow master accounts and sub accounts structure.
  record update-role-body-sub-account-privileges {
    /// Indicates how the account can manage sub accounts. The value can be one of the following:<br>
    /// `1`: Manage the sub account as an owner of the account.<br>
    second-level: option<s32>
  }

  record add-role-members-body-members-item {
    /// Email address of the user to whom you would like to assign the role. Provide either the userId in the ID field or the email address in the email field. If both fields are provided, only userId is used.
    email: option<string>,
    /// User ID of the user to whom you would like to assign the role. 
    id: option<string>
  }

  /// List roles
  roles: func() -> result<string, string>;

  /// Create a role
  record create-role-params {
    /// Description of the role.
    description: option<string>,
    /// Name of the role.
    name: option<string>,
    /// Privileges assigned to the role. Can be one or a combination of [these permissions](https://marketplace.zoom.us/docs/api-reference/other-references/privileges).
    privileges: option<list<string>>
  }
  create-role: func(params: create-role-params) -> result<string, string>;

  /// Get role information
  record get-role-information-params {
    /// Role Id. 
    role-id: string
  }
  get-role-information: func(params: get-role-information-params) -> result<string, string>;

  /// Update role information
  record update-role-params {
    /// Role Id
    role-id: string,
    /// Description of the role.
    description: option<string>,
    /// Role Id.
    id: option<string>,
    /// Name of the role.
    name: option<string>,
    /// Privileges assigned to the role. Can be one or a combination of [these permissions](https://marketplace.zoom.us/docs/api-reference/other-references/privileges).
    privileges: option<list<string>>,
    /// This field will only be displayed to accounts that are enrolled in the partner plan and follow master accounts and sub accounts structure.
    sub-account-privileges: option<update-role-body-sub-account-privileges>,
    /// Total members assigned to that role.
    total-members: option<s32>
  }
  update-role: func(params: update-role-params) -> result<string, string>;

  /// Delete a role
  record delete-role-params {
    /// Role Id.
    role-id: string
  }
  delete-role: func(params: delete-role-params) -> result<string, string>;

  /// List members in a role
  record role-members-params {
    /// The role ID
    role-id: string,
    /// The number of pages returned for this request.
    page-count: option<string>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>
  }
  role-members: func(params: role-members-params) -> result<string, string>;

  /// Assign a role
  record add-role-members-params {
    /// The role ID
    role-id: string,
    /// Array of userId/user email of users to whom you would like to assign this role. Upto 30 users can be assigned a role at once.
    members: option<list<add-role-members-body-members-item>>
  }
  add-role-members: func(params: add-role-members-params) -> result<string, string>;

  /// Unassign a role
  record role-member-delete-params {
    /// The role ID
    role-id: string,
    /// Member's ID
    member-id: string
  }
  role-member-delete: func(params: role-member-delete-params) -> result<string, string>;

}

interface rooms {
  enum list-zoom-rooms-status-enum {
    offline,
    available,
    in-meeting,
    under-construction,
  }

  enum list-zoom-rooms-type-op-enum {
    zoom-room,
    scheduling-display-only,
    digital-signage-only,
  }

  record check-in-rooms-body-params {
    /// This field is only required if Google Calendar is being used for the event associated with the Zoom Room. The value for this field can be retrieved by calling Google's [CalendarList:list API](https://developers.google.com/calendar/v3/reference/events/list) and referring to the "id" field included in the [calendarList resource](https://developers.google.com/calendar/v3/reference/calendarList#resource).
    /// 
    calendar-id: option<string>,
    /// This field is required only for Microsoft Exchange or Office 365  calendar. The change key represents the specific version of the calendar item and can be retrieved by using Microsoft's [FindItem Operation](https://docs.microsoft.com/en-us/exchange/client-developer/web-service-reference/finditem-operation) and referring to the ChangeKey field of the ItemId Element included in the operation response.<br>
    change-key: option<string>,
    /// Unique Identifier of the calendar event associated with the Zoom Room.<br><br>If the calendar integration being used is Microsoft Exchange, the value for this field can be retrieved by using Microsoft's [FindItem Operation](https://docs.microsoft.com/en-us/exchange/client-developer/web-service-reference/finditem-operation) and referring to the Id field of the ItemId Element included in the operation response.<br><br>If the Google calendar integration was used for this event, the event_id can be retrieved by calling Google's [Events:list API](https://developers.google.com/calendar/v3/reference/events/list) and referring to the "id" field included in the [events resource](https://developers.google.com/calendar/v3/reference/events#resource).
    /// 
    event-id: string,
    /// This field is only required for Microsoft Exchange / Office 365 Calendar. It is the [resource mailbox](https://support.microsoft.com/en-us/help/10063/creating-and-managing-resource-mailboxes-in-office-365) associated with the calendar.
    resource-email: option<string>
  }

  record update-room-profile-body-basic {
    /// Hide this Zoom Room from your Contact List. 
    hide-room-in-contacts: option<bool>,
    /// Name of the Zoom Room.
    name: option<string>,
    /// Require code to exit out of Zoom Rooms application to switch between other apps.
    required-code-to-ext: option<bool>,
    /// 1-16 digit number or characters that is used to secure your Zoom Rooms application. This code must be entered on your Zoom Room Controller to change settings or sign out.
    room-passcode: option<string>,
    /// The email address to be used for reporting Zoom Room issues.
    support-email: option<string>,
    /// The phone number to be used for reporting Zoom Room issues.
    support-phone: option<string>
  }

  /// List Zoom Rooms
  record list-zoom-rooms-params {
    /// The status of the Zoom Room.
    status: option<list-zoom-rooms-status-enum>,
    /// Type of the Zoom Rooms.
    type-op: option<list-zoom-rooms-type-op-enum>,
    /// Use this query parameter with a value of `true` if you would like to see Zoom Rooms in your account that have not been assigned to anyone yet.
    unassigned-rooms: option<bool>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Parent location ID of the Zoom Room.
    location-id: option<string>
  }
  list-zoom-rooms: func(params: list-zoom-rooms-params) -> result<string, string>;

  /// Add a Zoom Room
  record add-a-room-params {
    /// **Optional**<br>Location ID of the lowest level location in the [location hierarchy](https://support.zoom.us/hc/en-us/articles/115000342983-Zoom-Rooms-Location-Hierarchy) where the Zoom Room is to be added. For instance if the structure of the location hierarchy is set up as “country, states, city, campus, building, floor”, a room can only be added under the floor level location. 
    /// 
    location-id: option<string>,
    /// Name of the Zoom Room.
    name: string,
    /// Type of the Zoom Room. 
    type-op: list-zoom-rooms-type-op-enum
  }
  add-a-room: func(params: add-a-room-params) -> result<string, string>;

  /// List digital signage contents
  record list-digital-signage-content-params {
    /// Specify the type of digital signane resource. The value can be one of the following:
    /// * `content`: Returns information about content files.
    type-op: option<string>,
    /// Unique identifier of the folder where the content is located. Provide this field if you would like to filter the response by contents that are only available in a specific folder.
    folder-id: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-digital-signage-content: func(params: list-digital-signage-content-params) -> result<string, string>;

  /// Update E911 digital signage
  record manage-e911signage-params {
    body: option<string>
  }
  manage-e911signage: func(params: manage-e911signage-params) -> result<string, string>;

  /// Check-in or check-out of a Zoom Room
  record check-in-rooms-params {
    /// Room ID
    id: string,
    /// The value of this field can be one of the following:<br>
    /// * zoomroom.check_in
    method: option<string>,
    params: option<check-in-rooms-body-params>
  }
  check-in-rooms: func(params: check-in-rooms-params) -> result<string, string>;

  /// Get Zoom Room profile
  record get-zr-profile-params {
    /// Unique Identifier of the Zoom Room. This can be retrieved from the response of [List Zoom Rooms](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms/listzoomrooms) API.
    room-id: string
  }
  get-zr-profile: func(params: get-zr-profile-params) -> result<string, string>;

  /// Update a Zoom Room profile
  record update-room-profile-params {
    /// Unique Identifier of a Zoom Room.
    room-id: string,
    basic: option<update-room-profile-body-basic>
  }
  update-room-profile: func(params: update-room-profile-params) -> result<string, string>;

  /// Delete a Zoom Room
  record delete-a-zoom-room-params {
    /// Unique Identifier of a Zoom Room.
    room-id: string
  }
  delete-a-zoom-room: func(params: delete-a-zoom-room-params) -> result<string, string>;

  /// List Zoom Room devices
  record list-zr-devices-params {
    /// Unique Identifier of the Zoom Room. This can be retrieved from the response of [List Zoom Rooms](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms/listzoomrooms) API.
    room-id: string
  }
  list-zr-devices: func(params: list-zr-devices-params) -> result<string, string>;

  /// Change a Zoom Room's location
  record change-zr-location-params {
    /// Unique Identifier of the Zoom Room.
    room-id: string,
    /// Location ID of the location where Zoom Room is to be assigned. This can be retrieved from the `id` property in the response of [List Zoom Rooms Locations](https://marketplace.zoom.us/docs/api-reference/zoom-api/rooms-location/listzrlocations) API.
    location-id: option<string>
  }
  change-zr-location: func(params: change-zr-location-params) -> result<string, string>;

  /// Get Zoom Room settings
  record get-zr-settings-params {
    /// The type of setting that you would like to retrieve.<br> `alert`: Alert Settings applied on the Zoom Rooms Account.<br>
    /// `meeting`: Meeting settings of the Zoom Rooms Account.
    setting-type: string,
    /// Unique identifier of the Zoom Room.
    room-id: string
  }
  get-zr-settings: func(params: get-zr-settings-params) -> result<string, string>;

  /// Update Zoom Room settings
  record update-zr-settings-params {
    /// Unique Identifier of the Zoom Room.
    room-id: string,
    /// The type of setting that you would like to update.<br> `alert`: Alert Settings applied on the Zoom Room.<br>
    /// `meeting`: Meeting settings of the Zoom Room.<br>
    setting-type: option<string>,
    body: option<string>
  }
  update-zr-settings: func(params: update-zr-settings-params) -> result<string, string>;

}

interface rooms-account {
  enum get-zr-account-settings-setting-type-enum {
    meeting,
