/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `Client_Credentials` | `Authorization: Bearer <secret>` |
/// | `OAuth` | `Authorization: Bearer <secret>` |
package autostamp:zoom@0.2.0;

interface accounts {
  enum account-create-body-options-pay-mode-enum {
    master,
    sub,
  }

  enum account-settings-option-op-enum {
    meeting-authentication,
    recording-authentication,
  }

  enum account-settings-update-option-op-enum {
    meeting-authentication,
    recording-authentication,
    security,
    meeting-security,
  }

  /// Account options object.
  record account-create-body-options {
    /// Toggle whether automatic billing renewal is on or off.
    billing-auto-renew: option<bool>,
    /// Specify the IP addresses of the Meeting Connectors that you would like to share with the sub account. Multiple values can be separated by comma. If no value is provided in this field, all the Meeting Connectors of a master account will be shared with the sub account.
    /// 
    meeting-connector-list: option<list<string>>,
    /// Payee:<br>`master` - master account holder pays.<br>`sub` - Sub account holder pays.
    pay-mode: option<account-create-body-options-pay-mode-enum>,
    /// Specify the IP addresses of the Room Connectors that you would like to share with the sub account. Multiple values can be separated by comma. If no value is provided in this field, all the Room Connectors of a master account will be shared with the sub account.
    /// 
    room-connector-list: option<list<string>>,
    /// Enable/disable the option for a sub account to use shared [Meeting Connector(s)](https://support.zoom.us/hc/en-us/articles/201363093-Getting-Started-with-the-Meeting-Connector) that are set up by the master account. Meeting Connectors can only be used by On-prem users.
    share-mc: option<bool>,
    /// Enable/disable the option for a sub account to use shared [Virtual Room Connector(s)](https://support.zoom.us/hc/en-us/articles/202134758-Getting-Started-With-Virtual-Room-Connector) that are set up by the master account. Virtual Room Connectors can only be used by On-prem users.
    share-rc: option<bool>
  }

  /// List sub accounts
  record accounts-params {
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  accounts: func(params: accounts-params) -> result<string, string>;

  /// Create a sub account
  record account-create-params {
    /// Name of the account. If you do not provide a value for this field, by default, the value will be set as a concatenation of "first_name" and "last_name". 
    account-name: option<string>,
    /// User's email address.
    email: string,
    /// User's first name.
    first-name: string,
    /// User's last name.
    last-name: string,
    /// Account options object.
    options: option<account-create-body-options>,
    /// User's password.
    /// 
    password: string
  }
  account-create: func(params: account-create-params) -> result<string, string>;

  /// Get sub account details
  record account-params {
    /// The account ID.
    account-id: string
  }
  account: func(params: account-params) -> result<string, string>;

  /// Disassociate a sub account
  record account-disassociate-params {
    /// The account ID.
    account-id: string
  }
  account-disassociate: func(params: account-disassociate-params) -> result<string, string>;

  /// Get locked settings
  record get-account-lock-settings-params {
    /// Unique Identifier of the account. To retrieve locked settings of the master account or a regular account, provide "me" as the value of this field. <br> To retrieve locked settings of a sub account, provide the Account ID of the sub account in this field.
    account-id: string,
    /// `meeting_security`: Use this query parameter to view meeting security settings applied on the account.<br>
    option-op: option<string>,
    /// Provide the name of the field by which you would like to filter the response. For example, if you provide "host_video" as the value of this field, you will get a response similar to the following:<br>
    /// {
    custom-query-fields: option<string>
  }
  get-account-lock-settings: func(params: get-account-lock-settings-params) -> result<string, string>;

  /// Update locked settings
  record update-account-lock-settings-params {
    /// Unique Identifier of the account. To retrieve locked settings of the master account or a regular account, provide "me" as the value of this field. <br> To retrieve locked settings of a sub account, provide the Account ID of the sub account in this field.
    account-id: string,
    body: option<string>
  }
  update-account-lock-settings: func(params: update-account-lock-settings-params) -> result<string, string>;

  /// Get managed domains
  record account-managed-domain-params {
    /// Unique Identifier of the account. To retrieve locked settings of the master account or a regular account, provide "me" as the value of this field. <br> To retrieve locked settings of a sub account, provide the Account ID of the sub account in this field.
    account-id: string
  }
  account-managed-domain: func(params: account-managed-domain-params) -> result<string, string>;

  /// Update options
  record account-options-update-params {
    /// The account ID.
    account-id: string,
    /// Toggle whether automatic billing renewal is on or off.
    billing-auto-renew: option<bool>,
    /// Specify the IP addresses of the Meeting Connectors that you would like to share with the sub account. Multiple values can be separated by comma. If no value is provided in this field, all the Meeting Connectors of a master account will be shared with the sub account.
    /// 
    meeting-connector-list: option<list<string>>,
    /// Payee:<br>`master` - master account holder pays.<br>`sub` - Sub account holder pays.
    pay-mode: option<account-create-body-options-pay-mode-enum>,
    /// Specify the IP addresses of the Room Connectors that you would like to share with the sub account. Multiple values can be separated by comma. If no value is provided in this field, all the Room Connectors of a master account will be shared with the sub account.
    /// 
    room-connector-list: option<list<string>>,
    /// Enable/disable the option for a sub account to use shared [Meeting Connector(s)](https://support.zoom.us/hc/en-us/articles/201363093-Getting-Started-with-the-Meeting-Connector) that are set up by the master account. Meeting Connectors can only be used by On-prem users.
    share-mc: option<bool>,
    /// Enable/disable the option for a sub account to use shared [Virtual Room Connector(s)](https://support.zoom.us/hc/en-us/articles/202134758-Getting-Started-With-Virtual-Room-Connector) that are set up by the master account. Virtual Room Connectors can only be used by On-prem users.
    share-rc: option<bool>
  }
  account-options-update: func(params: account-options-update-params) -> result<string, string>;

  /// Update the account owner
  record update-account-owner-params {
    /// Account Id of the account.
    account-id: string,
    /// Email address of the new owner.
    email: string
  }
  update-account-owner: func(params: update-account-owner-params) -> result<string, string>;

  /// Get settings
  record account-settings-params {
    /// The account ID.
    account-id: string,
    /// `meeting_authentication`: Use this query parameter to view [meeting authentication configuration](https://support.zoom.us/hc/en-us/articles/360037117472-Authentication-Profiles-for-Meetings-and-Webinars) applied on the account.<br>`recording_authentication`: Use this query parameter to view [recording authentication configuration](https://support.zoom.us/hc/en-us/articles/360037756671-Authentication-Profiles-for-Cloud-Recordings) applied on the account.<br>`security`: Use this query parameter to view security settings such as password requirements for user login, two factor authentication etc., applied on the account.<br>
    /// `meeting_security`: Use this query parameter to view meeting security settings applied on the account.<br>
    option-op: option<account-settings-option-op-enum>,
    /// Provide the name of the field by which you would like to filter the response. For example, if you provide "host_video" as the value of this field, you will get a response similar to the following:<br>
    /// {
    custom-query-fields: option<string>
  }
  account-settings: func(params: account-settings-params) -> result<string, string>;

  /// Update settings
  record account-settings-update-params {
    /// The account ID.
    account-id: string,
    option-op: option<account-settings-update-option-op-enum>,
    body: string
  }
  account-settings-update: func(params: account-settings-update-params) -> result<string, string>;

  /// Upload virtual background files
  record upload-vb-params {
    /// Unique identifier of the account.
    account-id: string
  }
  upload-vb: func(params: upload-vb-params) -> result<string, string>;

  /// Delete virtual background files
  record del-vb-params {
    /// Provide the id of the file that is to be deleted. To delete multiple files, provide comma separated values for this field.
    file-ids: option<string>
  }
  del-vb: func(params: del-vb-params) -> result<string, string>;

  /// Get trusted domains
  record account-trusted-domain-params {
    /// The account ID.
    account-id: string
  }
  account-trusted-domain: func(params: account-trusted-domain-params) -> result<string, string>;

}


interface billing {
  enum account-plan-addon-cancel-body-action-enum {
    cancel,
  }

  /// Get billing information
  record account-billing-params {
    /// The account ID.
    account-id: string
  }
  account-billing: func(params: account-billing-params) -> result<string, string>;

  /// Update billing information
  record account-billing-update-params {
    /// The account ID.
    account-id: string,
    /// Billing Contact's address.
    address: option<string>,
    /// Billing Contact's apartment/suite.
    apt: option<string>,
    /// Billing Contact's city.
    city: option<string>,
    /// Billing Contact's country.
    country: option<string>,
    /// Billing Contact's email address.
    email: option<string>,
    /// Billing Contact's first name.
    first-name: option<string>,
    /// Billing Contact's last name.
    last-name: option<string>,
    /// Billing Contact's phone number.
    phone-number: option<string>,
    /// Billing Contact's state.
    state: option<string>,
    /// Billing Contact's zip/postal code.
    zip: option<string>
  }
  account-billing-update: func(params: account-billing-update-params) -> result<string, string>;

  /// List billing invoices
  record account-billing-invoices-params {
    /// Start date for the invoice query in `yyyy-mm-dd` format. The date range defined by the “from” and “to” parameters should not exceed one year. The range defined should fall within the past three years.
    from-op: option<string>,
    /// End date for the invoice query in `yyyy-mm-dd` format
    to: option<string>
  }
  account-billing-invoices: func(params: account-billing-invoices-params) -> result<string, string>;

  /// Get invoice details
  get-account-billing-invoice: func() -> result<string, string>;

  /// Get plan Information
  record account-plans-params {
    /// The account ID.
    account-id: string
  }
  account-plans: func(params: account-plans-params) -> result<string, string>;

  /// Subscribe plans
  record account-plan-create-params {
    /// The account ID.
    account-id: string,
    body: string
  }
  account-plan-create: func(params: account-plan-create-params) -> result<string, string>;

  /// Subscribe additional plan
  record account-plan-addon-create-params {
    /// The account ID.
    account-id: string,
    body: string
  }
  account-plan-addon-create: func(params: account-plan-addon-create-params) -> result<string, string>;

  /// Update an additional plan
  record account-plan-addon-update-params {
    /// The account ID.
    account-id: string,
    /// Number of hosts for this plan.
    hosts: s32,
    /// Account <a href="https://marketplace.zoom.us/docs/api-reference/other-references/plans">plan type.</a>
    type-op: string
  }
  account-plan-addon-update: func(params: account-plan-addon-update-params) -> result<string, string>;

  /// Cancel additional plans
  record account-plan-addon-cancel-params {
    /// The action that needs to be taken for this sub account. Value must be set to "cancel".
    action: option<account-plan-addon-cancel-body-action-enum>,
    /// Additional comments about the cancellation decision.
    comment: option<string>,
    /// The reason for the cancellation of plan. Reason options:<br>`1` - I am no longer working remote.<br>`2` - I had challenges getting the support I needed.<br>`3` - Features in the Basic Free Plan are sufficient.<br>`4` - The expense is too high.<br>`5` - I purchased the wrong product.<br> `6` - Paid purchase not needed right now, will repurchase in the future.
    reason: option<s32>,
    /// Plan [type](https://marketplace.zoom.us/docs/api-reference/other-references/plans).
    type-op: option<string>
  }
  account-plan-addon-cancel: func(params: account-plan-addon-cancel-params) -> result<string, string>;

  /// Update a base plan
  record account-plan-base-update-params {
    /// The account ID.
    account-id: string,
    /// Account base plan number of hosts. For a Pro Plan please select a value between 1 and 9. For a Business Plan please select a value between 10 and 49. For a Education Plan please select a value between 20 and 149. For a Free Trial Plan please select a value between 1 and 9999.
    hosts: s32,
    /// Account base <a href="https://marketplace.zoom.us/docs/api-reference/other-references/plans">plan type.</a>
    type-op: string
  }
  account-plan-base-update: func(params: account-plan-base-update-params) -> result<string, string>;

  /// Cancel a base plan
  record account-plan-base-delete-params {
    account-id: string,
    /// The action that needs to be taken for this sub account. Value must be set to "cancel".
    action: string,
    /// Additional comments about the cancellation decision.
    comment: option<string>,
    /// The reason for the cancellation of plan. Reason options:<br>`1` - I am no longer working remote.<br>`2` - I had challenges getting the support I needed.<br>`3` - Features in the Basic Free Plan are sufficient.<br>`4` - The expense is too high.<br>`5` - I purchased the wrong product.<br> `6` - Paid purchase not needed right now, will repurchase in the future.
    reason: option<s32>
  }
  account-plan-base-delete: func(params: account-plan-base-delete-params) -> result<string, string>;

  /// Get plan usage
  get-plan-usage: func() -> result<string, string>;

  /// Download an invoice file
  download-invoice-pdf: func() -> result<string, string>;

}

interface phone {
  enum account-call-logs-time-type-enum {
    start-time,
    end-time,
  }

  enum list-account-phone-numbers-type-op-enum {
    assigned,
    unassigned,
    all,
  }

  enum list-account-phone-numbers-extension-type-enum {
    user,
    call-queue,
    auto-receptionist,
    common-area-phone,
  }

  enum list-account-phone-numbers-number-type-enum {
    toll,
    tollfree,
  }

  enum add-setting-template-body-type-op-enum {
    user,
    group,
    auto-receptionist,
    commonarea,
    interop,
  }

  enum update-setting-template-body-policy-auto-call-recording-recording-calls-enum {
    inbound,
    outbound,
    both,
  }

  enum update-setting-template-body-user-settings-call-handling-business-hours-connect-to-operator-type-op-enum {
    user,
    zoom-room,
    common-area-phone,
    auto-receptionist,
    call-queue,
    shared-line-group,
  }

  enum update-setting-template-body-user-settings-hold-music-enum {
    default,
    disable,
  }

  enum phone-user-call-logs-type-op-enum {
    all,
    missed,
  }

  enum phone-user-voice-mails-status-enum {
    all,
    read,
    unread,
  }

  record update-phone-settings-body-byoc {
    /// Set the value of this field to `true` to allow a sub account to add BYOC numbers from the Zoom web admin portal.
    enable: option<bool>
  }

  /// Specify emergency address for the account.
  record set-up-account-body-emergency-address {
    /// Specify the street address.
    address-line1: string,
    /// Specify any building number, floor number, or unit number.
    address-line2: option<string>,
    /// City of the emergency address. Required or optional dependent on different countries.
    city: option<string>,
    /// Specify the two letter [country code](https://marketplace.zoom.us/docs/api-reference/other-references/abbreviation-lists#countries) (Alpha-2 code in ISO-3166).
    country: string,
    /// State code of the emergency address. Required or optional dependent on the country and state.
    state-code: option<string>,
    /// Zip code of the emergency address. Required or optional dependent on different countries.
    zip: option<string>
  }

  record post-phone-sip-trunk-body-sip-trunks-item {
    /// The account associated to the carrier.
    carrier-account: option<string>,
    /// Unique identifier of the master account's SIP trunk.
    id: option<string>,
    /// The name of the SIP Trunk. If this is not used, the master SIP Trunk name will be the default.
    name: option<string>
  }

  record update-setting-template-body-policy {
    ad-hoc-call-recording: option<update-setting-template-body-policy-ad-hoc-call-recording>,
    auto-call-recording: option<update-setting-template-body-policy-auto-call-recording>,
    sms: option<update-setting-template-body-policy-sms>,
    voicemail: option<update-setting-template-body-policy-voicemail>
  }

  record update-setting-template-body-policy-ad-hoc-call-recording {
    /// Allow current extension to record and save calls in the cloud.
    enable: option<bool>,
    /// Play a prompt to call participants when the recording has started.
    recording-start-prompt: option<bool>,
    /// Allow call recording transcription.
    recording-transcription: option<bool>
  }

  record update-setting-template-body-policy-auto-call-recording {
    /// Automatic call recording.
    enable: option<bool>,
    /// Values: inbound, outbound, both.
    recording-calls: option<update-setting-template-body-policy-auto-call-recording-recording-calls-enum>,
    /// Play a prompt to call participants when the recording has started.
    recording-start-prompt: option<bool>,
    /// Allow call recording transcription.
    recording-transcription: option<bool>
  }

  record update-setting-template-body-policy-sms {
    /// Allow user to send and receive messages.
    enable: option<bool>,
    /// Whether or not SMS is international.
    international-sms: option<bool>
  }

  record update-setting-template-body-policy-voicemail {
    /// Allow voicemail transcription.
    allow-transcription: option<bool>,
    /// Allow current extension to access, receive, or share voicemail.
    enable: option<bool>
  }

  record update-setting-template-body-profile {
    /// The area code from which the phone account was created.
    area-code: option<string>,
    /// Name of the country where the template was created.
    country: option<string>
  }

  record update-setting-template-body-user-settings {
    /// Audio prompt language code.<br> American English: `en-US`<br>
    /// British English: `en-GB`<br>
    audio-prompt-language: option<string>,
    /// Block Calls without Caller ID.
    block-calls-without-caller-id: option<bool>,
    call-handling: option<update-setting-template-body-user-settings-call-handling>,
    desk-phone: option<update-setting-template-body-user-settings-desk-phone>,
    /// The value of this field can be either `default` or `disable`.
    /// 
    hold-music: option<update-setting-template-body-user-settings-hold-music-enum>
  }

  record update-setting-template-body-user-settings-call-handling {
    business-hours: option<update-setting-template-body-user-settings-call-handling-business-hours>,
    close-hours: option<update-setting-template-body-user-settings-call-handling-close-hours>
  }

  record update-setting-template-body-user-settings-call-handling-business-hours {
    /// When a call is not answered:<br>
    /// 0-Forward to voicemail;<br>
    business-hour-action: option<s32>,
    /// Allow callers to press Zero to reach an operator or press One to leave a message, or allow neither of these options.
    connect-to-operator: option<update-setting-template-body-user-settings-call-handling-business-hours-connect-to-operator>,
    custom-hours: option<list<update-setting-template-body-user-settings-call-handling-business-hours-custom-hours-item>>,
    /// Call Handling Ring Mode:<br>
    /// 0-Simultaneous,<br>
    ring-type: option<string>,
    /// Ringing Duration for Each Device, in seconds. Values:<br>
    /// 15,20,25,30,35,40,45,50,55,60
    ringing-duration: option<string>,
    /// Values:<br>
    /// 1-24 Hours, 7 Days a Week;<br>
    type-op: option<s32>
  }

  /// Allow callers to press Zero to reach an operator or press One to leave a message, or allow neither of these options.
  record update-setting-template-body-user-settings-call-handling-business-hours-connect-to-operator {
    /// Enable connect to operator.
    enable: option<bool>,
    /// Extension ID of user, zoomRoom, commonAreaPhone, autoReceptionist, callQueue or sharedLineGroup. This ID is passed along with the `type` if the `close_hour_action` was not set with a value of *26*.
    id: option<string>,
    /// Values:<br>
    /// 1-user,<br>
    type-op: option<update-setting-template-body-user-settings-call-handling-business-hours-connect-to-operator-type-op-enum>
  }

  record update-setting-template-body-user-settings-call-handling-business-hours-custom-hours-item {
    /// Values:<br> 
    /// hh:mm
    from-op: option<string>,
    /// Values:<br> 
    /// hh:mm
    to: option<string>,
    /// Values:<br>
    /// 1-24 Hours,<br>
    type-op: option<s32>,
    /// Values: 1-7 sun-sat
    weekday: option<s32>
  }

  record update-setting-template-body-user-settings-call-handling-close-hours {
    /// Action to take when a call is not answered:<br>
    /// 0-Forward to voicemail; <br>
    close-hour-action: option<s32>,
    /// Allow callers to press Zero to reach an operator or press One to leave a message, or allow neither of these options.
    connect-to-operator: option<update-setting-template-body-user-settings-call-handling-close-hours-connect-to-operator>,
    /// Maximum wait time, in seconds. Values:<br>
    /// 15,20,25,30,35,40,45,50,55,60
    max-wait-time: option<string>
  }

  /// Allow callers to press Zero to reach an operator or press One to leave a message, or allow neither of these options.
  record update-setting-template-body-user-settings-call-handling-close-hours-connect-to-operator {
    /// Enable connect to operator.
    enable: option<bool>,
    /// Extension ID of user, zoomRoom, commonAreaPhone, autoReceptionist, callQueue or sharedLineGroup. This ID is passed along with the `type` if the `close_hour_action` was not set with a value of *26*.
    id: option<string>,
    /// Values:<br>
    /// 1-user,<br>
    type-op: option<update-setting-template-body-user-settings-call-handling-business-hours-connect-to-operator-type-op-enum>
  }

  record update-setting-template-body-user-settings-desk-phone {
    /// Pin code.
    pin-code: option<string>
  }

  record assign-calling-plan-body-calling-plans-item {
    /// [Type](https://marketplace.zoom.us/docs/api-reference/other-references/plans#zoom-phone-calling-plans) of the calling plan.
    type-op: option<string>
  }

  record assign-phone-number-body-phone-numbers-item {
    /// ID for phone number
    id: option<string>,
    /// Phone number in E164 format.
    number: option<string>
  }

  /// Update the voicemail setting.
  record add-user-setting-body-voice-mail {
    /// Specify the user ID of a user with whom to share voicemail access permissions. 
    access-user-id: option<string>,
    /// Specifies whether the user has delete permissions. The default is **false**.
    delete: option<bool>,
    /// Specifies whether the user has download permissions. The default is **false**.
    download: option<bool>
  }

  /// Update the voicemail setting.
  record update-user-setting-body-voice-mail {
    /// Specify the user ID of the user whose voicemail permissions need to be updated.
    access-user-id: option<string>,
    /// Specify whether the user has delete permissions. The default is **false**.
    delete: option<bool>,
    /// Specify whether the user has download permissions. The default is **false**.
    download: option<bool>,
    /// 
    /// Specify the ID of the voicemail.
    shared-id: option<string>
  }

  /// Update BYOC settings
  record update-phone-settings-params {
    /// Unique identifier of the sub account.
    account-id: string,
    byoc: option<update-phone-settings-body-byoc>
  }
  update-phone-settings: func(params: update-phone-settings-params) -> result<string, string>;

  /// Set up a Zoom Phone account
  record set-up-account-params {
    /// Unique identifier of the account.
    account-id: string,
    /// Specify emergency address for the account.
    emergency-address: set-up-account-body-emergency-address,
    /// Specify extension number that will be associated with the owner of the account.
    extension-number: string
  }
  set-up-account: func(params: set-up-account-params) -> result<string, string>;

  /// Assign SIP trunks
  record post-phone-sip-trunk-params {
    /// Unique identifier of the account.
    account-id: string,
    /// SIP trunk configurations.
    sip-trunks: option<list<post-phone-sip-trunk-body-sip-trunks-item>>
  }
  post-phone-sip-trunk: func(params: post-phone-sip-trunk-params) -> result<string, string>;

  /// Update SIP trunk details
  record update-phone-sip-trunk-params {
    /// Unique identifier of the SIP trunk.
    sip-trunk-id: string,
    /// Unique identifier of the sub account.
    account-id: string,
    /// Account associated with the carrier.
    carrier-account: option<string>,
    /// Name of the SIP Trunk.
    name: option<string>
  }
  update-phone-sip-trunk: func(params: update-phone-sip-trunk-params) -> result<string, string>;

  /// Add BYOC phone numbers
  record add-byoc-number-params {
    /// Name of the carrier.
    carrier: string,
    /// Phone number(s) to be added to Zoom. The value should be in e164 format.
    phone-numbers: list<string>,
    /// Unique identifier of the site. This field is only required if you have enabled multiple sites in the account. See [Managing multiple sites](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites) or [Adding a site](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites#h_05c88e35-1593-491f-b1a8-b7139a75dc15) for details.
    site-id: option<string>
  }
  add-byoc-number: func(params: add-byoc-number-params) -> result<string, string>;

  /// Get account's call logs
  record account-call-logs-params {
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// Start date from which you would like to get the call logs. The start date should be within past six months. <br>
    /// 
    from-op: option<string>,
    /// The end date upto which you would like to get the call logs for. The end date should be within past six months.
    to: option<string>,
    /// The type of the call logs. The value can be either "all" or "missed".
    type-op: option<string>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Filter the API response by [path](https://support.zoom.us/hc/en-us/articles/360021114452-Viewing-and-identifying-logs#h_646b46c6-0623-4ab1-8b8b-ea5b8bcef679) of the call. The value of this field can be one of the following: `voiceMail`, `message`, `forward`, `extension`, `callQueue`, `ivrMenu`, `companyDirectory`, `autoReceptionist`, `contactCenter`, `disconnected`, `commonAreaPhone`,
    /// `pstn`, `transfer`, `sharedLines`, `sharedLineGroup`, `tollFreeBilling`, `meetingService`, `parkPickup`,
    path: option<string>,
    /// Enables you to sort call logs by start or end time. Choose the sort time value. Values include `startTime` or `endTime`.
    time-type: option<account-call-logs-time-type-enum>,
    /// Unique identifier of the [site](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites). Use this query parameter if you have enabled multiple sites and would like to filter the response of this API call by call logs of a specific phone site.
    site-id: option<string>
  }
  account-call-logs: func(params: account-call-logs-params) -> result<string, string>;

  /// List calling plans
  list-calling-plans: func() -> result<string, string>;

  /// Change main company number
  record change-main-company-number-params {
    /// Provide either the unique identifier of the phone number (id) or the phone number itself in e164 format (e.g: +199955500123).
    phone-number: option<string>
  }
  change-main-company-number: func(params: change-main-company-number-params) -> result<string, string>;

  /// List phone numbers
  record list-account-phone-numbers-params {
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Query response by number assignment. The value can be one of the following:
    /// <br>
    type-op: option<list-account-phone-numbers-type-op-enum>,
    /// The type of assignee to whom the number is assigned. The value can be one of the following:<br>
    /// `user`<br> `callQueue`<br> `autoReceptionist`<br>
    extension-type: option<list-account-phone-numbers-extension-type-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The type of phone number. The value can be either `toll` or `tollfree`.
    number-type: option<list-account-phone-numbers-number-type-enum>,
    /// Include or exclude pending numbers in the response. The value can be either `true` or `false`.
    pending-numbers: option<bool>,
    /// Unique identifier of the site. Use this query parameter if you have enabled multiple sites and would like to filter the response of this API call by a specific phone site. See [Managing multiple sites](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites) or [Adding a site](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites#h_05c88e35-1593-491f-b1a8-b7139a75dc15) for details.
    site-id: option<string>
  }
  list-account-phone-numbers: func(params: list-account-phone-numbers-params) -> result<string, string>;

  /// Get phone number details
  record get-phone-number-details-params {
    /// Unique Identifier of the Phone Number. This can be retrieved from the List Phone Numbers API.
    number-id: string
  }
  get-phone-number-details: func(params: get-phone-number-details-params) -> result<string, string>;

  /// Update phone number details
  record update-phone-number-details-params {
    /// Phone number ID.
    number-id: string,
    /// Phone number capability. Values: `outgoing` or `incoming`. Add one or both.
    capability: option<list<string>>,
    /// Phone number display name.
    display-name: option<string>
  }
  update-phone-number-details: func(params: update-phone-number-details-params) -> result<string, string>;

  /// Get call recordings
  record get-phone-recordings-params {
    /// The number of records returned within a single API call. The default is **30**, and the maximum is **100**.
    page-size: option<s32>,
    /// The current page number of returned records.
    next-page-token: option<string>,
    /// Start date and time in **yyyy-mm-dd** format or **yyyy-MM-dd’T’HH:mm:ss’Z’** format. The date range defined by the from and to parameters should only be one month as the report includes only one month worth of data at once.
    from-op: option<string>,
    /// End date and time in **yyyy-mm-dd** format or **yyyy-MM-dd’T’HH:mm:ss’Z’** format, the same formats supported by the `from` parameter.
    /// 
    to: option<string>,
    /// The owner type. The allowed values are null, `user`, or `callQueue`. The default is null. If null, returns all owner types.
    owner-type: option<string>,
    /// The recording type. The allowed values are null, `OnDemand`, or `Automatic`. The default is null. If null, returns all recording types.
    recording-type: option<string>,
    /// The site ID. The default is `All sites`.
    site-id: option<string>
  }
  get-phone-recordings: func(params: get-phone-recordings-params) -> result<string, string>;

  /// List setting templates
  record list-setting-templates-params {
    /// Number of records returns within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Unique identifier of the site. This field is required only if multiple sites have been enabled.  of the site. Required only when multiple sites are enabled. See [Managing multiple sites](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites) for details. If this is not provided, the response lists the account level setting templates.
    site-id: option<string>
  }
  list-setting-templates: func(params: list-setting-templates-params) -> result<string, string>;

  /// Add a setting template
  record add-setting-template-params {
    /// A description of the template.
    description: option<string>,
    /// The name of the template.
    name: string,
    /// Unique identifier of the site. Required only when multiple sites are enabled. See [Managing multiple sites](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites) for details.
    site-id: option<string>,
    /// The type of template. Values include `user`, `group`, `autoReceptionist`, `commonarea`, or `interop`.
    type-op: add-setting-template-body-type-op-enum
  }
  add-setting-template: func(params: add-setting-template-params) -> result<string, string>;

  /// Get setting template details
  record get-setting-template-params {
    /// Unique identifier of the template.
    template-id: string,
    /// Provide the name of the field to use to filter the response. For example, if you provide "description" as the value of the field, you will get a response similar to the following: {“description”: “template description”}.
    custom-query-fields: option<string>
  }
  get-setting-template: func(params: get-setting-template-params) -> result<string, string>;

  /// Update a setting template
  record update-setting-template-params {
    /// The Template ID.
    template-id: string,
    /// The description of the template.
    description: option<string>,
    /// Specify the name of the template.
    name: option<string>,
    policy: option<update-setting-template-body-policy>,
    profile: option<update-setting-template-body-profile>,
    user-settings: option<update-setting-template-body-user-settings>
  }
  update-setting-template: func(params: update-setting-template-params) -> result<string, string>;

  /// List BYOC SIP trunks
  record list-byocsip-trunk-params {
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>
  }
  list-byocsip-trunk: func(params: list-byocsip-trunk-params) -> result<string, string>;

  /// List phone users
  record list-phone-users-params {
    /// The number of records returned from a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Unique Identifier of the site. This can be retrieved from the [List Phone Sites](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone-site/listphonesites) API.
    site-id: option<string>
  }
  list-phone-users: func(params: list-phone-users-params) -> result<string, string>;

  /// Get user's profile
  record phone-user-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  phone-user: func(params: phone-user-params) -> result<string, string>;

  /// Update user's profile
  record update-user-profile-params {
    /// The extension number of the user. The number must be complete (i.e. site number + short extension).
    extension-number: option<string>,
    /// Unique identifier of the [site](https://support.zoom.us/hc/en-us/articles/360020809672) where the user should be moved or assigned. 
    site-id: option<string>
  }
  update-user-profile: func(params: update-user-profile-params) -> result<string, string>;

  /// Get user's call logs
  record phone-user-call-logs-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    type-op: option<phone-user-call-logs-type-op-enum>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Filter API responses to include call logs of only the phone number defined in this field.
    phone-number: option<string>,
    /// Enables you to sort call logs by start or end time. Choose the sort time value. Values include `startTime` or `endTime`.
    time-type: option<account-call-logs-time-type-enum>
  }
  phone-user-call-logs: func(params: phone-user-call-logs-params) -> result<string, string>;

  /// Delete a user's call log
  record delete-call-log-params {
    /// The user ID or email address of the user.
    user-id: string,
    /// Unique identifier of the call log. The value for this field can be retrieved from [account's call logs](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone/accountcalllogs) or [user's call logs](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone/phoneusercalllogs).
    call-log-id: string
  }
  delete-call-log: func(params: delete-call-log-params) -> result<string, string>;

  /// Assign calling plan to a user
  record assign-calling-plan-params {
    calling-plans: option<list<assign-calling-plan-body-calling-plans-item>>
  }
  assign-calling-plan: func(params: assign-calling-plan-params) -> result<string, string>;

  /// Unassign user's calling plan
  record unassign-calling-plan-params {
    /// The [type](https://marketplace.zoom.us/docs/api-reference/other-references/plans#zoom-phone-calling-plans) of the calling plan that was assigned to user. (e.g: The value of type would be "200" for Unlimited US/Canada calling plan.)
    type-op: string
  }
  unassign-calling-plan: func(params: unassign-calling-plan-params) -> result<string, string>;

  /// Assign phone number to user
  record assign-phone-number-params {
    phone-numbers: option<list<assign-phone-number-body-phone-numbers-item>>
  }
  assign-phone-number: func(params: assign-phone-number-params) -> result<string, string>;

  /// Unassign phone number
  record unassign-phone-number-params {
    /// Provide either userId or email address of the user.
    user-id: string,
    /// Provide either phone number or phoneNumberId of the user. 
    phone-number-id: string
  }
  unassign-phone-number: func(params: unassign-phone-number-params) -> result<string, string>;

  /// Get user's recordings
  record phone-user-recordings-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Start date for the query in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the response includes only one month worth of recording data. The month defined should fall within the last six months.
    from-op: option<string>,
    /// End date.
    to: string
  }
  phone-user-recordings: func(params: phone-user-recordings-params) -> result<string, string>;

  /// Get user's settings
  record phone-user-settings-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  phone-user-settings: func(params: phone-user-settings-params) -> result<string, string>;

  /// Set up shared access
  record add-user-setting-params {
    /// Unique identifier of the user.
    user-id: string,
    /// Corresponds to the setting item you wish to modify. Allowed values: `voice_mail`
    setting-type: string,
    /// Update the voicemail setting.
    voice-mail: option<add-user-setting-body-voice-mail>
  }
  add-user-setting: func(params: add-user-setting-params) -> result<string, string>;

  /// Update shared access
  record update-user-setting-params {
    /// Corresponds to the setting item you wish to modify. Allowed values: `voice_mail`
    setting-type: string,
    /// Unique identifier of the user.
    user-id: string,
    /// Update the voicemail setting.
    voice-mail: option<update-user-setting-body-voice-mail>
  }
  update-user-setting: func(params: update-user-setting-params) -> result<string, string>;

  /// Remove shared access
  record delete-user-setting-params {
    /// Unique identifier of the user.
    user-id: string,
    /// Corresponds to the setting item you wish to remove. Allowed values: `voice_mail`
    setting-type: string,
    /// Required only for voicemail setting type.
    shared-id: string
  }
  delete-user-setting: func(params: delete-user-setting-params) -> result<string, string>;

  /// Get user's voicemails
  record phone-user-voice-mails-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// Status of the voice mail
    status: option<phone-user-voice-mails-status-enum>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Start date for the query in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the response includes only one month worth of voicemail data. The month defined should fall within the last six months.
    from-op: option<string>,
    /// End date.
    to: string
  }
  phone-user-voice-mails: func(params: phone-user-voice-mails-params) -> result<string, string>;

  /// Delete a voicemail
  record delete-voicemail-params {
    /// Unique identifier of the voicemail. Retrieve the value for this field by calling the [Get voicemails](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone/phoneuservoicemails) API.
    voicemail-id: string
  }
  delete-voicemail: func(params: delete-voicemail-params) -> result<string, string>;

}

interface cloud-recording {
  enum list-archived-files-query-data-type-enum {
    meeting-start-time,
    archive-complete-time,
  }

  enum recording-delete-action-enum {
    trash,
    delete,
  }

  enum meeting-recording-registrants-status-enum {
    pending,
    approved,
    denied,
  }

  enum meeting-recording-registrant-status-body-action-enum {
    approve,
    deny,
  }

  enum recording-settings-update-body-share-recording-enum {
    publicly,
    internally,
    none,
  }

  enum recording-status-update-body-action-enum {
    recover,
  }

  record meeting-recording-registrant-status-body-registrants-item {
    id: option<string>
  }

  /// List recordings of an account
  record get-account-cloud-recording-params {
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The start date in UTC for the monthly range for which you would like to retrieve recordings. The maximum range can be a month. If no value is provided for this field, the default will be current date. For example, if you make the API request on June 30, 2020, without providing the “from” and “to” parameters, by default the value of 'from' field will be “2020-06-30” and the value of the 'to' field will be “2020-07-01”.
    from-op: option<string>,
    /// The end date for the monthly range for which you would like to retrieve recordings. The maximum range can be a month.
    to: option<string>,
    /// Unique identifier of the account.
    account-id: string
  }
  get-account-cloud-recording: func(params: get-account-cloud-recording-params) -> result<string, string>;

  /// List archived files
  record list-archived-files-params {
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Start date for the query in "yyyy-MM-dd'T'HH:mm:ss'Z'" format. The duration for the query defined using the "from" and "to" parameters should not exceed 7 days as this API only provides a week's data at once.
    from-op: option<string>,
    /// End date for the query in "yyyy-MM-dd'T'HH:mm:ss'Z'" format. 
    to: option<string>,
    /// Query data type for `from` and `to`.
    query-data-type: option<list-archived-files-query-data-type-enum>
  }
  list-archived-files: func(params: list-archived-files-params) -> result<string, string>;

  /// Get meeting recordings
  record recording-get-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string,
    /// Get the `download_access_token` field for downloading meeting recordings.
    include-fields: option<string>,
    /// Time to live (TTL) of the `download_access_token`. This is only valid if the `include_fields` query parameter contains `download_access_token`. The range is between 0-604800.
    ttl: option<s32>
  }
  recording-get: func(params: recording-get-params) -> result<string, string>;

  /// Delete meeting recordings
  record recording-delete-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string,
    /// The recording delete actions:<br>`trash` - Move recording to trash.<br>`delete` - Delete recording permanently.
    action: option<recording-delete-action-enum>
  }
  recording-delete: func(params: recording-delete-params) -> result<string, string>;

  /// List recording registrants
  record meeting-recording-registrants-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// The registrant status:<br>`pending` - Registrant's status is pending.<br>`approved` - Registrant's status is approved.<br>`denied` - Registrant's status is denied.
    status: option<meeting-recording-registrants-status-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  meeting-recording-registrants: func(params: meeting-recording-registrants-params) -> result<string, string>;

  /// Create a recording registrant
  record meeting-recording-registrant-create-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    body: string
  }
  meeting-recording-registrant-create: func(params: meeting-recording-registrant-create-params) -> result<string, string>;

  /// Get registration questions
  record recording-registrants-questions-get-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string
  }
  recording-registrants-questions-get: func(params: recording-registrants-questions-get-params) -> result<string, string>;

  /// Update registration questions
  record recording-registrant-question-update-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string,
    body: string
  }
  recording-registrant-question-update: func(params: recording-registrant-question-update-params) -> result<string, string>;

  /// Update registrant's status
  record meeting-recording-registrant-status-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    action: meeting-recording-registrant-status-body-action-enum,
    /// List of registrants
    registrants: option<list<meeting-recording-registrant-status-body-registrants-item>>
  }
  meeting-recording-registrant-status: func(params: meeting-recording-registrant-status-params) -> result<string, string>;

  /// Get meeting recording settings
  record recording-setting-update-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string
  }
  recording-setting-update: func(params: recording-setting-update-params) -> result<string, string>;

  /// Update meeting recording settings
  record recording-settings-update-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string,
    /// Approval type for the registration.<br>
    /// `0`- Automatically approve the registration when a user registers.<br>
    approval-type: option<s32>,
    /// Authentication domains.
    authentication-domains: option<string>,
    /// Authentication Options.
    authentication-option: option<string>,
    /// Determine whether registration  isrequired to view the recording.
    on-demand: option<bool>,
    /// Enable password protection for the recording by setting a password. The password must have a minimum of **eight** characters with a mix of numbers, letters and special characters.<br><br>
    /// **Note:** If the account owner or the admin has set minimum password strength requirements for recordings via Account Settings, the password value provided here must meet those requirements. <br><br>If the requirements are enabled, you can view those requirements by calling either the [Get User Settings API](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/usersettings) or the [Get Account Settings](https://marketplace.zoom.us/docs/api-reference/zoom-api/accounts/accountsettings) API. 
    password: option<string>,
    /// Only authenticated users can view.
    recording-authentication: option<bool>,
    /// Send an email to host when someone registers to view the recording. This applies for On-demand recordings only.
    send-email-to-host: option<bool>,
    /// Determine how the meeting recording is shared.
    share-recording: option<recording-settings-update-body-share-recording-enum>,
    /// Show social share buttons on registration page. This applies for On-demand recordings only.
    show-social-share-buttons: option<bool>,
    /// Name of the recording.
    topic: option<string>,
    /// Determine whether a viewer can download the recording file or not.
    viewer-download: option<bool>
  }
  recording-settings-update: func(params: recording-settings-update-params) -> result<string, string>;

  /// Recover meeting recordings
  record recording-status-update-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string,
    action: option<recording-status-update-body-action-enum>
  }
  recording-status-update: func(params: recording-status-update-params) -> result<string, string>;

  /// Delete a meeting recording file
  record recording-delete-one-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string,
    /// The recording ID.
    recording-id: string,
    /// The recording delete actions:<br>`trash` - Move recording to trash.<br>`delete` - Delete recording permanently.
    action: option<recording-delete-action-enum>
  }
  recording-delete-one: func(params: recording-delete-one-params) -> result<string, string>;

  /// Recover a single recording
  record recording-status-update-one-params {
    /// To get Cloud Recordings of a meeting, provide the meeting ID or meeting UUID. If the meeting ID is provided instead of UUID,the response will be for the latest meeting instance. 
    /// 
    meeting-id: string,
    /// The recording ID.
    recording-id: string,
    action: option<recording-status-update-body-action-enum>
  }
  recording-status-update-one: func(params: recording-status-update-one-params) -> result<string, string>;

  /// List all recordings
  record recordings-list-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Query Metadata of Recording if an On-Premise Meeting Connector was used for the meeting.
    mc: option<string>,
    /// Query trash.
    /// `true`: List recordings from trash.<br> `false`: Do not list recordings from the trash.<br> The default value is `false`. If you set it to `true`, you can use the `trash_type` property to indicate the type of Cloud recording that you need to retrieve. 
    trash: option<bool>,
    /// The start date in 'yyyy-mm-dd' UTC format for the date range for which you would like to retrieve recordings. The maximum range can be a month. If no value is provided for this field, the default will be current date. For example, if you make the API request on June 30, 2020, without providing the “from” and “to” parameters, by default the value of 'from' field will be “2020-06-30” and the value of the 'to' field will be “2020-07-01”. 
    /// 
    from-op: option<string>,
    /// End date in 'yyyy-mm-dd' 'yyyy-mm-dd' UTC format. 
    to: option<string>,
    /// The type of Cloud recording that you would like to retrieve from the trash. The value can be one of the following:<br>
    ///     `meeting_recordings`: List all meeting recordings from the trash.<br>
    trash-type: option<string>
  }
  recordings-list: func(params: recordings-list-params) -> result<string, string>;

}

interface sip-connected-audio {
  enum add-internal-numbers-body-internal-numbers-item-languages-enum {
    en-gb,
    en-us,
    de-de,
  }

  record add-callout-countries-body-callout-countries-item {
    /// Two letter country code of the  call-out country.
    id: string
  }

  record add-internal-numbers-body-internal-numbers-item {
    /// Control whether the number can be used to attend 3rd party meetings.
    allow-for-external-meetings: option<bool>,
    /// Specify whether this number can be used by users to join a meeting or not. <br>
    /// * `true` : This number can be used to join a meeting. <br>
    allow-join: option<bool>,
    /// Two letter country code of the country.
    country: string,
    /// Phone number with display format. For instance, if the value in the number field is `+1888888000`, the value of this field could be `+1 888 888 000`. 
    display-number: string,
    /// A short description for the phone number.
    labels: string,
    /// Specify the language in which this phone number should be displayed. Currently, the only supported languages are `en-GB`, `en-US`, `de-DE`.
    languages: add-internal-numbers-body-internal-numbers-item-languages-enum,
    /// Phone number in E164 format.
    number: string,
    /// Type of phone number. <br>
    /// The value can be one of the following:<br>
    type-op: s32,
    /// Specify whether you want this number to be visible (in Zoom Client and Zoom Portal) to the account users or not. The value could be one of the following:<br>
    /// * `true`: Make the number visible. <br>
    visible: option<bool>
  }

  record assign-sip-trunks-body-sip-trunks-item {
    /// DNIS of the sub account. The prefix of the DNIS (i.e. the first five digits of the DNIS value) must match the DNIS prefix of the master account. To retrieve the DNIS prefix of a master account's SIP Trunk, use the List SIP Trunks API and refer to the first five digits in the `dnis` value. 
    /// 
    dnis: option<string>,
    /// Unique identifier of the SIP trunk that will be assigned to the sub account. The value of this field can be retrieved by listing the SIP Trunks of a master account using List SIP Trunks API.
    id: option<string>,
    /// Assign an outbound caller Id to the trunk.
    outbound-caller-id: option<string>
  }

  /// List internal call-out countries
  record list-internal-callout-countries-params {
    /// Unique identifier of the account. To list Call-out enabled countries to a sub account, provide the account ID of the sub account in the `accountId` path parameter. To list Call-out enabled countries of a sub account, provide the account ID of the sub account in the `accountId` path parameter. To list Call-out enabled countries of a master account, provide `me` as the value of the `accountId` path parameter.
    account-id: string
  }
  list-internal-callout-countries: func(params: list-internal-callout-countries-params) -> result<string, string>;

  /// Add internal call-out countries
  record add-callout-countries-params {
    /// Unique identifier of the account. To add Call-out enabled countries to a sub account, provide the account ID of the sub account in the `accountId` path parameter. To add Call-out enabled countries to a master account, provide `me` as the value of the `accountId` path parameter.
    account-id: string,
    /// List of callout countries.
    callout-countries: list<add-callout-countries-body-callout-countries-item>
  }
  add-callout-countries: func(params: add-callout-countries-params) -> result<string, string>;

  /// Delete internal call-out country
  record delete-internal-call-out-country-params {
    /// Unique Identifier of the Account.<br>
    /// To remove Call-out country from a sub account, provide the account ID of the sub account in the `accountId` path parameter. To remove Call-out country from a master account, provide `me` as the value of the `accountId` path parameter.
    account-id: string,
    /// Two lettered Id of the country.
    country-id: string
  }
  delete-internal-call-out-country: func(params: delete-internal-call-out-country-params) -> result<string, string>;

  /// List internal numbers
  record list-internal-numbers-params {
    /// Unique identifier of the account. To list internal numbers of a sub account, provide the account ID of the sub account in the `accountId` path parameter. To list internal numbers of a  master account, provide `me` as the value of the `accountId` path parameter.
    account-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-internal-numbers: func(params: list-internal-numbers-params) -> result<string, string>;

  /// Add internal numbers
  record add-internal-numbers-params {
    /// Unique identifier of the account.<br>To add internal numbers to a sub account, provide the account ID of the sub account in the `accountId` path parameter. To add internal numbers to a master account, provide `me` as the value of the `accountId` path parameter.
    account-id: string,
    internal-numbers: option<list<add-internal-numbers-body-internal-numbers-item>>
  }
  add-internal-numbers: func(params: add-internal-numbers-params) -> result<string, string>;

  /// Delete an internal number
  record delete-internal-number-params {
    /// Unique Identifier of the account. To delete an internal number from a sub account, provide the account ID of the sub account in the `accountId` path parameter. To delete an internal number from a master account, provide `me` as the value of the `accountId` path parameter.
    account-id: string,
    /// Unique identifier of the phone number. This value can be retrieved by calling the List Internal Numbers API.
    number-id: string
  }
  delete-internal-number: func(params: delete-internal-number-params) -> result<string, string>;

  /// Assign numbers
  record assign-sip-trunk-numbers-params {
    /// Unique Identifier of the sub account.
    account-id: string,
    /// Phone number(s) to be assigned to the sub account.
    phone-numbers: option<list<string>>
  }
  assign-sip-trunk-numbers: func(params: assign-sip-trunk-numbers-params) -> result<string, string>;

  /// Delete all numbers
  record delete-all-sip-numbers-params {
    /// Account ID of the sub account from which the numbers are to be deleted. This can be retrieved from [List sub accounts](https://marketplace.zoom.us/docs/api-reference/zoom-api/accounts/account) API.
    account-id: string
  }
  delete-all-sip-numbers: func(params: delete-all-sip-numbers-params) -> result<string, string>;

  /// Assign SIP trunk configuration
  record assign-sip-config-params {
    /// Enable or delete the configuration.<br> The values can be one of the following:<br> `true`: Enable configuration.<br> `false`: Delete configuration
    enable: option<bool>,
    /// If the value of this option is set to `true`, the call-out numbers provided by the Zoom carrier partners will be displayed in the account's list of available call-out numbers in the Zoom Web Portal and Zoom Client.
    show-callout-internal-number: option<bool>,
    /// If the value of this option is set to `0`, the call-out countries list provided by Zoom will be [displayed](https://support.zoom.us/hc/en-us/articles/200942859-Using-telephone-call-out) in the account's list of available call-out countries. 
    /// 
    show-zoom-provided-callout-countries: option<s32>,
    /// If the value of this option is set to `0`, the numbers provided by Zoom will be displayed in the account's list of available call-out and call-in numbers in the Zoom Web Portal and Zoom Client. 
    /// 
    show-zoom-provided-numbers: option<s32>
  }
  assign-sip-config: func(params: assign-sip-config-params) -> result<string, string>;

  /// List SIP trunks
  record list-sip-trunks-params {
    /// Unique Identifier of the Account. To retrieve SIP trunks assigned to a sub account, provide the account ID of the sub account in the as the value of this field. To retrieve SIP trunks of a master account, provide `me` as the value of this field.
    account-id: string
  }
  list-sip-trunks: func(params: list-sip-trunks-params) -> result<string, string>;

  /// Assign SIP trunks
  record assign-sip-trunks-params {
    /// Unique Identifier of the sub account.
    account-id: string,
    /// Array of one or more SIP Trunk objects. 
    sip-trunks: option<list<assign-sip-trunks-body-sip-trunks-item>>
  }
  assign-sip-trunks: func(params: assign-sip-trunks-params) -> result<string, string>;

  /// Delete a SIP trunk
  record delete-sip-trunk-params {
    /// Unique identifier of the sub account.
    account-id: string,
    /// Unique identifier of the SIP Trunk that was previously assigned to a sub account. To retrieve the value of this field, use the List SIP Trunks API.
    trunk-id: string
  }
  delete-sip-trunk: func(params: delete-sip-trunk-params) -> result<string, string>;

  /// List SIP trunk numbers
  list-sip-trunk-numbers: func() -> result<string, string>;

}

interface users {
  enum users-status-enum {
    active,
    inactive,
    pending,
  }

  enum user-create-body-action-enum {
    create,
    auto-create,
    cust-create,
    sso-create,
  }

  enum user-login-type-enum {
    v0,
    v1,
    v99,
    v100,
    v101,
  }

  enum user-delete-action-enum {
    disassociate,
    delete,
  }

  enum update-presence-status-body-status-enum {
    do-no-disturb,
    away,
    available,
  }

  enum user-settings-option-op-enum {
    meeting-authentication,
    recording-authentication,
  }

  enum user-settings-update-option-op-enum {
    meeting-authentication,
    recording-authentication,
    meeting-secuirty,
  }

  enum user-status-body-action-enum {
    activate,
    deactivate,
  }

  enum user-token-type-op-enum {
    token,
    zak,
  }

  record user-create-body-user-info {
    /// User email address.
    email: string,
    /// User's first name: cannot contain more than 5 Chinese words.
    first-name: option<string>,
    /// User's last name: cannot contain more than 5 Chinese words.
    last-name: option<string>,
    /// User password. Only used for the "autoCreate" function. The password has to have a minimum of 8 characters and maximum of 32 characters. By default (basic requirement), password must have at least one letter (a, b, c..), at least one number (1, 2, 3...) and include both uppercase and lowercase letters. It should not contain only one identical character repeatedly ('11111111' or 'aaaaaaaa') and it cannot contain consecutive characters ('12345678' or 'abcdefgh').
    /// 
    password: option<string>,
    /// User type:<br>`1` - Basic.<br>`2` - Licensed.<br>`3` - On-prem.<br>`99` - None (this can only be set with `ssoCreate`).
    type-op: s32
  }

  /// Custom attribute(s) of the user.
  record user-update-body-custom-attributes {
    /// Identifier for the custom attribute.
    key: option<string>,
    /// Name of the custom attribute.
    name: option<string>,
    /// Value of the custom attribute.
    value: option<string>
  }

  record user-update-body-phone-numbers {
    /// Country code of the phone number. For example, for United States phone numbers, the value of this field should be "+1".
    code: option<string>,
    /// [Country ID](https://marketplace.zoom.us/docs/api-reference/other-references/abbreviation-lists#countries) of the phone number. For example, if the phone number provided in the `number` field is a Brazil based number, the value of the `country` field should be `BR`.
    country: option<string>,
    /// Phone number of the user.
    number: option<string>
  }

  record user-assistant-create-body-assistants-item {
    /// Assistant's email address.
    email: option<string>,
    /// Assistant's user ID.
    id: option<string>
  }

  /// Switch a user's account
  record switch-user-account-params {
    account-id: string
  }
  switch-user-account: func(params: switch-user-account-params) -> result<string, string>;

  /// List users
  record users-params {
    /// User statuses:<br>`active` - Users with an active status.<br>`inactive` - Users who are deactivated.<br>`pending` - Users with a pending status.
    status: option<users-status-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// Unique identifier of the role. Provide this parameter if you would like to filter the response by a specific role. You can retrieve Role IDs from [List Roles](https://marketplace.zoom.us/docs/api-reference/zoom-api/roles/roles) API. 
    role-id: option<string>,
    /// The page number of the current page in the returned records.
    page-number: option<string>,
    /// Provide a value for this field if you would like to see the following attribute in the response of this API call:<br>
    /// 
    include-fields: option<string>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  users: func(params: users-params) -> result<string, string>;

  /// Create users
  record user-create-params {
    /// Specify how to create the new user: <br>`create` - User will get an email sent from Zoom. There is a confirmation link in this email. The user will then need to use the link to activate their Zoom account. The user can then set or change their password.<br>`autoCreate` - This action is provided for the enterprise customer who has a managed domain. This feature is disabled by default because of the security risk involved in creating a user who does not belong to your domain.<br>`custCreate` - Users created via this option do not have passwords and will not have the ability to log into the Zoom Web Portal or the Zoom Client. These users can still host and join meetings using the `start_url` and `join_url` respectively. To use this option, you must contact the ISV Platform Sales team at isv@zoom.us.<br>`ssoCreate` - This action is provided for the enabled “Pre-provisioning SSO User” option. A user created in this way has no password. If not a basic user, a personal vanity URL using the user name (no domain) of the provisioning email will be generated. If the user name or PMI is invalid or occupied, it will use a random number or random personal vanity URL.
    action: user-create-body-action-enum,
    user-info: option<user-create-body-user-info>
  }
  user-create: func(params: user-create-params) -> result<string, string>;

  /// Check a user email
  record user-email-params {
    /// The email address to be verified.
    email: string
  }
  user-email: func(params: user-email-params) -> result<string, string>;

  /// Get user's ZAK
  user-zak: func() -> result<string, string>;

  /// Check a user's PM room
  record user-vanity-name-params {
    /// Personal meeting room name.
    vanity-name: string
  }
  user-vanity-name: func(params: user-vanity-name-params) -> result<string, string>;

  /// Get a user
  record user-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// `0` - Facebook.<br>`1` - Google.<br>`99` - API.<br>`100` - Zoom.<br>`101` - SSO.
    login-type: option<user-login-type-enum>
  }
  user: func(params: user-params) -> result<string, string>;

  /// Update a user
  record user-update-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// `0` - Facebook.<br>`1` - Google.<br>`99` - API.<br>`100` - Zoom.<br>`101` - SSO.
    login-type: option<user-login-type-enum>,
    /// Kaltura user ID.
    cms-user-id: option<string>,
    /// User's company.
    company: option<string>,
    /// Custom attribute(s) of the user.
    custom-attributes: option<user-update-body-custom-attributes>,
    /// Department for user profile: use for report.
    dept: option<string>,
    /// User's first name. Cannot contain more than 5 Chinese characters.
    first-name: option<string>,
    /// Provide unique identifier of the group that you would like to add a [pending user](https://support.zoom.us/hc/en-us/articles/201363183-Managing-users#h_13c87a2a-ecd6-40ad-be61-a9935e660edb) to. The value of this field can be retrieved from [List Groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups) API.
    group-id: option<string>,
    /// Host key. It should be a 6-10 digit number.
    host-key: option<string>,
    /// User's job title.
    job-title: option<string>,
    /// language
    language: option<string>,
    /// User's last name. Cannot contain more than 5 Chinese characters.
    last-name: option<string>,
    /// User's location.
    location: option<string>,
    /// The manager for the user.
    manager: option<string>,
    /// **Note:** This field has been **deprecated** and will not be supported in the future. Use the **country** field of the **phone_numbers** object instead to select the country for the phone number.
    /// 
    phone-country: option<string>,
    /// **Note:** This field has been **deprecated** and will not be supported in the future. Use the **phone_numbers** field instead to assign phone number(s) to a user.
    /// 
    phone-number: option<string>,
    phone-numbers: option<user-update-body-phone-numbers>,
    /// Personal meeting ID: length must be 10.
    pmi: option<string>,
    /// The time zone ID for a user profile. For this parameter value please refer to the ID value in the [timezone](https://marketplace.zoom.us/docs/api-reference/other-references/abbreviation-lists#timezones) list.
    timezone: option<string>,
    /// User types:<br>`1` - Basic.<br>`2` - Licensed.<br>`3` - On-prem.<br>`99` - None (this can only be set with `ssoCreate`).
    type-op: option<s32>,
    /// Use Personal Meeting ID for instant meetings.
    use-pmi: option<bool>,
    /// Personal meeting room name.
    vanity-name: option<string>
  }
  user-update: func(params: user-update-params) -> result<string, string>;

  /// Delete a user
  record user-delete-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// Delete action options:<br>`disassociate` - Disassociate a user.<br>`delete`-  Permanently delete a user.<br>Note: To delete pending user in the account, use `disassociate`
    action: option<user-delete-action-enum>,
    /// Transfer email.
    transfer-email: option<string>,
    /// Transfer meeting.
    transfer-meeting: option<bool>,
    /// Transfer webinar.
    transfer-webinar: option<bool>,
    /// Transfer recording.
    transfer-recording: option<bool>
  }
  user-delete: func(params: user-delete-params) -> result<string, string>;

  /// List user assistants
  record user-assistants-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-assistants: func(params: user-assistants-params) -> result<string, string>;

  /// Add assistants
  record user-assistant-create-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// List of User's assistants.
    assistants: option<list<user-assistant-create-body-assistants-item>>
  }
  user-assistant-create: func(params: user-assistant-create-params) -> result<string, string>;

  /// Delete user assistants
  record user-assistants-delete-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-assistants-delete: func(params: user-assistants-delete-params) -> result<string, string>;

  /// Delete a user assistant
  record user-assistant-delete-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// Assistant ID.
    assistant-id: string
  }
  user-assistant-delete: func(params: user-assistant-delete-params) -> result<string, string>;

  /// Update a user's email
  record user-email-update-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// User’s email. The length should be less than 128 characters.
    email: string
  }
  user-email-update: func(params: user-email-update-params) -> result<string, string>;

  /// Update a user's password
  record user-password-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// User password. Should be less than 32 characters.
    /// 
    password: string
  }
  user-password: func(params: user-password-params) -> result<string, string>;

  /// Get user permissions
  record user-permission-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-permission: func(params: user-permission-params) -> result<string, string>;

  /// Upload a user's profile picture
  record user-picture-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-picture: func(params: user-picture-params) -> result<string, string>;

  /// Update a user's presence status
  record update-presence-status-params {
    /// If you're updating the status to `Do_Not_Disturb`, specify a duration in minutes for which the status should remain as `Do_Not_Disturb`. 
    /// 
    duration: option<s32>,
    /// Presence status of the user. The value can be set to one of the following:<br>
    /// * `Away`
    status: option<update-presence-status-body-status-enum>
  }
  update-presence-status: func(params: update-presence-status-params) -> result<string, string>;

  /// List user schedulers
  record user-schedulers-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-schedulers: func(params: user-schedulers-params) -> result<string, string>;

  /// Delete user schedulers
  record user-schedulers-delete-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-schedulers-delete: func(params: user-schedulers-delete-params) -> result<string, string>;

  /// Delete a scheduler
  record user-scheduler-delete-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// Scheduler's ID.
    scheduler-id: string
  }
  user-scheduler-delete: func(params: user-scheduler-delete-params) -> result<string, string>;

  /// Get user settings
  record user-settings-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// `0` - Facebook.<br>`1` - Google.<br>`99` - API.<br>`100` - Zoom.<br>`101` - SSO.
    login-type: option<user-login-type-enum>,
    /// `meeting_authentication`: Use this query parameter to view [meeting authentication configuration](https://support.zoom.us/hc/en-us/articles/360037117472-Authentication-Profiles-for-Meetings-and-Webinars) applied on the user's account.<br>`recording_authentication`: Use this query parameter to view [recording authentication configuration](https://support.zoom.us/hc/en-us/articles/360037756671-Authentication-Profiles-for-Cloud-Recordings) applied on the user's account.<br>
    /// `meeting_security`: Use this query parameter to view meeting security settings applied on the user's account.<br>
    option-op: option<user-settings-option-op-enum>,
    /// Provide the name of the field by which you would like to filter the response. For example, if you provide "host_video" as the value of this field, you will get a response similar to the following:<br>
    /// {
    custom-query-fields: option<string>
  }
  user-settings: func(params: user-settings-params) -> result<string, string>;

  /// Update user settings
  record user-settings-update-params {
    option-op: option<user-settings-update-option-op-enum>,
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    body: string
  }
  user-settings-update: func(params: user-settings-update-params) -> result<string, string>;

  /// Upload virtual background files
  record upload-v-buser-params {
    /// Unique identifier of the user. Retrieve the value for this field by calling the [List users](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/users) API.
    user-id: string
  }
  upload-v-buser: func(params: upload-v-buser-params) -> result<string, string>;

  /// Delete virtual background files
  record del-user-vb-params {
    /// Provide the id of the file that is to be deleted. To delete multiple files, provide comma separated values for this field.
    file-ids: option<string>,
    /// Unique identifier of the user. Retrieve the value of this field by calling the [List users](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/users) API. 
    user-id: string
  }
  del-user-vb: func(params: del-user-vb-params) -> result<string, string>;

  /// Update user status
  record user-status-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// The action types:<br>`activate` - Activate a deactivated user.<br>`deactivate` - Deactivate a user.
    action: user-status-body-action-enum
  }
  user-status: func(params: user-status-params) -> result<string, string>;

  /// Get a user token
  record user-token-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// User token types:<br>`token` - Used for starting meetings with the client SDK. This token expires in 14 days and a new token will be returned after the expiry.<br>`zak` - Used for generating the start meeting URL. The token expiration time is two hours. For API users, the expiration time is 90 days.
    type-op: option<user-token-type-op-enum>,
    /// Use this field in conjunction with the `type` field where the value of `type` field is `zak`. The value of this field denotes the expiry time of the `zak` token in seconds. For example, if you would like the zak token to be expired after one hour of the token generation, the value of this field should be `3600`.
    ttl: option<s32>
  }
  user-token: func(params: user-token-params) -> result<string, string>;

  /// Revoke a user's SSO token
  record user-sso-token-delete-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string
  }
  user-sso-token-delete: func(params: user-sso-token-delete-params) -> result<string, string>;

}

interface chat-channels {
  record create-channel-body-members-item {
    /// Member's email address.
    email: string
  }

  /// Get a channel
  record get-user-level-channel-params {
    /// Channel ID: Unique Identifier of a channel.
    channel-id: string
  }
  get-user-level-channel: func(params: get-user-level-channel-params) -> result<string, string>;

  /// Update a channel
  record update-user-level-channel-params {
    /// Channel Id.
    channel-id: string,
    /// A new name for the channel.
    name: string
  }
  update-user-level-channel: func(params: update-user-level-channel-params) -> result<string, string>;

  /// Delete a channel
  record delete-user-level-channel-params {
    /// Channel ID: Unique Identifier of a channel.
    channel-id: string
  }
  delete-user-level-channel: func(params: delete-user-level-channel-params) -> result<string, string>;

  /// Join a channel
  record join-channel-params {
    /// Channel Id.
    channel-id: string
  }
  join-channel: func(params: join-channel-params) -> result<string, string>;

  /// Leave a channel
  record leave-channel-params {
    /// Channel ID: Unique Identifier of a channel.
    channel-id: string
  }
  leave-channel: func(params: leave-channel-params) -> result<string, string>;

  /// Remove a member
  record remove-a-user-level-channel-member-params {
    /// Unique Identifier of the Channel from where you would like to remove a member. This can be retrieved from the [List Channels API](https://marketplace.zoom.us/docs/api-reference/zoom-api/chat-channels/getchannels).
    channel-id: string,
    /// Email address of the member whom you would like to be remove from the channel.
    member-id: string
  }
  remove-a-user-level-channel-member: func(params: remove-a-user-level-channel-member-params) -> result<string, string>;

  /// List user's channels
  record get-channels-params {
    /// The number of records returned from a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Unique identifier of the user.
    user-id: string
  }
  get-channels: func(params: get-channels-params) -> result<string, string>;

  /// Create a channel
  record create-channel-params {
    /// Unique identifier of the user.
    user-id: string,
    /// Member(s) to include in the channel. A max of 5 members can be added to the channel at once with this API.
    members: option<list<create-channel-body-members-item>>,
    /// Name of the channel.
    name: option<string>,
    /// Type of the channel. The value can be one of the following:<br>
    /// `1`: Private channel. In this type of channel, members must be invited to join a channel.<br>
    type-op: option<s32>
  }
  create-channel: func(params: create-channel-params) -> result<string, string>;

}

interface contacts {
  /// List user's contacts
  record get-user-contacts-params {
    /// The type of contact. The value can be one of the following:
    /// `company`: Contacts from the user's organization.
    type-op: option<string>,
    /// The number of records returned with a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  get-user-contacts: func(params: get-user-contacts-params) -> result<string, string>;

  /// Get user's contact details
  record get-user-contact-params {
    /// The user's contact Id or email address. The contact can be either a company contact or an external contact.
    contact-id: string,
    /// The presence status of the contact. 
    /// Include this query parameter with a value of `true` to get the presence status of the contact in the response.
    query-presence-status: option<bool>
  }
  get-user-contact: func(params: get-user-contact-params) -> result<string, string>;

  /// Search company contacts
  record search-company-contacts-params {
    /// Provide the keyword - either first name, last name or email of the contact whom you have to search for.
    search-key: string,
    /// Set `query_presence_status` to `true` in order to include the presence status of a contact in the response.
    query-presence-status: option<string>,
    /// The number of records to be returned with a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  search-company-contacts: func(params: search-company-contacts-params) -> result<string, string>;

}

interface chat-channels-account-level {
  record invite-channel-members-body-members-item {
    /// Email adress of the member.
    email: string
  }

  /// Get a channel
  record get-channel-params {
    /// Channel ID: Unique Identifier of a channel.
    channel-id: string,
    /// Unique identifier of the user who is the owner of the channel.
    user-id: string
  }
  get-channel: func(params: get-channel-params) -> result<string, string>;

  /// Update a channel
  record update-channel-params {
    /// Channel Id.
    channel-id: string,
    /// Unique Identifier of the Zoom user who is the owner of the channel.
    user-id: string,
    /// A new name for the channel.
    name: string
  }
  update-channel: func(params: update-channel-params) -> result<string, string>;

  /// Delete a channel
  record delete-channel-params {
    /// Channel ID: Unique Identifier of a channel.
    channel-id: string
  }
  delete-channel: func(params: delete-channel-params) -> result<string, string>;

  /// List channel members
  record list-channel-members-params {
    /// Channel Id.
    channel-id: string,
    /// The number of records returned with a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Unique identifier of the user who is the owner of this channel.
    user-id: string
  }
  list-channel-members: func(params: list-channel-members-params) -> result<string, string>;

  /// Invite channel members
  record invite-channel-members-params {
    /// Channel ID: Unique Identifier of the channel.
    channel-id: string,
    /// Unique identifier of the user who is the owner of this channel.
    user-id: string,
    /// Members of a channel. You can invite up to a max number of 5 members with a single API call.
    members: option<list<invite-channel-members-body-members-item>>
  }
  invite-channel-members: func(params: invite-channel-members-params) -> result<string, string>;

  /// Remove a member
  record remove-a-channel-member-params {
    /// Unique Identifier of the Channel from where you would like to remove a member. This can be retrieved from the [List Channels API](https://marketplace.zoom.us/docs/api-reference/zoom-api/chat-channels/getchannels).
    channel-id: string,
    /// Email address of the member whom you would like to be remove from the channel.
    member-id: string,
    /// Unique identifier of the channel owner.
    user-id: string
  }
  remove-a-channel-member: func(params: remove-a-channel-member-params) -> result<string, string>;

}

interface chat-messages {
  record senda-chat-message-body-at-items-item {
    /// This field is required if the value of `at_type` field is set to 1. 
    /// 
    at-contact: option<string>,
    /// Type of mention. You can use one of the following values:<br>
    /// * `1`: Mention a contact. 
    at-type: option<s32>,
    /// End position of the mention.
    /// 
    end-position: option<s32>,
    /// Start position of the mention("@") in the message string. 
    /// 
    start-position: option<s32>
  }

  /// List user's chat messages
  record get-chat-messages-params {
    /// The email address of a chat contact with whom the current user chatted. Messages that were sent and/or received between the user and the contact is displayed.
    /// 
    to-contact: option<string>,
    /// The channel Id of a channel inside which the current user had chat conversations. Messages that were sent and/or received between the user and the channel is displayed.
    /// 
    to-channel: option<string>,
    /// The query date for which you would like to get the chat messages.
    date: option<string>,
    /// The number of records returned with a single API call. 
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// **Optional** <br>
    /// Set the value of this field to `true` to include edited and deleted messages in the response.
    include-deleted-and-edited-message: option<string>
  }
  get-chat-messages: func(params: get-chat-messages-params) -> result<string, string>;

  /// Send a chat message
  record senda-chat-message-params {
    /// [Chat mentions](https://support.zoom.us/hc/en-us/articles/360037567431-Using-chat-mentions-and-slash-commands) object. Use this object to include mentions in the message that will be sent to  a channel. 
    at-items: option<list<senda-chat-message-body-at-items-item>>,
    /// The message to be sent.
    message: string,
    /// The Channel Id of the channel where you would like to send a message.
    to-channel: option<string>,
    /// The email address of the contact to whom you would like to send the message.
    to-contact: option<string>
  }
  senda-chat-message: func(params: senda-chat-message-params) -> result<string, string>;

  /// Update a message
  record edit-message-params {
    /// Message ID: Unique Identifier of the message.
    message-id: string,
    /// The edited message.
    message: option<string>,
    /// The Channel ID of the channel where you sent the message.<br>You must provide either `to_contact` or `to_channel` parameter in the API request.
    ///  Channel ID can be retrieved from List User's Channels API. 
    to-channel: option<string>,
    /// The email address of the contact to whom the message was sent.<br>
    /// You must provide either `to_contact` or `to_channel` parameter in the API request.
    to-contact: option<string>
  }
  edit-message: func(params: edit-message-params) -> result<string, string>;

  /// Delete a message
  record delete-chat-message-params {
    /// Message ID
    message-id: string,
    /// The userId or email address of a chat contact to whom you previously sent the message.
    /// 
    to-contact: option<string>,
    /// The channel Id of the channel where you would like to send the message.
    /// 
    to-channel: option<string>
  }
  delete-chat-message: func(params: delete-chat-message-params) -> result<string, string>;

}

interface groups {
  enum update-a-group-member-body-action-enum {
    move,
    set-primary,
  }

  enum get-group-settings-option-op-enum {
    meeting-authentication,
    recording-authentication,
  }

  enum update-group-settings-option-op-enum {
    meeting-authentication,
    recording-authentication,
    meeting-security,
  }

  record group-members-create-body-members-item {
    /// User email. If the user ID is given then the user email should be ignored.
    email: option<string>,
    /// User ID.
    id: option<string>
  }

  /// List groups
  groups: func() -> result<string, string>;

  /// Create a group
  record group-create-params {
    /// Group name.
    name: option<string>
  }
  group-create: func(params: group-create-params) -> result<string, string>;

  /// Get a group
  record group-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string
  }
  group: func(params: group-params) -> result<string, string>;

  /// Update a group
  record group-update-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string,
    /// Group name. It must be unique to one account and less than 128 characters.
    name: option<string>
  }
  group-update: func(params: group-update-params) -> result<string, string>;

  /// Delete a group
  record group-delete-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string
  }
  group-delete: func(params: group-delete-params) -> result<string, string>;

  /// Get locked settings
  record get-group-lock-settings-params {
    /// Id of the group.
    group-id: string,
    /// Specify `meeting_security` as the value of this field if you would like to view security settings applied on a meeting hosted by the users in this group.
    option-op: option<string>
  }
  get-group-lock-settings: func(params: get-group-lock-settings-params) -> result<string, string>;

  /// Update locked settings
  record group-locked-settings-params {
    /// The Id of the group.
    group-id: string,
    /// Specify `meeting_security` as the value of this field if you would like to view security settings applied on a meeting hosted by the users in this group.
    option-op: option<string>,
    body: option<string>
  }
  group-locked-settings: func(params: group-locked-settings-params) -> result<string, string>;

  /// List group members 
  record group-members-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  group-members: func(params: group-members-params) -> result<string, string>;

  /// Add group members
  record group-members-create-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string,
    /// List of Group members
    members: option<list<group-members-create-body-members-item>>
  }
  group-members-create: func(params: group-members-create-params) -> result<string, string>;

  /// Update a group member
  record update-a-group-member-params {
    /// Unique Identifier of the group. Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups) API.<br> To change a member's primary group, provide the groupId of the member's current primary group as the value of this field.<br> To remove a member from one group and move the member to another group, provide the groupId of the group from which the member is to be moved.
    group-id: string,
    /// Unique Identifier of the group member. Can be retrieved by calling the [List Group Members](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groupmembers) API.
    member-id: string,
    /// Specify the type of action to be performed:<br><br>
    /// `move`: Simultaneously remove a member from one group and move the member to a different group.<br>
    action: update-a-group-member-body-action-enum,
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups) API.<br>
    /// 
    target-group-id: option<string>
  }
  update-a-group-member: func(params: update-a-group-member-params) -> result<string, string>;

  /// Delete a group member
  record group-members-delete-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string,
    /// The member ID.
    member-id: string
  }
  group-members-delete: func(params: group-members-delete-params) -> result<string, string>;

  /// Get a group's settings
  record get-group-settings-params {
    /// `meeting_authentication`: Use this query parameter to view [meeting authentication configuration](https://support.zoom.us/hc/en-us/articles/360037117472-Authentication-Profiles-for-Meetings-and-Webinars) applied on the group.<br>`recording_authentication`: Use this query parameter to view [recording authentication configuration](https://support.zoom.us/hc/en-us/articles/360037756671-Authentication-Profiles-for-Cloud-Recordings) applied on the group.<br>
    /// `meeting_security`: Use this query parameter to view meeting security settings applied on the group.<br>
    option-op: option<get-group-settings-option-op-enum>
  }
  get-group-settings: func(params: get-group-settings-params) -> result<string, string>;

  /// Update a group's settings
  record update-group-settings-params {
    /// Id of the group.
    group-id: string,
    option-op: option<update-group-settings-option-op-enum>,
    body: option<string>
  }
  update-group-settings: func(params: update-group-settings-params) -> result<string, string>;

  /// Upload virtual background files
  record upload-group-vb-params {
    /// Unique identifier of the group. Retrieve the value for this field by calling the [List groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups) API.
    group-id: string
  }
  upload-group-vb: func(params: upload-group-vb-params) -> result<string, string>;

  /// Delete virtual background files
  record del-group-vb-params {
    /// Unique identifier of the group. Retrieve the value for this field by calling the [List groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups) API.
    group-id: string,
    /// Provide the id of the file that is to be deleted. To delete multiple files, provide comma separated values for this field.
    file-ids: option<string>
  }
  del-group-vb: func(params: del-group-vb-params) -> result<string, string>;

}

interface devices {
  enum device-create-body-encryption-enum {
    auto,
    yes,
    no,
  }

  enum device-create-body-protocol-enum {
    h-v323,
    sip,
  }

  /// List H.323/SIP devices
  record device-list-params {
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  device-list: func(params: device-list-params) -> result<string, string>;

  /// Create a H.323/SIP device
  record device-create-params {
    /// Device encryption:<br>`auto` - auto.<br>`yes` - yes.<br>`no` - no.
    encryption: device-create-body-encryption-enum,
    /// Device IP.
    ip: string,
    /// Device name.
    name: string,
    /// Device protocol:<br>`H.323` - H.323.<br>`SIP` - SIP.
    protocol: device-create-body-protocol-enum
  }
  device-create: func(params: device-create-params) -> result<string, string>;

  /// Update a H.323/SIP device
  record device-update-params {
    /// The device ID.
    device-id: string,
    /// Device encryption:<br>`auto` - auto.<br>`yes` - yes.<br>`no` - no.
    encryption: device-create-body-encryption-enum,
    /// Device IP.
    ip: string,
    /// Device name.
    name: string,
    /// Device protocol:<br>`H.323` - H.323.<br>`SIP` - SIP.
    protocol: device-create-body-protocol-enum
  }
  device-update: func(params: device-update-params) -> result<string, string>;

  /// Delete a H.323/SIP device
  record device-delete-params {
    /// The device ID.
    device-id: string
  }
  device-delete: func(params: device-delete-params) -> result<string, string>;

}

interface chatbot-messages {
  /// JSON template describing how the message should be displayed for the user. For more information please see our ["Send Message" templates](https://marketplace.zoom.us/docs/guides/chatbots/sending-messages#example-request).
  record sendchatbot-body-content {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// JSON template describing how the edited message should be displayed for the user. For more information please see our ["Send Message" templates](https://marketplace.zoom.us/docs/guides/chatbots/sending-messages#example-request).
  record edit-chatbot-message-body-content {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Send chatbot messages
  record sendchatbot-params {
    /// Account ID of the authorized account.
    account-id: string,
    /// JSON template describing how the message should be displayed for the user. For more information please see our ["Send Message" templates](https://marketplace.zoom.us/docs/guides/chatbots/sending-messages#example-request).
    content: sendchatbot-body-content,
    /// **Optional**<br>
    /// Applies the markdown parser to your chatbot message if the value of this field is set to `true`.<br> To learn more, refer to the Chatbot message [markdown reference](https://marketplace.zoom.us/docs/guides/chatbots/customizing-messages/message-with-markdown).
    is-markdown-support: option<bool>,
    /// Robot JID created when enabling chatbot features on your marketplace app.
    robot-jid: string,
    /// Unique JID of reciever. Can be a group or user.
    to-jid: string,
    /// **Optional**<br>
    /// The UserJID of the user on whose behalf the message is being sent. Use this field to prevent members of a channel from getting notifications that were set up by a user who has left the channel.
    user-jid: option<string>,
    /// **Optional**<br>Allow a Chatbot to send a message to a group channel, but have only one designated person in that group channel see the message by providing the person's UserID in this field.
    visible-to-user: option<string>
  }
  sendchatbot: func(params: sendchatbot-params) -> result<string, string>;

  /// Edit a chatbot message
  record edit-chatbot-message-params {
    /// Unique Identifier of the message that needs to be updated. This should be retrieved from the response of [Send Chatbot Message API](https://marketplace.zoom.us/docs/api-reference/zoom-api/im-chat/sendchatbot).
    message-id: string,
    /// The AccountID of the Zoom account to which the message was sent. Retrieve this from the Chatbot request sent to your server as shown in the example [here]( https://marketplace.zoom.us/docs/guides/chatbots/sending-messages).
    account-id: string,
    /// JSON template describing how the edited message should be displayed for the user. For more information please see our ["Send Message" templates](https://marketplace.zoom.us/docs/guides/chatbots/sending-messages#example-request).
    content: edit-chatbot-message-body-content,
    /// **Optional**<br>
    /// Enable or disable markdown parser to your chatbot message. Applies the markdown parser to your chatbot message if the value of this field is set to `true`.<br> To learn more, refer to the Chatbot message [markdown reference](https://marketplace.zoom.us/docs/guides/chatbots/customizing-messages/message-with-markdown).
    is-markdown-support: option<bool>,
    /// Robot JID created when enabling chatbot features on your marketplace app.
    robot-jid: string,
    /// **Optional**<br>
    /// The UserJID of the user on whose behalf the message is being sent. Use this field to prevent members of a channel from getting notifications that were set up by a user who has left the channel.
    user-jid: option<string>
  }
  edit-chatbot-message: func(params: edit-chatbot-message-params) -> result<string, string>;

  /// Delete a chatbot message
  record delete-a-chatbot-message-params {
    /// The AccountID of the Zoom account to which the message was sent. Retrieve this from the Chatbot request sent to your server as shown in the example [here]( https://marketplace.zoom.us/docs/guides/chatbots/sending-messages).
    account-id: string,
    /// The BotJID found in the Chat Subscription Section on the Features page of your App Dashboard.
    robot-jid: string,
    /// The UserJID of the user on whose behalf the message is being sent. Used to prevent members of a channel from getting notifications that were set up by a user who has left the channel.
    user-jid: option<string>
  }
  delete-a-chatbot-message: func(params: delete-a-chatbot-message-params) -> result<string, string>;

}

interface im-chat {
  /// Get IM chat sessions
  record im-chat-sessions-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  im-chat-sessions: func(params: im-chat-sessions-params) -> result<string, string>;

  /// Get IM chat messages
  record im-chat-messages-params {
    /// IM chat session ID.
    session-id: string,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  im-chat-messages: func(params: im-chat-messages-params) -> result<string, string>;

  /// Send IM messages
  record sendimmessages-params {
    /// The email address (registered with Zoom) or the userId of the chat user.
    chat-user: option<string>,
    /// IM message content.
    message: option<string>
  }
  sendimmessages: func(params: sendimmessages-params) -> result<string, string>;

  /// Get user’s IM messages
  record listimmessages-params {
    /// The user ID or email address.
    user-id: string,
    /// Chat user's ID or email address.
    chat-user: option<string>,
    /// IM Channel's ID.
    channel: option<string>,
    /// IM message's query date time, format as yyyy-MM-dd.
    date: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  listimmessages: func(params: listimmessages-params) -> result<string, string>;

}

interface im-groups {
  enum im-group-create-body-type-op-enum {
    normal,
    shared,
    restricted,
  }

  record im-group-members-create-body-members-item {
    /// User email. If the user ID is given then ignore the user email. 
    email: option<string>,
    /// User ID.
    id: option<string>
  }

  /// List IM directory groups
  im-groups: func() -> result<string, string>;

  /// Create an IM directory group
  record im-group-create-params {
    /// Group name: must be unique to one account.
    name: option<string>,
    /// Members can search for others under same account.
    search-by-account: option<bool>,
    /// Members can search for others in the same email domain.
    search-by-domain: option<bool>,
    /// Members can search for others under same master account, including all sub accounts.
    search-by-ma-account: option<bool>,
    /// IM Group types:<br>`normal` - Only members can see automatically see the other members of this group. Other people can search for members within this group. <br>`shared` - Everyone under an account can see the group members automatically.<br>`restricted` - Nobody can see the group or search for members except the members in the group.
    type-op: option<im-group-create-body-type-op-enum>
  }
  im-group-create: func(params: im-group-create-params) -> result<string, string>;

  /// Retrieve an IM directory group
  record im-group-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string
  }
  im-group: func(params: im-group-params) -> result<string, string>;

  /// Update an IM directory group
  record im-group-update-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string,
    /// Group name: must be unique to one account.
    name: option<string>,
    /// Members can search for others under same account.
    search-by-account: option<bool>,
    /// Members can search for others in the same email domain.
    search-by-domain: option<bool>,
    /// Members can search for others under same master account, including all sub accounts.
    search-by-ma-account: option<bool>,
    /// IM Group types:<br>`normal` - Only group members can automatically see others in their group. Other people can search for members in the group.<br>`shared` - Everyone under the account can see the group and members automatically.<br>`restricted` - Nobody can see the group or search for members except for the members in the group.
    type-op: option<im-group-create-body-type-op-enum>
  }
  im-group-update: func(params: im-group-update-params) -> result<string, string>;

  /// Delete an IM directory group
  record im-group-delete-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string
  }
  im-group-delete: func(params: im-group-delete-params) -> result<string, string>;

  /// List IM directory group members
  record im-group-members-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  im-group-members: func(params: im-group-members-params) -> result<string, string>;

  /// Add IM directory group members
  record im-group-members-create-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string,
    /// List of IM group members.
    members: option<list<im-group-members-create-body-members-item>>
  }
  im-group-members-create: func(params: im-group-members-create-params) -> result<string, string>;

  /// Delete an IM directory group member
  record im-group-members-delete-params {
    /// The group ID.<br>
    /// Can be retrieved by calling [GET /groups](https://marketplace.zoom.us/docs/api-reference/zoom-api/groups/groups).
    group-id: string,
    /// The member ID.
    member-id: string
  }
  im-group-members-delete: func(params: im-group-members-delete-params) -> result<string, string>;

}

interface meetings {
  enum create-batch-polls-body-questions-item-type-op-enum {
    single,
    multiple,
  }

  enum meeting-live-stream-status-update-body-action-enum {
    start,
    stop,
  }

  enum meeting-registrants-status-enum {
    pending,
    approved,
    denied,
  }

  enum meeting-registrant-status-body-action-enum {
    approve,
    cancel,
    deny,
  }

  enum meeting-status-body-action-enum {
    end,
    recover,
  }

  enum meetings-type-op-enum {
    scheduled,
    live,
    upcoming,
  }

  enum meeting-create-body-recurrence-weekly-days-enum {
    v1,
    v2,
    v3,
    v4,
    v5,
    v6,
    v7,
  }

  enum meeting-create-body-settings-approved-or-denied-countries-or-regions-method-enum {
    approve,
    deny,
  }

  enum meeting-create-body-settings-audio-enum {
    both,
    telephony,
    voip,
  }

  enum meeting-create-body-settings-auto-recording-enum {
    local,
    cloud,
    none,
  }

  enum meeting-create-body-settings-encryption-type-enum {
    enhanced-encryption,
    e2ee,
  }

  record create-batch-polls-body-questions-item {
    /// Possible answers for the question.
    answers: option<list<string>>,
    /// Name of the question.
    name: option<string>,
    /// Question type:<br>`single` - Single choice<br>`mutliple` - Multiple choice
    type-op: option<create-batch-polls-body-questions-item-type-op-enum>
  }

  /// Update the settings of a live streaming session. The settings can only be updated for a live stream that has been stopped. You can not update the settings of an ongoing live stream.
  record meeting-live-stream-status-update-body-settings {
    /// Display the name of the active speaker during a live stream.
    active-speaker-name: option<bool>,
    /// Display name of the live stream.
    display-name: option<string>
  }

  record meeting-registrant-status-body-registrants-item {
    email: option<string>,
    id: option<string>
  }

  /// Recurrence object. Use this object only for a meeting with type `8` i.e., a recurring meeting with fixed time. 
  record meeting-create-body-recurrence {
    /// Select the final date on which the meeting will recur before it is canceled. Should be in UTC time, such as 2017-11-25T12:00:00Z. (Cannot be used with "end_times".)
    end-date-time: option<string>,
    /// Select how many times the meeting should recur before it is canceled. (Cannot be used with "end_date_time".)
    end-times: option<s32>,
    /// Use this field **only if you're scheduling a recurring meeting of type** `3` to state which day in a month, the meeting should recur. The value range is from 1 to 31.
    /// 
    monthly-day: option<s32>,
    /// Use this field **only if you're scheduling a recurring meeting of type** `3` to state the week of the month when the meeting should recur. If you use this field, **you must also use the `monthly_week_day` field to state the day of the week when the meeting should recur.** <br>`-1` - Last week of the month.<br>`1` - First week of the month.<br>`2` - Second week of the month.<br>`3` - Third week of the month.<br>`4` - Fourth week of the month.
    monthly-week: option<s32>,
    /// Use this field **only if you're scheduling a recurring meeting of type** `3` to state a specific day in a week when the monthly meeting should recur. To use this field, you must also use the `monthly_week` field. 
    /// 
    monthly-week-day: option<s32>,
    /// Define the interval at which the meeting should recur. For instance, if you would like to schedule a meeting that recurs every two months, you must set the value of this field as `2` and the value of the `type` parameter as `3`. 
    /// 
    repeat-interval: option<s32>,
    /// Recurrence meeting types:<br>`1` - Daily.<br>`2` - Weekly.<br>`3` - Monthly.
    type-op: s32,
    /// This field is required **if you're scheduling a recurring meeting of type** `2` to state which day(s) of the week the meeting should repeat. <br> <br> The value for this field could be a number between `1` to `7` in string format. For instance, if the meeting should recur on Sunday, provide `"1"` as the value of this field.<br><br> **Note:** If you would like the meeting to occur on multiple days of a week, you should provide comma separated values for this field. For instance, if the meeting should recur on Sundays and Tuesdays provide `"1,3"` as the value of this field.
    /// 
    weekly-days: option<meeting-create-body-recurrence-weekly-days-enum>
  }

  /// Meeting settings.
  record meeting-create-body-settings {
    /// Enable additional [data center regions](https://support.zoom.us/hc/en-us/articles/360042411451-Selecting-data-center-regions-for-hosted-meetings-and-webinars) for this meeting. Provide the value in the form of array of country code(s) for the countries which are available as data center regions in the [account settings](https://zoom.us/account/setting) but have been opt out of in the user settings. For instance, let's say that in your account settings, the data center regions that have been selected are Europe, Honkong, Australia, India, Latin America, Japan, China, United States,and Canada. The complete list of available data center regions for your account is: ["EU", "HK", "AU", "IN", "LA", "TY", "CN", "US", "CA"]. In [user settings](https://zoom.us/profile/setting), you have opted out of India(IN) and Japan(TY) for meeting and webinar traffic routing. If you would like, you can still include India and Japan as additional data centers for this meeting using this field. To include India and Japan as additional data center regions, you would provide ["IN", "TY"] as the value.
    additional-data-center-regions: option<list<string>>,
    /// If set to `true`, attendees will be allowed to join a meeting from multiple devices.
    /// 
    allow-multiple-devices: option<bool>,
    /// Alternative host's emails or IDs: multiple values separated by a comma.
    alternative-hosts: option<string>,
    /// Flag to determine whether to send email notifications to alternative hosts, default value is true.
    alternative-hosts-email-notification: option<bool>,
    /// The default value is `2`. To enable registration required, set the approval type to `0` or `1`. Values include:<br>
    /// 
    approval-type: option<s32>,
    /// Approve or block users from specific regions/countries from joining this meeting. 
    approved-or-denied-countries-or-regions: option<meeting-create-body-settings-approved-or-denied-countries-or-regions>,
    /// Determine how participants can join the audio portion of the meeting.<br>`both` - Both Telephony and VoIP.<br>`telephony` - Telephony only.<br>`voip` - VoIP only.
    audio: option<meeting-create-body-settings-audio-enum>,
    /// Meeting authentication domains. This option, allows you to specify the rule so that Zoom users, whose email address contains a certain domain, can join the meeting. You can either provide multiple domains, using a comma in between and/or use a wildcard for listing domains.
    authentication-domains: option<string>,
    /// Specify the authentication type for users to join a meeting with`meeting_authentication` setting set to `true`. The value of this field can be retrieved from the `id` field within `authentication_options` array in the response of [Get User Settings API](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/usersettings).
    authentication-option: option<string>,
    /// Automatic recording:<br>`local` - Record on local.<br>`cloud` -  Record on cloud.<br>`none` - Disabled.
    auto-recording: option<meeting-create-body-settings-auto-recording-enum>,
    /// Setting to [pre-assign breakout rooms](https://support.zoom.us/hc/en-us/articles/360032752671-Pre-assigning-participants-to-breakout-rooms#h_36f71353-4190-48a2-b999-ca129861c1f4).
    breakout-room: option<meeting-create-body-settings-breakout-room>,
    /// Close registration after event date
    close-registration: option<bool>,
    /// Host meeting in China.
    cn-meeting: option<bool>,
    /// Contact email for registration
    contact-email: option<string>,
    /// Contact name for registration
    contact-name: option<string>,
    /// Choose between enhanced encryption and [end-to-end encryption](https://support.zoom.us/hc/en-us/articles/360048660871) when starting or a meeting. When using end-to-end encryption, several features (e.g. cloud recording, phone/SIP/H.323 dial-in) will be **automatically disabled**. <br><br>The value of this field can be one of the following:<br>
    /// `enhanced_encryption`: Enhanced encryption. Encryption is stored in the cloud if you enable this option. <br>
    encryption-type: option<meeting-create-body-settings-encryption-type-enum>,
    /// List of global dial-in countries
    global-dial-in-countries: option<list<string>>,
    /// Start video when the host joins the meeting.
    host-video: option<bool>,
    /// Host meeting in India.
    in-meeting: option<bool>,
    /// If the value of "join_before_host" field is set to true, this field can be used to indicate time limits within which a participant may join a meeting before a host. The value of this field can be one of the following:
    /// 
    jbh-time: option<s32>,
    /// Allow participants to join the meeting before the host starts the meeting. This field can only used for scheduled or recurring meetings.
    /// 
    join-before-host: option<bool>,
    /// Language interpretation [settings](https://support.zoom.us/hc/en-us/articles/360034919791-Language-interpretation-in-meetings-and-webinars#h_01EGGQFD3Q4BST3378SA762MJ1) for meetings. 
    /// 
    language-interpretation: option<meeting-create-body-settings-language-interpretation>,
    /// Only [authenticated](https://support.zoom.us/hc/en-us/articles/360037117472-Authentication-Profiles-for-Meetings-and-Webinars) users can join meeting if the value of this field is set to `true`.
    meeting-authentication: option<bool>,
    /// Mute participants upon entry.
    mute-upon-entry: option<bool>,
    /// Start video when participants join the meeting.
    participant-video: option<bool>,
    /// Send email notifications to registrants about approval, cancellation, denial of the registration. The value of this field must be set to true in order to use the `registrants_confirmation_email` field.
    registrants-email-notification: option<bool>,
    /// Registration type. Used for recurring meeting with fixed time only. <br>`1` Attendees register once and can attend any of the occurrences.<br>`2` Attendees need to register for each occurrence to attend.<br>`3` Attendees register once and can choose one or more occurrences to attend.
    registration-type: option<s32>,
    /// If set to `true`, the registration page for the meeting will include social share buttons.
    /// 
    show-share-button: option<bool>,
    /// Use Personal Meeting ID instead of an automatically generated meeting ID. It can only be used for scheduled meetings, instant meetings and recurring meetings with no fixed time.
    use-pmi: option<bool>,
    /// Enable waiting room. Note that if the value of this field is set to `true`, it will override and disable the `join_before_host` setting.
    waiting-room: option<bool>,
    /// Add watermark when viewing a shared screen.
    watermark: option<bool>
  }

  /// Approve or block users from specific regions/countries from joining this meeting. 
  record meeting-create-body-settings-approved-or-denied-countries-or-regions {
    /// List of countries/regions from where participants can join this meeting. 
    approved-list: option<list<string>>,
    /// List of countries/regions from where participants can not join this meeting. 
    denied-list: option<list<string>>,
    /// `true`: Setting enabled to either allow users or block users from specific regions to join your meetings. <br>
    /// 
    enable: option<bool>,
    /// Specify whether to allow users from specific regions to join this meeting; or block users from specific regions from joining this meeting. <br><br>
    /// `approve`: Allow users from specific regions/countries to join this meeting. If this setting is selected, the approved regions/countries must be included in the `approved_list`.<br><br>
    method: option<meeting-create-body-settings-approved-or-denied-countries-or-regions-method-enum>
  }

  /// Setting to [pre-assign breakout rooms](https://support.zoom.us/hc/en-us/articles/360032752671-Pre-assigning-participants-to-breakout-rooms#h_36f71353-4190-48a2-b999-ca129861c1f4).
  record meeting-create-body-settings-breakout-room {
    /// Set the value of this field to `true` if you would like to enable the [breakout room pre-assign](https://support.zoom.us/hc/en-us/articles/360032752671-Pre-assigning-participants-to-breakout-rooms#h_36f71353-4190-48a2-b999-ca129861c1f4) option.
    enable: option<bool>,
    /// Create room(s).
    rooms: option<list<meeting-create-body-settings-breakout-room-rooms-item>>
  }

  record meeting-create-body-settings-breakout-room-rooms-item {
    /// Name of the breakout room.
    name: option<string>,
    /// Email addresses of the participants who are to be assigned to the breakout room.
    participants: option<list<string>>
  }

  /// Language interpretation [settings](https://support.zoom.us/hc/en-us/articles/360034919791-Language-interpretation-in-meetings-and-webinars#h_01EGGQFD3Q4BST3378SA762MJ1) for meetings. 
  /// 
  /// **Note:** This feature is only available on certain Webinar add-on, Education, Business and higher plans. If this feature is not enabled on the host's account, this setting will not be applied for the meeting.
  record meeting-create-body-settings-language-interpretation {
    /// Indicate whether or not you would like to enable [language interpretation](https://support.zoom.us/hc/en-us/articles/360034919791-Language-interpretation-in-meetings-and-webinars#h_01EGGQFD3Q4BST3378SA762MJ1) for this meeting.
    enable: option<bool>,
    /// Information associated with the interpreter.
    interpreters: option<list<meeting-create-body-settings-language-interpretation-interpreters-item>>
  }

  record meeting-create-body-settings-language-interpretation-interpreters-item {
    /// Email address of the interpreter.
    email: option<string>,
    /// Languages for interpretation. The string must contain two [country Ids](https://marketplace.zoom.us/docs/api-reference/other-references/abbreviation-lists#countries) separated by a comma. 
    /// 
    languages: option<string>
  }

  record meeting-create-body-tracking-fields-item {
    /// Label of the tracking field.
    field: string,
    /// Tracking fields value
    value: option<string>
  }

  /// Use in-Meeting recording controls
  record in-meeting-recording-control-params {
    /// Unique identifier of the live meeting.
    meeting-id: string,
    /// The method that you would like to control. The value of this field can be one of the following:
    /// * `recording.start`: Provide this value if you would like to start the recording.<br><br>
    method: option<string>
  }
  in-meeting-recording-control: func(params: in-meeting-recording-control-params) -> result<string, string>;

  /// Get a meeting
  record meeting-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// Meeting Occurrence ID. Provide this field to view meeting details of a particular occurrence of the [recurring meeting](https://support.zoom.us/hc/en-us/articles/214973206-Scheduling-Recurring-Meetings).
    occurrence-id: option<string>,
    /// Set the value of this field to `true` if you would like to view meeting details of all previous occurrences of a [recurring meeting](https://support.zoom.us/hc/en-us/articles/214973206-Scheduling-Recurring-Meetings). 
    show-previous-occurrences: option<bool>
  }
  meeting: func(params: meeting-params) -> result<string, string>;

  /// Update a meeting
  record meeting-update-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// Meeting occurrence id. Support change of agenda, start_time, duration, settings: {host_video, participant_video, join_before_host, mute_upon_entry, waiting_room, watermark, auto_recording}
    occurrence-id: option<string>,
    body: string
  }
  meeting-update: func(params: meeting-update-params) -> result<string, string>;

  /// Delete a meeting
  record meeting-delete-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// The meeting occurrence ID.
    occurrence-id: option<string>,
    /// `true`: Notify host and alternative host about the meeting cancellation via email.
    /// `false`: Do not send any email notification.
    schedule-for-reminder: option<bool>,
    /// `true`: Notify registrants about the meeting cancellation via email. 
    /// 
    cancel-meeting-reminder: option<string>
  }
  meeting-delete: func(params: meeting-delete-params) -> result<string, string>;

  /// Perform batch poll creation
  record create-batch-polls-params {
    meeting-id: string,
    questions: option<list<create-batch-polls-body-questions-item>>,
    /// Meeting Poll Title.
    title: option<string>
  }
  create-batch-polls: func(params: create-batch-polls-params) -> result<string, string>;

  /// Get meeting invitation
  record meeting-invitation-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string
  }
  meeting-invitation: func(params: meeting-invitation-params) -> result<string, string>;

  /// Get live stream details
  record get-live-stream-details-params {
    /// Unique identifier of the meeting.
    meeting-id: string
  }
  get-live-stream-details: func(params: get-live-stream-details-params) -> result<string, string>;

  /// Update a live stream
  record meeting-live-stream-update-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// The livestream page URL.
    page-url: option<string>,
    /// Stream name and key.
    stream-key: string,
    /// Streaming URL.
    stream-url: string
  }
  meeting-live-stream-update: func(params: meeting-live-stream-update-params) -> result<string, string>;

  /// Update Live Stream Status
  record meeting-live-stream-status-update-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// Update the status of a livestream.
    /// 
    action: option<meeting-live-stream-status-update-body-action-enum>,
    /// Update the settings of a live streaming session. The settings can only be updated for a live stream that has been stopped. You can not update the settings of an ongoing live stream.
    settings: option<meeting-live-stream-status-update-body-settings>
  }
  meeting-live-stream-status-update: func(params: meeting-live-stream-status-update-params) -> result<string, string>;

  /// List meeting polls
  record meeting-polls-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string
  }
  meeting-polls: func(params: meeting-polls-params) -> result<string, string>;

  /// Create a meeting poll
  record meeting-poll-create-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    body: string
  }
  meeting-poll-create: func(params: meeting-poll-create-params) -> result<string, string>;

  /// Get a meeting poll
  record meeting-poll-get-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// The poll ID
    poll-id: string
  }
  meeting-poll-get: func(params: meeting-poll-get-params) -> result<string, string>;

  /// Update a meeting poll
  record meeting-poll-update-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// The poll ID
    poll-id: string,
    body: string
  }
  meeting-poll-update: func(params: meeting-poll-update-params) -> result<string, string>;

  /// Delete a meeting poll
  record meeting-poll-delete-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// The poll ID
    poll-id: string
  }
  meeting-poll-delete: func(params: meeting-poll-delete-params) -> result<string, string>;

  /// List meeting registrants
  record meeting-registrants-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// The meeting occurrence ID.
    occurrence-id: option<string>,
    /// The registrant status:<br>`pending` - Registrant's status is pending.<br>`approved` - Registrant's status is approved.<br>`denied` - Registrant's status is denied.
    status: option<meeting-registrants-status-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  meeting-registrants: func(params: meeting-registrants-params) -> result<string, string>;

  /// Add meeting registrant
  record meeting-registrant-create-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// Occurrence IDs. You can find these with the meeting get API. Multiple values separated by comma.
    occurrence-ids: option<string>,
    body: string
  }
  meeting-registrant-create: func(params: meeting-registrant-create-params) -> result<string, string>;

  /// List registration questions 
  record meeting-registrants-questions-get-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string
  }
  meeting-registrants-questions-get: func(params: meeting-registrants-questions-get-params) -> result<string, string>;

  /// Update registration questions
  record meeting-registrant-question-update-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    body: string
  }
  meeting-registrant-question-update: func(params: meeting-registrant-question-update-params) -> result<string, string>;

  /// Update registrant's status
  record meeting-registrant-status-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// The meeting occurrence ID.
    occurrence-id: option<string>,
    /// Registrant Status:<br>`approve` - Approve registrant.<br>`cancel` - Cancel previously approved registrant's registration.<br>`deny` - Deny registrant.
    action: meeting-registrant-status-body-action-enum,
    /// List of registrants.
    registrants: option<list<meeting-registrant-status-body-registrants-item>>
  }
  meeting-registrant-status: func(params: meeting-registrant-status-params) -> result<string, string>;

  /// Delete a meeting registrant
  record meetingregistrantdelete-params {
    /// The meeting occurence ID.
    occurrence-id: option<string>,
    /// The meeting ID.
    meeting-id: string,
    /// The meeting registrant ID.
    registrant-id: string
  }
  meetingregistrantdelete: func(params: meetingregistrantdelete-params) -> result<string, string>;

  /// Update meeting status
  record meeting-status-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string,
    /// `end` - End a meeting.<br>
    /// `recover` - [Recover](https://support.zoom.us/hc/en-us/articles/360038297111-Recover-a-deleted-meeting) a deleted meeting.
    action: option<meeting-status-body-action-enum>
  }
  meeting-status: func(params: meeting-status-params) -> result<string, string>;

  /// List ended meeting instances
  record past-meetings-params {
    /// The meeting ID in **long** format. The data type of this field is "long"(represented as int64 in JSON).
    /// 
    meeting-id: string
  }
  past-meetings: func(params: past-meetings-params) -> result<string, string>;

  /// List past meeting's poll results
  record list-past-meeting-polls-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string
  }
  list-past-meeting-polls: func(params: list-past-meeting-polls-params) -> result<string, string>;

  /// Get past meeting details
  record past-meeting-details-params {
    /// The meeting UUID. Each meeting instance will generate its own Meeting UUID (i.e., after a meeting ends, a new UUID will be generated for the next instance of the meeting). Please double encode your UUID when using it for other API calls if the UUID begins with a '/'or contains '//' in it.
    meeting-uuid: string
  }
  past-meeting-details: func(params: past-meeting-details-params) -> result<string, string>;

  /// Get past meeting participants
  record past-meeting-participants-params {
    /// The meeting UUID. Each meeting instance will generate its own Meeting UUID (i.e., after a meeting ends, a new UUID will be generated for the next instance of the meeting). Please double encode your UUID when using it for other API calls if the UUID begins with a '/'or contains '//' in it.
    meeting-uuid: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  past-meeting-participants: func(params: past-meeting-participants-params) -> result<string, string>;

  /// List meeting templates
  record list-meeting-templates-params {
    /// Unique identifier of the user. Retrieve the value of this field by calling the [List users](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/users) API.
    user-id: string
  }
  list-meeting-templates: func(params: list-meeting-templates-params) -> result<string, string>;

  /// List meetings
  record meetings-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// The meeting types: <br>`scheduled` - This includes all valid past meetings (unexpired), live meetings and upcoming scheduled meetings. It is equivalent to the combined list of "Previous Meetings" and "Upcoming Meetings" displayed in the user's [Meetings page](https://zoom.us/meeting) on the Zoom Web Portal.<br>`live` - All the ongoing meetings.<br>`upcoming` - All upcoming meetings including live meetings.
    type-op: option<meetings-type-op-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The page number of the current page in the returned records.
    page-number: option<string>
  }
  meetings: func(params: meetings-params) -> result<string, string>;

  /// Create a meeting
  record meeting-create-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// Meeting description.
    agenda: option<string>,
    /// Meeting duration (minutes). Used for scheduled meetings only.
    duration: option<s32>,
    /// Passcode to join the meeting. By default, passcode may only contain the following characters: [a-z A-Z 0-9 @ - _ *] and can have a maximum of 10 characters.
    /// 
    password: option<string>,
    /// Recurrence object. Use this object only for a meeting with type `8` i.e., a recurring meeting with fixed time. 
    recurrence: option<meeting-create-body-recurrence>,
    /// If you would like to schedule this meeting for someone else in your account, provide the Zoom user id or email address of the user here.
    schedule-for: option<string>,
    /// Meeting settings.
    settings: option<meeting-create-body-settings>,
    /// Meeting start time. We support two formats for `start_time` - local time and GMT.<br> 
    /// 
    start-time: option<string>,
    /// Unique identifier of the **admin meeting template**. To create admin meeting templates, contact the Zoom support team.
    /// 
    template-id: option<string>,
    /// Time zone to format start_time. For example, "America/Los_Angeles". For scheduled meetings only. Please reference our [time zone](https://marketplace.zoom.us/docs/api-reference/other-references/abbreviation-lists#timezones) list for supported time zones and their formats.
    timezone: option<string>,
    /// Meeting topic.
    topic: option<string>,
    /// Tracking fields
    tracking-fields: option<list<meeting-create-body-tracking-fields-item>>,
    /// Meeting Type:<br>`1` - Instant meeting.<br>`2` - Scheduled meeting.<br>`3` - Recurring meeting with no fixed time.<br>`8` - Recurring meeting with fixed time.
    type-op: option<s32>
  }
  meeting-create: func(params: meeting-create-params) -> result<string, string>;

}

interface dashboards {
  enum dashboard-meetings-type-op-enum {
    past,
    past-one,
    live,
  }

  enum dashboard-meetings-include-fields-enum {
    tracking-fields,
  }

  enum dashboard-meeting-participants-include-fields-enum {
    registrant-id,
  }

  enum dashboard-webinars-type-op-enum {
    past,
    live,
  }

  /// List Zoom meetings client feedback
  record dashboard-client-feedback-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string
  }
  dashboard-client-feedback: func(params: dashboard-client-feedback-params) -> result<string, string>;

  /// Get zoom meetings client feedback
  record dashboard-client-feedback-detail-params {
    /// Feedback Detail Id
    feedback-id: string,
    from-op: option<string>,
    to: option<string>,
    page-size: option<s32>,
    next-page-token: option<string>
  }
  dashboard-client-feedback-detail: func(params: dashboard-client-feedback-detail-params) -> result<string, string>;

  /// List client meeting satisfaction
  record list-meeting-satisfaction-params {
    /// The start date for the query in “yyyy-mm-dd” format. 
    from-op: option<string>,
    /// The end date for the query in “yyyy-mm-dd” format. 
    to: option<string>
  }
  list-meeting-satisfaction: func(params: list-meeting-satisfaction-params) -> result<string, string>;

  /// Get CRC port usage
  record dashboard-crc-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string
  }
  dashboard-crc: func(params: dashboard-crc-params) -> result<string, string>;

  /// Get IM metrics
  record dashboard-im-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-im: func(params: dashboard-im-params) -> result<string, string>;

  /// Get top 25 Zoom Rooms with issues
  record dashboard-issue-zoom-room-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string
  }
  dashboard-issue-zoom-room: func(params: dashboard-issue-zoom-room-params) -> result<string, string>;

  /// Get issues of Zoom Rooms
  record dashboard-issue-detail-zoom-room-params {
    /// The Zoom room ID.
    zoomroom-id: string,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-issue-detail-zoom-room: func(params: dashboard-issue-detail-zoom-room-params) -> result<string, string>;

  /// List meetings
  record dashboard-meetings-params {
    /// Specify a value to get the response for the corresponding meeting type. The value of this field can be one of the following:<br> <br>`past` - Meeting that already occurred in the specified date range.<br>`pastOne` - Past meetings that were attended by only one user. <br>`live` - Live meetings.<br><br>
    /// 
    type-op: option<dashboard-meetings-type-op-enum>,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Set the value of this field to "tracking_fields" if you would like to include tracking fields of each meeting in the response.
    include-fields: option<dashboard-meetings-include-fields-enum>
  }
  dashboard-meetings: func(params: dashboard-meetings-params) -> result<string, string>;

  /// Get meeting details
  record dashboard-meeting-detail-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string,
    /// The meeting types: <br>`past` - Past meetings.<br>`pastOne` - Past one user meetings.<br>`live` - Live meetings.
    type-op: option<dashboard-meetings-type-op-enum>
  }
  dashboard-meeting-detail: func(params: dashboard-meeting-detail-params) -> result<string, string>;

  /// List meeting participants
  record dashboard-meeting-participants-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string,
    /// The meeting types: <br>`past` - Past meetings.<br>`pastOne` - Past one user meetings.<br>`live` - Live meetings.
    type-op: option<dashboard-meetings-type-op-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Provide `registrant_id` as the value for this field if you would like to see the registrant ID attribute in the response of this API call. A registrant ID is a unique identifier of a [meeting registrant](https://marketplace.zoom.us/docs/api-reference/zoom-api/meetings/meetingregistrants). This is not supported for `live` meeting types.
    include-fields: option<dashboard-meeting-participants-include-fields-enum>
  }
  dashboard-meeting-participants: func(params: dashboard-meeting-participants-params) -> result<string, string>;

  /// List meeting participants QoS
  record dashboard-meeting-participants-qos-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string,
    /// The meeting types: <br>`past` - Past meetings.<br>`live` - Live Meetings.
    type-op: option<dashboard-meetings-type-op-enum>,
    /// The number of items returned per page.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-meeting-participants-qos: func(params: dashboard-meeting-participants-qos-params) -> result<string, string>;

  /// Get post meeting feedback
  record participant-feedback-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string,
    /// Specify a value to get the response for the corresponding meeting type. The value of this field can be one of the following:<br> <br>`past` - Meeting that already occurred in the specified date range.<br>`pastOne` - Past meetings that were attended by only one user. <br>`live` - Live meetings.<br><br>
    /// 
    type-op: option<dashboard-meetings-type-op-enum>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>
  }
  participant-feedback: func(params: participant-feedback-params) -> result<string, string>;

  /// Get sharing/recording details
  record dashboard-meeting-participant-share-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string,
    /// The meeting types: <br>`past` - Past meetings.<br>`live` - Live Meetings.
    type-op: option<dashboard-meetings-type-op-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceed the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-meeting-participant-share: func(params: dashboard-meeting-participant-share-params) -> result<string, string>;

  /// Get meeting participant QoS
  record dashboard-meeting-participant-qos-params {
    /// The meeting ID or the meeting UUID.  If a meeting ID is provided in the request instead of a UUID, the response will be for the latest meeting instance.
    /// 
    meeting-id: string,
    /// Participant ID.
    participant-id: string,
    /// The meeting types: <br>`past` - Past meetings.<br>`live` - Live Meetings.
    type-op: option<dashboard-meetings-type-op-enum>
  }
  dashboard-meeting-participant-qos: func(params: dashboard-meeting-participant-qos-params) -> result<string, string>;

  /// List webinars
  record dashboard-webinars-params {
    /// The webinar type.
    type-op: option<dashboard-webinars-type-op-enum>,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-webinars: func(params: dashboard-webinars-params) -> result<string, string>;

  /// Get webinar details
  record dashboard-webinar-detail-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string,
    /// The webinar type.
    type-op: option<dashboard-webinars-type-op-enum>
  }
  dashboard-webinar-detail: func(params: dashboard-webinar-detail-params) -> result<string, string>;

  /// Get webinar participants
  record dashboard-webinar-participants-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string,
    /// The webinar type.
    type-op: option<dashboard-webinars-type-op-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Provide 'registrant_id' as the value for this field if you would like to see the registrant ID attribute in the response of this API call. A registrant ID is a unique identifier of a [webinar registrant](https://marketplace.zoom.us/docs/api-reference/zoom-api/webinars/webinarregistrants).<br>
    /// 
    include-fields: option<dashboard-meeting-participants-include-fields-enum>
  }
  dashboard-webinar-participants: func(params: dashboard-webinar-participants-params) -> result<string, string>;

  /// List webinar participant QoS
  record dashboard-webinar-participants-qos-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string,
    /// The webinar type.
    type-op: option<dashboard-webinars-type-op-enum>,
    /// The number of items returned per page.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-webinar-participants-qos: func(params: dashboard-webinar-participants-qos-params) -> result<string, string>;

  /// Get post webinar feedback
  record participant-webinar-feedback-params {
    /// Specify a value to get the response for the corresponding meeting type. The value of this field can be one of the following:<br> <br>`past` - Meeting that already occurred in the specified date range.<br>`pastOne` - Past meetings that were attended by only one user. <br>`live` - Live meetings.<br><br>
    /// 
    type-op: option<dashboard-meetings-type-op-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string
  }
  participant-webinar-feedback: func(params: participant-webinar-feedback-params) -> result<string, string>;

  /// Get sharing/recording details
  record dashboard-webinar-participant-share-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string,
    /// The webinar type.
    type-op: option<dashboard-webinars-type-op-enum>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceed the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-webinar-participant-share: func(params: dashboard-webinar-participant-share-params) -> result<string, string>;

  /// Get webinar participant QoS
  record dashboard-webinar-participant-qos-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string,
    /// Participant ID.
    participant-id: string,
    /// The webinar type.
    type-op: option<dashboard-webinars-type-op-enum>
  }
  dashboard-webinar-participant-qos: func(params: dashboard-webinar-participant-qos-params) -> result<string, string>;

  /// List Zoom Rooms
  record dashboard-zoom-rooms-params {
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The page number of the current page in the returned records.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-zoom-rooms: func(params: dashboard-zoom-rooms-params) -> result<string, string>;

  /// Get top 25 issues of Zoom Rooms
  record dashboard-zoom-room-issue-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string
  }
  dashboard-zoom-room-issue: func(params: dashboard-zoom-room-issue-params) -> result<string, string>;

  /// Get Zoom Rooms details
  record dashboard-zoom-room-params {
    /// The Zoom room ID.
    zoomroom-id: string,
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report includes only one month worth of data at once.
    from-op: string,
    /// End date.
    to: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  dashboard-zoom-room: func(params: dashboard-zoom-room-params) -> result<string, string>;

  /// List call logs
  record list-call-logs-metrics-params {
    /// Start date for the report in `yyyy-mm-dd` format. Specify a 30 day range using the `from` and `to` parameters as the response provides a maximum of a month worth of data per API request.
    from-op: option<string>,
    /// End date for the report in `yyyy-mm-dd` format.
    to: option<string>,
    /// Unique identifier of the [site](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites). Use this query parameter if you have enabled multiple sites and would like to filter the response of this API call by call logs of a specific phone site.
    site-id: option<string>,
    /// Filter call logs by voice quality. Zoom uses MOS of 3.5 as a general baseline to categorize calls by call quality. A MOS greater than or equal to 3.5 means good quality, while below 3.5 means poor quality. <br><br>The value of this field can be one of the following:<br>
    /// * `good`: Retrieve call logs of the call(s) with good quality of voice.<br>
    quality-type: option<string>,
    /// The number of records returned within a single call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-call-logs-metrics: func(params: list-call-logs-metrics-params) -> result<string, string>;

  /// Get call QoS
  record get-call-qo-s-params {
    /// Unique identifier of the call.
    call-id: string
  }
  get-call-qo-s: func(params: get-call-qo-s-params) -> result<string, string>;

  /// Get call details from call log
  record get-call-log-metrics-details-params {
    /// Unique identifier of the phone call. The value of this field can be retrieved from [List Call Logs]() API.
    call-id: string
  }
  get-call-log-metrics-details: func(params: get-call-log-metrics-details-params) -> result<string, string>;

}

interface deprecated-api-endpoints {
  /// List past meeting's files
  record list-past-meeting-files-params {
