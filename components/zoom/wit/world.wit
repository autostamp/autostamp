    /// 
    meeting-id: string
  }
  list-past-meeting-files: func(params: list-past-meeting-files-params) -> result<string, string>;

  /// List past webinar files
  record list-past-webinar-files-params {
    webinar-id: string
  }
  list-past-webinar-files: func(params: list-past-webinar-files-params) -> result<string, string>;

}

interface webinars {
  enum webinar-registrants-status-enum {
    pending,
    approved,
    denied,
  }

  enum webinar-registrant-status-body-action-enum {
    approve,
    cancel,
    deny,
  }

  enum webinar-status-body-action-enum {
    end,
  }

  record add-batch-webinar-registrants-body-registrants-item {
    /// Email address of the registrant.
    email: string,
    /// First name of the registrant.
    first-name: string,
    /// Last name of the registrant.
    last-name: option<string>
  }

  record webinar-registrant-status-body-registrants-item {
    /// Registrant's email address.
    email: option<string>,
    /// Registrant ID
    id: option<string>
  }

  /// Get webinar absentees
  record webinar-absentees-params {
    /// The meeting occurrence ID.
    occurrence-id: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The Webinar UUID. Each Webinar instance will generate its own Webinar UUID (i.e., after a Webinar ends, a new UUID will be generated for the next instance of the Webinar). Please double encode your UUID when using it for API calls if the UUID begins with a '/' or contains '//' in it.
    webinar-uuid: string
  }
  webinar-absentees: func(params: webinar-absentees-params) -> result<string, string>;

  /// List past webinar instances
  record past-webinars-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string
  }
  past-webinars: func(params: past-webinars-params) -> result<string, string>;

  /// List webinar participants
  record list-webinar-participants-params {
    /// Unique identifier of the webinar. You can retrieve the value of this field by calling the [list webinars](https://marketplace.zoom.us/docs/api-reference/zoom-api/webinars/webinars) API.
    webinar-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-webinar-participants: func(params: list-webinar-participants-params) -> result<string, string>;

  /// List past webinar poll results
  record list-past-webinar-poll-results-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string
  }
  list-past-webinar-poll-results: func(params: list-past-webinar-poll-results-params) -> result<string, string>;

  /// List Q&A of past webinar
  record list-past-webinar-qa-params {
    /// The webinar ID or the webinar UUID.  If a webinar ID is provided in the request instead of a UUID, the response will be for the latest webinar instance.
    /// 
    webinar-id: string
  }
  list-past-webinar-qa: func(params: list-past-webinar-qa-params) -> result<string, string>;

  /// List webinar templates
  list-webinar-templates: func() -> result<string, string>;

  /// List webinars
  record webinars-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>
  }
  webinars: func(params: webinars-params) -> result<string, string>;

  /// Create a webinar
  record webinar-create-params {
    /// The user ID or email address of the user. For user-level apps, pass `me` as the value for userId.
    user-id: string,
    body: string
  }
  webinar-create: func(params: webinar-create-params) -> result<string, string>;

  /// Get a webinar
  record webinar-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// Unique Identifier that identifies an occurrence of a recurring webinar. [Recurring webinars](https://support.zoom.us/hc/en-us/articles/216354763-How-to-Schedule-A-Recurring-Webinar) can have a maximum of 50 occurrences. When you create a recurring Webinar using [Create a Webinar API](https://marketplace.zoom.us/docs/api-reference/zoom-api/webinars/webinarcreate), you can retrieve the Occurrence ID from the response of the API call.
    occurrence-id: option<string>,
    /// Set the value of this field to `true` if you would like to view Webinar details of all previous occurrences of a recurring Webinar.
    show-previous-occurrences: option<bool>
  }
  webinar: func(params: webinar-params) -> result<string, string>;

  /// Update a webinar
  record webinar-update-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// Webinar occurrence id. Support change of agenda, start_time, duration, settings: {host_video, panelist_video, hd_video, watermark, auto_recording}
    occurrence-id: option<string>,
    body: string
  }
  webinar-update: func(params: webinar-update-params) -> result<string, string>;

  /// Delete a webinar
  record webinar-delete-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// The meeting occurrence ID.
    occurrence-id: option<string>,
    /// `true`: Notify panelists and registrants about the webinar cancellation via email. 
    /// 
    cancel-webinar-reminder: option<string>
  }
  webinar-delete: func(params: webinar-delete-params) -> result<string, string>;

  /// Perform batch registration
  record add-batch-webinar-registrants-params {
    /// Unique identifier of the webinar.
    webinar-id: string,
    /// If a meeting was scheduled with approval_type `1` (manual approval), but you would like to automatically approve the registrants that are added via this API, you can set the value of this field to `true`. 
    /// 
    auto-approve: option<bool>,
    registrants: option<list<add-batch-webinar-registrants-body-registrants-item>>
  }
  add-batch-webinar-registrants: func(params: add-batch-webinar-registrants-params) -> result<string, string>;

  /// List panelists
  record webinar-panelists-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string
  }
  webinar-panelists: func(params: webinar-panelists-params) -> result<string, string>;

  /// Add panelists
  record webinar-panelist-create-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// List of panelist objects.
    panelists: option<list<string>>
  }
  webinar-panelist-create: func(params: webinar-panelist-create-params) -> result<string, string>;

  /// Remove panelists
  record webinar-panelists-delete-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string
  }
  webinar-panelists-delete: func(params: webinar-panelists-delete-params) -> result<string, string>;

  /// Remove a panelist
  record webinar-panelist-delete-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// The panelist ID or panelist email.
    panelist-id: string
  }
  webinar-panelist-delete: func(params: webinar-panelist-delete-params) -> result<string, string>;

  /// List a webinar's polls 
  record webinar-polls-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string
  }
  webinar-polls: func(params: webinar-polls-params) -> result<string, string>;

  /// Create a webinar's poll
  record webinar-poll-create-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    body: string
  }
  webinar-poll-create: func(params: webinar-poll-create-params) -> result<string, string>;

  /// Get a webinar poll
  record webinar-poll-get-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// The poll ID
    poll-id: string
  }
  webinar-poll-get: func(params: webinar-poll-get-params) -> result<string, string>;

  /// Update a webinar poll
  record webinar-poll-update-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// The poll ID
    poll-id: string,
    body: string
  }
  webinar-poll-update: func(params: webinar-poll-update-params) -> result<string, string>;

  /// Delete a webinar poll
  record webinar-poll-delete-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// The poll ID
    poll-id: string
  }
  webinar-poll-delete: func(params: webinar-poll-delete-params) -> result<string, string>;

  /// List webinar registrants
  record webinar-registrants-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// The meeting occurrence ID.
    occurrence-id: option<string>,
    /// The registrant status:<br>`pending` - Registrant's status is pending.<br>`approved` - Registrant's status is approved.<br>`denied` - Registrant's status is denied.
    status: option<webinar-registrants-status-enum>,
    /// The tracking source ID for the registrants. Useful if you share the webinar registration page in multiple locations. See [Creating source tracking links for webinar registration](https://support.zoom.us/hc/en-us/articles/360000315683-Creating-source-tracking-links-for-webinar-registration) for details.
    tracking-source-id: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// 
    /// **Deprecated** - This field has been deprecated and we will stop supporting it completely in a future release. Please use "next_page_token" for pagination instead of this field.
    page-number: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  webinar-registrants: func(params: webinar-registrants-params) -> result<string, string>;

  /// Add a webinar registrant
  record webinar-registrant-create-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// Occurrence ID. Get this value from the webinar get API. Multiple values separated by a comma.
    occurrence-ids: option<string>,
    body: string
  }
  webinar-registrant-create: func(params: webinar-registrant-create-params) -> result<string, string>;

  /// List registration questions
  record webinar-registrants-questions-get-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string
  }
  webinar-registrants-questions-get: func(params: webinar-registrants-questions-get-params) -> result<string, string>;

  /// Update registration questions
  record webinar-registrant-question-update-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    body: string
  }
  webinar-registrant-question-update: func(params: webinar-registrant-question-update-params) -> result<string, string>;

  /// Update registrant's status
  record webinar-registrant-status-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// The meeting occurrence ID.
    occurrence-id: option<string>,
    /// Used to approve a registrant, deny a registrant, or cancel a previously approved registrant. 
    action: webinar-registrant-status-body-action-enum,
    /// List of registrants.
    registrants: option<list<webinar-registrant-status-body-registrants-item>>
  }
  webinar-registrant-status: func(params: webinar-registrant-status-params) -> result<string, string>;

  /// Get a webinar registrant
  record webinar-registrant-get-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    /// The registrant ID.
    registrant-id: string,
    /// The meeting occurrence ID.
    occurrence-id: option<string>
  }
  webinar-registrant-get: func(params: webinar-registrant-get-params) -> result<string, string>;

  /// Delete a webinar registrant
  record delete-webinar-registrant-params {
    /// The webinar ID.
    webinar-id: string,
    /// The registrant ID.
    registrant-id: string,
    /// The webinar occurence ID.
    occurrence-id: option<string>
  }
  delete-webinar-registrant: func(params: delete-webinar-registrant-params) -> result<string, string>;

  /// Update webinar status
  record webinar-status-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string,
    action: option<webinar-status-body-action-enum>
  }
  webinar-status: func(params: webinar-status-params) -> result<string, string>;

  /// Get webinar tracking sources
  record get-tracking-sources-params {
    /// The webinar ID in "**long**" format(represented as int64 data type in JSON). 
    webinar-id: string
  }
  get-tracking-sources: func(params: get-tracking-sources-params) -> result<string, string>;

}

interface phone-auto-receptionists {
  record assign-phone-numbers-auto-receptionist-body-phone-numbers-item {
    /// Unique Identifier of the Phone number.
    id: option<string>,
    /// Phone number in e164 format.
    number: option<string>
  }

  /// Add an auto receptionist
  record add-auto-receptionist-params {
    /// Provide a name to help identify the auto receptionist.
    name: string,
    /// Unique identifier of the site where the auto receptionist is to be assigned. This field is required only if you have [multiple sites](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-Multiple-Sites) enabled.
    site-id: option<string>
  }
  add-auto-receptionist: func(params: add-auto-receptionist-params) -> result<string, string>;

  /// Update auto receptionist details
  record update-auto-receptionist-params {
    /// Unique Identifier of the Auto Receptionist. It can be retrieved from the [List Sites API](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone-site/listphonesites).
    auto-receptionist-id: string,
    /// Extension number to be assigned to the auto receptionist. If site code is enabled, provide the short extension number instead.
    extension-number: option<s32>,
    /// Display name of the auto receptionist.
    name: option<string>
  }
  update-auto-receptionist: func(params: update-auto-receptionist-params) -> result<string, string>;

  /// Assign phone numbers
  record assign-phone-numbers-auto-receptionist-params {
    /// Unique Identifier of the Auto Receptionist. It can be retrieved from the [List Sites API](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone-site/listphonesites).
    auto-receptionist-id: string,
    /// Provide either the unique identifier of the Phone Number  in the `id` field or provide the phone number in the `number` field.
    phone-numbers: option<list<assign-phone-numbers-auto-receptionist-body-phone-numbers-item>>
  }
  assign-phone-numbers-auto-receptionist: func(params: assign-phone-numbers-auto-receptionist-params) -> result<string, string>;

  /// Unassign all phone numbers
  unassign-all-phone-nums-auto-receptionist: func() -> result<string, string>;

  /// Unassign a phone number
  record unassign-a-phone-num-auto-receptionist-params {
    /// Unique identifier of the auto receptionist. This can be retrieved from the List Phone Sites API.
    auto-receptionist-id: string,
    /// Unique Identifier of the phone number or provide the actual phone number in e164 format (example: +19995550123).
    phone-number-id: string
  }
  unassign-a-phone-num-auto-receptionist: func(params: unassign-a-phone-num-auto-receptionist-params) -> result<string, string>;

}

interface phone-blocked-list {
  enum add-anumber-to-blocked-list-body-block-type-enum {
    inbound,
    outbound,
  }

  enum add-anumber-to-blocked-list-body-match-type-enum {
    phone-number,
    prefix,
  }

  enum add-anumber-to-blocked-list-body-status-enum {
    active,
    inactive,
  }

  /// List blocked lists
  record list-blocked-list-params {
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The total number of records returned from a single API call.
    page-size: option<s32>
  }
  list-blocked-list: func(params: list-blocked-list-params) -> result<string, string>;

  /// Create a blocked list
  record add-anumber-to-blocked-list-params {
    /// State whether you want the block type to be inbound or outbound.<br>
    /// `inbound`: Pass this value to prevent the blocked number or prefix from calling in to phone users.<br>
    block-type: option<add-anumber-to-blocked-list-body-block-type-enum>,
    /// Provide a comment to help you identify the blocked number or prefix.
    comment: option<string>,
    /// Specify the match type for the blocked list. The values can be one of the following:<br><br>
    /// `phoneNumber`: Choose this option (Phone Number Match) if you want to block a specific phone number. Then, in the `phone_number` field, provide the phone number along with the country code.<br><br>
    match-type: option<add-anumber-to-blocked-list-body-match-type-enum>,
    /// The phone number to be blocked if you passed "phoneNumber" as the value for the `match_type` field. If you passed "prefix" as the value for the `match_type` field, provide the prefix of the phone number here including the country code. For example, entering 1905 blocks numbers with country code 1 and area code 905. 
    phone-number: option<string>,
    /// Enable or disable the blocking. One of the following values are allowed:<br>
    /// `active`: Keep the blocking active.<br>
    status: option<add-anumber-to-blocked-list-body-status-enum>
  }
  add-anumber-to-blocked-list: func(params: add-anumber-to-blocked-list-params) -> result<string, string>;

  /// Get blocked list details
  record get-a-blocked-list-params {
    /// Unique Identifier of the blocked list.
    blocked-list-id: string
  }
  get-a-blocked-list: func(params: get-a-blocked-list-params) -> result<string, string>;

  /// Update a blocked list
  record update-blocked-list-params {
    /// Unique Identifier of the blocked list.
    blocked-list-id: string,
    /// State whether you want the block type to be inbound or outbound.<br>
    /// `inbound`: Pass this value to prevent the blocked number or prefix from calling in to phone users.<br>
    block-type: option<add-anumber-to-blocked-list-body-block-type-enum>,
    /// Provide a comment to help you identify the blocked number or prefix.
    comment: option<string>,
    /// Specify the match type for the blocked list. The values can be one of the following:<br><br>
    /// `phoneNumber`: Choose this option (Phone Number Match) if you want to block a specific phone number. Then, in the `phone_number` field, provide the phone number along with the country code.<br><br>
    match-type: option<add-anumber-to-blocked-list-body-match-type-enum>,
    /// The phone number to be blocked if you passed "phoneNumber" as the value for the `match_type` field. If you passed "prefix" as the value for the `match_type` field, provide the prefix of the phone number here including the country code. For example, entering 1905 blocks numbers with country code 1 and area code 905. 
    phone-number: option<string>,
    /// Enable or disable the blocking. One of the following values are allowed:<br>
    /// `active`: Keep the blocking active.<br>
    status: option<add-anumber-to-blocked-list-body-status-enum>
  }
  update-blocked-list: func(params: update-blocked-list-params) -> result<string, string>;

  /// Delete a blocked list
  record delete-a-blocked-list-params {
    /// Unique Identifier of the blocked list. This can be retrieved from the List Blocked List API.
    blocked-list-id: string
  }
  delete-a-blocked-list: func(params: delete-a-blocked-list-params) -> result<string, string>;

}

interface phone-call-queues {
  enum update-call-queue-body-status-enum {
    active,
    inactive,
  }

  /// A list of one or more phone users to be included in the call queue. Provide either users or common area phone(s). Provide at least one user in the users object.
  record create-call-queue-body-members {
    /// **Optional**<br>
    /// Unique identifier of the [Common Area Phone](https://support.zoom.us/hc/en-us/articles/360028516231-Managing-Common-Area-Phones). This can be retrieved from the List Common Area Phones API.
    common-area-phone-ids: option<list<string>>,
    /// Users object. Provide either the id (userId) field or the email address of the user.
    users: option<list<create-call-queue-body-members-users-item>>
  }

  record create-call-queue-body-members-users-item {
    /// Email address of the user. This can be retrieved from the [List Users](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/users) API.
    email: option<string>,
    /// User Id of the user. This can be retrieved from the [List Users](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/users) API.
    id: option<string>
  }

  /// A maximum of 10 members can be added at a time.
  record add-members-to-call-queue-body-members {
    /// Array of one or more Common Area Phone Ids of the Common Area Phone(s) that you would like to add to the Call Queue.
    common-area-phone-ids: option<list<string>>,
    users: option<list<add-members-to-call-queue-body-members-users-item>>
  }

  record add-members-to-call-queue-body-members-users-item {
    /// Email address of the user.
    email: option<string>,
    /// User ID: Unique Identifier of the user.
    id: option<string>
  }

  record assign-phone-to-call-queue-body-phone-numbers-item {
    /// Unique Identifier of the phone number.
    id: option<string>,
    /// Phone number.
    number: option<string>
  }

  /// List call queues
  record list-call-queues-params {
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The number of records returned from a single API call.
    page-size: option<s32>
  }
  list-call-queues: func(params: list-call-queues-params) -> result<string, string>;

  /// Create a call queue
  record create-call-queue-params {
    /// Description for the Call Queue.
    description: option<string>,
    /// Phone extension number for the site.<br>
    /// 
    extension-number: option<s32>,
    /// A list of one or more phone users to be included in the call queue. Provide either users or common area phone(s). Provide at least one user in the users object.
    members: option<create-call-queue-body-members>,
    /// Name of the Call Queue.
    name: string,
    /// Unique identifier of the site. Required only if [multiple sites](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-Multiple-Sites) have been enabled. This can be retrieved from the [List Phone Sites](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone-site/listphonesites) API.
    site-id: string
  }
  create-call-queue: func(params: create-call-queue-params) -> result<string, string>;

  /// Get call queue details
  record get-a-call-queue-params {
    /// Unique Identifier of the Call Queue. This can be retrieved from [List Call Queues API](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone-call-queues/listcallqueues).
    call-queue-id: string
  }
  get-a-call-queue: func(params: get-a-call-queue-params) -> result<string, string>;

  /// Update call queue details
  record update-call-queue-params {
    /// Unique Identifier of the Call Queue.
    call-queue-id: string,
    /// Description for the Call Queue.
    description: option<string>,
    /// Phone extension number for the site.<br>
    /// 
    extension-number: option<s32>,
    /// Name of the Call Queue.
    name: option<string>,
    /// Unique identifier of the [site](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-Multiple-Sites) where the Call Queue is assigned.
    site-id: option<string>,
    /// Status of the Call Queue. Allowed values:<br>
    /// `active`<br>
    status: option<update-call-queue-body-status-enum>,
    /// [Timezone](https://marketplace.zoom.us/docs/api-reference/other-references/abbreviation-lists#timezones) of the Call Queue.
    timezone: option<string>
  }
  update-call-queue: func(params: update-call-queue-params) -> result<string, string>;

  /// Delete a call queue
  record delete-a-call-queue-params {
    /// Unique Identifier of the call queue.
    call-queue-id: string
  }
  delete-a-call-queue: func(params: delete-a-call-queue-params) -> result<string, string>;

  /// Change call queue manager
  record change-call-queue-manager-params {
    /// Unique Identifier of the Call Queue.
    call-queue-id: string,
    /// Unique Identifier (userId) or email address of the user who will be the new call queue manager.
    member-id: option<string>
  }
  change-call-queue-manager: func(params: change-call-queue-manager-params) -> result<string, string>;

  /// Add members to a call queue
  record add-members-to-call-queue-params {
    /// Unique Identifier of the Call Queue.
    call-queue-id: string,
    /// A maximum of 10 members can be added at a time.
    members: option<add-members-to-call-queue-body-members>
  }
  add-members-to-call-queue: func(params: add-members-to-call-queue-params) -> result<string, string>;

  /// Unassign all members
  record unassign-all-members-params {
    call-queue-id: string
  }
  unassign-all-members: func(params: unassign-all-members-params) -> result<string, string>;

  /// Unassign a member
  record unassign-member-from-call-queue-params {
    /// Unique Identifier of the Call Queue from which the member needs to be unassigned.
    call-queue-id: string,
    /// Unique Identifier of the member who needs to be unassigned.
    member-id: string
  }
  unassign-member-from-call-queue: func(params: unassign-member-from-call-queue-params) -> result<string, string>;

  /// Assign numbers to a call queue
  record assign-phone-to-call-queue-params {
    /// Unique Identifier of the Call Queue.
    call-queue-id: string,
    /// Provide either the `id` or the `number` field. Only a max of 5 numbers can be assigned to a call queue at a time.
    phone-numbers: option<list<assign-phone-to-call-queue-body-phone-numbers-item>>
  }
  assign-phone-to-call-queue: func(params: assign-phone-to-call-queue-params) -> result<string, string>;

  /// Unassign all phone numbers
  record unassign-a-phone-num-call-queue-params {
    /// Unique Identifier of the Call Queue. This can be retrieved from List Call Queues API.
    call-queue-id: string
  }
  unassign-a-phone-num-call-queue: func(params: unassign-a-phone-num-call-queue-params) -> result<string, string>;

  /// Unassign a phone number
  record un-assign-phone-num-call-queue-params {
    /// Unique Identifier of the Call Queue. This can be retrieved from the List Call Queues API.
    call-queue-id: string,
    /// Unique Identifier of the Phone Number. 
    phone-number-id: string
  }
  un-assign-phone-num-call-queue: func(params: un-assign-phone-num-call-queue-params) -> result<string, string>;

  /// Get call queue recordings
  record get-call-queue-recordings-params {
    /// Unique Identifier of the Call Queue.
    call-queue-id: string,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// Start date (within a 6 month range).
    from-op: option<string>,
    /// End date (within a 6 month range).
    to: option<string>
  }
  get-call-queue-recordings: func(params: get-call-queue-recordings-params) -> result<string, string>;

}

interface common-area-phones {
  /// List common area phones
  record list-common-area-phones-params {
    /// The total number of records returned from a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-common-area-phones: func(params: list-common-area-phones-params) -> result<string, string>;

  /// Add a common area phone
  record add-common-area-phone-params {
    /// Description for the common area phone.
    description: option<string>,
    /// Display name of the Common area phone.
    display-name: string,
    /// Extension number assigned to the common area phone. If site code is enabled, provide the short extension number instead.
    extension-number: s32,
    /// Mac Address (serial number) of the common area desk phone. These examples show the formats supported: `64-16-7f-37-90-92` or `64167f379092`
    mac-address: string,
    /// Device Model name. Refer to the "Model Name" field in [this](https://marketplace.zoom.us/docs/api-reference/other-references/zoomphone-supporteddevice) table.
    model: option<string>,
    /// Unique identifier of the [site](https://support.zoom.us/hc/en-us/articles/360020809672). This can be retrieved from the [List Phone Sites](https://marketplace.zoom.us/docs/api-reference/zoom-api/phone-site/listphonesites) API.
    site-id: option<string>,
    /// [Timezone ID](https://marketplace.zoom.us/docs/api-reference/other-references/abbreviation-lists) for the common area phone.
    time-zone: option<string>,
    /// Phone device manufacturer name. Refer to the "Manufacturer Name" field in [this](https://marketplace.zoom.us/docs/api-reference/other-references/zoomphone-supporteddevice) table.
    type-op: string
  }
  add-common-area-phone: func(params: add-common-area-phone-params) -> result<string, string>;

  /// Get common area phone details
  record get-a-common-area-phone-params {
    /// Unique Identifier of the Common Area Phone. Use the unique identifier or the Mac address of the common area phone. The Mac address can be hyphenated (00-04-f2-5e-ec-3c) or not hyphenated (0004f25eec3c). You can retrieved this from the [List Common Area Phones API](https://marketplace.zoom.us/docs/api-reference/zoom-api/common-area-phones/listcommonareaphones).
    common-area-phone-id: string
  }
  get-a-common-area-phone: func(params: get-a-common-area-phone-params) -> result<string, string>;

  /// Update common area phone
  record update-common-area-phone-params {
    /// Display name of the common area phone.
    display-name: option<string>,
    /// Extension number of the phone. If site code is enabled, provide short extension number instead.
    extension-number: option<s32>,
    ///  Mac address or serial number of the device. Examples of supported format: "64-16-7f-37-90-92" or "64167f379092".
    mac-address: option<string>,
    /// Unique identifier of the [site](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-Multiple-Sites) to which the common area desk phone is assigned.
    site-id: option<string>
  }
  update-common-area-phone: func(params: update-common-area-phone-params) -> result<string, string>;

  /// Delete a common area phone
  record delete-common-area-phone-params {
    /// Unique Identifier of the common area phone.
    common-area-phone-id: string
  }
  delete-common-area-phone: func(params: delete-common-area-phone-params) -> result<string, string>;

}

interface phone-devices {
  enum list-phone-devices-type-op-enum {
    assigned,
    unassigned,
  }

  /// List devices
  record list-phone-devices-params {
    /// State of the device. The value should be either `assigned` to list devices that have been assigned to user(s) or `unassigned` to list devices that have not yet been assigned to any user in the Zoom account.
    type-op: list-phone-devices-type-op-enum,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>
  }
  list-phone-devices: func(params: list-phone-devices-params) -> result<string, string>;

  /// Add a device
  record add-phone-device-params {
    /// User ID or email address of the user to whom this device is to be assigned. The User ID and the email of the user can be retrieved using the [List Users](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/users) API.
    assigned-to: option<string>,
    /// Display name of the desk phone.
    display-name: string,
    /// The MAC address of the desk phone.<br> 
    /// Note: If you're using a wireless phone, enter the wired MAC address, not the wireless MAC address.
    mac-address: string,
    /// Model name of the device.
    model: option<string>,
    /// Manufacturer (brand) name of the device.
    type-op: option<string>
  }
  add-phone-device: func(params: add-phone-device-params) -> result<string, string>;

  /// Get device details
  record get-a-device-params {
    /// Unique Identifier of the device.
    device-id: string
  }
  get-a-device: func(params: get-a-device-params) -> result<string, string>;

  /// Update a device
  record update-a-device-params {
    /// Unique Identifier of the Device.
    device-id: string,
    /// User ID or email address of the user to whom this device is to be assigned. The User ID and the email of the user can be retrieved using the [List Users](https://marketplace.zoom.us/docs/api-reference/zoom-api/users/users) API.
    assigned-to: option<string>,
    /// Display name of the desk phone.
    display-name: option<string>,
    /// The MAC address of the desk phone.<br> 
    /// Note: If you're using a wireless phone, enter the wired MAC address, not the wireless MAC address.
    mac-address: option<string>
  }
  update-a-device: func(params: update-a-device-params) -> result<string, string>;

  /// Delete a device
  record delete-a-device-params {
    /// Unique Identifier of the device.
    device-id: string
  }
  delete-a-device: func(params: delete-a-device-params) -> result<string, string>;

}

interface phone-reports {
  /// Get operation logs report
  record get-ps-operation-logs-params {
    /// Start date in 'yyyy-mm-dd' format. The date range defined by the "from" and "to" parameters should only be one month as the report provides only one month worth of data per API request.
    from-op: option<string>,
    /// End date in 'yyyy-mm-dd' format.
    to: option<string>,
    /// Filter the response by the category of the action performed. By default, the value of this field is "all" and thus, the response will include log of all operations for the defined period.<br><br>To only include response for a specific category type, provide a value for `category_type` from this [table](http://marketplace.zoom.us/docs/phone-operation-categories ).
    category-type: option<string>,
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  get-ps-operation-logs: func(params: get-ps-operation-logs-params) -> result<string, string>;

}

interface phone-shared-line-groups {
  enum update-a-shared-line-group-body-status-enum {
    active,
    inactive,
  }

  /// If you have multiple direct phone numbers assigned to the shared line group, select a number from those numbers as the primary number. The primary number shares the same line as the extension number. This means if a caller is routed to the shared line group through an auto receptionist, the line associated with the primary number will be used. A pending number cannot be used as a Primary Number.
  record update-a-shared-line-group-body-primary-number {
    /// Phone Number ID. Unique Identifier of the Phone Number.
    id: option<string>,
    /// Phone Number that you would like to assign as the primary number for this Shared Line Group.
    number: option<string>
  }

  /// Members can comprise of users on the account as well as common area phones. You can add a maximum of 10 members at once.
  record add-members-to-shared-line-group-body-members {
    /// Unique identifier(s) of the Common Area Phone. 
    common-area-phone-ids: option<list<string>>,
    /// Zoom Phone users on the account.
    users: option<list<add-members-to-shared-line-group-body-members-users-item>>
  }

  record add-members-to-shared-line-group-body-members-users-item {
    /// Email address of the user.
    email: option<string>,
    /// Unique identifier of the user.
    id: option<string>
  }

  record assign-phone-numbers-slg-body-phone-numbers-item {
    /// Unique Identifier of the phone number.
    id: option<string>,
    /// Phone number.
    number: option<string>
  }

  /// List shared line groups
  record list-shared-line-groups-params {
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-shared-line-groups: func(params: list-shared-line-groups-params) -> result<string, string>;

  /// Create a shared line group
  record create-a-shared-line-group-params {
    /// Provide a description for the shared line group.
    description: option<string>,
    /// Provide a name to help identify the shared line group.
    display-name: string,
    /// Extension number to be assigned to the shared line group. If a [site code has been assigned](https://support.zoom.us/hc/en-us/articles/360020809672#h_79ca9c8f-c97b-4486-aa59-d0d9d31a525b) to the site, provide the short extension number 
    extension-number: option<s32>,
    /// Unique identifier of the [site](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-multiple-sites) that you would like to use for the shared line group. You will only be able to add members that belong to this site to the shared line group.
    /// 
    site-id: option<string>
  }
  create-a-shared-line-group: func(params: create-a-shared-line-group-params) -> result<string, string>;

  /// Get a shared line group
  record get-a-shared-line-group-params {
    /// Unique Identifier of the Shared Line Group.
    shared-line-group-id: string
  }
  get-a-shared-line-group: func(params: get-a-shared-line-group-params) -> result<string, string>;

  /// Update a shared line group
  record update-a-shared-line-group-params {
    /// Unique identifier of the shared line group that is to be updated.
    shared-line-group-id: string,
    /// Display Name of the Shared Line Group.
    display-name: option<string>,
    /// Extension number assigned to the Shared Line Group.
    extension-number: option<s32>,
    /// If you have multiple direct phone numbers assigned to the shared line group, select a number from those numbers as the primary number. The primary number shares the same line as the extension number. This means if a caller is routed to the shared line group through an auto receptionist, the line associated with the primary number will be used. A pending number cannot be used as a Primary Number.
    primary-number: option<update-a-shared-line-group-body-primary-number>,
    /// Status of the Shared Line Group.
    status: option<update-a-shared-line-group-body-status-enum>,
    /// Timezone to be used for the Business Hours. A value should be provided from the IDs listed [here](https://marketplace.zoom.us/docs/api-reference/other-references/abbreviation-lists#timezones).
    timezone: option<string>
  }
  update-a-shared-line-group: func(params: update-a-shared-line-group-params) -> result<string, string>;

  /// Delete a shared line group
  record delete-a-shared-line-group-params {
    /// Unique Identifier of the shared line group that you would like to delete.
    shared-line-group-id: string
  }
  delete-a-shared-line-group: func(params: delete-a-shared-line-group-params) -> result<string, string>;

  /// Add members to a shared line group
  record add-members-to-shared-line-group-params {
    /// Unique Identifier of the shared line group.
    shared-line-group-id: string,
    /// Members can comprise of users on the account as well as common area phones. You can add a maximum of 10 members at once.
    members: option<add-members-to-shared-line-group-body-members>
  }
  add-members-to-shared-line-group: func(params: add-members-to-shared-line-group-params) -> result<string, string>;

  /// Unassign members of a shared line group
  record delete-members-of-slg-params {
    /// Unique identifier of the Shared Line Group that you would like to delete.
    shared-line-group-id: string
  }
  delete-members-of-slg: func(params: delete-members-of-slg-params) -> result<string, string>;

  /// Unassign a member from a shared line group
  record delete-a-member-slg-params {
    /// Unique Identifier of the shared line group from which you would like to remove a member.
    shared-line-group-id: string,
    /// Unique identifier of the member who is to be removed.
    member-id: string
  }
  delete-a-member-slg: func(params: delete-a-member-slg-params) -> result<string, string>;

  /// Assign phone numbers
  record assign-phone-numbers-slg-params {
    /// Unique Identifier of the Shared Line Group.
    shared-line-group-id: string,
    /// Phone number(s) to be assigned to the Shared Line Group.
    phone-numbers: option<list<assign-phone-numbers-slg-body-phone-numbers-item>>
  }
  assign-phone-numbers-slg: func(params: assign-phone-numbers-slg-params) -> result<string, string>;

  /// Unassign a phone number
  record delete-a-phone-number-slg-params {
    /// Unique identifier of the shared line group from which you would like to unassign a phone number.
    shared-line-group-id: string,
    /// Unique identifier of the phone number which is to be unassigned. This can be retrieved from Get a Shared Line Group API.
    phone-number-id: string
  }
  delete-a-phone-number-slg: func(params: delete-a-phone-number-slg-params) -> result<string, string>;

}

interface phone-site {
  record create-phone-site-body-default-emergency-address {
    /// Address Line 1 of the  [emergency address](https://support.zoom.us/hc/en-us/articles/360021062871-Setting-an-Emergency-Address) consisting of house number and street name.
    address-line1: string,
    /// Address Line 2 of the [emergency address](https://support.zoom.us/hc/en-us/articles/360021062871-Setting-an-Emergency-Address) consisting of Building number, floor number, unit, etc.
    address-line2: option<string>,
    /// City of the [emergency address](https://support.zoom.us/hc/en-us/articles/360021062871-Setting-an-Emergency-Address).
    city: string,
    /// Two lettered country code (Aplha-2 code in ISO-3166) standard of the Site's [emergency address](https://support.zoom.us/hc/en-us/articles/360021062871-Setting-an-Emergency-Address).
    country: string,
    /// State Code of the [emergency address](https://support.zoom.us/hc/en-us/articles/360021062871-Setting-an-Emergency-Address).
    state-code: string,
    /// Zip Code of the [emergency address](https://support.zoom.us/hc/en-us/articles/360021062871-Setting-an-Emergency-Address).
    zip: string
  }

  /// Short extension of the phone site.
  record create-phone-site-body-short-extension {
    /// Specify the length of short extension numbers for the site.
    /// 
    length: option<s32>
  }

  /// List phone sites
  record list-phone-sites-params {
    /// The number of records returned within a single API call.
    page-size: option<s32>,
    /// The next page token is used to paginate through large result sets. A next page token will be returned whenever the set of available results exceeds the current page size. The expiration period for this token is 15 minutes.
    next-page-token: option<string>
  }
  list-phone-sites: func(params: list-phone-sites-params) -> result<string, string>;

  /// Create a phone site
  record create-phone-site-params {
    /// Display name of the [auto-receptionist](https://support.zoom.us/hc/en-us/articles/360021121312-Managing-Auto-Receptionists-and-Integrated-Voice-Response-IVR-) for the site.
    auto-receptionist-name: string,
    default-emergency-address: option<create-phone-site-body-default-emergency-address>,
    /// Name of the Site.
    name: string,
    /// Short extension of the phone site.
    short-extension: option<create-phone-site-body-short-extension>,
    /// Identifier for a site. If site code is enabled, this field is required.
    /// 
    site-code: option<s32>
  }
  create-phone-site: func(params: create-phone-site-params) -> result<string, string>;

  /// Get phone site details
  record get-a-site-params {
    /// Unique Identifier of the Site.
    site-id: string
  }
  get-a-site: func(params: get-a-site-params) -> result<string, string>;

  /// Update phone site details
  record update-site-details-params {
    /// Unique Identifier of the Site.
    site-id: string,
    /// Name of the site.
    name: option<string>,
    /// [Site Code](https://support.zoom.us/hc/en-us/articles/360020809672-Managing-Multiple-Sites#h_79ca9c8f-c97b-4486-aa59-d0d9d31a525b).
    site-code: option<s32>
  }
  update-site-details: func(params: update-site-details-params) -> result<string, string>;

  /// Delete a phone site
  record delete-phone-site-params {
    /// Unique Identifier of the Site.
    site-id: string,
    /// The Site ID of another site where the assets of the current site (users, numbers and phones) can be transferred to.
    transfer-site-id: string
  }
  delete-phone-site: func(params: delete-phone-site-params) -> result<string, string>;

}

interface reports {
  enum report-meeting-participants-include-fields-enum {
    registrant-id,
  }

  enum report-operation-logs-category-type-enum {
    all,
    user,
    user-settings,
    account,
    billing,
    im,
    recording,
    phone-contacts,
    webinar,
    sub-account,
    role,
    zoom-rooms,
  }

  enum report-users-type-op-enum {
    active,
    inactive,
  }

  enum report-meetings-type-op-enum {
    past,
    past-one,
  }

  /// Get sign In / sign out activity report
  record report-sign-in-sign-out-activities-params {
    /// Start date for which you would like to view the activity logs report. Using the `from` and `to` parameters, specify a monthly date range for the report as the API only provides one month worth of data in one request. The specified date range should fall within the last six months.
    from-op: option<string>,
    /// End date up to which you would like to view the activity logs report.
    to: option<string>,
    /// The number of records to be returned within a single API call
    page-size: option<s32>,
    /// Next page token is used to paginate through large result sets
    next-page-token: option<string>
  }
