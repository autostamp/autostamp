package autostamp:tfl@0.3.0;

interface accident-stats {
  /// Gets all accident details for accidents occuring in the specified year
  record get-params {
    /// The year for which to filter the accidents on.
    year: string
  }
  get: func(params: get-params) -> result<string, string>;

}


interface air-quality {
  /// Gets air quality data feed
  get: func() -> result<string, string>;

}

interface bike-point {
  /// Gets all bike point locations. The Place object has an addtionalProperties array which contains the nbBikes, nbDocks and nbSpaces
  ///             numbers which give the status of the BikePoint. A mismatch in these numbers i.e. nbDocks - (nbBikes + nbSpaces) != 0 indicates broken docks.
  get-all: func() -> result<string, string>;

  /// Search for bike stations by their name, a bike point's name often contains information about the name of the street
  ///             or nearby landmarks, for example. Note that the search result does not contain the PlaceProperties i.e. the status
  ///             or occupancy of the BikePoint, to get that information you should retrieve the BikePoint by its id on /BikePoint/id.
  record search-params {
    /// The search term e.g. "St. James"
    query: string
  }
  search: func(params: search-params) -> result<string, string>;

  /// Gets the bike point with the given id.
  record get-params {
    /// A bike point id (a list of ids can be obtained from the above BikePoint call)
    id: string
  }
  get: func(params: get-params) -> result<string, string>;

}

interface cabwise {
  /// Gets taxis and minicabs contact information
  record get-params {
    /// Latitude
    lat: f64,
    /// Longitude
    lon: f64,
    /// Operator Type e.g Minicab, Executive, Limousine
    optype: option<string>,
    /// Wheelchair accessible
    wc: option<string>,
    /// The radius of the bounding circle in metres
    radius: option<f64>,
    /// Trading name of operating company
    name: option<string>,
    /// An optional parameter to limit the number of results return. Default and maximum is 20.
    max-results: option<s32>,
    /// Legacy Format
    legacy-format: option<bool>,
    /// Force Xml
    force-xml: option<bool>,
    /// Twenty Four Seven Only
    twenty-four-seven-only: option<bool>
  }
  get: func(params: get-params) -> result<string, string>;

}

interface journey {
  enum journey-results-time-is-enum {
    arriving,
    departing,
  }

  enum journey-results-journey-preference-enum {
    least-interchange,
    least-time,
    least-walking,
  }

  enum journey-results-accessibility-preference-item-enum {
    no-requirements,
    no-solid-stairs,
    no-escalators,
    no-elevators,
    step-free-to-vehicle,
    step-free-to-platform,
  }

  enum journey-results-walking-speed-enum {
    slow,
    average,
    fast,
  }

  enum journey-results-cycle-preference-enum {
    none,
    leave-at-station,
    take-on-transport,
    all-the-way,
    cycle-hire,
  }

  enum journey-results-bike-proficiency-item-enum {
    easy,
    moderate,
    fast,
  }

  /// Perform a Journey Planner search from the parameters specified in simple types
  record journey-results-params {
    /// Origin of the journey. Can be WGS84 coordinates expressed as "lat,long", a UK postcode, a Naptan (StopPoint) id, an ICS StopId, or a free-text string (will cause disambiguation unless it exactly matches a point of interest name).
    from-op: string,
    /// Destination of the journey. Can be WGS84 coordinates expressed as "lat,long", a UK postcode, a Naptan (StopPoint) id, an ICS StopId, or a free-text string (will cause disambiguation unless it exactly matches a point of interest name).
    to: string,
    /// Travel through point on the journey. Can be WGS84 coordinates expressed as "lat,long", a UK postcode, a Naptan (StopPoint) id, an ICS StopId, or a free-text string (will cause disambiguation unless it exactly matches a point of interest name).
    via: option<string>,
    /// Does the journey cover stops outside London? eg. "nationalSearch=true"
    national-search: option<bool>,
    /// The date must be in yyyyMMdd format
    date: option<string>,
    /// The time must be in HHmm format
    time: option<string>,
    /// Does the time given relate to arrival or leaving time? Possible options: "departing" | "arriving"
    time-is: option<journey-results-time-is-enum>,
    /// The journey preference eg possible options: "leastinterchange" | "leasttime" | "leastwalking"
    journey-preference: option<journey-results-journey-preference-enum>,
    /// The mode must be a comma separated list of modes. eg possible options: "public-bus,overground,train,tube,coach,dlr,cablecar,tram,river,walking,cycle"
    mode: option<list<string>>,
    /// The accessibility preference must be a comma separated list eg. "noSolidStairs,noEscalators,noElevators,stepFreeToVehicle,stepFreeToPlatform"
    accessibility-preference: option<list<journey-results-accessibility-preference-item-enum>>,
    /// An optional name to associate with the origin of the journey in the results.
    from-name: option<string>,
    /// An optional name to associate with the destination of the journey in the results.
    to-name: option<string>,
    /// An optional name to associate with the via point of the journey in the results.
    via-name: option<string>,
    /// The max walking time in minutes for transfer eg. "120"
    max-transfer-minutes: option<string>,
    /// The max walking time in minutes for journeys eg. "120"
    max-walking-minutes: option<string>,
    /// The walking speed. eg possible options: "slow" | "average" | "fast".
    walking-speed: option<journey-results-walking-speed-enum>,
    /// The cycle preference. eg possible options: "allTheWay" | "leaveAtStation" | "takeOnTransport" | "cycleHire"
    cycle-preference: option<journey-results-cycle-preference-enum>,
    /// Time adjustment command. eg possible options: "TripFirst" | "TripLast"
    adjustment: option<string>,
    /// A comma separated list of cycling proficiency levels. eg possible options: "easy,moderate,fast"
    bike-proficiency: option<list<journey-results-bike-proficiency-item-enum>>,
    /// Option to determine whether to return alternative cycling journey
    alternative-cycle: option<bool>,
    /// Option to determine whether to return alternative walking journey
    alternative-walking: option<bool>,
    /// Flag to determine whether certain text (e.g. walking instructions) should be output with HTML tags or not.
    apply-html-markup: option<bool>,
    /// A boolean to indicate whether or not to return 3 public transport journeys, a bus journey, a cycle hire journey, a personal cycle journey and a walking journey
    use-multi-modal-call: option<bool>,
    /// A boolean to indicate whether to optimize journeys using walking
    walking-optimization: option<bool>,
    /// A boolean to indicate whether to return one or more taxi journeys. Note, setting this to true will override "useMultiModalCall".
    taxi-only-trip: option<bool>,
    /// A boolean to indicate whether public transport routes should include directions between platforms and station entrances.
    route-between-entrances: option<bool>,
    /// A boolean to indicate if we want to receive real time live arrivals data where available.
    use-real-time-live-arrivals: option<bool>,
    /// A boolean to make Journey Planner calculate journeys in one temporal direction only. In other words, only calculate journeys after the 'depart' time, or before the 'arrive' time. By default, the Journey Planner engine (EFA) calculates journeys in both temporal directions.
    calc-one-direction: option<bool>
  }
  journey-results: func(params: journey-results-params) -> result<string, string>;

  /// Gets a list of all of the available journey planner modes
  meta: func() -> result<string, string>;

}

interface line {
  enum route-by-mode-service-types-item-enum {
    regular,
    night,
  }

  enum arrivals-direction-enum {
    inbound,
    outbound,
    all,
  }

  /// Gets a list of valid disruption categories
  meta-disruption-categories: func() -> result<string, string>;

  /// Gets a list of valid modes
  meta-modes: func() -> result<string, string>;

  /// Gets a list of valid ServiceTypes to filter on
  meta-service-types: func() -> result<string, string>;

  /// Gets a list of valid severity codes
  meta-severity: func() -> result<string, string>;

  /// Gets lines that serve the given modes.
  record get-by-mode-params {
    /// A comma-separated list of modes e.g. tube,dlr
    modes: string
  }
  get-by-mode: func(params: get-by-mode-params) -> result<string, string>;

  /// Get disruptions for all lines of the given modes.
  record disruption-by-mode-params {
    /// A comma-separated list of modes e.g. tube,dlr
    modes: string
  }
  disruption-by-mode: func(params: disruption-by-mode-params) -> result<string, string>;

  /// Gets all lines and their valid routes for given modes, including the name and id of the originating and terminating stops for each route
  record route-by-mode-params {
    /// A comma-separated list of modes e.g. tube,dlr
    modes: string,
    /// A comma seperated list of service types to filter on. Supported values: Regular, Night. Defaulted to 'Regular' if not specified
    service-types: option<list<route-by-mode-service-types-item-enum>>
  }
  route-by-mode: func(params: route-by-mode-params) -> result<string, string>;

  /// Gets the line status of for all lines for the given modes
  record status-by-mode-params {
    /// A comma-separated list of modes to filter by. e.g. tube,dlr
    modes: string,
    /// Include details of the disruptions that are causing the line status including the affected stops and routes
    detail: option<bool>,
    /// If specified, ensures that only those line status(es) are returned within the lines that have disruptions with the matching severity level.
    severity-level: option<string>
  }
  status-by-mode: func(params: status-by-mode-params) -> result<string, string>;

  /// Get all valid routes for all lines, including the name and id of the originating and terminating stops for each route.
  record route-params {
    /// A comma seperated list of service types to filter on. Supported values: Regular, Night. Defaulted to 'Regular' if not specified
    service-types: option<list<route-by-mode-service-types-item-enum>>
  }
  route: func(params: route-params) -> result<string, string>;

  /// Search for lines or routes matching the query string
  record search-params {
    /// Search term e.g victoria
    query: string,
    /// Optionally filter by the specified modes
    modes: option<list<string>>,
    /// A comma seperated list of service types to filter on. Supported values: Regular, Night. Defaulted to 'Regular' if not specified
    service-types: option<list<route-by-mode-service-types-item-enum>>
  }
  search: func(params: search-params) -> result<string, string>;

  /// Gets the line status for all lines with a given severity
  ///             A list of valid severity codes can be obtained from a call to Line/Meta/Severity
  record status-by-severity-params {
    /// The level of severity (eg: a number from 0 to 14)
    severity: string
  }
  status-by-severity: func(params: status-by-severity-params) -> result<string, string>;

  /// Gets lines that match the specified line ids.
  record get-params {
    /// A comma-separated list of line ids e.g. victoria,circle,N133. Max. approx. 20 ids.
    ids: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Get the list of arrival predictions for given line ids based at the given stop
  record arrivals-params {
    /// A comma-separated list of line ids e.g. victoria,circle,N133. Max. approx. 20 ids.
    ids: string,
    /// Optional. Id of stop to get arrival predictions for (station naptan code e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name)
    stop-point-id: string,
    /// Optional. The direction of travel. Can be inbound or outbound or all. If left blank, and destinationStopId is set, will default to all
    direction: option<arrivals-direction-enum>,
    /// Optional. Id of destination stop
    destination-station-id: option<string>
  }
  arrivals: func(params: arrivals-params) -> result<string, string>;

  /// Get disruptions for the given line ids
  record disruption-params {
    /// A comma-separated list of line ids e.g. victoria,circle,N133. Max. approx. 20 ids.
    ids: string
  }
  disruption: func(params: disruption-params) -> result<string, string>;

  /// Get all valid routes for given line ids, including the name and id of the originating and terminating stops for each route.
  record line-routes-by-ids-params {
    /// A comma-separated list of line ids e.g. victoria,circle,N133. Max. approx. 20 ids.
    ids: string,
    /// A comma seperated list of service types to filter on. Supported values: Regular, Night. Defaulted to 'Regular' if not specified
    service-types: option<list<route-by-mode-service-types-item-enum>>
  }
  line-routes-by-ids: func(params: line-routes-by-ids-params) -> result<string, string>;

  /// Gets the line status of for given line ids e.g Minor Delays
  record status-by-ids-params {
    /// A comma-separated list of line ids e.g. victoria,circle,N133. Max. approx. 20 ids.
    ids: string,
    /// Include details of the disruptions that are causing the line status including the affected stops and routes
    detail: option<bool>
  }
  status-by-ids: func(params: status-by-ids-params) -> result<string, string>;

  /// Gets the line status for given line ids during the provided dates e.g Minor Delays
  record status-params {
    /// A comma-separated list of line ids e.g. victoria,circle,N133. Max. approx. 20 ids.
    ids: string,
    /// Include details of the disruptions that are causing the line status including the affected stops and routes
    detail: option<bool>,
    start-date: string,
    end-date: string,
    date-range-start-date: option<string>,
    date-range-end-date: option<string>
  }
  status: func(params: status-params) -> result<string, string>;

  /// Gets all valid routes for given line id, including the sequence of stops on each route.
  record route-sequence-params {
    /// A single line id e.g. victoria
    id: string,
    /// The direction of travel. Can be inbound or outbound.
    direction: string,
    /// A comma seperated list of service types to filter on. Supported values: Regular, Night. Defaulted to 'Regular' if not specified
    service-types: option<list<route-by-mode-service-types-item-enum>>,
    /// That excludes crowding from line disruptions. Can be true or false.
    exclude-crowding: option<bool>
  }
  route-sequence: func(params: route-sequence-params) -> result<string, string>;

  /// Gets a list of the stations that serve the given line id
  record stop-points-params {
    /// A single line id e.g. victoria
    id: string,
    /// If the national-rail line is requested, this flag will filter the national rail stations so that only those operated by TfL are returned
    tfl-operated-national-rail-stations-only: option<bool>
  }
  stop-points: func(params: stop-points-params) -> result<string, string>;

  /// Gets the timetable for a specified station on the give line
  record timetable-params {
    /// The originating station's stop point id (station naptan code e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name)
    from-stop-point-id: string,
    /// A single line id e.g. victoria
    id: string
  }
  timetable: func(params: timetable-params) -> result<string, string>;

  /// Gets the timetable for a specified station on the give line with specified destination
  record timetable-to-params {
    /// The originating station's stop point id (station naptan code e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name)
    from-stop-point-id: string,
    /// A single line id e.g. victoria
    id: string,
    /// The destination stations's Naptan code
    to-stop-point-id: string
  }
  timetable-to: func(params: timetable-to-params) -> result<string, string>;

}

interface mode {
  /// Returns the service type active for a mode.
  ///             Currently only supports tube
  get-active-service-types: func() -> result<string, string>;

  /// Gets the next arrival predictions for all stops of a given mode
  record arrivals-params {
    /// A mode name e.g. tube, dlr
    mode: string,
    /// A number of arrivals to return for each stop, -1 to return all available.
    count: option<s32>
  }
  arrivals: func(params: arrivals-params) -> result<string, string>;

}

interface occupancy {
  /// Get the occupancy for bike points.
  record get-bike-points-occupancies-params {
    ids: string
  }
  get-bike-points-occupancies: func(params: get-bike-points-occupancies-params) -> result<string, string>;

  /// Gets the occupancy for all car parks that have occupancy data
  get-occupancy-car-park: func() -> result<string, string>;

  /// Gets the occupancy for a car park with a given id
  record get-params {
    id: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Gets the occupancy for all charge connectors
  get-all-charge-connector-status: func() -> result<string, string>;

  /// Gets the occupancy for a charge connectors with a given id (sourceSystemPlaceId)
  record get-charge-connector-status-params {
    ids: string
  }
  get-charge-connector-status: func(params: get-charge-connector-status-params) -> result<string, string>;

}

interface place {
  /// Gets the places that lie within a geographic region. The geographic region of interest can either be specified
  ///             by using a lat/lon geo-point and a radius in metres to return places within the locus defined by the lat/lon of
  ///             its centre or alternatively, by the use of a bounding box defined by the lat/lon of its north-west and south-east corners.
  ///             Optionally filters on type and can strip properties for a smaller payload.
  record get-by-geo-params {
    /// The radius of the bounding circle in metres when only lat/lon are specified.
    radius: option<f64>,
    /// An optional list of comma separated property categories to return in the Place's property bag. If null or empty, all categories of property are returned. Pass the keyword "none" to return no properties (a valid list of categories can be obtained from the /Place/Meta/categories endpoint)
    categories: option<list<string>>,
    /// Defaults to false. If true child places e.g. individual charging stations at a charge point while be included, otherwise just the URLs of any child places will be returned
    include-children: option<bool>,
    /// Place types to filter on, or null to return all types
    type-op: option<list<string>>,
    /// An optional parameter to limit the results to active records only (Currently only the 'VariableMessageSign' place type is supported)
    active-only: option<bool>,
    /// If specified, limits the number of returned places equal to the given value
    number-of-places-to-return: option<s32>,
    place-geo-sw-lat: option<f64>,
    place-geo-sw-lon: option<f64>,
    place-geo-ne-lat: option<f64>,
    place-geo-ne-lon: option<f64>,
    place-geo-lat: option<f64>,
    place-geo-lon: option<f64>
  }
  get-by-geo: func(params: get-by-geo-params) -> result<string, string>;

  /// Gets the set of streets associated with a post code.
  record get-streets-by-post-code-params {
    postcode: string,
    postcode-input-postcode: option<string>
  }
  get-streets-by-post-code: func(params: get-streets-by-post-code-params) -> result<string, string>;

  /// Gets a list of all of the available place property categories and keys.
  meta-categories: func() -> result<string, string>;

  /// Gets a list of the available types of Place.
  meta-place-types: func() -> result<string, string>;

  /// Gets all places that matches the given query
  record search-params {
    /// The name of the place, you can use the /Place/Types/{types} endpoint to get a list of places for a given type including their names.
    name: string,
    /// A comma-separated list of the types to return. Max. approx 12 types.
    types: option<list<string>>
  }
  search: func(params: search-params) -> result<string, string>;

  /// Gets all places of a given type
  record get-by-type-params {
    /// A comma-separated list of the types to return. Max. approx 12 types.
    ///             A valid list of place types can be obtained from the /Place/Meta/placeTypes endpoint.
    types: string,
    /// An optional parameter to limit the results to active records only (Currently only the 'VariableMessageSign' place type is supported)
    active-only: option<bool>
  }
  get-by-type: func(params: get-by-type-params) -> result<string, string>;

  /// Gets the place with the given id.
  record get-params {
    /// The id of the place, you can use the /Place/Types/{types} endpoint to get a list of places for a given type including their ids
    id: string,
    /// Defaults to false. If true child places e.g. individual charging stations at a charge point while be included, otherwise just the URLs of any child places will be returned
    include-children: option<bool>
  }
  get: func(params: get-params) -> result<string, string>;

  /// Gets any places of the given type whose geography intersects the given latitude and longitude. In practice this means the Place
  ///             must be polygonal e.g. a BoroughBoundary.
  record get-at-params {
    /// The place type (a valid list of place types can be obtained from the /Place/Meta/placeTypes endpoint)
    type-op: string,
    lat: string,
    lon: string,
    location-lat: f64,
    location-lon: f64
  }
  get-at: func(params: get-at-params) -> result<string, string>;

  /// Gets the place overlay for a given set of co-ordinates and a given width/height.
  record get-overlay-params {
    /// The zoom level
    z: string,
    /// The place type (a valid list of place types can be obtained from the /Place/Meta/placeTypes endpoint)
    type-op: string,
    /// The width of the requested overlay.
    width: string,
    /// The height of the requested overlay.
    height: string,
    lat: string,
    lon: string,
    location-lat: f64,
    location-lon: f64
  }
  get-overlay: func(params: get-overlay-params) -> result<string, string>;

}

interface road {
  /// Gets all roads managed by TfL
  get: func() -> result<string, string>;

  /// Gets a list of valid RoadDisruption categories
  meta-categories: func() -> result<string, string>;

  /// Gets a list of valid RoadDisruption severity codes
  meta-severities: func() -> result<string, string>;

  /// Gets a list of active disruptions filtered by disruption Ids.
  record disruption-by-id-params {
    /// Comma-separated list of disruption identifiers to filter by.
    disruption-ids: string,
    /// Optional, defaults to false. When true, removes every property/node except for id, point, severity, severityDescription, startDate, endDate, corridor details, location and comments.
    strip-content: option<bool>
  }
  disruption-by-id: func(params: disruption-by-id-params) -> result<string, string>;

  /// Gets a list of disrupted streets. If no date filters are provided, current disruptions are returned.
  record disrupted-streets-params {
    /// Optional, the start time to filter on.
    start-date: string,
    /// Optional, The end time to filter on.
    end-date: string
  }
  disrupted-streets: func(params: disrupted-streets-params) -> result<string, string>;

  /// Gets the road with the specified id (e.g. A1)
  record get-road-ids-params {
    /// Comma-separated list of road identifiers e.g. "A406, A2" (a full list of supported road identifiers can be found at the /Road/ endpoint)
    ids: string
  }
  get-road-ids: func(params: get-road-ids-params) -> result<string, string>;

  /// Get active disruptions, filtered by road ids
  record disruption-params {
    /// Comma-separated list of road identifiers e.g. "A406, A2" use all for all to ignore id filter (a full list of supported road identifiers can be found at the /Road/ endpoint)
    ids: string,
    /// Optional, defaults to false. When true, removes every property/node except for id, point, severity, severityDescription, startDate, endDate, corridor details, location, comments and streets
    strip-content: option<bool>,
    /// an optional list of Severity names to filter on (a valid list of severities can be obtained from the /Road/Meta/severities endpoint)
    severities: option<list<string>>,
    /// an optional list of category names to filter on (a valid list of categories can be obtained from the /Road/Meta/categories endpoint)
    categories: option<list<string>>,
    /// Optional, defaults to true. When true, always includes disruptions that have road closures, regardless of the severity filter. When false, the severity filter works as normal.
    closures: option<bool>
  }
  disruption: func(params: disruption-params) -> result<string, string>;

  /// Gets the specified roads with the status aggregated over the date range specified, or now until the end of today if no dates are passed.
  record status-params {
    /// Comma-separated list of road identifiers e.g. "A406, A2" or use "all" to ignore id filter (a full list of supported road identifiers can be found at the /Road/ endpoint)
    ids: string,
    date-range-nullable-start-date: option<string>,
    date-range-nullable-end-date: option<string>
  }
  status: func(params: status-params) -> result<string, string>;

}

interface search {
  /// Search the site for occurrences of the query string. The maximum number of results returned is equal to the maximum page size
  ///             of 100. To return subsequent pages, use the paginated overload.
  record get-params {
    /// The search query
    query: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Searches the bus schedules folder on S3 for a given bus number.
  record bus-schedules-params {
    /// The search query
    query: string
  }
  bus-schedules: func(params: bus-schedules-params) -> result<string, string>;

  /// Gets the available search categories.
  meta-categories: func() -> result<string, string>;

  /// Gets the available searchProvider names.
  meta-search-providers: func() -> result<string, string>;

  /// Gets the available sorting options.
  meta-sorts: func() -> result<string, string>;

}

interface stop-point {
  enum reachable-from-service-types-item-enum {
    regular,
    night,
  }

  enum crowding-direction-enum {
    inbound,
    outbound,
    all,
  }

  /// Gets a list of StopPoints within {radius} by the specified criteria
  record get-by-geo-point-params {
    /// a list of stopTypes that should be returned (a list of valid stop types can be obtained from the StopPoint/meta/stoptypes endpoint)
    stop-types: list<string>,
    /// the radius of the bounding circle in metres (default : 200)
    radius: option<s32>,
    /// Re-arrange the output into a parent/child hierarchy
    use-stop-point-hierarchy: option<bool>,
    /// the list of modes to search (comma separated mode names e.g. tube,dlr)
    modes: option<list<string>>,
    /// an optional list of comma separated property categories to return in the StopPoint's property bag. If null or empty, all categories of property are returned. Pass the keyword "none" to return no properties (a valid list of categories can be obtained from the /StopPoint/Meta/categories endpoint)
    categories: option<list<string>>,
    /// true to return the lines that each stop point serves as a nested resource
    return-lines: option<bool>,
    location-lat: f64,
    location-lon: f64
  }
  get-by-geo-point: func(params: get-by-geo-point-params) -> result<string, string>;

  /// Gets the list of available StopPoint additional information categories
  meta-categories: func() -> result<string, string>;

  /// Gets the list of available StopPoint modes
  meta-modes: func() -> result<string, string>;

  /// Gets the list of available StopPoint types
  meta-stop-types: func() -> result<string, string>;

  /// Gets a list of StopPoints filtered by the modes available at that StopPoint.
  record get-by-mode-params {
    /// A comma-seperated list of modes e.g. tube,dlr
    modes: string,
    /// The data set page to return. Page 1 equates to the first 1000 stop points, page 2 equates to 1001-2000 etc. Must be entered for bus mode as data set is too large.
    page: option<s32>
  }
  get-by-mode: func(params: get-by-mode-params) -> result<string, string>;

  /// Gets a distinct list of disrupted stop points for the given modes
  record disruption-by-mode-params {
    /// A comma-seperated list of modes e.g. tube,dlr
    modes: string,
    include-route-blocked-stops: option<bool>
  }
  disruption-by-mode: func(params: disruption-by-mode-params) -> result<string, string>;

  /// Search StopPoints by their common name, or their 5-digit Countdown Bus Stop Code.
  record get-stop-point-search-params {
    /// The query string, case-insensitive. Leading and trailing wildcards are applied automatically.
    query: string,
    /// An optional, parameter separated list of the modes to filter by
    modes: option<list<string>>,
    /// True to only return stations in that have Fares data available for single fares to another station.
    fares-only: option<bool>,
    /// An optional result limit, defaulting to and with a maximum of 50. Since children of the stop point heirarchy are returned for matches,
    ///             it is possible that the flattened result set will contain more than 50 items.
    max-results: option<s32>,
    /// An optional, parameter separated list of the lines to filter by
    lines: option<list<string>>,
    /// If true, returns results including HUBs.
    include-hubs: option<bool>,
    /// If the national-rail mode is included, this flag will filter the national rail stations so that only those operated by TfL are returned
    tfl-operated-national-rail-stations-only: option<bool>
  }
  get-stop-point-search: func(params: get-stop-point-search-params) -> result<string, string>;

  /// Search StopPoints by their common name, or their 5-digit Countdown Bus Stop Code.
  record search-params {
    /// The query string, case-insensitive. Leading and trailing wildcards are applied automatically.
    query: string,
    /// An optional, parameter separated list of the modes to filter by
    modes: option<list<string>>,
    /// True to only return stations in that have Fares data available for single fares to another station.
    fares-only: option<bool>,
    /// An optional result limit, defaulting to and with a maximum of 50. Since children of the stop point heirarchy are returned for matches,
    ///             it is possible that the flattened result set will contain more than 50 items.
    max-results: option<s32>,
    /// An optional, parameter separated list of the lines to filter by
    lines: option<list<string>>,
    /// If true, returns results including HUBs.
    include-hubs: option<bool>,
    /// If the national-rail mode is included, this flag will filter the national rail stations so that only those operated by TfL are returned
    tfl-operated-national-rail-stations-only: option<bool>
  }
  search: func(params: search-params) -> result<string, string>;

  /// Gets the service types for a given stoppoint
  record get-service-types-params {
    /// The Naptan id of the stop
    id: string,
    /// The lines which contain the given Naptan id (all lines relevant to the given stoppoint if empty)
    line-ids: option<list<string>>,
    /// The modes which the lines are relevant to (all if empty)
    modes: option<list<string>>
  }
  get-service-types: func(params: get-service-types-params) -> result<string, string>;

  /// Gets a StopPoint for a given sms code.
  record get-by-sms-params {
    /// A 5-digit Countdown Bus Stop Code e.g. 73241, 50435, 56334.
    id: string,
    /// If set to "web", a 302 redirect to relevant website bus stop page is returned. Valid values are : web. All other values are ignored.
    output: option<string>
  }
  get-by-sms: func(params: get-by-sms-params) -> result<string, string>;

  /// Gets all stop points of a given type
  record get-by-type-params {
    /// A comma-separated list of the types to return. Max. approx. 12 types. 
    ///             A list of valid stop types can be obtained from the StopPoint/meta/stoptypes endpoint.
    types: string
  }
  get-by-type: func(params: get-by-type-params) -> result<string, string>;

  /// Gets all the stop points of given type(s) with a page number
  record get-by-type-with-pagination-params {
    types: string,
    page: string
  }
  get-by-type-with-pagination: func(params: get-by-type-with-pagination-params) -> result<string, string>;

  /// Gets a list of StopPoints corresponding to the given list of stop ids.
  record get-params {
    /// A comma-separated list of stop point ids (station naptan code e.g. 940GZZLUASL). Max. approx. 20 ids.
    ///             You can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name.
    ids: string,
    /// Include the crowding data (static). To Filter further use: /StopPoint/{ids}/Crowding/{line}
    include-crowding-data: option<bool>
  }
  get: func(params: get-params) -> result<string, string>;

  /// Gets all disruptions for the specified StopPointId, plus disruptions for any child Naptan records it may have.
  record disruption-params {
    /// A comma-seperated list of stop point ids. Max. approx. 20 ids.
    ///             You can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name.
    ids: string,
    /// Specify true to return disruptions for entire family, or false to return disruptions for just this stop point. Defaults to false.
    get-family: option<bool>,
    include-route-blocked-stops: option<bool>,
    /// Specify true to associate all disruptions with parent stop point. (Only applicable when getFamily is true).
    flatten-response: option<bool>
  }
  disruption: func(params: disruption-params) -> result<string, string>;

  /// Gets the list of arrival and departure predictions for the given stop point id (overground, Elizabeth line and thameslink only)
  record arrival-departures-params {
    /// A StopPoint id (station naptan code e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name)
    id: string,
    /// A comma-separated list of line ids e.g. elizabeth, london-overground, thameslink
    line-ids: list<string>
  }
  arrival-departures: func(params: arrival-departures-params) -> result<string, string>;

  /// Gets the list of arrival predictions for the given stop point id
  record arrivals-params {
    /// A StopPoint id (station naptan code e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name)
    id: string
  }
  arrivals: func(params: arrivals-params) -> result<string, string>;

  /// Gets Stopoints that are reachable from a station/line combination.
  record reachable-from-params {
    /// The id (station naptan code e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name) of the stop point to filter by
    id: string,
    /// Line id of the line to filter by (e.g. victoria)
    line-id: string,
    /// A comma-separated list of service types to filter on. If not specified. Supported values: Regular, Night. Defaulted to 'Regular' if not specified
    service-types: option<list<reachable-from-service-types-item-enum>>
  }
  reachable-from: func(params: reachable-from-params) -> result<string, string>;

  /// Gets all the Crowding data (static) for the StopPointId, plus crowding data for a given line and optionally a particular direction.
  record crowding-params {
    /// The Naptan id of the stop
    id: string,
    /// A particular line e.g. victoria, circle, northern etc.
    line: string,
    /// The direction of travel. Can be inbound or outbound.
    direction: crowding-direction-enum
  }
  crowding: func(params: crowding-params) -> result<string, string>;

  /// Returns the canonical direction, "inbound" or "outbound", for a given pair of stop point Ids in the direction from -&gt; to.
  record direction-params {
    /// Originating stop id (station naptan code e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name)
    id: string,
    /// Destination stop id (station naptan code e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name)
    to-stop-point-id: string,
    /// Optional line id filter e.g. victoria
    line-id: option<string>
  }
  direction: func(params: direction-params) -> result<string, string>;

  /// Returns the route sections for all the lines that service the given stop point ids
  record route-params {
    /// A stop point id (station naptan codes e.g. 940GZZLUASL, you can use /StopPoint/Search/{query} endpoint to find a stop point id from a station name)
    id: string,
    /// A comma-separated list of service types to filter on. If not specified. Supported values: Regular, Night. Defaulted to 'Regular' if not specified
    service-types: option<list<reachable-from-service-types-item-enum>>
  }
  route: func(params: route-params) -> result<string, string>;

  /// Get a list of places corresponding to a given id and place types.
  record get-stop-point-id-place-types-params {
    /// A naptan id for a stop point (station naptan code e.g. 940GZZLUASL).
    id: string,
    /// A comcomma-separated value representing the place types.
    place-types: list<string>
  }
  get-stop-point-id-place-types: func(params: get-stop-point-id-place-types-params) -> result<string, string>;

  /// Get car parks corresponding to the given stop point id.
  record get-car-parks-by-id-params {
    /// stopPointId is required to get the car parks.
    stop-point-id: string
  }
  get-car-parks-by-id: func(params: get-car-parks-by-id-params) -> result<string, string>;

  /// Gets a list of taxi ranks corresponding to the given stop point id.
  record get-taxi-ranks-by-ids-params {
    /// stopPointId is required to get the taxi ranks.
    stop-point-id: string
  }
  get-taxi-ranks-by-ids: func(params: get-taxi-ranks-by-ids-params) -> result<string, string>;

}

interface travel-time {
  enum get-compare-overlay-direction-enum {
    average,
    from-op,
    to,
  }

  /// Gets the TravelTime overlay.
  record get-compare-overlay-params {
    /// The zoom level.
    z: string,
    /// The latitude of the pin.
    pin-lat: string,
    /// The longitude of the pin.
    pin-lon: string,
    /// The map center latitude.
    map-center-lat: string,
    /// The map center longitude.
    map-center-lon: string,
    /// The title of the scenario.
    scenario-title: string,
    /// The id for the time of day (AM/INTER/PM)
    time-of-day-id: string,
    /// The id of the mode.
    mode-id: string,
    /// The width of the requested overlay.
    width: string,
    /// The height of the requested overlay.
    height: string,
    /// The direction of travel.
    direction: get-compare-overlay-direction-enum,
    /// The total minutes between the travel time bands
    travel-time-interval: s32,
    compare-type: string,
    compare-value: string
  }
  get-compare-overlay: func(params: get-compare-overlay-params) -> result<string, string>;

  /// Gets the TravelTime overlay.
  record get-overlay-params {
    /// The zoom level.
    z: string,
    /// The latitude of the pin.
    pin-lat: string,
    /// The longitude of the pin.
    pin-lon: string,
    /// The map center latitude.
    map-center-lat: string,
    /// The map center longitude.
    map-center-lon: string,
    /// The title of the scenario.
    scenario-title: string,
    /// The id for the time of day (AM/INTER/PM)
    time-of-day-id: string,
    /// The id of the mode.
    mode-id: string,
    /// The width of the requested overlay.
    width: string,
    /// The height of the requested overlay.
    height: string,
    /// The direction of travel.
    direction: get-compare-overlay-direction-enum,
    /// The total minutes between the travel time bands
    travel-time-interval: s32
  }
  get-overlay: func(params: get-overlay-params) -> result<string, string>;

}

interface vehicle {
  /// Gets the predictions for a given list of vehicle Id's.
  record get-params {
    /// A comma-separated list of vehicle ids e.g. LX58CFV,LX11AZB,LX58CFE. Max approx. 25 ids.
    ids: string
  }
  get: func(params: get-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export accident-stats;
  export air-quality;
  export bike-point;
  export cabwise;
  export journey;
  export line;
  export mode;
  export occupancy;
  export place;
  export road;
  export search;
  export stop-point;
  export travel-time;
  export vehicle;
}
