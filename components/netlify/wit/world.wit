package autostamp:netlify@0.5.0;

interface account-membership {
  enum account-setup-period-enum {
    monthly,
    yearly,
  }

  record account-membership {
    billing-details: option<string>,
    billing-email: option<string>,
    billing-name: option<string>,
    billing-period: option<string>,
    capabilities: option<account-membership-capabilities>,
    created-at: option<string>,
    id: option<string>,
    name: option<string>,
    owner-ids: option<list<string>>,
    payment-method-id: option<string>,
    roles-allowed: option<list<string>>,
    slug: option<string>,
    type-op: option<string>,
    type-id: option<string>,
    type-name: option<string>,
    updated-at: option<string>
  }

  record account-membership-capabilities {
    collaborators: option<account-usage-capability>,
    sites: option<account-usage-capability>
  }

  record account-usage-capability {
    included: option<s32>,
    used: option<s32>
  }

  list-accounts-for-user: func() -> result<list<account-membership>, string>;

  record create-account-params {
    extra-seats-block: option<s32>,
    name: string,
    payment-method-id: option<string>,
    period: option<account-setup-period-enum>,
    type-id: string
  }
  create-account: func(params: create-account-params) -> result<account-membership, string>;

  record get-account-params {
    account-id: string
  }
  get-account: func(params: get-account-params) -> result<list<account-membership>, string>;

  record update-account-params {
    account-id: string,
    billing-details: option<string>,
    billing-email: option<string>,
    billing-name: option<string>,
    extra-seats-block: option<s32>,
    name: option<string>,
    slug: option<string>,
    type-id: option<string>
  }
  update-account: func(params: update-account-params) -> result<account-membership, string>;

  record cancel-account-params {
    account-id: string
  }
  cancel-account: func(params: cancel-account-params) -> result<string, string>;

}


interface account-type {
  record account-type {
    capabilities: option<account-type-capabilities>,
    description: option<string>,
    id: option<string>,
    monthly-dollar-price: option<s32>,
    monthly-seats-addon-dollar-price: option<s32>,
    name: option<string>,
    yearly-dollar-price: option<s32>,
    yearly-seats-addon-dollar-price: option<s32>
  }

  record account-type-capabilities {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  list-account-types-for-user: func() -> result<list<account-type>, string>;

}

interface audit-log {
  record audit-log {
    account-id: option<string>,
    id: option<string>,
    payload: option<audit-log-payload>
  }

  record audit-log-payload {
    action: option<string>,
    actor-email: option<string>,
    actor-id: option<string>,
    actor-name: option<string>,
    log-type: option<string>,
    timestamp: option<string>
  }

  record list-account-audit-events-params {
    account-id: string,
    query: option<string>,
    log-type: option<string>,
    page: option<s32>,
    per-page: option<s32>
  }
  list-account-audit-events: func(params: list-account-audit-events-params) -> result<list<audit-log>, string>;

}

interface environment-variables {
  enum get-env-vars-context-name-enum {
    all,
    dev,
    branch-deploy,
    deploy-preview,
    production,
  }

  enum get-env-vars-scope-enum {
    builds,
    functions,
    runtime,
    post-processing,
  }

  enum set-env-var-value-body-context-enum {
    dev,
    branch-deploy,
    deploy-preview,
    production,
  }

  /// Environment variable model definition
  record env-var {
    /// The environment variable key, like ALGOLIA_ID (case-sensitive)
    key: option<string>,
    /// The scopes that this environment variable is set to
    scopes: option<list<get-env-vars-scope-enum>>,
    /// The timestamp of when the value was last updated
    updated-at: option<string>,
    updated-by: option<env-var-user>,
    /// An array of Value objects containing values and metadata
    values: option<list<env-var-value>>
  }

  record env-var-user {
    /// A URL pointing to the user's avatar
    avatar-url: option<string>,
    /// The user's email address
    email: option<string>,
    /// The user's full name (first and last)
    full-name: option<string>,
    /// The user's unique identifier
    id: option<string>
  }

  /// Environment variable value model definition
  record env-var-value {
    /// The deploy context in which this value will be used. `dev` refers to local development when running `netlify dev`.
    context: option<get-env-vars-context-name-enum>,
    /// The environment variable value's universally unique ID
    id: option<string>,
    /// The environment variable's unencrypted value
    value: option<string>
  }

  record create-env-vars-body-item {
    /// The existing or new name of the key, if you wish to rename it (case-sensitive)
    key: option<string>,
    /// The scopes that this environment variable is set to (Pro plans and above)
    scopes: option<list<get-env-vars-scope-enum>>,
    values: option<list<env-var-value>>
  }

  record get-env-vars-params {
    /// Scope response to account_id
    account-id: string,
    /// Filter by deploy context
    context-name: option<get-env-vars-context-name-enum>,
    /// Filter by scope
    scope: option<get-env-vars-scope-enum>,
    /// If specified, only return environment variables set on this site
    site-id: option<string>
  }
  get-env-vars: func(params: get-env-vars-params) -> result<list<env-var>, string>;

  record create-env-vars-params {
    /// Scope response to account_id
    account-id: string,
    /// If provided, create an environment variable on the site level, not the account level
    site-id: option<string>,
    body: option<list<create-env-vars-body-item>>
  }
  create-env-vars: func(params: create-env-vars-params) -> result<list<env-var>, string>;

  record get-env-var-params {
    /// Scope response to account_id
    account-id: string,
    /// The environment variable key (case-sensitive)
    key: string,
    /// If provided, return the environment variable for a specific site (no merging is performed)
    site-id: option<string>
  }
  get-env-var: func(params: get-env-var-params) -> result<env-var, string>;

  record update-env-var-params {
    /// Scope response to account_id
    account-id: string,
    /// The existing environment variable key name (case-sensitive)
    key: string,
    /// If provided, update an environment variable set on this site
    site-id: option<string>,
    /// The existing or new name of the key, if you wish to rename it (case-sensitive)
    key-v2: option<string>,
    /// The scopes that this environment variable is set to (Pro plans and above)
    scopes: option<list<get-env-vars-scope-enum>>,
    values: option<list<env-var-value>>
  }
  update-env-var: func(params: update-env-var-params) -> result<env-var, string>;

  record set-env-var-value-params {
    /// Scope response to account_id
    account-id: string,
    /// The existing environment variable key name (case-sensitive)
    key: string,
    /// If provided, update an environment variable set on this site
    site-id: option<string>,
    /// The deploy context in which this value will be used. `dev` refers to local development when running `netlify dev`.
    context: option<set-env-var-value-body-context-enum>,
    /// The environment variable's unencrypted value
    value: option<string>
  }
  set-env-var-value: func(params: set-env-var-value-params) -> result<env-var, string>;

  record delete-env-var-params {
    /// Scope response to account_id
    account-id: string,
    /// The environment variable key (case-sensitive)
    key: string,
    /// If provided, delete the environment variable from this site
    site-id: option<string>
  }
  delete-env-var: func(params: delete-env-var-params) -> result<string, string>;

  record delete-env-var-value-params {
    /// Scope response to account_id
    account-id: string,
    /// The environment variable value's ID
    id: string,
    /// The environment variable key name (case-sensitive)
    key: string,
    /// If provided, delete the value from an environment variable on this site
    site-id: option<string>
  }
  delete-env-var-value: func(params: delete-env-var-value-params) -> result<string, string>;

}

interface payment-method {
  record payment-method {
    created-at: option<string>,
    data: option<payment-method-data>,
    id: option<string>,
    method-name: option<string>,
    state: option<string>,
    type-op: option<string>,
    updated-at: option<string>
  }

  record payment-method-data {
