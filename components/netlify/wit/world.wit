interface dns-zone {
  record dns-zones {
    /// opaque schema; raw JSON
    value: string
  }

  record dns-zone {
    account-id: option<string>,
    account-name: option<string>,
    account-slug: option<string>,
    created-at: option<string>,
    dedicated: option<bool>,
    dns-servers: option<list<string>>,
    domain: option<string>,
    errors: option<list<string>>,
    id: option<string>,
    ipv6-enabled: option<bool>,
    name: option<string>,
    records: option<list<dns-record>>,
    site-id: option<string>,
    supported-record-types: option<list<string>>,
    updated-at: option<string>,
    user-id: option<string>
  }

  record dns-record {
    dns-zone-id: option<string>,
    flag: option<s32>,
    hostname: option<string>,
    id: option<string>,
    managed: option<bool>,
    priority: option<s64>,
    site-id: option<string>,
    tag: option<string>,
    ttl: option<s64>,
    type-op: option<string>,
    value: option<string>
  }

  record dns-records {
    /// opaque schema; raw JSON
    value: string
  }

  record get-dns-zones-params {
    account-slug: option<string>
  }
  get-dns-zones: func(params: get-dns-zones-params) -> result<dns-zones, string>;

  record create-dns-zone-params {
    account-slug: option<string>,
    name: option<string>,
    site-id: option<string>
  }
  create-dns-zone: func(params: create-dns-zone-params) -> result<dns-zone, string>;

  record get-dns-zone-params {
    zone-id: string
  }
  get-dns-zone: func(params: get-dns-zone-params) -> result<dns-zone, string>;

  record delete-dns-zone-params {
    zone-id: string
  }
  delete-dns-zone: func(params: delete-dns-zone-params) -> result<string, string>;

  record get-dns-records-params {
    zone-id: string
  }
  get-dns-records: func(params: get-dns-records-params) -> result<dns-records, string>;

  record create-dns-record-params {
    zone-id: string,
    flag: option<s64>,
    hostname: option<string>,
    port: option<s64>,
    priority: option<s64>,
    tag: option<string>,
    ttl: option<s64>,
    type-op: option<string>,
    value: option<string>,
    weight: option<s64>
  }
  create-dns-record: func(params: create-dns-record-params) -> result<dns-record, string>;

  record get-individual-dns-record-params {
    zone-id: string,
    dns-record-id: string
  }
  get-individual-dns-record: func(params: get-individual-dns-record-params) -> result<dns-record, string>;

  record delete-dns-record-params {
    zone-id: string,
    dns-record-id: string
  }
  delete-dns-record: func(params: delete-dns-record-params) -> result<string, string>;

  record transfer-dns-zone-params {
    zone-id: string,
    /// the account of the dns zone
    account-id: string,
    /// the account you want to transfer the dns zone to
    transfer-account-id: string,
    /// the user you want to transfer the dns zone to
    transfer-user-id: string
  }
  transfer-dns-zone: func(params: transfer-dns-zone-params) -> result<dns-zone, string>;

  record get-dns-for-site-params {
    site-id: string
  }
  get-dns-for-site: func(params: get-dns-for-site-params) -> result<list<dns-zone>, string>;

  record configure-dns-for-site-params {
    site-id: string
  }
  configure-dns-for-site: func(params: configure-dns-for-site-params) -> result<list<dns-zone>, string>;

}

