  }
  update-site-build-log: func(params: update-site-build-log-params) -> result<string, string>;

}

interface deploy-key {
  record deploy-key {
    created-at: option<string>,
    id: option<string>,
    public-key: option<string>
  }

  list-deploy-keys: func() -> result<list<deploy-key>, string>;

  create-deploy-key: func() -> result<deploy-key, string>;

  record get-deploy-key-params {
