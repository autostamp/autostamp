/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export account-membership;
  export account-type;
  export audit-log;
  export environment-variables;
  export payment-method;
  export build;
  export build-log-msg;
  export deploy-key;
  export deploy;
  export file;
  export function;
  export x-internal;
  export dns-zone;
  export submission;
  export hook;
  export hook-type;
  export ticket;
  export access-token;
  export service;
  export site;
  export asset;
  export asset-public-signature;
  export build-hook;
  export deployed-branch;
  export form;
  export metadata;
  export service-instance;
  export snippet;
  export sni-certificate;
  export split-test;
  export user;
  export member;
}
