    full-name: option<string>,
    id: option<string>,
    last-login: option<string>,
    login-providers: option<list<string>>,
    onboarding-progress: option<user-onboarding-progress>,
    site-count: option<s64>,
    uid: option<string>
  }

  record user-onboarding-progress {
    slides: option<string>
  }

  get-current-user: func() -> result<list<user>, string>;

}

interface member {
  enum account-add-member-setup-role-enum {
    owner,
    collaborator,
    controller,
  }

  enum account-update-member-setup-site-access-enum {
    all,
    none,
    selected,
  }

  record member {
    avatar: option<string>,
    email: option<string>,
    full-name: option<string>,
    id: option<string>,
    role: option<string>
  }

  record list-members-for-account-params {
    account-slug: string
  }
  list-members-for-account: func(params: list-members-for-account-params) -> result<list<member>, string>;

  record add-member-to-account-params {
    account-slug: string,
    email: option<string>,
    role: option<account-add-member-setup-role-enum>
  }
  add-member-to-account: func(params: add-member-to-account-params) -> result<list<member>, string>;

  record get-account-member-params {
    account-slug: string,
    member-id: string
  }
  get-account-member: func(params: get-account-member-params) -> result<member, string>;

  record update-account-member-params {
    account-slug: string,
    member-id: string,
    role: option<account-add-member-setup-role-enum>,
    site-access: option<account-update-member-setup-site-access-enum>,
    site-ids: option<list<string>>
  }
  update-account-member: func(params: update-account-member-params) -> result<member, string>;

  record remove-account-member-params {
    account-slug: string,
    member-id: string
  }
  remove-account-member: func(params: remove-account-member-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export account-membership;
  export account-type;
  export audit-log;
  export environment-variables;
  export payment-method;
  export build;
  export build-log-msg;
  export deploy-key;
  export deploy;
  export file;
  export function;
  export x-internal;
  export dns-zone;
  export submission;
  export hook;
  export hook-type;
  export ticket;
  export access-token;
  export service;
  export site;
  export asset;
  export asset-public-signature;
  export build-hook;
  export deployed-branch;
  export form;
  export metadata;
  export service-instance;
  export snippet;
  export sni-certificate;
  export split-test;
  export user;
  export member;
}
