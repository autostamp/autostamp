}

interface deploy {
  enum list-site-deploys-state-enum {
    new,
    pending-review,
    accepted,
    rejected,
    enqueued,
    building,
    uploading,
    uploaded,
    preparing,
    prepared,
    processing,
    ready,
    error,
    retrying,
  }

  record deploy {
    admin-url: option<string>,
    branch: option<string>,
    build-id: option<string>,
    commit-ref: option<string>,
    commit-url: option<string>,
    context: option<string>,
    created-at: option<string>,
    deploy-ssl-url: option<string>,
    deploy-url: option<string>,
    draft: option<bool>,
    error-message: option<string>,
    framework: option<string>,
    function-schedules: option<list<function-schedule>>,
    id: option<string>,
    locked: option<bool>,
    name: option<string>,
    published-at: option<string>,
    required: option<list<string>>,
    required-functions: option<list<string>>,
    review-id: option<f64>,
    review-url: option<string>,
    screenshot-url: option<string>,
    site-capabilities: option<deploy-site-capabilities>,
    site-id: option<string>,
    skipped: option<bool>,
    ssl-url: option<string>,
    state: option<string>,
    title: option<string>,
    updated-at: option<string>,
    url: option<string>,
    user-id: option<string>
  }

  record function-schedule {
    cron: option<string>,
    name: option<string>
  }

  record deploy-site-capabilities {
    large-media-enabled: option<bool>
  }

  record files-files {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record files-functions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record files-functions-config {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-deploy-params {
    deploy-id: string
  }
  get-deploy: func(params: get-deploy-params) -> result<deploy, string>;

  record delete-deploy-params {
    deploy-id: string
  }
  delete-deploy: func(params: delete-deploy-params) -> result<string, string>;

  record cancel-site-deploy-params {
    deploy-id: string
  }
  cancel-site-deploy: func(params: cancel-site-deploy-params) -> result<deploy, string>;

  record lock-deploy-params {
    deploy-id: string
  }
  lock-deploy: func(params: lock-deploy-params) -> result<deploy, string>;

  record unlock-deploy-params {
    deploy-id: string
  }
  unlock-deploy: func(params: unlock-deploy-params) -> result<deploy, string>;

  record list-site-deploys-params {
    site-id: string,
    deploy-previews: option<bool>,
    production: option<bool>,
    state: option<list-site-deploys-state-enum>,
    branch: option<string>,
    latest-published: option<bool>,
    page: option<s32>,
    per-page: option<s32>
  }
  list-site-deploys: func(params: list-site-deploys-params) -> result<list<deploy>, string>;

  record create-site-deploy-params {
    site-id: string,
    deploy-previews: option<bool>,
    production: option<bool>,
    state: option<list-site-deploys-state-enum>,
    branch: option<string>,
    latest-published: option<bool>,
    title: option<string>,
    async-op: option<bool>,
    branch-v2: option<string>,
    draft: option<bool>,
    files: option<files-files>,
    framework: option<string>,
    function-schedules: option<list<function-schedule>>,
    functions: option<files-functions>,
    functions-config: option<files-functions-config>
  }
  create-site-deploy: func(params: create-site-deploy-params) -> result<deploy, string>;

  record get-site-deploy-params {
    site-id: string,
    deploy-id: string
  }
  get-site-deploy: func(params: get-site-deploy-params) -> result<deploy, string>;

  record update-site-deploy-params {
    site-id: string,
    deploy-id: string,
    async-op: option<bool>,
    branch: option<string>,
    draft: option<bool>,
    files: option<files-files>,
    framework: option<string>,
    function-schedules: option<list<function-schedule>>,
    functions: option<files-functions>,
    functions-config: option<files-functions-config>
  }
  update-site-deploy: func(params: update-site-deploy-params) -> result<deploy, string>;

  record delete-site-deploy-params {
    deploy-id: string,
    site-id: string
  }
  delete-site-deploy: func(params: delete-site-deploy-params) -> result<string, string>;

  record restore-site-deploy-params {
    site-id: string,
    deploy-id: string
  }
  restore-site-deploy: func(params: restore-site-deploy-params) -> result<deploy, string>;

  record rollback-site-deploy-params {
    site-id: string
  }
  rollback-site-deploy: func(params: rollback-site-deploy-params) -> result<string, string>;

}

