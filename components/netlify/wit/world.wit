  list-payment-methods-for-user: func() -> result<list<payment-method>, string>;

}

interface build {
  record build {
    created-at: option<string>,
    deploy-id: option<string>,
    done: option<bool>,
    error: option<string>,
    id: option<string>,
    sha: option<string>
  }

  record status {
    active: option<s32>,
    build-count: option<s32>,
    enqueued: option<s32>,
    minutes: option<status-minutes>,
    pending-concurrency: option<s32>
  }

  record status-minutes {
    current: option<s32>,
    current-average-sec: option<s32>,
    included-minutes: option<string>,
    included-minutes-with-packs: option<string>,
    last-updated-at: option<string>,
    period-end-date: option<string>,
    period-start-date: option<string>,
    previous: option<s32>
  }

  record get-site-build-params {
    build-id: string
  }
  get-site-build: func(params: get-site-build-params) -> result<build, string>;

  record notify-build-start-params {
    build-id: string
  }
  notify-build-start: func(params: notify-build-start-params) -> result<string, string>;

  record list-site-builds-params {
    site-id: string,
    page: option<s32>,
    per-page: option<s32>
  }
  list-site-builds: func(params: list-site-builds-params) -> result<list<build>, string>;

  record create-site-build-params {
    site-id: string,
    clear-cache: option<bool>,
    image: option<string>
  }
  create-site-build: func(params: create-site-build-params) -> result<build, string>;

  record get-account-build-status-params {
    account-id: string
  }
  get-account-build-status: func(params: get-account-build-status-params) -> result<list<status>, string>;

}

interface build-log-msg {
