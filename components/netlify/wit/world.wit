package autostamp:netlify@0.2.1;

interface account-membership {
  enum account-setup-period-enum {
    monthly,
    yearly,
  }

  list-accounts-for-user: func() -> result<string, string>;

  record create-account-params {
    extra-seats-block: option<s32>,
    name: string,
    payment-method-id: option<string>,
    period: option<account-setup-period-enum>,
    type-id: string
  }
  create-account: func(params: create-account-params) -> result<string, string>;

  get-account: func() -> result<string, string>;

  record update-account-params {
    billing-details: option<string>,
    billing-email: option<string>,
    billing-name: option<string>,
    extra-seats-block: option<s32>,
    name: option<string>,
    slug: option<string>,
    type-id: option<string>
  }
  update-account: func(params: update-account-params) -> result<string, string>;

  cancel-account: func() -> result<string, string>;

}


interface account-type {
  list-account-types-for-user: func() -> result<string, string>;

}

interface audit-log {
  record list-account-audit-events-params {
    query: option<string>,
    log-type: option<string>
  }
  list-account-audit-events: func(params: list-account-audit-events-params) -> result<string, string>;

}

interface environment-variables {
  enum get-env-vars-context-name-enum {
    all,
    dev,
    branch-deploy,
    deploy-preview,
    production,
  }

  enum get-env-vars-scope-enum {
    builds,
    functions,
    runtime,
    post-processing,
  }

  enum set-env-var-value-body-context-enum {
    dev,
    branch-deploy,
    deploy-preview,
    production,
  }

  record create-env-vars-body-item {
    /// The existing or new name of the key, if you wish to rename it (case-sensitive)
    key: option<string>,
    /// The scopes that this environment variable is set to (Pro plans and above)
    scopes: option<list<get-env-vars-scope-enum>>,
    values: option<list<env-var-value>>
  }

  /// Environment variable value model definition
  record env-var-value {
    /// The deploy context in which this value will be used. `dev` refers to local development when running `netlify dev`.
    context: option<get-env-vars-context-name-enum>,
    /// The environment variable value's universally unique ID
    id: option<string>,
    /// The environment variable's unencrypted value
    value: option<string>
  }

  record get-env-vars-params {
    /// Scope response to account_id
    account-id: string,
    /// Filter by deploy context
    context-name: option<get-env-vars-context-name-enum>,
    /// Filter by scope
    scope: option<get-env-vars-scope-enum>,
    /// If specified, only return environment variables set on this site
    site-id: option<string>
  }
  get-env-vars: func(params: get-env-vars-params) -> result<string, string>;

  record create-env-vars-params {
    /// Scope response to account_id
    account-id: string,
    /// If provided, create an environment variable on the site level, not the account level
    site-id: option<string>,
    body: option<list<create-env-vars-body-item>>
  }
  create-env-vars: func(params: create-env-vars-params) -> result<string, string>;

  record get-env-var-params {
    /// Scope response to account_id
    account-id: string,
    /// The environment variable key (case-sensitive)
    key: string,
    /// If provided, return the environment variable for a specific site (no merging is performed)
    site-id: option<string>
  }
  get-env-var: func(params: get-env-var-params) -> result<string, string>;

  record update-env-var-params {
    /// Scope response to account_id
    account-id: string,
    /// The existing environment variable key name (case-sensitive)
    key: string,
    /// If provided, update an environment variable set on this site
    site-id: option<string>,
    /// The scopes that this environment variable is set to (Pro plans and above)
    scopes: option<list<get-env-vars-scope-enum>>,
    values: option<list<env-var-value>>
  }
  update-env-var: func(params: update-env-var-params) -> result<string, string>;

  record set-env-var-value-params {
    /// Scope response to account_id
    account-id: string,
    /// The existing environment variable key name (case-sensitive)
    key: string,
    /// If provided, update an environment variable set on this site
    site-id: option<string>,
    /// The deploy context in which this value will be used. `dev` refers to local development when running `netlify dev`.
    context: option<set-env-var-value-body-context-enum>,
    /// The environment variable's unencrypted value
    value: option<string>
  }
  set-env-var-value: func(params: set-env-var-value-params) -> result<string, string>;

  record delete-env-var-params {
    /// Scope response to account_id
    account-id: string,
    /// The environment variable key (case-sensitive)
    key: string,
    /// If provided, delete the environment variable from this site
    site-id: option<string>
  }
  delete-env-var: func(params: delete-env-var-params) -> result<string, string>;

  record delete-env-var-value-params {
    /// Scope response to account_id
    account-id: string,
    /// The environment variable value's ID
    id: string,
    /// The environment variable key name (case-sensitive)
    key: string,
    /// If provided, delete the value from an environment variable on this site
    site-id: option<string>
  }
  delete-env-var-value: func(params: delete-env-var-value-params) -> result<string, string>;

}

