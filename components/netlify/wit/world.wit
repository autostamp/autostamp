interface deploy {
  record deploy-files-files {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record function-schedule {
    cron: option<string>,
    name: option<string>
  }

  record deploy-files-functions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record deploy-files-functions-config {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-deploy-params {
    deploy-id: string
  }
  get-deploy: func(params: get-deploy-params) -> result<string, string>;

  record delete-deploy-params {
    deploy-id: string
  }
  delete-deploy: func(params: delete-deploy-params) -> result<string, string>;

  record cancel-site-deploy-params {
    deploy-id: string
  }
  cancel-site-deploy: func(params: cancel-site-deploy-params) -> result<string, string>;

  record lock-deploy-params {
    deploy-id: string
  }
  lock-deploy: func(params: lock-deploy-params) -> result<string, string>;

  record unlock-deploy-params {
    deploy-id: string
  }
  unlock-deploy: func(params: unlock-deploy-params) -> result<string, string>;

  list-site-deploys: func() -> result<string, string>;

  record create-site-deploy-params {
    title: option<string>,
    async-op: option<bool>,
    branch: option<string>,
    draft: option<bool>,
    files: option<deploy-files-files>,
    framework: option<string>,
    function-schedules: option<list<function-schedule>>,
    functions: option<deploy-files-functions>,
    functions-config: option<deploy-files-functions-config>
  }
  create-site-deploy: func(params: create-site-deploy-params) -> result<string, string>;

  record get-site-deploy-params {
    site-id: string,
    deploy-id: string
  }
  get-site-deploy: func(params: get-site-deploy-params) -> result<string, string>;

  record update-site-deploy-params {
    site-id: string,
    deploy-id: string,
    async-op: option<bool>,
    branch: option<string>,
    draft: option<bool>,
    files: option<deploy-files-files>,
    framework: option<string>,
    function-schedules: option<list<function-schedule>>,
    functions: option<deploy-files-functions>,
    functions-config: option<deploy-files-functions-config>
  }
  update-site-deploy: func(params: update-site-deploy-params) -> result<string, string>;

  record delete-site-deploy-params {
    deploy-id: string,
    site-id: string
  }
  delete-site-deploy: func(params: delete-site-deploy-params) -> result<string, string>;

  record restore-site-deploy-params {
    site-id: string,
    deploy-id: string
  }
  restore-site-deploy: func(params: restore-site-deploy-params) -> result<string, string>;

  rollback-site-deploy: func() -> result<string, string>;

}

