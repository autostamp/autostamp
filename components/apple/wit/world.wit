    forbidden(string),
    not-found(string),
    other(string)
  }

  variant app-get-to-one-related-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant builds-get-to-many-related-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  record get-collection-params {
    /// filter by attribute 'builds.expired'
    filter-builds-expired: option<list<string>>,
    /// filter by attribute 'builds.processingState'
    filter-builds-processing-state: option<list<get-collection-filter-builds-processing-state-item-enum>>,
    /// filter by attribute 'platform'
    filter-platform: option<list<get-collection-filter-platform-item-enum>>,
    /// filter by attribute 'version'
    filter-version: option<list<string>>,
    /// filter by id(s) of related 'app'
    filter-app: option<list<string>>,
    /// filter by id(s) of related 'builds'
    filter-builds: option<list<string>>,
    /// comma-separated list of sort expressions; resources will be sorted as specified
    sort: option<list<get-collection-sort-item-enum>>,
    /// the fields to include for returned resources of type preReleaseVersions
    fields-pre-release-versions: option<list<get-collection-fields-pre-release-versions-item-enum>>,
    /// maximum resources per page
    limit: option<s32>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type builds
    fields-builds: option<list<get-collection-fields-builds-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum number of related builds returned (when they are included)
    limit-builds: option<s32>
  }
  get-collection: func(params: get-collection-params) -> result<response, get-collection-error>;

  record get-instance-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type preReleaseVersions
    fields-pre-release-versions: option<list<get-collection-fields-pre-release-versions-item-enum>>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type builds
    fields-builds: option<list<get-collection-fields-builds-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum number of related builds returned (when they are included)
    limit-builds: option<s32>
  }
  get-instance: func(params: get-instance-params) -> result<prerelease-version-response, get-instance-error>;

  record app-get-to-one-related-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>
  }
  app-get-to-one-related: func(params: app-get-to-one-related-params) -> result<app-response, app-get-to-one-related-error>;

  record builds-get-to-many-related-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type builds
    fields-builds: option<list<get-collection-fields-builds-item-enum>>,
    /// maximum resources per page
    limit: option<s32>
  }
  builds-get-to-many-related: func(params: builds-get-to-many-related-params) -> result<builds-response, builds-get-to-many-related-error>;

}

interface profiles {
  enum get-collection-filter-profile-state-item-enum {
    active,
    invalid,
  }

  enum get-collection-filter-profile-type-item-enum {
    ios-app-development,
    ios-app-store,
    ios-app-adhoc,
    ios-app-inhouse,
    mac-app-development,
    mac-app-store,
    mac-app-direct,
    tvos-app-development,
    tvos-app-store,
    tvos-app-adhoc,
    tvos-app-inhouse,
    mac-catalyst-app-development,
    mac-catalyst-app-store,
    mac-catalyst-app-direct,
  }

  enum get-collection-sort-item-enum {
    id,
    id-v2,
    name,
    name-v2,
    profile-state,
    profile-state-v2,
    profile-type,
    profile-type-v2,
  }

  enum get-collection-fields-profiles-item-enum {
    bundle-id,
    certificates,
    created-date,
    devices,
    expiration-date,
    name,
    platform,
    profile-content,
    profile-state,
    profile-type,
    uuid,
  }

  enum get-collection-include-op-item-enum {
    bundle-id,
    certificates,
    devices,
  }

  enum get-collection-fields-certificates-item-enum {
    certificate-content,
    certificate-type,
    csr-content,
    display-name,
    expiration-date,
    name,
    platform,
    serial-number,
  }

  enum get-collection-fields-devices-item-enum {
    added-date,
    device-class,
    model,
    name,
    platform,
    status,
    udid,
  }

  enum get-collection-fields-bundle-ids-item-enum {
    app,
    bundle-id-capabilities,
    identifier,
    name,
    platform,
    profiles,
    seed-id,
  }

  enum profile-relationships-bundle-id-data-type-op-enum {
    bundle-ids,
  }

  enum profile-relationships-certificates-data-item-type-op-enum {
    certificates,
  }

  enum profile-relationships-devices-data-item-type-op-enum {
    devices,
  }

  enum profile-type-op-enum {
    profiles,
  }

  enum bundle-id-relationships-app-data-type-op-enum {
    apps,
  }

  enum bundle-id-relationships-bundle-id-capabilities-data-item-type-op-enum {
    bundle-id-capabilities,
  }

  enum device-attributes-device-class-enum {
    apple-watch,
    ipad,
    iphone,
    ipod,
    apple-tv,
    mac,
  }

  enum device-attributes-status-enum {
    enabled,
    disabled,
  }

  record response {
    data: list<profile>,
    included: option<list<string>>,
    links: paged-document-links,
    meta: option<paging-information>
  }

  record profile {
    attributes: option<profile-attributes>,
    id: string,
    links: resource-links,
    relationships: option<profile-relationships>,
    type-op: profile-type-op-enum
  }

  record profile-attributes {
    created-date: option<string>,
    expiration-date: option<string>,
    name: option<string>,
    platform: option<bundle-id-platform>,
    profile-content: option<string>,
    profile-state: option<get-collection-filter-profile-state-item-enum>,
    profile-type: option<get-collection-filter-profile-type-item-enum>,
    uuid: option<string>
  }

  record bundle-id-platform {
    /// opaque schema; raw JSON
    value: string
  }

  record resource-links {
    self: string
  }

  record profile-relationships {
    bundle-id: option<profile-relationships-bundle-id>,
    certificates: option<profile-relationships-certificates>,
    devices: option<profile-relationships-devices>
  }

  record profile-relationships-bundle-id {
    data: option<profile-relationships-bundle-id-data>,
    links: option<profile-relationships-bundle-id-links>
  }

  record profile-relationships-bundle-id-data {
    id: string,
    type-op: profile-relationships-bundle-id-data-type-op-enum
  }

  record profile-relationships-bundle-id-links {
    related: option<string>,
    self: option<string>
  }

  record profile-relationships-certificates {
    data: option<list<profile-relationships-certificates-data-item>>,
    links: option<profile-relationships-certificates-links>,
    meta: option<paging-information>
  }

  record profile-relationships-certificates-data-item {
    id: string,
    type-op: profile-relationships-certificates-data-item-type-op-enum
  }

  record profile-relationships-certificates-links {
    related: option<string>,
    self: option<string>
  }

  record paging-information {
    paging: paging-information-paging
  }

  record paging-information-paging {
    limit: s32,
    total: s32
  }

  record profile-relationships-devices {
    data: option<list<profile-relationships-devices-data-item>>,
    links: option<profile-relationships-devices-links>,
    meta: option<paging-information>
  }

  record profile-relationships-devices-data-item {
    id: string,
    type-op: profile-relationships-devices-data-item-type-op-enum
  }

  record profile-relationships-devices-links {
    related: option<string>,
    self: option<string>
  }

  record paged-document-links {
    first: option<string>,
    next: option<string>,
    self: string
  }

  record profile-create-request-data {
    attributes: profile-create-request-data-attributes,
    relationships: profile-create-request-data-relationships,
    type-op: profile-type-op-enum
  }

  record profile-create-request-data-attributes {
    name: string,
    profile-type: get-collection-filter-profile-type-item-enum
  }

  record profile-create-request-data-relationships {
    bundle-id: profile-create-request-data-relationships-bundle-id,
