    not-found(string),
    other(string)
  }

  record get-collection-params {
    /// filter by attribute 'locale'
    filter-locale: option<list<string>>,
    /// filter by id(s) of related 'app'
    filter-app: option<list<string>>,
    /// the fields to include for returned resources of type betaAppLocalizations
    fields-beta-app-localizations: option<list<get-collection-fields-beta-app-localizations-item-enum>>,
    /// maximum resources per page
    limit: option<s32>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>
  }
  get-collection: func(params: get-collection-params) -> result<response, get-collection-error>;

  record create-instance-params {
    data: beta-app-localization-create-request-data
  }
  create-instance: func(params: create-instance-params) -> result<beta-app-localization-response, create-instance-error>;

  record get-instance-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type betaAppLocalizations
    fields-beta-app-localizations: option<list<get-collection-fields-beta-app-localizations-item-enum>>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>
  }
  get-instance: func(params: get-instance-params) -> result<beta-app-localization-response, get-instance-error>;

  record update-instance-params {
    /// the id of the requested resource
    id: string,
    data: beta-app-localization-update-request-data
  }
  update-instance: func(params: update-instance-params) -> result<beta-app-localization-response, update-instance-error>;

  record delete-instance-params {
    /// the id of the requested resource
    id: string
  }
  delete-instance: func(params: delete-instance-params) -> result<string, delete-instance-error>;

  record app-get-to-one-related-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>
  }
  app-get-to-one-related: func(params: app-get-to-one-related-params) -> result<app-response, app-get-to-one-related-error>;

}

