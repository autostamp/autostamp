    id: string,
    type-op: user-invitation-relationships-visible-apps-data-item-type-op-enum
  }

  record user-invitation-response {
    data: user-invitation,
    included: option<list<app>>,
    links: document-links
  }

  record document-links {
    self: string
  }

  record apps-response {
    data: list<app>,
    included: option<list<string>>,
    links: paged-document-links,
    meta: option<paging-information>
  }

  variant get-collection-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant create-instance-error {
    bad-request(string),
    forbidden(string),
    conflict(string),
    other(string)
  }

  variant get-instance-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-instance-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant visible-apps-get-to-many-related-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  record get-collection-params {
    /// filter by attribute 'email'
    filter-email: option<list<string>>,
    /// filter by attribute 'roles'
    filter-roles: option<list<get-collection-filter-roles-item-enum>>,
    /// filter by id(s) of related 'visibleApps'
    filter-visible-apps: option<list<string>>,
    /// comma-separated list of sort expressions; resources will be sorted as specified
    sort: option<list<get-collection-sort-item-enum>>,
    /// the fields to include for returned resources of type userInvitations
    fields-user-invitations: option<list<get-collection-fields-user-invitations-item-enum>>,
    /// maximum resources per page
    limit: option<s32>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum number of related visibleApps returned (when they are included)
    limit-visible-apps: option<s32>
  }
  get-collection: func(params: get-collection-params) -> result<response, get-collection-error>;

  record create-instance-params {
    data: user-invitation-create-request-data
  }
  create-instance: func(params: create-instance-params) -> result<user-invitation-response, create-instance-error>;

  record get-instance-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type userInvitations
    fields-user-invitations: option<list<get-collection-fields-user-invitations-item-enum>>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum number of related visibleApps returned (when they are included)
    limit-visible-apps: option<s32>
  }
  get-instance: func(params: get-instance-params) -> result<user-invitation-response, get-instance-error>;

  record delete-instance-params {
    /// the id of the requested resource
    id: string
  }
  delete-instance: func(params: delete-instance-params) -> result<string, delete-instance-error>;

  record visible-apps-get-to-many-related-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum resources per page
    limit: option<s32>
  }
  visible-apps-get-to-many-related: func(params: visible-apps-get-to-many-related-params) -> result<apps-response, visible-apps-get-to-many-related-error>;

}

interface users {
  enum get-collection-filter-roles-item-enum {
    admin,
    finance,
    technical,
    account-holder,
    read-only,
    sales,
    marketing,
    app-manager,
    developer,
    access-to-reports,
    customer-support,
    create-apps,
    cloud-managed-developer-id,
    cloud-managed-app-distribution,
  }

  enum get-collection-sort-item-enum {
    last-name,
    last-name-v2,
    username,
    username-v2,
  }

  enum get-collection-fields-users-item-enum {
    all-apps-visible,
    first-name,
    last-name,
    provisioning-allowed,
    roles,
    username,
    visible-apps,
  }

  enum get-collection-include-op-item-enum {
    visible-apps,
  }

  enum get-collection-fields-apps-item-enum {
    app-infos,
    app-store-versions,
    available-in-new-territories,
    available-territories,
    beta-app-localizations,
    beta-app-review-detail,
    beta-groups,
    beta-license-agreement,
    beta-testers,
