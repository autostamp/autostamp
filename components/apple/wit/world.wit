  }

  record age-rating-declaration-response {
    data: age-rating-declaration,
    links: document-links
  }

  record age-rating-declaration {
    attributes: option<age-rating-declaration-attributes>,
    id: string,
    links: resource-links,
    type-op: age-rating-declaration-update-request-data-type-op-enum
  }

  record age-rating-declaration-attributes {
    alcohol-tobacco-or-drug-use-or-references: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
