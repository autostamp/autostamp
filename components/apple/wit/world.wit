interface beta-app-localizations {
  enum get-collection-fields-beta-app-localizations-item-enum {
    app,
    description,
    feedback-email,
    locale,
    marketing-url,
    privacy-policy-url,
    tv-os-privacy-policy,
  }

  enum get-collection-include-op-item-enum {
    app,
  }

  enum get-collection-fields-apps-item-enum {
    app-infos,
    app-store-versions,
    available-in-new-territories,
    available-territories,
    beta-app-localizations,
    beta-app-review-detail,
    beta-groups,
    beta-license-agreement,
    beta-testers,
    builds,
    bundle-id,
    content-rights-declaration,
    end-user-license-agreement,
    game-center-enabled-versions,
    in-app-purchases,
    is-or-ever-was-made-for-kids,
    name,
    perf-power-metrics,
    pre-order,
    pre-release-versions,
    prices,
    primary-locale,
    sku,
  }

  enum beta-app-localization-relationships-app-data-type-op-enum {
    apps,
  }

  enum beta-app-localization-type-op-enum {
    beta-app-localizations,
  }

  enum app-attributes-content-rights-declaration-enum {
    does-not-use-third-party-content,
    uses-third-party-content,
  }

  enum app-relationships-app-infos-data-item-type-op-enum {
    app-infos,
  }

  enum app-relationships-app-store-versions-data-item-type-op-enum {
    app-store-versions,
  }

  enum app-relationships-available-territories-data-item-type-op-enum {
    territories,
  }

  enum app-relationships-beta-app-review-detail-data-type-op-enum {
    beta-app-review-details,
  }

  enum app-relationships-beta-groups-data-item-type-op-enum {
    beta-groups,
  }

  enum app-relationships-beta-license-agreement-data-type-op-enum {
    beta-license-agreements,
  }

  enum app-relationships-builds-data-item-type-op-enum {
    builds,
  }

  enum app-relationships-end-user-license-agreement-data-type-op-enum {
    end-user-license-agreements,
  }

  enum app-relationships-game-center-enabled-versions-data-item-type-op-enum {
    game-center-enabled-versions,
  }

  enum app-relationships-in-app-purchases-data-item-type-op-enum {
    in-app-purchases,
  }

  enum app-relationships-pre-order-data-type-op-enum {
    app-pre-orders,
  }

  enum app-relationships-pre-release-versions-data-item-type-op-enum {
    pre-release-versions,
  }

  enum app-relationships-prices-data-item-type-op-enum {
    app-prices,
  }

  record response {
    data: list<beta-app-localization>,
    included: option<list<app>>,
    links: paged-document-links,
    meta: option<paging-information>
  }

  record beta-app-localization {
    attributes: option<beta-app-localization-attributes>,
    id: string,
    links: resource-links,
    relationships: option<beta-app-localization-relationships>,
    type-op: beta-app-localization-type-op-enum
  }

  record beta-app-localization-attributes {
    description: option<string>,
    feedback-email: option<string>,
    locale: option<string>,
    marketing-url: option<string>,
    privacy-policy-url: option<string>,
    tv-os-privacy-policy: option<string>
  }

  record resource-links {
    self: string
  }

  record beta-app-localization-relationships {
    app: option<beta-app-localization-relationships-app>
  }

  record beta-app-localization-relationships-app {
    data: option<beta-app-localization-relationships-app-data>,
    links: option<beta-app-localization-relationships-app-links>
  }

  record beta-app-localization-relationships-app-data {
    id: string,
    type-op: beta-app-localization-relationships-app-data-type-op-enum
  }

  record beta-app-localization-relationships-app-links {
    related: option<string>,
    self: option<string>
  }

  record app {
    attributes: option<app-attributes>,
    id: string,
    links: resource-links,
    relationships: option<app-relationships>,
    type-op: beta-app-localization-relationships-app-data-type-op-enum
  }

  record app-attributes {
    available-in-new-territories: option<bool>,
    bundle-id: option<string>,
    content-rights-declaration: option<app-attributes-content-rights-declaration-enum>,
    is-or-ever-was-made-for-kids: option<bool>,
    name: option<string>,
    primary-locale: option<string>,
    sku: option<string>
  }

  record app-relationships {
    app-infos: option<app-relationships-app-infos>,
    app-store-versions: option<app-relationships-app-store-versions>,
    available-territories: option<app-relationships-available-territories>,
    beta-app-localizations: option<app-relationships-beta-app-localizations>,
    beta-app-review-detail: option<app-relationships-beta-app-review-detail>,
    beta-groups: option<app-relationships-beta-groups>,
    beta-license-agreement: option<app-relationships-beta-license-agreement>,
