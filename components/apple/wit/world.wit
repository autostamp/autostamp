    gambling: option<bool>,
    gambling-and-contests: option<bool>,
    gambling-simulated: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
    horror-or-fear-themes: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
    kids-age-band: option<kids-age-band>,
    mature-or-suggestive-themes: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
    medical-or-treatment-information: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
    profanity-or-crude-humor: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
    seventeen-plus: option<bool>,
    sexual-content-graphic-and-nudity: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
