    data: option<list<app-relationships-pre-release-versions-data-item>>,
    links: option<app-relationships-pre-release-versions-links>,
    meta: option<paging-information>
  }

  record app-relationships-pre-release-versions-data-item {
    id: string,
    type-op: app-relationships-pre-release-versions-data-item-type-op-enum
  }

  record app-relationships-pre-release-versions-links {
    related: option<string>,
    self: option<string>
  }

  record app-relationships-prices {
    data: option<list<app-relationships-prices-data-item>>,
    links: option<app-relationships-prices-links>,
    meta: option<paging-information>
  }

  record app-relationships-prices-data-item {
    id: string,
    type-op: app-relationships-prices-data-item-type-op-enum
  }

  record app-relationships-prices-links {
    related: option<string>,
    self: option<string>
  }

  record paged-document-links {
    first: option<string>,
    next: option<string>,
    self: string
  }

  record user-response {
    data: user,
    included: option<list<app>>,
    links: document-links
  }

  record document-links {
    self: string
  }

  record user-update-request-data {
    attributes: option<user-update-request-data-attributes>,
    id: string,
    relationships: option<user-update-request-data-relationships>,
    type-op: user-type-op-enum
  }

  record user-update-request-data-attributes {
    all-apps-visible: option<bool>,
    provisioning-allowed: option<bool>,
    roles: option<list<user-role>>
  }

  record user-update-request-data-relationships {
    visible-apps: option<user-update-request-data-relationships-visible-apps>
  }

  record user-update-request-data-relationships-visible-apps {
    data: option<list<user-update-request-data-relationships-visible-apps-data-item>>
  }

  record user-update-request-data-relationships-visible-apps-data-item {
    id: string,
    type-op: user-relationships-visible-apps-data-item-type-op-enum
  }

  record user-visible-apps-linkages-response {
    data: list<user-visible-apps-linkages-response-data-item>,
    links: paged-document-links,
    meta: option<paging-information>
  }

  record user-visible-apps-linkages-response-data-item {
    id: string,
    type-op: user-relationships-visible-apps-data-item-type-op-enum
  }

  record user-visible-apps-linkages-request-data-item {
    id: string,
    type-op: user-relationships-visible-apps-data-item-type-op-enum
  }

  record apps-response {
    data: list<app>,
    included: option<list<string>>,
    links: paged-document-links,
    meta: option<paging-information>
  }

  variant get-collection-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant get-instance-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-instance-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant delete-instance-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant visible-apps-get-to-many-relationship-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant visible-apps-create-to-many-relationship-error {
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant visible-apps-replace-to-many-relationship-error {
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant visible-apps-delete-to-many-relationship-error {
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant visible-apps-get-to-many-related-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  record get-collection-params {
    /// filter by attribute 'roles'
    filter-roles: option<list<get-collection-filter-roles-item-enum>>,
    /// filter by attribute 'username'
    filter-username: option<list<string>>,
    /// filter by id(s) of related 'visibleApps'
    filter-visible-apps: option<list<string>>,
    /// comma-separated list of sort expressions; resources will be sorted as specified
    sort: option<list<get-collection-sort-item-enum>>,
    /// the fields to include for returned resources of type users
    fields-users: option<list<get-collection-fields-users-item-enum>>,
    /// maximum resources per page
    limit: option<s32>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum number of related visibleApps returned (when they are included)
    limit-visible-apps: option<s32>
  }
  get-collection: func(params: get-collection-params) -> result<response, get-collection-error>;

  record get-instance-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type users
    fields-users: option<list<get-collection-fields-users-item-enum>>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum number of related visibleApps returned (when they are included)
    limit-visible-apps: option<s32>
  }
  get-instance: func(params: get-instance-params) -> result<user-response, get-instance-error>;

  record update-instance-params {
    /// the id of the requested resource
    id: string,
    data: user-update-request-data
  }
  update-instance: func(params: update-instance-params) -> result<user-response, update-instance-error>;

  record delete-instance-params {
    /// the id of the requested resource
    id: string
  }
  delete-instance: func(params: delete-instance-params) -> result<string, delete-instance-error>;

  record visible-apps-get-to-many-relationship-params {
    /// the id of the requested resource
    id: string,
    /// maximum resources per page
    limit: option<s32>
  }
  visible-apps-get-to-many-relationship: func(params: visible-apps-get-to-many-relationship-params) -> result<user-visible-apps-linkages-response, visible-apps-get-to-many-relationship-error>;

  record visible-apps-create-to-many-relationship-params {
    /// the id of the requested resource
    id: string,
    data: list<user-visible-apps-linkages-request-data-item>
  }
  visible-apps-create-to-many-relationship: func(params: visible-apps-create-to-many-relationship-params) -> result<string, visible-apps-create-to-many-relationship-error>;

  record visible-apps-replace-to-many-relationship-params {
    /// the id of the requested resource
    id: string,
    data: list<user-visible-apps-linkages-request-data-item>
  }
  visible-apps-replace-to-many-relationship: func(params: visible-apps-replace-to-many-relationship-params) -> result<string, visible-apps-replace-to-many-relationship-error>;

  record visible-apps-delete-to-many-relationship-params {
    /// the id of the requested resource
    id: string,
    data: list<user-visible-apps-linkages-request-data-item>
  }
  visible-apps-delete-to-many-relationship: func(params: visible-apps-delete-to-many-relationship-params) -> result<string, visible-apps-delete-to-many-relationship-error>;

  record visible-apps-get-to-many-related-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum resources per page
    limit: option<s32>
  }
  visible-apps-get-to-many-related: func(params: visible-apps-get-to-many-related-params) -> result<apps-response, visible-apps-get-to-many-related-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
