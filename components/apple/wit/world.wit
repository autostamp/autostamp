interface app-categories {
  enum get-collection-filter-platforms-item-enum {
    ios,
    mac-os,
    tv-os,
  }

  enum get-collection-fields-app-categories-item-enum {
    parent,
    platforms,
    subcategories,
  }

  enum get-collection-include-op-item-enum {
    parent,
    subcategories,
  }

  enum app-category-relationships-parent-data-type-op-enum {
    app-categories,
  }

  record response {
    data: list<app-category>,
    included: option<list<string>>,
    links: paged-document-links,
    meta: option<paging-information>
  }

  record app-category {
    attributes: option<app-category-attributes>,
    id: string,
    links: resource-links,
    relationships: option<app-category-relationships>,
    type-op: app-category-relationships-parent-data-type-op-enum
  }

  record app-category-attributes {
    platforms: option<list<platform>>
  }

  record platform {
    /// opaque schema; raw JSON
    value: string
  }

  record resource-links {
    self: string
  }

  record app-category-relationships {
    parent: option<app-category-relationships-parent>,
    subcategories: option<app-category-relationships-subcategories>
  }

  record app-category-relationships-parent {
    data: option<app-category-relationships-parent-data>,
    links: option<app-category-relationships-parent-links>
  }

  record app-category-relationships-parent-data {
    id: string,
    type-op: app-category-relationships-parent-data-type-op-enum
  }

  record app-category-relationships-parent-links {
    related: option<string>,
    self: option<string>
  }

  record app-category-relationships-subcategories {
    data: option<list<app-category-relationships-subcategories-data-item>>,
    links: option<app-category-relationships-subcategories-links>,
    meta: option<paging-information>
  }

  record app-category-relationships-subcategories-data-item {
    id: string,
    type-op: app-category-relationships-parent-data-type-op-enum
  }

  record app-category-relationships-subcategories-links {
    related: option<string>,
    self: option<string>
  }

  record paging-information {
    paging: paging-information-paging
  }

  record paging-information-paging {
    limit: s32,
    total: s32
  }

  record paged-document-links {
    first: option<string>,
    next: option<string>,
    self: string
  }

  record app-category-response {
    data: app-category,
    included: option<list<string>>,
    links: document-links
  }

  record document-links {
    self: string
  }

  variant get-collection-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant get-instance-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant parent-get-to-one-related-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant subcategories-get-to-many-related-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  record get-collection-params {
    /// filter by attribute 'platforms'
    filter-platforms: option<list<get-collection-filter-platforms-item-enum>>,
    /// filter by existence or non-existence of related 'parent'
    exists-parent: option<list<string>>,
    /// the fields to include for returned resources of type appCategories
    fields-app-categories: option<list<get-collection-fields-app-categories-item-enum>>,
    /// maximum resources per page
    limit: option<s32>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// maximum number of related subcategories returned (when they are included)
    limit-subcategories: option<s32>
  }
  get-collection: func(params: get-collection-params) -> result<response, get-collection-error>;

  record get-instance-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type appCategories
    fields-app-categories: option<list<get-collection-fields-app-categories-item-enum>>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// maximum number of related subcategories returned (when they are included)
    limit-subcategories: option<s32>
  }
  get-instance: func(params: get-instance-params) -> result<app-category-response, get-instance-error>;

  record parent-get-to-one-related-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type appCategories
    fields-app-categories: option<list<get-collection-fields-app-categories-item-enum>>
  }
  parent-get-to-one-related: func(params: parent-get-to-one-related-params) -> result<app-category-response, parent-get-to-one-related-error>;

  record subcategories-get-to-many-related-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type appCategories
    fields-app-categories: option<list<get-collection-fields-app-categories-item-enum>>,
    /// maximum resources per page
    limit: option<s32>
  }
  subcategories-get-to-many-related: func(params: subcategories-get-to-many-related-params) -> result<response, subcategories-get-to-many-related-error>;

}

