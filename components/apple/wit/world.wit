interface bundle-id-capabilities {
  enum capability-setting-allowed-instances-enum {
    entry,
    single,
    multiple,
  }

  enum capability-setting-key-enum {
    icloud-version,
    data-protection-permission-level,
    apple-id-auth-app-consent,
  }

  enum capability-option-key-enum {
    xcode-v5,
    xcode-v6,
    complete-protection,
    protected-unless-open,
    protected-until-first-user-auth,
    primary-app-consent,
  }

  enum bundle-id-capability-create-request-data-relationships-bundle-id-data-type-op-enum {
    bundle-ids,
  }

  enum bundle-id-capability-create-request-data-type-op-enum {
    bundle-id-capabilities,
  }

  record bundle-id-capability-create-request-data {
    attributes: bundle-id-capability-create-request-data-attributes,
    relationships: bundle-id-capability-create-request-data-relationships,
    type-op: bundle-id-capability-create-request-data-type-op-enum
  }

  record bundle-id-capability-create-request-data-attributes {
    capability-type: capability-type,
    settings: option<list<capability-setting>>
  }

  record capability-type {
    /// opaque schema; raw JSON
    value: string
  }

  record capability-setting {
    allowed-instances: option<capability-setting-allowed-instances-enum>,
    description: option<string>,
    enabled-by-default: option<bool>,
    key: option<capability-setting-key-enum>,
    min-instances: option<s32>,
    name: option<string>,
    options: option<list<capability-option>>,
    visible: option<bool>
  }

  record capability-option {
    description: option<string>,
    enabled: option<bool>,
    enabled-by-default: option<bool>,
    key: option<capability-option-key-enum>,
    name: option<string>,
    supports-wildcard: option<bool>
  }

  record bundle-id-capability-create-request-data-relationships {
    bundle-id: bundle-id-capability-create-request-data-relationships-bundle-id
  }

  record bundle-id-capability-create-request-data-relationships-bundle-id {
    data: bundle-id-capability-create-request-data-relationships-bundle-id-data
  }

  record bundle-id-capability-create-request-data-relationships-bundle-id-data {
    id: string,
    type-op: bundle-id-capability-create-request-data-relationships-bundle-id-data-type-op-enum
  }

  record bundle-id-capability-update-request-data {
    attributes: option<bundle-id-capability-update-request-data-attributes>,
    id: string,
    type-op: bundle-id-capability-create-request-data-type-op-enum
  }

  record bundle-id-capability-update-request-data-attributes {
    capability-type: option<capability-type>,
    settings: option<list<capability-setting>>
  }

  record bundle-id-capabilities-create-instance-params {
    data: bundle-id-capability-create-request-data
  }
  bundle-id-capabilities-create-instance: func(params: bundle-id-capabilities-create-instance-params) -> result<string, string>;

  record bundle-id-capabilities-update-instance-params {
    data: bundle-id-capability-update-request-data
  }
  bundle-id-capabilities-update-instance: func(params: bundle-id-capabilities-update-instance-params) -> result<string, string>;

  bundle-id-capabilities-delete-instance: func() -> result<string, string>;

}

