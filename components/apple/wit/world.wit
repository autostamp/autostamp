  record get-collection-params {
    /// filter by attribute 'email'
    filter-email: option<list<string>>,
    /// filter by attribute 'firstName'
    filter-first-name: option<list<string>>,
    /// filter by attribute 'inviteType'
    filter-invite-type: option<list<get-collection-filter-invite-type-item-enum>>,
    /// filter by attribute 'lastName'
    filter-last-name: option<list<string>>,
    /// filter by id(s) of related 'apps'
    filter-apps: option<list<string>>,
    /// filter by id(s) of related 'betaGroups'
    filter-beta-groups: option<list<string>>,
    /// filter by id(s) of related 'builds'
    filter-builds: option<list<string>>,
    /// comma-separated list of sort expressions; resources will be sorted as specified
    sort: option<list<get-collection-sort-item-enum>>,
    /// the fields to include for returned resources of type betaTesters
    fields-beta-testers: option<list<get-collection-fields-beta-testers-item-enum>>,
    /// maximum resources per page
    limit: option<s32>,
    /// comma-separated list of relationships to include
    include-op: option<list<get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type betaGroups
    fields-beta-groups: option<list<get-collection-fields-beta-groups-item-enum>>,
    /// the fields to include for returned resources of type builds
    fields-builds: option<list<get-collection-fields-builds-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum number of related apps returned (when they are included)
    limit-apps: option<s32>,
    /// maximum number of related betaGroups returned (when they are included)
    limit-beta-groups: option<s32>,
    /// maximum number of related builds returned (when they are included)
    limit-builds: option<s32>
  }
  get-collection: func(params: get-collection-params) -> result<response, get-collection-error>;

  record create-instance-params {
    data: beta-tester-create-request-data
  }
  create-instance: func(params: create-instance-params) -> result<beta-tester-response, create-instance-error>;

  record get-instance-params {
    /// the id of the requested resource
    id: string,
    /// the fields to include for returned resources of type betaTesters
    fields-beta-testers: option<list<get-collection-fields-beta-testers-item-enum>>,
    /// comma-separated list of relationships to include
