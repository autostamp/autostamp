    violence-cartoon-or-fantasy: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
    violence-realistic: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>,
    violence-realistic-prolonged-graphic-or-sadistic: option<age-rating-declaration-update-request-data-attributes-alcohol-tobacco-or-drug-use-or-references-enum>
