    limit-visible-apps: option<s32>
  }
  users-get-collection: func(params: users-get-collection-params) -> result<string, string>;

  record users-get-instance-params {
    /// the fields to include for returned resources of type users
    fields-users: option<list<users-get-collection-fields-users-item-enum>>,
    /// comma-separated list of relationships to include
    include-op: option<list<users-get-collection-include-op-item-enum>>,
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<users-get-collection-fields-apps-item-enum>>,
    /// maximum number of related visibleApps returned (when they are included)
    limit-visible-apps: option<s32>
  }
  users-get-instance: func(params: users-get-instance-params) -> result<string, string>;

  record users-update-instance-params {
    data: user-update-request-data
  }
  users-update-instance: func(params: users-update-instance-params) -> result<string, string>;

  users-delete-instance: func() -> result<string, string>;

  record users-visible-apps-get-to-many-relationship-params {
    /// maximum resources per page
    limit: option<s32>
  }
  users-visible-apps-get-to-many-relationship: func(params: users-visible-apps-get-to-many-relationship-params) -> result<string, string>;

  record users-visible-apps-create-to-many-relationship-params {
    data: list<user-visible-apps-linkages-request-data-item>
  }
  users-visible-apps-create-to-many-relationship: func(params: users-visible-apps-create-to-many-relationship-params) -> result<string, string>;

  record users-visible-apps-replace-to-many-relationship-params {
    data: list<user-visible-apps-linkages-request-data-item>
  }
  users-visible-apps-replace-to-many-relationship: func(params: users-visible-apps-replace-to-many-relationship-params) -> result<string, string>;

  record users-visible-apps-delete-to-many-relationship-params {
    data: list<user-visible-apps-linkages-request-data-item>
  }
  users-visible-apps-delete-to-many-relationship: func(params: users-visible-apps-delete-to-many-relationship-params) -> result<string, string>;

  record users-visible-apps-get-to-many-related-params {
    /// the fields to include for returned resources of type apps
    fields-apps: option<list<users-get-collection-fields-apps-item-enum>>,
    /// maximum resources per page
    limit: option<s32>
  }
  users-visible-apps-get-to-many-related: func(params: users-visible-apps-get-to-many-related-params) -> result<string, string>;

}
