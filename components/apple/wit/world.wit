    /// the fields to include for returned resources of type apps
    fields-apps: option<list<get-collection-fields-apps-item-enum>>,
    /// maximum number of related apps returned (when they are included)
    limit-apps: option<s32>,
    /// maximum number of related betaGroups returned (when they are included)
    limit-beta-groups: option<s32>,
    /// maximum number of related builds returned (when they are included)
    limit-builds: option<s32>
  }
  get-instance: func(params: get-instance-params) -> result<beta-tester-response, get-instance-error>;

