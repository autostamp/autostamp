package autostamp:mandrillapp@0.5.0;

interface exports {
  record satus {
    created-at: option<string>,
    finished-at: option<string>,
    id: option<string>,
    result-url: option<string>,
    state: option<string>,
    type-op: option<string>
  }

  record info-response {
    created-at: option<string>,
    finished-at: option<string>,
    id: option<string>,
    result-url: option<string>,
    state: option<string>,
    type-op: option<string>
  }

  record list-response {
    /// opaque schema; raw JSON
    value: string
  }

  record post-exports-activity-json-params {
    api-keys: option<list<string>>,
    date-from: option<string>,
    date-to: option<string>,
    key: option<string>,
    notify-email: option<string>,
    senders: option<list<string>>,
    states: option<list<string>>,
    tags: option<list<string>>
  }
  post-exports-activity-json: func(params: post-exports-activity-json-params) -> result<satus, string>;

  record post-exports-info-json-params {
    id: option<string>,
    key: option<string>
  }
  post-exports-info-json: func(params: post-exports-info-json-params) -> result<info-response, string>;

  record post-exports-list-json-params {
    key: option<string>
  }
  post-exports-list-json: func(params: post-exports-list-json-params) -> result<list-response, string>;

  record post-exports-rejects-json-params {
    key: option<string>,
    notify-email: option<string>
  }
  post-exports-rejects-json: func(params: post-exports-rejects-json-params) -> result<satus, string>;

  record post-exports-whitelist-json-params {
    key: option<string>,
    notify-email: option<string>
  }
  post-exports-whitelist-json: func(params: post-exports-whitelist-json-params) -> result<satus, string>;

}


interface inbound {
  record info {
    created-at: option<string>,
    domain: option<string>,
    valid-mx: option<bool>
  }

  record route {
    id: option<string>,
    pattern: option<string>,
    url: option<string>
  }

  record domains-response {
    /// opaque schema; raw JSON
    value: string
  }

  record routes-response {
    /// opaque schema; raw JSON
    value: string
  }

  record send-raw-response {
    /// opaque schema; raw JSON
    value: string
  }

  record post-inbound-add-domain-json-params {
    domain: option<string>,
    key: option<string>
  }
  post-inbound-add-domain-json: func(params: post-inbound-add-domain-json-params) -> result<info, string>;

  record post-inbound-add-route-json-params {
    domain: option<string>,
    key: option<string>,
    pattern: option<string>,
    url: option<string>
  }
  post-inbound-add-route-json: func(params: post-inbound-add-route-json-params) -> result<route, string>;

  record post-inbound-check-domain-json-params {
    domain: option<string>,
    key: option<string>
  }
  post-inbound-check-domain-json: func(params: post-inbound-check-domain-json-params) -> result<info, string>;

  record post-inbound-delete-domain-json-params {
    domain: option<string>,
    key: option<string>
  }
  post-inbound-delete-domain-json: func(params: post-inbound-delete-domain-json-params) -> result<info, string>;

  record post-inbound-delete-route-json-params {
    id: option<string>,
    key: option<string>
  }
  post-inbound-delete-route-json: func(params: post-inbound-delete-route-json-params) -> result<route, string>;

  record post-inbound-domains-json-params {
    key: option<string>
  }
  post-inbound-domains-json: func(params: post-inbound-domains-json-params) -> result<domains-response, string>;

  record post-inbound-routes-json-params {
    domain: option<string>,
    key: option<string>
  }
  post-inbound-routes-json: func(params: post-inbound-routes-json-params) -> result<routes-response, string>;

  record post-inbound-send-raw-json-params {
    client-address: option<string>,
    helo: option<string>,
    key: option<string>,
    mail-from: option<string>,
    raw-message: option<string>,
    to: option<list<string>>
  }
  post-inbound-send-raw-json: func(params: post-inbound-send-raw-json-params) -> result<send-raw-response, string>;

  record post-inbound-update-route-json-params {
    id: option<string>,
    key: option<string>,
    pattern: option<string>,
    url: option<string>
  }
  post-inbound-update-route-json: func(params: post-inbound-update-route-json-params) -> result<route, string>;

}

interface ips {
  record ip-info {
    created-at: option<string>,
    custom-dns: option<ip-info-custom-dns>,
