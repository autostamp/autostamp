interface messages {
  record schedulingchange-info {
    id: option<string>,
    created-at: option<string>,
    from-email: option<string>,
    send-at: option<string>,
    subject: option<string>,
    to: option<string>
  }

  record content-response {
    id: option<string>,
    attachments: option<list<content-response-attachments-item>>,
    from-email: option<string>,
    from-name: option<string>,
    headers: option<content-response-headers>,
    html: option<string>,
    subject: option<string>,
    tags: option<list<string>>,
    text: option<string>,
    to: option<content-response-to>,
    ts: option<s32>
  }

  record content-response-attachments-item {
    content: option<string>,
    name: option<string>,
    type-op: option<string>
  }

  record content-response-headers {
    reply-to: option<string>
  }

  record content-response-to {
    email: option<string>,
    name: option<string>
  }

  record info-response {
    id: option<string>,
    clicks: option<s32>,
    clicks-detail: option<list<info-response-clicks-detail-item>>,
    email: option<string>,
    metadata: option<info-response-metadata>,
    opens: option<s32>,
    opens-detail: option<list<info-response-opens-detail-item>>,
    sender: option<string>,
    smtp-events: option<list<info-response-smtp-events-item>>,
    state: option<string>,
    subject: option<string>,
    tags: option<list<string>>,
    template: option<string>,
    ts: option<s32>
  }

  record info-response-clicks-detail-item {
    ip: option<string>,
    location: option<string>,
    ts: option<s32>,
    ua: option<string>,
    url: option<string>
  }

  record info-response-metadata {
    user-id: option<string>,
    website: option<string>
  }

  record info-response-opens-detail-item {
    ip: option<string>,
    location: option<string>,
    ts: option<s32>,
    ua: option<string>
  }

  record info-response-smtp-events-item {
    diag: option<string>,
    ts: option<s32>,
    type-op: option<string>
  }

  record list-scheduled-response {
    /// opaque schema; raw JSON
    value: string
  }

  record parse-response {
    attachments: option<list<parse-response-attachments-item>>,
    from-email: option<string>,
    from-name: option<string>,
    headers: option<parse-response-headers>,
    html: option<string>,
    images: option<list<parse-response-images-item>>,
    subject: option<string>,
    text: option<string>,
    to: option<list<parse-response-to-item>>
  }

  record parse-response-attachments-item {
    binary: option<bool>,
    content: option<string>,
    name: option<string>,
    type-op: option<string>
  }

  record parse-response-headers {
    reply-to: option<string>
  }

  record parse-response-images-item {
    content: option<string>,
    name: option<string>,
    type-op: option<string>
  }

  record parse-response-to-item {
    email: option<string>,
    name: option<string>
  }

  record timeseries {
    /// opaque schema; raw JSON
    value: string
  }

  record search-response {
    /// opaque schema; raw JSON
    value: string
  }

  record message-send-status {
    /// opaque schema; raw JSON
    value: string
  }

  record send-template-message {
    attachments: option<list<send-template-message-attachments-item>>,
    auto-html: option<string>,
    auto-text: option<string>,
    bcc-address: option<string>,
    from-email: option<string>,
    from-name: option<string>,
    global-merge-vars: option<list<send-template-message-global-merge-vars-item>>,
    google-analytics-campaign: option<string>,
    google-analytics-domains: option<list<string>>,
    headers: option<send-template-message-headers>,
    html: option<string>,
    images: option<list<send-template-message-images-item>>,
    important: option<bool>,
    inline-css: option<string>,
    merge: option<bool>,
    merge-vars: option<list<send-template-message-merge-vars-item>>,
    metadata: option<send-template-message-metadata>,
    preserve-recipients: option<string>,
    recipient-metadata: option<list<send-template-message-recipient-metadata-item>>,
    return-path-domain: option<string>,
    signing-domain: option<string>,
    subaccount: option<string>,
    subject: option<string>,
    tags: option<list<string>>,
    text: option<string>,
    to: option<list<send-template-message-to-item>>,
    track-clicks: option<string>,
    track-opens: option<string>,
    tracking-domain: option<string>,
    url-strip-qs: option<string>,
    view-content-link: option<string>
  }

  record send-template-message-attachments-item {
    content: option<string>,
    name: option<string>,
