    key: option<string>,
    pool: option<string>
  }
  post-ips-create-pool-json: func(params: post-ips-create-pool-json-params) -> result<pool, string>;

  record post-ips-delete-pool-json-params {
    key: option<string>,
    pool: option<string>
  }
  post-ips-delete-pool-json: func(params: post-ips-delete-pool-json-params) -> result<delete-pool-response, string>;

  record post-ips-delete-json-params {
    ip: option<string>,
    key: option<string>
  }
  post-ips-delete-json: func(params: post-ips-delete-json-params) -> result<delete-response, string>;

  record post-ips-info-json-params {
    ip: option<string>,
    key: option<string>
  }
  post-ips-info-json: func(params: post-ips-info-json-params) -> result<ip-info, string>;

  record post-ips-list-pools-json-params {
    key: option<string>
  }
  post-ips-list-pools-json: func(params: post-ips-list-pools-json-params) -> result<list-pools-response, string>;

  record post-ips-list-json-params {
    key: option<string>
  }
  post-ips-list-json: func(params: post-ips-list-json-params) -> result<list-response, string>;

  record post-ips-pool-info-json-params {
    key: option<string>,
    pool: option<string>
  }
  post-ips-pool-info-json: func(params: post-ips-pool-info-json-params) -> result<pool, string>;

  record post-ips-provision-json-params {
