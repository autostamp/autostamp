    google-analytics-domains: option<list<string>>,
    headers: option<send-message-headers>,
    html: option<string>,
    images: option<list<send-message-images-item>>,
    important: option<bool>,
    inline-css: option<string>,
    merge: option<bool>,
    merge-vars: option<list<send-message-merge-vars-item>>,
    metadata: option<send-message-metadata>,
    preserve-recipients: option<string>,
    recipient-metadata: option<list<send-message-recipient-metadata-item>>,
    return-path-domain: option<string>,
    signing-domain: option<string>,
    subaccount: option<string>,
    subject: option<string>,
    tags: option<list<string>>,
    text: option<string>,
    to: option<list<send-message-to-item>>,
    track-clicks: option<string>,
    track-opens: option<string>,
    tracking-domain: option<string>,
    url-strip-qs: option<string>,
