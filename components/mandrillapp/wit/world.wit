  }

  record send-message-attachments-item {
    content: option<string>,
    name: option<string>,
    type-op: option<string>
  }

  record send-message-global-merge-vars-item {
    content: option<string>,
    name: option<string>
  }

  record send-message-headers {
    reply-to: option<string>
  }

  record send-message-images-item {
    content: option<string>,
    name: option<string>,
    type-op: option<string>
  }

  record send-message-merge-vars-item {
    rcpt: option<string>,
    vars: option<list<send-message-merge-vars-item-vars-item>>
  }

  record send-message-merge-vars-item-vars-item {
    content: option<string>,
    name: option<string>
  }

  record send-message-metadata {
    website: option<string>
  }

  record send-message-recipient-metadata-item {
    rcpt: option<string>,
    values: option<send-message-recipient-metadata-item-values>
  }

  record send-message-recipient-metadata-item-values {
    user-id: option<s32>
  }

