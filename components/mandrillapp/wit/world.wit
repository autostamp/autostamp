    id: option<string>,
    key: option<string>
  }
  post-messages-cancel-scheduled-json: func(params: post-messages-cancel-scheduled-json-params) -> result<schedulingchange-info, string>;

  record post-messages-content-json-params {
    id: option<string>,
    key: option<string>
  }
  post-messages-content-json: func(params: post-messages-content-json-params) -> result<content-response, string>;

  record post-messages-info-json-params {
    id: option<string>,
    key: option<string>
  }
  post-messages-info-json: func(params: post-messages-info-json-params) -> result<info-response, string>;

