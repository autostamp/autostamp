package autostamp:postmarkapp@0.6.0;

interface domains-api {
  record domain-listing-results {
    domains: option<list<domain-information>>,
    total-count: option<s32>
  }

  record domain-information {
    dkim-verified: option<bool>,
    id: option<s64>,
    name: option<string>,
    return-path-domain-verified: option<bool>,
    spf-verified: option<bool>,
    weak-dkim: option<bool>
  }

  record domain-extended-information {
    dkim-host: option<string>,
    dkim-pending-host: option<string>,
    dkim-pending-text-value: option<string>,
    dkim-revoked-host: option<string>,
    dkim-revoked-text-value: option<string>,
    dkim-test-value: option<string>,
    dkim-update-status: option<string>,
    dkim-verified: option<bool>,
    id: option<s64>,
    name: option<string>,
    return-path-domain: option<string>,
    return-path-domain-cname-value: option<string>,
    return-path-domain-verified: option<bool>,
    spf-host: option<string>,
    spf-text-value: option<string>,
    spf-verified: option<bool>,
    safe-to-remove-revoked-key-from-dns: option<bool>,
    weak-dkim: option<bool>
  }

  /// A Postmark API error.
  record standard-postmark-response {
    error-code: option<s32>,
    message: option<string>
  }

  record dkim-rotation-response {
    dkim-host: option<string>,
    dkim-pending-host: option<string>,
    dkim-pending-text-value: option<string>,
    dkim-revoked-host: option<string>,
    dkim-revoked-text-value: option<string>,
    dkim-test-value: option<string>,
    dkim-update-status: option<string>,
    dkim-verified: option<bool>,
    id: option<s64>,
    name: option<string>,
    safe-to-remove-revoked-key-from-dns: option<bool>,
    weak-dkim: option<bool>
  }

  record domain-spf-result {
    spf-host: option<string>,
    spf-text-value: option<string>,
    spf-verified: option<bool>
  }

  variant list-domains-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant create-domain-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant get-domain-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant edit-domain-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-domain-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant rotate-dkim-key-for-domain-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant request-dkim-verification-for-domain-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant request-return-path-verification-for-domain-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant request-spf-verification-for-domain-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  /// List Domains
  record list-domains-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// Number of records to return per request. Max 500.
    count: s32,
    /// Number of records to skip
    offset: s32
  }
  list-domains: func(params: list-domains-params) -> result<domain-listing-results, list-domains-error>;

  /// Create a Domain
  record create-domain-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    name: option<string>,
    return-path-domain: option<string>
  }
  create-domain: func(params: create-domain-params) -> result<domain-extended-information, create-domain-error>;

  /// Get a Domain
  record get-domain-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Domain that should be retrieved.
    domainid: string
  }
  get-domain: func(params: get-domain-params) -> result<domain-extended-information, get-domain-error>;

  /// Update a Domain
  record edit-domain-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Domain that should be modified by the request.
    domainid: string,
    return-path-domain: option<string>
  }
  edit-domain: func(params: edit-domain-params) -> result<domain-extended-information, edit-domain-error>;

  /// Delete a Domain
  record delete-domain-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Domain that should be deleted by the request.
    domainid: string
  }
  delete-domain: func(params: delete-domain-params) -> result<standard-postmark-response, delete-domain-error>;

  /// Rotate DKIM Key
  record rotate-dkim-key-for-domain-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Sender Signature for which a new DKIM Key should be generated.
    domainid: string
  }
  rotate-dkim-key-for-domain: func(params: rotate-dkim-key-for-domain-params) -> result<dkim-rotation-response, rotate-dkim-key-for-domain-error>;

  /// Request DNS Verification for DKIM
  record request-dkim-verification-for-domain-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Domain for which DKIM DNS records should be verified.
    domainid: string
  }
  request-dkim-verification-for-domain: func(params: request-dkim-verification-for-domain-params) -> result<domain-extended-information, request-dkim-verification-for-domain-error>;

  /// Request DNS Verification for Return-Path
  record request-return-path-verification-for-domain-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Domain for which Return-Path DNS records should be verified.
    domainid: string
  }
  request-return-path-verification-for-domain: func(params: request-return-path-verification-for-domain-params) -> result<domain-extended-information, request-return-path-verification-for-domain-error>;

  /// Request DNS Verification for SPF
  record request-spf-verification-for-domain-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Domain for which SPF DNS records should be verified.
    domainid: string
  }
  request-spf-verification-for-domain: func(params: request-spf-verification-for-domain-params) -> result<domain-spf-result, request-spf-verification-for-domain-error>;

}


interface sender-signatures-api {
  record sender-listing-results {
    sender-signatures: option<list<sender-signature-information>>,
    total-count: option<s32>
  }

  record sender-signature-information {
    confirmed: option<bool>,
    domain: option<string>,
    email-address: option<string>,
    id: option<s64>,
    name: option<string>,
    reply-to-email-address: option<string>
  }

  record sender-signature-extended-information {
    confirmed: option<bool>,
    dkim-host: option<string>,
    dkim-pending-host: option<string>,
    dkim-pending-text-value: option<string>,
    dkim-revoked-host: option<string>,
    dkim-revoked-text-value: option<string>,
    dkim-test-value: option<string>,
    dkim-update-status: option<string>,
    dkim-verified: option<bool>,
    domain: option<string>,
    email-address: option<string>,
    id: option<s64>,
    name: option<string>,
    reply-to-email-address: option<string>,
    return-path-domain: option<string>,
    return-path-domain-cname-value: option<string>,
    return-path-domain-verified: option<bool>,
    spf-host: option<string>,
    spf-text-value: option<string>,
    spf-verified: option<bool>,
    safe-to-remove-revoked-key-from-dns: option<bool>,
    weak-dkim: option<bool>
  }

  /// A Postmark API error.
  record standard-postmark-response {
    error-code: option<s32>,
    message: option<string>
  }

  variant list-sender-signatures-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant create-sender-signature-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant get-sender-signature-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant edit-sender-signature-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-sender-signature-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant request-new-dkim-key-for-sender-signature-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant resend-sender-signature-confirmation-email-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant request-spf-verification-for-sender-signature-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  /// List Sender Signatures
  record list-sender-signatures-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// Number of records to return per request. Max 500.
    count: s32,
    /// Number of records to skip
    offset: s32
  }
  list-sender-signatures: func(params: list-sender-signatures-params) -> result<sender-listing-results, list-sender-signatures-error>;

  /// Create a Sender Signature
  record create-sender-signature-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    from-email: option<string>,
    name: option<string>,
    reply-to-email: option<string>,
    return-path-domain: option<string>
  }
  create-sender-signature: func(params: create-sender-signature-params) -> result<sender-signature-extended-information, create-sender-signature-error>;

  /// Get a Sender Signature
  record get-sender-signature-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Sender Signature that should be retrieved.
    signatureid: string
  }
  get-sender-signature: func(params: get-sender-signature-params) -> result<sender-signature-extended-information, get-sender-signature-error>;

  /// Update a Sender Signature
  record edit-sender-signature-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Sender Signature that should be modified by the request.
    signatureid: string,
    name: option<string>,
    reply-to-email: option<string>,
    return-path-domain: option<string>
  }
  edit-sender-signature: func(params: edit-sender-signature-params) -> result<sender-signature-extended-information, edit-sender-signature-error>;

  /// Delete a Sender Signature
  record delete-sender-signature-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Sender Signature that should be deleted by the request.
    signatureid: string
  }
  delete-sender-signature: func(params: delete-sender-signature-params) -> result<standard-postmark-response, delete-sender-signature-error>;

  /// Request a new DKIM Key
  record request-new-dkim-key-for-sender-signature-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Sender Signature for which a new DKIM Key should be generated.
    signatureid: string
  }
  request-new-dkim-key-for-sender-signature: func(params: request-new-dkim-key-for-sender-signature-params) -> result<standard-postmark-response, request-new-dkim-key-for-sender-signature-error>;

  /// Resend Signature Confirmation Email
  record resend-sender-signature-confirmation-email-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Sender Signature that should have its confirmation email resent.
    signatureid: string
  }
  resend-sender-signature-confirmation-email: func(params: resend-sender-signature-confirmation-email-params) -> result<standard-postmark-response, resend-sender-signature-confirmation-email-error>;

  /// Request DNS Verification for SPF
  record request-spf-verification-for-sender-signature-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID for the Sender Signature for which SPF DNS records should be verified.
    signatureid: string
  }
  request-spf-verification-for-sender-signature: func(params: request-spf-verification-for-sender-signature-params) -> result<sender-signature-extended-information, request-spf-verification-for-sender-signature-error>;

}

interface server-management-api {
  enum extended-server-info-track-links-enum {
    none,
    html-and-text-tracking,
    html-only-tracking,
    text-only-tracking,
  }

  /// The results of listing servers.
  record server-listing-response {
    servers: option<list<extended-server-info>>,
    total-count: option<s32>
  }

  record extended-server-info {
    api-tokens: option<list<string>>,
    bounce-hook-url: option<string>,
    click-hook-url: option<string>,
    color: option<string>,
    delivery-hook-url: option<string>,
    id: option<s32>,
    inbound-address: option<string>,
    inbound-domain: option<string>,
    inbound-hash: option<string>,
    inbound-hook-url: option<string>,
    inbound-spam-threshold: option<s32>,
    name: option<string>,
    open-hook-url: option<string>,
    post-first-open-only: option<bool>,
    raw-email-enabled: option<bool>,
    server-link: option<string>,
    smtp-api-activated: option<bool>,
    track-links: option<extended-server-info-track-links-enum>,
    track-opens: option<bool>
  }

  variant list-servers-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant create-server-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant get-server-information-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant edit-server-information-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-server-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  /// List servers
  record list-servers-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// Number of servers to return per request.
    count: s32,
    /// Number of servers to skip.
    offset: s32,
    /// Filter by a specific server name
    name: option<string>
  }
  list-servers: func(params: list-servers-params) -> result<server-listing-response, list-servers-error>;

  /// Create a Server
  record create-server-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    bounce-hook-url: option<string>,
    click-hook-url: option<string>,
    color: option<string>,
    delivery-hook-url: option<string>,
    inbound-domain: option<string>,
    inbound-hook-url: option<string>,
    inbound-spam-threshold: option<s32>,
    name: option<string>,
    open-hook-url: option<string>,
    post-first-open-only: option<bool>,
    raw-email-enabled: option<bool>,
    smtp-api-activated: option<bool>,
    track-links: option<extended-server-info-track-links-enum>,
    track-opens: option<bool>
  }
  create-server: func(params: create-server-params) -> result<extended-server-info, create-server-error>;

  /// Get a Server
  record get-server-information-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID of the Server to get.
    serverid: string
  }
  get-server-information: func(params: get-server-information-params) -> result<extended-server-info, get-server-information-error>;

  /// Edit a Server
  record edit-server-information-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID of the Server to update.
    serverid: string,
    bounce-hook-url: option<string>,
    click-hook-url: option<string>,
    color: option<string>,
    delivery-hook-url: option<string>,
    inbound-domain: option<string>,
    inbound-hook-url: option<string>,
    inbound-spam-threshold: option<s32>,
    name: option<string>,
    open-hook-url: option<string>,
    post-first-open-only: option<bool>,
    raw-email-enabled: option<bool>,
    smtp-api-activated: option<bool>,
    track-links: option<extended-server-info-track-links-enum>,
    track-opens: option<bool>
  }
  edit-server-information: func(params: edit-server-information-params) -> result<extended-server-info, edit-server-information-error>;

  /// Delete a Server
  record delete-server-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    /// The ID of the Server that should be deleted.
    serverid: string
  }
  delete-server: func(params: delete-server-params) -> result<string, delete-server-error>;

}

interface templates-api {
  record templates-push-response {
    templates: option<list<templates-push-response-templates-item>>,
    total-count: option<s32>
  }

  record templates-push-response-templates-item {
    action: option<string>,
    alias: option<string>,
    name: option<string>,
    template-id: option<s32>
  }

  variant push-templates-error {
    unprocessable-entity(string),
    internal-server-error(string),
    other(string)
  }

  /// Push templates from one server to another
  record push-templates-params {
    /// The token associated with the Account on which this request will operate.
    x-postmark-account-token: string,
    destination-server-id: option<s32>,
    perform-changes: option<bool>,
    source-server-id: option<s32>
  }
  push-templates: func(params: push-templates-params) -> result<templates-push-response, push-templates-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export domains-api;
  export sender-signatures-api;
  export server-management-api;
  export templates-api;
}
