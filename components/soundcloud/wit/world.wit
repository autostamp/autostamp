/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `AuthHeader` | header `Authorization` |
/// | `ClientId` | query `client_id` |
package autostamp:soundcloud@0.5.0;

interface oauth {
  enum get-connect-response-type-enum {
    code,
    token,
    code-and-token,
  }

  variant get-connect-error {
    found(string),
    unauthorized(string),
    other(string)
  }

  variant post-oauth2-token-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// The OAuth2 authorization endpoint. Your app redirects a user to this endpoint, allowing them to delegate access to their account.
  record get-connect-params {
    /// The redirect uri you have configured for your application
    redirect-uri: string,
    /// It's recommended to use "code" here
    response-type: get-connect-response-type-enum,
    /// Scope
    scope: string,
    /// Any value included here will be appended to the redirect URI. Use this for CSRF protection.
    state: option<string>
  }
  get-connect: func(params: get-connect-params) -> result<string, get-connect-error>;

  /// This endpoint accepts POST requests and is used to provision access tokens once a user has authorized your application.
  record post-oauth2-token-params {
    body: option<string>
  }
  post-oauth2-token: func(params: post-oauth2-token-params) -> result<string, post-oauth2-token-error>;

}


interface likes {
  variant post-likes-playlists-playlist-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant delete-likes-playlists-playlist-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant post-likes-tracks-track-id-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant delete-likes-tracks-track-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  /// Likes a playlist.
  record post-likes-playlists-playlist-id-params {
    /// SoundCloud playlist id
    playlist-id: string
  }
  post-likes-playlists-playlist-id: func(params: post-likes-playlists-playlist-id-params) -> result<string, post-likes-playlists-playlist-id-error>;

  /// Unlikes a playlist.
  record delete-likes-playlists-playlist-id-params {
    /// SoundCloud playlist id
    playlist-id: string
  }
  delete-likes-playlists-playlist-id: func(params: delete-likes-playlists-playlist-id-params) -> result<string, delete-likes-playlists-playlist-id-error>;

  /// Likes a track.
  record post-likes-tracks-track-id-params {
    /// SoundCloud Track id
    track-id: string
  }
  post-likes-tracks-track-id: func(params: post-likes-tracks-track-id-params) -> result<string, post-likes-tracks-track-id-error>;

  /// Unlikes a track.
  record delete-likes-tracks-track-id-params {
    /// SoundCloud Track id
    track-id: string
  }
  delete-likes-tracks-track-id: func(params: delete-likes-tracks-track-id-params) -> result<string, delete-likes-tracks-track-id-error>;

}

interface me {
  enum get-me-activities-access-item-enum {
    playable,
    preview,
    blocked,
  }

  /// SoundCloud Complete User object
  record complete-user {
    /// URL to a JPEG image.
    avatar-url: option<string>,
    /// city.
    city: option<string>,
    /// country.
    country: option<string>,
    /// description.
    description: option<string>,
    /// discogs name.
    discogs-name: option<string>,
    /// first name.
    first-name: option<string>,
    /// number of followers.
    followers-count: option<s32>,
    /// number of followed users.
    followings-count: option<s32>,
    /// first and last name.
    full-name: option<string>,
    /// unique identifier
    id: option<s32>,
    /// kind of resource.
    kind: option<string>,
    /// last modified timestamp.
    last-modified: option<string>,
    /// last name.
    last-name: option<string>,
    /// locale.
    locale: option<string>,
    /// myspace name
    myspace-name: option<string>,
    /// permalink of the resource.
    permalink: option<string>,
    /// URL to the SoundCloud.com page.
    permalink-url: option<string>,
    /// subscription plan of the user.
    plan: option<string>,
    /// number of public playlists.
    playlist-count: option<s32>,
    /// boolean if email is confirmed.
    primary-email-confirmed: option<bool>,
    /// number of private playlists.
    private-playlists-count: option<s32>,
    /// number of private tracks.
    private-tracks-count: option<s32>,
    /// number of favorited public tracks
    public-favorites-count: option<s32>,
    /// user's upload quota
    quota: option<complete-user-quota>,
    /// number of reposts from user
    reposts-count: option<s32>,
    /// a list subscriptions associated with the user
    subscriptions: option<string>,
    /// number of public tracks.
    track-count: option<s32>,
    /// API resource URL.
    uri: option<string>,
    /// username
    username: option<string>,
    /// a URL to the website.
    website: option<string>,
    /// a custom title for the website.
    website-title: option<string>
  }

  /// user's upload quota
  record complete-user-quota {
    /// unlimited upload quota.
    unlimited-upload-quota: option<bool>,
    /// upload seconds used.
    upload-seconds-used: option<s32>
  }

  /// User's activities.
  record activities {
    collection: option<list<activities-collection-item>>,
    future-href: option<string>,
    next-href: option<string>
  }

  record activities-collection-item {
    /// Created timestamp.
    created-at: option<string>,
    /// Origin.
    origin: option<string>,
    /// Type of activity (track).
    type-op: option<string>
  }

  record connections {
    /// opaque schema; raw JSON
    value: string
  }

  record connection {
    /// Created timestamp.
    created-at: option<string>,
    /// Full Name.
    display-name: option<string>,
    /// Unique identifier
    id: option<s32>,
    /// Kind of resource.
    kind: option<string>,
    post-favorite: option<bool>,
    post-publish: option<bool>,
    /// Service.
    service: option<string>,
    /// Type.
    type-op: option<string>,
    /// The external link URI.
    uri: option<string>
  }

  /// SoundCloud User object
  record user {
    /// URL to a JPEG image
    avatar-url: option<string>,
    /// city
    city: option<string>,
    /// country
    country: option<string>,
    /// profile creation datetime
    created-at: option<string>,
    /// description
    description: option<string>,
    /// discogs name
    discogs-name: option<string>,
    /// first name
    first-name: option<string>,
    /// number of followers
    followers-count: option<s32>,
    /// number of followed users
    followings-count: option<s32>,
    /// first and last name
    full-name: option<string>,
    /// unique identifier
    id: option<s32>,
    /// kind of resource
    kind: option<string>,
    /// last modified datetime
    last-modified: option<string>,
    /// last name
    last-name: option<string>,
    /// myspace name
    myspace-name: option<string>,
    /// permalink of the resource
    permalink: option<string>,
    /// URL to the SoundCloud.com page
    permalink-url: option<string>,
    /// subscription plan of the user
    plan: option<string>,
    /// number of public playlists
    playlist-count: option<s32>,
    /// number of favorited public tracks
    public-favorites-count: option<s32>,
    /// number of reposts from user
    reposts-count: option<s32>,
    /// a list subscriptions associated with the user
    subscriptions: option<string>,
    /// number of public tracks
    track-count: option<s32>,
    /// API resource URL
    uri: option<string>,
    /// username
    username: option<string>,
    /// a URL to the website
    website: option<string>,
    /// a custom title for the website
    website-title: option<string>
  }

  record tracks-list {
    /// opaque schema; raw JSON
    value: string
  }

  record playlists-array {
    /// opaque schema; raw JSON
    value: string
  }

  /// Soundcloud Playlist Object
  record playlist {
    /// URL to a JPEG image.
    artwork-url: option<string>,
    /// Created timestamp.
    created-at: option<string>,
    /// Playlist description.
    description: option<string>,
    /// is downloadable.
    downloadable: option<bool>,
    /// Playlist duration.
    duration: option<s32>,
    /// European Article Number.
    ean: option<string>,
    /// Embeddable by.
    embeddable-by: option<string>,
    /// Playlist genre.
    genre: option<string>,
    /// Playlist identifier.
    id: option<s32>,
    /// Type of Soundcloud object (playlist).
    kind: option<string>,
    label: option<meta-user>,
    /// Label user identifier.
    label-id: option<s32>,
    /// Label name.
    label-name: option<string>,
    /// Last modified timestamp.
    last-modified: option<string>,
    /// License.
    license: option<string>,
    /// Count of playlist likes.
    likes-count: option<s32>,
    /// Playlist permalink.
    permalink: option<string>,
    /// Playlist permalink URL.
    permalink-url: option<string>,
    /// Type of playlist.
    playlist-type: option<string>,
    /// Purchase title.
    purchase-title: option<string>,
    /// Purchase URL.
    purchase-url: option<string>,
    /// Release.
    release: option<string>,
    /// Day of release.
    release-day: option<s32>,
    /// Month of release.
    release-month: option<s32>,
    /// Year of release.
    release-year: option<s32>,
    /// Type of sharing (private/public).
    sharing: option<string>,
    /// Is streamable.
    streamable: option<bool>,
    /// Tags.
    tag-list: option<string>,
    /// Tags.
    tags: option<string>,
    /// Playlist title.
    title: option<string>,
    /// Count of tracks.
    track-count: option<s32>,
    /// List of tracks.
    tracks: option<list<track>>,
    /// tracks URI.
    tracks-uri: option<string>,
    /// Playlist type.
    type-op: option<string>,
    /// Playlist URI.
    uri: option<string>,
    user: option<meta-user>,
    /// User identifier.
    user-id: option<s32>
  }

  /// SoundCloud User object.
  record meta-user {
    /// URL to a JPEG image
    avatar-url: option<string>,
    /// profile creation datetime
    created-at: option<string>,
    /// unique identifier
    id: option<s32>,
    /// kind of resource
    kind: option<string>,
    /// last modified datetime
    last-modified: option<string>,
    /// permalink of the resource
    permalink: option<string>,
    /// URL to the SoundCloud.com page
    permalink-url: option<string>,
    /// API resource URL
    uri: option<string>,
    /// username
    username: option<string>
  }

  /// Soundcloud Track object.
  record track {
    /// Level of access the user (logged in or anonymous) has to the track.
    ///   * `playable` - user is allowed to listen to a full track.
    access: option<get-me-activities-access-item-enum>,
    /// URL to a JPEG image.
    artwork-url: option<string>,
    /// List of countries where track is available.
    available-country-codes: option<string>,
    /// Tempo.
    bpm: option<s32>,
    /// Number of comments.
    comment-count: option<s32>,
    /// Is commentable.
    commentable: option<bool>,
    /// Created timestamp.
    created-at: option<string>,
    /// Track description.
    description: option<string>,
    /// NUmber of downloads.
    download-count: option<s32>,
    /// URL to download a track.
    download-url: option<string>,
    /// Is downloadable.
    downloadable: option<string>,
    /// Track duration.
    duration: option<s32>,
    /// Embeddable by.
    embeddable-by: option<string>,
    /// Number of favoritings.
    favoritings-count: option<s32>,
    /// Genre
    genre: option<string>,
    /// Track identifier.
    id: option<s32>,
    /// ISRC code.
    isrc: option<string>,
    /// Key signature.
    key-signature: option<string>,
    /// Type of object (track).
    kind: option<string>,
    /// Label user name.
    label-name: option<string>,
    /// License
    license: option<string>,
    /// Permalink URL.
    permalink-url: option<string>,
    /// Number of plays.
    playback-count: option<s32>,
    /// Purchase title.
    purchase-title: option<string>,
    /// Purchase URL.
    purchase-url: option<string>,
    /// Release.
    release: option<string>,
    /// Day of release.
    release-day: option<s32>,
    /// Month of release.
    release-month: option<s32>,
    /// Year of release.
    release-year: option<s32>,
    /// Number of reposts.
    reposts-count: option<s32>,
    /// Secret URL.
    secret-uri: option<string>,
    /// Type of sharing (public/private).
    sharing: option<string>,
    /// URL to stream.
    stream-url: option<string>,
    /// Is streamable.
    streamable: option<bool>,
    /// Tags.
    tag-list: option<string>,
    /// Track title.
    title: option<string>,
    /// Track URI.
    uri: option<string>,
    user: option<meta-user>,
    /// Is user's favourite.
    user-favorite: option<bool>,
    /// Number of plays by a user.
    user-playback-count: option<s32>,
    /// Waveform URL.
    waveform-url: option<string>
  }

  variant get-me-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-activities-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-activities-all-own-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-activities-tracks-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-connections-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-connections-connection-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-me-favorites-ids-error {
    not-found(string),
    other(string)
  }

  variant get-me-followers-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-followers-follower-id-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-followings-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-followings-tracks-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-followings-user-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant put-me-followings-user-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-me-followings-user-id-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-me-likes-tracks-error {
    unauthorized(string),
    other(string)
  }

  variant get-me-playlists-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-me-tracks-error {
    unauthorized(string),
    other(string)
  }

  /// Returns the authenticated user’s information.
  get-me: func() -> result<complete-user, get-me-error>;

  /// Returns the authenticated user's activities.
  record get-me-activities-params {
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-me-activities-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-me-activities: func(params: get-me-activities-params) -> result<activities, get-me-activities-error>;

  /// Recent the authenticated user's activities.
  record get-me-activities-all-own-params {
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-me-activities-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-me-activities-all-own: func(params: get-me-activities-all-own-params) -> result<activities, get-me-activities-all-own-error>;

  /// Returns the authenticated user's recent track related activities.
  record get-me-activities-tracks-params {
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-me-activities-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-me-activities-tracks: func(params: get-me-activities-tracks-params) -> result<activities, get-me-activities-tracks-error>;

  /// Returns a list of the authenticated user's connected social accounts.
  record get-me-connections-params {
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>
  }
  get-me-connections: func(params: get-me-connections-params) -> result<connections, get-me-connections-error>;

  /// Returns the authenticated user's connected social account.
  record get-me-connections-connection-id-params {
    /// SoundCloud connection id
    connection-id: string
  }
  get-me-connections-connection-id: func(params: get-me-connections-connection-id-params) -> result<connection, get-me-connections-connection-id-error>;

  /// Returns user’s favorites ids. (use /me/likes/tracks instead to fetch the authenticated user's likes)
  record get-me-favorites-ids-params {
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-me-favorites-ids: func(params: get-me-favorites-ids-params) -> result<string, get-me-favorites-ids-error>;

  /// Returns a list of users who are following the authenticated user.
  record get-me-followers-params {
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-me-followers: func(params: get-me-followers-params) -> result<string, get-me-followers-error>;

  /// Returns a user who is following the authenticated user. (use /users/{user_id} instead, to fetch the user details)
  record get-me-followers-follower-id-params {
    /// SoundCloud User id to denote a Follower
    follower-id: string
  }
  get-me-followers-follower-id: func(params: get-me-followers-follower-id-params) -> result<user, get-me-followers-follower-id-error>;

  /// Returns a list of users who are followed by the authenticated user.
  record get-me-followings-params {
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>
  }
  get-me-followings: func(params: get-me-followings-params) -> result<string, get-me-followings-error>;

  /// Returns a list of recent tracks from users followed by the authenticated user.
  record get-me-followings-tracks-params {
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-me-activities-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>
  }
  get-me-followings-tracks: func(params: get-me-followings-tracks-params) -> result<tracks-list, get-me-followings-tracks-error>;

  /// Returns a user who is followed by the authenticated user. (use /users/{user_id} instead, to fetch the user details)
  record get-me-followings-user-id-params {
    /// SoundCloud User id
    user-id: string
  }
  get-me-followings-user-id: func(params: get-me-followings-user-id-params) -> result<user, get-me-followings-user-id-error>;

  /// Follows a user.
  record put-me-followings-user-id-params {
    /// SoundCloud User id
    user-id: string
  }
  put-me-followings-user-id: func(params: put-me-followings-user-id-params) -> result<string, put-me-followings-user-id-error>;

  /// Deletes a user who is followed by the authenticated user.
  record delete-me-followings-user-id-params {
    /// SoundCloud User id
    user-id: string
  }
  delete-me-followings-user-id: func(params: delete-me-followings-user-id-params) -> result<string, delete-me-followings-user-id-error>;

  /// Returns a list of favorited or liked tracks of the authenticated user.
  record get-me-likes-tracks-params {
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-me-likes-tracks: func(params: get-me-likes-tracks-params) -> result<string, get-me-likes-tracks-error>;

  /// Returns user’s playlists (sets).
  record get-me-playlists-params {
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-me-playlists: func(params: get-me-playlists-params) -> result<playlists-array, get-me-playlists-error>;

  /// Returns playlist. (use /playlists/{playlist_id} instead, to fetch the playlist details)
  record get-me-playlists-playlist-id-params {
    /// SoundCloud playlist id
    playlist-id: string
  }
  get-me-playlists-playlist-id: func(params: get-me-playlists-playlist-id-params) -> result<playlist, string>;

  /// Returns a list of user's tracks.
  record get-me-tracks-params {
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-me-tracks: func(params: get-me-tracks-params) -> result<string, get-me-tracks-error>;

  /// Returns a specified track. (use /tracks/{track_id} instead, to fetch the track details)
  record get-me-tracks-track-id-params {
    /// SoundCloud Track id
    track-id: string
  }
  get-me-tracks-track-id: func(params: get-me-tracks-track-id-params) -> result<track, string>;

}

interface search {
  enum get-playlists-access-item-enum {
    playable,
    preview,
    blocked,
  }

  variant get-playlists-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-tracks-error {
    bad-request(string),
    unauthorized(string),
    internal-server-error(string),
    other(string)
  }

  variant get-users-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// Performs a playlist search based on a query
  record get-playlists-params {
    /// search
    q: string,
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-playlists-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-playlists: func(params: get-playlists-params) -> result<string, get-playlists-error>;

  /// Performs a track search based on a query
  record get-tracks-params {
    /// search
    q: string,
    /// A comma separated list of track ids to filter on
    ids: option<string>,
    /// A comma separated list of genres
    genres: option<string>,
    /// A comma separated list of tags
    tags: option<string>,
    /// Return tracks with a specified bpm[from], bpm[to]
    bpm: option<string>,
    /// Return tracks within a specified duration range
    duration: option<string>,
    /// (yyyy-mm-dd hh:mm:ss) return tracks created within the specified dates
    created-at: option<string>,
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-playlists-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-tracks: func(params: get-tracks-params) -> result<string, get-tracks-error>;

  /// Performs a user search based on a query
  record get-users-params {
    /// search
    q: string,
    /// A comma separated list of track ids to filter on
    ids: option<string>,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-users: func(params: get-users-params) -> result<string, get-users-error>;

}

