  record meta-user {
    /// URL to a JPEG image
    avatar-url: option<string>,
    /// profile creation datetime
    created-at: option<string>,
    /// unique identifier
    id: option<s32>,
    /// kind of resource
    kind: option<string>,
    /// last modified datetime
    last-modified: option<string>,
    /// permalink of the resource
    permalink: option<string>,
    /// URL to the SoundCloud.com page
    permalink-url: option<string>,
    /// API resource URL
    uri: option<string>,
    /// username
    username: option<string>
  }

  record track-metadata-request-track {
    commentable: option<bool>,
    description: option<string>,
    downloadable: option<bool>,
    /// who can embed this track "all", "me", or "none"
    embeddable-by: option<track-data-request-track-embeddable-by-enum>,
    genre: option<string>,
    isrc: option<string>,
    label-name: option<string>,
    /// Possible values: no-rights-reserved, all-rights-reserved, cc-by, cc-by-nc, cc-by-nd, cc-by-sa, cc-by-nc-nd, cc-by-nc-sa
    license: option<track-data-request-track-license-enum>,
    permalink: option<string>,
    purchase-url: option<string>,
    release: option<string>,
    /// string, formatted as yyyy-mm-dd, representing release date
    release-date: option<string>,
    sharing: option<track-data-request-track-sharing-enum>,
    streamable: option<bool>,
    /// The tag_list property contains a list of tags separated by spaces. Multiword tags are quoted in double quotes. We also support machine tags that follow the pattern NAMESPACE:KEY=VALUE. For example: geo:lat=43.555 camel:size=medium “machine:tag=with space” Machine tags are not revealed to the user on the track pages.
    tag-list: option<string>,
    title: option<string>
  }

  record post-tracks-track-id-comments-body-comment {
    /// Comment's content
    body: string,
    /// Timestamp of a comment. String or float representation is supported
    timestamp: option<string>
  }

  /// User's Comment
  record comment {
    /// Comment body.
    body: option<string>,
    /// Created timestamp.
    created-at: option<string>,
    /// Identifier.
    id: option<s32>,
    /// Kind (comment).
    kind: option<string>,
    /// Timestamp.
    timestamp: option<string>,
    /// Track's identifier.
    track-id: option<s32>,
    /// Comment's URL.
    uri: option<string>,
    /// SoundCloud User object
    user: option<comment-user>,
    /// User's identifier.
    user-id: option<s32>
  }

  /// SoundCloud User object
  record comment-user {
    /// URL to a JPEG image.
    avatar-url: option<string>,
    /// number of followers.
    followers-count: option<s32>,
    /// number of followed users.
    followings-count: option<s32>,
    /// unique identifier
    id: option<s32>,
    /// kind of resource.
    kind: option<string>,
    /// last modified timestamp.
    last-modified: option<string>,
    /// permalink of the resource.
    permalink: option<string>,
    /// URL to the SoundCloud.com page.
    permalink-url: option<string>,
    /// number of reposts from user
    reposts-count: option<s32>,
    /// API resource URL.
    uri: option<string>,
    /// username
    username: option<string>
  }

  record users-list {
    /// opaque schema; raw JSON
    value: string
  }

  record meta-users {
    collection: option<list<meta-user>>,
    next-href: option<string>
  }

  record streams {
    hls-mp3-v128-url: option<string>,
    hls-opus-v64-url: option<string>,
    http-mp3-v128-url: option<string>,
    preview-mp3-v128-url: option<string>
  }

  variant post-tracks-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant get-tracks-track-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant put-tracks-track-id-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  variant delete-tracks-track-id-error {
    not-found(string),
    other(string)
  }

  variant get-tracks-track-id-comments-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant post-tracks-track-id-comments-error {
    unprocessable-entity(string),
    too-many-requests(string),
    other(string)
  }

  variant get-tracks-track-id-favoriters-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-tracks-track-id-related-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-tracks-track-id-reposters-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-tracks-track-id-streams-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Uploads a new track.
  record post-tracks-params {
    track-artwork-data: option<string>,
    track-asset-data: option<string>,
    track-commentable: option<bool>,
    track-description: option<string>,
    track-downloadable: option<bool>,
    /// who can embed this track "all", "me", or "none"
    track-embeddable-by: option<track-data-request-track-embeddable-by-enum>,
    track-genre: option<string>,
    track-isrc: option<string>,
    track-label-name: option<string>,
    /// Possible values: no-rights-reserved, all-rights-reserved, cc-by, cc-by-nc, cc-by-nd, cc-by-sa, cc-by-nc-nd, cc-by-nc-sa
    track-license: option<track-data-request-track-license-enum>,
    track-permalink: option<string>,
    track-purchase-url: option<string>,
    track-release: option<string>,
    /// string, formatted as yyyy-mm-dd, representing release date
    track-release-date: option<string>,
    track-sharing: option<track-data-request-track-sharing-enum>,
    track-streamable: option<bool>,
    /// The tag_list property contains a list of tags separated by spaces. Multiword tags are quoted in double quotes. We also support machine tags that follow the pattern NAMESPACE:KEY=VALUE. For example: geo:lat=43.555 camel:size=medium “machine:tag=with space” Machine tags are not revealed to the user on the track pages.
    track-tag-list: option<string>,
    track-title: option<string>
  }
  post-tracks: func(params: post-tracks-params) -> result<track, post-tracks-error>;

  /// Returns a track.
  record get-tracks-track-id-params {
    /// SoundCloud Track id
    track-id: string,
    /// A secret token to fetch private playlists/tracks
    secret-token: option<string>
  }
  get-tracks-track-id: func(params: get-tracks-track-id-params) -> result<track, get-tracks-track-id-error>;

  /// Updates a track's information.
  record put-tracks-track-id-params {
    /// SoundCloud Track id
    track-id: string,
    track: option<track-metadata-request-track>
  }
  put-tracks-track-id: func(params: put-tracks-track-id-params) -> result<track, put-tracks-track-id-error>;

  /// Deletes a track.
  record delete-tracks-track-id-params {
    /// SoundCloud Track id
    track-id: string
  }
  delete-tracks-track-id: func(params: delete-tracks-track-id-params) -> result<string, delete-tracks-track-id-error>;

  /// Returns the comments posted on the track(track_id).
  record get-tracks-track-id-comments-params {
    /// SoundCloud Track id
    track-id: string,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-tracks-track-id-comments: func(params: get-tracks-track-id-comments-params) -> result<string, get-tracks-track-id-comments-error>;

  /// Returns the newly created comment on success
  record post-tracks-track-id-comments-params {
    /// SoundCloud Track id
    track-id: string,
    comment: option<post-tracks-track-id-comments-body-comment>
  }
  post-tracks-track-id-comments: func(params: post-tracks-track-id-comments-params) -> result<comment, post-tracks-track-id-comments-error>;

  /// Returns a list of users who have favorited or liked the track.
  record get-tracks-track-id-favoriters-params {
    /// SoundCloud Track id
    track-id: string,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>
  }
  get-tracks-track-id-favoriters: func(params: get-tracks-track-id-favoriters-params) -> result<users-list, get-tracks-track-id-favoriters-error>;

  /// Returns all related tracks of track on SoundCloud.
  record get-tracks-track-id-related-params {
    /// SoundCloud Track id
    track-id: string,
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<track-access-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-tracks-track-id-related: func(params: get-tracks-track-id-related-params) -> result<string, get-tracks-track-id-related-error>;

  /// Returns a collection of track's reposters.
  record get-tracks-track-id-reposters-params {
    /// SoundCloud Track id
    track-id: string,
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-tracks-track-id-reposters: func(params: get-tracks-track-id-reposters-params) -> result<meta-users, get-tracks-track-id-reposters-error>;

  /// Returns a track's streamable URLs
  record get-tracks-track-id-streams-params {
    /// SoundCloud Track id
    track-id: string,
    /// A secret token to fetch private playlists/tracks
    secret-token: option<string>
  }
  get-tracks-track-id-streams: func(params: get-tracks-track-id-streams-params) -> result<streams, get-tracks-track-id-streams-error>;

}

interface users {
  enum get-users-user-id-likes-tracks-access-item-enum {
    playable,
    preview,
    blocked,
  }

  /// SoundCloud Complete User object
  record complete-user {
    /// URL to a JPEG image.
    avatar-url: option<string>,
    /// city.
    city: option<string>,
    /// country.
    country: option<string>,
    /// description.
    description: option<string>,
    /// discogs name.
    discogs-name: option<string>,
    /// first name.
    first-name: option<string>,
    /// number of followers.
    followers-count: option<s32>,
    /// number of followed users.
    followings-count: option<s32>,
    /// first and last name.
    full-name: option<string>,
    /// unique identifier
    id: option<s32>,
    /// kind of resource.
    kind: option<string>,
    /// last modified timestamp.
    last-modified: option<string>,
    /// last name.
    last-name: option<string>,
    /// locale.
    locale: option<string>,
    /// myspace name
    myspace-name: option<string>,
    /// permalink of the resource.
    permalink: option<string>,
    /// URL to the SoundCloud.com page.
    permalink-url: option<string>,
    /// subscription plan of the user.
    plan: option<string>,
    /// number of public playlists.
    playlist-count: option<s32>,
    /// boolean if email is confirmed.
    primary-email-confirmed: option<bool>,
    /// number of private playlists.
    private-playlists-count: option<s32>,
    /// number of private tracks.
    private-tracks-count: option<s32>,
    /// number of favorited public tracks
    public-favorites-count: option<s32>,
    /// user's upload quota
    quota: option<complete-user-quota>,
    /// number of reposts from user
    reposts-count: option<s32>,
    /// a list subscriptions associated with the user
    subscriptions: option<string>,
    /// number of public tracks.
    track-count: option<s32>,
    /// API resource URL.
    uri: option<string>,
    /// username
    username: option<string>,
    /// a URL to the website.
    website: option<string>,
    /// a custom title for the website.
    website-title: option<string>
  }

  /// user's upload quota
  record complete-user-quota {
    /// unlimited upload quota.
    unlimited-upload-quota: option<bool>,
    /// upload seconds used.
    upload-seconds-used: option<s32>
  }

  record comments-list {
    /// opaque schema; raw JSON
    value: string
  }

  /// User's links added to their profile
  record web-profiles {
    /// opaque schema; raw JSON
    value: string
  }

  variant get-users-user-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-users-user-id-comments-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-users-user-id-favorites-error {
    unauthorized(string),
    other(string)
  }

  variant get-users-user-id-followers-error {
    unauthorized(string),
    other(string)
  }

  variant get-users-user-id-followings-error {
    unauthorized(string),
    other(string)
  }

  variant get-users-user-id-followings-following-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-users-user-id-likes-tracks-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-users-user-id-playlists-error {
    unauthorized(string),
    other(string)
  }

  variant get-users-user-id-tracks-error {
    unauthorized(string),
    other(string)
  }

  variant get-users-user-id-web-profiles-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Returns a user.
  record get-users-user-id-params {
    /// SoundCloud User id
    user-id: string
  }
  get-users-user-id: func(params: get-users-user-id-params) -> result<complete-user, get-users-user-id-error>;

  /// Returns a list of user's comments.
  record get-users-user-id-comments-params {
    /// SoundCloud User id
    user-id: string,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Offset of first result. Deprecated, use `linked_partitioning` instead.
    offset: option<s32>
  }
  get-users-user-id-comments: func(params: get-users-user-id-comments-params) -> result<comments-list, get-users-user-id-comments-error>;

  /// Returns a list of user's favorited or liked tracks. (use /users/:userId/likes/tracks instead, to fetch a user's likes)
  record get-users-user-id-favorites-params {
    /// SoundCloud User id
    user-id: string,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-users-user-id-favorites: func(params: get-users-user-id-favorites-params) -> result<string, get-users-user-id-favorites-error>;

  /// Returns a list of user’s followers.
  record get-users-user-id-followers-params {
    /// SoundCloud User id
    user-id: string,
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-users-user-id-followers: func(params: get-users-user-id-followers-params) -> result<string, get-users-user-id-followers-error>;

  /// Returns a list of user’s followings.
  record get-users-user-id-followings-params {
    /// SoundCloud User id
    user-id: string,
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-users-user-id-followings: func(params: get-users-user-id-followings-params) -> result<string, get-users-user-id-followings-error>;

  /// Returns a user's following. (use /users/{user_id} instead, to fetch the user details)
  record get-users-user-id-followings-following-id-params {
    /// SoundCloud User id
    user-id: string,
    /// SoundCloud User id to denote a Following of a user
    following-id: string
  }
  get-users-user-id-followings-following-id: func(params: get-users-user-id-followings-following-id-params) -> result<complete-user, get-users-user-id-followings-following-id-error>;

  /// Returns a list of user's liked tracks.
  record get-users-user-id-likes-tracks-params {
    /// SoundCloud User id
    user-id: string,
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-users-user-id-likes-tracks-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-users-user-id-likes-tracks: func(params: get-users-user-id-likes-tracks-params) -> result<string, get-users-user-id-likes-tracks-error>;

  /// Returns a list of user's playlists.
  record get-users-user-id-playlists-params {
    /// SoundCloud User id
    user-id: string,
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-users-user-id-likes-tracks-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-users-user-id-playlists: func(params: get-users-user-id-playlists-params) -> result<string, get-users-user-id-playlists-error>;

  /// Returns a list of user's tracks.
  record get-users-user-id-tracks-params {
    /// SoundCloud User id
    user-id: string,
    /// Filters content by level of access the user (logged in or anonymous) has to the track. The result list will include only tracks with the specified access. Include all options if you'd like to see all possible tracks. See `Track#access` schema for more details.
    access: option<list<get-users-user-id-likes-tracks-access-item-enum>>,
    /// Number of results to return in the collection.
    limit: option<s32>,
    /// Returns paginated collection of items (recommended, returning a list without pagination is deprecated and should not be used)
    linked-partitioning: option<bool>
  }
  get-users-user-id-tracks: func(params: get-users-user-id-tracks-params) -> result<string, get-users-user-id-tracks-error>;

  /// Returns list of user's links added to their profile (website, facebook, instagram).
  record get-users-user-id-web-profiles-params {
    /// SoundCloud User id
    user-id: string,
    /// Number of results to return in the collection.
    limit: option<s32>
  }
  get-users-user-id-web-profiles: func(params: get-users-user-id-web-profiles-params) -> result<web-profiles, get-users-user-id-web-profiles-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export oauth;
  export likes;
  export me;
  export search;
  export playlists;
  export reposts;
  export miscellaneous;
  export tracks;
  export users;
}
