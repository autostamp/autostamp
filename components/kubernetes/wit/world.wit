interface logs {
  variant log-file-list-handler-error {
    unauthorized(string),
    other(string)
  }

  variant log-file-handler-error {
    unauthorized(string),
    other(string)
  }

  log-file-list-handler: func() -> result<string, log-file-list-handler-error>;

  record log-file-handler-params {
    /// path to the log
    logpath: string
  }
  log-file-handler: func(params: log-file-handler-params) -> result<string, log-file-handler-error>;

}

interface openid {
  variant get-service-account-issuer-open-id-keyset-error {
    unauthorized(string),
    other(string)
  }

  get-service-account-issuer-open-id-keyset: func() -> result<string, get-service-account-issuer-open-id-keyset-error>;

}

interface version {
  /// Info contains versioning information. how we'll want to distribute that information.
  record io-k8s-apimachinery-pkg-version-info {
    build-date: string,
    compiler: string,
    git-commit: string,
    git-tree-state: string,
    git-version: string,
    go-version: string,
    major: string,
    minor: string,
    platform: string
  }

  variant get-code-version-error {
    unauthorized(string),
    other(string)
  }

  get-code-version: func() -> result<io-k8s-apimachinery-pkg-version-info, get-code-version-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export well-known;
  export core;
  export core-v1;
  export apis;
  export admissionregistration;
  export admissionregistration-v1;
  export admissionregistration-v1alpha1;
  export apiextensions;
  export apiextensions-v1;
  export apiregistration;
  export apiregistration-v1;
  export apps;
  export apps-v1;
  export authentication;
  export authentication-v1;
  export authentication-v1alpha1;
  export authentication-v1beta1;
  export authorization;
  export authorization-v1;
  export autoscaling;
  export autoscaling-v1;
  export autoscaling-v2;
  export batch;
  export batch-v1;
  export certificates;
  export certificates-v1;
  export certificates-v1alpha1;
  export coordination;
  export coordination-v1;
  export discovery;
  export discovery-v1;
  export events;
  export events-v1;
  export flowcontrol-apiserver;
  export flowcontrol-apiserver-v1beta2;
  export flowcontrol-apiserver-v1beta3;
  export internal-apiserver;
  export internal-apiserver-v1alpha1;
  export networking;
  export networking-v1;
  export networking-v1alpha1;
  export node;
  export node-v1;
  export policy;
  export policy-v1;
  export rbac-authorization;
  export rbac-authorization-v1;
  export resource-op;
  export resource-v1alpha2;
  export scheduling;
  export scheduling-v1;
  export storage;
  export storage-v1;
  export logs;
  export openid;
  export version;
}
