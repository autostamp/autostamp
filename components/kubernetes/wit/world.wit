  /// one entry of a string-keyed map (free-form object)
  record io-k8s-api-core-v1-persistent-volume-claim-status-capacity-entry {
    key: string,
    value: string
  }

  /// PersistentVolumeClaimCondition contains details about state of pvc
  record io-k8s-api-core-v1-persistent-volume-claim-condition {
    last-probe-time: option<string>,
    last-transition-time: option<string>,
    /// message is the human-readable message indicating details about last transition.
    message: option<string>,
    /// reason is a unique, this should be a short, machine understandable string that gives the reason for condition's last transition. If it reports "ResizeStarted" that means the underlying persistent volume is being resized.
    reason: option<string>,
    status: string,
    type-op: string
  }

