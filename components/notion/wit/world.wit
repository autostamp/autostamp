interface users {
  /// one entry of a string-keyed map (free-form object)
  record retrieve-a-user-body-entry {
    key: string,
    value: string
  }

  record retrieve-a-user-response {
    avatar-url: option<string>,
    id: option<string>,
    name: option<string>,
    object: option<string>,
    person: option<retrieve-a-user-response-person>,
    type-op: option<string>
  }

  record retrieve-a-user-response-person {
    email: option<string>
  }

  /// Retrieve a user
  record retrieve-a-user-params {
    id: string,
    notion-version: option<string>,
    body: option<list<retrieve-a-user-body-entry>>
  }
  retrieve-a-user: func(params: retrieve-a-user-params) -> result<retrieve-a-user-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export blocks;
  export comments;
  export databases;
  export pages;
  export users;
}
