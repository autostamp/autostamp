package autostamp:notion@0.6.0;

interface blocks {
  record retrieve-a-block-response {
    created-time: option<string>,
    has-children: option<bool>,
    id: option<string>,
    last-edited-time: option<string>,
    object: option<string>,
    paragraph: option<retrieve-a-block-response-paragraph>,
    type-op: option<string>
  }

  record retrieve-a-block-response-paragraph {
    text: option<list<retrieve-a-block-response-paragraph-text-item>>
  }

  record retrieve-a-block-response-paragraph-text-item {
    annotations: option<retrieve-a-block-response-paragraph-text-item-annotations>,
    href: option<string>,
    plain-text: option<string>,
    text: option<retrieve-a-block-response-paragraph-text-item-text>,
    type-op: option<string>
  }

  record retrieve-a-block-response-paragraph-text-item-annotations {
    bold: option<bool>,
    code: option<bool>,
    color: option<string>,
    italic: option<bool>,
    strikethrough: option<bool>,
    underline: option<bool>
  }

  record retrieve-a-block-response-paragraph-text-item-text {
    content: option<string>,
    link: option<string>
  }

  record update-a-block-body-paragraph {
    rich-text: option<list<update-a-block-body-paragraph-rich-text-item>>
  }

  record update-a-block-body-paragraph-rich-text-item {
    text: option<update-a-block-body-paragraph-rich-text-item-text>,
    type-op: option<string>
  }

  record update-a-block-body-paragraph-rich-text-item-text {
    content: option<string>
  }

  record update-a-block-response {
    created-time: option<string>,
    has-children: option<bool>,
    id: option<string>,
    last-edited-time: option<string>,
    object: option<string>,
    paragraph: option<update-a-block-response-paragraph>,
    type-op: option<string>
  }

  record update-a-block-response-paragraph {
    text: option<list<update-a-block-response-paragraph-text-item>>
  }

  record update-a-block-response-paragraph-text-item {
    annotations: option<update-a-block-response-paragraph-text-item-annotations>,
    href: option<string>,
    plain-text: option<string>,
    text: option<update-a-block-response-paragraph-text-item-text>,
    type-op: option<string>
  }

  record update-a-block-response-paragraph-text-item-annotations {
    bold: option<bool>,
    code: option<bool>,
    color: option<string>,
    italic: option<bool>,
    strikethrough: option<bool>,
    underline: option<bool>
  }

  record update-a-block-response-paragraph-text-item-text {
    content: option<string>,
    link: option<string>
  }

  record delete-a-block-response {
    archived: option<bool>,
    created-by: option<delete-a-block-response-created-by>,
    created-time: option<string>,
    has-children: option<bool>,
    id: option<string>,
    last-edited-by: option<delete-a-block-response-last-edited-by>,
    last-edited-time: option<string>,
    object: option<string>,
    paragraph: option<delete-a-block-response-paragraph>,
    type-op: option<string>
  }

  record delete-a-block-response-created-by {
    id: option<string>,
    object: option<string>
  }

  record delete-a-block-response-last-edited-by {
    id: option<string>,
    object: option<string>
  }

  record delete-a-block-response-paragraph {
    text: option<list<delete-a-block-response-paragraph-text-item>>
  }

  record delete-a-block-response-paragraph-text-item {
    annotations: option<delete-a-block-response-paragraph-text-item-annotations>,
    href: option<string>,
    plain-text: option<string>,
    text: option<delete-a-block-response-paragraph-text-item-text>,
    type-op: option<string>
  }

  record delete-a-block-response-paragraph-text-item-annotations {
    bold: option<bool>,
    code: option<bool>,
    color: option<string>,
    italic: option<bool>,
    strikethrough: option<bool>,
    underline: option<bool>
  }

  record delete-a-block-response-paragraph-text-item-text {
    content: option<string>,
    link: option<string>
  }

  record retrieve-block-children-response {
    has-more: option<bool>,
    next-cursor: option<string>,
    object: option<string>,
    results: option<list<retrieve-block-children-response-results-item>>
  }

  record retrieve-block-children-response-results-item {
    created-time: option<string>,
    has-children: option<bool>,
    id: option<string>,
    last-edited-time: option<string>,
    object: option<string>,
    paragraph: option<retrieve-block-children-response-results-item-paragraph>,
    type-op: option<string>,
    unsupported: option<list<retrieve-block-children-response-results-item-unsupported-entry>>
  }

  record retrieve-block-children-response-results-item-paragraph {
    text: option<list<retrieve-block-children-response-results-item-paragraph-text-item>>
  }

  record retrieve-block-children-response-results-item-paragraph-text-item {
    annotations: option<retrieve-block-children-response-results-item-paragraph-text-item-annotations>,
    href: option<string>,
    plain-text: option<string>,
    text: option<retrieve-block-children-response-results-item-paragraph-text-item-text>,
    type-op: option<string>
  }

  record retrieve-block-children-response-results-item-paragraph-text-item-annotations {
    bold: option<bool>,
    code: option<bool>,
    color: option<string>,
    italic: option<bool>,
    strikethrough: option<bool>,
    underline: option<bool>
  }

  record retrieve-block-children-response-results-item-paragraph-text-item-text {
    content: option<string>,
    link: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record retrieve-block-children-response-results-item-unsupported-entry {
    key: string,
    value: string
  }

  record append-block-children-body-children-item {
    heading-v2: option<append-block-children-body-children-item-heading-v2>,
    object: option<string>,
    paragraph: option<append-block-children-body-children-item-paragraph>,
    type-op: option<string>
  }

  record append-block-children-body-children-item-heading-v2 {
    text: option<list<append-block-children-body-children-item-heading-v2-text-item>>
  }

  record append-block-children-body-children-item-heading-v2-text-item {
    text: option<append-block-children-body-children-item-heading-v2-text-item-text>,
    type-op: option<string>
  }

  record append-block-children-body-children-item-heading-v2-text-item-text {
    content: option<string>
  }

  record append-block-children-body-children-item-paragraph {
    rich-text: option<list<append-block-children-body-children-item-paragraph-rich-text-item>>
  }

  record append-block-children-body-children-item-paragraph-rich-text-item {
    text: option<append-block-children-body-children-item-paragraph-rich-text-item-text>,
    type-op: option<string>
  }

  record append-block-children-body-children-item-paragraph-rich-text-item-text {
    content: option<string>,
    link: option<append-block-children-body-children-item-paragraph-rich-text-item-text-link>
  }

  record append-block-children-body-children-item-paragraph-rich-text-item-text-link {
    url: option<string>
  }

  record append-block-children-response {
    child-page: option<append-block-children-response-child-page>,
    created-time: option<string>,
    has-children: option<bool>,
    id: option<string>,
    last-edited-time: option<string>,
    object: option<string>,
    type-op: option<string>
  }

  record append-block-children-response-child-page {
    title: option<string>
  }

  /// Retrieve a block
  record retrieve-a-block-params {
    id: string,
    notion-version: option<string>
  }
  retrieve-a-block: func(params: retrieve-a-block-params) -> result<retrieve-a-block-response, string>;

  /// Update a block
  record update-a-block-params {
    id: string,
    notion-version: option<string>,
    paragraph: option<update-a-block-body-paragraph>
  }
  update-a-block: func(params: update-a-block-params) -> result<update-a-block-response, string>;

  /// Delete a block
  record delete-a-block-params {
    id: string,
    notion-version: option<string>
  }
  delete-a-block: func(params: delete-a-block-params) -> result<delete-a-block-response, string>;

  /// Retrieve block children
  record retrieve-block-children-params {
    id: string,
    page-size: option<string>,
    notion-version: option<string>
  }
  retrieve-block-children: func(params: retrieve-block-children-params) -> result<retrieve-block-children-response, string>;

  /// Append block children
  record append-block-children-params {
    id: string,
    notion-version: option<string>,
    children: option<list<append-block-children-body-children-item>>
  }
  append-block-children: func(params: append-block-children-params) -> result<append-block-children-response, string>;

}


interface comments {
  /// one entry of a string-keyed map (free-form object)
  record retrieve-comments-body-entry {
    key: string,
    value: string
  }

  record retrieve-comments-response {
    comment: option<list<retrieve-comments-response-comment-entry>>,
    has-more: option<bool>,
    next-cursor: option<string>,
    object: option<string>,
    results: option<list<retrieve-comments-response-results-item>>,
    type-op: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record retrieve-comments-response-comment-entry {
    key: string,
    value: string
  }

  record retrieve-comments-response-results-item {
    created-by: option<retrieve-comments-response-results-item-created-by>,
    created-time: option<string>,
    discussion-id: option<string>,
    id: option<string>,
    last-edited-time: option<string>,
    object: option<string>,
    parent: option<retrieve-comments-response-results-item-parent>,
    rich-text: option<list<retrieve-comments-response-results-item-rich-text-item>>
  }

  record retrieve-comments-response-results-item-created-by {
    id: option<string>,
    object: option<string>
  }

  record retrieve-comments-response-results-item-parent {
    block-id: option<string>,
    type-op: option<string>
  }

  record retrieve-comments-response-results-item-rich-text-item {
    annotations: option<retrieve-comments-response-results-item-rich-text-item-annotations>,
    href: option<string>,
    plain-text: option<string>,
    text: option<retrieve-comments-response-results-item-rich-text-item-text>,
    type-op: option<string>
  }

  record retrieve-comments-response-results-item-rich-text-item-annotations {
    bold: option<bool>,
    code: option<bool>,
    color: option<string>,
    italic: option<bool>,
    strikethrough: option<bool>,
    underline: option<bool>
  }

  record retrieve-comments-response-results-item-rich-text-item-text {
    content: option<string>,
    link: option<string>
  }

  /// Retrieve comments
  record retrieve-comments-params {
    block-id: option<string>,
    page-size: option<string>,
    notion-version: option<string>,
    body: option<list<retrieve-comments-body-entry>>
  }
  retrieve-comments: func(params: retrieve-comments-params) -> result<retrieve-comments-response, string>;

}

