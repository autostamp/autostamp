package autostamp:opencagedata@0.5.0;

interface v-version {
  record response {
    documentation: option<string>,
    licenses: option<list<response-licenses-item>>,
    rate: option<response-rate>,
    results: option<list<response-results-item>>,
    status: option<response-status>,
    stay-informed: option<response-stay-informed>,
    thanks: option<string>,
    timestamp: option<response-timestamp>,
    total-results: option<s32>
  }

  record response-licenses-item {
    name: option<string>,
    url: option<string>
  }

  record response-rate {
    limit: option<s32>,
    remaining: option<s32>,
    reset: option<s32>
  }

  record response-results-item {
    annotations: option<response-results-item-annotations>,
    bounds: option<response-results-item-bounds>,
    components: option<response-results-item-components>,
    confidence: option<s32>,
    formatted: option<string>,
    geometry: option<lat-lng>
  }

  record response-results-item-annotations {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record response-results-item-bounds {
    northeast: option<lat-lng>,
    southwest: option<lat-lng>
  }

  record lat-lng {
    lat: option<f64>,
    lng: option<f64>
  }

  record response-results-item-components {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record response-status {
    code: option<s32>,
    message: option<string>
  }

  record response-stay-informed {
    blog: option<string>,
    twitter: option<string>
  }

  record response-timestamp {
    created-http: option<string>,
    created-unix: option<s32>
  }

  variant get-v-version-format-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    request-timeout(string),
    gone(string),
    upgrade-required(string),
    too-many-requests(string),
    service-unavailable(string),
    other(string)
  }

  record get-v-version-format-params {
    /// API version.
    version: string,
    /// format of the response. One of 'json', 'xml' or 'map'.
    format: string,
    /// string or lat,lng to be geocoded.
    q: string,
    /// an application key.
    key: string,
    /// when true we attempt to abbreviate the formatted field of results.
    abbrv: option<bool>,
    /// when true we include only address details in the formatted field of results.
    address-only: option<bool>,
    /// if true the request is included in the response.
    add-request: option<bool>,
    /// four coordinate points forming the south-west and north-east corners of a bounding box (min long, min lat, max long, max lat).
    bounds: option<string>,
    /// two letter code ISO 3166-1 Alpha 2 code to limit results to that country.
    countrycode: option<string>,
    /// wraps the returned JSON with a function name.
    jsonp: option<string>,
    /// an IETF format language code (ex: 'es' or 'pt-BR').
    language: option<string>,
    /// maximum number of results to return. Default is 10. Maximum is 100.
    limit: option<s32>,
    /// integer from 1-10. Only results with at least this confidence are returned.
    min-confidence: option<s32>,
    /// when true annotations are not added to results.
    no-annotations: option<bool>,
    /// when true results are not deduplicated.
    no-dedupe: option<bool>,
    /// when true query content is not logged.
    no-record: option<bool>,
    /// when true results are pretty printed. Useful for debugging.
    pretty: option<bool>,
    /// lat,lng to bias results.
    proximity: option<string>,
    /// match nearest road, include roadinfo annotation
    roadinfo: option<bool>
  }
  get-v-version-format: func(params: get-v-version-format-params) -> result<response, get-v-version-format-error>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export v-version;
}
