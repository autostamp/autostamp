/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `api_key` | query `key` |
package autostamp:trello@0.2.1;

interface action {
  /// getActionsByIdAction()
  record get-actions-by-id-action-params {
    /// idAction
    id-action: string,
    ///  true or false
    display: option<string>,
    ///  true or false
    entities: option<string>,
    /// all or a comma-separated list of: data, date, idMemberCreator or type
    fields: option<string>,
    ///  true or false
    member: option<string>,
    /// all or a comma-separated list of: avatarHash, bio, bioData, confirmed, fullName, idPremOrgsAdmin, initials, memberType, products, status, url or username
    member-fields: option<string>,
    ///  true or false
    member-creator: option<string>,
    /// all or a comma-separated list of: avatarHash, bio, bioData, confirmed, fullName, idPremOrgsAdmin, initials, memberType, products, status, url or username
    member-creator-fields: option<string>,
    /// <a href="https://trello.com/docs/gettingstarted/index.html#getting-a-token-from-a-user"  target="_blank">Getting a token from a user</a>
    token: string
  }
  get-actions-by-id-action: func(params: get-actions-by-id-action-params) -> result<string, string>;

  /// updateActionsByIdAction()
  record update-actions-by-id-action-params {
    /// idAction
    id-action: string,
    /// <a href="https://trello.com/docs/gettingstarted/index.html#getting-a-token-from-a-user"  target="_blank">Getting a token from a user</a>
    token: string,
    /// a string with a length from 1 to 16384
    text: option<string>
  }
  update-actions-by-id-action: func(params: update-actions-by-id-action-params) -> result<string, string>;

  /// deleteActionsByIdAction()
  record delete-actions-by-id-action-params {
    /// idAction
    id-action: string,
    /// <a href="https://trello.com/docs/gettingstarted/index.html#getting-a-token-from-a-user"  target="_blank">Getting a token from a user</a>
    token: string
  }
  delete-actions-by-id-action: func(params: delete-actions-by-id-action-params) -> result<string, string>;

  /// getActionsBoardByIdAction()
  record get-actions-board-by-id-action-params {
    /// idAction
    id-action: string,
    /// all or a comma-separated list of: closed, dateLastActivity, dateLastView, desc, descData, idOrganization, invitations, invited, labelNames, memberships, name, pinned, powerUps, prefs, shortLink, shortUrl, starred, subscribed or url
    fields: option<string>,
    /// <a href="https://trello.com/docs/gettingstarted/index.html#getting-a-token-from-a-user"  target="_blank">Getting a token from a user</a>
