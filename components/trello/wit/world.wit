  update-boards-by-id-board: func(params: update-boards-by-id-board-params) -> result<string, string>;

  /// getBoardsActionsByIdBoard()
  record get-boards-actions-by-id-board-params {
    /// board_id
    id-board: string,
    ///  true or false
    entities: option<string>,
    ///  true or false
