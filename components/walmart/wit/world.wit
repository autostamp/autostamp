package autostamp:walmart@0.6.0;

interface inventory {
  enum update-bulk-inventory-feed-type-enum {
    inventory,
    mp-inventory,
  }

  enum get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum {
    each,
  }

  enum get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-category-enum {
    application,
    system,
    request,
    data,
  }

  enum get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-severity-enum {
    info,
    warn,
    error,
  }

  record update-bulk-inventory-response {
    additional-attributes: option<list<update-bulk-inventory-response-additional-attributes-entry>>,
    errors: option<list<update-bulk-inventory-response-errors-entry>>,
    /// A unique ID, returned from the Bulk Upload API, used for tracking the feed file
    feed-id: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record update-bulk-inventory-response-additional-attributes-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record update-bulk-inventory-response-errors-entry {
    key: string,
    value: string
  }

  record get-wfs-inventory-response {
    headers: option<get-wfs-inventory-response-headers>,
    payload: option<get-wfs-inventory-response-payload>
  }

  record get-wfs-inventory-response-headers {
    /// Information about the quantity in inventory
    limit: option<s32>,
    /// Offset is the number of records you wish to skip before selecting results.
    offset: option<s32>,
    /// Total number of results for query.
    total-count: option<s32>
  }

  record get-wfs-inventory-response-payload {
    inventory: option<list<get-wfs-inventory-response-payload-inventory-item>>
  }

  record get-wfs-inventory-response-payload-inventory-item {
    ship-nodes: option<list<get-wfs-inventory-response-payload-inventory-item-ship-nodes-item>>,
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item.
    sku: option<string>
  }

  record get-wfs-inventory-response-payload-inventory-item-ship-nodes-item {
    /// The available quantity is the quantity of an item that is available to be allocated to orders.
    avail-to-sell-qty: option<s32>,
    /// Last changes date for the item.
    modified-date: option<string>,
    /// The on-hand balance is the quantity of active inventory stored at the warehouse.Active inventory is defined as the usable amount of an item that is in the warehouse.Inventory is active if it is not damaged, expired or being inspected.
    on-hand-qty: option<s32>,
    /// Identifies fulfillment aspect of invetory. Walmart, seller or 3PL fulfilled. Possible value is 'WFSFulfilled'. In later phase we will also add seller fulfilled inventory.
    ship-node-type: option<string>
  }

  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response {
    elements: option<get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements>,
    meta: option<get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-meta>
  }

  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements {
    inventories: option<list<get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item>>
  }

  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item {
    nodes: option<list<get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item>>,
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item.
    sku: option<string>
  }

  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item {
    /// Quantity of an item that is available to be allocated to orders
    avail-to-sell-qty: option<get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty>,
    /// Quantity of an item that is input by the seller
    input-qty: option<get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-input-qty>,
    /// Quantity that has been ordered by the customers but not yet shipped
    reserved-qty: option<get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-reserved-qty>,
    /// ShipNode Id of the ship node for which the inventory is requested
    ship-node: option<string>
  }

  /// Quantity of an item that is available to be allocated to orders
  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  /// Quantity of an item that is input by the seller
  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-input-qty {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  /// Quantity that has been ordered by the customers but not yet shipped
  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-reserved-qty {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-meta {
    /// Used for pagination to fetch the next set of items.
    next-cursor: option<string>,
    /// Total number of Skus of the Seller. Example: '235'
    total-count: option<f64>
  }

  record get-multi-node-inventory-for-sku-and-all-shipnodes-response {
    nodes: option<list<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item>>,
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item.
    sku: option<string>
  }

  record get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item {
    /// Quantity of an item that is available to be allocated to orders
    avail-to-sell-qty: option<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-avail-to-sell-qty>,
    errors: option<list<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item>>,
    /// Quantity of an item that is input by the seller
    input-qty: option<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-input-qty>,
    /// Quantity that has been ordered by the customers but not yet shipped
    reserved-qty: option<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-reserved-qty>,
    /// ShipNode Id of the ship node for which the inventory is requested
    ship-node: option<string>
  }

  /// Quantity of an item that is available to be allocated to orders
  record get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-avail-to-sell-qty {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  record get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item {
    category: option<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-category-enum>,
    causes: option<list<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-causes-item>>,
    code: string,
    description: option<string>,
    error-identifiers: option<list<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-error-identifiers-entry>>,
    field: option<string>,
    info: option<string>,
    severity: option<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-severity-enum>
  }

  record get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-causes-item {
    code: option<string>,
    description: option<string>,
    field: option<string>,
    type-op: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-error-identifiers-value-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-error-identifiers-entry {
    key: string,
    value: list<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-error-identifiers-value-entry>
  }

  /// Quantity of an item that is input by the seller
  record get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-input-qty {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  /// Quantity that has been ordered by the customers but not yet shipped
  record get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-reserved-qty {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  record update-multi-node-inventory-body-inventories {
    nodes: list<update-multi-node-inventory-body-inventories-nodes-item>
  }

  record update-multi-node-inventory-body-inventories-nodes-item {
    /// Quantity that has been ordered by the customers but not yet shipped
    input-qty: update-multi-node-inventory-body-inventories-nodes-item-input-qty,
    /// ShipNode Id of the ship node for which the inventory is requested
    ship-node: string
  }

  /// Quantity that has been ordered by the customers but not yet shipped
  record update-multi-node-inventory-body-inventories-nodes-item-input-qty {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  record update-multi-node-inventory-response {
    nodes: option<list<update-multi-node-inventory-response-nodes-item>>,
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item.
    sku: option<string>
  }

  record update-multi-node-inventory-response-nodes-item {
    /// Node Update Error description.
    errors: option<list<update-multi-node-inventory-response-nodes-item-errors-item>>,
    /// ShipNode Id of the ship node for which the inventory is requested
    ship-node: option<string>,
    /// Node Update status. Example: 'Success'
    status: option<string>
  }

  record update-multi-node-inventory-response-nodes-item-errors-item {
    category: option<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-category-enum>,
    causes: option<list<update-multi-node-inventory-response-nodes-item-errors-item-causes-item>>,
    code: string,
    description: option<string>,
    error-identifiers: option<list<update-multi-node-inventory-response-nodes-item-errors-item-error-identifiers-entry>>,
    field: option<string>,
    info: option<string>,
    severity: option<get-multi-node-inventory-for-sku-and-all-shipnodes-response-nodes-item-errors-item-severity-enum>
  }

  record update-multi-node-inventory-response-nodes-item-errors-item-causes-item {
    code: option<string>,
    description: option<string>,
    field: option<string>,
    type-op: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record update-multi-node-inventory-response-nodes-item-errors-item-error-identifiers-value-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record update-multi-node-inventory-response-nodes-item-errors-item-error-identifiers-entry {
    key: string,
    value: list<update-multi-node-inventory-response-nodes-item-errors-item-error-identifiers-value-entry>
  }

  record get-inventory-response {
    /// Quantity that has been ordered by the customers but not yet shipped
    quantity: get-inventory-response-quantity,
    /// A seller-provided Product ID. Response will have decoded value.
    sku: string
  }

  /// Quantity that has been ordered by the customers but not yet shipped
  record get-inventory-response-quantity {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  /// Quantity that has been ordered by the customers but not yet shipped
  record update-inventory-for-an-item-body-quantity {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  record update-inventory-for-an-item-response {
    /// Quantity that has been ordered by the customers but not yet shipped
    quantity: update-inventory-for-an-item-response-quantity,
    /// A seller-provided Product ID. Response will have decoded value.
    sku: string
  }

  /// Quantity that has been ordered by the customers but not yet shipped
  record update-inventory-for-an-item-response-quantity {
    /// Inventory Count
    amount: f64,
    /// The unit of measurement. Example: 'EACH'
    unit: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response-elements-inventories-item-nodes-item-avail-to-sell-qty-unit-enum
  }

  /// Bulk Item Inventory Update
  record update-bulk-inventory-params {
    /// The feed Type
    feed-type: update-bulk-inventory-feed-type-enum,
    /// The shipNode for which the inventory is to be updated. Not required in case of Multi Node Inventory Update Feed (feedType=MP_INVENTORY)
    ship-node: option<string>,
    /// The access token retrieved in the Token API call
    wm-sec-access-token: string,
    /// A unique ID to track the consumer request by channel. Use the Consumer Channel Type received during onboarding
    wm-consumer-channel-type: option<string>,
    /// A unique ID which identifies each API call and used to track and debug issues; use a random generated GUID for this ID
    wm-qos-correlation-id: string,
    /// Walmart Service Name
    wm-svc-name: string,
    /// Feed file to upload
    file: string
  }
  update-bulk-inventory: func(params: update-bulk-inventory-params) -> result<update-bulk-inventory-response, string>;

  /// WFS Inventory
  record get-wfs-inventory-params {
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item. This will be used by the seller in the XSD file to refer to each item. Special characters in the sku needing encoding are: ':', '/', '?', '#', '[', ']', '@', '!', '$', '&', "'", '(', ')', '*', '+', ',', ';', '=', ‘ ’ as well as '%' itself if it's a part of sku. Make sure to encode space with %20. Other characters don't need to be encoded.
    sku: option<string>,
    /// last inventory modified date - starting range.
    from-modified-date: option<string>,
    /// last inventory modified date - starting range.
    to-modified-date: option<string>,
    /// Number of Sku to be returned. Cannot be larger than 300.
    limit: option<string>,
    /// Offset is the number of records you wish to skip before selecting records.
    offset: option<string>,
    /// The access token retrieved in the Token API call
    wm-sec-access-token: string,
    /// A unique ID to track the consumer request by channel. Use the Consumer Channel Type received during onboarding
    wm-consumer-channel-type: option<string>,
    /// A unique ID which identifies each API call and used to track and debug issues; use a random generated GUID for this ID
    wm-qos-correlation-id: string,
    /// Walmart Service Name
    wm-svc-name: string
  }
  get-wfs-inventory: func(params: get-wfs-inventory-params) -> result<get-wfs-inventory-response, string>;

  /// Multiple Item Inventory for All Ship Nodes
  record get-multi-node-inventory-for-all-sku-and-all-ship-nodes-params {
    /// The number of items returned. Cannot be more than 50.
    limit: option<string>,
    /// String returned from initial API call to indicate pagination. Specify nextCursor value to retrieve the next 50 items.
    next-cursor: option<string>,
    /// The access token retrieved in the Token API call
    wm-sec-access-token: string,
    /// A unique ID to track the consumer request by channel. Use the Consumer Channel Type received during onboarding
    wm-consumer-channel-type: option<string>,
    /// A unique ID which identifies each API call and used to track and debug issues; use a random generated GUID for this ID
    wm-qos-correlation-id: string,
    /// Walmart Service Name
    wm-svc-name: string
  }
  get-multi-node-inventory-for-all-sku-and-all-ship-nodes: func(params: get-multi-node-inventory-for-all-sku-and-all-ship-nodes-params) -> result<get-multi-node-inventory-for-all-sku-and-all-ship-nodes-response, string>;

  /// Single Item Inventory by Ship Node
  record get-multi-node-inventory-for-sku-and-all-shipnodes-params {
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item. This will be used by the seller in the XSD file to refer to each item. Special characters in the sku needing encoding are: ':', '/', '?', '#', '[', ']', '@', '!', '$', '&', "'", '(', ')', '*', '+', ',', ';', '=', ‘ ’ as well as '%' itself if it's a part of sku. Make sure to encode space with %20. Other characters don't need to be encoded.
    sku: string,
    /// ShipNode Id of the ship node for which the inventory is requested
    ship-node: option<string>,
    /// The access token retrieved in the Token API call
    wm-sec-access-token: string,
    /// A unique ID to track the consumer request by channel. Use the Consumer Channel Type received during onboarding
    wm-consumer-channel-type: option<string>,
    /// A unique ID which identifies each API call and used to track and debug issues; use a random generated GUID for this ID
    wm-qos-correlation-id: string,
    /// Walmart Service Name
    wm-svc-name: string
  }
  get-multi-node-inventory-for-sku-and-all-shipnodes: func(params: get-multi-node-inventory-for-sku-and-all-shipnodes-params) -> result<get-multi-node-inventory-for-sku-and-all-shipnodes-response, string>;

  /// Update Item Inventory per Ship Node
  record update-multi-node-inventory-params {
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item. This will be used by the seller in the XSD file to refer to each item. Special characters in the sku needing encoding are: ':', '/', '?', '#', '[', ']', '@', '!', '$', '&', "'", '(', ')', '*', '+', ',', ';', '=', ‘ ’ as well as '%' itself if it's a part of sku. Make sure to encode space with %20. Other characters don't need to be encoded.
    sku: string,
    /// The access token retrieved in the Token API call
    wm-sec-access-token: string,
    /// A unique ID to track the consumer request by channel. Use the Consumer Channel Type received during onboarding
    wm-consumer-channel-type: option<string>,
    /// A unique ID which identifies each API call and used to track and debug issues; use a random generated GUID for this ID
    wm-qos-correlation-id: string,
    /// Walmart Service Name
    wm-svc-name: string,
    inventories: update-multi-node-inventory-body-inventories
  }
  update-multi-node-inventory: func(params: update-multi-node-inventory-params) -> result<update-multi-node-inventory-response, string>;

  /// Inventory
  record get-inventory-params {
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item. This will be used by the seller in the XSD file to refer to each item. Special characters in the sku needing encoding are: ':', '/', '?', '#', '[', ']', '@', '!', '$', '&', "'", '(', ')', '*', '+', ',', ';', '=', ‘ ’, '{', '}' as well as '%' itself if it's a part of sku. Make sure to encode space with %20. Other characters don't need to be encoded.
    sku: string,
    /// The shipNode for which the inventory is requested
    ship-node: option<string>,
    /// The access token retrieved in the Token API call
    wm-sec-access-token: string,
    /// A unique ID to track the consumer request by channel. Use the Consumer Channel Type received during onboarding
    wm-consumer-channel-type: option<string>,
    /// A unique ID which identifies each API call and used to track and debug issues; use a random generated GUID for this ID
    wm-qos-correlation-id: string,
    /// Walmart Service Name
    wm-svc-name: string
  }
  get-inventory: func(params: get-inventory-params) -> result<get-inventory-response, string>;

  /// Update inventory
  record update-inventory-for-an-item-params {
    /// An arbitrary alphanumeric unique ID, specified by the seller, which identifies each item. This will be used by the seller in the XSD file to refer to each item. Special characters in the sku needing encoding are: ':', '/', '?', '#', '[', ']', '@', '!', '$', '&', "'", '(', ')', '*', '+', ',', ';', '=', ‘ ’, '{', '}' as well as '%' itself if it's a part of sku. Make sure to encode space with %20. Other characters don't need to be encoded.
    sku: string,
    /// The shipNode for which the inventory is to be updated.
    ship-node: option<string>,
    /// The access token retrieved in the Token API call
    wm-sec-access-token: string,
    /// A unique ID to track the consumer request by channel. Use the Consumer Channel Type received during onboarding
    wm-consumer-channel-type: option<string>,
    /// A unique ID which identifies each API call and used to track and debug issues; use a random generated GUID for this ID
    wm-qos-correlation-id: string,
    /// Walmart Service Name
    wm-svc-name: string,
    /// Quantity that has been ordered by the customers but not yet shipped
    quantity: update-inventory-for-an-item-body-quantity,
    /// A seller-provided Product ID. Response will have decoded value.
    sku-v2: string
  }
  update-inventory-for-an-item: func(params: update-inventory-for-an-item-params) -> result<update-inventory-for-an-item-response, string>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export inventory;
}
