  record get-users-params {
    inname: option<string>,
    order: option<get-users-order-enum>,
    /// sort = reputation => number
    /// sort = creation => date
    max: option<string>,
    /// sort = reputation => number
    /// sort = creation => date
    min: option<string>,
    sort: option<get-users-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
    todate: option<s32>,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-users: func(params: get-users-params) -> result<list<users-item>, get-users-error>;

  record get-users-moderators-params {
    order: option<get-users-order-enum>,
    /// sort = reputation => number
    /// sort = creation => date
    max: option<string>,
    /// sort = reputation => number
    /// sort = creation => date
    min: option<string>,
    sort: option<get-users-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
    todate: option<s32>,
    pagesize: option<s32>,
    page: option<s32>,
