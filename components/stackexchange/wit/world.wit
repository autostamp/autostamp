    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  record get-filters-create-params {
    base: option<string>,
    /// String list (semicolon delimited).
    exclude: option<string>,
    /// String list (semicolon delimited).
    include-op: option<string>,
    unsafe: option<bool>
  }
  get-filters-create: func(params: get-filters-create-params) -> result<single-filter, get-filters-create-error>;

  record get-filters-filters-params {
    /// String list (semicolon delimited).
    filters: string
  }
  get-filters-filters: func(params: get-filters-filters-params) -> result<filters, get-filters-filters-error>;

}

