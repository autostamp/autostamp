    /// sort = activity => date
    /// sort = creation => date
    max: option<string>,
    /// sort = activity => date
    /// sort = creation => date
    min: option<string>,
    sort: option<get-answers-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
    todate: option<s32>,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-answers-ids: func(params: get-answers-ids-params) -> result<answers, get-answers-ids-error>;

  record get-answers-ids-comments-params {
    /// Number list (semicolon delimited).
    ids: string,
    order: option<get-answers-order-enum>,
    /// sort = creation => date
    /// sort = votes => number
    max: option<string>,
    /// sort = creation => date
    /// sort = votes => number
    min: option<string>,
    sort: option<get-answers-ids-comments-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
    todate: option<s32>,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-answers-ids-comments: func(params: get-answers-ids-comments-params) -> result<comments, get-answers-ids-comments-error>;

}

