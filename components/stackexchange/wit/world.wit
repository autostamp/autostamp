  }

  record get-inbox-params {
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>
  }
  get-inbox: func(params: get-inbox-params) -> result<items, get-inbox-error>;

  record get-inbox-unread-params {
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Unix date.
    since: option<s32>
  }
  get-inbox-unread: func(params: get-inbox-unread-params) -> result<items, get-inbox-unread-error>;

}

interface info {
  record object {
    answers-per-minute: option<f64>,
