package autostamp:stackexchange@0.6.0;

interface access-tokens {
  record access-tokens-item {
    access-token: option<string>,
    account-id: option<s32>,
    expires-on-date: option<s32>,
    scope: option<list<string>>
  }

  record access-tokens-item-v2 {
    access-token: option<string>,
    account-id: option<s32>,
    expires-on-date: option<s32>,
    scope: option<list<string>>
  }

  variant get-access-tokens-access-tokens-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  variant get-access-tokens-access-tokens-invalidate-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  record get-access-tokens-access-tokens-params {
    /// String list (semicolon delimited).
    access-tokens: string,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>
  }
  get-access-tokens-access-tokens: func(params: get-access-tokens-access-tokens-params) -> result<list<access-tokens-item>, get-access-tokens-access-tokens-error>;

  record get-access-tokens-access-tokens-invalidate-params {
    /// String list (semicolon delimited).
    access-tokens: string,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>
  }
  get-access-tokens-access-tokens-invalidate: func(params: get-access-tokens-access-tokens-invalidate-params) -> result<list<access-tokens-item-v2>, get-access-tokens-access-tokens-invalidate-error>;

}


interface answers {
  enum get-answers-order-enum {
    desc,
    asc,
  }

  enum get-answers-sort-enum {
    activity,
    creation,
    votes,
  }

  enum get-answers-ids-comments-sort-enum {
    creation,
    votes,
  }

  record answers-item {
    accepted: option<bool>,
    answer-id: option<s32>,
    awarded-bounty-amount: option<s32>,
    awarded-bounty-users: option<list<string>>,
    body: option<string>,
    body-markdown: option<string>,
    can-flag: option<bool>,
    comment-count: option<s32>,
    comments: option<list<string>>,
    community-owned-date: option<s32>,
    creation-date: option<s32>,
    down-vote-count: option<s32>,
    downvoted: option<bool>,
    is-accepted: option<bool>,
    last-activity-date: option<s32>,
    last-edit-date: option<s32>,
    last-editor: option<answers-item-last-editor>,
    link: option<string>,
    locked-date: option<s32>,
    owner: option<answers-item-owner>,
    question-id: option<s32>,
    score: option<s32>,
    share-link: option<string>,
    tags: option<list<string>>,
    title: option<string>,
    up-vote-count: option<s32>,
    upvoted: option<bool>
  }

  record answers-item-last-editor {
    accept-rate: option<s32>,
    badge-counts: option<answers-item-last-editor-badge-counts>,
    display-name: option<string>,
    link: option<string>,
    profile-image: option<string>,
    reputation: option<s32>,
    user-id: option<s32>,
    user-type: option<string>
  }

  record answers-item-last-editor-badge-counts {
    bronze: option<s32>,
    gold: option<s32>,
    silver: option<s32>
  }

  record answers-item-owner {
    accept-rate: option<s32>,
    badge-counts: option<answers-item-owner-badge-counts>,
    display-name: option<string>,
    link: option<string>,
    profile-image: option<string>,
    reputation: option<s32>,
    user-id: option<s32>,
    user-type: option<string>
  }

  record answers-item-owner-badge-counts {
    bronze: option<s32>,
    gold: option<s32>,
    silver: option<s32>
  }

  record answers-item-v2 {
    accepted: option<bool>,
    answer-id: option<s32>,
    awarded-bounty-amount: option<s32>,
    awarded-bounty-users: option<list<string>>,
    body: option<string>,
    body-markdown: option<string>,
    can-flag: option<bool>,
    comment-count: option<s32>,
    comments: option<list<string>>,
    community-owned-date: option<s32>,
    creation-date: option<s32>,
    down-vote-count: option<s32>,
    downvoted: option<bool>,
    is-accepted: option<bool>,
    last-activity-date: option<s32>,
    last-edit-date: option<s32>,
    last-editor: option<answers-item-v2-last-editor>,
    link: option<string>,
    locked-date: option<s32>,
    owner: option<answers-item-v2-owner>,
    question-id: option<s32>,
    score: option<s32>,
    share-link: option<string>,
    tags: option<list<string>>,
    title: option<string>,
    up-vote-count: option<s32>,
    upvoted: option<bool>
  }

  record answers-item-v2-last-editor {
    accept-rate: option<s32>,
    badge-counts: option<answers-item-v2-last-editor-badge-counts>,
    display-name: option<string>,
    link: option<string>,
    profile-image: option<string>,
    reputation: option<s32>,
    user-id: option<s32>,
    user-type: option<string>
  }

  record answers-item-v2-last-editor-badge-counts {
    bronze: option<s32>,
    gold: option<s32>,
    silver: option<s32>
  }

  record answers-item-v2-owner {
    accept-rate: option<s32>,
    badge-counts: option<answers-item-v2-owner-badge-counts>,
    display-name: option<string>,
    link: option<string>,
    profile-image: option<string>,
    reputation: option<s32>,
    user-id: option<s32>,
    user-type: option<string>
  }

  record answers-item-v2-owner-badge-counts {
    bronze: option<s32>,
    gold: option<s32>,
    silver: option<s32>
  }

  record comments-item {
    body: option<string>,
    body-markdown: option<string>,
    can-flag: option<bool>,
    comment-id: option<s32>,
    creation-date: option<s32>,
    edited: option<bool>,
    link: option<string>,
    owner: option<comments-item-owner>,
    post-id: option<s32>,
    post-type: option<string>,
    reply-to-user: option<comments-item-reply-to-user>,
    score: option<s32>,
    upvoted: option<bool>
  }

  record comments-item-owner {
    accept-rate: option<s32>,
    badge-counts: option<comments-item-owner-badge-counts>,
    display-name: option<string>,
    link: option<string>,
    profile-image: option<string>,
    reputation: option<s32>,
    user-id: option<s32>,
    user-type: option<string>
  }

  record comments-item-owner-badge-counts {
    bronze: option<s32>,
    gold: option<s32>,
    silver: option<s32>
  }

  record comments-item-reply-to-user {
    accept-rate: option<s32>,
    badge-counts: option<comments-item-reply-to-user-badge-counts>,
    display-name: option<string>,
    link: option<string>,
    profile-image: option<string>,
    reputation: option<s32>,
    user-id: option<s32>,
    user-type: option<string>
  }

  record comments-item-reply-to-user-badge-counts {
    bronze: option<s32>,
    gold: option<s32>,
    silver: option<s32>
  }

  variant get-answers-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  variant get-answers-ids-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  variant get-answers-ids-comments-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  record get-answers-params {
    order: option<get-answers-order-enum>,
    /// sort = activity => date
    /// sort = creation => date
    max: option<string>,
    /// sort = activity => date
    /// sort = creation => date
    min: option<string>,
    sort: option<get-answers-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
    todate: option<s32>,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-answers: func(params: get-answers-params) -> result<list<answers-item>, get-answers-error>;

  record get-answers-ids-params {
    /// Number list (semicolon delimited).
    ids: string,
    order: option<get-answers-order-enum>,
    /// sort = activity => date
    /// sort = creation => date
    max: option<string>,
    /// sort = activity => date
    /// sort = creation => date
    min: option<string>,
    sort: option<get-answers-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
    todate: option<s32>,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-answers-ids: func(params: get-answers-ids-params) -> result<list<answers-item-v2>, get-answers-ids-error>;

  record get-answers-ids-comments-params {
    /// Number list (semicolon delimited).
    ids: string,
    order: option<get-answers-order-enum>,
    /// sort = creation => date
    /// sort = votes => number
    max: option<string>,
    /// sort = creation => date
    /// sort = votes => number
    min: option<string>,
    sort: option<get-answers-ids-comments-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
    todate: option<s32>,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-answers-ids-comments: func(params: get-answers-ids-comments-params) -> result<list<comments-item>, get-answers-ids-comments-error>;

}

interface apps {
  record access-tokens-item {
    access-token: option<string>,
    account-id: option<s32>,
    expires-on-date: option<s32>,
    scope: option<list<string>>
  }

  variant get-apps-access-tokens-de-authenticate-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  record get-apps-access-tokens-de-authenticate-params {
    /// String list (semicolon delimited).
    access-tokens: string,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>
  }
  get-apps-access-tokens-de-authenticate: func(params: get-apps-access-tokens-de-authenticate-params) -> result<list<access-tokens-item>, get-apps-access-tokens-de-authenticate-error>;

}

