/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export access-tokens;
  export answers;
  export apps;
  export badges;
  export comments;
  export errors;
  export events;
  export filters;
  export inbox;
  export info;
  export me;
  export notifications;
  export posts;
  export privileges;
  export questions;
  export revisions;
  export search;
  export similar;
  export sites;
  export suggested-edits;
  export tags;
  export users;
}
