interface notifications {
  record notifications {
    /// opaque schema; raw JSON
    value: string
  }

  variant get-notifications-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  variant get-notifications-unread-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  record get-notifications-params {
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>
  }
  get-notifications: func(params: get-notifications-params) -> result<notifications, get-notifications-error>;

  record get-notifications-unread-params {
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>
  }
  get-notifications-unread: func(params: get-notifications-unread-params) -> result<notifications, get-notifications-unread-error>;

}

interface posts {
  enum get-posts-order-enum {
    desc,
    asc,
  }

  enum get-posts-sort-enum {
    activity,
    creation,
    votes,
  }

  enum get-posts-ids-comments-sort-enum {
    creation,
    votes,
  }

  enum get-posts-ids-suggested-edits-sort-enum {
    creation,
    approval,
    rejection,
  }

  record posts {
    /// opaque schema; raw JSON
    value: string
  }

  record comments {
    /// opaque schema; raw JSON
    value: string
  }

  record revisions {
    /// opaque schema; raw JSON
    value: string
  }

  record suggested-edits {
    /// opaque schema; raw JSON
    value: string
  }

  record created-comment {
    body: option<string>,
    body-markdown: option<string>,
    can-flag: option<bool>,
    comment-id: option<s32>,
    creation-date: option<s32>,
    edited: option<bool>,
    link: option<string>,
    owner: option<created-comment-owner>,
    post-id: option<s32>,
    post-type: option<string>,
    reply-to-user: option<created-comment-reply-to-user>,
    score: option<s32>,
    upvoted: option<bool>
  }

  record created-comment-owner {
    accept-rate: option<s32>,
    badge-counts: option<created-comment-owner-badge-counts>,
    display-name: option<string>,
    link: option<string>,
    profile-image: option<string>,
    reputation: option<s32>,
    user-id: option<s32>,
    user-type: option<string>
  }

  record created-comment-owner-badge-counts {
    bronze: option<s32>,
    gold: option<s32>,
    silver: option<s32>
  }

  record created-comment-reply-to-user {
    accept-rate: option<s32>,
    badge-counts: option<created-comment-reply-to-user-badge-counts>,
