    order: option<get-users-order-enum>,
    /// sort = activity => date
    /// sort = creation => date
    max: option<string>,
    /// sort = activity => date
    /// sort = creation => date
    min: option<string>,
    sort: option<get-users-ids-answers-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
    todate: option<s32>,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-users-id-tags-tags-top-questions: func(params: get-users-id-tags-tags-top-questions-params) -> result<list<questions-item-v7>, get-users-id-tags-tags-top-questions-error>;

  record get-users-id-top-answer-tags-params {
    id: string,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
