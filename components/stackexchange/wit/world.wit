package autostamp:stackexchange@0.5.0;

interface access-tokens {
  record access-tokens {
    /// opaque schema; raw JSON
    value: string
  }

  variant get-access-tokens-access-tokens-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  variant get-access-tokens-access-tokens-invalidate-error {
    bad-request(string),
    unauthorized(string),
    payment-required(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    not-acceptable(string),
    internal-server-error(string),
    bad-gateway(string),
    service-unavailable(string),
    other(string)
  }

  record get-access-tokens-access-tokens-params {
    /// String list (semicolon delimited).
    access-tokens: string,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>
  }
  get-access-tokens-access-tokens: func(params: get-access-tokens-access-tokens-params) -> result<access-tokens, get-access-tokens-access-tokens-error>;

  record get-access-tokens-access-tokens-invalidate-params {
    /// String list (semicolon delimited).
    access-tokens: string,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>
  }
  get-access-tokens-access-tokens-invalidate: func(params: get-access-tokens-access-tokens-invalidate-params) -> result<access-tokens, get-access-tokens-access-tokens-invalidate-error>;

}


interface answers {
