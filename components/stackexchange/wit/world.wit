interface notifications {
  record notifications-item {
    body: option<string>,
    creation-date: option<s32>,
    is-unread: option<bool>,
    notification-type: option<string>,
    post-id: option<s32>,
    site: option<notifications-item-site>
  }

  record notifications-item-site {
    aliases: option<list<string>>,
    api-site-parameter: option<string>,
    audience: option<string>,
    closed-beta-date: option<s32>,
    favicon-url: option<string>,
    high-resolution-icon-url: option<string>,
    icon-url: option<string>,
    launch-date: option<s32>,
    logo-url: option<string>,
    markdown-extensions: option<list<string>>,
    name: option<string>,
    open-beta-date: option<s32>,
    related-sites: option<list<string>>,
    site-state: option<string>,
    site-type: option<string>,
    site-url: option<string>,
    styling: option<notifications-item-site-styling>,
    twitter-account: option<string>
  }

  record notifications-item-site-styling {
    link-color: option<string>,
    tag-background-color: option<string>,
    tag-foreground-color: option<string>
  }

  record notifications-item-v2 {
    body: option<string>,
    creation-date: option<s32>,
    is-unread: option<bool>,
    notification-type: option<string>,
    post-id: option<s32>,
    site: option<notifications-item-v2-site>
  }

  record notifications-item-v2-site {
    aliases: option<list<string>>,
    api-site-parameter: option<string>,
    audience: option<string>,
    closed-beta-date: option<s32>,
    favicon-url: option<string>,
