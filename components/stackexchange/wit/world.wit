    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-users-id-top-question-tags: func(params: get-users-id-top-question-tags-params) -> result<list<top-tag-objects-item-v2>, get-users-id-top-question-tags-error>;

  record get-users-id-write-permissions-params {
    id: string,
    pagesize: option<s32>,
    page: option<s32>,
    /// #Discussion
    /// 
    filter: option<string>,
    /// All API responses are JSON, we do support JSONP with the callback query parameter.
    callback: option<string>,
    /// Each of these methods operates on a single site at a time, identified by the site parameter. This parameter can be the full domain name (ie. "stackoverflow.com"), or a short form identified by api_site_parameter on the site object.
    site: string
  }
  get-users-id-write-permissions: func(params: get-users-id-write-permissions-params) -> result<list<write-permissions-item>, get-users-id-write-permissions-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export access-tokens;
  export answers;
  export apps;
  export badges;
  export comments;
  export errors;
  export events;
  export filters;
  export inbox;
  export info;
  export me;
  export notifications;
  export posts;
  export privileges;
  export questions;
  export revisions;
  export search;
  export similar;
  export sites;
  export suggested-edits;
  export tags;
  export users;
}
