  record get-comments-params {
    order: option<get-comments-order-enum>,
    /// sort = creation => date
    /// sort = votes => number
    max: option<string>,
    /// sort = creation => date
    /// sort = votes => number
    min: option<string>,
    sort: option<get-comments-sort-enum>,
    /// Unix date.
    fromdate: option<s32>,
    /// Unix date.
