  }
  get-templates-id-default-content: func(params: get-templates-id-default-content-params) -> result<get-templates-id-default-content-response, string>;

}

interface verified-domains {
  /// The verified domains currently on the account.
  record get-verified-domains-response {
    /// The domains on the account
    domains: option<list<get-verified-domains-response-domains-item>>,
    /// The total number of items matching the query regardless of pagination.
    total-items: option<s32>
  }

  /// The verified domains currently on the account.
  record get-verified-domains-response-domains-item {
    /// Whether domain authentication is enabled for this domain.
    authenticated: option<bool>,
    /// The name of this domain.
    domain: option<string>,
    /// The e-mail address receiving the two-factor challenge for this domain.
    verification-email: option<string>,
    /// The date/time that the two-factor challenge was sent to the verification email.
    verification-sent: option<string>,
    /// Whether the domain has been verified for sending.
    verified: option<bool>
  }

  /// The verified domains currently on the account.
  record create-verified-domain-response {
    /// Whether domain authentication is enabled for this domain.
    authenticated: option<bool>,
    /// The name of this domain.
    domain: option<string>,
    /// The e-mail address receiving the two-factor challenge for this domain.
    verification-email: option<string>,
    /// The date/time that the two-factor challenge was sent to the verification email.
    verification-sent: option<string>,
    /// Whether the domain has been verified for sending.
    verified: option<bool>
  }

  /// The verified domains currently on the account.
  record get-verified-domain-response {
    /// Whether domain authentication is enabled for this domain.
    authenticated: option<bool>,
    /// The name of this domain.
    domain: option<string>,
    /// The e-mail address receiving the two-factor challenge for this domain.
    verification-email: option<string>,
    /// The date/time that the two-factor challenge was sent to the verification email.
    verification-sent: option<string>,
    /// Whether the domain has been verified for sending.
    verified: option<bool>
  }

  /// The verified domains currently on the account.
  record verify-domain-response {
    /// Whether domain authentication is enabled for this domain.
    authenticated: option<bool>,
    /// The name of this domain.
    domain: option<string>,
    /// The e-mail address receiving the two-factor challenge for this domain.
    verification-email: option<string>,
    /// The date/time that the two-factor challenge was sent to the verification email.
    verification-sent: option<string>,
    /// Whether the domain has been verified for sending.
    verified: option<bool>
  }

  /// List sending domains
  get-verified-domains: func() -> result<get-verified-domains-response, string>;

  /// Add domain to account
  record create-verified-domain-params {
    /// The e-mail address at the domain you want to verify. This will receive a two-factor challenge to be used in the verify action.
    verification-email: string
  }
  create-verified-domain: func(params: create-verified-domain-params) -> result<create-verified-domain-response, string>;

  /// Get domain info
  record get-verified-domain-params {
    /// The domain name.
    domain-name: string
  }
  get-verified-domain: func(params: get-verified-domain-params) -> result<get-verified-domain-response, string>;

  /// Delete domain
  record delete-verified-domain-params {
    /// The domain name.
    domain-name: string
  }
  delete-verified-domain: func(params: delete-verified-domain-params) -> result<string, string>;

  /// Verify domain
  record verify-domain-params {
    /// The domain name.
    domain-name: string,
    /// The code that was sent to the email address provided when adding a new domain to verify.
    code: string
  }
  verify-domain: func(params: verify-domain-params) -> result<verify-domain-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export root;
  export account-exports;
  export account-export;
  export activity-feed;
  export authorized-apps;
  export automations;
  export batch-webhooks;
  export batches;
  export campaign-folders;
  export campaigns;
  export connected-sites;
  export conversations;
  export customer-journeys;
  export ecommerce;
  export facebook-ads;
  export file-manager;
  export landing-pages;
  export lists;
  export surveys;
  export ping;
  export reporting;
  export reports;
  export search-campaigns;
  export search-members;
  export template-folders;
  export templates;
  export verified-domains;
}
