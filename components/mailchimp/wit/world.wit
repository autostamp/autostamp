interface reports {
  enum get-reports-type-op-enum {
    regular,
    plaintext,
    absplit,
    rss,
    variate,
  }

  enum get-reports-response-links-item-method-enum {
    get,
    post,
    put,
    patch,
    delete,
    options,
    head,
  }

  enum get-reports-response-reports-item-delivery-status-status-enum {
    delivering,
    delivered,
    canceling,
    canceled,
  }

  enum get-reports-id-advice-response-advice-item-type-op-enum {
    negative,
    positive,
    neutral,
  }

  enum get-reports-id-click-details-sort-field-enum {
    total-clicks,
    unique-clicks,
  }

  enum get-reports-id-click-details-sort-dir-enum {
    asc,
    desc,
  }

  enum get-reports-id-ecommerce-product-activity-sort-field-enum {
    title,
    total-revenue,
    total-purchased,
  }

  enum get-reports-id-open-details-sort-field-enum {
    opens-count,
  }

  enum get-reports-id-sent-to-response-sent-to-item-absplit-group-enum {
    a,
    b,
    winner,
  }

  enum get-reports-id-sent-to-response-sent-to-item-status-enum {
    sent,
    hard,
    soft,
  }

  /// A list of reports containing campaigns marked as Sent.
  record get-reports-response {
    /// A list of link types and descriptions for the API schema documents.
    links: option<list<get-reports-response-links-item>>,
    /// An array of objects, each representing a report resource.
    reports: option<list<get-reports-response-reports-item>>,
    /// The total number of items matching the query regardless of pagination.
    total-items: option<s32>
  }

  /// This object represents a link from the resource where it is found to another resource or action that may be performed.
  record get-reports-response-links-item {
    /// This property contains a fully-qualified URL that can be called to retrieve the linked resource or perform the linked action.
    href: option<string>,
    /// The HTTP method that should be used when accessing the URL defined in 'href'.
    method: option<get-reports-response-links-item-method-enum>,
    /// As with an HTML 'rel' attribute, this describes the type of link.
    rel: option<string>,
    /// For HTTP methods that can receive bodies (POST and PUT), this is a URL representing the schema that the body should conform to.
    schema: option<string>,
    /// For GETs, this is a URL representing the schema that the response should conform to.
    target-schema: option<string>
  }

  /// Report details about a sent campaign.
  record get-reports-response-reports-item {
    /// A list of link types and descriptions for the API schema documents.
    links: option<list<get-reports-response-reports-item-links-item>>,
    /// General stats about different groups of an A/B Split campaign. Does not return information about Multivariate Campaigns.
    ab-split: option<get-reports-response-reports-item-ab-split>,
    /// The number of abuse reports generated for this campaign.
    abuse-reports: option<s32>,
    /// An object describing the bounce summary for the campaign.
    bounces: option<get-reports-response-reports-item-bounces>,
    /// The title of the campaign.
    campaign-title: option<string>,
    /// An object describing the click activity for the campaign.
    clicks: option<get-reports-response-reports-item-clicks>,
    /// Updates on campaigns in the process of sending.
    delivery-status: option<get-reports-response-reports-item-delivery-status>,
    /// E-Commerce stats for a campaign.
    ecommerce: option<get-reports-response-reports-item-ecommerce>,
    /// The total number of emails sent for this campaign.
    emails-sent: option<s32>,
    /// An object describing campaign engagement on Facebook.
    facebook-likes: option<get-reports-response-reports-item-facebook-likes>,
    /// An object describing the forwards and forward activity for the campaign.
    forwards: option<get-reports-response-reports-item-forwards>,
    /// A string that uniquely identifies this campaign.
    id: option<string>,
    /// The average campaign statistics for your industry.
    industry-stats: option<get-reports-response-reports-item-industry-stats>,
    /// The unique list id.
    list-id: option<string>,
    /// The status of the list used, namely if it's deleted or disabled.
    list-is-active: option<bool>,
    /// The name of the list.
    list-name: option<string>,
    /// The average campaign statistics for your list. This won't be present if we haven't calculated it yet for this list.
    list-stats: option<get-reports-response-reports-item-list-stats>,
    /// An object describing the open activity for the campaign.
    opens: option<get-reports-response-reports-item-opens>,
    /// The preview text for the campaign.
    preview-text: option<string>,
    /// For RSS campaigns, the date and time of the last send in ISO 8601 format.
    rss-last-send: option<string>,
    /// The date and time a campaign was sent in ISO 8601 format.
    send-time: option<string>,
    /// The url and password for the [VIP report](https://mailchimp.com/help/share-a-campaign-report/).
    share-report: option<get-reports-response-reports-item-share-report>,
    /// The subject line for the campaign.
    subject-line: option<string>,
    /// An hourly breakdown of the performance of the campaign over the first 24 hours.
    timeseries: option<list<get-reports-response-reports-item-timeseries-item>>,
    /// An hourly breakdown of sends, opens, and clicks if a campaign is sent using timewarp.
    timewarp: option<list<get-reports-response-reports-item-timewarp-item>>,
    /// The type of campaign (regular, plain-text, ab_split, rss, automation, variate, or auto).
    type-op: option<string>,
    /// The total number of unsubscribed members for this campaign.
    unsubscribed: option<s32>
  }

  /// This object represents a link from the resource where it is found to another resource or action that may be performed.
  record get-reports-response-reports-item-links-item {
    /// This property contains a fully-qualified URL that can be called to retrieve the linked resource or perform the linked action.
    href: option<string>,
    /// The HTTP method that should be used when accessing the URL defined in 'href'.
    method: option<get-reports-response-links-item-method-enum>,
    /// As with an HTML 'rel' attribute, this describes the type of link.
    rel: option<string>,
    /// For HTTP methods that can receive bodies (POST and PUT), this is a URL representing the schema that the body should conform to.
    schema: option<string>,
    /// For GETs, this is a URL representing the schema that the response should conform to.
    target-schema: option<string>
  }

  /// General stats about different groups of an A/B Split campaign. Does not return information about Multivariate Campaigns.
  record get-reports-response-reports-item-ab-split {
    /// Stats for Campaign A.
    a: option<get-reports-response-reports-item-ab-split-a>,
    /// Stats for Campaign B.
    b: option<get-reports-response-reports-item-ab-split-b>
  }

  /// Stats for Campaign A.
  record get-reports-response-reports-item-ab-split-a {
    /// Abuse reports for Campaign A.
    abuse-reports: option<s32>,
    /// Bounces for Campaign A.
    bounces: option<s32>,
    /// Forwards for Campaign A.
    forwards: option<s32>,
    /// Opens from forwards for Campaign A.
    forwards-opens: option<s32>,
    /// The last open for Campaign A.
    last-open: option<string>,
    /// Opens for Campaign A.
    opens: option<s32>,
    /// Recipient Clicks for Campaign A.
    recipient-clicks: option<s32>,
    /// Unique opens for Campaign A.
    unique-opens: option<s32>,
    /// Unsubscribes for Campaign A.
    unsubs: option<s32>
  }

  /// Stats for Campaign B.
  record get-reports-response-reports-item-ab-split-b {
    /// Abuse reports for Campaign B.
    abuse-reports: option<s32>,
    /// Bounces for Campaign B.
    bounces: option<s32>,
    /// Forwards for Campaign B.
    forwards: option<s32>,
    /// Opens for forwards from Campaign B.
    forwards-opens: option<s32>,
    /// The last open for Campaign B.
    last-open: option<string>,
    /// Opens for Campaign B.
    opens: option<s32>,
    /// Recipients clicks for Campaign B.
    recipient-clicks: option<s32>,
    /// Unique opens for Campaign B.
    unique-opens: option<s32>,
    /// Unsubscribes for Campaign B.
    unsubs: option<s32>
  }

  /// An object describing the bounce summary for the campaign.
  record get-reports-response-reports-item-bounces {
    /// The total number of hard bounced email addresses.
    hard-bounces: option<s32>,
    /// The total number of soft bounced email addresses.
    soft-bounces: option<s32>,
    /// The total number of addresses that were syntax-related bounces.
    syntax-errors: option<s32>
  }

  /// An object describing the click activity for the campaign.
  record get-reports-response-reports-item-clicks {
    /// The number of unique clicks divided by the total number of successful deliveries.
    click-rate: option<f64>,
    /// The total number of clicks for the campaign.
    clicks-total: option<s32>,
    /// The date and time of the last recorded click for the campaign in ISO 8601 format.
    last-click: option<string>,
    /// The total number of unique clicks for links across a campaign.
    unique-clicks: option<s32>,
    /// The total number of subscribers who clicked on a campaign.
    unique-subscriber-clicks: option<s32>
  }

  /// Updates on campaigns in the process of sending.
  record get-reports-response-reports-item-delivery-status {
    /// Whether a campaign send can be canceled.
    can-cancel: option<bool>,
    /// The total number of emails canceled for this campaign.
    emails-canceled: option<s32>,
    /// The total number of emails confirmed sent for this campaign so far.
    emails-sent: option<s32>,
    /// Whether Campaign Delivery Status is enabled for this account and campaign.
    enabled: option<bool>,
    /// The current state of a campaign delivery.
    status: option<get-reports-response-reports-item-delivery-status-status-enum>
  }

  /// E-Commerce stats for a campaign.
  record get-reports-response-reports-item-ecommerce {
    currency-code: option<string>,
    /// The total orders for a campaign.
    total-orders: option<s32>,
    /// The total revenue for a campaign. Calculated as the sum of all order totals minus shipping and tax totals.
    total-revenue: option<f64>,
    /// The total spent for a campaign. Calculated as the sum of all order totals with no deductions.
    total-spent: option<f64>
  }

  /// An object describing campaign engagement on Facebook.
  record get-reports-response-reports-item-facebook-likes {
    /// The number of Facebook likes for the campaign.
    facebook-likes: option<s32>,
    /// The number of recipients who liked the campaign on Facebook.
    recipient-likes: option<s32>,
    /// The number of unique likes.
    unique-likes: option<s32>
  }

  /// An object describing the forwards and forward activity for the campaign.
  record get-reports-response-reports-item-forwards {
    /// How many times the campaign has been forwarded.
    forwards-count: option<s32>,
    /// How many times the forwarded campaign has been opened.
    forwards-opens: option<s32>
  }

  /// The average campaign statistics for your industry.
  record get-reports-response-reports-item-industry-stats {
    /// The industry abuse rate.
