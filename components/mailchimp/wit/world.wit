    settings: option<post-campaigns-body-settings>,
    /// The preview for the campaign, rendered by social networks like Facebook and Twitter. [Learn more](https://mailchimp.com/help/enable-and-customize-social-cards/).
    social-card: option<post-campaigns-body-social-card>,
    /// The tracking options for a campaign.
    tracking: option<post-campaigns-body-tracking>,
    /// There are four types of [campaigns](https://mailchimp.com/help/getting-started-with-campaigns/) you can create in Mailchimp. A/B Split campaigns have been deprecated and variate campaigns should be used instead.
    type-op: get-campaigns-type-op-enum,
    /// The settings specific to A/B test campaigns.
    variate-settings: option<post-campaigns-body-variate-settings>
  }
  post-campaigns: func(params: post-campaigns-params) -> result<string, string>;

