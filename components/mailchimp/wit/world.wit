}

interface automations {
  enum get-automations-status-enum {
    save,
    paused,
    sending,
  }

  enum patch-automation-email-workflow-id-body-delay-action-enum {
    signup,
    ecomm-abandoned-browse,
    ecomm-abandoned-cart,
  }

  enum patch-automation-email-workflow-id-body-delay-direction-enum {
    after,
  }

  enum patch-automation-email-workflow-id-body-delay-type-op-enum {
    now,
    day,
    hour,
    week,
  }

  /// List settings for the Automation.
  record post-automations-body-recipients {
    /// The id of the List.
    list-id: option<string>,
    /// The id of the store.
    store-id: option<string>
  }

  /// The settings for the Automation workflow.
  record post-automations-body-settings {
    /// The 'from' name for the Automation (not an email address).
    from-name: option<string>,
    /// The reply-to email address for the Automation.
    reply-to: option<string>
  }

  /// Trigger settings for the Automation.
  record post-automations-body-trigger-settings {
    /// The type of Automation workflow. Currently only supports 'abandonedCart'.
    workflow-type: string
  }

  /// The delay settings for an automation email.
  record patch-automation-email-workflow-id-body-delay {
    /// The action that triggers the delay of an automation emails.
    action: patch-automation-email-workflow-id-body-delay-action-enum,
    /// The delay amount for an automation email.
    amount: option<s32>,
    /// Whether the delay settings describe before or after the delay action of an automation email.
    direction: option<patch-automation-email-workflow-id-body-delay-direction-enum>,
    /// The type of delay for an automation email.
    type-op: option<patch-automation-email-workflow-id-body-delay-type-op-enum>
  }

  /// Settings for the campaign including the email subject, from name, and from email address.
  record patch-automation-email-workflow-id-body-settings {
    /// The 'from' name for the Automation (not an email address).
    from-name: option<string>,
    /// The preview text for the campaign.
    preview-text: option<string>,
    /// The reply-to email address for the Automation.
    reply-to: option<string>,
    /// The subject line for the campaign.
    subject-line: option<string>,
    /// The title of the Automation.
    title: option<string>
  }

  /// List automations
  record get-automations-params {
    /// The number of records to return. Default value is 10. Maximum value is 1000
    count: option<s32>,
    /// Used for [pagination](https://mailchimp.com/developer/marketing/docs/methods-parameters/#pagination), this it the number of records from a collection to skip. Default value is 0.
    offset: option<s32>,
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// Restrict the response to automations created before this time. Uses the ISO 8601 time format: 2015-10-21T15:41:36+00:00.
    before-create-time: option<string>,
    /// Restrict the response to automations created after this time. Uses the ISO 8601 time format: 2015-10-21T15:41:36+00:00.
    since-create-time: option<string>,
    /// Restrict the response to automations started before this time. Uses the ISO 8601 time format: 2015-10-21T15:41:36+00:00.
    before-start-time: option<string>,
    /// Restrict the response to automations started after this time. Uses the ISO 8601 time format: 2015-10-21T15:41:36+00:00.
    since-start-time: option<string>,
    /// Restrict the results to automations with the specified status.
    status: option<get-automations-status-enum>
  }
  get-automations: func(params: get-automations-params) -> result<string, string>;

  /// Add automation
  record post-automations-params {
    /// List settings for the Automation.
    recipients: post-automations-body-recipients,
    /// The settings for the Automation workflow.
    settings: option<post-automations-body-settings>,
    /// Trigger settings for the Automation.
    trigger-settings: post-automations-body-trigger-settings
  }
  post-automations: func(params: post-automations-params) -> result<string, string>;

  /// Get automation info
  record get-automations-id-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The unique id for the Automation workflow.
    workflow-id: string
  }
  get-automations-id: func(params: get-automations-id-params) -> result<string, string>;

  /// Archive automation
  record archive-automations-params {
    /// The unique id for the Automation workflow.
    workflow-id: string
  }
  archive-automations: func(params: archive-automations-params) -> result<string, string>;

  /// Pause automation emails
  record post-automations-id-actions-pause-all-emails-params {
    /// The unique id for the Automation workflow.
    workflow-id: string
  }
  post-automations-id-actions-pause-all-emails: func(params: post-automations-id-actions-pause-all-emails-params) -> result<string, string>;

  /// Start automation emails
  record post-automations-id-actions-start-all-emails-params {
    /// The unique id for the Automation workflow.
    workflow-id: string
  }
  post-automations-id-actions-start-all-emails: func(params: post-automations-id-actions-start-all-emails-params) -> result<string, string>;

  /// List automated emails
  record get-automations-id-emails-params {
    /// The unique id for the Automation workflow.
    workflow-id: string
  }
  get-automations-id-emails: func(params: get-automations-id-emails-params) -> result<string, string>;

  /// Get workflow email info
  record get-automations-id-emails-id-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The unique id for the Automation workflow email.
    workflow-email-id: string
  }
  get-automations-id-emails-id: func(params: get-automations-id-emails-id-params) -> result<string, string>;

  /// Update workflow email
  record patch-automation-email-workflow-id-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The unique id for the Automation workflow email.
    workflow-email-id: string,
    /// The delay settings for an automation email.
    delay: option<patch-automation-email-workflow-id-body-delay>,
    /// Settings for the campaign including the email subject, from name, and from email address.
    settings: option<patch-automation-email-workflow-id-body-settings>
  }
  patch-automation-email-workflow-id: func(params: patch-automation-email-workflow-id-params) -> result<string, string>;

  /// Delete workflow email
  record delete-automations-id-emails-id-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The unique id for the Automation workflow email.
    workflow-email-id: string
  }
  delete-automations-id-emails-id: func(params: delete-automations-id-emails-id-params) -> result<string, string>;

  /// Pause automated email
  record post-automations-id-emails-id-actions-pause-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The unique id for the Automation workflow email.
    workflow-email-id: string
  }
  post-automations-id-emails-id-actions-pause: func(params: post-automations-id-emails-id-actions-pause-params) -> result<string, string>;

  /// Start automated email
  record post-automations-id-emails-id-actions-start-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The unique id for the Automation workflow email.
    workflow-email-id: string
  }
  post-automations-id-emails-id-actions-start: func(params: post-automations-id-emails-id-actions-start-params) -> result<string, string>;

  /// List automated email subscribers
  record get-automations-id-emails-id-queue-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The unique id for the Automation workflow email.
    workflow-email-id: string
  }
  get-automations-id-emails-id-queue: func(params: get-automations-id-emails-id-queue-params) -> result<string, string>;

  /// Add subscriber to workflow email
  record post-automations-id-emails-id-queue-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The unique id for the Automation workflow email.
    workflow-email-id: string,
    /// The list member's email address.
    email-address: string
  }
  post-automations-id-emails-id-queue: func(params: post-automations-id-emails-id-queue-params) -> result<string, string>;

  /// Get automated email subscriber
  record get-automations-id-emails-id-queue-id-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The unique id for the Automation workflow email.
    workflow-email-id: string,
    /// The MD5 hash of the lowercase version of the list member's email address.
    subscriber-hash: string
  }
  get-automations-id-emails-id-queue-id: func(params: get-automations-id-emails-id-queue-id-params) -> result<string, string>;

  /// List subscribers removed from workflow
  record get-automations-id-removed-subscribers-params {
    /// The unique id for the Automation workflow.
    workflow-id: string
  }
  get-automations-id-removed-subscribers: func(params: get-automations-id-removed-subscribers-params) -> result<string, string>;

  /// Remove subscriber from workflow
  record post-automations-id-removed-subscribers-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The list member's email address.
    email-address: string
  }
  post-automations-id-removed-subscribers: func(params: post-automations-id-removed-subscribers-params) -> result<string, string>;

  /// Get subscriber removed from workflow
  record get-automations-id-removed-subscribers-id-params {
    /// The unique id for the Automation workflow.
    workflow-id: string,
    /// The MD5 hash of the lowercase version of the list member's email address.
    subscriber-hash: string
  }
  get-automations-id-removed-subscribers-id: func(params: get-automations-id-removed-subscribers-id-params) -> result<string, string>;

}

interface batch-webhooks {
  /// List batch webhooks
  record get-batch-webhooks-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The number of records to return. Default value is 10. Maximum value is 1000
    count: option<s32>,
    /// Used for [pagination](https://mailchimp.com/developer/marketing/docs/methods-parameters/#pagination), this it the number of records from a collection to skip. Default value is 0.
    offset: option<s32>
  }
