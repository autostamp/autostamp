interface search-campaigns {
  enum get-search-campaigns-response-links-item-method-enum {
    get,
    post,
    put,
    patch,
    delete,
    options,
    head,
  }

  enum get-search-campaigns-response-results-item-campaign-ab-split-opts-pick-winner-enum {
    opens,
    clicks,
    manual,
  }

  enum get-search-campaigns-response-results-item-campaign-ab-split-opts-split-test-enum {
    subject,
    from-name,
    schedule,
  }

  enum get-search-campaigns-response-results-item-campaign-ab-split-opts-wait-units-enum {
    hours,
    days,
  }

  enum get-search-campaigns-response-results-item-campaign-content-type-enum {
    template,
    html,
    url,
    multichannel,
  }

  enum get-search-campaigns-response-results-item-campaign-delivery-status-status-enum {
    delivering,
    delivered,
    canceling,
    canceled,
  }

  enum get-search-campaigns-response-results-item-campaign-recipients-segment-opts-match-enum {
    any,
    all,
  }

  enum get-search-campaigns-response-results-item-campaign-rss-opts-frequency-enum {
    daily,
    weekly,
    monthly,
  }

  enum get-search-campaigns-response-results-item-campaign-rss-opts-schedule-weekly-send-day-enum {
    sunday,
    monday,
    tuesday,
    wednesday,
    thursday,
    friday,
    saturday,
  }

  enum get-search-campaigns-response-results-item-campaign-status-enum {
    save,
    paused,
    schedule,
    sending,
    sent,
    canceled,
    canceling,
    archived,
  }

  enum get-search-campaigns-response-results-item-campaign-type-op-enum {
    regular,
    plaintext,
    absplit,
    rss,
    variate,
  }

  enum get-search-campaigns-response-results-item-campaign-variate-settings-winner-criteria-enum {
    opens,
    clicks,
    manual,
    total-revenue,
  }

  /// Campaigns and Snippets found for given search term.
  record get-search-campaigns-response {
    /// A list of link types and descriptions for the API schema documents.
    links: option<list<get-search-campaigns-response-links-item>>,
    /// An array of matching campaigns and snippets.
    results: option<list<get-search-campaigns-response-results-item>>,
    /// The total number of items matching the query regardless of pagination.
    total-items: option<s32>
  }

  /// This object represents a link from the resource where it is found to another resource or action that may be performed.
  record get-search-campaigns-response-links-item {
    /// This property contains a fully-qualified URL that can be called to retrieve the linked resource or perform the linked action.
    href: option<string>,
    /// The HTTP method that should be used when accessing the URL defined in 'href'.
    method: option<get-search-campaigns-response-links-item-method-enum>,
    /// As with an HTML 'rel' attribute, this describes the type of link.
    rel: option<string>,
    /// For HTTP methods that can receive bodies (POST and PUT), this is a URL representing the schema that the body should conform to.
    schema: option<string>,
    /// For GETs, this is a URL representing the schema that the response should conform to.
    target-schema: option<string>
  }

  record get-search-campaigns-response-results-item {
    /// A summary of an individual campaign's settings and content.
    campaign: option<get-search-campaigns-response-results-item-campaign>,
    snippet: option<string>
  }

  /// A summary of an individual campaign's settings and content.
  record get-search-campaigns-response-results-item-campaign {
    /// A list of link types and descriptions for the API schema documents.
    links: option<list<get-search-campaigns-response-results-item-campaign-links-item>>,
    /// [A/B Testing](https://mailchimp.com/help/about-ab-testing-campaigns/) options for a campaign.
    ab-split-opts: option<get-search-campaigns-response-results-item-campaign-ab-split-opts>,
    /// The link to the campaign's archive version in ISO 8601 format.
    archive-url: option<string>,
    /// How the campaign's content is put together.
    content-type: option<get-search-campaigns-response-results-item-campaign-content-type-enum>,
    /// The date and time the campaign was created in ISO 8601 format.
    create-time: option<string>,
    /// Updates on campaigns in the process of sending.
    delivery-status: option<get-search-campaigns-response-results-item-campaign-delivery-status>,
    /// The total number of emails sent for this campaign.
    emails-sent: option<s32>,
    /// A string that uniquely identifies this campaign.
    id: option<string>,
    /// The original link to the campaign's archive version.
    long-archive-url: option<string>,
    /// Determines if the campaign needs its blocks refreshed by opening the web-based campaign editor. Deprecated and will always return false.
    needs-block-refresh: option<bool>,
    /// If this campaign is the child of another campaign, this identifies the parent campaign. For Example, for RSS or Automation children.
    parent-campaign-id: option<string>,
    /// List settings for the campaign.
    recipients: option<get-search-campaigns-response-results-item-campaign-recipients>,
    /// For sent campaigns, a summary of opens, clicks, and e-commerce data.
    report-summary: option<get-search-campaigns-response-results-item-campaign-report-summary>,
    /// Determines if the campaign qualifies to be resent to non-openers.
    resendable: option<bool>,
    /// [RSS](https://mailchimp.com/help/share-your-blog-posts-with-mailchimp/) options for a campaign.
    rss-opts: option<get-search-campaigns-response-results-item-campaign-rss-opts>,
    /// The date and time a campaign was sent.
    send-time: option<string>,
    /// The settings for your campaign, including subject, from name, reply-to address, and more.
    settings: option<get-search-campaigns-response-results-item-campaign-settings>,
    /// The preview for the campaign, rendered by social networks like Facebook and Twitter. [Learn more](https://mailchimp.com/help/enable-and-customize-social-cards/).
    social-card: option<get-search-campaigns-response-results-item-campaign-social-card>,
    /// The current status of the campaign.
    status: option<get-search-campaigns-response-results-item-campaign-status-enum>,
    /// The tracking options for a campaign.
    tracking: option<get-search-campaigns-response-results-item-campaign-tracking>,
    /// There are four types of [campaigns](https://mailchimp.com/help/getting-started-with-campaigns/) you can create in Mailchimp. A/B Split campaigns have been deprecated and variate campaigns should be used instead.
    type-op: option<get-search-campaigns-response-results-item-campaign-type-op-enum>,
    /// The settings specific to A/B test campaigns.
    variate-settings: option<get-search-campaigns-response-results-item-campaign-variate-settings>,
    /// The ID used in the Mailchimp web application. View this campaign in your Mailchimp account at `https://{dc}.admin.mailchimp.com/campaigns/show/?id={web_id}`.
    web-id: option<s32>
  }

  /// This object represents a link from the resource where it is found to another resource or action that may be performed.
  record get-search-campaigns-response-results-item-campaign-links-item {
    /// This property contains a fully-qualified URL that can be called to retrieve the linked resource or perform the linked action.
    href: option<string>,
    /// The HTTP method that should be used when accessing the URL defined in 'href'.
    method: option<get-search-campaigns-response-links-item-method-enum>,
    /// As with an HTML 'rel' attribute, this describes the type of link.
    rel: option<string>,
    /// For HTTP methods that can receive bodies (POST and PUT), this is a URL representing the schema that the body should conform to.
    schema: option<string>,
    /// For GETs, this is a URL representing the schema that the response should conform to.
    target-schema: option<string>
  }

  /// [A/B Testing](https://mailchimp.com/help/about-ab-testing-campaigns/) options for a campaign.
  record get-search-campaigns-response-results-item-campaign-ab-split-opts {
    /// For campaigns split on 'From Name', the name for Group A.
    from-name-a: option<string>,
    /// For campaigns split on 'From Name', the name for Group B.
    from-name-b: option<string>,
    /// How we should evaluate a winner. Based on 'opens', 'clicks', or 'manual'.
    pick-winner: option<get-search-campaigns-response-results-item-campaign-ab-split-opts-pick-winner-enum>,
    /// For campaigns split on 'From Name', the reply-to address for Group A.
    reply-email-a: option<string>,
    /// For campaigns split on 'From Name', the reply-to address for Group B.
    reply-email-b: option<string>,
    /// The send time for Group A.
    send-time-a: option<string>,
    /// The send time for Group B.
    send-time-b: option<string>,
    /// The send time for the winning version.
    send-time-winner: option<string>,
    /// The size of the split groups. Campaigns split based on 'schedule' are forced to have a 50/50 split. Valid split integers are between 1-50.
    split-size: option<s32>,
    /// The type of AB split to run.
    split-test: option<get-search-campaigns-response-results-item-campaign-ab-split-opts-split-test-enum>,
    /// For campaigns split on 'Subject Line', the subject line for Group A.
    subject-a: option<string>,
    /// For campaigns split on 'Subject Line', the subject line for Group B.
    subject-b: option<string>,
    /// The amount of time to wait before picking a winner. This cannot be changed after a campaign is sent.
    wait-time: option<s32>,
    /// How unit of time for measuring the winner ('hours' or 'days'). This cannot be changed after a campaign is sent.
    wait-units: option<get-search-campaigns-response-results-item-campaign-ab-split-opts-wait-units-enum>
  }

  /// Updates on campaigns in the process of sending.
  record get-search-campaigns-response-results-item-campaign-delivery-status {
    /// Whether a campaign send can be canceled.
    can-cancel: option<bool>,
    /// The total number of emails canceled for this campaign.
    emails-canceled: option<s32>,
    /// The total number of emails confirmed sent for this campaign so far.
    emails-sent: option<s32>,
    /// Whether Campaign Delivery Status is enabled for this account and campaign.
    enabled: option<bool>,
    /// The current state of a campaign delivery.
    status: option<get-search-campaigns-response-results-item-campaign-delivery-status-status-enum>
  }

  /// List settings for the campaign.
  record get-search-campaigns-response-results-item-campaign-recipients {
    /// The unique list id.
    list-id: option<string>,
    /// The status of the list used, namely if it's deleted or disabled.
    list-is-active: option<bool>,
    /// The name of the list.
    list-name: option<string>,
    /// Count of the recipients on the associated list. Formatted as an integer.
    recipient-count: option<s32>,
    /// An object representing all segmentation options. This object should contain a `saved_segment_id` to use an existing segment, or you can create a new segment by including both `match` and `conditions` options.
    segment-opts: option<get-search-campaigns-response-results-item-campaign-recipients-segment-opts>,
    /// A description of the [segment](https://mailchimp.com/help/create-and-send-to-a-segment/) used for the campaign. Formatted as a string marked up with HTML.
    segment-text: option<string>
  }

  /// An object representing all segmentation options. This object should contain a `saved_segment_id` to use an existing segment, or you can create a new segment by including both `match` and `conditions` options.
  record get-search-campaigns-response-results-item-campaign-recipients-segment-opts {
    /// Segment match conditions. There are multiple possible types, see the [condition types documentation](https://mailchimp.com/developer/marketing/docs/alternative-schemas/#segment-condition-schemas).
    conditions: option<list<string>>,
    /// Segment match type.
    match: option<get-search-campaigns-response-results-item-campaign-recipients-segment-opts-match-enum>,
    /// The prebuilt segment id, if a prebuilt segment has been designated for this campaign.
    prebuilt-segment-id: option<string>,
    /// The id for an existing saved segment.
    saved-segment-id: option<s32>
  }

  /// For sent campaigns, a summary of opens, clicks, and e-commerce data.
  record get-search-campaigns-response-results-item-campaign-report-summary {
    /// The number of unique clicks divided by the total number of successful deliveries.
    click-rate: option<f64>,
    /// The total number of clicks for an campaign.
    clicks: option<s32>,
    /// E-Commerce stats for a campaign.
    ecommerce: option<get-search-campaigns-response-results-item-campaign-report-summary-ecommerce>,
    /// The number of unique opens divided by the total number of successful deliveries.
    open-rate: option<f64>,
    /// The total number of opens for a campaign.
    opens: option<s32>,
    /// The number of unique clicks.
    subscriber-clicks: option<s32>,
    /// The number of unique opens.
    unique-opens: option<s32>
  }

  /// E-Commerce stats for a campaign.
  record get-search-campaigns-response-results-item-campaign-report-summary-ecommerce {
    /// The total orders for a campaign.
    total-orders: option<s32>,
    /// The total revenue for a campaign. Calculated as the sum of all order totals minus shipping and tax totals.
    total-revenue: option<f64>,
    /// The total spent for a campaign. Calculated as the sum of all order totals with no deductions.
    total-spent: option<f64>
  }

  /// [RSS](https://mailchimp.com/help/share-your-blog-posts-with-mailchimp/) options for a campaign.
  record get-search-campaigns-response-results-item-campaign-rss-opts {
    /// Whether to add CSS to images in the RSS feed to constrain their width in campaigns.
    constrain-rss-img: option<bool>,
    /// The URL for the RSS feed.
    feed-url: option<string>,
    /// The frequency of the RSS Campaign.
    frequency: option<get-search-campaigns-response-results-item-campaign-rss-opts-frequency-enum>,
    /// The date the campaign was last sent.
    last-sent: option<string>,
    /// The schedule for sending the RSS Campaign.
    schedule: option<get-search-campaigns-response-results-item-campaign-rss-opts-schedule>
  }

  /// The schedule for sending the RSS Campaign.
  record get-search-campaigns-response-results-item-campaign-rss-opts-schedule {
    /// The days of the week to send a daily RSS Campaign.
    daily-send: option<get-search-campaigns-response-results-item-campaign-rss-opts-schedule-daily-send>,
    /// The hour to send the campaign in local time. Acceptable hours are 0-23. For example, '4' would be 4am in [your account's default time zone](https://mailchimp.com/help/set-account-defaults/).
    hour: option<s32>,
    /// The day of the month to send a monthly RSS Campaign. Acceptable days are 0-31, where '0' is always the last day of a month. Months with fewer than the selected number of days will not have an RSS campaign sent out that day. For example, RSS Campaigns set to send on the 30th will not go out in February.
    monthly-send-date: option<f64>,
    /// The day of the week to send a weekly RSS Campaign.
    weekly-send-day: option<get-search-campaigns-response-results-item-campaign-rss-opts-schedule-weekly-send-day-enum>
  }

  /// The days of the week to send a daily RSS Campaign.
  record get-search-campaigns-response-results-item-campaign-rss-opts-schedule-daily-send {
    /// Sends the daily RSS Campaign on Fridays.
    friday: option<bool>,
    /// Sends the daily RSS Campaign on Mondays.
    monday: option<bool>,
    /// Sends the daily RSS Campaign on Saturdays.
    saturday: option<bool>,
    /// Sends the daily RSS Campaign on Sundays.
    sunday: option<bool>,
    /// Sends the daily RSS Campaign on Thursdays.
    thursday: option<bool>,
    /// Sends the daily RSS Campaign on Tuesdays.
    tuesday: option<bool>,
    /// Sends the daily RSS Campaign on Wednesdays.
    wednesday: option<bool>
  }

  /// The settings for your campaign, including subject, from name, reply-to address, and more.
  record get-search-campaigns-response-results-item-campaign-settings {
    /// Whether Mailchimp [authenticated](https://mailchimp.com/help/about-email-authentication/) the campaign. Defaults to `true`.
    authenticate: option<bool>,
    /// An array of [Facebook](https://mailchimp.com/help/connect-or-disconnect-the-facebook-integration/) page ids to auto-post to.
    auto-fb-post: option<list<string>>,
    /// Automatically append Mailchimp's [default footer](https://mailchimp.com/help/about-campaign-footers/) to the campaign.
    auto-footer: option<bool>,
    /// Automatically tweet a link to the [campaign archive](https://mailchimp.com/help/about-email-campaign-archives-and-pages/) page when the campaign is sent.
    auto-tweet: option<bool>,
    /// Whether the campaign uses the drag-and-drop editor.
    drag-and-drop: option<bool>,
    /// Allows Facebook comments on the campaign (also force-enables the Campaign Archive toolbar). Defaults to `true`.
    fb-comments: option<bool>,
    /// If the campaign is listed in a folder, the id for that folder.
    folder-id: option<string>,
    /// The 'from' name on the campaign (not an email address).
    from-name: option<string>,
    /// Automatically inline the CSS included with the campaign content.
    inline-css: option<bool>,
    /// The preview text for the campaign.
    preview-text: option<string>,
    /// The reply-to email address for the campaign.
    reply-to: option<string>,
    /// The subject line for the campaign.
    subject-line: option<string>,
    /// The id for the template used in this campaign.
    template-id: option<s32>,
    /// Send this campaign using [Timewarp](https://mailchimp.com/help/use-timewarp/).
    timewarp: option<bool>,
    /// The title of the campaign.
    title: option<string>,
    /// The campaign's custom 'To' name. Typically the first name [audience field](https://mailchimp.com/help/getting-started-with-merge-tags/).
    to-name: option<string>,
    /// Use Mailchimp Conversation feature to manage out-of-office replies.
    use-conversation: option<bool>
  }

  /// The preview for the campaign, rendered by social networks like Facebook and Twitter. [Learn more](https://mailchimp.com/help/enable-and-customize-social-cards/).
  record get-search-campaigns-response-results-item-campaign-social-card {
    /// A short summary of the campaign to display.
    description: option<string>,
    /// The url for the header image for the card.
    image-url: option<string>,
    /// The title for the card. Typically the subject line of the campaign.
    title: option<string>
  }

  /// The tracking options for a campaign.
  record get-search-campaigns-response-results-item-campaign-tracking {
    /// Deprecated
    capsule: option<get-search-campaigns-response-results-item-campaign-tracking-capsule>,
    /// The custom slug for [ClickTale](https://mailchimp.com/help/additional-tracking-options-for-campaigns/) tracking (max of 50 bytes).
    clicktale: option<string>,
    /// Whether to enable e-commerce tracking.
    ecomm360: option<bool>,
    /// Deprecated
    goal-tracking: option<bool>,
    /// The custom slug for [Google Analytics](https://mailchimp.com/help/integrate-google-analytics-with-mailchimp/) tracking (max of 50 bytes).
    google-analytics: option<string>,
    /// Whether to [track clicks](https://mailchimp.com/help/enable-and-view-click-tracking/) in the HTML version of the campaign. Defaults to `true`. Cannot be set to false for variate campaigns.
    html-clicks: option<bool>,
    /// Whether to [track opens](https://mailchimp.com/help/about-open-tracking/). Defaults to `true`. Cannot be set to false for variate campaigns.
    opens: option<bool>,
    /// Deprecated
    salesforce: option<get-search-campaigns-response-results-item-campaign-tracking-salesforce>,
    /// Whether to [track clicks](https://mailchimp.com/help/enable-and-view-click-tracking/) in the plain-text version of the campaign. Defaults to `true`. Cannot be set to false for variate campaigns.
    text-clicks: option<bool>
  }

  /// Deprecated
  record get-search-campaigns-response-results-item-campaign-tracking-capsule {
    /// Update contact notes for a campaign based on subscriber email addresses.
    notes: option<bool>
  }

  /// Deprecated
  record get-search-campaigns-response-results-item-campaign-tracking-salesforce {
    /// Create a campaign in a connected Salesforce account.
    campaign: option<bool>,
    /// Update contact notes for a campaign based on subscriber email addresses.
    notes: option<bool>
  }

  /// The settings specific to A/B test campaigns.
  record get-search-campaigns-response-results-item-campaign-variate-settings {
    /// Combinations of possible variables used to build emails.
    combinations: option<list<get-search-campaigns-response-results-item-campaign-variate-settings-combinations-item>>,
    /// Descriptions of possible email contents. To set campaign contents, make a PUT request to /campaigns/{campaign_id}/content with the field 'variate_contents'.
    contents: option<list<string>>,
    /// The possible from names. The number of from_names provided must match the number of reply_to_addresses. If no from_names are provided, settings.from_name will be used.
    from-names: option<list<string>>,
    /// The possible reply-to addresses. The number of reply_to_addresses provided must match the number of from_names. If no reply_to_addresses are provided, settings.reply_to will be used.
    reply-to-addresses: option<list<string>>,
    /// The possible send times to test. The times provided should be in the format YYYY-MM-DD HH:MM:SS. If send_times are provided to test, the test_size will be set to 100% and winner_criteria will be ignored.
    send-times: option<list<string>>,
    /// The possible subject lines to test. If no subject lines are provided, settings.subject_line will be used.
    subject-lines: option<list<string>>,
    /// The percentage of recipients to send the test combinations to, must be a value between 10 and 100.
    test-size: option<s32>,
    /// The number of minutes to wait before choosing the winning campaign. The value of wait_time must be greater than 0 and in whole hours, specified in minutes.
    wait-time: option<s32>,
    /// The combination that performs the best. This may be determined automatically by click rate, open rate, or total revenue -- or you may choose manually based on the reporting data you find the most valuable. For Multivariate Campaigns testing send_time, winner_criteria is ignored. For Multivariate Campaigns with 'manual' as the winner_criteria, the winner must be chosen in the Mailchimp web application.
    winner-criteria: option<get-search-campaigns-response-results-item-campaign-variate-settings-winner-criteria-enum>,
    /// ID of the campaign that was sent to the remaining recipients based on the winning combination.
    winning-campaign-id: option<string>,
    /// ID for the winning combination.
    winning-combination-id: option<string>
  }

  record get-search-campaigns-response-results-item-campaign-variate-settings-combinations-item {
    /// The index of `variate_settings.contents` used.
    content-description: option<s32>,
    /// The index of `variate_settings.from_names` used.
    from-name: option<s32>,
    /// Unique ID for the combination.
    id: option<string>,
    /// The number of recipients for this combination.
    recipients: option<s32>,
    /// The index of `variate_settings.reply_to_addresses` used.
    reply-to: option<s32>,
    /// The index of `variate_settings.send_times` used.
    send-time: option<s32>,
    /// The index of `variate_settings.subject_lines` used.
    subject-line: option<s32>
  }

  /// Search campaigns
  record get-search-campaigns-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The search query used to filter results.
    query: string
  }
  get-search-campaigns: func(params: get-search-campaigns-params) -> result<get-search-campaigns-response, string>;

}

interface search-members {
  enum get-search-members-response-links-item-method-enum {
    get,
    post,
    put,
    patch,
    delete,
    options,
    head,
  }

  enum get-search-members-response-exact-matches-members-item-status-enum {
    subscribed,
    unsubscribed,
    cleaned,
    pending,
    transactional,
    archived,
  }

  /// Members found for given search term
  record get-search-members-response {
    /// A list of link types and descriptions for the API schema documents.
    links: option<list<get-search-members-response-links-item>>,
    /// Exact matches of the provided search query.
    exact-matches: option<get-search-members-response-exact-matches>,
    /// Partial matches of the provided search query.
    full-search: option<get-search-members-response-full-search>
  }

  /// This object represents a link from the resource where it is found to another resource or action that may be performed.
  record get-search-members-response-links-item {
    /// This property contains a fully-qualified URL that can be called to retrieve the linked resource or perform the linked action.
    href: option<string>,
    /// The HTTP method that should be used when accessing the URL defined in 'href'.
    method: option<get-search-members-response-links-item-method-enum>,
    /// As with an HTML 'rel' attribute, this describes the type of link.
    rel: option<string>,
    /// For HTTP methods that can receive bodies (POST and PUT), this is a URL representing the schema that the body should conform to.
    schema: option<string>,
    /// For GETs, this is a URL representing the schema that the response should conform to.
    target-schema: option<string>
  }

  /// Exact matches of the provided search query.
  record get-search-members-response-exact-matches {
    /// An array of objects, each representing a specific list member.
    members: option<list<get-search-members-response-exact-matches-members-item>>,
    /// The total number of items matching the query regardless of pagination.
    total-items: option<s32>
  }

  /// Individuals who are currently or have been previously subscribed to this list, including members who have bounced or unsubscribed.
  record get-search-members-response-exact-matches-members-item {
    /// A list of link types and descriptions for the API schema documents.
    links: option<list<get-search-members-response-exact-matches-members-item-links-item>>,
    /// Indicates whether a contact consents to 1:1 messaging.
    consents-to-one-to-one-messaging: option<bool>,
    /// As Mailchimp evolves beyond email, you may eventually have contacts without email addresses. While the `id` is the MD5 hash of their email address, this `contact_id` is agnostic of contact’s inclusion of an email address.
    contact-id: option<string>,
    /// Email address for a subscriber.
    email-address: option<string>,
    /// The list member's email client.
    email-client: option<string>,
    /// Type of email this member asked to get ('html' or 'text').
    email-type: option<string>,
    /// The contact's full name.
    full-name: option<string>,
    /// The MD5 hash of the lowercase version of the list member's email address.
    id: option<string>,
    /// The key of this object's properties is the ID of the interest in question.
    interests: option<list<get-search-members-response-exact-matches-members-item-interests-entry>>,
    /// The IP address the subscriber used to confirm their opt-in status.
    ip-opt: option<string>,
    /// IP address the subscriber signed up from.
    ip-signup: option<string>,
    /// If set/detected, the [subscriber's language](https://mailchimp.com/help/view-and-edit-contact-languages/).
    language: option<string>,
    /// The date and time the member's info was last changed in ISO 8601 format.
    last-changed: option<string>,
    /// The most recent Note added about this member.
    last-note: option<get-search-members-response-exact-matches-members-item-last-note>,
    /// The list id.
    list-id: option<string>,
    /// Subscriber location information.
    location: option<get-search-members-response-exact-matches-members-item-location>,
    /// The marketing permissions for the subscriber.
    marketing-permissions: option<list<get-search-members-response-exact-matches-members-item-marketing-permissions-item>>,
    /// Star rating for this member, between 1 and 5.
    member-rating: option<s32>,
    /// A dictionary of merge fields where the keys are the merge tags. See the [Merge Fields documentation](https://mailchimp.com/developer/marketing/docs/merge-fields/#structure) for more about the structure.
    merge-fields: option<list<get-search-members-response-exact-matches-members-item-merge-fields-entry>>,
    /// The source from which the subscriber was added to this list.
    source: option<string>,
    /// Open and click rates for this subscriber.
    stats: option<get-search-members-response-exact-matches-members-item-stats>,
    /// Subscriber's current status.
    status: option<get-search-members-response-exact-matches-members-item-status-enum>,
