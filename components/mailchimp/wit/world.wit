interface campaigns {
  enum get-campaigns-type-op-enum {
    regular,
    plaintext,
    absplit,
    rss,
    variate,
  }

  enum get-campaigns-status-enum {
    save,
    paused,
    schedule,
    sending,
    sent,
  }

  enum get-campaigns-sort-field-enum {
    create-time,
    send-time,
  }

  enum get-campaigns-sort-dir-enum {
    asc,
    desc,
  }

  enum post-campaigns-body-content-type-enum {
    template,
    multichannel,
  }

  enum post-campaigns-body-recipients-segment-opts-match-enum {
    any,
    all,
  }

  enum post-campaigns-body-rss-opts-frequency-enum {
    daily,
    weekly,
    monthly,
  }

  enum post-campaigns-body-rss-opts-schedule-weekly-send-day-enum {
    sunday,
    monday,
    tuesday,
    wednesday,
    thursday,
    friday,
    saturday,
  }

  enum post-campaigns-body-variate-settings-winner-criteria-enum {
    opens,
    clicks,
    manual,
    total-revenue,
  }

  enum post-campaigns-id-actions-test-body-send-type-enum {
    html,
    plaintext,
  }

  enum put-campaigns-id-content-body-archive-archive-type-enum {
    zip,
    tar-gz,
    tar-bz2,
    tar,
    tgz,
    tbz,
  }

  /// List settings for the campaign.
  record post-campaigns-body-recipients {
    /// The unique list id.
    list-id: string,
    /// An object representing all segmentation options. This object should contain a `saved_segment_id` to use an existing segment, or you can create a new segment by including both `match` and `conditions` options.
    segment-opts: option<post-campaigns-body-recipients-segment-opts>
  }

  /// An object representing all segmentation options. This object should contain a `saved_segment_id` to use an existing segment, or you can create a new segment by including both `match` and `conditions` options.
  record post-campaigns-body-recipients-segment-opts {
    /// Segment match conditions. There are multiple possible types, see the [condition types documentation](https://mailchimp.com/developer/marketing/docs/alternative-schemas/#segment-condition-schemas).
    conditions: option<list<string>>,
    /// Segment match type.
    match: option<post-campaigns-body-recipients-segment-opts-match-enum>,
    /// The id for an existing saved segment.
    saved-segment-id: option<s32>
  }

  /// [RSS](https://mailchimp.com/help/share-your-blog-posts-with-mailchimp/) options, specific to an RSS campaign.
  record post-campaigns-body-rss-opts {
    /// Whether to add CSS to images in the RSS feed to constrain their width in campaigns.
    constrain-rss-img: option<bool>,
    /// The URL for the RSS feed.
    feed-url: string,
    /// The frequency of the RSS Campaign.
    frequency: post-campaigns-body-rss-opts-frequency-enum,
    /// The schedule for sending the RSS Campaign.
    schedule: option<post-campaigns-body-rss-opts-schedule>
  }

  /// The schedule for sending the RSS Campaign.
  record post-campaigns-body-rss-opts-schedule {
    /// The days of the week to send a daily RSS Campaign.
    daily-send: option<post-campaigns-body-rss-opts-schedule-daily-send>,
    /// The hour to send the campaign in local time. Acceptable hours are 0-23. For example, '4' would be 4am in [your account's default time zone](https://mailchimp.com/help/set-account-defaults/).
    hour: option<s32>,
    /// The day of the month to send a monthly RSS Campaign. Acceptable days are 0-31, where '0' is always the last day of a month. Months with fewer than the selected number of days will not have an RSS campaign sent out that day. For example, RSS Campaigns set to send on the 30th will not go out in February.
    monthly-send-date: option<f64>,
    /// The day of the week to send a weekly RSS Campaign.
    weekly-send-day: option<post-campaigns-body-rss-opts-schedule-weekly-send-day-enum>
  }

  /// The days of the week to send a daily RSS Campaign.
  record post-campaigns-body-rss-opts-schedule-daily-send {
    /// Sends the daily RSS Campaign on Fridays.
    friday: option<bool>,
    /// Sends the daily RSS Campaign on Mondays.
    monday: option<bool>,
