interface templates {
  enum get-templates-sort-field-enum {
    date-created,
    date-edited,
    name,
  }

  enum get-templates-content-type-enum {
    html,
    template,
    multichannel,
  }

  enum get-templates-sort-dir-enum {
    asc,
    desc,
  }

  /// List templates
  record get-templates-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The number of records to return. Default value is 10. Maximum value is 1000
    count: option<s32>,
    /// Used for [pagination](https://mailchimp.com/developer/marketing/docs/methods-parameters/#pagination), this it the number of records from a collection to skip. Default value is 0.
    offset: option<s32>,
    /// The Mailchimp account user who created the template.
    created-by: option<string>,
    /// Restrict the response to templates created after the set date. Uses ISO 8601 time format: 2015-10-21T15:41:36+00:00.
    since-date-created: option<string>,
    /// Restrict the response to templates created before the set date. Uses ISO 8601 time format: 2015-10-21T15:41:36+00:00.
    before-date-created: option<string>,
    /// Limit results based on template type.
    type-op: option<string>,
    /// Limit results based on category.
    category: option<string>,
    /// The unique folder id.
    folder-id: option<string>,
    /// Returns user templates sorted by the specified field.
    sort-field: option<get-templates-sort-field-enum>,
    /// Limit results based on how the template's content is put together. Only templates of type `user` can be filtered by `content_type`. If you want to retrieve saved templates created with the legacy email editor, then filter `content_type` to `template`. If you'd rather pull your saved templates for the new editor, filter to `multichannel`. For code your own templates, filter to `html`.
    content-type: option<get-templates-content-type-enum>,
    /// Determines the order direction for sorted results.
    sort-dir: option<get-templates-sort-dir-enum>
  }
  get-templates: func(params: get-templates-params) -> result<string, string>;

  /// Add template
  record post-templates-params {
    /// The id of the folder the template is currently in.
    folder-id: option<string>,
    /// The raw HTML for the template. We  support the Mailchimp [Template Language](https://mailchimp.com/help/getting-started-with-mailchimps-template-language/) in any HTML code passed via the API.
    html: string,
    /// The name of the template.
    name: string
  }
  post-templates: func(params: post-templates-params) -> result<string, string>;

  /// Get template info
  record get-templates-id-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The unique id for the template.
    template-id: string
  }
  get-templates-id: func(params: get-templates-id-params) -> result<string, string>;

  /// Update template
  record patch-templates-id-params {
    /// The unique id for the template.
    template-id: string,
    /// The id of the folder the template is currently in.
    folder-id: option<string>,
    /// The raw HTML for the template. We  support the Mailchimp [Template Language](https://mailchimp.com/help/getting-started-with-mailchimps-template-language/) in any HTML code passed via the API.
    html: string,
    /// The name of the template.
    name: string
  }
  patch-templates-id: func(params: patch-templates-id-params) -> result<string, string>;

  /// Delete template
  record delete-templates-id-params {
    /// The unique id for the template.
    template-id: string
  }
  delete-templates-id: func(params: delete-templates-id-params) -> result<string, string>;

  /// View default content
  record get-templates-id-default-content-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The unique id for the template.
    template-id: string
  }
  get-templates-id-default-content: func(params: get-templates-id-default-content-params) -> result<string, string>;

}

interface verified-domains {
  /// List sending domains
  get-verified-domains: func() -> result<string, string>;

  /// Add domain to account
  record create-verified-domain-params {
    /// The e-mail address at the domain you want to verify. This will receive a two-factor challenge to be used in the verify action.
    verification-email: string
  }
  create-verified-domain: func(params: create-verified-domain-params) -> result<string, string>;

  /// Get domain info
  record get-verified-domain-params {
    /// The domain name.
    domain-name: string
  }
  get-verified-domain: func(params: get-verified-domain-params) -> result<string, string>;

  /// Delete domain
  record delete-verified-domain-params {
    /// The domain name.
    domain-name: string
  }
  delete-verified-domain: func(params: delete-verified-domain-params) -> result<string, string>;

  /// Verify domain
  record verify-domain-params {
    /// The domain name.
    domain-name: string,
    /// The code that was sent to the email address provided when adding a new domain to verify.
    code: string
  }
  verify-domain: func(params: verify-domain-params) -> result<string, string>;

}
/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export root;
  export account-exports;
  export account-export;
  export activity-feed;
  export authorized-apps;
  export automations;
  export batch-webhooks;
  export batches;
  export campaign-folders;
  export campaigns;
  export connected-sites;
  export conversations;
  export customer-journeys;
  export ecommerce;
  export facebook-ads;
  export file-manager;
  export landing-pages;
  export lists;
  export surveys;
  export ping;
  export reporting;
  export reports;
  export search-campaigns;
  export search-members;
  export template-folders;
  export templates;
  export verified-domains;
}
