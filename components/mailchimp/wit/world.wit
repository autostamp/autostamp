    get,
    post,
    put,
    patch,
    delete,
    options,
    head,
  }

  enum get-all-facebook-ads-response-facebook-ads-item-recipients-segment-opts-match-enum {
    any,
    all,
  }

  enum get-all-facebook-ads-response-facebook-ads-item-status-enum {
    save,
    paused,
    schedule,
    scheduled,
    sending,
    sent,
    canceled,
    canceling,
    active,
    disconnected,
    somepaused,
    draft,
    completed,
    partial-rejected,
    pending,
    rejected,
    published,
    unpublished,
  }

