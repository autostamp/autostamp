    /// Whether the webhook receives requests or not.
    enabled: option<bool>,
    /// A valid URL for the Webhook.
    url: string
  }
  post-batch-webhooks: func(params: post-batch-webhooks-params) -> result<string, string>;

  /// Get batch webhook info
  record get-batch-webhook-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The unique id for the batch webhook.
    batch-webhook-id: string
  }
  get-batch-webhook: func(params: get-batch-webhook-params) -> result<string, string>;

  /// Update batch webhook
  record patch-batch-webhooks-params {
    /// The unique id for the batch webhook.
    batch-webhook-id: string,
    /// Whether the webhook receives requests or not.
    enabled: option<bool>,
    /// A valid URL for the Webhook.
    url: option<string>
  }
  patch-batch-webhooks: func(params: patch-batch-webhooks-params) -> result<string, string>;

  /// Delete batch webhook
  record delete-batch-webhook-id-params {
    /// The unique id for the batch webhook.
    batch-webhook-id: string
  }
  delete-batch-webhook-id: func(params: delete-batch-webhook-id-params) -> result<string, string>;

}

interface batches {
  enum post-batches-body-operations-item-method-enum {
    get,
    post,
    put,
    patch,
    delete,
  }

  record post-batches-body-operations-item {
    /// A string containing the JSON body to use with the request.
    body: option<string>,
    /// The HTTP method to use for the operation.
    method: post-batches-body-operations-item-method-enum,
    /// An optional client-supplied id returned with the operation results.
    operation-id: option<string>,
    /// Any request query parameters. Example parameters: {"count":10, "offset":0}
    params: option<post-batches-body-operations-item-params>,
    /// The relative path to use for the operation.
    path: string
  }

  /// Any request query parameters. Example parameters: {"count":10, "offset":0}
  record post-batches-body-operations-item-params {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List batch requests
  record get-batches-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The number of records to return. Default value is 10. Maximum value is 1000
    count: option<s32>,
    /// Used for [pagination](https://mailchimp.com/developer/marketing/docs/methods-parameters/#pagination), this it the number of records from a collection to skip. Default value is 0.
    offset: option<s32>
  }
  get-batches: func(params: get-batches-params) -> result<string, string>;

  /// Start batch operation
  record post-batches-params {
    /// An array of objects that describes operations to perform.
    operations: list<post-batches-body-operations-item>
  }
  post-batches: func(params: post-batches-params) -> result<string, string>;

  /// Get batch operation status
  record get-batches-id-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The unique id for the batch operation.
    batch-id: string
  }
  get-batches-id: func(params: get-batches-id-params) -> result<string, string>;

  /// Delete batch request
  record delete-batches-id-params {
    /// The unique id for the batch operation.
    batch-id: string
  }
  delete-batches-id: func(params: delete-batches-id-params) -> result<string, string>;

}

interface campaign-folders {
  /// List campaign folders
  record get-campaign-folders-params {
