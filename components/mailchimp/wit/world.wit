    schema: option<string>,
    /// For GETs, this is a URL representing the schema that the response should conform to.
    target-schema: option<string>
  }

  /// A summary of an individual Automation workflow's settings and content.
  record get-automations-response-automations-item {
    /// A list of link types and descriptions for the API schema documents.
    links: option<list<get-automations-response-automations-item-links-item>>,
    /// The date and time the Automation was created in ISO 8601 format.
    create-time: option<string>,
    /// The total number of emails sent for the Automation.
    emails-sent: option<s32>,
    /// A string that identifies the Automation.
    id: option<string>,
    /// List settings for the Automation.
    recipients: option<get-automations-response-automations-item-recipients>,
    /// A summary of opens and clicks for sent campaigns.
    report-summary: option<get-automations-response-automations-item-report-summary>,
    /// The settings for the Automation workflow.
    settings: option<get-automations-response-automations-item-settings>,
    /// The date and time the Automation was started in ISO 8601 format.
    start-time: option<string>,
    /// The current status of the Automation.
    status: option<get-automations-status-enum>,
    /// The tracking options for the Automation.
