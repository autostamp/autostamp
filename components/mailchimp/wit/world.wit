    status: option<get-campaigns-response-campaigns-item-status-enum>,
    /// The tracking options for a campaign.
    tracking: option<post-campaigns-response-tracking>,
    /// There are four types of [campaigns](https://mailchimp.com/help/getting-started-with-campaigns/) you can create in Mailchimp. A/B Split campaigns have been deprecated and variate campaigns should be used instead.
    type-op: option<get-campaigns-type-op-enum>,
    /// The settings specific to A/B test campaigns.
    variate-settings: option<post-campaigns-response-variate-settings>,
    /// The ID used in the Mailchimp web application. View this campaign in your Mailchimp account at `https://{dc}.admin.mailchimp.com/campaigns/show/?id={web_id}`.
