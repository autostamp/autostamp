/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `basicAuth` | `Authorization: Basic base64(<secret>)` |
package autostamp:mailchimp@0.2.0;

interface root {
  /// List api root resources
  record get-root-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>
  }
  get-root: func(params: get-root-params) -> result<string, string>;

}


interface account-exports {
  enum post-account-export-body-include-stages-item-enum {
    audiences,
    campaigns,
    events,
    gallery-files,
    reports,
    templates,
  }

  /// List account exports
  record get-account-exports-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The number of records to return. Default value is 10. Maximum value is 1000
    count: option<s32>,
    /// Used for [pagination](https://mailchimp.com/developer/marketing/docs/methods-parameters/#pagination), this it the number of records from a collection to skip. Default value is 0.
    offset: option<s32>
  }
  get-account-exports: func(params: get-account-exports-params) -> result<string, string>;

  /// Add export
  record post-account-export-params {
    /// The stages of an account export to include.
    include-stages: list<post-account-export-body-include-stages-item-enum>,
    /// An ISO 8601 date that will limit the export to only records created after a given time. For instance, the reports stage will contain any campaign sent after the given timestamp. Audiences, however, are excluded from this limit.
    since-timestamp: option<string>
  }
  post-account-export: func(params: post-account-export-params) -> result<string, string>;

}

interface account-export {
  /// Get account export info
  record get-account-export-id-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>,
    /// The unique id for the account export.
    export-id: string
  }
  get-account-export-id: func(params: get-account-export-id-params) -> result<string, string>;

}

