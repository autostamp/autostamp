/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `basicAuth` | `Authorization: Basic base64(<secret>)` |
package autostamp:mailchimp@0.6.0;

interface root {
  enum get-root-response-links-item-method-enum {
    get,
    post,
    put,
    patch,
    delete,
    options,
    head,
  }

  enum get-root-response-pricing-plan-type-enum {
    monthly,
    pay-as-you-go,
    forever-free,
  }

  /// The API root resource links to all other resources available in the API.
  record get-root-response {
    /// A list of link types and descriptions for the API schema documents.
    links: option<list<get-root-response-links-item>>,
    /// The Mailchimp account ID.
    account-id: option<string>,
    /// The user-specified industry associated with the account.
    account-industry: option<string>,
    /// The name of the account.
    account-name: option<string>,
    /// The timezone currently set for the account.
    account-timezone: option<string>,
    /// URL of the avatar for the user.
    avatar-url: option<string>,
    /// Information about the account contact.
    contact: option<get-root-response-contact>,
    /// The account email address.
    email: option<string>,
    /// The first name tied to the account.
    first-name: option<string>,
    /// Date of first payment for monthly plans.
    first-payment: option<string>,
    /// The [average campaign statistics](https://mailchimp.com/resources/research/email-marketing-benchmarks/?utm_source=mc-api&utm_medium=docs&utm_campaign=apidocs) for all campaigns in the account's specified industry.
    industry-stats: option<get-root-response-industry-stats>,
    /// The date and time of the last login for this account in ISO 8601 format.
    last-login: option<string>,
    /// The last name tied to the account.
    last-name: option<string>,
    /// The ID associated with the user who owns this API key. If you can login to multiple accounts, this ID will be the same for each account.
    login-id: option<string>,
    /// The date and time that the account was created in ISO 8601 format.
    member-since: option<string>,
    /// The type of pricing plan the account is on.
    pricing-plan-type: option<get-root-response-pricing-plan-type-enum>,
    /// Legacy - whether the account includes [Mailchimp Pro](https://mailchimp.com/help/about-mailchimp-pro/).
    pro-enabled: option<bool>,
    /// The [user role](https://mailchimp.com/help/manage-user-levels-in-your-account/) for the account.
    role: option<string>,
    /// The total number of subscribers across all lists in the account.
    total-subscribers: option<s32>,
    /// The username tied to the account.
    username: option<string>
  }

  /// This object represents a link from the resource where it is found to another resource or action that may be performed.
  record get-root-response-links-item {
    /// This property contains a fully-qualified URL that can be called to retrieve the linked resource or perform the linked action.
    href: option<string>,
    /// The HTTP method that should be used when accessing the URL defined in 'href'.
    method: option<get-root-response-links-item-method-enum>,
    /// As with an HTML 'rel' attribute, this describes the type of link.
    rel: option<string>,
    /// For HTTP methods that can receive bodies (POST and PUT), this is a URL representing the schema that the body should conform to.
    schema: option<string>,
    /// For GETs, this is a URL representing the schema that the response should conform to.
    target-schema: option<string>
  }

  /// Information about the account contact.
  record get-root-response-contact {
    /// The street address for the account contact.
    addr1: option<string>,
    /// The street address for the account contact.
    addr2: option<string>,
    /// The city for the account contact.
    city: option<string>,
    /// The company name for the account.
    company: option<string>,
    /// The country for the account contact.
    country: option<string>,
    /// The state for the account contact.
    state: option<string>,
    /// The zip code for the account contact.
    zip: option<string>
  }

  /// The [average campaign statistics](https://mailchimp.com/resources/research/email-marketing-benchmarks/?utm_source=mc-api&utm_medium=docs&utm_campaign=apidocs) for all campaigns in the account's specified industry.
  record get-root-response-industry-stats {
    /// The average bounce rate for all campaigns in the account's specified industry.
    bounce-rate: option<f64>,
    /// The average unique click rate for all campaigns in the account's specified industry.
    click-rate: option<f64>,
    /// The average unique open rate for all campaigns in the account's specified industry.
    open-rate: option<f64>
  }

  /// List api root resources
  record get-root-params {
    /// A comma-separated list of fields to return. Reference parameters of sub-objects with dot notation.
    fields: option<list<string>>,
    /// A comma-separated list of fields to exclude. Reference parameters of sub-objects with dot notation.
    exclude-fields: option<list<string>>
  }
  get-root: func(params: get-root-params) -> result<get-root-response, string>;

}


