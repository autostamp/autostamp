}

interface issue-tracker {
  enum issue-content-markup-enum {
    markdown,
    creole,
    plaintext,
  }

  enum issue-kind-enum {
    bug,
    enhancement,
    proposal,
    task,
  }

  enum issue-priority-enum {
    trivial,
    minor,
    major,
    critical,
    blocker,
  }

  enum repository-fork-policy-enum {
    allow-forks,
    no-public-forks,
    no-forks,
  }

  enum participant-role-enum {
    participant,
    reviewer,
  }

  enum participant-state-enum {
    approved,
    changes-requested,
  }

  enum branch-merge-strategies-item-enum {
    merge-commit,
    squash,
    fast-forward,
  }

  enum repository-scm-enum {
    git,
  }

  enum issue-state-enum {
    submitted,
    new,
    open,
    resolved,
    on-hold,
    invalid,
    duplicate,
    wontfix,
    closed,
  }

  enum issue-job-status-status-enum {
    accepted,
    started,
    running,
    failure,
  }

  /// A paginated list of issue tracker components.
  record paginated-components {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<component>>
  }

  record component {
    type-op: string,
    id: option<s32>,
    links: option<component-links>,
    name: option<string>
  }

  record component-links {
    /// A link to a resource related to this object.
    self: option<component-links-self>
  }

  /// A link to a resource related to this object.
  record component-links-self {
    href: option<string>,
    name: option<string>
  }

  /// A paginated list of issues.
  record paginated-issues {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<issue>>
  }

  record issue {
    type-op: string,
    assignee: option<account>,
    component: option<component>,
    content: option<issue-content>,
    created-on: option<string>,
    edited-on: option<string>,
    id: option<s32>,
    kind: option<issue-kind-enum>,
    links: option<issue-links>,
    milestone: option<milestone>,
    priority: option<issue-priority-enum>,
    reporter: option<account>,
    repository: option<repository>,
    state: option<issue-state-enum>,
    title: option<string>,
    updated-on: option<string>,
    version: option<version>,
    votes: option<s32>
  }

  record account {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  record issue-content {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<issue-content-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record issue-links {
    /// A link to a resource related to this object.
    attachments: option<issue-links-attachments>,
    /// A link to a resource related to this object.
    comments: option<issue-links-comments>,
    /// A link to a resource related to this object.
    html: option<issue-links-html>,
    /// A link to a resource related to this object.
    self: option<issue-links-self>,
    /// A link to a resource related to this object.
    vote: option<issue-links-vote>,
    /// A link to a resource related to this object.
    watch: option<issue-links-watch>
  }

  /// A link to a resource related to this object.
  record issue-links-attachments {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record issue-links-comments {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record issue-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record issue-links-self {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record issue-links-vote {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record issue-links-watch {
    href: option<string>,
    name: option<string>
  }

  record milestone {
    type-op: string,
    id: option<s32>,
    links: option<milestone-links>,
    name: option<string>
  }

  record milestone-links {
    /// A link to a resource related to this object.
    self: option<milestone-links-self>
  }

  /// A link to a resource related to this object.
  record milestone-links-self {
    href: option<string>,
    name: option<string>
  }

  record repository {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Controls the rules for forking this repository.
    fork-policy: option<repository-fork-policy-enum>,
    /// The concatenation of the repository owner's username and the slugified name, e.g. "evzijst/interruptingcow". This is the same string used in Bitbucket URLs.
    full-name: option<string>,
    has-issues: option<bool>,
    has-wiki: option<bool>,
    is-private: option<bool>,
    language: option<string>,
    links: option<repository-links>,
    mainbranch: option<branch>,
    name: option<string>,
    owner: option<account>,
    parent: option<string>,
    project: option<project>,
    scm: option<repository-scm-enum>,
    size: option<s32>,
    updated-on: option<string>,
    /// The repository's immutable id. This can be used as a substitute for the slug segment in URLs. Doing this guarantees your URLs will survive renaming of the repository by its owner, or even transfer of the repository to a different user.
    uuid: option<string>
  }

  record repository-links {
    /// A link to a resource related to this object.
    avatar: option<repository-links-avatar>,
    clone: option<list<repository-links-clone-item>>,
    /// A link to a resource related to this object.
    commits: option<repository-links-commits>,
    /// A link to a resource related to this object.
    downloads: option<repository-links-downloads>,
    /// A link to a resource related to this object.
    forks: option<repository-links-forks>,
    /// A link to a resource related to this object.
    hooks: option<repository-links-hooks>,
    /// A link to a resource related to this object.
    html: option<repository-links-html>,
    /// A link to a resource related to this object.
    pullrequests: option<repository-links-pullrequests>,
    /// A link to a resource related to this object.
    self: option<repository-links-self>,
    /// A link to a resource related to this object.
    watchers: option<repository-links-watchers>
  }

  /// A link to a resource related to this object.
  record repository-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-clone-item {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-downloads {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-forks {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-hooks {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-pullrequests {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-self {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-watchers {
    href: option<string>,
    name: option<string>
  }

  record branch {
    links: option<branch-links>,
    /// The name of the ref.
    name: option<string>,
    target: option<commit>,
    type-op: string,
    /// The default merge strategy for pull requests targeting this branch.
    default-merge-strategy: option<string>,
    /// Available merge strategies for pull requests targeting this branch.
    merge-strategies: option<list<branch-merge-strategies-item-enum>>
  }

  record branch-links {
    /// A link to a resource related to this object.
    commits: option<branch-links-commits>,
    /// A link to a resource related to this object.
    html: option<branch-links-html>,
    /// A link to a resource related to this object.
    self: option<branch-links-self>
  }

  /// A link to a resource related to this object.
  record branch-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record branch-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record branch-links-self {
    href: option<string>,
    name: option<string>
  }

  record commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<base-commit>>,
    summary: option<commit-summary>,
    participants: option<list<participant>>,
    repository: option<string>
  }

  record author {
    type-op: string,
    /// The raw author value from the repository. This may be the only value available if the author does not match a user in Bitbucket.
    raw: option<string>,
    user: option<account>
  }

  record base-commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<string>>,
    summary: option<base-commit-summary>
  }

  record base-commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<issue-content-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<issue-content-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record participant {
    type-op: string,
    approved: option<bool>,
    /// The ISO8601 timestamp of the participant's action. For approvers, this is the time of their approval. For commenters and pull request reviewers who are not approvers, this is the time they last commented, or null if they have not commented.
    participated-on: option<string>,
    role: option<participant-role-enum>,
    state: option<participant-state-enum>,
    user: option<account>
  }

  record project {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Indicates whether the project contains publicly visible repositories.
    has-publicly-visible-repos: option<bool>,
    /// 
    /// Indicates whether the project is publicly accessible, or whether it is
    is-private: option<bool>,
    /// The project's key.
    key: option<string>,
    links: option<project-links>,
    /// The name of the project.
    name: option<string>,
    owner: option<team>,
    updated-on: option<string>,
    /// The project's immutable id.
    uuid: option<string>
  }

  record project-links {
    /// A link to a resource related to this object.
    avatar: option<project-links-avatar>,
    /// A link to a resource related to this object.
    html: option<project-links-html>
  }

  /// A link to a resource related to this object.
  record project-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record project-links-html {
    href: option<string>,
    name: option<string>
  }

  record team {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  record version {
    type-op: string,
    id: option<s32>,
    links: option<version-links>,
    name: option<string>
  }

  record version-links {
    /// A link to a resource related to this object.
    self: option<version-links-self>
  }

  /// A link to a resource related to this object.
  record version-links-self {
    href: option<string>,
    name: option<string>
  }

  /// The status of an import or export job
  record issue-job-status {
    /// The total number of issues already imported/exported
    count: option<s32>,
    /// The percentage of issues already imported/exported
    pct: option<f64>,
    /// The phase of the import/export job
    phase: option<string>,
    /// The status of the import/export job
    status: option<issue-job-status-status-enum>,
    /// The total number of issues being imported/exported
    total: option<s32>,
    type-op: option<string>
  }

  /// A paginated list of issue attachments.
  record paginated-issue-attachments {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<issue-attachment>>
  }

  record issue-attachment {
    type-op: string,
    links: option<issue-attachment-links>,
    name: option<string>
  }

  record issue-attachment-links {
    /// A link to a resource related to this object.
    self: option<issue-attachment-links-self>
  }

  /// A link to a resource related to this object.
  record issue-attachment-links-self {
    href: option<string>,
    name: option<string>
  }

  /// A paginated list of issue changes.
  record paginated-log-entries {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<issue-change>>
  }

  /// An issue change.
  record issue-change {
    changes: option<issue-change-changes>,
    created-on: option<string>,
    issue: option<issue>,
    links: option<issue-change-links>,
    message: option<issue-change-message>,
    name: option<string>,
    type-op: string,
    user: option<account>
  }

  record issue-change-changes {
    assignee: option<issue-change-changes-assignee>,
    component: option<issue-change-changes-component>,
    content: option<issue-change-changes-content>,
    kind: option<issue-change-changes-kind>,
    milestone: option<issue-change-changes-milestone>,
    priority: option<issue-change-changes-priority>,
    state: option<issue-change-changes-state>,
    title: option<issue-change-changes-title>,
    version: option<issue-change-changes-version>
  }

  record issue-change-changes-assignee {
    new: option<string>,
    old: option<string>
  }

  record issue-change-changes-component {
    new: option<string>,
    old: option<string>
  }

  record issue-change-changes-content {
    new: option<string>,
    old: option<string>
  }

  record issue-change-changes-kind {
    new: option<string>,
    old: option<string>
  }

  record issue-change-changes-milestone {
    new: option<string>,
    old: option<string>
  }

  record issue-change-changes-priority {
    new: option<string>,
    old: option<string>
  }

  record issue-change-changes-state {
    new: option<string>,
    old: option<string>
  }

  record issue-change-changes-title {
    new: option<string>,
    old: option<string>
  }

  record issue-change-changes-version {
    new: option<string>,
    old: option<string>
  }

  record issue-change-links {
    /// A link to a resource related to this object.
    issue: option<issue-change-links-issue>,
    /// A link to a resource related to this object.
    self: option<issue-change-links-self>
  }

  /// A link to a resource related to this object.
  record issue-change-links-issue {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record issue-change-links-self {
    href: option<string>,
    name: option<string>
  }

  record issue-change-message {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<issue-content-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

