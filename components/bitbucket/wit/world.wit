    /// The name of the property.
    property-name: string
  }
  delete-pull-request-hosted-property-value: func(params: delete-pull-request-hosted-property-value-params) -> result<string, string>;

  /// Get a user application property
  record retrieve-user-hosted-property-value-params {
    /// Either the UUID of the account surrounded by curly-braces, for example `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  retrieve-user-hosted-property-value: func(params: retrieve-user-hosted-property-value-params) -> result<application-property, string>;

  /// Update a user application property
  record update-user-hosted-property-value-params {
    /// Either the UUID of the account surrounded by curly-braces, for example `{account UUID}`, OR an Atlassian Account ID.
