  /// List snippets
  record get-snippets-params {
    /// Filter down the result based on the authenticated user's role (`owner`, `contributor`, or `member`).
    role: option<get-snippets-role-enum>
  }
  get-snippets: func(params: get-snippets-params) -> result<paginated-snippets, get-snippets-error>;

  /// Create a snippet
  record post-snippets-params {
    type-op: string,
    created-on: option<string>,
    creator: option<account>,
    id: option<s32>,
    is-private: option<bool>,
    owner: option<account>,
    /// The DVCS used to store the snippet.
    scm: option<snippet-scm-enum>,
    title: option<string>,
    updated-on: option<string>
  }
  post-snippets: func(params: post-snippets-params) -> result<snippet, post-snippets-error>;

  /// List snippets in a workspace
  record get-snippets-workspace-params {
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    /// Filter down the result based on the authenticated user's role (`owner`, `contributor`, or `member`).
    role: option<get-snippets-role-enum>
  }
  get-snippets-workspace: func(params: get-snippets-workspace-params) -> result<paginated-snippets, get-snippets-workspace-error>;

  /// Create a snippet for a workspace
  record post-snippets-workspace-params {
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    type-op: string,
    created-on: option<string>,
    creator: option<account>,
    id: option<s32>,
    is-private: option<bool>,
    owner: option<account>,
    /// The DVCS used to store the snippet.
    scm: option<snippet-scm-enum>,
    title: option<string>,
    updated-on: option<string>
  }
  post-snippets-workspace: func(params: post-snippets-workspace-params) -> result<snippet, post-snippets-workspace-error>;

  /// Get a snippet
  record get-snippets-workspace-encoded-id-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id: func(params: get-snippets-workspace-encoded-id-params) -> result<snippet, get-snippets-workspace-encoded-id-error>;

  /// Update a snippet
  record put-snippets-workspace-encoded-id-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  put-snippets-workspace-encoded-id: func(params: put-snippets-workspace-encoded-id-params) -> result<snippet, put-snippets-workspace-encoded-id-error>;

  /// Delete a snippet
  record delete-snippets-workspace-encoded-id-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  delete-snippets-workspace-encoded-id: func(params: delete-snippets-workspace-encoded-id-params) -> result<string, delete-snippets-workspace-encoded-id-error>;

  /// List comments on a snippet
  record get-snippets-workspace-encoded-id-comments-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-comments: func(params: get-snippets-workspace-encoded-id-comments-params) -> result<paginated-snippet-comments, get-snippets-workspace-encoded-id-comments-error>;

  /// Create a comment on a snippet
  record post-snippets-workspace-encoded-id-comments-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    type-op: string,
    links: option<snippet-comment-links>,
    snippet: option<snippet>
  }
  post-snippets-workspace-encoded-id-comments: func(params: post-snippets-workspace-encoded-id-comments-params) -> result<snippet-comment, post-snippets-workspace-encoded-id-comments-error>;

  /// Get a comment on a snippet
  record get-snippets-workspace-encoded-id-comments-comment-id-params {
    /// The id of the comment.
    comment-id: string,
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-comments-comment-id: func(params: get-snippets-workspace-encoded-id-comments-comment-id-params) -> result<snippet-comment, get-snippets-workspace-encoded-id-comments-comment-id-error>;

  /// Update a comment on a snippet
  record put-snippets-workspace-encoded-id-comments-comment-id-params {
    /// The id of the comment.
    comment-id: string,
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    type-op: string,
    links: option<snippet-comment-links>,
    snippet: option<snippet>
  }
  put-snippets-workspace-encoded-id-comments-comment-id: func(params: put-snippets-workspace-encoded-id-comments-comment-id-params) -> result<snippet-comment, put-snippets-workspace-encoded-id-comments-comment-id-error>;

  /// Delete a comment on a snippet
  record delete-snippets-workspace-encoded-id-comments-comment-id-params {
    /// The id of the comment.
    comment-id: string,
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  delete-snippets-workspace-encoded-id-comments-comment-id: func(params: delete-snippets-workspace-encoded-id-comments-comment-id-params) -> result<string, delete-snippets-workspace-encoded-id-comments-comment-id-error>;

  /// List snippet changes
  record get-snippets-workspace-encoded-id-commits-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-commits: func(params: get-snippets-workspace-encoded-id-commits-params) -> result<paginated-snippet-commit, get-snippets-workspace-encoded-id-commits-error>;

  /// Get a previous snippet change
  record get-snippets-workspace-encoded-id-commits-revision-params {
    /// The snippet id.
    encoded-id: string,
    /// The commit's SHA1.
    revision: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-commits-revision: func(params: get-snippets-workspace-encoded-id-commits-revision-params) -> result<snippet-commit, get-snippets-workspace-encoded-id-commits-revision-error>;

  /// Get a snippet's raw file at HEAD
  record get-snippets-workspace-encoded-id-files-path-params {
    /// The snippet id.
    encoded-id: string,
    /// Path to the file.
    path: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-files-path: func(params: get-snippets-workspace-encoded-id-files-path-params) -> result<string, get-snippets-workspace-encoded-id-files-path-error>;

  /// Check if the current user is watching a snippet
  record get-snippets-workspace-encoded-id-watch-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-watch: func(params: get-snippets-workspace-encoded-id-watch-params) -> result<string, get-snippets-workspace-encoded-id-watch-error>;

  /// Watch a snippet
  record put-snippets-workspace-encoded-id-watch-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  put-snippets-workspace-encoded-id-watch: func(params: put-snippets-workspace-encoded-id-watch-params) -> result<string, put-snippets-workspace-encoded-id-watch-error>;

  /// Stop watching a snippet
  record delete-snippets-workspace-encoded-id-watch-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  delete-snippets-workspace-encoded-id-watch: func(params: delete-snippets-workspace-encoded-id-watch-params) -> result<string, delete-snippets-workspace-encoded-id-watch-error>;

  /// List users watching a snippet
  record get-snippets-workspace-encoded-id-watchers-params {
    /// The snippet id.
    encoded-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-watchers: func(params: get-snippets-workspace-encoded-id-watchers-params) -> result<paginated-accounts, get-snippets-workspace-encoded-id-watchers-error>;

  /// Get a previous revision of a snippet
  record get-snippets-workspace-encoded-id-node-id-params {
    /// The snippet id.
    encoded-id: string,
    /// A commit revision (SHA1).
    node-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-node-id: func(params: get-snippets-workspace-encoded-id-node-id-params) -> result<snippet, get-snippets-workspace-encoded-id-node-id-error>;

  /// Update a previous revision of a snippet
  record put-snippets-workspace-encoded-id-node-id-params {
    /// The snippet id.
    encoded-id: string,
    /// A commit revision (SHA1).
    node-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  put-snippets-workspace-encoded-id-node-id: func(params: put-snippets-workspace-encoded-id-node-id-params) -> result<snippet, put-snippets-workspace-encoded-id-node-id-error>;

  /// Delete a previous revision of a snippet
  record delete-snippets-workspace-encoded-id-node-id-params {
    /// The snippet id.
    encoded-id: string,
    /// A commit revision (SHA1).
    node-id: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  delete-snippets-workspace-encoded-id-node-id: func(params: delete-snippets-workspace-encoded-id-node-id-params) -> result<string, delete-snippets-workspace-encoded-id-node-id-error>;

  /// Get a snippet's raw file
  record get-snippets-workspace-encoded-id-node-id-files-path-params {
    /// The snippet id.
    encoded-id: string,
    /// A commit revision (SHA1).
    node-id: string,
    /// Path to the file.
    path: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-node-id-files-path: func(params: get-snippets-workspace-encoded-id-node-id-files-path-params) -> result<string, get-snippets-workspace-encoded-id-node-id-files-path-error>;

  /// Get snippet changes between versions
  record get-snippets-workspace-encoded-id-revision-diff-params {
    /// The snippet id.
    encoded-id: string,
    /// A revspec expression. This can simply be a commit SHA1, a ref name, or a compare expression like `staging..production`.
    revision: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    /// When used, only one the diff of the specified file will be returned.
    path: option<string>
  }
  get-snippets-workspace-encoded-id-revision-diff: func(params: get-snippets-workspace-encoded-id-revision-diff-params) -> result<string, get-snippets-workspace-encoded-id-revision-diff-error>;

  /// Get snippet patch between versions
  record get-snippets-workspace-encoded-id-revision-patch-params {
    /// The snippet id.
    encoded-id: string,
    /// A revspec expression. This can simply be a commit SHA1, a ref name, or a compare expression like `staging..production`.
    revision: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-snippets-workspace-encoded-id-revision-patch: func(params: get-snippets-workspace-encoded-id-revision-patch-params) -> result<string, get-snippets-workspace-encoded-id-revision-patch-error>;

}

interface search {
  enum commit-file-attributes-enum {
    link,
    executable,
    subrepository,
    binary,
    lfs,
  }

  enum base-commit-summary-markup-enum {
    markdown,
    creole,
    plaintext,
  }

  enum participant-role-enum {
    participant,
    reviewer,
  }

  enum participant-state-enum {
    approved,
    changes-requested,
  }

  enum repository-fork-policy-enum {
    allow-forks,
    no-public-forks,
    no-forks,
  }

  enum branch-merge-strategies-item-enum {
    merge-commit,
    squash,
    fast-forward,
  }

  enum repository-scm-enum {
    git,
  }

  record result-page {
    next: option<string>,
    page: option<s32>,
    pagelen: option<s32>,
    previous: option<string>,
    query-substituted: option<bool>,
    size: option<s64>,
    values: option<list<code-search-result>>
  }

  record code-search-result {
    content-match-count: option<s64>,
    content-matches: option<list<content-match>>,
    file: option<commit-file>,
    path-matches: option<list<segment>>,
    type-op: option<string>
  }

  record content-match {
    lines: option<list<line>>
  }

  record line {
    line: option<s32>,
    segments: option<list<segment>>
  }

  record segment {
    match: option<bool>,
    text: option<string>
  }

  /// A file object, representing a file at a commit in a repository
  record commit-file {
    attributes: option<commit-file-attributes-enum>,
    commit: option<commit>,
    /// The escaped version of the path as it appears in a diff. If the path does not require escaping this will be the same as path.
    escaped-path: option<string>,
    /// The path in the repository
    path: option<string>,
    type-op: string
  }

  record commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<base-commit>>,
    summary: option<commit-summary>,
    participants: option<list<participant>>,
    repository: option<repository>
  }

  record author {
    type-op: string,
    /// The raw author value from the repository. This may be the only value available if the author does not match a user in Bitbucket.
    raw: option<string>,
    user: option<account>
  }

  record account {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  record base-commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<string>>,
    summary: option<base-commit-summary>
  }

  record base-commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record participant {
    type-op: string,
    approved: option<bool>,
    /// The ISO8601 timestamp of the participant's action. For approvers, this is the time of their approval. For commenters and pull request reviewers who are not approvers, this is the time they last commented, or null if they have not commented.
    participated-on: option<string>,
    role: option<participant-role-enum>,
    state: option<participant-state-enum>,
    user: option<account>
  }

  record repository {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Controls the rules for forking this repository.
    fork-policy: option<repository-fork-policy-enum>,
    /// The concatenation of the repository owner's username and the slugified name, e.g. "evzijst/interruptingcow". This is the same string used in Bitbucket URLs.
    full-name: option<string>,
    has-issues: option<bool>,
    has-wiki: option<bool>,
    is-private: option<bool>,
    language: option<string>,
    links: option<repository-links>,
    mainbranch: option<branch>,
    name: option<string>,
    owner: option<account>,
    parent: option<string>,
    project: option<project>,
    scm: option<repository-scm-enum>,
    size: option<s32>,
    updated-on: option<string>,
    /// The repository's immutable id. This can be used as a substitute for the slug segment in URLs. Doing this guarantees your URLs will survive renaming of the repository by its owner, or even transfer of the repository to a different user.
    uuid: option<string>
  }

  record repository-links {
    /// A link to a resource related to this object.
    avatar: option<repository-links-avatar>,
    clone: option<list<repository-links-clone-item>>,
    /// A link to a resource related to this object.
    commits: option<repository-links-commits>,
    /// A link to a resource related to this object.
    downloads: option<repository-links-downloads>,
    /// A link to a resource related to this object.
    forks: option<repository-links-forks>,
    /// A link to a resource related to this object.
    hooks: option<repository-links-hooks>,
    /// A link to a resource related to this object.
    html: option<repository-links-html>,
    /// A link to a resource related to this object.
    pullrequests: option<repository-links-pullrequests>,
    /// A link to a resource related to this object.
    self: option<repository-links-self>,
    /// A link to a resource related to this object.
    watchers: option<repository-links-watchers>
  }

  /// A link to a resource related to this object.
  record repository-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-clone-item {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-downloads {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-forks {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-hooks {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-pullrequests {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-self {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-watchers {
    href: option<string>,
    name: option<string>
  }

  record branch {
    links: option<branch-links>,
    /// The name of the ref.
    name: option<string>,
    target: option<string>,
    type-op: string,
    /// The default merge strategy for pull requests targeting this branch.
    default-merge-strategy: option<string>,
    /// Available merge strategies for pull requests targeting this branch.
    merge-strategies: option<list<branch-merge-strategies-item-enum>>
  }

  record branch-links {
    /// A link to a resource related to this object.
    commits: option<branch-links-commits>,
    /// A link to a resource related to this object.
    html: option<branch-links-html>,
    /// A link to a resource related to this object.
    self: option<branch-links-self>
  }

  /// A link to a resource related to this object.
  record branch-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record branch-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record branch-links-self {
    href: option<string>,
    name: option<string>
  }

  record project {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Indicates whether the project contains publicly visible repositories.
    has-publicly-visible-repos: option<bool>,
    /// 
    /// Indicates whether the project is publicly accessible, or whether it is
    is-private: option<bool>,
    /// The project's key.
    key: option<string>,
    links: option<project-links>,
    /// The name of the project.
    name: option<string>,
    owner: option<team-v2>,
    updated-on: option<string>,
    /// The project's immutable id.
    uuid: option<string>
  }

  record project-links {
    /// A link to a resource related to this object.
    avatar: option<project-links-avatar>,
    /// A link to a resource related to this object.
    html: option<project-links-html>
  }

  /// A link to a resource related to this object.
  record project-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record project-links-html {
    href: option<string>,
    name: option<string>
  }

  record team-v2 {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  variant team-error {
    bad-request(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant account-v2-error {
    bad-request(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant workspace-error {
    bad-request(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  /// Search for code in a team's repositories
  record team-params {
    /// The account to search in; either the username or the UUID in curly braces
    username: string,
    /// The search query
    search-query: string,
    /// Which page of the search results to retrieve
    page: option<s32>,
    /// How many search results to retrieve per page
    pagelen: option<s32>
  }
  team: func(params: team-params) -> result<result-page, team-error>;

  /// Search for code in a user's repositories
  record account-v2-params {
    /// Either the UUID of the account surrounded by curly-braces, for example `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string,
    /// The search query
    search-query: string,
    /// Which page of the search results to retrieve
    page: option<s32>,
    /// How many search results to retrieve per page
    pagelen: option<s32>
  }
  account-v2: func(params: account-v2-params) -> result<result-page, account-v2-error>;

  /// Search for code in a workspace
  record workspace-params {
    /// The workspace to search in; either the slug or the UUID in curly braces
    workspace: string,
    /// The search query
    search-query: string,
    /// Which page of the search results to retrieve
    page: option<s32>,
    /// How many search results to retrieve per page
    pagelen: option<s32>
  }
  workspace: func(params: workspace-params) -> result<result-page, workspace-error>;

}

interface users {
  record account {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  variant get-user-error {
    unauthorized(string),
    other(string)
  }

  variant get-users-selected-user-error {
    not-found(string),
    other(string)
  }

  /// Get current user
  get-user: func() -> result<account, get-user-error>;

  /// List email addresses for current user
  get-user-emails: func() -> result<string, string>;

  /// Get an email address for current user
  record get-user-emails-email-params {
    /// Email address of the user.
    email: string
  }
  get-user-emails-email: func(params: get-user-emails-email-params) -> result<string, string>;

  /// Get a user
  record get-users-selected-user-params {
    /// This can either be the UUID of the account, surrounded by curly-braces, for
    /// example: `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string
  }
  get-users-selected-user: func(params: get-users-selected-user-params) -> result<account, get-users-selected-user-error>;

}

