interface search {
  /// Search for code in a team's repositories
  record team-params {
    /// The account to search in; either the username or the UUID in curly braces
    username: string,
    /// The search query
    search-query: string,
    /// Which page of the search results to retrieve
    page: option<s32>,
    /// How many search results to retrieve per page
    pagelen: option<s32>
  }
  team: func(params: team-params) -> result<string, string>;

  /// Search for code in a user's repositories
  record account-params {
    /// Either the UUID of the account surrounded by curly-braces, for example `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string,
    /// The search query
    search-query: string,
    /// Which page of the search results to retrieve
    page: option<s32>,
    /// How many search results to retrieve per page
    pagelen: option<s32>
  }
  account: func(params: account-params) -> result<string, string>;

  /// Search for code in a workspace
  record workspace-params {
    /// The workspace to search in; either the slug or the UUID in curly braces
    workspace: string,
    /// The search query
    search-query: string,
    /// Which page of the search results to retrieve
    page: option<s32>,
    /// How many search results to retrieve per page
    pagelen: option<s32>
  }
  workspace: func(params: workspace-params) -> result<string, string>;

}

