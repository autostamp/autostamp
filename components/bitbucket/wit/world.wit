    workspace: string
  }
  delete-repositories-workspace-repo-slug-branch-restrictions-id: func(params: delete-repositories-workspace-repo-slug-branch-restrictions-id-params) -> result<string, delete-repositories-workspace-repo-slug-branch-restrictions-id-error>;

