    type-op: string,
    /// Whether Pipelines is enabled for the repository.
    enabled: option<bool>,
    repository: option<repository>
  }
  update-repository-pipeline-config: func(params: update-repository-pipeline-config-params) -> result<config, string>;

  /// Update the next build number
  record update-repository-build-number-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    type-op: string,
    /// The next number that will be used as build number.
    next: option<s32>
  }
  update-repository-build-number: func(params: update-repository-build-number-params) -> result<pipeline-build-number, update-repository-build-number-error>;

  /// List schedules
  record get-repository-pipeline-schedules-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
