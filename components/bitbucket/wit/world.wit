  get-pipelines-for-repository: func(params: get-pipelines-for-repository-params) -> result<paginated-pipelines, string>;

  /// Run a pipeline
  record create-pipeline-for-repository-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    type-op: string,
    /// The build number of the pipeline.
    build-number: option<s32>,
    /// The number of build seconds used by this pipeline.
    build-seconds-used: option<s32>,
    /// The timestamp when the Pipeline was completed. This is not set if the pipeline is still in progress.
    completed-on: option<string>,
    /// The timestamp when the pipeline was created.
    created-on: option<string>,
    creator: option<account>,
    repository: option<repository>,
    state: option<pipeline-state>,
    target: option<pipeline-target>,
    trigger: option<pipeline-trigger>,
    /// The UUID identifying the pipeline.
    uuid: option<string>
  }
  create-pipeline-for-repository: func(params: create-pipeline-for-repository-params) -> result<pipeline, create-pipeline-for-repository-error>;

