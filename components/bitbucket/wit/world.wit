interface branch-restrictions {
  /// A paginated list of branch restriction rules.
  record paginated-branchrestrictions {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<branchrestriction>>
  }

  record branchrestriction {
    type-op: string,
    groups: option<list<group>>,
    users: option<list<account>>
  }

  record group {
    type-op: string,
    /// The concatenation of the workspace's slug and the group's slug,
    /// separated with a colon (e.g. `acme:developers`)
    full-slug: option<string>,
    links: option<group-links>,
    name: option<string>,
    owner: option<account>,
    /// The "sluggified" version of the group's name. This contains only ASCII
    /// characters and can therefore be slightly different than the name
    slug: option<string>,
    workspace: option<workspace>
  }

  record group-links {
    /// A link to a resource related to this object.
    html: option<group-links-html>,
    /// A link to a resource related to this object.
    self: option<group-links-self>
  }

  /// A link to a resource related to this object.
  record group-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record group-links-self {
    href: option<string>,
    name: option<string>
  }

  record account {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  record workspace {
    type-op: string,
    created-on: option<string>,
    /// Indicates whether the workspace is publicly accessible, or whether it is
    /// private to the members and consequently only visible to members.
    is-private: option<bool>,
    links: option<workspace-links>,
    /// The name of the workspace.
    name: option<string>,
    /// The short label that identifies this workspace.
    slug: option<string>,
    updated-on: option<string>,
    /// The workspace's immutable id.
    uuid: option<string>
  }

  record workspace-links {
    /// A link to a resource related to this object.
    avatar: option<workspace-links-avatar>,
    /// A link to a resource related to this object.
    html: option<workspace-links-html>,
    /// A link to a resource related to this object.
    members: option<workspace-links-members>,
    /// A link to a resource related to this object.
    owners: option<workspace-links-owners>,
    /// A link to a resource related to this object.
    projects: option<workspace-links-projects>,
    /// A link to a resource related to this object.
    repositories: option<workspace-links-repositories>,
    /// A link to a resource related to this object.
    self: option<workspace-links-self>,
    /// A link to a resource related to this object.
    snippets: option<workspace-links-snippets>
  }

  /// A link to a resource related to this object.
  record workspace-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record workspace-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record workspace-links-members {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record workspace-links-owners {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record workspace-links-projects {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record workspace-links-repositories {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record workspace-links-self {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record workspace-links-snippets {
    href: option<string>,
    name: option<string>
  }

  variant get-repositories-workspace-repo-slug-branch-restrictions-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant post-repositories-workspace-repo-slug-branch-restrictions-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-repositories-workspace-repo-slug-branch-restrictions-id-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant put-repositories-workspace-repo-slug-branch-restrictions-id-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-repositories-workspace-repo-slug-branch-restrictions-id-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// List branch restrictions
  record get-repositories-workspace-repo-slug-branch-restrictions-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    /// Branch restrictions of this type
    kind: option<string>,
    /// Branch restrictions applied to branches of this pattern
    pattern: option<string>
  }
  get-repositories-workspace-repo-slug-branch-restrictions: func(params: get-repositories-workspace-repo-slug-branch-restrictions-params) -> result<paginated-branchrestrictions, get-repositories-workspace-repo-slug-branch-restrictions-error>;

  /// Create a branch restriction rule
  record post-repositories-workspace-repo-slug-branch-restrictions-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    type-op: string,
    groups: option<list<group>>,
    users: option<list<account>>
  }
  post-repositories-workspace-repo-slug-branch-restrictions: func(params: post-repositories-workspace-repo-slug-branch-restrictions-params) -> result<branchrestriction, post-repositories-workspace-repo-slug-branch-restrictions-error>;

  /// Get a branch restriction rule
  record get-repositories-workspace-repo-slug-branch-restrictions-id-params {
    /// The restriction rule's id
    id: string,
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-branch-restrictions-id: func(params: get-repositories-workspace-repo-slug-branch-restrictions-id-params) -> result<branchrestriction, get-repositories-workspace-repo-slug-branch-restrictions-id-error>;

  /// Update a branch restriction rule
  record put-repositories-workspace-repo-slug-branch-restrictions-id-params {
    /// The restriction rule's id
    id: string,
    /// This can either be the repository slug or the UUID of the repository,
