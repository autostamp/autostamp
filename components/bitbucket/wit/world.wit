  }
  post-repositories-workspace-repo-slug-deploy-keys: func(params: post-repositories-workspace-repo-slug-deploy-keys-params) -> result<deploy-key, post-repositories-workspace-repo-slug-deploy-keys-error>;

  /// Get a repository deploy key
  record get-repositories-workspace-repo-slug-deploy-keys-key-id-params {
    /// The key ID matching the deploy key.
    key-id: string,
    /// This can either be the repository slug or the UUID of the repository,
