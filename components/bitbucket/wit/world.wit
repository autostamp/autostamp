/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `oauth2` | `Authorization: Bearer <secret>` |
package autostamp:bitbucket@0.3.0;

interface addon {
  /// Update an installed app
  put-addon: func() -> result<string, string>;

  /// Delete an app
  delete-addon: func() -> result<string, string>;

  /// List linkers for an app
  get-addon-linkers: func() -> result<string, string>;

  /// Get a linker for an app
  get-addon-linkers-linker-key: func() -> result<string, string>;

  /// List linker values for a linker
  get-addon-linkers-linker-key-values: func() -> result<string, string>;

  /// Create a linker value
  post-addon-linkers-linker-key-values: func() -> result<string, string>;

  /// Update a linker value
  put-addon-linkers-linker-key-values: func() -> result<string, string>;

  /// Delete all linker values
  delete-addon-linkers-linker-key-values: func() -> result<string, string>;

  /// Get a linker value
  get-addon-linkers-linker-key-values-value-id: func() -> result<string, string>;

  /// Delete a linker value
  delete-addon-linkers-linker-key-values-value-id: func() -> result<string, string>;

}


interface webhooks {
  /// Get a webhook resource
  get-hook-events: func() -> result<string, string>;

  /// List subscribable webhook types
  get-hook-events-subject-type: func() -> result<string, string>;

}

interface pullrequests {
  enum get-pullrequests-selected-user-state-enum {
    open,
    merged,
    declined,
    superseded,
  }

  enum pullrequest-merge-parameters-merge-strategy-enum {
    merge-commit,
    squash,
    fast-forward,
  }

  /// List pull requests for a user
  record get-pullrequests-selected-user-params {
    /// Only return pull requests that are in this state. This parameter can be repeated.
    state: option<get-pullrequests-selected-user-state-enum>
  }
  get-pullrequests-selected-user: func(params: get-pullrequests-selected-user-params) -> result<string, string>;

  /// List pull requests that contain a commit
  record get-pullrequests-for-commit-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces
    workspace: string,
    /// The repository; either the UUID in curly braces, or the slug
    repo-slug: string,
    /// The SHA1 of the commit
    commit: string,
    /// Which page to retrieve
    page: option<s32>,
    /// How many pull requests to retrieve per page
    pagelen: option<s32>
  }
  get-pullrequests-for-commit: func(params: get-pullrequests-for-commit-params) -> result<string, string>;

  /// List default reviewers
  get-repositories-workspace-repo-slug-default-reviewers: func() -> result<string, string>;

  /// Get a default reviewer
  get-repositories-workspace-repo-slug-default-reviewers-target-username: func() -> result<string, string>;

  /// Add a user to the default reviewers
  put-repositories-workspace-repo-slug-default-reviewers-target-username: func() -> result<string, string>;

  /// Remove a user from the default reviewers
  delete-repositories-workspace-repo-slug-default-reviewers-target-username: func() -> result<string, string>;

  /// List effective default reviewers
  get-repositories-workspace-repo-slug-effective-default-reviewers: func() -> result<string, string>;

  /// List pull requests
  record get-repositories-workspace-repo-slug-pullrequests-params {
    /// Only return pull requests that are in this state. This parameter can be repeated.
    state: option<get-pullrequests-selected-user-state-enum>
  }
  get-repositories-workspace-repo-slug-pullrequests: func(params: get-repositories-workspace-repo-slug-pullrequests-params) -> result<string, string>;

  /// Create a pull request
  record post-repositories-workspace-repo-slug-pullrequests-params {
    /// opaque schema; raw JSON
    value: string
  }
  post-repositories-workspace-repo-slug-pullrequests: func(params: post-repositories-workspace-repo-slug-pullrequests-params) -> result<string, string>;

  /// List a pull request activity log
  get-repositories-workspace-repo-slug-pullrequests-activity: func() -> result<string, string>;

  /// Get a pull request
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id: func() -> result<string, string>;

  /// Update a pull request
  record put-repositories-workspace-repo-slug-pullrequests-pull-request-id-params {
    /// opaque schema; raw JSON
    value: string
  }
  put-repositories-workspace-repo-slug-pullrequests-pull-request-id: func(params: put-repositories-workspace-repo-slug-pullrequests-pull-request-id-params) -> result<string, string>;

  /// List a pull request activity log
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-activity: func() -> result<string, string>;

  /// Approve a pull request
  post-repositories-workspace-repo-slug-pullrequests-pull-request-id-approve: func() -> result<string, string>;

  /// Unapprove a pull request
  delete-repositories-workspace-repo-slug-pullrequests-pull-request-id-approve: func() -> result<string, string>;

  /// List comments on a pull request
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments: func() -> result<string, string>;

  /// Create a comment on a pull request
  record post-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-params {
    /// opaque schema; raw JSON
    value: string
  }
  post-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments: func(params: post-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-params) -> result<string, string>;

  /// Get a comment on a pull request
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-comment-id: func() -> result<string, string>;

  /// Update a comment on a pull request
  record put-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-comment-id-params {
    /// opaque schema; raw JSON
    value: string
  }
  put-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-comment-id: func(params: put-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-comment-id-params) -> result<string, string>;

  /// Delete a comment on a pull request
  delete-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-comment-id: func() -> result<string, string>;

  /// Resolve a comment thread
  post-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-comment-id-resolve: func() -> result<string, string>;

  /// Reopen a comment thread
  delete-repositories-workspace-repo-slug-pullrequests-pull-request-id-comments-comment-id-resolve: func() -> result<string, string>;

  /// List commits on a pull request
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-commits: func() -> result<string, string>;

  /// Decline a pull request
  post-repositories-workspace-repo-slug-pullrequests-pull-request-id-decline: func() -> result<string, string>;

  /// List changes in a pull request
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-diff: func() -> result<string, string>;

  /// Get the diff stat for a pull request
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-diffstat: func() -> result<string, string>;

  /// Merge a pull request
  record post-repositories-workspace-repo-slug-pullrequests-pull-request-id-merge-params {
    /// Default value is false.
    /// 
    async-op: option<bool>,
    /// Whether the source branch should be deleted. If this is not provided, we fallback to the value used when the pull request was created, which defaults to False
    close-source-branch: option<bool>,
    /// The merge strategy that will be used to merge the pull request.
    merge-strategy: option<pullrequest-merge-parameters-merge-strategy-enum>,
    /// The commit message that will be used on the resulting commit.
    message: option<string>,
    type-op: string
  }
  post-repositories-workspace-repo-slug-pullrequests-pull-request-id-merge: func(params: post-repositories-workspace-repo-slug-pullrequests-pull-request-id-merge-params) -> result<string, string>;

  /// Get the merge task status for a pull request
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-merge-task-status-task-id: func() -> result<string, string>;

  /// Get the patch for a pull request
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-patch: func() -> result<string, string>;

  /// Request changes for a pull request
  post-repositories-workspace-repo-slug-pullrequests-pull-request-id-request-changes: func() -> result<string, string>;

  /// Remove change request for a pull request
  delete-repositories-workspace-repo-slug-pullrequests-pull-request-id-request-changes: func() -> result<string, string>;

  /// List commit statuses for a pull request
  record get-repositories-workspace-repo-slug-pullrequests-pull-request-id-statuses-params {
    /// Query string to narrow down the response as per
    /// [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    q: option<string>,
    /// Field by which the results should be sorted as per
    /// [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    sort: option<string>
  }
  get-repositories-workspace-repo-slug-pullrequests-pull-request-id-statuses: func(params: get-repositories-workspace-repo-slug-pullrequests-pull-request-id-statuses-params) -> result<string, string>;

}

interface repositories {
  enum get-repositories-role-enum {
    admin,
    contributor,
    member,
    owner,
  }

  /// List public repositories
  record get-repositories-params {
    /// Filter the results to include only repositories created on or
    /// after this [ISO-8601](https://en.wikipedia.org/wiki/ISO_8601)
    after: option<string>,
    /// Filters the result based on the authenticated user's role on each repository.
    /// 
    role: option<get-repositories-role-enum>,
    /// Query string to narrow down the response as per [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    /// `role` parameter must also be specified.
    q: option<string>,
    /// Field by which the results should be sorted as per [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    sort: option<string>
  }
  get-repositories: func(params: get-repositories-params) -> result<string, string>;

  /// List repositories in a workspace
  record get-repositories-workspace-params {
    /// 
    /// Filters the result based on the authenticated user's role on each repository.
    role: option<get-repositories-role-enum>,
    /// 
    /// Query string to narrow down the response as per [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    q: option<string>,
    /// 
    /// Field by which the results should be sorted as per [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    sort: option<string>
  }
  get-repositories-workspace: func(params: get-repositories-workspace-params) -> result<string, string>;

  /// Get a repository
  get-repositories-workspace-repo-slug: func() -> result<string, string>;

  /// Create a repository
  record post-repositories-workspace-repo-slug-params {
    /// opaque schema; raw JSON
    value: string
  }
  post-repositories-workspace-repo-slug: func(params: post-repositories-workspace-repo-slug-params) -> result<string, string>;

  /// Update a repository
  record put-repositories-workspace-repo-slug-params {
    /// opaque schema; raw JSON
    value: string
  }
  put-repositories-workspace-repo-slug: func(params: put-repositories-workspace-repo-slug-params) -> result<string, string>;

  /// Delete a repository
  record delete-repositories-workspace-repo-slug-params {
    /// If a repository has been moved to a new location, use this parameter to
    /// show users a friendly message in the Bitbucket UI that the repository
    redirect-to: option<string>
  }
  delete-repositories-workspace-repo-slug: func(params: delete-repositories-workspace-repo-slug-params) -> result<string, string>;

  /// List repository forks
  record get-repositories-workspace-repo-slug-forks-params {
    /// Filters the result based on the authenticated user's role on each repository.
    /// 
    role: option<get-repositories-role-enum>,
    /// Query string to narrow down the response as per [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    q: option<string>,
    /// Field by which the results should be sorted as per [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    sort: option<string>
  }
  get-repositories-workspace-repo-slug-forks: func(params: get-repositories-workspace-repo-slug-forks-params) -> result<string, string>;

  /// Fork a repository
  record post-repositories-workspace-repo-slug-forks-params {
    /// opaque schema; raw JSON
    value: string
  }
  post-repositories-workspace-repo-slug-forks: func(params: post-repositories-workspace-repo-slug-forks-params) -> result<string, string>;

  /// List webhooks for a repository
  get-repositories-workspace-repo-slug-hooks: func() -> result<string, string>;

  /// Create a webhook for a repository
  post-repositories-workspace-repo-slug-hooks: func() -> result<string, string>;

  /// Get a webhook for a repository
  get-repositories-workspace-repo-slug-hooks-uid: func() -> result<string, string>;

  /// Update a webhook for a repository
  put-repositories-workspace-repo-slug-hooks-uid: func() -> result<string, string>;

  /// Delete a webhook for a repository
  delete-repositories-workspace-repo-slug-hooks-uid: func() -> result<string, string>;

  /// Retrieve the inheritance state for repository settings
  get-repositories-workspace-repo-slug-override-settings: func() -> result<string, string>;

  /// Set the inheritance state for repository settings
  ///                 
  put-repositories-workspace-repo-slug-override-settings: func() -> result<string, string>;

  /// List explicit group permissions for a repository
  get-repositories-workspace-repo-slug-permissions-config-groups: func() -> result<string, string>;

  /// Get an explicit group permission for a repository
  get-repositories-workspace-repo-slug-permissions-config-groups-group-slug: func() -> result<string, string>;

  /// Update an explicit group permission for a repository
  put-repositories-workspace-repo-slug-permissions-config-groups-group-slug: func() -> result<string, string>;

  /// Delete an explicit group permission for a repository
  delete-repositories-workspace-repo-slug-permissions-config-groups-group-slug: func() -> result<string, string>;

  /// List explicit user permissions for a repository
  get-repositories-workspace-repo-slug-permissions-config-users: func() -> result<string, string>;

  /// Get an explicit user permission for a repository
  get-repositories-workspace-repo-slug-permissions-config-users-selected-user-id: func() -> result<string, string>;

  /// Update an explicit user permission for a repository
  put-repositories-workspace-repo-slug-permissions-config-users-selected-user-id: func() -> result<string, string>;

  /// Delete an explicit user permission for a repository
  delete-repositories-workspace-repo-slug-permissions-config-users-selected-user-id: func() -> result<string, string>;

  /// List repositories watchers
  get-repositories-workspace-repo-slug-watchers: func() -> result<string, string>;

  /// List repository permissions for a user
  record get-user-permissions-repositories-params {
    /// 
    /// Query string to narrow down the response as per
    q: option<string>,
    /// 
    /// Name of a response property sort the result by as per
    sort: option<string>
  }
  get-user-permissions-repositories: func(params: get-user-permissions-repositories-params) -> result<string, string>;

}

interface branch-restrictions {
  /// List branch restrictions
  record get-repositories-workspace-repo-slug-branch-restrictions-params {
    /// Branch restrictions of this type
    kind: option<string>,
    /// Branch restrictions applied to branches of this pattern
    pattern: option<string>
  }
  get-repositories-workspace-repo-slug-branch-restrictions: func(params: get-repositories-workspace-repo-slug-branch-restrictions-params) -> result<string, string>;

  /// Create a branch restriction rule
  record post-repositories-workspace-repo-slug-branch-restrictions-params {
    /// opaque schema; raw JSON
    value: string
  }
  post-repositories-workspace-repo-slug-branch-restrictions: func(params: post-repositories-workspace-repo-slug-branch-restrictions-params) -> result<string, string>;

  /// Get a branch restriction rule
  get-repositories-workspace-repo-slug-branch-restrictions-id: func() -> result<string, string>;

  /// Update a branch restriction rule
  record put-repositories-workspace-repo-slug-branch-restrictions-id-params {
    /// opaque schema; raw JSON
    value: string
  }
  put-repositories-workspace-repo-slug-branch-restrictions-id: func(params: put-repositories-workspace-repo-slug-branch-restrictions-id-params) -> result<string, string>;

  /// Delete a branch restriction rule
  delete-repositories-workspace-repo-slug-branch-restrictions-id: func() -> result<string, string>;

}

interface branching-model {
  /// Get the branching model for a repository
  get-repositories-workspace-repo-slug-branching-model: func() -> result<string, string>;

  /// Get the branching model config for a repository
  get-repositories-workspace-repo-slug-branching-model-settings: func() -> result<string, string>;

  /// Update the branching model config for a repository
  put-repositories-workspace-repo-slug-branching-model-settings: func() -> result<string, string>;

  /// Get the effective, or currently applied, branching model for a repository
  get-repositories-workspace-repo-slug-effective-branching-model: func() -> result<string, string>;

  /// Get the branching model for a project
  get-workspaces-workspace-projects-project-key-branching-model: func() -> result<string, string>;

  /// Get the branching model config for a project
  get-workspaces-workspace-projects-project-key-branching-model-settings: func() -> result<string, string>;

  /// Update the branching model config for a project
  put-workspaces-workspace-projects-project-key-branching-model-settings: func() -> result<string, string>;

}

interface commits {
  /// Get a commit
  get-repositories-workspace-repo-slug-commit-commit: func() -> result<string, string>;

  /// Approve a commit
  post-repositories-workspace-repo-slug-commit-commit-approve: func() -> result<string, string>;

  /// Unapprove a commit
  delete-repositories-workspace-repo-slug-commit-commit-approve: func() -> result<string, string>;

  /// List a commit's comments
  record get-repositories-workspace-repo-slug-commit-commit-comments-params {
    /// Query string to narrow down the response as per
    /// [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    q: option<string>,
    /// Field by which the results should be sorted as per
    /// [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    sort: option<string>
  }
  get-repositories-workspace-repo-slug-commit-commit-comments: func(params: get-repositories-workspace-repo-slug-commit-commit-comments-params) -> result<string, string>;

  /// Create comment for a commit
  record post-repositories-workspace-repo-slug-commit-commit-comments-params {
    /// opaque schema; raw JSON
    value: string
  }
  post-repositories-workspace-repo-slug-commit-commit-comments: func(params: post-repositories-workspace-repo-slug-commit-commit-comments-params) -> result<string, string>;

  /// Get a commit comment
  get-repositories-workspace-repo-slug-commit-commit-comments-comment-id: func() -> result<string, string>;

  /// Update a commit comment
  record put-repositories-workspace-repo-slug-commit-commit-comments-comment-id-params {
    /// opaque schema; raw JSON
    value: string
  }
  put-repositories-workspace-repo-slug-commit-commit-comments-comment-id: func(params: put-repositories-workspace-repo-slug-commit-commit-comments-comment-id-params) -> result<string, string>;

  /// Delete a commit comment
  delete-repositories-workspace-repo-slug-commit-commit-comments-comment-id: func() -> result<string, string>;

  /// List commits
  get-repositories-workspace-repo-slug-commits: func() -> result<string, string>;

  /// List commits with include/exclude
  post-repositories-workspace-repo-slug-commits: func() -> result<string, string>;

  /// List commits for revision
  get-repositories-workspace-repo-slug-commits-revision: func() -> result<string, string>;

  /// List commits for revision using include/exclude
  post-repositories-workspace-repo-slug-commits-revision: func() -> result<string, string>;

  /// Compare two commits
  record get-repositories-workspace-repo-slug-diff-spec-params {
    /// Generate diffs with <n> lines of context instead of the usual three.
    context: option<s32>,
    /// Limit the diff to a particular file (this parameter
    /// can be repeated for multiple paths).
    path: option<string>,
    /// Generate diffs that ignore whitespace.
    ignore-whitespace: option<bool>,
    /// Generate diffs that include binary files, true if omitted.
    binary: option<bool>,
    /// Whether to perform rename detection, true if omitted.
    renames: option<bool>,
    /// This parameter is deprecated and will be removed at the end
    /// of 2022. The 'topic' parameter should be used instead. The
    merge: option<bool>,
    /// If true, returns 2-way 'three-dot' diff.
    /// This is a diff between the source commit and the merge base
    topic: option<bool>
  }
  get-repositories-workspace-repo-slug-diff-spec: func(params: get-repositories-workspace-repo-slug-diff-spec-params) -> result<string, string>;

  /// Compare two commit diff stats
  get-repositories-workspace-repo-slug-diffstat-spec: func() -> result<string, string>;

  /// Get the common ancestor between two commits
  get-repositories-workspace-repo-slug-merge-base-revspec: func() -> result<string, string>;

  /// Get a patch for two commits
  get-repositories-workspace-repo-slug-patch-spec: func() -> result<string, string>;

}

interface properties {
  enum application-property-attributes-item-enum {
    public,
    read-only,
  }

  /// Get a commit application property
  record get-commit-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit.
    commit: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  get-commit-hosted-property-value: func(params: get-commit-hosted-property-value-params) -> result<string, string>;

  /// Update a commit application property
  record update-commit-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit.
    commit: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string,
    attributes: option<list<application-property-attributes-item-enum>>
  }
  update-commit-hosted-property-value: func(params: update-commit-hosted-property-value-params) -> result<string, string>;

  /// Delete a commit application property
  record delete-commit-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit.
    commit: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  delete-commit-hosted-property-value: func(params: delete-commit-hosted-property-value-params) -> result<string, string>;

  /// Get a repository application property
  record get-repository-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  get-repository-hosted-property-value: func(params: get-repository-hosted-property-value-params) -> result<string, string>;

  /// Update a repository application property
  record update-repository-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string,
    attributes: option<list<application-property-attributes-item-enum>>
  }
  update-repository-hosted-property-value: func(params: update-repository-hosted-property-value-params) -> result<string, string>;

  /// Delete a repository application property
  record delete-repository-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  delete-repository-hosted-property-value: func(params: delete-repository-hosted-property-value-params) -> result<string, string>;

  /// Get a pull request application property
  record get-pull-request-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The pull request ID.
    pullrequest-id: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  get-pull-request-hosted-property-value: func(params: get-pull-request-hosted-property-value-params) -> result<string, string>;

  /// Update a pull request application property
  record update-pull-request-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
