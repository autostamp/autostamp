    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-deploy-keys-key-id: func(params: get-repositories-workspace-repo-slug-deploy-keys-key-id-params) -> result<deploy-key, get-repositories-workspace-repo-slug-deploy-keys-key-id-error>;

  /// Update a repository deploy key
  record put-repositories-workspace-repo-slug-deploy-keys-key-id-params {
    /// The key ID matching the deploy key.
    key-id: string,
