  delete-repositories-workspace-repo-slug-deploy-keys-key-id: func(params: delete-repositories-workspace-repo-slug-deploy-keys-key-id-params) -> result<string, delete-repositories-workspace-repo-slug-deploy-keys-key-id-error>;

  /// List deployments
  record get-deployments-for-repository-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string
  }
  get-deployments-for-repository: func(params: get-deployments-for-repository-params) -> result<paginated-deployments, string>;

  /// Get a deployment
  record get-deployment-for-repository-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The deployment UUID.
    deployment-uuid: string
  }
  get-deployment-for-repository: func(params: get-deployment-for-repository-params) -> result<deployment, get-deployment-for-repository-error>;

  /// List environments
  record get-environments-for-repository-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string
  }
  get-environments-for-repository: func(params: get-environments-for-repository-params) -> result<paginated-environments, string>;

  /// Create an environment
  record create-environment-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    type-op: string,
    /// The name of the environment.
    name: option<string>,
    /// The UUID identifying the environment.
    uuid: option<string>
  }
  create-environment: func(params: create-environment-params) -> result<deployment-environment, create-environment-error>;

  /// Get an environment
  record get-environment-for-repository-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The environment UUID.
    environment-uuid: string
  }
  get-environment-for-repository: func(params: get-environment-for-repository-params) -> result<deployment-environment, get-environment-for-repository-error>;

  /// Delete an environment
  record delete-environment-for-repository-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The environment UUID.
    environment-uuid: string
  }
  delete-environment-for-repository: func(params: delete-environment-for-repository-params) -> result<string, delete-environment-for-repository-error>;

  /// Update an environment
  record update-environment-for-repository-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The environment UUID.
    environment-uuid: string
  }
  update-environment-for-repository: func(params: update-environment-for-repository-params) -> result<string, update-environment-for-repository-error>;

  /// List project deploy keys
  record get-workspaces-workspace-projects-project-key-deploy-keys-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-projects-project-key-deploy-keys: func(params: get-workspaces-workspace-projects-project-key-deploy-keys-params) -> result<paginated-project-deploy-keys, get-workspaces-workspace-projects-project-key-deploy-keys-error>;

  /// Create a project deploy key
  record post-workspaces-workspace-projects-project-key-deploy-keys-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  post-workspaces-workspace-projects-project-key-deploy-keys: func(params: post-workspaces-workspace-projects-project-key-deploy-keys-params) -> result<project-deploy-key, post-workspaces-workspace-projects-project-key-deploy-keys-error>;

  /// Get a project deploy key
  record get-workspaces-workspace-projects-project-key-deploy-keys-key-id-params {
    /// The key ID matching the project deploy key.
    key-id: string,
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-projects-project-key-deploy-keys-key-id: func(params: get-workspaces-workspace-projects-project-key-deploy-keys-key-id-params) -> result<project-deploy-key, get-workspaces-workspace-projects-project-key-deploy-keys-key-id-error>;

  /// Delete a deploy key from a project
  record delete-workspaces-workspace-projects-project-key-deploy-keys-key-id-params {
    /// The key ID matching the project deploy key.
    key-id: string,
