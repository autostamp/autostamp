interface deployments {
  enum repository-fork-policy-enum {
    allow-forks,
    no-public-forks,
    no-forks,
  }

  enum base-commit-summary-markup-enum {
    markdown,
    creole,
    plaintext,
  }

  enum participant-role-enum {
    participant,
    reviewer,
  }

  enum participant-state-enum {
    approved,
    changes-requested,
  }

  enum branch-merge-strategies-item-enum {
    merge-commit,
    squash,
    fast-forward,
  }

  enum repository-scm-enum {
    git,
  }

  /// A paginated list of deploy keys.
  record paginated-deploy-keys {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<deploy-key>>
  }

  record deploy-key {
    type-op: string,
    added-on: option<string>,
    /// The comment parsed from the deploy key (if present)
    comment: option<string>,
    /// The deploy key value.
    key: option<string>,
    /// The user-defined label for the deploy key
    label: option<string>,
    last-used: option<string>,
    links: option<deploy-key-links>,
    owner: option<account>,
    repository: option<repository>
  }

  record deploy-key-links {
    /// A link to a resource related to this object.
    self: option<deploy-key-links-self>
  }

  /// A link to a resource related to this object.
  record deploy-key-links-self {
    href: option<string>,
    name: option<string>
  }

  record account {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  record repository {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Controls the rules for forking this repository.
    fork-policy: option<repository-fork-policy-enum>,
    /// The concatenation of the repository owner's username and the slugified name, e.g. "evzijst/interruptingcow". This is the same string used in Bitbucket URLs.
    full-name: option<string>,
    has-issues: option<bool>,
    has-wiki: option<bool>,
    is-private: option<bool>,
    language: option<string>,
    links: option<repository-links>,
    mainbranch: option<branch>,
    name: option<string>,
    owner: option<account>,
    parent: option<string>,
    project: option<project>,
    scm: option<repository-scm-enum>,
    size: option<s32>,
    updated-on: option<string>,
    /// The repository's immutable id. This can be used as a substitute for the slug segment in URLs. Doing this guarantees your URLs will survive renaming of the repository by its owner, or even transfer of the repository to a different user.
    uuid: option<string>
  }

  record repository-links {
    /// A link to a resource related to this object.
    avatar: option<repository-links-avatar>,
    clone: option<list<repository-links-clone-item>>,
    /// A link to a resource related to this object.
    commits: option<repository-links-commits>,
    /// A link to a resource related to this object.
    downloads: option<repository-links-downloads>,
    /// A link to a resource related to this object.
    forks: option<repository-links-forks>,
    /// A link to a resource related to this object.
    hooks: option<repository-links-hooks>,
    /// A link to a resource related to this object.
    html: option<repository-links-html>,
    /// A link to a resource related to this object.
    pullrequests: option<repository-links-pullrequests>,
    /// A link to a resource related to this object.
    self: option<repository-links-self>,
    /// A link to a resource related to this object.
    watchers: option<repository-links-watchers>
  }

  /// A link to a resource related to this object.
  record repository-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-clone-item {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-downloads {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-forks {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-hooks {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-pullrequests {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-self {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-watchers {
    href: option<string>,
    name: option<string>
  }

  record branch {
    links: option<branch-links>,
    /// The name of the ref.
    name: option<string>,
    target: option<commit>,
    type-op: string,
    /// The default merge strategy for pull requests targeting this branch.
    default-merge-strategy: option<string>,
    /// Available merge strategies for pull requests targeting this branch.
    merge-strategies: option<list<branch-merge-strategies-item-enum>>
  }

  record branch-links {
    /// A link to a resource related to this object.
    commits: option<branch-links-commits>,
    /// A link to a resource related to this object.
    html: option<branch-links-html>,
    /// A link to a resource related to this object.
    self: option<branch-links-self>
  }

  /// A link to a resource related to this object.
  record branch-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record branch-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record branch-links-self {
    href: option<string>,
    name: option<string>
  }

  record commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<base-commit>>,
    summary: option<commit-summary>,
    participants: option<list<participant>>,
    repository: option<string>
  }

  record author {
    type-op: string,
    /// The raw author value from the repository. This may be the only value available if the author does not match a user in Bitbucket.
    raw: option<string>,
    user: option<account>
  }

  record base-commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<string>>,
    summary: option<base-commit-summary>
  }

  record base-commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record participant {
    type-op: string,
    approved: option<bool>,
    /// The ISO8601 timestamp of the participant's action. For approvers, this is the time of their approval. For commenters and pull request reviewers who are not approvers, this is the time they last commented, or null if they have not commented.
    participated-on: option<string>,
    role: option<participant-role-enum>,
    state: option<participant-state-enum>,
    user: option<account>
  }

  record project {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Indicates whether the project contains publicly visible repositories.
    has-publicly-visible-repos: option<bool>,
    /// 
    /// Indicates whether the project is publicly accessible, or whether it is
    is-private: option<bool>,
    /// The project's key.
    key: option<string>,
    links: option<project-links>,
    /// The name of the project.
    name: option<string>,
    owner: option<team>,
    updated-on: option<string>,
    /// The project's immutable id.
    uuid: option<string>
  }

  record project-links {
    /// A link to a resource related to this object.
    avatar: option<project-links-avatar>,
    /// A link to a resource related to this object.
    html: option<project-links-html>
  }

  /// A link to a resource related to this object.
  record project-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record project-links-html {
    href: option<string>,
    name: option<string>
  }

  record team {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// A paged list of deployments
  record paginated-deployments {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    /// The values of the current page.
    values: option<list<deployment>>
  }

  record deployment {
    type-op: string,
    environment: option<deployment-environment>,
    release: option<deployment-release>,
    state: option<deployment-state>,
    /// The UUID identifying the deployment.
    uuid: option<string>
  }

  record deployment-environment {
    type-op: string,
    /// The name of the environment.
    name: option<string>,
    /// The UUID identifying the environment.
    uuid: option<string>
  }

  record deployment-release {
    type-op: string,
    commit: option<commit>,
    /// The timestamp when the release was created.
    created-on: option<string>,
    /// The name of the release.
    name: option<string>,
    /// Link to the pipeline that produced the release.
    url: option<string>,
    /// The UUID identifying the release.
    uuid: option<string>
  }

  record deployment-state {
    type-op: string
  }

  /// A paged list of environments
  record paginated-environments {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    /// The values of the current page.
    values: option<list<deployment-environment>>
  }

  /// A paginated list of project deploy keys.
  record paginated-project-deploy-keys {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<project-deploy-key>>
  }

  record project-deploy-key {
    type-op: string,
    added-on: option<string>,
    /// The comment parsed from the deploy key (if present)
    comment: option<string>,
    created-by: option<account>,
    /// The deploy key value.
    key: option<string>,
    /// The user-defined label for the deploy key
    label: option<string>,
    last-used: option<string>,
    links: option<project-deploy-key-links>,
    project: option<project>
  }

  record project-deploy-key-links {
    /// A link to a resource related to this object.
    self: option<project-deploy-key-links-self>
  }

  /// A link to a resource related to this object.
  record project-deploy-key-links-self {
    href: option<string>,
    name: option<string>
  }

