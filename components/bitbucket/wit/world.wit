    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-watchers {
    href: option<string>,
    name: option<string>
  }

  record project {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Indicates whether the project contains publicly visible repositories.
    has-publicly-visible-repos: option<bool>,
    /// 
    /// Indicates whether the project is publicly accessible, or whether it is
    is-private: option<bool>,
    /// The project's key.
    key: option<string>,
    links: option<project-links>,
    /// The name of the project.
    name: option<string>,
    owner: option<team>,
    updated-on: option<string>,
    /// The project's immutable id.
    uuid: option<string>
  }

  record project-links {
    /// A link to a resource related to this object.
    avatar: option<project-links-avatar>,
    /// A link to a resource related to this object.
    html: option<project-links-html>
  }

  /// A link to a resource related to this object.
  record project-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record project-links-html {
    href: option<string>,
    name: option<string>
  }

  record team {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  record branching-model-production {
    branch: option<branch>,
    /// Name of the target branch. Will be listed here even when the target branch does not exist. Will be `null` if targeting the main branch and the repository is empty.
    name: string,
    /// Indicates if the setting points at an explicit branch (`false`) or tracks the main branch (`true`).
    use-mainbranch: bool
  }

  record settings {
    type-op: string,
    branch-types: option<list<settings-branch-types-item>>,
    development: option<settings-development>,
    links: option<settings-links>,
    production: option<settings-production>
  }

  record settings-branch-types-item {
    /// Whether the branch type is enabled or not. A disabled branch type may contain an invalid `prefix`.
    enabled: option<bool>,
    /// The kind of the branch type.
    kind: branching-model-branch-types-item-kind-enum,
    /// The prefix for this branch type. A branch with this prefix will be classified as per `kind`. The `prefix` of an enabled branch type must be a valid branch prefix.Additionally, it cannot be blank, empty or `null`. The `prefix` for a disabled branch type can be empty or invalid.
    prefix: option<string>
  }

  record settings-development {
    /// Indicates if the configured branch is valid, that is, if the configured branch actually exists currently. Is always `true` when `use_mainbranch` is `true` (even if the main branch does not exist). This field is read-only. This field is ignored when updating/creating settings.
    is-valid: option<bool>,
    /// The configured branch. It must be `null` when `use_mainbranch` is `true`. Otherwise it must be a non-empty value. It is possible for the configured branch to not exist (e.g. it was deleted after the settings are set). In this case `is_valid` will be `false`. The branch must exist when updating/setting the `name` or an error will occur.
    name: option<string>,
    /// Indicates if the setting points at an explicit branch (`false`) or tracks the main branch (`true`). When `true` the `name` must be `null` or not provided. When `false` the `name` must contain a non-empty branch name.
    use-mainbranch: option<bool>
  }

  record settings-links {
    /// A link to a resource related to this object.
    self: option<settings-links-self>
  }

  /// A link to a resource related to this object.
  record settings-links-self {
    href: option<string>,
    name: option<string>
  }

  record settings-production {
    /// Indicates if branch is enabled or not.
    enabled: option<bool>,
    /// Indicates if the configured branch is valid, that is, if the configured branch actually exists currently. Is always `true` when `use_mainbranch` is `true` (even if the main branch does not exist). This field is read-only. This field is ignored when updating/creating settings.
    is-valid: option<bool>,
    /// The configured branch. It must be `null` when `use_mainbranch` is `true`. Otherwise it must be a non-empty value. It is possible for the configured branch to not exist (e.g. it was deleted after the settings are set). In this case `is_valid` will be `false`. The branch must exist when updating/setting the `name` or an error will occur.
    name: option<string>,
    /// Indicates if the setting points at an explicit branch (`false`) or tracks the main branch (`true`). When `true` the `name` must be `null` or not provided. When `false` the `name` must contain a non-empty branch name.
    use-mainbranch: option<bool>
  }

  record effective-repo-branching-model {
    type-op: string,
    /// The active branch types.
    branch-types: option<list<effective-repo-branching-model-branch-types-item>>,
    development: option<effective-repo-branching-model-development>,
    production: option<effective-repo-branching-model-production>
  }

  record effective-repo-branching-model-branch-types-item {
    /// The kind of branch.
    kind: branching-model-branch-types-item-kind-enum,
    /// The prefix for this branch type. A branch with this prefix will be classified as per `kind`. The prefix must be a valid prefix for a branch and must always exist. It cannot be blank, empty or `null`.
    prefix: string
  }

  record effective-repo-branching-model-development {
    branch: option<branch>,
    /// Name of the target branch. Will be listed here even when the target branch does not exist. Will be `null` if targeting the main branch and the repository is empty.
    name: string,
    /// Indicates if the setting points at an explicit branch (`false`) or tracks the main branch (`true`).
    use-mainbranch: bool
  }

  record effective-repo-branching-model-production {
    branch: option<branch>,
    /// Name of the target branch. Will be listed here even when the target branch does not exist. Will be `null` if targeting the main branch and the repository is empty.
    name: string,
    /// Indicates if the setting points at an explicit branch (`false`) or tracks the main branch (`true`).
    use-mainbranch: bool
  }

  record project-branching-model {
    type-op: string,
    /// The active branch types.
    branch-types: option<list<project-branching-model-branch-types-item>>,
    development: option<project-branching-model-development>,
    production: option<project-branching-model-production>
  }

  record project-branching-model-branch-types-item {
    /// The kind of branch.
    kind: branching-model-branch-types-item-kind-enum,
    /// The prefix for this branch type. A branch with this prefix will be classified as per `kind`. The prefix must be a valid prefix for a branch and must always exist. It cannot be blank, empty or `null`.
    prefix: string
  }

  record project-branching-model-development {
    /// Name of the target branch. If inherited by a repository, it will default to the main branch if the specified branch does not exist.
    name: string,
    /// Indicates if the setting points at an explicit branch (`false`) or tracks the main branch (`true`).
    use-mainbranch: bool
  }

  record project-branching-model-production {
    /// Name of the target branch. If inherited by a repository, it will default to the main branch if the specified branch does not exist.
    name: string,
    /// Indicates if the setting points at an explicit branch (`false`) or tracks the main branch (`true`).
    use-mainbranch: bool
  }

  variant get-repositories-workspace-repo-slug-branching-model-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-repositories-workspace-repo-slug-branching-model-settings-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant put-repositories-workspace-repo-slug-branching-model-settings-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-repositories-workspace-repo-slug-effective-branching-model-error {
