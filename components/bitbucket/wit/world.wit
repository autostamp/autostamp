  put-workspaces-workspace-hooks-uid: func(params: put-workspaces-workspace-hooks-uid-params) -> result<webhook-subscription, put-workspaces-workspace-hooks-uid-error>;

  /// Delete a webhook for a workspace
  record delete-workspaces-workspace-hooks-uid-params {
    /// Installed webhook's ID
    uid: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  delete-workspaces-workspace-hooks-uid: func(params: delete-workspaces-workspace-hooks-uid-params) -> result<string, delete-workspaces-workspace-hooks-uid-error>;

  /// List users in a workspace
  record get-workspaces-workspace-members-params {
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-members: func(params: get-workspaces-workspace-members-params) -> result<paginated-workspace-memberships, get-workspaces-workspace-members-error>;

  /// Get user membership for a workspace
  record get-workspaces-workspace-members-member-params {
    /// Member's UUID or Atlassian ID.
    member: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-members-member: func(params: get-workspaces-workspace-members-member-params) -> result<workspace-membership, get-workspaces-workspace-members-member-error>;

  /// List user permissions in a workspace
  record get-workspaces-workspace-permissions-params {
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    /// 
    /// Query string to narrow down the response as per
    q: option<string>
  }
  get-workspaces-workspace-permissions: func(params: get-workspaces-workspace-permissions-params) -> result<paginated-workspace-memberships, get-workspaces-workspace-permissions-error>;

  /// List all repository permissions for a workspace
  record get-workspaces-workspace-permissions-repositories-params {
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    /// 
    /// Query string to narrow down the response as per
    q: option<string>,
    /// 
    /// Name of a response property sort the result by as per
    sort: option<string>
  }
  get-workspaces-workspace-permissions-repositories: func(params: get-workspaces-workspace-permissions-repositories-params) -> result<paginated-repository-permissions, get-workspaces-workspace-permissions-repositories-error>;

  /// List a repository permissions for a workspace
  record get-workspaces-workspace-permissions-repositories-repo-slug-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    /// 
    /// Query string to narrow down the response as per
    q: option<string>,
    /// 
    /// Name of a response property sort the result by as per
    sort: option<string>
  }
  get-workspaces-workspace-permissions-repositories-repo-slug: func(params: get-workspaces-workspace-permissions-repositories-repo-slug-params) -> result<paginated-repository-permissions, get-workspaces-workspace-permissions-repositories-repo-slug-error>;

  /// List projects in a workspace
  record get-workspaces-workspace-projects-params {
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-projects: func(params: get-workspaces-workspace-projects-params) -> result<paginated-projects, get-workspaces-workspace-projects-error>;

}

interface ssh {
  /// A paginated list of SSH keys.
  record paginated-ssh-user-keys {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<account-key>>
  }

  record account-key {
    type-op: string,
    /// The comment parsed from the SSH key (if present)
    comment: option<string>,
    created-on: option<string>,
    /// The SSH public key value in OpenSSH format.
    key: option<string>,
    /// The user-defined label for the SSH key
    label: option<string>,
    last-used: option<string>,
    links: option<account-key-links>,
    /// The SSH key's immutable ID.
    uuid: option<string>,
    owner: option<account>
  }

  record account-key-links {
    /// A link to a resource related to this object.
    self: option<account-key-links-self>
  }

  /// A link to a resource related to this object.
  record account-key-links-self {
    href: option<string>,
    name: option<string>
  }

  record account {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  variant get-users-selected-user-ssh-keys-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant post-users-selected-user-ssh-keys-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-users-selected-user-ssh-keys-key-id-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant put-users-selected-user-ssh-keys-key-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-users-selected-user-ssh-keys-key-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// List SSH keys
  record get-users-selected-user-ssh-keys-params {
    /// This can either be the UUID of the account, surrounded by curly-braces, for
    /// example: `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string
  }
  get-users-selected-user-ssh-keys: func(params: get-users-selected-user-ssh-keys-params) -> result<paginated-ssh-user-keys, get-users-selected-user-ssh-keys-error>;

  /// Add a new SSH key
  record post-users-selected-user-ssh-keys-params {
    /// This can either be the UUID of the account, surrounded by curly-braces, for
    /// example: `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string,
    type-op: string,
    /// The comment parsed from the SSH key (if present)
    comment: option<string>,
    created-on: option<string>,
    /// The SSH public key value in OpenSSH format.
    key: option<string>,
    /// The user-defined label for the SSH key
    label: option<string>,
    last-used: option<string>,
    links: option<account-key-links>,
    /// The SSH key's immutable ID.
    uuid: option<string>,
    owner: option<account>
  }
  post-users-selected-user-ssh-keys: func(params: post-users-selected-user-ssh-keys-params) -> result<account-key, post-users-selected-user-ssh-keys-error>;

  /// Get a SSH key
  record get-users-selected-user-ssh-keys-key-id-params {
    /// The SSH key's UUID value.
    key-id: string,
    /// This can either be the UUID of the account, surrounded by curly-braces, for
    /// example: `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string
  }
  get-users-selected-user-ssh-keys-key-id: func(params: get-users-selected-user-ssh-keys-key-id-params) -> result<account-key, get-users-selected-user-ssh-keys-key-id-error>;

  /// Update a SSH key
  record put-users-selected-user-ssh-keys-key-id-params {
    /// The SSH key's UUID value.
    key-id: string,
    /// This can either be the UUID of the account, surrounded by curly-braces, for
    /// example: `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string,
    type-op: string,
    /// The comment parsed from the SSH key (if present)
    comment: option<string>,
    created-on: option<string>,
    /// The SSH public key value in OpenSSH format.
    key: option<string>,
    /// The user-defined label for the SSH key
    label: option<string>,
    last-used: option<string>,
    links: option<account-key-links>,
    /// The SSH key's immutable ID.
    uuid: option<string>,
    owner: option<account>
  }
  put-users-selected-user-ssh-keys-key-id: func(params: put-users-selected-user-ssh-keys-key-id-params) -> result<account-key, put-users-selected-user-ssh-keys-key-id-error>;

  /// Delete a SSH key
  record delete-users-selected-user-ssh-keys-key-id-params {
    /// The SSH key's UUID value.
    key-id: string,
    /// This can either be the UUID of the account, surrounded by curly-braces, for
    /// example: `{account UUID}`, OR an Atlassian Account ID.
    selected-user: string
  }
  delete-users-selected-user-ssh-keys-key-id: func(params: delete-users-selected-user-ssh-keys-key-id-params) -> result<string, delete-users-selected-user-ssh-keys-key-id-error>;

}

interface projects {
  record project {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Indicates whether the project contains publicly visible repositories.
    has-publicly-visible-repos: option<bool>,
    /// 
    /// Indicates whether the project is publicly accessible, or whether it is
    is-private: option<bool>,
    /// The project's key.
    key: option<string>,
    links: option<project-links>,
    /// The name of the project.
    name: option<string>,
    owner: option<team>,
    updated-on: option<string>,
    /// The project's immutable id.
    uuid: option<string>
  }

  record project-links {
    /// A link to a resource related to this object.
    avatar: option<project-links-avatar>,
    /// A link to a resource related to this object.
    html: option<project-links-html>
  }

  /// A link to a resource related to this object.
  record project-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record project-links-html {
    href: option<string>,
    name: option<string>
  }

  record team {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  /// A paginated list of default reviewers with reviewer type.
  record paginated-default-reviewer-and-type {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<default-reviewer-and-type>>
  }

  /// Object containing a user that is a default reviewer and the type of reviewer
  record default-reviewer-and-type {
    reviewer-type: option<string>,
    type-op: string,
    user: option<user>
  }

  record user {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>,
    /// The user's Atlassian account ID.
    account-id: option<string>,
    /// The status of the account. Currently the only possible value is "active", but more values may be added in the future.
    account-status: option<string>,
    has-v2fa-enabled: option<bool>,
    is-staff: option<bool>,
    /// Account name defined by the owner. Should be used instead of the "username" field. Note that "nickname" cannot be used in place of "username" in URLs and queries, as "nickname" is not guaranteed to be unique.
    nickname: option<string>,
    website: option<string>
  }

  variant post-workspaces-workspace-projects-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-workspaces-workspace-projects-project-key-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant put-workspaces-workspace-projects-project-key-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-workspaces-workspace-projects-project-key-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-workspaces-workspace-projects-project-key-default-reviewers-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-workspaces-workspace-projects-project-key-default-reviewers-selected-user-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant put-workspaces-workspace-projects-project-key-default-reviewers-selected-user-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-workspaces-workspace-projects-project-key-default-reviewers-selected-user-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Create a project in a workspace
  record post-workspaces-workspace-projects-params {
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Indicates whether the project contains publicly visible repositories.
    has-publicly-visible-repos: option<bool>,
    /// 
    /// Indicates whether the project is publicly accessible, or whether it is
    is-private: option<bool>,
    /// The project's key.
    key: option<string>,
    links: option<project-links>,
    /// The name of the project.
    name: option<string>,
    owner: option<team>,
    updated-on: option<string>,
    /// The project's immutable id.
    uuid: option<string>
  }
  post-workspaces-workspace-projects: func(params: post-workspaces-workspace-projects-params) -> result<project, post-workspaces-workspace-projects-error>;

  /// Get a project for a workspace
  record get-workspaces-workspace-projects-project-key-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-projects-project-key: func(params: get-workspaces-workspace-projects-project-key-params) -> result<project, get-workspaces-workspace-projects-project-key-error>;

  /// Update a project for a workspace
  record put-workspaces-workspace-projects-project-key-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Indicates whether the project contains publicly visible repositories.
    has-publicly-visible-repos: option<bool>,
    /// 
    /// Indicates whether the project is publicly accessible, or whether it is
    is-private: option<bool>,
    /// The project's key.
    key: option<string>,
    links: option<project-links>,
    /// The name of the project.
    name: option<string>,
    owner: option<team>,
    updated-on: option<string>,
    /// The project's immutable id.
    uuid: option<string>
  }
  put-workspaces-workspace-projects-project-key: func(params: put-workspaces-workspace-projects-project-key-params) -> result<project, put-workspaces-workspace-projects-project-key-error>;

  /// Delete a project for a workspace
  record delete-workspaces-workspace-projects-project-key-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  delete-workspaces-workspace-projects-project-key: func(params: delete-workspaces-workspace-projects-project-key-params) -> result<string, delete-workspaces-workspace-projects-project-key-error>;

  /// List the default reviewers in a project
  record get-workspaces-workspace-projects-project-key-default-reviewers-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-projects-project-key-default-reviewers: func(params: get-workspaces-workspace-projects-project-key-default-reviewers-params) -> result<paginated-default-reviewer-and-type, get-workspaces-workspace-projects-project-key-default-reviewers-error>;

  /// Get a default reviewer
  record get-workspaces-workspace-projects-project-key-default-reviewers-selected-user-params {
    /// The project in question. This can either be the actual `key` assigned
    /// to the project or the `UUID` (surrounded by curly-braces (`{}`)).
    project-key: string,
    /// This can either be the username or the UUID of the default reviewer,
    /// surrounded by curly-braces, for example: `{account UUID}`.
    selected-user: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-projects-project-key-default-reviewers-selected-user: func(params: get-workspaces-workspace-projects-project-key-default-reviewers-selected-user-params) -> result<user, get-workspaces-workspace-projects-project-key-default-reviewers-selected-user-error>;

  /// Add the specific user as a default reviewer for the project
  record put-workspaces-workspace-projects-project-key-default-reviewers-selected-user-params {
    /// The project in question. This can either be the actual `key` assigned
    /// to the project or the `UUID` (surrounded by curly-braces (`{}`)).
    project-key: string,
    /// This can either be the username or the UUID of the default reviewer,
    /// surrounded by curly-braces, for example: `{account UUID}`.
    selected-user: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  put-workspaces-workspace-projects-project-key-default-reviewers-selected-user: func(params: put-workspaces-workspace-projects-project-key-default-reviewers-selected-user-params) -> result<user, put-workspaces-workspace-projects-project-key-default-reviewers-selected-user-error>;

  /// Remove the specific user from the project's default reviewers
  record delete-workspaces-workspace-projects-project-key-default-reviewers-selected-user-params {
    /// The project in question. This can either be the actual `key` assigned
    /// to the project or the `UUID` (surrounded by curly-braces (`{}`)).
    project-key: string,
    /// This can either be the username or the UUID of the default reviewer,
    /// surrounded by curly-braces, for example: `{account UUID}`.
    selected-user: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  delete-workspaces-workspace-projects-project-key-default-reviewers-selected-user: func(params: delete-workspaces-workspace-projects-project-key-default-reviewers-selected-user-params) -> result<string, delete-workspaces-workspace-projects-project-key-default-reviewers-selected-user-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export addon;
  export webhooks;
  export pullrequests;
  export repositories;
  export branch-restrictions;
  export branching-model;
  export commits;
  export properties;
  export reports;
  export commit-statuses;
  export issue-tracker;
  export deployments;
  export pipelines;
  export downloads;
  export source;
  export refs;
  export snippets;
  export search;
  export users;
  export workspaces;
  export ssh;
  export projects;
}
