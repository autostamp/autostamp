  put-repositories-workspace-repo-slug-deploy-keys-key-id: func(params: put-repositories-workspace-repo-slug-deploy-keys-key-id-params) -> result<deploy-key, put-repositories-workspace-repo-slug-deploy-keys-key-id-error>;

  /// Delete a repository deploy key
  record delete-repositories-workspace-repo-slug-deploy-keys-key-id-params {
    /// The key ID matching the deploy key.
    key-id: string,
    /// This can either be the repository slug or the UUID of the repository,
