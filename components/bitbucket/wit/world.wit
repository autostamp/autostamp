  put-repositories-workspace-repo-slug-branch-restrictions-id: func(params: put-repositories-workspace-repo-slug-branch-restrictions-id-params) -> result<branchrestriction, put-repositories-workspace-repo-slug-branch-restrictions-id-error>;

  /// Delete a branch restriction rule
