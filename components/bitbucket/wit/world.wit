  variant put-workspaces-workspace-projects-project-key-branching-model-settings-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get the branching model for a repository
  record get-repositories-workspace-repo-slug-branching-model-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-branching-model: func(params: get-repositories-workspace-repo-slug-branching-model-params) -> result<branching-model, get-repositories-workspace-repo-slug-branching-model-error>;

  /// Get the branching model config for a repository
  record get-repositories-workspace-repo-slug-branching-model-settings-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-branching-model-settings: func(params: get-repositories-workspace-repo-slug-branching-model-settings-params) -> result<settings, get-repositories-workspace-repo-slug-branching-model-settings-error>;

  /// Update the branching model config for a repository
  record put-repositories-workspace-repo-slug-branching-model-settings-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  put-repositories-workspace-repo-slug-branching-model-settings: func(params: put-repositories-workspace-repo-slug-branching-model-settings-params) -> result<settings, put-repositories-workspace-repo-slug-branching-model-settings-error>;

  /// Get the effective, or currently applied, branching model for a repository
  record get-repositories-workspace-repo-slug-effective-branching-model-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-effective-branching-model: func(params: get-repositories-workspace-repo-slug-effective-branching-model-params) -> result<effective-repo-branching-model, get-repositories-workspace-repo-slug-effective-branching-model-error>;

  /// Get the branching model for a project
  record get-workspaces-workspace-projects-project-key-branching-model-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-projects-project-key-branching-model: func(params: get-workspaces-workspace-projects-project-key-branching-model-params) -> result<project-branching-model, get-workspaces-workspace-projects-project-key-branching-model-error>;

  /// Get the branching model config for a project
  record get-workspaces-workspace-projects-project-key-branching-model-settings-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-workspaces-workspace-projects-project-key-branching-model-settings: func(params: get-workspaces-workspace-projects-project-key-branching-model-settings-params) -> result<settings, get-workspaces-workspace-projects-project-key-branching-model-settings-error>;

  /// Update the branching model config for a project
  record put-workspaces-workspace-projects-project-key-branching-model-settings-params {
    /// The project in question. This is the actual `key` assigned
    /// to the project.
    project-key: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  put-workspaces-workspace-projects-project-key-branching-model-settings: func(params: put-workspaces-workspace-projects-project-key-branching-model-settings-params) -> result<settings, put-workspaces-workspace-projects-project-key-branching-model-settings-error>;

}

interface commits {
  enum base-commit-summary-markup-enum {
    markdown,
    creole,
    plaintext,
  }

  enum participant-role-enum {
    participant,
    reviewer,
  }

  enum participant-state-enum {
    approved,
    changes-requested,
  }

  enum repository-fork-policy-enum {
    allow-forks,
    no-public-forks,
    no-forks,
  }

  enum branch-merge-strategies-item-enum {
    merge-commit,
    squash,
    fast-forward,
  }

  enum repository-scm-enum {
    git,
  }

  enum commit-file-attributes-enum {
    link,
    executable,
    subrepository,
    binary,
    lfs,
  }

  enum diffstat-status-enum {
    added,
    removed,
    modified,
    renamed,
  }

  record commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<base-commit>>,
    summary: option<commit-summary>,
    participants: option<list<participant>>,
    repository: option<repository>
  }

  record author {
    type-op: string,
    /// The raw author value from the repository. This may be the only value available if the author does not match a user in Bitbucket.
    raw: option<string>,
    user: option<account>
  }

  record account {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  record base-commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<string>>,
    summary: option<base-commit-summary>
  }

  record base-commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record participant {
    type-op: string,
    approved: option<bool>,
    /// The ISO8601 timestamp of the participant's action. For approvers, this is the time of their approval. For commenters and pull request reviewers who are not approvers, this is the time they last commented, or null if they have not commented.
    participated-on: option<string>,
    role: option<participant-role-enum>,
    state: option<participant-state-enum>,
    user: option<account>
  }

  record repository {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Controls the rules for forking this repository.
    fork-policy: option<repository-fork-policy-enum>,
    /// The concatenation of the repository owner's username and the slugified name, e.g. "evzijst/interruptingcow". This is the same string used in Bitbucket URLs.
    full-name: option<string>,
    has-issues: option<bool>,
    has-wiki: option<bool>,
    is-private: option<bool>,
    language: option<string>,
    links: option<repository-links>,
    mainbranch: option<branch>,
    name: option<string>,
    owner: option<account>,
    parent: option<string>,
    project: option<project>,
    scm: option<repository-scm-enum>,
    size: option<s32>,
    updated-on: option<string>,
    /// The repository's immutable id. This can be used as a substitute for the slug segment in URLs. Doing this guarantees your URLs will survive renaming of the repository by its owner, or even transfer of the repository to a different user.
    uuid: option<string>
  }

  record repository-links {
    /// A link to a resource related to this object.
    avatar: option<repository-links-avatar>,
    clone: option<list<repository-links-clone-item>>,
    /// A link to a resource related to this object.
    commits: option<repository-links-commits>,
    /// A link to a resource related to this object.
    downloads: option<repository-links-downloads>,
    /// A link to a resource related to this object.
    forks: option<repository-links-forks>,
    /// A link to a resource related to this object.
    hooks: option<repository-links-hooks>,
    /// A link to a resource related to this object.
    html: option<repository-links-html>,
    /// A link to a resource related to this object.
    pullrequests: option<repository-links-pullrequests>,
    /// A link to a resource related to this object.
    self: option<repository-links-self>,
    /// A link to a resource related to this object.
    watchers: option<repository-links-watchers>
  }

  /// A link to a resource related to this object.
  record repository-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-clone-item {
