    /// The name of the property.
    property-name: string
  }
  delete-user-hosted-property-value: func(params: delete-user-hosted-property-value-params) -> result<string, string>;

}

interface reports {
  enum report-data-type-op-enum {
    boolean,
    date,
    duration,
    link,
    number,
    percentage,
    text,
  }

  enum report-report-type-enum {
    security,
    coverage,
    test,
    bug,
  }

  enum report-result-op-enum {
    passed,
    failed,
    pending,
  }

  enum report-annotation-annotation-type-enum {
    vulnerability,
    code-smell,
    bug,
  }

  enum report-annotation-result-op-enum {
    passed,
    failed,
    skipped,
    ignored,
  }

  enum report-annotation-severity-enum {
    critical,
    high,
    medium,
    low,
  }

  /// A paginated list of reports.
  record paginated-reports {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    /// The values of the current page.
    values: option<list<report>>
  }

  record report {
    type-op: string,
    /// The timestamp when the report was created.
    created-on: option<string>,
    /// An array of data fields to display information on the report. Maximum 10.
    data: option<list<report-data>>,
    /// A string to describe the purpose of the report.
    details: option<string>,
    /// ID of the report provided by the report creator. It can be used to identify the report as an alternative to it's generated uuid. It is not used by Bitbucket, but only by the report creator for updating or deleting this specific report. Needs to be unique.
    external-id: option<string>,
    /// A URL linking to the results of the report in an external tool.
    link: option<string>,
    /// A URL to the report logo. If none is provided, the default insights logo will be used.
    logo-url: option<string>,
    /// If enabled, a remote link is created in Jira for the issue associated with the commit the report belongs to.
    remote-link-enabled: option<bool>,
    /// The type of the report.
    report-type: option<report-report-type-enum>,
    /// A string to describe the tool or company who created the report.
    reporter: option<string>,
    /// The state of the report. May be set to PENDING and later updated.
    result-op: option<report-result-op-enum>,
    /// The title of the report.
    title: option<string>,
    /// The timestamp when the report was updated.
    updated-on: option<string>,
    /// The UUID that can be used to identify the report.
    uuid: option<string>
  }

  /// A key-value element that will be displayed along with the report.
  record report-data {
    /// A string describing what this data field represents.
    title: option<string>,
    /// The type of data contained in the value field. If not provided, then the value will be detected as a boolean, number or string.
    type-op: option<report-data-type-op-enum>,
    /// The value of the data element.
    value: option<list<report-data-value-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record report-data-value-entry {
    key: string,
    value: string
  }

  /// A paginated list of annotations.
  record paginated-annotations {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    /// The values of the current page.
    values: option<list<report-annotation>>
  }

  record report-annotation {
    type-op: string,
    /// The type of the report.
    annotation-type: option<report-annotation-annotation-type-enum>,
    /// The timestamp when the report was created.
    created-on: option<string>,
    /// The details to show to users when clicking on the annotation.
    details: option<string>,
    /// ID of the annotation provided by the annotation creator. It can be used to identify the annotation as an alternative to it's generated uuid. It is not used by Bitbucket, but only by the annotation creator for updating or deleting this specific annotation. Needs to be unique.
    external-id: option<string>,
    /// The line number that the annotation should belong to. If no line number is provided, then it will default to 0 and in a pull request it will appear at the top of the file specified by the path field.
    line: option<s32>,
    /// A URL linking to the annotation in an external tool.
    link: option<string>,
    /// The path of the file on which this annotation should be placed. This is the path of the file relative to the git repository. If no path is provided, then it will appear in the overview modal on all pull requests where the tip of the branch is the given commit, regardless of which files were modified.
    path: option<string>,
    /// The state of the report. May be set to PENDING and later updated.
    result-op: option<report-annotation-result-op-enum>,
    /// The severity of the annotation.
    severity: option<report-annotation-severity-enum>,
    /// The message to display to users.
    summary: option<string>,
    /// The timestamp when the report was updated.
    updated-on: option<string>,
    /// The UUID that can be used to identify the annotation.
    uuid: option<string>
  }

  variant get-report-error {
    not-found(string),
    other(string)
  }

  variant create-or-update-report-error {
    bad-request(string),
    other(string)
  }

  variant get-annotation-error {
    not-found(string),
    other(string)
  }

  variant create-or-update-annotation-error {
    bad-request(string),
    other(string)
  }

  /// List reports
  record get-reports-for-commit-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit for which to retrieve reports.
    commit: string
  }
  get-reports-for-commit: func(params: get-reports-for-commit-params) -> result<paginated-reports, string>;

  /// Get a report
  record get-report-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit the report belongs to.
    commit: string,
    /// Either the uuid or external-id of the report.
    report-id: string
  }
  get-report: func(params: get-report-params) -> result<report, get-report-error>;

  /// Create or update a report
  record create-or-update-report-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit the report belongs to.
    commit: string,
    /// Either the uuid or external-id of the report.
    report-id: string,
    type-op: string,
    /// The timestamp when the report was created.
    created-on: option<string>,
    /// An array of data fields to display information on the report. Maximum 10.
    data: option<list<report-data>>,
    /// A string to describe the purpose of the report.
    details: option<string>,
    /// ID of the report provided by the report creator. It can be used to identify the report as an alternative to it's generated uuid. It is not used by Bitbucket, but only by the report creator for updating or deleting this specific report. Needs to be unique.
    external-id: option<string>,
    /// A URL linking to the results of the report in an external tool.
    link: option<string>,
    /// A URL to the report logo. If none is provided, the default insights logo will be used.
    logo-url: option<string>,
    /// If enabled, a remote link is created in Jira for the issue associated with the commit the report belongs to.
    remote-link-enabled: option<bool>,
    /// The type of the report.
    report-type: option<report-report-type-enum>,
    /// A string to describe the tool or company who created the report.
    reporter: option<string>,
    /// The state of the report. May be set to PENDING and later updated.
    result-op: option<report-result-op-enum>,
    /// The title of the report.
    title: option<string>,
    /// The timestamp when the report was updated.
    updated-on: option<string>,
    /// The UUID that can be used to identify the report.
    uuid: option<string>
  }
  create-or-update-report: func(params: create-or-update-report-params) -> result<report, create-or-update-report-error>;

  /// Delete a report
  record delete-report-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit the report belongs to.
    commit: string,
    /// Either the uuid or external-id of the report.
    report-id: string
  }
  delete-report: func(params: delete-report-params) -> result<string, string>;

  /// List annotations
  record get-annotations-for-report-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit for which to retrieve reports.
    commit: string,
    /// Uuid or external-if of the report for which to get annotations for.
    report-id: string
  }
  get-annotations-for-report: func(params: get-annotations-for-report-params) -> result<paginated-annotations, string>;

  /// Bulk create or update annotations
  record bulk-create-or-update-annotations-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit for which to retrieve reports.
    commit: string,
    /// Uuid or external-if of the report for which to get annotations for.
    report-id: string,
    body: list<report-annotation>
  }
  bulk-create-or-update-annotations: func(params: bulk-create-or-update-annotations-params) -> result<list<report-annotation>, string>;

  /// Get an annotation
  record get-annotation-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit the report belongs to.
    commit: string,
    /// Either the uuid or external-id of the report.
    report-id: string,
    /// Either the uuid or external-id of the annotation.
    annotation-id: string
  }
  get-annotation: func(params: get-annotation-params) -> result<report-annotation, get-annotation-error>;

  /// Create or update an annotation
  record create-or-update-annotation-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit the report belongs to.
    commit: string,
    /// Either the uuid or external-id of the report.
    report-id: string,
    /// Either the uuid or external-id of the annotation.
    annotation-id: string,
    type-op: string,
    /// The type of the report.
    annotation-type: option<report-annotation-annotation-type-enum>,
    /// The timestamp when the report was created.
    created-on: option<string>,
    /// The details to show to users when clicking on the annotation.
    details: option<string>,
    /// ID of the annotation provided by the annotation creator. It can be used to identify the annotation as an alternative to it's generated uuid. It is not used by Bitbucket, but only by the annotation creator for updating or deleting this specific annotation. Needs to be unique.
    external-id: option<string>,
    /// The line number that the annotation should belong to. If no line number is provided, then it will default to 0 and in a pull request it will appear at the top of the file specified by the path field.
    line: option<s32>,
    /// A URL linking to the annotation in an external tool.
    link: option<string>,
    /// The path of the file on which this annotation should be placed. This is the path of the file relative to the git repository. If no path is provided, then it will appear in the overview modal on all pull requests where the tip of the branch is the given commit, regardless of which files were modified.
    path: option<string>,
    /// The state of the report. May be set to PENDING and later updated.
    result-op: option<report-annotation-result-op-enum>,
    /// The severity of the annotation.
    severity: option<report-annotation-severity-enum>,
    /// The message to display to users.
    summary: option<string>,
    /// The timestamp when the report was updated.
    updated-on: option<string>,
    /// The UUID that can be used to identify the annotation.
    uuid: option<string>
  }
  create-or-update-annotation: func(params: create-or-update-annotation-params) -> result<report-annotation, create-or-update-annotation-error>;

  /// Delete an annotation
  record delete-annotation-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit the annotation belongs to.
    commit: string,
    /// Either the uuid or external-id of the annotation.
    report-id: string,
    /// Either the uuid or external-id of the annotation.
    annotation-id: string
  }
  delete-annotation: func(params: delete-annotation-params) -> result<string, string>;

}

interface commit-statuses {
  enum commitstatus-state-enum {
    inprogress,
    successful,
    failed,
    stopped,
  }

  /// A paginated list of commit status objects.
  record paginated-commitstatuses {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<commitstatus>>
  }

  record commitstatus {
    type-op: string,
    created-on: option<string>,
    /// A description of the build (e.g. "Unit tests in Bamboo")
    description: option<string>,
    /// An identifier for the status that's unique to
    ///         its type (current "build" is the only supported type) and the vendor,
    key: option<string>,
    links: option<commitstatus-links>,
    /// An identifier for the build itself, e.g. BB-DEPLOY-1
    name: option<string>,
    /// 
    /// The name of the ref that pointed to this commit at the time the status
    refname: option<string>,
    /// Provides some indication of the status of this commit
    state: option<commitstatus-state-enum>,
    updated-on: option<string>,
    /// A URL linking back to the vendor or build system, for providing more information about whatever process produced this status. Accepts context variables `repository` and `commit` that Bitbucket will evaluate at runtime whenever at runtime. For example, one could use https://foo.com/builds/{repository.full_name} which Bitbucket will turn into https://foo.com/builds/foo/bar at render time.
    url: option<string>,
    /// The commit status' id.
    uuid: option<string>
  }

  record commitstatus-links {
    /// A link to a resource related to this object.
    commit: option<commitstatus-links-commit>,
    /// A link to a resource related to this object.
    self: option<commitstatus-links-self>
  }

  /// A link to a resource related to this object.
  record commitstatus-links-commit {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record commitstatus-links-self {
    href: option<string>,
    name: option<string>
  }

  variant get-repositories-workspace-repo-slug-commit-commit-statuses-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant post-repositories-workspace-repo-slug-commit-commit-statuses-build-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-repositories-workspace-repo-slug-commit-commit-statuses-build-key-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant put-repositories-workspace-repo-slug-commit-commit-statuses-build-key-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// List commit statuses for a commit
  record get-repositories-workspace-repo-slug-commit-commit-statuses-params {
    /// The commit's SHA1.
    commit: string,
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string,
    /// Query string to narrow down the response as per
    /// [filtering and sorting](/cloud/bitbucket/rest/intro/#filtering).
    q: option<string>,
