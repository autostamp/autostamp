  /// List variables for an environment
  record get-deployment-variables-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The environment.
    environment-uuid: string
  }
  get-deployment-variables: func(params: get-deployment-variables-params) -> result<paginated-deployment-variable, string>;

  /// Create a variable for an environment
  record create-deployment-variable-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The environment.
    environment-uuid: string,
    type-op: string,
    /// The unique name of the variable.
    key: option<string>,
    /// If true, this variable will be treated as secured. The value will never be exposed in the logs or the REST API.
    secured: option<bool>,
    /// The UUID identifying the variable.
    uuid: option<string>,
    /// The value of the variable. If the variable is secured, this will be empty.
    value: option<string>
  }
  create-deployment-variable: func(params: create-deployment-variable-params) -> result<deployment-variable, create-deployment-variable-error>;

  /// Update a variable for an environment
  record update-deployment-variable-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The environment.
    environment-uuid: string,
    /// The UUID of the variable to update.
    variable-uuid: string,
    type-op: string,
    /// The unique name of the variable.
    key: option<string>,
    /// If true, this variable will be treated as secured. The value will never be exposed in the logs or the REST API.
    secured: option<bool>,
    /// The UUID identifying the variable.
    uuid: option<string>,
    /// The value of the variable. If the variable is secured, this will be empty.
    value: option<string>
  }
  update-deployment-variable: func(params: update-deployment-variable-params) -> result<deployment-variable, update-deployment-variable-error>;

  /// Delete a variable for an environment
  record delete-deployment-variable-params {
    /// This can either be the workspace ID (slug) or the workspace UUID surrounded by curly-braces, for example `{workspace UUID}`.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The environment.
    environment-uuid: string,
    /// The UUID of the variable to delete.
    variable-uuid: string
  }
  delete-deployment-variable: func(params: delete-deployment-variable-params) -> result<string, delete-deployment-variable-error>;

