    repo-slug: string,
    /// The UUID of the pipeline.
    pipeline-uuid: string,
    /// The UUID of the step.
    step-uuid: string
  }
  get-pipeline-test-report-test-cases: func(params: get-pipeline-test-report-test-cases-params) -> result<string, get-pipeline-test-report-test-cases-error>;

