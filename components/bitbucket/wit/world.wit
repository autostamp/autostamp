    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-merge-base-revspec: func(params: get-repositories-workspace-repo-slug-merge-base-revspec-params) -> result<commit, get-repositories-workspace-repo-slug-merge-base-revspec-error>;

  /// Get a patch for two commits
  record get-repositories-workspace-repo-slug-patch-spec-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// A commit SHA (e.g. `3a8b42`) or a commit range using double dot
    /// notation (e.g. `3a8b42..9ff173`).
    spec: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-patch-spec: func(params: get-repositories-workspace-repo-slug-patch-spec-params) -> result<string, get-repositories-workspace-repo-slug-patch-spec-error>;

}

interface properties {
  enum application-property-attributes-item-enum {
    public,
    read-only,
  }

  /// An application property. It is a caller defined JSON object that Bitbucket will store and return. 
  /// The `_attributes` field at its top level can be used to control who is allowed to read and update the property. 
  /// The keys of the JSON object must match an allowed pattern. For details, 
  /// see [Application properties](/cloud/bitbucket/application-properties/).
  record application-property {
    attributes: option<list<application-property-attributes-item-enum>>
  }

  /// Get a commit application property
  record get-commit-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit.
    commit: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  get-commit-hosted-property-value: func(params: get-commit-hosted-property-value-params) -> result<application-property, string>;

  /// Update a commit application property
  record update-commit-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit.
    commit: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string,
    attributes: option<list<application-property-attributes-item-enum>>
  }
  update-commit-hosted-property-value: func(params: update-commit-hosted-property-value-params) -> result<string, string>;

  /// Delete a commit application property
  record delete-commit-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The commit.
    commit: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  delete-commit-hosted-property-value: func(params: delete-commit-hosted-property-value-params) -> result<string, string>;

  /// Get a repository application property
  record get-repository-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  get-repository-hosted-property-value: func(params: get-repository-hosted-property-value-params) -> result<application-property, string>;

  /// Update a repository application property
  record update-repository-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string,
    attributes: option<list<application-property-attributes-item-enum>>
  }
  update-repository-hosted-property-value: func(params: update-repository-hosted-property-value-params) -> result<string, string>;

  /// Delete a repository application property
  record delete-repository-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  delete-repository-hosted-property-value: func(params: delete-repository-hosted-property-value-params) -> result<string, string>;

  /// Get a pull request application property
  record get-pull-request-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The pull request ID.
    pullrequest-id: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string
  }
  get-pull-request-hosted-property-value: func(params: get-pull-request-hosted-property-value-params) -> result<application-property, string>;

  /// Update a pull request application property
  record update-pull-request-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The pull request ID.
    pullrequest-id: string,
    /// The key of the Connect app.
    app-key: string,
    /// The name of the property.
    property-name: string,
    attributes: option<list<application-property-attributes-item-enum>>
  }
  update-pull-request-hosted-property-value: func(params: update-pull-request-hosted-property-value-params) -> result<string, string>;

  /// Delete a pull request application property
  record delete-pull-request-hosted-property-value-params {
    /// The repository container; either the workspace slug or the UUID in curly braces.
    workspace: string,
    /// The repository.
    repo-slug: string,
    /// The pull request ID.
    pullrequest-id: string,
    /// The key of the Connect app.
