interface downloads {
  variant get-repositories-workspace-repo-slug-downloads-error {
    forbidden(string),
    other(string)
  }

  variant post-repositories-workspace-repo-slug-downloads-error {
    bad-request(string),
    forbidden(string),
    not-acceptable(string),
    other(string)
  }

  variant get-repositories-workspace-repo-slug-downloads-filename-error {
    found(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-repositories-workspace-repo-slug-downloads-filename-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// List download artifacts
  record get-repositories-workspace-repo-slug-downloads-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-downloads: func(params: get-repositories-workspace-repo-slug-downloads-params) -> result<string, get-repositories-workspace-repo-slug-downloads-error>;

  /// Upload a download artifact
  record post-repositories-workspace-repo-slug-downloads-params {
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  post-repositories-workspace-repo-slug-downloads: func(params: post-repositories-workspace-repo-slug-downloads-params) -> result<string, post-repositories-workspace-repo-slug-downloads-error>;

  /// Get a download artifact link
  record get-repositories-workspace-repo-slug-downloads-filename-params {
    /// Name of the file.
    filename: string,
    /// This can either be the repository slug or the UUID of the repository,
    /// surrounded by curly-braces, for example: `{repository UUID}`.
    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-downloads-filename: func(params: get-repositories-workspace-repo-slug-downloads-filename-params) -> result<string, get-repositories-workspace-repo-slug-downloads-filename-error>;

