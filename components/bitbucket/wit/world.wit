/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `oauth2` | `Authorization: Bearer <secret>` |
package autostamp:bitbucket@0.6.0;

interface addon {
  variant put-addon-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant delete-addon-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-addon-linkers-error {
    unauthorized(string),
    other(string)
  }

  variant get-addon-linkers-linker-key-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-addon-linkers-linker-key-values-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant post-addon-linkers-linker-key-values-error {
    unauthorized(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant put-addon-linkers-linker-key-values-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-addon-linkers-linker-key-values-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-addon-linkers-linker-key-values-value-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant delete-addon-linkers-linker-key-values-value-id-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Update an installed app
  put-addon: func() -> result<string, put-addon-error>;

  /// Delete an app
  delete-addon: func() -> result<string, delete-addon-error>;

  /// List linkers for an app
  get-addon-linkers: func() -> result<string, get-addon-linkers-error>;

  /// Get a linker for an app
  record get-addon-linkers-linker-key-params {
    /// The unique key of a [linker module](/cloud/bitbucket/modules/linker/)
    /// as defined in an application descriptor.
    linker-key: string
  }
  get-addon-linkers-linker-key: func(params: get-addon-linkers-linker-key-params) -> result<string, get-addon-linkers-linker-key-error>;

  /// List linker values for a linker
  record get-addon-linkers-linker-key-values-params {
    /// The unique key of a [linker module](/cloud/bitbucket/modules/linker/)
    /// as defined in an application descriptor.
    linker-key: string
  }
  get-addon-linkers-linker-key-values: func(params: get-addon-linkers-linker-key-values-params) -> result<string, get-addon-linkers-linker-key-values-error>;

  /// Create a linker value
  record post-addon-linkers-linker-key-values-params {
    /// The unique key of a [linker module](/cloud/bitbucket/modules/linker/)
    /// as defined in an application descriptor.
    linker-key: string
  }
  post-addon-linkers-linker-key-values: func(params: post-addon-linkers-linker-key-values-params) -> result<string, post-addon-linkers-linker-key-values-error>;

  /// Update a linker value
  record put-addon-linkers-linker-key-values-params {
    /// The unique key of a [linker module](/cloud/bitbucket/modules/linker/)
    /// as defined in an application descriptor.
    linker-key: string
  }
  put-addon-linkers-linker-key-values: func(params: put-addon-linkers-linker-key-values-params) -> result<string, put-addon-linkers-linker-key-values-error>;

  /// Delete all linker values
  record delete-addon-linkers-linker-key-values-params {
    /// The unique key of a [linker module](/cloud/bitbucket/modules/linker/)
    /// as defined in an application descriptor.
    linker-key: string
  }
  delete-addon-linkers-linker-key-values: func(params: delete-addon-linkers-linker-key-values-params) -> result<string, delete-addon-linkers-linker-key-values-error>;

  /// Get a linker value
  record get-addon-linkers-linker-key-values-value-id-params {
    /// The unique key of a [linker module](/cloud/bitbucket/modules/linker/)
    /// as defined in an application descriptor.
    linker-key: string,
    /// The numeric ID of the linker value.
    value-id: string
  }
  get-addon-linkers-linker-key-values-value-id: func(params: get-addon-linkers-linker-key-values-value-id-params) -> result<string, get-addon-linkers-linker-key-values-value-id-error>;

  /// Delete a linker value
  record delete-addon-linkers-linker-key-values-value-id-params {
    /// The unique key of a [linker module](/cloud/bitbucket/modules/linker/)
    /// as defined in an application descriptor.
    linker-key: string,
    /// The numeric ID of the linker value.
    value-id: string
  }
  delete-addon-linkers-linker-key-values-value-id: func(params: delete-addon-linkers-linker-key-values-value-id-params) -> result<string, delete-addon-linkers-linker-key-values-value-id-error>;

}


interface webhooks {
  enum hook-event-event-enum {
    pullrequest-changes-request-removed,
    issue-comment-created,
    repo-push,
    repo-commit-status-updated,
    repo-imported,
    pullrequest-unapproved,
    repo-updated,
    pullrequest-rejected,
    pullrequest-fulfilled,
    pullrequest-created,
    pullrequest-approved,
    repo-transfer,
    repo-commit-status-created,
    repo-fork,
    issue-updated,
    project-updated,
    repo-created,
    issue-created,
    repo-commit-comment-created,
    pullrequest-updated,
    repo-deleted,
    pullrequest-comment-updated,
    pullrequest-changes-request-created,
    pullrequest-comment-deleted,
    pullrequest-comment-created,
  }

  /// The mapping of resource/subject types pointing to their individual event types.
  record subject-types {
    repository: option<subject-types-repository>,
    workspace: option<subject-types-workspace>
  }

  record subject-types-repository {
    /// A link to a resource related to this object.
    events: option<subject-types-repository-events>
  }

  /// A link to a resource related to this object.
  record subject-types-repository-events {
    href: option<string>,
    name: option<string>
  }

  record subject-types-workspace {
    /// A link to a resource related to this object.
    events: option<subject-types-workspace-events>
  }

  /// A link to a resource related to this object.
  record subject-types-workspace-events {
    href: option<string>,
    name: option<string>
  }

  /// A paginated list of webhook types available to subscribe on.
  record paginated-hook-events {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<hook-event>>
  }

  /// An event, associated with a resource or subject type.
  record hook-event {
    /// The category this event belongs to.
    category: option<string>,
    /// More detailed description of the webhook event type.
    description: option<string>,
    /// The event identifier.
    event: option<hook-event-event-enum>,
    /// Summary of the webhook event type.
    label: option<string>
  }

  variant get-hook-events-subject-type-error {
    not-found(string),
    other(string)
  }

  /// Get a webhook resource
  get-hook-events: func() -> result<subject-types, string>;

  /// List subscribable webhook types
  record get-hook-events-subject-type-params {
    /// A resource or subject type.
    subject-type: string
  }
  get-hook-events-subject-type: func(params: get-hook-events-subject-type-params) -> result<paginated-hook-events, get-hook-events-subject-type-error>;

}

interface pullrequests {
  enum get-pullrequests-selected-user-state-enum {
    open,
    merged,
    declined,
    superseded,
  }

  enum pullrequest-endpoint-branch-merge-strategies-item-enum {
    merge-commit,
    squash,
    fast-forward,
  }

  enum repository-fork-policy-enum {
    allow-forks,
    no-public-forks,
    no-forks,
  }

  enum base-commit-summary-markup-enum {
    markdown,
    creole,
    plaintext,
  }

  enum participant-role-enum {
    participant,
    reviewer,
  }

  enum participant-state-enum {
    approved,
    changes-requested,
  }

  enum repository-scm-enum {
    git,
  }

  enum commitstatus-state-enum {
    inprogress,
    successful,
    failed,
    stopped,
  }

  /// A paginated list of pullrequests.
  record paginated-pullrequests {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<pullrequest>>
  }

  record pullrequest {
    type-op: string,
    author: option<account>,
    /// A boolean flag indicating if merging the pull request closes the source branch.
    close-source-branch: option<bool>,
    closed-by: option<account>,
    /// The number of comments for a specific pull request.
    comment-count: option<s32>,
    /// The ISO8601 timestamp the request was created.
    created-on: option<string>,
    destination: option<pullrequest-endpoint>,
    /// The pull request's unique ID. Note that pull request IDs are only unique within their associated repository.
    id: option<s32>,
    links: option<pullrequest-links>,
    merge-commit: option<pullrequest-merge-commit>,
    ///         The list of users that are collaborating on this pull request.
    ///         Collaborators are user that:
    participants: option<list<participant>>,
    /// Explains why a pull request was declined. This field is only applicable to pull requests in rejected state.
    reason: option<string>,
    /// User provided pull request text, interpreted in a markup language and rendered in HTML
    rendered: option<pullrequest-rendered>,
    /// The list of users that were added as reviewers on this pull request when it was created. For performance reasons, the API only includes this list on a pull request's `self` URL.
    reviewers: option<list<account>>,
    source: option<pullrequest-endpoint>,
    /// The pull request's current status.
    state: option<get-pullrequests-selected-user-state-enum>,
    summary: option<pullrequest-summary>,
    /// The number of open tasks for a specific pull request.
    task-count: option<s32>,
    /// Title of the pull request.
    title: option<string>,
    /// The ISO8601 timestamp the request was last updated.
    updated-on: option<string>
  }

  record account {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  /// Links related to an Account.
  record account-links {
    avatar: option<link>
  }

  /// A link to a resource related to this object.
  record link {
    href: option<string>,
    name: option<string>
  }

  record pullrequest-endpoint {
    branch: option<pullrequest-endpoint-branch>,
    commit: option<pullrequest-endpoint-commit>,
    repository: option<repository>
  }

  record pullrequest-endpoint-branch {
    /// The default merge strategy, when this endpoint is the destination of the pull request.
    default-merge-strategy: option<string>,
    /// Available merge strategies, when this endpoint is the destination of the pull request.
    merge-strategies: option<list<pullrequest-endpoint-branch-merge-strategies-item-enum>>,
    name: option<string>
  }

  record pullrequest-endpoint-commit {
    hash: option<string>
  }

  record repository {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Controls the rules for forking this repository.
    fork-policy: option<repository-fork-policy-enum>,
    /// The concatenation of the repository owner's username and the slugified name, e.g. "evzijst/interruptingcow". This is the same string used in Bitbucket URLs.
    full-name: option<string>,
    has-issues: option<bool>,
    has-wiki: option<bool>,
    is-private: option<bool>,
    language: option<string>,
    links: option<repository-links>,
    mainbranch: option<branch>,
    name: option<string>,
    owner: option<account>,
    parent: option<string>,
    project: option<project>,
    scm: option<repository-scm-enum>,
    size: option<s32>,
    updated-on: option<string>,
    /// The repository's immutable id. This can be used as a substitute for the slug segment in URLs. Doing this guarantees your URLs will survive renaming of the repository by its owner, or even transfer of the repository to a different user.
    uuid: option<string>
  }

  record repository-links {
    /// A link to a resource related to this object.
    avatar: option<repository-links-avatar>,
    clone: option<list<repository-links-clone-item>>,
    /// A link to a resource related to this object.
    commits: option<repository-links-commits>,
    /// A link to a resource related to this object.
    downloads: option<repository-links-downloads>,
    /// A link to a resource related to this object.
    forks: option<repository-links-forks>,
    /// A link to a resource related to this object.
    hooks: option<repository-links-hooks>,
    /// A link to a resource related to this object.
    html: option<repository-links-html>,
    /// A link to a resource related to this object.
    pullrequests: option<repository-links-pullrequests>,
    /// A link to a resource related to this object.
    self: option<repository-links-self>,
    /// A link to a resource related to this object.
    watchers: option<repository-links-watchers>
  }

  /// A link to a resource related to this object.
  record repository-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-clone-item {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-downloads {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-forks {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-hooks {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-pullrequests {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-self {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record repository-links-watchers {
    href: option<string>,
    name: option<string>
  }

  record branch {
    links: option<branch-links>,
    /// The name of the ref.
    name: option<string>,
    target: option<commit>,
    type-op: string,
    /// The default merge strategy for pull requests targeting this branch.
    default-merge-strategy: option<string>,
    /// Available merge strategies for pull requests targeting this branch.
    merge-strategies: option<list<pullrequest-endpoint-branch-merge-strategies-item-enum>>
  }

  record branch-links {
    /// A link to a resource related to this object.
    commits: option<branch-links-commits>,
    /// A link to a resource related to this object.
    html: option<branch-links-html>,
    /// A link to a resource related to this object.
    self: option<branch-links-self>
  }

  /// A link to a resource related to this object.
  record branch-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record branch-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record branch-links-self {
    href: option<string>,
    name: option<string>
  }

  record commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<base-commit>>,
    summary: option<commit-summary>,
    participants: option<list<participant>>,
    repository: option<string>
  }

  record author {
    type-op: string,
    /// The raw author value from the repository. This may be the only value available if the author does not match a user in Bitbucket.
    raw: option<string>,
    user: option<account>
  }

  record base-commit {
    type-op: string,
    author: option<author>,
    date: option<string>,
    hash: option<string>,
    message: option<string>,
    parents: option<list<string>>,
    summary: option<base-commit-summary>
  }

  record base-commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record commit-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record participant {
    type-op: string,
    approved: option<bool>,
    /// The ISO8601 timestamp of the participant's action. For approvers, this is the time of their approval. For commenters and pull request reviewers who are not approvers, this is the time they last commented, or null if they have not commented.
    participated-on: option<string>,
    role: option<participant-role-enum>,
    state: option<participant-state-enum>,
    user: option<account>
  }

  record project {
    type-op: string,
    created-on: option<string>,
    description: option<string>,
    /// 
    /// Indicates whether the project contains publicly visible repositories.
    has-publicly-visible-repos: option<bool>,
    /// 
    /// Indicates whether the project is publicly accessible, or whether it is
    is-private: option<bool>,
    /// The project's key.
    key: option<string>,
    links: option<project-links>,
    /// The name of the project.
    name: option<string>,
    owner: option<team>,
    updated-on: option<string>,
    /// The project's immutable id.
    uuid: option<string>
  }

  record project-links {
    /// A link to a resource related to this object.
    avatar: option<project-links-avatar>,
    /// A link to a resource related to this object.
    html: option<project-links-html>
  }

  /// A link to a resource related to this object.
  record project-links-avatar {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record project-links-html {
    href: option<string>,
    name: option<string>
  }

  record team {
    type-op: string,
    created-on: option<string>,
    display-name: option<string>,
    links: option<account-links>,
    username: option<string>,
    uuid: option<string>
  }

  record pullrequest-links {
    /// A link to a resource related to this object.
    activity: option<pullrequest-links-activity>,
    /// A link to a resource related to this object.
    approve: option<pullrequest-links-approve>,
    /// A link to a resource related to this object.
    comments: option<pullrequest-links-comments>,
    /// A link to a resource related to this object.
    commits: option<pullrequest-links-commits>,
    /// A link to a resource related to this object.
    decline: option<pullrequest-links-decline>,
    /// A link to a resource related to this object.
    diff: option<pullrequest-links-diff>,
    /// A link to a resource related to this object.
    diffstat: option<pullrequest-links-diffstat>,
    /// A link to a resource related to this object.
    html: option<pullrequest-links-html>,
    /// A link to a resource related to this object.
    merge: option<pullrequest-links-merge>,
    /// A link to a resource related to this object.
    self: option<pullrequest-links-self>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-activity {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-approve {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-comments {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-commits {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-decline {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-diff {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-diffstat {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-html {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-merge {
    href: option<string>,
    name: option<string>
  }

  /// A link to a resource related to this object.
  record pullrequest-links-self {
    href: option<string>,
    name: option<string>
  }

  record pullrequest-merge-commit {
    hash: option<string>
  }

  /// User provided pull request text, interpreted in a markup language and rendered in HTML
  record pullrequest-rendered {
    description: option<pullrequest-rendered-description>,
    reason: option<pullrequest-rendered-reason>,
    title: option<pullrequest-rendered-title>
  }

  record pullrequest-rendered-description {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record pullrequest-rendered-reason {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record pullrequest-rendered-title {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  record pullrequest-summary {
    /// The user's content rendered as HTML.
    html: option<string>,
    /// The type of markup language the raw content is to be interpreted in.
    markup: option<base-commit-summary-markup-enum>,
    /// The text as it was typed by a user.
    raw: option<string>
  }

  /// A paginated list of accounts.
  record paginated-accounts {
    /// Link to the next page if it exists. The last page of a collection does not have this value. Use this link to navigate the result set and refrain from constructing your own URLs.
    next: option<string>,
    /// Page number of the current results. This is an optional element that is not provided in all responses.
    page: option<s32>,
    /// Current number of objects on the existing page. The default value is 10 with 100 being the maximum allowed value. Individual APIs may enforce different values.
    pagelen: option<s32>,
    /// Link to previous page if it exists. A collections first page does not have this value. This is an optional element that is not provided in all responses. Some result sets strictly support forward navigation and never provide previous links. Clients must anticipate that backwards navigation is not always available. Use this link to navigate the result set and refrain from constructing your own URLs.
    previous: option<string>,
    /// Total number of objects in the response. This is an optional element that is not provided in all responses, as it can be expensive to compute.
    size: option<s32>,
    values: option<list<account>>
  }

