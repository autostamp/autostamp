    repo-slug: string,
    /// This can either be the workspace ID (slug) or the workspace UUID
    /// surrounded by curly-braces, for example: `{workspace UUID}`.
    workspace: string
  }
  get-repositories-workspace-repo-slug-deploy-keys: func(params: get-repositories-workspace-repo-slug-deploy-keys-params) -> result<paginated-deploy-keys, get-repositories-workspace-repo-slug-deploy-keys-error>;

  /// Add a repository deploy key
  record post-repositories-workspace-repo-slug-deploy-keys-params {
    /// This can either be the repository slug or the UUID of the repository,
