/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `HubAuth` | `Authorization: Bearer <secret>` |
package autostamp:docker@0.6.0;

interface discovery {
  enum dataset-type {
    pulls,
  }

  enum timespan-type {
    months,
    weeks,
  }

  enum dataview-type {
    raw,
    summary,
    repo-summary,
  }

  record namespace-data {
    namespaces: option<list<string>>
  }

  record namespace-metadata {
    datasets: option<list<dataset-model>>,
    extra-repos: option<list<string>>,
    namespace: option<string>
  }

  record dataset-model {
    name: option<dataset-type>,
    timespans: option<list<timespan-type>>,
    views: option<list<dataview-type>>
  }

  /// Get namespaces and repos
  get-namespaces: func() -> result<namespace-data, string>;

  /// Get namespace
  record get-namespace-params {
    /// Namespace to fetch data for
    namespace: string
  }
  get-namespace: func(params: get-namespace-params) -> result<namespace-metadata, string>;

}


interface namespaces {
  record year-data {
    years: option<list<year-model>>
  }

  record year-model {
    year: option<s32>
  }

  record response-data {
    data: option<list<response-data-file>>
  }

  record response-data-file {
    size: option<s64>,
    url: option<string>
  }

  variant get-namespace-timespan-metadata-error {
    not-found(string),
    other(string)
  }

  /// Get years with data
  record get-namespace-years-params {
    /// Namespace to fetch data for
    namespace: string
  }
  get-namespace-years: func(params: get-namespace-years-params) -> result<year-data, string>;

  /// Get timespans with data
  record get-namespace-timespans-params {
    /// Namespace to fetch data for
    namespace: string,
    /// Year to fetch data for
    year: string,
    /// Type of timespan to fetch data for
    timespantype: string
  }
  get-namespace-timespans: func(params: get-namespace-timespans-params) -> result<string, string>;

  /// Get namespace metadata for timespan
  record get-namespace-timespan-metadata-params {
    /// Namespace to fetch data for
    namespace: string,
    /// Year to fetch data for
    year: string,
    /// Type of timespan to fetch data for
    timespantype: string,
    /// Timespan to fetch data for
    timespan: string
  }
  get-namespace-timespan-metadata: func(params: get-namespace-timespan-metadata-params) -> result<string, get-namespace-timespan-metadata-error>;

  /// Get namespace data for timespan
  record get-namespace-data-by-timespan-params {
    /// Namespace to fetch data for
    namespace: string,
    /// Year to fetch data for
    year: string,
    /// Type of timespan to fetch data for
    timespantype: string,
    /// Timespan to fetch data for
    timespan: string,
    /// Type of data to fetch
    dataview: string
  }
  get-namespace-data-by-timespan: func(params: get-namespace-data-by-timespan-params) -> result<response-data, string>;

}

interface authentication {
  /// successful user login response
  record post-users-login-success-response {
    /// Created authentication token.
    /// 
    token: option<string>
  }

  variant post-users2-fa-login-error {
    unauthorized(string),
    other(string)
  }

  variant post-users-login-error {
    unauthorized(string),
    other(string)
  }

  /// Second factor authentication.
  record post-users2-fa-login-params {
    /// The Time-based One-Time Password of the Docker Hub account to authenticate with.
    code: string,
    /// The intermediate 2FA token returned from `/v2/users/login` API.
    login-v2fa-token: string
  }
  post-users2-fa-login: func(params: post-users2-fa-login-params) -> result<post-users-login-success-response, post-users2-fa-login-error>;

  /// Create an authentication token
  record post-users-login-params {
    /// The password or personal access token (PAT) of the Docker Hub account to authenticate with.
    password: string,
    /// The username of the Docker Hub account to authenticate with.
    username: string
  }
  post-users-login: func(params: post-users-login-params) -> result<post-users-login-success-response, post-users-login-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export discovery;
  export namespaces;
  export authentication;
}
