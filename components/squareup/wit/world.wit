    /// The object ID of any type of catalog objects to be retrieved.
    object-id: string,
    /// If `true`, the response will include additional objects that are related to the
    /// requested object, as follows:
    include-related-objects: option<bool>,
    /// Requests objects as of a specific version of the catalog. This allows you to retrieve historical
    /// versions of objects. The value to retrieve a specific version of an object can be found
    catalog-version: option<s64>
  }
  retrieve-catalog-object: func(params: retrieve-catalog-object-params) -> result<string, string>;

  /// DeleteCatalogObject
  record delete-catalog-object-params {
    /// The ID of the catalog object to be deleted. When an object is deleted, other
    /// objects in the graph that depend on that object will be deleted as well (for example, deleting a
    object-id: string
  }
  delete-catalog-object: func(params: delete-catalog-object-params) -> result<string, string>;

  /// SearchCatalogObjects
  record search-catalog-objects-params {
    /// Return objects modified after this [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates), in RFC 3339
    /// format, e.g., `2016-09-04T23:59:33.123Z`. The timestamp is exclusive - objects with a
    begin-time: option<string>,
    /// The pagination cursor returned in the previous response. Leave unset for an initial request.
    /// See [Pagination](https://developer.squareup.com/docs/basics/api101/pagination) for more information.
    cursor: option<string>,
    /// If `true`, deleted objects will be included in the results. Deleted objects will have their
    /// `is_deleted` field set to `true`.
    include-deleted-objects: option<bool>,
    /// If `true`, the response will include additional objects that are related to the
    /// requested object, as follows:
    include-related-objects: option<bool>,
    /// A limit on the number of results to be returned in a single page. The limit is advisory -
    /// the implementation may return more or fewer results. If the supplied limit is negative, zero, or
    limit: option<s32>,
    /// The desired set of object types to appear in the search results.
    object-types: option<list<string>>,
    query: option<catalog-query>
  }
  search-catalog-objects: func(params: search-catalog-objects-params) -> result<string, string>;

  /// SearchCatalogItems
  record search-catalog-items-params {
    /// The category id query expression to return items containing the specified category IDs.
    category-ids: option<list<string>>,
    /// The pagination token, returned in the previous response, used to fetch the next batch of pending results.
    cursor: option<string>,
    /// The customer-attribute filter to return items or item variations matching the specified
    /// custom attribute expressions. A maximum number of 10 custom attribute expressions are supported in
    custom-attribute-filters: option<list<custom-attribute-filter>>,
    /// The enabled-location query expression to return items and item variations having specified enabled locations.
    enabled-location-ids: option<list<string>>,
    /// The maximum number of results to return per page. The default value is 100.
    limit: option<s32>,
    /// The product types query expression to return items or item variations having the specified product types.
    product-types: option<list<string>>,
    /// The order to sort the results by item names. The default sort order is ascending (`ASC`).
    sort-order: option<string>,
    /// The stock-level query expression to return item variations with the specified stock levels.
    stock-levels: option<list<string>>,
    /// The text filter expression to return items or item variations containing specified text in
    /// the `name`, `description`, or `abbreviation` attribute value of an item, or in
    text-filter: option<string>
  }
  search-catalog-items: func(params: search-catalog-items-params) -> result<string, string>;

  /// UpdateItemModifierLists
  record update-item-modifier-lists-params {
    /// The IDs of the catalog items associated with the CatalogModifierList objects being updated.
    item-ids: list<string>,
    /// The IDs of the CatalogModifierList objects to disable for the CatalogItem.
    modifier-lists-to-disable: option<list<string>>,
    /// The IDs of the CatalogModifierList objects to enable for the CatalogItem.
    modifier-lists-to-enable: option<list<string>>
  }
  update-item-modifier-lists: func(params: update-item-modifier-lists-params) -> result<string, string>;

  /// UpdateItemTaxes
  record update-item-taxes-params {
    /// IDs for the CatalogItems associated with the CatalogTax objects being updated.
    item-ids: list<string>,
    /// IDs of the CatalogTax objects to disable.
    taxes-to-disable: option<list<string>>,
    /// IDs of the CatalogTax objects to enable.
    taxes-to-enable: option<list<string>>
  }
  update-item-taxes: func(params: update-item-taxes-params) -> result<string, string>;

}

interface customers {
  /// Represents a postal address in a country. The address format is based 
  /// on an [open-source library from Google](https://github.com/google/libaddressinput). For more information, 
  /// see [AddressValidationMetadata](https://github.com/google/libaddressinput/wiki/AddressValidationMetadata). 
  /// This format has dedicated fields for four address components: postal code, 
  /// locality (city), administrative district (state, prefecture, or province), and 
  /// sublocality (town or village). These components have dedicated fields in the 
  /// `Address` object because software sometimes behaves differently based on them. 
  /// For example, sales tax software may charge different amounts of sales tax 
  /// based on the postal code, and some software is only available in 
  /// certain states due to compliance reasons.
  /// 
  /// For the remaining address components, the `Address` type provides the 
  /// `address_line_1` and `address_line_2` fields for free-form data entry. 
  /// These fields are free-form because the remaining address components have 
  /// too many variations around the world and typical software does not parse 
  /// these components. These fields enable users to enter anything they want. 
  /// 
  /// Note that, in the current implementation, all other `Address` type fields are blank. 
  /// These include `address_line_3`, `sublocality_2`, `sublocality_3`, 
  /// `administrative_district_level_2`, `administrative_district_level_3`, 
  /// `first_name`, `last_name`, and `organization`. 
  /// 
  /// When it comes to localization, the seller's language preferences 
  /// (see [Language preferences](https://developer.squareup.com/docs/locations-api#location-specific-and-seller-level-language-preferences)) 
  /// are ignored for addresses. Even though Square products (such as Square Point of Sale 
  /// and the Seller Dashboard) mostly use a seller's language preference in 
  /// communication, when it comes to addresses, they will use English for a US address, 
  /// Japanese for an address in Japan, and so on.
  record address {
    /// The first line of the address.
    /// 
    address-line-v1: option<string>,
    /// The second line of the address, if any.
    address-line-v2: option<string>,
    /// The third line of the address, if any.
    address-line-v3: option<string>,
    /// A civil entity within the address's country. In the US, this
    /// is the state.
    administrative-district-level-v1: option<string>,
    /// A civil entity within the address's `administrative_district_level_1`.
    /// In the US, this is the county.
    administrative-district-level-v2: option<string>,
    /// A civil entity within the address's `administrative_district_level_2`,
    /// if any.
    administrative-district-level-v3: option<string>,
    /// The address's country, in ISO 3166-1-alpha-2 format.
    country: option<string>,
    /// Optional first name when it's representing recipient.
    first-name: option<string>,
    /// Optional last name when it's representing recipient.
    last-name: option<string>,
    /// The city or town of the address.
    locality: option<string>,
    /// Optional organization name when it's representing recipient.
    organization: option<string>,
    /// The address's postal code.
    postal-code: option<string>,
    /// A civil region within the address's `locality`, if any.
    sublocality: option<string>,
    /// A civil region within the address's `sublocality`, if any.
    sublocality-v2: option<string>,
    /// A civil region within the address's `sublocality_2`, if any.
    sublocality-v3: option<string>
  }

  /// Represents a query (including filtering criteria, sorting criteria, or both) used to search
  /// for customer profiles.
  record customer-query {
    filter: option<customer-filter>,
    sort: option<customer-sort>
  }

  /// Represents a set of `CustomerQuery` filters used to limit the set of
  /// customers returned by the [SearchCustomers](https://developer.squareup.com/reference/square_2021-08-18/customers-api/search-customers) endpoint.
  record customer-filter {
    created-at: option<time-range>,
    creation-source: option<customer-creation-source-filter>,
    email-address: option<customer-text-filter>,
    group-ids: option<filter-value>,
    phone-number: option<customer-text-filter>,
    reference-id: option<customer-text-filter>,
    updated-at: option<time-range>
  }

  /// Represents a generic time range. The start and end values are
  /// represented in RFC 3339 format. Time ranges are customized to be
  /// inclusive or exclusive based on the needs of a particular endpoint.
  /// Refer to the relevant endpoint-specific documentation to determine
  /// how time ranges are handled.
  record time-range {
    /// A datetime value in RFC 3339 format indicating when the time range
    /// ends.
    end-at: option<string>,
    /// A datetime value in RFC 3339 format indicating when the time range
    /// starts.
    start-at: option<string>
  }

  /// The creation source filter.
  /// 
  /// If one or more creation sources are set, customer profiles are included in,
  /// or excluded from, the result if they match at least one of the filter criteria.
  record customer-creation-source-filter {
    /// Indicates whether a customer profile matching the filter criteria
    /// should be included in the result or excluded from the result.
    rule: option<string>,
    /// The list of creation sources used as filtering criteria.
    values: option<list<string>>
  }

  /// A filter to select customers based on exact or fuzzy matching of
  /// customer attributes against a specified query. Depending on the customer attributes, 
  /// the filter can be case-sensitive. This filter can be exact or fuzzy, but it cannot be both.
  record customer-text-filter {
    /// Use the exact filter to select customers whose attributes match exactly the specified query.
    exact: option<string>,
    /// Use the fuzzy filter to select customers whose attributes match the specified query 
    /// in a fuzzy manner. When the fuzzy option is used, search queries are tokenized, and then 
    fuzzy: option<string>
  }

  /// A filter to select resources based on an exact field value. For any given
  /// value, the value can only be in one property. Depending on the field, either
  /// all properties can be set or only a subset will be available.
  /// 
  /// Refer to the documentation of the field.
  record filter-value {
    /// A list of terms that must be present on the field of the resource.
    all: option<list<string>>,
    /// A list of terms where at least one of them must be present on the
    /// field of the resource.
    any: option<list<string>>,
    /// A list of terms that must not be present on the field the resource
    none: option<list<string>>
  }

  /// Specifies how searched customers profiles are sorted, including the sort key and sort order.
  record customer-sort {
    /// Use one or more customer attributes as the sort key to sort searched customer profiles. 
    /// For example, use the creation date (`created_at`) of customers or default attributes as the sort key.
    field: option<string>,
    /// Indicates the order in which results should be sorted based on the
    /// sort field value. Strings use standard alphabetic comparison
    order: option<string>
  }

  /// ListCustomers
  record list-customers-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// The maximum number of results to return in a single page. This limit is advisory. The response might contain more or fewer results. 
    /// The limit is ignored if it is less than 1 or greater than 100. The default value is 100.
    limit: option<s32>,
    /// Indicates how customers should be sorted.
    /// 
    sort-field: option<string>,
    /// Indicates whether customers should be sorted in ascending (`ASC`) or
    /// descending (`DESC`) order.
    sort-order: option<string>
  }
  list-customers: func(params: list-customers-params) -> result<string, string>;

  /// CreateCustomer
  record create-customer-params {
    address: option<address>,
    /// The birthday associated with the customer profile, in RFC 3339 format. The year is optional. The timezone and time are not allowed.
    /// For example, `0000-09-21T00:00:00-00:00` represents a birthday on September 21 and `1998-09-21T00:00:00-00:00` represents a birthday on September 21, 1998.
    birthday: option<string>,
    /// A business name associated with the customer profile.
    company-name: option<string>,
    /// The email address associated with the customer profile.
    email-address: option<string>,
    /// The family name (that is, the last name) associated with the customer profile.
    family-name: option<string>,
    /// The given name (that is, the first name) associated with the customer profile.
    given-name: option<string>,
    /// The idempotency key for the request.	For more information, see
    /// [Idempotency](https://developer.squareup.com/docs/working-with-apis/idempotency).
    idempotency-key: option<string>,
    /// A nickname for the customer profile.
    nickname: option<string>,
    /// A custom note associated with the customer profile.
    note: option<string>,
    /// The 11-digit phone number associated with the customer profile.
    phone-number: option<string>,
    /// An optional second ID used to associate the customer profile with an
    /// entity in another system.
    reference-id: option<string>
  }
  create-customer: func(params: create-customer-params) -> result<string, string>;

  /// SearchCustomers
  record search-customers-params {
    /// Include the pagination cursor in subsequent calls to this endpoint to retrieve
    /// the next set of results associated with the original query.
    cursor: option<string>,
    /// The maximum number of results to return in a single page. This limit is advisory. The response might contain more or fewer results. 
    /// The limit is ignored if it is less than the minimum or greater than the maximum value. The default value is 100.
    limit: option<s64>,
    query: option<customer-query>
  }
  search-customers: func(params: search-customers-params) -> result<string, string>;

  /// RetrieveCustomer
  record retrieve-customer-params {
    /// The ID of the customer to retrieve.
    customer-id: string
  }
  retrieve-customer: func(params: retrieve-customer-params) -> result<string, string>;

  /// UpdateCustomer
  record update-customer-params {
    /// The ID of the customer to update.
    customer-id: string,
    address: option<address>,
    /// The birthday associated with the customer profile, in RFC 3339 format. The year is optional. The timezone and time are not allowed.
    /// For example, `0000-09-21T00:00:00-00:00` represents a birthday on September 21 and `1998-09-21T00:00:00-00:00` represents a birthday on September 21, 1998.
    birthday: option<string>,
    /// A business name associated with the customer profile.
    company-name: option<string>,
    /// The email address associated with the customer profile.
    email-address: option<string>,
    /// The family name (that is, the last name) associated with the customer profile.
    family-name: option<string>,
    /// The given name (that is, the first name) associated with the customer profile.
    given-name: option<string>,
    /// A nickname for the customer profile.
    nickname: option<string>,
    /// A custom note associated with the customer profile.
    note: option<string>,
    /// The 11-digit phone number associated with the customer profile.
    phone-number: option<string>,
    /// An optional second ID used to associate the customer profile with an
    /// entity in another system.
    reference-id: option<string>,
    /// The current version of the customer profile.
    /// 
    version: option<s64>
  }
  update-customer: func(params: update-customer-params) -> result<string, string>;

  /// DeleteCustomer
  record delete-customer-params {
    /// The ID of the customer to delete.
    customer-id: string,
    /// The current version of the customer profile.
    /// 
    version: option<s64>
  }
  delete-customer: func(params: delete-customer-params) -> result<string, string>;

  /// CreateCustomerCard
  record create-customer-card-params {
    /// The Square ID of the customer profile the card is linked to.
    customer-id: string,
    billing-address: option<address>,
    /// A card nonce representing the credit card to link to the customer.
    /// 
    card-nonce: string,
    /// The full name printed on the credit card.
    cardholder-name: option<string>,
    /// An identifying token generated by [Payments.verifyBuyer()](https://developer.squareup.com/reference/sdks/web/payments/objects/Payments#Payments.verifyBuyer).
    /// Verification tokens encapsulate customer device information and 3-D Secure
    verification-token: option<string>
  }
  create-customer-card: func(params: create-customer-card-params) -> result<string, string>;

  /// DeleteCustomerCard
  record delete-customer-card-params {
    /// The ID of the customer that the card on file belongs to.
    customer-id: string,
    /// The ID of the card on file to delete.
    card-id: string
  }
  delete-customer-card: func(params: delete-customer-card-params) -> result<string, string>;

  /// AddGroupToCustomer
  record add-group-to-customer-params {
    /// The ID of the customer to add to a group.
    customer-id: string,
    /// The ID of the customer group to add the customer to.
    group-id: string
  }
  add-group-to-customer: func(params: add-group-to-customer-params) -> result<string, string>;

  /// RemoveGroupFromCustomer
  record remove-group-from-customer-params {
    /// The ID of the customer to remove from the group.
    customer-id: string,
    /// The ID of the customer group to remove the customer from.
    group-id: string
  }
  remove-group-from-customer: func(params: remove-group-from-customer-params) -> result<string, string>;

}

interface customer-groups {
  /// Represents a group of customer profiles. 
  /// 
  /// Customer groups can be created, be modified, and have their membership defined using 
  /// the Customers API or within the Customer Directory in the Square Seller Dashboard or Point of Sale.
  record customer-group {
    /// The timestamp when the customer group was created, in RFC 3339 format.
    created-at: option<string>,
    /// A unique Square-generated ID for the customer group.
    id: option<string>,
    /// The name of the customer group.
    name: string,
    /// The timestamp when the customer group was last updated, in RFC 3339 format.
    updated-at: option<string>
  }

  /// ListCustomerGroups
  record list-customer-groups-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// The maximum number of results to return in a single page. This limit is advisory. The response might contain more or fewer results. 
    /// The limit is ignored if it is less than 1 or greater than 50. The default value is 50.
    limit: option<s32>
  }
  list-customer-groups: func(params: list-customer-groups-params) -> result<string, string>;

  /// CreateCustomerGroup
  record create-customer-group-params {
    group: customer-group,
    /// The idempotency key for the request. For more information, see [Idempotency](https://developer.squareup.com/docs/basics/api101/idempotency).
    idempotency-key: option<string>
  }
  create-customer-group: func(params: create-customer-group-params) -> result<string, string>;

  /// RetrieveCustomerGroup
  record retrieve-customer-group-params {
    /// The ID of the customer group to retrieve.
    group-id: string
  }
  retrieve-customer-group: func(params: retrieve-customer-group-params) -> result<string, string>;

  /// UpdateCustomerGroup
  record update-customer-group-params {
    /// The ID of the customer group to update.
    group-id: string,
    group: customer-group
  }
  update-customer-group: func(params: update-customer-group-params) -> result<string, string>;

  /// DeleteCustomerGroup
  record delete-customer-group-params {
    /// The ID of the customer group to delete.
    group-id: string
  }
  delete-customer-group: func(params: delete-customer-group-params) -> result<string, string>;

}

interface customer-segments {
  /// ListCustomerSegments
  record list-customer-segments-params {
    /// A pagination cursor returned by previous calls to `ListCustomerSegments`.
    /// This cursor is used to retrieve the next set of query results.
    cursor: option<string>,
    /// The maximum number of results to return in a single page. This limit is advisory. The response might contain more or fewer results. 
    /// The limit is ignored if it is less than 1 or greater than 50. The default value is 50.
    limit: option<s32>
  }
  list-customer-segments: func(params: list-customer-segments-params) -> result<string, string>;

  /// RetrieveCustomerSegment
  record retrieve-customer-segment-params {
    /// The Square-issued ID of the customer segment.
    segment-id: string
  }
  retrieve-customer-segment: func(params: retrieve-customer-segment-params) -> result<string, string>;

}

interface devices {
  record device-code {
    /// The unique code that can be used to login.
    code: option<string>,
    /// When this DeviceCode was created. Timestamp in RFC 3339 format.
    created-at: option<string>,
    /// The unique id of the device that used this code. Populated when the device is paired up.
    device-id: option<string>,
    /// The unique id for this device code.
    id: option<string>,
    /// The location assigned to this code.
    location-id: option<string>,
    /// An optional user-defined name for the device code.
    name: option<string>,
    /// When this DeviceCode will expire and no longer login. Timestamp in RFC 3339 format.
    pair-by: option<string>,
    /// When this DeviceCode was paired. Timestamp in RFC 3339 format.
    paired-at: option<string>,
    /// The targeting product type of the device code.
    product-type: string,
    /// The pairing status of the device code.
    status: option<string>,
    /// When this DeviceCode's status was last changed. Timestamp in RFC 3339 format.
    status-changed-at: option<string>
  }

  /// ListDeviceCodes
  record list-device-codes-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// If specified, only returns DeviceCodes of the specified location.
    /// Returns DeviceCodes of all locations if empty.
    location-id: option<string>,
    /// If specified, only returns DeviceCodes targeting the specified product type.
    /// Returns DeviceCodes of all product types if empty.
    product-type: option<string>,
    /// If specified, returns DeviceCodes with the specified statuses.
    /// Returns DeviceCodes of status `PAIRED` and `UNPAIRED` if empty.
    status: option<string>
  }
  list-device-codes: func(params: list-device-codes-params) -> result<string, string>;

  /// CreateDeviceCode
  record create-device-code-params {
    device-code: device-code,
    /// A unique string that identifies this CreateDeviceCode request. Keys can
    /// be any valid string but must be unique for every CreateDeviceCode request.
    idempotency-key: string
  }
  create-device-code: func(params: create-device-code-params) -> result<string, string>;

  /// GetDeviceCode
  record get-device-code-params {
    /// The unique identifier for the device code.
    id: string
  }
  get-device-code: func(params: get-device-code-params) -> result<string, string>;

}

interface disputes {
  /// ListDisputes
  record list-disputes-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The dispute states to filter the result.
    /// If not specified, the endpoint returns all open disputes (the dispute status is not `INQUIRY_CLOSED`, `WON`,
    states: option<string>,
    /// The ID of the location for which to return a list of disputes. If not specified, the endpoint returns
    /// all open disputes (the dispute status is not `INQUIRY_CLOSED`, `WON`, or `LOST`) associated with all locations.
    location-id: option<string>
  }
  list-disputes: func(params: list-disputes-params) -> result<string, string>;

  /// RetrieveDispute
  record retrieve-dispute-params {
    /// The ID of the dispute you want more details about.
    dispute-id: string
  }
  retrieve-dispute: func(params: retrieve-dispute-params) -> result<string, string>;

  /// AcceptDispute
  record accept-dispute-params {
    /// The ID of the dispute you want to accept.
    dispute-id: string
  }
  accept-dispute: func(params: accept-dispute-params) -> result<string, string>;

  /// ListDisputeEvidence
  record list-dispute-evidence-params {
    /// The ID of the dispute.
    dispute-id: string,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>
  }
  list-dispute-evidence: func(params: list-dispute-evidence-params) -> result<string, string>;

  /// CreateDisputeEvidenceText
  record create-dispute-evidence-text-params {
    /// The ID of the dispute you want to upload evidence for.
    dispute-id: string,
    /// The evidence string.
    evidence-text: string,
    /// The type of evidence you are uploading.
    evidence-type: option<string>,
    /// The Unique ID. For more information, see [Idempotency](https://developer.squareup.com/docs/working-with-apis/idempotency).
    idempotency-key: string
  }
  create-dispute-evidence-text: func(params: create-dispute-evidence-text-params) -> result<string, string>;

  /// RetrieveDisputeEvidence
  record retrieve-dispute-evidence-params {
    /// The ID of the dispute that you want to retrieve evidence from.
    dispute-id: string,
    /// The ID of the evidence to retrieve.
    evidence-id: string
  }
  retrieve-dispute-evidence: func(params: retrieve-dispute-evidence-params) -> result<string, string>;

  /// DeleteDisputeEvidence
  record delete-dispute-evidence-params {
    /// The ID of the dispute you want to remove evidence from.
    dispute-id: string,
    /// The ID of the evidence you want to remove.
    evidence-id: string
  }
  delete-dispute-evidence: func(params: delete-dispute-evidence-params) -> result<string, string>;

  /// SubmitEvidence
  record submit-evidence-params {
    /// The ID of the dispute that you want to submit evidence for.
    dispute-id: string
  }
  submit-evidence: func(params: submit-evidence-params) -> result<string, string>;

}

interface employees {
  /// ListEmployees
  record get-v2-employees-params {
    location-id: option<string>,
    /// Specifies the EmployeeStatus to filter the employee by.
    status: option<string>,
    /// The number of employees to be returned on each page.
    limit: option<s32>,
    /// The token required to retrieve the specified page of results.
    cursor: option<string>
  }
  get-v2-employees: func(params: get-v2-employees-params) -> result<string, string>;

  /// RetrieveEmployee
  record get-v2-employees-id-params {
    /// UUID for the employee that was requested.
    id: string
  }
  get-v2-employees-id: func(params: get-v2-employees-id-params) -> result<string, string>;

}

interface gift-cards {
  /// Represents a Square gift card.
  record gift-card {
    balance-money: option<money>,
    /// The timestamp when the gift card was created, in RFC 3339 format. 
    /// In the case of a digital gift card, it is the time when you create a card 
    created-at: option<string>,
    /// The IDs of the customers to whom this gift card is linked.
    customer-ids: option<list<string>>,
    /// The gift card account number.
    gan: option<string>,
    gan-source: option<gan-source>,
    /// The Square-assigned ID of the gift card.
    id: option<string>,
    state: option<status>,
    type-op: type-op
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  record gan-source {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record status {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record type-op {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// ListGiftCards
  record list-gift-cards-params {
    /// If a type is provided, gift cards of this type are returned 
    /// (see [GiftCardType](https://developer.squareup.com/reference/square_2021-08-18/enums/GiftCardType)).
    type-op: option<string>,
    /// If the state is provided, it returns the gift cards in the specified state 
    /// (see [GiftCardStatus](https://developer.squareup.com/reference/square_2021-08-18/enums/GiftCardStatus)).
    state: option<string>,
    /// If a value is provided, it returns only that number of results per page.
    /// The maximum number of results allowed per page is 50. The default value is 30.
    limit: option<s32>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// If a value is provided, returns only the gift cards linked to the specified customer
    customer-id: option<string>
  }
  list-gift-cards: func(params: list-gift-cards-params) -> result<string, string>;

  /// CreateGiftCard
  record create-gift-card-params {
    gift-card: gift-card,
    /// A unique string that identifies the `CreateGiftCard` request.
    idempotency-key: string,
    /// The location ID where the gift card that will be created should be registered.
    location-id: string
  }
  create-gift-card: func(params: create-gift-card-params) -> result<string, string>;

  /// RetrieveGiftCardFromGAN
  record retrieve-gift-card-from-gan-params {
    /// The gift card account number (GAN) of the gift card to retrieve.
    /// The maximum length of a GAN is 255 digits to account for third-party GANs that have been imported.
    gan: string
  }
  retrieve-gift-card-from-gan: func(params: retrieve-gift-card-from-gan-params) -> result<string, string>;

  /// RetrieveGiftCardFromNonce
  record retrieve-gift-card-from-nonce-params {
    /// The nonce of the gift card to retrieve.
    nonce: string
  }
  retrieve-gift-card-from-nonce: func(params: retrieve-gift-card-from-nonce-params) -> result<string, string>;

  /// LinkCustomerToGiftCard
  record link-customer-to-gift-card-params {
    /// The ID of the gift card to link.
    gift-card-id: string,
    /// The ID of the customer to be linked.
    customer-id: string
  }
  link-customer-to-gift-card: func(params: link-customer-to-gift-card-params) -> result<string, string>;

  /// UnlinkCustomerFromGiftCard
  record unlink-customer-from-gift-card-params {
    gift-card-id: string,
    customer-id: string
  }
  unlink-customer-from-gift-card: func(params: unlink-customer-from-gift-card-params) -> result<string, string>;

  /// RetrieveGiftCard
  record retrieve-gift-card-params {
    /// The ID of the gift card to retrieve.
    id: string
  }
  retrieve-gift-card: func(params: retrieve-gift-card-params) -> result<string, string>;

}

interface gift-card-activities {
  /// Represents an action performed on a gift card that affects its state or balance.
  record gift-card-activity {
    activate-activity-details: option<gift-card-activity-activate>,
    adjust-decrement-activity-details: option<gift-card-activity-adjust-decrement>,
    adjust-increment-activity-details: option<gift-card-activity-adjust-increment>,
    block-activity-details: option<gift-card-activity-block>,
    clear-balance-activity-details: option<gift-card-activity-clear-balance>,
    /// The timestamp when the gift card activity was created, in RFC 3339 format.
    created-at: option<string>,
    deactivate-activity-details: option<gift-card-activity-deactivate>,
    gift-card-balance-money: option<money>,
    /// The gift card GAN. The GAN is not required if `gift_card_id` is present.
    gift-card-gan: option<string>,
    /// The gift card ID. The ID is not required if a GAN is present.
    gift-card-id: option<string>,
    /// The unique ID of the gift card activity.
    id: option<string>,
    import-activity-details: option<gift-card-activity-import>,
    import-reversal-activity-details: option<gift-card-activity-import-reversal>,
    load-activity-details: option<gift-card-activity-load>,
    /// The ID of the location at which the activity occurred.
    location-id: string,
    redeem-activity-details: option<gift-card-activity-redeem>,
    refund-activity-details: option<gift-card-activity-refund>,
    type-op: type-op,
    unblock-activity-details: option<gift-card-activity-unblock>,
    unlinked-activity-refund-activity-details: option<gift-card-activity-unlinked-activity-refund>
  }

  /// Describes a gift card activity of the ACTIVATE type.
  record gift-card-activity-activate {
    amount-money: option<money>,
    /// Required if your application does not use the Square Orders API. 
    /// This is a list of client-provided payment instrument IDs. 
    buyer-payment-instrument-ids: option<list<string>>,
    /// The `line_item_uid` of the gift card line item in an order. 
    /// This is required if your application uses the Square Orders API.
    line-item-uid: option<string>,
    /// The ID of the order associated with the activity. 
    /// This is required if your application uses the Square Orders API.
    order-id: option<string>,
    /// If your application does not use the Square Orders API, you can optionally use this field 
    /// to associate the gift card activity with a client-side entity.
    reference-id: option<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Describes a gift card activity of the ADJUST_DECREMENT type.
  record gift-card-activity-adjust-decrement {
    amount-money: money,
    reason: reason
  }

  record reason {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Describes a gift card activity of the ADJUST_INCREMENT type.
  record gift-card-activity-adjust-increment {
    amount-money: money,
    reason: reason
  }

  /// Describes a gift card activity of the BLOCK type.
  record gift-card-activity-block {
    reason: reason
  }

  /// Describes a gift card activity of the CLEAR_BALANCE type.
  record gift-card-activity-clear-balance {
    reason: reason
  }

  /// Describes a gift card activity of the DEACTIVATE type.
  record gift-card-activity-deactivate {
    reason: reason
  }

  /// Describes a gift card activity of the IMPORT type and the `GiftCardGANSource` is OTHER 
  /// (a third-party gift card).
  record gift-card-activity-import {
    amount-money: money
  }

  /// Present only when GiftCardActivityType is IMPORT_REVERSAL and GiftCardGANSource is OTHER
  record gift-card-activity-import-reversal {
    amount-money: money
  }

  /// Present only when `GiftCardActivityType` is LOAD.
  record gift-card-activity-load {
    amount-money: option<money>,
    /// If you are not using the Orders API, this field is required because it is used to identify a buyer 
    /// to perform compliance checks.
    buyer-payment-instrument-ids: option<list<string>>,
    /// The `line_item_uid` of the gift card’s line item in the order associated with the activity.
    /// It is populated along with `order_id` and is required if using the Square Orders API.
    line-item-uid: option<string>,
    /// The `order_id` of the order associated with the activity.
    /// It is populated along with `line_item_uid` and is required if using the Square Orders API.
    order-id: option<string>,
    /// A client-specified ID to associate an entity, in another system, with this gift card
    /// activity. This can be used to track the order or payment related information when the Square Orders
    reference-id: option<string>
  }

  /// Present only when `GiftCardActivityType` is REDEEM.
  record gift-card-activity-redeem {
    amount-money: money,
    /// When the Square Payments API is used, Redeem is not called on the Gift Cards API.
    /// However, when Square reads a Redeem activity from the Gift Cards API, developers need to know the
    payment-id: option<string>,
    /// A client-specified ID to associate an entity, in another system, with this gift card
    /// activity. This can be used to track the order or payment related information when the Square Orders
    reference-id: option<string>
  }

  /// Present only when `GiftCardActivityType` is REFUND.
  record gift-card-activity-refund {
    amount-money: option<money>,
    /// When the Square Payments API is used, Refund is not called on the Gift Cards API.
    /// However, when Square reads a Refund activity from the Gift Cards API, the developer needs to know the
    payment-id: option<string>,
    /// The ID for the Redeem activity that needs to be refunded. Hence, the activity it
    /// refers to has to be of the REDEEM type.
    redeem-activity-id: string,
    /// A client-specified ID to associate an entity, in another system, with this gift card
    /// activity. This can be used to track the order or payment related information when the Square Orders
    reference-id: option<string>
  }

  record type-op {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Present only when `GiftCardActivityType` is UNBLOCK.
  record gift-card-activity-unblock {
    reason: reason
  }

  /// Present only when `GiftCardActivityType` is UNLINKED_ACTIVITY_REFUND.
  record gift-card-activity-unlinked-activity-refund {
    amount-money: money,
    /// When using the Square Payments API, the ID of the payment that was refunded to this gift
    /// card.
    payment-id: option<string>,
    /// A client-specified ID to associate an entity, in another system, with this gift card
    /// activity. This can be used to track the order or payment related information when the Square Payments
    reference-id: option<string>
  }

  /// ListGiftCardActivities
  record list-gift-card-activities-params {
    /// If you provide a gift card ID, the endpoint returns activities that belong 
    /// to the specified gift card. Otherwise, the endpoint returns all gift card activities for 
    gift-card-id: option<string>,
    /// If you provide a type, the endpoint returns gift card activities of this type. 
    /// Otherwise, the endpoint returns all types of gift card activities.
    type-op: option<string>,
    /// If you provide a location ID, the endpoint returns gift card activities for that location. 
    /// Otherwise, the endpoint returns gift card activities for all locations.
    location-id: option<string>,
    /// The timestamp for the beginning of the reporting period, in RFC 3339 format.
    /// Inclusive. Default: The current time minus one year.
    begin-time: option<string>,
    /// The timestamp for the end of the reporting period, in RFC 3339 format.
    /// Inclusive. Default: The current time.
    end-time: option<string>,
    /// If you provide a limit value, the endpoint returns the specified number 
    /// of results (or less) per page. A maximum value is 100. The default value is 50.
    limit: option<s32>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The order in which the endpoint returns the activities, based on `created_at`.
    /// - `ASC` - Oldest to newest.
    sort-order: option<string>
  }
  list-gift-card-activities: func(params: list-gift-card-activities-params) -> result<string, string>;

  /// CreateGiftCardActivity
  record create-gift-card-activity-params {
    gift-card-activity: gift-card-activity,
    /// A unique string that identifies the `CreateGiftCardActivity` request.
    idempotency-key: string
  }
  create-gift-card-activity: func(params: create-gift-card-activity-params) -> result<string, string>;

}

interface inventory {
  /// Represents a single physical count, inventory, adjustment, or transfer
  /// that is part of the history of inventory changes for a particular
  /// [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) instance.
  record inventory-change {
    adjustment: option<inventory-adjustment>,
    measurement-unit: option<catalog-measurement-unit>,
    /// The ID of the [CatalogMeasurementUnit](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogMeasurementUnit) object representing the catalog measurement unit associated with the inventory change.
    measurement-unit-id: option<string>,
    physical-count: option<inventory-physical-count>,
    transfer: option<inventory-transfer>,
    /// Indicates how the inventory change is applied. See
    /// [InventoryChangeType](https://developer.squareup.com/reference/square_2021-08-18/enums/InventoryChangeType) for all possible values.
    type-op: option<string>
  }

  /// Represents a change in state or quantity of product inventory at a
  /// particular time and location.
  record inventory-adjustment {
    adjustment-group: option<inventory-adjustment-group>,
    /// The Square-generated ID of the
    /// [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) being tracked.
    catalog-object-id: option<string>,
    /// The [type](https://developer.squareup.com/reference/square_2021-08-18/enums/CatalogObjectType) of the
    /// [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) being tracked. Tracking is only
    catalog-object-type: option<string>,
    /// An RFC 3339-formatted timestamp that indicates when the inventory adjustment is received.
    created-at: option<string>,
    /// The Square-generated ID of the [Employee](https://developer.squareup.com/reference/square_2021-08-18/objects/Employee) responsible for the
    /// inventory adjustment.
    employee-id: option<string>,
    /// The [inventory state](https://developer.squareup.com/reference/square_2021-08-18/enums/InventoryState) of the related quantity
    /// of items before the adjustment.
    from-state: option<string>,
    /// The Square-generated ID of the goods receipt that caused the
    /// adjustment. Only relevant for state transitions from the Square for Retail
    goods-receipt-id: option<string>,
    /// A unique ID generated by Square for the
    /// `InventoryAdjustment`.
    id: option<string>,
    /// The Square-generated ID of the [Location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) where the related
    /// quantity of items is being tracked.
    location-id: option<string>,
    /// A client-generated RFC 3339-formatted timestamp that indicates when
    /// the inventory adjustment took place. For inventory adjustment updates, the `occurred_at`
    occurred-at: option<string>,
    /// The Square-generated ID of the purchase order that caused the
    /// adjustment. Only relevant for state transitions from the Square for Retail
    purchase-order-id: option<string>,
    /// The number of items affected by the adjustment as a decimal string.
    /// Can support up to 5 digits after the decimal point.
    quantity: option<string>,
    /// An optional ID provided by the application to tie the
    /// `InventoryAdjustment` to an external
    reference-id: option<string>,
    /// The Square-generated ID of the [Refund][#type-refund] that
    /// caused the adjustment. Only relevant for refund-related state
    refund-id: option<string>,
    source: option<source-application>,
    /// The [inventory state](https://developer.squareup.com/reference/square_2021-08-18/enums/InventoryState) of the related quantity
    /// of items after the adjustment.
    to-state: option<string>,
    total-price-money: option<money>,
    /// The Square-generated ID of the [Transaction][#type-transaction] that
    /// caused the adjustment. Only relevant for payment-related state
    transaction-id: option<string>
  }

  record inventory-adjustment-group {
    /// Representative `from_state` for adjustments within the group. For example, for a group adjustment from `IN_STOCK` to `SOLD`,
    /// there can be two component adjustments in the group: one from `IN_STOCK`to `COMPOSED` and the other one from `COMPOSED` to `SOLD`.
    from-state: option<string>,
    /// A unique ID generated by Square for the
    /// `InventoryAdjustmentGroup`.
    id: option<string>,
    /// The inventory adjustment of the composed variation.
    root-adjustment-id: option<string>,
    /// Representative `to_state` for adjustments within group. For example, for a group adjustment from `IN_STOCK` to `SOLD`,
    /// the two component adjustments in the group can be from `IN_STOCK` to `COMPOSED` and from `COMPOSED` to `SOLD`. 
    to-state: option<string>
  }

  /// Provides information about the application used to generate a change.
  record source-application {
    /// Read-only Square ID assigned to the application. Only used for
    /// [Product](https://developer.squareup.com/reference/square_2021-08-18/enums/Product) type `EXTERNAL_API`.
    application-id: option<string>,
    /// Read-only display name assigned to the application
    /// (e.g. `"Custom Application"`, `"Square POS 4.74 for Android"`).
    name: option<string>,
    /// Read-only [Product](https://developer.squareup.com/reference/square_2021-08-18/enums/Product) type for the application.
    product: option<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Represents the unit used to measure a `CatalogItemVariation` and
  /// specifies the precision for decimal quantities.
  record catalog-measurement-unit {
    measurement-unit: option<measurement-unit>,
    /// An integer between 0 and 5 that represents the maximum number of
    /// positions allowed after the decimal in quantities measured with this unit.
    precision: option<s32>
  }

  /// Represents a unit of measurement to use with a quantity, such as ounces
  /// or inches. Exactly one of the following fields are required: `custom_unit`,
  /// `area_unit`, `length_unit`, `volume_unit`, and `weight_unit`.
  record measurement-unit {
    /// Represents a standard area unit.
    area-unit: option<string>,
    custom-unit: option<measurement-unit-custom>,
    /// Reserved for API integrations that lack the ability to specify a real measurement unit
    generic-unit: option<string>,
    /// Represents a standard length unit.
    length-unit: option<string>,
    /// Represents a standard unit of time.
    time-unit: option<string>,
    /// Represents the type of the measurement unit.
    type-op: option<string>,
    /// Represents a standard volume unit.
    volume-unit: option<string>,
    /// Represents a standard unit of weight or mass.
    weight-unit: option<string>
  }

  /// The information needed to define a custom unit, provided by the seller.
  record measurement-unit-custom {
    /// The abbreviation of the custom unit, such as "bsh" (bushel). This appears
    /// in the cart for the Point of Sale app, and in reports.
    abbreviation: string,
    /// The name of the custom unit, for example "bushel".
    name: string
  }

  /// Represents the quantity of an item variation that is physically present
  /// at a specific location, verified by a seller or a seller's employee. For example,
  /// a physical count might come from an employee counting the item variations on
  /// hand or from syncing with an external system.
  record inventory-physical-count {
    /// The Square-generated ID of the
    /// [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) being tracked.
    catalog-object-id: option<string>,
    /// The [type](https://developer.squareup.com/reference/square_2021-08-18/enums/CatalogObjectType) of the
    /// [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) being tracked. Tracking is only
    catalog-object-type: option<string>,
    /// An RFC 3339-formatted timestamp that indicates when the physical count is received.
    created-at: option<string>,
    /// The Square-generated ID of the [Employee](https://developer.squareup.com/reference/square_2021-08-18/objects/Employee) responsible for the
    /// physical count.
    employee-id: option<string>,
    /// A unique Square-generated ID for the
    /// [InventoryPhysicalCount](https://developer.squareup.com/reference/square_2021-08-18/objects/InventoryPhysicalCount).
    id: option<string>,
    /// The Square-generated ID of the [Location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) where the related
    /// quantity of items is being tracked.
    location-id: option<string>,
    /// A client-generated RFC 3339-formatted timestamp that indicates when
    /// the physical count was examined. For physical count updates, the `occurred_at`
    occurred-at: option<string>,
    /// The number of items affected by the physical count as a decimal string.
    /// The number can support up to 5 digits after the decimal point.
    quantity: option<string>,
    /// An optional ID provided by the application to tie the
    /// [InventoryPhysicalCount](https://developer.squareup.com/reference/square_2021-08-18/objects/InventoryPhysicalCount) to an external
    reference-id: option<string>,
    source: option<source-application>,
    /// The current [inventory state](https://developer.squareup.com/reference/square_2021-08-18/enums/InventoryState) for the related
    /// quantity of items.
    state: option<string>
  }

  /// Represents the transfer of a quantity of product inventory at a
  /// particular time from one location to another.
  record inventory-transfer {
    /// The Square-generated ID of the
    /// [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) being tracked.
    catalog-object-id: option<string>,
    /// The [type](https://developer.squareup.com/reference/square_2021-08-18/enums/CatalogObjectType) of the
    /// [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) being tracked.Tracking is only
    catalog-object-type: option<string>,
    /// An RFC 3339-formatted timestamp that indicates when Square
    /// received the transfer request.
    created-at: option<string>,
    /// The Square-generated ID of the [Employee](https://developer.squareup.com/reference/square_2021-08-18/objects/Employee) responsible for the
    /// inventory transfer.
    employee-id: option<string>,
    /// The Square-generated ID of the [Location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) where the related
    /// quantity of items was tracked before the transfer.
    from-location-id: option<string>,
    /// A unique ID generated by Square for the
    /// `InventoryTransfer`.
    id: option<string>,
    /// A client-generated RFC 3339-formatted timestamp that indicates when
    /// the transfer took place. For write actions, the `occurred_at` timestamp
    occurred-at: option<string>,
    /// The number of items affected by the transfer as a decimal string.
    /// Can support up to 5 digits after the decimal point.
    quantity: option<string>,
    /// An optional ID provided by the application to tie the
    /// `InventoryTransfer` to an external system.
    reference-id: option<string>,
    source: option<source-application>,
    /// The [inventory state](https://developer.squareup.com/reference/square_2021-08-18/enums/InventoryState) for the quantity of
    /// items being transferred.
    state: option<string>,
    /// The Square-generated ID of the [Location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) where the related
    /// quantity of items was tracked after the transfer.
    to-location-id: option<string>
  }

  /// DeprecatedRetrieveInventoryAdjustment
  record deprecated-retrieve-inventory-adjustment-params {
    /// ID of the [InventoryAdjustment](https://developer.squareup.com/reference/square_2021-08-18/objects/InventoryAdjustment) to retrieve.
    adjustment-id: string
  }
  deprecated-retrieve-inventory-adjustment: func(params: deprecated-retrieve-inventory-adjustment-params) -> result<string, string>;

  /// RetrieveInventoryAdjustment
  record retrieve-inventory-adjustment-params {
    /// ID of the [InventoryAdjustment](https://developer.squareup.com/reference/square_2021-08-18/objects/InventoryAdjustment) to retrieve.
    adjustment-id: string
  }
  retrieve-inventory-adjustment: func(params: retrieve-inventory-adjustment-params) -> result<string, string>;

  /// DeprecatedBatchChangeInventory
  record deprecated-batch-change-inventory-params {
    /// The set of physical counts and inventory adjustments to be made.
    /// Changes are applied based on the client-supplied timestamp and may be sent
    changes: option<list<inventory-change>>,
    /// A client-supplied, universally unique identifier (UUID) for the
    /// request.
    idempotency-key: string,
    /// Indicates whether the current physical count should be ignored if
    /// the quantity is unchanged since the last physical count. Default: `true`.
    ignore-unchanged-counts: option<bool>
  }
  deprecated-batch-change-inventory: func(params: deprecated-batch-change-inventory-params) -> result<string, string>;

  /// DeprecatedBatchRetrieveInventoryChanges
  record deprecated-batch-retrieve-inventory-changes-params {
    /// The filter to return results by `CatalogObject` ID.
    /// The filter is only applicable when set. The default value is null.
    catalog-object-ids: option<list<string>>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The filter to return results by `Location` ID. 
    /// The filter is only applicable when set. The default value is null.
    location-ids: option<list<string>>,
    /// The filter to return `ADJUSTMENT` query results by
    /// `InventoryState`. This filter is only applied when set.
    states: option<list<string>>,
    /// The filter to return results by `InventoryChangeType` values other than `TRANSFER`.
    /// The default value is `[PHYSICAL_COUNT, ADJUSTMENT]`.
    types: option<list<string>>,
    /// The filter to return results with their `calculated_at` value  
    /// after the given time as specified in an RFC 3339 timestamp. 
    updated-after: option<string>,
    /// The filter to return results with their `created_at` or `calculated_at` value  
    /// strictly before the given time as specified in an RFC 3339 timestamp. 
    updated-before: option<string>
  }
  deprecated-batch-retrieve-inventory-changes: func(params: deprecated-batch-retrieve-inventory-changes-params) -> result<string, string>;

  /// DeprecatedBatchRetrieveInventoryCounts
  record deprecated-batch-retrieve-inventory-counts-params {
    /// The filter to return results by `CatalogObject` ID.
    /// The filter is applicable only when set.  The default is null.
    catalog-object-ids: option<list<string>>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The filter to return results by `Location` ID. 
    /// This filter is applicable only when set. The default is null.
    location-ids: option<list<string>>,
    /// The filter to return results by `InventoryState`. The filter is only applicable when set.
    /// Ignored are untracked states of `NONE`, `SOLD`, and `UNLINKED_RETURN`.
    states: option<list<string>>,
    /// The filter to return results with their `calculated_at` value 
    /// after the given time as specified in an RFC 3339 timestamp. 
    updated-after: option<string>
  }
  deprecated-batch-retrieve-inventory-counts: func(params: deprecated-batch-retrieve-inventory-counts-params) -> result<string, string>;

  /// BatchChangeInventory
  record batch-change-inventory-params {
    /// The set of physical counts and inventory adjustments to be made.
    /// Changes are applied based on the client-supplied timestamp and may be sent
    changes: option<list<inventory-change>>,
    /// A client-supplied, universally unique identifier (UUID) for the
    /// request.
    idempotency-key: string,
    /// Indicates whether the current physical count should be ignored if
    /// the quantity is unchanged since the last physical count. Default: `true`.
    ignore-unchanged-counts: option<bool>
  }
  batch-change-inventory: func(params: batch-change-inventory-params) -> result<string, string>;

  /// BatchRetrieveInventoryChanges
  record batch-retrieve-inventory-changes-params {
    /// The filter to return results by `CatalogObject` ID.
    /// The filter is only applicable when set. The default value is null.
    catalog-object-ids: option<list<string>>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The filter to return results by `Location` ID. 
    /// The filter is only applicable when set. The default value is null.
    location-ids: option<list<string>>,
    /// The filter to return `ADJUSTMENT` query results by
    /// `InventoryState`. This filter is only applied when set.
    states: option<list<string>>,
    /// The filter to return results by `InventoryChangeType` values other than `TRANSFER`.
    /// The default value is `[PHYSICAL_COUNT, ADJUSTMENT]`.
    types: option<list<string>>,
    /// The filter to return results with their `calculated_at` value  
    /// after the given time as specified in an RFC 3339 timestamp. 
    updated-after: option<string>,
    /// The filter to return results with their `created_at` or `calculated_at` value  
    /// strictly before the given time as specified in an RFC 3339 timestamp. 
    updated-before: option<string>
  }
  batch-retrieve-inventory-changes: func(params: batch-retrieve-inventory-changes-params) -> result<string, string>;

  /// BatchRetrieveInventoryCounts
  record batch-retrieve-inventory-counts-params {
    /// The filter to return results by `CatalogObject` ID.
    /// The filter is applicable only when set.  The default is null.
    catalog-object-ids: option<list<string>>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The filter to return results by `Location` ID. 
    /// This filter is applicable only when set. The default is null.
    location-ids: option<list<string>>,
    /// The filter to return results by `InventoryState`. The filter is only applicable when set.
    /// Ignored are untracked states of `NONE`, `SOLD`, and `UNLINKED_RETURN`.
    states: option<list<string>>,
    /// The filter to return results with their `calculated_at` value 
    /// after the given time as specified in an RFC 3339 timestamp. 
    updated-after: option<string>
  }
  batch-retrieve-inventory-counts: func(params: batch-retrieve-inventory-counts-params) -> result<string, string>;

  /// DeprecatedRetrieveInventoryPhysicalCount
  record deprecated-retrieve-inventory-physical-count-params {
    /// ID of the
    /// [InventoryPhysicalCount](https://developer.squareup.com/reference/square_2021-08-18/objects/InventoryPhysicalCount) to retrieve.
    physical-count-id: string
  }
  deprecated-retrieve-inventory-physical-count: func(params: deprecated-retrieve-inventory-physical-count-params) -> result<string, string>;

  /// RetrieveInventoryPhysicalCount
  record retrieve-inventory-physical-count-params {
    /// ID of the
    /// [InventoryPhysicalCount](https://developer.squareup.com/reference/square_2021-08-18/objects/InventoryPhysicalCount) to retrieve.
    physical-count-id: string
  }
  retrieve-inventory-physical-count: func(params: retrieve-inventory-physical-count-params) -> result<string, string>;

  /// RetrieveInventoryTransfer
  record retrieve-inventory-transfer-params {
    /// ID of the [InventoryTransfer](https://developer.squareup.com/reference/square_2021-08-18/objects/InventoryTransfer) to retrieve.
    transfer-id: string
  }
  retrieve-inventory-transfer: func(params: retrieve-inventory-transfer-params) -> result<string, string>;

  /// RetrieveInventoryCount
  record retrieve-inventory-count-params {
    /// ID of the [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) to retrieve.
    catalog-object-id: string,
    /// The [Location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) IDs to look up as a comma-separated
    /// list. An empty list queries all locations.
    location-ids: option<string>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>
  }
  retrieve-inventory-count: func(params: retrieve-inventory-count-params) -> result<string, string>;

  /// RetrieveInventoryChanges
  record retrieve-inventory-changes-params {
    /// ID of the [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject) to retrieve.
    catalog-object-id: string,
    /// The [Location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) IDs to look up as a comma-separated
    /// list. An empty list queries all locations.
    location-ids: option<string>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>
  }
  retrieve-inventory-changes: func(params: retrieve-inventory-changes-params) -> result<string, string>;

}

interface invoices {
  /// Stores information about an invoice. You use the Invoices API to create and manage
  /// invoices. For more information, see [Manage Invoices Using the Invoices API](https://developer.squareup.com/docs/invoices-api/overview).
  record invoice {
    accepted-payment-methods: option<invoice-accepted-payment-methods>,
    /// The timestamp when the invoice was created, in RFC 3339 format.
    created-at: option<string>,
    /// Additional seller-defined fields to render on the invoice. These fields are visible to sellers and buyers
    /// on the Square-hosted invoice page and in emailed or PDF copies of invoices. For more information, see
    custom-fields: option<list<invoice-custom-field>>,
    delivery-method: option<invoice-delivery-method-invoice-delivery-method>,
    /// The description of the invoice. This is visible to the customer receiving the invoice.
    description: option<string>,
    /// The Square-assigned ID of the invoice.
    id: option<string>,
    /// A user-friendly invoice number. The value is unique within a location.
    /// If not provided when creating an invoice, Square assigns a value.
    invoice-number: option<string>,
    /// The ID of the location that this invoice is associated with. 
    /// 
    location-id: option<string>,
    next-payment-amount-money: option<money>,
    /// The ID of the [order](https://developer.squareup.com/reference/square_2021-08-18/objects/Order) for which the invoice is created. 
    /// This field is required when creating an invoice, and the order must be in the `OPEN` state.
    order-id: option<string>,
    /// The payment schedule for the invoice, represented by one or more payment requests that
    /// define payment settings, such as amount due and due date. An invoice supports the following payment request combinations:
    payment-requests: option<list<invoice-payment-request>>,
    primary-recipient: option<invoice-recipient>,
    /// The URL of the Square-hosted invoice page.
    /// After you publish the invoice using the `PublishInvoice` endpoint, Square hosts the invoice
    public-url: option<string>,
    /// The timestamp when the invoice is scheduled for processing, in RFC 3339 format.
    /// After the invoice is published, Square processes the invoice on the specified date,
    scheduled-at: option<string>,
    /// The status of the invoice.
    status: option<string>,
    /// The ID of the [subscription](https://developer.squareup.com/reference/square_2021-08-18/objects/Subscription) associated with the invoice.
    /// This field is present only on subscription billing invoices.
    subscription-id: option<string>,
    /// The time zone used to interpret calendar dates on the invoice, such as `due_date`.
    /// When an invoice is created, this field is set to the `timezone` specified for the seller
    timezone: option<string>,
    /// The title of the invoice.
    title: option<string>,
    /// The timestamp when the invoice was last updated, in RFC 3339 format.
    updated-at: option<string>,
    /// The Square-assigned version number, which is incremented each time an update is committed to the invoice.
    version: option<s32>
  }

  /// The payment methods that customers can use to pay an invoice on the Square-hosted invoice page.
  record invoice-accepted-payment-methods {
    /// Indicates whether bank transfer payments are accepted. The default value is `false`.
    /// 
    bank-account: option<bool>,
    /// Indicates whether credit card or debit card payments are accepted. The default value is `false`.
    card: option<bool>,
    /// Indicates whether Square gift card payments are accepted. The default value is `false`.
    square-gift-card: option<bool>
  }

  /// An additional seller-defined and customer-facing field to include on the invoice. For more information, 
  /// see [Custom fields](https://developer.squareup.com/docs/invoices-api/overview#custom-fields).
  /// 
  /// Adding custom fields to an invoice requires an 
  /// [Invoices Plus subscription](https://developer.squareup.com/docs/invoices-api/overview#invoices-plus-subscription).
  record invoice-custom-field {
    /// The label or title of the custom field. This field is required for a custom field.
    label: option<string>,
    /// The location of the custom field on the invoice. This field is required for a custom field.
    placement: option<string>,
    /// The text of the custom field. If omitted, only the label is rendered.
    value: option<string>
  }

  record invoice-delivery-method-invoice-delivery-method {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Represents a payment request for an [invoice](https://developer.squareup.com/reference/square_2021-08-18/objects/Invoice). Invoices can specify a maximum
  /// of 13 payment requests, with up to 12 `INSTALLMENT` request types. For more information, 
  /// see [Payment requests](https://developer.squareup.com/docs/invoices-api/overview#payment-requests).
  /// 
  /// Adding `INSTALLMENT` payment requests to an invoice requires an 
  /// [Invoices Plus subscription](https://developer.squareup.com/docs/invoices-api/overview#invoices-plus-subscription).
  record invoice-payment-request {
    /// The payment method for an automatic payment.
    /// 
    automatic-payment-source: option<string>,
    /// The ID of the credit or debit card on file to charge for the payment request. To get the cards on file for a customer,
    /// call [ListCards](https://developer.squareup.com/reference/square_2021-08-18/cards-api/list-cards) and include the `customer_id` of the invoice recipient.
    card-id: option<string>,
    computed-amount-money: option<money>,
    /// The due date (in the invoice's time zone) for the payment request, in `YYYY-MM-DD` format. This field
    /// is required to create a payment request.
    due-date: option<string>,
    fixed-amount-requested-money: option<money>,
    /// Specifies the amount for the payment request in percentage:
    /// 
    percentage-requested: option<string>,
    /// A list of one or more reminders to send for the payment request.
    reminders: option<list<invoice-payment-reminder>>,
    /// Indicates how Square processes the payment request. DEPRECATED at version 2021-01-21. Replaced by the
    /// `Invoice.delivery_method` and `InvoicePaymentRequest.automatic_payment_source` fields.
    request-method: option<string>,
    /// Identifies the payment request type. This type defines how the payment request amount is determined. 
    /// This field is required to create a payment request.
    request-type: option<string>,
    rounding-adjustment-included-money: option<money>,
    /// If set to true, the Square-hosted invoice page (the `public_url` field of the invoice) 
    /// provides a place for the customer to pay a tip. 
    tipping-enabled: option<bool>,
    total-completed-amount-money: option<money>,
    /// The Square-generated ID of the payment request in an [invoice](https://developer.squareup.com/reference/square_2021-08-18/objects/Invoice).
    uid: option<string>
  }

  /// Describes a payment request reminder (automatic notification) that Square sends
  /// to the customer. You configure a reminder relative to the payment request
  /// `due_date`.
  record invoice-payment-reminder {
    /// The reminder message.
    message: option<string>,
    /// The number of days before (a negative number) or after (a positive number)
    /// the payment request `due_date` when the reminder is sent. For example, -3 indicates that
    relative-scheduled-days: option<s32>,
    /// If sent, the timestamp when the reminder was sent, in RFC 3339 format.
    sent-at: option<string>,
    /// The status of the reminder.
    status: option<string>,
    /// A Square-assigned ID that uniquely identifies the reminder within the
    /// `InvoicePaymentRequest`.
    uid: option<string>
  }

  /// Provides customer data that Square uses to deliver an invoice.
  record invoice-recipient {
    address: option<address>,
    /// The name of the recipient's company.
    company-name: option<string>,
    /// The ID of the customer. This is the customer profile ID that 
    /// you provide when creating a draft invoice.
    customer-id: option<string>,
    /// The recipient's email address.
    email-address: option<string>,
    /// The recipient's family (that is, last) name.
    family-name: option<string>,
    /// The recipient's given (that is, first) name.
    given-name: option<string>,
    /// The recipient's phone number.
    phone-number: option<string>
  }

  /// Represents a postal address in a country. The address format is based 
  /// on an [open-source library from Google](https://github.com/google/libaddressinput). For more information, 
  /// see [AddressValidationMetadata](https://github.com/google/libaddressinput/wiki/AddressValidationMetadata). 
  /// This format has dedicated fields for four address components: postal code, 
  /// locality (city), administrative district (state, prefecture, or province), and 
  /// sublocality (town or village). These components have dedicated fields in the 
  /// `Address` object because software sometimes behaves differently based on them. 
  /// For example, sales tax software may charge different amounts of sales tax 
  /// based on the postal code, and some software is only available in 
  /// certain states due to compliance reasons.
  /// 
  /// For the remaining address components, the `Address` type provides the 
  /// `address_line_1` and `address_line_2` fields for free-form data entry. 
  /// These fields are free-form because the remaining address components have 
  /// too many variations around the world and typical software does not parse 
  /// these components. These fields enable users to enter anything they want. 
  /// 
  /// Note that, in the current implementation, all other `Address` type fields are blank. 
  /// These include `address_line_3`, `sublocality_2`, `sublocality_3`, 
  /// `administrative_district_level_2`, `administrative_district_level_3`, 
  /// `first_name`, `last_name`, and `organization`. 
  /// 
  /// When it comes to localization, the seller's language preferences 
  /// (see [Language preferences](https://developer.squareup.com/docs/locations-api#location-specific-and-seller-level-language-preferences)) 
  /// are ignored for addresses. Even though Square products (such as Square Point of Sale 
  /// and the Seller Dashboard) mostly use a seller's language preference in 
  /// communication, when it comes to addresses, they will use English for a US address, 
  /// Japanese for an address in Japan, and so on.
  record address {
    /// The first line of the address.
    /// 
    address-line-v1: option<string>,
    /// The second line of the address, if any.
    address-line-v2: option<string>,
    /// The third line of the address, if any.
    address-line-v3: option<string>,
    /// A civil entity within the address's country. In the US, this
    /// is the state.
    administrative-district-level-v1: option<string>,
    /// A civil entity within the address's `administrative_district_level_1`.
    /// In the US, this is the county.
    administrative-district-level-v2: option<string>,
    /// A civil entity within the address's `administrative_district_level_2`,
    /// if any.
    administrative-district-level-v3: option<string>,
    /// The address's country, in ISO 3166-1-alpha-2 format.
    country: option<string>,
    /// Optional first name when it's representing recipient.
    first-name: option<string>,
    /// Optional last name when it's representing recipient.
    last-name: option<string>,
    /// The city or town of the address.
    locality: option<string>,
    /// Optional organization name when it's representing recipient.
    organization: option<string>,
    /// The address's postal code.
    postal-code: option<string>,
    /// A civil region within the address's `locality`, if any.
    sublocality: option<string>,
    /// A civil region within the address's `sublocality`, if any.
    sublocality-v2: option<string>,
    /// A civil region within the address's `sublocality_2`, if any.
    sublocality-v3: option<string>
  }

  /// Describes query criteria for searching invoices.
  record invoice-query {
    filter: invoice-filter,
    sort: option<invoice-sort>
  }

  /// Describes query filters to apply.
  record invoice-filter {
    /// Limits the search to the specified customers, within the specified locations. 
    /// Specifying a customer is optional. In the current implementation, 
    customer-ids: option<list<string>>,
    /// Limits the search to the specified locations. A location is required. 
    /// In the current implementation, only one location can be specified.
    location-ids: list<string>
  }

  /// Identifies the sort field and sort order.
  record invoice-sort {
    /// The field to use for sorting.
    field: string,
    /// The order to use for sorting the results.
    order: option<string>
  }

  /// ListInvoices
  record list-invoices-params {
    /// The ID of the location for which to list invoices.
    location-id: string,
    /// A pagination cursor returned by a previous call to this endpoint. 
    /// Provide this cursor to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// The maximum number of invoices to return (200 is the maximum `limit`). 
    /// If not provided, the server uses a default limit of 100 invoices.
    limit: option<s32>
  }
  list-invoices: func(params: list-invoices-params) -> result<string, string>;

  /// CreateInvoice
  record create-invoice-params {
    /// A unique string that identifies the `CreateInvoice` request. If you do not 
    /// provide `idempotency_key` (or provide an empty string as the value), the endpoint 
    idempotency-key: option<string>,
    invoice: invoice
  }
  create-invoice: func(params: create-invoice-params) -> result<string, string>;

  /// SearchInvoices
  record search-invoices-params {
    /// A pagination cursor returned by a previous call to this endpoint. 
    /// Provide this cursor to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// The maximum number of invoices to return (200 is the maximum `limit`). 
    /// If not provided, the server uses a default limit of 100 invoices.
    limit: option<s32>,
    query: invoice-query
  }
  search-invoices: func(params: search-invoices-params) -> result<string, string>;

  /// GetInvoice
  record get-invoice-params {
    /// The ID of the invoice to retrieve.
    invoice-id: string
  }
  get-invoice: func(params: get-invoice-params) -> result<string, string>;

  /// UpdateInvoice
  record update-invoice-params {
    /// The ID of the invoice to update.
    invoice-id: string,
    /// The list of fields to clear.
    /// For examples, see [Update an invoice](https://developer.squareup.com/docs/invoices-api/overview#update-an-invoice).
    fields-to-clear: option<list<string>>,
    /// A unique string that identifies the `UpdateInvoice` request. If you do not
    /// provide `idempotency_key` (or provide an empty string as the value), the endpoint
    idempotency-key: option<string>,
    invoice: invoice
  }
  update-invoice: func(params: update-invoice-params) -> result<string, string>;

  /// DeleteInvoice
  record delete-invoice-params {
    /// The ID of the invoice to delete.
    invoice-id: string,
    /// The version of the [invoice](https://developer.squareup.com/reference/square_2021-08-18/objects/Invoice) to delete.
    /// If you do not know the version, you can call [GetInvoice](https://developer.squareup.com/reference/square_2021-08-18/invoices-api/get-invoice) or 
    version: option<s32>
  }
  delete-invoice: func(params: delete-invoice-params) -> result<string, string>;

  /// CancelInvoice
  record cancel-invoice-params {
    /// The ID of the [invoice](https://developer.squareup.com/reference/square_2021-08-18/objects/Invoice) to cancel.
    invoice-id: string,
    /// The version of the [invoice](https://developer.squareup.com/reference/square_2021-08-18/objects/Invoice) to cancel.
    /// If you do not know the version, you can call 
    version: s32
  }
  cancel-invoice: func(params: cancel-invoice-params) -> result<string, string>;

  /// PublishInvoice
  record publish-invoice-params {
    /// The ID of the invoice to publish.
    invoice-id: string,
    /// A unique string that identifies the `PublishInvoice` request. If you do not 
    /// provide `idempotency_key` (or provide an empty string as the value), the endpoint 
    idempotency-key: option<string>,
    /// The version of the [invoice](https://developer.squareup.com/reference/square_2021-08-18/objects/Invoice) to publish.
    /// This must match the current version of the invoice; otherwise, the request is rejected.
    version: s32
  }
  publish-invoice: func(params: publish-invoice-params) -> result<string, string>;

}

interface labor {
  /// A defined break template that sets an expectation for possible `Break`
  /// instances on a `Shift`.
  record break-type {
    /// A human-readable name for this type of break. The name is displayed to
    /// employees in Square products.
    break-name: string,
    /// A read-only timestamp in RFC 3339 format.
    created-at: option<string>,
    /// Format: RFC-3339 P[n]Y[n]M[n]DT[n]H[n]M[n]S. The expected length of
    /// this break. Precision less than minutes is truncated.
    expected-duration: string,
    /// The UUID for this object.
    id: option<string>,
    /// Whether this break counts towards time worked for compensation
    /// purposes.
    is-paid: bool,
    /// The ID of the business location this type of break applies to.
    location-id: string,
    /// A read-only timestamp in RFC 3339 format.
    updated-at: option<string>,
    /// Used for resolving concurrency issues. The request fails if the version
    /// provided does not match the server version at the time of the request. If a value is not
    version: option<s32>
  }

  /// A record of the hourly rate, start, and end times for a single work shift
  /// for an employee. This might include a record of the start and end times for breaks
  /// taken during the shift.
  record shift {
    /// A list of all the paid or unpaid breaks that were taken during this shift.
    breaks: option<list<break>>,
    /// A read-only timestamp in RFC 3339 format; presented in UTC.
    created-at: option<string>,
    /// The ID of the employee this shift belongs to. DEPRECATED at version 2020-08-26. Use `team_member_id` instead.
    employee-id: option<string>,
    /// RFC 3339; shifted to the timezone + offset. Precision up to the minute is
    /// respected; seconds are truncated.
    end-at: option<string>,
    /// The UUID for this object.
    id: option<string>,
    /// The ID of the location this shift occurred at. The location should be based on
    /// where the employee clocked in.
    location-id: option<string>,
    /// RFC 3339; shifted to the location timezone + offset. Precision up to the
    /// minute is respected; seconds are truncated.
    start-at: string,
    /// Describes the working state of the current `Shift`.
    status: option<string>,
    /// The ID of the team member this shift belongs to. Replaced `employee_id` at version "2020-08-26".
    team-member-id: option<string>,
    /// The read-only convenience value that is calculated from the location based
    /// on the `location_id`. Format: the IANA timezone database identifier for the
    timezone: option<string>,
    /// A read-only timestamp in RFC 3339 format; presented in UTC.
    updated-at: option<string>,
    /// Used for resolving concurrency issues. The request fails if the version
    /// provided does not match the server version at the time of the request. If not provided,
    version: option<s32>,
    wage: option<shift-wage>
  }

  /// A record of an employee's break during a shift.
  record break {
    /// The `BreakType` that this `Break` was templated on.
    break-type-id: string,
    /// RFC 3339; follows the same timezone information as `Shift`. Precision up to
    /// the minute is respected; seconds are truncated.
    end-at: option<string>,
    /// Format: RFC-3339 P[n]Y[n]M[n]DT[n]H[n]M[n]S. The expected length of
    /// the break.
    expected-duration: string,
    /// The UUID for this object.
    id: option<string>,
    /// Whether this break counts towards time worked for compensation
    /// purposes.
    is-paid: bool,
    /// A human-readable name.
    name: string,
    /// RFC 3339; follows the same timezone information as `Shift`. Precision up to
    /// the minute is respected; seconds are truncated.
    start-at: string
  }

  /// The hourly wage rate used to compensate an employee for this shift.
  record shift-wage {
    hourly-rate: option<money>,
    /// The name of the job performed during this shift. Square
    /// labor-reporting UIs might group shifts together by title.
    title: option<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// The parameters of a `Shift` search query, which includes filter and sort options.
  record shift-query {
    filter: option<shift-filter>,
    sort: option<shift-sort>
  }

  /// Defines a filter used in a search for `Shift` records. `AND` logic is
  /// used by Square's servers to apply each filter property specified.
  record shift-filter {
    /// Fetch shifts for the specified employees. DEPRECATED at version 2020-08-26. Use `team_member_ids` instead.
    employee-ids: option<list<string>>,
    end: option<time-range>,
    /// Fetch shifts for the specified location.
    location-ids: list<string>,
    start: option<time-range>,
    /// Fetch a `Shift` instance by `Shift.status`.
    status: option<string>,
    /// Fetch shifts for the specified team members. Replaced `employee_ids` at version "2020-08-26".
    team-member-ids: list<string>,
    workday: option<shift-workday>
  }

  /// Represents a generic time range. The start and end values are
  /// represented in RFC 3339 format. Time ranges are customized to be
  /// inclusive or exclusive based on the needs of a particular endpoint.
  /// Refer to the relevant endpoint-specific documentation to determine
  /// how time ranges are handled.
  record time-range {
    /// A datetime value in RFC 3339 format indicating when the time range
    /// ends.
    end-at: option<string>,
    /// A datetime value in RFC 3339 format indicating when the time range
    /// starts.
    start-at: option<string>
  }

  /// A `Shift` search query filter parameter that sets a range of days that
  /// a `Shift` must start or end in before passing the filter condition.
  record shift-workday {
    date-range: option<date-range>,
    /// Location-specific timezones convert workdays to datetime filters.
    /// Every location included in the query must have a timezone or this field
    default-timezone: option<string>,
    /// The strategy on which the dates are applied.
    match-shifts-by: option<string>
  }

  /// A range defined by two dates. Used for filtering a query for Connect v2
  /// objects that have date properties.
  record date-range {
    /// A string in `YYYY-MM-DD` format, such as `2017-10-31`, per the ISO 8601
    /// extended format for calendar dates.
    end-date: option<string>,
    /// A string in `YYYY-MM-DD` format, such as `2017-10-31`, per the ISO 8601
    /// extended format for calendar dates.
    start-date: option<string>
  }

  /// Sets the sort order of search results.
  record shift-sort {
    /// The field to sort on.
    field: option<string>,
    /// The order in which results are returned. Defaults to DESC.
    order: option<string>
  }

  /// Sets the day of the week and hour of the day that a business starts a
  /// workweek. This is used to calculate overtime pay.
  record workweek-config {
    /// A read-only timestamp in RFC 3339 format; presented in UTC.
    created-at: option<string>,
    /// The UUID for this object.
    id: option<string>,
    /// The local time at which a business week ends. Represented as a
    /// string in `HH:MM` format (`HH:MM:SS` is also accepted, but seconds are
    start-of-day-local-time: string,
    /// The day of the week on which a business week ends for
    /// compensation purposes.
    start-of-week: string,
    /// A read-only timestamp in RFC 3339 format; presented in UTC.
    updated-at: option<string>,
    /// Used for resolving concurrency issues. The request fails if the version
    /// provided does not match the server version at the time of the request. If not provided,
    version: option<s32>
  }

  /// ListBreakTypes
  record list-break-types-params {
    /// Filter the returned `BreakType` results to only those that are associated with the
    /// specified location.
    location-id: option<string>,
    /// The maximum number of `BreakType` results to return per page. The number can range between 1
    /// and 200. The default is 200.
    limit: option<s32>,
    /// A pointer to the next page of `BreakType` results to fetch.
    cursor: option<string>
  }
  list-break-types: func(params: list-break-types-params) -> result<string, string>;

  /// CreateBreakType
  record create-break-type-params {
    break-type: break-type,
    /// A unique string value to ensure the idempotency of the operation.
    idempotency-key: option<string>
  }
  create-break-type: func(params: create-break-type-params) -> result<string, string>;

  /// GetBreakType
  record get-break-type-params {
    /// The UUID for the `BreakType` being retrieved.
    id: string
  }
  get-break-type: func(params: get-break-type-params) -> result<string, string>;

  /// UpdateBreakType
  record update-break-type-params {
    ///  The UUID for the `BreakType` being updated.
    id: string,
    break-type: break-type
  }
  update-break-type: func(params: update-break-type-params) -> result<string, string>;

  /// DeleteBreakType
  record delete-break-type-params {
    /// The UUID for the `BreakType` being deleted.
    id: string
  }
  delete-break-type: func(params: delete-break-type-params) -> result<string, string>;

  /// ListEmployeeWages
  record list-employee-wages-params {
    /// Filter the returned wages to only those that are associated with the specified employee.
    employee-id: option<string>,
    /// The maximum number of `EmployeeWage` results to return per page. The number can range between
    /// 1 and 200. The default is 200.
    limit: option<s32>,
    /// A pointer to the next page of `EmployeeWage` results to fetch.
    cursor: option<string>
  }
  list-employee-wages: func(params: list-employee-wages-params) -> result<string, string>;

  /// GetEmployeeWage
  record get-employee-wage-params {
    /// The UUID for the `EmployeeWage` being retrieved.
    id: string
  }
  get-employee-wage: func(params: get-employee-wage-params) -> result<string, string>;

  /// CreateShift
  record create-shift-params {
    /// A unique string value to ensure the idempotency of the operation.
    idempotency-key: option<string>,
    shift: shift
  }
  create-shift: func(params: create-shift-params) -> result<string, string>;

  /// SearchShifts
  record search-shifts-params {
    /// An opaque cursor for fetching the next page.
    cursor: option<string>,
    /// The number of resources in a page (200 by default).
    limit: option<s32>,
    query: option<shift-query>
  }
  search-shifts: func(params: search-shifts-params) -> result<string, string>;

  /// GetShift
  record get-shift-params {
    /// The UUID for the `Shift` being retrieved.
    id: string
  }
  get-shift: func(params: get-shift-params) -> result<string, string>;

  /// UpdateShift
  record update-shift-params {
    /// The ID of the object being updated.
    id: string,
    shift: shift
  }
  update-shift: func(params: update-shift-params) -> result<string, string>;

  /// DeleteShift
  record delete-shift-params {
    /// The UUID for the `Shift` being deleted.
    id: string
  }
  delete-shift: func(params: delete-shift-params) -> result<string, string>;

  /// ListTeamMemberWages
  record list-team-member-wages-params {
    /// Filter the returned wages to only those that are associated with the
    /// specified team member.
    team-member-id: option<string>,
    /// The maximum number of `TeamMemberWage` results to return per page. The number can range between
    /// 1 and 200. The default is 200.
    limit: option<s32>,
    /// A pointer to the next page of `EmployeeWage` results to fetch.
    cursor: option<string>
  }
  list-team-member-wages: func(params: list-team-member-wages-params) -> result<string, string>;

  /// GetTeamMemberWage
  record get-team-member-wage-params {
    /// The UUID for the `TeamMemberWage` being retrieved.
    id: string
  }
  get-team-member-wage: func(params: get-team-member-wage-params) -> result<string, string>;

  /// ListWorkweekConfigs
  record list-workweek-configs-params {
    /// The maximum number of `WorkweekConfigs` results to return per page.
    limit: option<s32>,
    /// A pointer to the next page of `WorkweekConfig` results to fetch.
    cursor: option<string>
  }
  list-workweek-configs: func(params: list-workweek-configs-params) -> result<string, string>;

  /// UpdateWorkweekConfig
  record update-workweek-config-params {
    /// The UUID for the `WorkweekConfig` object being updated.
    id: string,
    workweek-config: workweek-config
  }
  update-workweek-config: func(params: update-workweek-config-params) -> result<string, string>;

}

interface locations {
  record location {
    address: option<address>,
    /// The email of the location.
    /// This email is visible to the customers of the location.
    business-email: option<string>,
    business-hours: option<business-hours>,
    /// The business name of the location
    /// This is the name visible to the customers of the location.
    business-name: option<string>,
    /// The Square features that are enabled for the location.
    /// See [LocationCapability](https://developer.squareup.com/reference/square_2021-08-18/enums/LocationCapability) for possible values.
    capabilities: option<list<string>>,
    coordinates: option<coordinates>,
    /// The country of the location, in ISO 3166-1-alpha-2 format.
    /// 
    country: option<string>,
    /// The time when the location was created, in RFC 3339 format.
    /// For more information, see [Working with Dates](https://developer.squareup.com/docs/build-basics/working-with-dates).
    created-at: option<string>,
    /// The currency used for all transactions at this location,
    /// in ISO 4217 format.
    currency: option<string>,
    /// The description of the location.
    description: option<string>,
    /// The Facebook profile URL of the location. The URL should begin with 'facebook.com/'. For example, `https://www.facebook.com/square`.
    facebook-url: option<string>,
    /// The URL of a full-format logo image for the location. The Seller must choose this logo in the
    /// Seller dashboard (Receipts section) for the logo to appear on transactions (such as receipts, invoices)
    full-format-logo-url: option<string>,
    /// The Square-issued ID of the location.
    id: option<string>,
    /// The Instagram username of the location without the '&#64;' symbol. For example, `square`.
    instagram-username: option<string>,
    /// The language associated with the location, in
    /// [BCP 47 format](https://tools.ietf.org/html/bcp47#appendix-A). 
    language-code: option<string>,
    /// The URL of the logo image for the location. The Seller must choose this logo in the Seller
    /// dashboard (Receipts section) for the logo to appear on transactions (such as receipts, invoices)
    logo-url: option<string>,
    /// The merchant category code (MCC) of the location, as standardized by ISO 18245.
    /// The MCC describes the kind of goods or services sold at the location.
    mcc: option<string>,
    /// The ID of the merchant that owns the location.
    merchant-id: option<string>,
    /// The name of the location.
    /// This information appears in the dashboard as the nickname.
    name: option<string>,
    /// The phone number of the location in human readable format. For example, `+353 80 0 098 8099`.
    phone-number: option<string>,
    /// The URL of the Point of Sale background image for the location.
    pos-background-url: option<string>,
    /// The status of the location, either active or inactive.
    status: option<string>,
    tax-ids: option<tax-ids>,
    /// The [IANA Timezone](https://www.iana.org/time-zones) identifier for
    /// the timezone of the location.
    timezone: option<string>,
    /// The Twitter username of the location without the '&#64;' symbol. For example, `Square`.
    twitter-username: option<string>,
    /// The type of the location, either physical or mobile.
    type-op: option<string>,
    /// The website URL of the location.  For example, `https://squareup.com`.
    website-url: option<string>
  }

  /// Represents a postal address in a country. The address format is based 
  /// on an [open-source library from Google](https://github.com/google/libaddressinput). For more information, 
  /// see [AddressValidationMetadata](https://github.com/google/libaddressinput/wiki/AddressValidationMetadata). 
  /// This format has dedicated fields for four address components: postal code, 
  /// locality (city), administrative district (state, prefecture, or province), and 
  /// sublocality (town or village). These components have dedicated fields in the 
  /// `Address` object because software sometimes behaves differently based on them. 
  /// For example, sales tax software may charge different amounts of sales tax 
  /// based on the postal code, and some software is only available in 
  /// certain states due to compliance reasons.
  /// 
  /// For the remaining address components, the `Address` type provides the 
  /// `address_line_1` and `address_line_2` fields for free-form data entry. 
  /// These fields are free-form because the remaining address components have 
  /// too many variations around the world and typical software does not parse 
  /// these components. These fields enable users to enter anything they want. 
  /// 
  /// Note that, in the current implementation, all other `Address` type fields are blank. 
  /// These include `address_line_3`, `sublocality_2`, `sublocality_3`, 
  /// `administrative_district_level_2`, `administrative_district_level_3`, 
  /// `first_name`, `last_name`, and `organization`. 
  /// 
  /// When it comes to localization, the seller's language preferences 
  /// (see [Language preferences](https://developer.squareup.com/docs/locations-api#location-specific-and-seller-level-language-preferences)) 
  /// are ignored for addresses. Even though Square products (such as Square Point of Sale 
  /// and the Seller Dashboard) mostly use a seller's language preference in 
  /// communication, when it comes to addresses, they will use English for a US address, 
  /// Japanese for an address in Japan, and so on.
  record address {
    /// The first line of the address.
    /// 
    address-line-v1: option<string>,
    /// The second line of the address, if any.
    address-line-v2: option<string>,
    /// The third line of the address, if any.
    address-line-v3: option<string>,
    /// A civil entity within the address's country. In the US, this
    /// is the state.
    administrative-district-level-v1: option<string>,
    /// A civil entity within the address's `administrative_district_level_1`.
    /// In the US, this is the county.
    administrative-district-level-v2: option<string>,
    /// A civil entity within the address's `administrative_district_level_2`,
    /// if any.
    administrative-district-level-v3: option<string>,
    /// The address's country, in ISO 3166-1-alpha-2 format.
    country: option<string>,
    /// Optional first name when it's representing recipient.
    first-name: option<string>,
    /// Optional last name when it's representing recipient.
    last-name: option<string>,
    /// The city or town of the address.
    locality: option<string>,
    /// Optional organization name when it's representing recipient.
    organization: option<string>,
    /// The address's postal code.
    postal-code: option<string>,
    /// A civil region within the address's `locality`, if any.
    sublocality: option<string>,
    /// A civil region within the address's `sublocality`, if any.
    sublocality-v2: option<string>,
    /// A civil region within the address's `sublocality_2`, if any.
    sublocality-v3: option<string>
  }

  /// Represents the hours of operation for a business location.
  record business-hours {
    /// The list of time periods during which the business is open. There may be at most 10
    /// periods per day.
    periods: option<list<business-hours-period>>
  }

  /// Represents a period of time during which a business location is open.
  record business-hours-period {
    /// The day of week for this time period.
    day-of-week: option<string>,
    /// The end time of a business hours period, specified in local time using partial-time
    /// RFC 3339 format.
    end-local-time: option<string>,
    /// The start time of a business hours period, specified in local time using partial-time
    /// RFC 3339 format.
    start-local-time: option<string>
  }

  /// Latitude and longitude coordinates.
  record coordinates {
    /// The latitude of the coordinate expressed in degrees.
    latitude: option<f64>,
    /// The longitude of the coordinate expressed in degrees.
    longitude: option<f64>
  }

  /// The tax IDs that a Location is operating under.
  record tax-ids {
    /// The EU VAT number for this location. For example, "IE3426675K".
    /// If the EU VAT number is present, it is well-formed and has been
    eu-vat: option<string>,
    /// The French government uses the NAF (Nomenclature des Activités Françaises) to display and
    /// track economic statistical data. This is also called the APE (Activite Principale de l’Entreprise) code.
    fr-naf: option<string>,
    /// The SIRET (Système d'Identification du Répertoire des Entreprises et de leurs Etablissements)
    /// number is a 14 digits code issued by the French INSEE. For example, "39922799000021".
    fr-siret: option<string>
  }

  /// ListLocations
  list-locations: func() -> result<string, string>;

  /// CreateLocation
  record create-location-params {
    location: option<location>
  }
  create-location: func(params: create-location-params) -> result<string, string>;

  /// RetrieveLocation
  record retrieve-location-params {
    /// The ID of the location to retrieve. If you specify the string "main",
    /// then the endpoint returns the main location.
    location-id: string
  }
  retrieve-location: func(params: retrieve-location-params) -> result<string, string>;

  /// UpdateLocation
  record update-location-params {
    /// The ID of the location to update.
    location-id: string,
    location: option<location>
  }
  update-location: func(params: update-location-params) -> result<string, string>;

}

interface checkout {
  /// Represents an additional recipient (other than the merchant) entitled to a portion of the tender.
  /// Support is currently limited to USD, CAD and GBP currencies
  record charge-request-additional-recipient {
    amount-money: money,
    /// The description of the additional recipient.
    description: string,
    /// The location ID for a recipient (other than the merchant) receiving a portion of the tender.
    location-id: string
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  record create-order-request {
    /// A value you specify that uniquely identifies this
    /// order among orders you have created.
    idempotency-key: option<string>,
    order: option<order>
  }

  /// Contains all information related to a single order to process with Square,
  /// including line items that specify the products to purchase. `Order` objects also
  /// include information about any associated tenders, refunds, and returns.
  /// 
  /// All Connect V2 Transactions have all been converted to Orders including all associated
  /// itemization data.
  record order {
    /// The timestamp for when the order reached a terminal [state](https://developer.squareup.com/reference/square_2021-08-18/enums/OrderState), in RFC 3339 format (for example "2016-09-04T23:59:33.123Z").
    closed-at: option<string>,
    /// The timestamp for when the order was created, in RFC 3339 format (for example, "2016-09-04T23:59:33.123Z").
    created-at: option<string>,
    /// The ID of the [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) associated with the order.
    /// 
    customer-id: option<string>,
    /// The list of all discounts associated with the order.
    /// 
    discounts: option<list<order-line-item-discount>>,
    /// Details about order fulfillment.
    /// 
    fulfillments: option<list<order-fulfillment>>,
    /// The order's unique ID.
    id: option<string>,
    /// The line items included in the order.
    line-items: option<list<order-line-item>>,
    /// The ID of the seller location that this order is associated with.
    location-id: string,
    /// Application-defined data attached to this order. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-metadata>,
    net-amounts: option<order-money-amounts>,
    pricing-options: option<order-pricing-options>,
    /// A client-specified ID to associate an entity in another system
    /// with this order.
    reference-id: option<string>,
    /// The refunds that are part of this order.
    refunds: option<list<refund>>,
    return-amounts: option<order-money-amounts>,
    /// A collection of items from sale orders being returned in this one. Normally part of an
    /// itemized return or exchange. There is exactly one `Return` object per sale `Order` being
    returns: option<list<order-return>>,
    /// A set-like list of Rewards that have been added to the Order.
    rewards: option<list<order-reward>>,
    rounding-adjustment: option<order-rounding-adjustment>,
    /// A list of service charges applied to the order.
    service-charges: option<list<order-service-charge>>,
    source: option<order-source>,
    /// The current state of the order: `OPEN`, `COMPLETED`, or `CANCELED`.
    state: option<string>,
    /// The list of all taxes associated with the order.
    /// 
    taxes: option<list<order-line-item-tax>>,
    /// The tenders that were used to pay for the order.
    tenders: option<list<tender>>,
    total-discount-money: option<money>,
    total-money: option<money>,
    total-service-charge-money: option<money>,
    total-tax-money: option<money>,
    total-tip-money: option<money>,
    /// The timestamp for when the order was last updated, in RFC 3339 format (for example, "2016-09-04T23:59:33.123Z").
    updated-at: option<string>,
    /// The version number, which is incremented each time an update is committed to the order.
    /// Orders not created through the API do not include a version number and
    version: option<s32>
  }

  /// Represents a discount that applies to one or more line items in an
  /// order.
  /// 
  /// Fixed-amount, order-scoped discounts are distributed across all non-zero line item totals.
  /// The amount distributed to each line item is relative to the
  /// amount contributed by the item to the order subtotal.
  record order-line-item-discount {
    amount-money: option<money>,
    applied-money: option<money>,
    /// The catalog object ID referencing [CatalogDiscount](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogDiscount).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this discount references.
    catalog-version: option<s64>,
    /// Application-defined data attached to this discount. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-line-item-discount-metadata>,
    /// The discount's name.
    name: option<string>,
    /// The percentage of the discount, as a string representation of a decimal number.
    /// A value of `7.25` corresponds to a percentage of 7.25%.
    percentage: option<string>,
    /// The object ID of a [pricing rule](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogPricingRule) to be applied 
    /// automatically to this discount. The specification and application of the discounts, to 
    pricing-rule-id: option<string>,
    /// The reward IDs corresponding to this discount. The application and
    /// specification of discounts that have `reward_ids` are completely controlled by the backing
    reward-ids: option<list<string>>,
    /// Indicates the level at which the discount applies. For `ORDER` scoped discounts,
    /// Square generates references in `applied_discounts` on all order line items that do
    scope: option<string>,
    /// The type of the discount.
    /// 
    type-op: option<string>,
    /// A unique ID that identifies the discount only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this discount. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-line-item-discount-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Contains details about how to fulfill this order.
  record order-fulfillment {
    /// Application-defined data attached to this fulfillment. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-fulfillment-metadata>,
    pickup-details: option<order-fulfillment-pickup-details>,
    shipment-details: option<order-fulfillment-shipment-details>,
    /// The state of the fulfillment.
    state: option<string>,
    /// The type of the fulfillment.
    type-op: option<string>,
    /// A unique ID that identifies the fulfillment only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this fulfillment. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-fulfillment-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Contains details necessary to fulfill a pickup order.
  record order-fulfillment-pickup-details {
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment was accepted. The timestamp must be in RFC 3339 format
    accepted-at: option<string>,
    /// The duration of time after which an open and accepted pickup fulfillment
    /// is automatically moved to the `COMPLETED` state. The duration must be in RFC 3339
    auto-complete-duration: option<string>,
    /// A description of why the pickup was canceled. The maximum length: 100 characters.
    cancel-reason: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment was canceled. The timestamp must be in RFC 3339 format
    canceled-at: option<string>,
    curbside-pickup-details: option<order-fulfillment-pickup-details-curbside-pickup-details>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the fulfillment expired. The timestamp must be in RFC 3339 format
    expired-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when this fulfillment expires if it is not accepted. The timestamp must be in RFC 3339 format
    expires-at: option<string>,
    /// If set to `true`, indicates that this pickup order is for curbside pickup, not in-store pickup.
    is-curbside-pickup: option<bool>,
    /// A note meant to provide additional instructions about the pickup
    /// fulfillment displayed in the Square Point of Sale application and set by the API.
    note: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the fulfillment was picked up by the recipient. The timestamp must be in RFC 3339 format
    picked-up-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// that represents the start of the pickup window. Must be in RFC 3339 timestamp format, e.g., 
    pickup-at: option<string>,
    /// The window of time in which the order should be picked up after the `pickup_at` timestamp.
    /// Must be in RFC 3339 duration format, e.g., "P1W3D". Can be used as an
    pickup-window-duration: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment was placed. The timestamp must be in RFC 3339 format
    placed-at: option<string>,
    /// The duration of time it takes to prepare this fulfillment.
    /// The duration must be in RFC 3339 format (for example, "P1W3D").
    prep-time-duration: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment is marked as ready for pickup. The timestamp must be in RFC 3339 format
    ready-at: option<string>,
    recipient: option<order-fulfillment-recipient>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment was rejected. The timestamp must be in RFC 3339 format
    rejected-at: option<string>,
    /// The schedule type of the pickup fulfillment. Defaults to `SCHEDULED`.
    schedule-type: option<string>
  }

  /// Specific details for curbside pickup.
  record order-fulfillment-pickup-details-curbside-pickup-details {
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the buyer arrived and is waiting for pickup. The timestamp must be in RFC 3339 format
    buyer-arrived-at: option<string>,
    /// Specific details for curbside pickup, such as parking number and vehicle model.
    curbside-details: option<string>
  }

  /// Contains information about the recipient of a fulfillment.
  record order-fulfillment-recipient {
    address: option<address>,
    /// The customer ID of the customer associated with the fulfillment.
    /// 
    customer-id: option<string>,
    /// The display name of the fulfillment recipient.
    /// 
    display-name: option<string>,
    /// The email address of the fulfillment recipient.
    /// 
    email-address: option<string>,
    /// The phone number of the fulfillment recipient.
    /// 
    phone-number: option<string>
  }

  /// Represents a postal address in a country. The address format is based 
  /// on an [open-source library from Google](https://github.com/google/libaddressinput). For more information, 
  /// see [AddressValidationMetadata](https://github.com/google/libaddressinput/wiki/AddressValidationMetadata). 
  /// This format has dedicated fields for four address components: postal code, 
  /// locality (city), administrative district (state, prefecture, or province), and 
  /// sublocality (town or village). These components have dedicated fields in the 
  /// `Address` object because software sometimes behaves differently based on them. 
  /// For example, sales tax software may charge different amounts of sales tax 
  /// based on the postal code, and some software is only available in 
  /// certain states due to compliance reasons.
  /// 
  /// For the remaining address components, the `Address` type provides the 
  /// `address_line_1` and `address_line_2` fields for free-form data entry. 
  /// These fields are free-form because the remaining address components have 
  /// too many variations around the world and typical software does not parse 
  /// these components. These fields enable users to enter anything they want. 
  /// 
  /// Note that, in the current implementation, all other `Address` type fields are blank. 
  /// These include `address_line_3`, `sublocality_2`, `sublocality_3`, 
  /// `administrative_district_level_2`, `administrative_district_level_3`, 
  /// `first_name`, `last_name`, and `organization`. 
  /// 
  /// When it comes to localization, the seller's language preferences 
  /// (see [Language preferences](https://developer.squareup.com/docs/locations-api#location-specific-and-seller-level-language-preferences)) 
  /// are ignored for addresses. Even though Square products (such as Square Point of Sale 
  /// and the Seller Dashboard) mostly use a seller's language preference in 
  /// communication, when it comes to addresses, they will use English for a US address, 
  /// Japanese for an address in Japan, and so on.
  record address {
    /// The first line of the address.
    /// 
    address-line-v1: option<string>,
    /// The second line of the address, if any.
    address-line-v2: option<string>,
    /// The third line of the address, if any.
    address-line-v3: option<string>,
    /// A civil entity within the address's country. In the US, this
    /// is the state.
    administrative-district-level-v1: option<string>,
    /// A civil entity within the address's `administrative_district_level_1`.
    /// In the US, this is the county.
    administrative-district-level-v2: option<string>,
    /// A civil entity within the address's `administrative_district_level_2`,
    /// if any.
    administrative-district-level-v3: option<string>,
    /// The address's country, in ISO 3166-1-alpha-2 format.
    country: option<string>,
    /// Optional first name when it's representing recipient.
    first-name: option<string>,
    /// Optional last name when it's representing recipient.
    last-name: option<string>,
    /// The city or town of the address.
    locality: option<string>,
    /// Optional organization name when it's representing recipient.
    organization: option<string>,
    /// The address's postal code.
    postal-code: option<string>,
    /// A civil region within the address's `locality`, if any.
    sublocality: option<string>,
    /// A civil region within the address's `sublocality`, if any.
    sublocality-v2: option<string>,
    /// A civil region within the address's `sublocality_2`, if any.
    sublocality-v3: option<string>
  }

  /// Contains the details necessary to fulfill a shipment order.
  record order-fulfillment-shipment-details {
    /// A description of why the shipment was canceled.
    cancel-reason: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating the shipment was canceled.
    canceled-at: option<string>,
    /// The shipping carrier being used to ship this fulfillment (such as UPS, FedEx, or USPS).
    carrier: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the shipment is expected to be delivered to the shipping carrier.
    expected-shipped-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the shipment failed to be completed. The timestamp must be in RFC 3339 format
    failed-at: option<string>,
    /// A description of why the shipment failed to be completed.
    failure-reason: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when this fulfillment was moved to the `RESERVED` state, which  indicates that preparation
    in-progress-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when this fulfillment was moved to the `PREPARED` state, which indicates that the
    packaged-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the shipment was requested. The timestamp must be in RFC 3339 format
    placed-at: option<string>,
    recipient: option<order-fulfillment-recipient>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when this fulfillment was moved to the `COMPLETED` state, which indicates that
    shipped-at: option<string>,
    /// A note with additional information for the shipping carrier.
    shipping-note: option<string>,
    /// A description of the type of shipping product purchased from the carrier
    /// (such as First Class, Priority, or Express).
    shipping-type: option<string>,
    /// The reference number provided by the carrier to track the shipment's progress.
    tracking-number: option<string>,
    /// A link to the tracking webpage on the carrier's website.
    tracking-url: option<string>
  }

  /// Represents a line item in an order. Each line item describes a different
  /// product to purchase, with its own quantity and price details.
  record order-line-item {
    /// The list of references to discounts applied to this line item. Each
    /// `OrderLineItemAppliedDiscount` has a `discount_uid` that references the `uid` of a top-level
    applied-discounts: option<list<order-line-item-applied-discount>>,
    /// The list of references to taxes applied to this line item. Each
    /// `OrderLineItemAppliedTax` has a `tax_uid` that references the `uid` of a
    applied-taxes: option<list<order-line-item-applied-tax>>,
    base-price-money: option<money>,
    /// The [CatalogItemVariation](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogItemVariation) ID applied to this line item.
    catalog-object-id: option<string>,
    /// The version of the catalog object that this line item references.
    catalog-version: option<s64>,
    gross-sales-money: option<money>,
    /// The type of line item: an itemized sale, a non-itemized sale (custom amount), or the
    /// activation or reloading of a gift card.
    item-type: option<string>,
    /// Application-defined data attached to this line item. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-line-item-metadata>,
    /// The [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier)s applied to this line item.
    modifiers: option<list<order-line-item-modifier>>,
    /// The name of the line item.
    name: option<string>,
    /// The note of the line item.
    note: option<string>,
    pricing-blocklists: option<order-line-item-pricing-blocklists>,
    /// The quantity purchased, formatted as a decimal number.
    /// For example, `"3"`.
    quantity: string,
    quantity-unit: option<order-quantity-unit>,
    total-discount-money: option<money>,
    total-money: option<money>,
    total-tax-money: option<money>,
    /// A unique ID that identifies the line item only within this order.
    uid: option<string>,
    /// The name of the variation applied to this line item.
    variation-name: option<string>,
    variation-total-price-money: option<money>
  }

  /// Represents an applied portion of a discount to a line item in an order.
  /// 
  /// Order scoped discounts have automatically applied discounts present for each line item.
  /// Line-item scoped discounts must have applied discounts added manually for any applicable line
  /// items. The corresponding applied money is automatically computed based on participating
  /// line items.
  record order-line-item-applied-discount {
    applied-money: option<money>,
    /// The `uid` of the discount that the applied discount represents. It must
    /// reference a discount present in the `order.discounts` field.
    discount-uid: string,
    /// A unique ID that identifies the applied discount only within this order.
    uid: option<string>
  }

  /// Represents an applied portion of a tax to a line item in an order.
  /// 
  /// Order-scoped taxes automatically include the applied taxes in each line item.
  /// Line item taxes must be referenced from any applicable line items.
  /// The corresponding applied money is automatically computed, based on the
  /// set of participating line items.
  record order-line-item-applied-tax {
    applied-money: option<money>,
    /// The `uid` of the tax for which this applied tax represents. It must reference
    /// a tax present in the `order.taxes` field.
    tax-uid: string,
    /// A unique ID that identifies the applied tax only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this line item. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-line-item-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier).
  record order-line-item-modifier {
    base-price-money: option<money>,
    /// The catalog object ID referencing [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this modifier references.
    catalog-version: option<s64>,
    /// The name of the item modifier.
    name: option<string>,
    total-price-money: option<money>,
    /// A unique ID that identifies the modifier only within this order.
    uid: option<string>
  }

  /// Describes pricing adjustments that are blocked from manual and 
  /// automatic application to a line item. For more information, see 
  /// [Apply Taxes and Discounts](https://developer.squareup.com/docs/orders-api/apply-taxes-and-discounts).
  record order-line-item-pricing-blocklists {
    /// A list of discounts blocked from applying to the line item. 
    /// Discounts can be blocked by the `discount_uid` (for ad hoc discounts) or 
    blocked-discounts: option<list<order-line-item-pricing-blocklists-blocked-discount>>,
    /// A list of taxes blocked from applying to the line item. 
    /// Taxes can be blocked by the `tax_uid` (for ad hoc taxes) or 
    blocked-taxes: option<list<order-line-item-pricing-blocklists-blocked-tax>>
  }

  /// A discount to block from applying to a line item. The discount must be 
  /// identified by either `discount_uid` or `discount_catalog_object_id`, but not both.
  record order-line-item-pricing-blocklists-blocked-discount {
    /// The `catalog_object_id` of the discount that should be blocked. 
    /// Use this field to block catalog discounts. For ad hoc discounts, use the 
    discount-catalog-object-id: option<string>,
    /// The `uid` of the discount that should be blocked. Use this field to block 
    /// ad hoc discounts. For catalog discounts, use the `discount_catalog_object_id` field.
    discount-uid: option<string>,
    /// A unique ID of the `BlockedDiscount` within the order.
    uid: option<string>
  }

  /// A tax to block from applying to a line item. The tax must be 
  /// identified by either `tax_uid` or `tax_catalog_object_id`, but not both.
  record order-line-item-pricing-blocklists-blocked-tax {
    /// The `catalog_object_id` of the tax that should be blocked. 
    /// Use this field to block catalog taxes. For ad hoc taxes, use the 
    tax-catalog-object-id: option<string>,
    /// The `uid` of the tax that should be blocked. Use this field to block 
    /// ad hoc taxes. For catalog, taxes use the `tax_catalog_object_id` field.
    tax-uid: option<string>,
    /// A unique ID of the `BlockedTax` within the order.
    uid: option<string>
  }

  /// Contains the measurement unit for a quantity and a precision that
  /// specifies the number of digits after the decimal point for decimal quantities.
  record order-quantity-unit {
    /// The version of the catalog object that this measurement unit references.
    /// 
    catalog-version: option<s64>,
    measurement-unit: option<measurement-unit>,
    /// For non-integer quantities, represents the number of digits after the decimal point that are
    /// recorded for this quantity.
    precision: option<s32>
  }

  /// Represents a unit of measurement to use with a quantity, such as ounces
  /// or inches. Exactly one of the following fields are required: `custom_unit`,
  /// `area_unit`, `length_unit`, `volume_unit`, and `weight_unit`.
  record measurement-unit {
    /// Represents a standard area unit.
    area-unit: option<string>,
    custom-unit: option<measurement-unit-custom>,
    /// Reserved for API integrations that lack the ability to specify a real measurement unit
    generic-unit: option<string>,
    /// Represents a standard length unit.
    length-unit: option<string>,
    /// Represents a standard unit of time.
    time-unit: option<string>,
    /// Represents the type of the measurement unit.
    type-op: option<string>,
    /// Represents a standard volume unit.
    volume-unit: option<string>,
    /// Represents a standard unit of weight or mass.
    weight-unit: option<string>
  }

  /// The information needed to define a custom unit, provided by the seller.
  record measurement-unit-custom {
    /// The abbreviation of the custom unit, such as "bsh" (bushel). This appears
    /// in the cart for the Point of Sale app, and in reports.
    abbreviation: string,
    /// The name of the custom unit, for example "bushel".
    name: string
  }

  /// Application-defined data attached to this order. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see  [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A collection of various money amounts.
  record order-money-amounts {
    discount-money: option<money>,
    service-charge-money: option<money>,
    tax-money: option<money>,
    tip-money: option<money>,
    total-money: option<money>
  }

  /// Pricing options for an order. The options affect how the order's price is calculated.
  /// They can be used, for example, to apply automatic price adjustments that are based on preconfigured
  /// [pricing rules](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogPricingRule).
  record order-pricing-options {
    /// The option to determine whether pricing rule-based
    /// discounts are automatically applied to an order.
    auto-apply-discounts: option<bool>,
    /// The option to determine whether rule-based taxes are automatically
    /// applied to an order when the criteria of the corresponding rules are met.
    auto-apply-taxes: option<bool>
  }

  /// Represents a refund processed for a Square transaction.
  record refund {
    /// Additional recipients (other than the merchant) receiving a portion of this refund.
    /// For example, fees assessed on a refund of a purchase by a third party integration.
    additional-recipients: option<list<additional-recipient>>,
    amount-money: money,
    /// The timestamp for when the refund was created, in RFC 3339 format.
    created-at: option<string>,
    /// The refund's unique ID.
    id: string,
    /// The ID of the refund's associated location.
    location-id: string,
    processing-fee-money: option<money>,
    /// The reason for the refund being issued.
    reason: string,
    /// The current status of the refund (`PENDING`, `APPROVED`, `REJECTED`,
    /// or `FAILED`).
    status: string,
    /// The ID of the refunded tender.
    tender-id: string,
    /// The ID of the transaction that the refunded tender is part of.
    transaction-id: string
  }

  /// Represents an additional recipient (other than the merchant) receiving a portion of this tender.
  record additional-recipient {
    amount-money: money,
    /// The description of the additional recipient.
    description: option<string>,
    /// The location ID for a recipient (other than the merchant) receiving a portion of this tender.
    location-id: string,
    /// The unique ID for this [AdditionalRecipientReceivable](https://developer.squareup.com/reference/square_2021-08-18/objects/AdditionalRecipientReceivable), assigned by the server.
    receivable-id: option<string>
  }

  /// The set of line items, service charges, taxes, discounts, tips, and other items being returned in an order.
  record order-return {
    return-amounts: option<order-money-amounts>,
    /// A collection of references to discounts being returned for an order, including the total
    /// applied discount amount to be returned. The discounts must reference a top-level discount ID
    return-discounts: option<list<order-return-discount>>,
    /// A collection of line items that are being returned.
    return-line-items: option<list<order-return-line-item>>,
    /// A collection of service charges that are being returned.
    return-service-charges: option<list<order-return-service-charge>>,
    /// A collection of references to taxes being returned for an order, including the total
    /// applied tax amount to be returned. The taxes must reference a top-level tax ID from the source
    return-taxes: option<list<order-return-tax>>,
    rounding-adjustment: option<order-rounding-adjustment>,
    /// An order that contains the original sale of these return line items. This is unset
    /// for unlinked returns.
    source-order-id: option<string>,
    /// A unique ID that identifies the return only within this order.
    uid: option<string>
  }

  /// Represents a discount being returned that applies to one or more return line items in an
  /// order.
  /// 
  /// Fixed-amount, order-scoped discounts are distributed across all non-zero return line item totals.
  /// The amount distributed to each return line item is relative to that item’s contribution to the
  /// order subtotal.
  record order-return-discount {
    amount-money: option<money>,
    applied-money: option<money>,
    /// The catalog object ID referencing [CatalogDiscount](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogDiscount).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this discount references.
    catalog-version: option<s64>,
    /// The discount's name.
    name: option<string>,
    /// The percentage of the tax, as a string representation of a decimal number.
    /// A value of `"7.25"` corresponds to a percentage of 7.25%.
    percentage: option<string>,
    /// Indicates the level at which the `OrderReturnDiscount` applies. For `ORDER` scoped
    /// discounts, the server generates references in `applied_discounts` on all
    scope: option<string>,
    /// The discount `uid` from the order that contains the original application of this discount.
    source-discount-uid: option<string>,
    /// The type of the discount. If it is created by the API, it is `FIXED_PERCENTAGE` or `FIXED_AMOUNT`.
    /// 
    type-op: option<string>,
    /// A unique ID that identifies the returned discount only within this order.
    uid: option<string>
  }

  /// The line item being returned in an order.
  record order-return-line-item {
    /// The list of references to `OrderReturnDiscount` entities applied to the return line item. Each
    /// `OrderLineItemAppliedDiscount` has a `discount_uid` that references the `uid` of a top-level
    applied-discounts: option<list<order-line-item-applied-discount>>,
    /// The list of references to `OrderReturnTax` entities applied to the return line item. Each
    /// `OrderLineItemAppliedTax` has a `tax_uid` that references the `uid` of a top-level
    applied-taxes: option<list<order-line-item-applied-tax>>,
    base-price-money: option<money>,
    /// The [CatalogItemVariation](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogItemVariation) ID applied to this return line item.
    catalog-object-id: option<string>,
    /// The version of the catalog object that this line item references.
    catalog-version: option<s64>,
    gross-return-money: option<money>,
    /// The type of line item: an itemized return, a non-itemized return (custom amount),
    /// or the return of an unactivated gift card sale.
    item-type: option<string>,
    /// The name of the line item.
    name: option<string>,
    /// The note of the return line item.
    note: option<string>,
    /// The quantity returned, formatted as a decimal number.
    /// For example, `"3"`.
    quantity: string,
    quantity-unit: option<order-quantity-unit>,
    /// The [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier)s applied to this line item.
    return-modifiers: option<list<order-return-line-item-modifier>>,
    /// The `uid` of the line item in the original sale order.
    source-line-item-uid: option<string>,
    total-discount-money: option<money>,
    total-money: option<money>,
    total-tax-money: option<money>,
    /// A unique ID for this return line-item entry.
    uid: option<string>,
    /// The name of the variation applied to this return line item.
    variation-name: option<string>,
    variation-total-price-money: option<money>
  }

  /// A line item modifier being returned.
  record order-return-line-item-modifier {
    base-price-money: option<money>,
    /// The catalog object ID referencing [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this line item modifier references.
    catalog-version: option<s64>,
    /// The name of the item modifier.
    name: option<string>,
    /// The modifier `uid` from the order's line item that contains the
    /// original sale of this line item modifier.
    source-modifier-uid: option<string>,
    total-price-money: option<money>,
    /// A unique ID that identifies the return modifier only within this order.
    uid: option<string>
  }

  /// Represents the service charge applied to the original order.
  record order-return-service-charge {
    amount-money: option<money>,
    applied-money: option<money>,
    /// The list of references to `OrderReturnTax` entities applied to the
    /// `OrderReturnServiceCharge`. Each `OrderLineItemAppliedTax` has a `tax_uid`
    applied-taxes: option<list<order-line-item-applied-tax>>,
    /// The calculation phase after which to apply the service charge.
    calculation-phase: option<string>,
    /// The catalog object ID of the associated [OrderServiceCharge](https://developer.squareup.com/reference/square_2021-08-18/objects/OrderServiceCharge).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this service charge references.
    catalog-version: option<s64>,
    /// The name of the service charge.
    name: option<string>,
    /// The percentage of the service charge, as a string representation of
    /// a decimal number. For example, a value of `"7.25"` corresponds to a
    percentage: option<string>,
    /// The service charge `uid` from the order containing the original
    /// service charge. `source_service_charge_uid` is `null` for
    source-service-charge-uid: option<string>,
    /// Indicates whether the surcharge can be taxed. Service charges
    /// calculated in the `TOTAL_PHASE` cannot be marked as taxable.
    taxable: option<bool>,
    total-money: option<money>,
    total-tax-money: option<money>,
    /// A unique ID that identifies the return service charge only within this order.
    uid: option<string>
  }

  /// Represents a tax being returned that applies to one or more return line items in an order.
  /// 
  /// Fixed-amount, order-scoped taxes are distributed across all non-zero return line item totals.
  /// The amount distributed to each return line item is relative to that item’s contribution to the
  /// order subtotal.
  record order-return-tax {
    applied-money: option<money>,
    /// The catalog object ID referencing [CatalogTax](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogTax).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this tax references.
    catalog-version: option<s64>,
    /// The tax's name.
    name: option<string>,
    /// The percentage of the tax, as a string representation of a decimal number.
    /// For example, a value of `"7.25"` corresponds to a percentage of 7.25%.
    percentage: option<string>,
    /// Indicates the level at which the `OrderReturnTax` applies. For `ORDER` scoped
    /// taxes, Square generates references in `applied_taxes` on all
    scope: option<string>,
    /// The tax `uid` from the order that contains the original tax charge.
    source-tax-uid: option<string>,
    /// Indicates the calculation method used to apply the tax.
    type-op: option<string>,
    /// A unique ID that identifies the returned tax only within this order.
    uid: option<string>
  }

  /// A rounding adjustment of the money being returned. Commonly used to apply cash rounding
  /// when the minimum unit of the account is smaller than the lowest physical denomination of the currency.
  record order-rounding-adjustment {
    amount-money: option<money>,
    /// The name of the rounding adjustment from the original sale order.
    name: option<string>,
    /// A unique ID that identifies the rounding adjustment only within this order.
    uid: option<string>
  }

  /// Represents a reward that can be applied to an order if the necessary
  /// reward tier criteria are met. Rewards are created through the Loyalty API.
  record order-reward {
    /// The identifier of the reward.
    id: string,
    /// The identifier of the reward tier corresponding to this reward.
    reward-tier-id: string
  }

  /// Represents a service charge applied to an order.
  record order-service-charge {
    amount-money: option<money>,
    applied-money: option<money>,
    /// The list of references to the taxes applied to this service charge. Each
    /// `OrderLineItemAppliedTax` has a `tax_uid` that references the `uid` of a top-level
    applied-taxes: option<list<order-line-item-applied-tax>>,
    /// The calculation phase at which to apply the service charge.
    calculation-phase: option<string>,
    /// The catalog object ID referencing the service charge [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this service charge references.
    catalog-version: option<s64>,
    /// Application-defined data attached to this service charge. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-service-charge-metadata>,
    /// The name of the service charge.
    name: option<string>,
    /// The service charge percentage as a string representation of a
    /// decimal number. For example, `"7.25"` indicates a service charge of 7.25%.
    percentage: option<string>,
    /// Indicates whether the service charge can be taxed. If set to `true`,
    /// order-level taxes automatically apply to the service charge. Note that
    taxable: option<bool>,
    total-money: option<money>,
    total-tax-money: option<money>,
    /// The type of the service charge.
    type-op: option<string>,
    /// A unique ID that identifies the service charge only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this service charge. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-service-charge-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents the origination details of an order.
  record order-source {
    /// The name used to identify the place (physical or digital) that an order originates.
    /// If unset, the name defaults to the name of the application that created the order.
    name: option<string>
  }

  /// Represents a tax that applies to one or more line item in the order.
  /// 
  /// Fixed-amount, order-scoped taxes are distributed across all non-zero line item totals.
  /// The amount distributed to each line item is relative to the amount the item
  /// contributes to the order subtotal.
  record order-line-item-tax {
    applied-money: option<money>,
    /// Determines whether the tax was automatically applied to the order based on
    /// the catalog configuration. For an example, see 
    auto-applied: option<bool>,
    /// The catalog object ID referencing [CatalogTax](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogTax).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this tax references.
    catalog-version: option<s64>,
    /// Application-defined data attached to this tax. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-line-item-tax-metadata>,
    /// The tax's name.
    name: option<string>,
    /// The percentage of the tax, as a string representation of a decimal
    /// number. For example, a value of `"7.25"` corresponds to a percentage of
    percentage: option<string>,
    /// Indicates the level at which the tax applies. For `ORDER` scoped taxes,
    /// Square generates references in `applied_taxes` on all order line items that do
    scope: option<string>,
    /// Indicates the calculation method used to apply the tax.
    type-op: option<string>,
    /// A unique ID that identifies the tax only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this tax. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-line-item-tax-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents a tender (i.e., a method of payment) used in a Square transaction.
  record tender {
    /// Additional recipients (other than the merchant) receiving a portion of this tender.
    /// For example, fees assessed on the purchase by a third party integration.
    additional-recipients: option<list<additional-recipient>>,
    amount-money: option<money>,
    card-details: option<tender-card-details>,
    cash-details: option<tender-cash-details>,
    /// The timestamp for when the tender was created, in RFC 3339 format.
    created-at: option<string>,
    /// If the tender is associated with a customer or represents a customer's card on file,
    /// this is the ID of the associated customer.
    customer-id: option<string>,
    /// The tender's unique ID.
    id: option<string>,
    /// The ID of the transaction's associated location.
    location-id: option<string>,
    /// An optional note associated with the tender at the time of payment.
    note: option<string>,
    /// The ID of the [Payment](https://developer.squareup.com/reference/square_2021-08-18/objects/Payment) that corresponds to this tender.
    /// This value is only present for payments created with the v2 Payments API.
    payment-id: option<string>,
    processing-fee-money: option<money>,
    tip-money: option<money>,
    /// The ID of the tender's associated transaction.
    transaction-id: option<string>,
    /// The type of tender, such as `CARD` or `CASH`.
    type-op: string
  }

  /// Represents additional details of a tender with `type` `CARD` or `SQUARE_GIFT_CARD`
  record tender-card-details {
    card: option<card>,
    /// The method used to enter the card's details for the transaction.
    entry-method: option<string>,
    /// The credit card payment's current state (such as `AUTHORIZED` or
    /// `CAPTURED`). See [TenderCardDetailsStatus](https://developer.squareup.com/reference/square_2021-08-18/objects/TenderCardDetailsStatus)
    status: option<string>
  }

  /// Represents the payment details of a card to be used for payments. These
  /// details are determined by the payment token generated by Web Payments SDK.
  record card {
    billing-address: option<address>,
    /// The first six digits of the card number, known as the Bank Identification Number (BIN). Only the Payments API
    /// returns this field.
    bin: option<string>,
    /// The card's brand.
    card-brand: option<string>,
    /// The type of the card.
    /// The Card object includes this field only in response to Payments API calls.
    card-type: option<string>,
    /// The name of the cardholder.
    cardholder-name: option<string>,
    /// The ID of a customer created using the Customers API to be associated with the card.
    customer-id: option<string>,
    /// Indicates whether or not a card can be used for payments.
    enabled: option<bool>,
    /// The expiration month of the associated card as an integer between 1 and 12.
    exp-month: option<s64>,
    /// The four-digit year of the card's expiration date.
    exp-year: option<s64>,
    /// __Not currently set.__ Intended as a Square-assigned identifier, based
    /// on the card number, to identify the card across multiple locations within a
    fingerprint: option<string>,
    /// Unique ID for this card. Generated by Square.
    id: option<string>,
    /// The last 4 digits of the card number.
    last-v4: option<string>,
    /// Indicates whether the Card is prepaid or not.
    /// The Card object includes this field only in response to Payments API calls.
    prepaid-type: option<string>,
    /// An optional user-defined reference ID that associates this card with
    /// another entity in an external system. For example, a customer ID from an
    reference-id: option<string>,
    /// Current version number of the card. Increments with each card update. Requests to update an
    /// existing Card object will be rejected unless the version in the request matches the current
    version: option<s64>
  }

  /// Represents the details of a tender with `type` `CASH`.
  record tender-cash-details {
    buyer-tendered-money: option<money>,
    change-back-money: option<money>
  }

  /// CreateCheckout
  record create-checkout-params {
    /// The ID of the business location to associate the checkout with.
    location-id: string,
    /// The basic primitive of a multi-party transaction. The value is optional.
    /// The transaction facilitated by you can be split from here.
    additional-recipients: option<list<charge-request-additional-recipient>>,
    /// If `true`, Square Checkout collects shipping information on your behalf and stores 
    /// that information with the transaction information in the Square Seller Dashboard.
    ask-for-shipping-address: option<bool>,
    /// A unique string that identifies this checkout among others you have created. It can be
    /// any valid string but must be unique for every order sent to Square Checkout for a given location ID.
    idempotency-key: string,
    /// The email address to display on the Square Checkout confirmation page
    /// and confirmation email that the buyer can use to contact the seller.
    merchant-support-email: option<string>,
    /// An optional note to associate with the `checkout` object.
    /// 
    note: option<string>,
    order: create-order-request,
    /// If provided, the buyer's email is prepopulated on the checkout page
    /// as an editable text field.
    pre-populate-buyer-email: option<string>,
    pre-populate-shipping-address: option<address>,
    /// The URL to redirect to after the checkout is completed with `checkoutId`,
    /// `transactionId`, and `referenceId` appended as URL parameters. For example,
    redirect-url: option<string>
  }
  create-checkout: func(params: create-checkout-params) -> result<string, string>;

}

interface transactions {
  /// Represents an additional recipient (other than the merchant) receiving a portion of this tender.
  record additional-recipient {
    amount-money: money,
    /// The description of the additional recipient.
    description: option<string>,
    /// The location ID for a recipient (other than the merchant) receiving a portion of this tender.
    location-id: string,
    /// The unique ID for this [AdditionalRecipientReceivable](https://developer.squareup.com/reference/square_2021-08-18/objects/AdditionalRecipientReceivable), assigned by the server.
    receivable-id: option<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Represents a postal address in a country. The address format is based 
  /// on an [open-source library from Google](https://github.com/google/libaddressinput). For more information, 
  /// see [AddressValidationMetadata](https://github.com/google/libaddressinput/wiki/AddressValidationMetadata). 
  /// This format has dedicated fields for four address components: postal code, 
  /// locality (city), administrative district (state, prefecture, or province), and 
  /// sublocality (town or village). These components have dedicated fields in the 
  /// `Address` object because software sometimes behaves differently based on them. 
  /// For example, sales tax software may charge different amounts of sales tax 
  /// based on the postal code, and some software is only available in 
  /// certain states due to compliance reasons.
  /// 
  /// For the remaining address components, the `Address` type provides the 
  /// `address_line_1` and `address_line_2` fields for free-form data entry. 
  /// These fields are free-form because the remaining address components have 
  /// too many variations around the world and typical software does not parse 
  /// these components. These fields enable users to enter anything they want. 
  /// 
  /// Note that, in the current implementation, all other `Address` type fields are blank. 
  /// These include `address_line_3`, `sublocality_2`, `sublocality_3`, 
  /// `administrative_district_level_2`, `administrative_district_level_3`, 
  /// `first_name`, `last_name`, and `organization`. 
  /// 
  /// When it comes to localization, the seller's language preferences 
  /// (see [Language preferences](https://developer.squareup.com/docs/locations-api#location-specific-and-seller-level-language-preferences)) 
  /// are ignored for addresses. Even though Square products (such as Square Point of Sale 
  /// and the Seller Dashboard) mostly use a seller's language preference in 
  /// communication, when it comes to addresses, they will use English for a US address, 
  /// Japanese for an address in Japan, and so on.
  record address {
    /// The first line of the address.
    /// 
    address-line-v1: option<string>,
    /// The second line of the address, if any.
    address-line-v2: option<string>,
    /// The third line of the address, if any.
    address-line-v3: option<string>,
    /// A civil entity within the address's country. In the US, this
    /// is the state.
    administrative-district-level-v1: option<string>,
    /// A civil entity within the address's `administrative_district_level_1`.
    /// In the US, this is the county.
    administrative-district-level-v2: option<string>,
    /// A civil entity within the address's `administrative_district_level_2`,
    /// if any.
    administrative-district-level-v3: option<string>,
    /// The address's country, in ISO 3166-1-alpha-2 format.
    country: option<string>,
    /// Optional first name when it's representing recipient.
    first-name: option<string>,
    /// Optional last name when it's representing recipient.
    last-name: option<string>,
    /// The city or town of the address.
    locality: option<string>,
    /// Optional organization name when it's representing recipient.
    organization: option<string>,
    /// The address's postal code.
    postal-code: option<string>,
    /// A civil region within the address's `locality`, if any.
    sublocality: option<string>,
    /// A civil region within the address's `sublocality`, if any.
    sublocality-v2: option<string>,
    /// A civil region within the address's `sublocality_2`, if any.
    sublocality-v3: option<string>
  }

  /// ListRefunds
  record get-v2-locations-location-id-refunds-params {
    /// The ID of the location to list refunds for.
    location-id: string,
    /// The beginning of the requested reporting period, in RFC 3339 format.
    /// 
    begin-time: option<string>,
    /// The end of the requested reporting period, in RFC 3339 format.
    /// 
    end-time: option<string>,
    /// The order in which results are listed in the response (`ASC` for
    /// oldest first, `DESC` for newest first).
    sort-order: option<string>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for your original query.
    cursor: option<string>
  }
  get-v2-locations-location-id-refunds: func(params: get-v2-locations-location-id-refunds-params) -> result<string, string>;

  /// ListTransactions
  record list-transactions-params {
    /// The ID of the location to list transactions for.
    location-id: string,
    /// The beginning of the requested reporting period, in RFC 3339 format.
    /// 
    begin-time: option<string>,
    /// The end of the requested reporting period, in RFC 3339 format.
    /// 
    end-time: option<string>,
    /// The order in which results are listed in the response (`ASC` for
    /// oldest first, `DESC` for newest first).
    sort-order: option<string>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for your original query.
    cursor: option<string>
  }
  list-transactions: func(params: list-transactions-params) -> result<string, string>;

  /// Charge
  record charge-params {
    /// The ID of the location to associate the created transaction with.
    location-id: string,
    /// The basic primitive of multi-party transaction. The value is optional.
    /// The transaction facilitated by you can be split from here.
    additional-recipients: option<list<additional-recipient>>,
    amount-money: money,
    billing-address: option<address>,
    /// The buyer's email address, if available. This value is optional,
    /// but this transaction is ineligible for chargeback protection if it is not
    buyer-email-address: option<string>,
    /// A payment token generated from the [Card.tokenize()](https://developer.squareup.com/reference/sdks/web/payments/objects/Card#Card.tokenize) that represents the card
    /// to charge.
    card-nonce: option<string>,
    /// The ID of the customer card on file to charge. Do
    /// not provide a value for this field if you provide a value for `card_nonce`.
    customer-card-id: option<string>,
    /// The ID of the customer to associate this transaction with. This field
    /// is required if you provide a value for `customer_card_id`, and optional
    customer-id: option<string>,
    /// If `true`, the request will only perform an Auth on the provided
    /// card. You can then later perform either a Capture (with the
    delay-capture: option<bool>,
    /// A value you specify that uniquely identifies this
    /// transaction among transactions you've created.
    idempotency-key: string,
    /// An optional note to associate with the transaction.
    /// 
    note: option<string>,
    /// The ID of the order to associate with this transaction.
    /// 
    order-id: option<string>,
    /// An optional ID you can associate with the transaction for your own
    /// purposes (such as to associate the transaction with an entity ID in your
    reference-id: option<string>,
    shipping-address: option<address>,
    /// A token generated by SqPaymentForm's verifyBuyer() that represents
    /// customer's device info and 3ds challenge result.
    verification-token: option<string>
  }
  charge: func(params: charge-params) -> result<string, string>;

  /// RetrieveTransaction
  record retrieve-transaction-params {
    /// The ID of the transaction's associated location.
    location-id: string,
    /// The ID of the transaction to retrieve.
    transaction-id: string
  }
  retrieve-transaction: func(params: retrieve-transaction-params) -> result<string, string>;

  /// CaptureTransaction
  record capture-transaction-params {
    location-id: string,
    transaction-id: string
  }
  capture-transaction: func(params: capture-transaction-params) -> result<string, string>;

  /// CreateRefund
  record post-v2-locations-location-id-transactions-transaction-id-refund-params {
    /// The ID of the original transaction's associated location.
    location-id: string,
    /// The ID of the original transaction that includes the tender to refund.
    transaction-id: string,
    amount-money: money,
    /// A value you specify that uniquely identifies this
    /// refund among refunds you've created for the tender.
    idempotency-key: string,
    /// A description of the reason for the refund.
    /// 
    reason: option<string>,
    /// The ID of the tender to refund.
    /// 
    tender-id: string
  }
  post-v2-locations-location-id-transactions-transaction-id-refund: func(params: post-v2-locations-location-id-transactions-transaction-id-refund-params) -> result<string, string>;

  /// VoidTransaction
  record void-transaction-params {
    location-id: string,
    transaction-id: string
  }
  void-transaction: func(params: void-transaction-params) -> result<string, string>;

}

interface loyalty {
  /// Describes a loyalty account. For more information, see
  /// [Manage Loyalty Accounts Using the Loyalty API](https://developer.squareup.com/docs/loyalty-api/overview).
  record loyalty-account {
    /// The available point balance in the loyalty account. If points are scheduled to expire, they are listed in the `expiring_point_deadlines` field.
    /// 
    balance: option<s32>,
    /// The timestamp when the loyalty account was created, in RFC 3339 format.
    created-at: option<string>,
    /// The Square-assigned ID of the [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) that is associated with the account.
    customer-id: option<string>,
    /// The timestamp when enrollment occurred, in RFC 3339 format.
    enrolled-at: option<string>,
    /// The schedule for when points expire in the loyalty account balance. This field is present only if the account has points that are scheduled to expire. 
    /// 
    expiring-point-deadlines: option<list<loyalty-account-expiring-point-deadline>>,
    /// The Square-assigned ID of the loyalty account.
    id: option<string>,
    /// The total points accrued during the lifetime of the account.
    lifetime-points: option<s32>,
    mapping: option<loyalty-account-mapping>,
    /// The Square-assigned ID of the [loyalty program](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyProgram) to which the account belongs.
    program-id: string,
    /// The timestamp when the loyalty account was last updated, in RFC 3339 format.
    updated-at: option<string>
  }

  /// Represents a set of points for a loyalty account that are scheduled to expire on a specific date.
  record loyalty-account-expiring-point-deadline {
    /// The timestamp of when the points are scheduled to expire, in RFC 3339 format.
    expires-at: string,
    /// The number of points scheduled to expire at the `expires_at` timestamp.
    points: s32
  }

  /// Represents the mapping that associates a loyalty account with a buyer. 
  /// 
  /// Currently, a loyalty account can only be mapped to a buyer by phone number. For more information, see 
  /// [Loyalty Overview](https://developer.squareup.com/docs/loyalty/overview).
  record loyalty-account-mapping {
    /// The timestamp when the mapping was created, in RFC 3339 format.
    created-at: option<string>,
    /// The Square-assigned ID of the mapping.
    id: option<string>,
    /// The phone number of the buyer, in E.164 format. For example, "+14155551111".
    phone-number: option<string>
  }

  /// The search criteria for the loyalty accounts.
  record search-loyalty-accounts-request-loyalty-account-query {
    /// The set of customer IDs to use in the loyalty account search.  
    /// 
    customer-ids: option<list<string>>,
    /// The set of mappings to use in the loyalty account search.  
    /// 
    mappings: option<list<loyalty-account-mapping>>
  }

  /// Provides metadata when the event `type` is `ACCUMULATE_POINTS`.
  record loyalty-event-accumulate-points {
    /// The ID of the [loyalty program](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyProgram).
    loyalty-program-id: option<string>,
    /// The ID of the [order](https://developer.squareup.com/reference/square_2021-08-18/objects/Order) for which the buyer accumulated the points.
    /// This field is returned only if the Orders API is used to process orders.
    order-id: option<string>,
    /// The number of points accumulated by the event.
    points: option<s32>
  }

  /// Provides metadata when the event `type` is `ADJUST_POINTS`.
  record loyalty-event-adjust-points {
    /// The Square-assigned ID of the [loyalty program](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyProgram).
    loyalty-program-id: option<string>,
    /// The number of points added or removed.
    points: s32,
    /// The reason for the adjustment of points.
    reason: option<string>
  }

  /// Represents a query used to search for loyalty events.
  record loyalty-event-query {
    filter: option<loyalty-event-filter>
  }

  /// The filtering criteria. If the request specifies multiple filters, 
  /// the endpoint uses a logical AND to evaluate them.
  record loyalty-event-filter {
    date-time-filter: option<loyalty-event-date-time-filter>,
    location-filter: option<loyalty-event-location-filter>,
    loyalty-account-filter: option<loyalty-event-loyalty-account-filter>,
    order-filter: option<loyalty-event-order-filter>,
    type-filter: option<loyalty-event-type-filter>
  }

  /// Filter events by date time range.
  record loyalty-event-date-time-filter {
    created-at: time-range
  }

  /// Represents a generic time range. The start and end values are
  /// represented in RFC 3339 format. Time ranges are customized to be
  /// inclusive or exclusive based on the needs of a particular endpoint.
  /// Refer to the relevant endpoint-specific documentation to determine
  /// how time ranges are handled.
  record time-range {
    /// A datetime value in RFC 3339 format indicating when the time range
    /// ends.
    end-at: option<string>,
    /// A datetime value in RFC 3339 format indicating when the time range
    /// starts.
    start-at: option<string>
  }

  /// Filter events by location.
  record loyalty-event-location-filter {
    /// The [location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) IDs for loyalty events to query.
    /// If multiple values are specified, the endpoint uses 
    location-ids: list<string>
  }

  /// Filter events by loyalty account.
  record loyalty-event-loyalty-account-filter {
    /// The ID of the [loyalty account](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyAccount) associated with loyalty events.
    loyalty-account-id: string
  }

  /// Filter events by the order associated with the event.
  record loyalty-event-order-filter {
    /// The ID of the [order](https://developer.squareup.com/reference/square_2021-08-18/objects/Order) associated with the event.
    order-id: string
  }

  /// Filter events by event type.
  record loyalty-event-type-filter {
    /// The loyalty event types used to filter the result.
    /// If multiple values are specified, the endpoint uses a 
    types: list<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Represents a contract to redeem loyalty points for a [reward tier](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyProgramRewardTier) discount. Loyalty rewards can be in an ISSUED, REDEEMED, or DELETED state. For more information, see [Redeem loyalty rewards](https://developer.squareup.com/docs/loyalty-api/overview#redeem-loyalty-rewards).
  record loyalty-reward {
    /// The timestamp when the reward was created, in RFC 3339 format.
    created-at: option<string>,
    /// The Square-assigned ID of the loyalty reward.
    id: option<string>,
    /// The Square-assigned ID of the [loyalty account](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyAccount) to which the reward belongs.
    loyalty-account-id: string,
    /// The Square-assigned ID of the [order](https://developer.squareup.com/reference/square_2021-08-18/objects/Order) to which the reward is attached.
    order-id: option<string>,
    /// The number of loyalty points used for the reward.
    points: option<s32>,
    /// The timestamp when the reward was redeemed, in RFC 3339 format.
    redeemed-at: option<string>,
    /// The Square-assigned ID of the [reward tier](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyProgramRewardTier) used to create the reward.
    reward-tier-id: string,
    /// The status of a loyalty reward.
    status: option<string>,
    /// The timestamp when the reward was last updated, in RFC 3339 format.
    updated-at: option<string>
  }

  /// The set of search requirements.
  record search-loyalty-rewards-request-loyalty-reward-query {
    /// The ID of the [loyalty account](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyAccount) to which the loyalty reward belongs.
    loyalty-account-id: string,
    /// The status of the loyalty reward.
    status: option<string>
  }

  /// CreateLoyaltyAccount
  record create-loyalty-account-params {
    /// A unique string that identifies this `CreateLoyaltyAccount` request. 
    /// Keys can be any valid string, but must be unique for every request.
    idempotency-key: string,
    loyalty-account: loyalty-account
  }
  create-loyalty-account: func(params: create-loyalty-account-params) -> result<string, string>;

  /// SearchLoyaltyAccounts
  record search-loyalty-accounts-params {
    /// A pagination cursor returned by a previous call to 
    /// this endpoint. Provide this to retrieve the next set of 
    cursor: option<string>,
    /// The maximum number of results to include in the response.
    limit: option<s32>,
    query: option<search-loyalty-accounts-request-loyalty-account-query>
  }
  search-loyalty-accounts: func(params: search-loyalty-accounts-params) -> result<string, string>;

  /// RetrieveLoyaltyAccount
  record retrieve-loyalty-account-params {
    /// The ID of the [loyalty account](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyAccount) to retrieve.
    account-id: string
  }
  retrieve-loyalty-account: func(params: retrieve-loyalty-account-params) -> result<string, string>;

  /// AccumulateLoyaltyPoints
  record accumulate-loyalty-points-params {
    /// The [loyalty account](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyAccount) ID to which to add the points.
    account-id: string,
    accumulate-points: loyalty-event-accumulate-points,
    /// A unique string that identifies the `AccumulateLoyaltyPoints` request. 
    /// Keys can be any valid string but must be unique for every request.
    idempotency-key: string,
    /// The [location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) where the purchase was made.
    location-id: string
  }
  accumulate-loyalty-points: func(params: accumulate-loyalty-points-params) -> result<string, string>;

  /// AdjustLoyaltyPoints
  record adjust-loyalty-points-params {
    /// The ID of the [loyalty account](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyAccount) in which to adjust the points.
    account-id: string,
    adjust-points: loyalty-event-adjust-points,
    /// A unique string that identifies this `AdjustLoyaltyPoints` request. 
    /// Keys can be any valid string, but must be unique for every request.
    idempotency-key: string
  }
  adjust-loyalty-points: func(params: adjust-loyalty-points-params) -> result<string, string>;

  /// SearchLoyaltyEvents
  record search-loyalty-events-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// The maximum number of results to include in the response. 
    /// The last page might contain fewer events. 
    limit: option<s32>,
    query: option<loyalty-event-query>
  }
  search-loyalty-events: func(params: search-loyalty-events-params) -> result<string, string>;

  /// ListLoyaltyPrograms
  list-loyalty-programs: func() -> result<string, string>;

  /// RetrieveLoyaltyProgram
  record retrieve-loyalty-program-params {
    /// The ID of the loyalty program or the keyword `main`. Either value can be used to retrieve the single loyalty program that belongs to the seller.
    program-id: string
  }
  retrieve-loyalty-program: func(params: retrieve-loyalty-program-params) -> result<string, string>;

  /// CalculateLoyaltyPoints
  record calculate-loyalty-points-params {
    /// The [loyalty program](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyProgram) ID, which defines the rules for accruing points.
    program-id: string,
    /// The [order](https://developer.squareup.com/reference/square_2021-08-18/objects/Order) ID for which to calculate the points.
    /// Specify this field if your application uses the Orders API to process orders.
    order-id: option<string>,
    transaction-amount-money: option<money>
  }
  calculate-loyalty-points: func(params: calculate-loyalty-points-params) -> result<string, string>;

  /// CreateLoyaltyReward
  record create-loyalty-reward-params {
    /// A unique string that identifies this `CreateLoyaltyReward` request. 
    /// Keys can be any valid string, but must be unique for every request.
    idempotency-key: string,
    reward: loyalty-reward
  }
  create-loyalty-reward: func(params: create-loyalty-reward-params) -> result<string, string>;

  /// SearchLoyaltyRewards
  record search-loyalty-rewards-params {
    /// A pagination cursor returned by a previous call to 
    /// this endpoint. Provide this to retrieve the next set of 
    cursor: option<string>,
    /// The maximum number of results to return in the response.
    limit: option<s32>,
    query: option<search-loyalty-rewards-request-loyalty-reward-query>
  }
  search-loyalty-rewards: func(params: search-loyalty-rewards-params) -> result<string, string>;

  /// RetrieveLoyaltyReward
  record retrieve-loyalty-reward-params {
    /// The ID of the [loyalty reward](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyReward) to retrieve.
    reward-id: string
  }
  retrieve-loyalty-reward: func(params: retrieve-loyalty-reward-params) -> result<string, string>;

  /// DeleteLoyaltyReward
  record delete-loyalty-reward-params {
    /// The ID of the [loyalty reward](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyReward) to delete.
    reward-id: string
  }
  delete-loyalty-reward: func(params: delete-loyalty-reward-params) -> result<string, string>;

  /// RedeemLoyaltyReward
  record redeem-loyalty-reward-params {
    /// The ID of the [loyalty reward](https://developer.squareup.com/reference/square_2021-08-18/objects/LoyaltyReward) to redeem.
    reward-id: string,
    /// A unique string that identifies this `RedeemLoyaltyReward` request. 
    /// Keys can be any valid string, but must be unique for every request.
    idempotency-key: string,
    /// The ID of the [location](https://developer.squareup.com/reference/square_2021-08-18/objects/Location) where the reward is redeemed.
    location-id: string
  }
  redeem-loyalty-reward: func(params: redeem-loyalty-reward-params) -> result<string, string>;

}

interface merchants {
  /// ListMerchants
  record list-merchants-params {
    /// The cursor generated by the previous response.
    cursor: option<s32>
  }
  list-merchants: func(params: list-merchants-params) -> result<string, string>;

  /// RetrieveMerchant
  record retrieve-merchant-params {
    /// The ID of the merchant to retrieve. If the string "me" is supplied as the ID,
    /// then retrieve the merchant that is currently accessible to this call.
    merchant-id: string
  }
  retrieve-merchant: func(params: retrieve-merchant-params) -> result<string, string>;

}

interface orders {
  /// Contains all information related to a single order to process with Square,
  /// including line items that specify the products to purchase. `Order` objects also
  /// include information about any associated tenders, refunds, and returns.
  /// 
  /// All Connect V2 Transactions have all been converted to Orders including all associated
  /// itemization data.
  record order {
    /// The timestamp for when the order reached a terminal [state](https://developer.squareup.com/reference/square_2021-08-18/enums/OrderState), in RFC 3339 format (for example "2016-09-04T23:59:33.123Z").
    closed-at: option<string>,
    /// The timestamp for when the order was created, in RFC 3339 format (for example, "2016-09-04T23:59:33.123Z").
    created-at: option<string>,
    /// The ID of the [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) associated with the order.
    /// 
    customer-id: option<string>,
    /// The list of all discounts associated with the order.
    /// 
    discounts: option<list<order-line-item-discount>>,
    /// Details about order fulfillment.
    /// 
    fulfillments: option<list<order-fulfillment>>,
    /// The order's unique ID.
    id: option<string>,
    /// The line items included in the order.
    line-items: option<list<order-line-item>>,
    /// The ID of the seller location that this order is associated with.
    location-id: string,
    /// Application-defined data attached to this order. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-metadata>,
    net-amounts: option<order-money-amounts>,
    pricing-options: option<order-pricing-options>,
    /// A client-specified ID to associate an entity in another system
    /// with this order.
    reference-id: option<string>,
    /// The refunds that are part of this order.
    refunds: option<list<refund>>,
    return-amounts: option<order-money-amounts>,
    /// A collection of items from sale orders being returned in this one. Normally part of an
    /// itemized return or exchange. There is exactly one `Return` object per sale `Order` being
    returns: option<list<order-return>>,
    /// A set-like list of Rewards that have been added to the Order.
    rewards: option<list<order-reward>>,
    rounding-adjustment: option<order-rounding-adjustment>,
    /// A list of service charges applied to the order.
    service-charges: option<list<order-service-charge>>,
    source: option<order-source>,
    /// The current state of the order: `OPEN`, `COMPLETED`, or `CANCELED`.
    state: option<string>,
    /// The list of all taxes associated with the order.
    /// 
    taxes: option<list<order-line-item-tax>>,
    /// The tenders that were used to pay for the order.
    tenders: option<list<tender>>,
    total-discount-money: option<money>,
    total-money: option<money>,
    total-service-charge-money: option<money>,
    total-tax-money: option<money>,
    total-tip-money: option<money>,
    /// The timestamp for when the order was last updated, in RFC 3339 format (for example, "2016-09-04T23:59:33.123Z").
    updated-at: option<string>,
    /// The version number, which is incremented each time an update is committed to the order.
    /// Orders not created through the API do not include a version number and
    version: option<s32>
  }

  /// Represents a discount that applies to one or more line items in an
  /// order.
  /// 
  /// Fixed-amount, order-scoped discounts are distributed across all non-zero line item totals.
  /// The amount distributed to each line item is relative to the
  /// amount contributed by the item to the order subtotal.
  record order-line-item-discount {
    amount-money: option<money>,
    applied-money: option<money>,
    /// The catalog object ID referencing [CatalogDiscount](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogDiscount).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this discount references.
    catalog-version: option<s64>,
    /// Application-defined data attached to this discount. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-line-item-discount-metadata>,
    /// The discount's name.
    name: option<string>,
    /// The percentage of the discount, as a string representation of a decimal number.
    /// A value of `7.25` corresponds to a percentage of 7.25%.
    percentage: option<string>,
    /// The object ID of a [pricing rule](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogPricingRule) to be applied 
    /// automatically to this discount. The specification and application of the discounts, to 
    pricing-rule-id: option<string>,
    /// The reward IDs corresponding to this discount. The application and
    /// specification of discounts that have `reward_ids` are completely controlled by the backing
    reward-ids: option<list<string>>,
    /// Indicates the level at which the discount applies. For `ORDER` scoped discounts,
    /// Square generates references in `applied_discounts` on all order line items that do
    scope: option<string>,
    /// The type of the discount.
    /// 
    type-op: option<string>,
    /// A unique ID that identifies the discount only within this order.
    uid: option<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Application-defined data attached to this discount. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-line-item-discount-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Contains details about how to fulfill this order.
  record order-fulfillment {
    /// Application-defined data attached to this fulfillment. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-fulfillment-metadata>,
    pickup-details: option<order-fulfillment-pickup-details>,
    shipment-details: option<order-fulfillment-shipment-details>,
    /// The state of the fulfillment.
    state: option<string>,
    /// The type of the fulfillment.
    type-op: option<string>,
    /// A unique ID that identifies the fulfillment only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this fulfillment. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-fulfillment-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Contains details necessary to fulfill a pickup order.
  record order-fulfillment-pickup-details {
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment was accepted. The timestamp must be in RFC 3339 format
    accepted-at: option<string>,
    /// The duration of time after which an open and accepted pickup fulfillment
    /// is automatically moved to the `COMPLETED` state. The duration must be in RFC 3339
    auto-complete-duration: option<string>,
    /// A description of why the pickup was canceled. The maximum length: 100 characters.
    cancel-reason: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment was canceled. The timestamp must be in RFC 3339 format
    canceled-at: option<string>,
    curbside-pickup-details: option<order-fulfillment-pickup-details-curbside-pickup-details>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the fulfillment expired. The timestamp must be in RFC 3339 format
    expired-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when this fulfillment expires if it is not accepted. The timestamp must be in RFC 3339 format
    expires-at: option<string>,
    /// If set to `true`, indicates that this pickup order is for curbside pickup, not in-store pickup.
    is-curbside-pickup: option<bool>,
    /// A note meant to provide additional instructions about the pickup
    /// fulfillment displayed in the Square Point of Sale application and set by the API.
    note: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the fulfillment was picked up by the recipient. The timestamp must be in RFC 3339 format
    picked-up-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// that represents the start of the pickup window. Must be in RFC 3339 timestamp format, e.g., 
    pickup-at: option<string>,
    /// The window of time in which the order should be picked up after the `pickup_at` timestamp.
    /// Must be in RFC 3339 duration format, e.g., "P1W3D". Can be used as an
    pickup-window-duration: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment was placed. The timestamp must be in RFC 3339 format
    placed-at: option<string>,
    /// The duration of time it takes to prepare this fulfillment.
    /// The duration must be in RFC 3339 format (for example, "P1W3D").
    prep-time-duration: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment is marked as ready for pickup. The timestamp must be in RFC 3339 format
    ready-at: option<string>,
    recipient: option<order-fulfillment-recipient>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the fulfillment was rejected. The timestamp must be in RFC 3339 format
    rejected-at: option<string>,
    /// The schedule type of the pickup fulfillment. Defaults to `SCHEDULED`.
    schedule-type: option<string>
  }

  /// Specific details for curbside pickup.
  record order-fulfillment-pickup-details-curbside-pickup-details {
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates) 
    /// indicating when the buyer arrived and is waiting for pickup. The timestamp must be in RFC 3339 format
    buyer-arrived-at: option<string>,
    /// Specific details for curbside pickup, such as parking number and vehicle model.
    curbside-details: option<string>
  }

  /// Contains information about the recipient of a fulfillment.
  record order-fulfillment-recipient {
    address: option<address>,
    /// The customer ID of the customer associated with the fulfillment.
    /// 
    customer-id: option<string>,
    /// The display name of the fulfillment recipient.
    /// 
    display-name: option<string>,
    /// The email address of the fulfillment recipient.
    /// 
    email-address: option<string>,
    /// The phone number of the fulfillment recipient.
    /// 
    phone-number: option<string>
  }

  /// Represents a postal address in a country. The address format is based 
  /// on an [open-source library from Google](https://github.com/google/libaddressinput). For more information, 
  /// see [AddressValidationMetadata](https://github.com/google/libaddressinput/wiki/AddressValidationMetadata). 
  /// This format has dedicated fields for four address components: postal code, 
  /// locality (city), administrative district (state, prefecture, or province), and 
  /// sublocality (town or village). These components have dedicated fields in the 
  /// `Address` object because software sometimes behaves differently based on them. 
  /// For example, sales tax software may charge different amounts of sales tax 
  /// based on the postal code, and some software is only available in 
  /// certain states due to compliance reasons.
  /// 
  /// For the remaining address components, the `Address` type provides the 
  /// `address_line_1` and `address_line_2` fields for free-form data entry. 
  /// These fields are free-form because the remaining address components have 
  /// too many variations around the world and typical software does not parse 
  /// these components. These fields enable users to enter anything they want. 
  /// 
  /// Note that, in the current implementation, all other `Address` type fields are blank. 
  /// These include `address_line_3`, `sublocality_2`, `sublocality_3`, 
  /// `administrative_district_level_2`, `administrative_district_level_3`, 
  /// `first_name`, `last_name`, and `organization`. 
  /// 
  /// When it comes to localization, the seller's language preferences 
  /// (see [Language preferences](https://developer.squareup.com/docs/locations-api#location-specific-and-seller-level-language-preferences)) 
  /// are ignored for addresses. Even though Square products (such as Square Point of Sale 
  /// and the Seller Dashboard) mostly use a seller's language preference in 
  /// communication, when it comes to addresses, they will use English for a US address, 
  /// Japanese for an address in Japan, and so on.
  record address {
    /// The first line of the address.
    /// 
    address-line-v1: option<string>,
    /// The second line of the address, if any.
    address-line-v2: option<string>,
    /// The third line of the address, if any.
    address-line-v3: option<string>,
    /// A civil entity within the address's country. In the US, this
    /// is the state.
    administrative-district-level-v1: option<string>,
    /// A civil entity within the address's `administrative_district_level_1`.
    /// In the US, this is the county.
    administrative-district-level-v2: option<string>,
    /// A civil entity within the address's `administrative_district_level_2`,
    /// if any.
    administrative-district-level-v3: option<string>,
    /// The address's country, in ISO 3166-1-alpha-2 format.
    country: option<string>,
    /// Optional first name when it's representing recipient.
    first-name: option<string>,
    /// Optional last name when it's representing recipient.
    last-name: option<string>,
    /// The city or town of the address.
    locality: option<string>,
    /// Optional organization name when it's representing recipient.
    organization: option<string>,
    /// The address's postal code.
    postal-code: option<string>,
    /// A civil region within the address's `locality`, if any.
    sublocality: option<string>,
    /// A civil region within the address's `sublocality`, if any.
    sublocality-v2: option<string>,
    /// A civil region within the address's `sublocality_2`, if any.
    sublocality-v3: option<string>
  }

  /// Contains the details necessary to fulfill a shipment order.
  record order-fulfillment-shipment-details {
    /// A description of why the shipment was canceled.
    cancel-reason: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating the shipment was canceled.
    canceled-at: option<string>,
    /// The shipping carrier being used to ship this fulfillment (such as UPS, FedEx, or USPS).
    carrier: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the shipment is expected to be delivered to the shipping carrier.
    expected-shipped-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the shipment failed to be completed. The timestamp must be in RFC 3339 format
    failed-at: option<string>,
    /// A description of why the shipment failed to be completed.
    failure-reason: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when this fulfillment was moved to the `RESERVED` state, which  indicates that preparation
    in-progress-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when this fulfillment was moved to the `PREPARED` state, which indicates that the
    packaged-at: option<string>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when the shipment was requested. The timestamp must be in RFC 3339 format
    placed-at: option<string>,
    recipient: option<order-fulfillment-recipient>,
    /// The [timestamp](https://developer.squareup.com/docs/build-basics/working-with-dates)
    /// indicating when this fulfillment was moved to the `COMPLETED` state, which indicates that
    shipped-at: option<string>,
    /// A note with additional information for the shipping carrier.
    shipping-note: option<string>,
    /// A description of the type of shipping product purchased from the carrier
    /// (such as First Class, Priority, or Express).
    shipping-type: option<string>,
    /// The reference number provided by the carrier to track the shipment's progress.
    tracking-number: option<string>,
    /// A link to the tracking webpage on the carrier's website.
    tracking-url: option<string>
  }

  /// Represents a line item in an order. Each line item describes a different
  /// product to purchase, with its own quantity and price details.
  record order-line-item {
    /// The list of references to discounts applied to this line item. Each
    /// `OrderLineItemAppliedDiscount` has a `discount_uid` that references the `uid` of a top-level
    applied-discounts: option<list<order-line-item-applied-discount>>,
    /// The list of references to taxes applied to this line item. Each
    /// `OrderLineItemAppliedTax` has a `tax_uid` that references the `uid` of a
    applied-taxes: option<list<order-line-item-applied-tax>>,
    base-price-money: option<money>,
    /// The [CatalogItemVariation](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogItemVariation) ID applied to this line item.
    catalog-object-id: option<string>,
    /// The version of the catalog object that this line item references.
    catalog-version: option<s64>,
    gross-sales-money: option<money>,
    /// The type of line item: an itemized sale, a non-itemized sale (custom amount), or the
    /// activation or reloading of a gift card.
    item-type: option<string>,
    /// Application-defined data attached to this line item. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-line-item-metadata>,
    /// The [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier)s applied to this line item.
    modifiers: option<list<order-line-item-modifier>>,
    /// The name of the line item.
    name: option<string>,
    /// The note of the line item.
    note: option<string>,
    pricing-blocklists: option<order-line-item-pricing-blocklists>,
    /// The quantity purchased, formatted as a decimal number.
    /// For example, `"3"`.
    quantity: string,
    quantity-unit: option<order-quantity-unit>,
    total-discount-money: option<money>,
    total-money: option<money>,
    total-tax-money: option<money>,
    /// A unique ID that identifies the line item only within this order.
    uid: option<string>,
    /// The name of the variation applied to this line item.
    variation-name: option<string>,
    variation-total-price-money: option<money>
  }

  /// Represents an applied portion of a discount to a line item in an order.
  /// 
  /// Order scoped discounts have automatically applied discounts present for each line item.
  /// Line-item scoped discounts must have applied discounts added manually for any applicable line
  /// items. The corresponding applied money is automatically computed based on participating
  /// line items.
  record order-line-item-applied-discount {
    applied-money: option<money>,
    /// The `uid` of the discount that the applied discount represents. It must
    /// reference a discount present in the `order.discounts` field.
    discount-uid: string,
    /// A unique ID that identifies the applied discount only within this order.
    uid: option<string>
  }

  /// Represents an applied portion of a tax to a line item in an order.
  /// 
  /// Order-scoped taxes automatically include the applied taxes in each line item.
  /// Line item taxes must be referenced from any applicable line items.
  /// The corresponding applied money is automatically computed, based on the
  /// set of participating line items.
  record order-line-item-applied-tax {
    applied-money: option<money>,
    /// The `uid` of the tax for which this applied tax represents. It must reference
    /// a tax present in the `order.taxes` field.
    tax-uid: string,
    /// A unique ID that identifies the applied tax only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this line item. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-line-item-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier).
  record order-line-item-modifier {
    base-price-money: option<money>,
    /// The catalog object ID referencing [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this modifier references.
    catalog-version: option<s64>,
    /// The name of the item modifier.
    name: option<string>,
    total-price-money: option<money>,
    /// A unique ID that identifies the modifier only within this order.
    uid: option<string>
  }

  /// Describes pricing adjustments that are blocked from manual and 
  /// automatic application to a line item. For more information, see 
  /// [Apply Taxes and Discounts](https://developer.squareup.com/docs/orders-api/apply-taxes-and-discounts).
  record order-line-item-pricing-blocklists {
    /// A list of discounts blocked from applying to the line item. 
    /// Discounts can be blocked by the `discount_uid` (for ad hoc discounts) or 
    blocked-discounts: option<list<order-line-item-pricing-blocklists-blocked-discount>>,
    /// A list of taxes blocked from applying to the line item. 
    /// Taxes can be blocked by the `tax_uid` (for ad hoc taxes) or 
    blocked-taxes: option<list<order-line-item-pricing-blocklists-blocked-tax>>
  }

  /// A discount to block from applying to a line item. The discount must be 
  /// identified by either `discount_uid` or `discount_catalog_object_id`, but not both.
  record order-line-item-pricing-blocklists-blocked-discount {
    /// The `catalog_object_id` of the discount that should be blocked. 
    /// Use this field to block catalog discounts. For ad hoc discounts, use the 
    discount-catalog-object-id: option<string>,
    /// The `uid` of the discount that should be blocked. Use this field to block 
    /// ad hoc discounts. For catalog discounts, use the `discount_catalog_object_id` field.
    discount-uid: option<string>,
    /// A unique ID of the `BlockedDiscount` within the order.
    uid: option<string>
  }

  /// A tax to block from applying to a line item. The tax must be 
  /// identified by either `tax_uid` or `tax_catalog_object_id`, but not both.
  record order-line-item-pricing-blocklists-blocked-tax {
    /// The `catalog_object_id` of the tax that should be blocked. 
    /// Use this field to block catalog taxes. For ad hoc taxes, use the 
    tax-catalog-object-id: option<string>,
    /// The `uid` of the tax that should be blocked. Use this field to block 
    /// ad hoc taxes. For catalog, taxes use the `tax_catalog_object_id` field.
    tax-uid: option<string>,
    /// A unique ID of the `BlockedTax` within the order.
    uid: option<string>
  }

  /// Contains the measurement unit for a quantity and a precision that
  /// specifies the number of digits after the decimal point for decimal quantities.
  record order-quantity-unit {
    /// The version of the catalog object that this measurement unit references.
    /// 
    catalog-version: option<s64>,
    measurement-unit: option<measurement-unit>,
    /// For non-integer quantities, represents the number of digits after the decimal point that are
    /// recorded for this quantity.
    precision: option<s32>
  }

  /// Represents a unit of measurement to use with a quantity, such as ounces
  /// or inches. Exactly one of the following fields are required: `custom_unit`,
  /// `area_unit`, `length_unit`, `volume_unit`, and `weight_unit`.
  record measurement-unit {
    /// Represents a standard area unit.
    area-unit: option<string>,
    custom-unit: option<measurement-unit-custom>,
    /// Reserved for API integrations that lack the ability to specify a real measurement unit
    generic-unit: option<string>,
    /// Represents a standard length unit.
    length-unit: option<string>,
    /// Represents a standard unit of time.
    time-unit: option<string>,
    /// Represents the type of the measurement unit.
    type-op: option<string>,
    /// Represents a standard volume unit.
    volume-unit: option<string>,
    /// Represents a standard unit of weight or mass.
    weight-unit: option<string>
  }

  /// The information needed to define a custom unit, provided by the seller.
  record measurement-unit-custom {
    /// The abbreviation of the custom unit, such as "bsh" (bushel). This appears
    /// in the cart for the Point of Sale app, and in reports.
    abbreviation: string,
    /// The name of the custom unit, for example "bushel".
    name: string
  }

  /// Application-defined data attached to this order. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see  [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A collection of various money amounts.
  record order-money-amounts {
    discount-money: option<money>,
    service-charge-money: option<money>,
    tax-money: option<money>,
    tip-money: option<money>,
    total-money: option<money>
  }

  /// Pricing options for an order. The options affect how the order's price is calculated.
  /// They can be used, for example, to apply automatic price adjustments that are based on preconfigured
  /// [pricing rules](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogPricingRule).
  record order-pricing-options {
    /// The option to determine whether pricing rule-based
    /// discounts are automatically applied to an order.
    auto-apply-discounts: option<bool>,
    /// The option to determine whether rule-based taxes are automatically
    /// applied to an order when the criteria of the corresponding rules are met.
    auto-apply-taxes: option<bool>
  }

  /// Represents a refund processed for a Square transaction.
  record refund {
    /// Additional recipients (other than the merchant) receiving a portion of this refund.
    /// For example, fees assessed on a refund of a purchase by a third party integration.
    additional-recipients: option<list<additional-recipient>>,
    amount-money: money,
    /// The timestamp for when the refund was created, in RFC 3339 format.
    created-at: option<string>,
    /// The refund's unique ID.
    id: string,
    /// The ID of the refund's associated location.
    location-id: string,
    processing-fee-money: option<money>,
    /// The reason for the refund being issued.
    reason: string,
    /// The current status of the refund (`PENDING`, `APPROVED`, `REJECTED`,
    /// or `FAILED`).
    status: string,
    /// The ID of the refunded tender.
    tender-id: string,
    /// The ID of the transaction that the refunded tender is part of.
    transaction-id: string
  }

  /// Represents an additional recipient (other than the merchant) receiving a portion of this tender.
  record additional-recipient {
    amount-money: money,
    /// The description of the additional recipient.
    description: option<string>,
    /// The location ID for a recipient (other than the merchant) receiving a portion of this tender.
    location-id: string,
    /// The unique ID for this [AdditionalRecipientReceivable](https://developer.squareup.com/reference/square_2021-08-18/objects/AdditionalRecipientReceivable), assigned by the server.
    receivable-id: option<string>
  }

  /// The set of line items, service charges, taxes, discounts, tips, and other items being returned in an order.
  record order-return {
    return-amounts: option<order-money-amounts>,
    /// A collection of references to discounts being returned for an order, including the total
    /// applied discount amount to be returned. The discounts must reference a top-level discount ID
    return-discounts: option<list<order-return-discount>>,
    /// A collection of line items that are being returned.
    return-line-items: option<list<order-return-line-item>>,
    /// A collection of service charges that are being returned.
    return-service-charges: option<list<order-return-service-charge>>,
    /// A collection of references to taxes being returned for an order, including the total
    /// applied tax amount to be returned. The taxes must reference a top-level tax ID from the source
    return-taxes: option<list<order-return-tax>>,
    rounding-adjustment: option<order-rounding-adjustment>,
    /// An order that contains the original sale of these return line items. This is unset
    /// for unlinked returns.
    source-order-id: option<string>,
    /// A unique ID that identifies the return only within this order.
    uid: option<string>
  }

  /// Represents a discount being returned that applies to one or more return line items in an
  /// order.
  /// 
  /// Fixed-amount, order-scoped discounts are distributed across all non-zero return line item totals.
  /// The amount distributed to each return line item is relative to that item’s contribution to the
  /// order subtotal.
  record order-return-discount {
    amount-money: option<money>,
    applied-money: option<money>,
    /// The catalog object ID referencing [CatalogDiscount](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogDiscount).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this discount references.
    catalog-version: option<s64>,
    /// The discount's name.
    name: option<string>,
    /// The percentage of the tax, as a string representation of a decimal number.
    /// A value of `"7.25"` corresponds to a percentage of 7.25%.
    percentage: option<string>,
    /// Indicates the level at which the `OrderReturnDiscount` applies. For `ORDER` scoped
    /// discounts, the server generates references in `applied_discounts` on all
    scope: option<string>,
    /// The discount `uid` from the order that contains the original application of this discount.
    source-discount-uid: option<string>,
    /// The type of the discount. If it is created by the API, it is `FIXED_PERCENTAGE` or `FIXED_AMOUNT`.
    /// 
    type-op: option<string>,
    /// A unique ID that identifies the returned discount only within this order.
    uid: option<string>
  }

  /// The line item being returned in an order.
  record order-return-line-item {
    /// The list of references to `OrderReturnDiscount` entities applied to the return line item. Each
    /// `OrderLineItemAppliedDiscount` has a `discount_uid` that references the `uid` of a top-level
    applied-discounts: option<list<order-line-item-applied-discount>>,
    /// The list of references to `OrderReturnTax` entities applied to the return line item. Each
    /// `OrderLineItemAppliedTax` has a `tax_uid` that references the `uid` of a top-level
    applied-taxes: option<list<order-line-item-applied-tax>>,
    base-price-money: option<money>,
    /// The [CatalogItemVariation](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogItemVariation) ID applied to this return line item.
    catalog-object-id: option<string>,
    /// The version of the catalog object that this line item references.
    catalog-version: option<s64>,
    gross-return-money: option<money>,
    /// The type of line item: an itemized return, a non-itemized return (custom amount),
    /// or the return of an unactivated gift card sale.
    item-type: option<string>,
    /// The name of the line item.
    name: option<string>,
    /// The note of the return line item.
    note: option<string>,
    /// The quantity returned, formatted as a decimal number.
    /// For example, `"3"`.
    quantity: string,
    quantity-unit: option<order-quantity-unit>,
    /// The [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier)s applied to this line item.
    return-modifiers: option<list<order-return-line-item-modifier>>,
    /// The `uid` of the line item in the original sale order.
    source-line-item-uid: option<string>,
    total-discount-money: option<money>,
    total-money: option<money>,
    total-tax-money: option<money>,
    /// A unique ID for this return line-item entry.
    uid: option<string>,
    /// The name of the variation applied to this return line item.
    variation-name: option<string>,
    variation-total-price-money: option<money>
  }

  /// A line item modifier being returned.
  record order-return-line-item-modifier {
    base-price-money: option<money>,
    /// The catalog object ID referencing [CatalogModifier](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogModifier).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this line item modifier references.
    catalog-version: option<s64>,
    /// The name of the item modifier.
    name: option<string>,
    /// The modifier `uid` from the order's line item that contains the
    /// original sale of this line item modifier.
    source-modifier-uid: option<string>,
    total-price-money: option<money>,
    /// A unique ID that identifies the return modifier only within this order.
    uid: option<string>
  }

  /// Represents the service charge applied to the original order.
  record order-return-service-charge {
    amount-money: option<money>,
    applied-money: option<money>,
    /// The list of references to `OrderReturnTax` entities applied to the
    /// `OrderReturnServiceCharge`. Each `OrderLineItemAppliedTax` has a `tax_uid`
    applied-taxes: option<list<order-line-item-applied-tax>>,
    /// The calculation phase after which to apply the service charge.
    calculation-phase: option<string>,
    /// The catalog object ID of the associated [OrderServiceCharge](https://developer.squareup.com/reference/square_2021-08-18/objects/OrderServiceCharge).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this service charge references.
    catalog-version: option<s64>,
    /// The name of the service charge.
    name: option<string>,
    /// The percentage of the service charge, as a string representation of
    /// a decimal number. For example, a value of `"7.25"` corresponds to a
    percentage: option<string>,
    /// The service charge `uid` from the order containing the original
    /// service charge. `source_service_charge_uid` is `null` for
    source-service-charge-uid: option<string>,
    /// Indicates whether the surcharge can be taxed. Service charges
    /// calculated in the `TOTAL_PHASE` cannot be marked as taxable.
    taxable: option<bool>,
    total-money: option<money>,
    total-tax-money: option<money>,
    /// A unique ID that identifies the return service charge only within this order.
    uid: option<string>
  }

  /// Represents a tax being returned that applies to one or more return line items in an order.
  /// 
  /// Fixed-amount, order-scoped taxes are distributed across all non-zero return line item totals.
  /// The amount distributed to each return line item is relative to that item’s contribution to the
  /// order subtotal.
  record order-return-tax {
    applied-money: option<money>,
    /// The catalog object ID referencing [CatalogTax](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogTax).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this tax references.
    catalog-version: option<s64>,
    /// The tax's name.
    name: option<string>,
    /// The percentage of the tax, as a string representation of a decimal number.
    /// For example, a value of `"7.25"` corresponds to a percentage of 7.25%.
    percentage: option<string>,
    /// Indicates the level at which the `OrderReturnTax` applies. For `ORDER` scoped
    /// taxes, Square generates references in `applied_taxes` on all
    scope: option<string>,
    /// The tax `uid` from the order that contains the original tax charge.
    source-tax-uid: option<string>,
    /// Indicates the calculation method used to apply the tax.
    type-op: option<string>,
    /// A unique ID that identifies the returned tax only within this order.
    uid: option<string>
  }

  /// A rounding adjustment of the money being returned. Commonly used to apply cash rounding
  /// when the minimum unit of the account is smaller than the lowest physical denomination of the currency.
  record order-rounding-adjustment {
    amount-money: option<money>,
    /// The name of the rounding adjustment from the original sale order.
    name: option<string>,
    /// A unique ID that identifies the rounding adjustment only within this order.
    uid: option<string>
  }

  /// Represents a reward that can be applied to an order if the necessary
  /// reward tier criteria are met. Rewards are created through the Loyalty API.
  record order-reward {
    /// The identifier of the reward.
    id: string,
    /// The identifier of the reward tier corresponding to this reward.
    reward-tier-id: string
  }

  /// Represents a service charge applied to an order.
  record order-service-charge {
    amount-money: option<money>,
    applied-money: option<money>,
    /// The list of references to the taxes applied to this service charge. Each
    /// `OrderLineItemAppliedTax` has a `tax_uid` that references the `uid` of a top-level
    applied-taxes: option<list<order-line-item-applied-tax>>,
    /// The calculation phase at which to apply the service charge.
    calculation-phase: option<string>,
    /// The catalog object ID referencing the service charge [CatalogObject](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogObject).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this service charge references.
    catalog-version: option<s64>,
    /// Application-defined data attached to this service charge. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-service-charge-metadata>,
    /// The name of the service charge.
    name: option<string>,
    /// The service charge percentage as a string representation of a
    /// decimal number. For example, `"7.25"` indicates a service charge of 7.25%.
    percentage: option<string>,
    /// Indicates whether the service charge can be taxed. If set to `true`,
    /// order-level taxes automatically apply to the service charge. Note that
    taxable: option<bool>,
    total-money: option<money>,
    total-tax-money: option<money>,
    /// The type of the service charge.
    type-op: option<string>,
    /// A unique ID that identifies the service charge only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this service charge. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-service-charge-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents the origination details of an order.
  record order-source {
    /// The name used to identify the place (physical or digital) that an order originates.
    /// If unset, the name defaults to the name of the application that created the order.
    name: option<string>
  }

  /// Represents a tax that applies to one or more line item in the order.
  /// 
  /// Fixed-amount, order-scoped taxes are distributed across all non-zero line item totals.
  /// The amount distributed to each line item is relative to the amount the item
  /// contributes to the order subtotal.
  record order-line-item-tax {
    applied-money: option<money>,
    /// Determines whether the tax was automatically applied to the order based on
    /// the catalog configuration. For an example, see 
    auto-applied: option<bool>,
    /// The catalog object ID referencing [CatalogTax](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogTax).
    catalog-object-id: option<string>,
    /// The version of the catalog object that this tax references.
    catalog-version: option<s64>,
    /// Application-defined data attached to this tax. Metadata fields are intended
    /// to store descriptive references or associations with an entity in another system or store brief
    metadata: option<order-line-item-tax-metadata>,
    /// The tax's name.
    name: option<string>,
    /// The percentage of the tax, as a string representation of a decimal
    /// number. For example, a value of `"7.25"` corresponds to a percentage of
    percentage: option<string>,
    /// Indicates the level at which the tax applies. For `ORDER` scoped taxes,
    /// Square generates references in `applied_taxes` on all order line items that do
    scope: option<string>,
    /// Indicates the calculation method used to apply the tax.
    type-op: option<string>,
    /// A unique ID that identifies the tax only within this order.
    uid: option<string>
  }

  /// Application-defined data attached to this tax. Metadata fields are intended
  /// to store descriptive references or associations with an entity in another system or store brief
  /// information about the object. Square does not process this field; it only stores and returns it
  /// in relevant API calls. Do not use metadata to store any sensitive information (such as personally
  /// identifiable information or card details).
  /// 
  /// Keys written by applications must be 60 characters or less and must be in the character set
  /// `[a-zA-Z0-9_-]`. Entries can also include metadata generated by Square. These keys are prefixed
  /// with a namespace, separated from the key with a ':' character.
  /// 
  /// Values have a maximum length of 255 characters.
  /// 
  /// An application can have up to 10 entries per metadata field.
  /// 
  /// Entries written by applications are private and can only be read or modified by the same
  /// application.
  /// 
  /// For more information, see [Metadata](https://developer.squareup.com/docs/build-basics/metadata).
  record order-line-item-tax-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents a tender (i.e., a method of payment) used in a Square transaction.
  record tender {
    /// Additional recipients (other than the merchant) receiving a portion of this tender.
    /// For example, fees assessed on the purchase by a third party integration.
    additional-recipients: option<list<additional-recipient>>,
    amount-money: option<money>,
    card-details: option<tender-card-details>,
    cash-details: option<tender-cash-details>,
    /// The timestamp for when the tender was created, in RFC 3339 format.
    created-at: option<string>,
    /// If the tender is associated with a customer or represents a customer's card on file,
    /// this is the ID of the associated customer.
    customer-id: option<string>,
    /// The tender's unique ID.
    id: option<string>,
    /// The ID of the transaction's associated location.
    location-id: option<string>,
    /// An optional note associated with the tender at the time of payment.
    note: option<string>,
    /// The ID of the [Payment](https://developer.squareup.com/reference/square_2021-08-18/objects/Payment) that corresponds to this tender.
    /// This value is only present for payments created with the v2 Payments API.
    payment-id: option<string>,
    processing-fee-money: option<money>,
    tip-money: option<money>,
    /// The ID of the tender's associated transaction.
    transaction-id: option<string>,
    /// The type of tender, such as `CARD` or `CASH`.
    type-op: string
  }

  /// Represents additional details of a tender with `type` `CARD` or `SQUARE_GIFT_CARD`
  record tender-card-details {
    card: option<card>,
    /// The method used to enter the card's details for the transaction.
    entry-method: option<string>,
    /// The credit card payment's current state (such as `AUTHORIZED` or
    /// `CAPTURED`). See [TenderCardDetailsStatus](https://developer.squareup.com/reference/square_2021-08-18/objects/TenderCardDetailsStatus)
    status: option<string>
  }

  /// Represents the payment details of a card to be used for payments. These
  /// details are determined by the payment token generated by Web Payments SDK.
  record card {
    billing-address: option<address>,
    /// The first six digits of the card number, known as the Bank Identification Number (BIN). Only the Payments API
    /// returns this field.
    bin: option<string>,
    /// The card's brand.
    card-brand: option<string>,
    /// The type of the card.
    /// The Card object includes this field only in response to Payments API calls.
    card-type: option<string>,
    /// The name of the cardholder.
    cardholder-name: option<string>,
    /// The ID of a customer created using the Customers API to be associated with the card.
    customer-id: option<string>,
    /// Indicates whether or not a card can be used for payments.
    enabled: option<bool>,
    /// The expiration month of the associated card as an integer between 1 and 12.
    exp-month: option<s64>,
    /// The four-digit year of the card's expiration date.
    exp-year: option<s64>,
    /// __Not currently set.__ Intended as a Square-assigned identifier, based
    /// on the card number, to identify the card across multiple locations within a
    fingerprint: option<string>,
    /// Unique ID for this card. Generated by Square.
    id: option<string>,
    /// The last 4 digits of the card number.
    last-v4: option<string>,
    /// Indicates whether the Card is prepaid or not.
    /// The Card object includes this field only in response to Payments API calls.
    prepaid-type: option<string>,
    /// An optional user-defined reference ID that associates this card with
    /// another entity in an external system. For example, a customer ID from an
    reference-id: option<string>,
    /// Current version number of the card. Increments with each card update. Requests to update an
    /// existing Card object will be rejected unless the version in the request matches the current
    version: option<s64>
  }

  /// Represents the details of a tender with `type` `CASH`.
  record tender-cash-details {
    buyer-tendered-money: option<money>,
    change-back-money: option<money>
  }

  /// Contains query criteria for the search.
  record search-orders-query {
    filter: option<search-orders-filter>,
    sort: option<search-orders-sort>
  }

  /// Filtering criteria to use for a `SearchOrders` request. Multiple filters
  /// are ANDed together.
  record search-orders-filter {
    customer-filter: option<search-orders-customer-filter>,
    date-time-filter: option<search-orders-date-time-filter>,
    fulfillment-filter: option<search-orders-fulfillment-filter>,
    source-filter: option<search-orders-source-filter>,
    state-filter: option<search-orders-state-filter>
  }

  /// A filter based on the order `customer_id` and any tender `customer_id`
  /// associated with the order. It does not filter based on the
  /// [FulfillmentRecipient](https://developer.squareup.com/reference/square_2021-08-18/objects/OrderFulfillmentRecipient) `customer_id`.
  record search-orders-customer-filter {
    /// A list of customer IDs to filter by.
    /// 
    customer-ids: option<list<string>>
  }

  /// Filter for `Order` objects based on whether their `CREATED_AT`,
  /// `CLOSED_AT`, or `UPDATED_AT` timestamps fall within a specified time range.
  /// You can specify the time range and which timestamp to filter for. You can filter
  /// for only one time range at a time.
  /// 
  /// For each time range, the start time and end time are inclusive. If the end time
  /// is absent, it defaults to the time of the first request for the cursor.
  /// 
  /// __Important:__ If you use the `DateTimeFilter` in a `SearchOrders` query,
  /// you must set the `sort_field` in [OrdersSort](https://developer.squareup.com/reference/square_2021-08-18/objects/SearchOrdersSort)
  /// to the same field you filter for. For example, if you set the `CLOSED_AT` field
  /// in `DateTimeFilter`, you must set the `sort_field` in `SearchOrdersSort` to
  /// `CLOSED_AT`. Otherwise, `SearchOrders` throws an error.
  /// [Learn more about filtering orders by time range.](https://developer.squareup.com/docs/orders-api/manage-orders#important-note-on-filtering-orders-by-time-range)
  record search-orders-date-time-filter {
    closed-at: option<time-range>,
    created-at: option<time-range>,
    updated-at: option<time-range>
  }

  /// Represents a generic time range. The start and end values are
  /// represented in RFC 3339 format. Time ranges are customized to be
  /// inclusive or exclusive based on the needs of a particular endpoint.
  /// Refer to the relevant endpoint-specific documentation to determine
  /// how time ranges are handled.
  record time-range {
    /// A datetime value in RFC 3339 format indicating when the time range
    /// ends.
    end-at: option<string>,
    /// A datetime value in RFC 3339 format indicating when the time range
    /// starts.
    start-at: option<string>
  }

  /// Filter based on [order fulfillment](https://developer.squareup.com/reference/square_2021-08-18/objects/OrderFulfillment) information.
  record search-orders-fulfillment-filter {
    /// A list of [fulfillment states](https://developer.squareup.com/reference/square_2021-08-18/objects/OrderFulfillmentState) to filter
    /// for. The list returns orders if any of its fulfillments match any of the
    fulfillment-states: option<list<string>>,
    /// A list of [fulfillment types](https://developer.squareup.com/reference/square_2021-08-18/enums/OrderFulfillmentType) to filter
    /// for. The list returns orders if any of its fulfillments match any of the fulfillment types
    fulfillment-types: option<list<string>>
  }

  /// A filter based on order `source` information.
  record search-orders-source-filter {
    /// Filters by the [Source](https://developer.squareup.com/reference/square_2021-08-18/objects/OrderSource) `name`. The filter returns any orders
    /// with a `source.name` that matches any of the listed source names.
    source-names: option<list<string>>
  }

  /// Filter by the current order `state`.
  record search-orders-state-filter {
    /// States to filter for.
    states: list<string>
  }

  /// Sorting criteria for a `SearchOrders` request. Results can only be sorted
  /// by a timestamp field.
  record search-orders-sort {
    /// The field to sort by.
    /// 
    sort-field: string,
    /// The chronological order in which results are returned. Defaults to `DESC`.
    sort-order: option<string>
  }

  /// CreateOrder
  record create-order-params {
    /// A value you specify that uniquely identifies this
    /// order among orders you have created.
    idempotency-key: option<string>,
    order: option<order>
  }
  create-order: func(params: create-order-params) -> result<string, string>;

  /// BatchRetrieveOrders
  record batch-retrieve-orders-params {
    /// The ID of the location for these orders. This field is optional: omit it to retrieve
    /// orders within the scope of the current authorization's merchant ID.
    location-id: option<string>,
    /// The IDs of the orders to retrieve. A maximum of 100 orders can be retrieved per request.
    order-ids: list<string>
  }
  batch-retrieve-orders: func(params: batch-retrieve-orders-params) -> result<string, string>;

  /// CalculateOrder
  record calculate-order-params {
    order: order,
    /// Identifies one or more loyalty reward tiers to apply during the order calculation.
    /// The discounts defined by the reward tiers are added to the order only to preview the
    proposed-rewards: option<list<order-reward>>
  }
  calculate-order: func(params: calculate-order-params) -> result<string, string>;

  /// SearchOrders
  record search-orders-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// The maximum number of results to be returned in a single page. It is
    /// possible to receive fewer results than the specified limit on a given page.
    limit: option<s32>,
    /// The location IDs for the orders to query. All locations must belong to
    /// the same merchant.
    location-ids: option<list<string>>,
    query: option<search-orders-query>,
    /// A Boolean that controls the format of the search results. If `true`,
    /// `SearchOrders` returns [OrderEntry](https://developer.squareup.com/reference/square_2021-08-18/objects/OrderEntry) objects. If `false`, `SearchOrders`
    return-entries: option<bool>
  }
  search-orders: func(params: search-orders-params) -> result<string, string>;

  /// RetrieveOrder
  record get-v2-orders-order-id-params {
    /// The ID of the order to retrieve.
    order-id: string
  }
  get-v2-orders-order-id: func(params: get-v2-orders-order-id-params) -> result<string, string>;

  /// UpdateOrder
  record put-v2-orders-order-id-params {
    /// The ID of the order to update.
    order-id: string,
    /// The [dot notation paths](https://developer.squareup.com/docs/orders-api/manage-orders#on-dot-notation)
    /// fields to clear. For example, `line_items[uid].note`.
    fields-to-clear: option<list<string>>,
    /// A value you specify that uniquely identifies this update request.
    /// 
    idempotency-key: option<string>,
    order: option<order>
  }
  put-v2-orders-order-id: func(params: put-v2-orders-order-id-params) -> result<string, string>;

  /// PayOrder
  record pay-order-params {
    /// The ID of the order being paid.
    order-id: string,
    /// A value you specify that uniquely identifies this request among requests you have sent. If
    /// you are unsure whether a particular payment request was completed successfully, you can reattempt
    idempotency-key: string,
    /// The version of the order being paid. If not supplied, the latest version will be paid.
    order-version: option<s32>,
    /// The IDs of the [payments](https://developer.squareup.com/reference/square_2021-08-18/objects/Payment) to collect.
    /// The payment total must match the order total.
    payment-ids: option<list<string>>
  }
  pay-order: func(params: pay-order-params) -> result<string, string>;

}

interface payments {
  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Represents a postal address in a country. The address format is based 
  /// on an [open-source library from Google](https://github.com/google/libaddressinput). For more information, 
  /// see [AddressValidationMetadata](https://github.com/google/libaddressinput/wiki/AddressValidationMetadata). 
  /// This format has dedicated fields for four address components: postal code, 
  /// locality (city), administrative district (state, prefecture, or province), and 
  /// sublocality (town or village). These components have dedicated fields in the 
  /// `Address` object because software sometimes behaves differently based on them. 
  /// For example, sales tax software may charge different amounts of sales tax 
  /// based on the postal code, and some software is only available in 
  /// certain states due to compliance reasons.
  /// 
  /// For the remaining address components, the `Address` type provides the 
  /// `address_line_1` and `address_line_2` fields for free-form data entry. 
  /// These fields are free-form because the remaining address components have 
  /// too many variations around the world and typical software does not parse 
  /// these components. These fields enable users to enter anything they want. 
  /// 
  /// Note that, in the current implementation, all other `Address` type fields are blank. 
  /// These include `address_line_3`, `sublocality_2`, `sublocality_3`, 
  /// `administrative_district_level_2`, `administrative_district_level_3`, 
  /// `first_name`, `last_name`, and `organization`. 
  /// 
  /// When it comes to localization, the seller's language preferences 
  /// (see [Language preferences](https://developer.squareup.com/docs/locations-api#location-specific-and-seller-level-language-preferences)) 
  /// are ignored for addresses. Even though Square products (such as Square Point of Sale 
  /// and the Seller Dashboard) mostly use a seller's language preference in 
  /// communication, when it comes to addresses, they will use English for a US address, 
  /// Japanese for an address in Japan, and so on.
  record address {
    /// The first line of the address.
    /// 
    address-line-v1: option<string>,
    /// The second line of the address, if any.
    address-line-v2: option<string>,
    /// The third line of the address, if any.
    address-line-v3: option<string>,
    /// A civil entity within the address's country. In the US, this
    /// is the state.
    administrative-district-level-v1: option<string>,
    /// A civil entity within the address's `administrative_district_level_1`.
    /// In the US, this is the county.
    administrative-district-level-v2: option<string>,
    /// A civil entity within the address's `administrative_district_level_2`,
    /// if any.
    administrative-district-level-v3: option<string>,
    /// The address's country, in ISO 3166-1-alpha-2 format.
    country: option<string>,
    /// Optional first name when it's representing recipient.
    first-name: option<string>,
    /// Optional last name when it's representing recipient.
    last-name: option<string>,
    /// The city or town of the address.
    locality: option<string>,
    /// Optional organization name when it's representing recipient.
    organization: option<string>,
    /// The address's postal code.
    postal-code: option<string>,
    /// A civil region within the address's `locality`, if any.
    sublocality: option<string>,
    /// A civil region within the address's `sublocality`, if any.
    sublocality-v2: option<string>,
    /// A civil region within the address's `sublocality_2`, if any.
    sublocality-v3: option<string>
  }

  /// Stores details about a cash payment. Contains only non-confidential information. For more information, see 
  /// [Take Cash Payments](https://developer.squareup.com/docs/payments-api/take-payments/cash-payments).
  record cash-payment-details {
    buyer-supplied-money: money,
    change-back-money: option<money>
  }

  /// Stores details about an external payment. Contains only non-confidential information.
  /// For more information, see 
  /// [Take External Payments](https://developer.squareup.com/docs/payments-api/take-payments/external-payments).
  record external-payment-details {
    /// A description of the external payment source. For example, 
    /// "Food Delivery Service".
    source: string,
    source-fee-money: option<money>,
    /// An ID to associate the payment to its originating source.
    source-id: option<string>,
    /// The type of external payment the seller received. It can be one of the following:
    /// - CHECK - Paid using a physical check.
    type-op: string
  }

  /// Represents a payment processed by the Square API.
  record payment {
    amount-money: option<money>,
    app-fee-money: option<money>,
    approved-money: option<money>,
    bank-account-details: option<bank-account-payment-details>,
    billing-address: option<address>,
    /// The buyer's email address.
    buyer-email-address: option<string>,
    /// Actions that can be performed on this payment:
    /// - `EDIT_AMOUNT_UP` - The payment amount can be edited up.
    capabilities: option<list<string>>,
    card-details: option<card-payment-details>,
    cash-details: option<cash-payment-details>,
    /// The timestamp of when the payment was created, in RFC 3339 format.
    created-at: option<string>,
    /// The [Customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) ID of the customer associated with the payment.
    customer-id: option<string>,
    /// The action to be applied to the payment when the `delay_duration` has elapsed. This field
    /// is read-only.
    delay-action: option<string>,
    /// The duration of time after the payment's creation when Square automatically applies the
    /// `delay_action` to the payment. This automatic `delay_action` applies only to payments that
    delay-duration: option<string>,
    /// The read-only timestamp of when the `delay_action` is automatically applied,
    /// in RFC 3339 format.
    delayed-until: option<string>,
    /// An optional ID of the employee associated with taking the payment.
    employee-id: option<string>,
    external-details: option<external-payment-details>,
    /// A unique ID for the payment.
    id: option<string>,
    /// The ID of the location associated with the payment.
    location-id: option<string>,
    /// An optional note to include when creating a payment.
    note: option<string>,
    /// The ID of the order associated with the payment.
    order-id: option<string>,
    /// The processing fees and fee adjustments assessed by Square for this payment.
    processing-fee: option<list<processing-fee>>,
    /// The payment's receipt number.
    /// The field is missing if a payment is canceled.
    receipt-number: option<string>,
    /// The URL for the payment's receipt.
    /// The field is only populated for COMPLETED payments.
    receipt-url: option<string>,
    /// An optional ID that associates the payment with an entity in
    /// another system.
    reference-id: option<string>,
    /// A list of `refund_id`s identifying refunds for the payment.
    refund-ids: option<list<string>>,
    refunded-money: option<money>,
    risk-evaluation: option<risk-evaluation>,
    shipping-address: option<address>,
    /// The source type for this payment.
    /// 
    source-type: option<string>,
    /// Additional payment information that gets added to the customer's card statement
    /// as part of the statement description.
    statement-description-identifier: option<string>,
    /// Indicates whether the payment is APPROVED, PENDING, COMPLETED, CANCELED, or FAILED.
    status: option<string>,
    tip-money: option<money>,
    total-money: option<money>,
    /// The timestamp of when the payment was last updated, in RFC 3339 format.
    updated-at: option<string>,
    /// Used for optimistic concurrency. This opaque token identifies a specific version of the
    /// `Payment` object.
    version-token: option<string>,
    wallet-details: option<digital-wallet-details>
  }

  /// Additional details about BANK_ACCOUNT type payments.
  record bank-account-payment-details {
    /// The ownership type of the bank account performing the transfer.
    /// The type can be `INDIVIDUAL`, `COMPANY`, or `UNKNOWN`.
    account-ownership-type: option<string>,
    ach-details: option<ach-details>,
    /// The name of the bank associated with the bank account.
    bank-name: option<string>,
    /// The two-letter ISO code representing the country the bank account is located in.
    country: option<string>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    /// Uniquely identifies the bank account for this seller and can be used
    /// to determine if payments are from the same bank account.
    fingerprint: option<string>,
    /// The statement description as sent to the bank.
    statement-description: option<string>,
    /// The type of the bank transfer. The type can be `ACH` or `UNKNOWN`.
    transfer-type: option<string>
  }

  /// ACH-specific details about `BANK_ACCOUNT` type payments with the `transfer_type` of `ACH`.
  record ach-details {
    /// The last few digits of the bank account number.
    account-number-suffix: option<string>,
    /// The type of the bank account performing the transfer. The account type can be `CHECKING`,
    /// `SAVINGS`, or `UNKNOWN`.
    account-type: option<string>,
    /// The routing number for the bank account.
    routing-number: option<string>
  }

  /// Represents an error encountered during a request to the Connect API.
  /// 
  /// See [Handling errors](https://developer.squareup.com/docs/build-basics/handling-errors) for more information.
  record error {
    /// The high-level category for the error.
    category: string,
    /// The specific code of the error.
    code: string,
    /// A human-readable description of the error for debugging purposes.
    detail: option<string>,
    /// The name of the field provided in the original request (if any) that
    /// the error pertains to.
    field: option<string>
  }

  /// Reflects the current status of a card payment. Contains only non-confidential information.
  record card-payment-details {
    /// For EMV payments, the cryptogram generated for the payment.
    application-cryptogram: option<string>,
    /// For EMV payments, the application ID identifies the EMV application used for the payment.
    application-identifier: option<string>,
    /// For EMV payments, the human-readable name of the EMV application used for the payment.
    application-name: option<string>,
    /// The status code returned by the card issuer that describes the payment's
    /// authorization status.
    auth-result-code: option<string>,
    /// The status code returned from the Address Verification System (AVS) check. The code can be
    /// `AVS_ACCEPTED`, `AVS_REJECTED`, or `AVS_NOT_CHECKED`.
    avs-status: option<string>,
    card: option<card>,
    card-payment-timeline: option<card-payment-timeline>,
    /// The status code returned from the Card Verification Value (CVV) check. The code can be
    /// `CVV_ACCEPTED`, `CVV_REJECTED`, or `CVV_NOT_CHECKED`.
    cvv-status: option<string>,
    device-details: option<device-details>,
    /// The method used to enter the card's details for the payment. The method can be
    /// `KEYED`, `SWIPED`, `EMV`, `ON_FILE`, or `CONTACTLESS`.
    entry-method: option<string>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    /// Whether the card must be physically present for the payment to
    /// be refunded.  If set to `true`, the card must be present.
    refund-requires-card-presence: option<bool>,
    /// The statement description sent to the card networks.
    /// 
    statement-description: option<string>,
    /// The card payment's current state. The state can be AUTHORIZED, CAPTURED, VOIDED, or
    /// FAILED.
    status: option<string>,
    /// For EMV payments, the method used to verify the cardholder's identity. The method can be
    /// `PIN`, `SIGNATURE`, `PIN_AND_SIGNATURE`, `ON_DEVICE`, or `NONE`.
    verification-method: option<string>,
    /// For EMV payments, the results of the cardholder verification. The result can be
    /// `SUCCESS`, `FAILURE`, or `UNKNOWN`.
    verification-results: option<string>
  }

  /// Represents the payment details of a card to be used for payments. These
  /// details are determined by the payment token generated by Web Payments SDK.
  record card {
    billing-address: option<address>,
    /// The first six digits of the card number, known as the Bank Identification Number (BIN). Only the Payments API
    /// returns this field.
    bin: option<string>,
    /// The card's brand.
    card-brand: option<string>,
    /// The type of the card.
    /// The Card object includes this field only in response to Payments API calls.
    card-type: option<string>,
    /// The name of the cardholder.
    cardholder-name: option<string>,
    /// The ID of a customer created using the Customers API to be associated with the card.
    customer-id: option<string>,
    /// Indicates whether or not a card can be used for payments.
    enabled: option<bool>,
    /// The expiration month of the associated card as an integer between 1 and 12.
    exp-month: option<s64>,
    /// The four-digit year of the card's expiration date.
    exp-year: option<s64>,
    /// __Not currently set.__ Intended as a Square-assigned identifier, based
    /// on the card number, to identify the card across multiple locations within a
    fingerprint: option<string>,
    /// Unique ID for this card. Generated by Square.
    id: option<string>,
    /// The last 4 digits of the card number.
    last-v4: option<string>,
    /// Indicates whether the Card is prepaid or not.
    /// The Card object includes this field only in response to Payments API calls.
    prepaid-type: option<string>,
    /// An optional user-defined reference ID that associates this card with
    /// another entity in an external system. For example, a customer ID from an
    reference-id: option<string>,
    /// Current version number of the card. Increments with each card update. Requests to update an
    /// existing Card object will be rejected unless the version in the request matches the current
    version: option<s64>
  }

  /// The timeline for card payments.
  record card-payment-timeline {
    /// The timestamp when the payment was authorized, in RFC 3339 format.
    authorized-at: option<string>,
    /// The timestamp when the payment was captured, in RFC 3339 format.
    captured-at: option<string>,
    /// The timestamp when the payment was voided, in RFC 3339 format.
    voided-at: option<string>
  }

  /// Details about the device that took the payment.
  record device-details {
    /// The Square-issued ID of the device.
    device-id: option<string>,
    /// The Square-issued installation ID for the device.
    device-installation-id: option<string>,
    /// The name of the device set by the seller.
    device-name: option<string>
  }

  /// Represents the Square processing fee.
  record processing-fee {
    amount-money: option<money>,
    /// The timestamp of when the fee takes effect, in RFC 3339 format.
    effective-at: option<string>,
    /// The type of fee assessed or adjusted. The fee type can be `INITIAL` or `ADJUSTMENT`.
    type-op: option<string>
  }

  /// Represents fraud risk information for the associated payment.
  /// 
  /// When you take a payment through Square's Payments API (using the `CreatePayment`
  /// endpoint), Square evaluates it and assigns a risk level to the payment. Sellers
  /// can use this information to determine the course of action (for example,
  /// provide the goods/services or refund the payment).
  record risk-evaluation {
    /// The timestamp when payment risk was evaluated, in RFC 3339 format.
    created-at: option<string>,
    /// The risk level associated with the payment
    risk-level: option<string>
  }

  /// Additional details about `WALLET` type payments. Contains only non-confidential information.
  record digital-wallet-details {
    /// The status of the `WALLET` payment. The status can be `AUTHORIZED`, `CAPTURED`, `VOIDED`, or
    /// `FAILED`.
    status: option<string>
  }

  /// ListPayments
  record get-v2-payments-params {
    /// The timestamp for the beginning of the reporting period, in RFC 3339 format.
    /// Inclusive. Default: The current time minus one year.
    begin-time: option<string>,
    /// The timestamp for the end of the reporting period, in RFC 3339 format.
    /// 
    end-time: option<string>,
    /// The order in which results are listed:
    /// - `ASC` - Oldest to newest.
    sort-order: option<string>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// Limit results to the location supplied. By default, results are returned
    /// for the default (main) location associated with the seller.
    location-id: option<string>,
    /// The exact amount in the `total_money` for a payment.
    total: option<s64>,
    /// The last four digits of a payment card.
    last-v4: option<string>,
    /// The brand of the payment card (for example, VISA).
    card-brand: option<string>,
    /// The maximum number of results to be returned in a single page.
    /// It is possible to receive fewer results than the specified limit on a given page.
    limit: option<s32>
  }
  get-v2-payments: func(params: get-v2-payments-params) -> result<string, string>;

  /// CreatePayment
  record create-payment-params {
    /// If set to `true` and charging a Square Gift Card, a payment might be returned with
    /// `amount_money` equal to less than what was requested. For example, a request for $20 when charging
    accept-partial-authorization: option<bool>,
    amount-money: money,
    app-fee-money: option<money>,
    /// If set to `true`, this payment will be completed when possible. If
    /// set to `false`, this payment is held in an approved state until either
    autocomplete: option<bool>,
    billing-address: option<address>,
    /// The buyer's email address.
    buyer-email-address: option<string>,
    cash-details: option<cash-payment-details>,
    /// The [Customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) ID of the customer associated with the payment.
    /// 
    customer-id: option<string>,
    /// The duration of time after the payment's creation when Square automatically cancels the
    /// payment. This automatic cancellation applies only to payments that do not reach a terminal state
    delay-duration: option<string>,
    external-details: option<external-payment-details>,
    /// A unique string that identifies this `CreatePayment` request. Keys can be any valid string
    /// but must be unique for every `CreatePayment` request.
    idempotency-key: string,
    /// The location ID to associate with the payment. If not specified, the default location is
    /// used.
    location-id: option<string>,
    /// An optional note to be entered by the developer when creating a payment.
    /// 
    note: option<string>,
    /// Associates a previously created order with this payment.
    order-id: option<string>,
    /// A user-defined ID to associate with the payment.
    /// 
    reference-id: option<string>,
    shipping-address: option<address>,
    /// The ID for the source of funds for this payment. This can be a payment token 
    /// (card nonce) generated by the Square payment form or a card on file made with the 
    source-id: string,
    /// Optional additional payment information to include on the customer's card statement
    /// as part of the statement description. This can be, for example, an invoice number, ticket number,
    statement-description-identifier: option<string>,
    tip-money: option<money>,
    /// An identifying token generated by [payments.verifyBuyer()](https://developer.squareup.com/reference/sdks/web/payments/objects/Payments#Payments.verifyBuyer).
    /// Verification tokens encapsulate customer device information and 3-D Secure
    verification-token: option<string>
  }
  create-payment: func(params: create-payment-params) -> result<string, string>;

  /// CancelPaymentByIdempotencyKey
  record cancel-payment-by-idempotency-key-params {
    /// The `idempotency_key` identifying the payment to be canceled.
    idempotency-key: string
  }
  cancel-payment-by-idempotency-key: func(params: cancel-payment-by-idempotency-key-params) -> result<string, string>;

  /// GetPayment
  record get-payment-params {
    /// A unique ID for the desired payment.
    payment-id: string
  }
  get-payment: func(params: get-payment-params) -> result<string, string>;

  /// UpdatePayment
  record update-payment-params {
    /// The ID of the payment to update.
    payment-id: string,
    /// A unique string that identifies this `UpdatePayment` request. Keys can be any valid string
    /// but must be unique for every `UpdatePayment` request.
    idempotency-key: string,
    payment: option<payment>
  }
  update-payment: func(params: update-payment-params) -> result<string, string>;

  /// CancelPayment
  record cancel-payment-params {
    /// The ID of the payment to cancel.
    payment-id: string
  }
  cancel-payment: func(params: cancel-payment-params) -> result<string, string>;

  /// CompletePayment
  record complete-payment-params {
    /// The unique ID identifying the payment to be completed.
    payment-id: string
  }
  complete-payment: func(params: complete-payment-params) -> result<string, string>;

}

interface refunds {
  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// ListPaymentRefunds
  record list-payment-refunds-params {
    /// The timestamp for the beginning of the requested reporting period, in RFC 3339 format.
    /// 
    begin-time: option<string>,
    /// The timestamp for the end of the requested reporting period, in RFC 3339 format.
    /// 
    end-time: option<string>,
    /// The order in which results are listed:
    /// - `ASC` - Oldest to newest.
    sort-order: option<string>,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// Limit results to the location supplied. By default, results are returned
    /// for all locations associated with the seller.
    location-id: option<string>,
    /// If provided, only refunds with the given status are returned.
    /// For a list of refund status values, see [PaymentRefund](https://developer.squareup.com/reference/square_2021-08-18/objects/PaymentRefund).
    status: option<string>,
    /// If provided, only refunds with the given source type are returned.
    /// - `CARD` - List refunds only for payments where `CARD` was specified as the payment
    source-type: option<string>,
    /// The maximum number of results to be returned in a single page.
    /// 
    limit: option<s32>
  }
  list-payment-refunds: func(params: list-payment-refunds-params) -> result<string, string>;

  /// RefundPayment
  record refund-payment-params {
    amount-money: money,
    app-fee-money: option<money>,
    ///  A unique string that identifies this `RefundPayment` request. The key can be any valid string
    /// but must be unique for every `RefundPayment` request.
    idempotency-key: string,
    /// The unique ID of the payment being refunded.
    payment-id: string,
    /// A description of the reason for the refund.
    reason: option<string>
  }
  refund-payment: func(params: refund-payment-params) -> result<string, string>;

  /// GetPaymentRefund
  record get-payment-refund-params {
    /// The unique ID for the desired `PaymentRefund`.
    refund-id: string
  }
  get-payment-refund: func(params: get-payment-refund-params) -> result<string, string>;

}

interface sites {
  /// ListSites
  list-sites: func() -> result<string, string>;

}

interface snippets {
  /// Represents the snippet that is added to a Square Online site. The snippet code is injected into the `head` element of all pages on the site, except for checkout pages.
  record snippet {
    /// The snippet code, which can contain valid HTML, JavaScript, or both.
    content: string,
    /// The timestamp of when the snippet was initially added to the site, in RFC 3339 format.
    created-at: option<string>,
    /// The Square-assigned ID for the snippet.
    id: option<string>,
    /// The ID of the site that contains the snippet.
    site-id: option<string>,
    /// The timestamp of when the snippet was last updated on the site, in RFC 3339 format.
    updated-at: option<string>
  }

  /// RetrieveSnippet
  record retrieve-snippet-params {
    /// The ID of the site that contains the snippet.
    site-id: string
  }
  retrieve-snippet: func(params: retrieve-snippet-params) -> result<string, string>;

  /// UpsertSnippet
  record upsert-snippet-params {
    /// The ID of the site where you want to add or update the snippet.
    site-id: string,
    snippet: snippet
  }
  upsert-snippet: func(params: upsert-snippet-params) -> result<string, string>;

  /// DeleteSnippet
  record delete-snippet-params {
    /// The ID of the site that contains the snippet.
    site-id: string
  }
  delete-snippet: func(params: delete-snippet-params) -> result<string, string>;

}

interface subscriptions {
  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Represents a query (including filtering criteria) used to search for subscriptions.
  record search-subscriptions-query {
    filter: option<search-subscriptions-filter>
  }

  /// Represents a set of SearchSubscriptionsQuery filters used to limit the set of Subscriptions returned by SearchSubscriptions.
  record search-subscriptions-filter {
    /// A filter to select subscriptions based on the customer.
    customer-ids: option<list<string>>,
    /// A filter to select subscriptions based the location.
    location-ids: option<list<string>>
  }

  /// Represents a customer subscription to a subscription plan.
  /// For an overview of the `Subscription` type, see
  /// [Subscription object](https://developer.squareup.com/docs/subscriptions-api/overview#subscription-object-overview).
  record subscription {
    /// The subscription cancellation date, in YYYY-MM-DD format (for
    /// example, 2013-01-15). On this date, the subscription status changes
    canceled-date: option<string>,
    /// The ID of the [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) [card](https://developer.squareup.com/reference/square_2021-08-18/objects/Card)
    /// that is charged for the subscription.
    card-id: option<string>,
    /// The date up to which the customer is invoiced for the
    /// subscription, in YYYY-MM-DD format (for example, 2013-01-15).
    charged-through-date: option<string>,
    /// The timestamp when the subscription was created, in RFC 3339 format.
    created-at: option<string>,
    /// The ID of the associated [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) profile.
    customer-id: option<string>,
    /// The Square-assigned ID of the subscription.
    id: option<string>,
    /// The IDs of the [invoices](https://developer.squareup.com/reference/square_2021-08-18/objects/Invoice) created for the
    /// subscription, listed in order when the invoices were created
    invoice-ids: option<list<string>>,
    /// The ID of the location associated with the subscription.
    location-id: option<string>,
    /// The ID of the associated [subscription plan](https://developer.squareup.com/reference/square_2021-08-18/objects/CatalogSubscriptionPlan).
    plan-id: option<string>,
    price-override-money: option<money>,
    /// The start date of the subscription, in YYYY-MM-DD format (for example,
    /// 2013-01-15).
    start-date: option<string>,
    /// The current status of the subscription.
    status: option<string>,
    /// The tax amount applied when billing the subscription. The
    /// percentage is expressed in decimal form, using a `'.'` as the decimal
    tax-percentage: option<string>,
    /// Timezone that will be used in date calculations for the subscription.
    /// Defaults to the timezone of the location based on `location_id`.
    timezone: option<string>,
    /// The version of the object. When updating an object, the version
    /// supplied must match the version in the database, otherwise the write will
    version: option<s64>
  }

  /// CreateSubscription
  record create-subscription-params {
    /// The date when the subscription should be canceled, in
    /// YYYY-MM-DD format (for example, 2025-02-29). This overrides the plan configuration
    canceled-date: option<string>,
    /// The ID of the [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) [card](https://developer.squareup.com/reference/square_2021-08-18/objects/Card) to charge.
    /// If not specified, Square sends an invoice via email. For an example to
    card-id: option<string>,
    /// The ID of the [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) profile.
    customer-id: string,
    /// A unique string that identifies this `CreateSubscription` request.
    /// If you do not provide a unique string (or provide an empty string as the value),
    idempotency-key: option<string>,
    /// The ID of the location the subscription is associated with.
    location-id: string,
    /// The ID of the subscription plan created using the Catalog API.
    /// For more information, see
    plan-id: string,
    price-override-money: option<money>,
    /// The start date of the subscription, in YYYY-MM-DD format. For example,
    /// 2013-01-15. If the start date is left empty, the subscription begins
    start-date: option<string>,
    /// The tax to add when billing the subscription.
    /// The percentage is expressed in decimal form, using a `'.'` as the decimal
    tax-percentage: option<string>,
    /// The timezone that is used in date calculations for the subscription. If unset, defaults to
    /// the location timezone. If a timezone is not configured for the location, defaults to "America/New_York".
    timezone: option<string>
  }
  create-subscription: func(params: create-subscription-params) -> result<string, string>;

  /// SearchSubscriptions
  record search-subscriptions-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The upper limit on the number of subscriptions to return
    /// in the response.
    limit: option<s32>,
    query: option<search-subscriptions-query>
  }
  search-subscriptions: func(params: search-subscriptions-params) -> result<string, string>;

  /// RetrieveSubscription
  record retrieve-subscription-params {
    /// The ID of the subscription to retrieve.
    subscription-id: string
  }
  retrieve-subscription: func(params: retrieve-subscription-params) -> result<string, string>;

  /// UpdateSubscription
  record update-subscription-params {
    /// The ID for the subscription to update.
    subscription-id: string,
    subscription: option<subscription>
  }
  update-subscription: func(params: update-subscription-params) -> result<string, string>;

  /// CancelSubscription
  record cancel-subscription-params {
    /// The ID of the subscription to cancel.
    subscription-id: string
  }
  cancel-subscription: func(params: cancel-subscription-params) -> result<string, string>;

  /// ListSubscriptionEvents
  record list-subscription-events-params {
    /// The ID of the subscription to retrieve the events for.
    subscription-id: string,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The upper limit on the number of subscription events to return
    /// in the response.
    limit: option<s32>
  }
  list-subscription-events: func(params: list-subscription-events-params) -> result<string, string>;

  /// ResumeSubscription
  record resume-subscription-params {
    /// The ID of the subscription to resume.
    subscription-id: string
  }
  resume-subscription: func(params: resume-subscription-params) -> result<string, string>;

}

interface team {
  /// A record representing an individual team member for a business.
  record team-member {
    assigned-locations: option<team-member-assigned-locations>,
    /// The timestamp, in RFC 3339 format, describing when the team member was created.
    /// For example, "2018-10-04T04:00:00-07:00" or "2019-02-05T12:00:00Z".
    created-at: option<string>,
    /// The email address associated with the team member.
    email-address: option<string>,
    /// The family name (that is, the last name) associated with the team member.
    family-name: option<string>,
    /// The given name (that is, the first name) associated with the team member.
    given-name: option<string>,
    /// The unique ID for the team member.
    id: option<string>,
    /// Whether the team member is the owner of the Square account.
    is-owner: option<bool>,
    /// The team member's phone number, in E.164 format. For example:
    /// +14155552671 - the country code is 1 for US
    phone-number: option<string>,
    /// A second ID used to associate the team member with an entity in another system.
    reference-id: option<string>,
    /// Describes the status of the team member.
    status: option<string>,
    /// The timestamp, in RFC 3339 format, describing when the team member was last updated.
    /// For example, "2018-10-04T04:00:00-07:00" or "2019-02-05T12:00:00Z".
    updated-at: option<string>
  }

  /// An object that represents a team member's assignment to locations.
  record team-member-assigned-locations {
    /// The current assignment type of the team member.
    assignment-type: option<string>,
    /// The locations that the team member is assigned to.
    location-ids: option<list<string>>
  }

  /// The data used to create the `TeamMember` objects. Each key is the `idempotency_key` that maps to the `CreateTeamMemberRequest`.
  record bulk-create-team-members-request-team-members {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The data used to update the `TeamMember` objects. Each key is the `team_member_id` that maps to the `UpdateTeamMemberRequest`.
  record bulk-update-team-members-request-team-members {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents the parameters in a search for `TeamMember` objects.
  record search-team-members-query {
    filter: option<search-team-members-filter>
  }

  /// Represents a filter used in a search for `TeamMember` objects. `AND` logic is applied
  /// between the individual fields, and `OR` logic is applied within list-based fields.
  /// For example, setting this filter value:
  /// ```
  /// filter = (locations_ids = ["A", "B"], status = ACTIVE)
  /// ```
  /// returns only active team members assigned to either location "A" or "B".
  record search-team-members-filter {
    /// When present, filters by team members assigned to the specified locations.
    /// When empty, includes team members assigned to any location.
    location-ids: option<list<string>>,
    /// When present, filters by team members who match the given status.
    /// When empty, includes team members of all statuses.
    status: option<string>
  }

  /// An object representing a team member's wage information.
  record wage-setting {
    /// The timestamp, in RFC 3339 format, describing when the wage setting object was created.
    /// For example, "2018-10-04T04:00:00-07:00" or "2019-02-05T12:00:00Z".
    created-at: option<string>,
    /// Whether the team member is exempt from the overtime rules of the seller's country.
    is-overtime-exempt: option<bool>,
    /// Required. The ordered list of jobs that the team member is assigned to.
    /// The first job assignment is considered the team member's primary job.
    job-assignments: option<list<job-assignment>>,
    /// The unique ID of the `TeamMember` whom this wage setting describes.
    team-member-id: option<string>,
    /// The timestamp, in RFC 3339 format, describing when the wage setting object was last updated.
    /// For example, "2018-10-04T04:00:00-07:00" or "2019-02-05T12:00:00Z".
    updated-at: option<string>,
    /// Used for resolving concurrency issues. The request fails if the version
    /// provided does not match the server version at the time of the request. If not provided,
    version: option<s32>
  }

  /// An object describing a job that a team member is assigned to.
  record job-assignment {
    annual-rate: option<money>,
    hourly-rate: option<money>,
    /// The title of the job.
    job-title: string,
    /// The current pay type for the job assignment used to
    /// calculate the pay amount in a pay period.
    pay-type: string,
    /// The planned hours per week for the job. Set if the job `PayType` is `SALARY`.
    weekly-hours: option<s32>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// CreateTeamMember
  record create-team-member-params {
    /// A unique string that identifies this `CreateTeamMember` request.
    /// Keys can be any valid string, but must be unique for every request.
    idempotency-key: option<string>,
    team-member: option<team-member>
  }
  create-team-member: func(params: create-team-member-params) -> result<string, string>;

  /// BulkCreateTeamMembers
  record bulk-create-team-members-params {
    /// The data used to create the `TeamMember` objects. Each key is the `idempotency_key` that maps to the `CreateTeamMemberRequest`.
    team-members: bulk-create-team-members-request-team-members
  }
  bulk-create-team-members: func(params: bulk-create-team-members-params) -> result<string, string>;

  /// BulkUpdateTeamMembers
  record bulk-update-team-members-params {
    /// The data used to update the `TeamMember` objects. Each key is the `team_member_id` that maps to the `UpdateTeamMemberRequest`.
    team-members: bulk-update-team-members-request-team-members
  }
  bulk-update-team-members: func(params: bulk-update-team-members-params) -> result<string, string>;

  /// SearchTeamMembers
  record search-team-members-params {
    /// The opaque cursor for fetching the next page. For more information, see
    /// [pagination](https://developer.squareup.com/docs/working-with-apis/pagination).
    cursor: option<string>,
    /// The maximum number of `TeamMember` objects in a page (100 by default).
    limit: option<s32>,
    query: option<search-team-members-query>
  }
  search-team-members: func(params: search-team-members-params) -> result<string, string>;

  /// RetrieveTeamMember
  record retrieve-team-member-params {
    /// The ID of the team member to retrieve.
    team-member-id: string
  }
  retrieve-team-member: func(params: retrieve-team-member-params) -> result<string, string>;

  /// UpdateTeamMember
  record update-team-member-params {
    /// The ID of the team member to update.
    team-member-id: string,
    team-member: option<team-member>
  }
  update-team-member: func(params: update-team-member-params) -> result<string, string>;

  /// RetrieveWageSetting
  record retrieve-wage-setting-params {
    /// The ID of the team member for which to retrieve the wage setting.
    team-member-id: string
  }
  retrieve-wage-setting: func(params: retrieve-wage-setting-params) -> result<string, string>;

  /// UpdateWageSetting
  record update-wage-setting-params {
    /// The ID of the team member for which to update the `WageSetting` object.
    team-member-id: string,
    wage-setting: wage-setting
  }
  update-wage-setting: func(params: update-wage-setting-params) -> result<string, string>;

}

interface terminal {
  record terminal-checkout {
    amount-money: money,
    /// The ID of the application that created the checkout.
    app-id: option<string>,
    /// Present if the status is `CANCELED`.
    cancel-reason: option<string>,
    /// The time when the `TerminalCheckout` was created, as an RFC 3339 timestamp.
    created-at: option<string>,
    /// An RFC 3339 duration, after which the checkout is automatically canceled.
    /// A `TerminalCheckout` that is `PENDING` is automatically `CANCELED` and has a cancellation reason
    deadline-duration: option<string>,
    device-options: device-checkout-options,
    /// A unique ID for this `TerminalCheckout`.
    id: option<string>,
    /// The location of the device where the `TerminalCheckout` was directed.
    location-id: option<string>,
    /// An optional note to associate with the checkout, as well as with any payments used to complete the checkout.
    note: option<string>,
    /// A list of IDs for payments created by this `TerminalCheckout`.
    payment-ids: option<list<string>>,
    /// The type of payment the terminal should attempt to capture from. Defaults to `CARD_PRESENT`.
    payment-type: option<string>,
    /// An optional user-defined reference ID that can be used to associate
    /// this `TerminalCheckout` to another entity in an external system. For example, an order
    reference-id: option<string>,
    /// The status of the `TerminalCheckout`.
    /// Options: `PENDING`, `IN_PROGRESS`, `CANCEL_REQUESTED`, `CANCELED`, `COMPLETED`
    status: option<string>,
    /// The time when the `TerminalCheckout` was last updated, as an RFC 3339 timestamp.
    updated-at: option<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  record device-checkout-options {
    /// The unique ID of the device intended for this `TerminalCheckout`.
    /// A list of `DeviceCode` objects can be retrieved from the /v2/devices/codes endpoint.
    device-id: string,
    /// Instructs the device to skip the receipt screen. Defaults to false.
    skip-receipt-screen: option<bool>,
    tip-settings: option<tip-settings>
  }

  record tip-settings {
    /// Indicates whether tipping is enabled for this checkout. Defaults to false.
    allow-tipping: option<bool>,
    /// Indicates whether custom tip amounts are allowed during the checkout flow. Defaults to false.
    custom-tip-field: option<bool>,
    /// Indicates whether tip options should be presented on the screen before presenting
    /// the signature screen during card payment. Defaults to false.
    separate-tip-screen: option<bool>,
    /// Enables the "Smart Tip Amounts" behavior.
    /// Exact tipping options depend on the region in which the Square seller is active.
    smart-tipping: option<bool>,
    /// A list of tip percentages that should be presented during the checkout flow, specified as
    /// up to 3 non-negative integers from 0 to 100 (inclusive). Defaults to 15, 20, and 25.
    tip-percentages: option<list<s32>>
  }

  record terminal-checkout-query {
    filter: option<terminal-checkout-query-filter>,
    sort: option<terminal-checkout-query-sort>
  }

  record terminal-checkout-query-filter {
    created-at: option<time-range>,
    /// The `TerminalCheckout` objects associated with a specific device. If no device is specified, then all
    /// `TerminalCheckout` objects for the merchant are displayed.
    device-id: option<string>,
    /// Filtered results with the desired status of the `TerminalCheckout`.
    /// Options: PENDING, IN_PROGRESS, CANCELED, COMPLETED
    status: option<string>
  }

  /// Represents a generic time range. The start and end values are
  /// represented in RFC 3339 format. Time ranges are customized to be
  /// inclusive or exclusive based on the needs of a particular endpoint.
  /// Refer to the relevant endpoint-specific documentation to determine
  /// how time ranges are handled.
  record time-range {
    /// A datetime value in RFC 3339 format indicating when the time range
    /// ends.
    end-at: option<string>,
    /// A datetime value in RFC 3339 format indicating when the time range
    /// starts.
    start-at: option<string>
  }

  record terminal-checkout-query-sort {
    /// The order in which results are listed.
    /// - `ASC` - Oldest to newest.
    sort-order: option<string>
  }

  record terminal-refund {
    amount-money: money,
    /// The ID of the application that created the refund.
    app-id: option<string>,
    /// Present if the status is `CANCELED`.
    cancel-reason: option<string>,
    /// The time when the `TerminalRefund` was created, as an RFC 3339 timestamp.
    created-at: option<string>,
    /// The RFC 3339 duration, after which the refund is automatically canceled.
    /// A `TerminalRefund` that is `PENDING` is automatically `CANCELED` and has a cancellation reason
    deadline-duration: option<string>,
    /// The unique ID of the device intended for this `TerminalRefund`.
    /// The Id can be retrieved from /v2/devices api.
    device-id: option<string>,
    /// A unique ID for this `TerminalRefund`.
    id: option<string>,
    /// The location of the device where the `TerminalRefund` was directed.
    location-id: option<string>,
    /// The reference to the Square order ID for the payment identified by the `payment_id`.
    order-id: option<string>,
    /// The unique ID of the payment being refunded.
    payment-id: string,
    /// A description of the reason for the refund.
    /// Note: maximum 192 characters
    reason: option<string>,
    /// The reference to the payment refund created by completing this `TerminalRefund`.
    refund-id: option<string>,
    /// The status of the `TerminalRefund`.
    /// Options: `PENDING`, `IN_PROGRESS`, `CANCELED`, or `COMPLETED`.
    status: option<string>,
    /// The time when the `TerminalRefund` was last updated, as an RFC 3339 timestamp.
    updated-at: option<string>
  }

  record terminal-refund-query {
    filter: option<terminal-refund-query-filter>,
    sort: option<terminal-refund-query-sort>
  }

  record terminal-refund-query-filter {
    created-at: option<time-range>,
    /// `TerminalRefund` objects associated with a specific device. If no device is specified, then all
    /// `TerminalRefund` objects for the signed-in account are displayed.
    device-id: option<string>,
    /// Filtered results with the desired status of the `TerminalRefund`.
    /// Options: `PENDING`, `IN_PROGRESS`, `CANCEL_REQUESTED`, `CANCELED`, or `COMPLETED`.
    status: option<string>
  }

  record terminal-refund-query-sort {
    /// The order in which results are listed.
    /// - `ASC` - Oldest to newest.
    sort-order: option<string>
  }

  /// CreateTerminalCheckout
  record create-terminal-checkout-params {
    checkout: terminal-checkout,
    /// A unique string that identifies this `CreateCheckout` request. Keys can be any valid string but
    /// must be unique for every `CreateCheckout` request.
    idempotency-key: string
  }
  create-terminal-checkout: func(params: create-terminal-checkout-params) -> result<string, string>;

  /// SearchTerminalCheckouts
  record search-terminal-checkouts-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// Limits the number of results returned for a single request.
    limit: option<s32>,
    query: option<terminal-checkout-query>
  }
  search-terminal-checkouts: func(params: search-terminal-checkouts-params) -> result<string, string>;

  /// GetTerminalCheckout
  record get-terminal-checkout-params {
    /// The unique ID for the desired `TerminalCheckout`.
    checkout-id: string
  }
  get-terminal-checkout: func(params: get-terminal-checkout-params) -> result<string, string>;

  /// CancelTerminalCheckout
  record cancel-terminal-checkout-params {
    /// The unique ID for the desired `TerminalCheckout`.
    checkout-id: string
  }
  cancel-terminal-checkout: func(params: cancel-terminal-checkout-params) -> result<string, string>;

  /// CreateTerminalRefund
  record create-terminal-refund-params {
    /// A unique string that identifies this `CreateRefund` request. Keys can be any valid string but
    /// must be unique for every `CreateRefund` request.
    idempotency-key: string,
    refund: option<terminal-refund>
  }
  create-terminal-refund: func(params: create-terminal-refund-params) -> result<string, string>;

  /// SearchTerminalRefunds
  record search-terminal-refunds-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// Limits the number of results returned for a single request.
    limit: option<s32>,
    query: option<terminal-refund-query>
  }
  search-terminal-refunds: func(params: search-terminal-refunds-params) -> result<string, string>;

  /// GetTerminalRefund
  record get-terminal-refund-params {
    /// The unique ID for the desired `TerminalRefund`.
    terminal-refund-id: string
  }
  get-terminal-refund: func(params: get-terminal-refund-params) -> result<string, string>;

  /// CancelTerminalRefund
  record cancel-terminal-refund-params {
    /// The unique ID for the desired `TerminalRefund`.
    terminal-refund-id: string
  }
  cancel-terminal-refund: func(params: cancel-terminal-refund-params) -> result<string, string>;

}
/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export mobile-authorization;
  export o-auth;
  export v1-employees;
  export v1-transactions;
  export apple-pay;
  export bank-accounts;
  export bookings;
  export cards;
  export cash-drawers;
  export catalog;
  export customers;
  export customer-groups;
  export customer-segments;
  export devices;
  export disputes;
  export employees;
  export gift-cards;
  export gift-card-activities;
  export inventory;
  export invoices;
  export labor;
  export locations;
  export checkout;
  export transactions;
  export loyalty;
  export merchants;
  export orders;
  export payments;
  export refunds;
  export sites;
  export snippets;
  export subscriptions;
  export team;
  export terminal;
}
