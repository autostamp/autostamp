    group: option<customer-group>
  }

  /// Defines the fields that are included in the response body of
  /// a request to the [DeleteCustomerGroup](https://developer.squareup.com/reference/square_2021-08-18/customer-groups-api/delete-customer-group) endpoint.
  record delete-customer-group-response {
    /// Any errors that occurred during the request.
    errors: option<list<error>>
  }

  /// ListCustomerGroups
  record list-customer-groups-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// The maximum number of results to return in a single page. This limit is advisory. The response might contain more or fewer results. 
    /// The limit is ignored if it is less than 1 or greater than 50. The default value is 50.
    limit: option<s32>
  }
  list-customer-groups: func(params: list-customer-groups-params) -> result<list-customer-groups-response, string>;

  /// CreateCustomerGroup
  record create-customer-group-params {
    group: customer-group,
    /// The idempotency key for the request. For more information, see [Idempotency](https://developer.squareup.com/docs/basics/api101/idempotency).
    idempotency-key: option<string>
  }
  create-customer-group: func(params: create-customer-group-params) -> result<create-customer-group-response, string>;

  /// RetrieveCustomerGroup
  record retrieve-customer-group-params {
    /// The ID of the customer group to retrieve.
    group-id: string
  }
  retrieve-customer-group: func(params: retrieve-customer-group-params) -> result<retrieve-customer-group-response, string>;

  /// UpdateCustomerGroup
  record update-customer-group-params {
    /// The ID of the customer group to update.
    group-id: string,
    group: customer-group
  }
  update-customer-group: func(params: update-customer-group-params) -> result<update-customer-group-response, string>;

  /// DeleteCustomerGroup
