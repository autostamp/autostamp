    subscription: option<subscription>
  }

  /// Defines the fields that are included in the response from the
  /// [UpdateSubscription](https://developer.squareup.com/reference/square_2021-08-18/subscriptions-api/update-subscription) endpoint.
  record update-subscription-response {
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    subscription: option<subscription>
  }

  /// Defines fields that are included in a
  /// [CancelSubscription](https://developer.squareup.com/reference/square_2021-08-18/subscriptions-api/cancel-subscription) response.
  record cancel-subscription-response {
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    subscription: option<subscription>
  }

  /// Defines the fields that are included in the response from the
  /// [ListSubscriptionEvents](https://developer.squareup.com/reference/square_2021-08-18/subscriptions-api/list-subscription-events)
  /// endpoint.
  record list-subscription-events-response {
    /// When a response is truncated, it includes a cursor that you can
    /// use in a subsequent request to fetch the next set of events.
    cursor: option<string>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    /// The `SubscriptionEvents` retrieved.
    subscription-events: option<list<subscription-event>>
  }

  /// Describes changes to subscription and billing states.
  record subscription-event {
    /// The date, in YYYY-MM-DD format (for
    /// example, 2013-01-15), when the subscription event went into effect.
    effective-date: string,
    /// The ID of the subscription event.
    id: string,
    info: option<info>,
    /// The ID of the subscription plan associated with the subscription.
    plan-id: string,
    /// Type of the subscription event.
    subscription-event-type: string
  }

  record info {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Defines parameters in a
  /// [ResumeSubscription](https://developer.squareup.com/reference/square_2021-08-18/subscriptions-api/resume-subscription) endpoint
  /// response.
  record resume-subscription-response {
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    subscription: option<subscription>
  }

  /// CreateSubscription
  record create-subscription-params {
    /// The date when the subscription should be canceled, in
    /// YYYY-MM-DD format (for example, 2025-02-29). This overrides the plan configuration
    canceled-date: option<string>,
    /// The ID of the [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) [card](https://developer.squareup.com/reference/square_2021-08-18/objects/Card) to charge.
    /// If not specified, Square sends an invoice via email. For an example to
    card-id: option<string>,
    /// The ID of the [customer](https://developer.squareup.com/reference/square_2021-08-18/objects/Customer) profile.
    customer-id: string,
    /// A unique string that identifies this `CreateSubscription` request.
    /// If you do not provide a unique string (or provide an empty string as the value),
    idempotency-key: option<string>,
    /// The ID of the location the subscription is associated with.
    location-id: string,
    /// The ID of the subscription plan created using the Catalog API.
    /// For more information, see
    plan-id: string,
    price-override-money: option<money>,
    /// The start date of the subscription, in YYYY-MM-DD format. For example,
    /// 2013-01-15. If the start date is left empty, the subscription begins
    start-date: option<string>,
    /// The tax to add when billing the subscription.
    /// The percentage is expressed in decimal form, using a `'.'` as the decimal
    tax-percentage: option<string>,
    /// The timezone that is used in date calculations for the subscription. If unset, defaults to
    /// the location timezone. If a timezone is not configured for the location, defaults to "America/New_York".
    timezone: option<string>
  }
  create-subscription: func(params: create-subscription-params) -> result<create-subscription-response, string>;

  /// SearchSubscriptions
  record search-subscriptions-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The upper limit on the number of subscriptions to return
    /// in the response.
    limit: option<s32>,
    query: option<search-subscriptions-query>
  }
  search-subscriptions: func(params: search-subscriptions-params) -> result<search-subscriptions-response, string>;

  /// RetrieveSubscription
  record retrieve-subscription-params {
    /// The ID of the subscription to retrieve.
    subscription-id: string
  }
  retrieve-subscription: func(params: retrieve-subscription-params) -> result<retrieve-subscription-response, string>;

  /// UpdateSubscription
  record update-subscription-params {
    /// The ID for the subscription to update.
    subscription-id: string,
    subscription: option<subscription>
  }
  update-subscription: func(params: update-subscription-params) -> result<update-subscription-response, string>;

  /// CancelSubscription
  record cancel-subscription-params {
    /// The ID of the subscription to cancel.
    subscription-id: string
  }
  cancel-subscription: func(params: cancel-subscription-params) -> result<cancel-subscription-response, string>;

  /// ListSubscriptionEvents
  record list-subscription-events-params {
    /// The ID of the subscription to retrieve the events for.
    subscription-id: string,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The upper limit on the number of subscription events to return
    /// in the response.
    limit: option<s32>
  }
  list-subscription-events: func(params: list-subscription-events-params) -> result<list-subscription-events-response, string>;

  /// ResumeSubscription
  record resume-subscription-params {
    /// The ID of the subscription to resume.
    subscription-id: string
  }
  resume-subscription: func(params: resume-subscription-params) -> result<resume-subscription-response, string>;

}

interface team {
  /// Represents a create request for a `TeamMember` object.
  record create-team-member-request {
    /// A unique string that identifies this `CreateTeamMember` request.
    /// Keys can be any valid string, but must be unique for every request.
    idempotency-key: option<string>,
    team-member: option<member>
  }

  /// A record representing an individual team member for a business.
  record member {
    assigned-locations: option<member-assigned-locations>,
    /// The timestamp, in RFC 3339 format, describing when the team member was created.
    /// For example, "2018-10-04T04:00:00-07:00" or "2019-02-05T12:00:00Z".
    created-at: option<string>,
    /// The email address associated with the team member.
    email-address: option<string>,
    /// The family name (that is, the last name) associated with the team member.
    family-name: option<string>,
    /// The given name (that is, the first name) associated with the team member.
    given-name: option<string>,
    /// The unique ID for the team member.
    id: option<string>,
    /// Whether the team member is the owner of the Square account.
    is-owner: option<bool>,
    /// The team member's phone number, in E.164 format. For example:
    /// +14155552671 - the country code is 1 for US
    phone-number: option<string>,
    /// A second ID used to associate the team member with an entity in another system.
    reference-id: option<string>,
    /// Describes the status of the team member.
    status: option<string>,
    /// The timestamp, in RFC 3339 format, describing when the team member was last updated.
    /// For example, "2018-10-04T04:00:00-07:00" or "2019-02-05T12:00:00Z".
    updated-at: option<string>
  }

  /// An object that represents a team member's assignment to locations.
  record member-assigned-locations {
    /// The current assignment type of the team member.
    assignment-type: option<string>,
    /// The locations that the team member is assigned to.
    location-ids: option<list<string>>
  }

  /// Represents a response from a create request containing the created `TeamMember` object or error messages.
  record create-team-member-response {
    /// The errors that occurred during the request.
    errors: option<list<error>>,
    team-member: option<member>
  }

  /// Represents an error encountered during a request to the Connect API.
  /// 
  /// See [Handling errors](https://developer.squareup.com/docs/build-basics/handling-errors) for more information.
  record error {
    /// The high-level category for the error.
    category: string,
    /// The specific code of the error.
    code: string,
    /// A human-readable description of the error for debugging purposes.
    detail: option<string>,
    /// The name of the field provided in the original request (if any) that
    /// the error pertains to.
    field: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record bulk-create-team-members-request-team-members-entry {
    key: string,
    value: create-team-member-request
  }

  /// Represents a response from a bulk create request containing the created `TeamMember` objects or error messages.
  record bulk-create-team-members-response {
    /// The errors that occurred during the request.
    errors: option<list<error>>,
    /// The successfully created `TeamMember` objects. Each key is the `idempotency_key` that maps to the `CreateTeamMemberRequest`.
    team-members: option<list<bulk-create-team-members-response-team-members-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record bulk-create-team-members-response-team-members-entry {
    key: string,
    value: create-team-member-response
  }

  /// Represents an update request for a `TeamMember` object.
  record update-team-member-request {
    team-member: option<member>
  }

  /// one entry of a string-keyed map (free-form object)
  record bulk-update-team-members-request-team-members-entry {
    key: string,
    value: update-team-member-request
  }

  /// Represents a response from a bulk update request containing the updated `TeamMember` objects or error messages.
  record bulk-update-team-members-response {
    /// The errors that occurred during the request.
    errors: option<list<error>>,
    /// The successfully updated `TeamMember` objects. Each key is the `team_member_id` that maps to the `UpdateTeamMemberRequest`.
    team-members: option<list<bulk-update-team-members-response-team-members-entry>>
  }

  /// Represents a response from an update request containing the updated `TeamMember` object or error messages.
  record update-team-member-response {
    /// The errors that occurred during the request.
    errors: option<list<error>>,
    team-member: option<member>
  }

  /// one entry of a string-keyed map (free-form object)
  record bulk-update-team-members-response-team-members-entry {
    key: string,
    value: update-team-member-response
  }

  /// Represents the parameters in a search for `TeamMember` objects.
  record search-team-members-query {
    filter: option<search-team-members-filter>
  }

  /// Represents a filter used in a search for `TeamMember` objects. `AND` logic is applied
  /// between the individual fields, and `OR` logic is applied within list-based fields.
  /// For example, setting this filter value:
  /// ```
  /// filter = (locations_ids = ["A", "B"], status = ACTIVE)
  /// ```
  /// returns only active team members assigned to either location "A" or "B".
  record search-team-members-filter {
    /// When present, filters by team members assigned to the specified locations.
    /// When empty, includes team members assigned to any location.
    location-ids: option<list<string>>,
    /// When present, filters by team members who match the given status.
    /// When empty, includes team members of all statuses.
    status: option<string>
  }

  /// Represents a response from a search request containing a filtered list of `TeamMember` objects.
  record search-team-members-response {
    /// The opaque cursor for fetching the next page. For more information, see
    /// [pagination](https://developer.squareup.com/docs/working-with-apis/pagination).
    cursor: option<string>,
    /// The errors that occurred during the request.
    errors: option<list<error>>,
    /// The filtered list of `TeamMember` objects.
    team-members: option<list<member>>
  }

  /// Represents a response from a retrieve request containing a `TeamMember` object or error messages.
  record retrieve-team-member-response {
    /// The errors that occurred during the request.
    errors: option<list<error>>,
    team-member: option<member>
  }

  /// Represents a response from a retrieve request containing the specified `WageSetting` object or error messages.
  record retrieve-wage-setting-response {
    /// The errors that occurred during the request.
    errors: option<list<error>>,
    wage-setting: option<wage-setting>
  }

  /// An object representing a team member's wage information.
  record wage-setting {
    /// The timestamp, in RFC 3339 format, describing when the wage setting object was created.
    /// For example, "2018-10-04T04:00:00-07:00" or "2019-02-05T12:00:00Z".
    created-at: option<string>,
    /// Whether the team member is exempt from the overtime rules of the seller's country.
    is-overtime-exempt: option<bool>,
    /// Required. The ordered list of jobs that the team member is assigned to.
    /// The first job assignment is considered the team member's primary job.
    job-assignments: option<list<job-assignment>>,
    /// The unique ID of the `TeamMember` whom this wage setting describes.
    team-member-id: option<string>,
    /// The timestamp, in RFC 3339 format, describing when the wage setting object was last updated.
    /// For example, "2018-10-04T04:00:00-07:00" or "2019-02-05T12:00:00Z".
    updated-at: option<string>,
    /// Used for resolving concurrency issues. The request fails if the version
    /// provided does not match the server version at the time of the request. If not provided,
    version: option<s32>
  }

  /// An object describing a job that a team member is assigned to.
  record job-assignment {
    annual-rate: option<money>,
    hourly-rate: option<money>,
    /// The title of the job.
    job-title: string,
    /// The current pay type for the job assignment used to
    /// calculate the pay amount in a pay period.
    pay-type: string,
    /// The planned hours per week for the job. Set if the job `PayType` is `SALARY`.
    weekly-hours: option<s32>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// Represents a response from an update request containing the updated `WageSetting` object
  /// or error messages.
  record update-wage-setting-response {
    /// The errors that occurred during the request.
    errors: option<list<error>>,
    wage-setting: option<wage-setting>
  }

  /// CreateTeamMember
  record create-team-member-params {
    /// A unique string that identifies this `CreateTeamMember` request.
    /// Keys can be any valid string, but must be unique for every request.
    idempotency-key: option<string>,
    team-member: option<member>
  }
  create-team-member: func(params: create-team-member-params) -> result<create-team-member-response, string>;

  /// BulkCreateTeamMembers
  record bulk-create-team-members-params {
    /// The data used to create the `TeamMember` objects. Each key is the `idempotency_key` that maps to the `CreateTeamMemberRequest`.
    team-members: list<bulk-create-team-members-request-team-members-entry>
  }
  bulk-create-team-members: func(params: bulk-create-team-members-params) -> result<bulk-create-team-members-response, string>;

  /// BulkUpdateTeamMembers
  record bulk-update-team-members-params {
    /// The data used to update the `TeamMember` objects. Each key is the `team_member_id` that maps to the `UpdateTeamMemberRequest`.
    team-members: list<bulk-update-team-members-request-team-members-entry>
  }
  bulk-update-team-members: func(params: bulk-update-team-members-params) -> result<bulk-update-team-members-response, string>;

  /// SearchTeamMembers
  record search-team-members-params {
    /// The opaque cursor for fetching the next page. For more information, see
    /// [pagination](https://developer.squareup.com/docs/working-with-apis/pagination).
    cursor: option<string>,
    /// The maximum number of `TeamMember` objects in a page (100 by default).
    limit: option<s32>,
    query: option<search-team-members-query>
  }
  search-team-members: func(params: search-team-members-params) -> result<search-team-members-response, string>;

  /// RetrieveTeamMember
  record retrieve-team-member-params {
    /// The ID of the team member to retrieve.
    team-member-id: string
  }
  retrieve-team-member: func(params: retrieve-team-member-params) -> result<retrieve-team-member-response, string>;

  /// UpdateTeamMember
  record update-team-member-params {
    /// The ID of the team member to update.
    team-member-id: string,
    team-member: option<member>
  }
  update-team-member: func(params: update-team-member-params) -> result<update-team-member-response, string>;

  /// RetrieveWageSetting
  record retrieve-wage-setting-params {
    /// The ID of the team member for which to retrieve the wage setting.
    team-member-id: string
  }
  retrieve-wage-setting: func(params: retrieve-wage-setting-params) -> result<retrieve-wage-setting-response, string>;

  /// UpdateWageSetting
  record update-wage-setting-params {
    /// The ID of the team member for which to update the `WageSetting` object.
    team-member-id: string,
    wage-setting: wage-setting
  }
  update-wage-setting: func(params: update-wage-setting-params) -> result<update-wage-setting-response, string>;

}

interface terminal {
  record checkout {
    amount-money: money,
    /// The ID of the application that created the checkout.
    app-id: option<string>,
    /// Present if the status is `CANCELED`.
    cancel-reason: option<string>,
    /// The time when the `TerminalCheckout` was created, as an RFC 3339 timestamp.
    created-at: option<string>,
    /// An RFC 3339 duration, after which the checkout is automatically canceled.
    /// A `TerminalCheckout` that is `PENDING` is automatically `CANCELED` and has a cancellation reason
    deadline-duration: option<string>,
    device-options: device-checkout-options,
    /// A unique ID for this `TerminalCheckout`.
    id: option<string>,
    /// The location of the device where the `TerminalCheckout` was directed.
    location-id: option<string>,
    /// An optional note to associate with the checkout, as well as with any payments used to complete the checkout.
    note: option<string>,
    /// A list of IDs for payments created by this `TerminalCheckout`.
    payment-ids: option<list<string>>,
    /// The type of payment the terminal should attempt to capture from. Defaults to `CARD_PRESENT`.
    payment-type: option<string>,
    /// An optional user-defined reference ID that can be used to associate
    /// this `TerminalCheckout` to another entity in an external system. For example, an order
    reference-id: option<string>,
    /// The status of the `TerminalCheckout`.
    /// Options: `PENDING`, `IN_PROGRESS`, `CANCEL_REQUESTED`, `CANCELED`, `COMPLETED`
    status: option<string>,
    /// The time when the `TerminalCheckout` was last updated, as an RFC 3339 timestamp.
    updated-at: option<string>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  record device-checkout-options {
    /// The unique ID of the device intended for this `TerminalCheckout`.
    /// A list of `DeviceCode` objects can be retrieved from the /v2/devices/codes endpoint.
    device-id: string,
    /// Instructs the device to skip the receipt screen. Defaults to false.
    skip-receipt-screen: option<bool>,
    tip-settings: option<tip-settings>
  }

  record tip-settings {
    /// Indicates whether tipping is enabled for this checkout. Defaults to false.
    allow-tipping: option<bool>,
    /// Indicates whether custom tip amounts are allowed during the checkout flow. Defaults to false.
    custom-tip-field: option<bool>,
    /// Indicates whether tip options should be presented on the screen before presenting
    /// the signature screen during card payment. Defaults to false.
    separate-tip-screen: option<bool>,
    /// Enables the "Smart Tip Amounts" behavior.
    /// Exact tipping options depend on the region in which the Square seller is active.
    smart-tipping: option<bool>,
    /// A list of tip percentages that should be presented during the checkout flow, specified as
    /// up to 3 non-negative integers from 0 to 100 (inclusive). Defaults to 15, 20, and 25.
    tip-percentages: option<list<s32>>
  }

  record create-terminal-checkout-response {
    checkout: option<checkout>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  /// Represents an error encountered during a request to the Connect API.
  /// 
  /// See [Handling errors](https://developer.squareup.com/docs/build-basics/handling-errors) for more information.
  record error {
    /// The high-level category for the error.
    category: string,
    /// The specific code of the error.
    code: string,
    /// A human-readable description of the error for debugging purposes.
    detail: option<string>,
    /// The name of the field provided in the original request (if any) that
    /// the error pertains to.
    field: option<string>
  }

  record checkout-query {
    filter: option<checkout-query-filter>,
    sort: option<checkout-query-sort>
  }

  record checkout-query-filter {
    created-at: option<time-range>,
    /// The `TerminalCheckout` objects associated with a specific device. If no device is specified, then all
    /// `TerminalCheckout` objects for the merchant are displayed.
    device-id: option<string>,
    /// Filtered results with the desired status of the `TerminalCheckout`.
    /// Options: PENDING, IN_PROGRESS, CANCELED, COMPLETED
    status: option<string>
  }

  /// Represents a generic time range. The start and end values are
  /// represented in RFC 3339 format. Time ranges are customized to be
  /// inclusive or exclusive based on the needs of a particular endpoint.
  /// Refer to the relevant endpoint-specific documentation to determine
  /// how time ranges are handled.
  record time-range {
    /// A datetime value in RFC 3339 format indicating when the time range
    /// ends.
    end-at: option<string>,
    /// A datetime value in RFC 3339 format indicating when the time range
    /// starts.
    start-at: option<string>
  }

  record checkout-query-sort {
    /// The order in which results are listed.
    /// - `ASC` - Oldest to newest.
    sort-order: option<string>
  }

  record search-terminal-checkouts-response {
    /// The requested search result of `TerminalCheckout` objects.
    checkouts: option<list<checkout>>,
    /// The pagination cursor to be used in a subsequent request. If empty,
    /// this is the final response.
    cursor: option<string>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  record get-terminal-checkout-response {
    checkout: option<checkout>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  record cancel-terminal-checkout-response {
    checkout: option<checkout>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  record refund {
    amount-money: money,
    /// The ID of the application that created the refund.
    app-id: option<string>,
    /// Present if the status is `CANCELED`.
    cancel-reason: option<string>,
    /// The time when the `TerminalRefund` was created, as an RFC 3339 timestamp.
    created-at: option<string>,
    /// The RFC 3339 duration, after which the refund is automatically canceled.
    /// A `TerminalRefund` that is `PENDING` is automatically `CANCELED` and has a cancellation reason
    deadline-duration: option<string>,
    /// The unique ID of the device intended for this `TerminalRefund`.
    /// The Id can be retrieved from /v2/devices api.
    device-id: option<string>,
    /// A unique ID for this `TerminalRefund`.
    id: option<string>,
    /// The location of the device where the `TerminalRefund` was directed.
    location-id: option<string>,
    /// The reference to the Square order ID for the payment identified by the `payment_id`.
    order-id: option<string>,
    /// The unique ID of the payment being refunded.
    payment-id: string,
    /// A description of the reason for the refund.
    /// Note: maximum 192 characters
    reason: option<string>,
    /// The reference to the payment refund created by completing this `TerminalRefund`.
    refund-id: option<string>,
    /// The status of the `TerminalRefund`.
    /// Options: `PENDING`, `IN_PROGRESS`, `CANCELED`, or `COMPLETED`.
    status: option<string>,
    /// The time when the `TerminalRefund` was last updated, as an RFC 3339 timestamp.
    updated-at: option<string>
  }

  record create-terminal-refund-response {
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    refund: option<refund>
  }

  record refund-query {
    filter: option<refund-query-filter>,
    sort: option<refund-query-sort>
  }

  record refund-query-filter {
    created-at: option<time-range>,
    /// `TerminalRefund` objects associated with a specific device. If no device is specified, then all
    /// `TerminalRefund` objects for the signed-in account are displayed.
    device-id: option<string>,
    /// Filtered results with the desired status of the `TerminalRefund`.
    /// Options: `PENDING`, `IN_PROGRESS`, `CANCEL_REQUESTED`, `CANCELED`, or `COMPLETED`.
    status: option<string>
  }

  record refund-query-sort {
    /// The order in which results are listed.
    /// - `ASC` - Oldest to newest.
    sort-order: option<string>
  }

  record search-terminal-refunds-response {
    /// The pagination cursor to be used in a subsequent request. If empty,
    /// this is the final response.
    cursor: option<string>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    /// The requested search result of `TerminalRefund` objects.
    refunds: option<list<refund>>
  }

  record get-terminal-refund-response {
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    refund: option<refund>
  }

  record cancel-terminal-refund-response {
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    refund: option<refund>
  }

  /// CreateTerminalCheckout
  record create-terminal-checkout-params {
    checkout: checkout,
    /// A unique string that identifies this `CreateCheckout` request. Keys can be any valid string but
    /// must be unique for every `CreateCheckout` request.
    idempotency-key: string
  }
  create-terminal-checkout: func(params: create-terminal-checkout-params) -> result<create-terminal-checkout-response, string>;

  /// SearchTerminalCheckouts
  record search-terminal-checkouts-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// Limits the number of results returned for a single request.
    limit: option<s32>,
    query: option<checkout-query>
  }
  search-terminal-checkouts: func(params: search-terminal-checkouts-params) -> result<search-terminal-checkouts-response, string>;

  /// GetTerminalCheckout
  record get-terminal-checkout-params {
    /// The unique ID for the desired `TerminalCheckout`.
    checkout-id: string
  }
  get-terminal-checkout: func(params: get-terminal-checkout-params) -> result<get-terminal-checkout-response, string>;

  /// CancelTerminalCheckout
  record cancel-terminal-checkout-params {
    /// The unique ID for the desired `TerminalCheckout`.
    checkout-id: string
  }
  cancel-terminal-checkout: func(params: cancel-terminal-checkout-params) -> result<cancel-terminal-checkout-response, string>;

  /// CreateTerminalRefund
  record create-terminal-refund-params {
    /// A unique string that identifies this `CreateRefund` request. Keys can be any valid string but
    /// must be unique for every `CreateRefund` request.
    idempotency-key: string,
    refund: option<refund>
  }
  create-terminal-refund: func(params: create-terminal-refund-params) -> result<create-terminal-refund-response, string>;

  /// SearchTerminalRefunds
  record search-terminal-refunds-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// Limits the number of results returned for a single request.
    limit: option<s32>,
    query: option<refund-query>
  }
  search-terminal-refunds: func(params: search-terminal-refunds-params) -> result<search-terminal-refunds-response, string>;

  /// GetTerminalRefund
  record get-terminal-refund-params {
    /// The unique ID for the desired `TerminalRefund`.
    terminal-refund-id: string
  }
  get-terminal-refund: func(params: get-terminal-refund-params) -> result<get-terminal-refund-response, string>;

  /// CancelTerminalRefund
  record cancel-terminal-refund-params {
    /// The unique ID for the desired `TerminalRefund`.
    terminal-refund-id: string
  }
  cancel-terminal-refund: func(params: cancel-terminal-refund-params) -> result<cancel-terminal-refund-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export mobile-authorization;
  export o-auth;
  export v1-employees;
  export v1-transactions;
  export apple-pay;
  export bank-accounts;
  export bookings;
  export cards;
  export cash-drawers;
  export catalog;
  export customers;
  export customer-groups;
  export customer-segments;
  export devices;
  export disputes;
  export employees;
  export gift-cards;
  export gift-card-activities;
  export inventory;
  export invoices;
  export labor;
  export locations;
  export checkout;
  export transactions;
  export loyalty;
  export merchants;
  export orders;
  export payments;
  export refunds;
  export sites;
  export snippets;
  export subscriptions;
  export team;
  export terminal;
}
