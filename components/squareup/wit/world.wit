interface devices {
  record list-device-codes-response {
    /// A pagination cursor to retrieve the next set of results for your
    /// original query to the endpoint. This value is present only if the request
    cursor: option<string>,
    /// The queried DeviceCode.
    device-codes: option<list<device-code>>,
    /// Any errors that occurred during the request.
    errors: option<list<error>>
  }

  record device-code {
    /// The unique code that can be used to login.
    code: option<string>,
    /// When this DeviceCode was created. Timestamp in RFC 3339 format.
    created-at: option<string>,
    /// The unique id of the device that used this code. Populated when the device is paired up.
    device-id: option<string>,
    /// The unique id for this device code.
    id: option<string>,
    /// The location assigned to this code.
    location-id: option<string>,
    /// An optional user-defined name for the device code.
    name: option<string>,
    /// When this DeviceCode will expire and no longer login. Timestamp in RFC 3339 format.
    pair-by: option<string>,
    /// When this DeviceCode was paired. Timestamp in RFC 3339 format.
    paired-at: option<string>,
    /// The targeting product type of the device code.
    product-type: string,
    /// The pairing status of the device code.
    status: option<string>,
    /// When this DeviceCode's status was last changed. Timestamp in RFC 3339 format.
    status-changed-at: option<string>
  }

  /// Represents an error encountered during a request to the Connect API.
  /// 
  /// See [Handling errors](https://developer.squareup.com/docs/build-basics/handling-errors) for more information.
  record error {
    /// The high-level category for the error.
    category: string,
    /// The specific code of the error.
    code: string,
    /// A human-readable description of the error for debugging purposes.
    detail: option<string>,
    /// The name of the field provided in the original request (if any) that
    /// the error pertains to.
    field: option<string>
  }

  record create-device-code-response {
    device-code: option<device-code>,
    /// Any errors that occurred during the request.
    errors: option<list<error>>
  }

  record get-device-code-response {
    device-code: option<device-code>,
    /// Any errors that occurred during the request.
    errors: option<list<error>>
  }

  /// ListDeviceCodes
  record list-device-codes-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this to retrieve the next set of results for your original query.
    cursor: option<string>,
    /// If specified, only returns DeviceCodes of the specified location.
    /// Returns DeviceCodes of all locations if empty.
    location-id: option<string>,
    /// If specified, only returns DeviceCodes targeting the specified product type.
    /// Returns DeviceCodes of all product types if empty.
    product-type: option<string>,
    /// If specified, returns DeviceCodes with the specified statuses.
    /// Returns DeviceCodes of status `PAIRED` and `UNPAIRED` if empty.
    status: option<string>
  }
  list-device-codes: func(params: list-device-codes-params) -> result<list-device-codes-response, string>;

  /// CreateDeviceCode
  record create-device-code-params {
    device-code: device-code,
    /// A unique string that identifies this CreateDeviceCode request. Keys can
    /// be any valid string but must be unique for every CreateDeviceCode request.
    idempotency-key: string
  }
  create-device-code: func(params: create-device-code-params) -> result<create-device-code-response, string>;

  /// GetDeviceCode
  record get-device-code-params {
    /// The unique identifier for the device code.
    id: string
  }
  get-device-code: func(params: get-device-code-params) -> result<get-device-code-response, string>;

}

interface disputes {
  /// Defines fields in a `ListDisputes` response.
  record list-disputes-response {
    /// The pagination cursor to be used in a subsequent request.
    /// If unset, this is the final response. For more information, see [Pagination](https://developer.squareup.com/docs/basics/api101/pagination).
    cursor: option<string>,
    /// The list of disputes.
    disputes: option<list<dispute>>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  /// Represents a dispute a cardholder initiated with their bank.
  record dispute {
    amount-money: option<money>,
    /// The ID of the dispute in the card brand system, generated by the card brand.
    brand-dispute-id: option<string>,
    /// The card brand used in the disputed payment.
    card-brand: option<string>,
    /// The timestamp when the dispute was created, in RFC 3339 format.
    created-at: option<string>,
    /// The unique ID for this `Dispute`, generated by Square.
    dispute-id: option<string>,
    disputed-payment: option<disputed-payment>,
    /// The time when the next action is due, in RFC 3339 format.
    due-at: option<string>,
    /// The IDs of the evidence associated with the dispute.
    evidence-ids: option<list<string>>,
    /// The unique ID for this `Dispute`, generated by Square.
    id: option<string>,
    /// The ID of the location where the dispute originated.
    location-id: option<string>,
    /// The dispute reason why the cardholder initiated the dispute with their bank.
    reason: option<string>,
    /// The timestamp when the dispute was reported, in RFC 3339 format.
    reported-at: option<string>,
    /// The timestamp when the dispute was reported, in RFC 3339 format.
    reported-date: option<string>,
    /// The current state of this dispute.
    state: option<string>,
    /// The timestamp when the dispute was last updated, in RFC 3339 format.
    updated-at: option<string>,
    /// The current version of the `Dispute`.
    version: option<s32>
  }

  /// Represents an amount of money. `Money` fields can be signed or unsigned.
  /// Fields that do not explicitly define whether they are signed or unsigned are
  /// considered unsigned and can only hold positive amounts. For signed fields, the
  /// sign of the value indicates the purpose of the money transfer. See
  /// [Working with Monetary Amounts](https://developer.squareup.com/docs/build-basics/working-with-monetary-amounts)
  /// for more information.
  record money {
    /// The amount of money, in the smallest denomination of the currency
    /// indicated by `currency`. For example, when `currency` is `USD`, `amount` is
    amount: option<s64>,
    /// The type of currency, in __ISO 4217 format__. For example, the currency
    /// code for US dollars is `USD`.
    currency: option<string>
  }

  /// The payment the cardholder disputed.
  record disputed-payment {
    /// Square-generated unique ID of the payment being disputed.
    payment-id: option<string>
  }

  /// Represents an error encountered during a request to the Connect API.
  /// 
  /// See [Handling errors](https://developer.squareup.com/docs/build-basics/handling-errors) for more information.
  record error {
    /// The high-level category for the error.
    category: string,
    /// The specific code of the error.
    code: string,
    /// A human-readable description of the error for debugging purposes.
    detail: option<string>,
    /// The name of the field provided in the original request (if any) that
    /// the error pertains to.
    field: option<string>
  }

  /// Defines fields in a `RetrieveDispute` response.
  record retrieve-dispute-response {
    dispute: option<dispute>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  /// Defines the fields in an `AcceptDispute` response.
  record accept-dispute-response {
    dispute: option<dispute>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  /// Defines the fields in a `ListDisputeEvidence` response.
  record list-dispute-evidence-response {
    /// The pagination cursor to be used in a subsequent request.
    /// If unset, this is the final response. For more information, see [Pagination](https://developer.squareup.com/docs/basics/api101/pagination).
    cursor: option<string>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>,
    /// The list of evidence previously uploaded to the specified dispute.
    evidence: option<list<dispute-evidence>>
  }

  record dispute-evidence {
    /// The ID of the dispute the evidence is associated with.
    dispute-id: option<string>,
    evidence-file: option<dispute-evidence-file>,
    /// The Square-generated ID of the evidence.
    evidence-id: option<string>,
    /// Raw text
    evidence-text: option<string>,
    /// The type of the evidence.
    evidence-type: option<string>,
    /// The Square-generated ID of the evidence.
    id: option<string>,
    /// The time when the next action is due, in RFC 3339 format.
    uploaded-at: option<string>
  }

  /// A file to be uploaded as dispute evidence.
  record dispute-evidence-file {
    /// The file name including the file extension. For example: "receipt.tiff".
    filename: option<string>,
    /// Dispute evidence files must be application/pdf, image/heic, image/heif, image/jpeg, image/png, or image/tiff formats.
    filetype: option<string>
  }

  /// Defines the fields in a `CreateDisputeEvidenceText` response.
  record create-dispute-evidence-text-response {
    /// Any errors that occurred during the request.
    errors: option<list<error>>,
    evidence: option<dispute-evidence>
  }

  /// Defines the fields in a `RetrieveDisputeEvidence` response.
  record retrieve-dispute-evidence-response {
    /// Any errors that occurred during the request.
    errors: option<list<error>>,
    evidence: option<dispute-evidence>
  }

  /// Defines the fields in a `DeleteDisputeEvidence` response.
  record delete-dispute-evidence-response {
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  /// Defines the fields in a `SubmitEvidence` response.
  record submit-evidence-response {
    dispute: option<dispute>,
    /// Information about errors encountered during the request.
    errors: option<list<error>>
  }

  /// ListDisputes
  record list-disputes-params {
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>,
    /// The dispute states to filter the result.
    /// If not specified, the endpoint returns all open disputes (the dispute status is not `INQUIRY_CLOSED`, `WON`,
    states: option<string>,
    /// The ID of the location for which to return a list of disputes. If not specified, the endpoint returns
    /// all open disputes (the dispute status is not `INQUIRY_CLOSED`, `WON`, or `LOST`) associated with all locations.
    location-id: option<string>
  }
  list-disputes: func(params: list-disputes-params) -> result<list-disputes-response, string>;

  /// RetrieveDispute
  record retrieve-dispute-params {
    /// The ID of the dispute you want more details about.
    dispute-id: string
  }
  retrieve-dispute: func(params: retrieve-dispute-params) -> result<retrieve-dispute-response, string>;

  /// AcceptDispute
  record accept-dispute-params {
    /// The ID of the dispute you want to accept.
    dispute-id: string
  }
  accept-dispute: func(params: accept-dispute-params) -> result<accept-dispute-response, string>;

  /// ListDisputeEvidence
  record list-dispute-evidence-params {
    /// The ID of the dispute.
    dispute-id: string,
    /// A pagination cursor returned by a previous call to this endpoint.
    /// Provide this cursor to retrieve the next set of results for the original query.
    cursor: option<string>
  }
  list-dispute-evidence: func(params: list-dispute-evidence-params) -> result<list-dispute-evidence-response, string>;

  /// CreateDisputeEvidenceText
  record create-dispute-evidence-text-params {
    /// The ID of the dispute you want to upload evidence for.
    dispute-id: string,
    /// The evidence string.
    evidence-text: string,
    /// The type of evidence you are uploading.
    evidence-type: option<string>,
    /// The Unique ID. For more information, see [Idempotency](https://developer.squareup.com/docs/working-with-apis/idempotency).
    idempotency-key: string
  }
  create-dispute-evidence-text: func(params: create-dispute-evidence-text-params) -> result<create-dispute-evidence-text-response, string>;

  /// RetrieveDisputeEvidence
  record retrieve-dispute-evidence-params {
    /// The ID of the dispute that you want to retrieve evidence from.
    dispute-id: string,
    /// The ID of the evidence to retrieve.
    evidence-id: string
  }
  retrieve-dispute-evidence: func(params: retrieve-dispute-evidence-params) -> result<retrieve-dispute-evidence-response, string>;

  /// DeleteDisputeEvidence
  record delete-dispute-evidence-params {
    /// The ID of the dispute you want to remove evidence from.
    dispute-id: string,
    /// The ID of the evidence you want to remove.
    evidence-id: string
  }
  delete-dispute-evidence: func(params: delete-dispute-evidence-params) -> result<delete-dispute-evidence-response, string>;

  /// SubmitEvidence
  record submit-evidence-params {
    /// The ID of the dispute that you want to submit evidence for.
    dispute-id: string
  }
  submit-evidence: func(params: submit-evidence-params) -> result<submit-evidence-response, string>;

}

interface employees {
  record list-employees-response {
    /// The token to be used to retrieve the next page of results.
    cursor: option<string>,
    employees: option<list<employee>>,
    /// Any errors that occurred during the request.
    errors: option<list<error>>
  }

  /// An employee object that is used by the external API.
  record employee {
    /// A read-only timestamp in RFC 3339 format.
    created-at: option<string>,
    /// The employee's email address
    email: option<string>,
    /// The employee's first name.
    first-name: option<string>,
    /// UUID for this object.
    id: option<string>,
    /// Whether this employee is the owner of the merchant. Each merchant
    /// has one owner employee, and that employee has full authority over
    is-owner: option<bool>,
    /// The employee's last name.
    last-name: option<string>,
    /// A list of location IDs where this employee has access to.
    location-ids: option<list<string>>,
    /// The employee's phone number in E.164 format, i.e. "+12125554250"
    phone-number: option<string>,
    /// Specifies the status of the employees being fetched.
    status: option<string>,
    /// A read-only timestamp in RFC 3339 format.
    updated-at: option<string>
  }

  /// Represents an error encountered during a request to the Connect API.
  /// 
  /// See [Handling errors](https://developer.squareup.com/docs/build-basics/handling-errors) for more information.
  record error {
    /// The high-level category for the error.
    category: string,
    /// The specific code of the error.
    code: string,
    /// A human-readable description of the error for debugging purposes.
    detail: option<string>,
    /// The name of the field provided in the original request (if any) that
    /// the error pertains to.
    field: option<string>
  }

  record retrieve-employee-response {
    employee: option<employee>,
    /// Any errors that occurred during the request.
    errors: option<list<error>>
  }

  /// ListEmployees
  record get-v2-employees-params {
    location-id: option<string>,
    /// Specifies the EmployeeStatus to filter the employee by.
    status: option<string>,
    /// The number of employees to be returned on each page.
    limit: option<s32>,
    /// The token required to retrieve the specified page of results.
    cursor: option<string>
  }
  get-v2-employees: func(params: get-v2-employees-params) -> result<list-employees-response, string>;

  /// RetrieveEmployee
  record get-v2-employees-id-params {
    /// UUID for the employee that was requested.
    id: string
  }
  get-v2-employees-id: func(params: get-v2-employees-id-params) -> result<retrieve-employee-response, string>;

}

interface gift-cards {
  /// A response that contains one or more `GiftCard`. The response might contain a set of `Error`
  /// objects if the request resulted in errors.
  record list-gift-cards-response {
    /// When a response is truncated, it includes a cursor that you can use in a
