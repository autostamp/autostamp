package autostamp:gitlab@0.3.0;

interface application {
  enum put-v3-application-settings-body-enabled-git-access-protocol-enum {
    ssh,
    http,
    nil,
  }

  /// Get the current application settings
  get-v3-application-settings: func() -> result<string, string>;

  /// Modify application settings
  record put-v3-application-settings-params {
    /// Determine if developers can push to master
    default-branch-protection: option<s32>,
    /// The default project visibility
    default-project-visibility: option<s32>,
    /// The default snippet visibility
    default-snippet-visibility: option<s32>,
    /// The default group visibility
    default-group-visibility: option<s32>,
    /// Selected levels cannot be used by non-admin users for projects or snippets. If the public level is restricted, user profiles are only visible to logged in users.
    restricted-visibility-levels: option<list<string>>,
    /// Enabled sources for code import during project creation. OmniAuth must be configured for GitHub, Bitbucket, and GitLab.com
    import-sources: option<string>,
    /// Disable certain OAuth sign-in sources
    disabled-oauth-sign-in-sources: option<list<string>>,
    /// Allow only the selected protocols to be used for Git access.
    enabled-git-access-protocol: option<put-v3-application-settings-body-enabled-git-access-protocol-enum>,
    /// Flag indicating if the Gravatar service is enabled
    gravatar-enabled: option<bool>,
    /// The maximum number of personal projects
    default-projects-limit: option<s32>,
    /// Maximum attachment size in MB
    max-attachment-size: option<s32>,
    /// Session duration in minutes. GitLab restart is required to apply changes.
    session-expire-delay: option<s32>,
    /// Allow users to register any application to use GitLab as an OAuth provider
    user-oauth-applications: option<bool>,
    /// Newly registered users will by default be external
    user-default-external: option<bool>,
    /// Flag indicating if sign up is enabled
    signup-enabled: option<bool>,
    /// Send confirmation email on sign-up
    send-user-confirmation-email: option<bool>,
    /// ONLY users with e-mail addresses that match these domain(s) will be able to sign-up. Wildcards allowed. Use separate lines for multiple entries. Ex: domain.com, *.domain.com
    domain-whitelist: option<string>,
    /// Enable domain blacklist for sign ups
    domain-blacklist-enabled: option<bool>,
    /// Users with e-mail addresses that match these domain(s) will NOT be able to sign-up. Wildcards allowed. Use separate lines for multiple entries. Ex: domain.com, *.domain.com
    domain-blacklist: string,
    /// Text shown after sign up
    after-sign-up-text: option<string>,
    /// Flag indicating if sign in is enabled
    signin-enabled: option<bool>,
    /// Require all users to setup Two-factor authentication
    require-two-factor-authentication: option<bool>,
    /// Amount of time (in hours) that users are allowed to skip forced configuration of two-factor authentication
    two-factor-grace-period: s32,
    /// We will redirect non-logged in users to this page
    home-page-url: option<string>,
    /// We will redirect users to this page after they sign out
    after-sign-out-path: option<string>,
    /// The sign in text of the GitLab application
    sign-in-text: option<string>,
    /// Custom text displayed on the help page
    help-page-text: option<string>,
    /// Enable shared runners for new projects
    shared-runners-enabled: option<bool>,
    /// Shared runners text 
    shared-runners-text: string,
    /// Set the maximum file size each build's artifacts can have
    max-artifacts-size: option<s32>,
    /// Authorization token duration (minutes)
    container-registry-token-expire-delay: option<s32>,
    /// Enable the InfluxDB metrics
    metrics-enabled: option<bool>,
    /// The InfluxDB host
    metrics-host: string,
    /// The UDP port to use for connecting to InfluxDB
    metrics-port: s32,
    /// The amount of InfluxDB connections to open
    metrics-pool-size: s32,
    /// The amount of seconds after which an InfluxDB connection will time out
    metrics-timeout: s32,
    /// A method call is only tracked when it takes longer to complete than the given amount of milliseconds.
    metrics-method-call-threshold: s32,
    /// The sampling interval in seconds
    metrics-sample-interval: s32,
    /// The amount of points to store in a single UDP packet
    metrics-packet-size: s32,
    /// Enable Sidekiq Job Throttling
    sidekiq-throttling-enabled: option<bool>,
    /// Choose which queues you wish to throttle
    sidekiq-throttling-queus: list<string>,
    /// The factor by which the queues should be throttled. A value between 0.0 and 1.0, exclusive.
    sidekiq-throttling-factor: f64,
    /// Helps prevent bots from creating accounts
    recaptcha-enabled: option<bool>,
    /// Generate site key at http://www.google.com/recaptcha
    recaptcha-site-key: string,
    /// Generate private key at http://www.google.com/recaptcha
    recaptcha-private-key: string,
    /// Helps prevent bots from creating issues
    akismet-enabled: option<bool>,
    /// Generate API key at http://www.akismet.com
    akismet-api-key: string,
    /// Abuse reports will be sent to this address if it is set. Abuse reports are always available in the admin area.
    admin-notification-email: option<string>,
    /// Sentry is an error reporting and logging tool which is currently not shipped with GitLab, get it here: https://getsentry.com
    sentry-enabled: option<bool>,
    /// Sentry Data Source Name
    sentry-dsn: string,
    /// Storage paths for new projects
    repository-storage: option<string>,
    /// GitLab will periodically run 'git fsck' in all project and wiki repositories to look for silent disk corruption issues.
    repository-checks-enabled: option<bool>,
    /// Enable Koding
    koding-enabled: option<bool>,
    /// The Koding team URL
    koding-url: string,
    /// Enable PlantUML
    plantuml-enabled: option<bool>,
    /// The PlantUML server URL
    plantuml-url: string,
    /// Let GitLab inform you when an update is available.
    version-check-enabled: option<bool>,
    /// Some email servers do not support overriding the email sender name. Enable this option to include the name of the author of the issue, merge request or comment in the email body instead.
    email-author-in-body: option<bool>,
    /// By default GitLab sends emails in HTML and plain text formats so mail clients can choose what format to use. Disable this option if you only want to send emails in plain text format.
    html-emails-enabled: option<bool>,
    /// Enable automatic repository housekeeping (git repack, git gc)
    housekeeping-enabled: option<bool>,
    /// Creating pack file bitmaps makes housekeeping take a little longer but bitmaps should accelerate 'git clone' performance.
    housekeeping-bitmaps-enabled: bool,
    /// Number of Git pushes after which an incremental 'git repack' is run.
    housekeeping-incremental-repack-period: s32,
    /// Number of Git pushes after which a full 'git repack' is run.
    housekeeping-full-repack-period: s32,
    /// Number of Git pushes after which 'git gc' is run.
    housekeeping-gc-period: s32
  }
  put-v3-application-settings: func(params: put-v3-application-settings-params) -> result<string, string>;

}


interface ci {
  /// Validation of .gitlab-ci.yml content
  record post-v3-ci-lint-params {
    /// Content of .gitlab-ci.yml
    content: string
  }
  post-v3-ci-lint: func(params: post-v3-ci-lint-params) -> result<string, string>;

}

interface deploy-keys {
  get-v3-deploy-keys: func() -> result<string, string>;

}

interface dockerfiles {
  /// Get the list of the available template
  get-v3-dockerfiles: func() -> result<string, string>;

  /// Get the text for a specific template present in local filesystem
  record get-v3-dockerfiles-name-params {
    /// The name of the template
    name: string
  }
  get-v3-dockerfiles-name: func(params: get-v3-dockerfiles-name-params) -> result<string, string>;

}

interface gitignores {
  /// Get the list of the available template
  get-v3-gitignores: func() -> result<string, string>;

  /// Get the text for a specific template present in local filesystem
  record get-v3-gitignores-name-params {
    /// The name of the template
    name: string
  }
  get-v3-gitignores-name: func(params: get-v3-gitignores-name-params) -> result<string, string>;

}

interface gitlab-ci-ymls {
  /// Get the list of the available template
  get-v3-gitlab-ci-ymls: func() -> result<string, string>;

  /// Get the text for a specific template present in local filesystem
  record get-v3-gitlab-ci-ymls-name-params {
    /// The name of the template
    name: string
  }
  get-v3-gitlab-ci-ymls-name: func(params: get-v3-gitlab-ci-ymls-name-params) -> result<string, string>;

}

interface groups {
  enum get-v3-groups-order-by-enum {
    name,
    path,
  }

  enum get-v3-groups-sort-enum {
    asc,
    desc,
  }

  enum get-v3-groups-id-issues-state-enum {
    opened,
    closed,
    all,
  }

  enum get-v3-groups-id-issues-order-by-enum {
    created-at,
    updated-at,
  }

  enum get-v3-groups-id-projects-visibility-enum {
    public,
    internal,
    private,
  }

  enum get-v3-groups-id-projects-order-by-enum {
    id,
    name,
    path,
    created-at,
    updated-at,
    last-activity-at,
  }

  /// Get a groups list
  record get-v3-groups-params {
    /// Include project statistics
    statistics: option<bool>,
    /// Show all group that you have access to
    all-available: option<bool>,
    /// Search for a specific group
    search: option<string>,
    /// Order by name or path
    order-by: option<get-v3-groups-order-by-enum>,
    /// Sort by asc (ascending) or desc (descending)
    sort: option<get-v3-groups-sort-enum>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>,
    /// Array of group ids to exclude from list
    skip-groups: option<list<s32>>
  }
  get-v3-groups: func(params: get-v3-groups-params) -> result<string, string>;

  /// Create a group. Available only for users who can create groups.
  record post-v3-groups-params {
    /// The name of the group
    name: string,
    /// The path of the group
    path: string,
    /// The description of the group
    description: option<string>,
    /// The visibility level of the group
    visibility-level: option<s32>,
    /// Enable/disable LFS for the projects in this group
    lfs-enabled: option<bool>,
    /// Allow users to request member access
    request-access-enabled: option<bool>
  }
  post-v3-groups: func(params: post-v3-groups-params) -> result<string, string>;

  /// Get list of owned groups for authenticated user
  record get-v3-groups-owned-params {
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>,
    /// Include project statistics
    statistics: option<bool>
  }
  get-v3-groups-owned: func(params: get-v3-groups-owned-params) -> result<string, string>;

  /// Get a single group, with containing projects.
  record get-v3-groups-id-params {
    /// The ID of a group
    id: string
  }
  get-v3-groups-id: func(params: get-v3-groups-id-params) -> result<string, string>;

  /// Update a group. Available only for users who can administrate groups.
  record put-v3-groups-id-params {
    /// The ID of a group
    id: string,
    /// The name of the group
    name: option<string>,
    /// The path of the group
    path: option<string>,
    /// The description of the group
    description: option<string>,
    /// The visibility level of the group
    visibility-level: option<s32>,
    /// Enable/disable LFS for the projects in this group
    lfs-enabled: option<bool>,
    /// Allow users to request member access
    request-access-enabled: option<bool>
  }
  put-v3-groups-id: func(params: put-v3-groups-id-params) -> result<string, string>;

  /// Remove a group.
  record delete-v3-groups-id-params {
    /// The ID of a group
    id: string
  }
  delete-v3-groups-id: func(params: delete-v3-groups-id-params) -> result<string, string>;

  /// Gets a list of access requests for a group.
  record get-v3-groups-id-access-requests-params {
    /// The group ID
    id: string,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-groups-id-access-requests: func(params: get-v3-groups-id-access-requests-params) -> result<string, string>;

  /// Requests access for the authenticated user to a group.
  record post-v3-groups-id-access-requests-params {
    /// The group ID
    id: string
  }
  post-v3-groups-id-access-requests: func(params: post-v3-groups-id-access-requests-params) -> result<string, string>;

  /// Denies an access request for the given user.
  record delete-v3-groups-id-access-requests-user-id-params {
    /// The group ID
    id: string,
    /// The user ID of the access requester
    user-id: string
  }
  delete-v3-groups-id-access-requests-user-id: func(params: delete-v3-groups-id-access-requests-user-id-params) -> result<string, string>;

  /// Approves an access request for the given user.
  record put-v3-groups-id-access-requests-user-id-approve-params {
    /// The group ID
    id: string,
    /// The user ID of the access requester
    user-id: string,
    /// A valid access level (defaults: `30`, developer access level)
    access-level: option<s32>
  }
  put-v3-groups-id-access-requests-user-id-approve: func(params: put-v3-groups-id-access-requests-user-id-approve-params) -> result<string, string>;

  /// Get a list of group issues
  record get-v3-groups-id-issues-params {
    /// The ID of a group
    id: string,
    /// Return opened, closed, or all issues
    state: option<get-v3-groups-id-issues-state-enum>,
    /// Comma-separated list of label names
    labels: option<string>,
    /// Return issues for a specific milestone
    milestone: option<string>,
    /// Return issues ordered by `created_at` or `updated_at` fields.
    order-by: option<get-v3-groups-id-issues-order-by-enum>,
    /// Return issues sorted in `asc` or `desc` order.
    sort: option<get-v3-groups-sort-enum>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-groups-id-issues: func(params: get-v3-groups-id-issues-params) -> result<string, string>;

  /// Gets a list of group or project members viewable by the authenticated user.
  record get-v3-groups-id-members-params {
    /// The group ID
    id: string,
    /// A query string to search for members
    query: option<string>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-groups-id-members: func(params: get-v3-groups-id-members-params) -> result<string, string>;

  /// Adds a member to a group or project.
  record post-v3-groups-id-members-params {
    /// The group ID
    id: string,
    /// The user ID of the new member
    user-id: s32,
    /// A valid access level (defaults: `30`, developer access level)
    access-level: s32,
    /// Date string in the format YEAR-MONTH-DAY
    expires-at: option<string>
  }
  post-v3-groups-id-members: func(params: post-v3-groups-id-members-params) -> result<string, string>;

  /// Gets a member of a group or project.
  record get-v3-groups-id-members-user-id-params {
    /// The group ID
    id: string,
    /// The user ID of the member
    user-id: string
  }
  get-v3-groups-id-members-user-id: func(params: get-v3-groups-id-members-user-id-params) -> result<string, string>;

  /// Updates a member of a group or project.
  record put-v3-groups-id-members-user-id-params {
    /// The group ID
    id: string,
    /// The user ID of the new member
    user-id: string,
    /// A valid access level
    access-level: s32,
    /// Date string in the format YEAR-MONTH-DAY
    expires-at: option<string>
  }
  put-v3-groups-id-members-user-id: func(params: put-v3-groups-id-members-user-id-params) -> result<string, string>;

  /// Removes a user from a group or project.
  record delete-v3-groups-id-members-user-id-params {
    /// The group ID
    id: string,
    /// The user ID of the member
    user-id: string
  }
  delete-v3-groups-id-members-user-id: func(params: delete-v3-groups-id-members-user-id-params) -> result<string, string>;

  /// Get group level notification level settings, defaults to Global
  record get-v3-groups-id-notification-settings-params {
    /// The group ID or project ID or project NAMESPACE/PROJECT_NAME
    id: string
  }
  get-v3-groups-id-notification-settings: func(params: get-v3-groups-id-notification-settings-params) -> result<string, string>;

  /// Update group level notification level settings, defaults to Global
  record put-v3-groups-id-notification-settings-params {
    /// The group ID or project ID or project NAMESPACE/PROJECT_NAME
    id: string,
    /// The group notification level
    level: option<string>,
    /// Enable/disable this notification
    new-note: option<bool>,
    /// Enable/disable this notification
    new-issue: option<bool>,
    /// Enable/disable this notification
    reopen-issue: option<bool>,
    /// Enable/disable this notification
    close-issue: option<bool>,
    /// Enable/disable this notification
    reassign-issue: option<bool>,
    /// Enable/disable this notification
    new-merge-request: option<bool>,
    /// Enable/disable this notification
    reopen-merge-request: option<bool>,
    /// Enable/disable this notification
    close-merge-request: option<bool>,
    /// Enable/disable this notification
    reassign-merge-request: option<bool>,
    /// Enable/disable this notification
    merge-merge-request: option<bool>,
    /// Enable/disable this notification
    failed-pipeline: option<bool>,
    /// Enable/disable this notification
    success-pipeline: option<bool>
  }
  put-v3-groups-id-notification-settings: func(params: put-v3-groups-id-notification-settings-params) -> result<string, string>;

  /// Get a list of projects in this group.
  record get-v3-groups-id-projects-params {
    /// The ID of a group
    id: string,
    /// Limit by archived status
    archived: option<bool>,
    /// Limit by visibility
    visibility: option<get-v3-groups-id-projects-visibility-enum>,
    /// Return list of authorized projects matching the search criteria
    search: option<string>,
    /// Return projects ordered by field
    order-by: option<get-v3-groups-id-projects-order-by-enum>,
    /// Return projects sorted in ascending and descending order
    sort: option<get-v3-groups-sort-enum>,
    /// Return only the ID, URL, name, and path of each project
    simple: option<bool>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-groups-id-projects: func(params: get-v3-groups-id-projects-params) -> result<string, string>;

  /// Transfer a project to the group namespace. Available only for admin.
  record post-v3-groups-id-projects-project-id-params {
    /// The ID of a group
    id: string,
    /// The ID or path of the project
    project-id: string
  }
  post-v3-groups-id-projects-project-id: func(params: post-v3-groups-id-projects-project-id-params) -> result<string, string>;

}

interface hooks {
  /// Get the list of system hooks
  get-v3-hooks: func() -> result<string, string>;

  /// Create a new system hook
  record post-v3-hooks-params {
    /// The URL to send the request to
    url: string,
    /// The token used to validate payloads
    token: option<string>,
    /// Trigger hook on push events
    push-events: option<bool>,
    /// Trigger hook on tag push events
    tag-push-events: option<bool>,
    /// Do SSL verification when triggering the hook
    enable-ssl-verification: option<bool>
  }
  post-v3-hooks: func(params: post-v3-hooks-params) -> result<string, string>;

  /// Test a hook
  record get-v3-hooks-id-params {
    /// The ID of the system hook
    id: string
  }
  get-v3-hooks-id: func(params: get-v3-hooks-id-params) -> result<string, string>;

  /// Delete a hook
  record delete-v3-hooks-id-params {
    /// The ID of the system hook
    id: string
  }
  delete-v3-hooks-id: func(params: delete-v3-hooks-id-params) -> result<string, string>;

}

interface internal {
  post-v3-internal-allowed: func() -> result<string, string>;

  get-v3-internal-broadcast-message: func() -> result<string, string>;

  get-v3-internal-check: func() -> result<string, string>;

  get-v3-internal-discover: func() -> result<string, string>;

  post-v3-internal-lfs-authenticate: func() -> result<string, string>;

  get-v3-internal-merge-request-urls: func() -> result<string, string>;

  post-v3-internal-two-factor-recovery-codes: func() -> result<string, string>;

}

interface issues {
  enum get-v3-issues-state-enum {
    opened,
    closed,
    all,
  }

  enum get-v3-issues-order-by-enum {
    created-at,
    updated-at,
  }

  enum get-v3-issues-sort-enum {
    asc,
    desc,
  }

  /// Get currently authenticated user's issues
  record get-v3-issues-params {
    /// Return opened, closed, or all issues
    state: option<get-v3-issues-state-enum>,
    /// Comma-separated list of label names
    labels: option<string>,
    /// Return issues for a specific milestone
    milestone: option<string>,
    /// Return issues ordered by `created_at` or `updated_at` fields.
    order-by: option<get-v3-issues-order-by-enum>,
    /// Return issues sorted in `asc` or `desc` order.
    sort: option<get-v3-issues-sort-enum>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-issues: func(params: get-v3-issues-params) -> result<string, string>;

}

interface keys {
  /// Get single ssh key by id. Only available to admin users
  record get-v3-keys-id-params {
    id: string
  }
  get-v3-keys-id: func(params: get-v3-keys-id-params) -> result<string, string>;

}

interface licenses {
  /// Get the list of the available license template
  record get-v3-licenses-params {
    /// If passed, returns only popular licenses
    popular: option<bool>
  }
  get-v3-licenses: func(params: get-v3-licenses-params) -> result<string, string>;

  /// Get the text for a specific license
  record get-v3-licenses-name-params {
    /// The name of the template
    name: string
  }
  get-v3-licenses-name: func(params: get-v3-licenses-name-params) -> result<string, string>;

}

interface namespaces {
  /// Get a namespaces list
  record get-v3-namespaces-params {
    /// Search query for namespaces
    search: option<string>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-namespaces: func(params: get-v3-namespaces-params) -> result<string, string>;

}

interface notification-settings {
  /// Get global notification level settings and email, defaults to Participate
  get-v3-notification-settings: func() -> result<string, string>;

  /// Update global notification level settings and email, defaults to Participate
  record put-v3-notification-settings-params {
    /// The global notification level
    level: option<string>,
    /// The email address to send notifications
    notification-email: option<string>,
    /// Enable/disable this notification
    new-note: option<bool>,
    /// Enable/disable this notification
    new-issue: option<bool>,
    /// Enable/disable this notification
    reopen-issue: option<bool>,
    /// Enable/disable this notification
    close-issue: option<bool>,
    /// Enable/disable this notification
    reassign-issue: option<bool>,
    /// Enable/disable this notification
    new-merge-request: option<bool>,
    /// Enable/disable this notification
    reopen-merge-request: option<bool>,
    /// Enable/disable this notification
    close-merge-request: option<bool>,
    /// Enable/disable this notification
    reassign-merge-request: option<bool>,
    /// Enable/disable this notification
    merge-merge-request: option<bool>,
    /// Enable/disable this notification
    failed-pipeline: option<bool>,
    /// Enable/disable this notification
    success-pipeline: option<bool>
  }
  put-v3-notification-settings: func(params: put-v3-notification-settings-params) -> result<string, string>;

}

interface projects {
  enum get-v3-projects-order-by-enum {
    id,
    name,
    path,
    created-at,
    updated-at,
    last-activity-at,
  }

  enum get-v3-projects-sort-enum {
    asc,
    desc,
  }

  enum get-v3-projects-visibility-enum {
    public,
    internal,
    private,
  }

  enum get-v3-projects-id-builds-scope-enum {
    pending,
    running,
    failed,
    success,
    canceled,
  }

  enum get-v3-projects-id-issues-state-enum {
    opened,
    closed,
    all,
  }

  enum get-v3-projects-id-issues-order-by-enum {
    created-at,
    updated-at,
  }

  enum put-v3-projects-id-issues-issue-id-body-state-event-enum {
    reopen,
