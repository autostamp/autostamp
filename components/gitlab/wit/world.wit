  /// Get a projects list for authenticated user
  record get-v3-projects-params {
    /// Return projects ordered by field
    order-by: option<get-v3-projects-order-by-enum>,
    /// Return projects sorted in ascending and descending order
    sort: option<get-v3-projects-sort-enum>,
    /// Limit by archived status
    archived: option<bool>,
    /// Limit by visibility
    visibility: option<get-v3-projects-visibility-enum>,
    /// Return list of authorized projects matching the search criteria
    search: option<string>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>,
    /// Return only the ID, URL, name, and path of each project
    simple: option<bool>
  }
