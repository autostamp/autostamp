    /// Flag indication if the container registry is enabled for that project
    container-registry-enabled: option<bool>,
    /// Flag indication if Git LFS is enabled for that project
    lfs-enabled: option<bool>,
    /// Create a public project. The same as visibility_level = 20.
    public: option<bool>,
    /// Create a public project. The same as visibility_level = 20.
    visibility-level: option<s32>,
    /// Perform public builds
    public-builds: option<bool>,
    /// Allow users to request member access
    request-access-enabled: option<bool>,
    /// Only allow to merge if builds succeed
    only-allow-merge-if-build-succeeds: option<bool>,
    /// Only allow to merge if all discussions are resolved
    only-allow-merge-if-all-discussions-are-resolved: option<bool>,
    /// Namespace ID for the new project. Default to the user namespace.
    namespace-id: option<s32>,
    /// URL from which the project is imported
    import-url: option<string>
  }
  post-v3-projects: func(params: post-v3-projects-params) -> result<string, string>;

