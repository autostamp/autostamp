  record post-v3-projects-id-star-params {
    /// The ID of a project
    id: string
  }
  post-v3-projects-id-star: func(params: post-v3-projects-id-star-params) -> result<string, string>;

  /// Unstar a project
  record delete-v3-projects-id-star-params {
    /// The ID of a project
    id: string
  }
  delete-v3-projects-id-star: func(params: delete-v3-projects-id-star-params) -> result<string, string>;

  /// Post status to a commit
  record post-v3-projects-id-statuses-sha-params {
    /// The ID of a project
    id: string,
    /// The commit hash
    sha: string,
    /// The state of the status
    state: post-v3-projects-id-statuses-sha-body-state-enum,
    /// The ref
    ref: option<string>,
    /// The target URL to associate with this status
    target-url: option<string>,
    /// A short description of the status
    description: option<string>,
    /// A string label to differentiate this status from the status of other systems. Default: "default"
    name: option<string>,
    /// A string label to differentiate this status from the status of other systems. Default: "default"
    context: option<string>
  }
  post-v3-projects-id-statuses-sha: func(params: post-v3-projects-id-statuses-sha-params) -> result<string, string>;

  /// Get triggers list
  record get-v3-projects-id-triggers-params {
    /// The ID of a project
    id: string,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-projects-id-triggers: func(params: get-v3-projects-id-triggers-params) -> result<string, string>;

  /// Create a trigger
  record post-v3-projects-id-triggers-params {
    /// The ID of a project
    id: string
  }
  post-v3-projects-id-triggers: func(params: post-v3-projects-id-triggers-params) -> result<string, string>;

  /// Get specific trigger of a project
  record get-v3-projects-id-triggers-token-params {
    /// The ID of a project
    id: string,
    /// The unique token of trigger
    token: string
  }
  get-v3-projects-id-triggers-token: func(params: get-v3-projects-id-triggers-token-params) -> result<string, string>;

  /// Delete a trigger
  record delete-v3-projects-id-triggers-token-params {
    /// The ID of a project
    id: string,
    /// The unique token of trigger
    token: string
  }
  delete-v3-projects-id-triggers-token: func(params: delete-v3-projects-id-triggers-token-params) -> result<string, string>;

  /// Unarchive a project
  record post-v3-projects-id-unarchive-params {
    /// The ID of a project
    id: string
  }
  post-v3-projects-id-unarchive: func(params: post-v3-projects-id-unarchive-params) -> result<string, string>;

  /// Upload a file
  record post-v3-projects-id-uploads-params {
    /// The ID of a project
    id: string,
    /// The file to be uploaded
    file: string
  }
  post-v3-projects-id-uploads: func(params: post-v3-projects-id-uploads-params) -> result<string, string>;

  /// Get the users list of a project
  record get-v3-projects-id-users-params {
    /// The ID of a project
    id: string,
    /// Return list of users matching the search criteria
    search: option<string>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-projects-id-users: func(params: get-v3-projects-id-users-params) -> result<string, string>;

  /// Get project variables
  record get-v3-projects-id-variables-params {
    /// The ID of a project
    id: string,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-projects-id-variables: func(params: get-v3-projects-id-variables-params) -> result<string, string>;

  /// Create a new variable in a project
  record post-v3-projects-id-variables-params {
    /// The ID of a project
    id: string,
    /// The key of the variable
    key: string,
    /// The value of the variable
    value: string
  }
  post-v3-projects-id-variables: func(params: post-v3-projects-id-variables-params) -> result<string, string>;

  /// Get a specific variable from a project
  record get-v3-projects-id-variables-key-params {
    /// The ID of a project
    id: string,
    /// The key of the variable
    key: string
  }
  get-v3-projects-id-variables-key: func(params: get-v3-projects-id-variables-key-params) -> result<string, string>;

  /// Update an existing variable from a project
  record put-v3-projects-id-variables-key-params {
    /// The ID of a project
    id: string,
    /// The key of the variable
    key: string,
    /// The value of the variable
    value: option<string>
  }
  put-v3-projects-id-variables-key: func(params: put-v3-projects-id-variables-key-params) -> result<string, string>;

  /// Delete an existing variable from a project
  record delete-v3-projects-id-variables-key-params {
    /// The ID of a project
    id: string,
    /// The key of the variable
    key: string
  }
  delete-v3-projects-id-variables-key: func(params: delete-v3-projects-id-variables-key-params) -> result<string, string>;

}

interface runners {
  enum get-v3-runners-scope-enum {
    active,
    paused,
    online,
  }

  enum get-v3-runners-all-scope-enum {
    active,
    paused,
    online,
    specific,
    shared,
  }

  /// Get runners available for user
  record get-v3-runners-params {
    /// The scope of specific runners to show
    scope: option<get-v3-runners-scope-enum>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-runners: func(params: get-v3-runners-params) -> result<string, string>;

  /// Get all runners - shared and specific
  record get-v3-runners-all-params {
    /// The scope of specific runners to show
    scope: option<get-v3-runners-all-scope-enum>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-runners-all: func(params: get-v3-runners-all-params) -> result<string, string>;

  /// Get runner's details
  record get-v3-runners-id-params {
    /// The ID of the runner
    id: string
  }
  get-v3-runners-id: func(params: get-v3-runners-id-params) -> result<string, string>;

  /// Update runner's details
  record put-v3-runners-id-params {
    /// The ID of the runner
    id: string,
    /// The description of the runner
    description: option<string>,
    /// The state of a runner
    active: option<bool>,
    /// The list of tags for a runner
    tag-list: option<list<string>>,
    /// Flag indicating the runner can execute untagged jobs
    run-untagged: option<bool>,
    /// Flag indicating the runner is locked
    locked: option<bool>
  }
  put-v3-runners-id: func(params: put-v3-runners-id-params) -> result<string, string>;

  /// Remove a runner
  record delete-v3-runners-id-params {
    /// The ID of the runner
    id: string
  }
  delete-v3-runners-id: func(params: delete-v3-runners-id-params) -> result<string, string>;

}

interface session {
  /// Login to get token
  record post-v3-session-params {
    /// The username
    login: option<string>,
    /// The email of the user
    email: option<string>,
    /// The password of the user
    password: string
  }
  post-v3-session: func(params: post-v3-session-params) -> result<string, string>;

}

interface sidekiq {
  /// Get the Sidekiq Compound metrics. Includes queue, process, and job statistics
  get-v3-sidekiq-compound-metrics: func() -> result<string, string>;

  /// Get the Sidekiq job statistics
  get-v3-sidekiq-job-stats: func() -> result<string, string>;

  /// Get the Sidekiq process metrics
  get-v3-sidekiq-process-metrics: func() -> result<string, string>;

  /// Get the Sidekiq queue metrics
  get-v3-sidekiq-queue-metrics: func() -> result<string, string>;

}

interface snippets {
  /// Get a snippets list for authenticated user
  record get-v3-snippets-params {
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-snippets: func(params: get-v3-snippets-params) -> result<string, string>;

  /// Create new snippet
  record post-v3-snippets-params {
    /// The title of a snippet
    title: string,
    /// The name of a snippet file
    file-name: string,
    /// The content of a snippet
    content: string,
    /// The visibility level of the snippet
    visibility-level: option<s32>
  }
  post-v3-snippets: func(params: post-v3-snippets-params) -> result<string, string>;

  /// List all public snippets current_user has access to
  record get-v3-snippets-public-params {
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-snippets-public: func(params: get-v3-snippets-public-params) -> result<string, string>;

  /// Get a single snippet
  record get-v3-snippets-id-params {
    /// The ID of a snippet
    id: string
  }
  get-v3-snippets-id: func(params: get-v3-snippets-id-params) -> result<string, string>;

  /// Update an existing snippet
  record put-v3-snippets-id-params {
    /// The ID of a snippet
    id: string,
    /// The title of a snippet
    title: option<string>,
    /// The name of a snippet file
    file-name: option<string>,
    /// The content of a snippet
    content: option<string>,
    /// The visibility level of the snippet
    visibility-level: option<s32>
  }
  put-v3-snippets-id: func(params: put-v3-snippets-id-params) -> result<string, string>;

  /// Remove snippet
  record delete-v3-snippets-id-params {
    /// The ID of a snippet
    id: string
  }
  delete-v3-snippets-id: func(params: delete-v3-snippets-id-params) -> result<string, string>;

  /// Get a raw snippet
  record get-v3-snippets-id-raw-params {
    /// The ID of a snippet
    id: string
  }
  get-v3-snippets-id-raw: func(params: get-v3-snippets-id-raw-params) -> result<string, string>;

}

interface templates {
  /// Get the list of the available template
  get-v3-templates-dockerfiles: func() -> result<string, string>;

  /// Get the text for a specific template present in local filesystem
  record get-v3-templates-dockerfiles-name-params {
    /// The name of the template
    name: string
  }
  get-v3-templates-dockerfiles-name: func(params: get-v3-templates-dockerfiles-name-params) -> result<string, string>;

  /// Get the list of the available template
  get-v3-templates-gitignores: func() -> result<string, string>;

  /// Get the text for a specific template present in local filesystem
  record get-v3-templates-gitignores-name-params {
    /// The name of the template
    name: string
  }
  get-v3-templates-gitignores-name: func(params: get-v3-templates-gitignores-name-params) -> result<string, string>;

  /// Get the list of the available template
  get-v3-templates-gitlab-ci-ymls: func() -> result<string, string>;

  /// Get the text for a specific template present in local filesystem
  record get-v3-templates-gitlab-ci-ymls-name-params {
    /// The name of the template
    name: string
  }
  get-v3-templates-gitlab-ci-ymls-name: func(params: get-v3-templates-gitlab-ci-ymls-name-params) -> result<string, string>;

  /// Get the list of the available license template
  record get-v3-templates-licenses-params {
    /// If passed, returns only popular licenses
    popular: option<bool>
  }
  get-v3-templates-licenses: func(params: get-v3-templates-licenses-params) -> result<string, string>;

  /// Get the text for a specific license
  record get-v3-templates-licenses-name-params {
    /// The name of the template
    name: string
  }
  get-v3-templates-licenses-name: func(params: get-v3-templates-licenses-name-params) -> result<string, string>;

}

interface todos {
  /// Get a todo list
  record get-v3-todos-params {
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-todos: func(params: get-v3-todos-params) -> result<string, string>;

  /// Mark all todos as done
  delete-v3-todos: func() -> result<string, string>;

  /// Mark a todo as done
  record delete-v3-todos-id-params {
    /// The ID of the todo being marked as done
    id: string
  }
  delete-v3-todos-id: func(params: delete-v3-todos-id-params) -> result<string, string>;

}

interface user {
  /// Get the currently authenticated user
  get-v3-user: func() -> result<string, string>;

  /// Get the currently authenticated user's email addresses
  get-v3-user-emails: func() -> result<string, string>;

  /// Add new email address to the currently authenticated user
  record post-v3-user-emails-params {
    /// The new email
    email: string
  }
  post-v3-user-emails: func(params: post-v3-user-emails-params) -> result<string, string>;

  /// Get a single email address owned by the currently authenticated user
  record get-v3-user-emails-email-id-params {
    /// The ID of the email
    email-id: string
  }
  get-v3-user-emails-email-id: func(params: get-v3-user-emails-email-id-params) -> result<string, string>;

  /// Delete an email address from the currently authenticated user
  record delete-v3-user-emails-email-id-params {
    /// The ID of the email
    email-id: string
  }
  delete-v3-user-emails-email-id: func(params: delete-v3-user-emails-email-id-params) -> result<string, string>;

  /// Get the currently authenticated user's SSH keys
  get-v3-user-keys: func() -> result<string, string>;

  /// Add a new SSH key to the currently authenticated user
  record post-v3-user-keys-params {
    /// The new SSH key
    key: string,
    /// The title of the new SSH key
    title: string
  }
  post-v3-user-keys: func(params: post-v3-user-keys-params) -> result<string, string>;

  /// Get a single key owned by currently authenticated user
  record get-v3-user-keys-key-id-params {
    /// The ID of the SSH key
    key-id: string
  }
  get-v3-user-keys-key-id: func(params: get-v3-user-keys-key-id-params) -> result<string, string>;

  /// Delete an SSH key from the currently authenticated user
  record delete-v3-user-keys-key-id-params {
    /// The ID of the SSH key
    key-id: string
  }
  delete-v3-user-keys-key-id: func(params: delete-v3-user-keys-key-id-params) -> result<string, string>;

}

interface users {
  /// Get the list of users
  record get-v3-users-params {
    /// Get a single user with a specific username
    username: option<string>,
    /// Search for a username
    search: option<string>,
    /// Filters only active users
    active: option<bool>,
    /// Filters only external users
    external: option<bool>,
    /// Filters only blocked users
    blocked: option<bool>,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-users: func(params: get-v3-users-params) -> result<string, string>;

  /// Create a user. Available only for admins.
  record post-v3-users-params {
    /// The email of the user
    email: string,
    /// The password of the new user
    password: string,
    /// The name of the user
    name: string,
    /// The username of the user
    username: string,
    /// The Skype username
    skype: option<string>,
    /// The LinkedIn username
    linkedin: option<string>,
    /// The Twitter username
    twitter: option<string>,
    /// The website of the user
    website-url: option<string>,
    /// The organization of the user
    organization: option<string>,
    /// The number of projects a user can create
    projects-limit: option<s32>,
    /// The external authentication provider UID
    extern-uid: option<string>,
    /// The external provider
    provider: option<string>,
    /// The biography of the user
    bio: option<string>,
    /// The location of the user
    location: option<string>,
    /// Flag indicating the user is an administrator
    admin: option<bool>,
    /// Flag indicating the user can create groups
    can-create-group: option<bool>,
    /// Flag indicating the account needs to be confirmed
    confirm: option<bool>,
    /// Flag indicating the user is an external user
    external: option<bool>
  }
  post-v3-users: func(params: post-v3-users-params) -> result<string, string>;

  /// Get a single user
  record get-v3-users-id-params {
    /// The ID of the user
    id: string
  }
  get-v3-users-id: func(params: get-v3-users-id-params) -> result<string, string>;

  /// Update a user. Available only for admins.
  record put-v3-users-id-params {
    /// The ID of the user
    id: string,
    /// The email of the user
    email: option<string>,
    /// The password of the new user
    password: option<string>,
    /// The name of the user
    name: option<string>,
    /// The username of the user
    username: option<string>,
    /// The Skype username
    skype: option<string>,
    /// The LinkedIn username
    linkedin: option<string>,
    /// The Twitter username
    twitter: option<string>,
    /// The website of the user
    website-url: option<string>,
    /// The organization of the user
    organization: option<string>,
    /// The number of projects a user can create
    projects-limit: option<s32>,
    /// The external authentication provider UID
    extern-uid: option<string>,
    /// The external provider
    provider: option<string>,
    /// The biography of the user
    bio: option<string>,
    /// The location of the user
    location: option<string>,
    /// Flag indicating the user is an administrator
    admin: option<bool>,
    /// Flag indicating the user can create groups
    can-create-group: option<bool>,
    /// Flag indicating the account needs to be confirmed
    confirm: option<bool>,
    /// Flag indicating the user is an external user
    external: option<bool>
  }
  put-v3-users-id: func(params: put-v3-users-id-params) -> result<string, string>;

  /// Delete a user. Available only for admins.
  record delete-v3-users-id-params {
    /// The ID of the user
    id: string
  }
  delete-v3-users-id: func(params: delete-v3-users-id-params) -> result<string, string>;

  /// Block a user. Available only for admins.
  record put-v3-users-id-block-params {
    /// The ID of the user
    id: string
  }
  put-v3-users-id-block: func(params: put-v3-users-id-block-params) -> result<string, string>;

  /// Get the emails addresses of a specified user. Available only for admins.
  record get-v3-users-id-emails-params {
    /// The ID of the user
    id: string
  }
  get-v3-users-id-emails: func(params: get-v3-users-id-emails-params) -> result<string, string>;

  /// Add an email address to a specified user. Available only for admins.
  record post-v3-users-id-emails-params {
    /// The ID of the user
    id: string,
    /// The email of the user
    email: string
  }
  post-v3-users-id-emails: func(params: post-v3-users-id-emails-params) -> result<string, string>;

  /// Delete an email address of a specified user. Available only for admins.
  record delete-v3-users-id-emails-email-id-params {
    /// The ID of the user
    id: string,
    /// The ID of the email
    email-id: string
  }
  delete-v3-users-id-emails-email-id: func(params: delete-v3-users-id-emails-email-id-params) -> result<string, string>;

  /// Get the contribution events of a specified user
  record get-v3-users-id-events-params {
    /// The ID of the user
    id: string,
    /// Current page number
    page: option<s32>,
    /// Number of items per page
    per-page: option<s32>
  }
  get-v3-users-id-events: func(params: get-v3-users-id-events-params) -> result<string, string>;

  /// Get the SSH keys of a specified user. Available only for admins.
  record get-v3-users-id-keys-params {
    /// The ID of the user
    id: string
  }
  get-v3-users-id-keys: func(params: get-v3-users-id-keys-params) -> result<string, string>;

  /// Add an SSH key to a specified user. Available only for admins.
  record post-v3-users-id-keys-params {
    /// The ID of the user
    id: string,
    /// The new SSH key
    key: string,
    /// The title of the new SSH key
    title: string
  }
  post-v3-users-id-keys: func(params: post-v3-users-id-keys-params) -> result<string, string>;

  /// Delete an existing SSH key from a specified user. Available only for admins.
  record delete-v3-users-id-keys-key-id-params {
    /// The ID of the user
    id: string,
    /// The ID of the SSH key
    key-id: string
  }
  delete-v3-users-id-keys-key-id: func(params: delete-v3-users-id-keys-key-id-params) -> result<string, string>;

  /// Unblock a user. Available only for admins.
  record put-v3-users-id-unblock-params {
    /// The ID of the user
    id: string
  }
  put-v3-users-id-unblock: func(params: put-v3-users-id-unblock-params) -> result<string, string>;

}

interface version {
  /// Get the version information of the GitLab instance.
  get-v3-version: func() -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export application;
  export ci;
  export deploy-keys;
  export dockerfiles;
  export gitignores;
  export gitlab-ci-ymls;
  export groups;
  export hooks;
  export internal;
  export issues;
  export keys;
  export licenses;
  export namespaces;
  export notification-settings;
  export projects;
  export runners;
  export session;
  export sidekiq;
  export snippets;
  export templates;
  export todos;
  export user;
  export users;
  export version;
}
