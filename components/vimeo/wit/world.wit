  export channels-subscriptions-and-subscribers;
  export channels-videos;
  export videos-comments;
  export videos-credits;
  export likes-essentials;
  export videos-thumbnails;
  export videos-viewing-privacy;
  export videos-text-tracks;
  export videos-content-ratings;
  export videos-creative-commons;
  export groups-essentials;
  export groups-users;
  export groups-videos;
  export videos-languages;
  export users-essentials;
  export albums-essentials;
  export albums-album-videos;
  export videos-essentials;
  export categories-subscriptions;
  export embed-presets-custom-logos;
  export users-feed;
  export users-follows;
  export groups-subscription;
  export on-demand-essentials;
  export on-demand-purchases-and-rentals;
  export users-pictures;
  export portfolios-essentials;
  export portfolios-videos;
  export embed-presets-essentials;
  export embed-presets-videos;
  export projects-essentials;
  export projects-videos;
  export videos-upload;
  export users-watch-history;
  export watch-later-queue-essentials;
  export authentication-extras-essentials;
  export on-demand-genres;
  export on-demand-backgrounds;
  export on-demand-posters;
  export on-demand-promotions;
  export on-demand-regions;
  export on-demand-seasons;
  export on-demand-videos;
  export tags-essentials;
  export videos-tags;
  export users-internal;
  export albums-custom-album-thumbnails;
  export albums-custom-album-logos;
  export videos-embed-privacy;
  export videos-versions;
  export videos-recommendations;
}
