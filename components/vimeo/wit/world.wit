  record user-metadata-connections-shared {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos uploaded by this user.
  record user-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has watched.
  record user-metadata-connections-watched-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user wants to watch later.
  record user-metadata-connections-watchlater {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-metadata-interactions {
    add-privacy-user: option<user-metadata-interactions-add-privacy-user>,
    /// Information related to the block status of this user.
    block: user-metadata-interactions-block,
    /// Information related to the followed status of this user.
    follow: user-metadata-interactions-follow,
    /// Information regarding where and how to report a user.
    report: user-metadata-interactions-report
  }

  record user-metadata-interactions-add-privacy-user {
    /// An array of the HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: option<string>
  }

  /// Information related to the block status of this user.
  record user-metadata-interactions-block {
    /// Whether a user is blocking the current user.
    added: bool,
    /// The time in ISO 8601 format when the block occurred, or the null value if no block exists.
    added-time: string,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to block or unblock the user.
    uri: string
  }

  /// Information related to the followed status of this user.
  record user-metadata-interactions-follow {
    /// Whether a user is following the current user.
    added: bool,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to follow the user.
    uri: string
  }

  /// Information regarding where and how to report a user.
  record user-metadata-interactions-report {
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// List of valid reasons for reporting a video.
    reason: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-preferences {
    videos: option<user-preferences-videos>
  }

  record user-preferences-videos {
    privacy: option<user-preferences-videos-privacy>
  }

  record user-preferences-videos-privacy {
    /// Whether other users can add the user's videos.
    add: option<bool>,
    /// The user's privacy preference for comments:
    /// 
    comments: option<user-preferences-videos-privacy-comments-enum>,
    /// Whether other users can download the user's videos.
    download: option<bool>,
    /// The user's privacy preference for embeds:
    /// 
    embed: option<user-preferences-videos-privacy-embed-enum>,
    /// The user's privacy preference for views:
    /// 
    view: option<user-preferences-videos-privacy-view-enum>
  }

  /// Appears only when the user has upload access and is looking at their own user record.
  record user-upload-quota {
    /// Information about the user's lifetime upload usage.
    lifetime: user-upload-quota-lifetime,
    /// Information about the user's usage for the current period.
    periodic: user-upload-quota-periodic,
    /// Information about the user's upload space remaining for the current period.
    space: user-upload-quota-space
  }

  /// Information about the user's lifetime upload usage.
  record user-upload-quota-lifetime {
    /// The number of bytes remaining in your lifetime maximum.
    free: f64,
    /// The total number of bytes that you can upload across the lifetime of your account.
    max: f64,
    /// The number of bytes that you've already uploaded against your lifetime limit.
    used: f64
  }

  /// Information about the user's usage for the current period.
  record user-upload-quota-periodic {
    /// The number of bytes remaining in your upload quota for the current period.
    free: f64,
    /// The total number of bytes that you can upload per period.
    max: f64,
    /// The time in ISO 8601 format when your upload quota resets.
    reset-date: string,
    /// The number of bytes that you've already uploaded against your quota in the current period.
    used: f64
  }

  /// Information about the user's upload space remaining for the current period.
  record user-upload-quota-space {
    /// The number of bytes remaining in your upload quota.
    free: f64,
    /// The maximum number of bytes allotted to your upload quota.
    max: f64,
    /// Whether the values of the upload_quota.space fields are for the lifetime quota or the periodic quota.
    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  /// The video's privacy setting.
  record video-privacy {
    /// Whether the video can be added to collections.
    add: bool,
    /// Who can comment on the video:
    /// 
    comments: user-preferences-videos-privacy-comments-enum,
    /// The video's download permission setting.
    download: bool,
    /// The video's embed permission setting:
    /// 
    embed: video-privacy-embed-enum,
    /// The general privacy setting for the video:
    /// 
    view: user-preferences-videos-privacy-view-enum
  }

  /// 360 spatial data.
  record video-spatial {
    /// 360 director timeline.
    director-timeline: list<video-spatial-director-timeline-item>,
    /// The 360 field of view, from 30 (minimum) to 90 (maximum). The default is 50.
    field-of-view: f64,
    /// The 360 spatial projection:
    /// 
    projection: video-spatial-projection-enum,
    /// The 360 stereo format:
    /// 
    stereo-format: video-spatial-stereo-format-enum
  }

  record video-spatial-director-timeline-item {
    /// The director timeline pitch, from -90 (minimum) to 90 (maximum).
    pitch: option<f64>,
    /// The director timeline roll.
    roll: option<f64>,
    /// The director timeline time code.
    time-code: option<f64>,
    /// The director timeline yaw, from 0 (minimum) to 360 (maximum).
    yaw: option<f64>
  }

  /// A collection of stats associated with this video.
  record video-stats {
    /// The current total number of times that the video has been played.
    plays: f64
  }

  record tag {
    /// The normalized canonical tag name.
    canonical: string,
    /// Metadata about the group.
    metadata: tag-metadata,
    /// The tag value.
    name: string,
    /// The tag's resource key string.
    resource-key: string,
    /// The canonical relative URI of the tag.
    uri: string
  }

  /// Metadata about the group.
  record tag-metadata {
    /// A collection of information that is connected to this resource.
    connections: tag-metadata-connections
  }

  /// A collection of information that is connected to this resource.
  record tag-metadata-connections {
    /// Information about the videos related to this tag.
    videos: tag-metadata-connections-videos
  }

  /// Information about the videos related to this tag.
  record tag-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// The transcode information for a video upload.
  record video-transcode {
    /// Status code for this video's availability.
    status: option<video-transcode-status-enum>
  }

  /// The upload information for this video.
  record video-upload {
    /// The approach for uploading the video.
    approach: option<video-upload-approach-enum>,
    /// The URI for completing the upload.
    complete-uri: option<string>,
    /// The HTML form for uploading a video through the post approach.
    form: option<string>,
    /// The link of the video to capture through the pull approach.
    link: option<string>,
    /// The redirect URL for the upload app.
    redirect-url: option<string>,
    /// The file size in bytes of the uploaded video.
    size: option<f64>,
    /// The status code for the availability of the uploaded video:
    /// 
    status: video-transcode-status-enum,
    /// The link for sending video file data.
    upload-link: option<string>
  }

  record channel {
    /// The categories to which this channel belongs as specified by the channel moderators.
    categories: list<category>,
    /// The time in ISO 8601 format when the channel was created.
    created-time: string,
    /// A brief explanation of the channel's content.
    description: string,
    /// The banner that appears by default at the top of the channel page.
    header: picture,
    /// The URL to access the channel in a browser.
    link: string,
    /// Metadata about the channel.
    metadata: channel-metadata,
    /// The time in ISO 8601 format when the album was last modified.
    modified-time: string,
    /// The display name that identifies the channel.
    name: string,
    /// The active image for the channel; defaults to the thumbnail of the last video added to the channel.
    pictures: picture,
    /// The privacy settings of the channel.
    privacy: channel-privacy,
    /// The channel resource key.
    resource-key: string,
    /// An array of all tags assigned to this channel.
    tags: list<tag>,
    /// The unique identifier to access the channel resource.
    uri: string,
    /// The Vimeo user who owns the channel.
    user: user
  }

  /// Metadata about the channel.
  record channel-metadata {
    /// A collection of information that is connected to this resource.
    connections: channel-metadata-connections,
    /// A list of resource URIs related to the channel.
    interactions: channel-metadata-interactions
  }

  /// A collection of information that is connected to this resource.
  record channel-metadata-connections {
    /// Information provided to channel moderators about which users they have specifically permitted to access a private channel. This data requires a bearer token with the `private` scope.
    privacy-users: channel-metadata-connections-privacy-users,
    /// Information about the users following or moderating this channel.
    users: channel-metadata-connections-users,
    /// Information about the videos that belong to this channel.
    videos: channel-metadata-connections-videos
  }

  /// Information provided to channel moderators about which users they have specifically permitted to access a private channel. This data requires a bearer token with the `private` scope.
  record channel-metadata-connections-privacy-users {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about the users following or moderating this channel.
  record channel-metadata-connections-users {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that belong to this channel.
  record channel-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A list of resource URIs related to the channel.
  record channel-metadata-interactions {
    /// An action indicating that the authenticated user is the owner of the channel and may therefore add other users as channel moderators. This data requires a bearer token with the `private` scope.
    add-moderators: channel-metadata-interactions-add-moderators,
    /// When a channel appears in the context of adding or removing a video from it (`/videos/{video_id}/available_channels`), include information about adding or removing the video. This data requires a bearer token with the `private` scope.
    add-to: channel-metadata-interactions-add-to,
    /// An action indicating if the authenticated user has followed this channel. This data requires a bearer token with the `private` scope.
    follow: channel-metadata-interactions-follow,
    /// An action indicating that the authenticated user is a moderator of the channel and may therefore add or remove videos from the channel. This data requires a bearer token with the `private` scope.
    moderate-videos: channel-metadata-interactions-moderate-videos
  }

  /// An action indicating that the authenticated user is the owner of the channel and may therefore add other users as channel moderators. This data requires a bearer token with the `private` scope.
  record channel-metadata-interactions-add-moderators {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// When a channel appears in the context of adding or removing a video from it (`/videos/{video_id}/available_channels`), include information about adding or removing the video. This data requires a bearer token with the `private` scope.
  record channel-metadata-interactions-add-to {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// An action indicating if the authenticated user has followed this channel. This data requires a bearer token with the `private` scope.
  record channel-metadata-interactions-follow {
    /// Whether the authenticated user has followed this channel. This data requires a bearer token with the `private` scope.
    added: bool,
    /// The time in ISO 8601 format that the user followed this channel, or the null value if the user hasn't followed the channel. This data requires a bearer token with the `private` scope.
    added-time: string,
    /// Whether the authenticated user is a moderator or subscriber. This data requires a bearer token with the `private` scope.
    /// 
    type-op: channel-metadata-interactions-follow-type-op-enum,
    /// The URI for following or unfollowing this channel. PUT to this URI to follow the channel, or DELETE to this URI to unfollow the channel. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// An action indicating that the authenticated user is a moderator of the channel and may therefore add or remove videos from the channel. This data requires a bearer token with the `private` scope.
  record channel-metadata-interactions-moderate-videos {
    /// An array of HTTP methods allowed on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// The privacy settings of the channel.
  record channel-privacy {
    /// Who can view the channel:
    /// 
    view: channel-privacy-view-enum
  }

  variant get-channel-videos-error {
    not-modified(string),
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant add-videos-to-channel-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-videos-from-channel-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-channel-video-error {
    not-found(string),
    other(string)
  }

  variant add-video-to-channel-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-video-from-channel-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-available-video-channels-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the videos in a channel
  record get-channel-videos-params {
    /// The ID of the channel.
    channel-id: string,
    /// The page that contains the video URI.
    containing-uri: option<string>,
    /// The sort direction of the results.
    direction: option<get-channel-videos-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-channel-videos-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-channel-videos-sort-enum>
  }
  get-channel-videos: func(params: get-channel-videos-params) -> result<list<video>, get-channel-videos-error>;

  /// Add a list of videos to a channel
  record add-videos-to-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The URI of a video to add.
    video-uri: string
  }
  add-videos-to-channel: func(params: add-videos-to-channel-params) -> result<string, add-videos-to-channel-error>;

  /// Remove a list of videos from a channel
  record remove-videos-from-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The URI of a video to remove.
    video-uri: string
  }
  remove-videos-from-channel: func(params: remove-videos-from-channel-params) -> result<video, remove-videos-from-channel-error>;

  /// Get a specific video in a channel
  record get-channel-video-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string
  }
  get-channel-video: func(params: get-channel-video-params) -> result<video, get-channel-video-error>;

  /// Add a specific video to a channel
  record add-video-to-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string
  }
  add-video-to-channel: func(params: add-video-to-channel-params) -> result<string, add-video-to-channel-error>;

  /// Remove a specific video from a channel
  record delete-video-from-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string
  }
  delete-video-from-channel: func(params: delete-video-from-channel-params) -> result<string, delete-video-from-channel-error>;

  /// Get all the channels to which a user can add or remove a specific video
  record get-available-video-channels-params {
    /// The ID of the video.
    video-id: string
  }
  get-available-video-channels: func(params: get-available-video-channels-params) -> result<list<channel>, get-available-video-channels-error>;

}

interface videos-comments {
  enum get-comments-alt1-direction-enum {
    asc,
    desc,
  }

  enum comment-type-op-enum {
    video,
  }

  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum user-preferences-videos-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum user-preferences-videos-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum user-preferences-videos-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  record comment {
    /// The time in ISO 8601 format when the comment was posted.
    created-on: string,
    metadata: comment-metadata,
    /// The resource key string for the comment.
    resource-key: string,
    /// The content of the comment.
    text: string,
    /// The Vimeo content to which the comment relates:
    /// 
    type-op: comment-type-op-enum,
    /// The unique identifier to access the comment resource.
    uri: string,
    /// The user who posted the comment.
    user: user
  }

  record comment-metadata {
    connections: comment-metadata-connections
  }

  record comment-metadata-connections {
    /// Information about this comment's replies.
    replies: comment-metadata-connections-replies
  }

  /// Information about this comment's replies.
  record comment-metadata-connections-replies {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of replies on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user {
    /// The user's account type:
    /// 
    account: user-account-enum,
    /// The user's bio.
    bio: string,
    /// The user's content filters:
    /// 
    content-filter: option<string>,
    /// The time in ISO 8601 format when the user account was created.
    created-time: string,
    /// The user's email address. This data requires a bearer token with the `email` scope.
    email: option<string>,
    /// The absolute URL of this user's profile page.
    link: string,
    /// The user's location.
    location: string,
    /// The user's metadata.
    metadata: user-metadata,
    /// The user's display name.
    name: string,
    /// The active portrait of this user.
    pictures: picture,
    preferences: option<user-preferences>,
    /// The user's resource key string.
    resource-key: string,
    /// Appears only when the user has upload access and is looking at their own user record.
    upload-quota: user-upload-quota,
    /// The user's canonical relative URI.
    uri: string,
    /// The user's websites.
    websites: list<user-websites-item>
  }

  /// The user's metadata.
  record user-metadata {
    /// The list of resource URIs related to the user.
    connections: user-metadata-connections,
    interactions: user-metadata-interactions
  }

  /// The list of resource URIs related to the user.
  record user-metadata-connections {
    /// Information about the albums created by this user.
    albums: user-metadata-connections-albums,
    /// Information about the appearances of this user in other videos.
    appearances: user-metadata-connections-appearances,
    /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
    block: user-metadata-connections-block,
    /// Information about this user's followed categories.
    categories: user-metadata-connections-categories,
    /// Information about this user's subscribed channels.
    channels: user-metadata-connections-channels,
    /// Information about this user's feed.
    feed: user-metadata-connections-feed,
    /// Information about this user's folders.
    folders: user-metadata-connections-folders,
    /// Information about the user's followers.
    followers: user-metadata-connections-followers,
    /// Information about the users that the current user is following.
    following: user-metadata-connections-following,
    /// Information about the groups created by this user.
    groups: user-metadata-connections-groups,
    /// Information about the videos that this user has liked.
    likes: user-metadata-connections-likes,
    /// Information about the channels that this user moderates.
    moderated-channels: user-metadata-connections-moderated-channels,
    /// Information about this user's portraits.
    pictures: user-metadata-connections-pictures,
    /// Information about this user's portfolios.
    portfolios: user-metadata-connections-portfolios,
    /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-channels: user-metadata-connections-recommended-channels,
    /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-users: user-metadata-connections-recommended-users,
    /// Information about the videos that have been shared with this user.
    shared: user-metadata-connections-shared,
    /// Information about the videos uploaded by this user.
    videos: user-metadata-connections-videos,
    /// Information about the videos that this user has watched.
    watched-videos: user-metadata-connections-watched-videos,
    /// Information about the videos that this user wants to watch later.
    watchlater: user-metadata-connections-watchlater
  }

  /// Information about the albums created by this user.
  record user-metadata-connections-albums {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of albums on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the appearances of this user in other videos.
  record user-metadata-connections-appearances {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of appearances on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-block {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of blocked users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about this user's followed categories.
  record user-metadata-connections-categories {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of categories on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's subscribed channels.
  record user-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's feed.
  record user-metadata-connections-feed {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's folders.
  record user-metadata-connections-folders {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of folders on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user's followers.
  record user-metadata-connections-followers {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of followers on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users that the current user is following.
  record user-metadata-connections-following {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups created by this user.
  record user-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has liked.
  record user-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the channels that this user moderates.
  record user-metadata-connections-moderated-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portraits.
  record user-metadata-connections-pictures {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of pictures on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portfolios.
  record user-metadata-connections-portfolios {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of portfolios on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-channels {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of channels on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-users {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about the videos that have been shared with this user.
  record user-metadata-connections-shared {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos uploaded by this user.
  record user-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has watched.
  record user-metadata-connections-watched-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user wants to watch later.
  record user-metadata-connections-watchlater {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-metadata-interactions {
    add-privacy-user: option<user-metadata-interactions-add-privacy-user>,
    /// Information related to the block status of this user.
    block: user-metadata-interactions-block,
    /// Information related to the followed status of this user.
    follow: user-metadata-interactions-follow,
    /// Information regarding where and how to report a user.
    report: user-metadata-interactions-report
  }

  record user-metadata-interactions-add-privacy-user {
    /// An array of the HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: option<string>
  }

  /// Information related to the block status of this user.
  record user-metadata-interactions-block {
    /// Whether a user is blocking the current user.
    added: bool,
    /// The time in ISO 8601 format when the block occurred, or the null value if no block exists.
    added-time: string,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to block or unblock the user.
    uri: string
  }

  /// Information related to the followed status of this user.
  record user-metadata-interactions-follow {
    /// Whether a user is following the current user.
    added: bool,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to follow the user.
    uri: string
  }

  /// Information regarding where and how to report a user.
  record user-metadata-interactions-report {
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// List of valid reasons for reporting a video.
    reason: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  record user-preferences {
    videos: option<user-preferences-videos>
  }

  record user-preferences-videos {
    privacy: option<user-preferences-videos-privacy>
  }

  record user-preferences-videos-privacy {
    /// Whether other users can add the user's videos.
    add: option<bool>,
    /// The user's privacy preference for comments:
    /// 
    comments: option<user-preferences-videos-privacy-comments-enum>,
    /// Whether other users can download the user's videos.
    download: option<bool>,
    /// The user's privacy preference for embeds:
    /// 
    embed: option<user-preferences-videos-privacy-embed-enum>,
    /// The user's privacy preference for views:
    /// 
    view: option<user-preferences-videos-privacy-view-enum>
  }

  /// Appears only when the user has upload access and is looking at their own user record.
  record user-upload-quota {
    /// Information about the user's lifetime upload usage.
    lifetime: user-upload-quota-lifetime,
    /// Information about the user's usage for the current period.
    periodic: user-upload-quota-periodic,
    /// Information about the user's upload space remaining for the current period.
    space: user-upload-quota-space
  }

  /// Information about the user's lifetime upload usage.
  record user-upload-quota-lifetime {
    /// The number of bytes remaining in your lifetime maximum.
    free: f64,
    /// The total number of bytes that you can upload across the lifetime of your account.
    max: f64,
    /// The number of bytes that you've already uploaded against your lifetime limit.
    used: f64
  }

  /// Information about the user's usage for the current period.
  record user-upload-quota-periodic {
    /// The number of bytes remaining in your upload quota for the current period.
    free: f64,
    /// The total number of bytes that you can upload per period.
    max: f64,
    /// The time in ISO 8601 format when your upload quota resets.
    reset-date: string,
    /// The number of bytes that you've already uploaded against your quota in the current period.
    used: f64
  }

  /// Information about the user's upload space remaining for the current period.
  record user-upload-quota-space {
    /// The number of bytes remaining in your upload quota.
    free: f64,
    /// The maximum number of bytes allotted to your upload quota.
    max: f64,
    /// Whether the values of the upload_quota.space fields are for the lifetime quota or the periodic quota.
    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  variant create-comment-alt1-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-comment-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-comment-error {
    not-found(string),
    other(string)
  }

  variant edit-comment-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant delete-comment-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-comment-replies-error {
    not-found(string),
    other(string)
  }

  variant create-comment-reply-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  /// Get all the comments on a video
  record get-comments-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string,
    /// The sort direction of the results.
    direction: option<get-comments-alt1-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-comments-alt1: func(params: get-comments-alt1-params) -> result<list<comment>, string>;

  /// Add a comment to a video
  record create-comment-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string,
    /// The text of the comment.
    text: string
  }
  create-comment-alt1: func(params: create-comment-alt1-params) -> result<comment, create-comment-alt1-error>;

  /// Get all the comments on a video
  record get-comments-params {
    /// The ID of the video.
    video-id: string,
    /// The sort direction of the results.
    direction: option<get-comments-alt1-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-comments: func(params: get-comments-params) -> result<list<comment>, string>;

  /// Add a comment to a video
  record create-comment-params {
    /// The ID of the video.
    video-id: string,
    /// The text of the comment.
    text: string
  }
  create-comment: func(params: create-comment-params) -> result<comment, create-comment-error>;

  /// Get a specific video comment
  record get-comment-params {
    /// The ID of the comment.
    comment-id: string,
    /// The ID of the video.
    video-id: string
  }
  get-comment: func(params: get-comment-params) -> result<comment, get-comment-error>;

  /// Edit a video comment
  record edit-comment-params {
    /// The ID of the comment.
    comment-id: string,
    /// The ID of the video.
    video-id: string,
    /// The next text of the comment.
    text: string
  }
  edit-comment: func(params: edit-comment-params) -> result<comment, edit-comment-error>;

  /// Delete a video comment
  record delete-comment-params {
    /// The ID of the comment.
    comment-id: string,
    /// The ID of the video.
    video-id: string
  }
  delete-comment: func(params: delete-comment-params) -> result<string, delete-comment-error>;

  /// Get all the replies to a video comment
  record get-comment-replies-params {
    /// The ID of the comment.
    comment-id: string,
    /// The ID of the video.
    video-id: string,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-comment-replies: func(params: get-comment-replies-params) -> result<list<comment>, get-comment-replies-error>;

  /// Add a reply to a video comment
  record create-comment-reply-params {
    /// The ID of the comment.
    comment-id: string,
    /// The ID of the video.
    video-id: string,
    /// The reply to the comment.
    text: string
  }
  create-comment-reply: func(params: create-comment-reply-params) -> result<comment, create-comment-reply-error>;

}

interface videos-credits {
  enum get-video-credits-alt1-direction-enum {
    asc,
    desc,
  }

  enum get-video-credits-alt1-sort-enum {
    alphabetical,
    date,
  }

  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum user-preferences-videos-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum user-preferences-videos-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum user-preferences-videos-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  enum video-context-action-enum {
    added-to,
    appearance-by,
    liked-by,
    uploaded-by,
  }

  enum embed-settings-title-name-enum {
    hide,
    show,
    user,
  }

  enum video-license-enum {
    by,
    by-nc,
    by-nc-nd,
    by-nc-sa,
    by-nd,
    by-sa,
    cc0,
  }

  enum video-metadata-interactions-buy-download-enum {
    available,
    purchased,
    restricted,
    unavailable,
  }

  enum video-privacy-embed-enum {
    private,
    public,
  }

  enum video-spatial-projection-enum {
    cubical,
    cylindrical,
    dome,
    equirectangular,
    pyramid,
  }

  enum video-spatial-stereo-format-enum {
    left-right,
    mono,
    top-bottom,
  }

  enum video-status-enum {
    available,
    quota-exceeded,
    total-cap-exceeded,
    transcode-starting,
    transcoding,
    transcoding-error,
    unavailable,
    uploading,
    uploading-error,
  }

  enum video-transcode-status-enum {
    complete,
    error,
    in-progress,
  }

  enum video-upload-approach-enum {
    post,
    pull,
    streaming,
    tus,
  }

  record credit {
    /// The name of the person credited.
    name: string,
    /// The character that this person portrayed, or the job that this person performed.
    role: string,
    /// The unique identifier to access the credits resource.
    uri: string,
    /// The Vimeo user associated with this credit.
    user: option<user>,
    /// The video associated with this credit.
    video: option<video>
  }

  record user {
    /// The user's account type:
    /// 
    account: user-account-enum,
    /// The user's bio.
    bio: string,
    /// The user's content filters:
    /// 
    content-filter: option<string>,
    /// The time in ISO 8601 format when the user account was created.
    created-time: string,
    /// The user's email address. This data requires a bearer token with the `email` scope.
    email: option<string>,
    /// The absolute URL of this user's profile page.
    link: string,
    /// The user's location.
    location: string,
    /// The user's metadata.
    metadata: user-metadata,
    /// The user's display name.
    name: string,
    /// The active portrait of this user.
    pictures: picture,
    preferences: option<user-preferences>,
    /// The user's resource key string.
    resource-key: string,
    /// Appears only when the user has upload access and is looking at their own user record.
    upload-quota: user-upload-quota,
    /// The user's canonical relative URI.
    uri: string,
    /// The user's websites.
    websites: list<user-websites-item>
  }

  /// The user's metadata.
  record user-metadata {
    /// The list of resource URIs related to the user.
    connections: user-metadata-connections,
    interactions: user-metadata-interactions
  }

  /// The list of resource URIs related to the user.
  record user-metadata-connections {
    /// Information about the albums created by this user.
    albums: user-metadata-connections-albums,
    /// Information about the appearances of this user in other videos.
    appearances: user-metadata-connections-appearances,
    /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
    block: user-metadata-connections-block,
    /// Information about this user's followed categories.
    categories: user-metadata-connections-categories,
    /// Information about this user's subscribed channels.
    channels: user-metadata-connections-channels,
    /// Information about this user's feed.
    feed: user-metadata-connections-feed,
    /// Information about this user's folders.
    folders: user-metadata-connections-folders,
    /// Information about the user's followers.
    followers: user-metadata-connections-followers,
    /// Information about the users that the current user is following.
    following: user-metadata-connections-following,
    /// Information about the groups created by this user.
    groups: user-metadata-connections-groups,
    /// Information about the videos that this user has liked.
    likes: user-metadata-connections-likes,
    /// Information about the channels that this user moderates.
    moderated-channels: user-metadata-connections-moderated-channels,
    /// Information about this user's portraits.
    pictures: user-metadata-connections-pictures,
    /// Information about this user's portfolios.
    portfolios: user-metadata-connections-portfolios,
    /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-channels: user-metadata-connections-recommended-channels,
    /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-users: user-metadata-connections-recommended-users,
    /// Information about the videos that have been shared with this user.
    shared: user-metadata-connections-shared,
    /// Information about the videos uploaded by this user.
    videos: user-metadata-connections-videos,
    /// Information about the videos that this user has watched.
    watched-videos: user-metadata-connections-watched-videos,
    /// Information about the videos that this user wants to watch later.
    watchlater: user-metadata-connections-watchlater
  }

  /// Information about the albums created by this user.
  record user-metadata-connections-albums {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of albums on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the appearances of this user in other videos.
  record user-metadata-connections-appearances {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of appearances on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-block {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of blocked users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about this user's followed categories.
  record user-metadata-connections-categories {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of categories on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's subscribed channels.
  record user-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's feed.
  record user-metadata-connections-feed {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's folders.
  record user-metadata-connections-folders {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of folders on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user's followers.
  record user-metadata-connections-followers {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of followers on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users that the current user is following.
  record user-metadata-connections-following {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups created by this user.
  record user-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has liked.
  record user-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the channels that this user moderates.
  record user-metadata-connections-moderated-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portraits.
  record user-metadata-connections-pictures {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of pictures on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portfolios.
  record user-metadata-connections-portfolios {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of portfolios on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-channels {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of channels on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-users {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
