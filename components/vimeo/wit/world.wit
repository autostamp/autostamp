    /// A list of resource URIs related to the album.
    connections: portfolio-metadata-connections
  }

  /// A list of resource URIs related to the album.
  record portfolio-metadata-connections {
    /// Information about the videos contained within this portfolio.
    videos: portfolio-metadata-connections-videos
  }

  /// Information about the videos contained within this portfolio.
  record portfolio-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
