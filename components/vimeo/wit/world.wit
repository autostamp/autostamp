/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `oauth2` | `Authorization: Bearer <secret>` |
package autostamp:vimeo@0.3.0;

interface api-information {
  /// Get an API specification
  record get-endpoints-params {
    /// Return an OpenAPI specification.
    openapi: option<bool>
  }
  get-endpoints: func(params: get-endpoints-params) -> result<string, string>;

}


interface categories-essentials {
  enum get-categories-direction-enum {
    asc,
    desc,
  }

  enum get-categories-sort-enum {
    last-video-featured-time,
    name,
  }

  /// Get all categories
  record get-categories-params {
    /// The sort direction of the results.
    direction: option<get-categories-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The way to sort the results.
    sort: option<get-categories-sort-enum>
  }
  get-categories: func(params: get-categories-params) -> result<string, string>;

  /// Get a specific category
  record get-category-params {
    /// The name of the category.
    category: string
  }
  get-category: func(params: get-category-params) -> result<string, string>;

}

interface categories-channels {
  enum get-category-channels-direction-enum {
    asc,
    desc,
  }

