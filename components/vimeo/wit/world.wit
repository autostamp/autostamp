interface videos-embed-privacy {
  record domain {
    /// Whether to permit HD embeds on this domain.
    allow-hd: bool,
    /// The domain name.
    domain: string,
    /// The URI of the domain.
    uri: string
  }

  variant get-video-privacy-domains-error {
    forbidden(string),
    other(string)
  }

  variant add-video-privacy-domain-error {
    forbidden(string),
    other(string)
  }

  variant delete-video-privacy-domain-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

