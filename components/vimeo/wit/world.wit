  }

  /// Get all the users who have liked a video
  record get-video-likes-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string,
    /// The sort direction of the results.
    direction: option<get-video-likes-alt1-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The way to sort the results.
    sort: option<get-video-likes-alt1-sort-enum>
  }
  get-video-likes-alt1: func(params: get-video-likes-alt1-params) -> result<list<user>, string>;

  /// Get all the videos that a user has liked
  record get-likes-alt1-params {
    /// The attribute by which to filter the results.
    filter: option<get-likes-alt1-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-likes-alt1-sort-enum>
  }
  get-likes-alt1: func(params: get-likes-alt1-params) -> result<list<video>, string>;

  /// Check if a user has liked a video
  record check-if-user-liked-video-alt1-params {
    /// The ID of the video.
    video-id: string
  }
  check-if-user-liked-video-alt1: func(params: check-if-user-liked-video-alt1-params) -> result<string, check-if-user-liked-video-alt1-error>;

  /// Cause a user to like a video
  record like-video-alt1-params {
    /// The ID of the video.
    video-id: string
  }
  like-video-alt1: func(params: like-video-alt1-params) -> result<string, like-video-alt1-error>;

  /// Cause a user to unlike a video
  record unlike-video-alt1-params {
    /// The ID of the video.
    video-id: string
  }
  unlike-video-alt1: func(params: unlike-video-alt1-params) -> result<string, unlike-video-alt1-error>;

  /// Get all the users who have liked a video on an On Demand page
  record get-vod-likes-params {
    /// The ID of the On Demand page.
    ondemand-id: string,
    /// The sort direction of the results.
    direction: option<get-video-likes-alt1-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-vod-likes-filter-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The way to sort the results.
    sort: option<get-video-likes-alt1-sort-enum>
  }
  get-vod-likes: func(params: get-vod-likes-params) -> result<list<user>, string>;

  /// Get all the videos that a user has liked
  record get-likes-params {
    /// The ID of the user.
    user-id: string,
    /// The attribute by which to filter the results.
    filter: option<get-likes-alt1-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-likes-alt1-sort-enum>
  }
  get-likes: func(params: get-likes-params) -> result<list<video>, string>;

  /// Check if a user has liked a video
  record check-if-user-liked-video-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  check-if-user-liked-video: func(params: check-if-user-liked-video-params) -> result<string, check-if-user-liked-video-error>;

  /// Cause a user to like a video
  record like-video-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  like-video: func(params: like-video-params) -> result<string, like-video-error>;

  /// Cause a user to unlike a video
  record unlike-video-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  unlike-video: func(params: unlike-video-params) -> result<string, unlike-video-error>;

  /// Get all the users who have liked a video
  record get-video-likes-params {
    /// The ID of the video.
    video-id: string,
    /// The sort direction of the results.
    direction: option<get-video-likes-alt1-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The way to sort the results.
    sort: option<get-video-likes-alt1-sort-enum>
  }
  get-video-likes: func(params: get-video-likes-params) -> result<list<user>, string>;

}

interface videos-thumbnails {
  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  /// Get all the thumbnails of a video
  record get-video-thumbnails-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-video-thumbnails-alt1: func(params: get-video-thumbnails-alt1-params) -> result<list<picture>, string>;

  /// Add a video thumbnail
  record create-video-thumbnail-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string,
    /// Whether the image created by the `time` field should be the default thumbnail for the video.
    active: option<bool>,
    /// Creates an image of the video from the given time offset.
    time: option<f64>
  }
  create-video-thumbnail-alt1: func(params: create-video-thumbnail-alt1-params) -> result<picture, string>;

  /// Get all the thumbnails of a video
  record get-video-thumbnails-params {
    /// The ID of the video.
    video-id: string,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-video-thumbnails: func(params: get-video-thumbnails-params) -> result<list<picture>, string>;

  /// Add a video thumbnail
  record create-video-thumbnail-params {
    /// The ID of the video.
    video-id: string,
    /// Whether the image created by the `time` field should be the default thumbnail for the video.
    active: option<bool>,
    /// Creates an image of the video from the given time offset.
    time: option<f64>
  }
  create-video-thumbnail: func(params: create-video-thumbnail-params) -> result<picture, string>;

  /// Get a video thumbnail
  record get-video-thumbnail-params {
    /// The ID of the picture.
    picture-id: string,
    /// The ID of the video.
    video-id: string
  }
  get-video-thumbnail: func(params: get-video-thumbnail-params) -> result<picture, string>;

  /// Edit a video thumbnail
  record edit-video-thumbnail-params {
    /// The ID of the picture.
    picture-id: string,
    /// The ID of the video.
    video-id: string,
    /// Whether this thumbnail is the default.
    active: option<bool>
  }
  edit-video-thumbnail: func(params: edit-video-thumbnail-params) -> result<picture, string>;

  /// Delete a video thumbnail
  record delete-video-thumbnail-params {
    /// The ID of the picture.
    picture-id: string,
    /// The ID of the video.
    video-id: string
  }
  delete-video-thumbnail: func(params: delete-video-thumbnail-params) -> result<string, string>;

}

interface videos-viewing-privacy {
  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum user-preferences-videos-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum user-preferences-videos-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum user-preferences-videos-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  record user {
    /// The user's account type:
    /// 
    account: user-account-enum,
    /// The user's bio.
    bio: string,
    /// The user's content filters:
    /// 
    content-filter: option<string>,
    /// The time in ISO 8601 format when the user account was created.
    created-time: string,
    /// The user's email address. This data requires a bearer token with the `email` scope.
    email: option<string>,
    /// The absolute URL of this user's profile page.
    link: string,
    /// The user's location.
    location: string,
    /// The user's metadata.
    metadata: user-metadata,
    /// The user's display name.
    name: string,
    /// The active portrait of this user.
    pictures: picture,
    preferences: option<user-preferences>,
    /// The user's resource key string.
    resource-key: string,
    /// Appears only when the user has upload access and is looking at their own user record.
    upload-quota: user-upload-quota,
    /// The user's canonical relative URI.
    uri: string,
    /// The user's websites.
    websites: list<user-websites-item>
  }

  /// The user's metadata.
  record user-metadata {
    /// The list of resource URIs related to the user.
    connections: user-metadata-connections,
    interactions: user-metadata-interactions
  }

  /// The list of resource URIs related to the user.
  record user-metadata-connections {
    /// Information about the albums created by this user.
    albums: user-metadata-connections-albums,
    /// Information about the appearances of this user in other videos.
    appearances: user-metadata-connections-appearances,
    /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
    block: user-metadata-connections-block,
    /// Information about this user's followed categories.
    categories: user-metadata-connections-categories,
    /// Information about this user's subscribed channels.
    channels: user-metadata-connections-channels,
    /// Information about this user's feed.
    feed: user-metadata-connections-feed,
    /// Information about this user's folders.
    folders: user-metadata-connections-folders,
    /// Information about the user's followers.
    followers: user-metadata-connections-followers,
    /// Information about the users that the current user is following.
    following: user-metadata-connections-following,
    /// Information about the groups created by this user.
    groups: user-metadata-connections-groups,
    /// Information about the videos that this user has liked.
    likes: user-metadata-connections-likes,
    /// Information about the channels that this user moderates.
    moderated-channels: user-metadata-connections-moderated-channels,
    /// Information about this user's portraits.
    pictures: user-metadata-connections-pictures,
    /// Information about this user's portfolios.
    portfolios: user-metadata-connections-portfolios,
    /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-channels: user-metadata-connections-recommended-channels,
    /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-users: user-metadata-connections-recommended-users,
    /// Information about the videos that have been shared with this user.
    shared: user-metadata-connections-shared,
    /// Information about the videos uploaded by this user.
    videos: user-metadata-connections-videos,
    /// Information about the videos that this user has watched.
    watched-videos: user-metadata-connections-watched-videos,
    /// Information about the videos that this user wants to watch later.
    watchlater: user-metadata-connections-watchlater
  }

  /// Information about the albums created by this user.
  record user-metadata-connections-albums {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of albums on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the appearances of this user in other videos.
  record user-metadata-connections-appearances {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of appearances on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-block {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of blocked users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about this user's followed categories.
  record user-metadata-connections-categories {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of categories on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's subscribed channels.
  record user-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's feed.
  record user-metadata-connections-feed {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's folders.
  record user-metadata-connections-folders {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of folders on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user's followers.
  record user-metadata-connections-followers {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of followers on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users that the current user is following.
  record user-metadata-connections-following {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups created by this user.
  record user-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has liked.
  record user-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the channels that this user moderates.
  record user-metadata-connections-moderated-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portraits.
  record user-metadata-connections-pictures {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of pictures on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portfolios.
  record user-metadata-connections-portfolios {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of portfolios on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-channels {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of channels on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-users {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about the videos that have been shared with this user.
  record user-metadata-connections-shared {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos uploaded by this user.
  record user-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has watched.
  record user-metadata-connections-watched-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user wants to watch later.
  record user-metadata-connections-watchlater {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-metadata-interactions {
    add-privacy-user: option<user-metadata-interactions-add-privacy-user>,
    /// Information related to the block status of this user.
    block: user-metadata-interactions-block,
    /// Information related to the followed status of this user.
    follow: user-metadata-interactions-follow,
    /// Information regarding where and how to report a user.
    report: user-metadata-interactions-report
  }

  record user-metadata-interactions-add-privacy-user {
    /// An array of the HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: option<string>
  }

  /// Information related to the block status of this user.
  record user-metadata-interactions-block {
    /// Whether a user is blocking the current user.
    added: bool,
    /// The time in ISO 8601 format when the block occurred, or the null value if no block exists.
    added-time: string,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to block or unblock the user.
    uri: string
  }

  /// Information related to the followed status of this user.
  record user-metadata-interactions-follow {
    /// Whether a user is following the current user.
    added: bool,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to follow the user.
    uri: string
  }

  /// Information regarding where and how to report a user.
  record user-metadata-interactions-report {
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// List of valid reasons for reporting a video.
    reason: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  record user-preferences {
    videos: option<user-preferences-videos>
  }

  record user-preferences-videos {
    privacy: option<user-preferences-videos-privacy>
  }

  record user-preferences-videos-privacy {
    /// Whether other users can add the user's videos.
    add: option<bool>,
    /// The user's privacy preference for comments:
    /// 
    comments: option<user-preferences-videos-privacy-comments-enum>,
    /// Whether other users can download the user's videos.
    download: option<bool>,
    /// The user's privacy preference for embeds:
    /// 
    embed: option<user-preferences-videos-privacy-embed-enum>,
    /// The user's privacy preference for views:
    /// 
    view: option<user-preferences-videos-privacy-view-enum>
  }

  /// Appears only when the user has upload access and is looking at their own user record.
  record user-upload-quota {
    /// Information about the user's lifetime upload usage.
    lifetime: user-upload-quota-lifetime,
    /// Information about the user's usage for the current period.
    periodic: user-upload-quota-periodic,
    /// Information about the user's upload space remaining for the current period.
    space: user-upload-quota-space
  }

  /// Information about the user's lifetime upload usage.
  record user-upload-quota-lifetime {
    /// The number of bytes remaining in your lifetime maximum.
    free: f64,
    /// The total number of bytes that you can upload across the lifetime of your account.
    max: f64,
    /// The number of bytes that you've already uploaded against your lifetime limit.
    used: f64
  }

  /// Information about the user's usage for the current period.
  record user-upload-quota-periodic {
    /// The number of bytes remaining in your upload quota for the current period.
    free: f64,
    /// The total number of bytes that you can upload per period.
    max: f64,
    /// The time in ISO 8601 format when your upload quota resets.
    reset-date: string,
    /// The number of bytes that you've already uploaded against your quota in the current period.
    used: f64
  }

  /// Information about the user's upload space remaining for the current period.
  record user-upload-quota-space {
    /// The number of bytes remaining in your upload quota.
    free: f64,
    /// The maximum number of bytes allotted to your upload quota.
    max: f64,
    /// Whether the values of the upload_quota.space fields are for the lifetime quota or the periodic quota.
    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  variant get-video-privacy-users-alt1-error {
    bad-request(string),
    other(string)
  }

  variant get-video-privacy-users-error {
    bad-request(string),
    other(string)
  }

  variant add-video-privacy-user-error {
    forbidden(string),
    other(string)
  }

  variant delete-video-privacy-user-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the users who can view a user's private videos by default
  record get-video-privacy-users-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-video-privacy-users-alt1: func(params: get-video-privacy-users-alt1-params) -> result<list<user>, get-video-privacy-users-alt1-error>;

  /// Permit a list of users to view a private video
  record add-video-privacy-users-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string
  }
  add-video-privacy-users-alt1: func(params: add-video-privacy-users-alt1-params) -> result<list<user>, string>;

  /// Get all the users who can view a user's private videos by default
  record get-video-privacy-users-params {
    /// The ID of the video.
    video-id: string,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-video-privacy-users: func(params: get-video-privacy-users-params) -> result<list<user>, get-video-privacy-users-error>;

  /// Permit a list of users to view a private video
  record add-video-privacy-users-params {
    /// The ID of the video.
    video-id: string
  }
  add-video-privacy-users: func(params: add-video-privacy-users-params) -> result<list<user>, string>;

  /// Permit a specific user to view a private video
  record add-video-privacy-user-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  add-video-privacy-user: func(params: add-video-privacy-user-params) -> result<user, add-video-privacy-user-error>;

  /// Restrict a user from viewing a private video
  record delete-video-privacy-user-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  delete-video-privacy-user: func(params: delete-video-privacy-user-params) -> result<string, delete-video-privacy-user-error>;

}

interface videos-text-tracks {
  enum text-track-type-op-enum {
    captions,
    subtitles,
  }

  enum create-text-track-alt1-body-type-op-enum {
    captions,
    chapters,
    descriptions,
    metadata,
    subtitles,
  }

  record text-track {
    /// Whether this text track is active.
    active: bool,
    /// The read-only URL of the text track file, intended for use with HLS playback.
    hls-link: string,
    /// The time in ISO 8601 format when the read-only HLS playback text track file expires.
    hls-link-expires-time: string,
    /// The language code for this text track. To see a full list, request
    /// `/languages?filter=texttrack`.
    language: string,
    /// The read-only URL of the text track file. You can upload to this link when you create it for the first time.
    link: string,
    /// The time in ISO 8601 format when the text track link expires.
    link-expires-time: string,
    /// The descriptive name of this text track.
    name: string,
    /// The type of the text track:
    /// 
    type-op: text-track-type-op-enum,
    /// The relative URI of the text track.
    uri: string
  }

  variant get-text-tracks-alt1-error {
    not-found(string),
    other(string)
  }

  variant create-text-track-alt1-error {
    forbidden(string),
    other(string)
  }

  variant get-text-tracks-error {
    not-found(string),
    other(string)
  }

  variant create-text-track-error {
    forbidden(string),
    other(string)
  }

  variant get-text-track-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant edit-text-track-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-text-track-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the text tracks of a video
  record get-text-tracks-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string
  }
  get-text-tracks-alt1: func(params: get-text-tracks-alt1-params) -> result<list<text-track>, get-text-tracks-alt1-error>;

  /// Add a text track to a video
  record create-text-track-alt1-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string,
    /// Active text tracks appear in the player and are visible to other users. Only one text track per language can be active.
    active: option<bool>,
    /// The language of the text track. For a complete list of valid languages, use the [/languages?filter=texttracks](https://developer.vimeo.com/api/endpoints/videos#GET/languages) endpoint.
    language: string,
    /// The name of the text track.
    name: string,
    /// The type of the text track.
    type-op: create-text-track-alt1-body-type-op-enum
  }
  create-text-track-alt1: func(params: create-text-track-alt1-params) -> result<text-track, create-text-track-alt1-error>;

  /// Get all the text tracks of a video
  record get-text-tracks-params {
    /// The ID of the video.
    video-id: string
  }
  get-text-tracks: func(params: get-text-tracks-params) -> result<list<text-track>, get-text-tracks-error>;

  /// Add a text track to a video
  record create-text-track-params {
    /// The ID of the video.
    video-id: string,
    /// Active text tracks appear in the player and are visible to other users. Only one text track per language can be active.
    active: option<bool>,
    /// The language of the text track. For a complete list of valid languages, use the [/languages?filter=texttracks](https://developer.vimeo.com/api/endpoints/videos#GET/languages) endpoint.
    language: string,
    /// The name of the text track.
    name: string,
    /// The type of the text track.
    type-op: create-text-track-alt1-body-type-op-enum
  }
  create-text-track: func(params: create-text-track-params) -> result<text-track, create-text-track-error>;

  /// Get a specific text track
  record get-text-track-params {
    /// The ID of the text track.
    texttrack-id: string,
    /// The ID of the video.
    video-id: string
  }
  get-text-track: func(params: get-text-track-params) -> result<text-track, get-text-track-error>;

  /// Edit a text track
  record edit-text-track-params {
    /// The ID of the text track.
    texttrack-id: string,
    /// The ID of the video.
    video-id: string,
    /// Whether the text track is active, meaning that it appears in the player. Only one text track per language, and type, can be active.
    active: option<bool>,
    /// The language of the text track. For a full list of valid languages, use the [/languages?filter=texttracks](https://developer.vimeo.com/api/endpoints/videos#GET/languages) endpoint.
    language: option<string>,
    /// The name of the text track.
    name: option<string>,
    /// The text track type.
    type-op: option<create-text-track-alt1-body-type-op-enum>
  }
  edit-text-track: func(params: edit-text-track-params) -> result<text-track, edit-text-track-error>;

  /// Delete a text track
  record delete-text-track-params {
    /// The ID of the text track.
    texttrack-id: string,
    /// The ID of the video.
    video-id: string
  }
  delete-text-track: func(params: delete-text-track-params) -> result<string, delete-text-track-error>;

}

