    uri: string
  }

  /// Information about this user's folders.
  record user-metadata-connections-folders {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of folders on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user's followers.
  record user-metadata-connections-followers {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of followers on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users that the current user is following.
  record user-metadata-connections-following {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups created by this user.
  record user-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has liked.
  record user-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
