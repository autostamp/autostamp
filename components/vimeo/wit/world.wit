    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-videos-alt1-sort-enum>
  }
  get-videos-alt1: func(params: get-videos-alt1-params) -> result<list<video>, get-videos-alt1-error>;

