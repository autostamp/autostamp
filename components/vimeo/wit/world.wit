    /// The total number of blocked users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about this user's followed categories.
  record user-metadata-connections-categories {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of categories on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's subscribed channels.
  record user-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's feed.
  record user-metadata-connections-feed {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's folders.
  record user-metadata-connections-folders {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of folders on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user's followers.
  record user-metadata-connections-followers {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of followers on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users that the current user is following.
  record user-metadata-connections-following {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups created by this user.
  record user-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has liked.
  record user-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the channels that this user moderates.
  record user-metadata-connections-moderated-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portraits.
  record user-metadata-connections-pictures {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of pictures on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portfolios.
  record user-metadata-connections-portfolios {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of portfolios on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-channels {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of channels on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-users {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about the videos that have been shared with this user.
  record user-metadata-connections-shared {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos uploaded by this user.
  record user-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has watched.
  record user-metadata-connections-watched-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user wants to watch later.
  record user-metadata-connections-watchlater {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-metadata-interactions {
    add-privacy-user: option<user-metadata-interactions-add-privacy-user>,
    /// Information related to the block status of this user.
    block: user-metadata-interactions-block,
    /// Information related to the followed status of this user.
    follow: user-metadata-interactions-follow,
    /// Information regarding where and how to report a user.
    report: user-metadata-interactions-report
  }

  record user-metadata-interactions-add-privacy-user {
    /// An array of the HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: option<string>
  }

  /// Information related to the block status of this user.
  record user-metadata-interactions-block {
    /// Whether a user is blocking the current user.
    added: bool,
    /// The time in ISO 8601 format when the block occurred, or the null value if no block exists.
    added-time: string,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to block or unblock the user.
    uri: string
  }

  /// Information related to the followed status of this user.
  record user-metadata-interactions-follow {
    /// Whether a user is following the current user.
    added: bool,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to follow the user.
    uri: string
  }

  /// Information regarding where and how to report a user.
  record user-metadata-interactions-report {
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// List of valid reasons for reporting a video.
    reason: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-preferences {
    videos: option<user-preferences-videos>
  }

  record user-preferences-videos {
    privacy: option<user-preferences-videos-privacy>
  }

  record user-preferences-videos-privacy {
    /// Whether other users can add the user's videos.
    add: option<bool>,
    /// The user's privacy preference for comments:
    /// 
    comments: option<user-preferences-videos-privacy-comments-enum>,
    /// Whether other users can download the user's videos.
    download: option<bool>,
    /// The user's privacy preference for embeds:
    /// 
    embed: option<user-preferences-videos-privacy-embed-enum>,
    /// The user's privacy preference for views:
    /// 
    view: option<user-preferences-videos-privacy-view-enum>
  }

  /// Appears only when the user has upload access and is looking at their own user record.
  record user-upload-quota {
    /// Information about the user's lifetime upload usage.
    lifetime: user-upload-quota-lifetime,
    /// Information about the user's usage for the current period.
    periodic: user-upload-quota-periodic,
    /// Information about the user's upload space remaining for the current period.
    space: user-upload-quota-space
  }

  /// Information about the user's lifetime upload usage.
  record user-upload-quota-lifetime {
    /// The number of bytes remaining in your lifetime maximum.
    free: f64,
    /// The total number of bytes that you can upload across the lifetime of your account.
    max: f64,
    /// The number of bytes that you've already uploaded against your lifetime limit.
    used: f64
  }

  /// Information about the user's usage for the current period.
  record user-upload-quota-periodic {
    /// The number of bytes remaining in your upload quota for the current period.
    free: f64,
    /// The total number of bytes that you can upload per period.
    max: f64,
    /// The time in ISO 8601 format when your upload quota resets.
    reset-date: string,
    /// The number of bytes that you've already uploaded against your quota in the current period.
    used: f64
  }

  /// Information about the user's upload space remaining for the current period.
  record user-upload-quota-space {
    /// The number of bytes remaining in your upload quota.
    free: f64,
    /// The maximum number of bytes allotted to your upload quota.
    max: f64,
    /// Whether the values of the upload_quota.space fields are for the lifetime quota or the periodic quota.
    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  /// The video's privacy setting.
  record video-privacy {
    /// Whether the video can be added to collections.
    add: bool,
    /// Who can comment on the video:
    /// 
    comments: user-preferences-videos-privacy-comments-enum,
    /// The video's download permission setting.
    download: bool,
    /// The video's embed permission setting:
    /// 
    embed: video-privacy-embed-enum,
    /// The general privacy setting for the video:
    /// 
    view: user-preferences-videos-privacy-view-enum
  }

  /// 360 spatial data.
  record video-spatial {
    /// 360 director timeline.
    director-timeline: list<video-spatial-director-timeline-item>,
    /// The 360 field of view, from 30 (minimum) to 90 (maximum). The default is 50.
    field-of-view: f64,
    /// The 360 spatial projection:
    /// 
    projection: video-spatial-projection-enum,
    /// The 360 stereo format:
    /// 
    stereo-format: video-spatial-stereo-format-enum
  }

  record video-spatial-director-timeline-item {
    /// The director timeline pitch, from -90 (minimum) to 90 (maximum).
    pitch: option<f64>,
    /// The director timeline roll.
    roll: option<f64>,
    /// The director timeline time code.
    time-code: option<f64>,
    /// The director timeline yaw, from 0 (minimum) to 360 (maximum).
    yaw: option<f64>
  }

  /// A collection of stats associated with this video.
  record video-stats {
    /// The current total number of times that the video has been played.
    plays: f64
  }

  record tag {
    /// The normalized canonical tag name.
    canonical: string,
    /// Metadata about the group.
    metadata: tag-metadata,
    /// The tag value.
    name: string,
    /// The tag's resource key string.
    resource-key: string,
    /// The canonical relative URI of the tag.
    uri: string
  }

  /// Metadata about the group.
  record tag-metadata {
    /// A collection of information that is connected to this resource.
    connections: tag-metadata-connections
  }

  /// A collection of information that is connected to this resource.
  record tag-metadata-connections {
    /// Information about the videos related to this tag.
    videos: tag-metadata-connections-videos
  }

  /// Information about the videos related to this tag.
  record tag-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// The transcode information for a video upload.
  record video-transcode {
    /// Status code for this video's availability.
    status: option<video-transcode-status-enum>
  }

  /// The upload information for this video.
  record video-upload {
    /// The approach for uploading the video.
    approach: option<video-upload-approach-enum>,
    /// The URI for completing the upload.
    complete-uri: option<string>,
    /// The HTML form for uploading a video through the post approach.
    form: option<string>,
    /// The link of the video to capture through the pull approach.
    link: option<string>,
    /// The redirect URL for the upload app.
    redirect-url: option<string>,
    /// The file size in bytes of the uploaded video.
    size: option<f64>,
    /// The status code for the availability of the uploaded video:
    /// 
    status: video-transcode-status-enum,
    /// The link for sending video file data.
    upload-link: option<string>
  }

  variant get-project-videos-alt1-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-videos-to-project-alt1-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant remove-videos-from-project-alt1-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-video-to-project-alt1-error {
    not-found(string),
    other(string)
  }

  variant remove-video-from-project-alt1-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant get-project-videos-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-videos-to-project-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant remove-videos-from-project-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant add-video-to-project-error {
    not-found(string),
    other(string)
  }

  variant remove-video-from-project-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get all the videos in a project
  record get-project-videos-alt1-params {
    /// The ID of the project.
    project-id: string,
    /// The sort direction of the results.
    direction: option<get-project-videos-alt1-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The way to sort the results.
    sort: option<get-project-videos-alt1-sort-enum>
  }
  get-project-videos-alt1: func(params: get-project-videos-alt1-params) -> result<list<video>, get-project-videos-alt1-error>;

  /// Add a list of videos to a project
  record add-videos-to-project-alt1-params {
    /// The ID of the project.
    project-id: string,
    /// A comma-separated list of video URIs to add.
    uris: string
  }
  add-videos-to-project-alt1: func(params: add-videos-to-project-alt1-params) -> result<string, add-videos-to-project-alt1-error>;

  /// Remove a list of videos from a project
  record remove-videos-from-project-alt1-params {
    /// The ID of the project.
    project-id: string,
    /// Whether to delete the videos when removing them from the project.
    should-delete-clips: option<bool>,
    /// A comma-separated list of the video URIs to remove.
    uris: string
  }
  remove-videos-from-project-alt1: func(params: remove-videos-from-project-alt1-params) -> result<string, remove-videos-from-project-alt1-error>;

  /// Add a specific video to a project
  record add-video-to-project-alt1-params {
    /// The ID of the project.
    project-id: string,
    /// The ID of the video.
    video-id: string
  }
  add-video-to-project-alt1: func(params: add-video-to-project-alt1-params) -> result<string, add-video-to-project-alt1-error>;

  /// Remove a specific video from a project
  record remove-video-from-project-alt1-params {
    /// The ID of the project.
    project-id: string,
    /// The ID of the video.
    video-id: string
  }
  remove-video-from-project-alt1: func(params: remove-video-from-project-alt1-params) -> result<string, remove-video-from-project-alt1-error>;

  /// Get all the videos in a project
  record get-project-videos-params {
    /// The ID of the project.
    project-id: string,
    /// The ID of the user.
    user-id: string,
    /// The sort direction of the results.
    direction: option<get-project-videos-alt1-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The way to sort the results.
    sort: option<get-project-videos-alt1-sort-enum>
  }
  get-project-videos: func(params: get-project-videos-params) -> result<list<video>, get-project-videos-error>;

  /// Add a list of videos to a project
  record add-videos-to-project-params {
    /// The ID of the project.
    project-id: string,
    /// The ID of the user.
    user-id: string,
    /// A comma-separated list of video URIs to add.
    uris: string
  }
  add-videos-to-project: func(params: add-videos-to-project-params) -> result<string, add-videos-to-project-error>;

  /// Remove a list of videos from a project
  record remove-videos-from-project-params {
    /// The ID of the project.
    project-id: string,
    /// The ID of the user.
    user-id: string,
    /// Whether to delete the videos when removing them from the project.
    should-delete-clips: option<bool>,
    /// A comma-separated list of the video URIs to remove.
    uris: string
  }
  remove-videos-from-project: func(params: remove-videos-from-project-params) -> result<string, remove-videos-from-project-error>;

  /// Add a specific video to a project
  record add-video-to-project-params {
    /// The ID of the project.
    project-id: string,
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  add-video-to-project: func(params: add-video-to-project-params) -> result<string, add-video-to-project-error>;

  /// Remove a specific video from a project
  record remove-video-from-project-params {
    /// The ID of the project.
    project-id: string,
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  remove-video-from-project: func(params: remove-video-from-project-params) -> result<string, remove-video-from-project-error>;

}

interface videos-upload {
  enum upload-video-alt1-body-embed-title-name-enum {
    hide,
    show,
    user,
  }

  enum upload-video-alt1-body-license-enum {
    by,
    by-nc,
    by-nc-nd,
    by-nc-sa,
    by-nd,
    by-sa,
    cc0,
  }

  enum upload-video-alt1-body-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum upload-video-alt1-body-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum upload-video-alt1-body-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum upload-video-alt1-body-ratings-mpaa-reason-enum {
    at,
    bn,
    n,
    sl,
    ss,
    v,
  }

  enum upload-video-alt1-body-ratings-tv-reason-enum {
    d,
    fv,
    l,
    ss,
    v,
  }

  enum upload-video-alt1-body-spatial-projection-enum {
    cubical,
    cylindrical,
    dome,
    equirectangular,
    pyramid,
  }

  enum upload-video-alt1-body-spatial-stereo-format-enum {
    left-right,
    mono,
    top-bottom,
  }

  enum upload-video-alt1-body-upload-approach-enum {
    post,
    pull,
    streaming,
    tus,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum video-context-action-enum {
    added-to,
    appearance-by,
    liked-by,
    uploaded-by,
  }

  enum video-metadata-interactions-buy-download-enum {
    available,
    purchased,
    restricted,
    unavailable,
  }

  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  enum video-privacy-embed-enum {
    private,
    public,
  }

  enum video-status-enum {
    available,
    quota-exceeded,
    total-cap-exceeded,
    transcode-starting,
    transcoding,
    transcoding-error,
    unavailable,
    uploading,
    uploading-error,
  }

  enum video-transcode-status-enum {
    complete,
    error,
    in-progress,
  }

  record upload-video-alt1-body-embed {
    buttons: option<upload-video-alt1-body-embed-buttons>,
    /// The main color of the embed player.
    color: option<string>,
    logos: option<upload-video-alt1-body-embed-logos>,
    /// Show or hide the playbar.
    playbar: option<bool>,
    title: option<upload-video-alt1-body-embed-title>,
    /// Show or hide the volume selector.
    volume: option<bool>
  }

  record upload-video-alt1-body-embed-buttons {
    /// Show or hide the Embed button.
    embed: option<bool>,
    /// Show or hide the Fullscreen button.
    fullscreen: option<bool>,
    /// Show or hide the HD button.
    hd: option<bool>,
    /// Show or hide the Like button.
    like: option<bool>,
    /// Show or hide the Scaling button (shown only in Fullscreen mode).
    scaling: option<bool>,
    /// Show or hide the Share button.
    share: option<bool>,
    /// Show or hide the Watch Later button.
    watchlater: option<bool>
  }

  record upload-video-alt1-body-embed-logos {
    custom: option<upload-video-alt1-body-embed-logos-custom>,
    /// Show or hide the Vimeo logo.
    vimeo: option<bool>
  }

  record upload-video-alt1-body-embed-logos-custom {
    /// Show or hide your custom logo.
    active: option<bool>,
    /// The URL that loads when the user clicks your custom logo.
    link: option<string>,
    /// Whether always to show the custom logo or to hide it after time with the rest of the UI.
    sticky: option<bool>
  }

  record upload-video-alt1-body-embed-title {
    /// Show or hide the video title, or enable the user to determine whether the video title appears.
    name: option<upload-video-alt1-body-embed-title-name-enum>,
    /// Show or hide the owner information, or enable the user to determine whether the owner information appears.
    owner: option<upload-video-alt1-body-embed-title-name-enum>,
    /// Show or hide the owner portrait, or enable the user to determine whether the owner portrait appears.
    portrait: option<upload-video-alt1-body-embed-title-name-enum>
  }

  record upload-video-alt1-body-privacy {
    /// Whether a user can add the video to an album, channel, or group.
    add: option<bool>,
    /// The privacy level required to comment on the video.
    comments: option<upload-video-alt1-body-privacy-comments-enum>,
    /// Whether a user can download the video. Not available to users with a Basic membership
    download: option<bool>,
    /// The video's embed settings. The `whitelist` value enables you to define all valid embed domains. See our [documentation](https://developer.vimeo.com/api/endpoints/videos#/{video_id}/privacy/domains) for details on adding and removing domains.
    embed: option<upload-video-alt1-body-privacy-embed-enum>,
    /// The video's privacy setting. When privacy is `users`, `application/json` is the only valid content type. Basic users can't set privacy to `unlisted`.
    view: option<upload-video-alt1-body-privacy-view-enum>
  }

  record upload-video-alt1-body-ratings {
    mpaa: option<upload-video-alt1-body-ratings-mpaa>,
    tv: option<upload-video-alt1-body-ratings-tv>
  }

  record upload-video-alt1-body-ratings-mpaa {
    /// The reason for the video's MPAA rating.
    /// 
    reason: option<upload-video-alt1-body-ratings-mpaa-reason-enum>
  }

