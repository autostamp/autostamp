interface on-demand-promotions {
  enum get-vod-promotions-filter-enum {
    batch,
    default,
    single,
    vip,
  }

  enum on-demand-promotion-access-type-enum {
    default,
    vip,
  }

  enum on-demand-promotion-discount-type-enum {
    dollars,
    free,
    percent,
  }

  enum on-demand-promotion-product-type-enum {
    any,
    buy,
    buy-episode,
    rent,
    rent-episode,
    subscribe,
  }

  enum on-demand-promotion-stream-period-enum {
    v1-week,
    v1-year,
    v24-hour,
    v30-days,
    v3-month,
    v48-hour,
    v6-month,
    v72-hour,
  }

  enum on-demand-promotion-type-op-enum {
    batch,
    batch-prefix,
    single,
  }

  enum create-vod-promotion-body-discount-type-enum {
    free,
    percent,
  }

  enum create-vod-promotion-body-stream-period-enum {
    v1-week,
    v1-year,
    v24-hour,
    v30-day,
    v3-month,
    v48-hour,
    v6-month,
    v72-hour,
  }

  enum create-vod-promotion-body-type-op-enum {
    batch,
    single,
  }

  record on-demand-promotion {
    /// The type of access that this promotion grants:
    /// 
    access-type: on-demand-promotion-access-type-enum,
    /// The type of discount for which this promotion can be used.
    /// 
    discount-type: on-demand-promotion-discount-type-enum,
    /// Whether this promotion grants download access to On Demand content.
    download: bool,
    /// The prefix string for batch codes, or the null value for single codes.
    label: string,
    /// The video's metadata.
    metadata: on-demand-promotion-metadata,
    /// The percentage amount that is deducted from the product price.
    percent-off: f64,
    /// The type of product to which this promotion can be applied. Only `buy` and `rent` are available for the VIP access type:
    /// 
    product-type: on-demand-promotion-product-type-enum,
    /// The amount of time that the user has access to the VOD content after redeeming a promo code.
    /// 
    stream-period: on-demand-promotion-stream-period-enum,
    /// The total amount of times that this promotion can be used.
    total: f64,
    /// The way in which this promotion can generate promo codes:
    /// 
    type-op: on-demand-promotion-type-op-enum,
    /// The promotion's canonical relative URI.
    uri: string
  }

  /// The video's metadata.
  record on-demand-promotion-metadata {
    /// A list of resource URIs related to the On Demand promotion.
    connections: on-demand-promotion-metadata-connections
  }

  /// A list of resource URIs related to the On Demand promotion.
  record on-demand-promotion-metadata-connections {
    /// Information about the codes associated with this promotion.
    codes: on-demand-promotion-metadata-connections-codes
  }

  /// Information about the codes associated with this promotion.
  record on-demand-promotion-metadata-connections-codes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of uses on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record on-demand-promotion-code {
    /// A promotion code that can be redeemed on Vimeo.
    code: string,
    /// A link to redeem the promotion code instantly.
    link: string,
    /// The total amount of times this code can be used.
    max-uses: f64,
    /// The number of times that this code has been used.
    uses: f64
  }

  variant get-vod-promotions-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-vod-promotion-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-vod-promotion-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-vod-promotion-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-vod-promotion-codes-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the promotions on an On Demand page
  record get-vod-promotions-params {
    /// The ID of the On Demand.
    ondemand-id: string,
    /// The filter to apply to the results.
    filter: get-vod-promotions-filter-enum,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-vod-promotions: func(params: get-vod-promotions-params) -> result<on-demand-promotion, get-vod-promotions-error>;

  /// Add a promotion to an On Demand page
  record create-vod-promotion-params {
    /// The ID of the On Demand.
    ondemand-id: string,
    /// The promotion access type, which is a purchase option that isn't available on the container. VIP promotions always make the content free of charge. If you use this type, you must further define the promotion with the `download` or `stream_period` fields.
    /// 
    access-type: option<on-demand-promotion-access-type-enum>,
    /// The promotion code. This field is ignored for batch promotions.
    code: option<string>,
    /// The type of discount offered by the promo code. When `access_type` is `vip`, the value of this field must be `free`.
    /// 
    discount-type: option<create-vod-promotion-body-discount-type-enum>,
    /// Whether the promotion grants download access to VOD content. This is necessary only when not previously defined in the On Demand container or when `access_type` is `vip` or `product_type` is `buy`.
    download: bool,
    /// The end of the promotion period. If you don't specify a value, the promotion will never expire.
    end-time: option<string>,
    /// The description of a batch promotion. This field is ignored for single promotions.
    label: option<string>,
    /// The percentage of the discount by using this promo code. This field is applicable only when `discount_type` is `percent`.
    percent-off: option<f64>,
    /// The type of transaction to which the promotion applies. When `access_type` is `default`, the default value is `any`, but the default value is `rent` when `access_type` is `vip`. Also, when `access_type` is `vip`, the only valid product types are `buy` and `rent`.
    product-type: option<on-demand-promotion-product-type-enum>,
    /// The start of the promotion period. If you don't specify a value, the start time defaults to the time that the promotion was created.
    start-time: option<string>,
    /// The amount of time that a user has access to the VOD content upon redeeming a promo code. This field is necessary only when not defined in the On Demand container or when creating promotions when `access_type` is `vip` or `product_type` is `rent`.
    stream-period: create-vod-promotion-body-stream-period-enum,
    /// The number of promotions to generate when `type` is `batch`, or the number of uses of the promotion when `type` is `single`.
    total: f64,
    /// The type of promotion. When `access_type` is `vip`, the value for this field must be `batch`.
    /// 
    type-op: create-vod-promotion-body-type-op-enum
  }
  create-vod-promotion: func(params: create-vod-promotion-params) -> result<on-demand-promotion, create-vod-promotion-error>;

  /// Get a specific promotion on an On Demand page
  record get-vod-promotion-params {
    /// The ID of the On Demand.
    ondemand-id: string,
    /// The ID of the promotion.
    promotion-id: string
  }
  get-vod-promotion: func(params: get-vod-promotion-params) -> result<on-demand-promotion, get-vod-promotion-error>;

  /// Remove a promotion from an On Demand page
  record delete-vod-promotion-params {
    /// The ID of the On Demand.
    ondemand-id: string,
    /// The ID of the promotion.
    promotion-id: string
  }
  delete-vod-promotion: func(params: delete-vod-promotion-params) -> result<string, delete-vod-promotion-error>;

  /// Get all the codes of a promotion on an On Demand page
  record get-vod-promotion-codes-params {
    /// The ID of the On Demand.
    ondemand-id: string,
    /// The ID of the promotion.
    promotion-id: string,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-vod-promotion-codes: func(params: get-vod-promotion-codes-params) -> result<on-demand-promotion-code, get-vod-promotion-codes-error>;

}

interface on-demand-regions {
  record on-demand-region {
    /// The ISO 3166-1 alpha-2 code for this country.
    country-code: string,
    /// The descriptive name of this country.
    country-name: string,
    /// The region container's relative URI.
    uri: string
  }

  variant get-vod-regions-error {
    not-found(string),
    other(string)
  }

  variant set-vod-regions-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-vod-regions-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-vod-region-error {
    not-found(string),
    other(string)
  }

  variant add-vod-region-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-vod-region-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-region-error {
    not-found(string),
    other(string)
  }

  /// Get all the regions of an On Demand page
