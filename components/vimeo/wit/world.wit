    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  variant get-category-channels-error {
    not-found(string),
    other(string)
  }

  /// Get all the channels in a category
  record get-category-channels-params {
    /// The name of the category.
    category: string,
    /// The sort direction of the results.
    direction: option<get-category-channels-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-category-channels-sort-enum>
  }
  get-category-channels: func(params: get-category-channels-params) -> result<list<channel>, get-category-channels-error>;

}

interface categories-groups {
  enum get-category-groups-direction-enum {
    asc,
    desc,
  }

  enum get-category-groups-sort-enum {
    alphabetical,
    date,
    members,
    videos,
  }

  enum group-metadata-interactions-join-type-op-enum {
    member,
    moderator,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum group-privacy-comment-enum {
    all,
    members,
  }

  enum group-privacy-join-enum {
    anybody,
    members,
  }

  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum user-preferences-videos-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum user-preferences-videos-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum user-preferences-videos-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  record group {
    /// The time in ISO 8601 format when the group was created.
    created-time: string,
    /// The group's description.
    description: string,
    /// The link to the group.
    link: string,
    /// Metadata about the group.
    metadata: group-metadata,
    /// The time in ISO 8601 format when the group was last modified.
    modified-time: string,
    /// The group's display name.
    name: string,
    /// The active picture for this group.
    pictures: picture,
    /// The group's privacy settings.
    privacy: group-privacy,
    /// The resource key of the group.
    resource-key: string,
    /// The canonical relative URI of this group.
    uri: string,
    /// The owner of the group.
    user: option<user>
  }

  /// Metadata about the group.
  record group-metadata {
    /// A collection of information that is connected to this resource.
    connections: group-metadata-connections,
    /// User actions that have involved the group. This data requires a bearer token with the `private` scope.
    interactions: group-metadata-interactions
  }

  /// A collection of information that is connected to this resource.
  record group-metadata-connections {
    /// Information about the members or moderators of this group.
    users: group-metadata-connections-users,
    /// Information about the videos contained within this group.
    videos: group-metadata-connections-videos
  }

  /// Information about the members or moderators of this group.
  record group-metadata-connections-users {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
