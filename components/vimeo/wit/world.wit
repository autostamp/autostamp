    per-page: option<f64>
  }
  get-vod-backgrounds: func(params: get-vod-backgrounds-params) -> result<list<picture>, get-vod-backgrounds-error>;

  /// Add a background to an On Demand page
  record create-vod-background-params {
    /// The ID of the On Demand.
    ondemand-id: string
  }
  create-vod-background: func(params: create-vod-background-params) -> result<picture, create-vod-background-error>;

  /// Get a specific background of an On Demand page
  record get-vod-background-params {
    /// The ID of the background.
    background-id: string,
    /// The ID of the On Demand.
    ondemand-id: string
  }
  get-vod-background: func(params: get-vod-background-params) -> result<picture, get-vod-background-error>;

  /// Edit a background of an On Demand page
  record edit-vod-background-params {
    /// The ID of the background.
    background-id: string,
    /// The ID of the On Demand.
    ondemand-id: string,
    /// Whether to make this background the active background.
    active: option<bool>
  }
  edit-vod-background: func(params: edit-vod-background-params) -> result<picture, edit-vod-background-error>;

  /// Remove a background from an On Demand page
  record delete-vod-background-params {
    /// The ID of the background.
    background-id: string,
    /// The ID of the On Demand.
    ondemand-id: string
  }
  delete-vod-background: func(params: delete-vod-background-params) -> result<picture, delete-vod-background-error>;

}

