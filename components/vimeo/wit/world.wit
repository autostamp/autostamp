    direction: option<get-category-channels-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-category-channels-sort-enum>
  }
  get-category-channels: func(params: get-category-channels-params) -> result<string, string>;

}

interface categories-groups {
  enum get-category-groups-direction-enum {
