    album-id: string,
    /// The ID of the custom thumbnail.
    thumbnail-id: string,
    /// The ID of the user.
    user-id: string,
    /// Whether to make this the active album thumbnail.
    active: option<bool>
  }
  replace-album-custom-thumb: func(params: replace-album-custom-thumb-params) -> result<picture, replace-album-custom-thumb-error>;

  /// Remove a custom uploaded album thumbnail
  record delete-album-custom-thumbnail-params {
    /// The ID of the album.
    album-id: string,
    /// The ID of the custom thumbnail.
    thumbnail-id: string,
    /// The ID of the user.
    user-id: string
  }
  delete-album-custom-thumbnail: func(params: delete-album-custom-thumbnail-params) -> result<string, delete-album-custom-thumbnail-error>;

}

