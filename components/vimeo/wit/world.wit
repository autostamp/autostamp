  }

  /// Information about the user's lifetime upload usage.
  record user-upload-quota-lifetime {
    /// The number of bytes remaining in your lifetime maximum.
    free: f64,
    /// The total number of bytes that you can upload across the lifetime of your account.
    max: f64,
    /// The number of bytes that you've already uploaded against your lifetime limit.
    used: f64
  }

  /// Information about the user's usage for the current period.
  record user-upload-quota-periodic {
    /// The number of bytes remaining in your upload quota for the current period.
    free: f64,
    /// The total number of bytes that you can upload per period.
    max: f64,
    /// The time in ISO 8601 format when your upload quota resets.
    reset-date: string,
    /// The number of bytes that you've already uploaded against your quota in the current period.
    used: f64
  }

  /// Information about the user's upload space remaining for the current period.
  record user-upload-quota-space {
    /// The number of bytes remaining in your upload quota.
    free: f64,
    /// The maximum number of bytes allotted to your upload quota.
    max: f64,
    /// Whether the values of the upload_quota.space fields are for the lifetime quota or the periodic quota.
    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  /// The video's privacy setting.
  record video-privacy {
    /// Whether the video can be added to collections.
    add: bool,
    /// Who can comment on the video:
    /// 
    comments: user-preferences-videos-privacy-comments-enum,
    /// The video's download permission setting.
    download: bool,
    /// The video's embed permission setting:
    /// 
    embed: video-privacy-embed-enum,
    /// The general privacy setting for the video:
    /// 
    view: user-preferences-videos-privacy-view-enum
  }

  /// 360 spatial data.
  record video-spatial {
    /// 360 director timeline.
    director-timeline: list<video-spatial-director-timeline-item>,
    /// The 360 field of view, from 30 (minimum) to 90 (maximum). The default is 50.
    field-of-view: f64,
    /// The 360 spatial projection:
    /// 
    projection: video-spatial-projection-enum,
    /// The 360 stereo format:
    /// 
    stereo-format: video-spatial-stereo-format-enum
  }

  record video-spatial-director-timeline-item {
    /// The director timeline pitch, from -90 (minimum) to 90 (maximum).
    pitch: option<f64>,
    /// The director timeline roll.
    roll: option<f64>,
    /// The director timeline time code.
    time-code: option<f64>,
    /// The director timeline yaw, from 0 (minimum) to 360 (maximum).
    yaw: option<f64>
  }

  /// A collection of stats associated with this video.
  record video-stats {
    /// The current total number of times that the video has been played.
    plays: f64
  }

  record tag {
    /// The normalized canonical tag name.
    canonical: string,
    /// Metadata about the group.
    metadata: tag-metadata,
    /// The tag value.
    name: string,
    /// The tag's resource key string.
    resource-key: string,
    /// The canonical relative URI of the tag.
    uri: string
  }

  /// Metadata about the group.
  record tag-metadata {
    /// A collection of information that is connected to this resource.
    connections: tag-metadata-connections
  }

  /// A collection of information that is connected to this resource.
  record tag-metadata-connections {
    /// Information about the videos related to this tag.
    videos: tag-metadata-connections-videos
  }

  /// Information about the videos related to this tag.
  record tag-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// The transcode information for a video upload.
  record video-transcode {
    /// Status code for this video's availability.
    status: option<video-transcode-status-enum>
  }

  /// The upload information for this video.
  record video-upload {
    /// The approach for uploading the video.
    approach: option<video-upload-approach-enum>,
    /// The URI for completing the upload.
    complete-uri: option<string>,
    /// The HTML form for uploading a video through the post approach.
    form: option<string>,
    /// The link of the video to capture through the pull approach.
    link: option<string>,
    /// The redirect URL for the upload app.
    redirect-url: option<string>,
    /// The file size in bytes of the uploaded video.
    size: option<f64>,
    /// The status code for the availability of the uploaded video:
    /// 
    status: video-transcode-status-enum,
    /// The link for sending video file data.
    upload-link: option<string>
  }

  variant get-watch-later-queue-alt1-error {
    not-modified(string),
    other(string)
  }

  variant check-watch-later-queue-alt1-error {
    not-found(string),
    other(string)
  }

  variant get-watch-later-queue-error {
    not-modified(string),
    other(string)
  }

  variant check-watch-later-queue-error {
    not-found(string),
    other(string)
  }

  /// Get all the videos in a user's Watch Later queue
  record get-watch-later-queue-alt1-params {
    /// The sort direction of the results.
    direction: option<get-watch-later-queue-alt1-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-watch-later-queue-alt1-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-watch-later-queue-alt1-sort-enum>
  }
  get-watch-later-queue-alt1: func(params: get-watch-later-queue-alt1-params) -> result<list<video>, get-watch-later-queue-alt1-error>;

  /// Check if a user has added a specific video to their Watch Later queue
  record check-watch-later-queue-alt1-params {
    /// The ID of the video.
    video-id: string
  }
  check-watch-later-queue-alt1: func(params: check-watch-later-queue-alt1-params) -> result<video, check-watch-later-queue-alt1-error>;

  /// Add a video to a user's Watch Later queue
  record add-video-to-watch-later-alt1-params {
    /// The ID of the video.
    video-id: string
  }
  add-video-to-watch-later-alt1: func(params: add-video-to-watch-later-alt1-params) -> result<string, string>;

  /// Remove a video from a user's Watch Later queue
  record delete-video-from-watch-later-alt1-params {
    /// The ID of the video.
    video-id: string
  }
  delete-video-from-watch-later-alt1: func(params: delete-video-from-watch-later-alt1-params) -> result<string, string>;

  /// Get all the videos in a user's Watch Later queue
  record get-watch-later-queue-params {
    /// The ID of the user.
    user-id: string,
    /// The sort direction of the results.
    direction: option<get-watch-later-queue-alt1-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-watch-later-queue-alt1-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-watch-later-queue-alt1-sort-enum>
  }
  get-watch-later-queue: func(params: get-watch-later-queue-params) -> result<list<video>, get-watch-later-queue-error>;

  /// Check if a user has added a specific video to their Watch Later queue
  record check-watch-later-queue-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  check-watch-later-queue: func(params: check-watch-later-queue-params) -> result<video, check-watch-later-queue-error>;

  /// Add a video to a user's Watch Later queue
  record add-video-to-watch-later-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  add-video-to-watch-later: func(params: add-video-to-watch-later-params) -> result<string, string>;

  /// Remove a video from a user's Watch Later queue
  record delete-video-from-watch-later-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the video.
    video-id: string
  }
  delete-video-from-watch-later: func(params: delete-video-from-watch-later-params) -> result<string, string>;

}

interface authentication-extras-essentials {
  enum exchange-auth-code-body-grant-type-enum {
    authorization-code,
  }

  enum auth-token-type-enum {
    bearer,
  }

  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum user-preferences-videos-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum user-preferences-videos-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum user-preferences-videos-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  enum client-auth-body-grant-type-enum {
    client-credentials,
  }

  enum convert-access-token-body-grant-type-enum {
    vimeo-oauth1,
  }

  record auth {
    /// The access token string.
    access-token: string,
    /// The API application associated with the token.
    app: api-app,
    /// The date and time that the token expires.
    expires-on: option<string>,
    /// The refresh token string.
    refresh-token: option<string>,
    /// The scope or scopes that the token supports.
    scope: string,
    /// The token type:
    /// 
    token-type: auth-token-type-enum,
    /// The user associated with the token.
    user: option<user>
  }

  record api-app {
    /// The name of the API app.
    name: string,
    /// The canonical URI of the API app.
    uri: string
  }

  record user {
    /// The user's account type:
    /// 
    account: user-account-enum,
    /// The user's bio.
    bio: string,
    /// The user's content filters:
    /// 
    content-filter: option<string>,
    /// The time in ISO 8601 format when the user account was created.
    created-time: string,
    /// The user's email address. This data requires a bearer token with the `email` scope.
    email: option<string>,
    /// The absolute URL of this user's profile page.
    link: string,
    /// The user's location.
    location: string,
    /// The user's metadata.
    metadata: user-metadata,
    /// The user's display name.
    name: string,
    /// The active portrait of this user.
    pictures: picture,
    preferences: option<user-preferences>,
    /// The user's resource key string.
    resource-key: string,
    /// Appears only when the user has upload access and is looking at their own user record.
    upload-quota: user-upload-quota,
    /// The user's canonical relative URI.
    uri: string,
    /// The user's websites.
    websites: list<user-websites-item>
  }

  /// The user's metadata.
  record user-metadata {
    /// The list of resource URIs related to the user.
    connections: user-metadata-connections,
    interactions: user-metadata-interactions
  }

  /// The list of resource URIs related to the user.
  record user-metadata-connections {
    /// Information about the albums created by this user.
    albums: user-metadata-connections-albums,
    /// Information about the appearances of this user in other videos.
    appearances: user-metadata-connections-appearances,
    /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
    block: user-metadata-connections-block,
    /// Information about this user's followed categories.
    categories: user-metadata-connections-categories,
    /// Information about this user's subscribed channels.
    channels: user-metadata-connections-channels,
    /// Information about this user's feed.
    feed: user-metadata-connections-feed,
    /// Information about this user's folders.
    folders: user-metadata-connections-folders,
    /// Information about the user's followers.
    followers: user-metadata-connections-followers,
    /// Information about the users that the current user is following.
    following: user-metadata-connections-following,
    /// Information about the groups created by this user.
    groups: user-metadata-connections-groups,
    /// Information about the videos that this user has liked.
    likes: user-metadata-connections-likes,
    /// Information about the channels that this user moderates.
    moderated-channels: user-metadata-connections-moderated-channels,
    /// Information about this user's portraits.
    pictures: user-metadata-connections-pictures,
    /// Information about this user's portfolios.
    portfolios: user-metadata-connections-portfolios,
    /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-channels: user-metadata-connections-recommended-channels,
    /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-users: user-metadata-connections-recommended-users,
    /// Information about the videos that have been shared with this user.
    shared: user-metadata-connections-shared,
    /// Information about the videos uploaded by this user.
    videos: user-metadata-connections-videos,
    /// Information about the videos that this user has watched.
    watched-videos: user-metadata-connections-watched-videos,
    /// Information about the videos that this user wants to watch later.
    watchlater: user-metadata-connections-watchlater
  }

  /// Information about the albums created by this user.
  record user-metadata-connections-albums {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of albums on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the appearances of this user in other videos.
  record user-metadata-connections-appearances {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of appearances on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-block {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of blocked users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about this user's followed categories.
  record user-metadata-connections-categories {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of categories on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's subscribed channels.
  record user-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's feed.
  record user-metadata-connections-feed {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's folders.
  record user-metadata-connections-folders {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of folders on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user's followers.
  record user-metadata-connections-followers {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of followers on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users that the current user is following.
  record user-metadata-connections-following {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups created by this user.
  record user-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has liked.
  record user-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the channels that this user moderates.
  record user-metadata-connections-moderated-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portraits.
  record user-metadata-connections-pictures {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of pictures on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portfolios.
  record user-metadata-connections-portfolios {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of portfolios on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-channels {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of channels on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-users {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about the videos that have been shared with this user.
  record user-metadata-connections-shared {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos uploaded by this user.
  record user-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has watched.
  record user-metadata-connections-watched-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user wants to watch later.
  record user-metadata-connections-watchlater {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-metadata-interactions {
    add-privacy-user: option<user-metadata-interactions-add-privacy-user>,
    /// Information related to the block status of this user.
    block: user-metadata-interactions-block,
    /// Information related to the followed status of this user.
    follow: user-metadata-interactions-follow,
    /// Information regarding where and how to report a user.
    report: user-metadata-interactions-report
  }

  record user-metadata-interactions-add-privacy-user {
    /// An array of the HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: option<string>
  }

  /// Information related to the block status of this user.
  record user-metadata-interactions-block {
    /// Whether a user is blocking the current user.
    added: bool,
    /// The time in ISO 8601 format when the block occurred, or the null value if no block exists.
    added-time: string,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to block or unblock the user.
    uri: string
  }

  /// Information related to the followed status of this user.
  record user-metadata-interactions-follow {
    /// Whether a user is following the current user.
    added: bool,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to follow the user.
    uri: string
  }

  /// Information regarding where and how to report a user.
  record user-metadata-interactions-report {
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// List of valid reasons for reporting a video.
    reason: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  record user-preferences {
    videos: option<user-preferences-videos>
  }

  record user-preferences-videos {
    privacy: option<user-preferences-videos-privacy>
  }

  record user-preferences-videos-privacy {
    /// Whether other users can add the user's videos.
    add: option<bool>,
    /// The user's privacy preference for comments:
    /// 
    comments: option<user-preferences-videos-privacy-comments-enum>,
    /// Whether other users can download the user's videos.
    download: option<bool>,
    /// The user's privacy preference for embeds:
    /// 
    embed: option<user-preferences-videos-privacy-embed-enum>,
    /// The user's privacy preference for views:
    /// 
    view: option<user-preferences-videos-privacy-view-enum>
  }

  /// Appears only when the user has upload access and is looking at their own user record.
  record user-upload-quota {
    /// Information about the user's lifetime upload usage.
    lifetime: user-upload-quota-lifetime,
    /// Information about the user's usage for the current period.
    periodic: user-upload-quota-periodic,
    /// Information about the user's upload space remaining for the current period.
    space: user-upload-quota-space
  }

  /// Information about the user's lifetime upload usage.
  record user-upload-quota-lifetime {
    /// The number of bytes remaining in your lifetime maximum.
    free: f64,
    /// The total number of bytes that you can upload across the lifetime of your account.
    max: f64,
    /// The number of bytes that you've already uploaded against your lifetime limit.
    used: f64
  }

  /// Information about the user's usage for the current period.
  record user-upload-quota-periodic {
    /// The number of bytes remaining in your upload quota for the current period.
    free: f64,
    /// The total number of bytes that you can upload per period.
    max: f64,
    /// The time in ISO 8601 format when your upload quota resets.
    reset-date: string,
    /// The number of bytes that you've already uploaded against your quota in the current period.
    used: f64
  }

  /// Information about the user's upload space remaining for the current period.
  record user-upload-quota-space {
    /// The number of bytes remaining in your upload quota.
    free: f64,
    /// The maximum number of bytes allotted to your upload quota.
    max: f64,
    /// Whether the values of the upload_quota.space fields are for the lifetime quota or the periodic quota.
    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  variant exchange-auth-code-error {
    bad-request(string),
    other(string)
  }

  variant client-auth-error {
    unauthorized(string),
    other(string)
  }

  variant convert-access-token-error {
    bad-request(string),
    other(string)
  }

  variant verify-token-error {
    unauthorized(string),
    other(string)
  }

  variant delete-token-error {
    bad-request(string),
    other(string)
  }

  /// Exchange an authorization code for an access token
  record exchange-auth-code-params {
    /// The authorization code received from the authorization server.
    code: string,
    /// The grant type. Must be set to `authorization_code`.
    grant-type: exchange-auth-code-body-grant-type-enum,
    /// The redirect URI. Must match the URI from `/oauth/authorize`.
    redirect-uri: string
  }
  exchange-auth-code: func(params: exchange-auth-code-params) -> result<auth, exchange-auth-code-error>;

  /// Authorize a client with OAuth
  record client-auth-params {
    /// The grant type. Must be set to `client_credentials`.
    grant-type: client-auth-body-grant-type-enum,
    /// A space-separated list of the authentication [scopes](https://developer.vimeo.com/api/authentication#supported-scopes) that you want to access. The default is `public`.
    scope: string
  }
  client-auth: func(params: client-auth-params) -> result<auth, client-auth-error>;

  /// Convert OAuth 1 access tokens to OAuth 2 access tokens
  record convert-access-token-params {
    /// The grant type. Must be set to `vimeo_oauth1`.
    grant-type: convert-access-token-body-grant-type-enum,
    /// The OAuth 1 token.
    token: string,
    /// The OAuth 1 token secret.
    token-secret: string
  }
  convert-access-token: func(params: convert-access-token-params) -> result<auth, convert-access-token-error>;

  /// Verify an OAuth 2 token
  verify-token: func() -> result<auth, verify-token-error>;

  /// Revoke the current access token
  delete-token: func() -> result<auth, delete-token-error>;

}

interface on-demand-genres {
  enum get-genre-vods-direction-enum {
    asc,
    desc,
  }

  enum get-genre-vods-filter-enum {
    country,
    my-region,
  }

  enum get-genre-vods-sort-enum {
    alphabetical,
    date,
    name,
    publish-time,
    videos,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum on-demand-page-episodes-rent-period-enum {
    v1-day,
    v1-month,
    v1-week,
    v1-year,
    v2-day,
    v24-hour,
    v3-day,
    v3-month,
    v30-day,
    v48-hour,
    v6-month,
    v60-day,
    v7-day,
    v72-hour,
  }

  enum video-context-action-enum {
    added-to,
    appearance-by,
    liked-by,
    uploaded-by,
  }

  enum embed-settings-title-name-enum {
    hide,
    show,
    user,
  }

  enum video-license-enum {
    by,
    by-nc,
    by-nc-nd,
    by-nc-sa,
    by-nd,
    by-sa,
    cc0,
  }

  enum video-metadata-interactions-buy-download-enum {
    available,
    purchased,
    restricted,
    unavailable,
  }

  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum user-preferences-videos-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum user-preferences-videos-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum user-preferences-videos-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  enum video-privacy-embed-enum {
    private,
    public,
  }

  enum video-spatial-projection-enum {
    cubical,
    cylindrical,
    dome,
    equirectangular,
    pyramid,
  }

  enum video-spatial-stereo-format-enum {
    left-right,
    mono,
    top-bottom,
  }

  enum video-status-enum {
    available,
    quota-exceeded,
    total-cap-exceeded,
    transcode-starting,
    transcoding,
    transcoding-error,
    unavailable,
    uploading,
    uploading-error,
  }

  enum video-transcode-status-enum {
    complete,
    error,
    in-progress,
  }

  enum video-upload-approach-enum {
    post,
    pull,
    streaming,
    tus,
  }

  enum on-demand-page-type-op-enum {
    film,
    series,
  }

  record on-demand-genre {
    /// The canonical name or URL slug of the genre.
    canonical: string,
    interactions: on-demand-genre-interactions,
    /// The Vimeo URL for this genre.
    link: string,
    metadata: on-demand-genre-metadata,
    /// The descriptive name of the genre.
    name: string,
    /// The relative URI of the On Demand genre.
    uri: string
  }

  record on-demand-genre-interactions {
    /// Interactions for On Demand pages that are in this genre.
    page: on-demand-genre-interactions-page
  }

  /// Interactions for On Demand pages that are in this genre.
  record on-demand-genre-interactions-page {
    /// Whether this On Demand genre was added.
    added: bool,
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to access the On Demand page.
    uri: string
  }

  record on-demand-genre-metadata {
    /// A collection of information connected to this resource.
    connections: on-demand-genre-metadata-connections
  }

  /// A collection of information connected to this resource.
  record on-demand-genre-metadata-connections {
    /// Information about the On Demand pages related to this group.
    pages: on-demand-genre-metadata-connections-pages
  }

  /// Information about the On Demand pages related to this group.
  record on-demand-genre-metadata-connections-pages {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record on-demand-page {
    /// The background image for the On Demand page on Vimeo.
    background: picture,
    /// The primary and secondary colors used for rendering this On Demand page.
    colors: on-demand-page-colors,
    /// An array of the page's content ratings.
    content-rating: list<string>,
    /// The time in ISO 8601 format when the page was created.
    created-time: option<string>,
    /// The description of this On Demand page.
    description: string,
    /// The link to this page on its own domain.
    domain-link: string,
    /// Information about this On Demand page's episodes, if the page is for a series.
    episodes: on-demand-page-episodes,
    /// This On Demand page's film, if it is a film.
    film: option<video>,
    /// All the genres assigned to this page.
    genres: list<on-demand-genre>,
    /// The link to the page on Vimeo.
    link: string,
    /// Metadata about the On Demand page.
    metadata: on-demand-page-metadata,
    /// he time in ISO 8601 format when the page was last modified.
    modified-time: option<string>,
    /// A descriptive title of this On Demand page.
    name: string,
    /// The active poster for this On Demand page.
    pictures: picture,
    preorder: on-demand-page-preorder,
    published: on-demand-page-published,
    /// The rating of this page.
    rating: f64,
    /// The VOD resource key.
    resource-key: string,
    /// The creator-designated SKU for this On Demand page.
    sku: option<string>,
    /// Information about subscribing to this On Demand page, if enabled.
    subscription: on-demand-page-subscription,
    /// The graphical theme for this On Demand page.
    theme: string,
    /// The thumbnail image for the On Demand page on Vimeo.
    thumbnail: picture,
    /// The trailer for this On Demand page.
    trailer: video,
    /// Whether this On Demand page is for a film or a series.
    /// 
    type-op: on-demand-page-type-op-enum,
    /// The relative URI of the On Demand page.
    uri: string,
    /// The user who created this On Demand page.
    user: user
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  /// The primary and secondary colors used for rendering this On Demand page.
  record on-demand-page-colors {
    /// The hexadecimal color code for the page's primary color.
    primary: string,
    /// The hexadecimal color code for the page's secondary color.
    secondary: string
  }

  /// Information about this On Demand page's episodes, if the page is for a series.
  record on-demand-page-episodes {
    buy: on-demand-page-episodes-buy,
    rent: on-demand-page-episodes-rent
  }

  record on-demand-page-episodes-buy {
    /// Whether all the videos on this On Demand page can be purchased as a whole.
    active: bool,
    /// The default price to buy an episode.
    price: f64
  }

  record on-demand-page-episodes-rent {
    /// Whether all the videos on this On Demand page can be rented as a whole.
    active: bool,
    /// The rental period for the video:
    /// 
    period: on-demand-page-episodes-rent-period-enum,
    /// The default price to rent an episode.
    price: f64
  }

  record video {
    /// The categories to which this video belongs.
    categories: list<category>,
    /// The content ratings of this video.
    content-rating: list<string>,
    /// The context of the video's subscription, if this video is part of a subscription.
    context: video-context,
    /// The time in ISO 8601 format when the video was created.
    created-time: string,
    /// A brief explanation of the video's content.
    description: string,
    /// The video's duration in seconds.
    duration: f64,
    /// Information about embedding this video.
    embed: embed-settings,
    /// The video's height in pixels.
    height: f64,
    /// The video's primary language.
    language: string,
    /// The time in ISO 8601 format when the user last modified the video.
    last-user-action-event-date: option<string>,
    /// The [Creative Commons](http://creativecommons.org/licenses/) license used for the video:
    /// 
    license: video-license-enum,
    /// The link to the video.
    link: string,
    /// The video's metadata.
    metadata: video-metadata,
    /// The time in ISO 8601 format when the video metadata was last modified.
    modified-time: string,
    /// The video's title.
    name: string,
    /// Information about the folder that contains this video.
    parent-folder: option<project>,
    /// The privacy-enabled password to watch this video. Only users can see their own video passwords. This data requires a bearer token with the `private` scope.
    password: option<string>,
    /// The active picture for this video.
    pictures: picture,
    /// The video's privacy setting.
    privacy: video-privacy,
    /// The time in ISO 8601 format when the video was released.
    release-time: string,
    /// The resource key string of the video.
    resource-key: string,
    /// 360 spatial data.
    spatial: video-spatial,
    /// A collection of stats associated with this video.
    stats: video-stats,
    /// The status code for the availability of the video. This field is deprecated in favor of `upload` and `transcode`.
    /// 
    status: video-status-enum,
    /// An array of all tags assigned to this video.
    tags: list<tag>,
    /// The transcode information for a video upload.
    transcode: video-transcode,
    /// The upload information for this video.
    upload: video-upload,
    /// The video's canonical relative URI.
    uri: string,
    /// The video owner.
    user: user,
    /// The video's width in pixels.
    width: f64
  }

  record category {
    /// The active icon for the category.
    icon: option<picture>,
    /// The last time, in ISO 8601 format, that a video was featured.
    last-video-featured-time: string,
    /// The URL to access the category in a browser.
    link: string,
    /// Metadata about the category.
    metadata: category-metadata,
    /// The display name that identifies the category.
    name: string,
    /// The container of this category's parent category, if the current category is a subcategory.
    parent: category-parent,
    /// The active picture for this category; defaults to vertical color bars.
    pictures: picture,
    /// The resource key of the category.
    resource-key: string,
    /// All the subcategories that belong to this category, if the current category is a top-level parent.
    subcategories: option<list<category-subcategories-item>>,
    /// Whether the category isn't a subcategory of another category.
    top-level: bool,
    /// The unique identifier to access the category resource.
    uri: string
  }

  /// Metadata about the category.
  record category-metadata {
    /// A collection of information that is connected to this resource.
    connections: category-metadata-connections,
    /// The permissible actions related to the category.
    interactions: category-metadata-interactions
  }

  /// A collection of information that is connected to this resource.
  record category-metadata-connections {
    /// Information about the channels related to this category.
    channels: category-metadata-connections-channels,
    /// Information about the groups related to this category.
    groups: category-metadata-connections-groups,
    /// Information about the users related to this category.
    users: category-metadata-connections-users,
    /// Information about the videos related to this category.
    videos: category-metadata-connections-videos
  }

  /// Information about the channels related to this category.
  record category-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups related to this category.
  record category-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users related to this category.
  record category-metadata-connections-users {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos related to this category.
  record category-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// The permissible actions related to the category.
  record category-metadata-interactions {
    /// An action indicating if the authenticated user has followed this category.
    follow: category-metadata-interactions-follow
  }

  /// An action indicating if the authenticated user has followed this category.
  record category-metadata-interactions-follow {
    /// Whether the authenticated user has followed this category.
    added: bool,
    /// The time in ISO 8601 format that the user followed this category, or the null value if the user hasn't followed this category.
    added-time: string,
    /// The URI for following or unfollowing this category: PUT to this URI to follow the category, or DELETE to this URI to unfollow the category.
    uri: string
  }

  /// The container of this category's parent category, if the current category is a subcategory.
  record category-parent {
    /// The URL to access the parent category in a browser.
    link: string,
    /// The display name that identifies the parent category.
    name: string,
    /// The unique identifier to access the parent of this category resource.
    uri: string
  }

  record category-subcategories-item {
    /// The URL to access the subcategory in a browser.
    link: string,
    /// The display name that identifies the subcategory.
    name: string,
    /// The unique identifier to access the subcategory resource.
    uri: string
  }

  /// The context of the video's subscription, if this video is part of a subscription.
  record video-context {
    /// The contextual action:
    /// 
    action: video-context-action-enum,
    /// The contextual resource: a user, group, or channel representation, or an object of a tag.
    resource-op: list<video-context-resource-op-entry>,
    /// The contextual resource type.
    resource-type: string
  }

  /// one entry of a string-keyed map (free-form object)
  record video-context-resource-op-entry {
    key: string,
    value: string
  }

  record embed-settings {
    /// A collection of information about the buttons that appear on the interface of the embeddable player.
    buttons: embed-settings-buttons,
    /// The primary player color, which controls the color of the progress bar, buttons, and more.
    color: string,
    /// A collection of information about the logo in the corner of the embeddable player.
    logos: embed-settings-logos,
    /// Whether the playbar appears in the embeddable player for this video.
    playbar: bool,
    /// Whether the speed controls appear in the embeddable player for this video.
    speed: bool,
    /// A collection of information relating to the embeddable player's title bar.
    title: embed-settings-title,
    /// The URI of the embed preset.
    uri: option<string>,
    /// Whether the volume controls appear in the embeddable player for this video.
    volume: bool
  }

  /// A collection of information about the buttons that appear on the interface of the embeddable player.
  record embed-settings-buttons {
    /// Whether the Embed button appears in the embeddable player for this video.
    embed: bool,
    /// Whether the Fullscreen button appears in the embeddable player for this video.
    fullscreen: bool,
    /// Whether the HD button appears in the embeddable player for this video.
    hd: bool,
    /// Whether the Like button appears in the embeddable player for this video.
    like: bool,
    /// Whether the Scaling button appears in the embeddable player for this video.
    scaling: bool,
    /// Whether the Share button appears in the embeddable player for this video.
    share: bool,
    /// Whether the Watch Later button appears in the embeddable player for this video.
    watchlater: bool
  }

  /// A collection of information about the logo in the corner of the embeddable player.
  record embed-settings-logos {
    /// A collection of information relating to custom logos in the embeddable player.
    custom: embed-settings-logos-custom,
    /// Whether the Vimeo logo appears in the embeddable player for this video.
    vimeo: bool
  }

  /// A collection of information relating to custom logos in the embeddable player.
  record embed-settings-logos-custom {
    /// Whether the custom logo appears in the embeddable player.
    active: bool,
    /// The URL that loads upon clicking the custom logo.
    link: string,
    /// Whether the custom logo appears even when the player interface is hidden.
    sticky: bool
  }

  /// A collection of information relating to the embeddable player's title bar.
  record embed-settings-title {
    /// How the embeddable player handles the video title:
    /// 
    name: embed-settings-title-name-enum,
    /// How the embeddable player handles the video owner's information:
    /// 
    owner: embed-settings-title-name-enum,
    /// How the embeddable player handles the video owner's portrait:
    /// 
    portrait: embed-settings-title-name-enum
  }

  /// The video's metadata.
  record video-metadata {
    /// A list of resource URIs related to the video.
    connections: video-metadata-connections,
    /// A list of resource URIs related to the video.
    interactions: video-metadata-interactions
  }

  /// A list of resource URIs related to the video.
  record video-metadata-connections {
    /// Information about the comments on this video.
    comments: video-metadata-connections-comments,
    /// Information about the users credited in this video.
    credits: video-metadata-connections-credits,
    /// Information about the users who have liked this video.
    likes: video-metadata-connections-likes,
    /// Information about this video's ondemand data.
    ondemand: video-metadata-connections-ondemand,
    /// Information about this video's thumbnails.
    pictures: video-metadata-connections-pictures,
    /// The DRM playback status connection for this video.
    playback: video-metadata-connections-playback,
    /// The recommendations for this video.
    recommendations: video-metadata-connections-recommendations,
    /// Related content for this video.
    related: video-metadata-connections-related,
    /// Information about the video's season.
    season: video-metadata-connections-season,
    /// Information about this video's text tracks.
    texttracks: video-metadata-connections-texttracks,
    /// Information about this video's VOD trailer.
    trailer: video-metadata-connections-trailer,
    /// Information about the user privacy of this video, if the video privacy is `users`.
    users-with-access: video-metadata-connections-users-with-access,
    /// Information about the versions of this video.
    versions: video-metadata-connections-versions
  }

  /// Information about the comments on this video.
  record video-metadata-connections-comments {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of comments on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users credited in this video.
  record video-metadata-connections-credits {
    /// An array of HTTP methods permitted on this URI.
    options: option<list<string>>,
    /// The total number of users on this connection.
    total: option<f64>,
    /// The API URI that resolves to the connection data.
    uri: option<string>
  }

  /// Information about the users who have liked this video.
  record video-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this video's ondemand data.
  record video-metadata-connections-ondemand {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The On Demand connection resource key.
    resource-key: string,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this video's thumbnails.
  record video-metadata-connections-pictures {
    /// An array of HTTP methods allowed on this URI.
    options: list<string>,
    /// Total number of thumbnails on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// The DRM playback status connection for this video.
  record video-metadata-connections-playback {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// The recommendations for this video.
  record video-metadata-connections-recommendations {
    /// An array of HTTP methods allowed on this URI.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data.
    uri: option<string>
  }

  /// Related content for this video.
  record video-metadata-connections-related {
    /// An array of HTTP methods allowed on this URI.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data.
    uri: option<string>
  }

  /// Information about the video's season.
  record video-metadata-connections-season {
    /// The name of this season.
    name: string,
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this video's text tracks.
  record video-metadata-connections-texttracks {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of text tracks on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this video's VOD trailer.
  record video-metadata-connections-trailer {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The trailer connection resource key.
    resource-key: string,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user privacy of this video, if the video privacy is `users`.
  record video-metadata-connections-users-with-access {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the versions of this video.
  record video-metadata-connections-versions {
    /// The URI of the current version of the video.
    current-uri: option<string>,
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of versions on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A list of resource URIs related to the video.
  record video-metadata-interactions {
    /// The Buy interaction for a On Demand video.
