    /// The way to sort the results.
    sort: option<get-followers-alt1-sort-enum>
  }
  get-followers: func(params: get-followers-params) -> result<string, string>;

  /// Get all the users that a user is following
  record get-user-following-params {
    /// The ID of the user.
    user-id: string,
    /// The sort direction of the results.
    direction: option<get-followers-alt1-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-user-following-alt1-filter-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-followers-alt1-sort-enum>
  }
  get-user-following: func(params: get-user-following-params) -> result<string, string>;

  /// Follow a list of users
  record follow-users-params {
    /// The ID of the user.
    user-id: string,
    /// An array of user URIs for the list of users to follow.
    users: list<string>
  }
  follow-users: func(params: follow-users-params) -> result<string, string>;

  /// Check if a user is following another user
  record check-if-user-is-following-params {
    /// The ID of the following user.
    follow-user-id: string,
    /// The ID of the user.
    user-id: string
  }
  check-if-user-is-following: func(params: check-if-user-is-following-params) -> result<string, string>;

  /// Follow a specific user
  record follow-user-params {
    /// The ID of the following user.
    follow-user-id: string,
    /// The ID of the user.
    user-id: string
  }
  follow-user: func(params: follow-user-params) -> result<string, string>;

  /// Unfollow a user
  record unfollow-user-params {
    /// The ID of the following user.
    follow-user-id: string,
    /// The ID of the user.
    user-id: string
  }
  unfollow-user: func(params: unfollow-user-params) -> result<string, string>;

}

interface groups-subscription {
