  record tag-metadata-connections {
    /// Information about the videos related to this tag.
    videos: tag-metadata-connections-videos
  }

  /// Information about the videos related to this tag.
  record tag-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// The transcode information for a video upload.
  record video-transcode {
    /// Status code for this video's availability.
    status: option<video-transcode-status-enum>
  }

  /// The upload information for this video.
  record video-upload {
    /// The approach for uploading the video.
    approach: option<video-upload-approach-enum>,
    /// The URI for completing the upload.
    complete-uri: option<string>,
    /// The HTML form for uploading a video through the post approach.
    form: option<string>,
    /// The link of the video to capture through the pull approach.
    link: option<string>,
    /// The redirect URL for the upload app.
    redirect-url: option<string>,
    /// The file size in bytes of the uploaded video.
    size: option<f64>,
    /// The status code for the availability of the uploaded video:
    /// 
    status: video-transcode-status-enum,
    /// The link for sending video file data.
    upload-link: option<string>
  }

  record on-demand-genre {
    /// The canonical name or URL slug of the genre.
    canonical: string,
    interactions: on-demand-genre-interactions,
    /// The Vimeo URL for this genre.
    link: string,
    metadata: on-demand-genre-metadata,
    /// The descriptive name of the genre.
    name: string,
    /// The relative URI of the On Demand genre.
    uri: string
  }

  record on-demand-genre-interactions {
    /// Interactions for On Demand pages that are in this genre.
    page: on-demand-genre-interactions-page
  }

  /// Interactions for On Demand pages that are in this genre.
  record on-demand-genre-interactions-page {
    /// Whether this On Demand genre was added.
    added: bool,
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to access the On Demand page.
    uri: string
  }

  record on-demand-genre-metadata {
    /// A collection of information connected to this resource.
    connections: on-demand-genre-metadata-connections
  }

  /// A collection of information connected to this resource.
  record on-demand-genre-metadata-connections {
    /// Information about the On Demand pages related to this group.
    pages: on-demand-genre-metadata-connections-pages
  }

  /// Information about the On Demand pages related to this group.
  record on-demand-genre-metadata-connections-pages {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Metadata about the On Demand page.
  record on-demand-page-metadata {
    /// A collection of information that is connected to this resource, including videos, genres, and pictures connections.
    connections: on-demand-page-metadata-connections,
    /// The user's available purchase interactions.
    interactions: purchase-interaction
  }

  /// A collection of information that is connected to this resource, including videos, genres, and pictures connections.
  record on-demand-page-metadata-connections {
    metadata: on-demand-page-metadata-connections-metadata
  }

  record on-demand-page-metadata-connections-metadata {
    connections: on-demand-page-metadata-connections-metadata-connections
  }

  record on-demand-page-metadata-connections-metadata-connections {
    /// Information about the comments associated with this page.
    comments: on-demand-page-metadata-connections-metadata-connections-comments,
    /// Information about the genres associated with this page.
    genres: on-demand-page-metadata-connections-metadata-connections-genres,
    /// Information about the likes associated with this page.
    likes: on-demand-page-metadata-connections-metadata-connections-likes,
    /// Information about the pictures associated with this page.
    pictures: on-demand-page-metadata-connections-metadata-connections-pictures,
    /// Information about the seasons associated with this page.
    seasons: on-demand-page-metadata-connections-metadata-connections-seasons,
    /// Information about the videos associated with this page.
    videos: on-demand-page-metadata-connections-metadata-connections-videos
  }

  /// Information about the comments associated with this page.
  record on-demand-page-metadata-connections-metadata-connections-comments {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of comments on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the genres associated with this page.
  record on-demand-page-metadata-connections-metadata-connections-genres {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of genres on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the likes associated with this page.
  record on-demand-page-metadata-connections-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the pictures associated with this page.
  record on-demand-page-metadata-connections-metadata-connections-pictures {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of pictures on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the seasons associated with this page.
  record on-demand-page-metadata-connections-metadata-connections-seasons {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of seasons on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos associated with this page.
  record on-demand-page-metadata-connections-metadata-connections-videos {
    /// The total number of extra videos.
    extra-total: f64,
    /// The total number of main videos.
    main-total: f64,
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string,
    /// The total number of viewable videos.
    viewable-total: f64
  }

  record purchase-interaction {
    /// Information on purchasing this video.
    buy: option<purchase-interaction-buy>,
    /// Information on renting this video.
    rent: option<list<purchase-interaction-rent-entry>>,
    /// Information on subscribing to this video.
    subscribe: option<purchase-interaction-subscribe>
  }

  /// Information on purchasing this video.
  record purchase-interaction-buy {
    /// Whether the On Demand video for purchase has DRM.
    drm: option<bool>
  }

  /// one entry of a string-keyed map (free-form object)
  record purchase-interaction-rent-entry {
    key: string,
    value: string
  }

  /// Information on subscribing to this video.
  record purchase-interaction-subscribe {
    /// Whether the On Demand subscription has DRM.
    drm: option<bool>,
    /// The time in ISO 8601 format when the On Demand video will expire.
    expires-time: option<string>,
    /// The URL to purchase this On Demand subscription on Vimeo.
    link: option<string>,
    /// The time in ISO 8601 format when the On Demand was purchased.
    purchase-time: option<string>,
    /// The user's streaming access to this On Demand subscription:
    /// 
    stream-op: option<video-metadata-interactions-buy-download-enum>,
    /// The On Demand subscription's product URI.
    uri: option<string>
  }

  record on-demand-page-preorder {
    /// Whether this page is available for preorder.
    active: bool,
    /// The time in ISO 8601 format when the preorder was cancelled.
    cancel-time: string,
    /// The time in ISO 8601 format when the preorder was released to the public.
    publish-time: string,
    /// The time in ISO 8601 format when the preorder started.
    time: string
  }

  record on-demand-page-published {
    /// Whether this On Demand page has been published.
    enabled: bool,
    /// The time in IS 8601 format when this page was published.
    time: string
  }

  /// Information about subscribing to this On Demand page, if enabled.
  record on-demand-page-subscription {
    /// Whether this product is active.
    active: bool,
    /// The link to this product on Vimeo.
    link: string,
    /// The product's rental period.
    period: option<string>,
    /// The accepted currencies and respective pricing for this product.
    price: list<on-demand-page-subscription-price-entry>
  }

  /// one entry of a string-keyed map (free-form object)
  record on-demand-page-subscription-price-entry {
    key: string,
    value: string
  }

  variant get-vod-purchases-error {
    forbidden(string),
    other(string)
  }

  variant check-if-vod-was-purchased-alt1-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant check-if-vod-was-purchased-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the On Demand purchases and rentals that a user has made
  record get-vod-purchases-params {
    /// The sort direction of the results.
    direction: option<get-vod-purchases-direction-enum>,
    /// The type of On Demand videos to show.
    /// 
    filter: option<get-vod-purchases-filter-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The way to sort the results.
    sort: option<get-vod-purchases-sort-enum>
  }
  get-vod-purchases: func(params: get-vod-purchases-params) -> result<list<on-demand-page>, get-vod-purchases-error>;

  /// Check if a user has made a purchase or rental from an On Demand page
  record check-if-vod-was-purchased-alt1-params {
    /// The ID of the On Demand.
    ondemand-id: string
  }
  check-if-vod-was-purchased-alt1: func(params: check-if-vod-was-purchased-alt1-params) -> result<on-demand-page, check-if-vod-was-purchased-alt1-error>;

  /// Check if a user has made a purchase or rental from an On Demand page
  record check-if-vod-was-purchased-params {
    /// The ID of the user.
    user-id: string
  }
  check-if-vod-was-purchased: func(params: check-if-vod-was-purchased-params) -> result<on-demand-page, check-if-vod-was-purchased-error>;

}

interface users-pictures {
  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  /// Get all the pictures that belong to a user
  record get-pictures-alt1-params {
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-pictures-alt1: func(params: get-pictures-alt1-params) -> result<list<picture>, string>;

  /// Add a user picture
  create-picture-alt1: func() -> result<picture, string>;

  /// Get a specific user picture
  record get-picture-alt1-params {
    /// The ID of the picture.
    portraitset-id: string
  }
  get-picture-alt1: func(params: get-picture-alt1-params) -> result<picture, string>;

  /// Edit a user picture
  record edit-picture-alt1-params {
    /// The ID of the picture.
    portraitset-id: string,
    /// Whether the picture is the user's active portrait.
    active: option<bool>
  }
  edit-picture-alt1: func(params: edit-picture-alt1-params) -> result<picture, string>;

  /// Delete a user picture
  record delete-picture-alt1-params {
    /// The ID of the picture.
    portraitset-id: string
  }
  delete-picture-alt1: func(params: delete-picture-alt1-params) -> result<string, string>;

  /// Get all the pictures that belong to a user
  record get-pictures-params {
    /// The ID of the user.
    user-id: string,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-pictures: func(params: get-pictures-params) -> result<list<picture>, string>;

  /// Add a user picture
  record create-picture-params {
    /// The ID of the user.
    user-id: string
  }
  create-picture: func(params: create-picture-params) -> result<picture, string>;

  /// Get a specific user picture
  record get-picture-params {
    /// The ID of the picture.
    portraitset-id: string,
    /// The ID of the user.
    user-id: string
  }
  get-picture: func(params: get-picture-params) -> result<picture, string>;

  /// Edit a user picture
  record edit-picture-params {
    /// The ID of the picture.
    portraitset-id: string,
    /// The ID of the user.
    user-id: string,
    /// Whether the picture is the user's active portrait.
    active: option<bool>
  }
  edit-picture: func(params: edit-picture-params) -> result<picture, string>;

  /// Delete a user picture
  record delete-picture-params {
    /// The ID of the picture.
    portraitset-id: string,
    /// The ID of the user.
    user-id: string
  }
  delete-picture: func(params: delete-picture-params) -> result<string, string>;

}

interface portfolios-essentials {
  enum get-portfolios-alt1-direction-enum {
    asc,
    desc,
  }

  enum get-portfolios-alt1-sort-enum {
    alphabetical,
    date,
  }

  enum portfolio-sort-enum {
    alphabetical,
    clips,
    modified,
    recent,
  }

  record portfolio {
    /// The time in ISO 8601 format when the portfolio was created.
    created-time: string,
    /// The portfolio's description.
    description: string,
    /// The link to the portfolio.
    link: string,
    /// Metadata about the album.
    metadata: portfolio-metadata,
    /// The time in ISO 8601 format when the portfolio's data was last modified.
    modified-time: string,
