    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  variant get-vod-backgrounds-error {
    not-found(string),
    other(string)
  }

  variant create-vod-background-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-vod-background-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant edit-vod-background-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-vod-background-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the backgrounds of an On Demand page
