interface categories-videos {
  enum get-category-videos-direction-enum {
    asc,
    desc,
  }

  enum get-category-videos-filter-enum {
    conditional-featured,
    embeddable,
  }

  enum get-category-videos-sort-enum {
    alphabetical,
    comments,
    date,
    duration,
    featured,
    likes,
    plays,
    relevant,
  }

  /// Get all the videos in a category
  record get-category-videos-params {
    /// The name of the category.
    category: string,
    /// The sort direction of the results.
    direction: option<get-category-videos-direction-enum>,
    /// The attribute by which to filter the results.
    /// 
    filter: option<get-category-videos-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-category-videos-sort-enum>
  }
  get-category-videos: func(params: get-category-videos-params) -> result<string, string>;

  /// Check for a video in a category
  record check-category-for-video-params {
    /// The name of the category.
    category: string,
    /// The ID of the video.
    video-id: string
  }
  check-category-for-video: func(params: check-category-for-video-params) -> result<string, string>;

  /// Get all the categories to which a video belongs
  record get-video-categories-params {
    /// The ID of the video.
    video-id: string
  }
  get-video-categories: func(params: get-video-categories-params) -> result<string, string>;

  /// Suggest categories for a video
  record suggest-video-category-params {
    /// The ID of the video.
    video-id: string
  }
  suggest-video-category: func(params: suggest-video-category-params) -> result<string, string>;

}

interface channels-essentials {
  enum get-channels-direction-enum {
    asc,
    desc,
  }

  enum get-channels-filter-enum {
    featured,
  }

  enum get-channels-sort-enum {
    alphabetical,
    date,
    followers,
    relevant,
    videos,
  }

  enum get-channel-subscriptions-alt1-filter-enum {
    moderated,
  }

  enum get-channel-subscriptions-alt1-sort-enum {
    alphabetical,
    date,
    followers,
    videos,
  }

  /// Get all channels
