    /// The sort direction of the results.
    direction: option<get-channels-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-channels-filter-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    /// 
    sort: option<get-channels-sort-enum>
  }
  get-channels: func(params: get-channels-params) -> result<string, string>;

  /// Create a channel
  create-channel: func() -> result<string, string>;

  /// Get a specific channel
  record get-channel-params {
    /// The ID of the channel.
    channel-id: string
  }
  get-channel: func(params: get-channel-params) -> result<string, string>;

  /// Edit a channel
  record edit-channel-params {
    /// The ID of the channel.
    channel-id: string
  }
  edit-channel: func(params: edit-channel-params) -> result<string, string>;

  /// Delete a channel
  record delete-channel-params {
    /// The ID of the channel.
    channel-id: string
  }
  delete-channel: func(params: delete-channel-params) -> result<string, string>;

  /// Get all the channels to which a user subscribes
  record get-channel-subscriptions-alt1-params {
    /// The sort direction of the results.
    direction: option<get-channels-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-channel-subscriptions-alt1-filter-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-channel-subscriptions-alt1-sort-enum>
  }
  get-channel-subscriptions-alt1: func(params: get-channel-subscriptions-alt1-params) -> result<string, string>;

  /// Get all the channels to which a user subscribes
  record get-channel-subscriptions-params {
    /// The ID of the user.
    user-id: string,
    /// The sort direction of the results.
    direction: option<get-channels-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-channel-subscriptions-alt1-filter-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-channel-subscriptions-alt1-sort-enum>
  }
  get-channel-subscriptions: func(params: get-channel-subscriptions-params) -> result<string, string>;

}

interface channels-categories {
