  /// Get all the videos in which a user appears
  record get-appearances-alt1-params {
    /// The sort direction of the results.
    direction: option<get-appearances-alt1-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-appearances-alt1-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-appearances-alt1-sort-enum>
  }
  get-appearances-alt1: func(params: get-appearances-alt1-params) -> result<list<video>, string>;

  /// Get all the videos that a user has uploaded
  record get-videos-alt1-params {
    /// The page that contains the video URI. Only available when not paired with `query`.
    containing-uri: option<string>,
    /// The sort direction of the results.
    direction: option<get-appearances-alt1-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-videos-alt1-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// Whether to filter by all playable videos or by all videos that are not  playable.
    filter-playable: option<bool>,
    /// The page number of the results to show.
