    channel-id: string,
    /// The description of the channel.
    description: option<string>,
    /// The link to access the channel. You can use a custom name in the URL in place of a numeric channel ID, as in `/channels/{url_custom}`. Submitting `""` for this field removes the link alias.
    link: option<string>,
    /// The name of the channel.
    name: option<string>,
    /// The privacy level of the channel.
    privacy: option<channel-privacy-view-enum>
  }
  edit-channel: func(params: edit-channel-params) -> result<channel, edit-channel-error>;

  /// Delete a channel
  record delete-channel-params {
    /// The ID of the channel.
    channel-id: string
  }
  delete-channel: func(params: delete-channel-params) -> result<string, delete-channel-error>;

  /// Get all the channels to which a user subscribes
  record get-channel-subscriptions-alt1-params {
    /// The sort direction of the results.
    direction: option<get-channels-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-channel-subscriptions-alt1-filter-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-channel-subscriptions-alt1-sort-enum>
  }
  get-channel-subscriptions-alt1: func(params: get-channel-subscriptions-alt1-params) -> result<list<channel>, get-channel-subscriptions-alt1-error>;

  /// Get all the channels to which a user subscribes
  record get-channel-subscriptions-params {
    /// The ID of the user.
    user-id: string,
    /// The sort direction of the results.
    direction: option<get-channels-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-channel-subscriptions-alt1-filter-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-channel-subscriptions-alt1-sort-enum>
  }
  get-channel-subscriptions: func(params: get-channel-subscriptions-params) -> result<list<channel>, get-channel-subscriptions-error>;

}

interface channels-categories {
  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  record category {
    /// The active icon for the category.
    icon: option<picture>,
    /// The last time, in ISO 8601 format, that a video was featured.
    last-video-featured-time: string,
    /// The URL to access the category in a browser.
    link: string,
    /// Metadata about the category.
    metadata: category-metadata,
    /// The display name that identifies the category.
    name: string,
    /// The container of this category's parent category, if the current category is a subcategory.
    parent: category-parent,
    /// The active picture for this category; defaults to vertical color bars.
    pictures: picture,
    /// The resource key of the category.
    resource-key: string,
    /// All the subcategories that belong to this category, if the current category is a top-level parent.
    subcategories: option<list<category-subcategories-item>>,
    /// Whether the category isn't a subcategory of another category.
    top-level: bool,
    /// The unique identifier to access the category resource.
    uri: string
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  /// Metadata about the category.
  record category-metadata {
    /// A collection of information that is connected to this resource.
    connections: category-metadata-connections,
    /// The permissible actions related to the category.
    interactions: category-metadata-interactions
  }

  /// A collection of information that is connected to this resource.
  record category-metadata-connections {
    /// Information about the channels related to this category.
    channels: category-metadata-connections-channels,
    /// Information about the groups related to this category.
    groups: category-metadata-connections-groups,
    /// Information about the users related to this category.
    users: category-metadata-connections-users,
    /// Information about the videos related to this category.
    videos: category-metadata-connections-videos
  }

  /// Information about the channels related to this category.
  record category-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups related to this category.
  record category-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users related to this category.
  record category-metadata-connections-users {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos related to this category.
  record category-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// The permissible actions related to the category.
  record category-metadata-interactions {
    /// An action indicating if the authenticated user has followed this category.
    follow: category-metadata-interactions-follow
  }

  /// An action indicating if the authenticated user has followed this category.
  record category-metadata-interactions-follow {
    /// Whether the authenticated user has followed this category.
    added: bool,
    /// The time in ISO 8601 format that the user followed this category, or the null value if the user hasn't followed this category.
    added-time: string,
    /// The URI for following or unfollowing this category: PUT to this URI to follow the category, or DELETE to this URI to unfollow the category.
    uri: string
  }

  /// The container of this category's parent category, if the current category is a subcategory.
  record category-parent {
    /// The URL to access the parent category in a browser.
    link: string,
    /// The display name that identifies the parent category.
    name: string,
    /// The unique identifier to access the parent of this category resource.
    uri: string
  }

  record category-subcategories-item {
    /// The URL to access the subcategory in a browser.
    link: string,
    /// The display name that identifies the subcategory.
    name: string,
    /// The unique identifier to access the subcategory resource.
    uri: string
  }

  variant get-channel-categories-error {
    not-found(string),
    other(string)
  }

  variant add-channel-categories-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant categorize-channel-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-channel-category-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the categories in a channel
  record get-channel-categories-params {
    /// The ID of the channel.
    channel-id: string
  }
  get-channel-categories: func(params: get-channel-categories-params) -> result<list<category>, get-channel-categories-error>;

  /// Add a list of categories to a channel
  record add-channel-categories-params {
    /// The ID of the channel.
    channel-id: string,
    /// The array of category URIs to add.
    channels: list<string>
  }
  add-channel-categories: func(params: add-channel-categories-params) -> result<string, add-channel-categories-error>;

  /// Categorize a channel
  record categorize-channel-params {
    /// The name of the category.
    category: string,
    /// The ID of the channel.
    channel-id: string
  }
  categorize-channel: func(params: categorize-channel-params) -> result<string, categorize-channel-error>;

  /// Remove a category from a channel
  record delete-channel-category-params {
    /// The name of the category.
    category: string,
    /// The ID of the channel.
    channel-id: string
  }
  delete-channel-category: func(params: delete-channel-category-params) -> result<string, delete-channel-category-error>;

}

interface channels-moderators {
  enum get-channel-moderators-direction-enum {
    asc,
    desc,
  }

  enum get-channel-moderators-sort-enum {
    alphabetical,
    date,
  }

  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum user-preferences-videos-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum user-preferences-videos-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum user-preferences-videos-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  record user {
    /// The user's account type:
    /// 
    account: user-account-enum,
    /// The user's bio.
    bio: string,
    /// The user's content filters:
    /// 
    content-filter: option<string>,
    /// The time in ISO 8601 format when the user account was created.
    created-time: string,
    /// The user's email address. This data requires a bearer token with the `email` scope.
    email: option<string>,
    /// The absolute URL of this user's profile page.
    link: string,
    /// The user's location.
    location: string,
    /// The user's metadata.
    metadata: user-metadata,
    /// The user's display name.
    name: string,
    /// The active portrait of this user.
    pictures: picture,
    preferences: option<user-preferences>,
    /// The user's resource key string.
    resource-key: string,
    /// Appears only when the user has upload access and is looking at their own user record.
    upload-quota: user-upload-quota,
    /// The user's canonical relative URI.
    uri: string,
    /// The user's websites.
    websites: list<user-websites-item>
  }

  /// The user's metadata.
  record user-metadata {
    /// The list of resource URIs related to the user.
    connections: user-metadata-connections,
    interactions: user-metadata-interactions
  }

  /// The list of resource URIs related to the user.
  record user-metadata-connections {
    /// Information about the albums created by this user.
    albums: user-metadata-connections-albums,
    /// Information about the appearances of this user in other videos.
    appearances: user-metadata-connections-appearances,
    /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
    block: user-metadata-connections-block,
    /// Information about this user's followed categories.
    categories: user-metadata-connections-categories,
    /// Information about this user's subscribed channels.
    channels: user-metadata-connections-channels,
    /// Information about this user's feed.
    feed: user-metadata-connections-feed,
    /// Information about this user's folders.
    folders: user-metadata-connections-folders,
    /// Information about the user's followers.
    followers: user-metadata-connections-followers,
    /// Information about the users that the current user is following.
    following: user-metadata-connections-following,
    /// Information about the groups created by this user.
    groups: user-metadata-connections-groups,
    /// Information about the videos that this user has liked.
    likes: user-metadata-connections-likes,
    /// Information about the channels that this user moderates.
    moderated-channels: user-metadata-connections-moderated-channels,
    /// Information about this user's portraits.
    pictures: user-metadata-connections-pictures,
    /// Information about this user's portfolios.
    portfolios: user-metadata-connections-portfolios,
    /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-channels: user-metadata-connections-recommended-channels,
    /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-users: user-metadata-connections-recommended-users,
    /// Information about the videos that have been shared with this user.
    shared: user-metadata-connections-shared,
    /// Information about the videos uploaded by this user.
    videos: user-metadata-connections-videos,
    /// Information about the videos that this user has watched.
    watched-videos: user-metadata-connections-watched-videos,
    /// Information about the videos that this user wants to watch later.
    watchlater: user-metadata-connections-watchlater
  }

  /// Information about the albums created by this user.
  record user-metadata-connections-albums {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of albums on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the appearances of this user in other videos.
  record user-metadata-connections-appearances {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of appearances on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-block {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of blocked users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about this user's followed categories.
  record user-metadata-connections-categories {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of categories on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's subscribed channels.
  record user-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's feed.
  record user-metadata-connections-feed {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's folders.
  record user-metadata-connections-folders {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of folders on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user's followers.
  record user-metadata-connections-followers {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of followers on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users that the current user is following.
  record user-metadata-connections-following {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups created by this user.
  record user-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has liked.
  record user-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the channels that this user moderates.
  record user-metadata-connections-moderated-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portraits.
  record user-metadata-connections-pictures {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of pictures on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portfolios.
  record user-metadata-connections-portfolios {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of portfolios on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-channels {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of channels on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-users {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about the videos that have been shared with this user.
  record user-metadata-connections-shared {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos uploaded by this user.
  record user-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has watched.
  record user-metadata-connections-watched-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user wants to watch later.
  record user-metadata-connections-watchlater {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-metadata-interactions {
    add-privacy-user: option<user-metadata-interactions-add-privacy-user>,
    /// Information related to the block status of this user.
    block: user-metadata-interactions-block,
    /// Information related to the followed status of this user.
    follow: user-metadata-interactions-follow,
    /// Information regarding where and how to report a user.
    report: user-metadata-interactions-report
  }

  record user-metadata-interactions-add-privacy-user {
    /// An array of the HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: option<string>
  }

  /// Information related to the block status of this user.
  record user-metadata-interactions-block {
    /// Whether a user is blocking the current user.
    added: bool,
    /// The time in ISO 8601 format when the block occurred, or the null value if no block exists.
    added-time: string,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to block or unblock the user.
    uri: string
  }

  /// Information related to the followed status of this user.
  record user-metadata-interactions-follow {
    /// Whether a user is following the current user.
    added: bool,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to follow the user.
    uri: string
  }

  /// Information regarding where and how to report a user.
  record user-metadata-interactions-report {
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// List of valid reasons for reporting a video.
    reason: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  record user-preferences {
    videos: option<user-preferences-videos>
  }

  record user-preferences-videos {
    privacy: option<user-preferences-videos-privacy>
  }

  record user-preferences-videos-privacy {
    /// Whether other users can add the user's videos.
    add: option<bool>,
    /// The user's privacy preference for comments:
    /// 
    comments: option<user-preferences-videos-privacy-comments-enum>,
    /// Whether other users can download the user's videos.
    download: option<bool>,
    /// The user's privacy preference for embeds:
    /// 
    embed: option<user-preferences-videos-privacy-embed-enum>,
    /// The user's privacy preference for views:
    /// 
    view: option<user-preferences-videos-privacy-view-enum>
  }

  /// Appears only when the user has upload access and is looking at their own user record.
  record user-upload-quota {
    /// Information about the user's lifetime upload usage.
    lifetime: user-upload-quota-lifetime,
    /// Information about the user's usage for the current period.
    periodic: user-upload-quota-periodic,
    /// Information about the user's upload space remaining for the current period.
    space: user-upload-quota-space
  }

  /// Information about the user's lifetime upload usage.
  record user-upload-quota-lifetime {
    /// The number of bytes remaining in your lifetime maximum.
    free: f64,
    /// The total number of bytes that you can upload across the lifetime of your account.
    max: f64,
    /// The number of bytes that you've already uploaded against your lifetime limit.
    used: f64
  }

  /// Information about the user's usage for the current period.
  record user-upload-quota-periodic {
    /// The number of bytes remaining in your upload quota for the current period.
    free: f64,
    /// The total number of bytes that you can upload per period.
    max: f64,
    /// The time in ISO 8601 format when your upload quota resets.
    reset-date: string,
    /// The number of bytes that you've already uploaded against your quota in the current period.
    used: f64
  }

  /// Information about the user's upload space remaining for the current period.
  record user-upload-quota-space {
    /// The number of bytes remaining in your upload quota.
    free: f64,
    /// The maximum number of bytes allotted to your upload quota.
    max: f64,
    /// Whether the values of the upload_quota.space fields are for the lifetime quota or the periodic quota.
    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  variant add-channel-moderators-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant replace-channel-moderators-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-channel-moderators-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-channel-moderator-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-channel-moderator-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the moderators in a channel
  record get-channel-moderators-params {
    /// The ID of the channel.
    channel-id: string,
    /// The sort direction of the results.
    direction: option<get-channel-moderators-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-channel-moderators-sort-enum>
  }
  get-channel-moderators: func(params: get-channel-moderators-params) -> result<list<user>, string>;

  /// Add a list of channel moderators
  record add-channel-moderators-params {
    /// The ID of the channel.
    channel-id: string,
    /// The URI of a user to add as a moderator.
    user-uri: string
  }
  add-channel-moderators: func(params: add-channel-moderators-params) -> result<string, add-channel-moderators-error>;

  /// Replace the moderators of a channel
  record replace-channel-moderators-params {
    /// The ID of the channel.
    channel-id: string,
    /// The URI of the user to add as a moderator.
    user-uri: string
  }
  replace-channel-moderators: func(params: replace-channel-moderators-params) -> result<list<user>, replace-channel-moderators-error>;

  /// Remove a list of channel moderators
  record remove-channel-moderators-params {
    /// The ID of the channel.
    channel-id: string,
    /// The URI of a user to remove as a moderator.
    user-uri: string
  }
  remove-channel-moderators: func(params: remove-channel-moderators-params) -> result<user, remove-channel-moderators-error>;

  /// Get a specific channel moderator
  record get-channel-moderator-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the user.
    user-id: string
  }
  get-channel-moderator: func(params: get-channel-moderator-params) -> result<user, string>;

  /// Add a specific channel moderator
  record add-channel-moderator-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the user.
    user-id: string
  }
  add-channel-moderator: func(params: add-channel-moderator-params) -> result<string, add-channel-moderator-error>;

  /// Remove a specific channel moderator
  record remove-channel-moderator-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the user.
    user-id: string
  }
  remove-channel-moderator: func(params: remove-channel-moderator-params) -> result<string, remove-channel-moderator-error>;

}

interface channels-private-channel-members {
  enum get-channel-privacy-users-direction-enum {
    asc,
    desc,
  }

  enum user-account-enum {
    basic,
    business,
    live-business,
    live-premium,
    live-pro,
    plus,
    pro,
    pro-unlimited,
    producer,
  }

  enum picture-type-op-enum {
    caution,
    custom,
    default,
  }

  enum user-preferences-videos-privacy-comments-enum {
    anybody,
    contacts,
    nobody,
  }

  enum user-preferences-videos-privacy-embed-enum {
    private,
    public,
    whitelist,
  }

  enum user-preferences-videos-privacy-view-enum {
    anybody,
    contacts,
    disable,
    nobody,
    password,
    unlisted,
    users,
  }

  enum user-upload-quota-space-showing-enum {
    lifetime,
    periodic,
  }

  record user {
    /// The user's account type:
    /// 
    account: user-account-enum,
    /// The user's bio.
    bio: string,
    /// The user's content filters:
    /// 
    content-filter: option<string>,
    /// The time in ISO 8601 format when the user account was created.
    created-time: string,
    /// The user's email address. This data requires a bearer token with the `email` scope.
    email: option<string>,
    /// The absolute URL of this user's profile page.
    link: string,
    /// The user's location.
    location: string,
    /// The user's metadata.
    metadata: user-metadata,
    /// The user's display name.
    name: string,
    /// The active portrait of this user.
    pictures: picture,
    preferences: option<user-preferences>,
    /// The user's resource key string.
    resource-key: string,
    /// Appears only when the user has upload access and is looking at their own user record.
    upload-quota: user-upload-quota,
    /// The user's canonical relative URI.
    uri: string,
    /// The user's websites.
    websites: list<user-websites-item>
  }

  /// The user's metadata.
  record user-metadata {
    /// The list of resource URIs related to the user.
    connections: user-metadata-connections,
    interactions: user-metadata-interactions
  }

  /// The list of resource URIs related to the user.
  record user-metadata-connections {
    /// Information about the albums created by this user.
    albums: user-metadata-connections-albums,
    /// Information about the appearances of this user in other videos.
    appearances: user-metadata-connections-appearances,
    /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
    block: user-metadata-connections-block,
    /// Information about this user's followed categories.
    categories: user-metadata-connections-categories,
    /// Information about this user's subscribed channels.
    channels: user-metadata-connections-channels,
    /// Information about this user's feed.
    feed: user-metadata-connections-feed,
    /// Information about this user's folders.
    folders: user-metadata-connections-folders,
    /// Information about the user's followers.
    followers: user-metadata-connections-followers,
    /// Information about the users that the current user is following.
    following: user-metadata-connections-following,
    /// Information about the groups created by this user.
    groups: user-metadata-connections-groups,
    /// Information about the videos that this user has liked.
    likes: user-metadata-connections-likes,
    /// Information about the channels that this user moderates.
    moderated-channels: user-metadata-connections-moderated-channels,
    /// Information about this user's portraits.
    pictures: user-metadata-connections-pictures,
    /// Information about this user's portfolios.
    portfolios: user-metadata-connections-portfolios,
    /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-channels: user-metadata-connections-recommended-channels,
    /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
    recommended-users: user-metadata-connections-recommended-users,
    /// Information about the videos that have been shared with this user.
    shared: user-metadata-connections-shared,
    /// Information about the videos uploaded by this user.
    videos: user-metadata-connections-videos,
    /// Information about the videos that this user has watched.
    watched-videos: user-metadata-connections-watched-videos,
    /// Information about the videos that this user wants to watch later.
    watchlater: user-metadata-connections-watchlater
  }

  /// Information about the albums created by this user.
  record user-metadata-connections-albums {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of albums on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the appearances of this user in other videos.
  record user-metadata-connections-appearances {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of appearances on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information on the users that the current user has blocked. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-block {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of blocked users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about this user's followed categories.
  record user-metadata-connections-categories {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of categories on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's subscribed channels.
  record user-metadata-connections-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's feed.
  record user-metadata-connections-feed {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's folders.
  record user-metadata-connections-folders {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of folders on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the user's followers.
  record user-metadata-connections-followers {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of followers on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the users that the current user is following.
  record user-metadata-connections-following {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of users on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the groups created by this user.
  record user-metadata-connections-groups {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of groups on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has liked.
  record user-metadata-connections-likes {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of likes on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the channels that this user moderates.
  record user-metadata-connections-moderated-channels {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of channels on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portraits.
  record user-metadata-connections-pictures {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of pictures on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about this user's portfolios.
  record user-metadata-connections-portfolios {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of portfolios on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// A collection of recommended channels for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-channels {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of channels on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// A Collection of recommended users for the current user to follow. This data requires a bearer token with the `private` scope.
  record user-metadata-connections-recommended-users {
    /// An array of HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: list<string>,
    /// The total number of users on this connection. This data requires a bearer token with the `private` scope.
    total: f64,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: string
  }

  /// Information about the videos that have been shared with this user.
  record user-metadata-connections-shared {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos uploaded by this user.
  record user-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user has watched.
  record user-metadata-connections-watched-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  /// Information about the videos that this user wants to watch later.
  record user-metadata-connections-watchlater {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record user-metadata-interactions {
    add-privacy-user: option<user-metadata-interactions-add-privacy-user>,
    /// Information related to the block status of this user.
    block: user-metadata-interactions-block,
    /// Information related to the followed status of this user.
    follow: user-metadata-interactions-follow,
    /// Information regarding where and how to report a user.
    report: user-metadata-interactions-report
  }

  record user-metadata-interactions-add-privacy-user {
    /// An array of the HTTP methods permitted on this URI. This data requires a bearer token with the `private` scope.
    options: option<list<string>>,
    /// The API URI that resolves to the connection data. This data requires a bearer token with the `private` scope.
    uri: option<string>
  }

  /// Information related to the block status of this user.
  record user-metadata-interactions-block {
    /// Whether a user is blocking the current user.
    added: bool,
    /// The time in ISO 8601 format when the block occurred, or the null value if no block exists.
    added-time: string,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to block or unblock the user.
    uri: string
  }

  /// Information related to the followed status of this user.
  record user-metadata-interactions-follow {
    /// Whether a user is following the current user.
    added: bool,
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// The URI to follow the user.
    uri: string
  }

  /// Information regarding where and how to report a user.
  record user-metadata-interactions-report {
    /// An array of the HTTP methods permitted on this URI.
    options: list<string>,
    /// List of valid reasons for reporting a video.
    reason: list<string>,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  record picture {
    /// Whether this picture is the active picture for its parent resource.
    active: bool,
    /// The upload URL for the picture. This field appears when you create the picture resource for the first time.
    link: option<string>,
    /// The picture's resource key string.
    resource-key: string,
    /// An array containing reference information about all available image files.
    sizes: list<picture-sizes-item>,
    /// The type of the picture:
    /// 
    type-op: picture-type-op-enum,
    /// The picture's URI.
    uri: string
  }

  record picture-sizes-item {
    /// The height of the image.
    height: f64,
    /// The direct link to the image.
    link: string,
    /// The direct link to the image with a play button overlay.
    link-with-play-button: option<string>,
    /// The width of the image.
    width: f64
  }

  record user-preferences {
    videos: option<user-preferences-videos>
  }

  record user-preferences-videos {
    privacy: option<user-preferences-videos-privacy>
  }

  record user-preferences-videos-privacy {
    /// Whether other users can add the user's videos.
    add: option<bool>,
    /// The user's privacy preference for comments:
    /// 
    comments: option<user-preferences-videos-privacy-comments-enum>,
    /// Whether other users can download the user's videos.
    download: option<bool>,
    /// The user's privacy preference for embeds:
    /// 
    embed: option<user-preferences-videos-privacy-embed-enum>,
    /// The user's privacy preference for views:
    /// 
    view: option<user-preferences-videos-privacy-view-enum>
  }

  /// Appears only when the user has upload access and is looking at their own user record.
  record user-upload-quota {
    /// Information about the user's lifetime upload usage.
    lifetime: user-upload-quota-lifetime,
    /// Information about the user's usage for the current period.
    periodic: user-upload-quota-periodic,
    /// Information about the user's upload space remaining for the current period.
    space: user-upload-quota-space
  }

  /// Information about the user's lifetime upload usage.
  record user-upload-quota-lifetime {
    /// The number of bytes remaining in your lifetime maximum.
    free: f64,
    /// The total number of bytes that you can upload across the lifetime of your account.
    max: f64,
    /// The number of bytes that you've already uploaded against your lifetime limit.
    used: f64
  }

  /// Information about the user's usage for the current period.
  record user-upload-quota-periodic {
    /// The number of bytes remaining in your upload quota for the current period.
    free: f64,
    /// The total number of bytes that you can upload per period.
    max: f64,
    /// The time in ISO 8601 format when your upload quota resets.
    reset-date: string,
    /// The number of bytes that you've already uploaded against your quota in the current period.
    used: f64
  }

  /// Information about the user's upload space remaining for the current period.
  record user-upload-quota-space {
    /// The number of bytes remaining in your upload quota.
    free: f64,
    /// The maximum number of bytes allotted to your upload quota.
    max: f64,
    /// Whether the values of the upload_quota.space fields are for the lifetime quota or the periodic quota.
    showing: user-upload-quota-space-showing-enum,
    /// The number of bytes that you've already uploaded against your quota.
    used: f64
  }

  record user-websites-item {
    /// The website's description.
    description: string,
    /// The URL of the website.
    link: string,
    /// The name of the website.
    name: string
  }

  variant get-channel-privacy-users-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-channel-privacy-users-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant set-channel-privacy-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-channel-privacy-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all the users who can view a private channel
  record get-channel-privacy-users-params {
    /// The ID of the channel.
    channel-id: string,
    /// The sort direction of the results.
    direction: option<get-channel-privacy-users-direction-enum>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>
  }
  get-channel-privacy-users: func(params: get-channel-privacy-users-params) -> result<list<user>, get-channel-privacy-users-error>;

  /// Permit a list of users to view a private channel
  record set-channel-privacy-users-params {
    /// The ID of the channel.
    channel-id: string,
    /// The array of either the user URIs or the user IDs to permit to view the private channel.
    users: list<string>
  }
  set-channel-privacy-users: func(params: set-channel-privacy-users-params) -> result<list<user>, set-channel-privacy-users-error>;

  /// Permit a specific user to view a private channel
  record set-channel-privacy-user-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the user.
    user-id: string
  }
  set-channel-privacy-user: func(params: set-channel-privacy-user-params) -> result<string, set-channel-privacy-user-error>;

  /// Restrict a user from viewing a private channel
  record delete-channel-privacy-user-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the user.
    user-id: string
  }
  delete-channel-privacy-user: func(params: delete-channel-privacy-user-params) -> result<string, delete-channel-privacy-user-error>;

}

interface channels-tags {
  record tag {
    /// The normalized canonical tag name.
    canonical: string,
    /// Metadata about the group.
    metadata: tag-metadata,
    /// The tag value.
    name: string,
    /// The tag's resource key string.
    resource-key: string,
    /// The canonical relative URI of the tag.
    uri: string
  }

  /// Metadata about the group.
  record tag-metadata {
    /// A collection of information that is connected to this resource.
    connections: tag-metadata-connections
  }

  /// A collection of information that is connected to this resource.
  record tag-metadata-connections {
    /// Information about the videos related to this tag.
    videos: tag-metadata-connections-videos
  }

  /// Information about the videos related to this tag.
  record tag-metadata-connections-videos {
    /// An array of HTTP methods permitted on this URI.
    options: list<string>,
    /// The total number of videos on this connection.
    total: f64,
    /// The API URI that resolves to the connection data.
    uri: string
  }

  variant get-channel-tags-error {
    bad-request(string),
    other(string)
  }

  variant add-tags-to-channel-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant check-if-channel-has-tag-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant add-channel-tag-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant delete-tag-from-channel-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  /// Get all the tags that have been added to a channel
  record get-channel-tags-params {
    /// The ID of the channel.
    channel-id: string
  }
  get-channel-tags: func(params: get-channel-tags-params) -> result<list<tag>, get-channel-tags-error>;

  /// Add a list of tags to a channel
  record add-tags-to-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// An array of tags to assign.
    tag: list<string>
  }
  add-tags-to-channel: func(params: add-tags-to-channel-params) -> result<list<tag>, add-tags-to-channel-error>;

  /// Check if a tag has been added to a channel
  record check-if-channel-has-tag-params {
    /// The ID of the channel.
    channel-id: string,
    /// The word to use as the tag.
    word: string
  }
  check-if-channel-has-tag: func(params: check-if-channel-has-tag-params) -> result<string, check-if-channel-has-tag-error>;

  /// Add a specific tag to a channel
  record add-channel-tag-params {
    /// The ID of the channel.
    channel-id: string,
    /// The word to use as the tag.
    word: string
  }
  add-channel-tag: func(params: add-channel-tag-params) -> result<string, add-channel-tag-error>;

  /// Remove a tag from a channel
  record delete-tag-from-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The word to use as the tag.
    word: string
  }
  delete-tag-from-channel: func(params: delete-tag-from-channel-params) -> result<string, delete-tag-from-channel-error>;

}

interface channels-subscriptions-and-subscribers {
  enum get-channel-subscribers-direction-enum {
    asc,
    desc,
  }

  enum get-channel-subscribers-filter-enum {
    moderators,
  }

  enum get-channel-subscribers-sort-enum {
    alphabetical,
    date,
