interface channels-videos {
  enum get-channel-videos-direction-enum {
    asc,
    desc,
  }

  enum get-channel-videos-filter-enum {
    embeddable,
  }

  enum get-channel-videos-sort-enum {
    added,
    alphabetical,
    comments,
    date,
    default,
    duration,
    likes,
    manual,
    modified-time,
    plays,
  }

  /// Get all the videos in a channel
  record get-channel-videos-params {
    /// The ID of the channel.
    channel-id: string,
    /// The page that contains the video URI.
    containing-uri: option<string>,
    /// The sort direction of the results.
    direction: option<get-channel-videos-direction-enum>,
    /// The attribute by which to filter the results.
    filter: option<get-channel-videos-filter-enum>,
    /// Whether to filter the results by embeddable videos (`true`) or non-embeddable videos (`false`). Required only if **filter** is `embeddable`.
    filter-embeddable: option<bool>,
    /// The page number of the results to show.
    page: option<f64>,
    /// The number of items to show on each page of results, up to a maximum of 100.
    per-page: option<f64>,
    /// The search query to use to filter the results.
    query: option<string>,
    /// The way to sort the results.
    sort: option<get-channel-videos-sort-enum>
  }
  get-channel-videos: func(params: get-channel-videos-params) -> result<string, string>;

  /// Add a list of videos to a channel
  record add-videos-to-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The URI of a video to add.
    video-uri: string
  }
  add-videos-to-channel: func(params: add-videos-to-channel-params) -> result<string, string>;

  /// Remove a list of videos from a channel
  record remove-videos-from-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The URI of a video to remove.
    video-uri: string
  }
  remove-videos-from-channel: func(params: remove-videos-from-channel-params) -> result<string, string>;

  /// Get a specific video in a channel
  record get-channel-video-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string
  }
  get-channel-video: func(params: get-channel-video-params) -> result<string, string>;

  /// Add a specific video to a channel
  record add-video-to-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string
  }
  add-video-to-channel: func(params: add-video-to-channel-params) -> result<string, string>;

  /// Remove a specific video from a channel
  record delete-video-from-channel-params {
    /// The ID of the channel.
    channel-id: string,
    /// The ID of the video.
    video-id: string
  }
  delete-video-from-channel: func(params: delete-video-from-channel-params) -> result<string, string>;

  /// Get all the channels to which a user can add or remove a specific video
  record get-available-video-channels-params {
    /// The ID of the video.
    video-id: string
  }
  get-available-video-channels: func(params: get-available-video-channels-params) -> result<string, string>;

}

