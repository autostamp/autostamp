package autostamp:ticketmaster@0.2.1;

interface discovery {
  enum find-source-enum {
    ticketmaster,
    universe,
    frontgate,
    tmr,
  }

  enum find-include-test-enum {
    yes,
    no,
    only,
  }

  enum find-include-licensed-content-enum {
    yes,
    no,
  }

  enum get-discovery-v2-events-unit-enum {
    miles,
    km,
  }

  /// Attraction Search
  record find-params {
    /// Sorting order of the search result. Allowable Values : 'name,asc', 'name,desc', 'relevance,asc', 'relevance,desc'
    sort: option<string>,
    /// Filter attractions by classification name: name of any segment, genre, sub-genre, type, sub-type
    classification-name: option<list<string>>,
    /// Filter attractions by classification id: id of any segment, genre, sub-genre, type, sub-type
    classification-id: option<list<string>>,
    /// Keyword to search on
    keyword: option<string>,
    /// Filter entities by its id
    id: option<string>,
    /// Filter entities by its source name
    source: option<find-source-enum>,
    /// True if you want to have entities flag as test in the response. Only, if you only wanted test entities
    include-test: option<find-include-test-enum>,
    /// Page number
    page: option<string>,
    /// Page size of the response
    size: option<string>,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// Yes if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>,
    /// yes, to include spell check suggestions in the response.
    include-spellcheck: option<find-include-licensed-content-enum>
  }
  find: func(params: find-params) -> result<string, string>;

  /// Get Attraction Details
  record get-params {
    /// ID of the attraction
    id: string,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// True if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>
  }
  get: func(params: get-params) -> result<string, string>;

  /// Classification Search
  record get-discovery-v2-classifications-params {
    /// Sorting order of the search result
    sort: option<string>,
    /// Keyword to search on
    keyword: option<string>,
    /// Filter entities by its id
    id: option<string>,
    /// Filter entities by its source name
    source: option<find-source-enum>,
    /// True if you want to have entities flag as test in the response. Only, if you only wanted test entities
    include-test: option<find-include-test-enum>,
    /// Page number
    page: option<string>,
    /// Page size of the response
    size: option<string>,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// Yes if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>,
    /// yes, to include spell check suggestions in the response.
    include-spellcheck: option<find-include-licensed-content-enum>
  }
  get-discovery-v2-classifications: func(params: get-discovery-v2-classifications-params) -> result<string, string>;

  /// Get Genre Details
  record get-genre-params {
    /// ID of the genre
    id: string,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// True if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>
  }
  get-genre: func(params: get-genre-params) -> result<string, string>;

  /// Get Segment Details
  record get-segment-params {
    /// ID of the segment
    id: string,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// True if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>
  }
  get-segment: func(params: get-segment-params) -> result<string, string>;

  /// Get Sub-Genre Details
  record get-subgenre-params {
    /// ID of the subgenre
    id: string,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// True if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>
  }
  get-subgenre: func(params: get-subgenre-params) -> result<string, string>;

  /// Get Classification Details
  record get-discovery-v2-classifications-id-params {
    /// ID of the segment, genre, or sub-genre
    id: string,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// True if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>
  }
  get-discovery-v2-classifications-id: func(params: get-discovery-v2-classifications-id-params) -> result<string, string>;

  /// Event Search
  record get-discovery-v2-events-params {
    /// Sorting order of the search result. Allowable values : 'name,asc', 'name,desc', 'date,asc', 'date,desc', 'relevance,asc', 'relevance,desc', 'distance,asc', 'name,date,asc', 'name,date,desc', 'date,name,asc', 'date,name,desc','onsaleStartDate,asc', 'id,asc'
    sort: option<string>,
    /// Filter events with a start date after this date
    start-date-time: option<string>,
    /// Filter events with a start date before this date
    end-date-time: option<string>,
    /// Filter events with onsale start date after this date
    onsale-start-date-time: option<string>,
    /// Filter events with onsale start date on this date
    onsale-on-start-date: option<string>,
    /// Filter events with onsale range within this date
    onsale-on-after-start-date: option<string>,
    /// Filter events with onsale end date before this date
    onsale-end-date-time: option<string>,
    /// Filter events by city
    city: option<string>,
    /// Filter events by country code
    country-code: option<string>,
    /// Filter events by state code
    state-code: option<string>,
    /// Filter events by postal code / zipcode
    postal-code: option<string>,
    /// Filter events by venue id
    venue-id: option<string>,
    /// Filter events by attraction id
    attraction-id: option<string>,
    /// Filter events by segment id
    segment-id: option<string>,
    /// Filter events by segment name
    segment-name: option<string>,
    /// Filter events by classification name: name of any segment, genre, sub-genre, type, sub-type
    classification-name: option<list<string>>,
    /// Filter events by classification id: id of any segment, genre, sub-genre, type, sub-type
    classification-id: option<list<string>>,
    /// Filter events by market id
    market-id: option<string>,
    /// Filter events by promoter id
    promoter-id: option<string>,
    /// Filter events by dma id
    dma-id: option<string>,
    /// True, to include events with date to be announce (TBA)
    include-tba: option<find-include-test-enum>,
    /// True, to include event with a date to be defined (TBD)
    include-tbd: option<find-include-test-enum>,
    /// Filter events by clientName
    client-visibility: option<string>,
    /// Filter events by latitude and longitude, this filter is deprecated and maybe removed in a future release, please use geoPoint instead
    latlong: option<string>,
    /// Radius of the area in which we want to search for events.
    radius: option<string>,
    /// Unit of the radius
    unit: option<get-discovery-v2-events-unit-enum>,
    /// filter events by geoHash
    geo-point: option<string>,
    /// Keyword to search on
    keyword: option<string>,
    /// Filter entities by its id
    id: option<string>,
    /// Filter entities by its source name
    source: option<find-source-enum>,
    /// True if you want to have entities flag as test in the response. Only, if you only wanted test entities
    include-test: option<find-include-test-enum>,
    /// Page number
    page: option<string>,
    /// Page size of the response
    size: option<string>,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// Yes if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>,
    /// yes, to include spell check suggestions in the response.
    include-spellcheck: option<find-include-licensed-content-enum>
  }
  get-discovery-v2-events: func(params: get-discovery-v2-events-params) -> result<string, string>;

  /// Get Event Details
  record get-discovery-v2-events-id-params {
    /// ID of the event
    id: string,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// True if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>
  }
  get-discovery-v2-events-id: func(params: get-discovery-v2-events-id-params) -> result<string, string>;

  /// Get Event Images
  record get-images-params {
    /// ID of the event
    id: string,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// True if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>
  }
  get-images: func(params: get-images-params) -> result<string, string>;

  /// Venue Search
  record get-discovery-v2-venues-params {
    /// Sorting order of the search result. Allowable Values: 'name,asc', 'name,desc', 'relevance,asc', 'relevance,desc', 'distance,asc', 'distance,desc'
    sort: option<string>,
    /// Filter venues by state / province code
    state-code: option<string>,
    /// Filter venues by country code
    country-code: option<string>,
    /// Filter events by latitude and longitude, this filter is deprecated and maybe removed in a future release, please use geoPoint instead
    latlong: option<string>,
    /// Radius of the area in which we want to search for events.
    radius: option<string>,
    /// Unit of the radius
    unit: option<get-discovery-v2-events-unit-enum>,
    /// filter events by geoHash
    geo-point: option<string>,
    /// Keyword to search on
    keyword: option<string>,
    /// Filter entities by its id
    id: option<string>,
    /// Filter entities by its source name
    source: option<find-source-enum>,
    /// True if you want to have entities flag as test in the response. Only, if you only wanted test entities
    include-test: option<find-include-test-enum>,
    /// Page number
    page: option<string>,
    /// Page size of the response
    size: option<string>,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// Yes if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>,
    /// yes, to include spell check suggestions in the response.
    include-spellcheck: option<find-include-licensed-content-enum>
  }
  get-discovery-v2-venues: func(params: get-discovery-v2-venues-params) -> result<string, string>;

  /// Get Venue Details
  record get-discovery-v2-venues-id-params {
    /// ID of the venue
    id: string,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// True if you want to display licensed content
    include-licensed-content: option<find-include-licensed-content-enum>
  }
  get-discovery-v2-venues-id: func(params: get-discovery-v2-venues-id-params) -> result<string, string>;

}


interface v2 {
  enum get-discovery-v2-suggest-source-enum {
    ticketmaster,
    universe,
    frontgate,
    tmr,
  }

  enum get-discovery-v2-suggest-unit-enum {
    miles,
    km,
  }

  enum get-discovery-v2-suggest-include-fuzzy-enum {
    yes,
    no,
  }

  enum get-discovery-v2-suggest-include-tba-enum {
    yes,
    no,
    only,
  }

  /// Find Suggest
  record get-discovery-v2-suggest-params {
    /// Keyword to search on
    keyword: option<string>,
    /// Filter entities by its source name
    source: option<get-discovery-v2-suggest-source-enum>,
    /// Filter events by latitude and longitude, this filter is deprecated and maybe removed in a future release, please use geoPoint instead
    latlong: option<string>,
    /// Radius of the area in which we want to search for events.
    radius: option<string>,
    /// Unit of the radius
    unit: option<get-discovery-v2-suggest-unit-enum>,
    /// Size of every entity returned in the response
    size: option<string>,
    /// yes, to include fuzzy matches in the search. This has performance impact.
    include-fuzzy: option<get-discovery-v2-suggest-include-fuzzy-enum>,
    /// Filter events to clientName
    client-visibility: option<string>,
    /// Filter suggestions by country code
    country-code: option<string>,
    /// True, to include events with date to be announce (TBA)
    include-tba: option<get-discovery-v2-suggest-include-tba-enum>,
    /// True, to include event with a date to be defined (TBD)
    include-tbd: option<get-discovery-v2-suggest-include-tba-enum>,
    /// Filter suggestions by segment id
    segment-id: option<string>,
    /// filter events by geoHash
    geo-point: option<string>,
    /// The locale in ISO code format. Multiple comma-separated values can be provided. When omitting the country part of the code (e.g. only 'en' or 'fr') then the first matching locale is used. When using a '*' it matches all locales. '*' can only be used at the end (e.g. 'en-us,en,*') 
    locale: option<string>,
    /// Yes if you want to display licensed content
    include-licensed-content: option<get-discovery-v2-suggest-include-fuzzy-enum>,
    /// yes, to include spell check suggestions in the response.
    include-spellcheck: option<get-discovery-v2-suggest-include-fuzzy-enum>
  }
  get-discovery-v2-suggest: func(params: get-discovery-v2-suggest-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export discovery;
  export v2;
}
