    /// Fax inbound rule id
    inbound-rule-id: string
  }
  delete-automations-fax-inbound-inbound-rule-id: func(params: delete-automations-fax-inbound-inbound-rule-id-params) -> result<string, string>;

  /// List Rules
  list-rules: func() -> result<string, string>;

  /// Create a New Rule
  record create-a-new-rule-params {
    /// Action.
    action: string,
    /// Action Address.
    action-address: string,
    /// Enabled.
    enabled: f64,
    /// Match Type. 0=All reports.
    match-type: f64,
    /// Rule Name.
    rule-name: string
  }
  create-a-new-rule: func(params: create-a-new-rule-params) -> result<string, string>;

  /// Get a Specific Rule
  record get-a-specific-rule-params {
    /// The rule id you want to access.
    rule-id: string
  }
  get-a-specific-rule: func(params: get-a-specific-rule-params) -> result<string, string>;

  /// Update a Rule
  record update-a-rule-params {
    /// The email receipt rule id you want to access.
    rule-id: string,
    /// Action.
    action: option<string>,
    /// Action Address.
    action-address: option<string>,
    /// Enabled.
    enabled: option<f64>,
    /// Match Type. 0=All reports.
    match-type: option<f64>,
    /// Rule Name.
    rule-name: option<string>
  }
  update-a-rule: func(params: update-a-rule-params) -> result<string, string>;

  /// Delete a Rule
  record delete-a-rule-params {
    /// The email receipt rule id you want to delete.
    rule-id: string
  }
  delete-a-rule: func(params: delete-a-rule-params) -> result<string, string>;

  /// List rules
  list-rules-v2: func() -> result<string, string>;

  /// Create a new rule
  record create-a-new-rule-v2-params {
    /// Action.
    action: string,
    /// Action Address.
    action-address: string,
    /// Dedicated Number.
    dedicated-number: f64,
    /// Enabled.
    enabled: f64,
    /// Message Search Term.
    message-search-term: string,
    /// Message Search Type: 0=Any message, 1=starts with, 2=contains, 3=does not contain.
    message-search-type: f64,
    /// Rule Name.
    rule-name: string
  }
  create-a-new-rule-v2: func(params: create-a-new-rule-v2-params) -> result<string, string>;

  /// Get a specific rule
  record get-a-specific-rule-v2-params {
    /// Inbound Rule ID.
    inbound-rule-id: string
  }
  get-a-specific-rule-v2: func(params: get-a-specific-rule-v2-params) -> result<string, string>;

  /// Update a rule
  record update-a-rule-v2-params {
    /// Inbound Rule ID.
    inbound-rule-id: string,
    /// Action.
    action: string,
    /// Action Address.
    action-address: string,
    /// Dedicated Number
    dedicated-number: string,
    /// Enabled.
    enabled: f64,
    /// Message Search Term.
    message-search-term: string,
    /// Message Search Type: 0=Any message, 1=starts with, 2=contains, 3=does not contain.
    message-search-type: f64
  }
  update-a-rule-v2: func(params: update-a-rule-v2-params) -> result<string, string>;

  /// Delete a rule
  record delete-a-rule-v2-params {
    /// Inbound Rule ID.
    inbound-rule-id: string
  }
  delete-a-rule-v2: func(params: delete-a-rule-v2-params) -> result<string, string>;

  /// List rules
  get-automations-sms-receipts: func() -> result<string, string>;

  /// Create a new rule
  record post-automations-sms-receipts-params {
    /// Action.
    action: string,
