    action-address: string,
    /// Enabled.
    enabled: f64,
    /// Match Type. 0=All reports, 1=Only failed, 2=Only successful.
    match-type: f64,
    /// Rule Name.
    rule-name: string
  }
  post-automations-sms-receipts: func(params: post-automations-sms-receipts-params) -> result<string, string>;

  /// Get a specific rule
  record get-automations-sms-receipts-receipt-rule-id-params {
