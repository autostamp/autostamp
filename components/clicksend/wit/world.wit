/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `basic` | `Authorization: Basic base64(<secret>)` |
package autostamp:clicksend@0.2.0;

interface account {
  /// Get account
  get-account: func() -> result<string, string>;

  /// Create a new account
  record create-a-new-account-params {
    /// Your delivery to value.
    account-name: string,
    /// Your country.
    country: string,
    /// Your password.
    password: string,
    /// Your email.
    user-email: string,
    /// Your first name.
    user-first-name: string,
    /// Your last name.
    user-last-name: string,
    /// Your phone number in E.164 format.
    user-phone: string,
    /// Your username.
    username: string
  }
  create-a-new-account: func(params: create-a-new-account-params) -> result<string, string>;

  /// Update Account
  record update-account-params {
    /// Your delivery to value.
    account-name: string,
    /// Your country.
    country: string,
    /// Your password.
    password: string,
    /// Set the private uploads flag. 0 or 1 only.
    private-uploads: option<f64>,
    /// Set the private uploads flag. 0 or 1 only.
    setting-sms-hide-business-name: option<f64>,
    /// Set the private uploads flag. 0 or 1 only.
    setting-sms-hide-your-number: option<f64>,
    /// Timezone.
    timezone: string,
    /// Your email.
    user-email: string,
    /// Your first name.
    user-first-name: string,
    /// Your last name.
    user-last-name: string,
    /// Your phone number in E.164 format.
    user-phone: string,
    /// Your username.
    username: string
  }
  update-account: func(params: update-account-params) -> result<string, string>;

  /// Send account activation token
  record send-account-activation-token-params {
    country: option<string>,
    type-op: option<string>,
    user-phone: option<string>
  }
  send-account-activation-token: func(params: send-account-activation-token-params) -> result<string, string>;

  /// Verify new account
  record verify-new-account-params {
    /// The ActivationToken to be used to verify an account.
    activation-token: string
  }
  verify-new-account: func(params: verify-new-account-params) -> result<string, string>;

  /// Account Usage
  record account-usage-params {
    /// Your account usage year.
    year: string,
    /// Your account usage month.
    month: string,
    /// The account type. Value can only be either email or subaccount.
    type-op: string
  }
  account-usage: func(params: account-usage-params) -> result<string, string>;

}


interface automation-rules {
  /// List Rules
  get-automations-email-receipt: func() -> result<string, string>;

  /// Create a New Rule
  record post-automations-email-receipt-params {
    /// Action.
    action: string,
    /// Action Address.
    action-address: string,
    /// Enabled.
    enabled: f64,
    /// Match Type. 0=All reports.
    match-type: f64,
    /// Rule Name.
    rule-name: string
