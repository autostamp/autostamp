interface sms {
  /// Cancel all Scheduled Messages
  cancel-all-scheduled-messages: func() -> result<string, string>;

  /// Export SMS History
  record export-sms-history-params {
    /// Your export filename.
    filename: string
  }
  export-sms-history: func(params: export-sms-history-params) -> result<string, string>;

  /// Get all History
  record get-all-history-params {
    /// Timestamp (from) used to show records by date.
    date-from: string,
    /// Timestamp (to) used to show recrods by date.
    date-to: string
  }
  get-all-history: func(params: get-all-history-params) -> result<string, string>;

  /// Get all Inbound SMS - Pull
  get-all-inbound-sms-pull: func() -> result<string, string>;

  /// Add a Test Inbound SMS
  record add-a-test-inbound-sms-params {
    /// Your URL if using the push option or 'poll' if using the pull option.
    url: string
  }
  add-a-test-inbound-sms: func(params: add-a-test-inbound-sms-params) -> result<string, string>;

  /// Mark all Inbound SMS as read
  record mark-all-inbound-sms-as-read-params {
    /// An optional timestamp - mark all as read before this timestamp. If not given, all messages will be marked as read.
    date-before: f64
  }
  mark-all-inbound-sms-as-read: func(params: mark-all-inbound-sms-as-read-params) -> result<string, string>;

  /// Mark a specific Inbound SMS as read
  record mark-a-specific-inbound-sms-as-read-params {
    /// Message ID. Must be a valid GUID.
    message-id: string
  }
  mark-a-specific-inbound-sms-as-read: func(params: mark-a-specific-inbound-sms-as-read-params) -> result<string, string>;

  /// Get Specific Inbound - Pull
  record get-specific-inbound-pull-params {
    /// Message ID of the original outbound message, to which the inbound message is a reply. Must be a valid GUID.
    outbound-message-id: string
  }
  get-specific-inbound-pull: func(params: get-specific-inbound-pull-params) -> result<string, string>;

  /// Calculate Price
  record post-sms-price-params {
    /// Your message.
    body: string,
    /// Recipient country.
    country: option<string>,
    /// Your reference. Will be passed back with all replies and delivery reports.
    custom-string: option<string>,
    /// Your sender id - [more info](http://help.clicksend.com/SMS/what-is-a-sender-id-or-sender-number).
    from-op: option<string>,
    /// Your list ID if sending to a whole list. Can be used instead of 'to'.
    list-id: option<f64>,
    /// Leave blank for immediate delivery. Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// Your method of sending e.g. 'wordpress', 'php', 'c#'.
    source: option<string>,
    /// Recipient number in E.164 format or local format ([more info](https://help.clicksend.com/SMS/what-format-does-the-recipient-phone-number-need-to-be-in)).
    to: string
  }
  post-sms-price: func(params: post-sms-price-params) -> result<string, string>;

  /// Get all Delivery Receipts
  get-sms-receipts: func() -> result<string, string>;

  /// Add a Test Delivery Receipt
  record post-sms-receipts-params {
    /// Your URL if using the push option or 'poll' if using the pull option.
    url: string
  }
  post-sms-receipts: func(params: post-sms-receipts-params) -> result<string, string>;

  /// Mark Delivery Receipts as read
  record mark-delivery-receipts-as-read-params {
    /// An optional timestamp - mark all as read before this timestamp. If not given, all receipts will be marked as read.
    date-before: option<f64>
  }
  mark-delivery-receipts-as-read: func(params: mark-delivery-receipts-as-read-params) -> result<string, string>;

  /// Get a Specific Delivery Receipt
  record get-a-specific-delivery-receipt-params {
    /// Your message id.
    message-id: string
  }
  get-a-specific-delivery-receipt: func(params: get-a-specific-delivery-receipt-params) -> result<string, string>;

  /// Send an SMS
  record send-an-sms-params {
    /// Your message.
    body: string,
    /// Recipient country.
    country: option<string>,
    /// Your reference. Will be passed back with all replies and delivery reports.
    custom-string: option<string>,
    /// Your sender id - [more info](http://help.clicksend.com/SMS/what-is-a-sender-id-or-sender-number).
    from-op: option<string>,
    /// An email address where the reply should be emailed to. If omitted, the reply will be emailed back to the user who sent the outgoing SMS.
    from-email: option<string>,
    /// Your list ID if sending to a whole list. Can be used instead of 'to'.
    list-id: option<f64>,
    /// Leave blank for immediate delivery. Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// Your method of sending e.g. 'wordpress', 'php', 'c#'.
    source: option<string>,
    /// Recipient number in E.164 format or local format ([more info](https://help.clicksend.com/SMS/what-format-does-the-recipient-phone-number-need-to-be-in)).
    to: string
  }
  send-an-sms: func(params: send-an-sms-params) -> result<string, string>;

  /// Cancel a Scheduled Message
  record cancel-a-scheduled-message-params {
    /// B7CE432193CD-0753597B7293 (string, required) - The message ID you want to cancel.
    message-id: string
  }
  cancel-a-scheduled-message: func(params: cancel-a-scheduled-message-params) -> result<string, string>;

}

