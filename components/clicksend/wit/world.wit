interface contact-suggestions {
  /// List Contact Suggestions
  list-contact-suggestions: func() -> result<string, string>;

}

interface countries {
  /// Get all Countries
  get-all-countries: func() -> result<string, string>;

}

interface delivery-issues {
  /// Get Delivery Issues
  get-delivery-issues: func() -> result<string, string>;

  /// Create Delivery Issue
  record create-delivery-issue-params {
    /// The user's comments.
    client-comments: option<string>,
    /// The description of the message.
    description: string,
    /// The user's email address.
    email-address: string,
    /// The message id of the message.
    message-id: string,
    /// The type of message, must be one of the following values: `SMS`, `MMS`, `VOICE`, `EMAIL_MARKETING`, `EMAIL_TRANSACTIONAL`, `FAX`, `POST`.
    type-op: string
  }
  create-delivery-issue: func(params: create-delivery-issue-params) -> result<string, string>;

}

interface email-marketing {
  /// Get All Email Campaigns
  get-all-email-campaigns: func() -> result<string, string>;

  /// Calculate Price
  record calculate-price-params {
    /// The allowed email address id.
    from-email-address-id: f64,
    /// The name that will appear on the email.
    from-name: string,
    /// The list id you want to access.
    list-id: f64,
    /// The name of the sender.
    name: string,
    /// Leave blank for immediate delivery. Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// The subject of the email campaign.
    subject: string,
    /// The template id you want to use.
    template-id: f64
  }
  calculate-price: func(params: calculate-price-params) -> result<string, string>;

  /// Create Email Campaign
  record create-email-campaign-params {
    /// The allowed email address id.
    from-email-address-id: f64,
    /// The name that will appear on the email.
    from-name: string,
    /// The list id you want to access.
    list-id: f64,
    /// The name of the sender.
    name: string,
    /// Leave blank for immediate delivery. Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// The subject of the email campaign.
    subject: string,
    /// The template id you want to use.
    template-id: f64
  }
  create-email-campaign: func(params: create-email-campaign-params) -> result<string, string>;

  /// Get Specific Email Campaign History
  record get-specific-email-campaign-history-params {
    /// The email campaign id you want to access.
    campaign-id: string
  }
  get-specific-email-campaign-history: func(params: get-specific-email-campaign-history-params) -> result<string, string>;

  /// Get Specific Email Campaign
  record get-specific-email-campaign-params {
    /// The email campaign id you want to access.
    email-campaign-id: string
  }
  get-specific-email-campaign: func(params: get-specific-email-campaign-params) -> result<string, string>;

  /// Update Email Campaign
  record update-email-campaign-params {
    /// The email campaign id you want to access.
    email-campaign-id: string,
    /// The allowed email address id.
    from-email-address-id: option<f64>,
    /// The name that will appear on the email.
    from-name: option<string>,
    /// The list id you want to access.
    list-id: option<f64>,
    /// The name of the sender.
    name: option<string>,
    /// Leave blank for immediate delivery. Will replace existing schedule (even if left blank). Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// The subject of the email campaign.
    subject: option<string>,
    /// The template id you want to use.
    template-id: option<f64>
  }
  update-email-campaign: func(params: update-email-campaign-params) -> result<string, string>;

  /// Cancel Email Campaign
  record cancel-email-campaign-params {
    /// The email campaign id you want to cancel.
    email-campaign-id: string
  }
  cancel-email-campaign: func(params: cancel-email-campaign-params) -> result<string, string>;

  /// Send Verification Token
  record send-verification-token-params {
    /// The email addess id you want to access.
    email-address-id: string
  }
  send-verification-token: func(params: send-verification-token-params) -> result<string, string>;

  /// Verify Allowed Email Address
  record verify-allowed-email-address-params {
    /// The email address id you want to access.
    email-address-id: string,
    /// 6E8B-4FDB-99A7-7ED08DF97BCC (required, string) - Your activation token.
    activation-token: string
  }
  verify-allowed-email-address: func(params: verify-allowed-email-address-params) -> result<string, string>;

  /// Get All Allowed Email Addresses
  get-all-allowed-email-addresses: func() -> result<string, string>;

  /// Create Allowed Email Address
  record create-allowed-email-address-params {
    /// {
    ///     "email_address" : "test222@user.com"
    body: option<string>,
    /// Your email.
    email-address: string
  }
  create-allowed-email-address: func(params: create-allowed-email-address-params) -> result<string, string>;

  /// Get Specific Allowed Email Address
  record get-specific-allowed-email-address-params {
    /// The email address you want to access.
    email-address-id: string
  }
  get-specific-allowed-email-address: func(params: get-specific-allowed-email-address-params) -> result<string, string>;

  /// Delete Allowed Email Address
  record delete-allowed-email-address-params {
    /// The email address you want to access.
    email-address-id: string
  }
  delete-allowed-email-address: func(params: delete-allowed-email-address-params) -> result<string, string>;

  /// Get All Master Email Templates
  get-all-master-email-templates: func() -> result<string, string>;

  /// Get All Master Template Categories
  get-all-master-template-categories: func() -> result<string, string>;

  /// Get Specific Email Template Category
  record get-specific-email-template-category-params {
    /// Your category id.
    category-id: string
  }
  get-specific-email-template-category: func(params: get-specific-email-template-category-params) -> result<string, string>;

  /// Get All Templates For Category
  record get-all-templates-for-category-params {
    /// Your category id.
    category-id: string
  }
  get-all-templates-for-category: func(params: get-all-templates-for-category-params) -> result<string, string>;

  /// Get Specific Master Template
  record get-specific-master-template-params {
    /// Your template id.
    template-id: string
  }
  get-specific-master-template: func(params: get-specific-master-template-params) -> result<string, string>;

  /// Get All Email Templates
  get-all-email-templates: func() -> result<string, string>;

  /// Create New Email Template from Master Template
  record create-new-email-template-from-master-template-params {
    /// The ID of the master template you want to base on.
    template-id-master: f64,
    /// The intended name for the new template.
    template-name: string
  }
  create-new-email-template-from-master-template: func(params: create-new-email-template-from-master-template-params) -> result<string, string>;

  /// Upload Image to Specific Template
  record upload-image-to-specific-template-params {
    /// Your template id.
    template-id: string,
    /// Uploads your selected image file.
    image: option<string>,
    /// Uploads the image from the supplied URL.
    url: option<string>
  }
  upload-image-to-specific-template: func(params: upload-image-to-specific-template-params) -> result<string, string>;

  /// Get Specific Email Template
  record get-specific-email-template-params {
    /// The email template id.
    template-id: string
  }
  get-specific-email-template: func(params: get-specific-email-template-params) -> result<string, string>;

  /// Update an Email Template
  record update-an-email-template-params {
    /// The id of the template to be updated.
    template-id: string,
    /// Your template body.
    body: string,
    /// The intended name for the new template.
    template-name: string
  }
  update-an-email-template: func(params: update-an-email-template-params) -> result<string, string>;

  /// Delete Email Template
  record delete-email-template-params {
    /// Your template id.
    template-id: string
  }
  delete-email-template: func(params: delete-email-template-params) -> result<string, string>;

}

interface transactional-email {
  /// Email History
  email-history: func() -> result<string, string>;

  /// Export History
  record export-history-params {
    /// Your export filename.
    filename: string
  }
  export-history: func(params: export-history-params) -> result<string, string>;

  /// Email Price
  record email-price-params {
    /// The attachments of the email. See sample request for more details.
    attachments: list<string>,
    /// The bcc of the email. See sample request for more details.
    bcc: option<list<string>>,
    /// The content of the email.
    body: string,
    /// The cc of the email. See sample request for more details.
    cc: option<list<string>>,
    /// The sender's email address id.
    from-email-address-id: f64,
    /// The sender's name.
    from-name: option<string>,
    /// The subject of the email.
    subject: string,
    /// The recipients of the email. See sample request for more details.
    to: list<string>
  }
  email-price: func(params: email-price-params) -> result<string, string>;

  /// Add a Test Delivery Receipt
  record post-email-receipts-params {
    /// Your URL if using the push option or 'poll' if using the pull option.
    url: string
  }
  post-email-receipts: func(params: post-email-receipts-params) -> result<string, string>;

  /// Email Send
  record email-send-params {
    /// The attachments of the email.
    attachments: option<list<string>>,
    /// The bcc of the email. Follows the same structure as `to`.
    bcc: option<list<string>>,
    /// The content of the email.
    body: string,
    /// The cc of the email. Follows the same structure as `to`.
    cc: option<list<string>>,
    /// The sender's email address ID.
    from-email-address-id: f64,
    /// The sender's name.
    from-name: option<string>,
    /// Leave blank for immediate delivery. Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// The recipients of the email.
    to: list<string>
  }
  email-send: func(params: email-send-params) -> result<string, string>;

}

interface fax {
  /// Export Fax History
  record export-fax-history-params {
    /// Your export filename.
    filename: string
  }
  export-fax-history: func(params: export-fax-history-params) -> result<string, string>;

  /// Get Fax History
  record get-fax-history-params {
    /// Customize result by setting from date (timestsamp)
    date-from: string,
    /// Customize result by setting to date (timestamp)
    date-to: string,
    /// Custom query
    q: string,
    /// Order result by
    order-by: string
  }
  get-fax-history: func(params: get-fax-history-params) -> result<string, string>;

  /// Calculate Price
  record post-fax-price-params {
    /// Recipient country.
    country: option<string>,
    /// Your reference. Will be passed back with all replies and delivery reports.
    custom-string: option<string>,
    /// Your URL to your PDF file.
    file-url: string,
    /// Your sender id. Must be a valid fax number.
    from-op: option<string>,
    /// An email address where the reply should be emailed to.
    from-email: option<string>,
    /// Your list ID if sending to a whole list. Can be used instead of 'to'.
    list-id: option<f64>,
    /// Your messages.
    messages: list<string>,
    /// Leave blank for immediate delivery. Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// Your method of sending e.g. 'wordpress', 'php', 'c#'.
    source: option<string>,
    /// Recipient number in E.164 format or local format ([more info](https://help.clicksend.com/SMS/what-format-does-the-recipient-phone-number-need-to-be-in)).
    to: string
  }
