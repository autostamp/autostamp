    receipt-rule-id: string
  }
  get-automations-sms-receipts-receipt-rule-id: func(params: get-automations-sms-receipts-receipt-rule-id-params) -> result<string, string>;

  /// Update a rule
  record put-automations-sms-receipts-receipt-rule-id-params {
    /// Receipt Rule ID.
    receipt-rule-id: string,
    /// Action.
    action: string,
    /// Action Address.
    action-address: string,
    /// Enabled.
    enabled: f64,
    /// Match Type. 0=All reports, 1=Only failed, 2=Only successful.
    match-type: f64,
    /// Rule Name.
    rule-name: string
  }
  put-automations-sms-receipts-receipt-rule-id: func(params: put-automations-sms-receipts-receipt-rule-id-params) -> result<string, string>;

  /// Delete a rule
  record delete-automations-sms-receipts-receipt-rule-id-params {
    /// Receipt Rule ID.
    receipt-rule-id: string
  }
  delete-automations-sms-receipts-receipt-rule-id: func(params: delete-automations-sms-receipts-receipt-rule-id-params) -> result<string, string>;

  /// List rules
  get-automations-voice-receipts: func() -> result<string, string>;

  /// Create a new rule
  record post-automations-voice-receipts-params {
    /// Action.
    action: string,
    /// Action Address.
    action-address: string,
    /// Enabled.
    enabled: f64,
    /// Match Type. 0=All reports, 1=Only failed, 2=Only successful.
    match-type: f64,
    /// Rule Name.
    rule-name: string
  }
  post-automations-voice-receipts: func(params: post-automations-voice-receipts-params) -> result<string, string>;

  /// Get a specific rule
  record get-automations-voice-receipts-receipt-rule-id-params {
    /// Receipt Rule ID.
    receipt-rule-id: string
  }
  get-automations-voice-receipts-receipt-rule-id: func(params: get-automations-voice-receipts-receipt-rule-id-params) -> result<string, string>;

  /// Update a rule
  record put-automations-voice-receipts-receipt-rule-id-params {
    /// Receipt Rule ID.
    receipt-rule-id: string,
    /// Action.
    action: string,
