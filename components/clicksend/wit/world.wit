    reseller-user-id: f64,
    /// Your email.
    user-email: string,
    /// Your first name.
    user-first-name: string,
    /// Your last name.
    user-last-name: string,
    /// Your phone number in E.164 format.
    user-phone: string,
    /// Your username.
    username: string
  }
  create-reseller-account-public: func(params: create-reseller-account-public-params) -> result<string, string>;

  /// Get Reseller Account
