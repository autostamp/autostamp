interface voice {
  /// Cancel all Voice Calls
  cancel-all-voice-calls: func() -> result<string, string>;

  /// Export Voice History
  record export-voice-history-params {
    /// Your export filename.
    filename: string
  }
  export-voice-history: func(params: export-voice-history-params) -> result<string, string>;

  /// Get Voice History
  record get-voice-history-params {
    /// Timestamp (from) used to show records by date.
    date-from: string,
    /// Timestamp (to) used to show recrods by date.
    date-to: string
  }
  get-voice-history: func(params: get-voice-history-params) -> result<string, string>;

  /// Voice Languages
  voice-languages: func() -> result<string, string>;

  /// Calculate Price
  record post-voice-price-params {
    /// Your message.
    body: string,
    /// The country of the recipient.
    country: option<string>,
    /// Your reference. Will be passed back with all replies and delivery reports.
    custom-string: option<string>,
    /// au (string, required) - See section on available languages.
    lang: option<string>,
    /// Your list ID if sending to a whole list. Can be used instead of 'to'.
    list-id: option<f64>,
    /// Whether you want to receive a keypress from the call recipient (1 for on, 0 [default] for off)
    require-input: option<f64>,
    /// Leave blank for immediate delivery. Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// Your method of sending e.g. 'wordpress', 'php', 'c#'.
    source: option<string>,
    /// Recipient number in E.164 format or local format ([more info](https://help.clicksend.com/SMS/what-format-does-the-recipient-phone-number-need-to-be-in)).
    to: string,
    /// Either 'female' or 'male'.
    voice: string
  }
  post-voice-price: func(params: post-voice-price-params) -> result<string, string>;

  /// Get Voice receipts
  get-voice-receipts: func() -> result<string, string>;

  /// Add a Test Delivery Receipt
  record post-voice-receipts-params {
    /// Your URL if using the push option or 'poll' if using the pull option.
    url: string
  }
  post-voice-receipts: func(params: post-voice-receipts-params) -> result<string, string>;

  /// Marked Voice Receipts as Read
  record marked-voice-receipts-as-read-params {
    /// An optional [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp) - mark all as read before this timestamp. If not given, all receipts will be marked as read.
    date-before: string
  }
  marked-voice-receipts-as-read: func(params: marked-voice-receipts-as-read-params) -> result<string, string>;

  /// Get Specific Voice Receipt
  record get-specific-voice-receipt-params {
    /// 3055-45F1-9B79-F2C43509FD16 (string, required) - The voice receipt message id.
    message-id: string
  }
  get-specific-voice-receipt: func(params: get-specific-voice-receipt-params) -> result<string, string>;

  /// Send a Voice Call
  record send-a-voice-call-params {
    /// Your message.
    body: string,
    /// The country of the recipient.
    country: option<string>,
    /// Your reference. Will be passed back with all replies and delivery reports.
    custom-string: option<string>,
    /// au (string, required) - See section on available languages.
    lang: option<string>,
    /// Your list ID if sending to a whole list. Can be used instead of 'to'. Will override 'to' if both are used.
    list-id: option<f64>,
    /// Whether to attempt to detect an answering machine or voicemail service and leave a message (1 for on, 0 [default] for off)
    machine-detection: option<f64>,
    /// Whether you want to receive a keypress from the call recipient (1 for on, 0 [default] for off)
    require-input: option<f64>,
    /// Leave blank for immediate delivery. Your schedule time as a [unix timestamp](http://help.clicksend.com/what-is-a-unix-timestamp).
    schedule: option<f64>,
    /// Your method of sending e.g. 'wordpress', 'php', 'c#'.
    source: option<string>,
    /// Recipient number in E.164 format or local format ([more info](https://help.clicksend.com/SMS/what-format-does-the-recipient-phone-number-need-to-be-in)).
    to: string,
    /// Either 'female' or 'male'.
    voice: string
  }
  send-a-voice-call: func(params: send-a-voice-call-params) -> result<string, string>;

  /// Cancel a Specific Voice Call
  record cancel-a-specific-voice-call-params {
    /// Your voice message id.
    message-id: string
  }
  cancel-a-specific-voice-call: func(params: cancel-a-specific-voice-call-params) -> result<string, string>;

}
/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export account;
  export automation-rules;
  export contact-suggestions;
  export countries;
  export delivery-issues;
  export email-marketing;
  export transactional-email;
  export fax;
  export forgot-account;
  export contact-lists;
  export contacts;
  export mms;
  export numbers;
  export post-direct-mail;
  export post-address-detection;
  export post-letter;
  export postcards;
  export pricing;
  export account-recharge;
  export referral-accounts;
  export reseller;
  export reseller-accounts;
  export sdk;
  export search;
  export sms-campaigns;
  export sms;
  export email-to-sms-allowed-address;
  export email-to-sms-stripped-strings;
  export sms-templates;
  export statistics;
  export subaccounts;
  export timezones;
  export uploads;
  export voice;
}
