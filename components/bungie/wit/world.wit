  }

  record friends-bungie-friend-request-list-response {
    incoming-requests: option<list<friends-bungie-friend>>,
    outgoing-requests: option<list<friends-bungie-friend>>
  }

  record accept-friend-request-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<accept-friend-request-response-message-data>,
    response: option<bool>,
    throttle-seconds: option<s32>
  }

  record accept-friend-request-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record decline-friend-request-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<decline-friend-request-response-message-data>,
    response: option<bool>,
    throttle-seconds: option<s32>
  }

  record decline-friend-request-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record remove-friend-request-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<remove-friend-request-response-message-data>,
    response: option<bool>,
    throttle-seconds: option<s32>
  }

  record remove-friend-request-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-platform-friend-list-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-platform-friend-list-response-message-data>,
    response: option<friends-platform-friend-response>,
    throttle-seconds: option<s32>
  }

  record get-platform-friend-list-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record friends-platform-friend-response {
    current-page: option<s32>,
    has-more: option<bool>,
    items-per-page: option<s32>,
    platform-friends: option<list<friends-platform-friend>>
  }

  record friends-platform-friend {
    bungie-global-display-name: option<string>,
    bungie-global-display-name-code: option<s32>,
    bungie-net-membership-id: option<s64>,
    destiny-membership-id: option<s64>,
    destiny-membership-type: option<string>,
    friend-platform: option<s32>,
    platform-display-name: option<string>
  }

  get-friend-list: func() -> result<get-friend-list-response, string>;

  record issue-friend-request-params {
    /// The membership id of the user you wish to add.
    membership-id: string
  }
  issue-friend-request: func(params: issue-friend-request-params) -> result<issue-friend-request-response, string>;

  record remove-friend-params {
    /// The membership id of the user you wish to remove.
    membership-id: string
  }
  remove-friend: func(params: remove-friend-params) -> result<remove-friend-response, string>;

  get-friend-request-list: func() -> result<get-friend-request-list-response, string>;

  record accept-friend-request-params {
    /// The membership id of the user you wish to accept.
    membership-id: string
  }
  accept-friend-request: func(params: accept-friend-request-params) -> result<accept-friend-request-response, string>;

  record decline-friend-request-params {
    /// The membership id of the user you wish to decline.
    membership-id: string
  }
  decline-friend-request: func(params: decline-friend-request-params) -> result<decline-friend-request-response, string>;

  record remove-friend-request-params {
    /// The membership id of the user you wish to remove.
    membership-id: string
  }
  remove-friend-request: func(params: remove-friend-request-params) -> result<remove-friend-request-response, string>;

  record get-platform-friend-list-params {
    /// The platform friend type.
    friend-platform: string,
    /// The zero based page to return. Page size is 100.
    page: string
  }
  get-platform-friend-list: func(params: get-platform-friend-list-params) -> result<get-platform-friend-list-response, string>;

}

