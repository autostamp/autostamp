  }

  /// I know what you seek. You seek linked accounts. Found them, you have.
  /// This contract returns a minimal amount of data about Destiny Accounts that are linked through your Bungie.Net account. We will not return accounts in this response whose
  record destiny-responses-destiny-linked-profiles-response {
    /// If the requested membership had a linked Bungie.Net membership ID, this is the basic information about that BNet account.
    /// I know, Tetron; I know this is mixing UserServices concerns with DestinyServices concerns. But it's so damn convenient! https://www.youtube.com/watch?v=X5R-bB-gKVI
    bnet-membership: option<string>,
    /// Any Destiny account for whom we could successfully pull characters will be returned here, as the Platform-level summary of user data. (no character data, no Destiny account data other than the Membership ID and Type so you can make further queries)
    profiles: option<list<destiny-responses-destiny-profile-user-info-card>>,
    /// This is brief summary info for profiles that we believe have valid Destiny info, but who failed to return data for some other reason and thus we know that subsequent calls for their info will also fail.
    profiles-with-errors: option<list<destiny-responses-destiny-error-profile>>
  }

  record destiny-responses-destiny-profile-user-info-card {
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    date-last-played: option<string>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If true, this account is hooked up as the "Primary" cross save account for one or more platforms.
    is-cross-save-primary: option<bool>,
    /// If this profile is being overridden/obscured by Cross Save, this will be set to true. We will still return the profile for display purposes where users need to know the info: it is up to any given area of the app/site to determine if this profile should still be shown.
    is-overridden: option<bool>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// This is the silver available on this Profile across any platforms on which they have purchased silver.
    ///  This is only available if you are requesting yourself.
    platform-silver: option<string>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>,
    /// If this profile is not in a cross save pairing, this will return the game versions that we believe this profile has access to.
    ///  For the time being, we will not return this information for any membership that is in a cross save pairing. The gist is that, once the pairing occurs, we do not currently have a consistent way to get that information for the profile's original Platform, and thus gameVersions would be too inconsistent (based on the last platform they happened to play on) for the info to be useful.
    unpaired-game-versions: option<string>
  }

  /// If a Destiny Profile can't be returned, but we're pretty certain it's a valid Destiny account, this will contain as much info as we can get about the profile for your use.
  /// Assume that the most you'll get is the Error Code, the Membership Type and the Membership ID.
  record destiny-responses-destiny-error-profile {
    /// The error that we encountered. You should be able to look up localized text to show to the user for these failures.
    error-code: option<s32>,
    /// Basic info about the account that failed. Don't expect anything other than membership ID, Membership Type, and displayName to be populated.
    info-card: option<string>
  }

  equip-item: func() -> result<equip-item-response, string>;

  equip-items: func() -> result<equip-items-response, string>;

  insert-socket-plug: func() -> result<insert-socket-plug-response, string>;

  insert-socket-plug-free: func() -> result<insert-socket-plug-free-response, string>;

  pull-from-postmaster: func() -> result<pull-from-postmaster-response, string>;

  set-item-lock-state: func() -> result<set-item-lock-state-response, string>;

  set-quest-tracked-state: func() -> result<set-quest-tracked-state-response, string>;

  transfer-item: func() -> result<transfer-item-response, string>;

  clear-loadout: func() -> result<clear-loadout-response, string>;

  equip-loadout: func() -> result<equip-loadout-response, string>;

  snapshot-loadout: func() -> result<snapshot-loadout-response, string>;

  update-loadout-identifiers: func() -> result<update-loadout-identifiers-response, string>;

  record search-destiny-entities-params {
    /// Page number to return, starting with 0.
    page: option<s32>,
    /// The string to use when searching for Destiny entities.
    search-term: string,
    /// The type of entity for whom you would like results. These correspond to the entity's definition contract name. For instance, if you are looking for items, this property should be 'DestinyInventoryItemDefinition'.
    type-op: string
  }
  search-destiny-entities: func(params: search-destiny-entities-params) -> result<search-destiny-entities-response, string>;

  awa-provide-authorization-result: func() -> result<awa-provide-authorization-result-response, string>;

  record awa-get-action-token-params {
    /// The identifier for the advanced write action request.
    correlation-id: string
  }
  awa-get-action-token: func(params: awa-get-action-token-params) -> result<awa-get-action-token-response, string>;

  awa-initialize-request: func() -> result<awa-initialize-request-response, string>;

  get-clan-banner-source: func() -> result<get-clan-banner-source-response, string>;

  record get-clan-weekly-reward-state-params {
    /// A valid group id of clan.
    group-id: string
  }
  get-clan-weekly-reward-state: func(params: get-clan-weekly-reward-state-params) -> result<get-clan-weekly-reward-state-response, string>;

  get-destiny-manifest: func() -> result<get-destiny-manifest-response, string>;

  record get-destiny-entity-definition-params {
    /// The type of entity for whom you would like results. These correspond to the entity's definition contract name. For instance, if you are looking for items, this property should be 'DestinyInventoryItemDefinition'. PREVIEW: This endpoint is still in beta, and may experience rough edges. The schema is tentatively in final form, but there may be bugs that prevent desirable operation.
    entity-type: string,
    /// The hash identifier for the specific Entity you want returned.
    hash-identifier: string
  }
  get-destiny-entity-definition: func(params: get-destiny-entity-definition-params) -> result<get-destiny-entity-definition-response, string>;

  get-public-milestones: func() -> result<get-public-milestones-response, string>;

  record get-public-milestone-content-params {
    /// The identifier for the milestone to be returned.
    milestone-hash: string
  }
  get-public-milestone-content: func(params: get-public-milestone-content-params) -> result<get-public-milestone-content-response, string>;

  record search-destiny-player-by-bungie-name-params {
    /// A valid non-BungieNet membership type, or All. Indicates which memberships to return. You probably want this set to All.
    membership-type: string
  }
  search-destiny-player-by-bungie-name: func(params: search-destiny-player-by-bungie-name-params) -> result<search-destiny-player-by-bungie-name-response, string>;

  record get-clan-aggregate-stats-params {
    /// Group ID of the clan whose leaderboards you wish to fetch.
    group-id: string,
    /// List of game modes for which to get leaderboards. See the documentation for DestinyActivityModeType for valid values, and pass in string representation, comma delimited.
    modes: option<string>
  }
  get-clan-aggregate-stats: func(params: get-clan-aggregate-stats-params) -> result<get-clan-aggregate-stats-response, string>;

  get-historical-stats-definition: func() -> result<get-historical-stats-definition-response, string>;

  record get-clan-leaderboards-params {
    /// Group ID of the clan whose leaderboards you wish to fetch.
    group-id: string,
    /// Maximum number of top players to return. Use a large number to get entire leaderboard.
    maxtop: option<s32>,
    /// List of game modes for which to get leaderboards. See the documentation for DestinyActivityModeType for valid values, and pass in string representation, comma delimited.
    modes: option<string>,
    /// ID of stat to return rather than returning all Leaderboard stats.
    statid: option<string>
  }
  get-clan-leaderboards: func(params: get-clan-leaderboards-params) -> result<get-clan-leaderboards-response, string>;

  record get-leaderboards-for-character-params {
    /// The specific character to build the leaderboard around for the provided Destiny Membership.
    character-id: string,
    /// The Destiny membershipId of the user to retrieve.
    destiny-membership-id: string,
    /// Maximum number of top players to return. Use a large number to get entire leaderboard.
    maxtop: option<s32>,
    /// A valid non-BungieNet membership type.
    membership-type: string,
    /// List of game modes for which to get leaderboards. See the documentation for DestinyActivityModeType for valid values, and pass in string representation, comma delimited.
    modes: option<string>,
    /// ID of stat to return rather than returning all Leaderboard stats.
    statid: option<string>
  }
  get-leaderboards-for-character: func(params: get-leaderboards-for-character-params) -> result<get-leaderboards-for-character-response, string>;

  record get-post-game-carnage-report-params {
    /// The ID of the activity whose PGCR is requested.
    activity-id: string
  }
  get-post-game-carnage-report: func(params: get-post-game-carnage-report-params) -> result<get-post-game-carnage-report-response, string>;

  record report-offensive-post-game-carnage-report-player-params {
    /// The ID of the activity where you ran into the brigand that you're reporting.
    activity-id: string
  }
  report-offensive-post-game-carnage-report-player: func(params: report-offensive-post-game-carnage-report-player-params) -> result<report-offensive-post-game-carnage-report-player-response, string>;

  record get-public-vendors-params {
    /// A comma separated list of components to return (as strings or numeric values). See the DestinyComponentType enum for valid components to request. You must request at least one component to receive results.
    components: option<list<s32>>
  }
  get-public-vendors: func(params: get-public-vendors-params) -> result<get-public-vendors-response, string>;

  record get-historical-stats-params {
    /// The id of the character to retrieve. You can omit this character ID or set it to 0 to get aggregate stats across all characters.
    character-id: string,
    /// Last day to return when daily stats are requested. Use the format YYYY-MM-DD. Currently, we cannot allow more than 31 days of daily data to be requested in a single request.
    dayend: option<string>,
    /// First day to return when daily stats are requested. Use the format YYYY-MM-DD. Currently, we cannot allow more than 31 days of daily data to be requested in a single request.
    daystart: option<string>,
    /// The Destiny membershipId of the user to retrieve.
    destiny-membership-id: string,
    /// Group of stats to include, otherwise only general stats are returned. Comma separated list is allowed. Values: General, Weapons, Medals
    groups: option<list<s32>>,
    /// A valid non-BungieNet membership type.
    membership-type: string,
    /// Game modes to return. See the documentation for DestinyActivityModeType for valid values, and pass in string representation, comma delimited.
    modes: option<list<s32>>,
    /// Indicates a specific period type to return. Optional. May be: Daily, AllTime, or Activity
    period-type: option<s32>
  }
  get-historical-stats: func(params: get-historical-stats-params) -> result<get-historical-stats-response, string>;

  record get-activity-history-params {
    /// The id of the character to retrieve.
    character-id: string,
    /// Number of rows to return
    count: option<s32>,
    /// The Destiny membershipId of the user to retrieve.
    destiny-membership-id: string,
    /// A valid non-BungieNet membership type.
    membership-type: string,
    /// A filter for the activity mode to be returned. None returns all activities. See the documentation for DestinyActivityModeType for valid values, and pass in string representation.
    mode: option<s32>,
    /// Page number to return, starting with 0.
    page: option<s32>
  }
  get-activity-history: func(params: get-activity-history-params) -> result<get-activity-history-response, string>;

  record get-destiny-aggregate-activity-stats-params {
    /// The specific character whose activities should be returned.
    character-id: string,
    /// The Destiny membershipId of the user to retrieve.
    destiny-membership-id: string,
    /// A valid non-BungieNet membership type.
    membership-type: string
  }
  get-destiny-aggregate-activity-stats: func(params: get-destiny-aggregate-activity-stats-params) -> result<get-destiny-aggregate-activity-stats-response, string>;

  record get-unique-weapon-history-params {
    /// The id of the character to retrieve.
    character-id: string,
    /// The Destiny membershipId of the user to retrieve.
    destiny-membership-id: string,
    /// A valid non-BungieNet membership type.
    membership-type: string
  }
  get-unique-weapon-history: func(params: get-unique-weapon-history-params) -> result<get-unique-weapon-history-response, string>;

  record get-historical-stats-for-account-params {
    /// The Destiny membershipId of the user to retrieve.
    destiny-membership-id: string,
    /// Groups of stats to include, otherwise only general stats are returned. Comma separated list is allowed. Values: General, Weapons, Medals.
    groups: option<list<s32>>,
    /// A valid non-BungieNet membership type.
    membership-type: string
  }
  get-historical-stats-for-account: func(params: get-historical-stats-for-account-params) -> result<get-historical-stats-for-account-response, string>;

  record get-leaderboards-params {
    /// The Destiny membershipId of the user to retrieve.
    destiny-membership-id: string,
    /// Maximum number of top players to return. Use a large number to get entire leaderboard.
    maxtop: option<s32>,
    /// A valid non-BungieNet membership type.
    membership-type: string,
    /// List of game modes for which to get leaderboards. See the documentation for DestinyActivityModeType for valid values, and pass in string representation, comma delimited.
    modes: option<string>,
    /// ID of stat to return rather than returning all Leaderboard stats.
    statid: option<string>
  }
  get-leaderboards: func(params: get-leaderboards-params) -> result<get-leaderboards-response, string>;

  record get-profile-params {
    /// A comma separated list of components to return (as strings or numeric values). See the DestinyComponentType enum for valid components to request. You must request at least one component to receive results.
    components: option<list<s32>>,
    /// Destiny membership ID.
    destiny-membership-id: string,
    /// A valid non-BungieNet membership type.
    membership-type: string
  }
  get-profile: func(params: get-profile-params) -> result<get-profile-response, string>;

  record get-character-params {
    /// ID of the character.
    character-id: string,
    /// A comma separated list of components to return (as strings or numeric values). See the DestinyComponentType enum for valid components to request. You must request at least one component to receive results.
    components: option<list<s32>>,
    /// Destiny membership ID.
    destiny-membership-id: string,
    /// A valid non-BungieNet membership type.
    membership-type: string
  }
  get-character: func(params: get-character-params) -> result<get-character-response, string>;

  record get-collectible-node-details-params {
    /// The Destiny Character ID of the character for whom we're getting collectible detail info.
    character-id: string,
    /// The hash identifier of the Presentation Node for whom we should return collectible details. Details will only be returned for collectibles that are direct descendants of this node.
    collectible-presentation-node-hash: string,
    /// A comma separated list of components to return (as strings or numeric values). See the DestinyComponentType enum for valid components to request. You must request at least one component to receive results.
    components: option<list<s32>>,
    /// Destiny membership ID of another user. You may be denied.
    destiny-membership-id: string,
    /// A valid non-BungieNet membership type.
    membership-type: string
  }
  get-collectible-node-details: func(params: get-collectible-node-details-params) -> result<get-collectible-node-details-response, string>;

  record get-vendors-params {
    /// The Destiny Character ID of the character for whom we're getting vendor info.
    character-id: string,
    /// A comma separated list of components to return (as strings or numeric values). See the DestinyComponentType enum for valid components to request. You must request at least one component to receive results.
    components: option<list<s32>>,
    /// Destiny membership ID of another user. You may be denied.
    destiny-membership-id: string,
    /// The filter of what vendors and items to return, if any.
    filter: option<s32>,
    /// A valid non-BungieNet membership type.
    membership-type: string
  }
  get-vendors: func(params: get-vendors-params) -> result<get-vendors-response, string>;

  record get-vendor-params {
    /// The Destiny Character ID of the character for whom we're getting vendor info.
    character-id: string,
    /// A comma separated list of components to return (as strings or numeric values). See the DestinyComponentType enum for valid components to request. You must request at least one component to receive results.
    components: option<list<s32>>,
    /// Destiny membership ID of another user. You may be denied.
    destiny-membership-id: string,
    /// A valid non-BungieNet membership type.
    membership-type: string,
    /// The Hash identifier of the Vendor to be returned.
    vendor-hash: string
  }
  get-vendor: func(params: get-vendor-params) -> result<get-vendor-response, string>;

  record get-item-params {
    /// A comma separated list of components to return (as strings or numeric values). See the DestinyComponentType enum for valid components to request. You must request at least one component to receive results.
    components: option<list<s32>>,
    /// The membership ID of the destiny profile.
    destiny-membership-id: string,
    /// The Instance ID of the destiny item.
    item-instance-id: string,
    /// A valid non-BungieNet membership type.
    membership-type: string
  }
  get-item: func(params: get-item-params) -> result<get-item-response, string>;

  record get-linked-profiles-params {
    /// (optional) if set to 'true', all memberships regardless of whether they're obscured by overrides will be returned. Normal privacy restrictions on account linking will still apply no matter what.
    get-all-memberships: option<bool>,
    /// The ID of the membership whose linked Destiny accounts you want returned. Make sure your membership ID matches its Membership Type: don't pass us a PSN membership ID and the XBox membership type, it's not going to work!
    membership-id: string,
    /// The type for the membership whose linked Destiny accounts you want returned.
    membership-type: string
  }
  get-linked-profiles: func(params: get-linked-profiles-params) -> result<get-linked-profiles-response, string>;

}

interface fireteam {
  record get-active-private-clan-fireteam-count-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-active-private-clan-fireteam-count-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record get-active-private-clan-fireteam-count-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-available-clan-fireteams-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-available-clan-fireteams-response-message-data>,
    response: option<search-result-of-fireteam-summary>,
    throttle-seconds: option<s32>
  }

  record get-available-clan-fireteams-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record search-result-of-fireteam-summary {
    has-more: option<bool>,
    query: option<queries-paged-query>,
    replacement-continuation-token: option<string>,
    results: option<list<fireteam-summary>>,
    total-results: option<s32>,
    /// If useTotalResults is true, then totalResults represents an accurate count.
    /// If False, it does not, and may be estimated/only the size of the current page.
    use-total-results: option<bool>
  }

  record queries-paged-query {
    current-page: option<s32>,
    items-per-page: option<s32>,
    request-continuation-token: option<string>
  }

  record fireteam-summary {
    activity-type: option<s32>,
    alternate-slot-count: option<s32>,
    available-alternate-slot-count: option<s32>,
    available-player-slot-count: option<s32>,
    date-created: option<string>,
    date-modified: option<string>,
    date-player-modified: option<string>,
    fireteam-id: option<s64>,
    group-id: option<s64>,
    is-immediate: option<bool>,
    is-public: option<bool>,
    is-valid: option<bool>,
    locale: option<string>,
    owner-current-guardian-rank-snapshot: option<s32>,
    owner-highest-lifetime-guardian-rank-snapshot: option<s32>,
    owner-membership-id: option<s64>,
    owner-total-commendation-score-snapshot: option<s32>,
    platform: option<s32>,
    player-slot-count: option<s32>,
    scheduled-time: option<string>,
    title: option<string>,
    title-before-moderation: option<string>
  }

  record get-my-clan-fireteams-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-my-clan-fireteams-response-message-data>,
    response: option<search-result-of-fireteam-response>,
    throttle-seconds: option<s32>
  }

  record get-my-clan-fireteams-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record search-result-of-fireteam-response {
    has-more: option<bool>,
    query: option<queries-paged-query>,
    replacement-continuation-token: option<string>,
    results: option<list<fireteam-response>>,
    total-results: option<s32>,
    /// If useTotalResults is true, then totalResults represents an accurate count.
    /// If False, it does not, and may be estimated/only the size of the current page.
    use-total-results: option<bool>
  }

  record fireteam-response {
    alternates: option<list<fireteam-member>>,
    members: option<list<fireteam-member>>,
    summary: option<fireteam-summary>
  }

  record fireteam-member {
    bungie-net-user-info: option<user-user-info-card>,
    character-id: option<s64>,
    date-joined: option<string>,
    destiny-user-info: option<fireteam-user-info-card>,
    has-microphone: option<bool>,
    last-platform-invite-attempt-date: option<string>,
    last-platform-invite-attempt-result: option<s32>
  }

  /// This contract supplies basic information commonly used to display a minimal amount of information about a user. Take care to not add more properties here unless the property applies in all (or at least the majority) of the situations where UserInfoCard is used. Avoid adding game specific or platform specific details here. In cases where UserInfoCard is a subset of the data needed in a contract, use UserInfoCard as a property of other contracts.
  record user-user-info-card {
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record fireteam-user-info-card {
    fireteam-display-name: option<string>,
    fireteam-membership-type: option<s32>,
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record get-clan-fireteam-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-clan-fireteam-response-message-data>,
    response: option<fireteam-response>,
    throttle-seconds: option<s32>
  }

  record get-clan-fireteam-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record search-public-available-clan-fireteams-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<search-public-available-clan-fireteams-response-message-data>,
    response: option<search-result-of-fireteam-summary>,
    throttle-seconds: option<s32>
  }

  record search-public-available-clan-fireteams-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-active-private-clan-fireteam-count-params {
    /// The group id of the clan.
    group-id: string
  }
  get-active-private-clan-fireteam-count: func(params: get-active-private-clan-fireteam-count-params) -> result<get-active-private-clan-fireteam-count-response, string>;

  record get-available-clan-fireteams-params {
    /// The activity type to filter by.
    activity-type: string,
    /// The date range to grab available fireteams.
    date-range: string,
    /// If you wish the result to exclude immediate fireteams, set this to true. Immediate-only can be forced using the dateRange enum.
    exclude-immediate: option<bool>,
    /// The group id of the clan.
    group-id: string,
    /// An optional language filter.
    lang-filter: option<string>,
    /// Zero based page
    page: string,
    /// The platform filter.
    platform: string,
    /// Determines public/private filtering.
    public-only: string,
    /// Filters based on available slots
    slot-filter: string
  }
  get-available-clan-fireteams: func(params: get-available-clan-fireteams-params) -> result<get-available-clan-fireteams-response, string>;

  record get-my-clan-fireteams-params {
    /// If true, filter by clan. Otherwise, ignore the clan and show all of the user's fireteams.
    group-filter: option<bool>,
    /// The group id of the clan. (This parameter is ignored unless the optional query parameter groupFilter is true).
    group-id: string,
    /// If true, return fireteams that have been closed.
    include-closed: string,
    /// An optional language filter.
    lang-filter: option<string>,
    /// Deprecated parameter, ignored.
    page: string,
    /// The platform filter.
    platform: string
  }
  get-my-clan-fireteams: func(params: get-my-clan-fireteams-params) -> result<get-my-clan-fireteams-response, string>;

  record get-clan-fireteam-params {
    /// The unique id of the fireteam.
    fireteam-id: string,
    /// The group id of the clan.
    group-id: string
  }
  get-clan-fireteam: func(params: get-clan-fireteam-params) -> result<get-clan-fireteam-response, string>;

  record search-public-available-clan-fireteams-params {
    /// The activity type to filter by.
    activity-type: string,
    /// The date range to grab available fireteams.
    date-range: string,
    /// If you wish the result to exclude immediate fireteams, set this to true. Immediate-only can be forced using the dateRange enum.
    exclude-immediate: option<bool>,
    /// An optional language filter.
    lang-filter: option<string>,
    /// Zero based page
    page: string,
    /// The platform filter.
    platform: string,
    /// Filters based on available slots
    slot-filter: string
  }
  search-public-available-clan-fireteams: func(params: search-public-available-clan-fireteams-params) -> result<search-public-available-clan-fireteams-response, string>;

}

interface forum {
  record get-core-topics-paged-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-core-topics-paged-response-message-data>,
    response: option<post-search-response>,
    throttle-seconds: option<s32>
  }

  record get-core-topics-paged-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-search-response {
    authors: option<list<user-general-user>>,
    available-pages: option<s32>,
    groups: option<list<groups-v2-group-response>>,
    has-more: option<bool>,
    polls: option<list<poll-response>>,
    query: option<queries-paged-query>,
    recruitment-details: option<list<forum-recruitment-detail>>,
    related-posts: option<list<post-response>>,
    replacement-continuation-token: option<string>,
    results: option<list<post-response>>,
    searched-tags: option<list<tags-models-contracts-tag-response>>,
    total-results: option<s32>,
    /// If useTotalResults is true, then totalResults represents an accurate count.
    /// If False, it does not, and may be estimated/only the size of the current page.
    use-total-results: option<bool>
  }

  record user-general-user {
    about: option<string>,
    blizzard-display-name: option<string>,
    cached-bungie-global-display-name: option<string>,
    cached-bungie-global-display-name-code: option<s32>,
    context: option<user-user-to-user-context>,
    display-name: option<string>,
    egs-display-name: option<string>,
    fb-display-name: option<string>,
    first-access: option<string>,
    is-deleted: option<bool>,
    last-ban-report-id: option<s64>,
    last-update: option<string>,
    legacy-portal-uid: option<s64>,
    locale: option<string>,
    locale-inherit-default: option<bool>,
    membership-id: option<s64>,
    normalized-name: option<string>,
    profile-ban-expire: option<string>,
    profile-picture: option<s32>,
    profile-picture-path: option<string>,
    profile-picture-wide-path: option<string>,
    profile-theme: option<s32>,
    profile-theme-name: option<string>,
    psn-display-name: option<string>,
    show-activity: option<bool>,
    show-group-messaging: option<bool>,
    stadia-display-name: option<string>,
    status-date: option<string>,
    status-text: option<string>,
    steam-display-name: option<string>,
    success-message-flags: option<s64>,
    twitch-display-name: option<string>,
    unique-name: option<string>,
    user-title: option<s32>,
    user-title-display: option<string>,
    xbox-display-name: option<string>
  }

  record user-user-to-user-context {
    global-ignore-end-date: option<string>,
    ignore-status: option<ignores-ignore-response>,
    is-following: option<bool>
  }

  record ignores-ignore-response {
    ignore-flags: option<s32>,
    is-ignored: option<bool>
  }

  record groups-v2-group-response {
    alliance-status: option<s32>,
    allied-ids: option<list<s64>>,
    /// This property will be populated if the authenticated user is a member of the group. Note that because of account linking, a user can sometimes be part of a clan more than once. As such, this returns the highest member type available.
    current-user-member-map: option<groups-v2-group-response-current-user-member-map>,
    /// A convenience property that indicates if every membership you (the current user) have that is a part of this group are part of an account that is considered inactive - for example, overridden accounts in Cross Save.
    current-user-memberships-inactive-for-destiny: option<bool>,
    /// This property will be populated if the authenticated user is an applicant or has an outstanding invitation to join. Note that because of account linking, a user can sometimes be part of a clan more than once.
    current-user-potential-member-map: option<groups-v2-group-response-current-user-potential-member-map>,
    detail: option<groups-v2-group-v2>,
    founder: option<groups-v2-group-member>,
    group-join-invite-count: option<s32>,
    parent-group: option<groups-v2-group-v2>
  }

  /// This property will be populated if the authenticated user is a member of the group. Note that because of account linking, a user can sometimes be part of a clan more than once. As such, this returns the highest member type available.
  record groups-v2-group-response-current-user-member-map {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This property will be populated if the authenticated user is an applicant or has an outstanding invitation to join. Note that because of account linking, a user can sometimes be part of a clan more than once.
  record groups-v2-group-response-current-user-potential-member-map {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record groups-v2-group-v2 {
    about: option<string>,
    allow-chat: option<bool>,
    avatar-image-index: option<s32>,
    avatar-path: option<string>,
    ban-expire-date: option<string>,
    banner-path: option<string>,
    chat-security: option<s32>,
    clan-info: option<groups-v2-group-v2-clan-info-and-investment>,
    conversation-id: option<s64>,
    creation-date: option<string>,
    default-publicity: option<s32>,
    enable-invitation-messaging-for-admins: option<bool>,
    features: option<groups-v2-group-features>,
    group-id: option<s64>,
    group-type: option<s32>,
    homepage: option<s32>,
    is-default-post-public: option<bool>,
    is-public: option<bool>,
    is-public-topic-admin-only: option<bool>,
    locale: option<string>,
    member-count: option<s32>,
    membership-id-created: option<s64>,
    membership-option: option<s32>,
    modification-date: option<string>,
    motto: option<string>,
    name: option<string>,
    tags: option<list<string>>,
    theme: option<string>
  }

  /// The same as GroupV2ClanInfo, but includes any investment data.
  record groups-v2-group-v2-clan-info-and-investment {
    clan-banner-data: option<groups-v2-clan-banner>,
    clan-callsign: option<string>,
    d2-clan-progressions: option<groups-v2-group-v2-clan-info-and-investment-d2-clan-progressions>
  }

  record groups-v2-clan-banner {
    decal-background-color-id: option<s32>,
    decal-color-id: option<s32>,
    decal-id: option<s32>,
    gonfalon-color-id: option<s32>,
    gonfalon-detail-color-id: option<s32>,
    gonfalon-detail-id: option<s32>,
    gonfalon-id: option<s32>
  }

  record groups-v2-group-v2-clan-info-and-investment-d2-clan-progressions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record groups-v2-group-features {
    capabilities: option<s32>,
    /// Minimum Member Level allowed to host guided games
    /// Always Allowed: Founder, Acting Founder, Admin
    host-guided-game-permission-override: option<s32>,
    /// Minimum Member Level allowed to invite new members to group
    /// Always Allowed: Founder, Acting Founder
    invite-permission-override: option<bool>,
    /// Level to join a member at when accepting an invite, application, or joining an open clan
    /// Default is Beginner.
    join-level: option<s32>,
    maximum-members: option<s32>,
    /// Maximum number of groups of this type a typical membership may join. For example, a user may join about 50 General groups with their Bungie.net account. They may join one clan per Destiny membership.
    maximum-memberships-of-group-type: option<s32>,
    membership-types: option<list<s32>>,
    /// Minimum Member Level allowed to update banner
    /// Always Allowed: Founder, Acting Founder
    update-banner-permission-override: option<bool>,
    /// Minimum Member Level allowed to update group culture
    /// Always Allowed: Founder, Acting Founder
    update-culture-permission-override: option<bool>
  }

  record groups-v2-group-member {
    bungie-net-user-info: option<user-user-info-card>,
    destiny-user-info: option<groups-v2-group-user-info-card>,
    group-id: option<s64>,
    is-online: option<bool>,
    join-date: option<string>,
    last-online-status-change: option<s64>,
    member-type: option<s32>
  }

  /// This contract supplies basic information commonly used to display a minimal amount of information about a user. Take care to not add more properties here unless the property applies in all (or at least the majority) of the situations where UserInfoCard is used. Avoid adding game specific or platform specific details here. In cases where UserInfoCard is a subset of the data needed in a contract, use UserInfoCard as a property of other contracts.
  record user-user-info-card {
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record groups-v2-group-user-info-card {
    /// This will be the display name the clan server last saw the user as. If the account is an active cross save override, this will be the display name to use. Otherwise, this will match the displayName property.
    last-seen-display-name: option<string>,
    /// The platform of the LastSeenDisplayName
    last-seen-display-name-type: option<s32>,
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record poll-response {
    results: option<list<poll-result>>,
    topic-id: option<s64>,
    total-votes: option<s32>
  }

  record poll-result {
    answer-slot: option<s32>,
    answer-text: option<string>,
    last-vote-date: option<string>,
    requesting-user-voted: option<bool>,
    votes: option<s32>
  }

  record queries-paged-query {
    current-page: option<s32>,
    items-per-page: option<s32>,
    request-continuation-token: option<string>
  }

  record forum-recruitment-detail {
    fireteam: option<list<user-general-user>>,
    approved: option<bool>,
    conversation-id: option<s64>,
    intensity: option<s32>,
    kicked-player-ids: option<list<s64>>,
    microphone-required: option<bool>,
    player-slots-remaining: option<s32>,
    player-slots-total: option<s32>,
    tone: option<s32>,
    topic-id: option<s64>
  }

  record post-response {
    is-pinned: option<bool>,
    ignore-status: option<ignores-ignore-response>,
    is-active: option<bool>,
    is-announcement: option<bool>,
    last-reply-timestamp: option<string>,
    latest-reply-author-id: option<s64>,
    latest-reply-post-id: option<s64>,
    locale: option<string>,
    popularity: option<s32>,
    thumbnail: option<string>,
    url-media-type: option<s32>,
    user-has-muted-post: option<bool>,
    user-has-rated: option<bool>,
    user-rating: option<s32>
  }

  record tags-models-contracts-tag-response {
    ignore-status: option<ignores-ignore-response>,
    tag-text: option<string>
  }

  record get-forum-tag-suggestions-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-forum-tag-suggestions-response-message-data>,
    response: option<list<tags-models-contracts-tag-response>>,
    throttle-seconds: option<s32>
  }

  record get-forum-tag-suggestions-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-post-and-parent-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-post-and-parent-response-message-data>,
    response: option<post-search-response>,
    throttle-seconds: option<s32>
  }

  record get-post-and-parent-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-post-and-parent-awaiting-approval-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-post-and-parent-awaiting-approval-response-message-data>,
    response: option<post-search-response>,
    throttle-seconds: option<s32>
  }

  record get-post-and-parent-awaiting-approval-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-posts-threaded-paged-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-posts-threaded-paged-response-message-data>,
    response: option<post-search-response>,
    throttle-seconds: option<s32>
  }

  record get-posts-threaded-paged-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-posts-threaded-paged-from-child-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-posts-threaded-paged-from-child-response-message-data>,
    response: option<post-search-response>,
    throttle-seconds: option<s32>
  }

  record get-posts-threaded-paged-from-child-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-topic-for-content-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-topic-for-content-response-message-data>,
    response: option<s64>,
    throttle-seconds: option<s32>
  }

  record get-topic-for-content-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-topics-paged-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-topics-paged-response-message-data>,
    response: option<post-search-response>,
    throttle-seconds: option<s32>
  }

  record get-topics-paged-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-poll-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-poll-response-message-data>,
    response: option<post-search-response>,
    throttle-seconds: option<s32>
  }

  record get-poll-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-recruitment-thread-summaries-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-recruitment-thread-summaries-response-message-data>,
    response: option<list<forum-recruitment-detail>>,
    throttle-seconds: option<s32>
  }

  record get-recruitment-thread-summaries-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-core-topics-paged-params {
    /// The category filter.
    category-filter: string,
    /// Comma seperated list of locales posts must match to return in the result list. Default 'en'
    locales: option<string>,
    /// Zero base page
    page: string,
    /// The date filter.
    quick-date: string,
    /// The sort mode.
    sort: string
  }
  get-core-topics-paged: func(params: get-core-topics-paged-params) -> result<get-core-topics-paged-response, string>;

  record get-forum-tag-suggestions-params {
    /// The partial tag input to generate suggestions from.
    partialtag: option<string>
  }
  get-forum-tag-suggestions: func(params: get-forum-tag-suggestions-params) -> result<get-forum-tag-suggestions-response, string>;

  record get-post-and-parent-params {
    child-post-id: string,
    /// If this value is not null or empty, banned posts are requested to be returned
    showbanned: option<string>
  }
  get-post-and-parent: func(params: get-post-and-parent-params) -> result<get-post-and-parent-response, string>;

  record get-post-and-parent-awaiting-approval-params {
    child-post-id: string,
    /// If this value is not null or empty, banned posts are requested to be returned
    showbanned: option<string>
  }
  get-post-and-parent-awaiting-approval: func(params: get-post-and-parent-awaiting-approval-params) -> result<get-post-and-parent-awaiting-approval-response, string>;

  record get-posts-threaded-paged-params {
    get-parent-post: string,
    page: string,
    page-size: string,
    parent-post-id: string,
    reply-size: string,
    root-thread-mode: string,
    /// If this value is not null or empty, banned posts are requested to be returned
    showbanned: option<string>,
    sort-mode: string
  }
  get-posts-threaded-paged: func(params: get-posts-threaded-paged-params) -> result<get-posts-threaded-paged-response, string>;

  record get-posts-threaded-paged-from-child-params {
    child-post-id: string,
    page: string,
    page-size: string,
    reply-size: string,
    root-thread-mode: string,
    /// If this value is not null or empty, banned posts are requested to be returned
    showbanned: option<string>,
    sort-mode: string
  }
  get-posts-threaded-paged-from-child: func(params: get-posts-threaded-paged-from-child-params) -> result<get-posts-threaded-paged-from-child-response, string>;

  record get-topic-for-content-params {
    content-id: string
  }
  get-topic-for-content: func(params: get-topic-for-content-params) -> result<get-topic-for-content-response, string>;

  record get-topics-paged-params {
    /// A category filter
    category-filter: string,
    /// The group, if any.
    group: string,
    /// Comma seperated list of locales posts must match to return in the result list. Default 'en'
    locales: option<string>,
    /// Zero paged page number
    page: string,
    /// Unused
    page-size: string,
    /// A date filter.
    quick-date: string,
    /// The sort mode.
    sort: string,
    /// The tags to search, if any.
    tagstring: option<string>
  }
  get-topics-paged: func(params: get-topics-paged-params) -> result<get-topics-paged-response, string>;

  record get-poll-params {
    /// The post id of the topic that has the poll.
    topic-id: string
  }
  get-poll: func(params: get-poll-params) -> result<get-poll-response, string>;

  get-recruitment-thread-summaries: func() -> result<get-recruitment-thread-summaries-response, string>;

}

interface x {
