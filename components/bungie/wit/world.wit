  claim-partner-offer: func() -> result<claim-partner-offer-response, string>;

  force-drops-repair: func() -> result<force-drops-repair-response, string>;

  record get-partner-offer-sku-history-params {
    /// The partner application identifier.
    partner-application-id: string,
    /// The bungie.net user to apply missing offers to. If not self, elevated permissions are required.
    target-bnet-membership-id: string
  }
  get-partner-offer-sku-history: func(params: get-partner-offer-sku-history-params) -> result<get-partner-offer-sku-history-response, string>;

  record get-partner-reward-history-params {
    /// The partner application identifier.
    partner-application-id: string,
    /// The bungie.net user to return reward history for.
    target-bnet-membership-id: string
  }
  get-partner-reward-history: func(params: get-partner-reward-history-params) -> result<get-partner-reward-history-response, string>;

  get-bungie-rewards-list: func() -> result<get-bungie-rewards-list-response, string>;

  record get-bungie-rewards-for-platform-user-params {
    /// users platform membershipId for requested user rewards. If not self, elevated permissions are required.
    membership-id: string,
    /// The target Destiny 2 membership type.
    membership-type: string
  }
  get-bungie-rewards-for-platform-user: func(params: get-bungie-rewards-for-platform-user-params) -> result<get-bungie-rewards-for-platform-user-response, string>;

  record get-bungie-rewards-for-user-params {
    /// bungie.net user membershipId for requested user rewards. If not self, elevated permissions are required.
    membership-id: string
  }
  get-bungie-rewards-for-user: func(params: get-bungie-rewards-for-user-params) -> result<get-bungie-rewards-for-user-response, string>;

}

interface trending {
  record get-trending-categories-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-trending-categories-response-message-data>,
    response: option<trending-categories>,
    throttle-seconds: option<s32>
  }

  record get-trending-categories-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trending-categories {
    categories: option<list<trending-category>>
  }

  record trending-category {
    category-id: option<string>,
    category-name: option<string>,
    entries: option<search-result-of-trending-entry>
  }

  record search-result-of-trending-entry {
    has-more: option<bool>,
    query: option<queries-paged-query>,
    replacement-continuation-token: option<string>,
    results: option<list<trending-entry>>,
    total-results: option<s32>,
    /// If useTotalResults is true, then totalResults represents an accurate count.
    /// If False, it does not, and may be estimated/only the size of the current page.
    use-total-results: option<bool>
  }

  record queries-paged-query {
    current-page: option<s32>,
    items-per-page: option<s32>,
    request-continuation-token: option<string>
  }

  /// The list entry view for trending items. Returns just enough to show the item on the trending page.
  record trending-entry {
    /// If the entry has a date at which it was created, this is that date.
    creation-date: option<string>,
    /// The localized "display name/article title/'primary localized identifier'" of the entity.
    display-name: option<string>,
    end-date: option<string>,
    /// An enum - unfortunately - dictating all of the possible kinds of trending items that you might get in your result set, in case you want to do custom rendering or call to get the details of the item.
    entity-type: option<s32>,
    /// If isFeatured, this image will be populated with whatever the featured image is. Note that this will likely be a very large image, so don't use it all the time.
    feature-image: option<string>,
    /// We don't know whether the identifier will be a string, a uint, or a long... so we're going to cast it all to a string. But either way, we need any trending item created to have a single unique identifier for its type.
    identifier: option<string>,
    image: option<string>,
    is-featured: option<bool>,
    /// If the item is of entityType TrendingEntryType.Container, it may have items - also Trending Entries - contained within it. This is the ordered list of those to display under the Container's header.
    items: option<list<string>>,
    link: option<string>,
    /// If this is populated, the entry has a related MP4 video to show. I am 100% certain I am going to regret putting this directly on TrendingEntry, but it will work so yolo
    mp4-video: option<string>,
    start-date: option<string>,
    /// If the entity has a localized tagline/subtitle/motto/whatever, that is found here.
    tagline: option<string>,
    /// If this is populated, the entry has a related WebM video to show. I am 100% certain I am going to regret putting this directly on TrendingEntry, but it will work so yolo
    webm-video: option<string>,
    /// The weighted score of this trending item.
    weight: option<f64>
  }

  record get-trending-category-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-trending-category-response-message-data>,
    response: option<search-result-of-trending-entry>,
    throttle-seconds: option<s32>
  }

  record get-trending-category-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-trending-entry-detail-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-trending-entry-detail-response-message-data>,
    response: option<trending-detail>,
    throttle-seconds: option<s32>
  }

  record get-trending-entry-detail-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trending-detail {
    creation: option<trending-entry-community-creation>,
    destiny-activity: option<trending-entry-destiny-activity>,
    destiny-item: option<trending-entry-destiny-item>,
    destiny-ritual: option<trending-entry-destiny-ritual>,
    entity-type: option<s32>,
    identifier: option<string>,
    news: option<trending-entry-news>,
    support: option<trending-entry-support-article>
  }

  record trending-entry-community-creation {
    author: option<string>,
    author-membership-id: option<s64>,
    body: option<string>,
    media: option<string>,
    post-id: option<s64>,
    title: option<string>,
    upvotes: option<s32>
  }

  record trending-entry-destiny-activity {
    activity-hash: option<s32>,
    status: option<destiny-activities-destiny-public-activity-status>
  }

  /// Represents the public-facing status of an activity: any data about what is currently active in the Activity, regardless of an individual character's progress in it.
  record destiny-activities-destiny-public-activity-status {
    /// Active Challenges for the activity, if any - represented as hashes for DestinyObjectiveDefinitions.
    challenge-objective-hashes: option<list<s32>>,
    /// The active modifiers on this activity, if any - represented as hashes for DestinyActivityModifierDefinitions.
    modifier-hashes: option<list<s32>>,
    /// If the activity itself provides any specific "mock" rewards, this will be the items and their quantity.
    /// Why "mock", you ask? Because these are the rewards as they are represented in the tooltip of the Activity.
    reward-tooltip-items: option<list<destiny-destiny-item-quantity>>
  }

  /// Used in a number of Destiny contracts to return data about an item stack and its quantity. Can optionally return an itemInstanceId if the item is instanced - in which case, the quantity returned will be 1. If it's not... uh, let me know okay? Thanks.
  record destiny-destiny-item-quantity {
    /// Indicates that this item quantity may be conditionally shown or hidden, based on various sources of state. For example: server flags, account state, or character progress.
    has-conditional-visibility: option<bool>,
    /// The hash identifier for the item in question. Use it to look up the item's DestinyInventoryItemDefinition.
    item-hash: option<s32>,
    /// If this quantity is referring to a specific instance of an item, this will have the item's instance ID. Normally, this will be null.
    item-instance-id: option<s64>,
    /// The amount of the item needed/available depending on the context of where DestinyItemQuantity is being used.
    quantity: option<s32>
  }

  record trending-entry-destiny-item {
    item-hash: option<s32>
  }

  record trending-entry-destiny-ritual {
    date-end: option<string>,
    date-start: option<string>,
    /// A destiny event will not necessarily have milestone "custom content", but if it does the details will be here.
    event-content: option<string>,
    icon: option<string>,
    image: option<string>,
    /// A destiny event does not necessarily have a related Milestone, but if it does the details will be returned here.
    milestone-details: option<string>,
    subtitle: option<string>,
    title: option<string>
  }

  record trending-entry-news {
    article: option<content-content-item-public-contract>
  }

  record content-content-item-public-contract {
    allow-comments: option<bool>,
    author: option<user-general-user>,
    auto-english-property-fallback: option<bool>,
    c-type: option<string>,
    cms-path: option<string>,
    comment-summary: option<content-comment-summary>,
    content-id: option<s64>,
    creation-date: option<string>,
    has-age-gate: option<bool>,
    minimum-age: option<s32>,
    modify-date: option<string>,
    /// Firehose content is really a collection of metadata and "properties", which are the potentially-but-not-strictly localizable data that comprises the meat of whatever content is being shown.
    /// As Cole Porter would have crooned, "Anything Goes" with Firehose properties. They are most often strings, but they can theoretically be anything. They are JSON encoded, and could be JSON structures, simple strings, numbers etc... The Content Type of the item (cType) will describe the properties, and thus how they ought to be deserialized.
    properties: option<content-content-item-public-contract-properties>,
    rating-image-path: option<string>,
    representations: option<list<content-content-representation>>,
    /// NOTE: Tags will always be lower case.
    tags: option<list<string>>
  }

  record user-general-user {
    about: option<string>,
    blizzard-display-name: option<string>,
    cached-bungie-global-display-name: option<string>,
    cached-bungie-global-display-name-code: option<s32>,
    context: option<user-user-to-user-context>,
    display-name: option<string>,
    egs-display-name: option<string>,
    fb-display-name: option<string>,
    first-access: option<string>,
    is-deleted: option<bool>,
    last-ban-report-id: option<s64>,
    last-update: option<string>,
    legacy-portal-uid: option<s64>,
    locale: option<string>,
    locale-inherit-default: option<bool>,
    membership-id: option<s64>,
    normalized-name: option<string>,
    profile-ban-expire: option<string>,
    profile-picture: option<s32>,
    profile-picture-path: option<string>,
    profile-picture-wide-path: option<string>,
    profile-theme: option<s32>,
    profile-theme-name: option<string>,
    psn-display-name: option<string>,
    show-activity: option<bool>,
    show-group-messaging: option<bool>,
    stadia-display-name: option<string>,
    status-date: option<string>,
    status-text: option<string>,
    steam-display-name: option<string>,
    success-message-flags: option<s64>,
    twitch-display-name: option<string>,
    unique-name: option<string>,
    user-title: option<s32>,
    user-title-display: option<string>,
    xbox-display-name: option<string>
  }

  record user-user-to-user-context {
    global-ignore-end-date: option<string>,
    ignore-status: option<ignores-ignore-response>,
    is-following: option<bool>
  }

  record ignores-ignore-response {
    ignore-flags: option<s32>,
    is-ignored: option<bool>
  }

  record content-comment-summary {
    comment-count: option<s32>,
    topic-id: option<s64>
  }

  /// Firehose content is really a collection of metadata and "properties", which are the potentially-but-not-strictly localizable data that comprises the meat of whatever content is being shown.
  /// As Cole Porter would have crooned, "Anything Goes" with Firehose properties. They are most often strings, but they can theoretically be anything. They are JSON encoded, and could be JSON structures, simple strings, numbers etc... The Content Type of the item (cType) will describe the properties, and thus how they ought to be deserialized.
  record content-content-item-public-contract-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record content-content-representation {
    name: option<string>,
    path: option<string>,
    validation-string: option<string>
  }

  record trending-entry-support-article {
    article: option<content-content-item-public-contract>
  }

  get-trending-categories: func() -> result<get-trending-categories-response, string>;

  record get-trending-category-params {
    /// The ID of the category for whom you want additional results.
    category-id: string,
    /// The page # of results to return.
    page-number: string
  }
  get-trending-category: func(params: get-trending-category-params) -> result<get-trending-category-response, string>;

  record get-trending-entry-detail-params {
    /// The identifier for the entity to be returned.
    identifier: string,
    /// The type of entity to be returned.
    trending-entry-type: string
  }
  get-trending-entry-detail: func(params: get-trending-entry-detail-params) -> result<get-trending-entry-detail-response, string>;

}

interface user {
  record get-available-themes-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-available-themes-response-message-data>,
    response: option<list<config-user-theme>>,
    throttle-seconds: option<s32>
  }

  record get-available-themes-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record config-user-theme {
    user-theme-description: option<string>,
    user-theme-id: option<s32>,
    user-theme-name: option<string>
  }

  record get-bungie-net-user-by-id-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-bungie-net-user-by-id-response-message-data>,
    response: option<general-user>,
    throttle-seconds: option<s32>
  }

  record get-bungie-net-user-by-id-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record general-user {
    about: option<string>,
    blizzard-display-name: option<string>,
    cached-bungie-global-display-name: option<string>,
    cached-bungie-global-display-name-code: option<s32>,
    context: option<user-to-user-context>,
    display-name: option<string>,
    egs-display-name: option<string>,
    fb-display-name: option<string>,
    first-access: option<string>,
    is-deleted: option<bool>,
    last-ban-report-id: option<s64>,
    last-update: option<string>,
    legacy-portal-uid: option<s64>,
    locale: option<string>,
    locale-inherit-default: option<bool>,
    membership-id: option<s64>,
    normalized-name: option<string>,
    profile-ban-expire: option<string>,
    profile-picture: option<s32>,
    profile-picture-path: option<string>,
    profile-picture-wide-path: option<string>,
    profile-theme: option<s32>,
    profile-theme-name: option<string>,
    psn-display-name: option<string>,
    show-activity: option<bool>,
    show-group-messaging: option<bool>,
    stadia-display-name: option<string>,
    status-date: option<string>,
    status-text: option<string>,
    steam-display-name: option<string>,
    success-message-flags: option<s64>,
    twitch-display-name: option<string>,
    unique-name: option<string>,
    user-title: option<s32>,
    user-title-display: option<string>,
    xbox-display-name: option<string>
  }

  record user-to-user-context {
    global-ignore-end-date: option<string>,
    ignore-status: option<ignores-ignore-response>,
    is-following: option<bool>
  }

  record ignores-ignore-response {
    ignore-flags: option<s32>,
    is-ignored: option<bool>
  }

  record get-credential-types-for-target-account-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-credential-types-for-target-account-response-message-data>,
    response: option<list<models-get-credential-types-for-account-response>>,
    throttle-seconds: option<s32>
  }

  record get-credential-types-for-target-account-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record models-get-credential-types-for-account-response {
    credential-as-string: option<string>,
    credential-display-name: option<string>,
    credential-type: option<s32>,
    is-public: option<bool>
  }

  record get-membership-from-hard-linked-credential-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-membership-from-hard-linked-credential-response-message-data>,
    response: option<hard-linked-user-membership>,
    throttle-seconds: option<s32>
  }

  record get-membership-from-hard-linked-credential-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record hard-linked-user-membership {
    cross-save-overridden-membership-id: option<s64>,
    cross-save-overridden-type: option<s32>,
    membership-id: option<s64>,
    membership-type: option<s32>
  }

  record get-membership-data-by-id-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-membership-data-by-id-response-message-data>,
    response: option<user-membership-data>,
    throttle-seconds: option<s32>
  }

  record get-membership-data-by-id-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record user-membership-data {
    bungie-net-user: option<general-user>,
    /// this allows you to see destiny memberships that are visible and linked to this account (regardless of whether or not they have characters on the world server)
    destiny-memberships: option<list<groups-v2-group-user-info-card>>,
    /// If this property is populated, it will have the membership ID of the account considered to be "primary" in this user's cross save relationship.
    ///  If null, this user has no cross save relationship, nor primary account.
    primary-membership-id: option<s64>
  }

  record groups-v2-group-user-info-card {
    /// This will be the display name the clan server last saw the user as. If the account is an active cross save override, this will be the display name to use. Otherwise, this will match the displayName property.
    last-seen-display-name: option<string>,
    /// The platform of the LastSeenDisplayName
    last-seen-display-name-type: option<s32>,
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record get-membership-data-for-current-user-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-membership-data-for-current-user-response-message-data>,
    response: option<user-membership-data>,
    throttle-seconds: option<s32>
  }

  record get-membership-data-for-current-user-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-sanitized-platform-display-names-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-sanitized-platform-display-names-response-message-data>,
    response: option<get-sanitized-platform-display-names-response-response>,
    throttle-seconds: option<s32>
  }

  record get-sanitized-platform-display-names-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-sanitized-platform-display-names-response-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record search-by-global-name-post-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<search-by-global-name-post-response-message-data>,
    response: option<user-search-response>,
    throttle-seconds: option<s32>
  }

  record search-by-global-name-post-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record user-search-response {
    has-more: option<bool>,
    page: option<s32>,
    search-results: option<list<user-search-response-detail>>
  }

  record user-search-response-detail {
    bungie-global-display-name: option<string>,
    bungie-global-display-name-code: option<s32>,
    bungie-net-membership-id: option<s64>,
    destiny-memberships: option<list<user-info-card>>
  }

  /// This contract supplies basic information commonly used to display a minimal amount of information about a user. Take care to not add more properties here unless the property applies in all (or at least the majority) of the situations where UserInfoCard is used. Avoid adding game specific or platform specific details here. In cases where UserInfoCard is a subset of the data needed in a contract, use UserInfoCard as a property of other contracts.
  record user-info-card {
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record search-by-global-name-prefix-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<search-by-global-name-prefix-response-message-data>,
    response: option<user-search-response>,
    throttle-seconds: option<s32>
  }

  record search-by-global-name-prefix-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  get-available-themes: func() -> result<get-available-themes-response, string>;

  record get-bungie-net-user-by-id-params {
    /// The requested Bungie.net membership id.
    id: string
  }
  get-bungie-net-user-by-id: func(params: get-bungie-net-user-by-id-params) -> result<get-bungie-net-user-by-id-response, string>;

  record get-credential-types-for-target-account-params {
    /// The user's membership id
    membership-id: string
  }
  get-credential-types-for-target-account: func(params: get-credential-types-for-target-account-params) -> result<get-credential-types-for-target-account-response, string>;

  record get-membership-from-hard-linked-credential-params {
    /// The credential to look up. Must be a valid SteamID64.
    credential: string,
    /// The credential type. 'SteamId' is the only valid value at present.
    cr-type: string
  }
  get-membership-from-hard-linked-credential: func(params: get-membership-from-hard-linked-credential-params) -> result<get-membership-from-hard-linked-credential-response, string>;

  record get-membership-data-by-id-params {
    /// The membership ID of the target user.
    membership-id: string,
    /// Type of the supplied membership ID.
    membership-type: string
  }
  get-membership-data-by-id: func(params: get-membership-data-by-id-params) -> result<get-membership-data-by-id-response, string>;

  get-membership-data-for-current-user: func() -> result<get-membership-data-for-current-user-response, string>;

  record get-sanitized-platform-display-names-params {
    /// The requested membership id to load.
    membership-id: string
  }
  get-sanitized-platform-display-names: func(params: get-sanitized-platform-display-names-params) -> result<get-sanitized-platform-display-names-response, string>;

  record search-by-global-name-post-params {
    /// The zero-based page of results you desire.
    page: string
  }
  search-by-global-name-post: func(params: search-by-global-name-post-params) -> result<search-by-global-name-post-response, string>;

  record search-by-global-name-prefix-params {
    /// The display name prefix you're looking for.
    display-name-prefix: string,
    /// The zero-based page of results you desire.
    page: string
  }
  search-by-global-name-prefix: func(params: search-by-global-name-prefix-params) -> result<search-by-global-name-prefix-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export app;
  export community-content;
  export content;
  export destiny2;
  export fireteam;
  export forum;
  export x;
  export group-v2;
  export social;
  export tokens;
  export trending;
  export user;
}
