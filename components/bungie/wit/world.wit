    message-data: option<get-friend-request-list-response-message-data>,
    response: option<friends-bungie-friend-request-list-response>,
    throttle-seconds: option<s32>
  }

  record get-friend-request-list-response-message-data {
    /// JSON-encoded free-form object payload
