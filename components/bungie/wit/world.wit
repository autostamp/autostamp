    data: option<string>
  }

  record get-recommended-groups-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-recommended-groups-response-message-data>,
    response: option<list<groups-v2-group-v2-card>>,
    throttle-seconds: option<s32>
  }

  record get-recommended-groups-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A small infocard of group information, usually used for when a list of groups are returned
  record groups-v2-group-v2-card {
    about: option<string>,
    avatar-path: option<string>,
    capabilities: option<s32>,
    clan-info: option<groups-v2-group-v2-clan-info>,
    creation-date: option<string>,
    group-id: option<s64>,
    group-type: option<s32>,
    locale: option<string>,
    member-count: option<s32>,
    membership-option: option<s32>,
    motto: option<string>,
    name: option<string>,
    theme: option<string>
  }

  /// This contract contains clan-specific group information. It does not include any investment data.
  record groups-v2-group-v2-clan-info {
    clan-banner-data: option<groups-v2-clan-banner>,
    clan-callsign: option<string>
  }

  record recover-group-for-founder-response {
    detailed-error-trace: option<string>,
