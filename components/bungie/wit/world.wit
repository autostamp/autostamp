/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `oauth2` | `Authorization: Bearer <secret>` |
package autostamp:bungie@0.5.0;

interface app {
  record get-application-api-usage-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-application-api-usage-response-message-data>,
    response: option<applications-api-usage>,
    throttle-seconds: option<s32>
  }

  record get-application-api-usage-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record applications-api-usage {
    /// Counts for on API calls made for the time range.
    api-calls: option<list<applications-series>>,
    /// Instances of blocked requests or requests that crossed the warn threshold during the time range.
    throttled-requests: option<list<applications-series>>
  }

  record applications-series {
    /// Collection of samples with time and value.
    datapoints: option<list<applications-datapoint>>,
    /// Target to which to datapoints apply.
    target: option<string>
  }

  record applications-datapoint {
    /// Count associated with timestamp
    count: option<f64>,
    /// Timestamp for the related count.
    time: option<string>
  }

  record get-bungie-applications-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-bungie-applications-response-message-data>,
    response: option<list<applications-application>>,
    throttle-seconds: option<s32>
  }

  record get-bungie-applications-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record applications-application {
    /// Unique ID assigned to the application
    application-id: option<s32>,
    /// Date the application was first added to our database.
    creation-date: option<string>,
    /// Date the first time the application status entered the 'Public' status.
    first-published: option<string>,
    /// Link to website for the application where a user can learn more about the app.
    link: option<string>,
    /// Name of the application
    name: option<string>,
    /// Value of the Origin header sent in requests generated by this application.
    origin: option<string>,
    /// An optional override for the Authorize view name.
    override-authorize-view-name: option<string>,
    /// URL used to pass the user's authorization code to the application
    redirect-url: option<string>,
    /// Permissions the application needs to work
    scope: option<s64>,
    /// Current status of the application.
    status: option<s32>,
    /// Date the application status last changed.
    status-changed: option<string>,
    /// List of team members who manage this application on Bungie.net. Will always consist of at least the application owner.
    team: option<list<applications-application-developer>>
  }

  record applications-application-developer {
    api-eula-version: option<s32>,
    role: option<s32>,
    user: option<user-user-info-card>
  }

  /// This contract supplies basic information commonly used to display a minimal amount of information about a user. Take care to not add more properties here unless the property applies in all (or at least the majority) of the situations where UserInfoCard is used. Avoid adding game specific or platform specific details here. In cases where UserInfoCard is a subset of the data needed in a contract, use UserInfoCard as a property of other contracts.
  record user-user-info-card {
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record get-application-api-usage-params {
    /// ID of the application to get usage statistics.
    application-id: string,
    /// End time for query. Goes to now if not specified.
    end: option<string>,
    /// Start time for query. Goes to 24 hours ago if not specified.
    start: option<string>
  }
  get-application-api-usage: func(params: get-application-api-usage-params) -> result<get-application-api-usage-response, string>;

  get-bungie-applications: func() -> result<get-bungie-applications-response, string>;

}


interface community-content {
  record get-community-content-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-community-content-response-message-data>,
    response: option<forum-post-search-response>,
    throttle-seconds: option<s32>
  }

  record get-community-content-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record forum-post-search-response {
    authors: option<list<user-general-user>>,
    available-pages: option<s32>,
    groups: option<list<groups-v2-group-response>>,
    has-more: option<bool>,
    polls: option<list<forum-poll-response>>,
    query: option<queries-paged-query>,
    recruitment-details: option<list<forum-forum-recruitment-detail>>,
    related-posts: option<list<forum-post-response>>,
    replacement-continuation-token: option<string>,
    results: option<list<forum-post-response>>,
    searched-tags: option<list<tags-models-contracts-tag-response>>,
    total-results: option<s32>,
    /// If useTotalResults is true, then totalResults represents an accurate count.
    /// If False, it does not, and may be estimated/only the size of the current page.
    use-total-results: option<bool>
  }

  record user-general-user {
    about: option<string>,
    blizzard-display-name: option<string>,
    cached-bungie-global-display-name: option<string>,
    cached-bungie-global-display-name-code: option<s32>,
    context: option<user-user-to-user-context>,
    display-name: option<string>,
    egs-display-name: option<string>,
    fb-display-name: option<string>,
    first-access: option<string>,
    is-deleted: option<bool>,
    last-ban-report-id: option<s64>,
    last-update: option<string>,
    legacy-portal-uid: option<s64>,
    locale: option<string>,
    locale-inherit-default: option<bool>,
    membership-id: option<s64>,
    normalized-name: option<string>,
    profile-ban-expire: option<string>,
    profile-picture: option<s32>,
    profile-picture-path: option<string>,
    profile-picture-wide-path: option<string>,
    profile-theme: option<s32>,
    profile-theme-name: option<string>,
    psn-display-name: option<string>,
    show-activity: option<bool>,
    show-group-messaging: option<bool>,
    stadia-display-name: option<string>,
    status-date: option<string>,
    status-text: option<string>,
    steam-display-name: option<string>,
    success-message-flags: option<s64>,
    twitch-display-name: option<string>,
    unique-name: option<string>,
    user-title: option<s32>,
    user-title-display: option<string>,
    xbox-display-name: option<string>
  }

  record user-user-to-user-context {
    global-ignore-end-date: option<string>,
    ignore-status: option<ignores-ignore-response>,
    is-following: option<bool>
  }

  record ignores-ignore-response {
    ignore-flags: option<s32>,
    is-ignored: option<bool>
  }

  record groups-v2-group-response {
    alliance-status: option<s32>,
    allied-ids: option<list<s64>>,
    /// This property will be populated if the authenticated user is a member of the group. Note that because of account linking, a user can sometimes be part of a clan more than once. As such, this returns the highest member type available.
    current-user-member-map: option<groups-v2-group-response-current-user-member-map>,
    /// A convenience property that indicates if every membership you (the current user) have that is a part of this group are part of an account that is considered inactive - for example, overridden accounts in Cross Save.
    current-user-memberships-inactive-for-destiny: option<bool>,
    /// This property will be populated if the authenticated user is an applicant or has an outstanding invitation to join. Note that because of account linking, a user can sometimes be part of a clan more than once.
    current-user-potential-member-map: option<groups-v2-group-response-current-user-potential-member-map>,
    detail: option<groups-v2-group-v2>,
    founder: option<groups-v2-group-member>,
    group-join-invite-count: option<s32>,
    parent-group: option<groups-v2-group-v2>
  }

  /// This property will be populated if the authenticated user is a member of the group. Note that because of account linking, a user can sometimes be part of a clan more than once. As such, this returns the highest member type available.
  record groups-v2-group-response-current-user-member-map {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This property will be populated if the authenticated user is an applicant or has an outstanding invitation to join. Note that because of account linking, a user can sometimes be part of a clan more than once.
  record groups-v2-group-response-current-user-potential-member-map {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record groups-v2-group-v2 {
    about: option<string>,
    allow-chat: option<bool>,
    avatar-image-index: option<s32>,
    avatar-path: option<string>,
    ban-expire-date: option<string>,
    banner-path: option<string>,
    chat-security: option<s32>,
    clan-info: option<groups-v2-group-v2-clan-info-and-investment>,
    conversation-id: option<s64>,
    creation-date: option<string>,
    default-publicity: option<s32>,
    enable-invitation-messaging-for-admins: option<bool>,
    features: option<groups-v2-group-features>,
    group-id: option<s64>,
    group-type: option<s32>,
    homepage: option<s32>,
    is-default-post-public: option<bool>,
    is-public: option<bool>,
    is-public-topic-admin-only: option<bool>,
    locale: option<string>,
    member-count: option<s32>,
    membership-id-created: option<s64>,
    membership-option: option<s32>,
    modification-date: option<string>,
    motto: option<string>,
    name: option<string>,
    tags: option<list<string>>,
    theme: option<string>
  }

  /// The same as GroupV2ClanInfo, but includes any investment data.
  record groups-v2-group-v2-clan-info-and-investment {
    clan-banner-data: option<groups-v2-clan-banner>,
    clan-callsign: option<string>,
    d2-clan-progressions: option<groups-v2-group-v2-clan-info-and-investment-d2-clan-progressions>
  }

  record groups-v2-clan-banner {
    decal-background-color-id: option<s32>,
    decal-color-id: option<s32>,
    decal-id: option<s32>,
    gonfalon-color-id: option<s32>,
    gonfalon-detail-color-id: option<s32>,
    gonfalon-detail-id: option<s32>,
    gonfalon-id: option<s32>
  }

  record groups-v2-group-v2-clan-info-and-investment-d2-clan-progressions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record groups-v2-group-features {
    capabilities: option<s32>,
    /// Minimum Member Level allowed to host guided games
    /// Always Allowed: Founder, Acting Founder, Admin
    host-guided-game-permission-override: option<s32>,
    /// Minimum Member Level allowed to invite new members to group
    /// Always Allowed: Founder, Acting Founder
    invite-permission-override: option<bool>,
    /// Level to join a member at when accepting an invite, application, or joining an open clan
    /// Default is Beginner.
    join-level: option<s32>,
    maximum-members: option<s32>,
    /// Maximum number of groups of this type a typical membership may join. For example, a user may join about 50 General groups with their Bungie.net account. They may join one clan per Destiny membership.
    maximum-memberships-of-group-type: option<s32>,
    membership-types: option<list<s32>>,
    /// Minimum Member Level allowed to update banner
    /// Always Allowed: Founder, Acting Founder
    update-banner-permission-override: option<bool>,
    /// Minimum Member Level allowed to update group culture
    /// Always Allowed: Founder, Acting Founder
    update-culture-permission-override: option<bool>
  }

  record groups-v2-group-member {
    bungie-net-user-info: option<user-user-info-card>,
    destiny-user-info: option<groups-v2-group-user-info-card>,
    group-id: option<s64>,
    is-online: option<bool>,
    join-date: option<string>,
    last-online-status-change: option<s64>,
    member-type: option<s32>
  }

  /// This contract supplies basic information commonly used to display a minimal amount of information about a user. Take care to not add more properties here unless the property applies in all (or at least the majority) of the situations where UserInfoCard is used. Avoid adding game specific or platform specific details here. In cases where UserInfoCard is a subset of the data needed in a contract, use UserInfoCard as a property of other contracts.
  record user-user-info-card {
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record groups-v2-group-user-info-card {
    /// This will be the display name the clan server last saw the user as. If the account is an active cross save override, this will be the display name to use. Otherwise, this will match the displayName property.
    last-seen-display-name: option<string>,
    /// The platform of the LastSeenDisplayName
    last-seen-display-name-type: option<s32>,
    /// The list of Membership Types indicating the platforms on which this Membership can be used.
    ///  Not in Cross Save = its original membership type. Cross Save Primary = Any membership types it is overridding, and its original membership type Cross Save Overridden = Empty list
    applicable-membership-types: option<list<s32>>,
    /// The bungie global display name, if set.
    bungie-global-display-name: option<string>,
    /// The bungie global display name code, if set.
    bungie-global-display-name-code: option<s32>,
    /// If there is a cross save override in effect, this value will tell you the type that is overridding this one.
    cross-save-override: option<s32>,
    /// Display Name the player has chosen for themselves. The display name is optional when the data type is used as input to a platform API.
    display-name: option<string>,
    /// URL the Icon if available.
    icon-path: option<string>,
    /// If True, this is a public user membership.
    is-public: option<bool>,
    /// Membership ID as they user is known in the Accounts service
    membership-id: option<s64>,
    /// Type of the membership. Not necessarily the native type.
    membership-type: option<s32>,
    /// A platform specific additional display name - ex: psn Real Name, bnet Unique Name, etc.
    supplemental-display-name: option<string>
  }

  record forum-poll-response {
    results: option<list<forum-poll-result>>,
    topic-id: option<s64>,
    total-votes: option<s32>
  }

  record forum-poll-result {
    answer-slot: option<s32>,
    answer-text: option<string>,
    last-vote-date: option<string>,
    requesting-user-voted: option<bool>,
    votes: option<s32>
  }

  record queries-paged-query {
    current-page: option<s32>,
    items-per-page: option<s32>,
    request-continuation-token: option<string>
  }

  record forum-forum-recruitment-detail {
    fireteam: option<list<user-general-user>>,
    approved: option<bool>,
    conversation-id: option<s64>,
    intensity: option<s32>,
    kicked-player-ids: option<list<s64>>,
    microphone-required: option<bool>,
    player-slots-remaining: option<s32>,
    player-slots-total: option<s32>,
    tone: option<s32>,
    topic-id: option<s64>
  }

  record forum-post-response {
    is-pinned: option<bool>,
    ignore-status: option<ignores-ignore-response>,
    is-active: option<bool>,
    is-announcement: option<bool>,
    last-reply-timestamp: option<string>,
    latest-reply-author-id: option<s64>,
    latest-reply-post-id: option<s64>,
    locale: option<string>,
    popularity: option<s32>,
    thumbnail: option<string>,
    url-media-type: option<s32>,
    user-has-muted-post: option<bool>,
    user-has-rated: option<bool>,
    user-rating: option<s32>
  }

  record tags-models-contracts-tag-response {
    ignore-status: option<ignores-ignore-response>,
    tag-text: option<string>
  }

  record get-community-content-params {
    /// The type of media to get
    media-filter: string,
    /// Zero based page
    page: string,
    /// The sort mode.
    sort: string
  }
  get-community-content: func(params: get-community-content-params) -> result<get-community-content-response, string>;

}

interface content {
  record get-content-by-id-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-content-by-id-response-message-data>,
    response: option<content-item-public-contract>,
    throttle-seconds: option<s32>
  }

  record get-content-by-id-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record content-item-public-contract {
    allow-comments: option<bool>,
    author: option<user-general-user>,
    auto-english-property-fallback: option<bool>,
    c-type: option<string>,
    cms-path: option<string>,
    comment-summary: option<comment-summary>,
    content-id: option<s64>,
    creation-date: option<string>,
    has-age-gate: option<bool>,
    minimum-age: option<s32>,
    modify-date: option<string>,
    /// Firehose content is really a collection of metadata and "properties", which are the potentially-but-not-strictly localizable data that comprises the meat of whatever content is being shown.
    /// As Cole Porter would have crooned, "Anything Goes" with Firehose properties. They are most often strings, but they can theoretically be anything. They are JSON encoded, and could be JSON structures, simple strings, numbers etc... The Content Type of the item (cType) will describe the properties, and thus how they ought to be deserialized.
    properties: option<content-item-public-contract-properties>,
    rating-image-path: option<string>,
    representations: option<list<content-representation>>,
    /// NOTE: Tags will always be lower case.
    tags: option<list<string>>
  }

  record user-general-user {
    about: option<string>,
    blizzard-display-name: option<string>,
    cached-bungie-global-display-name: option<string>,
    cached-bungie-global-display-name-code: option<s32>,
    context: option<user-user-to-user-context>,
    display-name: option<string>,
    egs-display-name: option<string>,
    fb-display-name: option<string>,
    first-access: option<string>,
    is-deleted: option<bool>,
    last-ban-report-id: option<s64>,
    last-update: option<string>,
    legacy-portal-uid: option<s64>,
    locale: option<string>,
    locale-inherit-default: option<bool>,
    membership-id: option<s64>,
    normalized-name: option<string>,
    profile-ban-expire: option<string>,
    profile-picture: option<s32>,
    profile-picture-path: option<string>,
    profile-picture-wide-path: option<string>,
    profile-theme: option<s32>,
    profile-theme-name: option<string>,
    psn-display-name: option<string>,
    show-activity: option<bool>,
    show-group-messaging: option<bool>,
    stadia-display-name: option<string>,
    status-date: option<string>,
    status-text: option<string>,
    steam-display-name: option<string>,
    success-message-flags: option<s64>,
    twitch-display-name: option<string>,
    unique-name: option<string>,
    user-title: option<s32>,
    user-title-display: option<string>,
    xbox-display-name: option<string>
  }

  record user-user-to-user-context {
    global-ignore-end-date: option<string>,
    ignore-status: option<ignores-ignore-response>,
    is-following: option<bool>
  }

  record ignores-ignore-response {
    ignore-flags: option<s32>,
    is-ignored: option<bool>
  }

  record comment-summary {
    comment-count: option<s32>,
    topic-id: option<s64>
  }

  /// Firehose content is really a collection of metadata and "properties", which are the potentially-but-not-strictly localizable data that comprises the meat of whatever content is being shown.
  /// As Cole Porter would have crooned, "Anything Goes" with Firehose properties. They are most often strings, but they can theoretically be anything. They are JSON encoded, and could be JSON structures, simple strings, numbers etc... The Content Type of the item (cType) will describe the properties, and thus how they ought to be deserialized.
  record content-item-public-contract-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record content-representation {
    name: option<string>,
    path: option<string>,
    validation-string: option<string>
  }

  record get-content-by-tag-and-type-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-content-by-tag-and-type-response-message-data>,
    response: option<content-item-public-contract>,
    throttle-seconds: option<s32>
  }

  record get-content-by-tag-and-type-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-content-type-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-content-type-response-message-data>,
    response: option<models-content-type-description>,
    throttle-seconds: option<s32>
  }

  record get-content-type-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record models-content-type-description {
    allow-comments: option<bool>,
    auto-english-property-fallback: option<bool>,
    bind-identifier-to-property: option<string>,
    bound-regex: option<string>,
    bulk-uploadable: option<bool>,
    c-type: option<string>,
    content-description: option<string>,
    force-identifier-binding: option<bool>,
    name: option<string>,
    preview-image: option<string>,
    previews: option<list<models-content-preview>>,
    priority: option<s32>,
    properties: option<list<models-content-type-property>>,
    property-sections: option<list<models-content-type-property-section>>,
    reminder: option<string>,
    show-in-content-editor: option<bool>,
    suppress-cms-path: option<bool>,
    tag-metadata: option<list<models-tag-metadata-definition>>,
    tag-metadata-items: option<models-content-type-description-tag-metadata-items>,
    type-of: option<string>,
    usage-examples: option<list<string>>
  }

  record models-content-preview {
    item-in-set: option<bool>,
    name: option<string>,
    path: option<string>,
    set-nesting: option<s32>,
    set-tag: option<string>,
    use-set-id: option<s32>
  }

  record models-content-type-property {
    attributes: option<models-content-type-property-attributes>,
    bind-to-property: option<string>,
    bound-regex: option<string>,
    child-properties: option<list<string>>,
    content-type-allowed: option<string>,
    datatype: option<s32>,
    default-values: option<list<models-content-type-default-value>>,
    enabled: option<bool>,
    entitytype: option<string>,
    fallback: option<bool>,
    is-combo: option<bool>,
    is-external-allowed: option<bool>,
    is-image: option<bool>,
    is-title: option<bool>,
    is-video: option<bool>,
    legal-content-types: option<list<string>>,
    localizable: option<bool>,
    max-byte-length: option<s32>,
    max-file-size: option<s32>,
    max-height: option<s32>,
    max-length: option<s32>,
    max-width: option<s32>,
    min-height: option<s32>,
    min-width: option<s32>,
    name: option<string>,
    order: option<s32>,
    property-description: option<string>,
    property-section: option<string>,
    readable-name: option<string>,
    regexp: option<string>,
    representation-selection: option<models-content-type-property-representation-selection>,
    representation-validation-string: option<string>,
    required: option<bool>,
    root-property-name: option<string>,
    rss-attribute: option<string>,
    suppress-property: option<bool>,
    validate-as: option<string>,
    value: option<string>,
    visible: option<bool>,
    visible-dependency: option<string>,
    visible-on: option<string>,
    weight: option<s32>
  }

  record models-content-type-property-attributes {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record models-content-type-default-value {
    default-value: option<string>,
    when-clause: option<string>,
    when-value: option<string>
  }

  record models-content-type-property-representation-selection {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record models-content-type-property-section {
    collapsed: option<bool>,
    name: option<string>,
    readable-name: option<string>
  }

  record models-tag-metadata-definition {
    datatype: option<string>,
    description: option<string>,
    is-required: option<bool>,
    items: option<list<models-tag-metadata-item>>,
    name: option<string>,
    order: option<s32>
  }

  record models-tag-metadata-item {
    description: option<string>,
    groups: option<list<string>>,
    is-default: option<bool>,
    name: option<string>,
    tag-text: option<string>
  }

  record models-content-type-description-tag-metadata-items {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record rss-news-articles-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<rss-news-articles-response-message-data>,
    response: option<news-article-rss-response>,
    throttle-seconds: option<s32>
  }

  record rss-news-articles-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record news-article-rss-response {
    category-filter: option<string>,
    current-pagination-token: option<s32>,
    news-articles: option<list<news-article-rss-item>>,
    next-pagination-token: option<s32>,
    result-count-this-page: option<s32>
  }

  record news-article-rss-item {
    description: option<string>,
    html-content: option<string>,
    image-path: option<string>,
    link: option<string>,
    optional-mobile-image-path: option<string>,
    pub-date: option<string>,
    title: option<string>,
    unique-identifier: option<string>
  }

  record search-content-with-text-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<search-content-with-text-response-message-data>,
    response: option<search-result-of-content-item-public-contract>,
    throttle-seconds: option<s32>
  }

  record search-content-with-text-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record search-result-of-content-item-public-contract {
    has-more: option<bool>,
    query: option<queries-paged-query>,
    replacement-continuation-token: option<string>,
    results: option<list<content-item-public-contract>>,
    total-results: option<s32>,
    /// If useTotalResults is true, then totalResults represents an accurate count.
    /// If False, it does not, and may be estimated/only the size of the current page.
    use-total-results: option<bool>
  }

  record queries-paged-query {
    current-page: option<s32>,
    items-per-page: option<s32>,
    request-continuation-token: option<string>
  }

  record search-content-by-tag-and-type-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<search-content-by-tag-and-type-response-message-data>,
    response: option<search-result-of-content-item-public-contract>,
    throttle-seconds: option<s32>
  }

  record search-content-by-tag-and-type-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record search-help-articles-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<search-help-articles-response-message-data>,
    response: option<search-help-articles-response-response>,
    throttle-seconds: option<s32>
  }

  record search-help-articles-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record search-help-articles-response-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-content-by-id-params {
    /// false
    head: option<bool>,
    id: string,
    locale: string
  }
  get-content-by-id: func(params: get-content-by-id-params) -> result<get-content-by-id-response, string>;

  record get-content-by-tag-and-type-params {
    /// Not used.
    head: option<bool>,
    locale: string,
    tag: string,
    type-op: string
  }
  get-content-by-tag-and-type: func(params: get-content-by-tag-and-type-params) -> result<get-content-by-tag-and-type-response, string>;

  record get-content-type-params {
    type-op: string
  }
  get-content-type: func(params: get-content-type-params) -> result<get-content-type-response, string>;

  record rss-news-articles-params {
    /// Optionally filter response to only include news items in a certain category.
    categoryfilter: option<string>,
    /// Optionally include full content body for each news item.
    includebody: option<bool>,
    /// Zero-based pagination token for paging through result sets.
    page-token: string
  }
  rss-news-articles: func(params: rss-news-articles-params) -> result<rss-news-articles-response, string>;

  record search-content-with-text-params {
    /// Content type tag: Help, News, etc. Supply multiple ctypes separated by space.
    ctype: option<string>,
    /// Page number for the search results, starting with page 1.
    currentpage: option<s32>,
    /// Not used.
    head: option<bool>,
    locale: string,
    /// Word or phrase for the search.
    searchtext: option<string>,
    /// For analytics, hint at the part of the app that triggered the search. Optional.
    source: option<string>,
    /// Tag used on the content to be searched.
    tag: option<string>
  }
  search-content-with-text: func(params: search-content-with-text-params) -> result<search-content-with-text-response, string>;

  record search-content-by-tag-and-type-params {
    /// Page number for the search results starting with page 1.
    currentpage: option<s32>,
    /// Not used.
    head: option<bool>,
    /// Not used.
    itemsperpage: option<s32>,
    locale: string,
    tag: string,
    type-op: string
  }
  search-content-by-tag-and-type: func(params: search-content-by-tag-and-type-params) -> result<search-content-by-tag-and-type-response, string>;

  record search-help-articles-params {
    searchtext: string,
    size: string
  }
  search-help-articles: func(params: search-help-articles-params) -> result<search-help-articles-response, string>;

}

interface destiny2 {
  record equip-item-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<equip-item-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record equip-item-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record equip-items-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<equip-items-response-message-data>,
    response: option<destiny-destiny-equip-item-results>,
    throttle-seconds: option<s32>
  }

  record equip-items-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The results of a bulk Equipping operation performed through the Destiny API.
  record destiny-destiny-equip-item-results {
    equip-results: option<list<destiny-destiny-equip-item-result>>
  }

  /// The results of an Equipping operation performed through the Destiny API.
  record destiny-destiny-equip-item-result {
    /// A PlatformErrorCodes enum indicating whether it succeeded, and if it failed why.
    equip-status: option<s32>,
    /// The instance ID of the item in question (all items that can be equipped must, but definition, be Instanced and thus have an Instance ID that you can use to refer to them)
    item-instance-id: option<s64>
  }

  record insert-socket-plug-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<insert-socket-plug-response-message-data>,
    response: option<destiny-responses-destiny-item-change-response>,
    throttle-seconds: option<s32>
  }

  record insert-socket-plug-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record destiny-responses-destiny-item-change-response {
    /// Items that appeared in the inventory possibly as a result of an action.
    added-inventory-items: option<list<destiny-entities-items-destiny-item-component>>,
    item: option<destiny-responses-destiny-item-response>,
    /// Items that disappeared from the inventory possibly as a result of an action.
    removed-inventory-items: option<list<destiny-entities-items-destiny-item-component>>
  }

  /// The base item component, filled with properties that are generally useful to know in any item request or that don't feel worthwhile to put in their own component.
  record destiny-entities-items-destiny-item-component {
    /// If the item is bound to a location, it will be specified in this enum.
    bind-status: option<s32>,
    /// The hash identifier for the specific inventory bucket in which the item is located.
    bucket-hash: option<s32>,
    /// If the item can expire, this is the date at which it will/did expire.
    expiration-date: option<string>,
    /// If this is true, the object is actually a "wrapper" of the object it's representing. This means that it's not the actual item itself, but rather an item that must be "opened" in game before you have and can use the item.
    ///  Wrappers are an evolution of "bundles", which give an easy way to let you preview the contents of what you purchased while still letting you get a refund before you "open" it.
    is-wrapper: option<bool>,
    /// The identifier for the item's definition, which is where most of the useful static information for the item can be found.
    item-hash: option<s32>,
    /// If the item is instanced, it will have an instance ID. Lack of an instance ID implies that the item has no distinct local qualities aside from stack size.
    item-instance-id: option<s64>,
    /// If available, a list that describes which item values (rewards) should be shown (true) or hidden (false).
    item-value-visibility: option<list<bool>>,
    /// An easy reference for where the item is located. Redundant if you got the item from an Inventory, but useful when making detail calls on specific items.
    location: option<s32>,
    /// If the item can be locked, this will indicate that state.
    lockable: option<bool>,
    /// The identifier for the currently-selected metric definition, to be displayed on the emblem nameplate.
    metric-hash: option<s32>,
    /// The objective progress for the currently-selected metric definition, to be displayed on the emblem nameplate.
    metric-objective: option<string>,
    /// If populated, this is the hash of the item whose icon (and other secondary styles, but *not* the human readable strings) should override whatever icons/styles are on the item being sold.
    /// If you don't do this, certain items whose styles are being overridden by socketed items - such as the "Recycle Shader" item - would show whatever their default icon/style is, and it wouldn't be pretty or look accurate.
    override-style-item-hash: option<s32>,
    /// The quantity of the item in this stack. Note that Instanced items cannot stack. If an instanced item, this value will always be 1 (as the stack has exactly one item in it)
    quantity: option<s32>,
    /// A flags enumeration indicating the transient/custom states of the item that affect how it is rendered: whether it's tracked or locked for example, or whether it has a masterwork plug inserted.
    state: option<s32>,
    /// If this is populated, it is a list of indexes into DestinyInventoryItemDefinition.tooltipNotifications for any special tooltip messages that need to be shown for this item.
    tooltip-notification-indexes: option<list<s32>>,
    /// If there is a known error state that would cause this item to not be transferable, this Flags enum will indicate all of those error states. Otherwise, it will be 0 (CanTransfer).
    transfer-status: option<s32>,
    /// The version of this item, used to index into the versions list in the item definition quality block.
    version-number: option<s32>
  }

  /// The response object for retrieving an individual instanced item. None of these components are relevant for an item that doesn't have an "itemInstanceId": for those, get your information from the DestinyInventoryDefinition.
  record destiny-responses-destiny-item-response {
    /// If the item is on a character, this will return the ID of the character that is holding the item.
    character-id: option<s64>,
    /// Basic instance data for the item.
    /// COMPONENT TYPE: ItemInstances
    instance: option<string>,
    /// Common data for the item relevant to its non-instanced properties.
    /// COMPONENT TYPE: ItemCommonData
    item: option<string>,
    /// Information specifically about the item's objectives.
    /// COMPONENT TYPE: ItemObjectives
    objectives: option<string>,
    /// Information specifically about the perks currently active on the item.
    /// COMPONENT TYPE: ItemPerks
    perks: option<string>,
    /// Information about objectives on Plugs for a given item. See the component's documentation for more info.
    /// COMPONENT TYPE: ItemPlugObjectives
    plug-objectives: option<string>,
    /// Information about how to render the item in 3D.
    /// COMPONENT TYPE: ItemRenderData
    render-data: option<string>,
    /// Information about the Reusable Plugs for sockets on an item. These are plugs that you can insert into the given socket regardless of if you actually own an instance of that plug: they are logic-driven plugs rather than inventory-driven.
    ///  These may need to be combined with Plug Set component data to get a full picture of available plugs on a given socket.
    reusable-plugs: option<string>,
    /// Information about the sockets of the item: which are currently active, what potential sockets you could have and the stats/abilities/perks you can gain from them.
    /// COMPONENT TYPE: ItemSockets
    sockets: option<string>,
    /// Information about the computed stats of the item: power, defense, etc...
    /// COMPONENT TYPE: ItemStats
    stats: option<string>,
    /// Information about the talent grid attached to the item. Talent nodes can provide a variety of benefits and abilities, and in Destiny 2 are used almost exclusively for the character's "Builds".
    /// COMPONENT TYPE: ItemTalentGrids
    talent-grid: option<string>
  }

  record insert-socket-plug-free-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<insert-socket-plug-free-response-message-data>,
    response: option<destiny-responses-destiny-item-change-response>,
    throttle-seconds: option<s32>
  }

  record insert-socket-plug-free-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record pull-from-postmaster-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<pull-from-postmaster-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record pull-from-postmaster-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record set-item-lock-state-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<set-item-lock-state-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record set-item-lock-state-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record set-quest-tracked-state-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<set-quest-tracked-state-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record set-quest-tracked-state-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record transfer-item-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<transfer-item-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record transfer-item-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record clear-loadout-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<clear-loadout-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record clear-loadout-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record equip-loadout-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<equip-loadout-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record equip-loadout-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record snapshot-loadout-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<snapshot-loadout-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record snapshot-loadout-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record update-loadout-identifiers-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<update-loadout-identifiers-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record update-loadout-identifiers-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record search-destiny-entities-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<search-destiny-entities-response-message-data>,
    response: option<destiny-definitions-destiny-entity-search-result>,
    throttle-seconds: option<s32>
  }

  record search-destiny-entities-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The results of a search for Destiny content. This will be improved on over time, I've been doing some experimenting to see what might be useful.
  record destiny-definitions-destiny-entity-search-result {
    /// The items found that are matches/near matches for the searched-for term, sorted by something vaguely resembling "relevance". Hopefully this will get better in the future.
    results: option<string>,
    /// A list of suggested words that might make for better search results, based on the text searched for.
    suggested-words: option<list<string>>
  }

  record awa-provide-authorization-result-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<awa-provide-authorization-result-response-message-data>,
    response: option<s32>,
    throttle-seconds: option<s32>
  }

  record awa-provide-authorization-result-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record awa-get-action-token-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<awa-get-action-token-response-message-data>,
    response: option<destiny-advanced-awa-authorization-result>,
    throttle-seconds: option<s32>
  }

  record awa-get-action-token-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record destiny-advanced-awa-authorization-result {
    /// Credential used to prove the user authorized an advanced write action.
    action-token: option<string>,
    /// Message to the app developer to help understand the response.
    developer-note: option<string>,
    /// This token may be used to perform the requested action this number of times, at a maximum. If this value is 0, then there is no limit.
    maximum-number-of-uses: option<s32>,
    /// MembershipType from the permission request.
    membership-type: option<s32>,
    response-reason: option<s32>,
    /// Advanced Write Action Type from the permission request.
    type-op: option<s32>,
    /// Indication of how the user responded to the request. If the value is "Approved" the actionToken will contain the token that can be presented when performing the advanced write action.
    user-selection: option<s32>,
    /// Time, UTC, when token expires.
    valid-until: option<string>
  }

  record awa-initialize-request-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<awa-initialize-request-response-message-data>,
    response: option<destiny-advanced-awa-initialize-response>,
    throttle-seconds: option<s32>
  }

  record awa-initialize-request-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record destiny-advanced-awa-initialize-response {
    /// ID used to get the token. Present this ID to the user as it will identify this specific request on their device.
    correlation-id: option<string>,
    /// True if the PUSH message will only be sent to the device that made this request.
    sent-to-self: option<bool>
  }

  record get-clan-banner-source-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-clan-banner-source-response-message-data>,
    response: option<config-clan-banner-clan-banner-source>,
    throttle-seconds: option<s32>
  }

  record get-clan-banner-source-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record config-clan-banner-clan-banner-source {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-clan-weekly-reward-state-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-clan-weekly-reward-state-response-message-data>,
    response: option<destiny-milestones-destiny-milestone>,
    throttle-seconds: option<s32>
  }

  record get-clan-weekly-reward-state-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents a runtime instance of a user's milestone status. Live Milestone data should be combined with DestinyMilestoneDefinition data to show the user a picture of what is available for them to do in the game, and their status in regards to said "things to do." Consider it a big, wonky to-do list, or Advisors 3.0 for those who remember the Destiny 1 API.
  record destiny-milestones-destiny-milestone {
    /// The currently active Activities in this milestone, when the Milestone is driven by Challenges.
    /// Not all Milestones have Challenges, but when they do this will indicate the Activities and Challenges under those Activities related to this Milestone.
    activities: option<list<destiny-milestones-destiny-milestone-challenge-activity>>,
    /// Indicates what quests are available for this Milestone. Usually this will be only a single Quest, but some quests have multiple available that you can choose from at any given time. All possible quests for a milestone can be found in the DestinyMilestoneDefinition, but they must be combined with this Live data to determine which one(s) are actually active right now. It is possible for Milestones to not have any quests.
    available-quests: option<list<destiny-milestones-destiny-milestone-quest>>,
    /// If known, this is the date when the event will next end or repeat. It will only be populated for events with fixed and repeating start and end dates.
    end-date: option<string>,
    /// The unique identifier for the Milestone. Use it to look up the DestinyMilestoneDefinition, so you can combine the other data in this contract with static definition data.
    milestone-hash: option<s32>,
    /// Used for ordering milestones in a display to match how we order them in BNet. May pull from static data, or possibly in the future from dynamic information.
    order: option<s32>,
    /// If the entity to which this component is attached has known active Rewards for the player, this will detail information about those rewards, keyed by the RewardEntry Hash. (See DestinyMilestoneDefinition for more information about Reward Entries) Note that these rewards are not for the Quests related to the Milestone. Think of these as "overview/checklist" rewards that may be provided for Milestones that may provide rewards for performing a variety of tasks that aren't under a specific Quest.
    rewards: option<list<destiny-milestones-destiny-milestone-reward-category>>,
    /// If known, this is the date when the event last began or refreshed. It will only be populated for events with fixed and repeating start and end dates.
    start-date: option<string>,
    /// Milestones may have arbitrary key/value pairs associated with them, for data that users will want to know about but that doesn't fit neatly into any of the common components such as Quests. A good example of this would be - if this existed in Destiny 1 - the number of wins you currently have on your Trials of Osiris ticket. Looking in the DestinyMilestoneDefinition, you can use the string identifier of this dictionary to look up more info about the value, including localized string content for displaying the value. The value in the dictionary is the floating point number. The definition will tell you how to format this number.
    values: option<destiny-milestones-destiny-milestone-values>,
    /// A milestone may have one or more active vendors that are "related" to it (that provide rewards, or that are the initiators of the Milestone). I already regret this, even as I'm typing it. [I told you I'd regret this] You see, sometimes a milestone may be directly correlated with a set of vendors that provide varying tiers of rewards. The player may not be able to interact with one or more of those vendors. This will return the hashes of the Vendors that the player *can* interact with, allowing you to show their current inventory as rewards or related items to the Milestone or its activities.
    /// Before we even use it, it's already deprecated! How much of a bummer is that? We need more data.
    vendor-hashes: option<list<s32>>,
    /// Replaces vendorHashes, which I knew was going to be trouble the day it walked in the door. This will return not only what Vendors are active and relevant to the activity (in an implied order that you can choose to ignore), but also other data - for example, if the Vendor is featuring a specific item relevant to this event that you should show with them.
    vendors: option<list<destiny-milestones-destiny-milestone-vendor>>
  }

  record destiny-milestones-destiny-milestone-challenge-activity {
    activity-hash: option<s32>,
    /// The set of activity options for this activity, keyed by an identifier that's unique for this activity (not guaranteed to be unique between or across all activities, though should be unique for every *variant* of a given *conceptual* activity: for instance, the original D2 Raid has many variant DestinyActivityDefinitions. While other activities could potentially have the same option hashes, for any given D2 base Raid variant the hash will be unique).
    /// As a concrete example of this data, the hashes you get for Raids will correspond to the currently active "Challenge Mode".
    boolean-activity-options: option<destiny-milestones-destiny-milestone-challenge-activity-boolean-activity-options>,
    challenges: option<list<destiny-challenges-destiny-challenge-status>>,
    /// If returned, this is the index into the DestinyActivityDefinition's "loadouts" property, indicating the currently active loadout requirements.
    loadout-requirement-index: option<s32>,
    /// If the activity has modifiers, this will be the list of modifiers that all variants have in common. Perform lookups against DestinyActivityModifierDefinition which defines the modifier being applied to get at the modifier data.
    /// Note that, in the DestiyActivityDefinition, you will see many more modifiers than this being referred to: those are all *possible* modifiers for the activity, not the active ones. Use only the active ones to match what's really live.
    modifier-hashes: option<list<s32>>,
    /// If the Activity has discrete "phases" that we can track, that info will be here. Otherwise, this value will be NULL. Note that this is a list and not a dictionary: the order implies the ascending order of phases or progression in this activity.
    phases: option<list<destiny-milestones-destiny-milestone-activity-phase>>
  }

  /// The set of activity options for this activity, keyed by an identifier that's unique for this activity (not guaranteed to be unique between or across all activities, though should be unique for every *variant* of a given *conceptual* activity: for instance, the original D2 Raid has many variant DestinyActivityDefinitions. While other activities could potentially have the same option hashes, for any given D2 base Raid variant the hash will be unique).
  /// As a concrete example of this data, the hashes you get for Raids will correspond to the currently active "Challenge Mode".
  /// We don't have any human readable information for these, but saavy 3rd party app users could manually associate the key (a hash identifier for the "option" that is enabled/disabled) and the value (whether it's enabled or disabled presently)
  /// On our side, we don't necessarily even know what these are used for (the game designers know, but we don't), and we have no human readable data for them. In order to use them, you will have to do some experimentation.
  record destiny-milestones-destiny-milestone-challenge-activity-boolean-activity-options {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents the status and other related information for a challenge that is - or was - available to a player. 
  /// A challenge is a bonus objective, generally tacked onto Quests or Activities, that provide additional variations on play.
  record destiny-challenges-destiny-challenge-status {
    /// The progress - including completion status - of the active challenge.
    objective: option<string>
  }

  /// Represents whatever information we can return about an explicit phase in an activity. In the future, I hope we'll have more than just "guh, you done gone and did something," but for the forseeable future that's all we've got. I'm making it more than just a list of booleans out of that overly-optimistic hope.
  record destiny-milestones-destiny-milestone-activity-phase {
    /// Indicates if the phase has been completed.
    complete: option<bool>,
    /// In DestinyActivityDefinition, if the activity has phases, there will be a set of phases defined in the "insertionPoints" property. This is the hash that maps to that phase.
    phase-hash: option<s32>
  }

  /// If a Milestone has one or more Quests, this will contain the live information for the character's status with one of those quests.
  record destiny-milestones-destiny-milestone-quest {
    /// *IF* the Milestone has an active Activity that can give you greater details about what you need to do, it will be returned here. Remember to associate this with the DestinyMilestoneDefinition's activities to get details about the activity, including what specific quest it is related to if you have multiple quests to choose from.
    activity: option<string>,
    /// The activities referred to by this quest can have many associated challenges. They are all contained here, with activityHashes so that you can associate them with the specific activity variants in which they can be found. In retrospect, I probably should have put these under the specific Activity Variants, but it's too late to change it now. Theoretically, a quest without Activities can still have Challenges, which is why this is on a higher level than activity/variants, but it probably should have been in both places. That may come as a later revision.
    challenges: option<list<destiny-challenges-destiny-challenge-status>>,
    /// Quests are defined as Items in content. As such, this is the hash identifier of the DestinyInventoryItemDefinition that represents this quest. It will have pointers to all of the steps in the quest, and display information for the quest (title, description, icon etc) Individual steps will be referred to in the Quest item's DestinyInventoryItemDefinition.setData property, and themselves are Items with their own renderable data.
    quest-item-hash: option<s32>,
    /// The current status of the quest for the character making the request.
    status: option<string>
  }

  /// Represents a category of "summary" rewards that can be earned for the Milestone regardless of specific quest rewards that can be earned.
  record destiny-milestones-destiny-milestone-reward-category {
    /// The individual reward entries for this category, and their status.
    entries: option<list<destiny-milestones-destiny-milestone-reward-entry>>,
    /// Look up the relevant DestinyMilestoneDefinition, and then use rewardCategoryHash to look up the category info in DestinyMilestoneDefinition.rewards.
    reward-category-hash: option<s32>
  }

  /// The character-specific data for a milestone's reward entry. See DestinyMilestoneDefinition for more information about Reward Entries.
  record destiny-milestones-destiny-milestone-reward-entry {
    /// If TRUE, the player has earned this reward.
    earned: option<bool>,
    /// If TRUE, the player has redeemed/picked up/obtained this reward. Feel free to alias this to "gotTheShinyBauble" in your own codebase.
    redeemed: option<bool>,
    /// The identifier for the reward entry in question. It is important to look up the related DestinyMilestoneRewardEntryDefinition to get the static details about the reward, which you can do by looking up the milestone's DestinyMilestoneDefinition and examining the DestinyMilestoneDefinition.rewards[rewardCategoryHash].rewardEntries[rewardEntryHash] data.
    reward-entry-hash: option<s32>
  }

  /// Milestones may have arbitrary key/value pairs associated with them, for data that users will want to know about but that doesn't fit neatly into any of the common components such as Quests. A good example of this would be - if this existed in Destiny 1 - the number of wins you currently have on your Trials of Osiris ticket. Looking in the DestinyMilestoneDefinition, you can use the string identifier of this dictionary to look up more info about the value, including localized string content for displaying the value. The value in the dictionary is the floating point number. The definition will tell you how to format this number.
  record destiny-milestones-destiny-milestone-values {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// If a Milestone has one or more Vendors that are relevant to it, this will contain information about that vendor that you can choose to show.
  record destiny-milestones-destiny-milestone-vendor {
    /// If this vendor is featuring a specific item for this event, this will be the hash identifier of that item. I'm taking bets now on how long we go before this needs to be a list or some other, more complex representation instead and I deprecate this too. I'm going to go with 5 months. Calling it now, 2017-09-14 at 9:46pm PST.
    preview-item-hash: option<s32>,
    /// The hash identifier of the Vendor related to this Milestone. You can show useful things from this, such as thier Faction icon or whatever you might care about.
    vendor-hash: option<s32>
  }

  record get-destiny-manifest-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-destiny-manifest-response-message-data>,
    response: option<destiny-config-destiny-manifest>,
    throttle-seconds: option<s32>
  }

  record get-destiny-manifest-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// DestinyManifest is the external-facing contract for just the properties needed by those calling the Destiny Platform.
  record destiny-config-destiny-manifest {
    /// Information about the "Image Pyramid" for Destiny icons. Where possible, we create smaller versions of Destiny icons. These are found as subfolders under the location of the "original/full size" Destiny images, with the same file name and extension as the original image itself. (this lets us avoid sending largely redundant path info with every entity, at the expense of the smaller versions of the image being less discoverable)
    icon-image-pyramid-info: option<list<destiny-config-image-pyramid-entry>>,
    /// This points to the generated JSON that contains all the Definitions. Each key is a locale. The value is a dictionary, where the key is a definition type by name, and the value is the path to the file for that definition. WARNING: This is unsafe and subject to change - do not depend on data in these files staying around long-term.
    json-world-component-content-paths: option<destiny-config-destiny-manifest-json-world-component-content-paths>,
    /// This points to the generated JSON that contains all the Definitions. Each key is a locale. The value is a path to the aggregated world definitions (warning: large file!)
    json-world-content-paths: option<destiny-config-destiny-manifest-json-world-content-paths>,
    mobile-asset-content-path: option<string>,
    mobile-clan-banner-database-path: option<string>,
    mobile-gear-asset-data-bases: option<list<destiny-config-gear-asset-data-base-definition>>,
    mobile-gear-cdn: option<destiny-config-destiny-manifest-mobile-gear-cdn>,
    mobile-world-content-paths: option<destiny-config-destiny-manifest-mobile-world-content-paths>,
    version: option<string>
  }

  record destiny-config-image-pyramid-entry {
    /// The factor by which the original image size has been reduced.
    factor: option<f64>,
    /// The name of the subfolder where these images are located.
    name: option<string>
  }

  /// This points to the generated JSON that contains all the Definitions. Each key is a locale. The value is a dictionary, where the key is a definition type by name, and the value is the path to the file for that definition. WARNING: This is unsafe and subject to change - do not depend on data in these files staying around long-term.
  record destiny-config-destiny-manifest-json-world-component-content-paths {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This points to the generated JSON that contains all the Definitions. Each key is a locale. The value is a path to the aggregated world definitions (warning: large file!)
  record destiny-config-destiny-manifest-json-world-content-paths {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record destiny-config-gear-asset-data-base-definition {
    path: option<string>,
    version: option<s32>
  }

  record destiny-config-destiny-manifest-mobile-gear-cdn {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record destiny-config-destiny-manifest-mobile-world-content-paths {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-destiny-entity-definition-response {
    detailed-error-trace: option<string>,
    error-code: option<s32>,
    error-status: option<string>,
    message: option<string>,
    message-data: option<get-destiny-entity-definition-response-message-data>,
    response: option<destiny-definitions-destiny-definition>,
    throttle-seconds: option<s32>
  }

  record get-destiny-entity-definition-response-message-data {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Provides common properties for destiny definitions.
  record destiny-definitions-destiny-definition {
    /// The unique identifier for this entity. Guaranteed to be unique for the type of entity, but not globally.
    /// When entities refer to each other in Destiny content, it is this hash that they are referring to.
    hash: option<s32>,
    /// The index of the entity as it was found in the investment tables.
    index: option<s32>,
    /// If this is true, then there is an entity with this identifier/type combination, but BNet is not yet allowed to show it. Sorry!
    redacted: option<bool>
  }

  record get-public-milestones-response {
    detailed-error-trace: option<string>,
