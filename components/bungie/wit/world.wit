  record get-global-alerts-params {
    /// Determines whether Streaming Alerts are included in results
    includestreaming: option<bool>
  }
  get-global-alerts: func(params: get-global-alerts-params) -> result<get-global-alerts-response, string>;

  get-common-settings: func() -> result<get-common-settings-response, string>;

  get-user-system-overrides: func() -> result<get-user-system-overrides-response, string>;

}

interface group-v2 {
