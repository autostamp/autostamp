/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export calendars;
  export certifications;
  export checkin;
  export comments;
  export countries;
  export genres;
  export languages;
  export lists;
  export movies;
  export networks;
  export authentication-o-auth;
  export authentication-devices;
  export people;
  export recommendations;
  export scrobble;
  export search;
  export shows;
  export seasons;
  export episodes;
  export sync;
  export users;
}
