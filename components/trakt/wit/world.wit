  /// Get all season translations
  record get-all-season-translations-params {
    /// Trakt ID, Trakt slug, or IMDB ID
    id: string,
    /// season number
    season: string,
    /// 2 character language code
    language: string,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
