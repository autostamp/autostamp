interface checkin {
  record check-into-an-item-body-movie {
    ids: option<check-into-an-item-body-movie-ids>,
    title: option<string>,
    year: option<f64>
  }

  record check-into-an-item-body-movie-ids {
    imdb: option<string>,
    slug: option<string>,
    tmdb: option<f64>,
    trakt: option<f64>
  }

  record check-into-an-item-body-sharing {
    mastodon: option<bool>,
    tumblr: option<bool>,
    twitter: option<bool>
  }

  /// Check into an item
  record check-into-an-item-params {
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>,
    app-date: option<string>,
    app-version: option<string>,
    message: option<string>,
    movie: option<check-into-an-item-body-movie>,
    sharing: option<check-into-an-item-body-sharing>
  }
  check-into-an-item: func(params: check-into-an-item-params) -> result<string, string>;

  /// Delete any active checkins
  record delete-any-active-checkins-params {
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  delete-any-active-checkins: func(params: delete-any-active-checkins-params) -> result<string, string>;

}

interface comments {
  record post-a-comment-body-movie {
    ids: option<post-a-comment-body-movie-ids>,
    title: option<string>,
    year: option<f64>
  }

  record post-a-comment-body-movie-ids {
    imdb: option<string>,
    slug: option<string>,
    tmdb: option<f64>,
    trakt: option<f64>
  }

  record post-a-comment-body-sharing {
    medium: option<bool>,
    tumblr: option<bool>,
    twitter: option<bool>
  }

  /// Post a comment
  record post-a-comment-params {
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>,
    comment: option<string>,
    movie: option<post-a-comment-body-movie>,
    sharing: option<post-a-comment-body-sharing>,
    spoiler: option<bool>
  }
  post-a-comment: func(params: post-a-comment-params) -> result<string, string>;

  /// Get recently created comments
  record get-recently-created-comments-params {
    comment-type: string,
    type-op: string,
    /// include comment replies
    include-replies: option<string>,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-recently-created-comments: func(params: get-recently-created-comments-params) -> result<string, string>;

  /// Get trending comments
  record get-trending-comments-params {
    comment-type: string,
    type-op: string,
    /// include comment replies
    include-replies: option<string>,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-trending-comments: func(params: get-trending-comments-params) -> result<string, string>;

  /// Get recently updated comments
  record get-recently-updated-comments-params {
    comment-type: string,
    type-op: string,
    /// include comment replies
    include-replies: option<string>,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-recently-updated-comments: func(params: get-recently-updated-comments-params) -> result<string, string>;

  /// Get a comment or reply
  record get-a-comment-or-reply-params {
    /// A specific comment ID.
    id: string,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-a-comment-or-reply: func(params: get-a-comment-or-reply-params) -> result<string, string>;

  /// Update a comment or reply
  record update-a-comment-or-reply-params {
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>,
    /// Automatically added
    id: string,
    comment: option<string>,
    spoiler: option<bool>
  }
  update-a-comment-or-reply: func(params: update-a-comment-or-reply-params) -> result<string, string>;

  /// Delete a comment or reply
  record delete-a-comment-or-reply-params {
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>,
    /// Automatically added
    id: string
  }
  delete-a-comment-or-reply: func(params: delete-a-comment-or-reply-params) -> result<string, string>;

  /// Get the attached media item
  record get-the-attached-media-item-params {
    /// A specific comment ID.
    id: string,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-the-attached-media-item: func(params: get-the-attached-media-item-params) -> result<string, string>;

  /// Like a comment
  record like-a-comment-params {
    /// A specific comment ID.
    id: string,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  like-a-comment: func(params: like-a-comment-params) -> result<string, string>;

  /// Remove like on a comment
  record remove-like-on-a-comment-params {
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>,
    /// Automatically added
    id: string
  }
  remove-like-on-a-comment: func(params: remove-like-on-a-comment-params) -> result<string, string>;

  /// Get all users who liked a comment
  record get-all-users-who-liked-a-comment-params {
    /// A specific comment ID.
    id: string,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-all-users-who-liked-a-comment: func(params: get-all-users-who-liked-a-comment-params) -> result<string, string>;

  /// Get replies for a comment
  record get-replies-for-a-comment-params {
    /// A specific comment ID.
    id: string,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-replies-for-a-comment: func(params: get-replies-for-a-comment-params) -> result<string, string>;

  /// Post a reply for a comment
  record post-a-reply-for-a-comment-params {
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>,
    /// Automatically added
    id: string,
    comment: option<string>,
    spoiler: option<bool>
  }
  post-a-reply-for-a-comment: func(params: post-a-reply-for-a-comment-params) -> result<string, string>;

}

