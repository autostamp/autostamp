    /// Start the calendar on this date.
    start-date: string,
    /// Number of days to display.
    days: string,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-dvd-releases: func(params: get-dvd-releases-params) -> result<string, string>;

  /// Get movies
  record get-movies-params {
    /// Start the calendar on this date.
    start-date: string,
    /// Number of days to display.
    days: string,
    /// e.g. 2
    trakt-api-version: option<string>,
    /// e.g. [client_id]
    trakt-api-key: option<string>
  }
  get-movies: func(params: get-movies-params) -> result<string, string>;

  /// Get new shows
