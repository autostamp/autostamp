interface admin-conversations {
  /// Schema for successful response of admin.conversations.archive
  record archive-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  /// Schema for successful response of admin.conversations.convertToPrivate
  record convert-to-private-response {
    ok: defs-ok-true
  }

  /// Schema for successful response of admin.conversations.create
  record create-response {
    channel-id: option<defs-channel-id>,
    ok: defs-ok-true
  }

  record defs-channel-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Schema for successful response of admin.conversations.delete
  record delete-response {
    ok: defs-ok-true
  }

  /// Schema for successful response of admin.conversations.disconnectShared
  record disconnect-shared-response {
    ok: defs-ok-true
  }

  /// Schema for successful response of admin.conversations.getConversationPrefs
  record get-conversation-prefs-response {
    ok: defs-ok-true,
    prefs: option<get-conversation-prefs-response-prefs>
  }

  record get-conversation-prefs-response-prefs {
    can-thread: option<get-conversation-prefs-response-prefs-can-thread>,
    who-can-post: option<get-conversation-prefs-response-prefs-who-can-post>
  }

  record get-conversation-prefs-response-prefs-can-thread {
    type-op: option<list<string>>,
    user: option<list<string>>
  }

  record get-conversation-prefs-response-prefs-who-can-post {
    type-op: option<list<string>>,
    user: option<list<string>>
  }

  /// Schema for successful response of admin.conversations.getTeams
  record get-teams-response {
    ok: defs-ok-true,
    response-metadata: option<get-teams-response-response-metadata>,
    team-ids: list<defs-team>
  }

  record get-teams-response-response-metadata {
    next-cursor: string
  }

  record defs-team {
    /// opaque schema; raw JSON
    value: string
  }

  /// Schema for successful response of admin.conversations.invite
  record invite-response {
    ok: defs-ok-true
  }

  /// Schema for successful response of admin.conversations.rename
  record rename-response {
    ok: defs-ok-true
  }

  /// Schema for successful response of admin.conversations.search
  record search-response {
    channels: list<objs-channel>,
    next-cursor: string
  }

  record objs-channel {
    accepted-user: option<defs-user-id>,
    created: s32,
    creator: defs-user-id,
    id: defs-channel-id,
    is-archived: option<bool>,
    is-channel: bool,
    is-frozen: option<bool>,
    is-general: option<bool>,
    is-member: option<bool>,
    is-moved: option<s32>,
    is-mpim: bool,
    is-non-threadable: option<bool>,
    is-org-shared: bool,
    is-pending-ext-shared: option<bool>,
    is-private: bool,
    is-read-only: option<bool>,
    is-shared: bool,
    is-thread-only: option<bool>,
    last-read: option<defs-ts>,
    latest: option<string>,
    members: list<defs-user-id>,
    name: string,
    name-normalized: string,
    num-members: option<s32>,
    pending-shared: option<list<defs-team>>,
    previous-names: option<list<defs-channel-name>>,
    priority: option<f64>,
    purpose: objs-channel-purpose,
    topic: objs-channel-topic,
    unlinked: option<s32>,
    unread-count: option<s32>,
    unread-count-display: option<s32>
  }

  record defs-user-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-ts {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-channel-name {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-channel-purpose {
    creator: defs-topic-purpose-creator,
    last-set: s32,
    value: string
  }

  record defs-topic-purpose-creator {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-channel-topic {
    creator: defs-topic-purpose-creator,
    last-set: s32,
    value: string
  }

  /// Schema for successful response of admin.conversations.setConversationPrefs
  record set-conversation-prefs-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record set-teams-response {
    ok: defs-ok-true
  }

  /// Schema for successful response of admin.conversations.unarchive
  record unarchive-response {
    ok: defs-ok-true
  }

  record archive-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The channel to archive.
    channel-id: string
  }
  archive: func(params: archive-params) -> result<archive-response, string>;

  record convert-to-private-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The channel to convert to private.
    channel-id: string
  }
  convert-to-private: func(params: convert-to-private-params) -> result<convert-to-private-response, string>;

  record create-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// Description of the public or private channel to create.
    description: option<string>,
    /// When `true`, creates a private channel instead of a public channel
    is-private: bool,
    /// Name of the public or private channel to create.
    name: string,
    /// When `true`, the channel will be available org-wide. Note: if the channel is not `org_wide=true`, you must specify a `team_id` for this channel
    org-wide: option<bool>,
    /// The workspace to create the channel in. Note: this argument is required unless you set `org_wide=true`.
    team-id: option<string>
  }
  create: func(params: create-params) -> result<create-response, string>;

  record delete-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The channel to delete.
    channel-id: string
  }
  delete: func(params: delete-params) -> result<delete-response, string>;

  record disconnect-shared-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The channel to be disconnected from some workspaces.
    channel-id: string,
    /// The team to be removed from the channel. Currently only a single team id can be specified.
    leaving-team-ids: option<string>
  }
  disconnect-shared: func(params: disconnect-shared-params) -> result<disconnect-shared-response, string>;

  record get-conversation-prefs-params {
    /// Authentication token. Requires scope: `admin.conversations:read`
    token: string,
    /// The channel to get preferences for.
    channel-id: string
  }
  get-conversation-prefs: func(params: get-conversation-prefs-params) -> result<get-conversation-prefs-response, string>;

  record get-teams-params {
    /// Authentication token. Requires scope: `admin.conversations:read`
    token: string,
    /// The channel to determine connected workspaces within the organization for.
    channel-id: string,
    /// Set `cursor` to `next_cursor` returned by the previous call to list items in the next page
    cursor: option<string>,
    /// The maximum number of items to return. Must be between 1 - 1000 both inclusive.
    limit: option<s32>
  }
  get-teams: func(params: get-teams-params) -> result<get-teams-response, string>;

  record invite-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The channel that the users will be invited to.
    channel-id: string,
    /// The users to invite.
    user-ids: string
  }
  invite: func(params: invite-params) -> result<invite-response, string>;

  record rename-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The channel to rename.
    channel-id: string,
    name: string
  }
  rename: func(params: rename-params) -> result<rename-response, string>;

  record search-params {
    /// Authentication token. Requires scope: `admin.conversations:read`
    token: string,
    /// Comma separated string of team IDs, signifying the workspaces to search through.
    team-ids: option<string>,
    /// Name of the the channel to query by.
    query: option<string>,
    /// Maximum number of items to be returned. Must be between 1 - 20 both inclusive. Default is 10.
    limit: option<s32>,
    /// Set `cursor` to `next_cursor` returned by the previous call to list items in the next page.
    cursor: option<string>,
    /// The type of channel to include or exclude in the search. For example `private` will search private channels, while `private_exclude` will exclude them. For a full list of types, check the [Types section](#types).
    search-channel-types: option<string>,
    /// Possible values are `relevant` (search ranking based on what we think is closest), `name` (alphabetical), `member_count` (number of users in the channel), and `created` (date channel was created). You can optionally pair this with the `sort_dir` arg to change how it is sorted 
    sort: option<string>,
    /// Sort direction. Possible values are `asc` for ascending order like (1, 2, 3) or (a, b, c), and `desc` for descending order like (3, 2, 1) or (c, b, a)
    sort-dir: option<string>
  }
  search: func(params: search-params) -> result<search-response, string>;

  record set-conversation-prefs-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The channel to set the prefs for
    channel-id: string,
    /// The prefs for this channel in a stringified JSON format.
    prefs: string
  }
  set-conversation-prefs: func(params: set-conversation-prefs-params) -> result<set-conversation-prefs-response, string>;

  record set-teams-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The encoded `channel_id` to add or remove to workspaces.
    channel-id: string,
    /// True if channel has to be converted to an org channel
    org-channel: option<bool>,
    /// A comma-separated list of workspaces to which the channel should be shared. Not required if the channel is being shared org-wide.
    target-team-ids: option<string>,
    /// The workspace to which the channel belongs. Omit this argument if the channel is a cross-workspace shared channel.
    team-id: option<string>
  }
  set-teams: func(params: set-teams-params) -> result<set-teams-response, string>;

  record unarchive-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string,
    /// The channel to unarchive.
    channel-id: string
  }
  unarchive: func(params: unarchive-params) -> result<unarchive-response, string>;

}

interface admin-conversations-ekm {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record list-original-connected-channel-info-response {
