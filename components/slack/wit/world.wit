    limit: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  record remove-params {
    /// Authentication token. Requires scope: `reactions:write`
    token: string,
    /// Channel where the message to remove reaction from was posted.
    channel: option<string>,
    /// File to remove reaction from.
    file: option<string>,
    /// File comment to remove reaction from.
    file-comment: option<string>,
    /// Reaction (emoji) name.
    name: string,
    /// Timestamp of the message to remove reaction from.
    timestamp: option<string>
  }
  remove: func(params: remove-params) -> result<remove-response, string>;

}

interface reminders {
