  }
  delete: func(params: delete-params) -> result<delete-response, string>;

  record info-params {
    /// Authentication token. Requires scope: `reminders:read`
    token: option<string>,
    /// The ID of the reminder
    reminder: option<string>
  }
  info: func(params: info-params) -> result<info-response, string>;

  record list-op-params {
    /// Authentication token. Requires scope: `reminders:read`
    token: option<string>
