  }
  list-original-connected-channel-info: func(params: list-original-connected-channel-info-params) -> result<list-original-connected-channel-info-response, string>;

}

interface admin-conversations-restrict-access {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record add-group-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record list-groups-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record remove-group-response {
    ok: defs-ok-true
  }

  record add-group-params {
    /// The channel to link this group to.
    channel-id: string,
    /// The [IDP Group](https://slack.com/help/articles/115001435788-Connect-identity-provider-groups-to-your-Enterprise-Grid-org) ID to be an allowlist for the private channel.
    group-id: string,
    /// The workspace where the channel exists. This argument is required for channels only tied to one workspace, and optional for channels that are shared across an organization.
    team-id: option<string>,
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  add-group: func(params: add-group-params) -> result<add-group-response, string>;

  record list-groups-params {
    /// Authentication token. Requires scope: `admin.conversations:read`
    token: string,
    channel-id: string,
    /// The workspace where the channel exists. This argument is required for channels only tied to one workspace, and optional for channels that are shared across an organization.
    team-id: option<string>
  }
  list-groups: func(params: list-groups-params) -> result<list-groups-response, string>;

  record remove-group-params {
    /// The channel to remove the linked group from.
    channel-id: string,
    /// The [IDP Group](https://slack.com/help/articles/115001435788-Connect-identity-provider-groups-to-your-Enterprise-Grid-org) ID to remove from the private channel.
    group-id: string,
    /// The workspace where the channel exists. This argument is required for channels only tied to one workspace, and optional for channels that are shared across an organization.
    team-id: string,
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  remove-group: func(params: remove-group-params) -> result<remove-group-response, string>;

}

interface admin-emoji {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record add-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record add-alias-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record list-op-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record remove-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record rename-response {
    ok: defs-ok-true
  }

  record add-params {
    /// The name of the emoji to be removed. Colons (`:myemoji:`) around the value are not required, although they may be included.
    name: string,
    /// Authentication token. Requires scope: `admin.teams:write`
    token: string,
    /// The URL of a file to use as an image for the emoji. Square images under 128KB and with transparent backgrounds work best.
    url: string
  }
  add: func(params: add-params) -> result<add-response, string>;

  record add-alias-params {
    /// The alias of the emoji.
    alias-for: string,
    /// The name of the emoji to be aliased. Colons (`:myemoji:`) around the value are not required, although they may be included.
    name: string,
    /// Authentication token. Requires scope: `admin.teams:write`
    token: string
  }
  add-alias: func(params: add-alias-params) -> result<add-alias-response, string>;

  record list-op-params {
    /// Authentication token. Requires scope: `admin.teams:read`
    token: string,
    /// Set `cursor` to `next_cursor` returned by the previous call to list items in the next page
    cursor: option<string>,
    /// The maximum number of items to return. Must be between 1 - 1000 both inclusive.
    limit: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  record remove-params {
    /// The name of the emoji to be removed. Colons (`:myemoji:`) around the value are not required, although they may be included.
    name: string,
    /// Authentication token. Requires scope: `admin.teams:write`
    token: string
  }
  remove: func(params: remove-params) -> result<remove-response, string>;

  record rename-params {
    /// The name of the emoji to be renamed. Colons (`:myemoji:`) around the value are not required, although they may be included.
    name: string,
    /// The new name of the emoji.
    new-name: string,
    /// Authentication token. Requires scope: `admin.teams:write`
    token: string
  }
  rename: func(params: rename-params) -> result<rename-response, string>;

}

