  admin-apps-restricted-list: func(params: admin-apps-restricted-list-params) -> result<string, string>;

}

interface admin-conversations {
  record admin-conversations-archive-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-archive: func(params: admin-conversations-archive-params) -> result<string, string>;

  record admin-conversations-convert-to-private-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-convert-to-private: func(params: admin-conversations-convert-to-private-params) -> result<string, string>;

  record admin-conversations-create-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-create: func(params: admin-conversations-create-params) -> result<string, string>;

  record admin-conversations-delete-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-delete: func(params: admin-conversations-delete-params) -> result<string, string>;

  record admin-conversations-disconnect-shared-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-disconnect-shared: func(params: admin-conversations-disconnect-shared-params) -> result<string, string>;

  record admin-conversations-get-conversation-prefs-params {
    /// Authentication token. Requires scope: `admin.conversations:read`
    token: string,
    /// The channel to get preferences for.
    channel-id: string
  }
  admin-conversations-get-conversation-prefs: func(params: admin-conversations-get-conversation-prefs-params) -> result<string, string>;

  record admin-conversations-get-teams-params {
    /// Authentication token. Requires scope: `admin.conversations:read`
    token: string,
    /// The channel to determine connected workspaces within the organization for.
    channel-id: string,
    /// Set `cursor` to `next_cursor` returned by the previous call to list items in the next page
    cursor: option<string>,
    /// The maximum number of items to return. Must be between 1 - 1000 both inclusive.
    limit: option<s32>
  }
  admin-conversations-get-teams: func(params: admin-conversations-get-teams-params) -> result<string, string>;

  record admin-conversations-invite-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-invite: func(params: admin-conversations-invite-params) -> result<string, string>;

  record admin-conversations-rename-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-rename: func(params: admin-conversations-rename-params) -> result<string, string>;

  record admin-conversations-search-params {
    /// Authentication token. Requires scope: `admin.conversations:read`
    token: string,
    /// Comma separated string of team IDs, signifying the workspaces to search through.
    team-ids: option<string>,
    /// Name of the the channel to query by.
    query: option<string>,
    /// Maximum number of items to be returned. Must be between 1 - 20 both inclusive. Default is 10.
    limit: option<s32>,
    /// Set `cursor` to `next_cursor` returned by the previous call to list items in the next page.
    cursor: option<string>,
    /// The type of channel to include or exclude in the search. For example `private` will search private channels, while `private_exclude` will exclude them. For a full list of types, check the [Types section](#types).
    search-channel-types: option<string>,
    /// Possible values are `relevant` (search ranking based on what we think is closest), `name` (alphabetical), `member_count` (number of users in the channel), and `created` (date channel was created). You can optionally pair this with the `sort_dir` arg to change how it is sorted 
    sort: option<string>,
    /// Sort direction. Possible values are `asc` for ascending order like (1, 2, 3) or (a, b, c), and `desc` for descending order like (3, 2, 1) or (c, b, a)
    sort-dir: option<string>
  }
  admin-conversations-search: func(params: admin-conversations-search-params) -> result<string, string>;

  record admin-conversations-set-conversation-prefs-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-set-conversation-prefs: func(params: admin-conversations-set-conversation-prefs-params) -> result<string, string>;

  record admin-conversations-set-teams-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-set-teams: func(params: admin-conversations-set-teams-params) -> result<string, string>;

  record admin-conversations-unarchive-params {
    /// Authentication token. Requires scope: `admin.conversations:write`
    token: string
  }
  admin-conversations-unarchive: func(params: admin-conversations-unarchive-params) -> result<string, string>;

}

