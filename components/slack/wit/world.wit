    token: string
  }
  usergroups-enable: func(params: usergroups-enable-params) -> result<string, string>;

  record usergroups-list-params {
    /// Include the list of users for each User Group.
    include-users: option<bool>,
    /// Authentication token. Requires scope: `usergroups:read`
    token: string,
    /// Include the number of users in each User Group.
    include-count: option<bool>,
    /// Include disabled User Groups.
    include-disabled: option<bool>
  }
  usergroups-list: func(params: usergroups-list-params) -> result<string, string>;

  record usergroups-update-params {
    /// Authentication token. Requires scope: `usergroups:write`
    token: string
  }
  usergroups-update: func(params: usergroups-update-params) -> result<string, string>;

}

interface usergroups-users {
  record usergroups-users-list-params {
    /// Authentication token. Requires scope: `usergroups:read`
    token: string,
    /// Allow results that involve disabled User Groups.
    include-disabled: option<bool>,
    /// The encoded ID of the User Group to update.
    usergroup: string
  }
  usergroups-users-list: func(params: usergroups-users-list-params) -> result<string, string>;

  record usergroups-users-update-params {
    /// Authentication token. Requires scope: `usergroups:write`
    token: string
  }
  usergroups-users-update: func(params: usergroups-users-update-params) -> result<string, string>;

}

interface users {
  record users-conversations-params {
    /// Authentication token. Requires scope: `conversations:read`
    token: option<string>,
    /// Browse conversations by a specific user ID's membership. Non-public channels are restricted to those where the calling user shares membership.
    user: option<string>,
    /// Mix and match channel types by providing a comma-separated list of any combination of `public_channel`, `private_channel`, `mpim`, `im`
    types: option<string>,
    /// Set to `true` to exclude archived channels from the list
    exclude-archived: option<bool>,
    /// The maximum number of items to return. Fewer than the requested number of items may be returned, even if the end of the list hasn't been reached. Must be an integer no larger than 1000.
    limit: option<s32>,
    /// Paginate through collections of data by setting the `cursor` parameter to a `next_cursor` attribute returned by a previous request's `response_metadata`. Default value fetches the first "page" of the collection. See [pagination](/docs/pagination) for more detail.
    cursor: option<string>
  }
  users-conversations: func(params: users-conversations-params) -> result<string, string>;

  users-delete-photo: func() -> result<string, string>;

  record users-get-presence-params {
    /// Authentication token. Requires scope: `users:read`
    token: string,
    /// User to get presence info on. Defaults to the authed user.
    user: option<string>
  }
  users-get-presence: func(params: users-get-presence-params) -> result<string, string>;

  record users-identity-params {
    /// Authentication token. Requires scope: `identity.basic`
    token: option<string>
  }
  users-identity: func(params: users-identity-params) -> result<string, string>;

  record users-info-params {
    /// Authentication token. Requires scope: `users:read`
    token: string,
    /// Set this to `true` to receive the locale for this user. Defaults to `false`
    include-locale: option<bool>,
    /// User to get info on
    user: option<string>
  }
  users-info: func(params: users-info-params) -> result<string, string>;

  record users-list-params {
    /// Authentication token. Requires scope: `users:read`
    token: option<string>,
    /// The maximum number of items to return. Fewer than the requested number of items may be returned, even if the end of the users list hasn't been reached. Providing no `limit` value will result in Slack attempting to deliver you the entire result set. If the collection is too large you may experience `limit_required` or HTTP 500 errors.
    limit: option<s32>,
    /// Paginate through collections of data by setting the `cursor` parameter to a `next_cursor` attribute returned by a previous request's `response_metadata`. Default value fetches the first "page" of the collection. See [pagination](/docs/pagination) for more detail.
    cursor: option<string>,
    /// Set this to `true` to receive the locale for users. Defaults to `false`
    include-locale: option<bool>
  }
  users-list: func(params: users-list-params) -> result<string, string>;

  record users-lookup-by-email-params {
    /// Authentication token. Requires scope: `users:read.email`
    token: string,
    /// An email address belonging to a user in the workspace
    email: string
  }
  users-lookup-by-email: func(params: users-lookup-by-email-params) -> result<string, string>;

  record users-set-active-params {
    /// Authentication token. Requires scope: `users:write`
    token: string
  }
  users-set-active: func(params: users-set-active-params) -> result<string, string>;

  users-set-photo: func() -> result<string, string>;

  record users-set-presence-params {
    /// Authentication token. Requires scope: `users:write`
    token: string
  }
  users-set-presence: func(params: users-set-presence-params) -> result<string, string>;

}

interface users-profile {
  record users-profile-get-params {
    /// Authentication token. Requires scope: `users.profile:read`
    token: string,
    /// Include labels for each ID in custom profile fields
    include-labels: option<bool>,
    /// User to retrieve profile info for
    user: option<string>
  }
  users-profile-get: func(params: users-profile-get-params) -> result<string, string>;

  record users-profile-set-params {
    /// Authentication token. Requires scope: `users.profile:write`
    token: string
  }
  users-profile-set: func(params: users-profile-set-params) -> result<string, string>;

}

interface views {
  record views-open-params {
    /// Authentication token. Requires scope: `none`
    token: string,
    /// Exchange a trigger to post to the user.
    trigger-id: string,
    /// A [view payload](/reference/surfaces/views). This must be a JSON-encoded string.
    view: string
  }
  views-open: func(params: views-open-params) -> result<string, string>;

  record views-publish-params {
    /// Authentication token. Requires scope: `none`
    token: string,
    /// `id` of the user you want publish a view to.
    user-id: string,
    /// A [view payload](/reference/surfaces/views). This must be a JSON-encoded string.
    view: string,
    /// A string that represents view state to protect against possible race conditions.
    hash: option<string>
  }
  views-publish: func(params: views-publish-params) -> result<string, string>;

  record views-push-params {
    /// Authentication token. Requires scope: `none`
    token: string,
    /// Exchange a trigger to post to the user.
    trigger-id: string,
    /// A [view payload](/reference/surfaces/views). This must be a JSON-encoded string.
    view: string
  }
  views-push: func(params: views-push-params) -> result<string, string>;

  record views-update-params {
    /// Authentication token. Requires scope: `none`
    token: string,
    /// A unique identifier of the view to be updated. Either `view_id` or `external_id` is required.
    view-id: option<string>,
    /// A unique identifier of the view set by the developer. Must be unique for all views on a team. Max length of 255 characters. Either `view_id` or `external_id` is required.
    external-id: option<string>,
    /// A [view object](/reference/surfaces/views). This must be a JSON-encoded string.
    view: option<string>,
    /// A string that represents view state to protect against possible race conditions.
    hash: option<string>
  }
  views-update: func(params: views-update-params) -> result<string, string>;

}

interface workflows {
  record workflows-step-completed-params {
    /// Authentication token. Requires scope: `workflow.steps:execute`
    token: string,
    /// Context identifier that maps to the correct workflow step execution.
    workflow-step-execute-id: string,
    /// Key-value object of outputs from your step. Keys of this object reflect the configured `key` properties of your [`outputs`](/reference/workflows/workflow_step#output) array from your `workflow_step` object.
    outputs: option<string>
  }
  workflows-step-completed: func(params: workflows-step-completed-params) -> result<string, string>;

  record workflows-step-failed-params {
    /// Authentication token. Requires scope: `workflow.steps:execute`
    token: string,
    /// Context identifier that maps to the correct workflow step execution.
    workflow-step-execute-id: string,
    /// A JSON-based object with a `message` property that should contain a human readable error message.
    error: string
  }
  workflows-step-failed: func(params: workflows-step-failed-params) -> result<string, string>;

  record workflows-update-step-params {
    /// Authentication token. Requires scope: `workflow.steps:execute`
    token: string,
    /// A context identifier provided with `view_submission` payloads used to call back to `workflows.updateStep`.
    workflow-step-edit-id: string,
    /// A JSON key-value map of inputs required from a user during configuration. This is the data your app expects to receive when the workflow step starts. **Please note**: the embedded variable format is set and replaced by the workflow system. You cannot create custom variables that will be replaced at runtime. [Read more about variables in workflow steps here](/workflows/steps#variables).
    inputs: option<string>,
    /// An JSON array of output objects used during step execution. This is the data your app agrees to provide when your workflow step was executed.
    outputs: option<string>,
    /// An optional field that can be used to override the step name that is shown in the Workflow Builder.
    step-name: option<string>,
    /// An optional field that can be used to override app image that is shown in the Workflow Builder.
    step-image-url: option<string>
  }
  workflows-update-step: func(params: workflows-update-step-params) -> result<string, string>;

}
