    thumb-v80: option<string>,
    thumb-v800: option<string>,
    thumb-v800-h: option<s32>,
    thumb-v800-w: option<s32>,
    thumb-v960: option<string>,
    thumb-v960-h: option<s32>,
    thumb-v960-w: option<s32>,
    thumb-tiny: option<string>,
    timestamp: option<s32>,
    title: option<string>,
    updated: option<s32>,
    url-private: option<string>,
    url-private-download: option<string>,
    user: option<string>,
    user-team: option<defs-team>,
    username: option<string>
  }

  record defs-channel-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-group-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-file-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-dm-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-pinned-info {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record defs-channel {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-reaction {
    count: s32,
    name: string,
    users: list<defs-user-id>
  }

  record objs-file-shares {
    private: option<string>,
    public: option<string>
  }

  record defs-team {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-paging {
    count: option<s32>,
    page: s32,
    pages: option<s32>,
    per-page: option<s32>,
    spill: option<s32>,
    total: s32
  }

  record objs-response-metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Schema for successful response from files.list method
  record list-op-response {
    files: list<objs-file>,
    ok: defs-ok-true,
    paging: objs-paging
  }

  /// Schema for successful response from files.revokePublicURL method
  record revoke-public-url-response {
    file: objs-file,
    ok: defs-ok-true
  }

  /// Schema for successful response from files.sharedPublicURL method
  record shared-public-url-response {
    file: objs-file,
    ok: defs-ok-true
  }

  /// Schema for successful response files.upload method
  record upload-response {
    file: objs-file,
    ok: defs-ok-true
  }

  record delete-params {
    /// Authentication token. Requires scope: `files:write:user`
    token: option<string>,
    /// ID of file to delete.
    file: option<string>
  }
  delete: func(params: delete-params) -> result<delete-response, string>;

  record info-params {
    /// Authentication token. Requires scope: `files:read`
    token: option<string>,
    /// Specify a file by providing its ID.
    file: option<string>,
    count: option<string>,
    page: option<string>,
    /// The maximum number of items to return. Fewer than the requested number of items may be returned, even if the end of the list hasn't been reached.
    limit: option<s32>,
    /// Parameter for pagination. File comments are paginated for a single file. Set `cursor` equal to the `next_cursor` attribute returned by the previous request's `response_metadata`. This parameter is optional, but pagination is mandatory: the default value simply fetches the first "page" of the collection of comments. See [pagination](/docs/pagination) for more details.
    cursor: option<string>
  }
  info: func(params: info-params) -> result<info-response, string>;

  record list-op-params {
    /// Authentication token. Requires scope: `files:read`
    token: option<string>,
    /// Filter files created by a single user.
    user: option<string>,
    /// Filter files appearing in a specific channel, indicated by its ID.
    channel: option<string>,
    /// Filter files created after this timestamp (inclusive).
    ts-from: option<f64>,
    /// Filter files created before this timestamp (inclusive).
    ts-to: option<f64>,
    /// Filter files by type ([see below](#file_types)). You can pass multiple values in the types argument, like `types=spaces,snippets`.The default value is `all`, which does not filter the list.
    types: option<string>,
    count: option<string>,
    page: option<string>,
    /// Show truncated file info for files hidden due to being too old, and the team who owns the file being over the file limit.
    show-files-hidden-by-limit: option<bool>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  record revoke-public-url-params {
    /// Authentication token. Requires scope: `files:write:user`
    token: option<string>,
    /// File to revoke
    file: option<string>
  }
  revoke-public-url: func(params: revoke-public-url-params) -> result<revoke-public-url-response, string>;

  record shared-public-url-params {
    /// Authentication token. Requires scope: `files:write:user`
    token: option<string>,
    /// File to share
    file: option<string>
  }
  shared-public-url: func(params: shared-public-url-params) -> result<shared-public-url-response, string>;

  record upload-params {
    /// Comma-separated list of channel names or IDs where the file will be shared.
    channels: option<string>,
    /// File contents via a POST variable. If omitting this parameter, you must provide a `file`.
    content: option<string>,
    /// File contents via `multipart/form-data`. If omitting this parameter, you must submit `content`.
    file: option<string>,
    /// Filename of file.
    filename: option<string>,
    /// A [file type](/types/file#file_types) identifier.
    filetype: option<string>,
    /// The message text introducing the file in specified `channels`.
    initial-comment: option<string>,
    /// Provide another message's `ts` value to upload this file as a reply. Never use a reply's `ts` value; use its parent instead.
    thread-ts: option<f64>,
    /// Title of file.
    title: option<string>,
    /// Authentication token. Requires scope: `files:write:user`
    token: option<string>
  }
  upload: func(params: upload-params) -> result<upload-response, string>;

}

interface files-remote {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record add-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record info-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record list-op-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record remove-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record share-response {
    ok: defs-ok-true
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record update-response {
    ok: defs-ok-true
  }

  record add-params {
    /// Creator defined GUID for the file.
    external-id: option<string>,
    /// URL of the remote file.
    external-url: option<string>,
    /// type of file
    filetype: option<string>,
    /// A text file (txt, pdf, doc, etc.) containing textual search terms that are used to improve discovery of the remote file.
    indexable-file-contents: option<string>,
    /// Preview of the document via `multipart/form-data`.
    preview-image: option<string>,
    /// Title of the file being shared.
    title: option<string>,
    /// Authentication token. Requires scope: `remote_files:write`
    token: option<string>
  }
  add: func(params: add-params) -> result<add-response, string>;

  record info-params {
    /// Authentication token. Requires scope: `remote_files:read`
    token: option<string>,
    /// Specify a file by providing its ID.
    file: option<string>,
    /// Creator defined GUID for the file.
    external-id: option<string>
  }
  info: func(params: info-params) -> result<info-response, string>;

  record list-op-params {
    /// Authentication token. Requires scope: `remote_files:read`
    token: option<string>,
    /// Filter files appearing in a specific channel, indicated by its ID.
    channel: option<string>,
    /// Filter files created after this timestamp (inclusive).
    ts-from: option<f64>,
    /// Filter files created before this timestamp (inclusive).
    ts-to: option<f64>,
    /// The maximum number of items to return.
    limit: option<s32>,
    /// Paginate through collections of data by setting the `cursor` parameter to a `next_cursor` attribute returned by a previous request's `response_metadata`. Default value fetches the first "page" of the collection. See [pagination](/docs/pagination) for more detail.
    cursor: option<string>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  record remove-params {
    /// Creator defined GUID for the file.
    external-id: option<string>,
    /// Specify a file by providing its ID.
    file: option<string>,
    /// Authentication token. Requires scope: `remote_files:write`
    token: option<string>
  }
  remove: func(params: remove-params) -> result<remove-response, string>;

  record share-params {
    /// Authentication token. Requires scope: `remote_files:share`
    token: option<string>,
    /// Specify a file registered with Slack by providing its ID. Either this field or `external_id` or both are required.
    file: option<string>,
    /// The globally unique identifier (GUID) for the file, as set by the app registering the file with Slack.  Either this field or `file` or both are required.
    external-id: option<string>,
    /// Comma-separated list of channel IDs where the file will be shared.
    channels: option<string>
  }
  share: func(params: share-params) -> result<share-response, string>;

  record update-params {
    /// Creator defined GUID for the file.
    external-id: option<string>,
    /// URL of the remote file.
    external-url: option<string>,
    /// Specify a file by providing its ID.
    file: option<string>,
    /// type of file
    filetype: option<string>,
    /// File containing contents that can be used to improve searchability for the remote file.
    indexable-file-contents: option<string>,
    /// Preview of the document via `multipart/form-data`.
    preview-image: option<string>,
    /// Title of the file being shared.
    title: option<string>,
    /// Authentication token. Requires scope: `remote_files:write`
    token: option<string>
  }
  update: func(params: update-params) -> result<update-response, string>;

}

