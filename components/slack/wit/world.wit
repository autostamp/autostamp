    /// Call duration in seconds
    duration: option<s32>,
    /// `id` returned when registering the call using the [`calls.add`](/methods/calls.add) method.
    id: string
  }
  end: func(params: end-params) -> result<end-response, string>;

  record info-params {
    /// Authentication token. Requires scope: `calls:read`
    token: string,
    /// `id` of the Call returned by the [`calls.add`](/methods/calls.add) method.
    id: string
  }
  info: func(params: info-params) -> result<info-response, string>;

  record update-params {
    /// Authentication token. Requires scope: `calls:write`
    token: string,
    /// When supplied, available Slack clients will attempt to directly launch the 3rd-party Call with this URL.
    desktop-app-join-url: option<string>,
    /// `id` returned by the [`calls.add`](/methods/calls.add) method.
    id: string,
    /// The URL required for a client to join the Call.
    join-url: option<string>,
    /// The name of the Call.
    title: option<string>
  }
  update: func(params: update-params) -> result<update-response, string>;

}

interface calls-participants {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record add-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record remove-response {
    ok: defs-ok-true
  }

  record add-params {
    /// Authentication token. Requires scope: `calls:write`
    token: string,
    /// `id` returned by the [`calls.add`](/methods/calls.add) method.
    id: string,
    /// The list of users to add as participants in the Call. [Read more on how to specify users here](/apis/calls#users).
    users: string
  }
  add: func(params: add-params) -> result<add-response, string>;

  record remove-params {
    /// Authentication token. Requires scope: `calls:write`
    token: string,
    /// `id` returned by the [`calls.add`](/methods/calls.add) method.
    id: string,
    /// The list of users to remove as participants in the Call. [Read more on how to specify users here](/apis/calls#users).
    users: string
  }
  remove: func(params: remove-params) -> result<remove-response, string>;

}

interface chat {
  /// Schema for successful response of chat.delete method
  record delete-response {
    channel: defs-channel,
    ok: defs-ok-true,
    ts: defs-ts
  }

  record defs-channel {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-ts {
    /// opaque schema; raw JSON
    value: string
  }

  /// Schema for successful response from chat.deleteScheduledMessage method
  record delete-scheduled-message-response {
    ok: defs-ok-true
  }

  /// Schema for successful response chat.getPermalink
  record get-permalink-response {
    channel: defs-channel,
    ok: defs-ok-true,
    permalink: string
  }

  /// Schema for successful response from chat.meMessage method
  record me-message-response {
    channel: option<defs-channel>,
    ok: defs-ok-true,
    ts: option<defs-ts>
  }

  /// Schema for successful response from chat.postEphemeral method
  record post-ephemeral-response {
    message-ts: defs-ts,
    ok: defs-ok-true
  }

  /// Schema for successful response of chat.postMessage method
  record post-message-response {
    channel: defs-channel,
    message: objs-message,
    ok: defs-ok-true,
    ts: defs-ts
  }

  record objs-message {
    attachments: option<list<objs-message-attachments-item>>,
    blocks: option<blocks>,
    bot-id: option<string>,
    bot-profile: option<objs-bot-profile>,
    client-msg-id: option<string>,
    comment: option<objs-comment>,
    display-as-bot: option<bool>,
    file: option<objs-file>,
    files: option<list<objs-file>>,
    icons: option<objs-message-icons>,
    inviter: option<defs-user-id>,
    is-delayed-message: option<bool>,
    is-intro: option<bool>,
    is-starred: option<bool>,
    last-read: option<defs-ts>,
    latest-reply: option<defs-ts>,
    name: option<string>,
    old-name: option<string>,
    parent-user-id: option<defs-user-id>,
    permalink: option<string>,
    pinned-to: option<list<defs-channel>>,
    purpose: option<string>,
    reactions: option<list<objs-reaction>>,
    reply-count: option<s32>,
    reply-users: option<list<defs-user-id>>,
    reply-users-count: option<s32>,
    source-team: option<defs-workspace-id>,
    subscribed: option<bool>,
    subtype: option<string>,
    team: option<defs-workspace-id>,
    text: string,
    thread-ts: option<defs-ts>,
    topic: option<string>,
    ts: defs-ts,
    type-op: string,
    unread-count: option<s32>,
    upload: option<bool>,
    user: option<defs-user-id>,
    user-profile: option<objs-user-profile-short>,
    user-team: option<defs-workspace-id>,
    username: option<string>
  }

  record objs-message-attachments-item {
    fallback: option<string>,
    id: s32,
    image-bytes: option<s32>,
    image-height: option<s32>,
    image-url: option<string>,
    image-width: option<s32>
  }

  /// This is a very loose definition, in the future, we'll populate this with deeper schema in this definition namespace.
  record blocks {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-bot-profile {
    app-id: defs-app-id,
    deleted: bool,
    icons: objs-bot-profile-icons,
    id: defs-bot-id,
    name: string,
    team-id: defs-team,
    updated: s32
  }

  record defs-app-id {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-bot-profile-icons {
    image-v36: string,
    image-v48: string,
    image-v72: string
  }

  record defs-bot-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-team {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-comment {
    comment: string,
    created: s32,
    id: defs-comment-id,
    is-intro: bool,
    is-starred: option<bool>,
    num-stars: option<s32>,
    pinned-info: option<defs-pinned-info>,
    pinned-to: option<list<defs-channel>>,
    reactions: option<list<objs-reaction>>,
    timestamp: s32,
    user: defs-user-id
  }

  record defs-comment-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-pinned-info {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record objs-reaction {
    count: s32,
    name: string,
    users: list<defs-user-id>
  }

  record defs-user-id {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-file {
    channels: option<list<defs-channel-id>>,
    comments-count: option<s32>,
    created: option<s32>,
    date-delete: option<s32>,
    display-as-bot: option<bool>,
    editable: option<bool>,
    editor: option<defs-user-id>,
    external-id: option<string>,
    external-type: option<string>,
    external-url: option<string>,
    filetype: option<string>,
    groups: option<list<defs-group-id>>,
    has-rich-preview: option<bool>,
    id: option<defs-file-id>,
    image-exif-rotation: option<s32>,
    ims: option<list<defs-dm-id>>,
    is-external: option<bool>,
    is-public: option<bool>,
    is-starred: option<bool>,
    is-tombstoned: option<bool>,
    last-editor: option<defs-user-id>,
    mimetype: option<string>,
    mode: option<string>,
    name: option<string>,
    non-owner-editable: option<bool>,
    num-stars: option<s32>,
    original-h: option<s32>,
    original-w: option<s32>,
    permalink: option<string>,
    permalink-public: option<string>,
    pinned-info: option<defs-pinned-info>,
    pinned-to: option<list<defs-channel>>,
    pretty-type: option<string>,
    preview: option<string>,
    public-url-shared: option<bool>,
    reactions: option<list<objs-reaction>>,
    shares: option<objs-file-shares>,
    size: option<s32>,
    source-team: option<defs-team>,
    state: option<string>,
    thumb-v1024: option<string>,
    thumb-v1024-h: option<s32>,
    thumb-v1024-w: option<s32>,
    thumb-v160: option<string>,
    thumb-v360: option<string>,
    thumb-v360-h: option<s32>,
    thumb-v360-w: option<s32>,
    thumb-v480: option<string>,
    thumb-v480-h: option<s32>,
    thumb-v480-w: option<s32>,
    thumb-v64: option<string>,
    thumb-v720: option<string>,
    thumb-v720-h: option<s32>,
    thumb-v720-w: option<s32>,
    thumb-v80: option<string>,
    thumb-v800: option<string>,
    thumb-v800-h: option<s32>,
    thumb-v800-w: option<s32>,
    thumb-v960: option<string>,
    thumb-v960-h: option<s32>,
    thumb-v960-w: option<s32>,
    thumb-tiny: option<string>,
    timestamp: option<s32>,
    title: option<string>,
    updated: option<s32>,
    url-private: option<string>,
    url-private-download: option<string>,
    user: option<string>,
    user-team: option<defs-team>,
    username: option<string>
  }

  record defs-channel-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-group-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-file-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-dm-id {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-file-shares {
    private: option<string>,
    public: option<string>
  }

  record objs-message-icons {
    emoji: option<string>,
    image-v64: option<string>
  }

  record defs-workspace-id {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-user-profile-short {
    avatar-hash: string,
    display-name: string,
    display-name-normalized: option<string>,
    first-name: string,
    image-v72: string,
    is-restricted: bool,
    is-ultra-restricted: bool,
    name: string,
    real-name: string,
    real-name-normalized: option<string>,
    team: defs-workspace-id
  }

  /// Schema for successful response of chat.scheduleMessage method
  record schedule-message-response {
    channel: defs-channel,
    message: schedule-message-response-message,
    ok: defs-ok-true,
    post-at: string,
    scheduled-message-id: string
  }

  record schedule-message-response-message {
    bot-id: defs-bot-id,
    bot-profile: option<objs-bot-profile>,
    team: defs-team,
    text: string,
    type-op: string,
    user: defs-user-id,
    username: option<string>
  }

  /// Schema for successful response from chat.unfurl method
  record unfurl-response {
    ok: defs-ok-true
  }

  /// Schema for successful response of chat.update method
  record update-response {
    channel: string,
    message: update-response-message,
    ok: defs-ok-true,
    text: string,
    ts: string
  }

  record update-response-message {
    attachments: option<list<update-response-message-attachments-item>>,
    blocks: option<update-response-message-blocks>,
    text: string
  }

  record update-response-message-attachments-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record update-response-message-blocks {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record delete-params {
    /// Authentication token. Requires scope: `chat:write`
    token: option<string>,
    /// Pass true to delete the message as the authed user with `chat:write:user` scope. [Bot users](/bot-users) in this context are considered authed users. If unused or false, the message will be deleted with `chat:write:bot` scope.
    as-user: option<bool>,
    /// Channel containing the message to be deleted.
    channel: option<string>,
    /// Timestamp of the message to be deleted.
    ts: option<f64>
  }
  delete: func(params: delete-params) -> result<delete-response, string>;

  record delete-scheduled-message-params {
    /// Authentication token. Requires scope: `chat:write`
    token: string,
    /// Pass true to delete the message as the authed user with `chat:write:user` scope. [Bot users](/bot-users) in this context are considered authed users. If unused or false, the message will be deleted with `chat:write:bot` scope.
    as-user: option<bool>,
    /// The channel the scheduled_message is posting to
    channel: string,
    /// `scheduled_message_id` returned from call to chat.scheduleMessage
    scheduled-message-id: string
  }
  delete-scheduled-message: func(params: delete-scheduled-message-params) -> result<delete-scheduled-message-response, string>;

  record get-permalink-params {
    /// Authentication token. Requires scope: `none`
    token: string,
    /// The ID of the conversation or channel containing the message
    channel: string,
    /// A message's `ts` value, uniquely identifying it within a channel
    message-ts: string
  }
  get-permalink: func(params: get-permalink-params) -> result<get-permalink-response, string>;

  record me-message-params {
    /// Authentication token. Requires scope: `chat:write`
    token: option<string>,
    /// Channel to send message to. Can be a public channel, private group or IM channel. Can be an encoded ID, or a name.
    channel: option<string>,
    /// Text of the message to send.
    text: option<string>
  }
  me-message: func(params: me-message-params) -> result<me-message-response, string>;

  record post-ephemeral-params {
    /// Authentication token. Requires scope: `chat:write`
    token: string,
    /// Pass true to post the message as the authed user. Defaults to true if the chat:write:bot scope is not included. Otherwise, defaults to false.
    as-user: option<bool>,
    /// A JSON-based array of structured attachments, presented as a URL-encoded string.
    attachments: option<string>,
    /// A JSON-based array of structured blocks, presented as a URL-encoded string.
    blocks: option<string>,
    /// Channel, private group, or IM channel to send message to. Can be an encoded ID, or a name.
    channel: string,
    /// Emoji to use as the icon for this message. Overrides `icon_url`. Must be used in conjunction with `as_user` set to `false`, otherwise ignored. See [authorship](#authorship) below.
    icon-emoji: option<string>,
    /// URL to an image to use as the icon for this message. Must be used in conjunction with `as_user` set to false, otherwise ignored. See [authorship](#authorship) below.
    icon-url: option<string>,
    /// Find and link channel names and usernames.
    link-names: option<bool>,
    /// Change how messages are treated. Defaults to `none`. See [below](#formatting).
    parse: option<string>,
    /// How this field works and whether it is required depends on other fields you use in your API call. [See below](#text_usage) for more detail.
    text: option<string>,
    /// Provide another message's `ts` value to post this message in a thread. Avoid using a reply's `ts` value; use its parent's value instead. Ephemeral messages in threads are only shown if there is already an active thread.
    thread-ts: option<string>,
    /// `id` of the user who will receive the ephemeral message. The user should be in the channel specified by the `channel` argument.
    user: string,
    /// Set your bot's user name. Must be used in conjunction with `as_user` set to false, otherwise ignored. See [authorship](#authorship) below.
    username: option<string>
  }
  post-ephemeral: func(params: post-ephemeral-params) -> result<post-ephemeral-response, string>;

  record post-message-params {
    /// Authentication token. Requires scope: `chat:write`
    token: string,
    /// Pass true to post the message as the authed user, instead of as a bot. Defaults to false. See [authorship](#authorship) below.
    as-user: option<string>,
    /// A JSON-based array of structured attachments, presented as a URL-encoded string.
    attachments: option<string>,
    /// A JSON-based array of structured blocks, presented as a URL-encoded string.
    blocks: option<string>,
    /// Channel, private group, or IM channel to send message to. Can be an encoded ID, or a name. See [below](#channels) for more details.
    channel: string,
    /// Emoji to use as the icon for this message. Overrides `icon_url`. Must be used in conjunction with `as_user` set to `false`, otherwise ignored. See [authorship](#authorship) below.
    icon-emoji: option<string>,
    /// URL to an image to use as the icon for this message. Must be used in conjunction with `as_user` set to false, otherwise ignored. See [authorship](#authorship) below.
    icon-url: option<string>,
    /// Find and link channel names and usernames.
    link-names: option<bool>,
    /// Disable Slack markup parsing by setting to `false`. Enabled by default.
    mrkdwn: option<bool>,
    /// Change how messages are treated. Defaults to `none`. See [below](#formatting).
    parse: option<string>,
    /// Used in conjunction with `thread_ts` and indicates whether reply should be made visible to everyone in the channel or conversation. Defaults to `false`.
    reply-broadcast: option<bool>,
    /// How this field works and whether it is required depends on other fields you use in your API call. [See below](#text_usage) for more detail.
    text: option<string>,
    /// Provide another message's `ts` value to make this message a reply. Avoid using a reply's `ts` value; use its parent instead.
    thread-ts: option<string>,
    /// Pass true to enable unfurling of primarily text-based content.
    unfurl-links: option<bool>,
    /// Pass false to disable unfurling of media content.
    unfurl-media: option<bool>,
    /// Set your bot's user name. Must be used in conjunction with `as_user` set to false, otherwise ignored. See [authorship](#authorship) below.
    username: option<string>
  }
  post-message: func(params: post-message-params) -> result<post-message-response, string>;

  record schedule-message-params {
    /// Authentication token. Requires scope: `chat:write`
    token: option<string>,
    /// Pass true to post the message as the authed user, instead of as a bot. Defaults to false. See [chat.postMessage](chat.postMessage#authorship).
    as-user: option<bool>,
    /// A JSON-based array of structured attachments, presented as a URL-encoded string.
    attachments: option<string>,
    /// A JSON-based array of structured blocks, presented as a URL-encoded string.
    blocks: option<string>,
    /// Channel, private group, or DM channel to send message to. Can be an encoded ID, or a name. See [below](#channels) for more details.
    channel: option<string>,
    /// Find and link channel names and usernames.
    link-names: option<bool>,
    /// Change how messages are treated. Defaults to `none`. See [chat.postMessage](chat.postMessage#formatting).
    parse: option<string>,
    /// Unix EPOCH timestamp of time in future to send the message.
    post-at: option<string>,
    /// Used in conjunction with `thread_ts` and indicates whether reply should be made visible to everyone in the channel or conversation. Defaults to `false`.
    reply-broadcast: option<bool>,
    /// How this field works and whether it is required depends on other fields you use in your API call. [See below](#text_usage) for more detail.
    text: option<string>,
    /// Provide another message's `ts` value to make this message a reply. Avoid using a reply's `ts` value; use its parent instead.
    thread-ts: option<f64>,
    /// Pass true to enable unfurling of primarily text-based content.
    unfurl-links: option<bool>,
    /// Pass false to disable unfurling of media content.
    unfurl-media: option<bool>
  }
  schedule-message: func(params: schedule-message-params) -> result<schedule-message-response, string>;

  record unfurl-params {
    /// Authentication token. Requires scope: `links:write`
    token: string,
    /// Channel ID of the message
    channel: string,
    /// Timestamp of the message to add unfurl behavior to.
    ts: string,
    /// URL-encoded JSON map with keys set to URLs featured in the the message, pointing to their unfurl blocks or message attachments.
    unfurls: option<string>,
    /// Provide a simply-formatted string to send as an ephemeral message to the user as invitation to authenticate further and enable full unfurling behavior
    user-auth-message: option<string>,
    /// Set to `true` or `1` to indicate the user must install your Slack app to trigger unfurls for this domain
    user-auth-required: option<bool>,
    /// Send users to this custom URL where they will complete authentication in your app to fully trigger unfurling. Value should be properly URL-encoded.
    user-auth-url: option<string>
  }
  unfurl: func(params: unfurl-params) -> result<unfurl-response, string>;

  record update-params {
    /// Authentication token. Requires scope: `chat:write`
    token: string,
    /// Pass true to update the message as the authed user. [Bot users](/bot-users) in this context are considered authed users.
    as-user: option<string>,
    /// A JSON-based array of structured attachments, presented as a URL-encoded string. This field is required when not presenting `text`. If you don't include this field, the message's previous `attachments` will be retained. To remove previous `attachments`, include an empty array for this field.
    attachments: option<string>,
    /// A JSON-based array of [structured blocks](/block-kit/building), presented as a URL-encoded string. If you don't include this field, the message's previous `blocks` will be retained. To remove previous `blocks`, include an empty array for this field.
    blocks: option<string>,
    /// Channel containing the message to be updated.
    channel: string,
    /// Find and link channel names and usernames. Defaults to `none`. If you do not specify a value for this field, the original value set for the message will be overwritten with the default, `none`.
    link-names: option<string>,
    /// Change how messages are treated. Defaults to `client`, unlike `chat.postMessage`. Accepts either `none` or `full`. If you do not specify a value for this field, the original value set for the message will be overwritten with the default, `client`.
    parse: option<string>,
    /// New text for the message, using the [default formatting rules](/reference/surfaces/formatting). It's not required when presenting `blocks` or `attachments`.
    text: option<string>,
    /// Timestamp of the message to be updated.
    ts: string
  }
  update: func(params: update-params) -> result<update-response, string>;

}

interface chat-scheduled-messages {
  /// Schema for successful response from chat.scheduledMessages.list method
  record list-op-response {
    ok: defs-ok-true,
    response-metadata: list-op-response-response-metadata,
    scheduled-messages: list<list-op-response-scheduled-messages-item>
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  record list-op-response-response-metadata {
    next-cursor: string
  }

  record list-op-response-scheduled-messages-item {
    channel-id: defs-channel-id,
    date-created: string,
    id: string,
    post-at: string,
    text: option<string>
  }

  record defs-channel-id {
    /// opaque schema; raw JSON
    value: string
  }

  record list-op-params {
    /// Authentication token. Requires scope: `none`
    token: option<string>,
    /// The channel of the scheduled messages
    channel: option<string>,
    /// A UNIX timestamp of the latest value in the time range
    latest: option<f64>,
    /// A UNIX timestamp of the oldest value in the time range
    oldest: option<f64>,
    /// Maximum number of original entries to return.
    limit: option<s32>,
    /// For pagination purposes, this is the `cursor` value returned from a previous call to `chat.scheduledmessages.list` indicating where you want to start this call from.
    cursor: option<string>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

}

interface conversations {
  /// Schema for successful response conversations.archive method
  record archive-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  /// Schema for successful response conversations.close method
  record close-response {
    already-closed: option<bool>,
    no-op: option<bool>,
    ok: defs-ok-true
  }

  /// Schema for successful response conversations.create method
  record create-response {
    channel: objs-conversation,
    ok: defs-ok-true
  }

  record objs-conversation {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Schema for successful response from conversations.history method
  record history-response {
    channel-actions-count: s32,
    channel-actions-ts: string,
    has-more: bool,
    messages: list<objs-message>,
    ok: defs-ok-true,
    pin-count: s32
  }

  record objs-message {
    attachments: option<list<objs-message-attachments-item>>,
    blocks: option<blocks>,
    bot-id: option<string>,
    bot-profile: option<objs-bot-profile>,
    client-msg-id: option<string>,
    comment: option<objs-comment>,
    display-as-bot: option<bool>,
    file: option<objs-file>,
    files: option<list<objs-file>>,
    icons: option<objs-message-icons>,
    inviter: option<defs-user-id>,
    is-delayed-message: option<bool>,
    is-intro: option<bool>,
    is-starred: option<bool>,
    last-read: option<defs-ts>,
    latest-reply: option<defs-ts>,
    name: option<string>,
    old-name: option<string>,
    parent-user-id: option<defs-user-id>,
    permalink: option<string>,
    pinned-to: option<list<defs-channel>>,
    purpose: option<string>,
    reactions: option<list<objs-reaction>>,
    reply-count: option<s32>,
    reply-users: option<list<defs-user-id>>,
    reply-users-count: option<s32>,
    source-team: option<defs-workspace-id>,
    subscribed: option<bool>,
    subtype: option<string>,
    team: option<defs-workspace-id>,
    text: string,
    thread-ts: option<defs-ts>,
    topic: option<string>,
    ts: defs-ts,
    type-op: string,
    unread-count: option<s32>,
    upload: option<bool>,
    user: option<defs-user-id>,
    user-profile: option<objs-user-profile-short>,
    user-team: option<defs-workspace-id>,
    username: option<string>
  }

  record objs-message-attachments-item {
    fallback: option<string>,
    id: s32,
    image-bytes: option<s32>,
    image-height: option<s32>,
    image-url: option<string>,
    image-width: option<s32>
  }

  /// This is a very loose definition, in the future, we'll populate this with deeper schema in this definition namespace.
  record blocks {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-bot-profile {
    app-id: defs-app-id,
    deleted: bool,
    icons: objs-bot-profile-icons,
    id: defs-bot-id,
    name: string,
    team-id: defs-team,
    updated: s32
  }

  record defs-app-id {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-bot-profile-icons {
    image-v36: string,
    image-v48: string,
    image-v72: string
  }

  record defs-bot-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-team {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-comment {
    comment: string,
    created: s32,
    id: defs-comment-id,
    is-intro: bool,
    is-starred: option<bool>,
    num-stars: option<s32>,
    pinned-info: option<defs-pinned-info>,
    pinned-to: option<list<defs-channel>>,
    reactions: option<list<objs-reaction>>,
    timestamp: s32,
    user: defs-user-id
  }

  record defs-comment-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-pinned-info {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record defs-channel {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-reaction {
    count: s32,
    name: string,
    users: list<defs-user-id>
  }

  record defs-user-id {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-file {
    channels: option<list<defs-channel-id>>,
    comments-count: option<s32>,
    created: option<s32>,
    date-delete: option<s32>,
    display-as-bot: option<bool>,
    editable: option<bool>,
    editor: option<defs-user-id>,
    external-id: option<string>,
    external-type: option<string>,
    external-url: option<string>,
    filetype: option<string>,
    groups: option<list<defs-group-id>>,
    has-rich-preview: option<bool>,
    id: option<defs-file-id>,
    image-exif-rotation: option<s32>,
    ims: option<list<defs-dm-id>>,
    is-external: option<bool>,
    is-public: option<bool>,
    is-starred: option<bool>,
    is-tombstoned: option<bool>,
    last-editor: option<defs-user-id>,
    mimetype: option<string>,
    mode: option<string>,
    name: option<string>,
    non-owner-editable: option<bool>,
    num-stars: option<s32>,
    original-h: option<s32>,
    original-w: option<s32>,
    permalink: option<string>,
    permalink-public: option<string>,
    pinned-info: option<defs-pinned-info>,
    pinned-to: option<list<defs-channel>>,
    pretty-type: option<string>,
    preview: option<string>,
    public-url-shared: option<bool>,
    reactions: option<list<objs-reaction>>,
    shares: option<objs-file-shares>,
    size: option<s32>,
    source-team: option<defs-team>,
    state: option<string>,
    thumb-v1024: option<string>,
    thumb-v1024-h: option<s32>,
    thumb-v1024-w: option<s32>,
    thumb-v160: option<string>,
    thumb-v360: option<string>,
    thumb-v360-h: option<s32>,
    thumb-v360-w: option<s32>,
    thumb-v480: option<string>,
    thumb-v480-h: option<s32>,
    thumb-v480-w: option<s32>,
    thumb-v64: option<string>,
    thumb-v720: option<string>,
    thumb-v720-h: option<s32>,
    thumb-v720-w: option<s32>,
    thumb-v80: option<string>,
    thumb-v800: option<string>,
    thumb-v800-h: option<s32>,
    thumb-v800-w: option<s32>,
    thumb-v960: option<string>,
    thumb-v960-h: option<s32>,
    thumb-v960-w: option<s32>,
    thumb-tiny: option<string>,
    timestamp: option<s32>,
    title: option<string>,
    updated: option<s32>,
    url-private: option<string>,
    url-private-download: option<string>,
    user: option<string>,
    user-team: option<defs-team>,
    username: option<string>
  }

  record defs-channel-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-group-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-file-id {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-dm-id {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-file-shares {
    private: option<string>,
    public: option<string>
  }

  record objs-message-icons {
    emoji: option<string>,
    image-v64: option<string>
  }

  record defs-ts {
    /// opaque schema; raw JSON
    value: string
  }

  record defs-workspace-id {
    /// opaque schema; raw JSON
    value: string
  }

  record objs-user-profile-short {
    avatar-hash: string,
    display-name: string,
    display-name-normalized: option<string>,
    first-name: string,
    image-v72: string,
    is-restricted: bool,
    is-ultra-restricted: bool,
    name: string,
    real-name: string,
    real-name-normalized: option<string>,
    team: defs-workspace-id
  }

  /// Schema for successful response conversations.info
  record info-response {
    channel: objs-conversation,
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.invite method
  record invite-response {
    channel: objs-conversation,
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.join method
  record join-response {
    channel: objs-conversation,
    ok: defs-ok-true,
    response-metadata: option<join-response-response-metadata>,
    warning: option<string>
  }

  record join-response-response-metadata {
    warnings: option<list<string>>
  }

  /// Schema for successful response conversations.kick method
  record kick-response {
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.leave method
  record leave-response {
    not-in-channel: option<bool>,
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.list method
  record list-op-response {
    channels: list<objs-conversation>,
    ok: defs-ok-true,
    response-metadata: option<list-op-response-response-metadata>
  }

  record list-op-response-response-metadata {
    next-cursor: string
  }

  /// Schema for successful response conversations.mark method
  record mark-response {
    ok: defs-ok-true
  }

  /// Schema for successful response conversations.members method
  record members-response {
    members: list<defs-user-id>,
    ok: defs-ok-true,
    response-metadata: members-response-response-metadata
  }

  record members-response-response-metadata {
    next-cursor: string
  }

  /// Schema for successful response from conversations.open method when opening channels, ims, mpims
  record open-response {
    already-open: option<bool>,
    channel: string,
    no-op: option<bool>,
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.rename method
  record rename-response {
    channel: objs-conversation,
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.replies method
  record replies-response {
    has-more: option<bool>,
    messages: list<string>,
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.setPurpose method
  record set-purpose-response {
    channel: objs-conversation,
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.setTopic method
  record set-topic-response {
    channel: objs-conversation,
    ok: defs-ok-true
  }

  /// Schema for successful response from conversations.unarchive method
  record unarchive-response {
    ok: defs-ok-true
  }

  record archive-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// ID of conversation to archive
    channel: option<string>
  }
  archive: func(params: archive-params) -> result<archive-response, string>;

  record close-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// Conversation to close.
    channel: option<string>
  }
  close: func(params: close-params) -> result<close-response, string>;

  record create-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// Create a private channel instead of a public one
    is-private: option<bool>,
    /// Name of the public or private channel to create
    name: option<string>
  }
  create: func(params: create-params) -> result<create-response, string>;

  record history-params {
    /// Authentication token. Requires scope: `conversations:history`
    token: option<string>,
    /// Conversation ID to fetch history for.
    channel: option<string>,
    /// End of time range of messages to include in results.
    latest: option<f64>,
    /// Start of time range of messages to include in results.
    oldest: option<f64>,
    /// Include messages with latest or oldest timestamp in results only when either timestamp is specified.
    inclusive: option<bool>,
    /// The maximum number of items to return. Fewer than the requested number of items may be returned, even if the end of the users list hasn't been reached.
    limit: option<s32>,
    /// Paginate through collections of data by setting the `cursor` parameter to a `next_cursor` attribute returned by a previous request's `response_metadata`. Default value fetches the first "page" of the collection. See [pagination](/docs/pagination) for more detail.
    cursor: option<string>
  }
  history: func(params: history-params) -> result<history-response, string>;

  record info-params {
    /// Authentication token. Requires scope: `conversations:read`
    token: option<string>,
    /// Conversation ID to learn more about
    channel: option<string>,
    /// Set this to `true` to receive the locale for this conversation. Defaults to `false`
    include-locale: option<bool>,
    /// Set to `true` to include the member count for the specified conversation. Defaults to `false`
    include-num-members: option<bool>
  }
  info: func(params: info-params) -> result<info-response, string>;

  record invite-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// The ID of the public or private channel to invite user(s) to.
    channel: option<string>,
    /// A comma separated list of user IDs. Up to 1000 users may be listed.
    users: option<string>
  }
  invite: func(params: invite-params) -> result<invite-response, string>;

  record join-params {
    /// Authentication token. Requires scope: `channels:write`
    token: option<string>,
    /// ID of conversation to join
    channel: option<string>
  }
  join: func(params: join-params) -> result<join-response, string>;

  record kick-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// ID of conversation to remove user from.
    channel: option<string>,
    /// User ID to be removed.
    user: option<string>
  }
  kick: func(params: kick-params) -> result<kick-response, string>;

  record leave-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// Conversation to leave
    channel: option<string>
  }
  leave: func(params: leave-params) -> result<leave-response, string>;

  record list-op-params {
    /// Authentication token. Requires scope: `conversations:read`
    token: option<string>,
    /// Set to `true` to exclude archived channels from the list
    exclude-archived: option<bool>,
    /// Mix and match channel types by providing a comma-separated list of any combination of `public_channel`, `private_channel`, `mpim`, `im`
    types: option<string>,
    /// The maximum number of items to return. Fewer than the requested number of items may be returned, even if the end of the list hasn't been reached. Must be an integer no larger than 1000.
    limit: option<s32>,
    /// Paginate through collections of data by setting the `cursor` parameter to a `next_cursor` attribute returned by a previous request's `response_metadata`. Default value fetches the first "page" of the collection. See [pagination](/docs/pagination) for more detail.
    cursor: option<string>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  record mark-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// Channel or conversation to set the read cursor for.
    channel: option<string>,
    /// Unique identifier of message you want marked as most recently seen in this conversation.
    ts: option<f64>
  }
  mark: func(params: mark-params) -> result<mark-response, string>;

  record members-params {
    /// Authentication token. Requires scope: `conversations:read`
    token: option<string>,
    /// ID of the conversation to retrieve members for
    channel: option<string>,
    /// The maximum number of items to return. Fewer than the requested number of items may be returned, even if the end of the users list hasn't been reached.
    limit: option<s32>,
    /// Paginate through collections of data by setting the `cursor` parameter to a `next_cursor` attribute returned by a previous request's `response_metadata`. Default value fetches the first "page" of the collection. See [pagination](/docs/pagination) for more detail.
    cursor: option<string>
  }
  members: func(params: members-params) -> result<members-response, string>;

  record open-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// Resume a conversation by supplying an `im` or `mpim`'s ID. Or provide the `users` field instead.
    channel: option<string>,
    /// Boolean, indicates you want the full IM channel definition in the response.
    return-im: option<bool>,
    /// Comma separated lists of users. If only one user is included, this creates a 1:1 DM.  The ordering of the users is preserved whenever a multi-person direct message is returned. Supply a `channel` when not supplying `users`.
    users: option<string>
  }
  open: func(params: open-params) -> result<open-response, string>;

  record rename-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// ID of conversation to rename
    channel: option<string>,
    /// New name for conversation.
    name: option<string>
  }
  rename: func(params: rename-params) -> result<rename-response, string>;

  record replies-params {
    /// Authentication token. Requires scope: `conversations:history`
    token: option<string>,
    /// Conversation ID to fetch thread from.
    channel: option<string>,
    /// Unique identifier of a thread's parent message. `ts` must be the timestamp of an existing message with 0 or more replies. If there are no replies then just the single message referenced by `ts` will return - it is just an ordinary, unthreaded message.
    ts: option<f64>,
    /// End of time range of messages to include in results.
    latest: option<f64>,
    /// Start of time range of messages to include in results.
    oldest: option<f64>,
    /// Include messages with latest or oldest timestamp in results only when either timestamp is specified.
    inclusive: option<bool>,
    /// The maximum number of items to return. Fewer than the requested number of items may be returned, even if the end of the users list hasn't been reached.
    limit: option<s32>,
    /// Paginate through collections of data by setting the `cursor` parameter to a `next_cursor` attribute returned by a previous request's `response_metadata`. Default value fetches the first "page" of the collection. See [pagination](/docs/pagination) for more detail.
    cursor: option<string>
  }
  replies: func(params: replies-params) -> result<replies-response, string>;

  record set-purpose-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// Conversation to set the purpose of
    channel: option<string>,
    /// A new, specialer purpose
    purpose: option<string>
  }
  set-purpose: func(params: set-purpose-params) -> result<set-purpose-response, string>;

  record set-topic-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// Conversation to set the topic of
    channel: option<string>,
    /// The new topic string. Does not support formatting or linkification.
    topic: option<string>
  }
  set-topic: func(params: set-topic-params) -> result<set-topic-response, string>;

  record unarchive-params {
    /// Authentication token. Requires scope: `conversations:write`
    token: option<string>,
    /// ID of conversation to unarchive
    channel: option<string>
  }
  unarchive: func(params: unarchive-params) -> result<unarchive-response, string>;

}

interface dialog {
  /// Schema for successful response from dialog.open method
  record open-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  record open-params {
    /// Authentication token. Requires scope: `none`
    token: string,
    /// The dialog definition. This must be a JSON-encoded string.
    dialog: string,
    /// Exchange a trigger to post to the user.
    trigger-id: string
  }
  open: func(params: open-params) -> result<open-response, string>;

}

interface dnd {
  /// Schema for successful response from dnd.endDnd method
  record end-dnd-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  /// Schema for successful response from dnd.endSnooze method
  record end-snooze-response {
    dnd-enabled: bool,
    next-dnd-end-ts: s32,
    next-dnd-start-ts: s32,
    ok: defs-ok-true,
    snooze-enabled: bool
  }

  /// Schema for successful response from dnd.info method
  record info-response {
    dnd-enabled: bool,
    next-dnd-end-ts: s32,
    next-dnd-start-ts: s32,
    ok: defs-ok-true,
    snooze-enabled: option<bool>,
    snooze-endtime: option<s32>,
    snooze-remaining: option<s32>
  }

  /// Schema for successful response from dnd.setSnooze method
  record set-snooze-response {
    ok: defs-ok-true,
    snooze-enabled: bool,
    snooze-endtime: s32,
    snooze-remaining: s32
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record team-info-response {
    ok: defs-ok-true
  }

  record end-dnd-params {
    /// Authentication token. Requires scope: `dnd:write`
    token: string
  }
  end-dnd: func(params: end-dnd-params) -> result<end-dnd-response, string>;

  record end-snooze-params {
    /// Authentication token. Requires scope: `dnd:write`
    token: string
  }
  end-snooze: func(params: end-snooze-params) -> result<end-snooze-response, string>;

  record info-params {
    /// Authentication token. Requires scope: `dnd:read`
    token: option<string>,
    /// User to fetch status for (defaults to current user)
    user: option<string>
  }
  info: func(params: info-params) -> result<info-response, string>;

  record set-snooze-params {
    /// Number of minutes, from now, to snooze until.
    num-minutes: string,
    /// Authentication token. Requires scope: `dnd:write`
    token: string
  }
  set-snooze: func(params: set-snooze-params) -> result<set-snooze-response, string>;

  record team-info-params {
    /// Authentication token. Requires scope: `dnd:read`
    token: option<string>,
    /// Comma-separated list of users to fetch Do Not Disturb status for
    users: option<string>
  }
  team-info: func(params: team-info-params) -> result<team-info-response, string>;

}

interface emoji {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record list-op-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  record list-op-params {
    /// Authentication token. Requires scope: `emoji:read`
    token: string
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

}

interface files-comments {
  /// Schema for successful response files.comments.delete method
  record delete-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-params {
    /// Authentication token. Requires scope: `files:write:user`
    token: option<string>,
    /// File to delete a comment from.
    file: option<string>,
    /// The comment to delete.
    id: option<string>
  }
  delete: func(params: delete-params) -> result<delete-response, string>;

}

