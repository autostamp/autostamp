/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `slackAuth` | `Authorization: Bearer <secret>` |
package autostamp:slack@0.5.0;

interface admin-apps {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record approve-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record restrict-response {
    ok: defs-ok-true
  }

  record approve-params {
    /// Authentication token. Requires scope: `admin.apps:write`
    token: string,
    /// The id of the app to approve.
    app-id: option<string>,
    /// The id of the request to approve.
    request-id: option<string>,
    team-id: option<string>
  }
  approve: func(params: approve-params) -> result<approve-response, string>;

  record restrict-params {
    /// Authentication token. Requires scope: `admin.apps:write`
    token: string,
    /// The id of the app to restrict.
    app-id: option<string>,
    /// The id of the request to restrict.
    request-id: option<string>,
    team-id: option<string>
  }
  restrict: func(params: restrict-params) -> result<restrict-response, string>;

}


interface admin-apps-approved {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record list-op-response {
    ok: defs-ok-true
  }

  record defs-ok-true {
    /// opaque schema; raw JSON
    value: string
  }

  record list-op-params {
    /// Authentication token. Requires scope: `admin.apps:read`
    token: string,
    /// The maximum number of items to return. Must be between 1 - 1000 both inclusive.
    limit: option<s32>,
    /// Set `cursor` to `next_cursor` returned by the previous call to list items in the next page
    cursor: option<string>,
    team-id: option<string>,
    enterprise-id: option<string>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

}

interface admin-apps-requests {
  /// This method either only returns a brief _OK_ response or a verbose schema is not available for this method.
  record list-op-response {
