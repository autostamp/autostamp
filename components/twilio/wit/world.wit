    page-size: option<s32>,
    /// The page index. This value is simply for client state.
    page: option<s32>,
    /// The page token. This is provided by the API.
    page-token: option<string>
  }
  list-dependent-phone-number: func(params: list-dependent-phone-number-params) -> result<list-dependent-phone-number-response, string>;

}

