/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `accountSid_authToken` | `Authorization: Basic base64(<secret>)` |
package autostamp:twilio@0.6.0;

interface api20100401-account {
  enum account-enum-status {
    active,
    suspended,
    closed,
  }

  enum account-enum-type {
    trial,
    full,
  }

  record list-account-response {
    accounts: option<list<api-v2010-account>>,
    end: option<s32>,
    first-page-uri: option<string>,
    next-page-uri: option<string>,
    page: option<s32>,
    page-size: option<s32>,
    previous-page-uri: option<string>,
    start: option<s32>,
    uri: option<string>
  }

  record api-v2010-account {
    /// The authorization token for this account. This token should be kept a secret, so no sharing.
    auth-token: option<string>,
    /// The date that this account was created, in GMT in RFC 2822 format
    date-created: option<string>,
    /// The date that this account was last updated, in GMT in RFC 2822 format.
    date-updated: option<string>,
    /// A human readable description of this account, up to 64 characters long. By default the FriendlyName is your email address.
    friendly-name: option<string>,
    /// The unique 34 character id that represents the parent of this account. The OwnerAccountSid of a parent account is it's own sid.
    owner-account-sid: option<string>,
    /// A 34 character string that uniquely identifies this resource.
    sid: option<string>,
    status: option<account-enum-status>,
    /// A Map of various subresources available for the given Account Instance
    subresource-uris: option<string>,
    type-op: option<account-enum-type>,
    /// The URI for this resource, relative to `https://api.twilio.com`
    uri: option<string>
  }

  record list-account-params {
    /// Only return the Account resources with friendly names that exactly match this name.
    friendly-name: option<string>,
    /// Only return Account resources with the given status. Can be `closed`, `suspended` or `active`.
    status: option<account-enum-status>,
    /// How many resources to return in each list page. The default is 50, and the maximum is 1000.
    page-size: option<s32>,
    /// The page index. This value is simply for client state.
    page: option<s32>,
    /// The page token. This is provided by the API.
    page-token: option<string>
  }
  list-account: func(params: list-account-params) -> result<list-account-response, string>;

  record create-account-params {
    /// A human readable description of the account to create, defaults to `SubAccount Created at {YYYY-MM-DD HH:MM meridian}`
    friendly-name: option<string>
  }
  create-account: func(params: create-account-params) -> result<api-v2010-account, string>;

  record fetch-account-params {
    /// The Account Sid that uniquely identifies the account to fetch
    sid: string
  }
  fetch-account: func(params: fetch-account-params) -> result<api-v2010-account, string>;

  record update-account-params {
    /// The Account Sid that uniquely identifies the account to update
    sid: string,
    /// Update the human-readable description of this Account
    friendly-name: option<string>,
    status: option<account-enum-status>
  }
  update-account: func(params: update-account-params) -> result<api-v2010-account, string>;

}


