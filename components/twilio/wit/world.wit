    participant-with-end-conference-on-exit-left,
    participant-with-end-conference-on-exit-kicked,
    last-participant-kicked,
    last-participant-left,
  }

  enum update-conference-body-announce-method-enum {
    head,
    get,
    post,
    patch,
    put,
    delete,
  }

  enum conference-enum-update-status {
    completed,
  }

  record list-conference-response {
    conferences: option<list<api-v2010-account-conference>>,
    end: option<s32>,
    first-page-uri: option<string>,
    next-page-uri: option<string>,
    page: option<s32>,
    page-size: option<s32>,
    previous-page-uri: option<string>,
    start: option<s32>,
    uri: option<string>
  }

