/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `accountSid_authToken` | `Authorization: Basic base64(<secret>)` |
package autostamp:twilio@0.2.1;

interface api20100401-account {
  record account-enum-status {
    /// opaque schema; raw JSON
    value: string
  }

  record list-account-params {
    /// Only return the Account resources with friendly names that exactly match this name.
    friendly-name: option<string>,
    /// Only return Account resources with the given status. Can be `closed`, `suspended` or `active`.
    status: option<account-enum-status>,
    /// How many resources to return in each list page. The default is 50, and the maximum is 1000.
    page-size: option<s32>,
    /// The page index. This value is simply for client state.
    page: option<s32>,
    /// The page token. This is provided by the API.
    page-token: option<string>
  }
  list-account: func(params: list-account-params) -> result<string, string>;

  create-account: func() -> result<string, string>;

  record fetch-account-params {
    /// The Account Sid that uniquely identifies the account to fetch
    sid: string
  }
  fetch-account: func(params: fetch-account-params) -> result<string, string>;

  record update-account-params {
    /// The Account Sid that uniquely identifies the account to update
    sid: string
  }
  update-account: func(params: update-account-params) -> result<string, string>;

}


interface api20100401-address {
