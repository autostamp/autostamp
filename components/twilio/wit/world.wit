    /// The date and time in GMT that the resource was created specified in [RFC 2822](https://www.ietf.org/rfc/rfc2822.txt) format.
    date-created: option<string>,
    /// The date and time in GMT that the resource was last updated specified in [RFC 2822](https://www.ietf.org/rfc/rfc2822.txt) format.
    date-updated: option<string>,
    /// The SID of the emergency address configuration that we use for emergency calling from the phone number.
    emergency-address-sid: option<string>,
    emergency-status: option<dependent-phone-number-enum-emergency-status>,
    /// The string that you assigned to describe the resource.
    friendly-name: option<string>,
    /// The phone number in [E.164](https://www.twilio.com/docs/glossary/what-e164) format, which consists of a + followed by the country code and subscriber number.
    phone-number: option<string>,
    /// The unique string that that we created to identify the DependentPhoneNumber resource.
    sid: option<string>,
    /// The SID of the application that handles SMS messages sent to the phone number. If an `sms_application_sid` is present, we ignore all `sms_*_url` values and use those of the application.
    sms-application-sid: option<string>,
    /// The HTTP method we use to call `sms_fallback_url`. Can be: `GET` or `POST`.
    sms-fallback-method: option<api-v2010-account-address-dependent-phone-number-sms-fallback-method-enum>,
    /// The URL that we call when an error occurs while retrieving or executing the TwiML from `sms_url`.
    sms-fallback-url: option<string>,
    /// The HTTP method we use to call `sms_url`. Can be: `GET` or `POST`.
    sms-method: option<api-v2010-account-address-dependent-phone-number-sms-fallback-method-enum>,
    /// The URL we call when the phone number receives an incoming SMS message.
    sms-url: option<string>,
    /// The URL we call using the `status_callback_method` to send status information to your application.
    status-callback: option<string>,
    /// The HTTP method we use to call `status_callback`. Can be: `GET` or `POST`.
    status-callback-method: option<api-v2010-account-address-dependent-phone-number-sms-fallback-method-enum>,
    /// The SID of the Trunk that handles calls to the phone number. If a `trunk_sid` is present, we ignore all of the voice urls and voice applications and use those set on the Trunk. Setting a `trunk_sid` will automatically delete your `voice_application_sid` and vice versa.
    trunk-sid: option<string>,
    /// The URI of the resource, relative to `https://api.twilio.com`.
    uri: option<string>,
    /// The SID of the application that handles calls to the phone number. If a `voice_application_sid` is present, we ignore all of the voice urls and use those set on the application. Setting a `voice_application_sid` will automatically delete your `trunk_sid` and vice versa.
    voice-application-sid: option<string>,
    /// Whether we look up the caller's caller-ID name from the CNAM database. Can be: `true` or `false`. Caller ID lookups can cost $0.01 each.
    voice-caller-id-lookup: option<bool>,
    /// The HTTP method we use to call `voice_fallback_url`. Can be: `GET` or `POST`.
    voice-fallback-method: option<api-v2010-account-address-dependent-phone-number-sms-fallback-method-enum>,
    /// The URL that we call when an error occurs retrieving or executing the TwiML requested by `url`.
    voice-fallback-url: option<string>,
    /// The HTTP method we use to call `voice_url`. Can be: `GET` or `POST`.
    voice-method: option<api-v2010-account-address-dependent-phone-number-sms-fallback-method-enum>,
    /// The URL we call when the phone number receives a call. The `voice_url` will not be used if a `voice_application_sid` or a `trunk_sid` is set.
    voice-url: option<string>
  }

  record list-dependent-phone-number-params {
    /// The SID of the [Account](https://www.twilio.com/docs/iam/api/account) that created the DependentPhoneNumber resources to read.
