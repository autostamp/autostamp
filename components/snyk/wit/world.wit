    bad-request(string),
    other(string)
  }

  variant get-list-of-latest-issues-error {
    bad-request(string),
    other(string)
  }

  /// Get issue counts
  record get-issue-counts-params {
    /// The date you wish to fetch results from, in the format `YYYY-MM-DD`
