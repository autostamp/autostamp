  get-an-organization-s-entitlement-value: func(params: get-an-organization-s-entitlement-value-params) -> result<string, string>;

  /// List all entitlements
  record list-all-entitlements-params {
    /// The organization ID to list entitlements for. The `API_KEY` must have access to this organization.
    org-id: string
  }
  list-all-entitlements: func(params: list-all-entitlements-params) -> result<string, string>;

}

interface integrations {
  enum retrieve-response-pull-request-assignment-type-op-enum {
    auto,
    manual,
  }

  record list-op-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record retrieve-response {
    /// Defines if the functionality is enabled
    auto-dep-upgrade-enabled: option<bool>,
    /// A list of strings defining what dependencies should be ignored
    auto-dep-upgrade-ignored-dependencies: option<list<string>>,
    /// A limit on how many automatic dependency upgrade PRs can be opened simultaneously
    auto-dep-upgrade-limit: option<f64>,
    /// The age (in days) that an automatic dependency check is valid for
    auto-dep-upgrade-min-age: option<f64>,
    /// Defines automatic remediation policies
    auto-remediation-prs: option<retrieve-response-auto-remediation-prs>,
    /// If true, will automatically detect and scan Dockerfiles in your Git repositories, surface base image vulnerabilities and recommend possible fixes
    dockerfile-scm-enabled: option<bool>,
    /// Defines manual remediation policies
    manual-remediation-prs: option<retrieve-response-manual-remediation-prs>,
    /// assign Snyk pull requests
    pull-request-assignment: option<retrieve-response-pull-request-assignment>,
    /// If an opened PR should fail to be validated if any vulnerable dependencies have been detected
    pull-request-fail-on-any-vulns: option<bool>,
    /// If an opened PR only should fail its validation if any dependencies are marked as being of high severity
    pull-request-fail-only-for-high-severity: option<bool>,
    /// If opened PRs should be tested
    pull-request-test-enabled: option<bool>
  }

  /// Defines automatic remediation policies
  record retrieve-response-auto-remediation-prs {
    /// If true, allows automatic remediation of prioritized backlog issues
    backlog-prs-enabled: option<bool>,
    /// If true, allows automatic remediation of newly identified issues, or older issues where a fix has been identified
    fresh-prs-enabled: option<bool>,
    /// If true, allows using patched remediation
    use-patch-remediation: option<bool>
  }

  /// Defines manual remediation policies
  record retrieve-response-manual-remediation-prs {
    /// If true, allows using patched remediation
    use-patch-remediation: option<bool>
  }

  /// assign Snyk pull requests
  record retrieve-response-pull-request-assignment {
    /// an array of usernames that have contributed to the organization's project(s).
    assignees: option<list<string>>,
    /// if the organization's project(s) will assign Snyk pull requests.
    enabled: option<bool>,
    /// a string representing the type of assignment your projects require.
    type-op: option<retrieve-response-pull-request-assignment-type-op-enum>
  }

  /// Defines automatic remediation policies
  record update-body-auto-remediation-prs {
    /// If true, allows automatic remediation of prioritized backlog issues
    backlog-prs-enabled: option<bool>,
    /// If true, allows automatic remediation of newly identified issues, or older issues where a fix has been identified
    fresh-prs-enabled: option<bool>,
    /// If true, allows using patched remediation
    use-patch-remediation: option<bool>
  }

  /// Defines manual remediation policies
  record update-body-manual-remediation-prs {
    /// If true, allows using patched remediation
    use-patch-remediation: option<bool>
  }

  /// assign Snyk pull requests
  record update-body-pull-request-assignment {
    /// an array of usernames that have contributed to the organization's project(s).
    assignees: option<list<string>>,
    /// if the organization's project(s) will assign Snyk pull requests.
    enabled: option<bool>,
    /// a string representing the type of assignment your projects require.
    type-op: option<retrieve-response-pull-request-assignment-type-op-enum>
  }

  record update-response {
    /// Defines if the functionality is enabled
    auto-dep-upgrade-enabled: option<bool>,
    /// A list of strings defining what dependencies should be ignored
    auto-dep-upgrade-ignored-dependencies: option<list<string>>,
    /// A limit on how many automatic dependency upgrade PRs can be opened simultaneously
    auto-dep-upgrade-limit: option<f64>,
    /// The age (in days) that an automatic dependency check is valid for
    auto-dep-upgrade-min-age: option<f64>,
    /// Defines automatic remediation policies
    auto-remediation-prs: option<update-response-auto-remediation-prs>,
    /// If true, will automatically detect and scan Dockerfiles in your Git repositories, surface base image vulnerabilities and recommend possible fixes
    dockerfile-scm-enabled: option<bool>,
    /// Defines manual remediation policies
    manual-remediation-prs: option<update-response-manual-remediation-prs>,
    /// assign Snyk pull requests
    pull-request-assignment: option<update-response-pull-request-assignment>,
    /// If an opened PR should fail to be validated if any vulnerable dependencies have been detected
    pull-request-fail-on-any-vulns: option<bool>,
    /// If an opened PR only should fail its validation if any dependencies are marked as being of high severity
    pull-request-fail-only-for-high-severity: option<bool>,
    /// If opened PRs should be tested
    pull-request-test-enabled: option<bool>
  }

  /// Defines automatic remediation policies
  record update-response-auto-remediation-prs {
    /// If true, allows automatic remediation of prioritized backlog issues
    backlog-prs-enabled: option<bool>,
    /// If true, allows automatic remediation of newly identified issues, or older issues where a fix has been identified
    fresh-prs-enabled: option<bool>,
    /// If true, allows using patched remediation
    use-patch-remediation: option<bool>
  }

  /// Defines manual remediation policies
  record update-response-manual-remediation-prs {
    /// If true, allows using patched remediation
    use-patch-remediation: option<bool>
  }

  /// assign Snyk pull requests
  record update-response-pull-request-assignment {
    /// an array of usernames that have contributed to the organization's project(s).
    assignees: option<list<string>>,
    /// if the organization's project(s) will assign Snyk pull requests.
    enabled: option<bool>,
    /// a string representing the type of assignment your projects require.
    type-op: option<retrieve-response-pull-request-assignment-type-op-enum>
  }

  record get-existing-integration-by-type-response {
    /// Alphanumeric UUID including - with a limit of 36 characters
    id: option<string>
  }

  /// List
  record list-op-params {
    /// The organization public ID. The `API_KEY` must have admin access to this organization.
    org-id: string
  }
  list-op: func(params: list-op-params) -> result<list-op-response, string>;

  /// Add new integration
  record add-new-integration-params {
    /// The organization ID. The `API_KEY` must have admin access to this organization.
    org-id: string,
    body: option<string>
  }
  add-new-integration: func(params: add-new-integration-params) -> result<string, string>;

  /// Update existing integration
  record update-existing-integration-params {
    /// The organization ID. The `API_KEY` must have admin access to this organization.
    org-id: string,
    /// The unique identifier for the configured integration. This can be found on the [Integration page in the Settings area](https://app.snyk.io/manage/integrations) for all integrations that have been configured.
    integration-id: string,
    body: option<string>
  }
  update-existing-integration: func(params: update-existing-integration-params) -> result<string, string>;

  /// Delete credentials
  record delete-credentials-params {
    /// The organization ID. The `API_KEY` must have access to this organization.
    org-id: string,
    /// The integration ID.
    integration-id: string
  }
  delete-credentials: func(params: delete-credentials-params) -> result<string, string>;

  /// Provision new broker token
  record provision-new-broker-token-params {
    /// The `API_KEY` must have access to this organization.
    org-id: string,
    integration-id: string
  }
  provision-new-broker-token: func(params: provision-new-broker-token-params) -> result<string, string>;

  /// Switch between broker tokens
  record switch-between-broker-tokens-params {
    /// The `API_KEY` must have access to this organization.
    org-id: string,
    integration-id: string
  }
  switch-between-broker-tokens: func(params: switch-between-broker-tokens-params) -> result<string, string>;

  /// Clone an integration (with settings and credentials)
  record clone-an-integration-with-settings-and-credentials-params {
    /// Source organization public ID to clone integration settings from. The `API_KEY` must have access to this organization.
    org-id: string,
    /// Source integration public ID to clone.
    integration-id: string,
    /// The organization public ID. The `API_KEY` must have access to this organization.
    destination-org-public-id: string
  }
  clone-an-integration-with-settings-and-credentials: func(params: clone-an-integration-with-settings-and-credentials-params) -> result<string, string>;

  /// Retrieve
  record retrieve-params {
    /// The organization ID. The `API_KEY` must have admin access to this organization.
    org-id: string,
    /// The unique identifier for the configured integration. This can be found on the [Integration page in the Settings area](https://app.snyk.io/manage/integrations) for all integrations that have been configured.
    integration-id: string
  }
  retrieve: func(params: retrieve-params) -> result<retrieve-response, string>;

  /// Update
  record update-params {
    /// The organization ID. The `API_KEY` must have admin access to this organization.
    org-id: string,
    /// The unique identifier for the configured integration. This can be found on the [Integration page in the Settings area](https://app.snyk.io/manage/integrations) for all integrations that have been configured.
    integration-id: string,
    /// Defines if the functionality is enabled
    auto-dep-upgrade-enabled: option<bool>,
    /// A list of strings defining what dependencies should be ignored
    auto-dep-upgrade-ignored-dependencies: option<list<string>>,
    /// A limit on how many automatic dependency upgrade PRs can be opened simultaneously
    auto-dep-upgrade-limit: option<f64>,
    /// The age (in days) that an automatic dependency check is valid for
    auto-dep-upgrade-min-age: option<f64>,
    /// Defines automatic remediation policies
    auto-remediation-prs: option<update-body-auto-remediation-prs>,
    /// If true, will automatically detect and scan Dockerfiles in your Git repositories, surface base image vulnerabilities and recommend possible fixes
    dockerfile-scm-enabled: option<bool>,
    /// Defines manual remediation policies
    manual-remediation-prs: option<update-body-manual-remediation-prs>,
    /// assign Snyk pull requests
    pull-request-assignment: option<update-body-pull-request-assignment>,
    /// If an opened PR should fail to be validated if any vulnerable dependencies have been detected
    pull-request-fail-on-any-vulns: option<bool>,
    /// If an opened PR only should fail its validation if any dependencies are marked as being of high severity
    pull-request-fail-only-for-high-severity: option<bool>,
    /// If opened PRs should be tested
    pull-request-test-enabled: option<bool>
  }
  update: func(params: update-params) -> result<update-response, string>;

  /// Get existing integration by type
  record get-existing-integration-by-type-params {
    /// The `API_KEY` must have admin access to this organization.
    org-id: string,
    /// Integration type.
    type-op: string
  }
  get-existing-integration-by-type: func(params: get-existing-integration-by-type-params) -> result<get-existing-integration-by-type-response, string>;

}

interface import-projects {
  record get-import-job-details-response {
    /// the time when an import job was created represented as a [UTC (ISO-8601)](https://tools.ietf.org/html/rfc3339) string
    created: option<string>,
    /// A uuid representing the job's id
    id: option<string>,
    /// all organizations imported by the job
    logs: option<list<string>>,
    /// a string representing the status of a job.
    /// 
    status: option<string>
  }

  /// Import targets
  record import-targets-params {
    /// The organization ID. The `API_KEY` must have admin access to this organization.
    org-id: string,
    /// The unique identifier for the configured integration. This can be found on the [Integration page in the Settings area](https://app.snyk.io/manage/integrations) for all integrations that have been configured.
    integration-id: string,
    body: option<string>
  }
  import-targets: func(params: import-targets-params) -> result<string, string>;

  /// Get import job details
  record get-import-job-details-params {
    /// The organization ID. The `API_KEY` must have admin access to this organization.
    org-id: string,
    /// The unique identifier for the configured integration. This can be found on the [Integration page in the Settings area](https://app.snyk.io/manage/integrations) for all integrations that have been configured.
    integration-id: string,
    /// The ID of the job. This can be found in the Location response header from the corresponding POST request that triggered the import job.
    job-id: string
  }
  get-import-job-details: func(params: get-import-job-details-params) -> result<get-import-job-details-response, string>;

}

interface licenses {
  enum list-all-licenses-sort-by-enum {
    license,
    dependencies,
    projects,
    severity,
  }

  enum list-all-licenses-order-enum {
    asc,
    desc,
  }

  enum list-all-licenses-response-results-item-severity-enum {
    none,
    high,
    medium,
    low,
  }

  record list-all-licenses-body-filters {
    /// The list of dependency IDs to filter the results by
    dependencies: option<string>,
    /// The type of languages to filter the results by
    languages: option<list<string>>,
    /// The list of license IDs to filter the results by
    licenses: option<string>,
    /// The list of project IDs to filter the results by
    projects: option<string>,
    /// The severities to filter the results by
    severity: option<list<string>>
  }

  record list-all-licenses-response {
    /// A list of licenses
    results: list<list-all-licenses-response-results-item>,
    /// The number of results returned
    total: option<f64>
  }

  record list-all-licenses-response-results-item {
    /// The dependencies of projects in the organization which have the license
    dependencies: list<list-all-licenses-response-results-item-dependencies-item>,
    /// The identifier of the license
    id: string,
    /// Custom instructions assigned to this license
    instructions: option<string>,
    /// The projects which contain the license
    projects: list<list-all-licenses-response-results-item-projects-item>,
    /// The severity assigned to this license
    severity: option<list-all-licenses-response-results-item-severity-enum>
  }

  record list-all-licenses-response-results-item-dependencies-item {
    /// The identifier of the package
    id: string,
    /// The name of the package
    name: string,
    /// The package manager of the dependency
    package-manager: string,
    /// The version of the package
    version: string
  }

  record list-all-licenses-response-results-item-projects-item {
    /// The identifier of the project
    id: string,
    /// The name of the project
    name: string
  }

  /// List all licenses
  record list-all-licenses-params {
    /// The organization ID to list projects for. The `API_KEY` must have access to this organization.
    org-id: string,
    /// The field to sort results by.
    sort-by: option<list-all-licenses-sort-by-enum>,
    /// The direction to sort results by.
    order: option<list-all-licenses-order-enum>,
    filters: option<list-all-licenses-body-filters>
  }
  list-all-licenses: func(params: list-all-licenses-params) -> result<list-all-licenses-response, string>;

}

interface projects {
  enum list-all-project-snapshots-response-snapshots-item-method-enum {
    api,
    cli,
    recurring,
    web,
    web-test,
    wizard,
  }

  enum add-ignore-body-reason-type-enum {
    not-vulnerable,
    wont-fix,
    temporary-ignore,
  }

  enum list-project-settings-response-pull-request-assignment-type-op-enum {
    auto,
    manual,
  }

  record retrieve-a-single-project-response {
    /// Applied project attributes
    attributes: option<retrieve-a-single-project-response-attributes>,
    /// The monitored branch (if available)
    branch: option<string>,
    /// URL with project overview
    browse-url: option<string>,
    /// The date that the project was created on
    created: option<string>,
    /// The hostname for a CLI project, null if not set
    hostname: option<string>,
    /// The project identifier
    id: option<string>,
    /// For docker projects shows the base image
    image-base-image: option<string>,
    /// For Kubernetes projects shows the origin cluster name
    image-cluster: option<string>,
    /// For docker projects shows the ID of the image
    image-id: option<string>,
    /// For docker projects shows the platform of the image
    image-platform: option<string>,
    /// For docker projects shows the tag of the image
    image-tag: option<string>,
    /// The user who imported the project
    importing-user: option<retrieve-a-single-project-response-importing-user>,
    /// Describes if a project is currently monitored or it is de-activated
    is-monitored: option<bool>,
    /// Number of known vulnerabilities in the project, not including ignored issues
    issue-counts-by-severity: option<retrieve-a-single-project-response-issue-counts-by-severity>,
    /// The date on which the most recent test was conducted for this project
    last-tested-date: option<string>,
    name: option<string>,
    /// The origin the project was added from
    origin: option<string>,
    /// The user who owns the project, null if not set
    /// 
    owner: option<retrieve-a-single-project-response-owner>,
    /// Whether the project is read-only
    read-only: option<bool>,
    /// Remediation data (if available)
    remediation: option<retrieve-a-single-project-response-remediation>,
    /// The project remote repository url. Only set for projects imported via the Snyk CLI tool.
    remote-repo-url: option<string>,
    /// List of applied tags
    tags: option<list<string>>,
    /// The identifier for which revision of the resource is scanned by Snyk. For example this may be a branch for SCM project, or a tag for a container image
    target-reference: option<string>,
    /// The frequency of automated Snyk re-test. Can be 'daily', 'weekly or 'never'
    test-frequency: option<string>,
    /// Number of dependencies of the project
    total-dependencies: option<f64>,
    /// The package manager of the project
    type-op: option<string>
  }

  /// Applied project attributes
  record retrieve-a-single-project-response-attributes {
    criticality: option<list<string>>,
    environment: option<list<string>>,
    lifecycle: option<list<string>>
  }

  /// The user who imported the project
  record retrieve-a-single-project-response-importing-user {
    /// The email of the user.
    email: option<string>,
    /// The ID of the user.
    id: option<string>,
    /// The name of the user.
    name: option<string>,
    /// The username of the user.
    username: option<string>
  }

  /// Number of known vulnerabilities in the project, not including ignored issues
  record retrieve-a-single-project-response-issue-counts-by-severity {
    /// Number of critical severity vulnerabilities
    critical: option<f64>,
    /// Number of high severity vulnerabilities
    high: option<f64>,
    /// Number of low severity vulnerabilities
    low: option<f64>,
    /// Number of medium severity vulnerabilities
    medium: option<f64>
  }

  /// The user who owns the project, null if not set
  /// 
  /// {
  ///     "id": "e713cf94-bb02-4ea0-89d9-613cce0caed2",
  ///     "name": "example-user@snyk.io",
  ///     "username": "exampleUser",
  ///     "email": "example-user@snyk.io"
  /// }
  record retrieve-a-single-project-response-owner {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Remediation data (if available)
  record retrieve-a-single-project-response-remediation {
    /// Recommended patches to apply to the project
    /// 
    patch: option<retrieve-a-single-project-response-remediation-patch>,
    /// Recommended pins to apply to the project (Python only)
    /// 
    pin: option<retrieve-a-single-project-response-remediation-pin>,
    /// Recommended upgrades to apply to the project
    /// 
    upgrade: option<retrieve-a-single-project-response-remediation-upgrade>
  }

  /// Recommended patches to apply to the project
  /// 
  /// (object)
  ///    paths (array) - List of paths to the vulnerable dependency that can be patched
  record retrieve-a-single-project-response-remediation-patch {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Recommended pins to apply to the project (Python only)
  /// 
  /// (object)
  ///     + upgradeTo (string, required) - `package@version` to upgrade to
  ///     + vulns (array[string], required) - List of vulnerability ids that will be fixed as part of this upgrade
  ///     + isTransitive (boolean) - Describes if the dependency to be pinned is a transitive dependency
  record retrieve-a-single-project-response-remediation-pin {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Recommended upgrades to apply to the project
  /// 
  /// (object)
  ///     + upgradeTo (string, required) - `package@version` to upgrade to
  ///     + upgrades (array[string], required) -  List of `package@version` that will be upgraded as part of this upgrade
  ///     + vulns (array[string], required) - List of vulnerability ids that will be fixed as part of this upgrade
  record retrieve-a-single-project-response-remediation-upgrade {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Set to `null` to remove all ownership. User must be a member of the same organization as the project.
  record update-a-project-body-owner {
    /// A user to assign as the project owner.
    id: option<string>
  }

  record update-a-project-response {
    /// Applied project attributes
    attributes: option<update-a-project-response-attributes>,
    /// The monitored branch (if available)
    branch: option<string>,
    /// URL with project overview
    browse-url: option<string>,
    /// The date that the project was created on
    created: option<string>,
    /// The hostname for a CLI project, null if not set
    hostname: option<string>,
    /// The project identifier
    id: option<string>,
    /// For docker projects shows the base image
    image-base-image: option<string>,
    /// For Kubernetes projects shows the origin cluster name
    image-cluster: option<string>,
    /// For docker projects shows the ID of the image
    image-id: option<string>,
    /// For docker projects shows the platform of the image
    image-platform: option<string>,
    /// For docker projects shows the tag of the image
    image-tag: option<string>,
    /// The user who imported the project
    importing-user: option<update-a-project-response-importing-user>,
    /// Describes if a project is currently monitored or it is de-activated
    is-monitored: option<bool>,
    /// Number of known vulnerabilities in the project, not including ignored issues
    issue-counts-by-severity: option<update-a-project-response-issue-counts-by-severity>,
    /// The date on which the most recent test was conducted for this project
    last-tested-date: option<string>,
    name: option<string>,
    /// The origin the project was added from
    origin: option<string>,
    /// The user who owns the project, null if not set
    /// 
    owner: option<update-a-project-response-owner>,
    /// Whether the project is read-only
    read-only: option<bool>,
    /// Remediation data (if available)
    remediation: option<update-a-project-response-remediation>,
    /// The project remote repository url. Only set for projects imported via the Snyk CLI tool.
    remote-repo-url: option<string>,
    /// List of applied tags
    tags: option<list<string>>,
    /// The identifier for which revision of the resource is scanned by Snyk. For example this may be a branch for SCM project, or a tag for a container image
    target-reference: option<string>,
    /// The frequency of automated Snyk re-test. Can be 'daily', 'weekly or 'never'
    test-frequency: option<string>,
    /// Number of dependencies of the project
    total-dependencies: option<f64>,
    /// The package manager of the project
    type-op: option<string>
  }

  /// Applied project attributes
  record update-a-project-response-attributes {
    criticality: option<list<string>>,
    environment: option<list<string>>,
    lifecycle: option<list<string>>
  }

  /// The user who imported the project
  record update-a-project-response-importing-user {
    /// The email of the user.
    email: option<string>,
    /// The ID of the user.
    id: option<string>,
    /// The name of the user.
    name: option<string>,
    /// The username of the user.
    username: option<string>
  }

  /// Number of known vulnerabilities in the project, not including ignored issues
  record update-a-project-response-issue-counts-by-severity {
    /// Number of critical severity vulnerabilities
    critical: option<f64>,
    /// Number of high severity vulnerabilities
    high: option<f64>,
    /// Number of low severity vulnerabilities
    low: option<f64>,
    /// Number of medium severity vulnerabilities
    medium: option<f64>
  }

  /// The user who owns the project, null if not set
  /// 
  /// {
  ///     "id": "e713cf94-bb02-4ea0-89d9-613cce0caed2",
  ///     "name": "example-user@snyk.io",
  ///     "username": "exampleUser",
  ///     "email": "example-user@snyk.io"
  /// }
  record update-a-project-response-owner {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Remediation data (if available)
  record update-a-project-response-remediation {
    /// Recommended patches to apply to the project
    /// 
    patch: option<update-a-project-response-remediation-patch>,
    /// Recommended pins to apply to the project (Python only)
    /// 
    pin: option<update-a-project-response-remediation-pin>,
    /// Recommended upgrades to apply to the project
    /// 
    upgrade: option<update-a-project-response-remediation-upgrade>
  }

  /// Recommended patches to apply to the project
  /// 
  /// (object)
  ///    paths (array) - List of paths to the vulnerable dependency that can be patched
  record update-a-project-response-remediation-patch {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Recommended pins to apply to the project (Python only)
  /// 
  /// (object)
  ///     + upgradeTo (string, required) - `package@version` to upgrade to
  ///     + vulns (array[string], required) - List of vulnerability ids that will be fixed as part of this upgrade
  ///     + isTransitive (boolean) - Describes if the dependency to be pinned is a transitive dependency
  record update-a-project-response-remediation-pin {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Recommended upgrades to apply to the project
  /// 
  /// (object)
  ///     + upgradeTo (string, required) - `package@version` to upgrade to
  ///     + upgrades (array[string], required) -  List of `package@version` that will be upgraded as part of this upgrade
  ///     + vulns (array[string], required) - List of vulnerability ids that will be fixed as part of this upgrade
  record update-a-project-response-remediation-upgrade {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

