    auto-dep-upgrade-ignored-dependencies: option<list<string>>,
    /// The limit on auto dependency upgrade PRs.
    auto-dep-upgrade-limit: option<f64>,
    /// The age (in days) that an automatic dependency check is valid for
    auto-dep-upgrade-min-age: option<f64>,
    /// Defines automatic remediation policies
    auto-remediation-prs: option<update-project-settings-body-auto-remediation-prs>,
    /// assign Snyk pull requests
    pull-request-assignment: option<update-project-settings-body-pull-request-assignment>,
    /// If set to `true`, fail Snyk Test if the repo has any vulnerabilities. Otherwise, fail only when the PR is adding a vulnerable dependency.
    pull-request-fail-on-any-vulns: option<bool>,
    /// If set to `true`, fail Snyk Test only for high and critical severity vulnerabilities
    pull-request-fail-only-for-high-severity: option<bool>,
    /// If set to `true`, Snyk Test checks PRs for vulnerabilities.:cq
    pull-request-test-enabled: option<bool>
  }
  update-project-settings: func(params: update-project-settings-params) -> result<update-project-settings-response, string>;

  /// Delete project settings
  record delete-project-settings-params {
    /// Automatically added
    org-id: string,
    /// Automatically added
    project-id: string
  }
  delete-project-settings: func(params: delete-project-settings-params) -> result<string, string>;

  /// Add a tag to a project
  record add-a-tag-to-a-project-params {
    /// The organization ID. The `API_KEY` must have access to this organization.
    org-id: string,
    /// The project ID to apply the tag to
    project-id: string,
    /// Alphanumeric including - and _ with a limit of 30 characters
    key: option<string>,
    /// Alphanumeric including - and _ with a limit of 50 characters
    value: option<string>
  }
  add-a-tag-to-a-project: func(params: add-a-tag-to-a-project-params) -> result<add-a-tag-to-a-project-response, string>;

  /// Remove a tag from a project
  record remove-a-tag-from-a-project-params {
    /// The organization ID. The `API_KEY` must have access to this organization.
    org-id: string,
    /// The project ID to remove a tag from
    project-id: string,
    /// Alphanumeric including - and _ with a limit of 30 characters
    key: option<string>,
    /// Alphanumeric including - and _ with a limit of 50 characters
    value: option<string>
  }
  remove-a-tag-from-a-project: func(params: remove-a-tag-from-a-project-params) -> result<remove-a-tag-from-a-project-response, string>;

  /// List all projects
  record list-all-projects-params {
    /// The organization ID to list projects for. The `API_KEY` must have access to this organization.
    org-id: string,
    filters: option<list-all-projects-body-filters>
  }
  list-all-projects: func(params: list-all-projects-params) -> result<list-all-projects-response, string>;

}

interface webhooks {
  /// List webhooks
  record list-webhooks-params {
    /// The organization ID to list projects for. The `API_KEY` must have access to this organization.
    org-id: string
  }
  list-webhooks: func(params: list-webhooks-params) -> result<string, string>;

  /// Create a webhook
  record create-a-webhook-params {
    /// The organization ID to list projects for. The `API_KEY` must have access to this organization.
    org-id: string,
    /// This is a password you create, that Snyk uses to sign our transports to you, so you be sure the notification is authentic. Your `secret` should: Be a random string with high entropy; Not be used for anything else; Only known to Snyk and your webhook transport consuming code;
    secret: option<string>,
    /// Webhooks can only be configured for URLs using the `https` protocol. `http` is not allowed.
    url: option<string>
  }
  create-a-webhook: func(params: create-a-webhook-params) -> result<string, string>;

  /// Retrieve a webhook
  record retrieve-a-webhook-params {
    /// The organization ID the project belongs to. The `API_KEY` must have access to this organization.
    org-id: string,
    /// The webhook ID.
    webhook-id: string
  }
  retrieve-a-webhook: func(params: retrieve-a-webhook-params) -> result<string, string>;

  /// Delete a webhook
  record delete-a-webhook-params {
    /// Automatically added
    org-id: string,
    /// Automatically added
    webhook-id: string
  }
  delete-a-webhook: func(params: delete-a-webhook-params) -> result<string, string>;

  /// Ping a webhook
  record ping-a-webhook-params {
    /// The organization ID the project belongs to. The `API_KEY` must have access to this organization.
    org-id: string,
    /// The webhook ID.
    webhook-id: string
  }
  ping-a-webhook: func(params: ping-a-webhook-params) -> result<string, string>;

}

interface reporting-api {
  enum get-issue-counts-group-by-enum {
    severity,
    fixable,
    project-severity-fixable,
  }

  enum get-test-counts-group-by-enum {
    is-private,
    issues-prevented,
  }

  enum get-list-of-issues-sort-by-enum {
    severity,
    issue-title,
    project-name,
    is-fixed,
    is-patched,
    is-ignored,
    introduced-date,
    is-upgradable,
    is-patchable,
    priority-score,
  }

  enum get-list-of-issues-group-by-enum {
    issue,
  }

  record get-issue-counts-body-filters {
    /// If set to `true`, only include issues which are fixable, if set to `false`, only include issues which are not fixable. An issue is fixable if it is either upgradable, patchable or pinnable. Also see isUpgradable, isPatchable and isPinnable filters.
    fixable: option<bool>,
    /// If set to `true`, only include issues which are ignored, if set to `false`, only include issues which are not ignored
    ignored: option<bool>,
    /// If set to `true`, only include issues which are patchable, if set to `false`, only include issues which are not patchable
    is-patchable: option<bool>,
    /// If set to `true`, only include issues which are pinnable, if set to `false`, only include issues which are not pinnable
    is-pinnable: option<bool>,
    /// If set to `true`, only include issues which are upgradable, if set to `false`, only include issues which are not upgradable
    is-upgradable: option<bool>,
    /// The type of languages to filter the results by
    languages: option<list<string>>,
    /// The list of org IDs to filter the results by
    orgs: string,
    /// If set to `true`, only include issues which are patched, if set to `false`, only include issues which are not patched
    patched: option<bool>,
    /// The priority score ranging between 0-1000
    priority-score: option<get-issue-counts-body-filters-priority-score>,
    /// The list of project IDs to filter issues by, max projects allowed is 1000
    projects: option<string>,
    /// The severity levels of issues to filter the results by
    severity: option<list<string>>,
    /// The type of issues to filter the results by
    types: option<list<string>>
  }

  /// The priority score ranging between 0-1000
  record get-issue-counts-body-filters-priority-score {
    max: option<f64>,
    min: option<f64>
  }

  record get-issue-counts-response {
    /// A list of issue counts by day
    results: list<get-issue-counts-response-results-item>
  }

  record get-issue-counts-response-results-item {
    /// The number of issues
    count: f64,
    /// The date in the format `YYYY-MM-DD`
    day: string,
    fixable: option<get-issue-counts-response-results-item-fixable>,
    severity: option<get-issue-counts-response-results-item-severity>
  }

  record get-issue-counts-response-results-item-fixable {
    /// The number of non-fixable issues
    false: option<f64>,
    /// The number of fixable issues
    true: option<f64>
  }

  record get-issue-counts-response-results-item-severity {
    /// The number of critical severity issues
    critical: option<f64>,
    /// The number of high severity issues
    high: option<f64>,
    /// The number of low severity issues
    low: option<f64>,
    /// The number of medium severity issues
    medium: option<f64>
  }

  record get-latest-issue-counts-body-filters {
    /// If set to `true`, only include issues which are fixable, if set to `false`, only include issues which are not fixable. An issue is fixable if it is either upgradable, patchable or pinnable. Also see isUpgradable, isPatchable and isPinnable filters.
    fixable: option<bool>,
    /// If set to `true`, only include issues which are ignored, if set to `false`, only include issues which are not ignored
    ignored: option<bool>,
    /// If set to `true`, only include issues which are patchable, if set to `false`, only include issues which are not patchable
    is-patchable: option<bool>,
    /// If set to `true`, only include issues which are pinnable, if set to `false`, only include issues which are not pinnable
    is-pinnable: option<bool>,
    /// If set to `true`, only include issues which are upgradable, if set to `false`, only include issues which are not upgradable
    is-upgradable: option<bool>,
    /// The type of languages to filter the results by
    languages: option<list<string>>,
    /// The list of org IDs to filter the results by
    orgs: string,
    /// If set to `true`, only include issues which are patched, if set to `false`, only include issues which are not patched
    patched: option<bool>,
    /// The priority score ranging between 0-1000
    priority-score: option<get-latest-issue-counts-body-filters-priority-score>,
    /// The list of project IDs to filter issues by, max projects allowed is 1000
    projects: option<string>,
    /// The severity levels of issues to filter the results by
    severity: option<list<string>>,
    /// The type of issues to filter the results by
    types: option<list<string>>
  }

  /// The priority score ranging between 0-1000
  record get-latest-issue-counts-body-filters-priority-score {
    max: option<f64>,
    min: option<f64>
  }

  record get-latest-issue-counts-response {
    /// A list of issue counts by day
    results: list<get-latest-issue-counts-response-results-item>
  }

  record get-latest-issue-counts-response-results-item {
    /// The number of issues
    count: f64,
    /// The date in the format `YYYY-MM-DD`
    day: string,
    fixable: option<get-latest-issue-counts-response-results-item-fixable>,
    severity: option<get-latest-issue-counts-response-results-item-severity>
  }

  record get-latest-issue-counts-response-results-item-fixable {
    /// The number of non-fixable issues
    false: option<f64>,
    /// The number of fixable issues
    true: option<f64>
  }

  record get-latest-issue-counts-response-results-item-severity {
    /// The number of critical severity issues
    critical: option<f64>,
    /// The number of high severity issues
    high: option<f64>,
    /// The number of low severity issues
    low: option<f64>,
    /// The number of medium severity issues
    medium: option<f64>
  }

  record get-project-counts-body-filters {
    /// The type of languages to filter the results by
    languages: option<list<string>>,
    /// The list of org IDs to filter the results by
    orgs: string,
    /// The list of project IDs to filter the results by, max projects allowed is 1000
    projects: option<string>
  }

  record get-project-counts-response {
    /// A list of project counts by day
    results: list<get-project-counts-response-results-item>
  }

  record get-project-counts-response-results-item {
    /// The number of projects
    count: f64,
    /// The date in the format `YYYY-MM-DD`
    day: string
  }

  record get-latest-project-counts-body-filters {
    /// The type of languages to filter the results by
    languages: option<list<string>>,
    /// The list of org IDs to filter the results by
    orgs: string,
    /// The list of project IDs to filter the results by, max projects allowed is 1000
    projects: option<string>
  }

  record get-latest-project-counts-response {
    /// A list of project counts by day
    results: list<get-latest-project-counts-response-results-item>
  }

  record get-latest-project-counts-response-results-item {
    /// The number of projects
    count: f64,
    /// The date in the format `YYYY-MM-DD`
    day: string
  }

  record get-test-counts-body-filters {
    /// If set to `true`, only include tests which were conducted against private projects, if set to `false` only include tests which were conducted against public projects
    is-private: option<bool>,
    /// If set to `true`, only include tests which prevented issues from being introduced, if set to `false` only include tests which did not prevent issues from being introduced
    issues-prevented: option<bool>,
    /// The list of org IDs to filter the results by
    orgs: string,
    /// The list of project IDs to filter issues by, max projects allowed is 1000
    projects: option<string>
  }

  record get-test-counts-response {
    /// A list of test counts
    results: list<get-test-counts-response-results-item>
  }

  record get-test-counts-response-results-item {
    /// The number of tests conducted
    count: f64,
    is-private: option<get-test-counts-response-results-item-is-private>,
    issues-prevented: option<get-test-counts-response-results-item-issues-prevented>
  }

  record get-test-counts-response-results-item-is-private {
    /// The number of tests conducted against public projects
    false: option<f64>,
    /// The number of tests conducted against private projects
    true: option<f64>
  }

  record get-test-counts-response-results-item-issues-prevented {
    /// The number of tests that did not prevent issues from being introduced
    false: option<f64>,
    /// The number of tests that prevented issues from being introduced
    true: option<f64>
  }

  record get-list-of-issues-body-filters {
    /// The exploit maturity levels of issues to filter the results by
    exploit-maturity: option<list<string>>,
    /// If set to `true`, only include issues which are fixable, if set to `false`, only include issues which are not fixable. An issue is fixable if it is either upgradable, patchable or pinnable. Also see isUpgradable, isPatchable and isPinnable filters.
    fixable: option<bool>,
    /// Search term to filter issue name by, or an exact CVE or CWE
    identifier: option<string>,
    /// If set to `true`, only include issues which are ignored, if set to `false`, only include issues which are not ignored
    ignored: option<bool>,
    /// If set to `true`, only include issues which are fixed, if set to `false`, only include issues which are not fixed
    is-fixed: option<bool>,
    /// If set to `true`, only include issues which are patchable, if set to `false`, only include issues which are not patchable
    is-patchable: option<bool>,
    /// If set to `true`, only include issues which are pinnable, if set to `false`, only include issues which are not pinnable
    is-pinnable: option<bool>,
    /// If set to `true`, only include issues which are upgradable, if set to `false`, only include issues which are not upgradable
    is-upgradable: option<bool>,
    /// The list of issue IDs to filter issues by
    issues: option<string>,
    /// The type of languages to filter the results by
    languages: option<list<string>>,
    /// The list of org IDs to filter the results by
    orgs: string,
    /// If set to `true`, only include issues which are patched, if set to `false`, only include issues which are not patched
    patched: option<bool>,
    /// The priority score ranging between 0-1000
    priority-score: option<get-list-of-issues-body-filters-priority-score>,
    /// The list of project IDs to filter issues by, max projects allowed is 1000
    projects: option<string>,
    /// The severity levels of issues to filter the results by
    severity: option<list<string>>,
    /// The type of issues to filter the results by
    types: option<list<string>>
  }

  /// The priority score ranging between 0-1000
  record get-list-of-issues-body-filters-priority-score {
    max: option<f64>,
    min: option<f64>
  }

  record get-list-of-issues-response {
    /// A list of issues
    results: list<get-list-of-issues-response-results-item>,
    /// The total number of results found
    total: f64
  }

  record get-list-of-issues-response-results-item {
    /// The date that the issue was fixed
    fixed-date: option<string>,
    /// The date that the issue was introduced into the project
    introduced-date: string,
    /// Whether the issue has been fixed
    is-fixed: bool,
    issue: get-list-of-issues-response-results-item-issue,
    /// The date that the issue was patched
    patched-date: option<string>
  }

  record get-list-of-issues-response-results-item-issue {
    /// The CVSS v3 string that signifies how the CVSS score was calculated (not applicable to licenses)
    cvs-sv3: option<string>,
    /// The list of people responsible for first uncovering or reporting the issue (not applicable to licenses)
    credit: option<list<string>>,
    /// The CVSS score that results from running the CVSSv3 string (not applicable to licenses)
    cvss-score: option<f64>,
    /// The date that the vulnerability was first disclosed (not applicable to licenses)
    disclosure-time: option<string>,
    /// The exploit maturity of the issue
    exploit-maturity: string,
    /// The identifier of the issue
    id: string,
    /// External identifiers assigned to the issue (not applicable to licenses)
    identifiers: option<get-list-of-issues-response-results-item-issue-identifiers>,
    /// The list of ignore rules that were applied to the issue (only present if issue was ignored and no `groupBy` in the API request)
    ignored: option<list<string>>,
    /// Whether the issue has been ignored (only present if there is no `groupBy` in the API request)
    is-ignored: option<bool>,
    /// Whether the issue can be patched
    is-patchable: option<bool>,
    /// Whether the issue has been patched (not applicable to licenses and only present if there is no `groupBy` in the API request)
    is-patched: option<bool>,
    /// Whether the issue can be pinned
    is-pinnable: option<bool>,
    /// Whether the issue can be fixed by upgrading to a later version of the dependency
    is-upgradable: option<bool>,
    /// The link to the Jira issue attached to the vulnerability
    jira-issue-url: option<string>,
    /// The language of the issue
    language: option<string>,
    /// The original severity status of the issue, as retrieved from Snyk Vulnerability database, before policies are applied
    original-severity: string,
    /// The name of the package that the issue relates to
    package-op: string,
    /// The package manager of the issue
    package-manager: option<string>,
    /// A list of patches available for the given issue (not applicable to licenses)
    patches: option<list<string>>,
    /// The priority score ranging between 0-1000
    priority-score: option<f64>,
    /// The date that the vulnerability was first published by Snyk (not applicable to licenses)
    publication-time: option<string>,
    /// The ranges that are vulnerable and unaffected by the issue
    semver: option<get-list-of-issues-response-results-item-issue-semver>,
    /// The severity status of the issue, after policies are applied
    severity: string,
    /// The issue title
    title: string,
    /// The issue type, can be "vuln", "license"
    type-op: string,
    /// A list of all severities in issue per projects
    unique-severities-list: option<list<string>>,
    /// URL to a page containing information about the issue
    url: string,
    /// The version of the package that the issue relates to
    version: string
  }

  /// External identifiers assigned to the issue (not applicable to licenses)
  record get-list-of-issues-response-results-item-issue-identifiers {
    /// Common Vulnerability Enumeration identifiers
    cve: option<list<string>>,
    /// Common Weakness Enumeration identifiers
    cwe: option<list<string>>,
    /// Identifiers assigned by the Open Source Vulnerability Database (OSVDB)
    osvdb: option<list<string>>
  }

  /// The ranges that are vulnerable and unaffected by the issue
  record get-list-of-issues-response-results-item-issue-semver {
    /// The ranges that are unaffected by the issue
    unaffected: option<string>,
    /// The ranges that are vulnerable to the issue
    vulnerable: option<list<string>>
  }

  record get-list-of-latest-issues-body-filters {
    /// The exploit maturity levels of issues to filter the results by
    exploit-maturity: option<list<string>>,
    /// If set to `true`, only include issues which are fixable, if set to `false`, only include issues which are not fixable. An issue is fixable if it is either upgradable, patchable or pinnable. Also see isUpgradable, isPatchable and isPinnable filters.
    fixable: option<bool>,
    /// Search term to filter issue name by, or an exact CVE or CWE
    identifier: option<string>,
    /// If set to `true`, only include issues which are ignored, if set to `false`, only include issues which are not ignored
    ignored: option<bool>,
    /// If set to `true`, only include issues which are fixed, if set to `false`, only include issues which are not fixed
    is-fixed: option<bool>,
    /// If set to `true`, only include issues which are patchable, if set to `false`, only include issues which are not patchable
    is-patchable: option<bool>,
    /// If set to `true`, only include issues which are pinnable, if set to `false`, only include issues which are not pinnable
    is-pinnable: option<bool>,
    /// If set to `true`, only include issues which are upgradable, if set to `false`, only include issues which are not upgradable
    is-upgradable: option<bool>,
    /// The list of issue IDs to filter issues by
    issues: option<string>,
    /// The type of languages to filter the results by
    languages: option<list<string>>,
    /// The list of org IDs to filter the results by
    orgs: string,
    /// If set to `true`, only include issues which are patched, if set to `false`, only include issues which are not patched
    patched: option<bool>,
    /// The priority score ranging between 0-1000
    priority-score: option<get-list-of-latest-issues-body-filters-priority-score>,
    /// The list of project IDs to filter issues by, max projects allowed is 1000
    projects: option<string>,
    /// The severity levels of issues to filter the results by
    severity: option<list<string>>,
    /// The type of issues to filter the results by
    types: option<list<string>>
  }

  /// The priority score ranging between 0-1000
  record get-list-of-latest-issues-body-filters-priority-score {
    max: option<f64>,
    min: option<f64>
  }

  record get-list-of-latest-issues-response {
    /// A list of issues
    results: list<get-list-of-latest-issues-response-results-item>,
    /// The total number of results found
    total: f64
  }

  record get-list-of-latest-issues-response-results-item {
    /// The date that the issue was fixed
    fixed-date: option<string>,
    /// The date that the issue was introduced into the project
    introduced-date: string,
    /// Whether the issue has been fixed
    is-fixed: bool,
    issue: get-list-of-latest-issues-response-results-item-issue,
    /// The date that the issue was patched
    patched-date: option<string>
  }

  record get-list-of-latest-issues-response-results-item-issue {
    /// The CVSS v3 string that signifies how the CVSS score was calculated (not applicable to licenses)
    cvs-sv3: option<string>,
    /// The list of people responsible for first uncovering or reporting the issue (not applicable to licenses)
    credit: option<list<string>>,
    /// The CVSS score that results from running the CVSSv3 string (not applicable to licenses)
    cvss-score: option<f64>,
    /// The date that the vulnerability was first disclosed (not applicable to licenses)
    disclosure-time: option<string>,
    /// The exploit maturity of the issue
    exploit-maturity: string,
    /// The identifier of the issue
    id: string,
    /// External identifiers assigned to the issue (not applicable to licenses)
    identifiers: option<get-list-of-latest-issues-response-results-item-issue-identifiers>,
    /// The list of ignore rules that were applied to the issue (only present if issue was ignored and no `groupBy` in the API request)
    ignored: option<list<string>>,
    /// Whether the issue has been ignored (only present if there is no `groupBy` in the API request)
    is-ignored: option<bool>,
    /// Whether the issue can be patched
    is-patchable: option<bool>,
    /// Whether the issue has been patched (not applicable to licenses and only present if there is no `groupBy` in the API request)
    is-patched: option<bool>,
    /// Whether the issue can be pinned
    is-pinnable: option<bool>,
    /// Whether the issue can be fixed by upgrading to a later version of the dependency
    is-upgradable: option<bool>,
    /// The link to the Jira issue attached to the vulnerability
    jira-issue-url: option<string>,
    /// The language of the issue
    language: option<string>,
    /// The original severity status of the issue, as retrieved from Snyk Vulnerability database, before policies are applied
    original-severity: string,
    /// The name of the package that the issue relates to
    package-op: string,
    /// The package manager of the issue
    package-manager: option<string>,
    /// A list of patches available for the given issue (not applicable to licenses)
    patches: option<list<string>>,
    /// The priority score ranging between 0-1000
    priority-score: option<f64>,
    /// The date that the vulnerability was first published by Snyk (not applicable to licenses)
    publication-time: option<string>,
    /// The ranges that are vulnerable and unaffected by the issue
    semver: option<get-list-of-latest-issues-response-results-item-issue-semver>,
    /// The severity status of the issue, after policies are applied
    severity: string,
    /// The issue title
    title: string,
    /// The issue type, can be "vuln", "license"
    type-op: string,
    /// A list of all severities in issue per projects
    unique-severities-list: option<list<string>>,
    /// URL to a page containing information about the issue
    url: string,
    /// The version of the package that the issue relates to
    version: string
  }

  /// External identifiers assigned to the issue (not applicable to licenses)
  record get-list-of-latest-issues-response-results-item-issue-identifiers {
    /// Common Vulnerability Enumeration identifiers
    cve: option<list<string>>,
    /// Common Weakness Enumeration identifiers
    cwe: option<list<string>>,
    /// Identifiers assigned by the Open Source Vulnerability Database (OSVDB)
    osvdb: option<list<string>>
  }

  /// The ranges that are vulnerable and unaffected by the issue
  record get-list-of-latest-issues-response-results-item-issue-semver {
    /// The ranges that are unaffected by the issue
    unaffected: option<string>,
    /// The ranges that are vulnerable to the issue
    vulnerable: option<list<string>>
  }

  variant get-issue-counts-error {
    bad-request(string),
    other(string)
  }

  variant get-latest-issue-counts-error {
    bad-request(string),
    other(string)
  }

  variant get-project-counts-error {
