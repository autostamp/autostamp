    /// The severity levels of issues to send notifications for (only applicable for `new-remediations-vulnerabilities` notificationType)
    issue-severity: get-organization-notification-settings-response-new-issues-remediations-issue-severity-enum,
    /// Filter the types of issue to include in notifications (only applicable for `new-remediations-vulnerabilities` notificationType)
    issue-type: get-organization-notification-settings-response-new-issues-remediations-issue-type-enum
  }

  record get-user-details-response {
    /// The email of the user.
    email: option<string>,
    /// The id of the user.
    id: option<string>,
    /// The name of the user.
    name: option<string>,
    /// The username of the user.
    username: option<string>
  }

  variant get-my-details-error {
    unauthorized(string),
    other(string)
  }

  variant get-user-details-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  /// Get My Details
  get-my-details: func() -> result<get-my-details-response, get-my-details-error>;

  /// Get organization notification settings
  record get-organization-notification-settings-params {
    /// The organization ID. The `API_KEY` must have access to this organization.
    org-id: string
  }
  get-organization-notification-settings: func(params: get-organization-notification-settings-params) -> result<get-organization-notification-settings-response, string>;

  /// Modify organization notification settings
  record modify-organization-notification-settings-params {
    /// Automatically added
    org-id: string,
    new-issues-remediations: option<modify-organization-notification-settings-body-new-issues-remediations>,
    project-imported: option<modify-organization-notification-settings-body-project-imported>,
    test-limit: option<modify-organization-notification-settings-body-test-limit>,
    weekly-report: option<modify-organization-notification-settings-body-weekly-report>
  }
  modify-organization-notification-settings: func(params: modify-organization-notification-settings-params) -> result<modify-organization-notification-settings-response, string>;

  /// Get project notification settings
  record get-project-notification-settings-params {
    /// The organization ID. The `API_KEY` must have access to this organization.
    org-id: string,
    /// The project ID to return notification settings for.
    project-id: string
  }
  get-project-notification-settings: func(params: get-project-notification-settings-params) -> result<get-project-notification-settings-response, string>;

  /// Modify project notification settings
  record modify-project-notification-settings-params {
    /// Automatically added
    org-id: string,
    /// Automatically added
    project-id: string,
    new-issues-remediations: option<modify-project-notification-settings-body-new-issues-remediations>
  }
  modify-project-notification-settings: func(params: modify-project-notification-settings-params) -> result<string, string>;

  /// Get User Details
  record get-user-details-params {
    /// The users ID. The `API_KEY` must have admin access to at least one group or organization where the requested user is a member and must have the `api` entitlement on their preferred organization.
    user-id: string
  }
  get-user-details: func(params: get-user-details-params) -> result<get-user-details-response, get-user-details-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export audit-logs;
  export groups;
  export monitor;
  export organizations;
  export dependencies;
  export entitlements;
  export integrations;
  export import-projects;
  export licenses;
  export projects;
  export webhooks;
  export reporting-api;
  export test;
  export users;
}
