package autostamp:azure@0.3.0;

interface operations {
  record list-op-params {
    /// Client API version.
    api-version: string
  }
  list-op: func(params: list-op-params) -> result<string, string>;

}


interface addon-status {
  record support-plan-types-list-info-params {
    /// Client API version.
    api-version: string,
    /// Subscription credentials that uniquely identify the Microsoft Azure subscription. The subscription ID forms part of the URI for every service call.
    subscription-id: string
  }
  support-plan-types-list-info: func(params: support-plan-types-list-info-params) -> result<string, string>;

}

interface addon-details {
  record support-plan-types-get-params {
    /// Client API version.
    api-version: string,
    /// Subscription credentials that uniquely identify the Microsoft Azure subscription. The subscription ID forms part of the URI for every service call.
    subscription-id: string,
    /// The support plan type. For now the only valid type is "canonical".
    provider-name: string,
    /// The Canonical support plan type.
    plan-type-name: string
  }
  support-plan-types-get: func(params: support-plan-types-get-params) -> result<string, string>;

  record support-plan-types-create-or-update-params {
    /// Client API version.
    api-version: string,
    /// Subscription credentials that uniquely identify the Microsoft Azure subscription. The subscription ID forms part of the URI for every service call.
    subscription-id: string,
    /// The support plan type. For now the only valid type is "canonical".
    provider-name: string,
    /// The Canonical support plan type.
    plan-type-name: string
  }
  support-plan-types-create-or-update: func(params: support-plan-types-create-or-update-params) -> result<string, string>;

}

interface subscriptions {
  record support-plan-types-delete-params {
    /// Client API version.
    api-version: string,
    /// Subscription credentials that uniquely identify the Microsoft Azure subscription. The subscription ID forms part of the URI for every service call.
    subscription-id: string,
    /// The support plan type. For now the only valid type is "canonical".
    provider-name: string,
    /// The Canonical support plan type.
    plan-type-name: string
  }
  support-plan-types-delete: func(params: support-plan-types-delete-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export operations;
  export addon-status;
  export addon-details;
  export subscriptions;
}
