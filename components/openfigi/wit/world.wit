package autostamp:openfigi@0.6.0;

interface mapping {
  enum job-id-type-enum {
    id-isin,
    id-bb-unique,
    id-sedol,
    id-common,
    id-wertpapier,
    id-cusip,
    id-bb,
    id-italy,
    id-exch-symbol,
    id-full-exchange-symbol,
    composite-id-bb-global,
    id-bb-global-share-class-level,
    id-bb-sec-num-des,
    id-bb-global,
    ticker,
    id-cusip-v8-chr,
    occ-symbol,
    unique-id-fut-opt,
    opra-symbol,
    trading-system-identifier,
    id-cins,
    id-short-code,
    base-ticker,
    vendor-index-code,
  }

  enum job-option-type-enum {
    put,
    call,
  }

  enum job-state-code-enum {
    ab,
    ac,
    ac-v2,
    ah,
    ak,
    al,
    am,
    ar,
    as-op,
    at,
    az,
    bc,
    bj,
    ca,
    cb,
    co,
    cq,
    ct,
    cz,
    dc,
    de,
    eh,
    fh,
    fi,
    fj,
    fl,
    fo,
    fs,
    ga,
    gd,
    gf,
    gm,
    gs,
    gu,
    gx,
    gz,
    ha,
    hb,
    he,
    hg,
    hi,
    hi-v2,
    hl,
    hn,
    ho,
    hs,
    ia,
    id,
    ig,
    ik,
    il,
    in,
    it,
    jl,
    js,
    jx,
    ka,
    kc,
    kn,
    ko,
    ks,
    kt,
    ku,
    ky,
    la,
    ln,
    ma,
    mb,
    md,
    me,
    me-v2,
    mg,
    mi,
    mn,
    mo,
    ms,
    mt,
    mz,
    nb,
    nc,
    nd,
    ne,
    ng,
    nh,
    nj,
    nl,
    nm,
    nm-v2,
    nn,
    nr,
    ns,
    ns-v2,
    ns-v3,
    nt,
    nu,
    nv,
    nw,
    nx,
    ny,
    oh,
    ok,
    on,
    on-v2,
    or,
    os,
    ot,
    ot-v2,
    oy,
    pa,
    pe,
    pr,
    qc,
    qh,
    ql,
    ri,
    sa,
    sa-v2,
    sc,
    sc-v2,
    sd,
    sd-v2,
    sh,
    si,
    sk,
    sn,
    sn-v2,
    st,
    sx,
    sz,
    ta,
    tg,
    tj,
    tk,
    tn,
    ts,
    tt,
    tt-v2,
    tx,
    ty,
    ut,
    va,
    vi,
    vi-v2,
    vt,
    wa,
    wa-v2,
    wi,
    wk,
    wv,
    wy,
    xj,
    xz,
    ya,
    yn,
    yn-v2,
    yt,
    yu,
    zj,
  }

  /// For V3: securityType2 is required when idType is BASE_TICKER or ID_EXCH_SYMBOL.  expiration is required when securityType2 is Option or Warrant.  maturity is required when securityType2 is Pool.
  record job {
    contract-size: option<list<f64>>,
    coupon: option<list<f64>>,
    currency: option<string>,
    exch-code: option<string>,
    expiration: option<list<string>>,
    id-type: job-id-type-enum,
    id-value: string,
    include-unlisted-equities: option<bool>,
    market-sec-des: option<string>,
    maturity: option<list<string>>,
    mic-code: option<string>,
    option-type: option<job-option-type-enum>,
    security-type: option<string>,
    security-type2: option<string>,
    state-code: option<job-state-code-enum>,
    strike: option<list<f64>>
  }

  record get-mapping-values-key-response {
    values: option<list<string>>
  }

  variant post-mapping-error {
    bad-request(string),
    unauthorized(string),
    not-acceptable(string),
    payload-too-large(string),
    internal-server-error(string),
    other(string)
  }

  variant get-mapping-values-key-error {
    bad-request(string),
    internal-server-error(string),
    other(string)
  }

  record post-mapping-params {
    body: option<list<job>>
  }
  post-mapping: func(params: post-mapping-params) -> result<list<string>, post-mapping-error>;

  record get-mapping-values-key-params {
    /// Key of MappingJob for which to get possible values.
    key: string
  }
  get-mapping-values-key: func(params: get-mapping-values-key-params) -> result<get-mapping-values-key-response, get-mapping-values-key-error>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export mapping;
}
