    inline-message-id: option<string>,
    /// Required if *inline\_message\_id* is not specified. Identifier of the message to edit
    message-id: option<s32>,
    reply-markup: option<inline-keyboard-markup>
  }
  post-edit-message-reply-markup: func(params: post-edit-message-reply-markup-params) -> result<post-edit-message-reply-markup-response, string>;

}

interface edit-message-text {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  record post-edit-message-text-response {
    ok: bool,
    result-op: string
  }

  record post-edit-message-text-params {
    /// Required if *inline\_message\_id* is not specified. Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: option<string>,
    /// Disables link previews for links in this message
    disable-web-page-preview: option<bool>,
    /// List of special entities that appear in message text, which can be specified instead of *parse\_mode*
    entities: option<list<message-entity>>,
    /// Required if *chat\_id* and *message\_id* are not specified. Identifier of the inline message
    inline-message-id: option<string>,
    /// Required if *inline\_message\_id* is not specified. Identifier of the message to edit
    message-id: option<s32>,
    /// Mode for parsing entities in the message text. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    parse-mode: option<string>,
    reply-markup: option<inline-keyboard-markup>,
    /// New text of the message, 1-4096 characters after entities parsing
    text: string
  }
  post-edit-message-text: func(params: post-edit-message-text-params) -> result<post-edit-message-text-response, string>;

}

interface export-chat-invite-link {
  record post-export-chat-invite-link-response {
    ok: bool,
    result-op: string
  }

  record post-export-chat-invite-link-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string
  }
  post-export-chat-invite-link: func(params: post-export-chat-invite-link-params) -> result<post-export-chat-invite-link-response, string>;

}

interface forward-message {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-forward-message-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-forward-message-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Unique identifier for the chat where the original message was sent (or channel username in the format `@channelusername`)
    from-chat-id: string,
    /// Message identifier in the chat specified in *from\_chat\_id*
    message-id: s32
  }
  post-forward-message: func(params: post-forward-message-params) -> result<post-forward-message-response, string>;

}

interface get-chat {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  record post-get-chat-response {
    ok: bool,
    result-op: chat
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<message>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: string,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<string>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<string>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-get-chat-params {
    /// Unique identifier for the target chat or username of the target supergroup or channel (in the format `@channelusername`)
    chat-id: string
  }
  post-get-chat: func(params: post-get-chat-params) -> result<post-get-chat-response, string>;

}

interface get-chat-administrators {
  enum chat-member-status-enum {
    creator,
    administrator,
    member,
    restricted,
    left,
    kicked,
  }

  record post-get-chat-administrators-response {
    ok: bool,
    result-op: list<chat-member>
  }

  /// This object contains information about one member of a chat.
  record chat-member {
    /// *Optional*. Restricted only. True, if the user is allowed to add web page previews to their messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. Administrators only. True, if the bot is allowed to edit administrator privileges of that user
    can-be-edited: option<bool>,
    /// *Optional*. Administrators and restricted only. True, if the user is allowed to change the chat title, photo and other settings
    can-change-info: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can delete messages of other users
    can-delete-messages: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can edit messages of other users and can pin messages; channels only
    can-edit-messages: option<bool>,
    /// *Optional*. Administrators and restricted only. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. Administrators and restricted only. True, if the user is allowed to pin messages; groups and supergroups only
    can-pin-messages: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can post in the channel; channels only
    can-post-messages: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can add new administrators with a subset of their own privileges or demote administrators that he has promoted, directly or indirectly (promoted by administrators that were appointed by the user)
    can-promote-members: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can restrict, ban or unban chat members
    can-restrict-members: option<bool>,
    /// *Optional*. Restricted only. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes
    can-send-media-messages: option<bool>,
    /// *Optional*. Restricted only. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. Restricted only. True, if the user is allowed to send animations, games, stickers and use inline bots
    can-send-other-messages: option<bool>,
    /// *Optional*. Restricted only. True, if the user is allowed to send polls
    can-send-polls: option<bool>,
    /// *Optional*. Owner and administrators only. Custom title for this user
    custom-title: option<string>,
    /// *Optional*. Owner and administrators only. True, if the user's presence in the chat is hidden
    is-anonymous: option<bool>,
    /// *Optional*. Restricted only. True, if the user is a member of the chat at the moment of the request
    is-member: option<bool>,
    /// The member's status in the chat. Can be “creator”, “administrator”, “member”, “restricted”, “left” or “kicked”
    status: chat-member-status-enum,
    /// *Optional*. Restricted and kicked only. Date when restrictions will be lifted for this user; unix time
    until-date: option<s32>,
    user: user
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-get-chat-administrators-params {
    /// Unique identifier for the target chat or username of the target supergroup or channel (in the format `@channelusername`)
    chat-id: string
  }
  post-get-chat-administrators: func(params: post-get-chat-administrators-params) -> result<post-get-chat-administrators-response, string>;

}

interface get-chat-member {
  enum chat-member-status-enum {
    creator,
    administrator,
    member,
    restricted,
    left,
    kicked,
  }

  record post-get-chat-member-response {
    ok: bool,
    result-op: chat-member
  }

  /// This object contains information about one member of a chat.
  record chat-member {
    /// *Optional*. Restricted only. True, if the user is allowed to add web page previews to their messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. Administrators only. True, if the bot is allowed to edit administrator privileges of that user
    can-be-edited: option<bool>,
    /// *Optional*. Administrators and restricted only. True, if the user is allowed to change the chat title, photo and other settings
    can-change-info: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can delete messages of other users
    can-delete-messages: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can edit messages of other users and can pin messages; channels only
    can-edit-messages: option<bool>,
    /// *Optional*. Administrators and restricted only. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. Administrators and restricted only. True, if the user is allowed to pin messages; groups and supergroups only
    can-pin-messages: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can post in the channel; channels only
    can-post-messages: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can add new administrators with a subset of their own privileges or demote administrators that he has promoted, directly or indirectly (promoted by administrators that were appointed by the user)
    can-promote-members: option<bool>,
    /// *Optional*. Administrators only. True, if the administrator can restrict, ban or unban chat members
    can-restrict-members: option<bool>,
    /// *Optional*. Restricted only. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes
    can-send-media-messages: option<bool>,
    /// *Optional*. Restricted only. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. Restricted only. True, if the user is allowed to send animations, games, stickers and use inline bots
    can-send-other-messages: option<bool>,
    /// *Optional*. Restricted only. True, if the user is allowed to send polls
    can-send-polls: option<bool>,
    /// *Optional*. Owner and administrators only. Custom title for this user
    custom-title: option<string>,
    /// *Optional*. Owner and administrators only. True, if the user's presence in the chat is hidden
    is-anonymous: option<bool>,
    /// *Optional*. Restricted only. True, if the user is a member of the chat at the moment of the request
    is-member: option<bool>,
    /// The member's status in the chat. Can be “creator”, “administrator”, “member”, “restricted”, “left” or “kicked”
    status: chat-member-status-enum,
    /// *Optional*. Restricted and kicked only. Date when restrictions will be lifted for this user; unix time
    until-date: option<s32>,
    user: user
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-get-chat-member-params {
    /// Unique identifier for the target chat or username of the target supergroup or channel (in the format `@channelusername`)
    chat-id: string,
    /// Unique identifier of the target user
    user-id: s32
  }
  post-get-chat-member: func(params: post-get-chat-member-params) -> result<post-get-chat-member-response, string>;

}

interface get-chat-members-count {
  record post-get-chat-members-count-response {
    ok: bool,
    result-op: s32
  }

  record post-get-chat-members-count-params {
    /// Unique identifier for the target chat or username of the target supergroup or channel (in the format `@channelusername`)
    chat-id: string
  }
  post-get-chat-members-count: func(params: post-get-chat-members-count-params) -> result<post-get-chat-members-count-response, string>;

}

interface get-file {
  record post-get-file-response {
    ok: bool,
    result-op: file
  }

  /// This object represents a file ready to be downloaded. The file can be downloaded via the link `https://api.telegram.org/file/bot<token>/<file_path>`. It is guaranteed that the link will be valid for at least 1 hour. When the link expires, a new one can be requested by calling [getFile](https://core.telegram.org/bots/api/#getfile).
  /// 
  /// Maximum file size to download is 20 MB
  record file {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File path. Use `https://api.telegram.org/file/bot<token>/<file_path>` to get the file.
    file-path: option<string>,
    /// *Optional*. File size, if known
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  record post-get-file-params {
    /// File identifier to get info about
    file-id: string
  }
  post-get-file: func(params: post-get-file-params) -> result<post-get-file-response, string>;

}

interface get-game-high-scores {
  record post-get-game-high-scores-response {
    ok: bool,
    result-op: list<game-high-score>
  }

  /// This object represents one row of the high scores table for a game.
  record game-high-score {
    /// Position in high score table for the game
    position: s32,
    /// Score
    score: s32,
    user: user
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-get-game-high-scores-params {
    /// Required if *inline\_message\_id* is not specified. Unique identifier for the target chat
    chat-id: option<s32>,
    /// Required if *chat\_id* and *message\_id* are not specified. Identifier of the inline message
    inline-message-id: option<string>,
    /// Required if *inline\_message\_id* is not specified. Identifier of the sent message
    message-id: option<s32>,
    /// Target user id
    user-id: s32
  }
  post-get-game-high-scores: func(params: post-get-game-high-scores-params) -> result<post-get-game-high-scores-response, string>;

}

interface get-me {
  record post-get-me-response {
    ok: bool,
    result-op: user
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  post-get-me: func() -> result<post-get-me-response, string>;

}

interface get-my-commands {
  record post-get-my-commands-response {
    ok: bool,
    result-op: list<bot-command>
  }

  /// This object represents a bot command.
  record bot-command {
    /// Text of the command, 1-32 characters. Can contain only lowercase English letters, digits and underscores.
    command: string,
    /// Description of the command, 3-256 characters.
    description: string
  }

  post-get-my-commands: func() -> result<post-get-my-commands-response, string>;

}

interface get-sticker-set {
  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-get-sticker-set-response {
    ok: bool,
    result-op: sticker-set
  }

  /// This object represents a sticker set.
  record sticker-set {
    /// *True*, if the sticker set contains masks
    contains-masks: bool,
    /// *True*, if the sticker set contains [animated stickers](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    /// Sticker set name
    name: string,
    /// List of all set stickers
    stickers: list<sticker>,
    thumb: option<photo-size>,
    /// Sticker set title
    title: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  record post-get-sticker-set-params {
    /// Name of the sticker set
    name: string
  }
  post-get-sticker-set: func(params: post-get-sticker-set-params) -> result<post-get-sticker-set-response, string>;

}

interface get-updates {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-get-updates-response {
    ok: bool,
    result-op: list<update>
  }

  /// This [object](https://core.telegram.org/bots/api/#available-types) represents an incoming update.  
  /// At most **one** of the optional parameters can be present in any given update.
  record update {
    callback-query: option<callback-query>,
    channel-post: option<message>,
    chosen-inline-result: option<chosen-inline-result>,
    edited-channel-post: option<message>,
    edited-message: option<message>,
    inline-query: option<inline-query>,
    message: option<message>,
    poll: option<poll>,
    poll-answer: option<poll-answer>,
    pre-checkout-query: option<pre-checkout-query>,
    shipping-query: option<shipping-query>,
    /// The update's unique identifier. Update identifiers start from a certain positive number and increase sequentially. This ID becomes especially handy if you're using [Webhooks](https://core.telegram.org/bots/api/#setwebhook), since it allows you to ignore repeated updates or to restore the correct update sequence, should they get out of order. If there are no new updates for at least a week, then identifier of the next update will be chosen randomly instead of sequentially.
    update-id: s32
  }

  /// This object represents an incoming callback query from a callback button in an [inline keyboard](/bots#inline-keyboards-and-on-the-fly-updating). If the button that originated the query was attached to a message sent by the bot, the field *message* will be present. If the button was attached to a message sent via the bot (in [inline mode](https://core.telegram.org/bots/api/#inline-mode)), the field *inline\_message\_id* will be present. Exactly one of the fields *data* or *game\_short\_name* will be present.
  record callback-query {
    /// Global identifier, uniquely corresponding to the chat to which the message with the callback button was sent. Useful for high scores in [games](https://core.telegram.org/bots/api/#games).
    chat-instance: string,
    /// *Optional*. Data associated with the callback button. Be aware that a bad client can send arbitrary data in this field.
    data: option<string>,
    from-op: user,
    /// *Optional*. Short name of a [Game](https://core.telegram.org/bots/api/#games) to be returned, serves as the unique identifier for the game
    game-short-name: option<string>,
    /// Unique identifier for this query
    id: string,
    /// *Optional*. Identifier of the message sent via the bot in inline mode, that originated the query.
    inline-message-id: option<string>,
    message: option<message>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  /// Represents a [result](https://core.telegram.org/bots/api/#inlinequeryresult) of an inline query that was chosen by the user and sent to their chat partner.
  record chosen-inline-result {
    from-op: user,
    /// *Optional*. Identifier of the sent inline message. Available only if there is an [inline keyboard](https://core.telegram.org/bots/api/#inlinekeyboardmarkup) attached to the message. Will be also received in [callback queries](https://core.telegram.org/bots/api/#callbackquery) and can be used to [edit](https://core.telegram.org/bots/api/#updating-messages) the message.
    inline-message-id: option<string>,
    location: option<location>,
    /// The query that was used to obtain the result
    query: string,
    /// The unique identifier for the result that was chosen
    result-id: string
  }

  /// This object represents an incoming inline query. When the user sends an empty query, your bot could return some default or trending results.
  record inline-query {
    from-op: user,
    /// Unique identifier for this query
    id: string,
    location: option<location>,
    /// Offset of the results to be returned, can be controlled by the bot
    offset: string,
    /// Text of the query (up to 256 characters)
    query: string
  }

  /// This object represents an answer of a user in a non-anonymous poll.
  record poll-answer {
    /// 0-based identifiers of answer options, chosen by the user. May be empty if the user retracted their vote.
    option-ids: list<s32>,
    /// Unique poll identifier
    poll-id: string,
    user: user
  }

  /// This object contains information about an incoming pre-checkout query.
  record pre-checkout-query {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    from-op: user,
    /// Unique query identifier
    id: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object contains information about an incoming shipping query.
  record shipping-query {
    from-op: user,
    /// Unique query identifier
    id: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    shipping-address: shipping-address
  }

  record post-get-updates-params {
    /// A JSON-serialized list of the update types you want your bot to receive. For example, specify [“message”, “edited\_channel\_post”, “callback\_query”] to only receive updates of these types. See [Update](https://core.telegram.org/bots/api/#update) for a complete list of available update types. Specify an empty list to receive all updates regardless of type (default). If not specified, the previous setting will be used.  
    /// 
    allowed-updates: option<list<string>>,
    /// Limits the number of updates to be retrieved. Values between 1-100 are accepted. Defaults to 100.
    limit: option<s32>,
    /// Identifier of the first update to be returned. Must be greater by one than the highest among the identifiers of previously received updates. By default, updates starting with the earliest unconfirmed update are returned. An update is considered confirmed as soon as [getUpdates](https://core.telegram.org/bots/api/#getupdates) is called with an *offset* higher than its *update\_id*. The negative offset can be specified to retrieve updates starting from *-offset* update from the end of the updates queue. All previous updates will forgotten.
    offset: option<s32>,
    /// Timeout in seconds for long polling. Defaults to 0, i.e. usual short polling. Should be positive, short polling should be used for testing purposes only.
    timeout: option<s32>
  }
  post-get-updates: func(params: post-get-updates-params) -> result<post-get-updates-response, string>;

}

interface get-user-profile-photos {
  record post-get-user-profile-photos-response {
    ok: bool,
    result-op: user-profile-photos
  }

  /// This object represent a user's profile pictures.
  record user-profile-photos {
    /// Requested profile pictures (in up to 4 sizes each)
    photos: list<list<photo-size>>,
    /// Total number of profile pictures the target user has
    total-count: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  record post-get-user-profile-photos-params {
    /// Limits the number of photos to be retrieved. Values between 1-100 are accepted. Defaults to 100.
    limit: option<s32>,
    /// Sequential number of the first photo to be returned. By default, all photos are returned.
    offset: option<s32>,
    /// Unique identifier of the target user
    user-id: s32
  }
  post-get-user-profile-photos: func(params: post-get-user-profile-photos-params) -> result<post-get-user-profile-photos-response, string>;

}

interface get-webhook-info {
  record post-get-webhook-info-response {
    ok: bool,
    result-op: webhook-info
  }

  /// Contains information about the current status of a webhook.
  record webhook-info {
    /// *Optional*. A list of update types the bot is subscribed to. Defaults to all update types
    allowed-updates: option<list<string>>,
    /// True, if a custom certificate was provided for webhook certificate checks
    has-custom-certificate: bool,
    /// *Optional*. Currently used webhook IP address
    ip-address: option<string>,
    /// *Optional*. Unix time for the most recent error that happened when trying to deliver an update via webhook
    last-error-date: option<s32>,
    /// *Optional*. Error message in human-readable format for the most recent error that happened when trying to deliver an update via webhook
    last-error-message: option<string>,
    /// *Optional*. Maximum allowed number of simultaneous HTTPS connections to the webhook for update delivery
    max-connections: option<s32>,
    /// Number of updates awaiting delivery
    pending-update-count: s32,
    /// Webhook URL, may be empty if webhook is not set up
    url: string
  }

  post-get-webhook-info: func() -> result<post-get-webhook-info-response, string>;

}

interface kick-chat-member {
  record post-kick-chat-member-response {
    ok: bool,
    result-op: bool
  }

  record post-kick-chat-member-params {
    /// Unique identifier for the target group or username of the target supergroup or channel (in the format `@channelusername`)
    chat-id: string,
    /// Date when the user will be unbanned, unix time. If user is banned for more than 366 days or less than 30 seconds from the current time they are considered to be banned forever
    until-date: option<s32>,
    /// Unique identifier of the target user
    user-id: s32
  }
  post-kick-chat-member: func(params: post-kick-chat-member-params) -> result<post-kick-chat-member-response, string>;

}

interface leave-chat {
  record post-leave-chat-response {
    ok: bool,
    result-op: bool
  }

  record post-leave-chat-params {
    /// Unique identifier for the target chat or username of the target supergroup or channel (in the format `@channelusername`)
    chat-id: string
  }
  post-leave-chat: func(params: post-leave-chat-params) -> result<post-leave-chat-response, string>;

}

interface log-out {
  record post-log-out-response {
    ok: bool,
    result-op: bool
  }

  post-log-out: func() -> result<post-log-out-response, string>;

}

interface pin-chat-message {
  record post-pin-chat-message-response {
    ok: bool,
    result-op: bool
  }

  record post-pin-chat-message-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Pass *True*, if it is not necessary to send a notification to all chat members about the new pinned message. Notifications are always disabled in channels and private chats.
    disable-notification: option<bool>,
    /// Identifier of a message to pin
    message-id: s32
  }
  post-pin-chat-message: func(params: post-pin-chat-message-params) -> result<post-pin-chat-message-response, string>;

}

interface promote-chat-member {
  record post-promote-chat-member-response {
    ok: bool,
    result-op: bool
  }

  record post-promote-chat-member-params {
    /// Pass True, if the administrator can change chat title, photo and other settings
    can-change-info: option<bool>,
    /// Pass True, if the administrator can delete messages of other users
    can-delete-messages: option<bool>,
    /// Pass True, if the administrator can edit messages of other users and can pin messages, channels only
    can-edit-messages: option<bool>,
    /// Pass True, if the administrator can invite new users to the chat
    can-invite-users: option<bool>,
    /// Pass True, if the administrator can pin messages, supergroups only
    can-pin-messages: option<bool>,
    /// Pass True, if the administrator can create channel posts, channels only
    can-post-messages: option<bool>,
    /// Pass True, if the administrator can add new administrators with a subset of their own privileges or demote administrators that he has promoted, directly or indirectly (promoted by administrators that were appointed by him)
    can-promote-members: option<bool>,
    /// Pass True, if the administrator can restrict, ban or unban chat members
    can-restrict-members: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Pass *True*, if the administrator's presence in the chat is hidden
    is-anonymous: option<bool>,
    /// Unique identifier of the target user
    user-id: s32
  }
  post-promote-chat-member: func(params: post-promote-chat-member-params) -> result<post-promote-chat-member-response, string>;

}

interface restrict-chat-member {
  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  record post-restrict-chat-member-response {
    ok: bool,
    result-op: bool
  }

  record post-restrict-chat-member-params {
    /// Unique identifier for the target chat or username of the target supergroup (in the format `@supergroupusername`)
    chat-id: string,
    permissions: chat-permissions,
    /// Date when restrictions will be lifted for the user, unix time. If user is restricted for more than 366 days or less than 30 seconds from the current time, they are considered to be restricted forever
    until-date: option<s32>,
    /// Unique identifier of the target user
    user-id: s32
  }
  post-restrict-chat-member: func(params: post-restrict-chat-member-params) -> result<post-restrict-chat-member-response, string>;

}

interface send-animation {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-send-animation-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-animation-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Animation to send. Pass a file\_id as String to send an animation that exists on the Telegram servers (recommended), pass an HTTP URL as a String for Telegram to get an animation from the Internet, or upload a new animation using multipart/form-data. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    animation: string,
    /// Animation caption (may also be used when resending animation by *file\_id*), 0-1024 characters after entities parsing
    caption: option<string>,
    /// List of special entities that appear in the caption, which can be specified instead of *parse\_mode*
    caption-entities: option<list<message-entity>>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Duration of sent animation in seconds
    duration: option<s32>,
    /// Animation height
    height: option<s32>,
    /// Mode for parsing entities in the animation caption. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    parse-mode: option<string>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is supported server-side. The thumbnail should be in JPEG format and less than 200 kB in size. A thumbnail's width and height should not exceed 320. Ignored if the file is not uploaded using multipart/form-data. Thumbnails can't be reused and can be only uploaded as a new file, so you can pass “attach://<file\_attach\_name>” if the thumbnail was uploaded using multipart/form-data under <file\_attach\_name>. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    thumb: option<string>,
    /// Animation width
    width: option<s32>
  }
  post-send-animation: func(params: post-send-animation-params) -> result<post-send-animation-response, string>;

}

interface send-audio {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-send-audio-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-audio-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Audio file to send. Pass a file\_id as String to send an audio file that exists on the Telegram servers (recommended), pass an HTTP URL as a String for Telegram to get an audio file from the Internet, or upload a new one using multipart/form-data. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    audio: string,
    /// Audio caption, 0-1024 characters after entities parsing
    caption: option<string>,
    /// List of special entities that appear in the caption, which can be specified instead of *parse\_mode*
    caption-entities: option<list<message-entity>>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Duration of the audio in seconds
    duration: option<s32>,
    /// Mode for parsing entities in the audio caption. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    parse-mode: option<string>,
    /// Performer
    performer: option<string>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is supported server-side. The thumbnail should be in JPEG format and less than 200 kB in size. A thumbnail's width and height should not exceed 320. Ignored if the file is not uploaded using multipart/form-data. Thumbnails can't be reused and can be only uploaded as a new file, so you can pass “attach://<file\_attach\_name>” if the thumbnail was uploaded using multipart/form-data under <file\_attach\_name>. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    thumb: option<string>,
    /// Track name
    title: option<string>
  }
  post-send-audio: func(params: post-send-audio-params) -> result<post-send-audio-response, string>;

}

interface send-chat-action {
  record post-send-chat-action-response {
    ok: bool,
    result-op: bool
  }

  record post-send-chat-action-params {
    /// Type of action to broadcast. Choose one, depending on what the user is about to receive: *typing* for [text messages](https://core.telegram.org/bots/api/#sendmessage), *upload\_photo* for [photos](https://core.telegram.org/bots/api/#sendphoto), *record\_video* or *upload\_video* for [videos](https://core.telegram.org/bots/api/#sendvideo), *record\_voice* or *upload\_voice* for [voice notes](https://core.telegram.org/bots/api/#sendvoice), *upload\_document* for [general files](https://core.telegram.org/bots/api/#senddocument), *find\_location* for [location data](https://core.telegram.org/bots/api/#sendlocation), *record\_video\_note* or *upload\_video\_note* for [video notes](https://core.telegram.org/bots/api/#sendvideonote).
    action: string,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string
  }
  post-send-chat-action: func(params: post-send-chat-action-params) -> result<post-send-chat-action-response, string>;

}

interface send-contact {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-send-contact-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-contact-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Contact's first name
    first-name: string,
    /// Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard), 0-2048 bytes
    vcard: option<string>
  }
  post-send-contact: func(params: post-send-contact-params) -> result<post-send-contact-response, string>;

}

interface send-dice {
  enum post-send-dice-body-emoji-enum {
    x,
    x-v2,
    x-v3,
    x-v4,
    x-v5,
  }

  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-send-dice-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-dice-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Emoji on which the dice throw animation is based. Currently, must be one of “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />”, “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />”, “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />”, “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />”, or “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />”. Dice can have values 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />”, values 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />”, and values 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />”. Defaults to “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />”
    emoji: option<post-send-dice-body-emoji-enum>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>
  }
  post-send-dice: func(params: post-send-dice-params) -> result<post-send-dice-response, string>;

}

interface send-document {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-send-document-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-document-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Document caption (may also be used when resending documents by *file\_id*), 0-1024 characters after entities parsing
    caption: option<string>,
    /// List of special entities that appear in the caption, which can be specified instead of *parse\_mode*
    caption-entities: option<list<message-entity>>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Disables automatic server-side content type detection for files uploaded using multipart/form-data
    disable-content-type-detection: option<bool>,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// File to send. Pass a file\_id as String to send a file that exists on the Telegram servers (recommended), pass an HTTP URL as a String for Telegram to get a file from the Internet, or upload a new one using multipart/form-data. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    document: string,
    /// Mode for parsing entities in the document caption. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    parse-mode: option<string>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is supported server-side. The thumbnail should be in JPEG format and less than 200 kB in size. A thumbnail's width and height should not exceed 320. Ignored if the file is not uploaded using multipart/form-data. Thumbnails can't be reused and can be only uploaded as a new file, so you can pass “attach://<file\_attach\_name>” if the thumbnail was uploaded using multipart/form-data under <file\_attach\_name>. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    thumb: option<string>
  }
  post-send-document: func(params: post-send-document-params) -> result<post-send-document-response, string>;

}

interface send-game {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  record post-send-game-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-game-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat
    chat-id: s32,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Short name of the game, serves as the unique identifier for the game. Set up your games via [Botfather](https://t.me/botfather).
    game-short-name: string,
    reply-markup: option<inline-keyboard-markup>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>
  }
  post-send-game: func(params: post-send-game-params) -> result<post-send-game-response, string>;

}

interface send-invoice {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents a portion of the price for goods or services.
  record labeled-price {
    /// Price of the product in the *smallest units* of the [currency](/bots/payments#supported-currencies) (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    amount: s32,
    /// Portion label
    label: string
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  record post-send-invoice-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-invoice-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target private chat
    chat-id: s32,
    /// Three-letter ISO 4217 currency code, see [more on currencies](/bots/payments#supported-currencies)
    currency: string,
    /// Product description, 1-255 characters
    description: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Pass *True*, if the final price depends on the shipping method
    is-flexible: option<bool>,
    /// Pass *True*, if you require the user's email address to complete the order
    need-email: option<bool>,
    /// Pass *True*, if you require the user's full name to complete the order
    need-name: option<bool>,
    /// Pass *True*, if you require the user's phone number to complete the order
    need-phone-number: option<bool>,
    /// Pass *True*, if you require the user's shipping address to complete the order
    need-shipping-address: option<bool>,
    /// Bot-defined invoice payload, 1-128 bytes. This will not be displayed to the user, use for your internal processes.
    payload: string,
    /// Photo height
    photo-height: option<s32>,
    /// Photo size
    photo-size: option<s32>,
    /// URL of the product photo for the invoice. Can be a photo of the goods or a marketing image for a service. People like it better when they see what they are paying for.
    photo-url: option<string>,
    /// Photo width
    photo-width: option<s32>,
    /// Price breakdown, a JSON-serialized list of components (e.g. product price, tax, discount, delivery cost, delivery tax, bonus, etc.)
    prices: list<labeled-price>,
    /// A JSON-serialized data about the invoice, which will be shared with the payment provider. A detailed description of required fields should be provided by the payment provider.
    provider-data: option<string>,
    /// Payments provider token, obtained via [Botfather](https://t.me/botfather)
    provider-token: string,
    reply-markup: option<inline-keyboard-markup>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Pass *True*, if user's email address should be sent to provider
    send-email-to-provider: option<bool>,
    /// Pass *True*, if user's phone number should be sent to provider
    send-phone-number-to-provider: option<bool>,
    /// Unique deep-linking parameter that can be used to generate this invoice when used as a start parameter
    start-parameter: string,
    /// Product name, 1-32 characters
    title: string
  }
  post-send-invoice: func(params: post-send-invoice-params) -> result<post-send-invoice-response, string>;

}

interface send-location {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-send-location-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-location-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// For live locations, a direction in which the user is moving, in degrees. Must be between 1 and 360 if specified.
    heading: option<s32>,
    /// The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude of the location
    latitude: f64,
    /// Period in seconds for which the location will be updated (see [Live Locations](https://telegram.org/blog/live-locations), should be between 60 and 86400.
    live-period: option<s32>,
    /// Longitude of the location
    longitude: f64,
    /// For live locations, a maximum distance for proximity alerts about approaching another chat member, in meters. Must be between 1 and 100000 if specified.
    proximity-alert-radius: option<s32>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>
  }
  post-send-location: func(params: post-send-location-params) -> result<post-send-location-response, string>;

}

interface send-media-group {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-send-media-group-response {
    ok: bool,
    result-op: list<message>
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-media-group-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends messages [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// A JSON-serialized array describing messages to be sent, must include 2-10 items
    media: list<string>,
    /// If the messages are a reply, ID of the original message
    reply-to-message-id: option<s32>
  }
  post-send-media-group: func(params: post-send-media-group-params) -> result<post-send-media-group-response, string>;

}

interface send-message {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-send-message-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-message-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Disables link previews for links in this message
    disable-web-page-preview: option<bool>,
    /// List of special entities that appear in message text, which can be specified instead of *parse\_mode*
    entities: option<list<message-entity>>,
    /// Mode for parsing entities in the message text. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    parse-mode: option<string>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Text of the message to be sent, 1-4096 characters after entities parsing
    text: string
  }
  post-send-message: func(params: post-send-message-params) -> result<post-send-message-response, string>;

}

interface send-photo {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-send-photo-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-photo-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Photo caption (may also be used when resending photos by *file\_id*), 0-1024 characters after entities parsing
    caption: option<string>,
    /// List of special entities that appear in the caption, which can be specified instead of *parse\_mode*
    caption-entities: option<list<message-entity>>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Mode for parsing entities in the photo caption. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    parse-mode: option<string>,
    /// Photo to send. Pass a file\_id as String to send a photo that exists on the Telegram servers (recommended), pass an HTTP URL as a String for Telegram to get a photo from the Internet, or upload a new photo using multipart/form-data. The photo must be at most 10 MB in size. The photo's width and height must not exceed 10000 in total. Width and height ratio must be at most 20. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    photo: string,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>
  }
  post-send-photo: func(params: post-send-photo-params) -> result<post-send-photo-response, string>;

}

interface send-poll {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-send-poll-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-poll-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// True, if the poll allows multiple answers, ignored for polls in quiz mode, defaults to *False*
    allows-multiple-answers: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Point in time (Unix timestamp) when the poll will be automatically closed. Must be at least 5 and no more than 600 seconds in the future. Can't be used together with *open\_period*.
    close-date: option<s32>,
    /// 0-based identifier of the correct answer option, required for polls in quiz mode
    correct-option-id: option<s32>,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters with at most 2 line feeds after entities parsing
    explanation: option<string>,
    /// List of special entities that appear in the poll explanation, which can be specified instead of *parse\_mode*
    explanation-entities: option<list<message-entity>>,
    /// Mode for parsing entities in the explanation. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    explanation-parse-mode: option<string>,
    /// True, if the poll needs to be anonymous, defaults to *True*
    is-anonymous: option<bool>,
    /// Pass *True*, if the poll needs to be immediately closed. This can be useful for poll preview.
    is-closed: option<bool>,
    /// Amount of time in seconds the poll will be active after creation, 5-600. Can't be used together with *close\_date*.
    open-period: option<s32>,
    /// A JSON-serialized list of answer options, 2-10 strings 1-100 characters each
    options: list<string>,
    /// Poll question, 1-300 characters
    question: string,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Poll type, “quiz” or “regular”, defaults to “regular”
    type-op: option<string>
  }
  post-send-poll: func(params: post-send-poll-params) -> result<post-send-poll-response, string>;

}

interface send-sticker {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-send-sticker-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-sticker-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Sticker to send. Pass a file\_id as String to send a file that exists on the Telegram servers (recommended), pass an HTTP URL as a String for Telegram to get a .WEBP file from the Internet, or upload a new one using multipart/form-data. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    sticker: string
  }
  post-send-sticker: func(params: post-send-sticker-params) -> result<post-send-sticker-response, string>;

}

interface send-venue {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-send-venue-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-venue-params {
    /// Address of the venue
    address: string,
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// Foursquare type of the venue, if known. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// Google Places identifier of the venue
    google-place-id: option<string>,
    /// Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    /// Latitude of the venue
    latitude: f64,
    /// Longitude of the venue
    longitude: f64,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Name of the venue
    title: string
  }
  post-send-venue: func(params: post-send-venue-params) -> result<post-send-venue-response, string>;

}

interface send-video {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-send-video-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-video-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Video caption (may also be used when resending videos by *file\_id*), 0-1024 characters after entities parsing
    caption: option<string>,
    /// List of special entities that appear in the caption, which can be specified instead of *parse\_mode*
    caption-entities: option<list<message-entity>>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Duration of sent video in seconds
    duration: option<s32>,
    /// Video height
    height: option<s32>,
    /// Mode for parsing entities in the video caption. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    parse-mode: option<string>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Pass *True*, if the uploaded video is suitable for streaming
    supports-streaming: option<bool>,
    /// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is supported server-side. The thumbnail should be in JPEG format and less than 200 kB in size. A thumbnail's width and height should not exceed 320. Ignored if the file is not uploaded using multipart/form-data. Thumbnails can't be reused and can be only uploaded as a new file, so you can pass “attach://<file\_attach\_name>” if the thumbnail was uploaded using multipart/form-data under <file\_attach\_name>. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    thumb: option<string>,
    /// Video to send. Pass a file\_id as String to send a video that exists on the Telegram servers (recommended), pass an HTTP URL as a String for Telegram to get a video from the Internet, or upload a new video using multipart/form-data. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    video: string,
    /// Video width
    width: option<s32>
  }
  post-send-video: func(params: post-send-video-params) -> result<post-send-video-response, string>;

}

interface send-video-note {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  record post-send-video-note-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-video-note-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Duration of sent video in seconds
    duration: option<s32>,
    /// Video width and height, i.e. diameter of the video message
    length: option<s32>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is supported server-side. The thumbnail should be in JPEG format and less than 200 kB in size. A thumbnail's width and height should not exceed 320. Ignored if the file is not uploaded using multipart/form-data. Thumbnails can't be reused and can be only uploaded as a new file, so you can pass “attach://<file\_attach\_name>” if the thumbnail was uploaded using multipart/form-data under <file\_attach\_name>. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    thumb: option<string>,
    /// Video note to send. Pass a file\_id as String to send a video note that exists on the Telegram servers (recommended) or upload a new video using multipart/form-data. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files). Sending video notes by a URL is currently unsupported
    video-note: string
  }
  post-send-video-note: func(params: post-send-video-note-params) -> result<post-send-video-note-response, string>;

}

interface send-voice {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  enum chat-type-op-enum {
    private,
    group,
    supergroup,
    channel,
  }

  enum encrypted-passport-element-type-op-enum {
    personal-details,
    passport,
    driver-license,
    identity-card,
    internal-passport,
    address,
    utility-bill,
    bank-statement,
    rental-agreement,
    passport-registration,
    temporary-registration,
    phone-number,
    email,
  }

  enum mask-position-point-enum {
    forehead,
    eyes,
    mouth,
    chin,
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  record post-send-voice-response {
    ok: bool,
    result-op: message
  }

  /// This object represents a message.
  record message {
    animation: option<animation>,
    audio: option<audio>,
    /// *Optional*. Signature of the post author for messages in channels, or the custom title of an anonymous group administrator
    author-signature: option<string>,
    /// *Optional*. Caption for the animation, audio, document, photo, video or voice, 0-1024 characters
    caption: option<string>,
    /// *Optional*. For messages with a caption, special entities like usernames, URLs, bot commands, etc. that appear in the caption
    caption-entities: option<list<message-entity>>,
    /// *Optional*. Service message: the channel has been created. This field can't be received in a message coming through updates, because bot can't be a member of a channel when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a channel.
    channel-chat-created: option<bool>,
    chat: chat,
    /// *Optional*. The domain name of the website on which the user has logged in. [More about Telegram Login »](/widgets/login)
    connected-website: option<string>,
    contact: option<contact>,
    /// Date the message was sent in Unix time
    date: s32,
    /// *Optional*. Service message: the chat photo was deleted
    delete-chat-photo: option<bool>,
    dice: option<dice>,
    document: option<document>,
    /// *Optional*. Date the message was last edited in Unix time
    edit-date: option<s32>,
    /// *Optional*. For text messages, special entities like usernames, URLs, bot commands, etc. that appear in the text
    entities: option<list<message-entity>>,
    /// *Optional*. For forwarded messages, date the original message was sent in Unix time
    forward-date: option<s32>,
    forward-from: option<user>,
    forward-from-chat: option<chat>,
    /// *Optional*. For messages forwarded from channels, identifier of the original message in the channel
    forward-from-message-id: option<s32>,
    /// *Optional*. Sender's name for messages forwarded from users who disallow adding a link to their account in forwarded messages
    forward-sender-name: option<string>,
    /// *Optional*. For messages forwarded from channels, signature of the post author if present
    forward-signature: option<string>,
    from-op: option<user>,
    game: option<game>,
    /// *Optional*. Service message: the group has been created
    group-chat-created: option<bool>,
    invoice: option<invoice>,
    left-chat-member: option<user>,
    location: option<location>,
    /// *Optional*. The unique identifier of a media message group this message belongs to
    media-group-id: option<string>,
    /// Unique message identifier inside this chat
    message-id: s32,
    /// *Optional*. The supergroup has been migrated from a group with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-from-chat-id: option<s32>,
    /// *Optional*. The group has been migrated to a supergroup with the specified identifier. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    migrate-to-chat-id: option<s32>,
    /// *Optional*. New members that were added to the group or supergroup and information about them (the bot itself may be one of these members)
    new-chat-members: option<list<user>>,
    /// *Optional*. A chat photo was change to this value
    new-chat-photo: option<list<photo-size>>,
    /// *Optional*. A chat title was changed to this value
    new-chat-title: option<string>,
    passport-data: option<passport-data>,
    /// *Optional*. Message is a photo, available sizes of the photo
    photo: option<list<photo-size>>,
    pinned-message: option<string>,
    poll: option<poll>,
    proximity-alert-triggered: option<proximity-alert-triggered>,
    reply-markup: option<inline-keyboard-markup>,
    reply-to-message: option<string>,
    sender-chat: option<chat>,
    sticker: option<sticker>,
    successful-payment: option<successful-payment>,
    /// *Optional*. Service message: the supergroup has been created. This field can't be received in a message coming through updates, because bot can't be a member of a supergroup when it is created. It can only be found in reply\_to\_message if someone replies to a very first message in a directly created supergroup.
    supergroup-chat-created: option<bool>,
    /// *Optional*. For text messages, the actual UTF-8 text of the message, 0-4096 characters
    text: option<string>,
    venue: option<venue>,
    via-bot: option<user>,
    video: option<video>,
    video-note: option<video-note>,
    voice: option<voice>
  }

  /// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
  record animation {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original animation filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents one size of a photo or a [file](https://core.telegram.org/bots/api/#document) / [sticker](https://core.telegram.org/bots/api/#sticker) thumbnail.
  record photo-size {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Photo height
    height: s32,
    /// Photo width
    width: s32
  }

  /// This object represents an audio file to be treated as music by the Telegram clients.
  record audio {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    /// *Optional*. Performer of the audio as defined by sender or by audio tags
    performer: option<string>,
    thumb: option<photo-size>,
    /// *Optional*. Title of the audio as defined by sender or by audio tags
    title: option<string>
  }

  /// This object represents a chat.
  record chat {
    /// *Optional*. Bio of the other party in a private chat. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    bio: option<string>,
    /// *Optional*. True, if the bot can change the group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    can-set-sticker-set: option<bool>,
    /// *Optional*. Description, for groups, supergroups and channel chats. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    description: option<string>,
    /// *Optional*. First name of the other party in a private chat
    first-name: option<string>,
    /// Unique identifier for this chat. This number may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier.
    id: s32,
    /// *Optional*. Chat invite link, for groups, supergroups and channel chats. Each administrator in a chat generates their own invite links, so the bot must first generate the link using [exportChatInviteLink](https://core.telegram.org/bots/api/#exportchatinvitelink). Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    invite-link: option<string>,
    /// *Optional*. Last name of the other party in a private chat
    last-name: option<string>,
    /// *Optional*. Unique identifier for the linked chat, i.e. the discussion group identifier for a channel and vice versa; for supergroups and channel chats. This identifier may be greater than 32 bits and some programming languages may have difficulty/silent defects in interpreting it. But it is smaller than 52 bits, so a signed 64 bit integer or double-precision float type are safe for storing this identifier. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    linked-chat-id: option<s32>,
    location: option<chat-location>,
    permissions: option<chat-permissions>,
    photo: option<chat-photo>,
    pinned-message: option<string>,
    /// *Optional*. For supergroups, the minimum allowed delay between consecutive messages sent by each unpriviledged user. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    slow-mode-delay: option<s32>,
    /// *Optional*. For supergroups, name of group sticker set. Returned only in [getChat](https://core.telegram.org/bots/api/#getchat).
    sticker-set-name: option<string>,
    /// *Optional*. Title, for supergroups, channels and group chats
    title: option<string>,
    /// Type of chat, can be either “private”, “group”, “supergroup” or “channel”
    type-op: chat-type-op-enum,
    /// *Optional*. Username, for private chats, supergroups and channels if available
    username: option<string>
  }

  /// Represents a location to which a chat is connected.
  record chat-location {
    /// Location address; 1-64 characters, as defined by the chat owner
    address: string,
    location: location
  }

  /// This object represents a point on the map.
  record location {
    /// *Optional*. The direction in which user is moving, in degrees; 1-360. For active live locations only.
    heading: option<s32>,
    /// *Optional*. The radius of uncertainty for the location, measured in meters; 0-1500
    horizontal-accuracy: option<f64>,
    /// Latitude as defined by sender
    latitude: f64,
    /// *Optional*. Time relative to the message sending date, during which the location can be updated, in seconds. For active live locations only.
    live-period: option<s32>,
    /// Longitude as defined by sender
    longitude: f64,
    /// *Optional*. Maximum distance for proximity alerts about approaching another chat member, in meters. For sent live locations only.
    proximity-alert-radius: option<s32>
  }

  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  /// This object represents a chat photo.
  record chat-photo {
    /// File identifier of big (640x640) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    big-file-id: string,
    /// Unique file identifier of big (640x640) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    big-file-unique-id: string,
    /// File identifier of small (160x160) chat photo. This file\_id can be used only for photo download and only for as long as the photo is not changed.
    small-file-id: string,
    /// Unique file identifier of small (160x160) chat photo, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    small-file-unique-id: string
  }

  /// This object represents a phone contact.
  record contact {
    /// Contact's first name
    first-name: string,
    /// *Optional*. Contact's last name
    last-name: option<string>,
    /// Contact's phone number
    phone-number: string,
    /// *Optional*. Contact's user identifier in Telegram
    user-id: option<s32>,
    /// *Optional*. Additional data about the contact in the form of a [vCard](https://en.wikipedia.org/wiki/VCard)
    vcard: option<string>
  }

  /// This object represents an animated emoji that displays a random value.
  record dice {
    /// Emoji on which the dice throw animation is based
    emoji: string,
    /// Value of the dice, 1-6 for “<img alt="🎲" src="//telegram.org/img/emoji/40/F09F8EB2.png" height="20" width="20" />” and “<img alt="🎯" src="//telegram.org/img/emoji/40/F09F8EAF.png" height="20" width="20" />” base emoji, 1-5 for “<img alt="🏀" src="//telegram.org/img/emoji/40/F09F8F80.png" height="20" width="20" />” and “<img alt="⚽" src="//telegram.org/img/emoji/40/E29ABD.png" height="20" width="20" />” base emoji, 1-64 for “<img alt="🎰" src="//telegram.org/img/emoji/40/F09F8EB0.png" height="20" width="20" />” base emoji
    value: s32
  }

  /// This object represents a general file (as opposed to [photos](https://core.telegram.org/bots/api/#photosize), [voice messages](https://core.telegram.org/bots/api/#voice) and [audio files](https://core.telegram.org/bots/api/#audio)).
  record document {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>
  }

  /// This object represents a game. Use BotFather to create and edit games, their short names will act as unique identifiers.
  record game {
    animation: option<animation>,
    /// Description of the game
    description: string,
    /// Photo that will be displayed in the game message in chats.
    photo: list<photo-size>,
    /// *Optional*. Brief description of the game or high scores included in the game message. Can be automatically edited to include current high scores for the game when the bot calls [setGameScore](https://core.telegram.org/bots/api/#setgamescore), or manually edited using [editMessageText](https://core.telegram.org/bots/api/#editmessagetext). 0-4096 characters.
    text: option<string>,
    /// *Optional*. Special entities that appear in *text*, such as usernames, URLs, bot commands, etc.
    text-entities: option<list<message-entity>>,
    /// Title of the game
    title: string
  }

  /// This object contains basic information about an invoice.
  record invoice {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Product description
    description: string,
    /// Unique bot deep-linking parameter that can be used to generate this invoice
    start-parameter: string,
    /// Product name
    title: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// Contains information about Telegram Passport data shared with the bot by the user.
  record passport-data {
    credentials: encrypted-credentials,
    /// Array with information about documents and other Telegram Passport elements that was shared with the bot
    data: list<encrypted-passport-element>
  }

  /// Contains data required for decrypting and authenticating [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement). See the [Telegram Passport Documentation](https://core.telegram.org/passport#receiving-information) for a complete description of the data decryption and authentication processes.
  record encrypted-credentials {
    /// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes and secrets required for [EncryptedPassportElement](https://core.telegram.org/bots/api/#encryptedpassportelement) decryption and authentication
    data: string,
    /// Base64-encoded data hash for data authentication
    hash: string,
    /// Base64-encoded secret, encrypted with the bot's public RSA key, required for data decryption
    secret: string
  }

  /// Contains information about documents or other Telegram Passport elements shared with the bot by the user.
  record encrypted-passport-element {
    /// *Optional*. Base64-encoded encrypted Telegram Passport element data provided by the user, available for “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport” and “address” types. Can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    data: option<string>,
    /// *Optional*. User's verified email address, available only for “email” type
    email: option<string>,
    /// *Optional*. Array of encrypted files with documents provided by the user, available for “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    files: option<list<passport-file>>,
    front-side: option<passport-file>,
    /// Base64-encoded element hash for using in [PassportElementErrorUnspecified](https://core.telegram.org/bots/api/#passportelementerrorunspecified)
    hash: string,
    /// *Optional*. User's verified phone number, available only for “phone\_number” type
    phone-number: option<string>,
    reverse-side: option<passport-file>,
    selfie: option<passport-file>,
    /// *Optional*. Array of encrypted files with translated versions of documents provided by the user. Available if requested for “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration” and “temporary\_registration” types. Files can be decrypted and verified using the accompanying [EncryptedCredentials](https://core.telegram.org/bots/api/#encryptedcredentials).
    translation: option<list<passport-file>>,
    /// Element type. One of “personal\_details”, “passport”, “driver\_license”, “identity\_card”, “internal\_passport”, “address”, “utility\_bill”, “bank\_statement”, “rental\_agreement”, “passport\_registration”, “temporary\_registration”, “phone\_number”, “email”.
    type-op: encrypted-passport-element-type-op-enum
  }

  /// This object represents a file uploaded to Telegram Passport. Currently all Telegram Passport files are in JPEG format when decrypted and don't exceed 10MB.
  record passport-file {
    /// Unix time when the file was uploaded
    file-date: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// File size
    file-size: s32,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  /// This object represents the content of a service message, sent whenever a user in the chat triggers a proximity alert set by another user.
  record proximity-alert-triggered {
    /// The distance between the users
    distance: s32,
    traveler: user,
    watcher: user
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  /// This object represents a sticker.
  record sticker {
    /// *Optional*. Emoji associated with the sticker
    emoji: option<string>,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Sticker height
    height: s32,
    /// *True*, if the sticker is [animated](https://telegram.org/blog/animated-stickers)
    is-animated: bool,
    mask-position: option<mask-position>,
    /// *Optional*. Name of the sticker set to which the sticker belongs
    set-name: option<string>,
    thumb: option<photo-size>,
    /// Sticker width
    width: s32
  }

  /// This object describes the position on faces where a mask should be placed by default.
  record mask-position {
    /// The part of the face relative to which the mask should be placed. One of “forehead”, “eyes”, “mouth”, or “chin”.
    point: mask-position-point-enum,
    /// Mask scaling coefficient. For example, 2.0 means double size.
    scale: f64,
    /// Shift by X-axis measured in widths of the mask scaled to the face size, from left to right. For example, choosing -1.0 will place mask just to the left of the default mask position.
    x-shift: f64,
    /// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to bottom. For example, 1.0 will place the mask just below the default mask position.
    y-shift: f64
  }

  /// This object contains basic information about a successful payment.
  record successful-payment {
    /// Three-letter ISO 4217 [currency](/bots/payments#supported-currencies) code
    currency: string,
    /// Bot specified invoice payload
    invoice-payload: string,
    order-info: option<order-info>,
    /// Provider payment identifier
    provider-payment-charge-id: string,
    /// *Optional*. Identifier of the shipping option chosen by the user
    shipping-option-id: option<string>,
    /// Telegram payment identifier
    telegram-payment-charge-id: string,
    /// Total price in the *smallest units* of the currency (integer, **not** float/double). For example, for a price of `US$ 1.45` pass `amount = 145`. See the *exp* parameter in [currencies.json](https://core.telegram.org/bots/payments/currencies.json), it shows the number of digits past the decimal point for each currency (2 for the majority of currencies).
    total-amount: s32
  }

  /// This object represents information about an order.
  record order-info {
    /// *Optional*. User email
    email: option<string>,
    /// *Optional*. User name
    name: option<string>,
    /// *Optional*. User's phone number
    phone-number: option<string>,
    shipping-address: option<shipping-address>
  }

  /// This object represents a shipping address.
  record shipping-address {
    /// City
    city: string,
    /// ISO 3166-1 alpha-2 country code
    country-code: string,
    /// Address post code
    post-code: string,
    /// State, if applicable
    state: string,
    /// First line for the address
    street-line1: string,
    /// Second line for the address
    street-line2: string
  }

  /// This object represents a venue.
  record venue {
    /// Address of the venue
    address: string,
    /// *Optional*. Foursquare identifier of the venue
    foursquare-id: option<string>,
    /// *Optional*. Foursquare type of the venue. (For example, “arts\_entertainment/default”, “arts\_entertainment/aquarium” or “food/icecream”.)
    foursquare-type: option<string>,
    /// *Optional*. Google Places identifier of the venue
    google-place-id: option<string>,
    /// *Optional*. Google Places type of the venue. (See [supported types](https://developers.google.com/places/web-service/supported_types).)
    google-place-type: option<string>,
    location: location,
    /// Name of the venue
    title: string
  }

  /// This object represents a video file.
  record video {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. Original filename as defined by sender
    file-name: option<string>,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video height as defined by sender
    height: s32,
    /// *Optional*. Mime type of a file as defined by sender
    mime-type: option<string>,
    thumb: option<photo-size>,
    /// Video width as defined by sender
    width: s32
  }

  /// This object represents a [video message](https://telegram.org/blog/video-messages-and-telescope) (available in Telegram apps as of [v.4.0](https://telegram.org/blog/video-messages-and-telescope)).
  record video-note {
    /// Duration of the video in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// Video width and height (diameter of the video message) as defined by sender
    length: s32,
    thumb: option<photo-size>
  }

  /// This object represents a voice note.
  record voice {
    /// Duration of the audio in seconds as defined by sender
    duration: s32,
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File size
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string,
    /// *Optional*. MIME type of the file as defined by sender
    mime-type: option<string>
  }

  record post-send-voice-params {
    /// Pass *True*, if the message should be sent even if the specified replied-to message is not found
    allow-sending-without-reply: option<bool>,
    /// Voice message caption, 0-1024 characters after entities parsing
    caption: option<string>,
    /// List of special entities that appear in the caption, which can be specified instead of *parse\_mode*
    caption-entities: option<list<message-entity>>,
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Sends the message [silently](https://telegram.org/blog/channels-2-0#silent-messages). Users will receive a notification with no sound.
    disable-notification: option<bool>,
    /// Duration of the voice message in seconds
    duration: option<s32>,
    /// Mode for parsing entities in the voice message caption. See [formatting options](https://core.telegram.org/bots/api/#formatting-options) for more details.
    parse-mode: option<string>,
    /// Additional interface options. A JSON-serialized object for an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating), [custom reply keyboard](https://core.telegram.org/bots#keyboards), instructions to remove reply keyboard or to force a reply from the user.
    reply-markup: option<string>,
    /// If the message is a reply, ID of the original message
    reply-to-message-id: option<s32>,
    /// Audio file to send. Pass a file\_id as String to send a file that exists on the Telegram servers (recommended), pass an HTTP URL as a String for Telegram to get a file from the Internet, or upload a new one using multipart/form-data. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files)
    voice: string
  }
  post-send-voice: func(params: post-send-voice-params) -> result<post-send-voice-response, string>;

}

interface set-chat-administrator-custom-title {
  record post-set-chat-administrator-custom-title-response {
    ok: bool,
    result-op: bool
  }

  record post-set-chat-administrator-custom-title-params {
    /// Unique identifier for the target chat or username of the target supergroup (in the format `@supergroupusername`)
    chat-id: string,
    /// New custom title for the administrator; 0-16 characters, emoji are not allowed
    custom-title: string,
    /// Unique identifier of the target user
    user-id: s32
  }
  post-set-chat-administrator-custom-title: func(params: post-set-chat-administrator-custom-title-params) -> result<post-set-chat-administrator-custom-title-response, string>;

}

interface set-chat-description {
  record post-set-chat-description-response {
    ok: bool,
    result-op: bool
  }

  record post-set-chat-description-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// New chat description, 0-255 characters
    description: option<string>
  }
  post-set-chat-description: func(params: post-set-chat-description-params) -> result<post-set-chat-description-response, string>;

}

interface set-chat-permissions {
  /// Describes actions that a non-administrator user is allowed to take in a chat.
  record chat-permissions {
    /// *Optional*. True, if the user is allowed to add web page previews to their messages, implies can\_send\_media\_messages
    can-add-web-page-previews: option<bool>,
    /// *Optional*. True, if the user is allowed to change the chat title, photo and other settings. Ignored in public supergroups
    can-change-info: option<bool>,
    /// *Optional*. True, if the user is allowed to invite new users to the chat
    can-invite-users: option<bool>,
    /// *Optional*. True, if the user is allowed to pin messages. Ignored in public supergroups
    can-pin-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send audios, documents, photos, videos, video notes and voice notes, implies can\_send\_messages
    can-send-media-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send text messages, contacts, locations and venues
    can-send-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send animations, games, stickers and use inline bots, implies can\_send\_media\_messages
    can-send-other-messages: option<bool>,
    /// *Optional*. True, if the user is allowed to send polls, implies can\_send\_messages
    can-send-polls: option<bool>
  }

  record post-set-chat-permissions-response {
    ok: bool,
    result-op: bool
  }

  record post-set-chat-permissions-params {
    /// Unique identifier for the target chat or username of the target supergroup (in the format `@supergroupusername`)
    chat-id: string,
    permissions: chat-permissions
  }
  post-set-chat-permissions: func(params: post-set-chat-permissions-params) -> result<post-set-chat-permissions-response, string>;

}

interface set-chat-photo {
  /// This object represents the contents of a file to be uploaded. Must be posted using multipart/form-data in the usual way that files are uploaded via the browser.
  record input-file {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-set-chat-photo-response {
    ok: bool,
    result-op: bool
  }

  record post-set-chat-photo-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    photo: input-file
  }
  post-set-chat-photo: func(params: post-set-chat-photo-params) -> result<post-set-chat-photo-response, string>;

}

interface set-chat-sticker-set {
  record post-set-chat-sticker-set-response {
    ok: bool,
    result-op: bool
  }

  record post-set-chat-sticker-set-params {
    /// Unique identifier for the target chat or username of the target supergroup (in the format `@supergroupusername`)
    chat-id: string,
    /// Name of the sticker set to be set as the group sticker set
    sticker-set-name: string
  }
  post-set-chat-sticker-set: func(params: post-set-chat-sticker-set-params) -> result<post-set-chat-sticker-set-response, string>;

}

interface set-chat-title {
  record post-set-chat-title-response {
    ok: bool,
    result-op: bool
  }

  record post-set-chat-title-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// New chat title, 1-255 characters
    title: string
  }
  post-set-chat-title: func(params: post-set-chat-title-params) -> result<post-set-chat-title-response, string>;

}

interface set-game-score {
  record post-set-game-score-response {
    ok: bool,
    result-op: string
  }

  record post-set-game-score-params {
    /// Required if *inline\_message\_id* is not specified. Unique identifier for the target chat
    chat-id: option<s32>,
    /// Pass True, if the game message should not be automatically edited to include the current scoreboard
    disable-edit-message: option<bool>,
    /// Pass True, if the high score is allowed to decrease. This can be useful when fixing mistakes or banning cheaters
    force: option<bool>,
    /// Required if *chat\_id* and *message\_id* are not specified. Identifier of the inline message
    inline-message-id: option<string>,
    /// Required if *inline\_message\_id* is not specified. Identifier of the sent message
    message-id: option<s32>,
    /// New score, must be non-negative
    score: s32,
    /// User identifier
    user-id: s32
  }
  post-set-game-score: func(params: post-set-game-score-params) -> result<post-set-game-score-response, string>;

}

interface set-my-commands {
  /// This object represents a bot command.
  record bot-command {
    /// Text of the command, 1-32 characters. Can contain only lowercase English letters, digits and underscores.
    command: string,
    /// Description of the command, 3-256 characters.
    description: string
  }

  record post-set-my-commands-response {
    ok: bool,
    result-op: bool
  }

  record post-set-my-commands-params {
    /// A JSON-serialized list of bot commands to be set as the list of the bot's commands. At most 100 commands can be specified.
    commands: list<bot-command>
  }
  post-set-my-commands: func(params: post-set-my-commands-params) -> result<post-set-my-commands-response, string>;

}

interface set-passport-data-errors {
  /// This object represents an error in the Telegram Passport element which was submitted that should be resolved by the user. It should be one of:
  record passport-element-error {
    /// opaque schema; raw JSON
    value: string
  }

  record post-set-passport-data-errors-response {
    ok: bool,
    result-op: bool
  }

  record post-set-passport-data-errors-params {
    /// A JSON-serialized array describing the errors
    errors: list<passport-element-error>,
    /// User identifier
    user-id: s32
  }
  post-set-passport-data-errors: func(params: post-set-passport-data-errors-params) -> result<post-set-passport-data-errors-response, string>;

}

interface set-sticker-position-in-set {
  record post-set-sticker-position-in-set-response {
    ok: bool,
    result-op: bool
  }

  record post-set-sticker-position-in-set-params {
    /// New sticker position in the set, zero-based
    position: s32,
    /// File identifier of the sticker
    sticker: string
  }
  post-set-sticker-position-in-set: func(params: post-set-sticker-position-in-set-params) -> result<post-set-sticker-position-in-set-response, string>;

}

interface set-sticker-set-thumb {
  record post-set-sticker-set-thumb-response {
    ok: bool,
    result-op: bool
  }

  record post-set-sticker-set-thumb-params {
    /// Sticker set name
    name: string,
    /// A **PNG** image with the thumbnail, must be up to 128 kilobytes in size and have width and height exactly 100px, or a **TGS** animation with the thumbnail up to 32 kilobytes in size; see [](https://core.telegram.org/animated_stickers#technical-requirements)[https://core.telegram.org/animated\_stickers#technical-requirements](https://core.telegram.org/animated_stickers#technical-requirements) for animated sticker technical requirements. Pass a *file\_id* as a String to send a file that already exists on the Telegram servers, pass an HTTP URL as a String for Telegram to get a file from the Internet, or upload a new one using multipart/form-data. [More info on Sending Files »](https://core.telegram.org/bots/api/#sending-files). Animated sticker set thumbnail can't be uploaded via HTTP URL.
    thumb: option<string>,
    /// User identifier of the sticker set owner
    user-id: s32
  }
  post-set-sticker-set-thumb: func(params: post-set-sticker-set-thumb-params) -> result<post-set-sticker-set-thumb-response, string>;

}

interface set-webhook {
  /// This object represents the contents of a file to be uploaded. Must be posted using multipart/form-data in the usual way that files are uploaded via the browser.
  record input-file {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-set-webhook-response {
    ok: bool,
    result-op: bool
  }

  record post-set-webhook-params {
    /// A JSON-serialized list of the update types you want your bot to receive. For example, specify [“message”, “edited\_channel\_post”, “callback\_query”] to only receive updates of these types. See [Update](https://core.telegram.org/bots/api/#update) for a complete list of available update types. Specify an empty list to receive all updates regardless of type (default). If not specified, the previous setting will be used.  
    /// Please note that this parameter doesn't affect updates created before the call to the setWebhook, so unwanted updates may be received for a short period of time.
    allowed-updates: option<list<string>>,
    certificate: option<input-file>,
    /// Pass *True* to drop all pending updates
    drop-pending-updates: option<bool>,
    /// The fixed IP address which will be used to send webhook requests instead of the IP address resolved through DNS
    ip-address: option<string>,
    /// Maximum allowed number of simultaneous HTTPS connections to the webhook for update delivery, 1-100. Defaults to *40*. Use lower values to limit the load on your bot's server, and higher values to increase your bot's throughput.
    max-connections: option<s32>,
    /// HTTPS url to send updates to. Use an empty string to remove webhook integration
    url: string
  }
  post-set-webhook: func(params: post-set-webhook-params) -> result<post-set-webhook-response, string>;

}

interface stop-message-live-location {
  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  record post-stop-message-live-location-response {
    ok: bool,
    result-op: string
  }

  record post-stop-message-live-location-params {
    /// Required if *inline\_message\_id* is not specified. Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: option<string>,
    /// Required if *chat\_id* and *message\_id* are not specified. Identifier of the inline message
    inline-message-id: option<string>,
    /// Required if *inline\_message\_id* is not specified. Identifier of the message with live location to stop
    message-id: option<s32>,
    reply-markup: option<inline-keyboard-markup>
  }
  post-stop-message-live-location: func(params: post-stop-message-live-location-params) -> result<post-stop-message-live-location-response, string>;

}

interface stop-poll {
  enum message-entity-type-op-enum {
    mention,
    hashtag,
    cashtag,
    bot-command,
    url,
    email,
    phone-number,
    bold,
    italic,
    underline,
    strikethrough,
    code,
    pre,
    text-link,
    text-mention,
  }

  /// This object represents an [inline keyboard](https://core.telegram.org/bots#inline-keyboards-and-on-the-fly-updating) that appears right next to the message it belongs to.
  record inline-keyboard-markup {
    /// Array of button rows, each represented by an Array of [InlineKeyboardButton](https://core.telegram.org/bots/api/#inlinekeyboardbutton) objects
    inline-keyboard: list<list<inline-keyboard-button>>
  }

  /// This object represents one button of an inline keyboard. You **must** use exactly one of the optional fields.
  record inline-keyboard-button {
    /// *Optional*. Data to be sent in a [callback query](https://core.telegram.org/bots/api/#callbackquery) to the bot when button is pressed, 1-64 bytes
    callback-data: option<string>,
    callback-game: option<callback-game>,
    login-url: option<login-url>,
    /// *Optional*. Specify True, to send a [Pay button](https://core.telegram.org/bots/api/#payments).  
    /// 
    pay: option<bool>,
    /// *Optional*. If set, pressing the button will prompt the user to select one of their chats, open that chat and insert the bot's username and the specified inline query in the input field. Can be empty, in which case just the bot's username will be inserted.  
    /// 
    switch-inline-query: option<string>,
    /// *Optional*. If set, pressing the button will insert the bot's username and the specified inline query in the current chat's input field. Can be empty, in which case only the bot's username will be inserted.  
    /// 
    switch-inline-query-current-chat: option<string>,
    /// Label text on the button
    text: string,
    /// *Optional*. HTTP or tg:// url to be opened when button is pressed
    url: option<string>
  }

  /// A placeholder, currently holds no information. Use [BotFather](https://t.me/botfather) to set up your game.
  record callback-game {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// This object represents a parameter of the inline keyboard button used to automatically authorize a user. Serves as a great replacement for the [Telegram Login Widget](https://core.telegram.org/widgets/login) when the user is coming from Telegram. All the user needs to do is tap/click a button and confirm that they want to log in:
  /// 
  /// Telegram apps support these buttons as of [version 5.7](https://telegram.org/blog/privacy-discussions-web-bots#meet-seamless-web-bots).
  /// 
  /// Sample bot: [@discussbot](https://t.me/discussbot)
  record login-url {
    /// *Optional*. Username of a bot, which will be used for user authorization. See [Setting up a bot](https://core.telegram.org/widgets/login#setting-up-a-bot) for more details. If not specified, the current bot's username will be assumed. The *url*'s domain must be the same as the domain linked with the bot. See [Linking your domain to the bot](https://core.telegram.org/widgets/login#linking-your-domain-to-the-bot) for more details.
    bot-username: option<string>,
    /// *Optional*. New text of the button in forwarded messages.
    forward-text: option<string>,
    /// *Optional*. Pass True to request the permission for your bot to send messages to the user.
    request-write-access: option<bool>,
    /// An HTTP URL to be opened with user authorization data added to the query string when the button is pressed. If the user refuses to provide authorization data, the original URL without information about the user will be opened. The data added is the same as described in [Receiving authorization data](https://core.telegram.org/widgets/login#receiving-authorization-data).  
    /// 
    url: string
  }

  record post-stop-poll-response {
    ok: bool,
    result-op: poll
  }

  /// This object contains information about a poll.
  record poll {
    /// True, if the poll allows multiple answers
    allows-multiple-answers: bool,
    /// *Optional*. Point in time (Unix timestamp) when the poll will be automatically closed
    close-date: option<s32>,
    /// *Optional*. 0-based identifier of the correct answer option. Available only for polls in the quiz mode, which are closed, or was sent (not forwarded) by the bot or to the private chat with the bot.
    correct-option-id: option<s32>,
    /// *Optional*. Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a quiz-style poll, 0-200 characters
    explanation: option<string>,
    /// *Optional*. Special entities like usernames, URLs, bot commands, etc. that appear in the *explanation*
    explanation-entities: option<list<message-entity>>,
    /// Unique poll identifier
    id: string,
    /// True, if the poll is anonymous
    is-anonymous: bool,
    /// True, if the poll is closed
    is-closed: bool,
    /// *Optional*. Amount of time in seconds the poll will be active after creation
    open-period: option<s32>,
    /// List of poll options
    options: list<poll-option>,
    /// Poll question, 1-255 characters
    question: string,
    /// Total number of users that voted in the poll
    total-voter-count: s32,
    /// Poll type, currently can be “regular” or “quiz”
    type-op: string
  }

  /// This object represents one special entity in a text message. For example, hashtags, usernames, URLs, etc.
  record message-entity {
    /// *Optional*. For “pre” only, the programming language of the entity text
    language: option<string>,
    /// Length of the entity in UTF-16 code units
    length: s32,
    /// Offset in UTF-16 code units to the start of the entity
    offset: s32,
    /// Type of the entity. Can be “mention” (`@username`), “hashtag” (`#hashtag`), “cashtag” (`$USD`), “bot\_command” (`/start@jobs_bot`), “url” (`https://telegram.org`), “email” (`do-not-reply@telegram.org`), “phone\_number” (`+1-212-555-0123`), “bold” (**bold text**), “italic” (*italic text*), “underline” (underlined text), “strikethrough” (strikethrough text), “code” (monowidth string), “pre” (monowidth block), “text\_link” (for clickable text URLs), “text\_mention” (for users [without usernames](https://telegram.org/blog/edit#new-mentions))
    type-op: message-entity-type-op-enum,
    /// *Optional*. For “text\_link” only, url that will be opened after user taps on the text
    url: option<string>,
    user: option<user>
  }

  /// This object represents a Telegram user or bot.
  record user {
    /// *Optional*. True, if the bot can be invited to groups. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-join-groups: option<bool>,
    /// *Optional*. True, if [privacy mode](https://core.telegram.org/bots#privacy-mode) is disabled for the bot. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    can-read-all-group-messages: option<bool>,
    /// User's or bot's first name
    first-name: string,
    /// Unique identifier for this user or bot
    id: s32,
    /// True, if this user is a bot
    is-bot: bool,
    /// *Optional*. [IETF language tag](https://en.wikipedia.org/wiki/IETF_language_tag) of the user's language
    language-code: option<string>,
    /// *Optional*. User's or bot's last name
    last-name: option<string>,
    /// *Optional*. True, if the bot supports inline queries. Returned only in [getMe](https://core.telegram.org/bots/api/#getme).
    supports-inline-queries: option<bool>,
    /// *Optional*. User's or bot's username
    username: option<string>
  }

  /// This object contains information about one answer option in a poll.
  record poll-option {
    /// Option text, 1-100 characters
    text: string,
    /// Number of users that voted for this option
    voter-count: s32
  }

  record post-stop-poll-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Identifier of the original message with the poll
    message-id: s32,
    reply-markup: option<inline-keyboard-markup>
  }
  post-stop-poll: func(params: post-stop-poll-params) -> result<post-stop-poll-response, string>;

}

interface unban-chat-member {
  record post-unban-chat-member-response {
    ok: bool,
    result-op: bool
  }

  record post-unban-chat-member-params {
    /// Unique identifier for the target group or username of the target supergroup or channel (in the format `@username`)
    chat-id: string,
    /// Do nothing if the user is not banned
    only-if-banned: option<bool>,
    /// Unique identifier of the target user
    user-id: s32
  }
  post-unban-chat-member: func(params: post-unban-chat-member-params) -> result<post-unban-chat-member-response, string>;

}

interface unpin-all-chat-messages {
  record post-unpin-all-chat-messages-response {
    ok: bool,
    result-op: bool
  }

  record post-unpin-all-chat-messages-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string
  }
  post-unpin-all-chat-messages: func(params: post-unpin-all-chat-messages-params) -> result<post-unpin-all-chat-messages-response, string>;

}

interface unpin-chat-message {
  record post-unpin-chat-message-response {
    ok: bool,
    result-op: bool
  }

  record post-unpin-chat-message-params {
    /// Unique identifier for the target chat or username of the target channel (in the format `@channelusername`)
    chat-id: string,
    /// Identifier of a message to unpin. If not specified, the most recent pinned message (by sending date) will be unpinned.
    message-id: option<s32>
  }
  post-unpin-chat-message: func(params: post-unpin-chat-message-params) -> result<post-unpin-chat-message-response, string>;

}

interface upload-sticker-file {
  /// This object represents the contents of a file to be uploaded. Must be posted using multipart/form-data in the usual way that files are uploaded via the browser.
  record input-file {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-upload-sticker-file-response {
    ok: bool,
    result-op: file
  }

  /// This object represents a file ready to be downloaded. The file can be downloaded via the link `https://api.telegram.org/file/bot<token>/<file_path>`. It is guaranteed that the link will be valid for at least 1 hour. When the link expires, a new one can be requested by calling [getFile](https://core.telegram.org/bots/api/#getfile).
  /// 
  /// Maximum file size to download is 20 MB
  record file {
    /// Identifier for this file, which can be used to download or reuse the file
    file-id: string,
    /// *Optional*. File path. Use `https://api.telegram.org/file/bot<token>/<file_path>` to get the file.
    file-path: option<string>,
    /// *Optional*. File size, if known
    file-size: option<s32>,
    /// Unique identifier for this file, which is supposed to be the same over time and for different bots. Can't be used to download or reuse the file.
    file-unique-id: string
  }

  record post-upload-sticker-file-params {
    png-sticker: input-file,
    /// User identifier of sticker file owner
    user-id: s32
  }
  post-upload-sticker-file: func(params: post-upload-sticker-file-params) -> result<post-upload-sticker-file-response, string>;

}
