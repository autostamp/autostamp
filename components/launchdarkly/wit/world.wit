/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export root;
  export relay-proxy-configurations;
  export audit-log;
  export data-export-destinations;
  export feature-flags;
  export integrations;
  export team-members;
  export projects;
  export environments;
  export custom-roles;
  export user-segments;
  export access-tokens;
  export customer-metrics;
  export users;
  export user-settings;
  export webhooks;
}
