    droplet: option<string>,
    /// The public IP address of the reserved IP. It also serves as its identifier.
    ip: option<string>,
    /// A boolean value indicating whether or not the reserved IP has pending actions preventing new ones from being submitted.
    locked: option<bool>,
    /// The UUID of the project to which the reserved IP currently belongs.
    project-id: option<string>,
    region: option<create-response-reserved-ip-region>
  }

  record create-response-reserved-ip-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record get-response {
    reserved-ip: option<get-response-reserved-ip>
  }

  record get-response-reserved-ip {
    /// The Droplet that the reserved IP has been assigned to. When you query a reserved IP, if it is assigned to a Droplet, the entire Droplet object will be returned. If it is not assigned, the value will be null.
    droplet: option<string>,
    /// The public IP address of the reserved IP. It also serves as its identifier.
    ip: option<string>,
    /// A boolean value indicating whether or not the reserved IP has pending actions preventing new ones from being submitted.
    locked: option<bool>,
    /// The UUID of the project to which the reserved IP currently belongs.
    project-id: option<string>,
    region: option<get-response-reserved-ip-region>
  }

  record get-response-reserved-ip-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  variant list-op-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
