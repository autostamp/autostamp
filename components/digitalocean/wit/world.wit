  }

  record get-available-upgrades-response-available-upgrade-versions-item {
    /// The upstream version string for the version of Kubernetes provided by a given slug.
    kubernetes-version: option<string>,
    /// The slug identifier for an available version of Kubernetes for use when creating or updating a cluster. The string contains both the upstream version of Kubernetes as well as the DigitalOcean revision.
    slug: option<string>,
    /// The features available with the version of Kubernetes provided by a given slug.
    supported-features: option<list<string>>
  }

  record get-cluster-user-response {
    kubernetes-cluster-user: option<get-cluster-user-response-kubernetes-cluster-user>
  }

  record get-cluster-user-response-kubernetes-cluster-user {
    /// A list of in-cluster groups that the user belongs to.
    groups: option<list<string>>,
    /// The username for the cluster admin user.
    username: option<string>
  }

  record list-options-response {
    options: option<list-options-response-options>
  }

  record list-options-response-options {
    regions: option<list<list-options-response-options-regions-item>>,
    sizes: option<list<list-options-response-options-sizes-item>>,
    versions: option<list<list-options-response-options-versions-item>>
  }

  record list-options-response-options-regions-item {
    /// A DigitalOcean region where Kubernetes is available.
    name: option<string>,
    /// The identifier for a region for use when creating a new cluster.
    slug: option<string>
  }

  record list-options-response-options-sizes-item {
    /// A Droplet size available for use in a Kubernetes node pool.
    name: option<string>,
    /// The identifier for a size for use when creating a new cluster.
    slug: option<string>
  }

  record list-options-response-options-versions-item {
    /// The upstream version string for the version of Kubernetes provided by a given slug.
    kubernetes-version: option<string>,
    /// The slug identifier for an available version of Kubernetes for use when creating or updating a cluster. The string contains both the upstream version of Kubernetes as well as the DigitalOcean revision.
    slug: option<string>,
    /// The features available with the version of Kubernetes provided by a given slug.
    supported-features: option<list<string>>
  }

