    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant domains-update-record-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant domains-patch-record-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant domains-delete-record-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Domain Records
  record domains-list-records-params {
    /// The name of the domain itself.
    domain-name: string,
    /// A fully qualified record name. For example, to only include records matching sub.example.com, send a GET request to `/v2/domains/$DOMAIN_NAME/records?name=sub.example.com`.
    name: option<string>,
    /// The type of the DNS record. For example: A, CNAME, TXT, ...
