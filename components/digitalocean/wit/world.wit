    vpc-uuid: option<string>,
    region: option<string>,
    /// An array containing the IDs of the Droplets assigned to the load balancer.
    droplet-ids: option<list<s32>>,
    /// The name of a Droplet tag corresponding to Droplets assigned to the load balancer.
    tag: option<string>
  }

  /// An object specifying allow and deny rules to control traffic to the load balancer.
  record update-response-load-balancer-firewall {
    /// the rules for allowing traffic to the load balancer (in the form 'ip:1.2.3.4' or 'cidr:1.2.0.0/16')
    allow: option<list<string>>,
    /// the rules for denying traffic to the load balancer (in the form 'ip:1.2.3.4' or 'cidr:1.2.0.0/16')
    deny: option<list<string>>
  }

  /// An object specifying a forwarding rule for a load balancer.
  record update-response-load-balancer-forwarding-rules-item {
    /// The ID of the TLS certificate used for SSL termination if enabled.
    certificate-id: option<string>,
    /// An integer representing the port on which the load balancer instance will listen.
    entry-port: s32,
    /// The protocol used for traffic to the load balancer. The possible values are: `http`, `https`, `http2`, `http3`, `tcp`, or `udp`. If you set the  `entry_protocol` to `udp`, the `target_protocol` must be set to `udp`.  When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    entry-protocol: list-op-response-load-balancers-item-forwarding-rules-item-entry-protocol-enum,
    /// An integer representing the port on the backend Droplets to which the load balancer will send traffic.
    target-port: s32,
    /// The protocol used for traffic from the load balancer to the backend Droplets. The possible values are: `http`, `https`, `http2`, `tcp`, or `udp`. If you set the `target_protocol` to `udp`, the `entry_protocol` must be set to  `udp`. When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    target-protocol: list-op-response-load-balancers-item-forwarding-rules-item-target-protocol-enum,
    /// A boolean value indicating whether SSL encrypted traffic will be passed through to the backend Droplets.
    tls-passthrough: option<bool>
  }

  /// An object specifying health check settings for the load balancer.
  record update-response-load-balancer-health-check {
    /// The number of seconds between between two consecutive health checks.
    check-interval-seconds: option<s32>,
    /// The number of times a health check must pass for a backend Droplet to be marked "healthy" and be re-added to the pool.
    healthy-threshold: option<s32>,
    /// The path on the backend Droplets to which the load balancer instance will send a request.
    path: option<string>,
    /// An integer representing the port on the backend Droplets on which the health check will attempt a connection.
    port: option<s32>,
    /// The protocol used for health checks sent to the backend Droplets. The possible values are `http`, `https`, or `tcp`.
    protocol: option<list-op-response-load-balancers-item-health-check-protocol-enum>,
    /// The number of seconds the load balancer instance will wait for a response until marking a health check as failed.
    response-timeout-seconds: option<s32>,
    /// The number of times a health check must fail for a backend Droplet to be marked "unhealthy" and be removed from the pool.
    unhealthy-threshold: option<s32>
  }

  /// An object specifying sticky sessions settings for the load balancer.
  record update-response-load-balancer-sticky-sessions {
    /// The name of the cookie sent to the client. This attribute is only returned when using `cookies` for the sticky sessions type.
    cookie-name: option<string>,
    /// The number of seconds until the cookie set by the load balancer expires. This attribute is only returned when using `cookies` for the sticky sessions type.
    cookie-ttl-seconds: option<s32>,
    /// An attribute indicating how and if requests from a client will be persistently served by the same backend Droplet. The possible values are `cookies` or `none`.
    type-op: option<list-op-response-load-balancers-item-sticky-sessions-type-op-enum>
  }

  /// An object specifying a forwarding rule for a load balancer.
  record add-forwarding-rules-body-forwarding-rules-item {
    /// The ID of the TLS certificate used for SSL termination if enabled.
    certificate-id: option<string>,
    /// An integer representing the port on which the load balancer instance will listen.
    entry-port: s32,
    /// The protocol used for traffic to the load balancer. The possible values are: `http`, `https`, `http2`, `http3`, `tcp`, or `udp`. If you set the  `entry_protocol` to `udp`, the `target_protocol` must be set to `udp`.  When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    entry-protocol: list-op-response-load-balancers-item-forwarding-rules-item-entry-protocol-enum,
    /// An integer representing the port on the backend Droplets to which the load balancer will send traffic.
    target-port: s32,
    /// The protocol used for traffic from the load balancer to the backend Droplets. The possible values are: `http`, `https`, `http2`, `tcp`, or `udp`. If you set the `target_protocol` to `udp`, the `entry_protocol` must be set to  `udp`. When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    target-protocol: list-op-response-load-balancers-item-forwarding-rules-item-target-protocol-enum,
    /// A boolean value indicating whether SSL encrypted traffic will be passed through to the backend Droplets.
    tls-passthrough: option<bool>
  }

  /// An object specifying a forwarding rule for a load balancer.
  record remove-forwarding-rules-body-forwarding-rules-item {
    /// The ID of the TLS certificate used for SSL termination if enabled.
    certificate-id: option<string>,
    /// An integer representing the port on which the load balancer instance will listen.
    entry-port: s32,
    /// The protocol used for traffic to the load balancer. The possible values are: `http`, `https`, `http2`, `http3`, `tcp`, or `udp`. If you set the  `entry_protocol` to `udp`, the `target_protocol` must be set to `udp`.  When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    entry-protocol: list-op-response-load-balancers-item-forwarding-rules-item-entry-protocol-enum,
    /// An integer representing the port on the backend Droplets to which the load balancer will send traffic.
    target-port: s32,
    /// The protocol used for traffic from the load balancer to the backend Droplets. The possible values are: `http`, `https`, `http2`, `tcp`, or `udp`. If you set the `target_protocol` to `udp`, the `entry_protocol` must be set to  `udp`. When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    target-protocol: list-op-response-load-balancers-item-forwarding-rules-item-target-protocol-enum,
    /// A boolean value indicating whether SSL encrypted traffic will be passed through to the backend Droplets.
    tls-passthrough: option<bool>
  }

  variant list-op-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant create-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant update-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant add-droplets-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant remove-droplets-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant add-forwarding-rules-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant remove-forwarding-rules-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Load Balancers
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Create a New Load Balancer
  record create-params {
    body: string
  }
  create: func(params: create-params) -> result<create-response, create-error>;

  /// Retrieve an Existing Load Balancer
  record get-params {
    /// A unique identifier for a load balancer.
    lb-id: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Update a Load Balancer
  record update-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    body: string
  }
  update: func(params: update-params) -> result<update-response, update-error>;

  /// Delete a Load Balancer
  record delete-params {
    /// A unique identifier for a load balancer.
    lb-id: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

  /// Add Droplets to a Load Balancer
  record add-droplets-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    /// An array containing the IDs of the Droplets assigned to the load balancer.
    droplet-ids: option<list<s32>>
  }
  add-droplets: func(params: add-droplets-params) -> result<string, add-droplets-error>;

  /// Remove Droplets from a Load Balancer
  record remove-droplets-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    /// An array containing the IDs of the Droplets assigned to the load balancer.
    droplet-ids: option<list<s32>>
  }
  remove-droplets: func(params: remove-droplets-params) -> result<string, remove-droplets-error>;

  /// Add Forwarding Rules to a Load Balancer
  record add-forwarding-rules-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    forwarding-rules: list<add-forwarding-rules-body-forwarding-rules-item>
  }
  add-forwarding-rules: func(params: add-forwarding-rules-params) -> result<string, add-forwarding-rules-error>;

  /// Remove Forwarding Rules from a Load Balancer
  record remove-forwarding-rules-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    forwarding-rules: list<remove-forwarding-rules-body-forwarding-rules-item>
  }
  remove-forwarding-rules: func(params: remove-forwarding-rules-params) -> result<string, remove-forwarding-rules-error>;

}

