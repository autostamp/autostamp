    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant cdn-create-endpoint-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant cdn-get-endpoint-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant cdn-update-endpoints-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant cdn-delete-endpoint-error {
