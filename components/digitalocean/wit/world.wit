  list-regions: func() -> result<list-regions-response, list-regions-error>;

  /// List App Tiers
  list-tiers: func() -> result<list-tiers-response, list-tiers-error>;

  /// List Instance Sizes
  list-instance-sizes: func() -> result<list-instance-sizes-response, list-instance-sizes-error>;

