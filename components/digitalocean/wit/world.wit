    /// The details of the network that are configured for the Droplet instance.  This is an object that contains keys for IPv4 and IPv6.  The value of each of these is an array that contains objects describing an individual IP resource allocated to the Droplet.  These will define attributes like the IP address, netmask, and gateway of the specific network depending on the type of network it is.
    networks: list-neighbors-response-droplets-item-networks,
    /// The details of the Droplet's backups feature, if backups are configured for the Droplet. This object contains keys for the start and end times of the window during which the backup will start.
    next-backup-window: list-neighbors-response-droplets-item-next-backup-window,
    region: list-neighbors-response-droplets-item-region,
    size: list-neighbors-response-droplets-item-size,
    /// The unique slug identifier for the size of this Droplet.
    size-slug: string,
    /// An array of snapshot IDs of any snapshots created from the Droplet instance.
    snapshot-ids: list<s32>,
    /// A status string indicating the state of the Droplet instance. This may be "new", "active", "off", or "archive".
    status: list-op-response-droplets-item-status-enum,
    /// An array of Tags the Droplet has been tagged with.
    tags: list<string>,
    /// The number of virtual CPUs.
    vcpus: s32,
    /// A flat array including the unique identifier for each Block Storage volume attached to the Droplet.
    volume-ids: list<string>,
    /// A string specifying the UUID of the VPC to which the Droplet is assigned.
    vpc-uuid: option<string>
  }

  record list-neighbors-response-droplets-item-image {
    /// A time value given in ISO8601 combined date and time format that represents when the image was created.
    created-at: option<string>,
    /// An optional free-form text field to describe an image.
    description: option<string>,
    /// The name of a custom image's distribution. Currently, the valid values are  `Arch Linux`, `CentOS`, `CoreOS`, `Debian`, `Fedora`, `Fedora Atomic`,  `FreeBSD`, `Gentoo`, `openSUSE`, `RancherOS`, `Rocky Linux`, `Ubuntu`, and `Unknown`.  Any other value will be accepted but ignored, and `Unknown` will be used in its place.
    distribution: option<list-op-response-droplets-item-image-distribution-enum>,
    /// A string containing information about errors that may occur when importing
    ///  a custom image.
    error-message: option<string>,
    /// A unique number that can be used to identify and reference a specific image.
    id: option<s32>,
    /// The minimum disk size in GB required for a Droplet to use this image.
    min-disk-size: option<s32>,
    /// The display name that has been given to an image.  This is what is shown in the control panel and is generally a descriptive title for the image in question.
    name: option<string>,
    /// This is a boolean value that indicates whether the image in question is public or not. An image that is public is available to all accounts. A non-public image is only accessible from your account.
    public: option<bool>,
    /// This attribute is an array of the regions that the image is available in. The regions are represented by their identifying slug values.
    regions: option<list<list-op-response-droplets-item-image-regions-item-enum>>,
    /// The size of the image in gigabytes.
    size-gigabytes: option<f64>,
    /// A uniquely identifying string that is associated with each of the DigitalOcean-provided public images. These can be used to reference a public image as an alternative to the numeric id.
    slug: option<string>,
    /// A status string indicating the state of a custom image. This may be `NEW`,
    ///  `available`, `pending`, `deleted`, or `retired`.
    status: option<list-op-response-droplets-item-image-status-enum>,
    /// A flat array of tag names as strings to be applied to the resource. Tag names may be for either existing or new tags.
    tags: option<list<string>>,
    /// Describes the kind of image. It may be one of `base`, `snapshot`, `backup`, `custom`, or `admin`. Respectively, this specifies whether an image is a DigitalOcean base OS image, user-generated Droplet snapshot, automatically created Droplet backup, user-provided virtual machine image, or an image used for DigitalOcean managed resources (e.g. DOKS worker nodes).
    type-op: option<list-op-response-droplets-item-image-type-op-enum>
  }

  /// **Note**: All Droplets created after March 2017 use internal kernels by default.
  /// These Droplets will have this attribute set to `null`.
  /// 
  /// The current [kernel](https://www.digitalocean.com/docs/droplets/how-to/kernel/)
  /// for Droplets with externally managed kernels. This will initially be set to
  /// the kernel of the base image when the Droplet is created.
  record list-neighbors-response-droplets-item-kernel {
    /// A unique number used to identify and reference a specific kernel.
    id: option<s32>,
    /// The display name of the kernel. This is shown in the web UI and is generally a descriptive title for the kernel in question.
    name: option<string>,
    /// A standard kernel version string representing the version, patch, and release information.
    version: option<string>
  }

  /// The details of the network that are configured for the Droplet instance.  This is an object that contains keys for IPv4 and IPv6.  The value of each of these is an array that contains objects describing an individual IP resource allocated to the Droplet.  These will define attributes like the IP address, netmask, and gateway of the specific network depending on the type of network it is.
  record list-neighbors-response-droplets-item-networks {
    v4: option<list<list-neighbors-response-droplets-item-networks-v4-item>>,
    v6: option<list<list-neighbors-response-droplets-item-networks-v6-item>>
  }

  record list-neighbors-response-droplets-item-networks-v4-item {
    /// The gateway of the specified IPv4 network interface.
    /// 
    gateway: option<string>,
    /// The IP address of the IPv4 network interface.
    ip-address: option<string>,
    /// The netmask of the IPv4 network interface.
    netmask: option<string>,
    /// The type of the IPv4 network interface.
    type-op: option<list-op-response-droplets-item-networks-v4-item-type-op-enum>
  }

  record list-neighbors-response-droplets-item-networks-v6-item {
    /// The gateway of the specified IPv6 network interface.
    gateway: option<string>,
    /// The IP address of the IPv6 network interface.
    ip-address: option<string>,
    /// The netmask of the IPv6 network interface.
    netmask: option<s32>,
    /// The type of the IPv6 network interface.
    /// 
    type-op: option<list-op-response-droplets-item-networks-v6-item-type-op-enum>
  }

  /// The details of the Droplet's backups feature, if backups are configured for the Droplet. This object contains keys for the start and end times of the window during which the backup will start.
  record list-neighbors-response-droplets-item-next-backup-window {
    /// A time value given in ISO8601 combined date and time format specifying the end of the Droplet's backup window.
    end: option<string>,
    /// A time value given in ISO8601 combined date and time format specifying the start of the Droplet's backup window.
    start: option<string>
  }

  record list-neighbors-response-droplets-item-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record list-neighbors-response-droplets-item-size {
    /// This is a boolean value that represents whether new Droplets can be created with this size.
    available: bool,
    /// A string describing the class of Droplets created from this size. For example: Basic, General Purpose, CPU-Optimized, Memory-Optimized, or Storage-Optimized.
    description: string,
    /// The amount of disk space set aside for Droplets of this size. The value is represented in gigabytes.
    disk: s32,
    /// The amount of RAM allocated to Droplets created of this size. The value is represented in megabytes.
    memory: s32,
    /// This describes the price of the Droplet size as measured hourly. The value is measured in US dollars.
    price-hourly: f64,
    /// This attribute describes the monthly cost of this Droplet size if the Droplet is kept for an entire month. The value is measured in US dollars.
    price-monthly: f64,
    /// An array containing the region slugs where this size is available for Droplet creates.
    regions: list<string>,
    /// A human-readable string that is used to uniquely identify each size.
    slug: string,
    /// The amount of transfer bandwidth that is available for Droplets created in this size. This only counts traffic on the public interface. The value is given in terabytes.
    transfer: f64,
    /// The integer of number CPUs allocated to Droplets of this size.
    vcpus: s32
  }

  record list-snapshots-response {
    snapshots: option<list<list-snapshots-response-snapshots-item>>,
    links: option<list-snapshots-response-links>,
    meta: list-snapshots-response-meta
  }

  record list-snapshots-response-snapshots-item {
    /// The unique identifier for the snapshot or backup.
    id: s32,
    /// A time value given in ISO8601 combined date and time format that represents when the snapshot was created.
    created-at: string,
    /// The minimum size in GB required for a volume or Droplet to use this snapshot.
    min-disk-size: s32,
    /// A human-readable name for the snapshot.
    name: string,
    /// An array of the regions that the snapshot is available in. The regions are represented by their identifying slug values.
    regions: list<string>,
    /// The billable size of the snapshot in gigabytes.
    size-gigabytes: f64,
    /// Describes the kind of image. It may be one of `snapshot` or `backup`. This specifies whether an image is a user-generated Droplet snapshot or automatically created Droplet backup.
    type-op: list-backups-response-backups-item-type-op-enum
  }

  record list-snapshots-response-links {
    pages: option<string>
  }

  record list-snapshots-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record list-neighbors-ids-response {
    /// An array of arrays. Each array will contain a set of Droplet IDs for Droplets that share a physical server.
    neighbor-ids: option<list<list<s32>>>
  }

  variant list-op-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant create-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant destroy-by-tag-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant destroy-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-backups-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-associated-resources-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant destroy-with-associated-resources-dangerous-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant destroy-retry-with-associated-resources-error {
    unauthorized(string),
    not-found(string),
    conflict(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant destroy-with-associated-resources-selective-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-destroy-associated-resources-status-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-firewalls-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-kernels-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-neighbors-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-snapshots-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-neighbors-ids-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Droplets
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>,
    /// Used to filter Droplets by a specific tag. Can not be combined with `name`.
    tag-name: option<string>,
    /// Used to filter list response by Droplet name returning only exact matches. It is case-insensitive and can not be combined with `tag_name`.
    name: option<string>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Create a New Droplet
  record create-params {
    body: option<string>
  }
  create: func(params: create-params) -> result<string, create-error>;

  /// Deleting Droplets by Tag
  record destroy-by-tag-params {
    /// Specifies Droplets to be deleted by tag.
    tag-name: string
  }
  destroy-by-tag: func(params: destroy-by-tag-params) -> result<string, destroy-by-tag-error>;

  /// Retrieve an Existing Droplet
  record get-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Delete an Existing Droplet
  record destroy-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  destroy: func(params: destroy-params) -> result<string, destroy-error>;

  /// List Backups for a Droplet
  record list-backups-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-backups: func(params: list-backups-params) -> result<list-backups-response, list-backups-error>;

  /// List Associated Resources for a Droplet
  record list-associated-resources-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  list-associated-resources: func(params: list-associated-resources-params) -> result<list-associated-resources-response, list-associated-resources-error>;

  /// Destroy a Droplet and All of its Associated Resources (Dangerous)
  record destroy-with-associated-resources-dangerous-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Acknowledge this action will destroy the Droplet and all associated resources and _can not_ be reversed.
    x-dangerous: bool
  }
  destroy-with-associated-resources-dangerous: func(params: destroy-with-associated-resources-dangerous-params) -> result<string, destroy-with-associated-resources-dangerous-error>;

  /// Retry a Droplet Destroy with Associated Resources Request
  record destroy-retry-with-associated-resources-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  destroy-retry-with-associated-resources: func(params: destroy-retry-with-associated-resources-params) -> result<string, destroy-retry-with-associated-resources-error>;

  /// Selectively Destroy a Droplet and its Associated Resources
  record destroy-with-associated-resources-selective-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// An array of unique identifiers for the floating IPs to be scheduled for deletion.
    floating-ips: option<list<string>>,
    /// An array of unique identifiers for the reserved IPs to be scheduled for deletion.
    reserved-ips: option<list<string>>,
    /// An array of unique identifiers for the snapshots to be scheduled for deletion.
    snapshots: option<list<string>>,
    /// An array of unique identifiers for the volume snapshots to be scheduled for deletion.
    volume-snapshots: option<list<string>>,
    /// An array of unique identifiers for the volumes to be scheduled for deletion.
    volumes: option<list<string>>
  }
  destroy-with-associated-resources-selective: func(params: destroy-with-associated-resources-selective-params) -> result<string, destroy-with-associated-resources-selective-error>;

  /// Check Status of a Droplet Destroy with Associated Resources Request
  record get-destroy-associated-resources-status-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  get-destroy-associated-resources-status: func(params: get-destroy-associated-resources-status-params) -> result<get-destroy-associated-resources-status-response, get-destroy-associated-resources-status-error>;

  /// List all Firewalls Applied to a Droplet
  record list-firewalls-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-firewalls: func(params: list-firewalls-params) -> result<list-firewalls-response, list-firewalls-error>;

  /// List All Available Kernels for a Droplet
  record list-kernels-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-kernels: func(params: list-kernels-params) -> result<list-kernels-response, list-kernels-error>;

  /// List Neighbors for a Droplet
  record list-neighbors-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  list-neighbors: func(params: list-neighbors-params) -> result<list-neighbors-response, list-neighbors-error>;

  /// List Snapshots for a Droplet
  record list-snapshots-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-snapshots: func(params: list-snapshots-params) -> result<list-snapshots-response, list-snapshots-error>;

  /// List All Droplet Neighbors
  list-neighbors-ids: func() -> result<list-neighbors-ids-response, list-neighbors-ids-error>;

}

interface droplet-actions {
  enum post-by-tag-response-actions-item-status-enum {
    in-progress,
    completed,
    errored,
  }

  record post-by-tag-response {
    actions: option<list<post-by-tag-response-actions-item>>
  }

  record post-by-tag-response-actions-item {
    /// A time value given in ISO8601 combined date and time format that represents when the action was completed.
    completed-at: option<string>,
    /// A unique numeric ID that can be used to identify and reference an action.
    id: option<s32>,
    region: option<post-by-tag-response-actions-item-region>,
    region-slug: option<post-by-tag-response-actions-item-region-slug>,
    /// A unique identifier for the resource that the action is associated with.
    resource-id: option<s32>,
    /// The type of resource that the action is associated with.
    resource-type: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the action was initiated.
    started-at: option<string>,
    /// The current status of the action. This can be "in-progress", "completed", or "errored".
    status: option<post-by-tag-response-actions-item-status-enum>,
    /// This is the type of action that the object represents. For example, this could be "transfer" to represent the state of an image transfer action.
    type-op: option<string>
  }

  record post-by-tag-response-actions-item-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record post-by-tag-response-actions-item-region-slug {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record list-op-response {
    actions: option<list<list-op-response-actions-item>>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  record list-op-response-actions-item {
    /// A time value given in ISO8601 combined date and time format that represents when the action was completed.
    completed-at: option<string>,
    /// A unique numeric ID that can be used to identify and reference an action.
    id: option<s32>,
    region: option<list-op-response-actions-item-region>,
    region-slug: option<list-op-response-actions-item-region-slug>,
    /// A unique identifier for the resource that the action is associated with.
    resource-id: option<s32>,
    /// The type of resource that the action is associated with.
    resource-type: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the action was initiated.
    started-at: option<string>,
    /// The current status of the action. This can be "in-progress", "completed", or "errored".
    status: option<post-by-tag-response-actions-item-status-enum>,
    /// This is the type of action that the object represents. For example, this could be "transfer" to represent the state of an image transfer action.
    type-op: option<string>
  }

  record list-op-response-actions-item-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record list-op-response-actions-item-region-slug {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record list-op-response-links {
    pages: option<string>
  }

  record list-op-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record post-response {
    action: option<post-response-action>
  }

  record post-response-action {
    /// A time value given in ISO8601 combined date and time format that represents when the action was completed.
    completed-at: option<string>,
    /// A unique numeric ID that can be used to identify and reference an action.
    id: option<s32>,
    region: option<post-response-action-region>,
    region-slug: option<post-response-action-region-slug>,
    /// A unique identifier for the resource that the action is associated with.
    resource-id: option<s32>,
    /// The type of resource that the action is associated with.
    resource-type: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the action was initiated.
    started-at: option<string>,
    /// The current status of the action. This can be "in-progress", "completed", or "errored".
    status: option<post-by-tag-response-actions-item-status-enum>,
    /// This is the type of action that the object represents. For example, this could be "transfer" to represent the state of an image transfer action.
    type-op: option<string>
  }

  record post-response-action-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record post-response-action-region-slug {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record get-response {
    action: option<get-response-action>
  }

  record get-response-action {
    /// A time value given in ISO8601 combined date and time format that represents when the action was completed.
    completed-at: option<string>,
    /// A unique numeric ID that can be used to identify and reference an action.
    id: option<s32>,
    region: option<get-response-action-region>,
    region-slug: option<get-response-action-region-slug>,
    /// A unique identifier for the resource that the action is associated with.
    resource-id: option<s32>,
    /// The type of resource that the action is associated with.
    resource-type: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the action was initiated.
    started-at: option<string>,
    /// The current status of the action. This can be "in-progress", "completed", or "errored".
    status: option<post-by-tag-response-actions-item-status-enum>,
    /// This is the type of action that the object represents. For example, this could be "transfer" to represent the state of an image transfer action.
    type-op: option<string>
  }

  record get-response-action-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record get-response-action-region-slug {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-by-tag-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-op-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant post-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// Acting on Tagged Droplets
  record post-by-tag-params {
    /// Used to filter Droplets by a specific tag. Can not be combined with `name`.
    tag-name: option<string>,
    body: option<string>
  }
  post-by-tag: func(params: post-by-tag-params) -> result<post-by-tag-response, post-by-tag-error>;

  /// List Actions for a Droplet
  record list-op-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Initiate a Droplet Action
  record post-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    body: option<string>
  }
  post: func(params: post-params) -> result<post-response, post-error>;

  /// Retrieve a Droplet Action
  record get-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// A unique numeric ID that can be used to identify and reference an action.
    action-id: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

}

