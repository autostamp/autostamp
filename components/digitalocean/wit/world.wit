  /// Update a Project
  record update-params {
    /// A unique identifier for a project.
    project-id: string,
    body: string
  }
  update: func(params: update-params) -> result<update-response, update-error>;

  /// Patch a Project
  record patch-params {
    /// A unique identifier for a project.
    project-id: string,
    /// A time value given in ISO8601 combined date and time format that represents when the project was created.
    created-at: option<string>,
    /// The description of the project. The maximum length is 255 characters.
    description: option<string>,
    /// The environment of the project's resources.
    environment: option<list-op-response-projects-item-environment-enum>,
    /// The unique universal identifier of this project.
    id: option<string>,
    /// The human-readable name for the project. The maximum length is 175 characters and the name must be unique.
    name: option<string>,
    /// The integer id of the project owner.
    owner-id: option<s32>,
    /// The unique universal identifier of the project owner.
    owner-uuid: option<string>,
    /// The purpose of the project. The maximum length is 255 characters. It can
    /// have one of the following values:
    purpose: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the project was updated.
    updated-at: option<string>,
    /// If true, all resources will be added to this project if no project is specified.
    is-default: option<bool>
  }
  patch: func(params: patch-params) -> result<patch-response, patch-error>;

  /// Delete an Existing Project
  record delete-params {
    /// A unique identifier for a project.
    project-id: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

}

