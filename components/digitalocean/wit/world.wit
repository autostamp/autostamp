    region: option<floating-i-ps-action-get-response-action-region>,
    region-slug: option<floating-i-ps-action-get-response-action-region-slug>,
    /// A unique identifier for the resource that the action is associated with.
    resource-id: option<s32>,
    /// The type of resource that the action is associated with.
    resource-type: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the action was initiated.
    started-at: option<string>,
    /// The current status of the action. This can be "in-progress", "completed", or "errored".
    status: option<floating-i-ps-action-list-response-actions-item-status-enum>,
    /// This is the type of action that the object represents. For example, this could be "transfer" to represent the state of an image transfer action.
    type-op: option<string>,
    /// The UUID of the project to which the reserved IP currently belongs.
    project-id: option<string>
  }

  record floating-i-ps-action-get-response-action-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record floating-i-ps-action-get-response-action-region-slug {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant floating-i-ps-action-list-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant floating-i-ps-action-post-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant floating-i-ps-action-get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Actions for a Floating IP
  record floating-i-ps-action-list-params {
    /// A floating IP address.
    floating-ip: string
  }
  floating-i-ps-action-list: func(params: floating-i-ps-action-list-params) -> result<floating-i-ps-action-list-response, floating-i-ps-action-list-error>;

  /// Initiate a Floating IP Action
  record floating-i-ps-action-post-params {
    /// A floating IP address.
    floating-ip: string,
    body: option<string>
  }
  floating-i-ps-action-post: func(params: floating-i-ps-action-post-params) -> result<floating-i-ps-action-post-response, floating-i-ps-action-post-error>;

  /// Retrieve an Existing Floating IP Action
  record floating-i-ps-action-get-params {
    /// A floating IP address.
    floating-ip: string,
    /// A unique numeric ID that can be used to identify and reference an action.
    action-id: string
  }
  floating-i-ps-action-get: func(params: floating-i-ps-action-get-params) -> result<floating-i-ps-action-get-response, floating-i-ps-action-get-error>;

}

interface functions {
  record list-namespaces-response {
    namespaces: option<list<list-namespaces-response-namespaces-item>>
  }

  record list-namespaces-response-namespaces-item {
    /// The namespace's API hostname. Each function in a namespace is provided an endpoint at the namespace's hostname.
    api-host: option<string>,
    /// UTC time string.
    created-at: option<string>,
    /// A random alpha numeric string. This key is used in conjunction with the namespace's UUID to authenticate 
    /// a user to use the namespace via `doctl`, DigitalOcean's official CLI.
    key: option<string>,
    /// The namespace's unique name.
    label: option<string>,
    /// A unique string format of UUID with a prefix fn-.
    namespace: option<string>,
    /// The namespace's datacenter region.
    region: option<string>,
    /// UTC time string.
    updated-at: option<string>,
    /// The namespace's Universally Unique Identifier.
    uuid: option<string>
  }

  record create-namespace-response {
    namespace: option<create-namespace-response-namespace>
  }

  record create-namespace-response-namespace {
    /// The namespace's API hostname. Each function in a namespace is provided an endpoint at the namespace's hostname.
    api-host: option<string>,
    /// UTC time string.
    created-at: option<string>,
    /// A random alpha numeric string. This key is used in conjunction with the namespace's UUID to authenticate 
    /// a user to use the namespace via `doctl`, DigitalOcean's official CLI.
    key: option<string>,
    /// The namespace's unique name.
    label: option<string>,
    /// A unique string format of UUID with a prefix fn-.
    namespace: option<string>,
    /// The namespace's datacenter region.
    region: option<string>,
    /// UTC time string.
    updated-at: option<string>,
    /// The namespace's Universally Unique Identifier.
    uuid: option<string>
  }

  record get-namespace-response {
    namespace: option<get-namespace-response-namespace>
  }

  record get-namespace-response-namespace {
    /// The namespace's API hostname. Each function in a namespace is provided an endpoint at the namespace's hostname.
    api-host: option<string>,
    /// UTC time string.
    created-at: option<string>,
    /// A random alpha numeric string. This key is used in conjunction with the namespace's UUID to authenticate 
    /// a user to use the namespace via `doctl`, DigitalOcean's official CLI.
    key: option<string>,
    /// The namespace's unique name.
    label: option<string>,
    /// A unique string format of UUID with a prefix fn-.
    namespace: option<string>,
    /// The namespace's datacenter region.
    region: option<string>,
    /// UTC time string.
    updated-at: option<string>,
    /// The namespace's Universally Unique Identifier.
    uuid: option<string>
  }

  record list-triggers-response {
    triggers: option<list<list-triggers-response-triggers-item>>
  }

  record list-triggers-response-triggers-item {
    /// UTC time string.
    created-at: option<string>,
    /// Name of function(action) that exists in the given namespace.
    function: option<string>,
    /// Indicates weather the trigger is paused or unpaused.
    is-enabled: option<bool>,
    /// The trigger's unique name within the namespace.
    name: option<string>,
    /// A unique string format of UUID with a prefix fn-.
    namespace: option<string>,
    /// Trigger details for SCHEDULED type, where body is optional.
    scheduled-details: option<list-triggers-response-triggers-item-scheduled-details>,
    scheduled-runs: option<list-triggers-response-triggers-item-scheduled-runs>,
    /// String which indicates the type of trigger source like SCHEDULED.
    type-op: option<string>,
    /// UTC time string.
    updated-at: option<string>
  }

  /// Trigger details for SCHEDULED type, where body is optional.
  record list-triggers-response-triggers-item-scheduled-details {
    /// Optional data to be sent to function while triggering the function.
    body: option<list-triggers-response-triggers-item-scheduled-details-body>,
    /// valid cron expression string which is required for SCHEDULED type triggers.
    cron: string
  }

  /// Optional data to be sent to function while triggering the function.
  record list-triggers-response-triggers-item-scheduled-details-body {
    name: option<string>
  }

  record list-triggers-response-triggers-item-scheduled-runs {
    /// Indicates last run time. null value indicates trigger not run yet.
    last-run-at: option<string>,
    /// Indicates next run time. null value indicates trigger will not run.
    next-run-at: option<string>
  }

  /// Trigger details for SCHEDULED type, where body is optional.
  record create-trigger-body-scheduled-details {
    /// Optional data to be sent to function while triggering the function.
    body: option<create-trigger-body-scheduled-details-body>,
    /// valid cron expression string which is required for SCHEDULED type triggers.
    cron: string
  }

  /// Optional data to be sent to function while triggering the function.
  record create-trigger-body-scheduled-details-body {
    name: option<string>
  }

  record create-trigger-response {
    trigger: option<create-trigger-response-trigger>
  }

  record create-trigger-response-trigger {
    /// UTC time string.
    created-at: option<string>,
    /// Name of function(action) that exists in the given namespace.
    function: option<string>,
    /// Indicates weather the trigger is paused or unpaused.
    is-enabled: option<bool>,
    /// The trigger's unique name within the namespace.
    name: option<string>,
    /// A unique string format of UUID with a prefix fn-.
    namespace: option<string>,
    /// Trigger details for SCHEDULED type, where body is optional.
    scheduled-details: option<create-trigger-response-trigger-scheduled-details>,
    scheduled-runs: option<create-trigger-response-trigger-scheduled-runs>,
    /// String which indicates the type of trigger source like SCHEDULED.
    type-op: option<string>,
    /// UTC time string.
    updated-at: option<string>
  }

  /// Trigger details for SCHEDULED type, where body is optional.
  record create-trigger-response-trigger-scheduled-details {
    /// Optional data to be sent to function while triggering the function.
    body: option<create-trigger-response-trigger-scheduled-details-body>,
    /// valid cron expression string which is required for SCHEDULED type triggers.
    cron: string
  }

  /// Optional data to be sent to function while triggering the function.
  record create-trigger-response-trigger-scheduled-details-body {
    name: option<string>
  }

  record create-trigger-response-trigger-scheduled-runs {
    /// Indicates last run time. null value indicates trigger not run yet.
    last-run-at: option<string>,
    /// Indicates next run time. null value indicates trigger will not run.
    next-run-at: option<string>
  }

  record get-trigger-response {
    trigger: option<get-trigger-response-trigger>
  }

  record get-trigger-response-trigger {
    /// UTC time string.
    created-at: option<string>,
    /// Name of function(action) that exists in the given namespace.
    function: option<string>,
    /// Indicates weather the trigger is paused or unpaused.
    is-enabled: option<bool>,
    /// The trigger's unique name within the namespace.
    name: option<string>,
    /// A unique string format of UUID with a prefix fn-.
    namespace: option<string>,
    /// Trigger details for SCHEDULED type, where body is optional.
    scheduled-details: option<get-trigger-response-trigger-scheduled-details>,
    scheduled-runs: option<get-trigger-response-trigger-scheduled-runs>,
    /// String which indicates the type of trigger source like SCHEDULED.
    type-op: option<string>,
    /// UTC time string.
    updated-at: option<string>
  }

  /// Trigger details for SCHEDULED type, where body is optional.
  record get-trigger-response-trigger-scheduled-details {
    /// Optional data to be sent to function while triggering the function.
    body: option<get-trigger-response-trigger-scheduled-details-body>,
    /// valid cron expression string which is required for SCHEDULED type triggers.
    cron: string
  }

  /// Optional data to be sent to function while triggering the function.
  record get-trigger-response-trigger-scheduled-details-body {
    name: option<string>
  }

  record get-trigger-response-trigger-scheduled-runs {
    /// Indicates last run time. null value indicates trigger not run yet.
    last-run-at: option<string>,
    /// Indicates next run time. null value indicates trigger will not run.
    next-run-at: option<string>
  }

  /// Trigger details for SCHEDULED type, where body is optional.
  record update-trigger-body-scheduled-details {
    /// Optional data to be sent to function while triggering the function.
    body: option<update-trigger-body-scheduled-details-body>,
    /// valid cron expression string which is required for SCHEDULED type triggers.
    cron: string
  }

  /// Optional data to be sent to function while triggering the function.
  record update-trigger-body-scheduled-details-body {
    name: option<string>
  }

  record update-trigger-response {
    trigger: option<update-trigger-response-trigger>
  }

  record update-trigger-response-trigger {
    /// UTC time string.
    created-at: option<string>,
    /// Name of function(action) that exists in the given namespace.
    function: option<string>,
    /// Indicates weather the trigger is paused or unpaused.
    is-enabled: option<bool>,
    /// The trigger's unique name within the namespace.
    name: option<string>,
    /// A unique string format of UUID with a prefix fn-.
    namespace: option<string>,
    /// Trigger details for SCHEDULED type, where body is optional.
    scheduled-details: option<update-trigger-response-trigger-scheduled-details>,
    scheduled-runs: option<update-trigger-response-trigger-scheduled-runs>,
    /// String which indicates the type of trigger source like SCHEDULED.
    type-op: option<string>,
    /// UTC time string.
    updated-at: option<string>
  }

  /// Trigger details for SCHEDULED type, where body is optional.
  record update-trigger-response-trigger-scheduled-details {
    /// Optional data to be sent to function while triggering the function.
    body: option<update-trigger-response-trigger-scheduled-details-body>,
    /// valid cron expression string which is required for SCHEDULED type triggers.
    cron: string
  }

  /// Optional data to be sent to function while triggering the function.
  record update-trigger-response-trigger-scheduled-details-body {
    name: option<string>
  }

  record update-trigger-response-trigger-scheduled-runs {
    /// Indicates last run time. null value indicates trigger not run yet.
    last-run-at: option<string>,
    /// Indicates next run time. null value indicates trigger will not run.
    next-run-at: option<string>
  }

  variant list-namespaces-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant create-namespace-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-namespace-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-namespace-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant list-triggers-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant create-trigger-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-trigger-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant update-trigger-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-trigger-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List Namespaces
  list-namespaces: func() -> result<list-namespaces-response, list-namespaces-error>;

  /// Create Namespace
  record create-namespace-params {
    /// The namespace's unique name.
    label: string,
    /// The [datacenter region](https://docs.digitalocean.com/products/platform/availability-matrix/#available-datacenters) in which to create the namespace.
    region: string
  }
  create-namespace: func(params: create-namespace-params) -> result<create-namespace-response, create-namespace-error>;

  /// Get Namespace
  record get-namespace-params {
    /// The ID of the namespace to be managed.
    namespace-id: string
  }
  get-namespace: func(params: get-namespace-params) -> result<get-namespace-response, get-namespace-error>;

  /// Delete Namespace
  record delete-namespace-params {
    /// The ID of the namespace to be managed.
    namespace-id: string
  }
  delete-namespace: func(params: delete-namespace-params) -> result<string, delete-namespace-error>;

  /// List Triggers
  record list-triggers-params {
    /// The ID of the namespace to be managed.
    namespace-id: string
  }
  list-triggers: func(params: list-triggers-params) -> result<list-triggers-response, list-triggers-error>;

  /// Create Trigger
  record create-trigger-params {
    /// The ID of the namespace to be managed.
    namespace-id: string,
    /// Name of function(action) that exists in the given namespace.
    function: string,
    /// Indicates weather the trigger is paused or unpaused.
    is-enabled: bool,
    /// The trigger's unique name within the namespace.
    name: string,
    /// Trigger details for SCHEDULED type, where body is optional.
    scheduled-details: create-trigger-body-scheduled-details,
    /// One of different type of triggers. Currently only SCHEDULED is supported.
    type-op: string
  }
  create-trigger: func(params: create-trigger-params) -> result<create-trigger-response, create-trigger-error>;

  /// Get Trigger
  record get-trigger-params {
    /// The ID of the namespace to be managed.
    namespace-id: string,
    /// The name of the trigger to be managed.
    trigger-name: string
  }
  get-trigger: func(params: get-trigger-params) -> result<get-trigger-response, get-trigger-error>;

  /// Update Trigger
  record update-trigger-params {
    /// The ID of the namespace to be managed.
    namespace-id: string,
    /// The name of the trigger to be managed.
    trigger-name: string,
    /// Indicates weather the trigger is paused or unpaused.
    is-enabled: option<bool>,
    /// Trigger details for SCHEDULED type, where body is optional.
    scheduled-details: option<update-trigger-body-scheduled-details>
  }
  update-trigger: func(params: update-trigger-params) -> result<update-trigger-response, update-trigger-error>;

  /// Delete Trigger
  record delete-trigger-params {
    /// The ID of the namespace to be managed.
    namespace-id: string,
    /// The name of the trigger to be managed.
    trigger-name: string
  }
  delete-trigger: func(params: delete-trigger-params) -> result<string, delete-trigger-error>;

}

interface images {
  enum list-op-type-op-enum {
    application,
    distribution,
  }

  enum list-op-response-images-item-distribution-enum {
    arch-linux,
    cent-os,
    core-os,
    debian,
    fedora,
    fedora-atomic,
    free-bsd,
    gentoo,
    open-suse,
    rancher-os,
    rocky-linux,
    ubuntu,
    unknown,
  }

  enum list-op-response-images-item-regions-item-enum {
    ams1,
    ams2,
    ams3,
    blr1,
    fra1,
    lon1,
    nyc1,
    nyc2,
    nyc3,
    sfo1,
    sfo2,
    sfo3,
    sgp1,
    tor1,
  }

  enum list-op-response-images-item-status-enum {
    new,
    available,
    pending,
    deleted,
    retired,
  }

  enum list-op-response-images-item-type-op-enum {
    base,
    snapshot,
    backup,
    custom,
    admin,
  }

  record list-op-response {
    images: list<list-op-response-images-item>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  record list-op-response-images-item {
    /// A time value given in ISO8601 combined date and time format that represents when the image was created.
    created-at: option<string>,
    /// An optional free-form text field to describe an image.
    description: option<string>,
    /// The name of a custom image's distribution. Currently, the valid values are  `Arch Linux`, `CentOS`, `CoreOS`, `Debian`, `Fedora`, `Fedora Atomic`,  `FreeBSD`, `Gentoo`, `openSUSE`, `RancherOS`, `Rocky Linux`, `Ubuntu`, and `Unknown`.  Any other value will be accepted but ignored, and `Unknown` will be used in its place.
    distribution: option<list-op-response-images-item-distribution-enum>,
    /// A string containing information about errors that may occur when importing
    ///  a custom image.
    error-message: option<string>,
    /// A unique number that can be used to identify and reference a specific image.
    id: option<s32>,
    /// The minimum disk size in GB required for a Droplet to use this image.
    min-disk-size: option<s32>,
    /// The display name that has been given to an image.  This is what is shown in the control panel and is generally a descriptive title for the image in question.
    name: option<string>,
    /// This is a boolean value that indicates whether the image in question is public or not. An image that is public is available to all accounts. A non-public image is only accessible from your account.
    public: option<bool>,
    /// This attribute is an array of the regions that the image is available in. The regions are represented by their identifying slug values.
    regions: option<list<list-op-response-images-item-regions-item-enum>>,
    /// The size of the image in gigabytes.
    size-gigabytes: option<f64>,
    /// A uniquely identifying string that is associated with each of the DigitalOcean-provided public images. These can be used to reference a public image as an alternative to the numeric id.
    slug: option<string>,
    /// A status string indicating the state of a custom image. This may be `NEW`,
    ///  `available`, `pending`, `deleted`, or `retired`.
    status: option<list-op-response-images-item-status-enum>,
    /// A flat array of tag names as strings to be applied to the resource. Tag names may be for either existing or new tags.
    tags: option<list<string>>,
    /// Describes the kind of image. It may be one of `base`, `snapshot`, `backup`, `custom`, or `admin`. Respectively, this specifies whether an image is a DigitalOcean base OS image, user-generated Droplet snapshot, automatically created Droplet backup, user-provided virtual machine image, or an image used for DigitalOcean managed resources (e.g. DOKS worker nodes).
    type-op: option<list-op-response-images-item-type-op-enum>
  }

  record list-op-response-links {
    pages: option<string>
  }

  record list-op-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record create-custom-response {
    image: option<create-custom-response-image>
  }

  record create-custom-response-image {
    /// A time value given in ISO8601 combined date and time format that represents when the image was created.
    created-at: option<string>,
    /// An optional free-form text field to describe an image.
    description: option<string>,
    /// The name of a custom image's distribution. Currently, the valid values are  `Arch Linux`, `CentOS`, `CoreOS`, `Debian`, `Fedora`, `Fedora Atomic`,  `FreeBSD`, `Gentoo`, `openSUSE`, `RancherOS`, `Rocky Linux`, `Ubuntu`, and `Unknown`.  Any other value will be accepted but ignored, and `Unknown` will be used in its place.
    distribution: option<list-op-response-images-item-distribution-enum>,
    /// A string containing information about errors that may occur when importing
    ///  a custom image.
    error-message: option<string>,
    /// A unique number that can be used to identify and reference a specific image.
    id: option<s32>,
    /// The minimum disk size in GB required for a Droplet to use this image.
    min-disk-size: option<s32>,
    /// The display name that has been given to an image.  This is what is shown in the control panel and is generally a descriptive title for the image in question.
    name: option<string>,
    /// This is a boolean value that indicates whether the image in question is public or not. An image that is public is available to all accounts. A non-public image is only accessible from your account.
    public: option<bool>,
    /// This attribute is an array of the regions that the image is available in. The regions are represented by their identifying slug values.
    regions: option<list<list-op-response-images-item-regions-item-enum>>,
    /// The size of the image in gigabytes.
    size-gigabytes: option<f64>,
    /// A uniquely identifying string that is associated with each of the DigitalOcean-provided public images. These can be used to reference a public image as an alternative to the numeric id.
    slug: option<string>,
    /// A status string indicating the state of a custom image. This may be `NEW`,
    ///  `available`, `pending`, `deleted`, or `retired`.
    status: option<list-op-response-images-item-status-enum>,
    /// A flat array of tag names as strings to be applied to the resource. Tag names may be for either existing or new tags.
    tags: option<list<string>>,
    /// Describes the kind of image. It may be one of `base`, `snapshot`, `backup`, `custom`, or `admin`. Respectively, this specifies whether an image is a DigitalOcean base OS image, user-generated Droplet snapshot, automatically created Droplet backup, user-provided virtual machine image, or an image used for DigitalOcean managed resources (e.g. DOKS worker nodes).
    type-op: option<list-op-response-images-item-type-op-enum>
  }

  record get-response {
    image: get-response-image
  }

  record get-response-image {
    /// A time value given in ISO8601 combined date and time format that represents when the image was created.
    created-at: option<string>,
    /// An optional free-form text field to describe an image.
    description: option<string>,
    /// The name of a custom image's distribution. Currently, the valid values are  `Arch Linux`, `CentOS`, `CoreOS`, `Debian`, `Fedora`, `Fedora Atomic`,  `FreeBSD`, `Gentoo`, `openSUSE`, `RancherOS`, `Rocky Linux`, `Ubuntu`, and `Unknown`.  Any other value will be accepted but ignored, and `Unknown` will be used in its place.
    distribution: option<list-op-response-images-item-distribution-enum>,
    /// A string containing information about errors that may occur when importing
    ///  a custom image.
    error-message: option<string>,
    /// A unique number that can be used to identify and reference a specific image.
    id: option<s32>,
    /// The minimum disk size in GB required for a Droplet to use this image.
    min-disk-size: option<s32>,
    /// The display name that has been given to an image.  This is what is shown in the control panel and is generally a descriptive title for the image in question.
    name: option<string>,
