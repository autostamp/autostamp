  /// List All Kubernetes Clusters
  record list-clusters-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-clusters: func(params: list-clusters-params) -> result<list-clusters-response, list-clusters-error>;

  /// Create a New Kubernetes Cluster
  record create-cluster-params {
    /// A boolean value indicating whether the cluster will be automatically upgraded to new patch releases during its maintenance window.
    auto-upgrade: option<bool>,
    /// The range of IP addresses in the overlay network of the Kubernetes cluster in CIDR notation.
    cluster-subnet: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the Kubernetes cluster was created.
    created-at: option<string>,
    /// The base URL of the API server on the Kubernetes master node.
    endpoint: option<string>,
    /// A boolean value indicating whether the control plane is run in a highly available configuration in the cluster. Highly available control planes incur less downtime. The property cannot be disabled.
    ha: option<bool>,
    /// A unique ID that can be used to identify and reference a Kubernetes cluster.
    id: option<string>,
    /// The public IPv4 address of the Kubernetes master node. This will not be set if high availability is configured on the cluster (v1.21+)
    ipv4: option<string>,
    /// An object specifying the maintenance window policy for the Kubernetes cluster.
    maintenance-policy: option<create-cluster-body-maintenance-policy>,
    /// A human-readable name for a Kubernetes cluster.
    name: string,
    /// An object specifying the details of the worker nodes available to the Kubernetes cluster.
    node-pools: list<string>,
    /// The slug identifier for the region where the Kubernetes cluster is located.
    region: string,
    /// A read-only boolean value indicating if a container registry is integrated with the cluster.
    registry-enabled: option<bool>,
    /// The range of assignable IP addresses for services running in the Kubernetes cluster in CIDR notation.
    service-subnet: option<string>,
    /// An object containing a `state` attribute whose value is set to a string indicating the current status of the cluster.
    status: option<create-cluster-body-status>,
    /// A boolean value indicating whether surge upgrade is enabled/disabled for the cluster. Surge upgrade makes cluster upgrades fast and reliable by bringing up new nodes before destroying the outdated nodes.
    surge-upgrade: option<bool>,
    /// An array of tags applied to the Kubernetes cluster. All clusters are automatically tagged `k8s` and `k8s:$K8S_CLUSTER_ID`.
    tags: option<list<string>>,
    /// A time value given in ISO8601 combined date and time format that represents when the Kubernetes cluster was last updated.
    updated-at: option<string>,
    /// The slug identifier for the version of Kubernetes used for the cluster. If set to a minor version (e.g. "1.14"), the latest version within it will be used (e.g. "1.14.6-do.1"); if set to "latest", the latest published version will be used. See the `/v2/kubernetes/options` endpoint to find all currently available versions.
    version: string,
    /// A string specifying the UUID of the VPC to which the Kubernetes cluster is assigned.
    vpc-uuid: option<string>
  }
  create-cluster: func(params: create-cluster-params) -> result<create-cluster-response, create-cluster-error>;

  /// Retrieve an Existing Kubernetes Cluster
  record get-cluster-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  get-cluster: func(params: get-cluster-params) -> result<get-cluster-response, get-cluster-error>;

  /// Update a Kubernetes Cluster
  record update-cluster-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A boolean value indicating whether the cluster will be automatically upgraded to new patch releases during its maintenance window.
    auto-upgrade: option<bool>,
    /// A boolean value indicating whether the control plane is run in a highly available configuration in the cluster. Highly available control planes incur less downtime. The property cannot be disabled.
    ha: option<bool>,
    /// An object specifying the maintenance window policy for the Kubernetes cluster.
    maintenance-policy: option<update-cluster-body-maintenance-policy>,
    /// A human-readable name for a Kubernetes cluster.
    name: string,
    /// A boolean value indicating whether surge upgrade is enabled/disabled for the cluster. Surge upgrade makes cluster upgrades fast and reliable by bringing up new nodes before destroying the outdated nodes.
    surge-upgrade: option<bool>,
    /// An array of tags applied to the Kubernetes cluster. All clusters are automatically tagged `k8s` and `k8s:$K8S_CLUSTER_ID`.
    tags: option<list<string>>
  }
  update-cluster: func(params: update-cluster-params) -> result<update-cluster-response, update-cluster-error>;

  /// Delete a Kubernetes Cluster
  record delete-cluster-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  delete-cluster: func(params: delete-cluster-params) -> result<string, delete-cluster-error>;

  /// Fetch Clusterlint Diagnostics for a Kubernetes Cluster
  record get-cluster-lint-results-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// Specifies the clusterlint run whose results will be retrieved.
    run-id: option<string>
  }
  get-cluster-lint-results: func(params: get-cluster-lint-results-params) -> result<get-cluster-lint-results-response, get-cluster-lint-results-error>;

  /// Run Clusterlint Checks on a Kubernetes Cluster
  record run-cluster-lint-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// An array of checks that will be run when clusterlint executes checks.
    exclude-checks: option<list<string>>,
    /// An array of check groups that will be omitted when clusterlint executes checks.
    exclude-groups: option<list<string>>,
    /// An array of checks that will be run when clusterlint executes checks.
    include-checks: option<list<string>>,
    /// An array of check groups that will be run when clusterlint executes checks.
    include-groups: option<list<string>>
  }
  run-cluster-lint: func(params: run-cluster-lint-params) -> result<run-cluster-lint-response, run-cluster-lint-error>;

  /// Retrieve Credentials for a Kubernetes Cluster
  record get-credentials-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// The duration in seconds that the returned Kubernetes credentials will be valid. If not set or 0, the credentials will have a 7 day expiry.
    expiry-seconds: option<s32>
  }
  get-credentials: func(params: get-credentials-params) -> result<get-credentials-response, get-credentials-error>;

  /// List Associated Resources for Cluster Deletion
  record list-associated-resources-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  list-associated-resources: func(params: list-associated-resources-params) -> result<list-associated-resources-response, list-associated-resources-error>;

  /// Delete a Cluster and All of its Associated Resources (Dangerous)
  record destroy-associated-resources-dangerous-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  destroy-associated-resources-dangerous: func(params: destroy-associated-resources-dangerous-params) -> result<string, destroy-associated-resources-dangerous-error>;

  /// Selectively Delete a Cluster and its Associated Resources
  record destroy-associated-resources-selective-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A list of IDs for associated load balancers to destroy along with the cluster.
    load-balancers: option<list<string>>,
    /// A list of IDs for associated volume snapshots to destroy along with the cluster.
    volume-snapshots: option<list<string>>,
    /// A list of IDs for associated volumes to destroy along with the cluster.
    volumes: option<list<string>>
  }
  destroy-associated-resources-selective: func(params: destroy-associated-resources-selective-params) -> result<string, destroy-associated-resources-selective-error>;

  /// Retrieve the kubeconfig for a Kubernetes Cluster
  record get-kubeconfig-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// The duration in seconds that the returned Kubernetes credentials will be valid. If not set or 0, the credentials will have a 7 day expiry.
    expiry-seconds: option<s32>
  }
  get-kubeconfig: func(params: get-kubeconfig-params) -> result<string, get-kubeconfig-error>;

  /// List All Node Pools in a Kubernetes Clusters
  record list-node-pools-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  list-node-pools: func(params: list-node-pools-params) -> result<list-node-pools-response, list-node-pools-error>;

  /// Add a Node Pool to a Kubernetes Cluster
  record add-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    body: string
  }
  add-node-pool: func(params: add-node-pool-params) -> result<add-node-pool-response, add-node-pool-error>;

  /// Retrieve a Node Pool for a Kubernetes Cluster
  record get-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string
  }
  get-node-pool: func(params: get-node-pool-params) -> result<get-node-pool-response, get-node-pool-error>;

  /// Update a Node Pool in a Kubernetes Cluster
  record update-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string,
    body: string
  }
  update-node-pool: func(params: update-node-pool-params) -> result<update-node-pool-response, update-node-pool-error>;

  /// Delete a Node Pool in a Kubernetes Cluster
  record delete-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string
  }
  delete-node-pool: func(params: delete-node-pool-params) -> result<string, delete-node-pool-error>;

  /// Delete a Node in a Kubernetes Cluster
  record delete-node-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string,
    /// A unique ID that can be used to reference a node in a Kubernetes node pool.
    node-id: string,
    /// Specifies whether or not to drain workloads from a node before it is deleted. Setting it to `1` causes node draining to be skipped. Omitting the query parameter or setting its value to `0` carries out draining prior to deletion.
    skip-drain: option<s32>,
    /// Specifies whether or not to replace a node after it has been deleted. Setting it to `1` causes the node to be replaced by a new one after deletion. Omitting the query parameter or setting its value to `0` deletes without replacement.
    replace: option<s32>
  }
  delete-node: func(params: delete-node-params) -> result<string, delete-node-error>;

  /// Recycle a Kubernetes Node Pool
  record recycle-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string,
    nodes: option<list<string>>
  }
  recycle-node-pool: func(params: recycle-node-pool-params) -> result<string, recycle-node-pool-error>;

  /// Upgrade a Kubernetes Cluster
  record upgrade-cluster-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// The slug identifier for the version of Kubernetes that the cluster will be upgraded to.
    version: option<string>
  }
  upgrade-cluster: func(params: upgrade-cluster-params) -> result<string, upgrade-cluster-error>;

  /// Retrieve Available Upgrades for an Existing Kubernetes Cluster
  record get-available-upgrades-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  get-available-upgrades: func(params: get-available-upgrades-params) -> result<get-available-upgrades-response, get-available-upgrades-error>;

  /// Retrieve User Information for a Kubernetes Cluster
  record get-cluster-user-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  get-cluster-user: func(params: get-cluster-user-params) -> result<get-cluster-user-response, get-cluster-user-error>;

  /// List Available Regions, Node Sizes, and Versions of Kubernetes
  list-options: func() -> result<list-options-response, list-options-error>;

  /// Add Container Registry to Kubernetes Clusters
  record add-registry-params {
    /// An array containing the UUIDs of Kubernetes clusters.
    cluster-uuids: option<list<string>>
  }
  add-registry: func(params: add-registry-params) -> result<string, add-registry-error>;

  /// Remove Container Registry from Kubernetes Clusters
  record remove-registry-params {
    /// An array containing the UUIDs of Kubernetes clusters.
    cluster-uuids: option<list<string>>
  }
  remove-registry: func(params: remove-registry-params) -> result<string, remove-registry-error>;

}

interface load-balancers {
  enum list-op-response-load-balancers-item-algorithm-enum {
    round-robin,
    least-connections,
  }

  enum list-op-response-load-balancers-item-forwarding-rules-item-entry-protocol-enum {
    http,
    https,
    http2,
    http3,
    tcp,
    udp,
  }

  enum list-op-response-load-balancers-item-forwarding-rules-item-target-protocol-enum {
    http,
    https,
    http2,
    tcp,
    udp,
  }

  enum list-op-response-load-balancers-item-health-check-protocol-enum {
    http,
    https,
    tcp,
  }

  enum list-op-response-load-balancers-item-size-enum {
    lb-small,
    lb-medium,
    lb-large,
  }

  enum list-op-response-load-balancers-item-status-enum {
    new,
    active,
    errored,
  }

  enum list-op-response-load-balancers-item-sticky-sessions-type-op-enum {
    cookies,
    none,
  }

  record list-op-response {
    load-balancers: option<list<list-op-response-load-balancers-item>>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  record list-op-response-load-balancers-item {
    /// This field has been deprecated. You can no longer specify an algorithm for load balancers.
    algorithm: option<list-op-response-load-balancers-item-algorithm-enum>,
    /// A time value given in ISO8601 combined date and time format that represents when the load balancer was created.
    created-at: option<string>,
    /// A boolean value indicating whether to disable automatic DNS record creation for Let's Encrypt certificates that are added to the load balancer.
    disable-lets-encrypt-dns-records: option<bool>,
    /// A boolean value indicating whether HTTP keepalive connections are maintained to target Droplets.
    enable-backend-keepalive: option<bool>,
    /// A boolean value indicating whether PROXY Protocol is in use.
    enable-proxy-protocol: option<bool>,
    /// An object specifying allow and deny rules to control traffic to the load balancer.
    firewall: option<list-op-response-load-balancers-item-firewall>,
    /// An array of objects specifying the forwarding rules for a load balancer.
    forwarding-rules: list<list-op-response-load-balancers-item-forwarding-rules-item>,
    /// An object specifying health check settings for the load balancer.
    health-check: option<list-op-response-load-balancers-item-health-check>,
    /// An integer value which configures the idle timeout for HTTP requests to the target droplets.
    http-idle-timeout-seconds: option<s32>,
    /// A unique ID that can be used to identify and reference a load balancer.
    id: option<string>,
    /// An attribute containing the public-facing IP address of the load balancer.
    ip: option<string>,
    /// A human-readable name for a load balancer instance.
    name: option<string>,
    /// The ID of the project that the load balancer is associated with. If no ID is provided at creation, the load balancer associates with the user's default project. If an invalid project ID is provided, the load balancer will not be created.
    project-id: option<string>,
    /// A boolean value indicating whether HTTP requests to the load balancer on port 80 will be redirected to HTTPS on port 443.
    redirect-http-to-https: option<bool>,
    /// This field has been replaced by the `size_unit` field for all regions except in AMS2, NYC2, and SFO1. Each available load balancer size now equates to the load balancer having a set number of nodes.
    /// * `lb-small` = 1 node
    size: option<list-op-response-load-balancers-item-size-enum>,
    /// How many nodes the load balancer contains. Each additional node increases the load balancer's ability to manage more connections. Load balancers can be scaled up or down, and you can change the number of nodes after creation up to once per hour. This field is currently not available in the AMS2, NYC2, or SFO1 regions. Use the `size` field to scale load balancers that reside in these regions.
    size-unit: option<s32>,
    /// A status string indicating the current state of the load balancer. This can be `new`, `active`, or `errored`.
    status: option<list-op-response-load-balancers-item-status-enum>,
    /// An object specifying sticky sessions settings for the load balancer.
    sticky-sessions: option<list-op-response-load-balancers-item-sticky-sessions>,
    /// A string specifying the UUID of the VPC to which the load balancer is assigned.
    vpc-uuid: option<string>,
    region: option<string>,
    /// An array containing the IDs of the Droplets assigned to the load balancer.
    droplet-ids: option<list<s32>>,
    /// The name of a Droplet tag corresponding to Droplets assigned to the load balancer.
    tag: option<string>
  }

  /// An object specifying allow and deny rules to control traffic to the load balancer.
  record list-op-response-load-balancers-item-firewall {
    /// the rules for allowing traffic to the load balancer (in the form 'ip:1.2.3.4' or 'cidr:1.2.0.0/16')
    allow: option<list<string>>,
    /// the rules for denying traffic to the load balancer (in the form 'ip:1.2.3.4' or 'cidr:1.2.0.0/16')
    deny: option<list<string>>
  }

  /// An object specifying a forwarding rule for a load balancer.
  record list-op-response-load-balancers-item-forwarding-rules-item {
    /// The ID of the TLS certificate used for SSL termination if enabled.
    certificate-id: option<string>,
    /// An integer representing the port on which the load balancer instance will listen.
