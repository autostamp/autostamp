    /// An array of objects, each indicating the version end-of-life, end-of-availability for various database engines
    mysql: option<list<list-options-response-version-availability-mysql-item>>,
    /// An array of objects, each indicating the version end-of-life, end-of-availability for various database engines
    pg: option<list<list-options-response-version-availability-pg-item>>,
    /// An array of objects, each indicating the version end-of-life, end-of-availability for various database engines
