    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Snapshots
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>,
    /// Used to filter snapshots by a resource type.
    resource-type: option<list-op-resource-type-enum>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Retrieve an Existing Snapshot
  record get-params {
    /// Either the ID of an existing snapshot. This will be an integer for a Droplet snapshot or a string for a volume snapshot.
    snapshot-id: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Delete a Snapshot
  record delete-params {
    /// Either the ID of an existing snapshot. This will be an integer for a Droplet snapshot or a string for a volume snapshot.
    snapshot-id: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

}

interface tags {
  enum assign-resources-body-resources-item-resource-type-enum {
    droplet,
    image,
    volume,
    volume-snapshot,
  }

  record list-op-response {
    tags: option<list<list-op-response-tags-item>>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  /// A tag is a label that can be applied to a resource (currently Droplets, Images, Volumes, Volume Snapshots, and Database clusters) in order to better organize or facilitate the lookups and actions on it.
  /// Tags have two attributes: a user defined `name` attribute and an embedded `resources` attribute with information about resources that have been tagged.
  record list-op-response-tags-item {
    /// The name of the tag. Tags may contain letters, numbers, colons, dashes, and underscores.
    /// There is a limit of 255 characters per tag.
    name: option<string>,
    /// An embedded object containing key value pairs of resource type and resource statistics. It also includes a count of the total number of resources tagged with the current tag as well as a `last_tagged_uri` attribute set to the last resource tagged with the current tag.
    resources: option<string>
  }

  record list-op-response-links {
    pages: option<string>
  }

  record list-op-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record create-response {
    /// A tag is a label that can be applied to a resource (currently Droplets, Images, Volumes, Volume Snapshots, and Database clusters) in order to better organize or facilitate the lookups and actions on it.
    /// Tags have two attributes: a user defined `name` attribute and an embedded `resources` attribute with information about resources that have been tagged.
    tag: option<create-response-tag>
  }

  /// A tag is a label that can be applied to a resource (currently Droplets, Images, Volumes, Volume Snapshots, and Database clusters) in order to better organize or facilitate the lookups and actions on it.
  /// Tags have two attributes: a user defined `name` attribute and an embedded `resources` attribute with information about resources that have been tagged.
  record create-response-tag {
    /// The name of the tag. Tags may contain letters, numbers, colons, dashes, and underscores.
    /// There is a limit of 255 characters per tag.
    name: option<string>,
    /// An embedded object containing key value pairs of resource type and resource statistics. It also includes a count of the total number of resources tagged with the current tag as well as a `last_tagged_uri` attribute set to the last resource tagged with the current tag.
    resources: option<string>
  }

  record get-response {
    /// A tag is a label that can be applied to a resource (currently Droplets, Images, Volumes, Volume Snapshots, and Database clusters) in order to better organize or facilitate the lookups and actions on it.
    /// Tags have two attributes: a user defined `name` attribute and an embedded `resources` attribute with information about resources that have been tagged.
    tag: option<get-response-tag>
  }

  /// A tag is a label that can be applied to a resource (currently Droplets, Images, Volumes, Volume Snapshots, and Database clusters) in order to better organize or facilitate the lookups and actions on it.
  /// Tags have two attributes: a user defined `name` attribute and an embedded `resources` attribute with information about resources that have been tagged.
  record get-response-tag {
    /// The name of the tag. Tags may contain letters, numbers, colons, dashes, and underscores.
    /// There is a limit of 255 characters per tag.
    name: option<string>,
    /// An embedded object containing key value pairs of resource type and resource statistics. It also includes a count of the total number of resources tagged with the current tag as well as a `last_tagged_uri` attribute set to the last resource tagged with the current tag.
    resources: option<string>
  }

  record assign-resources-body-resources-item {
    /// The identifier of a resource.
    resource-id: option<string>,
    /// The type of the resource.
    resource-type: option<assign-resources-body-resources-item-resource-type-enum>
  }

  record unassign-resources-body-resources-item {
    /// The identifier of a resource.
    resource-id: option<string>,
    /// The type of the resource.
    resource-type: option<assign-resources-body-resources-item-resource-type-enum>
  }

  variant list-op-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant create-error {
    bad-request(string),
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant assign-resources-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant unassign-resources-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Tags
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Create a New Tag
  record create-params {
    /// The name of the tag. Tags may contain letters, numbers, colons, dashes, and underscores.
    /// There is a limit of 255 characters per tag.
    name: option<string>,
    /// An embedded object containing key value pairs of resource type and resource statistics. It also includes a count of the total number of resources tagged with the current tag as well as a `last_tagged_uri` attribute set to the last resource tagged with the current tag.
    resources: option<string>
  }
  create: func(params: create-params) -> result<create-response, create-error>;

  /// Retrieve a Tag
  record get-params {
    /// The name of the tag. Tags may contain letters, numbers, colons, dashes, and underscores. There is a limit of 255 characters per tag.
    tag-id: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Delete a Tag
  record delete-params {
    /// The name of the tag. Tags may contain letters, numbers, colons, dashes, and underscores. There is a limit of 255 characters per tag.
    tag-id: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

  /// Tag a Resource
  record assign-resources-params {
    /// The name of the tag. Tags may contain letters, numbers, colons, dashes, and underscores. There is a limit of 255 characters per tag.
    tag-id: string,
    /// An array of objects containing resource_id and resource_type  attributes.
    resources: list<assign-resources-body-resources-item>
  }
  assign-resources: func(params: assign-resources-params) -> result<string, assign-resources-error>;

  /// Untag a Resource
  record unassign-resources-params {
    /// The name of the tag. Tags may contain letters, numbers, colons, dashes, and underscores. There is a limit of 255 characters per tag.
    tag-id: string,
    /// An array of objects containing resource_id and resource_type  attributes.
    resources: list<unassign-resources-body-resources-item>
  }
  unassign-resources: func(params: unassign-resources-params) -> result<string, unassign-resources-error>;

}

