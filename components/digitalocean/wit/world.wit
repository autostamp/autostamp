    /// - BUILD: Build-time logs
    type-op: get-logs-active-deployment-type-op-enum,
    /// An optional time duration to wait if the underlying component instance is not immediately available. Default: `3m`.
    pod-connection-timeout: option<string>
  }
  get-logs-aggregate: func(params: get-logs-aggregate-params) -> result<string, string>;

  /// Retrieve Active Deployment Aggregate Logs
  record get-logs-active-deployment-aggregate-params {
    /// The app ID
    app-id: string,
    /// Whether the logs should follow live updates.
    follow: option<bool>,
    /// The type of logs to retrieve
    /// - BUILD: Build-time logs
    type-op: get-logs-active-deployment-type-op-enum,
    /// An optional time duration to wait if the underlying component instance is not immediately available. Default: `3m`.
    pod-connection-timeout: option<string>
  }
  get-logs-active-deployment-aggregate: func(params: get-logs-active-deployment-aggregate-params) -> result<string, string>;

  /// Retrieve App Daily Bandwidth Metrics
  record get-metrics-bandwidth-daily-params {
    /// The app ID
    app-id: string,
    /// Optional day to query. Only the date component of the timestamp will be considered. Default: yesterday.
    date: option<string>
  }
  get-metrics-bandwidth-daily: func(params: get-metrics-bandwidth-daily-params) -> result<string, string>;

  /// Rollback App
  record create-rollback-params {
    /// The app ID
    app-id: string,
    /// The ID of the deployment to rollback to.
    deployment-id: option<string>,
    /// Whether to skip pinning the rollback deployment. If false, the rollback deployment will be pinned and any new deployments including Auto Deploy on Push hooks will be disabled until the rollback is either manually committed or reverted via the CommitAppRollback or RevertAppRollback endpoints respectively. If true, the rollback will be immediately committed and the app will remain unpinned.
    skip-pin: option<bool>
  }
  create-rollback: func(params: create-rollback-params) -> result<string, string>;

  /// Commit App Rollback
  record commit-rollback-params {
    /// The app ID
    app-id: string
  }
  commit-rollback: func(params: commit-rollback-params) -> result<string, string>;

  /// Revert App Rollback
  record revert-rollback-params {
    /// The app ID
    app-id: string
  }
  revert-rollback: func(params: revert-rollback-params) -> result<string, string>;

  /// Validate App Rollback
  record validate-rollback-params {
    /// The app ID
    app-id: string,
    /// The ID of the deployment to rollback to.
    deployment-id: option<string>,
    /// Whether to skip pinning the rollback deployment. If false, the rollback deployment will be pinned and any new deployments including Auto Deploy on Push hooks will be disabled until the rollback is either manually committed or reverted via the CommitAppRollback or RevertAppRollback endpoints respectively. If true, the rollback will be immediately committed and the app will remain unpinned.
    skip-pin: option<bool>
  }
  validate-rollback: func(params: validate-rollback-params) -> result<string, string>;

  /// Retrieve an Existing App
  record get-params {
    /// The ID of the app
    id: string,
    /// The name of the app to retrieve.
    name: option<string>
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update an App
  record update-params {
    /// The ID of the app
    id: string,
    /// The desired configuration of an application.
    spec: update-body-spec
  }
  update: func(params: update-params) -> result<string, string>;

  /// Delete an App
  record delete-params {
    /// The ID of the app
    id: string
  }
  delete: func(params: delete-params) -> result<string, string>;

}

interface cdn-endpoints {
  /// List All CDN Endpoints
  record cdn-list-endpoints-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  cdn-list-endpoints: func(params: cdn-list-endpoints-params) -> result<string, string>;

  /// Create a New CDN Endpoint
  record cdn-create-endpoint-params {
    /// The ID of a DigitalOcean managed TLS certificate used for SSL when a custom subdomain is provided.
    certificate-id: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the CDN endpoint was created.
    created-at: option<string>,
    /// The fully qualified domain name (FQDN) of the custom subdomain used with the CDN endpoint.
    custom-domain: option<string>,
    /// The fully qualified domain name (FQDN) from which the CDN-backed content is served.
    endpoint: option<string>,
    /// A unique ID that can be used to identify and reference a CDN endpoint.
    id: option<string>,
    /// The fully qualified domain name (FQDN) for the origin server which provides the content for the CDN. This is currently restricted to a Space.
    origin: string,
    /// The amount of time the content is cached by the CDN's edge servers in seconds. TTL must be one of 60, 600, 3600, 86400, or 604800. Defaults to 3600 (one hour) when excluded.
    ttl: option<s32>
  }
  cdn-create-endpoint: func(params: cdn-create-endpoint-params) -> result<string, string>;

  /// Retrieve an Existing CDN Endpoint
  record cdn-get-endpoint-params {
    /// A unique identifier for a CDN endpoint.
    cdn-id: string
  }
  cdn-get-endpoint: func(params: cdn-get-endpoint-params) -> result<string, string>;

  /// Update a CDN Endpoint
  record cdn-update-endpoints-params {
    /// A unique identifier for a CDN endpoint.
    cdn-id: string,
    /// The ID of a DigitalOcean managed TLS certificate used for SSL when a custom subdomain is provided.
    certificate-id: option<string>,
    /// The fully qualified domain name (FQDN) of the custom subdomain used with the CDN endpoint.
    custom-domain: option<string>,
    /// The amount of time the content is cached by the CDN's edge servers in seconds. TTL must be one of 60, 600, 3600, 86400, or 604800. Defaults to 3600 (one hour) when excluded.
    ttl: option<s32>
  }
  cdn-update-endpoints: func(params: cdn-update-endpoints-params) -> result<string, string>;

  /// Delete a CDN Endpoint
  record cdn-delete-endpoint-params {
    /// A unique identifier for a CDN endpoint.
    cdn-id: string
  }
  cdn-delete-endpoint: func(params: cdn-delete-endpoint-params) -> result<string, string>;

  /// Purge the Cache for an Existing CDN Endpoint
  record cdn-purge-cache-params {
    /// A unique identifier for a CDN endpoint.
    cdn-id: string,
    /// An array of strings containing the path to the content to be purged from the CDN cache.
    files: list<string>
  }
  cdn-purge-cache: func(params: cdn-purge-cache-params) -> result<string, string>;

}

