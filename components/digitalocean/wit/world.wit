    name: string,
    /// A randomly generated password for the database user.
    password: option<string>,
    /// A string representing the database user's role. The value will be either
    /// "primary" or "normal".
    role: option<list-clusters-response-databases-item-users-item-role-enum>
  }

  record create-cluster-body-users-item-mysql-settings {
    /// A string specifying the authentication method to be used for connections
    /// to the MySQL user account. The valid values are `mysql_native_password`
    auth-plugin: list-clusters-response-databases-item-users-item-mysql-settings-auth-plugin-enum
  }

  record create-cluster-body-backup-restore {
    /// The timestamp of an existing database cluster backup in ISO8601 combined date and time format. The most recent backup will be used if excluded.
    backup-created-at: option<string>,
    /// The name of an existing database cluster from which the backup will be restored.
    database-name: string
  }

  record create-cluster-response {
    database: create-cluster-response-database
  }

  record create-cluster-response-database {
