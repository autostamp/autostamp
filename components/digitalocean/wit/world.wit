  record assign-alert-destinations-params {
    /// The app ID
    app-id: string,
    /// The alert ID
    alert-id: string,
    emails: option<list<string>>,
    slack-webhooks: option<list<assign-alert-destinations-body-slack-webhooks-item>>
  }
  assign-alert-destinations: func(params: assign-alert-destinations-params) -> result<assign-alert-destinations-response, assign-alert-destinations-error>;

  /// Retrieve Active Deployment Logs
  record get-logs-active-deployment-params {
    /// The app ID
    app-id: string,
