    saturday,
    sunday,
  }

  enum list-clusters-response-kubernetes-clusters-item-status-state-enum {
    running,
    provisioning,
    degraded,
    error,
    deleted,
    upgrading,
    deleting,
  }

  record list-clusters-response {
    kubernetes-clusters: option<list<list-clusters-response-kubernetes-clusters-item>>,
