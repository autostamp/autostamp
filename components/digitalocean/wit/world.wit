    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant reserved-i-ps-actions-post-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant reserved-i-ps-actions-get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Actions for a Reserved IP
