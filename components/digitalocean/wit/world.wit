    deployment-id: string
  }
  get-deployment: func(params: get-deployment-params) -> result<get-deployment-response, get-deployment-error>;

  /// Cancel a Deployment
  record cancel-deployment-params {
    /// The app ID
    app-id: string,
    /// The deployment ID
    deployment-id: string
  }
  cancel-deployment: func(params: cancel-deployment-params) -> result<cancel-deployment-response, cancel-deployment-error>;

  /// Retrieve Deployment Logs
  record get-logs-params {
    /// The app ID
    app-id: string,
    /// The deployment ID
    deployment-id: string,
    /// An optional component name. If set, logs will be limited to this component only.
    component-name: string,
    /// Whether the logs should follow live updates.
    follow: option<bool>,
    /// The type of logs to retrieve
    /// - BUILD: Build-time logs
    type-op: get-logs-active-deployment-type-op-enum,
    /// An optional time duration to wait if the underlying component instance is not immediately available. Default: `3m`.
    pod-connection-timeout: option<string>
  }
  get-logs: func(params: get-logs-params) -> result<get-logs-response, get-logs-error>;

  /// Retrieve Aggregate Deployment Logs
  record get-logs-aggregate-params {
    /// The app ID
    app-id: string,
    /// The deployment ID
    deployment-id: string,
    /// Whether the logs should follow live updates.
    follow: option<bool>,
    /// The type of logs to retrieve
    /// - BUILD: Build-time logs
    type-op: get-logs-active-deployment-type-op-enum,
    /// An optional time duration to wait if the underlying component instance is not immediately available. Default: `3m`.
    pod-connection-timeout: option<string>
  }
  get-logs-aggregate: func(params: get-logs-aggregate-params) -> result<get-logs-aggregate-response, get-logs-aggregate-error>;

  /// Retrieve Active Deployment Aggregate Logs
  record get-logs-active-deployment-aggregate-params {
    /// The app ID
    app-id: string,
    /// Whether the logs should follow live updates.
    follow: option<bool>,
    /// The type of logs to retrieve
    /// - BUILD: Build-time logs
    type-op: get-logs-active-deployment-type-op-enum,
    /// An optional time duration to wait if the underlying component instance is not immediately available. Default: `3m`.
    pod-connection-timeout: option<string>
  }
  get-logs-active-deployment-aggregate: func(params: get-logs-active-deployment-aggregate-params) -> result<get-logs-active-deployment-aggregate-response, get-logs-active-deployment-aggregate-error>;

  /// Retrieve App Daily Bandwidth Metrics
  record get-metrics-bandwidth-daily-params {
    /// The app ID
    app-id: string,
    /// Optional day to query. Only the date component of the timestamp will be considered. Default: yesterday.
    date: option<string>
  }
  get-metrics-bandwidth-daily: func(params: get-metrics-bandwidth-daily-params) -> result<get-metrics-bandwidth-daily-response, get-metrics-bandwidth-daily-error>;

  /// Rollback App
  record create-rollback-params {
    /// The app ID
    app-id: string,
    /// The ID of the deployment to rollback to.
    deployment-id: option<string>,
    /// Whether to skip pinning the rollback deployment. If false, the rollback deployment will be pinned and any new deployments including Auto Deploy on Push hooks will be disabled until the rollback is either manually committed or reverted via the CommitAppRollback or RevertAppRollback endpoints respectively. If true, the rollback will be immediately committed and the app will remain unpinned.
    skip-pin: option<bool>
  }
  create-rollback: func(params: create-rollback-params) -> result<create-rollback-response, create-rollback-error>;

  /// Commit App Rollback
  record commit-rollback-params {
    /// The app ID
    app-id: string
  }
  commit-rollback: func(params: commit-rollback-params) -> result<string, commit-rollback-error>;

  /// Revert App Rollback
  record revert-rollback-params {
    /// The app ID
    app-id: string
  }
  revert-rollback: func(params: revert-rollback-params) -> result<revert-rollback-response, revert-rollback-error>;

  /// Validate App Rollback
  record validate-rollback-params {
    /// The app ID
    app-id: string,
    /// The ID of the deployment to rollback to.
    deployment-id: option<string>,
    /// Whether to skip pinning the rollback deployment. If false, the rollback deployment will be pinned and any new deployments including Auto Deploy on Push hooks will be disabled until the rollback is either manually committed or reverted via the CommitAppRollback or RevertAppRollback endpoints respectively. If true, the rollback will be immediately committed and the app will remain unpinned.
    skip-pin: option<bool>
  }
  validate-rollback: func(params: validate-rollback-params) -> result<validate-rollback-response, validate-rollback-error>;

  /// Retrieve an Existing App
  record get-params {
    /// The ID of the app
    id: string,
    /// The name of the app to retrieve.
    name: option<string>
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Update an App
  record update-params {
    /// The ID of the app
    id: string,
    /// The desired configuration of an application.
    spec: update-body-spec
  }
  update: func(params: update-params) -> result<update-response, update-error>;

  /// Delete an App
  record delete-params {
    /// The ID of the app
    id: string
  }
  delete: func(params: delete-params) -> result<delete-response, delete-error>;

}

interface cdn-endpoints {
  record cdn-list-endpoints-response {
    endpoints: option<list<cdn-list-endpoints-response-endpoints-item>>,
    links: option<cdn-list-endpoints-response-links>,
    meta: cdn-list-endpoints-response-meta
  }

  record cdn-list-endpoints-response-endpoints-item {
    /// The ID of a DigitalOcean managed TLS certificate used for SSL when a custom subdomain is provided.
    certificate-id: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the CDN endpoint was created.
    created-at: option<string>,
    /// The fully qualified domain name (FQDN) of the custom subdomain used with the CDN endpoint.
    custom-domain: option<string>,
    /// The fully qualified domain name (FQDN) from which the CDN-backed content is served.
    endpoint: option<string>,
    /// A unique ID that can be used to identify and reference a CDN endpoint.
    id: option<string>,
    /// The fully qualified domain name (FQDN) for the origin server which provides the content for the CDN. This is currently restricted to a Space.
    origin: string,
    /// The amount of time the content is cached by the CDN's edge servers in seconds. TTL must be one of 60, 600, 3600, 86400, or 604800. Defaults to 3600 (one hour) when excluded.
    ttl: option<s32>
  }

  record cdn-list-endpoints-response-links {
    pages: option<string>
  }

  record cdn-list-endpoints-response-meta {
