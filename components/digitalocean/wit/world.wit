  record volume-snapshots-list-response {
    snapshots: option<list<volume-snapshots-list-response-snapshots-item>>,
    links: option<volume-snapshots-list-response-links>,
    meta: volume-snapshots-list-response-meta
  }

  record volume-snapshots-list-response-snapshots-item {
    /// The unique identifier for the snapshot.
    id: string,
    /// A time value given in ISO8601 combined date and time format that represents when the snapshot was created.
    created-at: string,
    /// The minimum size in GB required for a volume or Droplet to use this snapshot.
    min-disk-size: s32,
    /// A human-readable name for the snapshot.
    name: string,
    /// An array of the regions that the snapshot is available in. The regions are represented by their identifying slug values.
    regions: list<string>,
    /// The billable size of the snapshot in gigabytes.
    size-gigabytes: f64,
    /// The unique identifier for the resource that the snapshot originated from.
    resource-id: string,
    /// The type of resource that the snapshot originated from.
    resource-type: volume-snapshots-get-by-id-response-snapshot-resource-type-enum,
    /// An array of Tags the snapshot has been tagged with.
    tags: list<string>
  }

  record volume-snapshots-list-response-links {
    pages: option<string>
  }

  record volume-snapshots-list-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record volume-snapshots-create-response {
    snapshot: option<volume-snapshots-create-response-snapshot>
  }

  record volume-snapshots-create-response-snapshot {
    /// The unique identifier for the snapshot.
    id: string,
    /// A time value given in ISO8601 combined date and time format that represents when the snapshot was created.
    created-at: string,
    /// The minimum size in GB required for a volume or Droplet to use this snapshot.
    min-disk-size: s32,
    /// A human-readable name for the snapshot.
    name: string,
    /// An array of the regions that the snapshot is available in. The regions are represented by their identifying slug values.
    regions: list<string>,
    /// The billable size of the snapshot in gigabytes.
    size-gigabytes: f64,
    /// The unique identifier for the resource that the snapshot originated from.
    resource-id: string,
    /// The type of resource that the snapshot originated from.
    resource-type: volume-snapshots-get-by-id-response-snapshot-resource-type-enum,
    /// An array of Tags the snapshot has been tagged with.
    tags: list<string>
  }

  variant volumes-list-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volumes-create-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volumes-delete-by-name-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volume-snapshots-get-by-id-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volume-snapshots-delete-by-id-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volumes-get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volumes-delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volume-snapshots-list-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volume-snapshots-create-error {
    bad-request(string),
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Block Storage Volumes
  record volumes-list-params {
    /// The block storage volume's name.
    name: option<string>,
    /// The slug identifier for the region where the resource is available.
    region: option<volumes-list-region-enum>,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  volumes-list: func(params: volumes-list-params) -> result<volumes-list-response, volumes-list-error>;

  /// Create a New Block Storage Volume
  record volumes-create-params {
    body: string
  }
  volumes-create: func(params: volumes-create-params) -> result<volumes-create-response, volumes-create-error>;

  /// Delete a Block Storage Volume by Name
  record volumes-delete-by-name-params {
    /// The block storage volume's name.
    name: option<string>,
    /// The slug identifier for the region where the resource is available.
    region: option<volumes-list-region-enum>
  }
  volumes-delete-by-name: func(params: volumes-delete-by-name-params) -> result<string, volumes-delete-by-name-error>;

  /// Retrieve an Existing Volume Snapshot
  record volume-snapshots-get-by-id-params {
    /// Either the ID of an existing snapshot. This will be an integer for a Droplet snapshot or a string for a volume snapshot.
    snapshot-id: string
  }
  volume-snapshots-get-by-id: func(params: volume-snapshots-get-by-id-params) -> result<volume-snapshots-get-by-id-response, volume-snapshots-get-by-id-error>;

  /// Delete a Volume Snapshot
  record volume-snapshots-delete-by-id-params {
    /// Either the ID of an existing snapshot. This will be an integer for a Droplet snapshot or a string for a volume snapshot.
    snapshot-id: string
  }
  volume-snapshots-delete-by-id: func(params: volume-snapshots-delete-by-id-params) -> result<string, volume-snapshots-delete-by-id-error>;

  /// Retrieve an Existing Block Storage Volume
  record volumes-get-params {
    /// The ID of the block storage volume.
    volume-id: string
  }
  volumes-get: func(params: volumes-get-params) -> result<volumes-get-response, volumes-get-error>;

  /// Delete a Block Storage Volume
  record volumes-delete-params {
    /// The ID of the block storage volume.
    volume-id: string
  }
  volumes-delete: func(params: volumes-delete-params) -> result<string, volumes-delete-error>;

  /// List Snapshots for a Volume
  record volume-snapshots-list-params {
    /// The ID of the block storage volume.
    volume-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  volume-snapshots-list: func(params: volume-snapshots-list-params) -> result<volume-snapshots-list-response, volume-snapshots-list-error>;

  /// Create Snapshot from a Volume
  record volume-snapshots-create-params {
    /// The ID of the block storage volume.
    volume-id: string,
    /// A human-readable name for the volume snapshot.
    name: string,
    /// A flat array of tag names as strings to be applied to the resource. Tag names may be for either existing or new tags.
    tags: option<list<string>>
  }
  volume-snapshots-create: func(params: volume-snapshots-create-params) -> result<volume-snapshots-create-response, volume-snapshots-create-error>;

}

interface block-storage-actions {
  record volume-actions-post-response {
    action: option<string>
  }

  record volume-actions-list-response {
    actions: option<list<string>>,
    links: option<volume-actions-list-response-links>,
    meta: volume-actions-list-response-meta
  }

  record volume-actions-list-response-links {
    pages: option<string>
  }

  record volume-actions-list-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record volume-actions-post-by-id-response {
    action: option<string>
  }

  record volume-actions-get-response {
    action: option<string>
  }

  variant volume-actions-post-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volume-actions-list-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volume-actions-post-by-id-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant volume-actions-get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// Initiate A Block Storage Action By Volume Name
  record volume-actions-post-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>,
    body: string
  }
  volume-actions-post: func(params: volume-actions-post-params) -> result<volume-actions-post-response, volume-actions-post-error>;

  /// List All Actions for a Volume
  record volume-actions-list-params {
    /// The ID of the block storage volume.
    volume-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  volume-actions-list: func(params: volume-actions-list-params) -> result<volume-actions-list-response, volume-actions-list-error>;

  /// Initiate A Block Storage Action By Volume Id
  record volume-actions-post-by-id-params {
    /// The ID of the block storage volume.
    volume-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>,
    body: string
  }
  volume-actions-post-by-id: func(params: volume-actions-post-by-id-params) -> result<volume-actions-post-by-id-response, volume-actions-post-by-id-error>;

  /// Retrieve an Existing Volume Action
  record volume-actions-get-params {
    /// The ID of the block storage volume.
    volume-id: string,
    /// A unique numeric ID that can be used to identify and reference an action.
    action-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  volume-actions-get: func(params: volume-actions-get-params) -> result<volume-actions-get-response, volume-actions-get-error>;

}

interface vp-cs {
  record vpcs-list-response {
    vpcs: option<list<string>>,
    links: option<vpcs-list-response-links>,
    meta: vpcs-list-response-meta
  }

  record vpcs-list-response-links {
    pages: option<string>
  }

  record vpcs-list-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record vpcs-create-response {
    vpc: option<string>
  }

  record vpcs-get-response {
    vpc: option<string>
  }

  record vpcs-update-response {
    vpc: option<string>
  }

  record vpcs-patch-response {
    vpc: option<string>
  }

  record vpcs-list-members-response {
    members: option<list<vpcs-list-members-response-members-item>>,
    links: option<vpcs-list-members-response-links>,
    meta: vpcs-list-members-response-meta
  }

  record vpcs-list-members-response-members-item {
    /// A time value given in ISO8601 combined date and time format that represents when the resource was created.
    created-at: option<string>,
    /// The name of the resource.
    name: option<string>,
    /// The uniform resource name (URN) for the resource in the format do:resource_type:resource_id.
    urn: option<string>
  }

  record vpcs-list-members-response-links {
    pages: option<string>
  }

  record vpcs-list-members-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  variant vpcs-list-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant vpcs-create-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant vpcs-get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant vpcs-update-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant vpcs-patch-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant vpcs-delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant vpcs-list-members-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All VPCs
  record vpcs-list-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  vpcs-list: func(params: vpcs-list-params) -> result<vpcs-list-response, vpcs-list-error>;

  /// Create a New VPC
  record vpcs-create-params {
    body: string
  }
  vpcs-create: func(params: vpcs-create-params) -> result<vpcs-create-response, vpcs-create-error>;

  /// Retrieve an Existing VPC
  record vpcs-get-params {
    /// A unique identifier for a VPC.
    vpc-id: string
  }
  vpcs-get: func(params: vpcs-get-params) -> result<vpcs-get-response, vpcs-get-error>;

  /// Update a VPC
  record vpcs-update-params {
    /// A unique identifier for a VPC.
    vpc-id: string,
    body: string
  }
  vpcs-update: func(params: vpcs-update-params) -> result<vpcs-update-response, vpcs-update-error>;

  /// Partially Update a VPC
  record vpcs-patch-params {
    /// A unique identifier for a VPC.
    vpc-id: string,
    /// A free-form text field for describing the VPC's purpose. It may be a maximum of 255 characters.
    description: option<string>,
    /// The name of the VPC. Must be unique and may only contain alphanumeric characters, dashes, and periods.
    name: option<string>,
    /// A boolean value indicating whether or not the VPC is the default network for the region. All applicable resources are placed into the default VPC network unless otherwise specified during their creation. The `default` field cannot be unset from `true`. If you want to set a new default VPC network, update the `default` field of another VPC network in the same region. The previous network's `default` field will be set to `false` when a new default VPC has been defined.
    default: option<bool>
  }
  vpcs-patch: func(params: vpcs-patch-params) -> result<vpcs-patch-response, vpcs-patch-error>;

  /// Delete a VPC
  record vpcs-delete-params {
    /// A unique identifier for a VPC.
    vpc-id: string
  }
  vpcs-delete: func(params: vpcs-delete-params) -> result<string, vpcs-delete-error>;

  /// List the Member Resources of a VPC
  record vpcs-list-members-params {
    /// A unique identifier for a VPC.
    vpc-id: string,
    /// Used to filter VPC members by a resource type.
    resource-type: option<string>,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  vpcs-list-members: func(params: vpcs-list-members-params) -> result<vpcs-list-members-response, vpcs-list-members-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export v1-click-applications;
  export account;
  export ssh-keys;
  export actions;
  export apps;
  export cdn-endpoints;
  export certificates;
  export billing;
  export databases;
  export domains;
  export domain-records;
  export droplets;
  export droplet-actions;
  export firewalls;
  export floating-i-ps;
  export floating-ip-actions;
  export functions;
  export images;
  export image-actions;
  export kubernetes;
  export load-balancers;
  export monitoring;
  export projects;
  export project-resources;
  export regions;
  export container-registry;
  export reserved-i-ps;
  export reserved-ip-actions;
  export sizes;
  export snapshots;
  export tags;
  export uptime;
  export block-storage;
  export block-storage-actions;
  export vp-cs;
}
