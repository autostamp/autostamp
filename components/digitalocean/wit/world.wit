interface databases {
  enum update-eviction-policy-body-eviction-policy-enum {
    noeviction,
    allkeys-lru,
    allkeys-random,
    volatile-lru,
    volatile-random,
    volatile-ttl,
  }

  enum update-firewall-rules-body-rules-item-type-op-enum {
    droplet,
    k8s,
    ip-addr,
    tag,
    app,
  }

  enum add-user-body-mysql-settings-auth-plugin-enum {
    mysql-native-password,
    caching-sha2-password,
  }

  enum add-user-body-role-enum {
    primary,
    normal,
  }

  record update-firewall-rules-body-rules-item {
    /// A unique ID for the database cluster to which the rule is applied.
    cluster-uuid: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the firewall rule was created.
    created-at: option<string>,
    /// The type of resource that the firewall rule allows to access the database cluster.
    type-op: update-firewall-rules-body-rules-item-type-op-enum,
    /// A unique ID for the firewall rule itself.
    uuid: option<string>,
    /// The ID of the specific resource, the name of a tag applied to a group of resources, or the IP address that the firewall rule allows to access the database cluster.
    value: string
  }

  record add-user-body-mysql-settings {
    /// A string specifying the authentication method to be used for connections
    /// to the MySQL user account. The valid values are `mysql_native_password`
    auth-plugin: add-user-body-mysql-settings-auth-plugin-enum
  }

  record reset-auth-body-mysql-settings {
    /// A string specifying the authentication method to be used for connections
    /// to the MySQL user account. The valid values are `mysql_native_password`
    auth-plugin: add-user-body-mysql-settings-auth-plugin-enum
  }

  /// List All Database Clusters
  record list-clusters-params {
    /// Limits the results to database clusters with a specific tag.
    tag-name: option<string>
  }
  list-clusters: func(params: list-clusters-params) -> result<string, string>;

  /// Create a New Database Cluster
  record create-cluster-params {
    body: string
  }
  create-cluster: func(params: create-cluster-params) -> result<string, string>;

  /// List Database Options
  list-options: func() -> result<string, string>;

  /// Retrieve an Existing Database Cluster
  record get-cluster-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-cluster: func(params: get-cluster-params) -> result<string, string>;

  /// Destroy a Database Cluster
  record destroy-cluster-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  destroy-cluster: func(params: destroy-cluster-params) -> result<string, string>;

  /// List Backups for a Database Cluster
  record list-backups-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-backups: func(params: list-backups-params) -> result<string, string>;

  /// Retrieve the Public Certificate
  record get-ca-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-ca: func(params: get-ca-params) -> result<string, string>;

  /// Retrieve an Existing Database Cluster Configuration
  record get-config-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-config: func(params: get-config-params) -> result<string, string>;

  /// Update the Database Configuration for an Existing Database
  record patch-config-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    config: option<string>
  }
  patch-config: func(params: patch-config-params) -> result<string, string>;

  /// List All Databases
  record list-op-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Add a New Database
  record add-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database.
    name: string
  }
  add: func(params: add-params) -> result<string, string>;

  /// Retrieve an Existing Database
  record get-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database.
    database-name: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Delete a Database
  record delete-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database.
    database-name: string
  }
  delete: func(params: delete-params) -> result<string, string>;

  /// Retrieve the Eviction Policy for a Redis Cluster
  record get-eviction-policy-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-eviction-policy: func(params: get-eviction-policy-params) -> result<string, string>;

  /// Configure the Eviction Policy for a Redis Cluster
  record update-eviction-policy-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A string specifying the desired eviction policy for the Redis cluster.
    /// 
    eviction-policy: update-eviction-policy-body-eviction-policy-enum
  }
  update-eviction-policy: func(params: update-eviction-policy-params) -> result<string, string>;

  /// List Firewall Rules (Trusted Sources) for a Database Cluster
  record list-firewall-rules-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-firewall-rules: func(params: list-firewall-rules-params) -> result<string, string>;

  /// Update Firewall Rules (Trusted Sources) for a Database
  record update-firewall-rules-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    rules: option<list<update-firewall-rules-body-rules-item>>
  }
  update-firewall-rules: func(params: update-firewall-rules-params) -> result<string, string>;

  /// Configure a Database Cluster's Maintenance Window
  record update-maintenance-window-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The day of the week on which to apply maintenance updates.
    day: string,
    /// A list of strings, each containing information about a pending maintenance update.
    description: option<list<string>>,
    /// The hour in UTC at which maintenance updates will be applied in 24 hour format.
    hour: string,
    /// A boolean value indicating whether any maintenance is scheduled to be performed in the next window.
    pending: option<bool>
  }
  update-maintenance-window: func(params: update-maintenance-window-params) -> result<string, string>;

  /// Migrate a Database Cluster to a New Region
  record update-region-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A slug identifier for the region to which the database cluster will be migrated.
    region: string
  }
  update-region: func(params: update-region-params) -> result<string, string>;

  /// Retrieve the Status of an Online Migration
  record get-migration-status-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-migration-status: func(params: get-migration-status-params) -> result<string, string>;

  /// Start an Online Migration
  record update-online-migration-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// Enables SSL encryption when connecting to the source database.
    disable-ssl: option<bool>,
    source: option<string>
  }
  update-online-migration: func(params: update-online-migration-params) -> result<string, string>;

  /// Stop an Online Migration
  record delete-online-migration-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A unique identifier assigned to the online migration.
    migration-id: string
  }
  delete-online-migration: func(params: delete-online-migration-params) -> result<string, string>;

  /// List Connection Pools (PostgreSQL)
  record list-connection-pools-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-connection-pools: func(params: list-connection-pools-params) -> result<string, string>;

  /// Add a New Connection Pool (PostgreSQL)
  record add-connection-pool-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    connection: option<string>,
    /// The database for use with the connection pool.
    db: string,
    /// The PGBouncer transaction mode for the connection pool. The allowed values are session, transaction, and statement.
    mode: string,
    /// A unique name for the connection pool. Must be between 3 and 60 characters.
    name: string,
    private-connection: option<string>,
    /// The desired size of the PGBouncer connection pool. The maximum allowed size is determined by the size of the cluster's primary node. 25 backend server connections are allowed for every 1GB of RAM. Three are reserved for maintenance. For example, a primary node with 1 GB of RAM allows for a maximum of 22 backend server connections while one with 4 GB would allow for 97. Note that these are shared across all connection pools in a cluster.
    size: s32,
    /// The name of the user for use with the connection pool. When excluded, all sessions connect to the database as the inbound user.
    user: option<string>
  }
  add-connection-pool: func(params: add-connection-pool-params) -> result<string, string>;

  /// Retrieve Existing Connection Pool (PostgreSQL)
  record get-connection-pool-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name used to identify the connection pool.
    pool-name: string
  }
  get-connection-pool: func(params: get-connection-pool-params) -> result<string, string>;

  /// Update Connection Pools (PostgreSQL)
  record update-connection-pool-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name used to identify the connection pool.
    pool-name: string,
    /// The database for use with the connection pool.
    db: string,
    /// The PGBouncer transaction mode for the connection pool. The allowed values are session, transaction, and statement.
    mode: string,
    /// The desired size of the PGBouncer connection pool. The maximum allowed size is determined by the size of the cluster's primary node. 25 backend server connections are allowed for every 1GB of RAM. Three are reserved for maintenance. For example, a primary node with 1 GB of RAM allows for a maximum of 22 backend server connections while one with 4 GB would allow for 97. Note that these are shared across all connection pools in a cluster.
    size: s32,
    /// The name of the user for use with the connection pool. When excluded, all sessions connect to the database as the inbound user.
    user: option<string>
  }
  update-connection-pool: func(params: update-connection-pool-params) -> result<string, string>;

  /// Delete a Connection Pool (PostgreSQL)
  record delete-connection-pool-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name used to identify the connection pool.
    pool-name: string
  }
  delete-connection-pool: func(params: delete-connection-pool-params) -> result<string, string>;

  /// List All Read-only Replicas
  record list-replicas-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-replicas: func(params: list-replicas-params) -> result<string, string>;

  /// Create a Read-only Replica
  record create-replica-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    body: option<string>
  }
  create-replica: func(params: create-replica-params) -> result<string, string>;

  /// Retrieve an Existing Read-only Replica
  record get-replica-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database replica.
    replica-name: string
  }
  get-replica: func(params: get-replica-params) -> result<string, string>;

  /// Destroy a Read-only Replica
  record destroy-replica-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database replica.
    replica-name: string
  }
  destroy-replica: func(params: destroy-replica-params) -> result<string, string>;

  /// Promote a Read-only Replica to become a Primary Cluster
  record promote-replica-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database replica.
    replica-name: string
  }
  promote-replica: func(params: promote-replica-params) -> result<string, string>;

  /// Resize a Database Cluster
  record update-cluster-size-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The number of nodes in the database cluster. Valid values are are 1-3. In addition to the primary node, up to two standby nodes may be added for highly available configurations.
    num-nodes: s32,
    /// A slug identifier representing desired the size of the nodes in the database cluster.
    size: string
  }
  update-cluster-size: func(params: update-cluster-size-params) -> result<string, string>;

  /// Retrieve the SQL Modes for a MySQL Cluster
  record get-sql-mode-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-sql-mode: func(params: get-sql-mode-params) -> result<string, string>;

  /// Update SQL Mode for a Cluster
  record update-sql-mode-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A string specifying the configured SQL modes for the MySQL cluster.
    sql-mode: string
  }
  update-sql-mode: func(params: update-sql-mode-params) -> result<string, string>;

  /// Upgrade Major Version for a Database
  record update-major-version-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A string representing the version of the database engine in use for the cluster.
    version: option<string>
  }
  update-major-version: func(params: update-major-version-params) -> result<string, string>;

  /// List all Database Users
  record list-users-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-users: func(params: list-users-params) -> result<string, string>;

  /// Add a Database User
  record add-user-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    mysql-settings: option<add-user-body-mysql-settings>,
    /// The name of a database user.
    name: string,
    /// A randomly generated password for the database user.
    password: option<string>,
    /// A string representing the database user's role. The value will be either
    /// "primary" or "normal".
    role: option<add-user-body-role-enum>
  }
  add-user: func(params: add-user-params) -> result<string, string>;

  /// Retrieve an Existing Database User
  record get-user-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database user.
    username: string
  }
  get-user: func(params: get-user-params) -> result<string, string>;

  /// Remove a Database User
  record delete-user-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database user.
    username: string
  }
  delete-user: func(params: delete-user-params) -> result<string, string>;

  /// Reset a Database User's Password or Authentication Method
  record reset-auth-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database user.
    username: string,
    mysql-settings: option<reset-auth-body-mysql-settings>
  }
  reset-auth: func(params: reset-auth-params) -> result<string, string>;

}

interface domains {
  /// List All Domains
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Create a New Domain
  record create-params {
    /// This optional attribute may contain an IP address. When provided, an A record will be automatically created pointing to the apex domain.
    ip-address: option<string>,
    /// The name of the domain itself. This should follow the standard domain format of domain.TLD. For instance, `example.com` is a valid domain name.
    name: option<string>,
    /// This value is the time to live for the records on this domain, in seconds. This defines the time frame that clients can cache queried information before a refresh should be requested.
    ttl: option<s32>,
    /// This attribute contains the complete contents of the zone file for the selected domain. Individual domain record resources should be used to get more granular control over records. However, this attribute can also be used to get information about the SOA record, which is created automatically and is not accessible as an individual record resource.
    zone-file: option<string>
  }
  create: func(params: create-params) -> result<string, string>;

  /// Retrieve an Existing Domain
  record get-params {
    /// The name of the domain itself.
    domain-name: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Delete a Domain
  record delete-params {
    /// The name of the domain itself.
    domain-name: string
  }
  delete: func(params: delete-params) -> result<string, string>;

}

interface domain-records {
  enum domains-list-records-type-op-enum {
    a,
    aaaa,
    caa,
    cname,
    mx,
    ns,
    soa,
    srv,
    txt,
  }

  /// List All Domain Records
  record domains-list-records-params {
    /// The name of the domain itself.
    domain-name: string,
    /// A fully qualified record name. For example, to only include records matching sub.example.com, send a GET request to `/v2/domains/$DOMAIN_NAME/records?name=sub.example.com`.
    name: option<string>,
    /// The type of the DNS record. For example: A, CNAME, TXT, ...
    type-op: option<domains-list-records-type-op-enum>,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  domains-list-records: func(params: domains-list-records-params) -> result<string, string>;

  /// Create a New Domain Record
  record domains-create-record-params {
    /// The name of the domain itself.
    domain-name: string,
    body: option<string>
  }
  domains-create-record: func(params: domains-create-record-params) -> result<string, string>;

  /// Retrieve an Existing Domain Record
  record domains-get-record-params {
    /// The name of the domain itself.
    domain-name: string,
    /// The unique identifier of the domain record.
    domain-record-id: string
  }
  domains-get-record: func(params: domains-get-record-params) -> result<string, string>;

  /// Update a Domain Record
  record domains-update-record-params {
    /// The name of the domain itself.
    domain-name: string,
    /// The unique identifier of the domain record.
    domain-record-id: string,
    /// Variable data depending on record type. For example, the "data" value for an A record would be the IPv4 address to which the domain will be mapped. For a CAA record, it would contain the domain name of the CA being granted permission to issue certificates.
    data: option<string>,
    /// An unsigned integer between 0-255 used for CAA records.
    flags-op: option<s32>,
    /// A unique identifier for each domain record.
    id: option<s32>,
    /// The host name, alias, or service being defined by the record.
    name: option<string>,
    /// The port for SRV records.
    port: option<s32>,
    /// The priority for SRV and MX records.
    priority: option<s32>,
    /// The parameter tag for CAA records. Valid values are "issue", "issuewild", or "iodef"
    tag: option<string>,
    /// This value is the time to live for the record, in seconds. This defines the time frame that clients can cache queried information before a refresh should be requested.
    ttl: option<s32>,
    /// The type of the DNS record. For example: A, CNAME, TXT, ...
    type-op: string,
    /// The weight for SRV records.
    weight: option<s32>
  }
  domains-update-record: func(params: domains-update-record-params) -> result<string, string>;

  /// Update a Domain Record
  record domains-patch-record-params {
    /// The name of the domain itself.
    domain-name: string,
    /// The unique identifier of the domain record.
    domain-record-id: string,
    /// Variable data depending on record type. For example, the "data" value for an A record would be the IPv4 address to which the domain will be mapped. For a CAA record, it would contain the domain name of the CA being granted permission to issue certificates.
    data: option<string>,
    /// An unsigned integer between 0-255 used for CAA records.
    flags-op: option<s32>,
    /// A unique identifier for each domain record.
    id: option<s32>,
    /// The host name, alias, or service being defined by the record.
    name: option<string>,
    /// The port for SRV records.
    port: option<s32>,
    /// The priority for SRV and MX records.
    priority: option<s32>,
    /// The parameter tag for CAA records. Valid values are "issue", "issuewild", or "iodef"
    tag: option<string>,
    /// This value is the time to live for the record, in seconds. This defines the time frame that clients can cache queried information before a refresh should be requested.
    ttl: option<s32>,
    /// The type of the DNS record. For example: A, CNAME, TXT, ...
    type-op: string,
    /// The weight for SRV records.
    weight: option<s32>
  }
  domains-patch-record: func(params: domains-patch-record-params) -> result<string, string>;

  /// Delete a Domain Record
  record domains-delete-record-params {
    /// The name of the domain itself.
    domain-name: string,
    /// The unique identifier of the domain record.
    domain-record-id: string
  }
  domains-delete-record: func(params: domains-delete-record-params) -> result<string, string>;

}

interface droplets {
  /// List All Droplets
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>,
    /// Used to filter Droplets by a specific tag. Can not be combined with `name`.
    tag-name: option<string>,
    /// Used to filter list response by Droplet name returning only exact matches. It is case-insensitive and can not be combined with `tag_name`.
    name: option<string>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Create a New Droplet
  record create-params {
    body: option<string>
  }
  create: func(params: create-params) -> result<string, string>;

  /// Deleting Droplets by Tag
  record destroy-by-tag-params {
    /// Specifies Droplets to be deleted by tag.
    tag-name: string
  }
  destroy-by-tag: func(params: destroy-by-tag-params) -> result<string, string>;

  /// Retrieve an Existing Droplet
  record get-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Delete an Existing Droplet
  record destroy-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  destroy: func(params: destroy-params) -> result<string, string>;

  /// List Backups for a Droplet
  record list-backups-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-backups: func(params: list-backups-params) -> result<string, string>;

  /// List Associated Resources for a Droplet
  record list-associated-resources-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  list-associated-resources: func(params: list-associated-resources-params) -> result<string, string>;

  /// Destroy a Droplet and All of its Associated Resources (Dangerous)
  record destroy-with-associated-resources-dangerous-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Acknowledge this action will destroy the Droplet and all associated resources and _can not_ be reversed.
    x-dangerous: bool
  }
  destroy-with-associated-resources-dangerous: func(params: destroy-with-associated-resources-dangerous-params) -> result<string, string>;

  /// Retry a Droplet Destroy with Associated Resources Request
  record destroy-retry-with-associated-resources-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  destroy-retry-with-associated-resources: func(params: destroy-retry-with-associated-resources-params) -> result<string, string>;

  /// Selectively Destroy a Droplet and its Associated Resources
  record destroy-with-associated-resources-selective-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// An array of unique identifiers for the floating IPs to be scheduled for deletion.
    floating-ips: option<list<string>>,
    /// An array of unique identifiers for the reserved IPs to be scheduled for deletion.
    reserved-ips: option<list<string>>,
    /// An array of unique identifiers for the snapshots to be scheduled for deletion.
    snapshots: option<list<string>>,
    /// An array of unique identifiers for the volume snapshots to be scheduled for deletion.
    volume-snapshots: option<list<string>>,
    /// An array of unique identifiers for the volumes to be scheduled for deletion.
    volumes: option<list<string>>
  }
  destroy-with-associated-resources-selective: func(params: destroy-with-associated-resources-selective-params) -> result<string, string>;

  /// Check Status of a Droplet Destroy with Associated Resources Request
  record get-destroy-associated-resources-status-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  get-destroy-associated-resources-status: func(params: get-destroy-associated-resources-status-params) -> result<string, string>;

  /// List all Firewalls Applied to a Droplet
  record list-firewalls-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-firewalls: func(params: list-firewalls-params) -> result<string, string>;

  /// List All Available Kernels for a Droplet
  record list-kernels-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-kernels: func(params: list-kernels-params) -> result<string, string>;

  /// List Neighbors for a Droplet
  record list-neighbors-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string
  }
  list-neighbors: func(params: list-neighbors-params) -> result<string, string>;

  /// List Snapshots for a Droplet
  record list-snapshots-params {
    /// A unique identifier for a Droplet instance.
    droplet-id: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-snapshots: func(params: list-snapshots-params) -> result<string, string>;

  /// List All Droplet Neighbors
  list-neighbors-ids: func() -> result<string, string>;

}

interface droplet-actions {
  /// Acting on Tagged Droplets
  record post-by-tag-params {
    /// Used to filter Droplets by a specific tag. Can not be combined with `name`.
    tag-name: option<string>,
    body: option<string>
  }
  post-by-tag: func(params: post-by-tag-params) -> result<string, string>;

  /// List Actions for a Droplet
