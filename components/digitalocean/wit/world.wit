interface functions {
  /// Trigger details for SCHEDULED type, where body is optional.
  record create-trigger-body-scheduled-details {
    /// Optional data to be sent to function while triggering the function.
    body: option<create-trigger-body-scheduled-details-body>,
    /// valid cron expression string which is required for SCHEDULED type triggers.
    cron: string
  }

  /// Optional data to be sent to function while triggering the function.
  record create-trigger-body-scheduled-details-body {
    name: option<string>
  }

  /// Trigger details for SCHEDULED type, where body is optional.
  record update-trigger-body-scheduled-details {
    /// Optional data to be sent to function while triggering the function.
    body: option<update-trigger-body-scheduled-details-body>,
    /// valid cron expression string which is required for SCHEDULED type triggers.
    cron: string
  }

  /// Optional data to be sent to function while triggering the function.
  record update-trigger-body-scheduled-details-body {
    name: option<string>
  }

  /// List Namespaces
  list-namespaces: func() -> result<string, string>;

  /// Create Namespace
  record create-namespace-params {
    /// The namespace's unique name.
    label: string,
    /// The [datacenter region](https://docs.digitalocean.com/products/platform/availability-matrix/#available-datacenters) in which to create the namespace.
    region: string
  }
  create-namespace: func(params: create-namespace-params) -> result<string, string>;

  /// Get Namespace
  record get-namespace-params {
    /// The ID of the namespace to be managed.
    namespace-id: string
  }
  get-namespace: func(params: get-namespace-params) -> result<string, string>;

  /// Delete Namespace
  record delete-namespace-params {
    /// The ID of the namespace to be managed.
    namespace-id: string
  }
  delete-namespace: func(params: delete-namespace-params) -> result<string, string>;

  /// List Triggers
  record list-triggers-params {
    /// The ID of the namespace to be managed.
    namespace-id: string
  }
  list-triggers: func(params: list-triggers-params) -> result<string, string>;

  /// Create Trigger
  record create-trigger-params {
    /// The ID of the namespace to be managed.
    namespace-id: string,
    /// Name of function(action) that exists in the given namespace.
    function: string,
    /// Indicates weather the trigger is paused or unpaused.
    is-enabled: bool,
    /// The trigger's unique name within the namespace.
    name: string,
    /// Trigger details for SCHEDULED type, where body is optional.
    scheduled-details: create-trigger-body-scheduled-details,
    /// One of different type of triggers. Currently only SCHEDULED is supported.
    type-op: string
  }
  create-trigger: func(params: create-trigger-params) -> result<string, string>;

  /// Get Trigger
  record get-trigger-params {
    /// The ID of the namespace to be managed.
    namespace-id: string,
    /// The name of the trigger to be managed.
    trigger-name: string
  }
  get-trigger: func(params: get-trigger-params) -> result<string, string>;

  /// Update Trigger
  record update-trigger-params {
    /// The ID of the namespace to be managed.
    namespace-id: string,
    /// The name of the trigger to be managed.
    trigger-name: string,
    /// Indicates weather the trigger is paused or unpaused.
    is-enabled: option<bool>,
    /// Trigger details for SCHEDULED type, where body is optional.
    scheduled-details: option<update-trigger-body-scheduled-details>
  }
  update-trigger: func(params: update-trigger-params) -> result<string, string>;

  /// Delete Trigger
  record delete-trigger-params {
    /// The ID of the namespace to be managed.
    namespace-id: string,
    /// The name of the trigger to be managed.
    trigger-name: string
  }
  delete-trigger: func(params: delete-trigger-params) -> result<string, string>;

}

interface images {
  enum list-op-type-op-enum {
    application,
    distribution,
  }

  enum update-body-distribution-enum {
    arch-linux,
    cent-os,
    core-os,
    debian,
    fedora,
    fedora-atomic,
    free-bsd,
    gentoo,
    open-suse,
    rancher-os,
    rocky-linux,
    ubuntu,
    unknown,
  }

  /// List All Images
  record list-op-params {
    /// Filters results based on image type which can be either `application` or `distribution`.
    type-op: option<list-op-type-op-enum>,
    /// Used to filter only user images.
    private: option<bool>,
    /// Used to filter images by a specific tag.
    tag-name: option<string>,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Create a Custom Image
  record create-custom-params {
    body: string
  }
  create-custom: func(params: create-custom-params) -> result<string, string>;

  /// Retrieve an Existing Image
  record get-params {
    /// A unique number (id) or string (slug) used to identify and reference a
    /// specific image.
    image-id: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update an Image
  record update-params {
    /// A unique number that can be used to identify and reference a specific image.
    image-id: string,
    /// An optional free-form text field to describe an image.
    description: option<string>,
    /// The name of a custom image's distribution. Currently, the valid values are  `Arch Linux`, `CentOS`, `CoreOS`, `Debian`, `Fedora`, `Fedora Atomic`,  `FreeBSD`, `Gentoo`, `openSUSE`, `RancherOS`, `Rocky Linux`, `Ubuntu`, and `Unknown`.  Any other value will be accepted but ignored, and `Unknown` will be used in its place.
    distribution: option<update-body-distribution-enum>,
    /// The display name that has been given to an image.  This is what is shown in the control panel and is generally a descriptive title for the image in question.
    name: option<string>
  }
  update: func(params: update-params) -> result<string, string>;

  /// Delete an Image
  record delete-params {
    /// A unique number that can be used to identify and reference a specific image.
    image-id: string
  }
  delete: func(params: delete-params) -> result<string, string>;

}

interface image-actions {
  /// List All Actions for an Image
  record list-op-params {
    /// A unique number that can be used to identify and reference a specific image.
    image-id: string
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Initiate an Image Action
  record post-params {
    /// A unique number that can be used to identify and reference a specific image.
    image-id: string,
    body: option<string>
  }
  post: func(params: post-params) -> result<string, string>;

  /// Retrieve an Existing Action
  record get-params {
    /// A unique number that can be used to identify and reference a specific image.
    image-id: string,
    /// A unique numeric ID that can be used to identify and reference an action.
    action-id: string
  }
  get: func(params: get-params) -> result<string, string>;

}

interface kubernetes {
  enum create-cluster-body-maintenance-policy-day-enum {
    any,
    monday,
    tuesday,
    wednesday,
    thursday,
    friday,
    saturday,
    sunday,
  }

  enum create-cluster-body-status-state-enum {
    running,
    provisioning,
    degraded,
    error,
    deleted,
    upgrading,
    deleting,
  }

  /// An object specifying the maintenance window policy for the Kubernetes cluster.
  record create-cluster-body-maintenance-policy {
    /// The day of the maintenance window policy. May be one of `monday` through `sunday`, or `any` to indicate an arbitrary week day.
    day: option<create-cluster-body-maintenance-policy-day-enum>,
    /// The duration of the maintenance window policy in human-readable format.
    duration: option<string>,
    /// The start time in UTC of the maintenance window policy in 24-hour clock format / HH:MM notation (e.g., `15:00`).
    start-time: option<string>
  }

  /// An object containing a `state` attribute whose value is set to a string indicating the current status of the cluster.
  record create-cluster-body-status {
    /// An optional message providing additional information about the current cluster state.
    message: option<string>,
    /// A string indicating the current status of the cluster.
    state: option<create-cluster-body-status-state-enum>
  }

  /// An object specifying the maintenance window policy for the Kubernetes cluster.
  record update-cluster-body-maintenance-policy {
    /// The day of the maintenance window policy. May be one of `monday` through `sunday`, or `any` to indicate an arbitrary week day.
    day: option<create-cluster-body-maintenance-policy-day-enum>,
    /// The duration of the maintenance window policy in human-readable format.
    duration: option<string>,
    /// The start time in UTC of the maintenance window policy in 24-hour clock format / HH:MM notation (e.g., `15:00`).
    start-time: option<string>
  }

  /// List All Kubernetes Clusters
  record list-clusters-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-clusters: func(params: list-clusters-params) -> result<string, string>;

  /// Create a New Kubernetes Cluster
  record create-cluster-params {
    /// A boolean value indicating whether the cluster will be automatically upgraded to new patch releases during its maintenance window.
    auto-upgrade: option<bool>,
    /// The range of IP addresses in the overlay network of the Kubernetes cluster in CIDR notation.
    cluster-subnet: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the Kubernetes cluster was created.
    created-at: option<string>,
    /// The base URL of the API server on the Kubernetes master node.
    endpoint: option<string>,
    /// A boolean value indicating whether the control plane is run in a highly available configuration in the cluster. Highly available control planes incur less downtime. The property cannot be disabled.
    ha: option<bool>,
    /// A unique ID that can be used to identify and reference a Kubernetes cluster.
    id: option<string>,
    /// The public IPv4 address of the Kubernetes master node. This will not be set if high availability is configured on the cluster (v1.21+)
    ipv4: option<string>,
    /// An object specifying the maintenance window policy for the Kubernetes cluster.
    maintenance-policy: option<create-cluster-body-maintenance-policy>,
    /// A human-readable name for a Kubernetes cluster.
    name: string,
    /// An object specifying the details of the worker nodes available to the Kubernetes cluster.
    node-pools: list<string>,
    /// The slug identifier for the region where the Kubernetes cluster is located.
    region: string,
    /// A read-only boolean value indicating if a container registry is integrated with the cluster.
    registry-enabled: option<bool>,
    /// The range of assignable IP addresses for services running in the Kubernetes cluster in CIDR notation.
    service-subnet: option<string>,
    /// An object containing a `state` attribute whose value is set to a string indicating the current status of the cluster.
    status: option<create-cluster-body-status>,
    /// A boolean value indicating whether surge upgrade is enabled/disabled for the cluster. Surge upgrade makes cluster upgrades fast and reliable by bringing up new nodes before destroying the outdated nodes.
    surge-upgrade: option<bool>,
    /// An array of tags applied to the Kubernetes cluster. All clusters are automatically tagged `k8s` and `k8s:$K8S_CLUSTER_ID`.
    tags: option<list<string>>,
    /// A time value given in ISO8601 combined date and time format that represents when the Kubernetes cluster was last updated.
    updated-at: option<string>,
    /// The slug identifier for the version of Kubernetes used for the cluster. If set to a minor version (e.g. "1.14"), the latest version within it will be used (e.g. "1.14.6-do.1"); if set to "latest", the latest published version will be used. See the `/v2/kubernetes/options` endpoint to find all currently available versions.
    version: string,
    /// A string specifying the UUID of the VPC to which the Kubernetes cluster is assigned.
    vpc-uuid: option<string>
  }
  create-cluster: func(params: create-cluster-params) -> result<string, string>;

  /// Retrieve an Existing Kubernetes Cluster
  record get-cluster-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  get-cluster: func(params: get-cluster-params) -> result<string, string>;

  /// Update a Kubernetes Cluster
  record update-cluster-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A boolean value indicating whether the cluster will be automatically upgraded to new patch releases during its maintenance window.
    auto-upgrade: option<bool>,
    /// A boolean value indicating whether the control plane is run in a highly available configuration in the cluster. Highly available control planes incur less downtime. The property cannot be disabled.
    ha: option<bool>,
    /// An object specifying the maintenance window policy for the Kubernetes cluster.
    maintenance-policy: option<update-cluster-body-maintenance-policy>,
    /// A human-readable name for a Kubernetes cluster.
    name: string,
    /// A boolean value indicating whether surge upgrade is enabled/disabled for the cluster. Surge upgrade makes cluster upgrades fast and reliable by bringing up new nodes before destroying the outdated nodes.
    surge-upgrade: option<bool>,
    /// An array of tags applied to the Kubernetes cluster. All clusters are automatically tagged `k8s` and `k8s:$K8S_CLUSTER_ID`.
    tags: option<list<string>>
  }
  update-cluster: func(params: update-cluster-params) -> result<string, string>;

  /// Delete a Kubernetes Cluster
  record delete-cluster-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  delete-cluster: func(params: delete-cluster-params) -> result<string, string>;

  /// Fetch Clusterlint Diagnostics for a Kubernetes Cluster
  record get-cluster-lint-results-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// Specifies the clusterlint run whose results will be retrieved.
    run-id: option<string>
  }
  get-cluster-lint-results: func(params: get-cluster-lint-results-params) -> result<string, string>;

  /// Run Clusterlint Checks on a Kubernetes Cluster
  record run-cluster-lint-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// An array of checks that will be run when clusterlint executes checks.
    exclude-checks: option<list<string>>,
    /// An array of check groups that will be omitted when clusterlint executes checks.
    exclude-groups: option<list<string>>,
    /// An array of checks that will be run when clusterlint executes checks.
    include-checks: option<list<string>>,
    /// An array of check groups that will be run when clusterlint executes checks.
    include-groups: option<list<string>>
  }
  run-cluster-lint: func(params: run-cluster-lint-params) -> result<string, string>;

  /// Retrieve Credentials for a Kubernetes Cluster
  record get-credentials-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// The duration in seconds that the returned Kubernetes credentials will be valid. If not set or 0, the credentials will have a 7 day expiry.
    expiry-seconds: option<s32>
  }
  get-credentials: func(params: get-credentials-params) -> result<string, string>;

  /// List Associated Resources for Cluster Deletion
  record list-associated-resources-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  list-associated-resources: func(params: list-associated-resources-params) -> result<string, string>;

  /// Delete a Cluster and All of its Associated Resources (Dangerous)
  record destroy-associated-resources-dangerous-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  destroy-associated-resources-dangerous: func(params: destroy-associated-resources-dangerous-params) -> result<string, string>;

  /// Selectively Delete a Cluster and its Associated Resources
  record destroy-associated-resources-selective-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A list of IDs for associated load balancers to destroy along with the cluster.
    load-balancers: option<list<string>>,
    /// A list of IDs for associated volume snapshots to destroy along with the cluster.
    volume-snapshots: option<list<string>>,
    /// A list of IDs for associated volumes to destroy along with the cluster.
    volumes: option<list<string>>
  }
  destroy-associated-resources-selective: func(params: destroy-associated-resources-selective-params) -> result<string, string>;

  /// Retrieve the kubeconfig for a Kubernetes Cluster
  record get-kubeconfig-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// The duration in seconds that the returned Kubernetes credentials will be valid. If not set or 0, the credentials will have a 7 day expiry.
    expiry-seconds: option<s32>
  }
  get-kubeconfig: func(params: get-kubeconfig-params) -> result<string, string>;

  /// List All Node Pools in a Kubernetes Clusters
  record list-node-pools-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  list-node-pools: func(params: list-node-pools-params) -> result<string, string>;

  /// Add a Node Pool to a Kubernetes Cluster
  record add-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    body: string
  }
  add-node-pool: func(params: add-node-pool-params) -> result<string, string>;

  /// Retrieve a Node Pool for a Kubernetes Cluster
  record get-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string
  }
  get-node-pool: func(params: get-node-pool-params) -> result<string, string>;

  /// Update a Node Pool in a Kubernetes Cluster
  record update-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string,
    body: string
  }
  update-node-pool: func(params: update-node-pool-params) -> result<string, string>;

  /// Delete a Node Pool in a Kubernetes Cluster
  record delete-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string
  }
  delete-node-pool: func(params: delete-node-pool-params) -> result<string, string>;

  /// Delete a Node in a Kubernetes Cluster
  record delete-node-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string,
    /// A unique ID that can be used to reference a node in a Kubernetes node pool.
    node-id: string,
    /// Specifies whether or not to drain workloads from a node before it is deleted. Setting it to `1` causes node draining to be skipped. Omitting the query parameter or setting its value to `0` carries out draining prior to deletion.
    skip-drain: option<s32>,
    /// Specifies whether or not to replace a node after it has been deleted. Setting it to `1` causes the node to be replaced by a new one after deletion. Omitting the query parameter or setting its value to `0` deletes without replacement.
    replace: option<s32>
  }
  delete-node: func(params: delete-node-params) -> result<string, string>;

  /// Recycle a Kubernetes Node Pool
  record recycle-node-pool-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// A unique ID that can be used to reference a Kubernetes node pool.
    node-pool-id: string,
    nodes: option<list<string>>
  }
  recycle-node-pool: func(params: recycle-node-pool-params) -> result<string, string>;

  /// Upgrade a Kubernetes Cluster
  record upgrade-cluster-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string,
    /// The slug identifier for the version of Kubernetes that the cluster will be upgraded to.
    version: option<string>
  }
  upgrade-cluster: func(params: upgrade-cluster-params) -> result<string, string>;

  /// Retrieve Available Upgrades for an Existing Kubernetes Cluster
  record get-available-upgrades-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  get-available-upgrades: func(params: get-available-upgrades-params) -> result<string, string>;

  /// Retrieve User Information for a Kubernetes Cluster
  record get-cluster-user-params {
    /// A unique ID that can be used to reference a Kubernetes cluster.
    cluster-id: string
  }
  get-cluster-user: func(params: get-cluster-user-params) -> result<string, string>;

  /// List Available Regions, Node Sizes, and Versions of Kubernetes
  list-options: func() -> result<string, string>;

  /// Add Container Registry to Kubernetes Clusters
  record add-registry-params {
    /// An array containing the UUIDs of Kubernetes clusters.
    cluster-uuids: option<list<string>>
  }
  add-registry: func(params: add-registry-params) -> result<string, string>;

  /// Remove Container Registry from Kubernetes Clusters
  record remove-registry-params {
    /// An array containing the UUIDs of Kubernetes clusters.
    cluster-uuids: option<list<string>>
  }
  remove-registry: func(params: remove-registry-params) -> result<string, string>;

}

interface load-balancers {
  enum add-forwarding-rules-body-forwarding-rules-item-entry-protocol-enum {
    http,
    https,
    http2,
    http3,
    tcp,
    udp,
  }

  enum add-forwarding-rules-body-forwarding-rules-item-target-protocol-enum {
    http,
    https,
    http2,
    tcp,
    udp,
  }

  /// An object specifying a forwarding rule for a load balancer.
  record add-forwarding-rules-body-forwarding-rules-item {
    /// The ID of the TLS certificate used for SSL termination if enabled.
    certificate-id: option<string>,
    /// An integer representing the port on which the load balancer instance will listen.
    entry-port: s32,
    /// The protocol used for traffic to the load balancer. The possible values are: `http`, `https`, `http2`, `http3`, `tcp`, or `udp`. If you set the  `entry_protocol` to `udp`, the `target_protocol` must be set to `udp`.  When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    entry-protocol: add-forwarding-rules-body-forwarding-rules-item-entry-protocol-enum,
    /// An integer representing the port on the backend Droplets to which the load balancer will send traffic.
    target-port: s32,
    /// The protocol used for traffic from the load balancer to the backend Droplets. The possible values are: `http`, `https`, `http2`, `tcp`, or `udp`. If you set the `target_protocol` to `udp`, the `entry_protocol` must be set to  `udp`. When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    target-protocol: add-forwarding-rules-body-forwarding-rules-item-target-protocol-enum,
    /// A boolean value indicating whether SSL encrypted traffic will be passed through to the backend Droplets.
    tls-passthrough: option<bool>
  }

  /// An object specifying a forwarding rule for a load balancer.
  record remove-forwarding-rules-body-forwarding-rules-item {
    /// The ID of the TLS certificate used for SSL termination if enabled.
    certificate-id: option<string>,
    /// An integer representing the port on which the load balancer instance will listen.
    entry-port: s32,
    /// The protocol used for traffic to the load balancer. The possible values are: `http`, `https`, `http2`, `http3`, `tcp`, or `udp`. If you set the  `entry_protocol` to `udp`, the `target_protocol` must be set to `udp`.  When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    entry-protocol: add-forwarding-rules-body-forwarding-rules-item-entry-protocol-enum,
    /// An integer representing the port on the backend Droplets to which the load balancer will send traffic.
    target-port: s32,
    /// The protocol used for traffic from the load balancer to the backend Droplets. The possible values are: `http`, `https`, `http2`, `tcp`, or `udp`. If you set the `target_protocol` to `udp`, the `entry_protocol` must be set to  `udp`. When using UDP, the load balancer requires that you set up a health  check with a port that uses TCP, HTTP, or HTTPS to work properly.
    target-protocol: add-forwarding-rules-body-forwarding-rules-item-target-protocol-enum,
    /// A boolean value indicating whether SSL encrypted traffic will be passed through to the backend Droplets.
    tls-passthrough: option<bool>
  }

  /// List All Load Balancers
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Create a New Load Balancer
  record create-params {
    body: string
  }
  create: func(params: create-params) -> result<string, string>;

  /// Retrieve an Existing Load Balancer
  record get-params {
    /// A unique identifier for a load balancer.
    lb-id: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update a Load Balancer
  record update-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    body: string
  }
  update: func(params: update-params) -> result<string, string>;

  /// Delete a Load Balancer
  record delete-params {
    /// A unique identifier for a load balancer.
    lb-id: string
  }
  delete: func(params: delete-params) -> result<string, string>;

  /// Add Droplets to a Load Balancer
  record add-droplets-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    /// An array containing the IDs of the Droplets assigned to the load balancer.
    droplet-ids: option<list<s32>>
  }
  add-droplets: func(params: add-droplets-params) -> result<string, string>;

  /// Remove Droplets from a Load Balancer
  record remove-droplets-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    /// An array containing the IDs of the Droplets assigned to the load balancer.
    droplet-ids: option<list<s32>>
  }
  remove-droplets: func(params: remove-droplets-params) -> result<string, string>;

  /// Add Forwarding Rules to a Load Balancer
  record add-forwarding-rules-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    forwarding-rules: list<add-forwarding-rules-body-forwarding-rules-item>
  }
  add-forwarding-rules: func(params: add-forwarding-rules-params) -> result<string, string>;

  /// Remove Forwarding Rules from a Load Balancer
  record remove-forwarding-rules-params {
    /// A unique identifier for a load balancer.
    lb-id: string,
    forwarding-rules: list<remove-forwarding-rules-body-forwarding-rules-item>
  }
  remove-forwarding-rules: func(params: remove-forwarding-rules-params) -> result<string, string>;

}

interface monitoring {
  enum create-alert-policy-body-compare-enum {
    greater-than,
    less-than,
  }

  enum create-alert-policy-body-type-op-enum {
    v1-insights-droplet-load-v1,
    v1-insights-droplet-load-v5,
    v1-insights-droplet-load-v15,
    v1-insights-droplet-memory-utilization-percent,
    v1-insights-droplet-disk-utilization-percent,
    v1-insights-droplet-cpu,
    v1-insights-droplet-disk-read,
    v1-insights-droplet-disk-write,
    v1-insights-droplet-public-outbound-bandwidth,
    v1-insights-droplet-public-inbound-bandwidth,
    v1-insights-droplet-private-outbound-bandwidth,
    v1-insights-droplet-private-inbound-bandwidth,
    v1-insights-lbaas-avg-cpu-utilization-percent,
    v1-insights-lbaas-connection-utilization-percent,
    v1-insights-lbaas-droplet-health,
    v1-insights-lbaas-tls-connections-per-second-utilization-percent,
    v1-insights-lbaas-increase-in-http-error-rate-percentage-v5xx,
    v1-insights-lbaas-increase-in-http-error-rate-percentage-v4xx,
    v1-insights-lbaas-increase-in-http-error-rate-count-v5xx,
    v1-insights-lbaas-increase-in-http-error-rate-count-v4xx,
    v1-insights-lbaas-high-http-request-response-time,
    v1-insights-lbaas-high-http-request-response-time-v50p,
    v1-insights-lbaas-high-http-request-response-time-v95p,
    v1-insights-lbaas-high-http-request-response-time-v99p,
    v1-dbaas-alerts-load-v15-alerts,
    v1-dbaas-alerts-memory-utilization-alerts,
    v1-dbaas-alerts-disk-utilization-alerts,
    v1-dbaas-alerts-cpu-alerts,
  }

  enum create-alert-policy-body-window-enum {
    v5m,
    v10m,
    v30m,
    v1h,
  }

  enum get-droplet-bandwidth-metrics-interface-op-enum {
    private,
    public,
  }

  enum get-droplet-bandwidth-metrics-direction-enum {
    inbound,
    outbound,
  }

  record create-alert-policy-body-alerts {
    /// An email to notify on an alert trigger.
    email: list<string>,
    /// Slack integration details.
    slack: list<create-alert-policy-body-alerts-slack-item>
  }

  record create-alert-policy-body-alerts-slack-item {
    /// Slack channel to notify of an alert trigger.
    channel: string,
    /// Slack Webhook URL.
    url: string
  }

  record update-alert-policy-body-alerts {
    /// An email to notify on an alert trigger.
    email: list<string>,
    /// Slack integration details.
    slack: list<update-alert-policy-body-alerts-slack-item>
  }

  record update-alert-policy-body-alerts-slack-item {
    /// Slack channel to notify of an alert trigger.
    channel: string,
    /// Slack Webhook URL.
    url: string
  }

  /// List Alert Policies
  record list-alert-policy-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-alert-policy: func(params: list-alert-policy-params) -> result<string, string>;

  /// Create Alert Policy
  record create-alert-policy-params {
    alerts: create-alert-policy-body-alerts,
    compare: create-alert-policy-body-compare-enum,
    description: string,
    enabled: bool,
    entities: list<string>,
    tags: list<string>,
    type-op: create-alert-policy-body-type-op-enum,
    value: f64,
    window: create-alert-policy-body-window-enum
  }
  create-alert-policy: func(params: create-alert-policy-params) -> result<string, string>;

  /// Retrieve an Existing Alert Policy
  record get-alert-policy-params {
    /// A unique identifier for an alert policy.
    alert-uuid: string
  }
  get-alert-policy: func(params: get-alert-policy-params) -> result<string, string>;

  /// Update an Alert Policy
  record update-alert-policy-params {
    /// A unique identifier for an alert policy.
    alert-uuid: string,
    alerts: update-alert-policy-body-alerts,
    compare: create-alert-policy-body-compare-enum,
    description: string,
    enabled: bool,
    entities: list<string>,
    tags: list<string>,
    type-op: create-alert-policy-body-type-op-enum,
    value: f64,
    window: create-alert-policy-body-window-enum
  }
  update-alert-policy: func(params: update-alert-policy-params) -> result<string, string>;

  /// Delete an Alert Policy
  record delete-alert-policy-params {
    /// A unique identifier for an alert policy.
    alert-uuid: string
  }
  delete-alert-policy: func(params: delete-alert-policy-params) -> result<string, string>;

  /// Get Droplet Bandwidth Metrics
  record get-droplet-bandwidth-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// The network interface.
    interface-op: get-droplet-bandwidth-metrics-interface-op-enum,
    /// The traffic direction.
    direction: get-droplet-bandwidth-metrics-direction-enum,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-bandwidth-metrics: func(params: get-droplet-bandwidth-metrics-params) -> result<string, string>;

  /// Get Droplet CPU Metrics
  record get-droplet-cpu-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-cpu-metrics: func(params: get-droplet-cpu-metrics-params) -> result<string, string>;

  /// Get Droplet Filesystem Free Metrics
  record get-droplet-filesystem-free-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-filesystem-free-metrics: func(params: get-droplet-filesystem-free-metrics-params) -> result<string, string>;

  /// Get Droplet Filesystem Size Metrics
  record get-droplet-filesystem-size-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-filesystem-size-metrics: func(params: get-droplet-filesystem-size-metrics-params) -> result<string, string>;

  /// Get Droplet Load1 Metrics
  record get-droplet-load1-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-load1-metrics: func(params: get-droplet-load1-metrics-params) -> result<string, string>;

  /// Get Droplet Load15 Metrics
  record get-droplet-load15-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-load15-metrics: func(params: get-droplet-load15-metrics-params) -> result<string, string>;

  /// Get Droplet Load5 Metrics
  record get-droplet-load5-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-load5-metrics: func(params: get-droplet-load5-metrics-params) -> result<string, string>;

  /// Get Droplet Available Memory Metrics
  record get-droplet-memory-available-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-memory-available-metrics: func(params: get-droplet-memory-available-metrics-params) -> result<string, string>;

  /// Get Droplet Cached Memory Metrics
  record get-droplet-memory-cached-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-memory-cached-metrics: func(params: get-droplet-memory-cached-metrics-params) -> result<string, string>;

  /// Get Droplet Free Memory Metrics
  record get-droplet-memory-free-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-memory-free-metrics: func(params: get-droplet-memory-free-metrics-params) -> result<string, string>;

  /// Get Droplet Total Memory Metrics
  record get-droplet-memory-total-metrics-params {
    /// The droplet ID.
    host-id: string,
    /// Timestamp to start metric window.
    start: string,
    /// Timestamp to end metric window.
    end: string
  }
  get-droplet-memory-total-metrics: func(params: get-droplet-memory-total-metrics-params) -> result<string, string>;

}

interface projects {
  /// List All Projects
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Create a Project
