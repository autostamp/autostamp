  /// List All Database Clusters
  record list-clusters-params {
    /// Limits the results to database clusters with a specific tag.
    tag-name: option<string>
  }
  list-clusters: func(params: list-clusters-params) -> result<list-clusters-response, list-clusters-error>;

  /// Create a New Database Cluster
  record create-cluster-params {
    connection: option<create-cluster-body-connection>,
    /// A time value given in ISO8601 combined date and time format that represents when the database cluster was created.
    created-at: option<string>,
    /// An array of strings containing the names of databases created in the database cluster.
    db-names: option<list<string>>,
    /// A slug representing the database engine used for the cluster. The possible values are: "pg" for PostgreSQL, "mysql" for MySQL, "redis" for Redis, and "mongodb" for MongoDB.
    engine: list-clusters-response-databases-item-engine-enum,
    /// A unique ID that can be used to identify and reference a database cluster.
    id: option<string>,
    maintenance-window: option<create-cluster-body-maintenance-window>,
    /// A unique, human-readable name referring to a database cluster.
    name: string,
    /// The number of nodes in the database cluster.
    num-nodes: s32,
    private-connection: option<create-cluster-body-private-connection>,
    /// A string specifying the UUID of the VPC to which the database cluster will be assigned. If excluded, the cluster when creating a new database cluster, it will be assigned to your account's default VPC for the region.
    private-network-uuid: option<string>,
    /// The ID of the project that the database cluster is assigned to. If excluded when creating a new database cluster, it will be assigned to your default project.
    project-id: option<string>,
    /// The slug identifier for the region where the database cluster is located.
    region: string,
    rules: option<list<create-cluster-body-rules-item>>,
    /// A string representing the semantic version of the database engine in use for the cluster.
    semantic-version: option<string>,
    /// The slug identifier representing the size of the nodes in the database cluster.
    size: string,
    /// A string representing the current status of the database cluster.
    status: option<list-clusters-response-databases-item-status-enum>,
    /// An array of tags that have been applied to the database cluster.
    tags: option<list<string>>,
    users: option<list<create-cluster-body-users-item>>,
    /// A string representing the version of the database engine in use for the cluster.
    version: option<string>,
    /// A timestamp referring to the date when the particular version will no longer be available for creating new clusters. If null, the version does not have an end of availability timeline.
    version-end-of-availability: option<string>,
    /// A timestamp referring to the date when the particular version will no longer be supported. If null, the version does not have an end of life timeline.
    version-end-of-life: option<string>,
    backup-restore: option<create-cluster-body-backup-restore>
  }
  create-cluster: func(params: create-cluster-params) -> result<create-cluster-response, create-cluster-error>;

  /// List Database Options
  list-options: func() -> result<list-options-response, list-options-error>;

  /// Retrieve an Existing Database Cluster
  record get-cluster-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-cluster: func(params: get-cluster-params) -> result<get-cluster-response, get-cluster-error>;

  /// Destroy a Database Cluster
  record destroy-cluster-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  destroy-cluster: func(params: destroy-cluster-params) -> result<string, destroy-cluster-error>;

  /// List Backups for a Database Cluster
  record list-backups-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-backups: func(params: list-backups-params) -> result<list-backups-response, list-backups-error>;

  /// Retrieve the Public Certificate
  record get-ca-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-ca: func(params: get-ca-params) -> result<get-ca-response, get-ca-error>;

  /// Retrieve an Existing Database Cluster Configuration
  record get-config-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-config: func(params: get-config-params) -> result<get-config-response, get-config-error>;

  /// Update the Database Configuration for an Existing Database
  record patch-config-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    config: option<string>
  }
  patch-config: func(params: patch-config-params) -> result<string, patch-config-error>;

  /// List All Databases
  record list-op-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Add a New Database
  record add-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database.
    name: string
  }
  add: func(params: add-params) -> result<add-response, add-error>;

  /// Retrieve an Existing Database
  record get-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database.
    database-name: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Delete a Database
  record delete-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database.
    database-name: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

  /// Retrieve the Eviction Policy for a Redis Cluster
  record get-eviction-policy-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-eviction-policy: func(params: get-eviction-policy-params) -> result<get-eviction-policy-response, get-eviction-policy-error>;

  /// Configure the Eviction Policy for a Redis Cluster
  record update-eviction-policy-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A string specifying the desired eviction policy for the Redis cluster.
    /// 
    eviction-policy: get-eviction-policy-response-eviction-policy-enum
  }
  update-eviction-policy: func(params: update-eviction-policy-params) -> result<string, update-eviction-policy-error>;

  /// List Firewall Rules (Trusted Sources) for a Database Cluster
  record list-firewall-rules-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-firewall-rules: func(params: list-firewall-rules-params) -> result<list-firewall-rules-response, list-firewall-rules-error>;

  /// Update Firewall Rules (Trusted Sources) for a Database
  record update-firewall-rules-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    rules: option<list<update-firewall-rules-body-rules-item>>
  }
  update-firewall-rules: func(params: update-firewall-rules-params) -> result<string, update-firewall-rules-error>;

  /// Configure a Database Cluster's Maintenance Window
  record update-maintenance-window-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The day of the week on which to apply maintenance updates.
    day: string,
    /// A list of strings, each containing information about a pending maintenance update.
    description: option<list<string>>,
    /// The hour in UTC at which maintenance updates will be applied in 24 hour format.
    hour: string,
    /// A boolean value indicating whether any maintenance is scheduled to be performed in the next window.
    pending: option<bool>
  }
  update-maintenance-window: func(params: update-maintenance-window-params) -> result<string, update-maintenance-window-error>;

  /// Migrate a Database Cluster to a New Region
  record update-region-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A slug identifier for the region to which the database cluster will be migrated.
    region: string
  }
  update-region: func(params: update-region-params) -> result<string, update-region-error>;

  /// Retrieve the Status of an Online Migration
  record get-migration-status-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-migration-status: func(params: get-migration-status-params) -> result<get-migration-status-response, get-migration-status-error>;

  /// Start an Online Migration
  record update-online-migration-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// Enables SSL encryption when connecting to the source database.
    disable-ssl: option<bool>,
    source: option<update-online-migration-body-source>
  }
  update-online-migration: func(params: update-online-migration-params) -> result<update-online-migration-response, update-online-migration-error>;

  /// Stop an Online Migration
  record delete-online-migration-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A unique identifier assigned to the online migration.
    migration-id: string
  }
  delete-online-migration: func(params: delete-online-migration-params) -> result<string, delete-online-migration-error>;

  /// List Connection Pools (PostgreSQL)
  record list-connection-pools-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-connection-pools: func(params: list-connection-pools-params) -> result<list-connection-pools-response, list-connection-pools-error>;

  /// Add a New Connection Pool (PostgreSQL)
  record add-connection-pool-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    connection: option<add-connection-pool-body-connection>,
    /// The database for use with the connection pool.
    db: string,
    /// The PGBouncer transaction mode for the connection pool. The allowed values are session, transaction, and statement.
    mode: string,
    /// A unique name for the connection pool. Must be between 3 and 60 characters.
    name: string,
    private-connection: option<add-connection-pool-body-private-connection>,
    /// The desired size of the PGBouncer connection pool. The maximum allowed size is determined by the size of the cluster's primary node. 25 backend server connections are allowed for every 1GB of RAM. Three are reserved for maintenance. For example, a primary node with 1 GB of RAM allows for a maximum of 22 backend server connections while one with 4 GB would allow for 97. Note that these are shared across all connection pools in a cluster.
    size: s32,
    /// The name of the user for use with the connection pool. When excluded, all sessions connect to the database as the inbound user.
    user: option<string>
  }
  add-connection-pool: func(params: add-connection-pool-params) -> result<add-connection-pool-response, add-connection-pool-error>;

  /// Retrieve Existing Connection Pool (PostgreSQL)
  record get-connection-pool-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name used to identify the connection pool.
    pool-name: string
  }
  get-connection-pool: func(params: get-connection-pool-params) -> result<get-connection-pool-response, get-connection-pool-error>;

  /// Update Connection Pools (PostgreSQL)
  record update-connection-pool-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name used to identify the connection pool.
    pool-name: string,
    /// The database for use with the connection pool.
    db: string,
    /// The PGBouncer transaction mode for the connection pool. The allowed values are session, transaction, and statement.
    mode: string,
    /// The desired size of the PGBouncer connection pool. The maximum allowed size is determined by the size of the cluster's primary node. 25 backend server connections are allowed for every 1GB of RAM. Three are reserved for maintenance. For example, a primary node with 1 GB of RAM allows for a maximum of 22 backend server connections while one with 4 GB would allow for 97. Note that these are shared across all connection pools in a cluster.
    size: s32,
    /// The name of the user for use with the connection pool. When excluded, all sessions connect to the database as the inbound user.
    user: option<string>
  }
  update-connection-pool: func(params: update-connection-pool-params) -> result<string, update-connection-pool-error>;

  /// Delete a Connection Pool (PostgreSQL)
  record delete-connection-pool-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name used to identify the connection pool.
    pool-name: string
  }
  delete-connection-pool: func(params: delete-connection-pool-params) -> result<string, delete-connection-pool-error>;

  /// List All Read-only Replicas
  record list-replicas-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-replicas: func(params: list-replicas-params) -> result<list-replicas-response, list-replicas-error>;

  /// Create a Read-only Replica
  record create-replica-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    body: option<string>
  }
  create-replica: func(params: create-replica-params) -> result<create-replica-response, create-replica-error>;

  /// Retrieve an Existing Read-only Replica
  record get-replica-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database replica.
    replica-name: string
  }
  get-replica: func(params: get-replica-params) -> result<get-replica-response, get-replica-error>;

  /// Destroy a Read-only Replica
  record destroy-replica-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database replica.
    replica-name: string
  }
  destroy-replica: func(params: destroy-replica-params) -> result<string, destroy-replica-error>;

  /// Promote a Read-only Replica to become a Primary Cluster
  record promote-replica-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database replica.
    replica-name: string
  }
  promote-replica: func(params: promote-replica-params) -> result<string, promote-replica-error>;

  /// Resize a Database Cluster
  record update-cluster-size-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The number of nodes in the database cluster. Valid values are are 1-3. In addition to the primary node, up to two standby nodes may be added for highly available configurations.
    num-nodes: s32,
    /// A slug identifier representing desired the size of the nodes in the database cluster.
    size: string
  }
  update-cluster-size: func(params: update-cluster-size-params) -> result<string, update-cluster-size-error>;

  /// Retrieve the SQL Modes for a MySQL Cluster
  record get-sql-mode-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  get-sql-mode: func(params: get-sql-mode-params) -> result<get-sql-mode-response, get-sql-mode-error>;

  /// Update SQL Mode for a Cluster
  record update-sql-mode-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A string specifying the configured SQL modes for the MySQL cluster.
    sql-mode: string
  }
  update-sql-mode: func(params: update-sql-mode-params) -> result<string, update-sql-mode-error>;

  /// Upgrade Major Version for a Database
  record update-major-version-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// A string representing the version of the database engine in use for the cluster.
    version: option<string>
  }
  update-major-version: func(params: update-major-version-params) -> result<string, update-major-version-error>;

  /// List all Database Users
  record list-users-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string
  }
  list-users: func(params: list-users-params) -> result<list-users-response, list-users-error>;

  /// Add a Database User
  record add-user-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    mysql-settings: option<add-user-body-mysql-settings>,
    /// The name of a database user.
    name: string,
    /// A randomly generated password for the database user.
    password: option<string>,
    /// A string representing the database user's role. The value will be either
    /// "primary" or "normal".
    role: option<list-clusters-response-databases-item-users-item-role-enum>
  }
  add-user: func(params: add-user-params) -> result<add-user-response, add-user-error>;

  /// Retrieve an Existing Database User
  record get-user-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database user.
    username: string
  }
  get-user: func(params: get-user-params) -> result<get-user-response, get-user-error>;

  /// Remove a Database User
  record delete-user-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database user.
    username: string
  }
  delete-user: func(params: delete-user-params) -> result<string, delete-user-error>;

  /// Reset a Database User's Password or Authentication Method
  record reset-auth-params {
    /// A unique identifier for a database cluster.
    database-cluster-uuid: string,
    /// The name of the database user.
    username: string,
    mysql-settings: option<reset-auth-body-mysql-settings>
  }
  reset-auth: func(params: reset-auth-params) -> result<reset-auth-response, reset-auth-error>;

}

interface domains {
  record list-op-response {
    /// Array of volumes.
    domains: list<list-op-response-domains-item>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  record list-op-response-domains-item {
    /// This optional attribute may contain an IP address. When provided, an A record will be automatically created pointing to the apex domain.
    ip-address: option<string>,
    /// The name of the domain itself. This should follow the standard domain format of domain.TLD. For instance, `example.com` is a valid domain name.
    name: option<string>,
    /// This value is the time to live for the records on this domain, in seconds. This defines the time frame that clients can cache queried information before a refresh should be requested.
    ttl: option<s32>,
    /// This attribute contains the complete contents of the zone file for the selected domain. Individual domain record resources should be used to get more granular control over records. However, this attribute can also be used to get information about the SOA record, which is created automatically and is not accessible as an individual record resource.
    zone-file: option<string>
  }

  record list-op-response-links {
    pages: option<string>
  }

  record list-op-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record create-response {
    domain: option<create-response-domain>
  }

  record create-response-domain {
    /// This optional attribute may contain an IP address. When provided, an A record will be automatically created pointing to the apex domain.
    ip-address: option<string>,
    /// The name of the domain itself. This should follow the standard domain format of domain.TLD. For instance, `example.com` is a valid domain name.
    name: option<string>,
    /// This value is the time to live for the records on this domain, in seconds. This defines the time frame that clients can cache queried information before a refresh should be requested.
    ttl: option<s32>,
    /// This attribute contains the complete contents of the zone file for the selected domain. Individual domain record resources should be used to get more granular control over records. However, this attribute can also be used to get information about the SOA record, which is created automatically and is not accessible as an individual record resource.
    zone-file: option<string>
  }

  record get-response {
    domain: option<get-response-domain>
  }

  record get-response-domain {
    /// This optional attribute may contain an IP address. When provided, an A record will be automatically created pointing to the apex domain.
    ip-address: option<string>,
    /// The name of the domain itself. This should follow the standard domain format of domain.TLD. For instance, `example.com` is a valid domain name.
    name: option<string>,
    /// This value is the time to live for the records on this domain, in seconds. This defines the time frame that clients can cache queried information before a refresh should be requested.
    ttl: option<s32>,
    /// This attribute contains the complete contents of the zone file for the selected domain. Individual domain record resources should be used to get more granular control over records. However, this attribute can also be used to get information about the SOA record, which is created automatically and is not accessible as an individual record resource.
    zone-file: option<string>
  }

  variant list-op-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant create-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Domains
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Create a New Domain
  record create-params {
    /// This optional attribute may contain an IP address. When provided, an A record will be automatically created pointing to the apex domain.
    ip-address: option<string>,
    /// The name of the domain itself. This should follow the standard domain format of domain.TLD. For instance, `example.com` is a valid domain name.
    name: option<string>,
    /// This value is the time to live for the records on this domain, in seconds. This defines the time frame that clients can cache queried information before a refresh should be requested.
    ttl: option<s32>,
    /// This attribute contains the complete contents of the zone file for the selected domain. Individual domain record resources should be used to get more granular control over records. However, this attribute can also be used to get information about the SOA record, which is created automatically and is not accessible as an individual record resource.
    zone-file: option<string>
  }
  create: func(params: create-params) -> result<create-response, create-error>;

  /// Retrieve an Existing Domain
  record get-params {
    /// The name of the domain itself.
    domain-name: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Delete a Domain
  record delete-params {
    /// The name of the domain itself.
    domain-name: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

}

interface domain-records {
  enum domains-list-records-type-op-enum {
    a,
    aaaa,
    caa,
    cname,
    mx,
    ns,
    soa,
    srv,
    txt,
  }

  record domains-list-records-response {
    domain-records: option<list<domains-list-records-response-domain-records-item>>,
    links: option<domains-list-records-response-links>,
    meta: domains-list-records-response-meta
  }

  record domains-list-records-response-domain-records-item {
    /// Variable data depending on record type. For example, the "data" value for an A record would be the IPv4 address to which the domain will be mapped. For a CAA record, it would contain the domain name of the CA being granted permission to issue certificates.
    data: option<string>,
    /// An unsigned integer between 0-255 used for CAA records.
    flags-op: option<s32>,
    /// A unique identifier for each domain record.
    id: option<s32>,
    /// The host name, alias, or service being defined by the record.
    name: option<string>,
    /// The port for SRV records.
    port: option<s32>,
    /// The priority for SRV and MX records.
    priority: option<s32>,
    /// The parameter tag for CAA records. Valid values are "issue", "issuewild", or "iodef"
    tag: option<string>,
    /// This value is the time to live for the record, in seconds. This defines the time frame that clients can cache queried information before a refresh should be requested.
    ttl: option<s32>,
    /// The type of the DNS record. For example: A, CNAME, TXT, ...
    type-op: string,
    /// The weight for SRV records.
    weight: option<s32>
  }

  record domains-list-records-response-links {
    pages: option<string>
  }

  record domains-list-records-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
