/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `bearer_auth` | `Authorization: Bearer <secret>` |
package autostamp:digitalocean@0.6.0;

interface v1-click-applications {
  enum one-clicks-list-type-op-enum {
    droplet,
    kubernetes,
  }

  record one-clicks-list-response {
    v1-clicks: option<list<one-clicks-list-response-v1-clicks-item>>
  }

  record one-clicks-list-response-v1-clicks-item {
    /// The slug identifier for the 1-Click application.
    slug: string,
    /// The type of the 1-Click application.
    type-op: string
  }

  record one-clicks-install-kubernetes-response {
    /// A message about the result of the request.
    message: option<string>
  }

  variant one-clicks-list-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant one-clicks-install-kubernetes-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List 1-Click Applications
  record one-clicks-list-params {
    /// Restrict results to a certain type of 1-Click.
    type-op: option<one-clicks-list-type-op-enum>
  }
  one-clicks-list: func(params: one-clicks-list-params) -> result<one-clicks-list-response, one-clicks-list-error>;

  /// Install Kubernetes 1-Click Applications
  record one-clicks-install-kubernetes-params {
    /// An array of 1-Click Application slugs to be installed to the Kubernetes cluster.
    addon-slugs: list<string>,
    /// A unique ID for the Kubernetes cluster to which the 1-Click Applications will be installed.
    cluster-uuid: string
  }
  one-clicks-install-kubernetes: func(params: one-clicks-install-kubernetes-params) -> result<one-clicks-install-kubernetes-response, one-clicks-install-kubernetes-error>;

}


interface account {
  enum get-response-account-status-enum {
    active,
    warning,
    locked,
  }

  record get-response {
    account: option<get-response-account>
  }

  record get-response-account {
    /// The total number of Droplets current user or team may have active at one time.
    droplet-limit: s32,
    /// The email address used by the current user to register for DigitalOcean.
    email: string,
    /// If true, the user has verified their account via email. False otherwise.
    email-verified: bool,
    /// The total number of Floating IPs the current user or team may have.
    floating-ip-limit: s32,
    /// This value is one of "active", "warning" or "locked".
    status: get-response-account-status-enum,
    /// A human-readable message giving more details about the status of the account.
    status-message: string,
    /// When authorized in a team context, includes information about the current team.
    team: option<get-response-account-team>,
    /// The unique universal identifier for the current user.
    uuid: string
  }

  /// When authorized in a team context, includes information about the current team.
  record get-response-account-team {
    /// The name for the current team.
    name: option<string>,
    /// The unique universal identifier for the current team.
    uuid: option<string>
  }

  variant get-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// Get User Information
  get: func() -> result<get-response, get-error>;

}

interface ssh-keys {
  record list-op-response {
    ssh-keys: option<list<list-op-response-ssh-keys-item>>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  record list-op-response-ssh-keys-item {
    /// A unique identifier that differentiates this key from other keys using  a format that SSH recognizes. The fingerprint is created when the key is added to your account.
    fingerprint: option<string>,
    /// A unique identification number for this key. Can be used to embed a  specific SSH key into a Droplet.
    id: option<s32>,
    /// A human-readable display name for this key, used to easily identify the SSH keys when they are displayed.
    name: string,
    /// The entire public key string that was uploaded. Embedded into the root user's `authorized_keys` file if you include this key during Droplet creation.
    public-key: string
  }

  record list-op-response-links {
    pages: option<string>
  }

  record list-op-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record create-response {
    ssh-key: option<create-response-ssh-key>
  }

  record create-response-ssh-key {
    /// A unique identifier that differentiates this key from other keys using  a format that SSH recognizes. The fingerprint is created when the key is added to your account.
    fingerprint: option<string>,
    /// A unique identification number for this key. Can be used to embed a  specific SSH key into a Droplet.
    id: option<s32>,
    /// A human-readable display name for this key, used to easily identify the SSH keys when they are displayed.
    name: string,
    /// The entire public key string that was uploaded. Embedded into the root user's `authorized_keys` file if you include this key during Droplet creation.
    public-key: string
  }

  record get-response {
    ssh-key: option<get-response-ssh-key>
  }

  record get-response-ssh-key {
    /// A unique identifier that differentiates this key from other keys using  a format that SSH recognizes. The fingerprint is created when the key is added to your account.
    fingerprint: option<string>,
    /// A unique identification number for this key. Can be used to embed a  specific SSH key into a Droplet.
    id: option<s32>,
    /// A human-readable display name for this key, used to easily identify the SSH keys when they are displayed.
    name: string,
    /// The entire public key string that was uploaded. Embedded into the root user's `authorized_keys` file if you include this key during Droplet creation.
    public-key: string
  }

  record update-response {
    ssh-key: option<update-response-ssh-key>
  }

  record update-response-ssh-key {
    /// A unique identifier that differentiates this key from other keys using  a format that SSH recognizes. The fingerprint is created when the key is added to your account.
    fingerprint: option<string>,
    /// A unique identification number for this key. Can be used to embed a  specific SSH key into a Droplet.
    id: option<s32>,
    /// A human-readable display name for this key, used to easily identify the SSH keys when they are displayed.
    name: string,
    /// The entire public key string that was uploaded. Embedded into the root user's `authorized_keys` file if you include this key during Droplet creation.
    public-key: string
  }

  variant list-op-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant create-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant update-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All SSH Keys
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Create a New SSH Key
  record create-params {
    /// A unique identifier that differentiates this key from other keys using  a format that SSH recognizes. The fingerprint is created when the key is added to your account.
    fingerprint: option<string>,
    /// A unique identification number for this key. Can be used to embed a  specific SSH key into a Droplet.
    id: option<s32>,
    /// A human-readable display name for this key, used to easily identify the SSH keys when they are displayed.
    name: string,
    /// The entire public key string that was uploaded. Embedded into the root user's `authorized_keys` file if you include this key during Droplet creation.
    public-key: string
  }
  create: func(params: create-params) -> result<create-response, create-error>;

  /// Retrieve an Existing SSH Key
  record get-params {
    /// Either the ID or the fingerprint of an existing SSH key.
    ssh-key-identifier: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Update an SSH Key's Name
  record update-params {
    /// Either the ID or the fingerprint of an existing SSH key.
    ssh-key-identifier: string,
    /// A human-readable display name for this key, used to easily identify the SSH keys when they are displayed.
    name: option<string>
  }
  update: func(params: update-params) -> result<update-response, update-error>;

  /// Delete an SSH Key
  record delete-params {
    /// Either the ID or the fingerprint of an existing SSH key.
    ssh-key-identifier: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

}

interface actions {
  enum list-op-response-actions-item-status-enum {
    in-progress,
    completed,
    errored,
  }

  record list-op-response {
    actions: option<list<list-op-response-actions-item>>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  record list-op-response-actions-item {
    /// A time value given in ISO8601 combined date and time format that represents when the action was completed.
    completed-at: option<string>,
    /// A unique numeric ID that can be used to identify and reference an action.
    id: option<s32>,
    region: option<list-op-response-actions-item-region>,
    region-slug: option<list-op-response-actions-item-region-slug>,
    /// A unique identifier for the resource that the action is associated with.
    resource-id: option<s32>,
    /// The type of resource that the action is associated with.
    resource-type: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the action was initiated.
    started-at: option<string>,
    /// The current status of the action. This can be "in-progress", "completed", or "errored".
    status: option<list-op-response-actions-item-status-enum>,
    /// This is the type of action that the object represents. For example, this could be "transfer" to represent the state of an image transfer action.
    type-op: option<string>
  }

  record list-op-response-actions-item-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record list-op-response-actions-item-region-slug {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record list-op-response-links {
    pages: option<string>
  }

  record list-op-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record get-response {
    action: option<get-response-action>
  }

  record get-response-action {
    /// A time value given in ISO8601 combined date and time format that represents when the action was completed.
    completed-at: option<string>,
    /// A unique numeric ID that can be used to identify and reference an action.
    id: option<s32>,
    region: option<get-response-action-region>,
    region-slug: option<get-response-action-region-slug>,
    /// A unique identifier for the resource that the action is associated with.
    resource-id: option<s32>,
    /// The type of resource that the action is associated with.
    resource-type: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the action was initiated.
    started-at: option<string>,
    /// The current status of the action. This can be "in-progress", "completed", or "errored".
    status: option<list-op-response-actions-item-status-enum>,
    /// This is the type of action that the object represents. For example, this could be "transfer" to represent the state of an image transfer action.
    type-op: option<string>
  }

  record get-response-action-region {
    /// This is a boolean value that represents whether new Droplets can be created in this region.
    available: bool,
    /// This attribute is set to an array which contains features available in this region
    features: string,
    /// The display name of the region.  This will be a full name that is used in the control panel and other interfaces.
    name: string,
    /// This attribute is set to an array which contains the identifying slugs for the sizes available in this region.
    sizes: string,
    /// A human-readable string that is used as a unique identifier for each region.
    slug: string
  }

  record get-response-action-region-slug {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant list-op-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Actions
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Retrieve an Existing Action
  record get-params {
    /// A unique numeric ID that can be used to identify and reference an action.
    action-id: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

}

interface apps {
  enum list-op-response-apps-item-active-deployment-phase-enum {
    unknown,
    pending-build,
    building,
    pending-deploy,
    deploying,
    active,
    superseded,
    error,
    canceled,
  }

  enum list-op-response-apps-item-active-deployment-progress-steps-item-status-enum {
    unknown,
    pending,
    running,
    error,
    success,
  }

  enum list-op-response-apps-item-active-deployment-spec-databases-item-engine-enum {
    unset,
    mysql,
    pg,
    redis,
  }

  enum list-op-response-apps-item-active-deployment-spec-domains-item-minimum-tls-version-enum {
    v1-v2,
    v1-v3,
  }

  enum list-op-response-apps-item-active-deployment-spec-domains-item-type-op-enum {
    unspecified,
    default,
    primary,
    alias,
  }

  enum list-op-response-apps-item-active-deployment-spec-functions-item-alerts-item-operator-enum {
    unspecified-operator,
    greater-than,
    less-than,
  }

  enum list-op-response-apps-item-active-deployment-spec-functions-item-alerts-item-rule-enum {
    unspecified-rule,
    cpu-utilization,
    mem-utilization,
    restart-count,
    deployment-failed,
    deployment-live,
    domain-failed,
    domain-live,
    functions-activation-count,
    functions-average-duration-ms,
    functions-error-rate-per-minute,
    functions-average-wait-time-ms,
    functions-error-count,
    functions-gb-rate-per-second,
  }

  enum list-op-response-apps-item-active-deployment-spec-functions-item-alerts-item-window-enum {
    unspecified-window,
    five-minutes,
    ten-minutes,
    thirty-minutes,
    one-hour,
  }

  enum list-op-response-apps-item-active-deployment-spec-functions-item-envs-item-scope-enum {
    unset,
    run-time,
    build-time,
    run-and-build-time,
  }

  enum list-op-response-apps-item-active-deployment-spec-functions-item-envs-item-type-op-enum {
    general,
    secret,
  }

  enum list-op-response-apps-item-active-deployment-spec-jobs-item-image-registry-type-enum {
    docker-hub,
    docr,
  }

  enum list-op-response-apps-item-active-deployment-spec-jobs-item-instance-size-slug-enum {
    basic-xxs,
    basic-xs,
    basic-s,
    basic-m,
    professional-xs,
    professional-s,
    professional-m,
    professional-v1l,
    professional-l,
    professional-xl,
  }

  enum list-op-response-apps-item-active-deployment-spec-jobs-item-kind-enum {
    unspecified,
    pre-deploy,
    post-deploy,
    failed-deploy,
  }

  enum list-op-response-apps-item-active-deployment-spec-region-enum {
    ams,
    nyc,
    fra,
    sfo,
    sgp,
    blr,
    tor,
    lon,
    syd,
  }

  enum list-op-response-apps-item-domains-item-phase-enum {
    unknown,
    pending,
    configuring,
    active,
    error,
  }

  enum create-accept-enum {
    application-json,
    application-yaml,
  }

  enum list-instance-sizes-response-instance-sizes-item-cpu-type-enum {
    unspecified,
    shared,
    dedicated,
  }

  enum get-logs-active-deployment-type-op-enum {
    unspecified,
    build,
    deploy,
    run,
  }

  enum validate-rollback-response-error-code-enum {
    incompatible-phase,
    incompatible-result,
    exceeded-revision-limit,
    app-pinned,
    database-config-conflict,
    region-conflict,
    static-site-requires-rebuild,
    image-source-missing-digest,
  }

  record list-op-response {
    apps: option<list<list-op-response-apps-item>>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  /// An application's configuration and status.
  record list-op-response-apps-item {
    active-deployment: option<list-op-response-apps-item-active-deployment>,
    created-at: option<string>,
    default-ingress: option<string>,
    domains: option<list<list-op-response-apps-item-domains-item>>,
    id: option<string>,
    in-progress-deployment: option<list-op-response-apps-item-in-progress-deployment>,
    last-deployment-created-at: option<string>,
    live-domain: option<string>,
    live-url: option<string>,
    live-url-base: option<string>,
    owner-uuid: option<string>,
    pending-deployment: option<list-op-response-apps-item-pending-deployment>,
    pinned-deployment: option<list-op-response-apps-item-pinned-deployment>,
    project-id: option<string>,
    region: option<list-op-response-apps-item-region>,
    /// The desired configuration of an application.
    spec: list-op-response-apps-item-spec,
    tier-slug: option<string>,
    updated-at: option<string>
  }

  record list-op-response-apps-item-active-deployment {
    cause: option<string>,
    cloned-from: option<string>,
    created-at: option<string>,
    functions: option<list<list-op-response-apps-item-active-deployment-functions-item>>,
    id: option<string>,
    jobs: option<list<list-op-response-apps-item-active-deployment-jobs-item>>,
    phase: option<list-op-response-apps-item-active-deployment-phase-enum>,
    phase-last-updated-at: option<string>,
    progress: option<list-op-response-apps-item-active-deployment-progress>,
    services: option<list<list-op-response-apps-item-active-deployment-services-item>>,
    /// The desired configuration of an application.
    spec: option<list-op-response-apps-item-active-deployment-spec>,
    static-sites: option<list<list-op-response-apps-item-active-deployment-static-sites-item>>,
    tier-slug: option<string>,
    updated-at: option<string>,
    workers: option<list<list-op-response-apps-item-active-deployment-workers-item>>
  }

  record list-op-response-apps-item-active-deployment-functions-item {
    name: option<string>,
    /// The namespace where the functions are deployed.
    namespace: option<string>,
    /// The commit hash of the repository that was used to build this functions component.
    source-commit-hash: option<string>
  }

  record list-op-response-apps-item-active-deployment-jobs-item {
    name: option<string>,
    source-commit-hash: option<string>
  }

  record list-op-response-apps-item-active-deployment-progress {
    error-steps: option<s32>,
    pending-steps: option<s32>,
    running-steps: option<s32>,
    steps: option<list<list-op-response-apps-item-active-deployment-progress-steps-item>>,
    success-steps: option<s32>,
    summary-steps: option<list<list-op-response-apps-item-active-deployment-progress-summary-steps-item>>,
    total-steps: option<s32>
  }

  record list-op-response-apps-item-active-deployment-progress-steps-item {
    component-name: option<string>,
    ended-at: option<string>,
    /// The base of a human-readable description of the step intended to be combined with the component name for presentation. For example:
    /// 
    message-base: option<string>,
    name: option<string>,
    reason: option<list-op-response-apps-item-active-deployment-progress-steps-item-reason>,
    started-at: option<string>,
    status: option<list-op-response-apps-item-active-deployment-progress-steps-item-status-enum>,
    steps: option<list<list<list-op-response-apps-item-active-deployment-progress-steps-item-steps-item-entry>>>
  }

  record list-op-response-apps-item-active-deployment-progress-steps-item-reason {
    code: option<string>,
    message: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record list-op-response-apps-item-active-deployment-progress-steps-item-steps-item-entry {
    key: string,
    value: string
  }

  record list-op-response-apps-item-active-deployment-progress-summary-steps-item {
    component-name: option<string>,
    ended-at: option<string>,
    /// The base of a human-readable description of the step intended to be combined with the component name for presentation. For example:
    /// 
    message-base: option<string>,
    name: option<string>,
    reason: option<list-op-response-apps-item-active-deployment-progress-summary-steps-item-reason>,
    started-at: option<string>,
    status: option<list-op-response-apps-item-active-deployment-progress-steps-item-status-enum>,
    steps: option<list<list<list-op-response-apps-item-active-deployment-progress-summary-steps-item-steps-item-entry>>>
  }

  record list-op-response-apps-item-active-deployment-progress-summary-steps-item-reason {
    code: option<string>,
    message: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record list-op-response-apps-item-active-deployment-progress-summary-steps-item-steps-item-entry {
    key: string,
    value: string
  }

  record list-op-response-apps-item-active-deployment-services-item {
    name: option<string>,
    source-commit-hash: option<string>
  }

  /// The desired configuration of an application.
  record list-op-response-apps-item-active-deployment-spec {
    /// Database instances which can provide persistence to workloads within the
    /// application.
    databases: option<list<list-op-response-apps-item-active-deployment-spec-databases-item>>,
    /// A set of hostnames where the application will be available.
    domains: option<list<list-op-response-apps-item-active-deployment-spec-domains-item>>,
    /// Workloads which expose publicly-accessible HTTP services via Functions Components.
    functions: option<list<list-op-response-apps-item-active-deployment-spec-functions-item>>,
    /// Specification for app ingress configurations.
    ingress: option<list-op-response-apps-item-active-deployment-spec-ingress>,
    /// Pre and post deployment workloads which do not expose publicly-accessible HTTP routes.
    jobs: option<list<list-op-response-apps-item-active-deployment-spec-jobs-item>>,
    /// The name of the app. Must be unique across all apps in the same account.
    name: string,
    /// The slug form of the geographical origin of the app. Default: `nearest available`
    region: option<list-op-response-apps-item-active-deployment-spec-region-enum>,
    /// Workloads which expose publicly-accessible HTTP services.
    services: option<list<list-op-response-apps-item-active-deployment-spec-services-item>>,
    /// Content which can be rendered to static web assets.
    static-sites: option<list<string>>,
    /// Workloads which do not expose publicly-accessible HTTP services.
    workers: option<list<string>>
  }

  record list-op-response-apps-item-active-deployment-spec-databases-item {
    /// The name of the underlying DigitalOcean DBaaS cluster. This is required for production databases. For dev databases, if cluster_name is not set, a new cluster will be provisioned.
    cluster-name: option<string>,
    /// The name of the MySQL or PostgreSQL database to configure.
    db-name: option<string>,
    /// The name of the MySQL or PostgreSQL user to configure.
    db-user: option<string>,
    /// - MYSQL: MySQL
    /// - PG: PostgreSQL
    engine: option<list-op-response-apps-item-active-deployment-spec-databases-item-engine-enum>,
    /// The name. Must be unique across all components within the same app.
    name: string,
    /// Whether this is a production or dev database.
    production: option<bool>,
    /// The version of the database engine
