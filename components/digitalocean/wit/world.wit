interface container-registry {
  enum registry-create-body-region-enum {
    nyc3,
    sfo3,
    ams3,
    sgp1,
    fra1,
  }

  enum registry-create-body-subscription-tier-slug-enum {
    starter,
    basic,
    professional,
  }

  /// Get Container Registry Information
  registry-get: func() -> result<string, string>;

  /// Create Container Registry
  record registry-create-params {
    /// A globally unique name for the container registry. Must be lowercase and be composed only of numbers, letters and `-`, up to a limit of 63 characters.
    name: string,
    /// Slug of the region where registry data is stored. When not provided, a region will be selected.
    region: option<registry-create-body-region-enum>,
    /// The slug of the subscription tier to sign up for. Valid values can be retrieved using the options endpoint.
    subscription-tier-slug: registry-create-body-subscription-tier-slug-enum
  }
  registry-create: func(params: registry-create-params) -> result<string, string>;

  /// Delete Container Registry
  registry-delete: func() -> result<string, string>;

  /// Get Docker Credentials for Container Registry
  record registry-get-docker-credentials-params {
    /// The duration in seconds that the returned registry credentials will be valid. If not set or 0, the credentials will not expire.
    expiry-seconds: option<s32>,
    /// By default, the registry credentials allow for read-only access. Set this query parameter to `true` to obtain read-write credentials.
    read-write: option<bool>
  }
  registry-get-docker-credentials: func(params: registry-get-docker-credentials-params) -> result<string, string>;

  /// List Registry Options (Subscription Tiers and Available Regions)
  registry-get-options: func() -> result<string, string>;

  /// Get Subscription Information
  registry-get-subscription: func() -> result<string, string>;

  /// Update Subscription Tier
  record registry-update-subscription-params {
    /// The slug of the subscription tier to sign up for.
    tier-slug: option<registry-create-body-subscription-tier-slug-enum>
  }
  registry-update-subscription: func(params: registry-update-subscription-params) -> result<string, string>;

  /// Validate a Container Registry Name
  record registry-validate-name-params {
    /// A globally unique name for the container registry. Must be lowercase and be composed only of numbers, letters and `-`, up to a limit of 63 characters.
    name: string
  }
  registry-validate-name: func(params: registry-validate-name-params) -> result<string, string>;

  /// Get Active Garbage Collection
  record registry-get-garbage-collection-params {
    /// The name of a container registry.
    registry-name: string
  }
  registry-get-garbage-collection: func(params: registry-get-garbage-collection-params) -> result<string, string>;

  /// Start Garbage Collection
  record registry-run-garbage-collection-params {
    /// The name of a container registry.
    registry-name: string
  }
  registry-run-garbage-collection: func(params: registry-run-garbage-collection-params) -> result<string, string>;

  /// Update Garbage Collection
  record registry-update-garbage-collection-params {
    /// The name of a container registry.
    registry-name: string,
    /// The UUID of a garbage collection run.
    garbage-collection-uuid: string,
    /// A boolean value indicating that the garbage collection should be cancelled.
    cancel: option<bool>
  }
  registry-update-garbage-collection: func(params: registry-update-garbage-collection-params) -> result<string, string>;

  /// List Garbage Collections
  record registry-list-garbage-collections-params {
    /// The name of a container registry.
    registry-name: string,
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  registry-list-garbage-collections: func(params: registry-list-garbage-collections-params) -> result<string, string>;

  /// List All Container Registry Repositories
  record registry-list-repositories-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>,
    /// The name of a container registry.
    registry-name: string
  }
  registry-list-repositories: func(params: registry-list-repositories-params) -> result<string, string>;

  /// List All Container Registry Repositories (V2)
  record registry-list-repositories-v2-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return. Ignored when 'page_token' is provided.
    page: option<s32>,
    /// Token to retrieve of the next or previous set of results more quickly than using 'page'.
    page-token: option<string>,
    /// The name of a container registry.
    registry-name: string
  }
  registry-list-repositories-v2: func(params: registry-list-repositories-v2-params) -> result<string, string>;

  /// List All Container Registry Repository Manifests
  record registry-list-repository-manifests-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>,
    /// The name of a container registry.
    registry-name: string,
    /// The name of a container registry repository. If the name contains `/` characters, they must be URL-encoded, e.g. `%2F`.
    repository-name: string
  }
  registry-list-repository-manifests: func(params: registry-list-repository-manifests-params) -> result<string, string>;

  /// Delete Container Registry Repository Manifest
  record registry-delete-repository-manifest-params {
    /// The name of a container registry.
    registry-name: string,
    /// The name of a container registry repository. If the name contains `/` characters, they must be URL-encoded, e.g. `%2F`.
    repository-name: string,
    /// The manifest digest of a container registry repository tag.
    manifest-digest: string
  }
  registry-delete-repository-manifest: func(params: registry-delete-repository-manifest-params) -> result<string, string>;

  /// List All Container Registry Repository Tags
  record registry-list-repository-tags-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>,
    /// The name of a container registry.
    registry-name: string,
    /// The name of a container registry repository. If the name contains `/` characters, they must be URL-encoded, e.g. `%2F`.
    repository-name: string
  }
  registry-list-repository-tags: func(params: registry-list-repository-tags-params) -> result<string, string>;

  /// Delete Container Registry Repository Tag
  record registry-delete-repository-tag-params {
    /// The name of a container registry.
    registry-name: string,
    /// The name of a container registry repository. If the name contains `/` characters, they must be URL-encoded, e.g. `%2F`.
    repository-name: string,
    /// The name of a container registry repository tag.
    repository-tag: string
  }
  registry-delete-repository-tag: func(params: registry-delete-repository-tag-params) -> result<string, string>;

}

