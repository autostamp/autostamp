    auth-plugin: list-clusters-response-databases-item-users-item-mysql-settings-auth-plugin-enum
  }

  record get-user-response {
    user: get-user-response-user
  }

  record get-user-response-user {
    mysql-settings: option<get-user-response-user-mysql-settings>,
