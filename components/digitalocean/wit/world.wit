  }
  reserved-i-ps-actions-post: func(params: reserved-i-ps-actions-post-params) -> result<reserved-i-ps-actions-post-response, reserved-i-ps-actions-post-error>;

  /// Retrieve an Existing Reserved IP Action
  record reserved-i-ps-actions-get-params {
