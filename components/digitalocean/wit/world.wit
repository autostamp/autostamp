    cdn-id: string
  }
  cdn-delete-endpoint: func(params: cdn-delete-endpoint-params) -> result<string, cdn-delete-endpoint-error>;

  /// Purge the Cache for an Existing CDN Endpoint
  record cdn-purge-cache-params {
    /// A unique identifier for a CDN endpoint.
    cdn-id: string,
    /// An array of strings containing the path to the content to be purged from the CDN cache.
    files: list<string>
  }
  cdn-purge-cache: func(params: cdn-purge-cache-params) -> result<string, cdn-purge-cache-error>;

}

interface certificates {
  enum list-op-response-certificates-item-state-enum {
    pending,
    verified,
    error,
  }

  enum list-op-response-certificates-item-type-op-enum {
    custom,
    lets-encrypt,
  }

  record list-op-response {
    certificates: option<list<list-op-response-certificates-item>>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  record list-op-response-certificates-item {
    /// A time value given in ISO8601 combined date and time format that represents when the certificate was created.
    created-at: option<string>,
    /// An array of fully qualified domain names (FQDNs) for which the certificate was issued.
    dns-names: option<list<string>>,
    /// A unique ID that can be used to identify and reference a certificate.
    id: option<string>,
    /// A unique human-readable name referring to a certificate.
    name: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents the certificate's expiration date.
    not-after: option<string>,
    /// A unique identifier generated from the SHA-1 fingerprint of the certificate.
    sha1-fingerprint: option<string>,
    /// A string representing the current state of the certificate. It may be `pending`, `verified`, or `error`.
    state: option<list-op-response-certificates-item-state-enum>,
    /// A string representing the type of the certificate. The value will be `custom` for a user-uploaded certificate or `lets_encrypt` for one automatically generated with Let's Encrypt.
    type-op: option<list-op-response-certificates-item-type-op-enum>
  }

  record list-op-response-links {
    pages: option<string>
  }

  record list-op-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record create-response {
    certificate: option<create-response-certificate>
  }

  record create-response-certificate {
    /// A time value given in ISO8601 combined date and time format that represents when the certificate was created.
    created-at: option<string>,
    /// An array of fully qualified domain names (FQDNs) for which the certificate was issued.
    dns-names: option<list<string>>,
    /// A unique ID that can be used to identify and reference a certificate.
    id: option<string>,
    /// A unique human-readable name referring to a certificate.
    name: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents the certificate's expiration date.
    not-after: option<string>,
    /// A unique identifier generated from the SHA-1 fingerprint of the certificate.
    sha1-fingerprint: option<string>,
    /// A string representing the current state of the certificate. It may be `pending`, `verified`, or `error`.
    state: option<list-op-response-certificates-item-state-enum>,
    /// A string representing the type of the certificate. The value will be `custom` for a user-uploaded certificate or `lets_encrypt` for one automatically generated with Let's Encrypt.
    type-op: option<list-op-response-certificates-item-type-op-enum>
  }

  record get-response {
    certificate: option<get-response-certificate>
  }

  record get-response-certificate {
    /// A time value given in ISO8601 combined date and time format that represents when the certificate was created.
    created-at: option<string>,
    /// An array of fully qualified domain names (FQDNs) for which the certificate was issued.
    dns-names: option<list<string>>,
    /// A unique ID that can be used to identify and reference a certificate.
    id: option<string>,
    /// A unique human-readable name referring to a certificate.
    name: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents the certificate's expiration date.
    not-after: option<string>,
    /// A unique identifier generated from the SHA-1 fingerprint of the certificate.
    sha1-fingerprint: option<string>,
    /// A string representing the current state of the certificate. It may be `pending`, `verified`, or `error`.
    state: option<list-op-response-certificates-item-state-enum>,
    /// A string representing the type of the certificate. The value will be `custom` for a user-uploaded certificate or `lets_encrypt` for one automatically generated with Let's Encrypt.
    type-op: option<list-op-response-certificates-item-type-op-enum>
  }

  variant list-op-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant create-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// List All Certificates
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list-op-response, list-op-error>;

  /// Create a New Certificate
  record create-params {
    body: string
  }
  create: func(params: create-params) -> result<create-response, create-error>;

  /// Retrieve an Existing Certificate
  record get-params {
    /// A unique identifier for a certificate.
    certificate-id: string
  }
  get: func(params: get-params) -> result<get-response, get-error>;

  /// Delete a Certificate
  record delete-params {
    /// A unique identifier for a certificate.
    certificate-id: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

}

interface billing {
  enum history-list-response-billing-history-item-type-op-enum {
    ach-failure,
    adjustment,
    attempt-failed,
    chargeback,
    credit,
    credit-expiration,
    invoice,
    payment,
    refund,
    reversal,
  }

  record balance-get-response {
    /// Current balance of the customer's most recent billing activity.  Does not reflect `month_to_date_usage`.
    account-balance: option<string>,
    /// The time at which balances were most recently generated.
    generated-at: option<string>,
    /// Balance as of the `generated_at` time.  This value includes the `account_balance` and `month_to_date_usage`.
    month-to-date-balance: option<string>,
    /// Amount used in the current billing period as of the `generated_at` time.
    month-to-date-usage: option<string>
  }

  record history-list-response {
    billing-history: option<list<history-list-response-billing-history-item>>,
    links: option<history-list-response-links>,
    /// Information about the response itself.
    meta: history-list-response-meta
  }

  record history-list-response-billing-history-item {
    /// Amount of the billing history entry.
    amount: option<string>,
    /// Time the billing history entry occurred.
    date: option<string>,
    /// Description of the billing history entry.
    description: option<string>,
    /// ID of the invoice associated with the billing history entry, if  applicable.
    invoice-id: option<string>,
    /// UUID of the invoice associated with the billing history entry, if  applicable.
    invoice-uuid: option<string>,
    /// Type of billing history entry.
    type-op: option<history-list-response-billing-history-item-type-op-enum>
  }

  record history-list-response-links {
    pages: option<string>
  }

  /// Information about the response itself.
  record history-list-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record invoices-list-response {
    /// The invoice preview.
    invoice-preview: option<invoices-list-response-invoice-preview>,
    invoices: option<list<invoices-list-response-invoices-item>>,
    links: option<invoices-list-response-links>,
    meta: invoices-list-response-meta
  }

  /// The invoice preview.
  record invoices-list-response-invoice-preview {
    /// Total amount of the invoice, in USD.  This will reflect month-to-date usage in the invoice preview.
    amount: option<string>,
    /// Billing period of usage for which the invoice is issued, in `YYYY-MM`  format.
    invoice-period: option<string>,
    /// The UUID of the invoice. The canonical reference for the invoice.
    invoice-uuid: option<string>,
    /// Time the invoice was last updated.  This is only included with the invoice preview.
    updated-at: option<string>
  }

  /// The invoice preview.
  record invoices-list-response-invoices-item {
    /// Total amount of the invoice, in USD.  This will reflect month-to-date usage in the invoice preview.
    amount: option<string>,
    /// Billing period of usage for which the invoice is issued, in `YYYY-MM`  format.
    invoice-period: option<string>,
    /// The UUID of the invoice. The canonical reference for the invoice.
    invoice-uuid: option<string>,
    /// Time the invoice was last updated.  This is only included with the invoice preview.
    updated-at: option<string>
  }

  record invoices-list-response-links {
    pages: option<string>
  }

  record invoices-list-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record invoices-get-by-uuid-response {
    invoice-items: option<list<invoices-get-by-uuid-response-invoice-items-item>>,
    links: option<invoices-get-by-uuid-response-links>,
    meta: invoices-get-by-uuid-response-meta
  }

  record invoices-get-by-uuid-response-invoice-items-item {
    /// Billed amount of this invoice item. Billed in USD.
    amount: option<string>,
    /// Description of the invoice item.
    description: option<string>,
    /// Duration of time this invoice item was used and subsequently billed.
    duration: option<string>,
    /// Unit of time for duration.
    duration-unit: option<string>,
    /// Time the invoice item stopped being billed for usage.
    end-time: option<string>,
    /// Description of the invoice item when it is a grouped set of usage, such  as DOKS or databases.
    group-description: option<string>,
    /// Name of the product being billed in the invoice item.
    product: option<string>,
    /// Name of the DigitalOcean Project this resource belongs to.
    project-name: option<string>,
    /// ID of the resource billing in the invoice item if available.
    resource-id: option<string>,
    /// UUID of the resource billing in the invoice item if available.
    resource-uuid: option<string>,
    /// Time the invoice item began to be billed for usage.
    start-time: option<string>
  }

  record invoices-get-by-uuid-response-links {
    pages: option<string>
  }

  record invoices-get-by-uuid-response-meta {
    /// Number of objects returned by the request.
    total: option<s32>
  }

  record invoices-get-summary-by-uuid-response {
    /// Total amount of the invoice, in USD.  This will reflect month-to-date usage in the invoice preview.
    amount: option<string>,
    /// Billing period of usage for which the invoice is issued, in `YYYY-MM`  format.
    billing-period: option<string>,
    credits-and-adjustments: option<invoices-get-summary-by-uuid-response-credits-and-adjustments>,
    /// UUID of the invoice
    invoice-uuid: option<string>,
    overages: option<invoices-get-summary-by-uuid-response-overages>,
    product-charges: option<invoices-get-summary-by-uuid-response-product-charges>,
    taxes: option<invoices-get-summary-by-uuid-response-taxes>,
    user-billing-address: option<invoices-get-summary-by-uuid-response-user-billing-address>,
    /// Company of the DigitalOcean customer being invoiced, if set.
    user-company: option<string>,
    /// Email of the DigitalOcean customer being invoiced.
    user-email: option<string>,
    /// Name of the DigitalOcean customer being invoiced.
    user-name: option<string>
  }

  record invoices-get-summary-by-uuid-response-credits-and-adjustments {
    /// Total amount charged in USD
    amount: option<string>,
    /// Name of the charge
    name: option<string>
  }

  record invoices-get-summary-by-uuid-response-overages {
    /// Total amount charged in USD
    amount: option<string>,
    /// Name of the charge
    name: option<string>
  }

  record invoices-get-summary-by-uuid-response-product-charges {
    /// Total amount charged
    amount: option<string>,
    /// List of amount, and grouped aggregates by resource type.
    items: option<list<invoices-get-summary-by-uuid-response-product-charges-items-item>>,
    /// Description of usage charges
    name: option<string>
  }

  record invoices-get-summary-by-uuid-response-product-charges-items-item {
    /// Amount of the charge
    amount: option<string>,
    /// Number of times the charge was applied
    count: option<string>,
    /// Description of the charge
    name: option<string>
  }

  record invoices-get-summary-by-uuid-response-taxes {
    /// Total amount charged in USD
    amount: option<string>,
    /// Name of the charge
    name: option<string>
  }

  record invoices-get-summary-by-uuid-response-user-billing-address {
    /// Street address line 1
    address-line1: option<string>,
    /// Street address line 2
    address-line2: option<string>,
    /// City
    city: option<string>,
    /// Country (ISO2) code
    country-iso2-code: option<string>,
    /// Timestamp billing address was created
    created-at: option<string>,
    /// Postal code
    postal-code: option<string>,
    /// Region
    region: option<string>,
    /// Timestamp billing address was updated
    updated-at: option<string>
  }

  variant balance-get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant history-list-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant invoices-list-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant invoices-get-by-uuid-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant invoices-get-csv-by-uuid-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant invoices-get-pdf-by-uuid-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant invoices-get-summary-by-uuid-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  /// Get Customer Balance
  balance-get: func() -> result<balance-get-response, balance-get-error>;

  /// List Billing History
  history-list: func() -> result<history-list-response, history-list-error>;

  /// List All Invoices
  record invoices-list-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  invoices-list: func(params: invoices-list-params) -> result<invoices-list-response, invoices-list-error>;

  /// Retrieve an Invoice by UUID
  record invoices-get-by-uuid-params {
    /// UUID of the invoice
    invoice-uuid: string
  }
  invoices-get-by-uuid: func(params: invoices-get-by-uuid-params) -> result<invoices-get-by-uuid-response, invoices-get-by-uuid-error>;

  /// Retrieve an Invoice CSV by UUID
  record invoices-get-csv-by-uuid-params {
    /// UUID of the invoice
    invoice-uuid: string
  }
  invoices-get-csv-by-uuid: func(params: invoices-get-csv-by-uuid-params) -> result<string, invoices-get-csv-by-uuid-error>;

  /// Retrieve an Invoice PDF by UUID
  record invoices-get-pdf-by-uuid-params {
    /// UUID of the invoice
    invoice-uuid: string
  }
  invoices-get-pdf-by-uuid: func(params: invoices-get-pdf-by-uuid-params) -> result<string, invoices-get-pdf-by-uuid-error>;

  /// Retrieve an Invoice Summary by UUID
  record invoices-get-summary-by-uuid-params {
    /// UUID of the invoice
    invoice-uuid: string
  }
  invoices-get-summary-by-uuid: func(params: invoices-get-summary-by-uuid-params) -> result<invoices-get-summary-by-uuid-response, invoices-get-summary-by-uuid-error>;

}

interface databases {
  enum list-clusters-response-databases-item-engine-enum {
    pg,
    mysql,
    redis,
    mongodb,
  }

  enum list-clusters-response-databases-item-rules-item-type-op-enum {
    droplet,
    k8s,
    ip-addr,
    tag,
    app,
  }

  enum list-clusters-response-databases-item-status-enum {
    creating,
    online,
    resizing,
    migrating,
    forking,
  }

  enum list-clusters-response-databases-item-users-item-mysql-settings-auth-plugin-enum {
    mysql-native-password,
    caching-sha2-password,
  }

  enum list-clusters-response-databases-item-users-item-role-enum {
    primary,
    normal,
  }

  enum get-eviction-policy-response-eviction-policy-enum {
    noeviction,
    allkeys-lru,
    allkeys-random,
    volatile-lru,
    volatile-random,
    volatile-ttl,
  }

  enum get-migration-status-response-status-enum {
    running,
    canceled,
    error,
    done,
  }

  record list-clusters-response {
    databases: option<list<list-clusters-response-databases-item>>
  }

  record list-clusters-response-databases-item {
    connection: option<list-clusters-response-databases-item-connection>,
    /// A time value given in ISO8601 combined date and time format that represents when the database cluster was created.
    created-at: option<string>,
    /// An array of strings containing the names of databases created in the database cluster.
    db-names: option<list<string>>,
    /// A slug representing the database engine used for the cluster. The possible values are: "pg" for PostgreSQL, "mysql" for MySQL, "redis" for Redis, and "mongodb" for MongoDB.
    engine: list-clusters-response-databases-item-engine-enum,
    /// A unique ID that can be used to identify and reference a database cluster.
    id: option<string>,
    maintenance-window: option<list-clusters-response-databases-item-maintenance-window>,
    /// A unique, human-readable name referring to a database cluster.
    name: string,
    /// The number of nodes in the database cluster.
    num-nodes: s32,
    private-connection: option<list-clusters-response-databases-item-private-connection>,
    /// A string specifying the UUID of the VPC to which the database cluster will be assigned. If excluded, the cluster when creating a new database cluster, it will be assigned to your account's default VPC for the region.
    private-network-uuid: option<string>,
    /// The ID of the project that the database cluster is assigned to. If excluded when creating a new database cluster, it will be assigned to your default project.
    project-id: option<string>,
    /// The slug identifier for the region where the database cluster is located.
    region: string,
    rules: option<list<list-clusters-response-databases-item-rules-item>>,
    /// A string representing the semantic version of the database engine in use for the cluster.
    semantic-version: option<string>,
    /// The slug identifier representing the size of the nodes in the database cluster.
    size: string,
    /// A string representing the current status of the database cluster.
    status: option<list-clusters-response-databases-item-status-enum>,
    /// An array of tags that have been applied to the database cluster.
    tags: option<list<string>>,
    users: option<list<list-clusters-response-databases-item-users-item>>,
    /// A string representing the version of the database engine in use for the cluster.
    version: option<string>,
    /// A timestamp referring to the date when the particular version will no longer be available for creating new clusters. If null, the version does not have an end of availability timeline.
    version-end-of-availability: option<string>,
    /// A timestamp referring to the date when the particular version will no longer be supported. If null, the version does not have an end of life timeline.
    version-end-of-life: option<string>
  }

  record list-clusters-response-databases-item-connection {
    /// The name of the default database.
    database: option<string>,
    /// The FQDN pointing to the database cluster's current primary node.
    host: option<string>,
    /// The randomly generated password for the default user.
    password: option<string>,
    /// The port on which the database cluster is listening.
    port: option<s32>,
    /// A boolean value indicating if the connection should be made over SSL.
    ssl: option<bool>,
    /// A connection string in the format accepted by the `psql` command. This is provided as a convenience and should be able to be constructed by the other attributes.
    uri: option<string>,
    /// The default user for the database.
    user: option<string>
  }

  record list-clusters-response-databases-item-maintenance-window {
    /// The day of the week on which to apply maintenance updates.
    day: string,
    /// A list of strings, each containing information about a pending maintenance update.
    description: option<list<string>>,
    /// The hour in UTC at which maintenance updates will be applied in 24 hour format.
    hour: string,
    /// A boolean value indicating whether any maintenance is scheduled to be performed in the next window.
    pending: option<bool>
  }

  record list-clusters-response-databases-item-private-connection {
    /// The name of the default database.
    database: option<string>,
    /// The FQDN pointing to the database cluster's current primary node.
    host: option<string>,
    /// The randomly generated password for the default user.
    password: option<string>,
    /// The port on which the database cluster is listening.
    port: option<s32>,
    /// A boolean value indicating if the connection should be made over SSL.
    ssl: option<bool>,
    /// A connection string in the format accepted by the `psql` command. This is provided as a convenience and should be able to be constructed by the other attributes.
    uri: option<string>,
    /// The default user for the database.
    user: option<string>
  }

  record list-clusters-response-databases-item-rules-item {
    /// A unique ID for the database cluster to which the rule is applied.
    cluster-uuid: option<string>,
    /// A time value given in ISO8601 combined date and time format that represents when the firewall rule was created.
    created-at: option<string>,
    /// The type of resource that the firewall rule allows to access the database cluster.
    type-op: list-clusters-response-databases-item-rules-item-type-op-enum,
    /// A unique ID for the firewall rule itself.
    uuid: option<string>,
    /// The ID of the specific resource, the name of a tag applied to a group of resources, or the IP address that the firewall rule allows to access the database cluster.
    value: string
  }

  record list-clusters-response-databases-item-users-item {
    mysql-settings: option<list-clusters-response-databases-item-users-item-mysql-settings>,
    /// The name of a database user.
    name: string,
    /// A randomly generated password for the database user.
    password: option<string>,
    /// A string representing the database user's role. The value will be either
    /// "primary" or "normal".
    role: option<list-clusters-response-databases-item-users-item-role-enum>
  }

  record list-clusters-response-databases-item-users-item-mysql-settings {
    /// A string specifying the authentication method to be used for connections
    /// to the MySQL user account. The valid values are `mysql_native_password`
    auth-plugin: list-clusters-response-databases-item-users-item-mysql-settings-auth-plugin-enum
  }

  record create-cluster-body-connection {
    /// The name of the default database.
    database: option<string>,
    /// The FQDN pointing to the database cluster's current primary node.
