  variant create-error {
    unauthorized(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant get-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
