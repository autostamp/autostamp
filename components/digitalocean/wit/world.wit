  domains-patch-record: func(params: domains-patch-record-params) -> result<domains-patch-record-response, domains-patch-record-error>;

  /// Delete a Domain Record
  record domains-delete-record-params {
    /// The name of the domain itself.
    domain-name: string,
    /// The unique identifier of the domain record.
    domain-record-id: string
  }
  domains-delete-record: func(params: domains-delete-record-params) -> result<string, domains-delete-record-error>;

}

interface droplets {
  enum list-op-response-droplets-item-image-distribution-enum {
    arch-linux,
    cent-os,
    core-os,
    debian,
    fedora,
    fedora-atomic,
    free-bsd,
    gentoo,
    open-suse,
    rancher-os,
    rocky-linux,
    ubuntu,
    unknown,
  }

  enum list-op-response-droplets-item-image-regions-item-enum {
    ams1,
    ams2,
    ams3,
    blr1,
    fra1,
    lon1,
    nyc1,
    nyc2,
    nyc3,
    sfo1,
    sfo2,
    sfo3,
    sgp1,
    tor1,
  }

  enum list-op-response-droplets-item-image-status-enum {
    new,
    available,
    pending,
    deleted,
    retired,
  }

  enum list-op-response-droplets-item-image-type-op-enum {
    base,
    snapshot,
    backup,
    custom,
    admin,
  }

  enum list-op-response-droplets-item-networks-v4-item-type-op-enum {
    public,
    private,
  }

  enum list-op-response-droplets-item-networks-v6-item-type-op-enum {
    public,
  }

  enum list-op-response-droplets-item-status-enum {
    new,
    active,
    off,
    archive,
  }

  enum list-backups-response-backups-item-type-op-enum {
    snapshot,
    backup,
  }

  record list-op-response {
    droplets: option<list<list-op-response-droplets-item>>,
    links: option<list-op-response-links>,
    meta: list-op-response-meta
  }

  record list-op-response-droplets-item {
    /// An array of backup IDs of any backups that have been taken of the Droplet instance.  Droplet backups are enabled at the time of the instance creation.
    backup-ids: list<s32>,
    /// A time value given in ISO8601 combined date and time format that represents when the Droplet was created.
    created-at: string,
    /// The size of the Droplet's disk in gigabytes.
    disk: s32,
    /// An array of features enabled on this Droplet.
    features: list<string>,
    /// A unique identifier for each Droplet instance. This is automatically generated upon Droplet creation.
    id: s32,
    image: list-op-response-droplets-item-image,
    /// **Note**: All Droplets created after March 2017 use internal kernels by default.
    /// These Droplets will have this attribute set to `null`.
    kernel: option<list-op-response-droplets-item-kernel>,
    /// A boolean value indicating whether the Droplet has been locked, preventing actions by users.
    locked: bool,
    /// Memory of the Droplet in megabytes.
    memory: s32,
    /// The human-readable name set for the Droplet instance.
    name: string,
    /// The details of the network that are configured for the Droplet instance.  This is an object that contains keys for IPv4 and IPv6.  The value of each of these is an array that contains objects describing an individual IP resource allocated to the Droplet.  These will define attributes like the IP address, netmask, and gateway of the specific network depending on the type of network it is.
    networks: list-op-response-droplets-item-networks,
    /// The details of the Droplet's backups feature, if backups are configured for the Droplet. This object contains keys for the start and end times of the window during which the backup will start.
    next-backup-window: list-op-response-droplets-item-next-backup-window,
    region: list-op-response-droplets-item-region,
    size: list-op-response-droplets-item-size,
    /// The unique slug identifier for the size of this Droplet.
    size-slug: string,
    /// An array of snapshot IDs of any snapshots created from the Droplet instance.
    snapshot-ids: list<s32>,
    /// A status string indicating the state of the Droplet instance. This may be "new", "active", "off", or "archive".
    status: list-op-response-droplets-item-status-enum,
    /// An array of Tags the Droplet has been tagged with.
    tags: list<string>,
    /// The number of virtual CPUs.
    vcpus: s32,
    /// A flat array including the unique identifier for each Block Storage volume attached to the Droplet.
    volume-ids: list<string>,
    /// A string specifying the UUID of the VPC to which the Droplet is assigned.
    vpc-uuid: option<string>
  }

  record list-op-response-droplets-item-image {
    /// A time value given in ISO8601 combined date and time format that represents when the image was created.
    created-at: option<string>,
    /// An optional free-form text field to describe an image.
    description: option<string>,
    /// The name of a custom image's distribution. Currently, the valid values are  `Arch Linux`, `CentOS`, `CoreOS`, `Debian`, `Fedora`, `Fedora Atomic`,  `FreeBSD`, `Gentoo`, `openSUSE`, `RancherOS`, `Rocky Linux`, `Ubuntu`, and `Unknown`.  Any other value will be accepted but ignored, and `Unknown` will be used in its place.
    distribution: option<list-op-response-droplets-item-image-distribution-enum>,
    /// A string containing information about errors that may occur when importing
    ///  a custom image.
    error-message: option<string>,
    /// A unique number that can be used to identify and reference a specific image.
    id: option<s32>,
    /// The minimum disk size in GB required for a Droplet to use this image.
    min-disk-size: option<s32>,
