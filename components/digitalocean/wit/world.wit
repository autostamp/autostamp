/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `bearer_auth` | `Authorization: Bearer <secret>` |
package autostamp:digitalocean@0.3.0;

interface v1-click-applications {
  enum one-clicks-list-type-op-enum {
    droplet,
    kubernetes,
  }

  /// List 1-Click Applications
  record one-clicks-list-params {
    /// Restrict results to a certain type of 1-Click.
    type-op: option<one-clicks-list-type-op-enum>
  }
  one-clicks-list: func(params: one-clicks-list-params) -> result<string, string>;

  /// Install Kubernetes 1-Click Applications
  record one-clicks-install-kubernetes-params {
    /// An array of 1-Click Application slugs to be installed to the Kubernetes cluster.
    addon-slugs: list<string>,
    /// A unique ID for the Kubernetes cluster to which the 1-Click Applications will be installed.
    cluster-uuid: string
  }
  one-clicks-install-kubernetes: func(params: one-clicks-install-kubernetes-params) -> result<string, string>;

}


interface account {
  /// Get User Information
  get: func() -> result<string, string>;

}

interface ssh-keys {
  /// List All SSH Keys
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Create a New SSH Key
  record create-params {
    /// A unique identifier that differentiates this key from other keys using  a format that SSH recognizes. The fingerprint is created when the key is added to your account.
    fingerprint: option<string>,
    /// A unique identification number for this key. Can be used to embed a  specific SSH key into a Droplet.
    id: option<s32>,
    /// A human-readable display name for this key, used to easily identify the SSH keys when they are displayed.
    name: string,
    /// The entire public key string that was uploaded. Embedded into the root user's `authorized_keys` file if you include this key during Droplet creation.
    public-key: string
  }
  create: func(params: create-params) -> result<string, string>;

  /// Retrieve an Existing SSH Key
  record get-params {
    /// Either the ID or the fingerprint of an existing SSH key.
    ssh-key-identifier: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update an SSH Key's Name
  record update-params {
    /// Either the ID or the fingerprint of an existing SSH key.
    ssh-key-identifier: string,
    /// A human-readable display name for this key, used to easily identify the SSH keys when they are displayed.
    name: option<string>
  }
  update: func(params: update-params) -> result<string, string>;

  /// Delete an SSH Key
  record delete-params {
    /// Either the ID or the fingerprint of an existing SSH key.
    ssh-key-identifier: string
  }
  delete: func(params: delete-params) -> result<string, string>;

}

interface actions {
  /// List All Actions
  record list-op-params {
    /// Number of items returned per page
    per-page: option<s32>,
    /// Which 'page' of paginated results to return.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Retrieve an Existing Action
  record get-params {
    /// A unique numeric ID that can be used to identify and reference an action.
    action-id: string
  }
  get: func(params: get-params) -> result<string, string>;

}

interface apps {
  enum create-accept-enum {
    application-json,
    application-yaml,
  }

  enum create-body-spec-databases-item-engine-enum {
    unset,
    mysql,
    pg,
    redis,
  }

  enum create-body-spec-domains-item-minimum-tls-version-enum {
    v1-v2,
    v1-v3,
  }

  enum create-body-spec-domains-item-type-op-enum {
    unspecified,
    default,
    primary,
    alias,
  }

  enum create-body-spec-functions-item-alerts-item-operator-enum {
    unspecified-operator,
    greater-than,
    less-than,
  }

  enum create-body-spec-functions-item-alerts-item-rule-enum {
    unspecified-rule,
    cpu-utilization,
    mem-utilization,
    restart-count,
    deployment-failed,
    deployment-live,
    domain-failed,
    domain-live,
    functions-activation-count,
    functions-average-duration-ms,
    functions-error-rate-per-minute,
    functions-average-wait-time-ms,
    functions-error-count,
    functions-gb-rate-per-second,
  }

  enum create-body-spec-functions-item-alerts-item-window-enum {
    unspecified-window,
    five-minutes,
    ten-minutes,
    thirty-minutes,
    one-hour,
  }

  enum create-body-spec-functions-item-envs-item-scope-enum {
    unset,
    run-time,
    build-time,
    run-and-build-time,
  }

  enum create-body-spec-functions-item-envs-item-type-op-enum {
    general,
    secret,
  }

  enum create-body-spec-region-enum {
    ams,
    nyc,
    fra,
    sfo,
    sgp,
    blr,
    tor,
    lon,
    syd,
  }

  enum get-logs-active-deployment-type-op-enum {
    unspecified,
    build,
    deploy,
    run,
  }

  /// The desired configuration of an application.
  record create-body-spec {
    /// Database instances which can provide persistence to workloads within the
    /// application.
    databases: option<list<create-body-spec-databases-item>>,
    /// A set of hostnames where the application will be available.
    domains: option<list<create-body-spec-domains-item>>,
    /// Workloads which expose publicly-accessible HTTP services via Functions Components.
    functions: option<list<create-body-spec-functions-item>>,
    /// Specification for app ingress configurations.
    ingress: option<create-body-spec-ingress>,
    /// Pre and post deployment workloads which do not expose publicly-accessible HTTP routes.
    jobs: option<list<string>>,
    /// The name of the app. Must be unique across all apps in the same account.
    name: string,
    /// The slug form of the geographical origin of the app. Default: `nearest available`
    region: option<create-body-spec-region-enum>,
    /// Workloads which expose publicly-accessible HTTP services.
    services: option<list<string>>,
    /// Content which can be rendered to static web assets.
    static-sites: option<list<string>>,
    /// Workloads which do not expose publicly-accessible HTTP services.
    workers: option<list<string>>
  }

  record create-body-spec-databases-item {
    /// The name of the underlying DigitalOcean DBaaS cluster. This is required for production databases. For dev databases, if cluster_name is not set, a new cluster will be provisioned.
    cluster-name: option<string>,
    /// The name of the MySQL or PostgreSQL database to configure.
    db-name: option<string>,
    /// The name of the MySQL or PostgreSQL user to configure.
    db-user: option<string>,
    /// - MYSQL: MySQL
    /// - PG: PostgreSQL
    engine: option<create-body-spec-databases-item-engine-enum>,
    /// The name. Must be unique across all components within the same app.
    name: string,
    /// Whether this is a production or dev database.
    production: option<bool>,
    /// The version of the database engine
    version: option<string>
  }

  record create-body-spec-domains-item {
    /// The hostname for the domain
    domain: string,
    /// The minimum version of TLS a client application can use to access resources for the domain.  Must be one of the following values wrapped within quotations: `"1.2"` or `"1.3"`.
    minimum-tls-version: option<create-body-spec-domains-item-minimum-tls-version-enum>,
    /// - DEFAULT: The default `.ondigitalocean.app` domain assigned to this app
    /// - PRIMARY: The primary domain for this app that is displayed as the default in the control panel, used in bindable environment variables, and any other places that reference an app's live URL. Only one domain may be set as primary.
    type-op: option<create-body-spec-domains-item-type-op-enum>,
    /// Indicates whether the domain includes all sub-domains, in addition to the given domain
    wildcard: option<bool>,
    /// Optional. If the domain uses DigitalOcean DNS and you would like App
    /// Platform to automatically manage it for you, set this to the name of the
    zone: option<string>
  }

  record create-body-spec-functions-item {
    alerts: option<list<create-body-spec-functions-item-alerts-item>>,
    cors: option<create-body-spec-functions-item-cors>,
    /// A list of environment variables made available to the component.
    envs: option<list<create-body-spec-functions-item-envs-item>>,
    git: option<create-body-spec-functions-item-git>,
    github: option<create-body-spec-functions-item-github>,
    gitlab: option<create-body-spec-functions-item-gitlab>,
    log-destinations: option<create-body-spec-functions-item-log-destinations>,
    /// The name. Must be unique across all components within the same app.
    name: string,
    /// A list of HTTP routes that should be routed to this component.
    routes: option<list<create-body-spec-functions-item-routes-item>>,
    /// An optional path to the working directory to use for the build. For Dockerfile builds, this will be used as the build context. Must be relative to the root of the repo.
    source-dir: option<string>
  }

  record create-body-spec-functions-item-alerts-item {
    /// Is the alert disabled?
    disabled: option<bool>,
    operator: option<create-body-spec-functions-item-alerts-item-operator-enum>,
    rule: option<create-body-spec-functions-item-alerts-item-rule-enum>,
    /// Threshold value for alert
    value: option<f64>,
    window: option<create-body-spec-functions-item-alerts-item-window-enum>
  }

  record create-body-spec-functions-item-cors {
    /// Whether browsers should expose the response to the client-side JavaScript code when the request’s credentials mode is include. This configures the `Access-Control-Allow-Credentials` header.
    allow-credentials: option<bool>,
    /// The set of allowed HTTP request headers. This configures the `Access-Control-Allow-Headers` header.
    allow-headers: option<list<string>>,
    /// The set of allowed HTTP methods. This configures the `Access-Control-Allow-Methods` header.
    allow-methods: option<list<string>>,
    /// The set of allowed CORS origins.
    allow-origins: option<list<create-body-spec-functions-item-cors-allow-origins-item>>,
    /// The set of HTTP response headers that browsers are allowed to access. This configures the `Access-Control-Expose-Headers` header.
    expose-headers: option<list<string>>,
    /// An optional duration specifying how long browsers can cache the results of a preflight request. This configures the `Access-Control-Max-Age` header.
    max-age: option<string>
  }

  record create-body-spec-functions-item-cors-allow-origins-item {
    /// Exact string match. Only 1 of `exact`, `prefix`, or `regex` must be set.
    exact: option<string>,
    /// Prefix-based match. Only 1 of `exact`, `prefix`, or `regex` must be set.
    prefix: option<string>,
    /// RE2 style regex-based match. Only 1 of `exact`, `prefix`, or `regex` must be set. For more information about RE2 syntax, see: https://github.com/google/re2/wiki/Syntax
    regex: option<string>
  }

  record create-body-spec-functions-item-envs-item {
    /// The variable name
    key: string,
    /// - RUN_TIME: Made available only at run-time
    /// - BUILD_TIME: Made available only at build-time
    scope: option<create-body-spec-functions-item-envs-item-scope-enum>,
    /// - GENERAL: A plain-text environment variable
    /// - SECRET: A secret encrypted environment variable
    type-op: option<create-body-spec-functions-item-envs-item-type-op-enum>,
    /// The value. If the type is `SECRET`, the value will be encrypted on first submission. On following submissions, the encrypted value should be used.
    value: option<string>
  }

  record create-body-spec-functions-item-git {
    /// The name of the branch to use
    branch: option<string>,
    /// The clone URL of the repo. Example: `https://github.com/digitalocean/sample-golang.git`
    repo-clone-url: option<string>
  }

  record create-body-spec-functions-item-github {
    /// The name of the branch to use
    branch: option<string>,
    /// Whether to automatically deploy new commits made to the repo
    deploy-on-push: option<bool>,
    /// The name of the repo in the format owner/repo. Example: `digitalocean/sample-golang`
    repo: option<string>
  }

  record create-body-spec-functions-item-gitlab {
    /// The name of the branch to use
    branch: option<string>,
    /// Whether to automatically deploy new commits made to the repo
    deploy-on-push: option<bool>,
    /// The name of the repo in the format owner/repo. Example: `digitalocean/sample-golang`
    repo: option<string>
  }

  record create-body-spec-functions-item-log-destinations {
    /// DataDog configuration.
    datadog: option<create-body-spec-functions-item-log-destinations-datadog>,
    /// Logtail configuration.
    logtail: option<create-body-spec-functions-item-log-destinations-logtail>,
    name: string,
    /// Papertrail configuration.
    papertrail: option<create-body-spec-functions-item-log-destinations-papertrail>
  }

  /// DataDog configuration.
  record create-body-spec-functions-item-log-destinations-datadog {
    /// Datadog API key.
    api-key: string,
    /// Datadog HTTP log intake endpoint.
    endpoint: option<string>
  }

  /// Logtail configuration.
  record create-body-spec-functions-item-log-destinations-logtail {
    /// Logtail token.
    token: option<string>
  }

  /// Papertrail configuration.
  record create-body-spec-functions-item-log-destinations-papertrail {
    /// Papertrail syslog endpoint.
    endpoint: string
  }

  record create-body-spec-functions-item-routes-item {
    /// An HTTP path prefix. Paths must start with / and must be unique across all components within an app.
    path: option<string>,
    /// An optional flag to preserve the path that is forwarded to the backend service. By default, the HTTP request path will be trimmed from the left when forwarded to the component. For example, a component with `path=/api` will have requests to `/api/list` trimmed to `/list`. If this value is `true`, the path will remain `/api/list`.
    preserve-path-prefix: option<bool>
  }

  /// Specification for app ingress configurations.
  record create-body-spec-ingress {
    /// Rules for configuring HTTP ingress for component routes, CORS, rewrites, and redirects.
    rules: option<list<create-body-spec-ingress-rules-item>>
  }

  record create-body-spec-ingress-rules-item {
    /// The component to route to. Only one of `component` or `redirect` may be set.
    component: option<create-body-spec-ingress-rules-item-component>,
    cors: option<create-body-spec-ingress-rules-item-cors>,
    /// The match configuration for the rule.
    match: option<create-body-spec-ingress-rules-item-match>,
    /// The redirect configuration for the rule. Only one of `component` or `redirect` may be set.
    redirect: option<create-body-spec-ingress-rules-item-redirect>
  }

  /// The component to route to. Only one of `component` or `redirect` may be set.
  record create-body-spec-ingress-rules-item-component {
    /// The name of the component to route to.
    name: string,
    /// An optional flag to preserve the path that is forwarded to the backend service. By default, the HTTP request path will be trimmed from the left when forwarded to the component. For example, a component with `path=/api` will have requests to `/api/list` trimmed to `/list`. If this value is `true`, the path will remain `/api/list`. Note: this is not applicable for Functions Components and is mutually exclusive with `rewrite`.
    preserve-path-prefix: option<string>,
    /// An optional field that will rewrite the path of the component to be what is specified here. By default, the HTTP request path will be trimmed from the left when forwarded to the component. For example, a component with `path=/api` will have requests to `/api/list` trimmed to `/list`. If you specified the rewrite to be `/v1/`, requests to `/api/list` would be rewritten to `/v1/list`. Note: this is mutually exclusive with `preserve_path_prefix`.
    rewrite: option<string>
  }

  record create-body-spec-ingress-rules-item-cors {
    /// Whether browsers should expose the response to the client-side JavaScript code when the request’s credentials mode is include. This configures the `Access-Control-Allow-Credentials` header.
    allow-credentials: option<bool>,
    /// The set of allowed HTTP request headers. This configures the `Access-Control-Allow-Headers` header.
    allow-headers: option<list<string>>,
    /// The set of allowed HTTP methods. This configures the `Access-Control-Allow-Methods` header.
    allow-methods: option<list<string>>,
    /// The set of allowed CORS origins.
    allow-origins: option<list<create-body-spec-ingress-rules-item-cors-allow-origins-item>>,
    /// The set of HTTP response headers that browsers are allowed to access. This configures the `Access-Control-Expose-Headers` header.
    expose-headers: option<list<string>>,
    /// An optional duration specifying how long browsers can cache the results of a preflight request. This configures the `Access-Control-Max-Age` header.
    max-age: option<string>
  }

  record create-body-spec-ingress-rules-item-cors-allow-origins-item {
    /// Exact string match. Only 1 of `exact`, `prefix`, or `regex` must be set.
    exact: option<string>,
    /// Prefix-based match. Only 1 of `exact`, `prefix`, or `regex` must be set.
    prefix: option<string>,
    /// RE2 style regex-based match. Only 1 of `exact`, `prefix`, or `regex` must be set. For more information about RE2 syntax, see: https://github.com/google/re2/wiki/Syntax
    regex: option<string>
  }

  /// The match configuration for the rule.
  record create-body-spec-ingress-rules-item-match {
    /// The path to match on.
    path: create-body-spec-ingress-rules-item-match-path
  }

  /// The path to match on.
  record create-body-spec-ingress-rules-item-match-path {
    /// Prefix-based match. For example, `/api` will match `/api`, `/api/`, and any nested paths such as `/api/v1/endpoint`.
    prefix: string
  }

  /// The redirect configuration for the rule. Only one of `component` or `redirect` may be set.
  record create-body-spec-ingress-rules-item-redirect {
    /// The authority/host to redirect to. This can be a hostname or IP address. Note: use `port` to set the port.
    authority: option<string>,
    /// The port to redirect to.
    port: option<s64>,
    /// The redirect code to use. Defaults to `302`. Supported values are 300, 301, 302, 303, 304, 307, 308.
    redirect-code: option<s64>,
    /// The scheme to redirect to. Supported values are `http` or `https`. Default: `https`.
    scheme: option<string>,
    /// An optional URI path to redirect to. Note: if this is specified the whole URI of the original request will be overwritten to this value, irrespective of the original request URI being matched.
    uri: option<string>
  }

  /// The desired configuration of an application.
  record validate-app-spec-body-spec {
    /// Database instances which can provide persistence to workloads within the
    /// application.
    databases: option<list<validate-app-spec-body-spec-databases-item>>,
    /// A set of hostnames where the application will be available.
    domains: option<list<validate-app-spec-body-spec-domains-item>>,
    /// Workloads which expose publicly-accessible HTTP services via Functions Components.
    functions: option<list<validate-app-spec-body-spec-functions-item>>,
    /// Specification for app ingress configurations.
    ingress: option<validate-app-spec-body-spec-ingress>,
    /// Pre and post deployment workloads which do not expose publicly-accessible HTTP routes.
    jobs: option<list<string>>,
    /// The name of the app. Must be unique across all apps in the same account.
    name: string,
    /// The slug form of the geographical origin of the app. Default: `nearest available`
    region: option<create-body-spec-region-enum>,
    /// Workloads which expose publicly-accessible HTTP services.
    services: option<list<string>>,
    /// Content which can be rendered to static web assets.
    static-sites: option<list<string>>,
    /// Workloads which do not expose publicly-accessible HTTP services.
    workers: option<list<string>>
  }

  record validate-app-spec-body-spec-databases-item {
    /// The name of the underlying DigitalOcean DBaaS cluster. This is required for production databases. For dev databases, if cluster_name is not set, a new cluster will be provisioned.
    cluster-name: option<string>,
    /// The name of the MySQL or PostgreSQL database to configure.
    db-name: option<string>,
    /// The name of the MySQL or PostgreSQL user to configure.
    db-user: option<string>,
    /// - MYSQL: MySQL
    /// - PG: PostgreSQL
    engine: option<create-body-spec-databases-item-engine-enum>,
    /// The name. Must be unique across all components within the same app.
    name: string,
    /// Whether this is a production or dev database.
    production: option<bool>,
    /// The version of the database engine
    version: option<string>
  }

  record validate-app-spec-body-spec-domains-item {
    /// The hostname for the domain
    domain: string,
    /// The minimum version of TLS a client application can use to access resources for the domain.  Must be one of the following values wrapped within quotations: `"1.2"` or `"1.3"`.
    minimum-tls-version: option<create-body-spec-domains-item-minimum-tls-version-enum>,
    /// - DEFAULT: The default `.ondigitalocean.app` domain assigned to this app
    /// - PRIMARY: The primary domain for this app that is displayed as the default in the control panel, used in bindable environment variables, and any other places that reference an app's live URL. Only one domain may be set as primary.
    type-op: option<create-body-spec-domains-item-type-op-enum>,
    /// Indicates whether the domain includes all sub-domains, in addition to the given domain
    wildcard: option<bool>,
    /// Optional. If the domain uses DigitalOcean DNS and you would like App
    /// Platform to automatically manage it for you, set this to the name of the
    zone: option<string>
  }

  record validate-app-spec-body-spec-functions-item {
    alerts: option<list<validate-app-spec-body-spec-functions-item-alerts-item>>,
    cors: option<validate-app-spec-body-spec-functions-item-cors>,
    /// A list of environment variables made available to the component.
    envs: option<list<validate-app-spec-body-spec-functions-item-envs-item>>,
    git: option<validate-app-spec-body-spec-functions-item-git>,
    github: option<validate-app-spec-body-spec-functions-item-github>,
    gitlab: option<validate-app-spec-body-spec-functions-item-gitlab>,
    log-destinations: option<validate-app-spec-body-spec-functions-item-log-destinations>,
    /// The name. Must be unique across all components within the same app.
    name: string,
    /// A list of HTTP routes that should be routed to this component.
    routes: option<list<validate-app-spec-body-spec-functions-item-routes-item>>,
    /// An optional path to the working directory to use for the build. For Dockerfile builds, this will be used as the build context. Must be relative to the root of the repo.
    source-dir: option<string>
  }

  record validate-app-spec-body-spec-functions-item-alerts-item {
    /// Is the alert disabled?
    disabled: option<bool>,
    operator: option<create-body-spec-functions-item-alerts-item-operator-enum>,
    rule: option<create-body-spec-functions-item-alerts-item-rule-enum>,
    /// Threshold value for alert
    value: option<f64>,
    window: option<create-body-spec-functions-item-alerts-item-window-enum>
  }

  record validate-app-spec-body-spec-functions-item-cors {
    /// Whether browsers should expose the response to the client-side JavaScript code when the request’s credentials mode is include. This configures the `Access-Control-Allow-Credentials` header.
    allow-credentials: option<bool>,
    /// The set of allowed HTTP request headers. This configures the `Access-Control-Allow-Headers` header.
    allow-headers: option<list<string>>,
    /// The set of allowed HTTP methods. This configures the `Access-Control-Allow-Methods` header.
    allow-methods: option<list<string>>,
    /// The set of allowed CORS origins.
    allow-origins: option<list<validate-app-spec-body-spec-functions-item-cors-allow-origins-item>>,
    /// The set of HTTP response headers that browsers are allowed to access. This configures the `Access-Control-Expose-Headers` header.
    expose-headers: option<list<string>>,
    /// An optional duration specifying how long browsers can cache the results of a preflight request. This configures the `Access-Control-Max-Age` header.
    max-age: option<string>
  }

  record validate-app-spec-body-spec-functions-item-cors-allow-origins-item {
    /// Exact string match. Only 1 of `exact`, `prefix`, or `regex` must be set.
    exact: option<string>,
    /// Prefix-based match. Only 1 of `exact`, `prefix`, or `regex` must be set.
    prefix: option<string>,
    /// RE2 style regex-based match. Only 1 of `exact`, `prefix`, or `regex` must be set. For more information about RE2 syntax, see: https://github.com/google/re2/wiki/Syntax
    regex: option<string>
  }

  record validate-app-spec-body-spec-functions-item-envs-item {
    /// The variable name
    key: string,
    /// - RUN_TIME: Made available only at run-time
    /// - BUILD_TIME: Made available only at build-time
    scope: option<create-body-spec-functions-item-envs-item-scope-enum>,
    /// - GENERAL: A plain-text environment variable
    /// - SECRET: A secret encrypted environment variable
    type-op: option<create-body-spec-functions-item-envs-item-type-op-enum>,
    /// The value. If the type is `SECRET`, the value will be encrypted on first submission. On following submissions, the encrypted value should be used.
    value: option<string>
  }

  record validate-app-spec-body-spec-functions-item-git {
    /// The name of the branch to use
    branch: option<string>,
    /// The clone URL of the repo. Example: `https://github.com/digitalocean/sample-golang.git`
    repo-clone-url: option<string>
  }

  record validate-app-spec-body-spec-functions-item-github {
    /// The name of the branch to use
    branch: option<string>,
    /// Whether to automatically deploy new commits made to the repo
    deploy-on-push: option<bool>,
    /// The name of the repo in the format owner/repo. Example: `digitalocean/sample-golang`
    repo: option<string>
