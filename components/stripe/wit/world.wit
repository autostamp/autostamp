  post-test-helpers-treasury-outbound-transfers-outbound-transfer-return: func(params: post-test-helpers-treasury-outbound-transfers-outbound-transfer-return-params) -> result<treasury-outbound-transfer, string>;

  record post-test-helpers-treasury-received-credits-params {
    /// Amount (in cents) to be transferred.
    amount: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// An arbitrary string attached to the object. Often useful for displaying to users.
    description: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// The FinancialAccount to send funds to.
    financial-account: string,
    /// Initiating payment method details for the object.
    initiating-payment-method-details: option<post-test-helpers-treasury-received-credits-body-initiating-payment-method-details>,
    /// The rails used for the object.
    network: outbound-transfers-payment-method-details-us-bank-account-network-enum
  }
  post-test-helpers-treasury-received-credits: func(params: post-test-helpers-treasury-received-credits-params) -> result<treasury-received-credit, string>;

  record post-test-helpers-treasury-received-debits-params {
    /// Amount (in cents) to be transferred.
    amount: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// An arbitrary string attached to the object. Often useful for displaying to users.
    description: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// The FinancialAccount to pull funds from.
    financial-account: string,
    /// Initiating payment method details for the object.
    initiating-payment-method-details: option<post-test-helpers-treasury-received-debits-body-initiating-payment-method-details>,
    /// The rails used for the object.
    network: post-test-helpers-treasury-received-debits-body-network-enum
  }
  post-test-helpers-treasury-received-debits: func(params: post-test-helpers-treasury-received-debits-params) -> result<treasury-received-debit, string>;

}

