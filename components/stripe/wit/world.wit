interface disputes {
  enum balance-transaction-object-enum {
    balance-transaction,
  }

  enum balance-transaction-type-op-enum {
    adjustment,
    advance,
    advance-funding,
    anticipation-repayment,
    application-fee,
    application-fee-refund,
    charge,
    connect-collection-transfer,
    contribution,
    issuing-authorization-hold,
    issuing-authorization-release,
    issuing-dispute,
    issuing-transaction,
    payment,
    payment-failure-refund,
    payment-refund,
    payout,
    payout-cancel,
    payout-failure,
    refund,
    refund-failure,
    reserve-transaction,
    reserved-funds,
    stripe-fee,
    stripe-fx-fee,
    tax-fee,
    topup,
    topup-reversal,
    transfer,
    transfer-cancel,
    transfer-failure,
    transfer-refund,
  }

  enum dispute-object-enum {
    dispute,
  }

  enum dispute-status-enum {
    charge-refunded,
    lost,
    needs-response,
    under-review,
    warning-closed,
    warning-needs-response,
    warning-under-review,
    won,
  }

  enum get-disputes-response-object-enum {
    list-op,
  }

  record get-disputes-response {
    data: list<dispute>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-disputes-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A dispute occurs when a customer questions your charge with their card issuer.
  /// When this happens, you're given the opportunity to respond to the dispute with
  /// evidence that shows that the charge is legitimate. You can find more
  /// information about the dispute process in our [Disputes and
  /// Fraud](/docs/disputes) documentation.
  /// 
  /// Related guide: [Disputes and Fraud](https://stripe.com/docs/disputes).
  record dispute {
    /// Disputed amount. Usually the amount of the charge, but can differ (usually because of currency fluctuation or because only part of the order is disputed).
    amount: s32,
    /// List of zero, one, or two balance transactions that show funds withdrawn and reinstated to your Stripe account as a result of this dispute.
    balance-transactions: list<balance-transaction>,
    /// ID of the charge that was disputed.
    charge: string,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    evidence: dispute-evidence,
    evidence-details: dispute-evidence-details,
    /// Unique identifier for the object.
    id: string,
    /// If true, it is still possible to refund the disputed payment. Once the payment has been fully refunded, no further funds will be withdrawn from your Stripe account as a result of this dispute.
    is-charge-refundable: bool,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<dispute-metadata-entry>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: dispute-object-enum,
    /// ID of the PaymentIntent that was disputed.
    payment-intent: option<string>,
    /// Reason given by cardholder for dispute. Possible values are `bank_cannot_process`, `check_returned`, `credit_not_processed`, `customer_initiated`, `debit_not_authorized`, `duplicate`, `fraudulent`, `general`, `incorrect_account_details`, `insufficient_funds`, `product_not_received`, `product_unacceptable`, `subscription_canceled`, or `unrecognized`. Read more about [dispute reasons](https://stripe.com/docs/disputes/categories).
    reason: string,
    /// Current status of dispute. Possible values are `warning_needs_response`, `warning_under_review`, `warning_closed`, `needs_response`, `under_review`, `charge_refunded`, `won`, or `lost`.
    status: dispute-status-enum
  }

  /// Balance transactions represent funds moving through your Stripe account.
  /// They're created for every type of transaction that comes into or flows out of your Stripe account balance.
  /// 
  /// Related guide: [Balance Transaction Types](https://stripe.com/docs/reports/balance-transaction-types).
  record balance-transaction {
    /// Gross amount of the transaction, in %s.
    amount: s32,
    /// The date the transaction's net funds will become available in the Stripe balance.
    available-on: s32,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// An arbitrary string attached to the object. Often useful for displaying to users.
    description: option<string>,
    /// The exchange rate used, if applicable, for this transaction. Specifically, if money was converted from currency A to currency B, then the `amount` in currency A, times `exchange_rate`, would be the `amount` in currency B. For example, suppose you charged a customer 10.00 EUR. Then the PaymentIntent's `amount` would be `1000` and `currency` would be `eur`. Suppose this was converted into 12.34 USD in your Stripe account. Then the BalanceTransaction's `amount` would be `1234`, `currency` would be `usd`, and `exchange_rate` would be `1.234`.
    exchange-rate: option<f64>,
    /// Fees (in %s) paid for this transaction.
    fee: s32,
    /// Detailed breakdown of fees (in %s) paid for this transaction.
    fee-details: list<fee>,
    /// Unique identifier for the object.
    id: string,
    /// Net amount of the transaction, in %s.
    net: s32,
    /// String representing the object's type. Objects of the same type share the same value.
    object: balance-transaction-object-enum,
    /// [Learn more](https://stripe.com/docs/reports/reporting-categories) about how reporting categories can help you understand balance transactions from an accounting perspective.
    reporting-category: string,
    /// The Stripe object to which this transaction is related.
    source: option<string>,
    /// If the transaction's net funds are available in the Stripe balance yet. Either `available` or `pending`.
    status: string,
    /// Transaction type: `adjustment`, `advance`, `advance_funding`, `anticipation_repayment`, `application_fee`, `application_fee_refund`, `charge`, `connect_collection_transfer`, `contribution`, `issuing_authorization_hold`, `issuing_authorization_release`, `issuing_dispute`, `issuing_transaction`, `payment`, `payment_failure_refund`, `payment_refund`, `payout`, `payout_cancel`, `payout_failure`, `refund`, `refund_failure`, `reserve_transaction`, `reserved_funds`, `stripe_fee`, `stripe_fx_fee`, `tax_fee`, `topup`, `topup_reversal`, `transfer`, `transfer_cancel`, `transfer_failure`, or `transfer_refund`. [Learn more](https://stripe.com/docs/reports/balance-transaction-types) about balance transaction types and what they represent. If you are looking to classify transactions for accounting purposes, you might want to consider `reporting_category` instead.
    type-op: balance-transaction-type-op-enum
  }

  record fee {
    /// Amount of the fee, in cents.
    amount: s32,
    /// ID of the Connect application that earned the fee.
    application: option<string>,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// An arbitrary string attached to the object. Often useful for displaying to users.
    description: option<string>,
    /// Type of the fee, one of: `application_fee`, `stripe_fee` or `tax`.
    type-op: string
  }

  record dispute-evidence {
    /// Any server or activity logs showing proof that the customer accessed or downloaded the purchased digital product. This information should include IP addresses, corresponding timestamps, and any detailed recorded activity.
    access-activity-log: option<string>,
    /// The billing address provided by the customer.
    billing-address: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Your subscription cancellation policy, as shown to the customer.
    cancellation-policy: option<string>,
    /// An explanation of how and when the customer was shown your refund policy prior to purchase.
    cancellation-policy-disclosure: option<string>,
    /// A justification for why the customer's subscription was not canceled.
    cancellation-rebuttal: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Any communication with the customer that you feel is relevant to your case. Examples include emails proving that the customer received the product or service, or demonstrating their use of or satisfaction with the product or service.
    customer-communication: option<string>,
    /// The email address of the customer.
    customer-email-address: option<string>,
    /// The name of the customer.
    customer-name: option<string>,
    /// The IP address that the customer used when making the purchase.
    customer-purchase-ip: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) A relevant document or contract showing the customer's signature.
    customer-signature: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Documentation for the prior charge that can uniquely identify the charge, such as a receipt, shipping label, work order, etc. This document should be paired with a similar document from the disputed payment that proves the two payments are separate.
    duplicate-charge-documentation: option<string>,
    /// An explanation of the difference between the disputed charge versus the prior charge that appears to be a duplicate.
    duplicate-charge-explanation: option<string>,
    /// The Stripe ID for the prior charge which appears to be a duplicate of the disputed charge.
    duplicate-charge-id: option<string>,
    /// A description of the product or service that was sold.
    product-description: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Any receipt or message sent to the customer notifying them of the charge.
    receipt: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Your refund policy, as shown to the customer.
    refund-policy: option<string>,
    /// Documentation demonstrating that the customer was shown your refund policy prior to purchase.
    refund-policy-disclosure: option<string>,
    /// A justification for why the customer is not entitled to a refund.
    refund-refusal-explanation: option<string>,
    /// The date on which the customer received or began receiving the purchased service, in a clear human-readable format.
    service-date: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Documentation showing proof that a service was provided to the customer. This could include a copy of a signed contract, work order, or other form of written agreement.
    service-documentation: option<string>,
    /// The address to which a physical product was shipped. You should try to include as complete address information as possible.
    shipping-address: option<string>,
    /// The delivery service that shipped a physical product, such as Fedex, UPS, USPS, etc. If multiple carriers were used for this purchase, please separate them with commas.
    shipping-carrier: option<string>,
    /// The date on which a physical product began its route to the shipping address, in a clear human-readable format.
    shipping-date: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Documentation showing proof that a product was shipped to the customer at the same address the customer provided to you. This could include a copy of the shipment receipt, shipping label, etc. It should show the customer's full shipping address, if possible.
    shipping-documentation: option<string>,
    /// The tracking number for a physical product, obtained from the delivery service. If multiple tracking numbers were generated for this purchase, please separate them with commas.
    shipping-tracking-number: option<string>,
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Any additional evidence or statements.
    uncategorized-file: option<string>,
    /// Any additional evidence or statements.
    uncategorized-text: option<string>
  }

  record dispute-evidence-details {
    /// Date by which evidence must be submitted in order to successfully challenge dispute. Will be 0 if the customer's bank or credit card company doesn't allow a response for this particular dispute.
    due-by: option<s32>,
    /// Whether evidence has been staged for this dispute.
    has-evidence: bool,
    /// Whether the last evidence submission was submitted past the due date. Defaults to `false` if no evidence submissions have occurred. If `true`, then delivery of the latest evidence is *not* guaranteed.
    past-due: bool,
    /// The number of times evidence has been submitted. Typically, you may only submit evidence once.
    submission-count: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record dispute-metadata-entry {
    key: string,
    value: string
  }

  /// Evidence to upload, to respond to a dispute. Updating any field in the hash will submit all fields in the hash for review. The combined character count of all fields is limited to 150,000.
  record post-disputes-dispute-body-evidence {
    access-activity-log: option<string>,
    billing-address: option<string>,
    cancellation-policy: option<string>,
    cancellation-policy-disclosure: option<string>,
    cancellation-rebuttal: option<string>,
    customer-communication: option<string>,
    customer-email-address: option<string>,
    customer-name: option<string>,
    customer-purchase-ip: option<string>,
    customer-signature: option<string>,
    duplicate-charge-documentation: option<string>,
    duplicate-charge-explanation: option<string>,
    duplicate-charge-id: option<string>,
    product-description: option<string>,
    receipt: option<string>,
    refund-policy: option<string>,
    refund-policy-disclosure: option<string>,
    refund-refusal-explanation: option<string>,
    service-date: option<string>,
    service-documentation: option<string>,
    shipping-address: option<string>,
    shipping-carrier: option<string>,
    shipping-date: option<string>,
    shipping-documentation: option<string>,
    shipping-tracking-number: option<string>,
    uncategorized-file: option<string>,
    uncategorized-text: option<string>
  }

  record get-disputes-params {
    /// Only return disputes associated to the charge specified by this charge ID.
    charge: option<string>,
    created: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// Only return disputes associated to the PaymentIntent specified by this PaymentIntent ID.
    payment-intent: option<string>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-disputes: func(params: get-disputes-params) -> result<get-disputes-response, string>;

  record get-disputes-dispute-params {
    dispute: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-disputes-dispute: func(params: get-disputes-dispute-params) -> result<dispute, string>;

  record post-disputes-dispute-params {
    dispute: string,
    /// Evidence to upload, to respond to a dispute. Updating any field in the hash will submit all fields in the hash for review. The combined character count of all fields is limited to 150,000.
    evidence: option<post-disputes-dispute-body-evidence>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// Whether to immediately submit evidence to the bank. If `false`, evidence is staged on the dispute. Staged evidence is visible in the API and Dashboard, and can be submitted to the bank by making another request with this attribute set to `true` (the default).
    submit: option<bool>
  }
  post-disputes-dispute: func(params: post-disputes-dispute-params) -> result<dispute, string>;

  record post-disputes-dispute-close-params {
    dispute: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-disputes-dispute-close: func(params: post-disputes-dispute-close-params) -> result<dispute, string>;

}

interface ephemeral-keys {
  enum ephemeral-key-object-enum {
    ephemeral-key,
  }

  record ephemeral-key {
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Time at which the key will expire. Measured in seconds since the Unix epoch.
    expires: s32,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: ephemeral-key-object-enum,
    /// The key's secret. You can use this value to make authorized requests to the Stripe API.
    secret: option<string>
  }

  record post-ephemeral-keys-params {
    /// The ID of the Customer you'd like to modify using the resulting ephemeral key.
    customer: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// The ID of the Issuing Card you'd like to access using the resulting ephemeral key.
    issuing-card: option<string>,
    /// The ID of the Identity VerificationSession you'd like to access using the resulting ephemeral key
    verification-session: option<string>
  }
  post-ephemeral-keys: func(params: post-ephemeral-keys-params) -> result<ephemeral-key, string>;

  record delete-ephemeral-keys-key-params {
    key: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  delete-ephemeral-keys-key: func(params: delete-ephemeral-keys-key-params) -> result<ephemeral-key, string>;

}

interface events {
  enum event-object-enum {
    event,
  }

  enum get-events-response-object-enum {
    list-op,
  }

  record get-events-response {
    data: list<event>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-events-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Events are our way of letting you know when something interesting happens in
  /// your account. When an interesting event occurs, we create a new `Event`
  /// object. For example, when a charge succeeds, we create a `charge.succeeded`
  /// event; and when an invoice payment attempt fails, we create an
  /// `invoice.payment_failed` event. Note that many API requests may cause multiple
  /// events to be created. For example, if you create a new subscription for a
  /// customer, you will receive both a `customer.subscription.created` event and a
  /// `charge.succeeded` event.
  /// 
  /// Events occur when the state of another API resource changes. The state of that
  /// resource at the time of the change is embedded in the event's data field. For
  /// example, a `charge.succeeded` event will contain a charge, and an
  /// `invoice.payment_failed` event will contain an invoice.
  /// 
  /// As with other API resources, you can use endpoints to retrieve an
  /// [individual event](https://stripe.com/docs/api#retrieve_event) or a [list of events](https://stripe.com/docs/api#list_events)
  /// from the API. We also have a separate
  /// [webhooks](http://en.wikipedia.org/wiki/Webhook) system for sending the
  /// `Event` objects directly to an endpoint on your server. Webhooks are managed
  /// in your
  /// [account settings](https://dashboard.stripe.com/account/webhooks),
  /// and our [Using Webhooks](https://stripe.com/docs/webhooks) guide will help you get set up.
  /// 
  /// When using [Connect](https://stripe.com/docs/connect), you can also receive notifications of
  /// events that occur in connected accounts. For these events, there will be an
  /// additional `account` attribute in the received `Event` object.
  /// 
  /// **NOTE:** Right now, access to events through the [Retrieve Event API](https://stripe.com/docs/api#retrieve_event) is
  /// guaranteed only for 30 days.
  record event {
    /// The connected account that originated the event.
    account: option<string>,
    /// The Stripe API version used to render `data`. *Note: This property is populated only for events on or after October 31, 2014*.
    api-version: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    data: notification-event-data,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: event-object-enum,
    /// Number of webhooks that have yet to be successfully delivered (i.e., to return a 20x response) to the URLs you've specified.
    pending-webhooks: s32,
    /// Information on the API request that instigated the event.
    request: option<string>,
    /// Description of the event (e.g., `invoice.created` or `charge.refunded`).
    type-op: string
  }

  record notification-event-data {
    /// Object containing the API resource relevant to the event. For example, an `invoice.created` event will have a full [invoice object](https://stripe.com/docs/api#invoice_object) as the value of the object key.
    object: list<notification-event-data-object-entry>,
    /// Object containing the names of the attributes that have changed, and their previous values (sent along only with *.updated events).
    previous-attributes: option<list<notification-event-data-previous-attributes-entry>>
  }

  /// one entry of a string-keyed map (free-form object)
  record notification-event-data-object-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record notification-event-data-previous-attributes-entry {
    key: string,
    value: string
  }

  record get-events-params {
    created: option<string>,
    /// Filter events by whether all webhooks were successfully delivered. If false, events which are still pending or have failed all delivery attempts to a webhook endpoint will be returned.
    delivery-success: option<bool>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// A string containing a specific event name, or group of events using * as a wildcard. The list will be filtered to include only events with a matching event property.
    type-op: option<string>,
    /// An array of up to 20 strings containing specific event names. The list will be filtered to include only events with a matching event property. You may pass either `type` or `types`, but not both.
    types: option<list<string>>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-events: func(params: get-events-params) -> result<get-events-response, string>;

  record get-events-id-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    id: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-events-id: func(params: get-events-id-params) -> result<event, string>;

}

interface exchange-rates {
  enum exchange-rate-object-enum {
    exchange-rate,
  }

  enum get-exchange-rates-response-object-enum {
    list-op,
  }

  record get-exchange-rates-response {
    data: list<exchange-rate>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-exchange-rates-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// `Exchange Rate` objects allow you to determine the rates that Stripe is
  /// currently using to convert from one currency to another. Since this number is
  /// variable throughout the day, there are various reasons why you might want to
  /// know the current rate (for example, to dynamically price an item for a user
  /// with a default payment in a foreign currency).
  /// 
  /// If you want a guarantee that the charge is made with a certain exchange rate
  /// you expect is current, you can pass in `exchange_rate` to charges endpoints.
  /// If the value is no longer up to date, the charge won't go through. Please
  /// refer to our [Exchange Rates API](https://stripe.com/docs/exchange-rates) guide for more
  /// details.
  record exchange-rate {
    /// Unique identifier for the object. Represented as the three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) in lowercase.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: exchange-rate-object-enum,
    /// Hash where the keys are supported currencies and the values are the exchange rate at which the base id currency converts to the key currency.
    rates: list<exchange-rate-rates-entry>
  }

  /// one entry of a string-keyed map (free-form object)
  record exchange-rate-rates-entry {
    key: string,
    value: f64
  }

  record get-exchange-rates-params {
    /// A cursor for use in pagination. `ending_before` is the currency that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with the exchange rate for currency X your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and total number of supported payout currencies, and the default is the max.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is the currency that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with the exchange rate for currency X, your subsequent call can include `starting_after=X` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-exchange-rates: func(params: get-exchange-rates-params) -> result<get-exchange-rates-response, string>;

  record get-exchange-rates-rate-id-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    rate-id: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-exchange-rates-rate-id: func(params: get-exchange-rates-rate-id-params) -> result<exchange-rate, string>;

}

interface file-links {
  enum file-link-object-enum {
    file-link,
  }

  enum get-file-links-response-object-enum {
    list-op,
  }

  record get-file-links-response {
    /// Details about each object.
    data: list<file-link>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-file-links-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// To share the contents of a `File` object with non-Stripe users, you can
  /// create a `FileLink`. `FileLink`s contain a URL that can be used to
  /// retrieve the contents of the file without authentication.
  record file-link {
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Whether this link is already expired.
    expired: bool,
    /// Time at which the link expires.
    expires-at: option<s32>,
    /// The file object this link points to.
    file: string,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<file-link-metadata-entry>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: file-link-object-enum,
    /// The publicly accessible URL to download the file.
    url: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record file-link-metadata-entry {
    key: string,
    value: string
  }

  record get-file-links-params {
    created: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Filter links by their expiration status. By default, all links are returned.
    expired: option<bool>,
    /// Only return links for the given file.
    file: option<string>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-file-links: func(params: get-file-links-params) -> result<get-file-links-response, string>;

  record post-file-links-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A future timestamp after which the link will no longer be usable.
    expires-at: option<s32>,
    /// The ID of the file. The file's `purpose` must be one of the following: `business_icon`, `business_logo`, `customer_signature`, `dispute_evidence`, `finance_report_run`, `identity_document_downloadable`, `pci_document`, `selfie`, `sigma_scheduled_query`, `tax_document_user_upload`, or `terminal_reader_splashscreen`.
    file: string,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>
  }
  post-file-links: func(params: post-file-links-params) -> result<file-link, string>;

  record get-file-links-link-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    link: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-file-links-link: func(params: get-file-links-link-params) -> result<file-link, string>;

  record post-file-links-link-params {
    link: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A future timestamp after which the link will no longer be usable, or `now` to expire the link immediately.
    expires-at: option<string>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>
  }
  post-file-links-link: func(params: post-file-links-link-params) -> result<file-link, string>;

}

interface files {
  enum get-files-purpose-enum {
    account-requirement,
    additional-verification,
    business-icon,
    business-logo,
    customer-signature,
    dispute-evidence,
    document-provider-identity-document,
    finance-report-run,
    identity-document,
    identity-document-downloadable,
    pci-document,
    selfie,
    sigma-scheduled-query,
    tax-document-user-upload,
    terminal-reader-splashscreen,
  }

  enum file-link-object-enum {
    file-link,
  }

  enum file-links-object-enum {
    list-op,
  }

  enum file-object-enum {
    file,
  }

  enum post-files-body-purpose-enum {
    account-requirement,
    additional-verification,
    business-icon,
    business-logo,
    customer-signature,
    dispute-evidence,
    identity-document,
    pci-document,
    tax-document-user-upload,
    terminal-reader-splashscreen,
  }

  record get-files-response {
    data: list<file>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: file-links-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// This is an object representing a file hosted on Stripe's servers. The
  /// file may have been uploaded by yourself using the [create file](https://stripe.com/docs/api#create_file)
  /// request (for example, when uploading dispute evidence) or it may have
  /// been created by Stripe (for example, the results of a [Sigma scheduled
  /// query](#scheduled_queries)).
  /// 
  /// Related guide: [File Upload Guide](https://stripe.com/docs/file-upload).
  record file {
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// The time at which the file expires and is no longer available in epoch seconds.
    expires-at: option<s32>,
    /// A filename for the file, suitable for saving to a filesystem.
    filename: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// A list of [file links](https://stripe.com/docs/api#file_links) that point at this file.
    links: option<file-links>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: file-object-enum,
    /// The [purpose](https://stripe.com/docs/file-upload#uploading-a-file) of the uploaded file.
    purpose: get-files-purpose-enum,
    /// The size in bytes of the file object.
    size: s32,
    /// A user friendly title for the document.
    title: option<string>,
    /// The type of the file returned (e.g., `csv`, `pdf`, `jpg`, or `png`).
    type-op: option<string>,
    /// The URL from which the file can be downloaded using your live secret API key.
    url: option<string>
  }

  /// A list of [file links](https://stripe.com/docs/api#file_links) that point at this file.
  record file-links {
    /// Details about each object.
    data: list<file-link>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: file-links-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// To share the contents of a `File` object with non-Stripe users, you can
  /// create a `FileLink`. `FileLink`s contain a URL that can be used to
  /// retrieve the contents of the file without authentication.
  record file-link {
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Whether this link is already expired.
    expired: bool,
    /// Time at which the link expires.
    expires-at: option<s32>,
    /// The file object this link points to.
    file: string,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<file-link-metadata-entry>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: file-link-object-enum,
    /// The publicly accessible URL to download the file.
    url: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record file-link-metadata-entry {
    key: string,
    value: string
  }

  /// Optional parameters to automatically create a [file link](https://stripe.com/docs/api#file_links) for the newly created file.
  record post-files-body-file-link-data {
    create: bool,
    expires-at: option<s32>,
    metadata: option<string>
  }

  record get-files-params {
    created: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// The file purpose to filter queries by. If none is provided, files will not be filtered by purpose.
    purpose: option<get-files-purpose-enum>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-files: func(params: get-files-params) -> result<get-files-response, string>;

  record post-files-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A file to upload. The file should follow the specifications of RFC 2388 (which defines file transfers for the `multipart/form-data` protocol).
    file: string,
    /// Optional parameters to automatically create a [file link](https://stripe.com/docs/api#file_links) for the newly created file.
    file-link-data: option<post-files-body-file-link-data>,
    /// The [purpose](https://stripe.com/docs/file-upload#uploading-a-file) of the uploaded file.
    purpose: post-files-body-purpose-enum
  }
  post-files: func(params: post-files-params) -> result<file, string>;

  record get-files-file-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    file: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-files-file: func(params: get-files-file-params) -> result<file, string>;

}

interface financial-connections {
  enum account-category-enum {
    cash,
    credit,
    investment,
    other,
  }

  enum account-object-enum {
    financial-connections-account,
  }

  enum account-permissions-item-enum {
    balances,
    ownership,
    payment-method,
    transactions,
  }

  enum account-status-enum {
    active,
    disconnected,
    inactive,
  }

  enum account-subcategory-enum {
    checking,
    credit-card,
    line-of-credit,
    mortgage,
    other,
    savings,
  }

  enum account-supported-payment-method-types-item-enum {
    link,
    us-bank-account,
  }

  enum get-financial-connections-accounts-response-object-enum {
    list-op,
  }

  enum account-owner-object-enum {
    financial-connections-account-owner,
  }

  enum post-financial-connections-accounts-account-refresh-body-features-item-enum {
    balance,
    ownership,
  }

  enum post-financial-connections-sessions-body-account-holder-type-op-enum {
    account,
    customer,
  }

  enum session-object-enum {
    financial-connections-session,
  }

  record get-financial-connections-accounts-response {
    /// Details about each object.
    data: list<account>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-financial-connections-accounts-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A Financial Connections Account represents an account that exists outside of Stripe, to which you have been granted some degree of access.
  record account {
    /// The account holder that this account belongs to.
    account-holder: option<string>,
    /// The most recent information about the account's balance.
    balance: option<string>,
    /// The state of the most recent attempt to refresh the account balance.
    balance-refresh: option<string>,
    /// The type of the account. Account category is further divided in `subcategory`.
    category: account-category-enum,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// A human-readable name that has been assigned to this account, either by the account holder or by the institution.
    display-name: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// The name of the institution that holds this account.
    institution-name: string,
    /// The last 4 digits of the account number. If present, this will be 4 numeric characters.
    last4: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: account-object-enum,
    /// The most recent information about the account's owners.
    ownership: option<string>,
    /// The state of the most recent attempt to refresh the account owners.
    ownership-refresh: option<string>,
    /// The list of permissions granted by this account.
    permissions: option<list<account-permissions-item-enum>>,
    /// The status of the link to the account.
    status: account-status-enum,
    /// If `category` is `cash`, one of:
    /// 
    subcategory: account-subcategory-enum,
    /// The [PaymentMethod type](https://stripe.com/docs/api/payment_methods/object#payment_method_object-type)(s) that can be created from this account.
    supported-payment-method-types: list<account-supported-payment-method-types-item-enum>
  }

  record get-financial-connections-accounts-account-owners-response {
    /// Details about each object.
    data: list<account-owner>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-financial-connections-accounts-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  record account-owner {
    /// The email address of the owner.
    email: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// The full name of the owner.
    name: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: account-owner-object-enum,
    /// The ownership object that this owner belongs to.
    ownership: string,
    /// The raw phone number of the owner.
    phone: option<string>,
    /// The raw physical address of the owner.
    raw-address: option<string>,
    /// The timestamp of the refresh that updated this owner.
    refreshed-at: option<s32>
  }

  /// The account holder to link accounts for.
  record post-financial-connections-sessions-body-account-holder {
    account: option<string>,
    customer: option<string>,
    type-op: post-financial-connections-sessions-body-account-holder-type-op-enum
  }

  /// Filters to restrict the kinds of accounts to collect.
  record post-financial-connections-sessions-body-filters {
    countries: list<string>
  }

  /// A Financial Connections Session is the secure way to programmatically launch the client-side Stripe.js modal that lets your users link their accounts.
  record session {
    /// The account holder for whom accounts are collected in this session.
    account-holder: option<string>,
    /// The accounts that were collected as part of this Session.
    accounts: session-accounts,
    /// A value that will be passed to the client to launch the authentication flow.
    client-secret: string,
    filters: option<bank-connections-resource-link-account-session-filters>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: session-object-enum,
    /// Permissions requested for accounts collected during this session.
    permissions: list<account-permissions-item-enum>,
    /// For webview integrations only. Upon completing OAuth login in the native browser, the user will be redirected to this URL to return to your app.
    return-url: option<string>
  }

  /// The accounts that were collected as part of this Session.
  record session-accounts {
    /// Details about each object.
    data: list<account>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-financial-connections-accounts-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  record bank-connections-resource-link-account-session-filters {
    /// List of countries from which to filter accounts.
    countries: option<list<string>>
  }

  record get-financial-connections-accounts-params {
    /// If present, only return accounts that belong to the specified account holder. `account_holder[customer]` and `account_holder[account]` are mutually exclusive.
    account-holder: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// If present, only return accounts that were collected as part of the given session.
    session: option<string>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
