  get-charges-charge-refunds-refund: func(params: get-charges-charge-refunds-refund-params) -> result<refund, string>;

  record post-charges-charge-refunds-refund-params {
    charge: string,
    refund: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    metadata: option<string>
