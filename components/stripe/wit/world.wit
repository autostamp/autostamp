    hypo-bank-burgenland-aktiengesellschaft,
    hypo-noe-lb-fur-niederosterreich-u-wien,
    hypo-oberosterreich-salzburg-steiermark,
    hypo-tirol-bank-ag,
    hypo-vorarlberg-bank-ag,
    marchfelder-bank,
    oberbank-ag,
    raiffeisen-bankengruppe-osterreich,
    schoellerbank-ag,
    sparda-bank-wien,
    volksbank-gruppe,
    volkskreditbank-ag,
    vr-bank-braunau,
  }

  enum post-setup-intents-body-payment-method-data-fpx-bank-enum {
    affin-bank,
    agrobank,
    alliance-bank,
    ambank,
    bank-islam,
    bank-muamalat,
    bank-of-china,
    bank-rakyat,
    bsn,
