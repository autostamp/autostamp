    individual,
    non-profit,
  }

  enum post-tokens-body-account-company-structure-enum {
    empty,
    free-zone-establishment,
    free-zone-llc,
    government-instrumentality,
    governmental-unit,
    incorporated-non-profit,
    limited-liability-partnership,
    llc,
