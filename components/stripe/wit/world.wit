interface terminal {
  enum configuration-object-enum {
    terminal-configuration,
  }

  enum get-terminal-configurations-response-object-enum {
    list-op,
  }

  enum connection-token-object-enum {
    terminal-connection-token,
  }

  enum location-object-enum {
    terminal-location,
  }

  enum get-terminal-readers-device-type-enum {
    bbpos-chipper2x,
    bbpos-wisepad3,
    bbpos-wisepos-e,
    simulated-wisepos-e,
    stripe-m2,
    verifone-p400,
  }

  enum get-terminal-readers-status-enum {
    offline,
    online,
  }

  enum reader-object-enum {
    terminal-reader,
  }

  enum post-terminal-readers-reader-set-reader-display-body-type-op-enum {
    cart,
  }

  record get-terminal-configurations-response {
    data: list<configuration>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-terminal-configurations-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A Configurations object represents how features should be configured for terminal readers.
  record configuration {
    bbpos-wisepos-e: option<configuration-configuration-resource-device-type-specific-config>,
    /// Unique identifier for the object.
    id: string,
    /// Whether this Configuration is the default for your account
    is-account-default: option<bool>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: configuration-object-enum,
    tipping: option<configuration-configuration-resource-tipping>,
    verifone-p400: option<configuration-configuration-resource-device-type-specific-config>
  }

  record configuration-configuration-resource-device-type-specific-config {
    /// A File ID representing an image you would like displayed on the reader.
    splashscreen: option<string>
  }

  record configuration-configuration-resource-tipping {
    aud: option<configuration-configuration-resource-currency-specific-config>,
    cad: option<configuration-configuration-resource-currency-specific-config>,
    chf: option<configuration-configuration-resource-currency-specific-config>,
    czk: option<configuration-configuration-resource-currency-specific-config>,
    dkk: option<configuration-configuration-resource-currency-specific-config>,
    eur: option<configuration-configuration-resource-currency-specific-config>,
    gbp: option<configuration-configuration-resource-currency-specific-config>,
    hkd: option<configuration-configuration-resource-currency-specific-config>,
    myr: option<configuration-configuration-resource-currency-specific-config>,
    nok: option<configuration-configuration-resource-currency-specific-config>,
    nzd: option<configuration-configuration-resource-currency-specific-config>,
    sek: option<configuration-configuration-resource-currency-specific-config>,
    sgd: option<configuration-configuration-resource-currency-specific-config>,
    usd: option<configuration-configuration-resource-currency-specific-config>
  }

  record configuration-configuration-resource-currency-specific-config {
    /// Fixed amounts displayed when collecting a tip
    fixed-amounts: option<list<s32>>,
    /// Percentages displayed when collecting a tip
    percentages: option<list<s32>>,
    /// Below this amount, fixed amounts will be displayed; above it, percentages will be displayed
    smart-tip-threshold: option<s32>
  }

  /// An object containing device type specific settings for BBPOS WisePOS E readers
  record post-terminal-configurations-body-bbpos-wisepos-e {
    splashscreen: option<string>
  }

  /// An object containing device type specific settings for Verifone P400 readers
  record post-terminal-configurations-body-verifone-p400 {
    splashscreen: option<string>
  }

  record deleted-terminal-configuration {
    /// Always true for a deleted object
    deleted: bool,
    /// Unique identifier for the object.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: configuration-object-enum
  }

  /// A Connection Token is used by the Stripe Terminal SDK to connect to a reader.
  /// 
  /// Related guide: [Fleet Management](https://stripe.com/docs/terminal/fleet/locations).
  record connection-token {
    /// The id of the location that this connection token is scoped to. Note that location scoping only applies to internet-connected readers. For more details, see [the docs on scoping connection tokens](https://stripe.com/docs/terminal/fleet/locations#connection-tokens).
    location: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: connection-token-object-enum,
    /// Your application should pass this token to the Stripe Terminal SDK.
    secret: string
  }

  record get-terminal-locations-response {
    data: list<location>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-terminal-configurations-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A Location represents a grouping of readers.
  /// 
  /// Related guide: [Fleet Management](https://stripe.com/docs/terminal/fleet/locations).
  record location {
    address: address,
    /// The ID of a configuration that will be used to customize all readers in this location.
    configuration-overrides: option<string>,
    /// The display name of the location.
    display-name: string,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<location-metadata-entry>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: location-object-enum
  }

  record address {
    /// City, district, suburb, town, or village.
    city: option<string>,
    /// Two-letter country code ([ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)).
    country: option<string>,
    /// Address line 1 (e.g., street, PO Box, or company name).
    line1: option<string>,
    /// Address line 2 (e.g., apartment, suite, unit, or building).
    line2: option<string>,
    /// ZIP or postal code.
    postal-code: option<string>,
    /// State, county, province, or region.
    state: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record location-metadata-entry {
    key: string,
    value: string
  }

  /// The full address of the location.
  record post-terminal-locations-body-address {
    city: option<string>,
    country: string,
    line1: option<string>,
    line2: option<string>,
    postal-code: option<string>,
    state: option<string>
  }

  /// The full address of the location.
  record post-terminal-locations-location-body-address {
    city: option<string>,
    country: option<string>,
    line1: option<string>,
    line2: option<string>,
    postal-code: option<string>,
    state: option<string>
  }

  record deleted-terminal-location {
    /// Always true for a deleted object
    deleted: bool,
    /// Unique identifier for the object.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: location-object-enum
  }

  record get-terminal-readers-response {
    /// A list of readers
    data: list<reader>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-terminal-configurations-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A Reader represents a physical device for accepting payment details.
  /// 
  /// Related guide: [Connecting to a Reader](https://stripe.com/docs/terminal/payments/connect-reader).
  record reader {
    /// The most recent action performed by the reader.
    action: option<string>,
    /// The current software version of the reader.
    device-sw-version: option<string>,
    /// Type of reader, one of `bbpos_wisepad3`, `stripe_m2`, `bbpos_chipper2x`, `bbpos_wisepos_e`, `verifone_P400`, or `simulated_wisepos_e`.
