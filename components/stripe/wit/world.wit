    /// Indicates if a plan's `trial_period_days` should be applied to the subscription. Setting `trial_end` per subscription is preferred, and this defaults to `false`. Setting this flag to `true` together with `trial_end` is not allowed. See [Using trial periods on subscriptions](https://stripe.com/docs/billing/subscriptions/trials) to learn more.
    trial-from-plan: option<bool>,
    /// Settings related to subscription trials.
    trial-settings: option<post-customers-customer-subscriptions-subscription-exposed-id-body-trial-settings>
  }
  post-customers-customer-subscriptions-subscription-exposed-id: func(params: post-customers-customer-subscriptions-subscription-exposed-id-params) -> result<subscription, string>;

  record delete-customers-customer-subscriptions-subscription-exposed-id-params {
    customer: string,
    subscription-exposed-id: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Can be set to `true` if `at_period_end` is not set to `true`. Will generate a final invoice that invoices for any un-invoiced metered usage and new/pending proration invoice items.
    invoice-now: option<bool>,
    /// Can be set to `true` if `at_period_end` is not set to `true`. Will generate a proration invoice item that credits remaining unused time until the subscription period end.
    prorate: option<bool>
  }
  delete-customers-customer-subscriptions-subscription-exposed-id: func(params: delete-customers-customer-subscriptions-subscription-exposed-id-params) -> result<subscription, string>;

  record get-customers-customer-subscriptions-subscription-exposed-id-discount-params {
