  enum post-checkout-sessions-body-shipping-options-item-shipping-rate-data-delivery-estimate-maximum-unit-enum {
    business-day,
    day,
    hour,
    month,
    week,
  }

  enum post-checkout-sessions-body-shipping-options-item-shipping-rate-data-type-op-enum {
    fixed-amount,
  }

  enum post-checkout-sessions-body-subscription-data-trial-settings-end-behavior-missing-payment-method-enum {
    cancel,
    create-invoice,
    pause,
  }

  record get-checkout-sessions-response {
    data: list<session>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: session-line-items-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A Checkout Session represents your customer's session as they pay for
  /// one-time purchases or subscriptions through [Checkout](https://stripe.com/docs/payments/checkout)
  /// or [Payment Links](https://stripe.com/docs/payments/payment-links). We recommend creating a
  /// new Session each time your customer attempts to pay.
  /// 
  /// Once payment is successful, the Checkout Session will contain a reference
  /// to the [Customer](https://stripe.com/docs/api/customers), and either the successful
  /// [PaymentIntent](https://stripe.com/docs/api/payment_intents) or an active
  /// [Subscription](https://stripe.com/docs/api/subscriptions).
  /// 
  /// You can create a Checkout Session on your server and redirect to its URL
  /// to begin Checkout.
  /// 
  /// Related guide: [Checkout Quickstart](https://stripe.com/docs/checkout/quickstart).
  record session {
    /// When set, provides configuration for actions to take if this Checkout Session expires.
    after-expiration: option<string>,
    /// Enables user redeemable promotion codes.
    allow-promotion-codes: option<bool>,
    /// Total of all items before discounts or taxes are applied.
    amount-subtotal: option<s32>,
    /// Total of all items after discounts and taxes are applied.
    amount-total: option<s32>,
    automatic-tax: payment-pages-checkout-session-automatic-tax,
    /// Describes whether Checkout should collect the customer's billing address.
    billing-address-collection: option<session-billing-address-collection-enum>,
    /// If set, Checkout displays a back button and customers will be directed to this URL if they decide to cancel payment and return to your website.
    cancel-url: option<string>,
    /// A unique string to reference the Checkout Session. This can be a
    /// customer ID, a cart ID, or similar, and can be used to reconcile the
    client-reference-id: option<string>,
    /// Results of `consent_collection` for this session.
    consent: option<string>,
    /// When set, provides configuration for the Checkout Session to gather active consent from customers.
    consent-collection: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: option<string>,
    /// Currency conversion details for automatic currency conversion sessions
    currency-conversion: option<string>,
    /// Collect additional information from your customer using custom fields. Up to 2 fields are supported.
    custom-fields: list<payment-pages-checkout-session-custom-fields>,
    custom-text: payment-pages-checkout-session-custom-text,
    /// The ID of the customer for this Session.
    /// For Checkout Sessions in `payment` or `subscription` mode, Checkout
    customer: option<string>,
    /// Configure whether a Checkout Session creates a Customer when the Checkout Session completes.
    customer-creation: option<session-customer-creation-enum>,
    /// The customer details including the customer's tax exempt status and the customer's tax IDs. Only the customer's email is present on Sessions in `setup` mode.
    customer-details: option<string>,
    /// If provided, this value will be used when the Customer object is created.
    /// If not provided, customers will be asked to enter their email address.
    customer-email: option<string>,
    /// The timestamp at which the Checkout Session will expire.
    expires-at: s32,
    /// Unique identifier for the object.
    id: string,
    /// ID of the invoice created by the Checkout Session, if it exists.
    invoice: option<string>,
    /// Details on the state of invoice creation for the Checkout Session.
    invoice-creation: option<string>,
    /// The line items purchased by the customer.
    line-items: option<session-line-items>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// The IETF language tag of the locale Checkout is displayed in. If blank or `auto`, the browser's locale is used.
    locale: option<session-locale-enum>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<session-metadata-entry>>,
    /// The mode of the Checkout Session.
    mode: session-mode-enum,
    /// String representing the object's type. Objects of the same type share the same value.
    object: session-object-enum,
    /// The ID of the PaymentIntent for Checkout Sessions in `payment` mode.
    payment-intent: option<string>,
    /// The ID of the Payment Link that created this Session.
    payment-link: option<string>,
    /// Configure whether a Checkout Session should collect a payment method.
    payment-method-collection: option<session-customer-creation-enum>,
    /// Payment-method-specific configuration for the PaymentIntent or SetupIntent of this CheckoutSession.
    payment-method-options: option<string>,
    /// A list of the types of payment methods (e.g. card) this Checkout
    /// Session is allowed to accept.
    payment-method-types: list<string>,
    /// The payment status of the Checkout Session, one of `paid`, `unpaid`, or `no_payment_required`.
    /// You can use this value to decide when to fulfill your customer's order.
    payment-status: session-payment-status-enum,
    phone-number-collection: option<payment-pages-checkout-session-phone-number-collection>,
    /// The ID of the original expired Checkout Session that triggered the recovery flow.
    recovered-from: option<string>,
    /// The ID of the SetupIntent for Checkout Sessions in `setup` mode.
    setup-intent: option<string>,
    /// When set, provides configuration for Checkout to collect a shipping address from a customer.
    shipping-address-collection: option<string>,
    /// The details of the customer cost of shipping, including the customer chosen ShippingRate.
    shipping-cost: option<string>,
    /// Shipping information for this Checkout Session.
    shipping-details: option<string>,
    /// The shipping rate options applied to this Session.
    shipping-options: list<payment-pages-checkout-session-shipping-option>,
    /// The status of the Checkout Session, one of `open`, `complete`, or `expired`.
    status: option<session-status-enum>,
    /// Describes the type of transaction being performed by Checkout in order to customize
    /// relevant text on the page, such as the submit button. `submit_type` can only be
    submit-type: option<session-submit-type-enum>,
    /// The ID of the subscription for Checkout Sessions in `subscription` mode.
    subscription: option<string>,
    /// The URL the customer will be directed to after the payment or
    /// subscription creation is successful.
    success-url: string,
    tax-id-collection: option<payment-pages-checkout-session-tax-id-collection>,
    /// Tax and discount details for the computed total amount.
    total-details: option<string>,
    /// The URL to the Checkout Session. Redirect customers to this URL to take them to Checkout. If you’re using [Custom Domains](https://stripe.com/docs/payments/checkout/custom-domains), the URL will use your subdomain. Otherwise, it’ll use `checkout.stripe.com.`
    /// This value is only present when the session is active.
    url: option<string>
  }

  record payment-pages-checkout-session-automatic-tax {
    /// Indicates whether automatic tax is enabled for the session
    enabled: bool,
    /// The status of the most recent automated tax calculation for this session.
    status: option<payment-pages-checkout-session-automatic-tax-status-enum>
  }

  record payment-pages-checkout-session-custom-fields {
    /// Configuration for `type=dropdown` fields.
    dropdown: option<string>,
    /// String of your choice that your integration can use to reconcile this field. Must be unique to this field, alphanumeric, and up to 200 characters.
    key: string,
    label: payment-pages-checkout-session-custom-fields-label,
    /// Configuration for `type=numeric` fields.
    numeric: option<string>,
    /// Whether the customer is required to complete the field before completing the Checkout Session. Defaults to `false`.
    optional: bool,
    /// Configuration for `type=text` fields.
    text: option<string>,
    /// The type of the field.
    type-op: payment-pages-checkout-session-custom-fields-type-op-enum
  }

  record payment-pages-checkout-session-custom-fields-label {
    /// Custom text for the label, displayed to the customer. Up to 50 characters.
    custom: option<string>,
    /// The type of the label.
    type-op: payment-pages-checkout-session-custom-fields-label-type-op-enum
  }

  record payment-pages-checkout-session-custom-text {
    /// Custom text that should be displayed alongside shipping address collection.
    shipping-address: option<string>,
    /// Custom text that should be displayed alongside the payment confirmation button.
    submit: option<string>
  }

  /// The line items purchased by the customer.
  record session-line-items {
    /// Details about each object.
    data: list<item>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: session-line-items-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A line item.
  record item {
    /// Total discount amount applied. If no discounts were applied, defaults to 0.
    amount-discount: s32,
    /// Total before any discounts or taxes are applied.
    amount-subtotal: s32,
    /// Total tax amount applied. If no tax was applied, defaults to 0.
    amount-tax: s32,
    /// Total after discounts and taxes.
    amount-total: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// An arbitrary string attached to the object. Often useful for displaying to users. Defaults to product name.
    description: string,
    /// The discounts applied to the line item.
    discounts: option<list<line-items-discount-amount>>,
    /// Unique identifier for the object.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: item-object-enum,
    /// The price used to generate the line item.
    price: option<string>,
    /// The quantity of products being purchased.
    quantity: option<s32>,
    /// The taxes applied to the line item.
    taxes: option<list<line-items-tax-amount>>
  }

  record line-items-discount-amount {
    /// The amount discounted.
    amount: s32,
    discount: discount
  }

  /// A discount represents the actual application of a [coupon](https://stripe.com/docs/api#coupons) or [promotion code](https://stripe.com/docs/api#promotion_codes).
  /// It contains information about when the discount began, when it will end, and what it is applied to.
  /// 
  /// Related guide: [Applying Discounts to Subscriptions](https://stripe.com/docs/billing/subscriptions/discounts).
  record discount {
    /// The Checkout session that this coupon is applied to, if it is applied to a particular session in payment mode. Will not be present for subscription mode.
    checkout-session: option<string>,
    coupon: coupon,
    /// The ID of the customer associated with this discount.
    customer: option<string>,
    /// If the coupon has a duration of `repeating`, the date that this discount will end. If the coupon has a duration of `once` or `forever`, this attribute will be null.
    end: option<s32>,
    /// The ID of the discount object. Discounts cannot be fetched by ID. Use `expand[]=discounts` in API calls to expand discount IDs in an array.
    id: string,
    /// The invoice that the discount's coupon was applied to, if it was applied directly to a particular invoice.
    invoice: option<string>,
    /// The invoice item `id` (or invoice line item `id` for invoice line items of type='subscription') that the discount's coupon was applied to, if it was applied directly to a particular invoice item or invoice line item.
    invoice-item: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: discount-object-enum,
    /// The promotion code applied to create this discount.
    promotion-code: option<string>,
    /// Date that the coupon was applied.
    start: s32,
    /// The subscription that this coupon is applied to, if it is applied to a particular subscription.
    subscription: option<string>
  }

  /// A coupon contains information about a percent-off or amount-off discount you
  /// might want to apply to a customer. Coupons may be applied to [subscriptions](https://stripe.com/docs/api#subscriptions), [invoices](https://stripe.com/docs/api#invoices),
  /// [checkout sessions](https://stripe.com/docs/api/checkout/sessions), [quotes](https://stripe.com/docs/api#quotes), and more. Coupons do not work with conventional one-off [charges](https://stripe.com/docs/api#create_charge) or [payment intents](https://stripe.com/docs/api/payment_intents).
  record coupon {
    /// Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer.
    amount-off: option<s32>,
    applies-to: option<coupon-applies-to>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// If `amount_off` has been set, the three-letter [ISO code for the currency](https://stripe.com/docs/currencies) of the amount to take off.
    currency: option<string>,
    /// Coupons defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<coupon-currency-options-entry>>,
    /// One of `forever`, `once`, and `repeating`. Describes how long a customer who applies this coupon will get the discount.
    duration: coupon-duration-enum,
    /// If `duration` is `repeating`, the number of months the coupon applies. Null if coupon `duration` is `forever` or `once`.
    duration-in-months: option<s32>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Maximum number of times this coupon can be redeemed, in total, across all customers, before it is no longer valid.
    max-redemptions: option<s32>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<coupon-metadata-entry>>,
    /// Name of the coupon displayed to customers on for instance invoices or receipts.
    name: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: coupon-object-enum,
    /// Percent that will be taken off the subtotal of any invoices for this customer for the duration of the coupon. For example, a coupon with percent_off of 50 will make a %s100 invoice %s50 instead.
    percent-off: option<f64>,
    /// Date after which the coupon can no longer be redeemed.
    redeem-by: option<s32>,
    /// Number of times this coupon has been applied to a customer.
    times-redeemed: s32,
    /// Taking account of the above properties, whether this coupon can still be applied to a customer.
    valid: bool
  }

  record coupon-applies-to {
    /// A list of product IDs this coupon applies to
    products: list<string>
  }

  record coupon-currency-option {
    /// Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer.
    amount-off: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record coupon-currency-options-entry {
    key: string,
    value: coupon-currency-option
  }

  /// one entry of a string-keyed map (free-form object)
  record coupon-metadata-entry {
    key: string,
    value: string
  }

  record line-items-tax-amount {
    /// Amount of tax applied for this rate.
    amount: s32,
    rate: tax-rate
  }

  /// Tax rates can be applied to [invoices](https://stripe.com/docs/billing/invoices/tax-rates), [subscriptions](https://stripe.com/docs/billing/subscriptions/taxes) and [Checkout Sessions](https://stripe.com/docs/payments/checkout/set-up-a-subscription#tax-rates) to collect tax.
  /// 
  /// Related guide: [Tax Rates](https://stripe.com/docs/billing/taxes/tax-rates).
  record tax-rate {
    /// Defaults to `true`. When set to `false`, this tax rate cannot be used with new applications or Checkout Sessions, but will still work for subscriptions and invoices that already have it set.
    active: bool,
    /// Two-letter country code ([ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)).
    country: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// An arbitrary string attached to the tax rate for your internal use only. It will not be visible to your customers.
    description: option<string>,
    /// The display name of the tax rates as it will appear to your customer on their receipt email, PDF, and the hosted invoice page.
    display-name: string,
    /// Unique identifier for the object.
    id: string,
    /// This specifies if the tax rate is inclusive or exclusive.
    inclusive: bool,
    /// The jurisdiction for the tax rate. You can use this label field for tax reporting purposes. It also appears on your customer’s invoice.
    jurisdiction: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<tax-rate-metadata-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: tax-rate-object-enum,
    /// This represents the tax rate percent out of 100.
    percentage: f64,
    /// [ISO 3166-2 subdivision code](https://en.wikipedia.org/wiki/ISO_3166-2:US), without country prefix. For example, "NY" for New York, United States.
    state: option<string>,
    /// The high-level tax type, such as `vat` or `sales_tax`.
    tax-type: option<tax-rate-tax-type-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record tax-rate-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record session-metadata-entry {
    key: string,
    value: string
  }

  record payment-pages-checkout-session-phone-number-collection {
    /// Indicates whether phone number collection is enabled for the session
    enabled: bool
  }

  record payment-pages-checkout-session-shipping-option {
    /// A non-negative integer in cents representing how much to charge.
    shipping-amount: s32,
    /// The shipping rate.
    shipping-rate: string
  }

  record payment-pages-checkout-session-tax-id-collection {
    /// Indicates whether tax ID collection is enabled for the session
    enabled: bool
  }

  /// Configure actions after a Checkout Session has expired.
  record post-checkout-sessions-body-after-expiration {
    recovery: option<post-checkout-sessions-body-after-expiration-recovery>
  }

  record post-checkout-sessions-body-after-expiration-recovery {
    allow-promotion-codes: option<bool>,
    enabled: bool
  }

  /// Settings for automatic tax lookup for this session and resulting payments, invoices, and subscriptions.
  record post-checkout-sessions-body-automatic-tax {
    enabled: bool
  }

  /// Configure fields for the Checkout Session to gather active consent from customers.
  record post-checkout-sessions-body-consent-collection {
    promotions: option<post-checkout-sessions-body-consent-collection-promotions-enum>,
    terms-of-service: option<post-checkout-sessions-body-consent-collection-terms-of-service-enum>
  }

  record post-checkout-sessions-body-custom-fields-item {
    dropdown: option<post-checkout-sessions-body-custom-fields-item-dropdown>,
    key: string,
    label: post-checkout-sessions-body-custom-fields-item-label,
    optional: option<bool>,
    type-op: payment-pages-checkout-session-custom-fields-type-op-enum
  }

  record post-checkout-sessions-body-custom-fields-item-dropdown {
    options: list<post-checkout-sessions-body-custom-fields-item-dropdown-options-item>
  }

  record post-checkout-sessions-body-custom-fields-item-dropdown-options-item {
    label: string,
    value: string
  }

  record post-checkout-sessions-body-custom-fields-item-label {
    custom: string,
    type-op: payment-pages-checkout-session-custom-fields-label-type-op-enum
  }

  /// Display additional text for your customers using custom text.
  record post-checkout-sessions-body-custom-text {
    shipping-address: option<string>,
    submit: option<string>
  }

  /// Controls what fields on Customer can be updated by the Checkout Session. Can only be provided when `customer` is provided.
  record post-checkout-sessions-body-customer-update {
    address: option<post-checkout-sessions-body-customer-update-address-enum>,
    name: option<post-checkout-sessions-body-customer-update-address-enum>,
    shipping: option<post-checkout-sessions-body-customer-update-address-enum>
  }

  record post-checkout-sessions-body-discounts-item {
    coupon: option<string>,
    promotion-code: option<string>
  }

  /// Generate a post-purchase Invoice for one-time payments.
  record post-checkout-sessions-body-invoice-creation {
    enabled: bool,
    invoice-data: option<post-checkout-sessions-body-invoice-creation-invoice-data>
  }

  record post-checkout-sessions-body-invoice-creation-invoice-data {
    account-tax-ids: option<string>,
    custom-fields: option<string>,
    description: option<string>,
    footer: option<string>,
    metadata: option<list<post-checkout-sessions-body-invoice-creation-invoice-data-metadata-entry>>,
    rendering-options: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-checkout-sessions-body-invoice-creation-invoice-data-metadata-entry {
    key: string,
    value: string
  }

  record post-checkout-sessions-body-line-items-item {
    adjustable-quantity: option<post-checkout-sessions-body-line-items-item-adjustable-quantity>,
    dynamic-tax-rates: option<list<string>>,
    price: option<string>,
    price-data: option<post-checkout-sessions-body-line-items-item-price-data>,
    quantity: option<s32>,
    tax-rates: option<list<string>>
  }

