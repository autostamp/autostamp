    /// Indicates if a customer is on or off-session while an invoice payment is attempted. Defaults to `true` (off-session).
    off-session: option<bool>,
    /// Boolean representing whether an invoice is paid outside of Stripe. This will result in no charge being made. Defaults to `false`.
    paid-out-of-band: option<bool>,
    /// A PaymentMethod to be charged. The PaymentMethod must be the ID of a PaymentMethod belonging to the customer associated with the invoice being paid.
    payment-method: option<string>,
    /// A payment source to be charged. The source must be the ID of a source belonging to the customer associated with the invoice being paid.
    source: option<string>
  }
  post-invoices-invoice-pay: func(params: post-invoices-invoice-pay-params) -> result<invoice, string>;

  record post-invoices-invoice-send-params {
    invoice: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-invoices-invoice-send: func(params: post-invoices-invoice-send-params) -> result<invoice, string>;

  record post-invoices-invoice-void-params {
    invoice: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-invoices-invoice-void: func(params: post-invoices-invoice-void-params) -> result<invoice, string>;

}

