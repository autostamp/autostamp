  record post-issuing-cards-card-body-pin {
    encrypted-number: option<string>
  }

  /// Rules that control spending for this card. Refer to our [documentation](https://stripe.com/docs/issuing/controls/spending-controls) for more details.
  record post-issuing-cards-card-body-spending-controls {
    allowed-categories: option<list<card-authorization-controls-allowed-categories-item-enum>>,
    blocked-categories: option<list<card-authorization-controls-allowed-categories-item-enum>>,
    spending-limits: option<list<post-issuing-cards-card-body-spending-controls-spending-limits-item>>
  }

  record post-issuing-cards-card-body-spending-controls-spending-limits-item {
    amount: s32,
    categories: option<list<card-authorization-controls-allowed-categories-item-enum>>,
    interval: card-spending-limit-interval-enum
  }

  record get-issuing-disputes-response {
    data: list<dispute>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-issuing-authorizations-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// As a [card issuer](https://stripe.com/docs/issuing), you can dispute transactions that the cardholder does not recognize, suspects to be fraudulent, or has other issues with.
  /// 
  /// Related guide: [Disputing Transactions](https://stripe.com/docs/issuing/purchases/disputes)
  record dispute {
    /// Disputed amount in the card's currency and in the [smallest currency unit](https://stripe.com/docs/currencies#zero-decimal). Usually the amount of the `transaction`, but can differ (usually because of currency fluctuation).
    amount: s32,
    /// List of balance transactions associated with the dispute.
    balance-transactions: option<list<balance-transaction>>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// The currency the `transaction` was made in.
    currency: string,
    evidence: dispute-evidence,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<dispute-metadata-entry>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: dispute-object-enum,
    /// Current status of the dispute.
    status: get-issuing-disputes-status-enum,
    /// The transaction being disputed.
    transaction: string,
    /// [Treasury](https://stripe.com/docs/api/treasury) details related to this dispute if it was created on a [FinancialAccount](/docs/api/treasury/financial_accounts
    treasury: option<string>
  }

  record dispute-evidence {
    canceled: option<dispute-canceled-evidence>,
    duplicate: option<dispute-duplicate-evidence>,
    fraudulent: option<dispute-fraudulent-evidence>,
    merchandise-not-as-described: option<dispute-merchandise-not-as-described-evidence>,
    not-received: option<dispute-not-received-evidence>,
    other: option<dispute-other-evidence>,
    /// The reason for filing the dispute. Its value will match the field containing the evidence.
    reason: dispute-evidence-reason-enum,
    service-not-as-described: option<dispute-service-not-as-described-evidence>
  }

  record dispute-canceled-evidence {
    /// (ID of a [file upload](https://stripe.com/docs/guides/file-upload)) Additional documentation supporting the dispute.
    additional-documentation: option<string>,
    /// Date when order was canceled.
    canceled-at: option<s32>,
    /// Whether the cardholder was provided with a cancellation policy.
    cancellation-policy-provided: option<bool>,
    /// Reason for canceling the order.
    cancellation-reason: option<string>,
    /// Date when the cardholder expected to receive the product.
    expected-at: option<s32>,
    /// Explanation of why the cardholder is disputing this transaction.
    explanation: option<string>,
    /// Description of the merchandise or service that was purchased.
    product-description: option<string>,
    /// Whether the product was a merchandise or service.
    product-type: option<dispute-canceled-evidence-product-type-enum>,
    /// Result of cardholder's attempt to return the product.
    return-status: option<dispute-canceled-evidence-return-status-enum>,
    /// Date when the product was returned or attempted to be returned.
    returned-at: option<s32>
  }

  record dispute-duplicate-evidence {
