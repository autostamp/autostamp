    fvlbnl22,
    handnl2a,
    ingbnl2a,
    knabnl2h,
    moyonl21,
    rabonl2u,
    rbrbnl21,
    revoie23,
    revolt21,
    snsbnl2a,
    trionl2u,
  }

  enum payment-method-object-enum {
    payment-method,
  }

  enum payment-method-p24-bank-enum {
    alior-bank,
    bank-millennium,
    bank-nowy-bfg-sa,
    bank-pekao-sa,
    banki-spbdzielcze,
    blik,
    bnp-paribas,
    boz,
    citi-handlowy,
    credit-agricole,
    envelobank,
    etransfer-pocztowy24,
    getin-bank,
    ideabank,
    ing,
    inteligo,
    mbank-mtransfer,
    nest-przelew,
    noble-pay,
    pbac-z-ipko,
    plus-bank,
    santander-przelew24,
    tmobile-usbugi-bankowe,
    toyota-bank,
    volkswagen-bank,
  }

  enum payment-method-type-op-enum {
    acss-debit,
    affirm,
    afterpay-clearpay,
    alipay,
    au-becs-debit,
    bacs-debit,
    bancontact,
    blik,
    boleto,
    card,
    card-present,
    cashapp,
    customer-balance,
    eps,
    fpx,
    giropay,
    grabpay,
    ideal,
    interac-present,
    klarna,
    konbini,
    link,
    oxxo,
    p24,
    paynow,
    pix,
    promptpay,
    sepa-debit,
    sofort,
    us-bank-account,
    wechat-pay,
  }

  enum payment-method-us-bank-account-account-holder-type-enum {
    company,
    individual,
  }

  enum payment-method-us-bank-account-account-type-enum {
    checking,
    savings,
  }

  enum get-payment-methods-response-object-enum {
    list-op,
  }

  enum post-payment-methods-body-sofort-country-enum {
    at,
    be,
    de,
    es,
    it,
    nl,
  }

  record get-payment-methods-response {
    data: list<payment-method>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-payment-methods-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// PaymentMethod objects represent your customer's payment instruments.
  /// You can use them with [PaymentIntents](https://stripe.com/docs/payments/payment-intents) to collect payments or save them to
  /// Customer objects to store instrument details for future payments.
  /// 
  /// Related guides: [Payment Methods](https://stripe.com/docs/payments/payment-methods) and [More Payment Scenarios](https://stripe.com/docs/payments/more-payment-scenarios).
  record payment-method {
    acss-debit: option<payment-method-acss-debit>,
    affirm: option<list<payment-method-affirm-entry>>,
    afterpay-clearpay: option<list<payment-method-afterpay-clearpay-entry>>,
    alipay: option<list<payment-flows-private-payment-methods-alipay-entry>>,
    au-becs-debit: option<payment-method-au-becs-debit>,
    bacs-debit: option<payment-method-bacs-debit>,
    bancontact: option<list<payment-method-bancontact-entry>>,
    billing-details: billing-details,
    blik: option<list<payment-method-blik-entry>>,
    boleto: option<payment-method-boleto>,
    card: option<payment-method-card>,
    card-present: option<list<payment-method-card-present-entry>>,
    cashapp: option<list<payment-method-cashapp-entry>>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// The ID of the Customer to which this PaymentMethod is saved. This will not be set when the PaymentMethod has not been saved to a Customer.
    customer: option<string>,
    customer-balance: option<list<payment-method-customer-balance-entry>>,
    eps: option<payment-method-eps>,
    fpx: option<payment-method-fpx>,
    giropay: option<list<payment-method-giropay-entry>>,
    grabpay: option<list<payment-method-grabpay-entry>>,
    /// Unique identifier for the object.
    id: string,
    ideal: option<payment-method-ideal>,
    interac-present: option<list<payment-method-interac-present-entry>>,
    klarna: option<payment-method-klarna>,
    konbini: option<list<payment-method-konbini-entry>>,
    link: option<payment-method-link>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<payment-method-metadata-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: payment-method-object-enum,
    oxxo: option<list<payment-method-oxxo-entry>>,
    p24: option<payment-method-p24>,
    paynow: option<list<payment-method-paynow-entry>>,
    pix: option<list<payment-method-pix-entry>>,
    promptpay: option<list<payment-method-promptpay-entry>>,
    radar-options: option<radar-radar-options>,
    sepa-debit: option<payment-method-sepa-debit>,
    sofort: option<payment-method-sofort>,
    /// The type of the PaymentMethod. An additional hash is included on the PaymentMethod with a name matching this value. It contains additional information specific to the PaymentMethod type.
    type-op: payment-method-type-op-enum,
    us-bank-account: option<payment-method-us-bank-account>,
    wechat-pay: option<list<payment-method-wechat-pay-entry>>
  }

  record payment-method-acss-debit {
    /// Name of the bank associated with the bank account.
    bank-name: option<string>,
    /// Uniquely identifies this particular bank account. You can use this attribute to check whether two bank accounts are the same.
    fingerprint: option<string>,
    /// Institution number of the bank account.
    institution-number: option<string>,
    /// Last four digits of the bank account number.
    last4: option<string>,
    /// Transit number of the bank account.
    transit-number: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-affirm-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-afterpay-clearpay-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-flows-private-payment-methods-alipay-entry {
    key: string,
    value: string
  }

  record payment-method-au-becs-debit {
    /// Six-digit number identifying bank and branch associated with this bank account.
    bsb-number: option<string>,
    /// Uniquely identifies this particular bank account. You can use this attribute to check whether two bank accounts are the same.
    fingerprint: option<string>,
    /// Last four digits of the bank account number.
    last4: option<string>
  }

  record payment-method-bacs-debit {
    /// Uniquely identifies this particular bank account. You can use this attribute to check whether two bank accounts are the same.
    fingerprint: option<string>,
    /// Last four digits of the bank account number.
    last4: option<string>,
    /// Sort code of the bank account. (e.g., `10-20-30`)
    sort-code: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-bancontact-entry {
    key: string,
    value: string
  }

  record billing-details {
    /// Billing address.
    address: option<string>,
    /// Email address.
    email: option<string>,
    /// Full name.
    name: option<string>,
    /// Billing phone number (including extension).
    phone: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-blik-entry {
    key: string,
    value: string
  }

  record payment-method-boleto {
    /// Uniquely identifies the customer tax id (CNPJ or CPF)
    tax-id: string
  }

  record payment-method-card {
    /// Card brand. Can be `amex`, `diners`, `discover`, `eftpos_au`, `jcb`, `mastercard`, `unionpay`, `visa`, or `unknown`.
    brand: string,
    /// Checks on Card address and CVC if provided.
    checks: option<string>,
    /// Two-letter ISO code representing the country of the card. You could use this attribute to get a sense of the international breakdown of cards you've collected.
    country: option<string>,
    /// Two-digit number representing the card's expiration month.
    exp-month: s32,
    /// Four-digit number representing the card's expiration year.
    exp-year: s32,
    /// Uniquely identifies this particular card number. You can use this attribute to check whether two customers who’ve signed up with you are using the same card number, for example. For payment methods that tokenize card information (Apple Pay, Google Pay), the tokenized number might be provided instead of the underlying card number.
    /// 
    fingerprint: option<string>,
    /// Card funding type. Can be `credit`, `debit`, `prepaid`, or `unknown`.
    funding: string,
    /// Details of the original PaymentMethod that created this object.
    generated-from: option<string>,
    /// The last four digits of the card.
    last4: string,
    /// Contains information about card networks that can be used to process the payment.
    networks: option<string>,
    /// Contains details on how this Card may be used for 3D Secure authentication.
    three-d-secure-usage: option<string>,
    /// If this Card is part of a card wallet, this contains the details of the card wallet.
    wallet: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-card-present-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-cashapp-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-customer-balance-entry {
    key: string,
    value: string
  }

  record payment-method-eps {
    /// The customer's bank. Should be one of `arzte_und_apotheker_bank`, `austrian_anadi_bank_ag`, `bank_austria`, `bankhaus_carl_spangler`, `bankhaus_schelhammer_und_schattera_ag`, `bawag_psk_ag`, `bks_bank_ag`, `brull_kallmus_bank_ag`, `btv_vier_lander_bank`, `capital_bank_grawe_gruppe_ag`, `deutsche_bank_ag`, `dolomitenbank`, `easybank_ag`, `erste_bank_und_sparkassen`, `hypo_alpeadriabank_international_ag`, `hypo_noe_lb_fur_niederosterreich_u_wien`, `hypo_oberosterreich_salzburg_steiermark`, `hypo_tirol_bank_ag`, `hypo_vorarlberg_bank_ag`, `hypo_bank_burgenland_aktiengesellschaft`, `marchfelder_bank`, `oberbank_ag`, `raiffeisen_bankengruppe_osterreich`, `schoellerbank_ag`, `sparda_bank_wien`, `volksbank_gruppe`, `volkskreditbank_ag`, or `vr_bank_braunau`.
    bank: option<payment-method-eps-bank-enum>
  }

  record payment-method-fpx {
    /// The customer's bank, if provided. Can be one of `affin_bank`, `agrobank`, `alliance_bank`, `ambank`, `bank_islam`, `bank_muamalat`, `bank_rakyat`, `bsn`, `cimb`, `hong_leong_bank`, `hsbc`, `kfh`, `maybank2u`, `ocbc`, `public_bank`, `rhb`, `standard_chartered`, `uob`, `deutsche_bank`, `maybank2e`, `pb_enterprise`, or `bank_of_china`.
    bank: payment-method-fpx-bank-enum
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-giropay-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-grabpay-entry {
    key: string,
    value: string
  }

  record payment-method-ideal {
    /// The customer's bank, if provided. Can be one of `abn_amro`, `asn_bank`, `bunq`, `handelsbanken`, `ing`, `knab`, `moneyou`, `rabobank`, `regiobank`, `revolut`, `sns_bank`, `triodos_bank`, `van_lanschot`, or `yoursafe`.
    bank: option<payment-method-ideal-bank-enum>,
    /// The Bank Identifier Code of the customer's bank, if the bank was provided.
    bic: option<payment-method-ideal-bic-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-interac-present-entry {
    key: string,
    value: string
  }

  record payment-method-klarna {
    /// The customer's date of birth, if provided.
    dob: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-konbini-entry {
    key: string,
    value: string
  }

  record payment-method-link {
    /// Account owner's email address.
    email: option<string>,
    /// Token used for persistent Link logins.
    persistent-token: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-oxxo-entry {
    key: string,
    value: string
  }

  record payment-method-p24 {
    /// The customer's bank, if provided.
    bank: option<payment-method-p24-bank-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-paynow-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-pix-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-promptpay-entry {
    key: string,
    value: string
  }

  /// Options to configure Radar. See [Radar Session](https://stripe.com/docs/radar/radar-session) for more information.
  record radar-radar-options {
    /// A [Radar Session](https://stripe.com/docs/radar/radar-session) is a snapshot of the browser metadata and device details that help Radar make more accurate predictions on your payments.
    session: option<string>
  }

  record payment-method-sepa-debit {
    /// Bank code of bank associated with the bank account.
    bank-code: option<string>,
    /// Branch code of bank associated with the bank account.
    branch-code: option<string>,
    /// Two-letter ISO code representing the country the bank account is located in.
    country: option<string>,
    /// Uniquely identifies this particular bank account. You can use this attribute to check whether two bank accounts are the same.
    fingerprint: option<string>,
    /// Information about the object that generated this PaymentMethod.
    generated-from: option<string>,
    /// Last four characters of the IBAN.
    last4: option<string>
  }

  record payment-method-sofort {
    /// Two-letter ISO code representing the country the bank account is located in.
    country: option<string>
  }

  record payment-method-us-bank-account {
    /// Account holder type: individual or company.
    account-holder-type: option<payment-method-us-bank-account-account-holder-type-enum>,
    /// Account type: checkings or savings. Defaults to checking if omitted.
    account-type: option<payment-method-us-bank-account-account-type-enum>,
    /// The name of the bank.
    bank-name: option<string>,
    /// The ID of the Financial Connections Account used to create the payment method.
    financial-connections-account: option<string>,
    /// Uniquely identifies this particular bank account. You can use this attribute to check whether two bank accounts are the same.
    fingerprint: option<string>,
    /// Last four digits of the bank account number.
    last4: option<string>,
    /// Contains information about US bank account networks that can be used.
    networks: option<string>,
    /// Routing number of the bank account.
    routing-number: option<string>,
    /// Contains information about the future reusability of this PaymentMethod.
    status-details: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record payment-method-wechat-pay-entry {
    key: string,
    value: string
  }

  /// If this is an `acss_debit` PaymentMethod, this hash contains details about the ACSS Debit payment method.
  record post-payment-methods-body-acss-debit {
    account-number: string,
    institution-number: string,
    transit-number: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-affirm-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-afterpay-clearpay-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-alipay-entry {
    key: string,
    value: string
  }

  /// If this is an `au_becs_debit` PaymentMethod, this hash contains details about the bank account.
  record post-payment-methods-body-au-becs-debit {
    account-number: string,
    bsb-number: string
  }

  /// If this is a `bacs_debit` PaymentMethod, this hash contains details about the Bacs Direct Debit bank account.
  record post-payment-methods-body-bacs-debit {
    account-number: option<string>,
    sort-code: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-bancontact-entry {
    key: string,
    value: string
  }

  /// Billing information associated with the PaymentMethod that may be used or required by particular types of payment methods.
  record post-payment-methods-body-billing-details {
    address: option<string>,
    email: option<string>,
    name: option<string>,
    phone: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-blik-entry {
    key: string,
    value: string
  }

  /// If this is a `boleto` PaymentMethod, this hash contains details about the Boleto payment method.
  record post-payment-methods-body-boleto {
    tax-id: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-cashapp-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-customer-balance-entry {
    key: string,
    value: string
  }

  /// If this is an `eps` PaymentMethod, this hash contains details about the EPS payment method.
  record post-payment-methods-body-eps {
    bank: option<payment-method-eps-bank-enum>
  }

  /// If this is an `fpx` PaymentMethod, this hash contains details about the FPX payment method.
  record post-payment-methods-body-fpx {
    bank: payment-method-fpx-bank-enum
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-giropay-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-grabpay-entry {
    key: string,
    value: string
  }

  /// If this is an `ideal` PaymentMethod, this hash contains details about the iDEAL payment method.
  record post-payment-methods-body-ideal {
    bank: option<payment-method-ideal-bank-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-interac-present-entry {
    key: string,
    value: string
  }

  /// If this is a `klarna` PaymentMethod, this hash contains details about the Klarna payment method.
  record post-payment-methods-body-klarna {
    dob: option<post-payment-methods-body-klarna-dob>
  }

  record post-payment-methods-body-klarna-dob {
    day: s32,
    month: s32,
    year: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-konbini-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-link-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-oxxo-entry {
    key: string,
    value: string
  }

  /// If this is a `p24` PaymentMethod, this hash contains details about the P24 payment method.
  record post-payment-methods-body-p24 {
    bank: option<payment-method-p24-bank-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-paynow-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-pix-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-promptpay-entry {
    key: string,
    value: string
  }

  /// Options to configure Radar. See [Radar Session](https://stripe.com/docs/radar/radar-session) for more information.
  record post-payment-methods-body-radar-options {
    session: option<string>
  }

  /// If this is a `sepa_debit` PaymentMethod, this hash contains details about the SEPA debit bank account.
  record post-payment-methods-body-sepa-debit {
    iban: string
  }

  /// If this is a `sofort` PaymentMethod, this hash contains details about the SOFORT payment method.
  record post-payment-methods-body-sofort {
    country: post-payment-methods-body-sofort-country-enum
  }

  /// If this is an `us_bank_account` PaymentMethod, this hash contains details about the US bank account payment method.
  record post-payment-methods-body-us-bank-account {
    account-holder-type: option<payment-method-us-bank-account-account-holder-type-enum>,
    account-number: option<string>,
    account-type: option<payment-method-us-bank-account-account-type-enum>,
    financial-connections-account: option<string>,
    routing-number: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-body-wechat-pay-entry {
    key: string,
    value: string
  }

  /// Billing information associated with the PaymentMethod that may be used or required by particular types of payment methods.
  record post-payment-methods-payment-method-body-billing-details {
    address: option<string>,
    email: option<string>,
    name: option<string>,
    phone: option<string>
  }

  /// If this is a `card` PaymentMethod, this hash contains the user's card details.
  record post-payment-methods-payment-method-body-card {
    exp-month: option<s32>,
    exp-year: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payment-methods-payment-method-body-link-entry {
    key: string,
    value: string
  }

  /// If this is an `us_bank_account` PaymentMethod, this hash contains details about the US bank account payment method.
  record post-payment-methods-payment-method-body-us-bank-account {
    account-holder-type: option<payment-method-us-bank-account-account-holder-type-enum>
  }

  record get-payment-methods-params {
    /// The ID of the customer whose PaymentMethods will be retrieved.
    customer: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// An optional filter on the list, based on the object `type` field. Without the filter, the list includes all current and future payment method types. If your integration expects only one type of payment method in the response, make sure to provide a type value in the request.
    type-op: option<get-payment-methods-type-op-enum>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-payment-methods: func(params: get-payment-methods-params) -> result<get-payment-methods-response, string>;

  record post-payment-methods-params {
    /// If this is an `acss_debit` PaymentMethod, this hash contains details about the ACSS Debit payment method.
    acss-debit: option<post-payment-methods-body-acss-debit>,
    /// If this is an `affirm` PaymentMethod, this hash contains details about the Affirm payment method.
    affirm: option<list<post-payment-methods-body-affirm-entry>>,
    /// If this is an `AfterpayClearpay` PaymentMethod, this hash contains details about the AfterpayClearpay payment method.
    afterpay-clearpay: option<list<post-payment-methods-body-afterpay-clearpay-entry>>,
    /// If this is an `Alipay` PaymentMethod, this hash contains details about the Alipay payment method.
    alipay: option<list<post-payment-methods-body-alipay-entry>>,
    /// If this is an `au_becs_debit` PaymentMethod, this hash contains details about the bank account.
    au-becs-debit: option<post-payment-methods-body-au-becs-debit>,
    /// If this is a `bacs_debit` PaymentMethod, this hash contains details about the Bacs Direct Debit bank account.
    bacs-debit: option<post-payment-methods-body-bacs-debit>,
    /// If this is a `bancontact` PaymentMethod, this hash contains details about the Bancontact payment method.
    bancontact: option<list<post-payment-methods-body-bancontact-entry>>,
    /// Billing information associated with the PaymentMethod that may be used or required by particular types of payment methods.
    billing-details: option<post-payment-methods-body-billing-details>,
    /// If this is a `blik` PaymentMethod, this hash contains details about the BLIK payment method.
    blik: option<list<post-payment-methods-body-blik-entry>>,
    /// If this is a `boleto` PaymentMethod, this hash contains details about the Boleto payment method.
    boleto: option<post-payment-methods-body-boleto>,
    /// If this is a `card` PaymentMethod, this hash contains the user's card details. For backwards compatibility, you can alternatively provide a Stripe token (e.g., for Apple Pay, Amex Express Checkout, or legacy Checkout) into the card hash with format `card: {token: "tok_visa"}`. When providing a card number, you must meet the requirements for [PCI compliance](https://stripe.com/docs/security#validating-pci-compliance). We strongly recommend using Stripe.js instead of interacting with this API directly.
    card: option<string>,
    /// If this is a `cashapp` PaymentMethod, this hash contains details about the Cash App Pay payment method.
    cashapp: option<list<post-payment-methods-body-cashapp-entry>>,
    /// The `Customer` to whom the original PaymentMethod is attached.
    customer: option<string>,
    /// If this is a `customer_balance` PaymentMethod, this hash contains details about the CustomerBalance payment method.
    customer-balance: option<list<post-payment-methods-body-customer-balance-entry>>,
    /// If this is an `eps` PaymentMethod, this hash contains details about the EPS payment method.
    eps: option<post-payment-methods-body-eps>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// If this is an `fpx` PaymentMethod, this hash contains details about the FPX payment method.
    fpx: option<post-payment-methods-body-fpx>,
    /// If this is a `giropay` PaymentMethod, this hash contains details about the Giropay payment method.
    giropay: option<list<post-payment-methods-body-giropay-entry>>,
    /// If this is a `grabpay` PaymentMethod, this hash contains details about the GrabPay payment method.
    grabpay: option<list<post-payment-methods-body-grabpay-entry>>,
    /// If this is an `ideal` PaymentMethod, this hash contains details about the iDEAL payment method.
    ideal: option<post-payment-methods-body-ideal>,
    /// If this is an `interac_present` PaymentMethod, this hash contains details about the Interac Present payment method.
    interac-present: option<list<post-payment-methods-body-interac-present-entry>>,
    /// If this is a `klarna` PaymentMethod, this hash contains details about the Klarna payment method.
    klarna: option<post-payment-methods-body-klarna>,
    /// If this is a `konbini` PaymentMethod, this hash contains details about the Konbini payment method.
    konbini: option<list<post-payment-methods-body-konbini-entry>>,
    /// If this is an `Link` PaymentMethod, this hash contains details about the Link payment method.
    link: option<list<post-payment-methods-body-link-entry>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-payment-methods-body-metadata-entry>>,
    /// If this is an `oxxo` PaymentMethod, this hash contains details about the OXXO payment method.
    oxxo: option<list<post-payment-methods-body-oxxo-entry>>,
    /// If this is a `p24` PaymentMethod, this hash contains details about the P24 payment method.
    p24: option<post-payment-methods-body-p24>,
    /// The PaymentMethod to share.
    payment-method: option<string>,
    /// If this is a `paynow` PaymentMethod, this hash contains details about the PayNow payment method.
    paynow: option<list<post-payment-methods-body-paynow-entry>>,
    /// If this is a `pix` PaymentMethod, this hash contains details about the Pix payment method.
    pix: option<list<post-payment-methods-body-pix-entry>>,
    /// If this is a `promptpay` PaymentMethod, this hash contains details about the PromptPay payment method.
    promptpay: option<list<post-payment-methods-body-promptpay-entry>>,
    /// Options to configure Radar. See [Radar Session](https://stripe.com/docs/radar/radar-session) for more information.
    radar-options: option<post-payment-methods-body-radar-options>,
    /// If this is a `sepa_debit` PaymentMethod, this hash contains details about the SEPA debit bank account.
    sepa-debit: option<post-payment-methods-body-sepa-debit>,
    /// If this is a `sofort` PaymentMethod, this hash contains details about the SOFORT payment method.
    sofort: option<post-payment-methods-body-sofort>,
    /// The type of the PaymentMethod. An additional hash is included on the PaymentMethod with a name matching this value. It contains additional information specific to the PaymentMethod type.
    type-op: option<get-payment-methods-type-op-enum>,
    /// If this is an `us_bank_account` PaymentMethod, this hash contains details about the US bank account payment method.
    us-bank-account: option<post-payment-methods-body-us-bank-account>,
    /// If this is an `wechat_pay` PaymentMethod, this hash contains details about the wechat_pay payment method.
    wechat-pay: option<list<post-payment-methods-body-wechat-pay-entry>>
  }
  post-payment-methods: func(params: post-payment-methods-params) -> result<payment-method, string>;

  record get-payment-methods-payment-method-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    payment-method: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-payment-methods-payment-method: func(params: get-payment-methods-payment-method-params) -> result<payment-method, string>;

  record post-payment-methods-payment-method-params {
    payment-method: string,
    /// Billing information associated with the PaymentMethod that may be used or required by particular types of payment methods.
    billing-details: option<post-payment-methods-payment-method-body-billing-details>,
    /// If this is a `card` PaymentMethod, this hash contains the user's card details.
    card: option<post-payment-methods-payment-method-body-card>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// If this is an `Link` PaymentMethod, this hash contains details about the Link payment method.
    link: option<list<post-payment-methods-payment-method-body-link-entry>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// If this is an `us_bank_account` PaymentMethod, this hash contains details about the US bank account payment method.
    us-bank-account: option<post-payment-methods-payment-method-body-us-bank-account>
  }
  post-payment-methods-payment-method: func(params: post-payment-methods-payment-method-params) -> result<payment-method, string>;

  record post-payment-methods-payment-method-attach-params {
    payment-method: string,
    /// The ID of the customer to which to attach the PaymentMethod.
    customer: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-payment-methods-payment-method-attach: func(params: post-payment-methods-payment-method-attach-params) -> result<payment-method, string>;

  record post-payment-methods-payment-method-detach-params {
    payment-method: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-payment-methods-payment-method-detach: func(params: post-payment-methods-payment-method-detach-params) -> result<payment-method, string>;

}

interface payouts {
  enum payout-object-enum {
    payout,
  }

  enum payout-reconciliation-status-enum {
    completed,
    in-progress,
    not-applicable,
  }

  enum payout-type-op-enum {
    bank-account,
    card,
  }

  enum get-payouts-response-object-enum {
    list-op,
  }

  enum post-payouts-body-method-enum {
    instant,
    standard,
  }

  enum post-payouts-body-source-type-enum {
    bank-account,
    card,
    fpx,
  }

  record get-payouts-response {
    data: list<payout>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-payouts-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A `Payout` object is created when you receive funds from Stripe, or when you
  /// initiate a payout to either a bank account or debit card of a [connected
  /// Stripe account](/docs/connect/bank-debit-card-payouts). You can retrieve individual payouts,
  /// as well as list all payouts. Payouts are made on [varying
  /// schedules](/docs/connect/manage-payout-schedule), depending on your country and
  /// industry.
  /// 
  /// Related guide: [Receiving Payouts](https://stripe.com/docs/payouts).
  record payout {
    /// Amount (in %s) to be transferred to your bank account or debit card.
    amount: s32,
    /// Date the payout is expected to arrive in the bank. This factors in delays like weekends or bank holidays.
    arrival-date: s32,
    /// Returns `true` if the payout was created by an [automated payout schedule](https://stripe.com/docs/payouts#payout-schedule), and `false` if it was [requested manually](https://stripe.com/docs/payouts#manual-payouts).
    automatic: bool,
    /// ID of the balance transaction that describes the impact of this payout on your account balance.
    balance-transaction: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// An arbitrary string attached to the object. Often useful for displaying to users.
    description: option<string>,
    /// ID of the bank account or card the payout was sent to.
    destination: option<string>,
    /// If the payout failed or was canceled, this will be the ID of the balance transaction that reversed the initial balance transaction, and puts the funds from the failed payout back in your balance.
    failure-balance-transaction: option<string>,
    /// Error code explaining reason for payout failure if available. See [Types of payout failures](https://stripe.com/docs/api#payout_failures) for a list of failure codes.
    failure-code: option<string>,
    /// Message to user further explaining reason for payout failure if available.
    failure-message: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<payout-metadata-entry>>,
    /// The method used to send this payout, which can be `standard` or `instant`. `instant` is only supported for payouts to debit cards. (See [Instant payouts for marketplaces](https://stripe.com/blog/instant-payouts-for-marketplaces) for more information.)
    method: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: payout-object-enum,
    /// If the payout reverses another, this is the ID of the original payout.
    original-payout: option<string>,
    /// If `completed`, the [Balance Transactions API](https://stripe.com/docs/api/balance_transactions/list#balance_transaction_list-payout) may be used to list all Balance Transactions that were paid out in this payout.
    reconciliation-status: payout-reconciliation-status-enum,
    /// If the payout was reversed, this is the ID of the payout that reverses this payout.
    reversed-by: option<string>,
    /// The source balance this payout came from. One of `card`, `fpx`, or `bank_account`.
    source-type: string,
    /// Extra information about a payout to be displayed on the user's bank statement.
    statement-descriptor: option<string>,
    /// Current status of the payout: `paid`, `pending`, `in_transit`, `canceled` or `failed`. A payout is `pending` until it is submitted to the bank, when it becomes `in_transit`. The status then changes to `paid` if the transaction goes through, or to `failed` or `canceled` (within 5 business days). Some failed payouts may initially show as `paid` but then change to `failed`.
    status: string,
    /// Can be `bank_account` or `card`.
    type-op: payout-type-op-enum
  }

  /// one entry of a string-keyed map (free-form object)
  record payout-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payouts-body-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-payouts-payout-reverse-body-metadata-entry {
    key: string,
    value: string
  }

  record get-payouts-params {
    arrival-date: option<string>,
    created: option<string>,
    /// The ID of an external account - only return payouts sent to this external account.
    destination: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// Only return payouts that have the given status: `pending`, `paid`, `failed`, or `canceled`.
    status: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-payouts: func(params: get-payouts-params) -> result<get-payouts-response, string>;

  record post-payouts-params {
    /// A positive integer in cents representing how much to payout.
    amount: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// An arbitrary string attached to the object. Often useful for displaying to users.
    description: option<string>,
    /// The ID of a bank account or a card to send the payout to. If no destination is supplied, the default external account for the specified currency will be used.
    destination: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-payouts-body-metadata-entry>>,
    /// The method used to send this payout, which can be `standard` or `instant`. `instant` is only supported for payouts to debit cards. (See [Instant payouts for marketplaces for more information](https://stripe.com/blog/instant-payouts-for-marketplaces).)
    method: option<post-payouts-body-method-enum>,
    /// The balance type of your Stripe balance to draw this payout from. Balances for different payment sources are kept separately. You can find the amounts with the balances API. One of `bank_account`, `card`, or `fpx`.
    source-type: option<post-payouts-body-source-type-enum>,
    /// A string to be displayed on the recipient's bank or card statement. This may be at most 22 characters. Attempting to use a `statement_descriptor` longer than 22 characters will return an error. Note: Most banks will truncate this information and/or display it inconsistently. Some may not display it at all.
    statement-descriptor: option<string>
  }
  post-payouts: func(params: post-payouts-params) -> result<payout, string>;

  record get-payouts-payout-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    payout: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-payouts-payout: func(params: get-payouts-payout-params) -> result<payout, string>;

  record post-payouts-payout-params {
    payout: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>
  }
  post-payouts-payout: func(params: post-payouts-payout-params) -> result<payout, string>;

  record post-payouts-payout-cancel-params {
    payout: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-payouts-payout-cancel: func(params: post-payouts-payout-cancel-params) -> result<payout, string>;

  record post-payouts-payout-reverse-params {
    payout: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-payouts-payout-reverse-body-metadata-entry>>
  }
  post-payouts-payout-reverse: func(params: post-payouts-payout-reverse-params) -> result<payout, string>;

}

interface plans {
  enum plan-aggregate-usage-enum {
    last-during-period,
    last-ever,
    max,
    sum,
  }

  enum plan-billing-scheme-enum {
    per-unit,
    tiered,
  }

  enum plan-interval-enum {
    day,
    month,
    week,
    year,
  }

  enum plan-object-enum {
    plan,
  }

  enum plan-tiers-mode-enum {
    graduated,
    volume,
  }

  enum plan-usage-type-enum {
    licensed,
    metered,
  }

  enum get-plans-response-object-enum {
    list-op,
  }

  enum post-plans-body-transform-usage-round-enum {
    down,
    up,
  }

  record get-plans-response {
    /// Details about each object.
    data: list<plan>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-plans-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// You can now model subscriptions more flexibly using the [Prices API](https://stripe.com/docs/api#prices). It replaces the Plans API and is backwards compatible to simplify your migration.
  /// 
  /// Plans define the base price, currency, and billing cycle for recurring purchases of products.
  /// [Products](https://stripe.com/docs/api#products) help you track inventory or provisioning, and plans help you track pricing. Different physical goods or levels of service should be represented by products, and pricing options should be represented by plans. This approach lets you change prices without having to change your provisioning scheme.
  /// 
  /// For example, you might have a single "gold" product that has plans for $10/month, $100/year, €9/month, and €90/year.
  /// 
  /// Related guides: [Set up a subscription](https://stripe.com/docs/billing/subscriptions/set-up-subscription) and more about [products and prices](https://stripe.com/docs/products-prices/overview).
  record plan {
    /// Whether the plan can be used for new purchases.
    active: bool,
    /// Specifies a usage aggregation strategy for plans of `usage_type=metered`. Allowed values are `sum` for summing up all usage during a period, `last_during_period` for using the last usage record reported within a period, `last_ever` for using the last usage record ever (across period bounds) or `max` which uses the usage record with the maximum reported usage during a period. Defaults to `sum`.
    aggregate-usage: option<plan-aggregate-usage-enum>,
    /// The unit amount in %s to be charged, represented as a whole integer if possible. Only set if `billing_scheme=per_unit`.
    amount: option<s32>,
    /// The unit amount in %s to be charged, represented as a decimal string with at most 12 decimal places. Only set if `billing_scheme=per_unit`.
    amount-decimal: option<string>,
    /// Describes how to compute the price per period. Either `per_unit` or `tiered`. `per_unit` indicates that the fixed amount (specified in `amount`) will be charged per unit in `quantity` (for plans with `usage_type=licensed`), or per unit of total usage (for plans with `usage_type=metered`). `tiered` indicates that the unit pricing will be computed using a tiering strategy as defined using the `tiers` and `tiers_mode` attributes.
    billing-scheme: plan-billing-scheme-enum,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// Unique identifier for the object.
    id: string,
    /// The frequency at which a subscription is billed. One of `day`, `week`, `month` or `year`.
    interval: plan-interval-enum,
    /// The number of intervals (specified in the `interval` attribute) between subscription billings. For example, `interval=month` and `interval_count=3` bills every 3 months.
    interval-count: s32,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<plan-metadata-entry>>,
    /// A brief description of the plan, hidden from customers.
    nickname: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: plan-object-enum,
    /// The product whose pricing this plan determines.
    product: option<string>,
    /// Each element represents a pricing tier. This parameter requires `billing_scheme` to be set to `tiered`. See also the documentation for `billing_scheme`.
    tiers: option<list<plan-tier>>,
    /// Defines if the tiering price should be `graduated` or `volume` based. In `volume`-based tiering, the maximum quantity within a period determines the per unit price. In `graduated` tiering, pricing can change as the quantity grows.
    tiers-mode: option<plan-tiers-mode-enum>,
    /// Apply a transformation to the reported usage or set quantity before computing the amount billed. Cannot be combined with `tiers`.
    transform-usage: option<string>,
    /// Default number of trial days when subscribing a customer to this plan using [`trial_from_plan=true`](https://stripe.com/docs/api#create_subscription-trial_from_plan).
    trial-period-days: option<s32>,
    /// Configures how the quantity per period should be determined. Can be either `metered` or `licensed`. `licensed` automatically bills the `quantity` set when adding it to a subscription. `metered` aggregates the total usage based on usage records. Defaults to `licensed`.
    usage-type: plan-usage-type-enum
  }

  /// one entry of a string-keyed map (free-form object)
  record plan-metadata-entry {
    key: string,
    value: string
  }

  record plan-tier {
    /// Price for the entire tier.
    flat-amount: option<s32>,
    /// Same as `flat_amount`, but contains a decimal value with at most 12 decimal places.
    flat-amount-decimal: option<string>,
    /// Per unit price for units relevant to the tier.
    unit-amount: option<s32>,
    /// Same as `unit_amount`, but contains a decimal value with at most 12 decimal places.
    unit-amount-decimal: option<string>,
    /// Up to and including to this quantity will be contained in the tier.
    up-to: option<s32>
  }

  record post-plans-body-tiers-item {
    flat-amount: option<s32>,
    flat-amount-decimal: option<string>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>,
    up-to: string
  }

  /// Apply a transformation to the reported usage or set quantity before computing the billed price. Cannot be combined with `tiers`.
  record post-plans-body-transform-usage {
    divide-by: s32,
    round: post-plans-body-transform-usage-round-enum
  }

  record deleted-plan {
    /// Always true for a deleted object
    deleted: bool,
    /// Unique identifier for the object.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: plan-object-enum
  }

  record get-plans-params {
    /// Only return plans that are active or inactive (e.g., pass `false` to list all inactive plans).
    active: option<bool>,
    /// A filter on the list, based on the object `created` field. The value can be a string with an integer Unix timestamp, or it can be a dictionary with a number of different query options.
    created: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// Only return plans for the given product.
    product: option<string>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-plans: func(params: get-plans-params) -> result<get-plans-response, string>;

  record post-plans-params {
    /// Whether the plan is currently available for new subscriptions. Defaults to `true`.
    active: option<bool>,
    /// Specifies a usage aggregation strategy for plans of `usage_type=metered`. Allowed values are `sum` for summing up all usage during a period, `last_during_period` for using the last usage record reported within a period, `last_ever` for using the last usage record ever (across period bounds) or `max` which uses the usage record with the maximum reported usage during a period. Defaults to `sum`.
    aggregate-usage: option<plan-aggregate-usage-enum>,
    /// A positive integer in cents (or local equivalent) (or 0 for a free plan) representing how much to charge on a recurring basis.
    amount: option<s32>,
    /// Same as `amount`, but accepts a decimal value with at most 12 decimal places. Only one of `amount` and `amount_decimal` can be set.
    amount-decimal: option<string>,
    /// Describes how to compute the price per period. Either `per_unit` or `tiered`. `per_unit` indicates that the fixed amount (specified in `amount`) will be charged per unit in `quantity` (for plans with `usage_type=licensed`), or per unit of total usage (for plans with `usage_type=metered`). `tiered` indicates that the unit pricing will be computed using a tiering strategy as defined using the `tiers` and `tiers_mode` attributes.
    billing-scheme: option<plan-billing-scheme-enum>,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// An identifier randomly generated by Stripe. Used to identify this plan when subscribing a customer. You can optionally override this ID, but the ID must be unique across all plans in your Stripe account. You can, however, use the same plan ID in both live and test modes.
    id: option<string>,
    /// Specifies billing frequency. Either `day`, `week`, `month` or `year`.
    interval: plan-interval-enum,
    /// The number of intervals between subscription billings. For example, `interval=month` and `interval_count=3` bills every 3 months. Maximum of one year interval allowed (1 year, 12 months, or 52 weeks).
    interval-count: option<s32>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// A brief description of the plan, hidden from customers.
    nickname: option<string>,
    product: option<string>,
    /// Each element represents a pricing tier. This parameter requires `billing_scheme` to be set to `tiered`. See also the documentation for `billing_scheme`.
    tiers: option<list<post-plans-body-tiers-item>>,
    /// Defines if the tiering price should be `graduated` or `volume` based. In `volume`-based tiering, the maximum quantity within a period determines the per unit price, in `graduated` tiering pricing can successively change as the quantity grows.
    tiers-mode: option<plan-tiers-mode-enum>,
    /// Apply a transformation to the reported usage or set quantity before computing the billed price. Cannot be combined with `tiers`.
    transform-usage: option<post-plans-body-transform-usage>,
    /// Default number of trial days when subscribing a customer to this plan using [`trial_from_plan=true`](https://stripe.com/docs/api#create_subscription-trial_from_plan).
    trial-period-days: option<s32>,
    /// Configures how the quantity per period should be determined. Can be either `metered` or `licensed`. `licensed` automatically bills the `quantity` set when adding it to a subscription. `metered` aggregates the total usage based on usage records. Defaults to `licensed`.
    usage-type: option<plan-usage-type-enum>
  }
  post-plans: func(params: post-plans-params) -> result<plan, string>;

  record get-plans-plan-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    plan: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-plans-plan: func(params: get-plans-plan-params) -> result<plan, string>;

  record post-plans-plan-params {
    plan: string,
    /// Whether the plan is currently available for new subscriptions.
    active: option<bool>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// A brief description of the plan, hidden from customers.
    nickname: option<string>,
    /// The product the plan belongs to. This cannot be changed once it has been used in a subscription or subscription schedule.
    product: option<string>,
    /// Default number of trial days when subscribing a customer to this plan using [`trial_from_plan=true`](https://stripe.com/docs/api#create_subscription-trial_from_plan).
    trial-period-days: option<s32>
  }
  post-plans-plan: func(params: post-plans-plan-params) -> result<plan, string>;

  record delete-plans-plan-params {
    plan: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  delete-plans-plan: func(params: delete-plans-plan-params) -> result<deleted-plan, string>;

}

interface prices {
  enum get-prices-type-op-enum {
    one-time,
    recurring,
  }

  enum price-billing-scheme-enum {
    per-unit,
    tiered,
  }

  enum currency-option-tax-behavior-enum {
    exclusive,
    inclusive,
    unspecified,
  }

  enum price-object-enum {
    price,
  }

  enum price-tiers-mode-enum {
    graduated,
    volume,
  }

  enum get-prices-response-object-enum {
    list-op,
  }

  enum post-prices-body-recurring-aggregate-usage-enum {
    last-during-period,
    last-ever,
    max,
    sum,
  }

  enum post-prices-body-recurring-interval-enum {
    day,
    month,
    week,
    year,
  }

  enum post-prices-body-recurring-usage-type-enum {
    licensed,
    metered,
  }

  enum post-prices-body-transform-quantity-round-enum {
    down,
    up,
  }

  enum get-prices-search-response-object-enum {
    search-result,
  }

  record get-prices-response {
    /// Details about each object.
    data: list<price>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-prices-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Prices define the unit cost, currency, and (optional) billing cycle for both recurring and one-time purchases of products.
  /// [Products](https://stripe.com/docs/api#products) help you track inventory or provisioning, and prices help you track payment terms. Different physical goods or levels of service should be represented by products, and pricing options should be represented by prices. This approach lets you change prices without having to change your provisioning scheme.
  /// 
  /// For example, you might have a single "gold" product that has prices for $10/month, $100/year, and €9 once.
  /// 
  /// Related guides: [Set up a subscription](https://stripe.com/docs/billing/subscriptions/set-up-subscription), [create an invoice](https://stripe.com/docs/billing/invoices/create), and more about [products and prices](https://stripe.com/docs/products-prices/overview).
  record price {
    /// Whether the price can be used for new purchases.
    active: bool,
    /// Describes how to compute the price per period. Either `per_unit` or `tiered`. `per_unit` indicates that the fixed amount (specified in `unit_amount` or `unit_amount_decimal`) will be charged per unit in `quantity` (for prices with `usage_type=licensed`), or per unit of total usage (for prices with `usage_type=metered`). `tiered` indicates that the unit pricing will be computed using a tiering strategy as defined using the `tiers` and `tiers_mode` attributes.
    billing-scheme: price-billing-scheme-enum,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// Prices defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<price-currency-options-entry>>,
    /// When set, provides configuration for the amount to be adjusted by the customer during Checkout Sessions and Payment Links.
    custom-unit-amount: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// A lookup key used to retrieve prices dynamically from a static string. This may be up to 200 characters.
    lookup-key: option<string>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<price-metadata-entry>,
    /// A brief description of the price, hidden from customers.
    nickname: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: price-object-enum,
    /// The ID of the product this price is associated with.
    product: string,
    /// The recurring components of a price such as `interval` and `usage_type`.
    recurring: option<string>,
    /// Only required if a [default tax behavior](https://stripe.com/docs/tax/products-prices-tax-categories-tax-behavior#setting-a-default-tax-behavior-(recommended)) was not provided in the Stripe Tax settings. Specifies whether the price is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`. Once specified as either `inclusive` or `exclusive`, it cannot be changed.
    tax-behavior: option<currency-option-tax-behavior-enum>,
    /// Each element represents a pricing tier. This parameter requires `billing_scheme` to be set to `tiered`. See also the documentation for `billing_scheme`.
    tiers: option<list<price-tier>>,
    /// Defines if the tiering price should be `graduated` or `volume` based. In `volume`-based tiering, the maximum quantity within a period determines the per unit price. In `graduated` tiering, pricing can change as the quantity grows.
    tiers-mode: option<price-tiers-mode-enum>,
    /// Apply a transformation to the reported usage or set quantity before computing the amount billed. Cannot be combined with `tiers`.
    transform-quantity: option<string>,
    /// One of `one_time` or `recurring` depending on whether the price is for a one-time purchase or a recurring (subscription) purchase.
    type-op: get-prices-type-op-enum,
    /// The unit amount in %s to be charged, represented as a whole integer if possible. Only set if `billing_scheme=per_unit`.
    unit-amount: option<s32>,
    /// The unit amount in %s to be charged, represented as a decimal string with at most 12 decimal places. Only set if `billing_scheme=per_unit`.
    unit-amount-decimal: option<string>
  }

  record currency-option {
    /// When set, provides configuration for the amount to be adjusted by the customer during Checkout Sessions and Payment Links.
    custom-unit-amount: option<string>,
    /// Only required if a [default tax behavior](https://stripe.com/docs/tax/products-prices-tax-categories-tax-behavior#setting-a-default-tax-behavior-(recommended)) was not provided in the Stripe Tax settings. Specifies whether the price is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`. Once specified as either `inclusive` or `exclusive`, it cannot be changed.
    tax-behavior: option<currency-option-tax-behavior-enum>,
    /// Each element represents a pricing tier. This parameter requires `billing_scheme` to be set to `tiered`. See also the documentation for `billing_scheme`.
    tiers: option<list<price-tier>>,
    /// The unit amount in %s to be charged, represented as a whole integer if possible. Only set if `billing_scheme=per_unit`.
    unit-amount: option<s32>,
    /// The unit amount in %s to be charged, represented as a decimal string with at most 12 decimal places. Only set if `billing_scheme=per_unit`.
    unit-amount-decimal: option<string>
  }

  record price-tier {
    /// Price for the entire tier.
    flat-amount: option<s32>,
    /// Same as `flat_amount`, but contains a decimal value with at most 12 decimal places.
    flat-amount-decimal: option<string>,
    /// Per unit price for units relevant to the tier.
    unit-amount: option<s32>,
    /// Same as `unit_amount`, but contains a decimal value with at most 12 decimal places.
    unit-amount-decimal: option<string>,
    /// Up to and including to this quantity will be contained in the tier.
    up-to: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record price-currency-options-entry {
    key: string,
    value: currency-option
  }

  /// one entry of a string-keyed map (free-form object)
  record price-metadata-entry {
    key: string,
    value: string
  }

  record post-prices-body-currency-options-value {
    custom-unit-amount: option<post-prices-body-currency-options-value-custom-unit-amount>,
    tax-behavior: option<currency-option-tax-behavior-enum>,
    tiers: option<list<post-prices-body-currency-options-value-tiers-item>>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>
  }

  record post-prices-body-currency-options-value-custom-unit-amount {
    enabled: bool,
    maximum: option<s32>,
    minimum: option<s32>,
    preset: option<s32>
  }

  record post-prices-body-currency-options-value-tiers-item {
    flat-amount: option<s32>,
    flat-amount-decimal: option<string>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>,
    up-to: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-prices-body-currency-options-entry {
    key: string,
    value: post-prices-body-currency-options-value
  }

  /// When set, provides configuration for the amount to be adjusted by the customer during Checkout Sessions and Payment Links.
  record post-prices-body-custom-unit-amount {
    enabled: bool,
    maximum: option<s32>,
    minimum: option<s32>,
    preset: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-prices-body-metadata-entry {
    key: string,
    value: string
  }

  /// These fields can be used to create a new product that this price will belong to.
  record post-prices-body-product-data {
    active: option<bool>,
    id: option<string>,
    metadata: option<list<post-prices-body-product-data-metadata-entry>>,
    name: string,
    statement-descriptor: option<string>,
    tax-code: option<string>,
    unit-label: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-prices-body-product-data-metadata-entry {
    key: string,
    value: string
  }

  /// The recurring components of a price such as `interval` and `usage_type`.
  record post-prices-body-recurring {
    aggregate-usage: option<post-prices-body-recurring-aggregate-usage-enum>,
    interval: post-prices-body-recurring-interval-enum,
    interval-count: option<s32>,
    usage-type: option<post-prices-body-recurring-usage-type-enum>
  }

  record post-prices-body-tiers-item {
    flat-amount: option<s32>,
    flat-amount-decimal: option<string>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>,
    up-to: string
  }

  /// Apply a transformation to the reported usage or set quantity before computing the billed price. Cannot be combined with `tiers`.
  record post-prices-body-transform-quantity {
    divide-by: s32,
    round: post-prices-body-transform-quantity-round-enum
  }

  record get-prices-search-response {
    data: list<price>,
    has-more: bool,
    next-page: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: get-prices-search-response-object-enum,
    /// The total number of objects that match the query, only accurate up to 10,000.
    total-count: option<s32>,
    url: string
  }

  record get-prices-params {
    /// Only return prices that are active or inactive (e.g., pass `false` to list all inactive prices).
    active: option<bool>,
    /// A filter on the list, based on the object `created` field. The value can be a string with an integer Unix timestamp, or it can be a dictionary with a number of different query options.
    created: option<string>,
    /// Only return prices for the given currency.
    currency: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// Only return the price with these lookup_keys, if any exist.
    lookup-keys: option<list<string>>,
    /// Only return prices for the given product.
    product: option<string>,
    /// Only return prices with these recurring fields.
    recurring: option<string>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// Only return prices of type `recurring` or `one_time`.
    type-op: option<get-prices-type-op-enum>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-prices: func(params: get-prices-params) -> result<get-prices-response, string>;

  record post-prices-params {
    /// Whether the price can be used for new purchases. Defaults to `true`.
    active: option<bool>,
    /// Describes how to compute the price per period. Either `per_unit` or `tiered`. `per_unit` indicates that the fixed amount (specified in `unit_amount` or `unit_amount_decimal`) will be charged per unit in `quantity` (for prices with `usage_type=licensed`), or per unit of total usage (for prices with `usage_type=metered`). `tiered` indicates that the unit pricing will be computed using a tiering strategy as defined using the `tiers` and `tiers_mode` attributes.
    billing-scheme: option<price-billing-scheme-enum>,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// Prices defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<post-prices-body-currency-options-entry>>,
    /// When set, provides configuration for the amount to be adjusted by the customer during Checkout Sessions and Payment Links.
    custom-unit-amount: option<post-prices-body-custom-unit-amount>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A lookup key used to retrieve prices dynamically from a static string. This may be up to 200 characters.
    lookup-key: option<string>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-prices-body-metadata-entry>>,
    /// A brief description of the price, hidden from customers.
    nickname: option<string>,
    /// The ID of the product that this price will belong to.
    product: option<string>,
    /// These fields can be used to create a new product that this price will belong to.
    product-data: option<post-prices-body-product-data>,
    /// The recurring components of a price such as `interval` and `usage_type`.
    recurring: option<post-prices-body-recurring>,
    /// Only required if a [default tax behavior](https://stripe.com/docs/tax/products-prices-tax-categories-tax-behavior#setting-a-default-tax-behavior-(recommended)) was not provided in the Stripe Tax settings. Specifies whether the price is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`. Once specified as either `inclusive` or `exclusive`, it cannot be changed.
    tax-behavior: option<currency-option-tax-behavior-enum>,
    /// Each element represents a pricing tier. This parameter requires `billing_scheme` to be set to `tiered`. See also the documentation for `billing_scheme`.
    tiers: option<list<post-prices-body-tiers-item>>,
    /// Defines if the tiering price should be `graduated` or `volume` based. In `volume`-based tiering, the maximum quantity within a period determines the per unit price, in `graduated` tiering pricing can successively change as the quantity grows.
    tiers-mode: option<price-tiers-mode-enum>,
    /// If set to true, will atomically remove the lookup key from the existing price, and assign it to this price.
    transfer-lookup-key: option<bool>,
    /// Apply a transformation to the reported usage or set quantity before computing the billed price. Cannot be combined with `tiers`.
    transform-quantity: option<post-prices-body-transform-quantity>,
    /// A positive integer in cents (or local equivalent) (or 0 for a free price) representing how much to charge. One of `unit_amount` or `custom_unit_amount` is required, unless `billing_scheme=tiered`.
    unit-amount: option<s32>,
    /// Same as `unit_amount`, but accepts a decimal value in cents (or local equivalent) with at most 12 decimal places. Only one of `unit_amount` and `unit_amount_decimal` can be set.
    unit-amount-decimal: option<string>
  }
  post-prices: func(params: post-prices-params) -> result<price, string>;

  record get-prices-search-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for pagination across multiple pages of results. Don't include this parameter on the first call. Use the next_page value returned in a previous response to request subsequent results.
    page: option<string>,
    /// The search query string. See [search query language](https://stripe.com/docs/search#search-query-language) and the list of supported [query fields for prices](https://stripe.com/docs/search#query-fields-for-prices).
    query: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-prices-search: func(params: get-prices-search-params) -> result<get-prices-search-response, string>;

  record get-prices-price-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    price: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-prices-price: func(params: get-prices-price-params) -> result<price, string>;

  record post-prices-price-params {
    price: string,
    /// Whether the price can be used for new purchases. Defaults to `true`.
    active: option<bool>,
    /// Prices defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A lookup key used to retrieve prices dynamically from a static string. This may be up to 200 characters.
    lookup-key: option<string>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// A brief description of the price, hidden from customers.
    nickname: option<string>,
    /// Only required if a [default tax behavior](https://stripe.com/docs/tax/products-prices-tax-categories-tax-behavior#setting-a-default-tax-behavior-(recommended)) was not provided in the Stripe Tax settings. Specifies whether the price is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`. Once specified as either `inclusive` or `exclusive`, it cannot be changed.
    tax-behavior: option<currency-option-tax-behavior-enum>,
    /// If set to true, will atomically remove the lookup key from the existing price, and assign it to this price.
    transfer-lookup-key: option<bool>
  }
  post-prices-price: func(params: post-prices-price-params) -> result<price, string>;

}

interface products {
  enum product-object-enum {
    product,
  }

  enum get-products-response-object-enum {
    list-op,
  }

  enum post-products-body-default-price-data-currency-options-value-tax-behavior-enum {
    exclusive,
    inclusive,
    unspecified,
  }

  enum post-products-body-default-price-data-recurring-interval-enum {
    day,
    month,
    week,
    year,
  }

  enum get-products-search-response-object-enum {
    search-result,
  }

  record get-products-response {
    /// Details about each object.
    data: list<product>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-products-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Products describe the specific goods or services you offer to your customers.
  /// For example, you might offer a Standard and Premium version of your goods or service; each version would be a separate Product.
  /// They can be used in conjunction with [Prices](https://stripe.com/docs/api#prices) to configure pricing in Payment Links, Checkout, and Subscriptions.
  /// 
  /// Related guides: [Set up a subscription](https://stripe.com/docs/billing/subscriptions/set-up-subscription),
  /// [share a Payment Link](https://stripe.com/docs/payment-links),
  /// [accept payments with Checkout](https://stripe.com/docs/payments/accept-a-payment#create-product-prices-upfront),
  /// and more about [Products and Prices](https://stripe.com/docs/products-prices/overview)
  record product {
    /// Whether the product is currently available for purchase.
    active: bool,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// The ID of the [Price](https://stripe.com/docs/api/prices) object that is the default price for this product.
    default-price: option<string>,
    /// The product's description, meant to be displayable to the customer. Use this field to optionally store a long form explanation of the product being sold for your own rendering purposes.
    description: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// A list of up to 8 URLs of images for this product, meant to be displayable to the customer.
    images: list<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<product-metadata-entry>,
    /// The product's name, meant to be displayable to the customer.
    name: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: product-object-enum,
    /// The dimensions of this product for shipping purposes.
    package-dimensions: option<string>,
    /// Whether this product is shipped (i.e., physical goods).
    shippable: option<bool>,
    /// Extra information about a product which will appear on your customer's credit card statement. In the case that multiple products are billed at once, the first statement descriptor will be used.
    statement-descriptor: option<string>,
    /// A [tax code](https://stripe.com/docs/tax/tax-categories) ID.
    tax-code: option<string>,
    /// A label that represents units of this product. When set, this will be included in customers' receipts, invoices, Checkout, and the customer portal.
    unit-label: option<string>,
    /// Time at which the object was last updated. Measured in seconds since the Unix epoch.
    updated: s32,
    /// A URL of a publicly-accessible webpage for this product.
    url: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record product-metadata-entry {
    key: string,
    value: string
  }

  /// Data used to generate a new [Price](https://stripe.com/docs/api/prices) object. This Price will be set as the default price for this product.
  record post-products-body-default-price-data {
    currency: string,
    currency-options: option<list<post-products-body-default-price-data-currency-options-entry>>,
    recurring: option<post-products-body-default-price-data-recurring>,
    tax-behavior: option<post-products-body-default-price-data-currency-options-value-tax-behavior-enum>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>
  }

  record post-products-body-default-price-data-currency-options-value {
    custom-unit-amount: option<post-products-body-default-price-data-currency-options-value-custom-unit-amount>,
    tax-behavior: option<post-products-body-default-price-data-currency-options-value-tax-behavior-enum>,
    tiers: option<list<post-products-body-default-price-data-currency-options-value-tiers-item>>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>
  }

  record post-products-body-default-price-data-currency-options-value-custom-unit-amount {
    enabled: bool,
    maximum: option<s32>,
    minimum: option<s32>,
    preset: option<s32>
  }

  record post-products-body-default-price-data-currency-options-value-tiers-item {
    flat-amount: option<s32>,
    flat-amount-decimal: option<string>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>,
    up-to: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-products-body-default-price-data-currency-options-entry {
    key: string,
    value: post-products-body-default-price-data-currency-options-value
  }

  record post-products-body-default-price-data-recurring {
    interval: post-products-body-default-price-data-recurring-interval-enum,
    interval-count: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-products-body-metadata-entry {
    key: string,
    value: string
  }

  /// The dimensions of this product for shipping purposes.
  record post-products-body-package-dimensions {
    height: f64,
    length: f64,
    weight: f64,
    width: f64
  }

  record get-products-search-response {
    data: list<product>,
    has-more: bool,
    next-page: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: get-products-search-response-object-enum,
    /// The total number of objects that match the query, only accurate up to 10,000.
    total-count: option<s32>,
    url: string
  }

  record deleted-product {
    /// Always true for a deleted object
    deleted: bool,
    /// Unique identifier for the object.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: product-object-enum
  }

  record get-products-params {
    /// Only return products that are active or inactive (e.g., pass `false` to list all inactive products).
    active: option<bool>,
    /// Only return products that were created during the given date interval.
    created: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Only return products with the given IDs. Cannot be used with [starting_after](https://stripe.com/docs/api#list_products-starting_after) or [ending_before](https://stripe.com/docs/api#list_products-ending_before).
    ids: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// Only return products that can be shipped (i.e., physical, not digital products).
    shippable: option<bool>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// Only return products with the given url.
    url: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-products: func(params: get-products-params) -> result<get-products-response, string>;

  record post-products-params {
    /// Whether the product is currently available for purchase. Defaults to `true`.
    active: option<bool>,
    /// Data used to generate a new [Price](https://stripe.com/docs/api/prices) object. This Price will be set as the default price for this product.
    default-price-data: option<post-products-body-default-price-data>,
    /// The product's description, meant to be displayable to the customer. Use this field to optionally store a long form explanation of the product being sold for your own rendering purposes.
    description: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// An identifier will be randomly generated by Stripe. You can optionally override this ID, but the ID must be unique across all products in your Stripe account.
    id: option<string>,
    /// A list of up to 8 URLs of images for this product, meant to be displayable to the customer.
    images: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-products-body-metadata-entry>>,
    /// The product's name, meant to be displayable to the customer.
    name: string,
    /// The dimensions of this product for shipping purposes.
    package-dimensions: option<post-products-body-package-dimensions>,
    /// Whether this product is shipped (i.e., physical goods).
    shippable: option<bool>,
    /// An arbitrary string to be displayed on your customer's credit card or bank statement. While most banks display this information consistently, some may display it incorrectly or not at all.
    /// 
    statement-descriptor: option<string>,
    /// A [tax code](https://stripe.com/docs/tax/tax-categories) ID.
    tax-code: option<string>,
    /// A label that represents units of this product. When set, this will be included in customers' receipts, invoices, Checkout, and the customer portal.
    unit-label: option<string>,
    /// A URL of a publicly-accessible webpage for this product.
    url: option<string>
  }
  post-products: func(params: post-products-params) -> result<product, string>;

  record get-products-search-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for pagination across multiple pages of results. Don't include this parameter on the first call. Use the next_page value returned in a previous response to request subsequent results.
    page: option<string>,
    /// The search query string. See [search query language](https://stripe.com/docs/search#search-query-language) and the list of supported [query fields for products](https://stripe.com/docs/search#query-fields-for-products).
    query: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-products-search: func(params: get-products-search-params) -> result<get-products-search-response, string>;

  record get-products-id-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    id: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-products-id: func(params: get-products-id-params) -> result<product, string>;

  record post-products-id-params {
    id: string,
    /// Whether the product is available for purchase.
    active: option<bool>,
    /// The ID of the [Price](https://stripe.com/docs/api/prices) object that is the default price for this product.
    default-price: option<string>,
    /// The product's description, meant to be displayable to the customer. Use this field to optionally store a long form explanation of the product being sold for your own rendering purposes.
    description: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A list of up to 8 URLs of images for this product, meant to be displayable to the customer.
    images: option<string>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// The product's name, meant to be displayable to the customer.
    name: option<string>,
    /// The dimensions of this product for shipping purposes.
    package-dimensions: option<string>,
    /// Whether this product is shipped (i.e., physical goods).
    shippable: option<bool>,
    /// An arbitrary string to be displayed on your customer's credit card or bank statement. While most banks display this information consistently, some may display it incorrectly or not at all.
    /// 
    statement-descriptor: option<string>,
    /// A [tax code](https://stripe.com/docs/tax/tax-categories) ID.
    tax-code: option<string>,
    /// A label that represents units of this product. When set, this will be included in customers' receipts, invoices, Checkout, and the customer portal. May only be set if `type=service`.
    unit-label: option<string>,
    /// A URL of a publicly-accessible webpage for this product.
    url: option<string>
  }
  post-products-id: func(params: post-products-id-params) -> result<product, string>;

  record delete-products-id-params {
    id: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  delete-products-id: func(params: delete-products-id-params) -> result<deleted-product, string>;

}

interface promotion-codes {
  enum coupon-duration-enum {
    forever,
    once,
    repeating,
  }

  enum coupon-object-enum {
    coupon,
  }

  enum promotion-code-object-enum {
    promotion-code,
  }

  enum get-promotion-codes-response-object-enum {
    list-op,
  }

  record get-promotion-codes-response {
    data: list<promotion-code>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-promotion-codes-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A Promotion Code represents a customer-redeemable code for a [coupon](https://stripe.com/docs/api#coupons). It can be used to
  /// create multiple codes for a single coupon.
  record promotion-code {
    /// Whether the promotion code is currently active. A promotion code is only active if the coupon is also valid.
    active: bool,
    /// The customer-facing code. Regardless of case, this code must be unique across all active promotion codes for each customer.
    code: string,
    coupon: coupon,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// The customer that this promotion code can be used by.
    customer: option<string>,
    /// Date at which the promotion code can no longer be redeemed.
    expires-at: option<s32>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Maximum number of times this promotion code can be redeemed.
    max-redemptions: option<s32>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<promotion-code-metadata-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: promotion-code-object-enum,
    restrictions: resource-restrictions,
    /// Number of times this promotion code has been used.
    times-redeemed: s32
  }

  /// A coupon contains information about a percent-off or amount-off discount you
  /// might want to apply to a customer. Coupons may be applied to [subscriptions](https://stripe.com/docs/api#subscriptions), [invoices](https://stripe.com/docs/api#invoices),
  /// [checkout sessions](https://stripe.com/docs/api/checkout/sessions), [quotes](https://stripe.com/docs/api#quotes), and more. Coupons do not work with conventional one-off [charges](https://stripe.com/docs/api#create_charge) or [payment intents](https://stripe.com/docs/api/payment_intents).
  record coupon {
    /// Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer.
    amount-off: option<s32>,
    applies-to: option<coupon-applies-to>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// If `amount_off` has been set, the three-letter [ISO code for the currency](https://stripe.com/docs/currencies) of the amount to take off.
    currency: option<string>,
    /// Coupons defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<coupon-currency-options-entry>>,
    /// One of `forever`, `once`, and `repeating`. Describes how long a customer who applies this coupon will get the discount.
    duration: coupon-duration-enum,
    /// If `duration` is `repeating`, the number of months the coupon applies. Null if coupon `duration` is `forever` or `once`.
    duration-in-months: option<s32>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Maximum number of times this coupon can be redeemed, in total, across all customers, before it is no longer valid.
    max-redemptions: option<s32>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<coupon-metadata-entry>>,
    /// Name of the coupon displayed to customers on for instance invoices or receipts.
    name: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: coupon-object-enum,
    /// Percent that will be taken off the subtotal of any invoices for this customer for the duration of the coupon. For example, a coupon with percent_off of 50 will make a %s100 invoice %s50 instead.
    percent-off: option<f64>,
    /// Date after which the coupon can no longer be redeemed.
    redeem-by: option<s32>,
    /// Number of times this coupon has been applied to a customer.
    times-redeemed: s32,
    /// Taking account of the above properties, whether this coupon can still be applied to a customer.
    valid: bool
  }

  record coupon-applies-to {
    /// A list of product IDs this coupon applies to
    products: list<string>
  }

  record coupon-currency-option {
    /// Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer.
    amount-off: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record coupon-currency-options-entry {
    key: string,
    value: coupon-currency-option
  }

  /// one entry of a string-keyed map (free-form object)
  record coupon-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record promotion-code-metadata-entry {
    key: string,
    value: string
  }

  record resource-restrictions {
    /// Promotion code restrictions defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<resource-restrictions-currency-options-entry>>,
    /// A Boolean indicating if the Promotion Code should only be redeemed for Customers without any successful payments or invoices
    first-time-transaction: bool,
    /// Minimum amount required to redeem this Promotion Code into a Coupon (e.g., a purchase must be $100 or more to work).
    minimum-amount: option<s32>,
    /// Three-letter [ISO code](https://stripe.com/docs/currencies) for minimum_amount
    minimum-amount-currency: option<string>
  }

  record promotion-code-currency-option {
    /// Minimum amount required to redeem this Promotion Code into a Coupon (e.g., a purchase must be $100 or more to work).
    minimum-amount: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record resource-restrictions-currency-options-entry {
    key: string,
    value: promotion-code-currency-option
  }

  /// one entry of a string-keyed map (free-form object)
  record post-promotion-codes-body-metadata-entry {
    key: string,
    value: string
  }

  /// Settings that restrict the redemption of the promotion code.
  record post-promotion-codes-body-restrictions {
    currency-options: option<list<post-promotion-codes-body-restrictions-currency-options-entry>>,
    first-time-transaction: option<bool>,
    minimum-amount: option<s32>,
    minimum-amount-currency: option<string>
  }

  record post-promotion-codes-body-restrictions-currency-options-value {
    minimum-amount: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-promotion-codes-body-restrictions-currency-options-entry {
    key: string,
    value: post-promotion-codes-body-restrictions-currency-options-value
  }

  /// Settings that restrict the redemption of the promotion code.
  record post-promotion-codes-promotion-code-body-restrictions {
    currency-options: option<list<post-promotion-codes-promotion-code-body-restrictions-currency-options-entry>>
  }

  record post-promotion-codes-promotion-code-body-restrictions-currency-options-value {
    minimum-amount: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-promotion-codes-promotion-code-body-restrictions-currency-options-entry {
    key: string,
    value: post-promotion-codes-promotion-code-body-restrictions-currency-options-value
  }

  record get-promotion-codes-params {
    /// Filter promotion codes by whether they are active.
    active: option<bool>,
    /// Only return promotion codes that have this case-insensitive code.
    code: option<string>,
    /// Only return promotion codes for this coupon.
    coupon: option<string>,
    /// A filter on the list, based on the object `created` field. The value can be a string with an integer Unix timestamp, or it can be a dictionary with a number of different query options.
    created: option<string>,
    /// Only return promotion codes that are restricted to this customer.
    customer: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-promotion-codes: func(params: get-promotion-codes-params) -> result<get-promotion-codes-response, string>;

  record post-promotion-codes-params {
    /// Whether the promotion code is currently active.
    active: option<bool>,
    /// The customer-facing code. Regardless of case, this code must be unique across all active promotion codes for a specific customer. If left blank, we will generate one automatically.
    code: option<string>,
    /// The coupon for this promotion code.
    coupon: string,
    /// The customer that this promotion code can be used by. If not set, the promotion code can be used by all customers.
    customer: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// The timestamp at which this promotion code will expire. If the coupon has specified a `redeems_by`, then this value cannot be after the coupon's `redeems_by`.
    expires-at: option<s32>,
    /// A positive integer specifying the number of times the promotion code can be redeemed. If the coupon has specified a `max_redemptions`, then this value cannot be greater than the coupon's `max_redemptions`.
    max-redemptions: option<s32>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-promotion-codes-body-metadata-entry>>,
    /// Settings that restrict the redemption of the promotion code.
    restrictions: option<post-promotion-codes-body-restrictions>
  }
  post-promotion-codes: func(params: post-promotion-codes-params) -> result<promotion-code, string>;

  record get-promotion-codes-promotion-code-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    promotion-code: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-promotion-codes-promotion-code: func(params: get-promotion-codes-promotion-code-params) -> result<promotion-code, string>;

  record post-promotion-codes-promotion-code-params {
    promotion-code: string,
    /// Whether the promotion code is currently active. A promotion code can only be reactivated when the coupon is still valid and the promotion code is otherwise redeemable.
    active: option<bool>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// Settings that restrict the redemption of the promotion code.
    restrictions: option<post-promotion-codes-promotion-code-body-restrictions>
  }
  post-promotion-codes-promotion-code: func(params: post-promotion-codes-promotion-code-params) -> result<promotion-code, string>;

}

interface quotes {
  enum get-quotes-status-enum {
    accepted,
    canceled,
    draft,
    open,
  }

  enum resource-automatic-tax-status-enum {
    complete,
    failed,
    requires-location-inputs,
  }

  enum quote-collection-method-enum {
    charge-automatically,
    send-invoice,
  }

  enum coupon-duration-enum {
    forever,
    once,
    repeating,
  }

  enum coupon-object-enum {
    coupon,
  }

  enum discount-object-enum {
    discount,
  }

  enum item-object-enum {
    item,
  }

  enum tax-rate-object-enum {
    tax-rate,
  }

  enum tax-rate-tax-type-enum {
    gst,
    hst,
    igst,
    jct,
    lease-tax,
    pst,
    qst,
    rst,
    sales-tax,
    vat,
  }

  enum resource-upfront-line-items-object-enum {
    list-op,
  }

  enum quote-object-enum {
    quote,
  }

  enum post-quotes-body-line-items-item-price-data-recurring-interval-enum {
    day,
    month,
    week,
    year,
  }

  enum post-quotes-body-line-items-item-price-data-tax-behavior-enum {
    exclusive,
    inclusive,
    unspecified,
  }

  record get-quotes-response {
    data: list<quote>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: resource-upfront-line-items-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A Quote is a way to model prices that you'd like to provide to a customer.
  /// Once accepted, it will automatically create an invoice, subscription or subscription schedule.
  record quote {
    /// Total before any discounts or taxes are applied.
    amount-subtotal: s32,
    /// Total after discounts and taxes are applied.
    amount-total: s32,
    /// ID of the Connect Application that created the quote.
    application: option<string>,
    /// The amount of the application fee (if any) that will be requested to be applied to the payment and transferred to the application owner's Stripe account. Only applicable if there are no line items with recurring prices on the quote.
    application-fee-amount: option<s32>,
    /// A non-negative decimal between 0 and 100, with at most two decimal places. This represents the percentage of the subscription invoice subtotal that will be transferred to the application owner's Stripe account. Only applicable if there are line items with recurring prices on the quote.
    application-fee-percent: option<f64>,
    automatic-tax: resource-automatic-tax,
    /// Either `charge_automatically`, or `send_invoice`. When charging automatically, Stripe will attempt to pay invoices at the end of the subscription cycle or on finalization using the default payment method attached to the subscription or customer. When sending an invoice, Stripe will email your customer an invoice with payment instructions and mark the subscription as `active`. Defaults to `charge_automatically`.
    collection-method: quote-collection-method-enum,
    computed: resource-computed,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: option<string>,
    /// The customer which this quote belongs to. A customer is required before finalizing the quote. Once specified, it cannot be changed.
    customer: option<string>,
    /// The tax rates applied to this quote.
    default-tax-rates: option<list<string>>,
    /// A description that will be displayed on the quote PDF.
    description: option<string>,
    /// The discounts applied to this quote.
    discounts: list<string>,
    /// The date on which the quote will be canceled if in `open` or `draft` status. Measured in seconds since the Unix epoch.
    expires-at: s32,
    /// A footer that will be displayed on the quote PDF.
    footer: option<string>,
    /// Details of the quote that was cloned. See the [cloning documentation](https://stripe.com/docs/quotes/clone) for more details.
    from-quote: option<string>,
    /// A header that will be displayed on the quote PDF.
    header: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// The invoice that was created from this quote.
    invoice: option<string>,
    /// All invoices will be billed using the specified settings.
    invoice-settings: option<string>,
    /// A list of items the customer is being quoted for.
    line-items: option<quote-line-items>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<quote-metadata-entry>,
    /// A unique number that identifies this particular quote. This number is assigned once the quote is [finalized](https://stripe.com/docs/quotes/overview#finalize).
    number: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: quote-object-enum,
    /// The account on behalf of which to charge. See the [Connect documentation](https://support.stripe.com/questions/sending-invoices-on-behalf-of-connected-accounts) for details.
    on-behalf-of: option<string>,
    /// The status of the quote.
    status: get-quotes-status-enum,
    status-transitions: resource-status-transitions,
    /// The subscription that was created or updated from this quote.
    subscription: option<string>,
    subscription-data: resource-subscription-data-subscription-data,
    /// The subscription schedule that was created or updated from this quote.
    subscription-schedule: option<string>,
    /// ID of the test clock this quote belongs to.
    test-clock: option<string>,
    total-details: resource-total-details,
    /// The account (if any) the payments will be attributed to for tax reporting, and where funds from each payment will be transferred to for each of the invoices.
    transfer-data: option<string>
  }

  record resource-automatic-tax {
    /// Automatically calculate taxes
    enabled: bool,
    /// The status of the most recent automated tax calculation for this quote.
    status: option<resource-automatic-tax-status-enum>
  }

  record resource-computed {
    /// The definitive totals and line items the customer will be charged on a recurring basis. Takes into account the line items with recurring prices and discounts with `duration=forever` coupons only. Defaults to `null` if no inputted line items with recurring prices.
    recurring: option<string>,
    upfront: resource-upfront
  }

  record resource-upfront {
    /// Total before any discounts or taxes are applied.
    amount-subtotal: s32,
    /// Total after discounts and taxes are applied.
    amount-total: s32,
    /// The line items that will appear on the next invoice after this quote is accepted. This does not include pending invoice items that exist on the customer but may still be included in the next invoice.
    line-items: option<resource-upfront-line-items>,
    total-details: resource-total-details
  }

  /// The line items that will appear on the next invoice after this quote is accepted. This does not include pending invoice items that exist on the customer but may still be included in the next invoice.
  record resource-upfront-line-items {
    /// Details about each object.
    data: list<item>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: resource-upfront-line-items-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A line item.
  record item {
    /// Total discount amount applied. If no discounts were applied, defaults to 0.
    amount-discount: s32,
    /// Total before any discounts or taxes are applied.
    amount-subtotal: s32,
    /// Total tax amount applied. If no tax was applied, defaults to 0.
    amount-tax: s32,
    /// Total after discounts and taxes.
    amount-total: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// An arbitrary string attached to the object. Often useful for displaying to users. Defaults to product name.
    description: string,
    /// The discounts applied to the line item.
    discounts: option<list<line-items-discount-amount>>,
    /// Unique identifier for the object.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: item-object-enum,
    /// The price used to generate the line item.
    price: option<string>,
    /// The quantity of products being purchased.
    quantity: option<s32>,
    /// The taxes applied to the line item.
    taxes: option<list<line-items-tax-amount>>
  }

  record line-items-discount-amount {
    /// The amount discounted.
    amount: s32,
    discount: discount
  }

  /// A discount represents the actual application of a [coupon](https://stripe.com/docs/api#coupons) or [promotion code](https://stripe.com/docs/api#promotion_codes).
  /// It contains information about when the discount began, when it will end, and what it is applied to.
  /// 
  /// Related guide: [Applying Discounts to Subscriptions](https://stripe.com/docs/billing/subscriptions/discounts).
  record discount {
    /// The Checkout session that this coupon is applied to, if it is applied to a particular session in payment mode. Will not be present for subscription mode.
    checkout-session: option<string>,
    coupon: coupon,
    /// The ID of the customer associated with this discount.
    customer: option<string>,
    /// If the coupon has a duration of `repeating`, the date that this discount will end. If the coupon has a duration of `once` or `forever`, this attribute will be null.
    end: option<s32>,
    /// The ID of the discount object. Discounts cannot be fetched by ID. Use `expand[]=discounts` in API calls to expand discount IDs in an array.
    id: string,
    /// The invoice that the discount's coupon was applied to, if it was applied directly to a particular invoice.
    invoice: option<string>,
    /// The invoice item `id` (or invoice line item `id` for invoice line items of type='subscription') that the discount's coupon was applied to, if it was applied directly to a particular invoice item or invoice line item.
    invoice-item: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: discount-object-enum,
    /// The promotion code applied to create this discount.
    promotion-code: option<string>,
    /// Date that the coupon was applied.
    start: s32,
    /// The subscription that this coupon is applied to, if it is applied to a particular subscription.
    subscription: option<string>
  }

  /// A coupon contains information about a percent-off or amount-off discount you
  /// might want to apply to a customer. Coupons may be applied to [subscriptions](https://stripe.com/docs/api#subscriptions), [invoices](https://stripe.com/docs/api#invoices),
  /// [checkout sessions](https://stripe.com/docs/api/checkout/sessions), [quotes](https://stripe.com/docs/api#quotes), and more. Coupons do not work with conventional one-off [charges](https://stripe.com/docs/api#create_charge) or [payment intents](https://stripe.com/docs/api/payment_intents).
  record coupon {
    /// Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer.
    amount-off: option<s32>,
    applies-to: option<coupon-applies-to>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// If `amount_off` has been set, the three-letter [ISO code for the currency](https://stripe.com/docs/currencies) of the amount to take off.
    currency: option<string>,
    /// Coupons defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<coupon-currency-options-entry>>,
    /// One of `forever`, `once`, and `repeating`. Describes how long a customer who applies this coupon will get the discount.
    duration: coupon-duration-enum,
    /// If `duration` is `repeating`, the number of months the coupon applies. Null if coupon `duration` is `forever` or `once`.
    duration-in-months: option<s32>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Maximum number of times this coupon can be redeemed, in total, across all customers, before it is no longer valid.
    max-redemptions: option<s32>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<coupon-metadata-entry>>,
    /// Name of the coupon displayed to customers on for instance invoices or receipts.
    name: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: coupon-object-enum,
    /// Percent that will be taken off the subtotal of any invoices for this customer for the duration of the coupon. For example, a coupon with percent_off of 50 will make a %s100 invoice %s50 instead.
    percent-off: option<f64>,
    /// Date after which the coupon can no longer be redeemed.
    redeem-by: option<s32>,
    /// Number of times this coupon has been applied to a customer.
    times-redeemed: s32,
    /// Taking account of the above properties, whether this coupon can still be applied to a customer.
    valid: bool
  }

  record coupon-applies-to {
    /// A list of product IDs this coupon applies to
    products: list<string>
  }

  record coupon-currency-option {
    /// Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer.
    amount-off: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record coupon-currency-options-entry {
    key: string,
    value: coupon-currency-option
  }

  /// one entry of a string-keyed map (free-form object)
  record coupon-metadata-entry {
    key: string,
    value: string
  }

  record line-items-tax-amount {
    /// Amount of tax applied for this rate.
    amount: s32,
    rate: tax-rate
  }

  /// Tax rates can be applied to [invoices](https://stripe.com/docs/billing/invoices/tax-rates), [subscriptions](https://stripe.com/docs/billing/subscriptions/taxes) and [Checkout Sessions](https://stripe.com/docs/payments/checkout/set-up-a-subscription#tax-rates) to collect tax.
  /// 
  /// Related guide: [Tax Rates](https://stripe.com/docs/billing/taxes/tax-rates).
  record tax-rate {
    /// Defaults to `true`. When set to `false`, this tax rate cannot be used with new applications or Checkout Sessions, but will still work for subscriptions and invoices that already have it set.
    active: bool,
    /// Two-letter country code ([ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)).
    country: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// An arbitrary string attached to the tax rate for your internal use only. It will not be visible to your customers.
    description: option<string>,
    /// The display name of the tax rates as it will appear to your customer on their receipt email, PDF, and the hosted invoice page.
    display-name: string,
    /// Unique identifier for the object.
    id: string,
    /// This specifies if the tax rate is inclusive or exclusive.
    inclusive: bool,
    /// The jurisdiction for the tax rate. You can use this label field for tax reporting purposes. It also appears on your customer’s invoice.
    jurisdiction: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<tax-rate-metadata-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: tax-rate-object-enum,
    /// This represents the tax rate percent out of 100.
    percentage: f64,
    /// [ISO 3166-2 subdivision code](https://en.wikipedia.org/wiki/ISO_3166-2:US), without country prefix. For example, "NY" for New York, United States.
    state: option<string>,
    /// The high-level tax type, such as `vat` or `sales_tax`.
    tax-type: option<tax-rate-tax-type-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record tax-rate-metadata-entry {
    key: string,
    value: string
  }

  record resource-total-details {
    /// This is the sum of all the discounts.
    amount-discount: s32,
    /// This is the sum of all the shipping amounts.
    amount-shipping: option<s32>,
    /// This is the sum of all the tax amounts.
    amount-tax: s32,
    breakdown: option<resource-total-details-resource-breakdown>
  }

  record resource-total-details-resource-breakdown {
    /// The aggregated discounts.
    discounts: list<line-items-discount-amount>,
    /// The aggregated tax amounts by rate.
    taxes: list<line-items-tax-amount>
  }

  /// A list of items the customer is being quoted for.
  record quote-line-items {
    /// Details about each object.
    data: list<item>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: resource-upfront-line-items-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// one entry of a string-keyed map (free-form object)
  record quote-metadata-entry {
    key: string,
    value: string
  }

  record resource-status-transitions {
    /// The time that the quote was accepted. Measured in seconds since Unix epoch.
    accepted-at: option<s32>,
    /// The time that the quote was canceled. Measured in seconds since Unix epoch.
    canceled-at: option<s32>,
    /// The time that the quote was finalized. Measured in seconds since Unix epoch.
    finalized-at: option<s32>
  }

  record resource-subscription-data-subscription-data {
    /// The subscription's description, meant to be displayable to the customer. Use this field to optionally store an explanation of the subscription.
    description: option<string>,
    /// When creating a new subscription, the date of which the subscription schedule will start after the quote is accepted. This date is ignored if it is in the past when the quote is accepted. Measured in seconds since the Unix epoch.
    effective-date: option<s32>,
    /// Integer representing the number of trial period days before the customer is charged for the first time.
    trial-period-days: option<s32>
  }

  /// Settings for automatic tax lookup for this quote and resulting invoices and subscriptions.
  record post-quotes-body-automatic-tax {
    enabled: bool
  }

  /// Clone an existing quote. The new quote will be created in `status=draft`. When using this parameter, you cannot specify any other parameters except for `expires_at`.
  record post-quotes-body-from-quote {
    is-revision: option<bool>,
    quote: string
  }

  /// All invoices will be billed using the specified settings.
  record post-quotes-body-invoice-settings {
    days-until-due: option<s32>
  }

  record post-quotes-body-line-items-item {
    price: option<string>,
    price-data: option<post-quotes-body-line-items-item-price-data>,
    quantity: option<s32>,
    tax-rates: option<string>
  }

  record post-quotes-body-line-items-item-price-data {
    currency: string,
    product: string,
    recurring: option<post-quotes-body-line-items-item-price-data-recurring>,
    tax-behavior: option<post-quotes-body-line-items-item-price-data-tax-behavior-enum>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>
  }

  record post-quotes-body-line-items-item-price-data-recurring {
    interval: post-quotes-body-line-items-item-price-data-recurring-interval-enum,
    interval-count: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-quotes-body-metadata-entry {
    key: string,
    value: string
  }

  /// When creating a subscription or subscription schedule, the specified configuration data will be used. There must be at least one line item with a recurring price for a subscription or subscription schedule to be created. A subscription schedule is created if `subscription_data[effective_date]` is present and in the future, otherwise a subscription is created.
  record post-quotes-body-subscription-data {
    description: option<string>,
    effective-date: option<string>,
    trial-period-days: option<string>
  }

  /// Settings for automatic tax lookup for this quote and resulting invoices and subscriptions.
  record post-quotes-quote-body-automatic-tax {
    enabled: bool
  }

  /// All invoices will be billed using the specified settings.
  record post-quotes-quote-body-invoice-settings {
    days-until-due: option<s32>
  }

  record post-quotes-quote-body-line-items-item {
    id: option<string>,
    price: option<string>,
    price-data: option<post-quotes-quote-body-line-items-item-price-data>,
    quantity: option<s32>,
    tax-rates: option<string>
  }

  record post-quotes-quote-body-line-items-item-price-data {
    currency: string,
    product: string,
    recurring: option<post-quotes-quote-body-line-items-item-price-data-recurring>,
    tax-behavior: option<post-quotes-body-line-items-item-price-data-tax-behavior-enum>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>
  }

  record post-quotes-quote-body-line-items-item-price-data-recurring {
    interval: post-quotes-body-line-items-item-price-data-recurring-interval-enum,
    interval-count: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-quotes-quote-body-metadata-entry {
    key: string,
    value: string
  }

  /// When creating a subscription or subscription schedule, the specified configuration data will be used. There must be at least one line item with a recurring price for a subscription or subscription schedule to be created. A subscription schedule is created if `subscription_data[effective_date]` is present and in the future, otherwise a subscription is created.
  record post-quotes-quote-body-subscription-data {
    description: option<string>,
    effective-date: option<string>,
    trial-period-days: option<string>
  }

  record get-quotes-quote-computed-upfront-line-items-response {
    /// Details about each object.
    data: list<item>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: resource-upfront-line-items-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  record get-quotes-quote-line-items-response {
    /// Details about each object.
    data: list<item>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
