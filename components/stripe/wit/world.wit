  record get-setup-intents-params {
    /// If present, the SetupIntent's payment method will be attached to the in-context Stripe Account.
    /// 
    attach-to-self: option<bool>,
    /// A filter on the list, based on the object `created` field. The value can be a string with an integer Unix timestamp, or it can be a dictionary with a number of different query options.
    created: option<string>,
    /// Only return SetupIntents for the customer specified by this customer ID.
    customer: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// Only return SetupIntents associated with the specified payment method.
    payment-method: option<string>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-setup-intents: func(params: get-setup-intents-params) -> result<get-setup-intents-response, string>;

  record post-setup-intents-params {
    /// If present, the SetupIntent's payment method will be attached to the in-context Stripe Account.
    /// 
    attach-to-self: option<bool>,
    /// When enabled, this SetupIntent will accept payment methods that you have enabled in the Dashboard and are compatible with this SetupIntent's other parameters.
    automatic-payment-methods: option<post-setup-intents-body-automatic-payment-methods>,
    /// Set to `true` to attempt to confirm this SetupIntent immediately. This parameter defaults to `false`. If the payment method attached is a card, a return_url may be provided in case additional authentication is required.
    confirm: option<bool>,
    /// ID of the Customer this SetupIntent belongs to, if one exists.
    /// 
    customer: option<string>,
    /// An arbitrary string attached to the object. Often useful for displaying to users.
    description: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Indicates the directions of money movement for which this payment method is intended to be used.
    /// 
    flow-directions: option<list<setup-intent-flow-directions-item-enum>>,
    /// This hash contains details about the Mandate to create. This parameter can only be used with [`confirm=true`](https://stripe.com/docs/api/setup_intents/create#create_setup_intent-confirm).
    mandate-data: option<post-setup-intents-body-mandate-data>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-setup-intents-body-metadata-entry>>,
    /// The Stripe account ID for which this SetupIntent is created.
    on-behalf-of: option<string>,
    /// ID of the payment method (a PaymentMethod, Card, or saved Source object) to attach to this SetupIntent.
    payment-method: option<string>,
    /// When included, this hash creates a PaymentMethod that is set as the [`payment_method`](https://stripe.com/docs/api/setup_intents/object#setup_intent_object-payment_method)
    /// value in the SetupIntent.
    payment-method-data: option<post-setup-intents-body-payment-method-data>,
    /// Payment-method-specific configuration for this SetupIntent.
    payment-method-options: option<post-setup-intents-body-payment-method-options>,
    /// The list of payment method types (e.g. card) that this SetupIntent is allowed to use. If this is not provided, defaults to ["card"].
    payment-method-types: option<list<string>>,
    /// The URL to redirect your customer back to after they authenticate or cancel their payment on the payment method's app or site. If you'd prefer to redirect to a mobile application, you can alternatively supply an application URI scheme. This parameter can only be used with [`confirm=true`](https://stripe.com/docs/api/setup_intents/create#create_setup_intent-confirm).
    return-url: option<string>,
    /// If this hash is populated, this SetupIntent will generate a single_use Mandate on success.
    single-use: option<post-setup-intents-body-single-use>,
    /// Indicates how the payment method is intended to be used in the future. If not provided, this value defaults to `off_session`.
    usage: option<post-setup-intents-body-usage-enum>
  }
  post-setup-intents: func(params: post-setup-intents-params) -> result<setup-intent, string>;

  record get-setup-intents-intent-params {
    /// The client secret of the SetupIntent. Required if a publishable key is used to retrieve the SetupIntent.
    client-secret: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    intent: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-setup-intents-intent: func(params: get-setup-intents-intent-params) -> result<setup-intent, string>;

  record post-setup-intents-intent-params {
    intent: string,
    /// If present, the SetupIntent's payment method will be attached to the in-context Stripe Account.
    /// 
    attach-to-self: option<bool>,
    /// ID of the Customer this SetupIntent belongs to, if one exists.
    /// 
    customer: option<string>,
    /// An arbitrary string attached to the object. Often useful for displaying to users.
    description: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Indicates the directions of money movement for which this payment method is intended to be used.
    /// 
    flow-directions: option<list<setup-intent-flow-directions-item-enum>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// ID of the payment method (a PaymentMethod, Card, or saved Source object) to attach to this SetupIntent.
    payment-method: option<string>,
    /// When included, this hash creates a PaymentMethod that is set as the [`payment_method`](https://stripe.com/docs/api/setup_intents/object#setup_intent_object-payment_method)
    /// value in the SetupIntent.
    payment-method-data: option<post-setup-intents-intent-body-payment-method-data>,
    /// Payment-method-specific configuration for this SetupIntent.
    payment-method-options: option<post-setup-intents-intent-body-payment-method-options>,
    /// The list of payment method types (e.g. card) that this SetupIntent is allowed to set up. If this is not provided, defaults to ["card"].
    payment-method-types: option<list<string>>
  }
  post-setup-intents-intent: func(params: post-setup-intents-intent-params) -> result<setup-intent, string>;

  record post-setup-intents-intent-cancel-params {
    intent: string,
    /// Reason for canceling this SetupIntent. Possible values are `abandoned`, `requested_by_customer`, or `duplicate`
    cancellation-reason: option<setup-intent-cancellation-reason-enum>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-setup-intents-intent-cancel: func(params: post-setup-intents-intent-cancel-params) -> result<setup-intent, string>;

  record post-setup-intents-intent-confirm-params {
    intent: string,
    /// The client secret of the SetupIntent.
    client-secret: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// This hash contains details about the Mandate to create
    mandate-data: option<string>,
    /// ID of the payment method (a PaymentMethod, Card, or saved Source object) to attach to this SetupIntent.
    payment-method: option<string>,
    /// When included, this hash creates a PaymentMethod that is set as the [`payment_method`](https://stripe.com/docs/api/setup_intents/object#setup_intent_object-payment_method)
    /// value in the SetupIntent.
    payment-method-data: option<post-setup-intents-intent-confirm-body-payment-method-data>,
    /// Payment-method-specific configuration for this SetupIntent.
    payment-method-options: option<post-setup-intents-intent-confirm-body-payment-method-options>,
    /// The URL to redirect your customer back to after they authenticate on the payment method's app or site.
    /// If you'd prefer to redirect to a mobile application, you can alternatively supply an application URI scheme.
    return-url: option<string>
  }
  post-setup-intents-intent-confirm: func(params: post-setup-intents-intent-confirm-params) -> result<setup-intent, string>;

  record post-setup-intents-intent-verify-microdeposits-params {
    intent: string,
    /// Two positive integers, in *cents*, equal to the values of the microdeposits sent to the bank account.
    amounts: option<list<s32>>,
    /// The client secret of the SetupIntent.
    client-secret: option<string>,
    /// A six-character code starting with SM present in the microdeposit sent to the bank account.
    descriptor-code: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-setup-intents-intent-verify-microdeposits: func(params: post-setup-intents-intent-verify-microdeposits-params) -> result<setup-intent, string>;

}

interface shipping-rates {
  enum shipping-rate-currency-option-tax-behavior-enum {
    exclusive,
    inclusive,
    unspecified,
  }

  enum shipping-rate-object-enum {
    shipping-rate,
  }

  enum shipping-rate-type-op-enum {
    fixed-amount,
  }

  enum get-shipping-rates-response-object-enum {
    list-op,
  }

  enum post-shipping-rates-body-delivery-estimate-maximum-unit-enum {
    business-day,
    day,
    hour,
    month,
    week,
  }

  record get-shipping-rates-response {
    data: list<shipping-rate>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-shipping-rates-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Shipping rates describe the price of shipping presented to your customers and can be
  /// applied to [Checkout Sessions](https://stripe.com/docs/payments/checkout/shipping)
  /// and [Orders](https://stripe.com/docs/orders/shipping) to collect shipping costs.
  record shipping-rate {
    /// Whether the shipping rate can be used for new purchases. Defaults to `true`.
    active: bool,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// The estimated range for how long shipping will take, meant to be displayable to the customer. This will appear on CheckoutSessions.
    delivery-estimate: option<string>,
    /// The name of the shipping rate, meant to be displayable to the customer. This will appear on CheckoutSessions.
    display-name: option<string>,
    fixed-amount: option<shipping-rate-fixed-amount>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<shipping-rate-metadata-entry>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: shipping-rate-object-enum,
    /// Specifies whether the rate is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`.
    tax-behavior: option<shipping-rate-currency-option-tax-behavior-enum>,
    /// A [tax code](https://stripe.com/docs/tax/tax-categories) ID. The Shipping tax code is `txcd_92010001`.
    tax-code: option<string>,
    /// The type of calculation to use on the shipping rate. Can only be `fixed_amount` for now.
    type-op: shipping-rate-type-op-enum
  }

  record shipping-rate-fixed-amount {
    /// A non-negative integer in cents representing how much to charge.
    amount: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// Shipping rates defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<shipping-rate-fixed-amount-currency-options-entry>>
  }

  record shipping-rate-currency-option {
    /// A non-negative integer in cents representing how much to charge.
    amount: s32,
    /// Specifies whether the rate is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`.
    tax-behavior: shipping-rate-currency-option-tax-behavior-enum
  }

  /// one entry of a string-keyed map (free-form object)
  record shipping-rate-fixed-amount-currency-options-entry {
    key: string,
    value: shipping-rate-currency-option
  }

  /// one entry of a string-keyed map (free-form object)
  record shipping-rate-metadata-entry {
    key: string,
    value: string
  }

  /// The estimated range for how long shipping will take, meant to be displayable to the customer. This will appear on CheckoutSessions.
  record post-shipping-rates-body-delivery-estimate {
    maximum: option<post-shipping-rates-body-delivery-estimate-maximum>,
    minimum: option<post-shipping-rates-body-delivery-estimate-minimum>
  }

  record post-shipping-rates-body-delivery-estimate-maximum {
    unit: post-shipping-rates-body-delivery-estimate-maximum-unit-enum,
    value: s32
  }

  record post-shipping-rates-body-delivery-estimate-minimum {
    unit: post-shipping-rates-body-delivery-estimate-maximum-unit-enum,
    value: s32
  }

  /// Describes a fixed amount to charge for shipping. Must be present if type is `fixed_amount`.
  record post-shipping-rates-body-fixed-amount {
    amount: s32,
    currency: string,
    currency-options: option<list<post-shipping-rates-body-fixed-amount-currency-options-entry>>
  }

  record post-shipping-rates-body-fixed-amount-currency-options-value {
    amount: s32,
    tax-behavior: option<shipping-rate-currency-option-tax-behavior-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-shipping-rates-body-fixed-amount-currency-options-entry {
    key: string,
    value: post-shipping-rates-body-fixed-amount-currency-options-value
  }

  /// one entry of a string-keyed map (free-form object)
  record post-shipping-rates-body-metadata-entry {
    key: string,
    value: string
  }

  /// Describes a fixed amount to charge for shipping. Must be present if type is `fixed_amount`.
  record post-shipping-rates-shipping-rate-token-body-fixed-amount {
    currency-options: option<list<post-shipping-rates-shipping-rate-token-body-fixed-amount-currency-options-entry>>
  }

  record post-shipping-rates-shipping-rate-token-body-fixed-amount-currency-options-value {
    amount: option<s32>,
    tax-behavior: option<shipping-rate-currency-option-tax-behavior-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-shipping-rates-shipping-rate-token-body-fixed-amount-currency-options-entry {
    key: string,
    value: post-shipping-rates-shipping-rate-token-body-fixed-amount-currency-options-value
  }

  record get-shipping-rates-params {
    /// Only return shipping rates that are active or inactive.
    active: option<bool>,
    /// A filter on the list, based on the object `created` field. The value can be a string with an integer Unix timestamp, or it can be a dictionary with a number of different query options.
    created: option<string>,
    /// Only return shipping rates for the given currency.
    currency: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-shipping-rates: func(params: get-shipping-rates-params) -> result<get-shipping-rates-response, string>;

  record post-shipping-rates-params {
    /// The estimated range for how long shipping will take, meant to be displayable to the customer. This will appear on CheckoutSessions.
    delivery-estimate: option<post-shipping-rates-body-delivery-estimate>,
    /// The name of the shipping rate, meant to be displayable to the customer. This will appear on CheckoutSessions.
    display-name: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Describes a fixed amount to charge for shipping. Must be present if type is `fixed_amount`.
    fixed-amount: option<post-shipping-rates-body-fixed-amount>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-shipping-rates-body-metadata-entry>>,
    /// Specifies whether the rate is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`.
    tax-behavior: option<shipping-rate-currency-option-tax-behavior-enum>,
    /// A [tax code](https://stripe.com/docs/tax/tax-categories) ID. The Shipping tax code is `txcd_92010001`.
    tax-code: option<string>,
    /// The type of calculation to use on the shipping rate. Can only be `fixed_amount` for now.
    type-op: option<shipping-rate-type-op-enum>
  }
  post-shipping-rates: func(params: post-shipping-rates-params) -> result<shipping-rate, string>;

  record get-shipping-rates-shipping-rate-token-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    shipping-rate-token: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-shipping-rates-shipping-rate-token: func(params: get-shipping-rates-shipping-rate-token-params) -> result<shipping-rate, string>;

  record post-shipping-rates-shipping-rate-token-params {
    shipping-rate-token: string,
    /// Whether the shipping rate can be used for new purchases. Defaults to `true`.
    active: option<bool>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Describes a fixed amount to charge for shipping. Must be present if type is `fixed_amount`.
    fixed-amount: option<post-shipping-rates-shipping-rate-token-body-fixed-amount>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// Specifies whether the rate is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`.
    tax-behavior: option<shipping-rate-currency-option-tax-behavior-enum>
  }
  post-shipping-rates-shipping-rate-token: func(params: post-shipping-rates-shipping-rate-token-params) -> result<shipping-rate, string>;

}

interface sigma {
  enum scheduled-query-run-object-enum {
    scheduled-query-run,
  }

  enum get-sigma-scheduled-query-runs-response-object-enum {
    list-op,
  }

  record get-sigma-scheduled-query-runs-response {
    data: list<scheduled-query-run>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-sigma-scheduled-query-runs-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// If you have [scheduled a Sigma query](https://stripe.com/docs/sigma/scheduled-queries), you'll
  /// receive a `sigma.scheduled_query_run.created` webhook each time the query
  /// runs. The webhook contains a `ScheduledQueryRun` object, which you can use to
  /// retrieve the query results.
  record scheduled-query-run {
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// When the query was run, Sigma contained a snapshot of your Stripe data at this time.
    data-load-time: s32,
    error: option<scheduled-query-run-error>,
    /// The file object representing the results of the query.
    file: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: scheduled-query-run-object-enum,
    /// Time at which the result expires and is no longer available for download.
    result-available-until: s32,
    /// SQL for the query.
    sql: string,
    /// The query's execution status, which will be `completed` for successful runs, and `canceled`, `failed`, or `timed_out` otherwise.
    status: string,
    /// Title of the query.
    title: string
  }

  record scheduled-query-run-error {
    /// Information about the run failure.
    message: string
  }

  record get-sigma-scheduled-query-runs-params {
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-sigma-scheduled-query-runs: func(params: get-sigma-scheduled-query-runs-params) -> result<get-sigma-scheduled-query-runs-response, string>;

  record get-sigma-scheduled-query-runs-scheduled-query-run-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    scheduled-query-run: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-sigma-scheduled-query-runs-scheduled-query-run: func(params: get-sigma-scheduled-query-runs-scheduled-query-run-params) -> result<scheduled-query-run, string>;

}

interface sources {
  enum post-sources-body-flow-enum {
    code-verification,
    none,
    receiver,
    redirect,
  }

  enum post-sources-body-mandate-acceptance-status-enum {
    accepted,
    pending,
    refused,
    revoked,
  }

  enum post-sources-body-mandate-acceptance-type-op-enum {
    offline,
    online,
  }

  enum post-sources-body-mandate-interval-enum {
    one-time,
    scheduled,
    variable,
  }

  enum post-sources-body-mandate-notification-method-enum {
    deprecated-none,
    email,
    manual,
    none,
    stripe-email,
  }

  enum post-sources-body-receiver-refund-attributes-method-enum {
    email,
    manual,
    none,
  }

  enum post-sources-body-source-order-items-item-type-op-enum {
    discount,
    shipping,
    sku,
    tax,
  }

  enum post-sources-body-usage-enum {
    reusable,
    single-use,
  }

  enum source-object-enum {
    source,
  }

  enum source-type-op-enum {
    ach-credit-transfer,
    ach-debit,
    acss-debit,
    alipay,
    au-becs-debit,
    bancontact,
    card,
    card-present,
    eps,
    giropay,
    ideal,
    klarna,
    multibanco,
    p24,
    sepa-debit,
    sofort,
    three-d-secure,
    wechat,
  }

  enum source-mandate-notification-object-enum {
    source-mandate-notification,
  }

  enum source-transaction-object-enum {
    source-transaction,
  }

  enum source-transaction-type-op-enum {
    ach-credit-transfer,
    ach-debit,
    alipay,
    bancontact,
    card,
    card-present,
    eps,
    giropay,
    ideal,
    klarna,
    multibanco,
    p24,
    sepa-debit,
    sofort,
    three-d-secure,
    wechat,
  }

  enum get-sources-source-source-transactions-response-object-enum {
    list-op,
  }

  /// Information about a mandate possibility attached to a source object (generally for bank debits) as well as its acceptance status.
  record post-sources-body-mandate {
    acceptance: option<post-sources-body-mandate-acceptance>,
    amount: option<string>,
    currency: option<string>,
    interval: option<post-sources-body-mandate-interval-enum>,
    notification-method: option<post-sources-body-mandate-notification-method-enum>
  }

  record post-sources-body-mandate-acceptance {
    date: option<s32>,
    ip: option<string>,
    offline: option<post-sources-body-mandate-acceptance-offline>,
    online: option<post-sources-body-mandate-acceptance-online>,
    status: post-sources-body-mandate-acceptance-status-enum,
    type-op: option<post-sources-body-mandate-acceptance-type-op-enum>,
    user-agent: option<string>
  }

  record post-sources-body-mandate-acceptance-offline {
    contact-email: string
  }

  record post-sources-body-mandate-acceptance-online {
    date: option<s32>,
    ip: option<string>,
    user-agent: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-sources-body-metadata-entry {
    key: string,
    value: string
  }

  /// Information about the owner of the payment instrument that may be used or required by particular source types.
  record post-sources-body-owner {
    address: option<post-sources-body-owner-address>,
    email: option<string>,
    name: option<string>,
    phone: option<string>
  }

  record post-sources-body-owner-address {
    city: option<string>,
    country: option<string>,
    line1: option<string>,
    line2: option<string>,
    postal-code: option<string>,
    state: option<string>
  }

  /// Optional parameters for the receiver flow. Can be set only if the source is a receiver (`flow` is `receiver`).
  record post-sources-body-receiver {
    refund-attributes-method: option<post-sources-body-receiver-refund-attributes-method-enum>
  }

  /// Parameters required for the redirect flow. Required if the source is authenticated by a redirect (`flow` is `redirect`).
  record post-sources-body-redirect {
    return-url: string
  }

  /// Information about the items and shipping associated with the source. Required for transactional credit (for example Klarna) sources before you can charge it.
  record post-sources-body-source-order {
    items: option<list<post-sources-body-source-order-items-item>>,
    shipping: option<post-sources-body-source-order-shipping>
  }

  record post-sources-body-source-order-items-item {
    amount: option<s32>,
    currency: option<string>,
    description: option<string>,
    parent: option<string>,
    quantity: option<s32>,
    type-op: option<post-sources-body-source-order-items-item-type-op-enum>
  }

  record post-sources-body-source-order-shipping {
    address: post-sources-body-source-order-shipping-address,
    carrier: option<string>,
    name: option<string>,
    phone: option<string>,
    tracking-number: option<string>
  }

  record post-sources-body-source-order-shipping-address {
    city: option<string>,
    country: option<string>,
    line1: string,
    line2: option<string>,
    postal-code: option<string>,
    state: option<string>
  }

  /// `Source` objects allow you to accept a variety of payment methods. They
  /// represent a customer's payment instrument, and can be used with the Stripe API
  /// just like a `Card` object: once chargeable, they can be charged, or can be
  /// attached to customers.
  /// 
  /// Stripe doesn't recommend using the deprecated [Sources API](https://stripe.com/docs/api/sources).
  /// We recommend that you adopt the [PaymentMethods API](https://stripe.com/docs/api/payment_methods).
  /// This newer API provides access to our latest features and payment method types.
  /// 
  /// Related guides: [Sources API](https://stripe.com/docs/sources) and [Sources & Customers](https://stripe.com/docs/sources/customers).
  record source {
    ach-credit-transfer: option<source-type-ach-credit-transfer>,
    ach-debit: option<source-type-ach-debit>,
    acss-debit: option<source-type-acss-debit>,
    alipay: option<source-type-alipay>,
    /// A positive integer in the smallest currency unit (that is, 100 cents for $1.00, or 1 for ¥1, Japanese Yen being a zero-decimal currency) representing the total amount associated with the source. This is the amount for which the source will be chargeable once ready. Required for `single_use` sources.
    amount: option<s32>,
    au-becs-debit: option<source-type-au-becs-debit>,
    bancontact: option<source-type-bancontact>,
    card: option<source-type-card>,
    card-present: option<source-type-card-present>,
    /// The client secret of the source. Used for client-side retrieval using a publishable key.
    client-secret: string,
    code-verification: option<source-code-verification-flow>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO code for the currency](https://stripe.com/docs/currencies) associated with the source. This is the currency for which the source will be chargeable once ready. Required for `single_use` sources.
    currency: option<string>,
    /// The ID of the customer to which this source is attached. This will not be present when the source has not been attached to a customer.
    customer: option<string>,
    eps: option<source-type-eps>,
    /// The authentication `flow` of the source. `flow` is one of `redirect`, `receiver`, `code_verification`, `none`.
    flow: string,
    giropay: option<source-type-giropay>,
    /// Unique identifier for the object.
    id: string,
    ideal: option<source-type-ideal>,
    klarna: option<source-type-klarna>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<source-metadata-entry>>,
    multibanco: option<source-type-multibanco>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: source-object-enum,
    /// Information about the owner of the payment instrument that may be used or required by particular source types.
    owner: option<string>,
    p24: option<source-type-p24>,
    receiver: option<source-receiver-flow>,
    redirect: option<source-redirect-flow>,
    sepa-debit: option<source-type-sepa-debit>,
    sofort: option<source-type-sofort>,
    source-order: option<source-order>,
    /// Extra information about a source. This will appear on your customer's statement every time you charge the source.
    statement-descriptor: option<string>,
    /// The status of the source, one of `canceled`, `chargeable`, `consumed`, `failed`, or `pending`. Only `chargeable` sources can be used to create a charge.
    status: string,
    three-d-secure: option<source-type-three-d-secure>,
    /// The `type` of the source. The `type` is a payment method, one of `ach_credit_transfer`, `ach_debit`, `alipay`, `bancontact`, `card`, `card_present`, `eps`, `giropay`, `ideal`, `multibanco`, `klarna`, `p24`, `sepa_debit`, `sofort`, `three_d_secure`, or `wechat`. An additional hash is included on the source with a name matching this value. It contains additional information specific to the [payment method](https://stripe.com/docs/sources) used.
    type-op: source-type-op-enum,
    /// Either `reusable` or `single_use`. Whether this source should be reusable or not. Some source types may or may not be reusable by construction, while others may leave the option at creation. If an incompatible value is passed, an error will be returned.
    usage: option<string>,
    wechat: option<source-type-wechat>
  }

  record source-type-ach-credit-transfer {
    account-number: option<string>,
    bank-name: option<string>,
    fingerprint: option<string>,
    refund-account-holder-name: option<string>,
    refund-account-holder-type: option<string>,
    refund-routing-number: option<string>,
    routing-number: option<string>,
    swift-code: option<string>
  }

  record source-type-ach-debit {
    bank-name: option<string>,
    country: option<string>,
    fingerprint: option<string>,
    last4: option<string>,
    routing-number: option<string>,
    type-op: option<string>
  }

  record source-type-acss-debit {
    bank-address-city: option<string>,
    bank-address-line-v1: option<string>,
    bank-address-line-v2: option<string>,
    bank-address-postal-code: option<string>,
    bank-name: option<string>,
    category: option<string>,
    country: option<string>,
    fingerprint: option<string>,
    last4: option<string>,
    routing-number: option<string>
  }

  record source-type-alipay {
    data-string: option<string>,
    native-url: option<string>,
    statement-descriptor: option<string>
  }

  record source-type-au-becs-debit {
    bsb-number: option<string>,
    fingerprint: option<string>,
    last4: option<string>
  }

  record source-type-bancontact {
    bank-code: option<string>,
    bank-name: option<string>,
    bic: option<string>,
    iban-last4: option<string>,
    preferred-language: option<string>,
    statement-descriptor: option<string>
  }

  record source-type-card {
    address-line1-check: option<string>,
    address-zip-check: option<string>,
    brand: option<string>,
    country: option<string>,
    cvc-check: option<string>,
    dynamic-last4: option<string>,
    exp-month: option<s32>,
    exp-year: option<s32>,
    fingerprint: option<string>,
    funding: option<string>,
    last4: option<string>,
    name: option<string>,
    three-d-secure: option<string>,
    tokenization-method: option<string>
  }

  record source-type-card-present {
    application-cryptogram: option<string>,
    application-preferred-name: option<string>,
    authorization-code: option<string>,
    authorization-response-code: option<string>,
    brand: option<string>,
    country: option<string>,
    cvm-type: option<string>,
    data-type: option<string>,
    dedicated-file-name: option<string>,
    emv-auth-data: option<string>,
    evidence-customer-signature: option<string>,
    evidence-transaction-certificate: option<string>,
    exp-month: option<s32>,
    exp-year: option<s32>,
    fingerprint: option<string>,
    funding: option<string>,
    last4: option<string>,
    pos-device-id: option<string>,
    pos-entry-mode: option<string>,
    read-method: option<string>,
    reader: option<string>,
    terminal-verification-results: option<string>,
    transaction-status-information: option<string>
  }

  record source-code-verification-flow {
    /// The number of attempts remaining to authenticate the source object with a verification code.
    attempts-remaining: s32,
    /// The status of the code verification, either `pending` (awaiting verification, `attempts_remaining` should be greater than 0), `succeeded` (successful verification) or `failed` (failed verification, cannot be verified anymore as `attempts_remaining` should be 0).
    status: string
  }

  record source-type-eps {
    reference: option<string>,
    statement-descriptor: option<string>
  }

  record source-type-giropay {
    bank-code: option<string>,
    bank-name: option<string>,
    bic: option<string>,
    statement-descriptor: option<string>
  }

  record source-type-ideal {
    bank: option<string>,
    bic: option<string>,
    iban-last4: option<string>,
    statement-descriptor: option<string>
  }

  record source-type-klarna {
    background-image-url: option<string>,
    client-token: option<string>,
    first-name: option<string>,
    last-name: option<string>,
    locale: option<string>,
    logo-url: option<string>,
    page-title: option<string>,
    pay-later-asset-urls-descriptive: option<string>,
    pay-later-asset-urls-standard: option<string>,
    pay-later-name: option<string>,
    pay-later-redirect-url: option<string>,
    pay-now-asset-urls-descriptive: option<string>,
    pay-now-asset-urls-standard: option<string>,
    pay-now-name: option<string>,
    pay-now-redirect-url: option<string>,
    pay-over-time-asset-urls-descriptive: option<string>,
    pay-over-time-asset-urls-standard: option<string>,
    pay-over-time-name: option<string>,
    pay-over-time-redirect-url: option<string>,
    payment-method-categories: option<string>,
    purchase-country: option<string>,
    purchase-type: option<string>,
    redirect-url: option<string>,
    shipping-delay: option<s32>,
    shipping-first-name: option<string>,
    shipping-last-name: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record source-metadata-entry {
    key: string,
    value: string
  }

  record source-type-multibanco {
    entity: option<string>,
    reference: option<string>,
    refund-account-holder-address-city: option<string>,
    refund-account-holder-address-country: option<string>,
    refund-account-holder-address-line1: option<string>,
    refund-account-holder-address-line2: option<string>,
    refund-account-holder-address-postal-code: option<string>,
    refund-account-holder-address-state: option<string>,
    refund-account-holder-name: option<string>,
    refund-iban: option<string>
  }

  record source-type-p24 {
    reference: option<string>
  }

  record source-receiver-flow {
    /// The address of the receiver source. This is the value that should be communicated to the customer to send their funds to.
    address: option<string>,
    /// The total amount that was moved to your balance. This is almost always equal to the amount charged. In rare cases when customers deposit excess funds and we are unable to refund those, those funds get moved to your balance and show up in amount_charged as well. The amount charged is expressed in the source's currency.
    amount-charged: s32,
    /// The total amount received by the receiver source. `amount_received = amount_returned + amount_charged` should be true for consumed sources unless customers deposit excess funds. The amount received is expressed in the source's currency.
    amount-received: s32,
    /// The total amount that was returned to the customer. The amount returned is expressed in the source's currency.
    amount-returned: s32,
    /// Type of refund attribute method, one of `email`, `manual`, or `none`.
    refund-attributes-method: string,
    /// Type of refund attribute status, one of `missing`, `requested`, or `available`.
    refund-attributes-status: string
  }

  record source-redirect-flow {
    /// The failure reason for the redirect, either `user_abort` (the customer aborted or dropped out of the redirect flow), `declined` (the authentication failed or the transaction was declined), or `processing_error` (the redirect failed due to a technical error). Present only if the redirect status is `failed`.
    failure-reason: option<string>,
    /// The URL you provide to redirect the customer to after they authenticated their payment.
    return-url: string,
    /// The status of the redirect, either `pending` (ready to be used by your customer to authenticate the transaction), `succeeded` (succesful authentication, cannot be reused) or `not_required` (redirect should not be used) or `failed` (failed authentication, cannot be reused).
    status: string,
    /// The URL provided to you to redirect a customer to as part of a `redirect` authentication flow.
    url: string
  }

  record source-type-sepa-debit {
    bank-code: option<string>,
    branch-code: option<string>,
    country: option<string>,
    fingerprint: option<string>,
    last4: option<string>,
    mandate-reference: option<string>,
    mandate-url: option<string>
  }

  record source-type-sofort {
    bank-code: option<string>,
    bank-name: option<string>,
    bic: option<string>,
    country: option<string>,
    iban-last4: option<string>,
    preferred-language: option<string>,
    statement-descriptor: option<string>
  }

  record source-order {
    /// A positive integer in the smallest currency unit (that is, 100 cents for $1.00, or 1 for ¥1, Japanese Yen being a zero-decimal currency) representing the total amount for the order.
    amount: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// The email address of the customer placing the order.
    email: option<string>,
    /// List of items constituting the order.
    items: option<list<source-order-item>>,
    shipping: option<shipping>
  }

  record source-order-item {
    /// The amount (price) for this order item.
    amount: option<s32>,
    /// This currency of this order item. Required when `amount` is present.
    currency: option<string>,
    /// Human-readable description for this order item.
    description: option<string>,
    /// The ID of the associated object for this line item. Expandable if not null (e.g., expandable to a SKU).
    parent: option<string>,
    /// The quantity of this order item. When type is `sku`, this is the number of instances of the SKU to be ordered.
    quantity: option<s32>,
    /// The type of this order item. Must be `sku`, `tax`, or `shipping`.
    type-op: option<string>
  }

  record shipping {
    address: option<address>,
    /// The delivery service that shipped a physical product, such as Fedex, UPS, USPS, etc.
    carrier: option<string>,
    /// Recipient name.
    name: option<string>,
    /// Recipient phone (including extension).
    phone: option<string>,
    /// The tracking number for a physical product, obtained from the delivery service. If multiple tracking numbers were generated for this purchase, please separate them with commas.
    tracking-number: option<string>
  }

  record address {
    /// City, district, suburb, town, or village.
    city: option<string>,
    /// Two-letter country code ([ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)).
    country: option<string>,
    /// Address line 1 (e.g., street, PO Box, or company name).
    line1: option<string>,
    /// Address line 2 (e.g., apartment, suite, unit, or building).
    line2: option<string>,
    /// ZIP or postal code.
    postal-code: option<string>,
    /// State, county, province, or region.
    state: option<string>
  }

  record source-type-three-d-secure {
    address-line1-check: option<string>,
    address-zip-check: option<string>,
    authenticated: option<bool>,
    brand: option<string>,
    card: option<string>,
    country: option<string>,
    customer: option<string>,
    cvc-check: option<string>,
    dynamic-last4: option<string>,
    exp-month: option<s32>,
    exp-year: option<s32>,
    fingerprint: option<string>,
    funding: option<string>,
    last4: option<string>,
    name: option<string>,
    three-d-secure: option<string>,
    tokenization-method: option<string>
  }

  record source-type-wechat {
    prepay-id: option<string>,
    qr-code-url: option<string>,
    statement-descriptor: option<string>
  }

  /// Information about a mandate possibility attached to a source object (generally for bank debits) as well as its acceptance status.
  record post-sources-source-body-mandate {
    acceptance: option<post-sources-source-body-mandate-acceptance>,
    amount: option<string>,
    currency: option<string>,
    interval: option<post-sources-body-mandate-interval-enum>,
    notification-method: option<post-sources-body-mandate-notification-method-enum>
  }

  record post-sources-source-body-mandate-acceptance {
    date: option<s32>,
    ip: option<string>,
    offline: option<post-sources-source-body-mandate-acceptance-offline>,
    online: option<post-sources-source-body-mandate-acceptance-online>,
    status: post-sources-body-mandate-acceptance-status-enum,
    type-op: option<post-sources-body-mandate-acceptance-type-op-enum>,
    user-agent: option<string>
  }

  record post-sources-source-body-mandate-acceptance-offline {
    contact-email: string
  }

  record post-sources-source-body-mandate-acceptance-online {
    date: option<s32>,
    ip: option<string>,
    user-agent: option<string>
  }

  /// Information about the owner of the payment instrument that may be used or required by particular source types.
  record post-sources-source-body-owner {
    address: option<post-sources-source-body-owner-address>,
    email: option<string>,
    name: option<string>,
    phone: option<string>
  }

  record post-sources-source-body-owner-address {
    city: option<string>,
    country: option<string>,
    line1: option<string>,
    line2: option<string>,
    postal-code: option<string>,
    state: option<string>
  }

  /// Information about the items and shipping associated with the source. Required for transactional credit (for example Klarna) sources before you can charge it.
  record post-sources-source-body-source-order {
    items: option<list<post-sources-source-body-source-order-items-item>>,
    shipping: option<post-sources-source-body-source-order-shipping>
  }

  record post-sources-source-body-source-order-items-item {
    amount: option<s32>,
    currency: option<string>,
    description: option<string>,
    parent: option<string>,
    quantity: option<s32>,
    type-op: option<post-sources-body-source-order-items-item-type-op-enum>
  }

  record post-sources-source-body-source-order-shipping {
    address: post-sources-source-body-source-order-shipping-address,
    carrier: option<string>,
    name: option<string>,
    phone: option<string>,
    tracking-number: option<string>
  }

  record post-sources-source-body-source-order-shipping-address {
    city: option<string>,
    country: option<string>,
    line1: string,
    line2: option<string>,
    postal-code: option<string>,
    state: option<string>
  }

  /// Source mandate notifications should be created when a notification related to
  /// a source mandate must be sent to the payer. They will trigger a webhook or
  /// deliver an email to the customer.
  record source-mandate-notification {
    acss-debit: option<source-mandate-notification-acss-debit-data>,
    /// A positive integer in the smallest currency unit (that is, 100 cents for $1.00, or 1 for ¥1, Japanese Yen being a zero-decimal currency) representing the amount associated with the mandate notification. The amount is expressed in the currency of the underlying source. Required if the notification type is `debit_initiated`.
    amount: option<s32>,
    bacs-debit: option<source-mandate-notification-bacs-debit-data>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: source-mandate-notification-object-enum,
    /// The reason of the mandate notification. Valid reasons are `mandate_confirmed` or `debit_initiated`.
    reason: string,
    sepa-debit: option<source-mandate-notification-sepa-debit-data>,
    source: source,
    /// The status of the mandate notification. Valid statuses are `pending` or `submitted`.
    status: string,
    /// The type of source this mandate notification is attached to. Should be the source type identifier code for the payment method, such as `three_d_secure`.
    type-op: string
  }

  record source-mandate-notification-acss-debit-data {
    /// The statement descriptor associate with the debit.
    statement-descriptor: option<string>
  }

  record source-mandate-notification-bacs-debit-data {
    /// Last 4 digits of the account number associated with the debit.
    last4: option<string>
  }

  record source-mandate-notification-sepa-debit-data {
    /// SEPA creditor ID.
    creditor-identifier: option<string>,
    /// Last 4 digits of the account number associated with the debit.
    last4: option<string>,
    /// Mandate reference associated with the debit.
    mandate-reference: option<string>
  }

  record get-sources-source-source-transactions-response {
    data: list<source-transaction>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-sources-source-source-transactions-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Some payment methods have no required amount that a customer must send.
  /// Customers can be instructed to send any amount, and it can be made up of
  /// multiple transactions. As such, sources can have multiple associated
  /// transactions.
  record source-transaction {
    ach-credit-transfer: option<source-transaction-ach-credit-transfer-data>,
    /// A positive integer in the smallest currency unit (that is, 100 cents for $1.00, or 1 for ¥1, Japanese Yen being a zero-decimal currency) representing the amount your customer has pushed to the receiver.
    amount: s32,
    chf-credit-transfer: option<source-transaction-chf-credit-transfer-data>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    gbp-credit-transfer: option<source-transaction-gbp-credit-transfer-data>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: source-transaction-object-enum,
    paper-check: option<source-transaction-paper-check-data>,
    sepa-credit-transfer: option<source-transaction-sepa-credit-transfer-data>,
    /// The ID of the source this transaction is attached to.
    source: string,
    /// The status of the transaction, one of `succeeded`, `pending`, or `failed`.
    status: string,
    /// The type of source this transaction is attached to.
    type-op: source-transaction-type-op-enum
  }

  record source-transaction-ach-credit-transfer-data {
    /// Customer data associated with the transfer.
    customer-data: option<string>,
    /// Bank account fingerprint associated with the transfer.
    fingerprint: option<string>,
    /// Last 4 digits of the account number associated with the transfer.
    last4: option<string>,
    /// Routing number associated with the transfer.
    routing-number: option<string>
  }

  record source-transaction-chf-credit-transfer-data {
    /// Reference associated with the transfer.
    reference: option<string>,
    /// Sender's country address.
    sender-address-country: option<string>,
    /// Sender's line 1 address.
    sender-address-line1: option<string>,
    /// Sender's bank account IBAN.
    sender-iban: option<string>,
    /// Sender's name.
    sender-name: option<string>
  }

  record source-transaction-gbp-credit-transfer-data {
    /// Bank account fingerprint associated with the Stripe owned bank account receiving the transfer.
    fingerprint: option<string>,
    /// The credit transfer rails the sender used to push this transfer. The possible rails are: Faster Payments, BACS, CHAPS, and wire transfers. Currently only Faster Payments is supported.
    funding-method: option<string>,
    /// Last 4 digits of sender account number associated with the transfer.
    last4: option<string>,
    /// Sender entered arbitrary information about the transfer.
    reference: option<string>,
    /// Sender account number associated with the transfer.
    sender-account-number: option<string>,
    /// Sender name associated with the transfer.
    sender-name: option<string>,
    /// Sender sort code associated with the transfer.
    sender-sort-code: option<string>
  }

  record source-transaction-paper-check-data {
    /// Time at which the deposited funds will be available for use. Measured in seconds since the Unix epoch.
    available-at: option<string>,
    /// Comma-separated list of invoice IDs associated with the paper check.
    invoices: option<string>
  }

  record source-transaction-sepa-credit-transfer-data {
    /// Reference associated with the transfer.
    reference: option<string>,
    /// Sender's bank account IBAN.
    sender-iban: option<string>,
    /// Sender's name.
    sender-name: option<string>
  }

  record post-sources-params {
    /// Amount associated with the source. This is the amount for which the source will be chargeable once ready. Required for `single_use` sources. Not supported for `receiver` type sources, where charge amount may not be specified until funds land.
    amount: option<s32>,
    /// Three-letter [ISO code for the currency](https://stripe.com/docs/currencies) associated with the source. This is the currency for which the source will be chargeable once ready.
    currency: option<string>,
    /// The `Customer` to whom the original source is attached to. Must be set when the original source is not a `Source` (e.g., `Card`).
    customer: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// The authentication `flow` of the source to create. `flow` is one of `redirect`, `receiver`, `code_verification`, `none`. It is generally inferred unless a type supports multiple flows.
    flow: option<post-sources-body-flow-enum>,
    /// Information about a mandate possibility attached to a source object (generally for bank debits) as well as its acceptance status.
    mandate: option<post-sources-body-mandate>,
    metadata: option<list<post-sources-body-metadata-entry>>,
    /// The source to share.
    original-source: option<string>,
    /// Information about the owner of the payment instrument that may be used or required by particular source types.
    owner: option<post-sources-body-owner>,
    /// Optional parameters for the receiver flow. Can be set only if the source is a receiver (`flow` is `receiver`).
    receiver: option<post-sources-body-receiver>,
    /// Parameters required for the redirect flow. Required if the source is authenticated by a redirect (`flow` is `redirect`).
    redirect: option<post-sources-body-redirect>,
    /// Information about the items and shipping associated with the source. Required for transactional credit (for example Klarna) sources before you can charge it.
    source-order: option<post-sources-body-source-order>,
    /// An arbitrary string to be displayed on your customer's statement. As an example, if your website is `RunClub` and the item you're charging for is a race ticket, you may want to specify a `statement_descriptor` of `RunClub 5K race ticket.` While many payment types will display this information, some may not display it at all.
    statement-descriptor: option<string>,
    /// An optional token used to create the source. When passed, token properties will override source parameters.
    token: option<string>,
    /// The `type` of the source to create. Required unless `customer` and `original_source` are specified (see the [Cloning card Sources](https://stripe.com/docs/sources/connect#cloning-card-sources) guide)
    type-op: option<string>,
    usage: option<post-sources-body-usage-enum>
  }
  post-sources: func(params: post-sources-params) -> result<source, string>;

  record get-sources-source-params {
    /// The client secret of the source. Required if a publishable key is used to retrieve the source.
    client-secret: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    source: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-sources-source: func(params: get-sources-source-params) -> result<source, string>;

  record post-sources-source-params {
    source: string,
    /// Amount associated with the source.
    amount: option<s32>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Information about a mandate possibility attached to a source object (generally for bank debits) as well as its acceptance status.
    mandate: option<post-sources-source-body-mandate>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// Information about the owner of the payment instrument that may be used or required by particular source types.
    owner: option<post-sources-source-body-owner>,
    /// Information about the items and shipping associated with the source. Required for transactional credit (for example Klarna) sources before you can charge it.
    source-order: option<post-sources-source-body-source-order>
  }
  post-sources-source: func(params: post-sources-source-params) -> result<source, string>;

  record get-sources-source-mandate-notifications-mandate-notification-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    mandate-notification: string,
    source: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-sources-source-mandate-notifications-mandate-notification: func(params: get-sources-source-mandate-notifications-mandate-notification-params) -> result<source-mandate-notification, string>;

  record get-sources-source-source-transactions-params {
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    source: string,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-sources-source-source-transactions: func(params: get-sources-source-source-transactions-params) -> result<get-sources-source-source-transactions-response, string>;

  record get-sources-source-source-transactions-source-transaction-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    source: string,
    source-transaction: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-sources-source-source-transactions-source-transaction: func(params: get-sources-source-source-transactions-source-transaction-params) -> result<source-transaction, string>;

  record post-sources-source-verify-params {
    source: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// The values needed to verify the source.
    values: list<string>
  }
  post-sources-source-verify: func(params: post-sources-source-verify-params) -> result<source, string>;

}

interface subscription-items {
  enum subscription-item-object-enum {
    subscription-item,
  }

  enum price-billing-scheme-enum {
    per-unit,
    tiered,
  }

  enum currency-option-tax-behavior-enum {
    exclusive,
    inclusive,
    unspecified,
  }

  enum price-object-enum {
    price,
  }

  enum price-tiers-mode-enum {
    graduated,
    volume,
  }

  enum price-type-op-enum {
    one-time,
    recurring,
  }

  enum tax-rate-object-enum {
    tax-rate,
  }

  enum tax-rate-tax-type-enum {
    gst,
    hst,
    igst,
    jct,
    lease-tax,
    pst,
    qst,
    rst,
    sales-tax,
    vat,
  }

  enum get-subscription-items-response-object-enum {
    list-op,
  }

  enum post-subscription-items-body-payment-behavior-enum {
    allow-incomplete,
    default-incomplete,
    error-if-incomplete,
    pending-if-incomplete,
  }

  enum post-subscription-items-body-price-data-recurring-interval-enum {
    day,
    month,
    week,
    year,
  }

  enum post-subscription-items-body-proration-behavior-enum {
    always-invoice,
    create-prorations,
    none,
  }

  enum usage-record-summary-object-enum {
    usage-record-summary,
  }

  enum post-subscription-items-subscription-item-usage-records-body-action-enum {
    increment,
    set,
  }

  enum usage-record-object-enum {
    usage-record,
  }

  record get-subscription-items-response {
    data: list<subscription-item>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-subscription-items-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Subscription items allow you to create customer subscriptions with more than
  /// one plan, making it easy to represent complex billing relationships.
  record subscription-item {
    /// Define thresholds at which an invoice will be sent, and the related subscription advanced to a new billing period
    billing-thresholds: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Unique identifier for the object.
    id: string,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<subscription-item-metadata-entry>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: subscription-item-object-enum,
    price: price,
    /// The [quantity](https://stripe.com/docs/subscriptions/quantities) of the plan to which the customer should be subscribed.
    quantity: option<s32>,
    /// The `subscription` this `subscription_item` belongs to.
    subscription: string,
    /// The tax rates which apply to this `subscription_item`. When set, the `default_tax_rates` on the subscription do not apply to this `subscription_item`.
    tax-rates: option<list<tax-rate>>
  }

  /// one entry of a string-keyed map (free-form object)
  record subscription-item-metadata-entry {
    key: string,
    value: string
  }

  /// Prices define the unit cost, currency, and (optional) billing cycle for both recurring and one-time purchases of products.
  /// [Products](https://stripe.com/docs/api#products) help you track inventory or provisioning, and prices help you track payment terms. Different physical goods or levels of service should be represented by products, and pricing options should be represented by prices. This approach lets you change prices without having to change your provisioning scheme.
  /// 
  /// For example, you might have a single "gold" product that has prices for $10/month, $100/year, and €9 once.
  /// 
  /// Related guides: [Set up a subscription](https://stripe.com/docs/billing/subscriptions/set-up-subscription), [create an invoice](https://stripe.com/docs/billing/invoices/create), and more about [products and prices](https://stripe.com/docs/products-prices/overview).
  record price {
    /// Whether the price can be used for new purchases.
    active: bool,
    /// Describes how to compute the price per period. Either `per_unit` or `tiered`. `per_unit` indicates that the fixed amount (specified in `unit_amount` or `unit_amount_decimal`) will be charged per unit in `quantity` (for prices with `usage_type=licensed`), or per unit of total usage (for prices with `usage_type=metered`). `tiered` indicates that the unit pricing will be computed using a tiering strategy as defined using the `tiers` and `tiers_mode` attributes.
    billing-scheme: price-billing-scheme-enum,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// Prices defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<price-currency-options-entry>>,
    /// When set, provides configuration for the amount to be adjusted by the customer during Checkout Sessions and Payment Links.
    custom-unit-amount: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// A lookup key used to retrieve prices dynamically from a static string. This may be up to 200 characters.
    lookup-key: option<string>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<price-metadata-entry>,
    /// A brief description of the price, hidden from customers.
    nickname: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: price-object-enum,
    /// The ID of the product this price is associated with.
    product: string,
    /// The recurring components of a price such as `interval` and `usage_type`.
    recurring: option<string>,
    /// Only required if a [default tax behavior](https://stripe.com/docs/tax/products-prices-tax-categories-tax-behavior#setting-a-default-tax-behavior-(recommended)) was not provided in the Stripe Tax settings. Specifies whether the price is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`. Once specified as either `inclusive` or `exclusive`, it cannot be changed.
    tax-behavior: option<currency-option-tax-behavior-enum>,
    /// Each element represents a pricing tier. This parameter requires `billing_scheme` to be set to `tiered`. See also the documentation for `billing_scheme`.
    tiers: option<list<price-tier>>,
    /// Defines if the tiering price should be `graduated` or `volume` based. In `volume`-based tiering, the maximum quantity within a period determines the per unit price. In `graduated` tiering, pricing can change as the quantity grows.
    tiers-mode: option<price-tiers-mode-enum>,
    /// Apply a transformation to the reported usage or set quantity before computing the amount billed. Cannot be combined with `tiers`.
    transform-quantity: option<string>,
    /// One of `one_time` or `recurring` depending on whether the price is for a one-time purchase or a recurring (subscription) purchase.
    type-op: price-type-op-enum,
    /// The unit amount in %s to be charged, represented as a whole integer if possible. Only set if `billing_scheme=per_unit`.
    unit-amount: option<s32>,
    /// The unit amount in %s to be charged, represented as a decimal string with at most 12 decimal places. Only set if `billing_scheme=per_unit`.
    unit-amount-decimal: option<string>
  }

  record currency-option {
    /// When set, provides configuration for the amount to be adjusted by the customer during Checkout Sessions and Payment Links.
    custom-unit-amount: option<string>,
    /// Only required if a [default tax behavior](https://stripe.com/docs/tax/products-prices-tax-categories-tax-behavior#setting-a-default-tax-behavior-(recommended)) was not provided in the Stripe Tax settings. Specifies whether the price is considered inclusive of taxes or exclusive of taxes. One of `inclusive`, `exclusive`, or `unspecified`. Once specified as either `inclusive` or `exclusive`, it cannot be changed.
    tax-behavior: option<currency-option-tax-behavior-enum>,
    /// Each element represents a pricing tier. This parameter requires `billing_scheme` to be set to `tiered`. See also the documentation for `billing_scheme`.
    tiers: option<list<price-tier>>,
    /// The unit amount in %s to be charged, represented as a whole integer if possible. Only set if `billing_scheme=per_unit`.
    unit-amount: option<s32>,
    /// The unit amount in %s to be charged, represented as a decimal string with at most 12 decimal places. Only set if `billing_scheme=per_unit`.
    unit-amount-decimal: option<string>
  }

  record price-tier {
    /// Price for the entire tier.
    flat-amount: option<s32>,
    /// Same as `flat_amount`, but contains a decimal value with at most 12 decimal places.
    flat-amount-decimal: option<string>,
    /// Per unit price for units relevant to the tier.
    unit-amount: option<s32>,
    /// Same as `unit_amount`, but contains a decimal value with at most 12 decimal places.
    unit-amount-decimal: option<string>,
    /// Up to and including to this quantity will be contained in the tier.
    up-to: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record price-currency-options-entry {
    key: string,
    value: currency-option
  }

  /// one entry of a string-keyed map (free-form object)
  record price-metadata-entry {
    key: string,
    value: string
  }

  /// Tax rates can be applied to [invoices](https://stripe.com/docs/billing/invoices/tax-rates), [subscriptions](https://stripe.com/docs/billing/subscriptions/taxes) and [Checkout Sessions](https://stripe.com/docs/payments/checkout/set-up-a-subscription#tax-rates) to collect tax.
  /// 
  /// Related guide: [Tax Rates](https://stripe.com/docs/billing/taxes/tax-rates).
  record tax-rate {
    /// Defaults to `true`. When set to `false`, this tax rate cannot be used with new applications or Checkout Sessions, but will still work for subscriptions and invoices that already have it set.
    active: bool,
    /// Two-letter country code ([ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)).
    country: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// An arbitrary string attached to the tax rate for your internal use only. It will not be visible to your customers.
    description: option<string>,
    /// The display name of the tax rates as it will appear to your customer on their receipt email, PDF, and the hosted invoice page.
    display-name: string,
    /// Unique identifier for the object.
    id: string,
    /// This specifies if the tax rate is inclusive or exclusive.
    inclusive: bool,
    /// The jurisdiction for the tax rate. You can use this label field for tax reporting purposes. It also appears on your customer’s invoice.
    jurisdiction: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<tax-rate-metadata-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: tax-rate-object-enum,
    /// This represents the tax rate percent out of 100.
    percentage: f64,
    /// [ISO 3166-2 subdivision code](https://en.wikipedia.org/wiki/ISO_3166-2:US), without country prefix. For example, "NY" for New York, United States.
    state: option<string>,
    /// The high-level tax type, such as `vat` or `sales_tax`.
    tax-type: option<tax-rate-tax-type-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record tax-rate-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-subscription-items-body-metadata-entry {
    key: string,
    value: string
  }

  /// Data used to generate a new [Price](https://stripe.com/docs/api/prices) object inline.
  record post-subscription-items-body-price-data {
    currency: string,
    product: string,
    recurring: post-subscription-items-body-price-data-recurring,
    tax-behavior: option<currency-option-tax-behavior-enum>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>
  }

  record post-subscription-items-body-price-data-recurring {
    interval: post-subscription-items-body-price-data-recurring-interval-enum,
    interval-count: option<s32>
  }

  /// Data used to generate a new [Price](https://stripe.com/docs/api/prices) object inline.
  record post-subscription-items-item-body-price-data {
    currency: string,
    product: string,
    recurring: post-subscription-items-item-body-price-data-recurring,
    tax-behavior: option<currency-option-tax-behavior-enum>,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>
  }

  record post-subscription-items-item-body-price-data-recurring {
    interval: post-subscription-items-body-price-data-recurring-interval-enum,
    interval-count: option<s32>
  }

  record deleted-subscription-item {
    /// Always true for a deleted object
    deleted: bool,
    /// Unique identifier for the object.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: subscription-item-object-enum
  }

  record get-subscription-items-subscription-item-usage-record-summaries-response {
    data: list<usage-record-summary>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-subscription-items-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  record usage-record-summary {
    /// Unique identifier for the object.
    id: string,
    /// The invoice in which this usage period has been billed for.
    invoice: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: usage-record-summary-object-enum,
    period: period,
    /// The ID of the subscription item this summary is describing.
    subscription-item: string,
    /// The total usage within this usage period.
    total-usage: s32
  }

  record period {
    /// The end date of this usage period. All usage up to and including this point in time is included.
    end: option<s32>,
    /// The start date of this usage period. All usage after this point in time is included.
    start: option<s32>
  }

  /// Usage records allow you to report customer usage and metrics to Stripe for
  /// metered billing of subscription prices.
  /// 
  /// Related guide: [Metered Billing](https://stripe.com/docs/billing/subscriptions/metered-billing).
  record usage-record {
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: usage-record-object-enum,
    /// The usage quantity for the specified date.
    quantity: s32,
    /// The ID of the subscription item this usage record contains data for.
    subscription-item: string,
    /// The timestamp when this usage occurred.
    timestamp: s32
  }

  record get-subscription-items-params {
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// The ID of the subscription whose items will be retrieved.
    subscription: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-subscription-items: func(params: get-subscription-items-params) -> result<get-subscription-items-response, string>;

  record post-subscription-items-params {
    /// Define thresholds at which an invoice will be sent, and the subscription advanced to a new billing period. When updating, pass an empty string to remove previously-defined thresholds.
    billing-thresholds: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-subscription-items-body-metadata-entry>>,
    /// Use `allow_incomplete` to transition the subscription to `status=past_due` if a payment is required but cannot be paid. This allows you to manage scenarios where additional user actions are needed to pay a subscription's invoice. For example, SCA regulation may require 3DS authentication to complete payment. See the [SCA Migration Guide](https://stripe.com/docs/billing/migration/strong-customer-authentication) for Billing to learn more. This is the default behavior.
    /// 
    payment-behavior: option<post-subscription-items-body-payment-behavior-enum>,
    /// The ID of the price object.
    price: option<string>,
    /// Data used to generate a new [Price](https://stripe.com/docs/api/prices) object inline.
    price-data: option<post-subscription-items-body-price-data>,
    /// Determines how to handle [prorations](https://stripe.com/docs/subscriptions/billing-cycle#prorations) when the billing cycle changes (e.g., when switching plans, resetting `billing_cycle_anchor=now`, or starting a trial), or if an item's `quantity` changes. The default value is `create_prorations`.
    proration-behavior: option<post-subscription-items-body-proration-behavior-enum>,
    /// If set, the proration will be calculated as though the subscription was updated at the given time. This can be used to apply the same proration that was previewed with the [upcoming invoice](https://stripe.com/docs/api#retrieve_customer_invoice) endpoint.
    proration-date: option<s32>,
    /// The quantity you'd like to apply to the subscription item you're creating.
    quantity: option<s32>,
    /// The identifier of the subscription to modify.
    subscription: string,
    /// A list of [Tax Rate](https://stripe.com/docs/api/tax_rates) ids. These Tax Rates will override the [`default_tax_rates`](https://stripe.com/docs/api/subscriptions/create#create_subscription-default_tax_rates) on the Subscription. When updating, pass an empty string to remove previously-defined tax rates.
    tax-rates: option<string>
  }
  post-subscription-items: func(params: post-subscription-items-params) -> result<subscription-item, string>;

  record get-subscription-items-item-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    item: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-subscription-items-item: func(params: get-subscription-items-item-params) -> result<subscription-item, string>;

  record post-subscription-items-item-params {
    item: string,
    /// Define thresholds at which an invoice will be sent, and the subscription advanced to a new billing period. When updating, pass an empty string to remove previously-defined thresholds.
    billing-thresholds: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// Indicates if a customer is on or off-session while an invoice payment is attempted.
    off-session: option<bool>,
    /// Use `allow_incomplete` to transition the subscription to `status=past_due` if a payment is required but cannot be paid. This allows you to manage scenarios where additional user actions are needed to pay a subscription's invoice. For example, SCA regulation may require 3DS authentication to complete payment. See the [SCA Migration Guide](https://stripe.com/docs/billing/migration/strong-customer-authentication) for Billing to learn more. This is the default behavior.
    /// 
    payment-behavior: option<post-subscription-items-body-payment-behavior-enum>,
    /// The ID of the price object. When changing a subscription item's price, `quantity` is set to 1 unless a `quantity` parameter is provided.
    price: option<string>,
    /// Data used to generate a new [Price](https://stripe.com/docs/api/prices) object inline.
    price-data: option<post-subscription-items-item-body-price-data>,
    /// Determines how to handle [prorations](https://stripe.com/docs/subscriptions/billing-cycle#prorations) when the billing cycle changes (e.g., when switching plans, resetting `billing_cycle_anchor=now`, or starting a trial), or if an item's `quantity` changes. The default value is `create_prorations`.
    proration-behavior: option<post-subscription-items-body-proration-behavior-enum>,
    /// If set, the proration will be calculated as though the subscription was updated at the given time. This can be used to apply the same proration that was previewed with the [upcoming invoice](https://stripe.com/docs/api#retrieve_customer_invoice) endpoint.
    proration-date: option<s32>,
    /// The quantity you'd like to apply to the subscription item you're creating.
    quantity: option<s32>,
    /// A list of [Tax Rate](https://stripe.com/docs/api/tax_rates) ids. These Tax Rates will override the [`default_tax_rates`](https://stripe.com/docs/api/subscriptions/create#create_subscription-default_tax_rates) on the Subscription. When updating, pass an empty string to remove previously-defined tax rates.
    tax-rates: option<string>
  }
  post-subscription-items-item: func(params: post-subscription-items-item-params) -> result<subscription-item, string>;

  record delete-subscription-items-item-params {
    item: string,
    /// Delete all usage for the given subscription item. Allowed only when the current plan's `usage_type` is `metered`.
    clear-usage: option<bool>,
    /// Determines how to handle [prorations](https://stripe.com/docs/subscriptions/billing-cycle#prorations) when the billing cycle changes (e.g., when switching plans, resetting `billing_cycle_anchor=now`, or starting a trial), or if an item's `quantity` changes. The default value is `create_prorations`.
    proration-behavior: option<post-subscription-items-body-proration-behavior-enum>,
    /// If set, the proration will be calculated as though the subscription was updated at the given time. This can be used to apply the same proration that was previewed with the [upcoming invoice](https://stripe.com/docs/api#retrieve_customer_invoice) endpoint.
    proration-date: option<s32>
  }
  delete-subscription-items-item: func(params: delete-subscription-items-item-params) -> result<deleted-subscription-item, string>;

  record get-subscription-items-subscription-item-usage-record-summaries-params {
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    subscription-item: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-subscription-items-subscription-item-usage-record-summaries: func(params: get-subscription-items-subscription-item-usage-record-summaries-params) -> result<get-subscription-items-subscription-item-usage-record-summaries-response, string>;

  record post-subscription-items-subscription-item-usage-records-params {
    subscription-item: string,
    /// Valid values are `increment` (default) or `set`. When using `increment` the specified `quantity` will be added to the usage at the specified timestamp. The `set` action will overwrite the usage quantity at that timestamp. If the subscription has [billing thresholds](https://stripe.com/docs/api/subscriptions/object#subscription_object-billing_thresholds), `increment` is the only allowed value.
    action: option<post-subscription-items-subscription-item-usage-records-body-action-enum>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// The usage quantity for the specified timestamp.
    quantity: s32,
    /// The timestamp for the usage event. This timestamp must be within the current billing period of the subscription of the provided `subscription_item`, and must not be in the future. When passing `"now"`, Stripe records usage for the current time. Default is `"now"` if a value is not provided.
    timestamp: option<string>
  }
  post-subscription-items-subscription-item-usage-records: func(params: post-subscription-items-subscription-item-usage-records-params) -> result<usage-record, string>;

}

interface subscription-schedules {
  enum resource-default-settings-billing-cycle-anchor-enum {
    automatic,
    phase-start,
  }

  enum resource-default-settings-collection-method-enum {
    charge-automatically,
    send-invoice,
  }

  enum subscription-schedule-end-behavior-enum {
    cancel,
    none,
    release,
    renew,
  }

  enum subscription-schedule-object-enum {
    subscription-schedule,
  }

  enum tax-rate-object-enum {
    tax-rate,
  }

  enum tax-rate-tax-type-enum {
    gst,
    hst,
    igst,
    jct,
    lease-tax,
    pst,
    qst,
    rst,
    sales-tax,
    vat,
  }

  enum subscription-schedule-phase-configuration-proration-behavior-enum {
    always-invoice,
    create-prorations,
    none,
  }

  enum subscription-schedule-status-enum {
    active,
    canceled,
    completed,
    not-started,
    released,
  }

  enum get-subscription-schedules-response-object-enum {
    list-op,
  }

  enum post-subscription-schedules-body-phases-item-add-invoice-items-item-price-data-tax-behavior-enum {
    exclusive,
    inclusive,
    unspecified,
  }

  enum post-subscription-schedules-body-phases-item-items-item-price-data-recurring-interval-enum {
    day,
    month,
    week,
    year,
  }

  record get-subscription-schedules-response {
    data: list<subscription-schedule>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-subscription-schedules-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A subscription schedule allows you to create and manage the lifecycle of a subscription by predefining expected changes.
  /// 
  /// Related guide: [Subscription Schedules](https://stripe.com/docs/billing/subscriptions/subscription-schedules).
  record subscription-schedule {
    /// ID of the Connect Application that created the schedule.
    application: option<string>,
    /// Time at which the subscription schedule was canceled. Measured in seconds since the Unix epoch.
    canceled-at: option<s32>,
    /// Time at which the subscription schedule was completed. Measured in seconds since the Unix epoch.
    completed-at: option<s32>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Object representing the start and end dates for the current phase of the subscription schedule, if it is `active`.
    current-phase: option<string>,
    /// ID of the customer who owns the subscription schedule.
    customer: string,
    default-settings: resource-default-settings,
    /// Behavior of the subscription schedule and underlying subscription when it ends. Possible values are `release` or `cancel` with the default being `release`. `release` will end the subscription schedule and keep the underlying subscription running.`cancel` will end the subscription schedule and cancel the underlying subscription.
    end-behavior: subscription-schedule-end-behavior-enum,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<subscription-schedule-metadata-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: subscription-schedule-object-enum,
    /// Configuration for the subscription schedule's phases.
    phases: list<subscription-schedule-phase-configuration>,
    /// Time at which the subscription schedule was released. Measured in seconds since the Unix epoch.
    released-at: option<s32>,
    /// ID of the subscription once managed by the subscription schedule (if it is released).
    released-subscription: option<string>,
    /// The present status of the subscription schedule. Possible values are `not_started`, `active`, `completed`, `released`, and `canceled`. You can read more about the different states in our [behavior guide](https://stripe.com/docs/billing/subscriptions/subscription-schedules).
    status: subscription-schedule-status-enum,
    /// ID of the subscription managed by the subscription schedule.
    subscription: option<string>,
    /// ID of the test clock this subscription schedule belongs to.
    test-clock: option<string>
  }

  record resource-default-settings {
    /// A non-negative decimal between 0 and 100, with at most two decimal places. This represents the percentage of the subscription invoice subtotal that will be transferred to the application owner's Stripe account during this phase of the schedule.
    application-fee-percent: option<f64>,
    automatic-tax: option<resource-default-settings-automatic-tax>,
    /// Possible values are `phase_start` or `automatic`. If `phase_start` then billing cycle anchor of the subscription is set to the start of the phase when entering the phase. If `automatic` then the billing cycle anchor is automatically modified as needed when entering the phase. For more information, see the billing cycle [documentation](https://stripe.com/docs/billing/subscriptions/billing-cycle).
    billing-cycle-anchor: resource-default-settings-billing-cycle-anchor-enum,
    /// Define thresholds at which an invoice will be sent, and the subscription advanced to a new billing period
    billing-thresholds: option<string>,
    /// Either `charge_automatically`, or `send_invoice`. When charging automatically, Stripe will attempt to pay the underlying subscription at the end of each billing cycle using the default source attached to the customer. When sending an invoice, Stripe will email your customer an invoice with payment instructions and mark the subscription as `active`.
    collection-method: option<resource-default-settings-collection-method-enum>,
    /// ID of the default payment method for the subscription schedule. If not set, invoices will use the default payment method in the customer's invoice settings.
    default-payment-method: option<string>,
    /// Subscription description, meant to be displayable to the customer. Use this field to optionally store an explanation of the subscription.
    description: option<string>,
    /// The subscription schedule's default invoice settings.
    invoice-settings: option<string>,
    /// The account (if any) the charge was made on behalf of for charges associated with the schedule's subscription. See the Connect documentation for details.
    on-behalf-of: option<string>,
    /// The account (if any) the associated subscription's payments will be attributed to for tax reporting, and where funds from each payment will be transferred to for each of the subscription's invoices.
    transfer-data: option<string>
