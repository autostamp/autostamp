interface identity {
  enum get-identity-verification-reports-type-op-enum {
    document,
    id-number,
  }

  enum gelato-document-report-status-enum {
    unverified,
    verified,
  }

  enum gelato-document-report-type-op-enum {
    driving-license,
    id-card,
    passport,
  }

  enum gelato-id-number-report-id-number-type-enum {
    br-cpf,
    sg-nric,
    us-ssn,
  }

  enum verification-report-object-enum {
    identity-verification-report,
  }

  enum get-identity-verification-reports-response-object-enum {
    list-op,
  }

  enum get-identity-verification-sessions-status-enum {
    canceled,
    processing,
    requires-input,
    verified,
  }

  enum verification-session-object-enum {
    identity-verification-session,
  }

  record get-identity-verification-reports-response {
    data: list<verification-report>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-identity-verification-reports-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A VerificationReport is the result of an attempt to collect and verify data from a user.
  /// The collection of verification checks performed is determined from the `type` and `options`
  /// parameters used. You can find the result of each verification check performed in the
  /// appropriate sub-resource: `document`, `id_number`, `selfie`.
  /// 
  /// Each VerificationReport contains a copy of any data collected by the user as well as
  /// reference IDs which can be used to access collected images through the [FileUpload](https://stripe.com/docs/api/files)
  /// API. To configure and create VerificationReports, use the
  /// [VerificationSession](https://stripe.com/docs/api/identity/verification_sessions) API.
  /// 
  /// Related guides: [Accessing verification results](https://stripe.com/docs/identity/verification-sessions#results).
  record verification-report {
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    document: option<gelato-document-report>,
    /// Unique identifier for the object.
    id: string,
    id-number: option<gelato-id-number-report>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: verification-report-object-enum,
    options: option<gelato-verification-report-options>,
    selfie: option<gelato-selfie-report>,
    /// Type of report.
    type-op: option<get-identity-verification-reports-type-op-enum>,
    /// ID of the VerificationSession that created this report.
    verification-session: option<string>
  }

  /// Result from a document check
  record gelato-document-report {
    /// Address as it appears in the document.
    address: option<string>,
    /// Date of birth as it appears in the document.
    dob: option<string>,
    /// Details on the verification error. Present when status is `unverified`.
    error: option<string>,
    /// Expiration date of the document.
    expiration-date: option<string>,
    /// Array of [File](https://stripe.com/docs/api/files) ids containing images for this document.
    files: option<list<string>>,
    /// First name as it appears in the document.
    first-name: option<string>,
    /// Issued date of the document.
    issued-date: option<string>,
    /// Issuing country of the document.
    issuing-country: option<string>,
    /// Last name as it appears in the document.
    last-name: option<string>,
    /// Document ID number.
    number: option<string>,
    /// Status of this `document` check.
    status: gelato-document-report-status-enum,
    /// Type of the document.
    type-op: option<gelato-document-report-type-op-enum>
  }

  /// Result from an id_number check
  record gelato-id-number-report {
    /// Date of birth.
    dob: option<string>,
    /// Details on the verification error. Present when status is `unverified`.
    error: option<string>,
    /// First name.
    first-name: option<string>,
    /// ID number.
    id-number: option<string>,
    /// Type of ID number.
    id-number-type: option<gelato-id-number-report-id-number-type-enum>,
    /// Last name.
    last-name: option<string>,
    /// Status of this `id_number` check.
    status: gelato-document-report-status-enum
  }

  record gelato-verification-report-options {
    document: option<gelato-report-document-options>,
    id-number: option<list<gelato-report-id-number-options-entry>>
  }

  record gelato-report-document-options {
    /// Array of strings of allowed identity document types. If the provided identity document isn’t one of the allowed types, the verification check will fail with a document_type_not_allowed error code.
    allowed-types: option<list<gelato-document-report-type-op-enum>>,
    /// Collect an ID number and perform an [ID number check](https://stripe.com/docs/identity/verification-checks?type=id-number) with the document’s extracted name and date of birth.
    require-id-number: option<bool>,
    /// Disable image uploads, identity document images have to be captured using the device’s camera.
    require-live-capture: option<bool>,
    /// Capture a face image and perform a [selfie check](https://stripe.com/docs/identity/verification-checks?type=selfie) comparing a photo ID and a picture of your user’s face. [Learn more](https://stripe.com/docs/identity/selfie).
    require-matching-selfie: option<bool>
  }

  /// one entry of a string-keyed map (free-form object)
  record gelato-report-id-number-options-entry {
    key: string,
    value: string
  }

  /// Result from a selfie check
  record gelato-selfie-report {
    /// ID of the [File](https://stripe.com/docs/api/files) holding the image of the identity document used in this check.
    document: option<string>,
    /// Details on the verification error. Present when status is `unverified`.
    error: option<string>,
    /// ID of the [File](https://stripe.com/docs/api/files) holding the image of the selfie used in this check.
    selfie: option<string>,
    /// Status of this `selfie` check.
    status: gelato-document-report-status-enum
  }

  record get-identity-verification-sessions-response {
    data: list<verification-session>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-identity-verification-reports-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A VerificationSession guides you through the process of collecting and verifying the identities
  /// of your users. It contains details about the type of verification, such as what [verification
  /// check](/docs/identity/verification-checks) to perform. Only create one VerificationSession for
  /// each verification in your system.
  /// 
  /// A VerificationSession transitions through [multiple
  /// statuses](/docs/identity/how-sessions-work) throughout its lifetime as it progresses through
  /// the verification flow. The VerificationSession contains the user's verified data after
  /// verification checks are complete.
  /// 
  /// Related guide: [The Verification Sessions API](https://stripe.com/docs/identity/verification-sessions)
  record verification-session {
    /// The short-lived client secret used by Stripe.js to [show a verification modal](https://stripe.com/docs/js/identity/modal) inside your app. This client secret expires after 24 hours and can only be used once. Don’t store it, log it, embed it in a URL, or expose it to anyone other than the user. Make sure that you have TLS enabled on any page that includes the client secret. Refer to our docs on [passing the client secret to the frontend](https://stripe.com/docs/identity/verification-sessions#client-secret) to learn more.
    client-secret: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Unique identifier for the object.
    id: string,
    /// If present, this property tells you the last error encountered when processing the verification.
    last-error: option<string>,
    /// ID of the most recent VerificationReport. [Learn more about accessing detailed verification results.](https://stripe.com/docs/identity/verification-sessions#results)
    last-verification-report: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<verification-session-metadata-entry>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: verification-session-object-enum,
    /// A set of options for the session’s verification checks.
    options: option<string>,
    /// Redaction status of this VerificationSession. If the VerificationSession is not redacted, this field will be null.
    redaction: option<string>,
    /// Status of this VerificationSession. [Learn more about the lifecycle of sessions](https://stripe.com/docs/identity/how-sessions-work).
    status: get-identity-verification-sessions-status-enum,
    /// The type of [verification check](https://stripe.com/docs/identity/verification-checks) to be performed.
    type-op: option<get-identity-verification-reports-type-op-enum>,
    /// The short-lived URL that you use to redirect a user to Stripe to submit their identity information. This URL expires after 48 hours and can only be used once. Don’t store it, log it, send it in emails or expose it to anyone other than the user. Refer to our docs on [verifying identity documents](https://stripe.com/docs/identity/verify-identity-documents?platform=web&type=redirect) to learn how to redirect users to Stripe.
    url: option<string>,
    /// The user’s verified data.
    verified-outputs: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record verification-session-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record post-identity-verification-sessions-body-metadata-entry {
    key: string,
    value: string
  }

  /// A set of options for the session’s verification checks.
  record post-identity-verification-sessions-body-options {
    document: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-identity-verification-sessions-session-body-metadata-entry {
    key: string,
    value: string
  }

  /// A set of options for the session’s verification checks.
  record post-identity-verification-sessions-session-body-options {
    document: option<string>
  }

  record get-identity-verification-reports-params {
    created: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// Only return VerificationReports of this type
    type-op: option<get-identity-verification-reports-type-op-enum>,
    /// Only return VerificationReports created by this VerificationSession ID. It is allowed to provide a VerificationIntent ID.
    verification-session: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-identity-verification-reports: func(params: get-identity-verification-reports-params) -> result<get-identity-verification-reports-response, string>;

  record get-identity-verification-reports-report-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    report: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-identity-verification-reports-report: func(params: get-identity-verification-reports-report-params) -> result<verification-report, string>;

  record get-identity-verification-sessions-params {
    created: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// Only return VerificationSessions with this status. [Learn more about the lifecycle of sessions](https://stripe.com/docs/identity/how-sessions-work).
    status: option<get-identity-verification-sessions-status-enum>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-identity-verification-sessions: func(params: get-identity-verification-sessions-params) -> result<get-identity-verification-sessions-response, string>;

  record post-identity-verification-sessions-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-identity-verification-sessions-body-metadata-entry>>,
    /// A set of options for the session’s verification checks.
    options: option<post-identity-verification-sessions-body-options>,
    /// The URL that the user will be redirected to upon completing the verification flow.
    return-url: option<string>,
    /// The type of [verification check](https://stripe.com/docs/identity/verification-checks) to be performed.
    type-op: get-identity-verification-reports-type-op-enum
  }
  post-identity-verification-sessions: func(params: post-identity-verification-sessions-params) -> result<verification-session, string>;

  record get-identity-verification-sessions-session-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    session: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-identity-verification-sessions-session: func(params: get-identity-verification-sessions-session-params) -> result<verification-session, string>;

  record post-identity-verification-sessions-session-params {
    session: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-identity-verification-sessions-session-body-metadata-entry>>,
    /// A set of options for the session’s verification checks.
    options: option<post-identity-verification-sessions-session-body-options>,
    /// The type of [verification check](https://stripe.com/docs/identity/verification-checks) to be performed.
    type-op: option<get-identity-verification-reports-type-op-enum>
  }
  post-identity-verification-sessions-session: func(params: post-identity-verification-sessions-session-params) -> result<verification-session, string>;

  record post-identity-verification-sessions-session-cancel-params {
    session: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
