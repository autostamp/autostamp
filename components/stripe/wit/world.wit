    maybank2u,
    ocbc,
    pb-enterprise,
    public-bank,
    rhb,
    standard-chartered,
    uob,
  }

  enum post-setup-intents-body-payment-method-data-ideal-bank-enum {
    abn-amro,
    asn-bank,
    bunq,
    handelsbanken,
    ing,
    knab,
    moneyou,
    rabobank,
    regiobank,
    revolut,
    sns-bank,
    triodos-bank,
    van-lanschot,
    yoursafe,
  }

  enum post-setup-intents-body-payment-method-data-p24-bank-enum {
    alior-bank,
    bank-millennium,
    bank-nowy-bfg-sa,
    bank-pekao-sa,
    banki-spbdzielcze,
    blik,
    bnp-paribas,
    boz,
    citi-handlowy,
    credit-agricole,
    envelobank,
    etransfer-pocztowy24,
    getin-bank,
    ideabank,
    ing,
    inteligo,
    mbank-mtransfer,
    nest-przelew,
    noble-pay,
    pbac-z-ipko,
    plus-bank,
    santander-przelew24,
    tmobile-usbugi-bankowe,
