    refund-application-fee: option<bool>,
    reverse-transfer: option<bool>
  }
  post-charges-charge-refunds: func(params: post-charges-charge-refunds-params) -> result<refund, string>;

  record get-charges-charge-refunds-refund-params {
    charge: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    refund: string,
    /// JSON-encoded free-form object payload
