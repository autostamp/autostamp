  record get-checkout-sessions-session-line-items-response {
    /// Details about each object.
    data: list<item>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: session-line-items-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  record get-checkout-sessions-params {
    /// Only return the Checkout Sessions for the Customer specified.
    customer: option<string>,
    /// Only return the Checkout Sessions for the Customer details specified.
    customer-details: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// Only return the Checkout Session for the PaymentIntent specified.
    payment-intent: option<string>,
    /// Only return the Checkout Sessions for the Payment Link specified.
    payment-link: option<string>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// Only return the Checkout Session for the subscription specified.
    subscription: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-checkout-sessions: func(params: get-checkout-sessions-params) -> result<get-checkout-sessions-response, string>;

  record post-checkout-sessions-params {
    /// Configure actions after a Checkout Session has expired.
    after-expiration: option<post-checkout-sessions-body-after-expiration>,
    /// Enables user redeemable promotion codes.
    allow-promotion-codes: option<bool>,
    /// Settings for automatic tax lookup for this session and resulting payments, invoices, and subscriptions.
    automatic-tax: option<post-checkout-sessions-body-automatic-tax>,
    /// Specify whether Checkout should collect the customer's billing address.
    billing-address-collection: option<session-billing-address-collection-enum>,
    /// If set, Checkout displays a back button and customers will be directed to this URL if they decide to cancel payment and return to your website.
    cancel-url: option<string>,
    /// A unique string to reference the Checkout Session. This can be a
    /// customer ID, a cart ID, or similar, and can be used to reconcile the
    client-reference-id: option<string>,
    /// Configure fields for the Checkout Session to gather active consent from customers.
    consent-collection: option<post-checkout-sessions-body-consent-collection>,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: option<string>,
    /// Collect additional information from your customer using custom fields. Up to 2 fields are supported.
    custom-fields: option<list<post-checkout-sessions-body-custom-fields-item>>,
    /// Display additional text for your customers using custom text.
    custom-text: option<post-checkout-sessions-body-custom-text>,
    /// ID of an existing Customer, if one exists. In `payment` mode, the customer’s most recent card
    /// payment method will be used to prefill the email, name, card details, and billing address
    customer: option<string>,
    /// Configure whether a Checkout Session creates a [Customer](https://stripe.com/docs/api/customers) during Session confirmation.
    /// 
    customer-creation: option<session-customer-creation-enum>,
    /// If provided, this value will be used when the Customer object is created.
    /// If not provided, customers will be asked to enter their email address.
    customer-email: option<string>,
    /// Controls what fields on Customer can be updated by the Checkout Session. Can only be provided when `customer` is provided.
    customer-update: option<post-checkout-sessions-body-customer-update>,
    /// The coupon or promotion code to apply to this Session. Currently, only up to one may be specified.
    discounts: option<list<post-checkout-sessions-body-discounts-item>>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// The Epoch time in seconds at which the Checkout Session will expire. It can be anywhere from 30 minutes to 24 hours after Checkout Session creation. By default, this value is 24 hours from creation.
    expires-at: option<s32>,
    /// Generate a post-purchase Invoice for one-time payments.
    invoice-creation: option<post-checkout-sessions-body-invoice-creation>,
    /// A list of items the customer is purchasing. Use this parameter to pass one-time or recurring [Prices](https://stripe.com/docs/api/prices).
    /// 
    line-items: option<list<post-checkout-sessions-body-line-items-item>>,
    /// The IETF language tag of the locale Checkout is displayed in. If blank or `auto`, the browser's locale is used.
    locale: option<session-locale-enum>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<list<post-checkout-sessions-body-metadata-entry>>,
    /// The mode of the Checkout Session. Pass `subscription` if the Checkout Session includes at least one recurring item.
    mode: option<session-mode-enum>,
    /// A subset of parameters to be passed to PaymentIntent creation for Checkout Sessions in `payment` mode.
    payment-intent-data: option<post-checkout-sessions-body-payment-intent-data>,
    /// Specify whether Checkout should collect a payment method. When set to `if_required`, Checkout will not collect a payment method when the total due for the session is 0.
    /// This may occur if the Checkout Session includes a free trial or a discount.
    payment-method-collection: option<session-customer-creation-enum>,
    /// Payment-method-specific configuration.
    payment-method-options: option<post-checkout-sessions-body-payment-method-options>,
    /// A list of the types of payment methods (e.g., `card`) this Checkout Session can accept.
    /// 
    payment-method-types: option<list<post-checkout-sessions-body-payment-method-types-item-enum>>,
    /// Controls phone number collection settings for the session.
    /// 
    phone-number-collection: option<post-checkout-sessions-body-phone-number-collection>,
    /// A subset of parameters to be passed to SetupIntent creation for Checkout Sessions in `setup` mode.
    setup-intent-data: option<post-checkout-sessions-body-setup-intent-data>,
    /// When set, provides configuration for Checkout to collect a shipping address from a customer.
    shipping-address-collection: option<post-checkout-sessions-body-shipping-address-collection>,
    /// The shipping rate options to apply to this Session.
    shipping-options: option<list<post-checkout-sessions-body-shipping-options-item>>,
    /// Describes the type of transaction being performed by Checkout in order to customize
    /// relevant text on the page, such as the submit button. `submit_type` can only be
    submit-type: option<session-submit-type-enum>,
    /// A subset of parameters to be passed to subscription creation for Checkout Sessions in `subscription` mode.
    subscription-data: option<post-checkout-sessions-body-subscription-data>,
    /// The URL to which Stripe should send customers when payment or setup
    /// is complete.
    success-url: string,
    /// Controls tax ID collection settings for the session.
    tax-id-collection: option<post-checkout-sessions-body-tax-id-collection>
  }
  post-checkout-sessions: func(params: post-checkout-sessions-params) -> result<session, string>;

  record get-checkout-sessions-session-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    session: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-checkout-sessions-session: func(params: get-checkout-sessions-session-params) -> result<session, string>;

  record post-checkout-sessions-session-expire-params {
    session: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>
  }
  post-checkout-sessions-session-expire: func(params: post-checkout-sessions-session-expire-params) -> result<session, string>;

  record get-checkout-sessions-session-line-items-params {
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    session: string,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-checkout-sessions-session-line-items: func(params: get-checkout-sessions-session-line-items-params) -> result<get-checkout-sessions-session-line-items-response, string>;

}

interface country-specs {
  enum country-spec-object-enum {
    country-spec,
  }

  enum get-country-specs-response-object-enum {
    list-op,
  }

  record get-country-specs-response {
    data: list<country-spec>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-country-specs-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Stripe needs to collect certain pieces of information about each account
  /// created. These requirements can differ depending on the account's country. The
  /// Country Specs API makes these rules available to your integration.
  /// 
  /// You can also view the information from this API call as [an online
  /// guide](/docs/connect/required-verification-information).
  record country-spec {
    /// The default currency for this country. This applies to both payment methods and bank accounts.
    default-currency: string,
    /// Unique identifier for the object. Represented as the ISO country code for this country.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: country-spec-object-enum,
    /// Currencies that can be accepted in the specific country (for transfers).
    supported-bank-account-currencies: list<country-spec-supported-bank-account-currencies-entry>,
    /// Currencies that can be accepted in the specified country (for payments).
    supported-payment-currencies: list<string>,
    /// Payment methods available in the specified country. You may need to enable some payment methods (e.g., [ACH](https://stripe.com/docs/ach)) on your account before they appear in this list. The `stripe` payment method refers to [charging through your platform](https://stripe.com/docs/connect/destination-charges).
    supported-payment-methods: list<string>,
    /// Countries that can accept transfers from the specified country.
    supported-transfer-countries: list<string>,
    verification-fields: country-spec-verification-fields
  }

  /// one entry of a string-keyed map (free-form object)
  record country-spec-supported-bank-account-currencies-entry {
    key: string,
    value: list<string>
  }

  record country-spec-verification-fields {
    company: country-spec-verification-field-details,
    individual: country-spec-verification-field-details
  }

  record country-spec-verification-field-details {
    /// Additional fields which are only required for some users.
    additional: list<string>,
    /// Fields which every account must eventually provide.
    minimum: list<string>
  }

  record get-country-specs-params {
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-country-specs: func(params: get-country-specs-params) -> result<get-country-specs-response, string>;

  record get-country-specs-country-params {
    country: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-country-specs-country: func(params: get-country-specs-country-params) -> result<country-spec, string>;

}

interface coupons {
  enum coupon-duration-enum {
    forever,
    once,
    repeating,
  }

  enum coupon-object-enum {
    coupon,
  }

  enum get-coupons-response-object-enum {
    list-op,
  }

  record get-coupons-response {
    data: list<coupon>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-coupons-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// A coupon contains information about a percent-off or amount-off discount you
  /// might want to apply to a customer. Coupons may be applied to [subscriptions](https://stripe.com/docs/api#subscriptions), [invoices](https://stripe.com/docs/api#invoices),
  /// [checkout sessions](https://stripe.com/docs/api/checkout/sessions), [quotes](https://stripe.com/docs/api#quotes), and more. Coupons do not work with conventional one-off [charges](https://stripe.com/docs/api#create_charge) or [payment intents](https://stripe.com/docs/api/payment_intents).
  record coupon {
    /// Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer.
    amount-off: option<s32>,
    applies-to: option<coupon-applies-to>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// If `amount_off` has been set, the three-letter [ISO code for the currency](https://stripe.com/docs/currencies) of the amount to take off.
    currency: option<string>,
    /// Coupons defined in each available currency option. Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<coupon-currency-options-entry>>,
    /// One of `forever`, `once`, and `repeating`. Describes how long a customer who applies this coupon will get the discount.
    duration: coupon-duration-enum,
    /// If `duration` is `repeating`, the number of months the coupon applies. Null if coupon `duration` is `forever` or `once`.
    duration-in-months: option<s32>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Maximum number of times this coupon can be redeemed, in total, across all customers, before it is no longer valid.
    max-redemptions: option<s32>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<coupon-metadata-entry>>,
    /// Name of the coupon displayed to customers on for instance invoices or receipts.
    name: option<string>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: coupon-object-enum,
    /// Percent that will be taken off the subtotal of any invoices for this customer for the duration of the coupon. For example, a coupon with percent_off of 50 will make a %s100 invoice %s50 instead.
    percent-off: option<f64>,
    /// Date after which the coupon can no longer be redeemed.
    redeem-by: option<s32>,
    /// Number of times this coupon has been applied to a customer.
    times-redeemed: s32,
    /// Taking account of the above properties, whether this coupon can still be applied to a customer.
    valid: bool
  }

  record coupon-applies-to {
    /// A list of product IDs this coupon applies to
    products: list<string>
  }

  record coupon-currency-option {
    /// Amount (in the `currency` specified) that will be taken off the subtotal of any invoices for this customer.
    amount-off: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record coupon-currency-options-entry {
    key: string,
    value: coupon-currency-option
  }

  /// one entry of a string-keyed map (free-form object)
  record coupon-metadata-entry {
    key: string,
    value: string
  }

  /// A hash containing directions for what this Coupon will apply discounts to.
  record post-coupons-body-applies-to {
    products: option<list<string>>
  }

  record post-coupons-body-currency-options-value {
    amount-off: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record post-coupons-body-currency-options-entry {
    key: string,
    value: post-coupons-body-currency-options-value
  }

  record post-coupons-coupon-body-currency-options-value {
    amount-off: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record post-coupons-coupon-body-currency-options-entry {
    key: string,
    value: post-coupons-coupon-body-currency-options-value
  }

  record deleted-coupon {
    /// Always true for a deleted object
    deleted: bool,
    /// Unique identifier for the object.
    id: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: coupon-object-enum
  }

  record get-coupons-params {
    /// A filter on the list, based on the object `created` field. The value can be a string with an integer Unix timestamp, or it can be a dictionary with a number of different query options.
    created: option<string>,
    /// A cursor for use in pagination. `ending_before` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, starting with `obj_bar`, your subsequent call can include `ending_before=obj_bar` in order to fetch the previous page of the list.
    ending-before: option<string>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// A limit on the number of objects to be returned. Limit can range between 1 and 100, and the default is 10.
    limit: option<s32>,
    /// A cursor for use in pagination. `starting_after` is an object ID that defines your place in the list. For instance, if you make a list request and receive 100 objects, ending with `obj_foo`, your subsequent call can include `starting_after=obj_foo` in order to fetch the next page of the list.
    starting-after: option<string>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-coupons: func(params: get-coupons-params) -> result<get-coupons-response, string>;

  record post-coupons-params {
    /// A positive integer representing the amount to subtract from an invoice total (required if `percent_off` is not passed).
    amount-off: option<s32>,
    /// A hash containing directions for what this Coupon will apply discounts to.
    applies-to: option<post-coupons-body-applies-to>,
    /// Three-letter [ISO code for the currency](https://stripe.com/docs/currencies) of the `amount_off` parameter (required if `amount_off` is passed).
    currency: option<string>,
    /// Coupons defined in each available currency option (only supported if `amount_off` is passed). Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<post-coupons-body-currency-options-entry>>,
    /// Specifies how long the discount will be in effect if used on a subscription. Defaults to `once`.
    duration: option<coupon-duration-enum>,
    /// Required only if `duration` is `repeating`, in which case it must be a positive integer that specifies the number of months the discount will be in effect.
    duration-in-months: option<s32>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Unique string of your choice that will be used to identify this coupon when applying it to a customer. If you don't want to specify a particular code, you can leave the ID blank and we'll generate a random code for you.
    id: option<string>,
    /// A positive integer specifying the number of times the coupon can be redeemed before it's no longer valid. For example, you might have a 50% off coupon that the first 20 readers of your blog can use.
    max-redemptions: option<s32>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// Name of the coupon displayed to customers on, for instance invoices, or receipts. By default the `id` is shown if `name` is not set.
    name: option<string>,
    /// A positive float larger than 0, and smaller or equal to 100, that represents the discount the coupon will apply (required if `amount_off` is not passed).
    percent-off: option<f64>,
    /// Unix timestamp specifying the last time at which the coupon can be redeemed. After the redeem_by date, the coupon can no longer be applied to new customers.
    redeem-by: option<s32>
  }
  post-coupons: func(params: post-coupons-params) -> result<coupon, string>;

  record get-coupons-coupon-params {
    coupon: string,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-coupons-coupon: func(params: get-coupons-coupon-params) -> result<coupon, string>;

  record post-coupons-coupon-params {
    coupon: string,
    /// Coupons defined in each available currency option (only supported if the coupon is amount-based). Each key must be a three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html) and a [supported currency](https://stripe.com/docs/currencies).
    currency-options: option<list<post-coupons-coupon-body-currency-options-entry>>,
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`.
    metadata: option<string>,
    /// Name of the coupon displayed to customers on, for instance invoices, or receipts. By default the `id` is shown if `name` is not set.
    name: option<string>
  }
  post-coupons-coupon: func(params: post-coupons-coupon-params) -> result<coupon, string>;

  record delete-coupons-coupon-params {
    coupon: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  delete-coupons-coupon: func(params: delete-coupons-coupon-params) -> result<deleted-coupon, string>;

}

interface credit-notes {
  enum credit-note-line-item-object-enum {
    credit-note-line-item,
  }

  enum tax-rate-object-enum {
    tax-rate,
  }

  enum tax-rate-tax-type-enum {
    gst,
    hst,
    igst,
    jct,
    lease-tax,
    pst,
    qst,
    rst,
    sales-tax,
    vat,
  }

  enum credit-note-line-item-type-op-enum {
    custom-line-item,
    invoice-line-item,
  }

  enum credit-note-lines-object-enum {
    list-op,
  }

  enum credit-note-object-enum {
    credit-note,
  }

  enum credit-note-reason-enum {
    duplicate,
    fraudulent,
    order-change,
    product-unsatisfactory,
  }

  enum credit-note-status-enum {
    issued,
    void,
  }

  enum credit-note-type-op-enum {
    post-payment,
    pre-payment,
  }

  record get-credit-notes-response {
    data: list<credit-note>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: credit-note-lines-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Issue a credit note to adjust an invoice's amount after the invoice is finalized.
  /// 
  /// Related guide: [Credit Notes](https://stripe.com/docs/billing/invoices/credit-notes).
  record credit-note {
    /// The integer amount in %s representing the total amount of the credit note, including tax.
    amount: s32,
    /// This is the sum of all the shipping amounts.
    amount-shipping: s32,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// ID of the customer.
    customer: string,
    /// Customer balance transaction related to this credit note.
    customer-balance-transaction: option<string>,
    /// The integer amount in %s representing the total amount of discount that was credited.
    discount-amount: s32,
    /// The aggregate amounts calculated per discount for all line items.
    discount-amounts: list<discounts-resource-discount-amount>,
    /// Unique identifier for the object.
    id: string,
    /// ID of the invoice.
    invoice: string,
    /// Line items that make up the credit note
    lines: credit-note-lines,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Customer-facing text that appears on the credit note PDF.
    memo: option<string>,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<credit-note-metadata-entry>>,
    /// A unique number that identifies this particular credit note and appears on the PDF of the credit note and its associated invoice.
    number: string,
    /// String representing the object's type. Objects of the same type share the same value.
    object: credit-note-object-enum,
    /// Amount that was credited outside of Stripe.
    out-of-band-amount: option<s32>,
    /// The link to download the PDF of the credit note.
    pdf: string,
    /// Reason for issuing this credit note, one of `duplicate`, `fraudulent`, `order_change`, or `product_unsatisfactory`
    reason: option<credit-note-reason-enum>,
    /// Refund related to this credit note.
    refund: option<string>,
    /// The details of the cost of shipping, including the ShippingRate applied to the invoice.
    shipping-cost: option<string>,
    /// Status of this credit note, one of `issued` or `void`. Learn more about [voiding credit notes](https://stripe.com/docs/billing/invoices/credit-notes#voiding).
    status: credit-note-status-enum,
    /// The integer amount in %s representing the amount of the credit note, excluding exclusive tax and invoice level discounts.
    subtotal: s32,
    /// The integer amount in %s representing the amount of the credit note, excluding all tax and invoice level discounts.
    subtotal-excluding-tax: option<s32>,
    /// The aggregate amounts calculated per tax rate for all line items.
    tax-amounts: list<credit-note-tax-amount>,
    /// The integer amount in %s representing the total amount of the credit note, including tax and all discount.
    total: s32,
    /// The integer amount in %s representing the total amount of the credit note, excluding tax, but including discounts.
    total-excluding-tax: option<s32>,
    /// Type of this credit note, one of `pre_payment` or `post_payment`. A `pre_payment` credit note means it was issued when the invoice was open. A `post_payment` credit note means it was issued when the invoice was paid.
    type-op: credit-note-type-op-enum,
    /// The time that the credit note was voided.
    voided-at: option<s32>
  }

  record discounts-resource-discount-amount {
    /// The amount, in %s, of the discount.
    amount: s32,
    /// The discount that was applied to get this discount amount.
    discount: string
  }

  /// Line items that make up the credit note
  record credit-note-lines {
    /// Details about each object.
    data: list<credit-note-line-item>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: credit-note-lines-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  record credit-note-line-item {
    /// The integer amount in %s representing the gross amount being credited for this line item, excluding (exclusive) tax and discounts.
    amount: s32,
    /// The integer amount in %s representing the amount being credited for this line item, excluding all tax and discounts.
    amount-excluding-tax: option<s32>,
    /// Description of the item being credited.
    description: option<string>,
    /// The integer amount in %s representing the discount being credited for this line item.
    discount-amount: s32,
    /// The amount of discount calculated per discount for this line item
    discount-amounts: list<discounts-resource-discount-amount>,
    /// Unique identifier for the object.
    id: string,
    /// ID of the invoice line item being credited
    invoice-line-item: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// String representing the object's type. Objects of the same type share the same value.
    object: credit-note-line-item-object-enum,
    /// The number of units of product being credited.
    quantity: option<s32>,
    /// The amount of tax calculated per tax rate for this line item
    tax-amounts: list<credit-note-tax-amount>,
    /// The tax rates which apply to the line item.
    tax-rates: list<tax-rate>,
    /// The type of the credit note line item, one of `invoice_line_item` or `custom_line_item`. When the type is `invoice_line_item` there is an additional `invoice_line_item` property on the resource the value of which is the id of the credited line item on the invoice.
    type-op: credit-note-line-item-type-op-enum,
    /// The cost of each unit of product being credited.
    unit-amount: option<s32>,
    /// Same as `unit_amount`, but contains a decimal value with at most 12 decimal places.
    unit-amount-decimal: option<string>,
    /// The amount in %s representing the unit amount being credited for this line item, excluding all tax and discounts.
    unit-amount-excluding-tax: option<string>
  }

  record credit-note-tax-amount {
    /// The amount, in %s, of the tax.
    amount: s32,
    /// Whether this tax amount is inclusive or exclusive.
    inclusive: bool,
    /// The tax rate that was applied to get this tax amount.
    tax-rate: string
  }

  /// Tax rates can be applied to [invoices](https://stripe.com/docs/billing/invoices/tax-rates), [subscriptions](https://stripe.com/docs/billing/subscriptions/taxes) and [Checkout Sessions](https://stripe.com/docs/payments/checkout/set-up-a-subscription#tax-rates) to collect tax.
  /// 
  /// Related guide: [Tax Rates](https://stripe.com/docs/billing/taxes/tax-rates).
  record tax-rate {
    /// Defaults to `true`. When set to `false`, this tax rate cannot be used with new applications or Checkout Sessions, but will still work for subscriptions and invoices that already have it set.
    active: bool,
    /// Two-letter country code ([ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)).
    country: option<string>,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// An arbitrary string attached to the tax rate for your internal use only. It will not be visible to your customers.
    description: option<string>,
    /// The display name of the tax rates as it will appear to your customer on their receipt email, PDF, and the hosted invoice page.
    display-name: string,
    /// Unique identifier for the object.
    id: string,
    /// This specifies if the tax rate is inclusive or exclusive.
    inclusive: bool,
    /// The jurisdiction for the tax rate. You can use this label field for tax reporting purposes. It also appears on your customer’s invoice.
    jurisdiction: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<tax-rate-metadata-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: tax-rate-object-enum,
    /// This represents the tax rate percent out of 100.
    percentage: f64,
    /// [ISO 3166-2 subdivision code](https://en.wikipedia.org/wiki/ISO_3166-2:US), without country prefix. For example, "NY" for New York, United States.
    state: option<string>,
    /// The high-level tax type, such as `vat` or `sales_tax`.
    tax-type: option<tax-rate-tax-type-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record tax-rate-metadata-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record credit-note-metadata-entry {
    key: string,
    value: string
  }

  record post-credit-notes-body-lines-item {
    amount: option<s32>,
    description: option<string>,
    invoice-line-item: option<string>,
    quantity: option<s32>,
    tax-rates: option<string>,
    type-op: credit-note-line-item-type-op-enum,
    unit-amount: option<s32>,
    unit-amount-decimal: option<string>
  }

