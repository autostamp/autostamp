interface mandates {
  enum customer-acceptance-type-op-enum {
    offline,
    online,
  }

  enum mandate-object-enum {
    mandate,
  }

  enum mandate-acss-debit-default-for-item-enum {
    invoice,
    subscription,
  }

  enum mandate-acss-debit-payment-schedule-enum {
    combined,
    interval,
    sporadic,
  }

  enum mandate-acss-debit-transaction-type-enum {
    business,
    personal,
  }

  enum mandate-bacs-debit-network-status-enum {
    accepted,
    pending,
    refused,
    revoked,
  }

  enum mandate-options-off-session-details-blik-interval-enum {
    day,
    month,
    week,
    year,
  }

  enum mandate-blik-type-op-enum {
    off-session,
    on-session,
  }

  enum mandate-status-enum {
    active,
    inactive,
    pending,
  }

  enum mandate-type-op-enum {
    multi-use,
    single-use,
  }

  /// A Mandate is a record of the permission a customer has given you to debit their payment method.
  record mandate {
    customer-acceptance: customer-acceptance,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    multi-use: option<list<mandate-multi-use-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: mandate-object-enum,
    /// ID of the payment method associated with this mandate.
    payment-method: string,
    payment-method-details: mandate-payment-method-details,
    single-use: option<mandate-single-use>,
    /// The status of the mandate, which indicates whether it can be used to initiate a payment.
    status: mandate-status-enum,
    /// The type of the mandate.
    type-op: mandate-type-op-enum
  }

  record customer-acceptance {
    /// The time at which the customer accepted the Mandate.
    accepted-at: option<s32>,
    offline: option<list<offline-acceptance-entry>>,
    online: option<online-acceptance>,
    /// The type of customer acceptance information included with the Mandate. One of `online` or `offline`.
    type-op: customer-acceptance-type-op-enum
  }

  /// one entry of a string-keyed map (free-form object)
  record offline-acceptance-entry {
    key: string,
    value: string
  }

  record online-acceptance {
    /// The IP address from which the Mandate was accepted by the customer.
    ip-address: option<string>,
    /// The user agent of the browser from which the Mandate was accepted by the customer.
    user-agent: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record mandate-multi-use-entry {
    key: string,
    value: string
  }

  record mandate-payment-method-details {
    acss-debit: option<mandate-acss-debit>,
    au-becs-debit: option<mandate-au-becs-debit>,
    bacs-debit: option<mandate-bacs-debit>,
    blik: option<mandate-blik>,
    card: option<list<card-mandate-payment-method-details-entry>>,
    cashapp: option<list<mandate-cashapp-entry>>,
    link: option<list<mandate-link-entry>>,
    sepa-debit: option<mandate-sepa-debit>,
    /// The type of the payment method associated with this mandate. An additional hash is included on `payment_method_details` with a name matching this value. It contains mandate information specific to the payment method.
    type-op: string,
    us-bank-account: option<list<mandate-us-bank-account-entry>>
  }

  record mandate-acss-debit {
    /// List of Stripe products where this mandate can be selected automatically.
    default-for: option<list<mandate-acss-debit-default-for-item-enum>>,
    /// Description of the interval. Only required if the 'payment_schedule' parameter is 'interval' or 'combined'.
    interval-description: option<string>,
    /// Payment schedule for the mandate.
    payment-schedule: mandate-acss-debit-payment-schedule-enum,
    /// Transaction type of the mandate.
    transaction-type: mandate-acss-debit-transaction-type-enum
  }

  record mandate-au-becs-debit {
    /// The URL of the mandate. This URL generally contains sensitive information about the customer and should be shared with them exclusively.
    url: string
  }

  record mandate-bacs-debit {
    /// The status of the mandate on the Bacs network. Can be one of `pending`, `revoked`, `refused`, or `accepted`.
    network-status: mandate-bacs-debit-network-status-enum,
    /// The unique reference identifying the mandate on the Bacs network.
    reference: string,
    /// The URL that will contain the mandate that the customer has signed.
    url: string
  }

  record mandate-blik {
    /// Date at which the mandate expires.
    expires-after: option<s32>,
    off-session: option<mandate-options-off-session-details-blik>,
    /// Type of the mandate.
    type-op: option<mandate-blik-type-op-enum>
  }

  record mandate-options-off-session-details-blik {
    /// Amount of each recurring payment.
    amount: option<s32>,
    /// Currency of each recurring payment.
    currency: option<string>,
    /// Frequency interval of each recurring payment.
    interval: option<mandate-options-off-session-details-blik-interval-enum>,
    /// Frequency indicator of each recurring payment.
    interval-count: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record card-mandate-payment-method-details-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record mandate-cashapp-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record mandate-link-entry {
    key: string,
    value: string
  }

  record mandate-sepa-debit {
    /// The unique reference of the mandate.
    reference: string,
    /// The URL of the mandate. This URL generally contains sensitive information about the customer and should be shared with them exclusively.
    url: string
  }

  /// one entry of a string-keyed map (free-form object)
  record mandate-us-bank-account-entry {
    key: string,
    value: string
  }

  record mandate-single-use {
    /// On a single use mandate, the amount of the payment.
    amount: s32,
    /// On a single use mandate, the currency of the payment.
    currency: string
  }

  record get-mandates-mandate-params {
    /// Specifies which fields in the response should be expanded.
    expand: option<list<string>>,
    mandate: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  get-mandates-mandate: func(params: get-mandates-mandate-params) -> result<mandate, string>;

}

interface payment-intents {
  enum payment-intent-cancellation-reason-enum {
    abandoned,
    automatic,
    duplicate,
    failed-invoice,
    fraudulent,
    requested-by-customer,
    void-invoice,
  }

