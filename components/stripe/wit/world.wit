  record get-treasury-credit-reversals-response {
    /// Details about each object.
    data: list<credit-reversal>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-treasury-credit-reversals-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// You can reverse some [ReceivedCredits](https://stripe.com/docs/api#received_credits) depending on their network and source flow. Reversing a ReceivedCredit leads to the creation of a new object known as a CreditReversal.
  record credit-reversal {
    /// Amount (in cents) transferred.
    amount: s32,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// The FinancialAccount to reverse funds from.
    financial-account: string,
    /// A [hosted transaction receipt](https://stripe.com/docs/treasury/moving-money/regulatory-receipts) URL that is provided when money movement is considered regulated under Stripe's money transmission licenses.
    hosted-regulatory-receipt-url: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<credit-reversal-metadata-entry>,
    /// The rails used to reverse the funds.
    network: credit-reversal-network-enum,
    /// String representing the object's type. Objects of the same type share the same value.
    object: credit-reversal-object-enum,
    /// The ReceivedCredit being reversed.
    received-credit: string,
    /// Status of the CreditReversal
    status: get-treasury-credit-reversals-status-enum,
    status-transitions: received-credits-resource-status-transitions,
    /// The Transaction associated with this object.
    transaction: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record credit-reversal-metadata-entry {
    key: string,
    value: string
  }

  record received-credits-resource-status-transitions {
    /// Timestamp describing when the CreditReversal changed status to `posted`
    posted-at: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-treasury-credit-reversals-body-metadata-entry {
    key: string,
    value: string
  }

  record get-treasury-debit-reversals-response {
    /// Details about each object.
    data: list<debit-reversal>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-treasury-credit-reversals-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// You can reverse some [ReceivedDebits](https://stripe.com/docs/api#received_debits) depending on their network and source flow. Reversing a ReceivedDebit leads to the creation of a new object known as a DebitReversal.
  record debit-reversal {
    /// Amount (in cents) transferred.
    amount: s32,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    /// Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies).
    currency: string,
    /// The FinancialAccount to reverse funds from.
    financial-account: option<string>,
    /// A [hosted transaction receipt](https://stripe.com/docs/treasury/moving-money/regulatory-receipts) URL that is provided when money movement is considered regulated under Stripe's money transmission licenses.
    hosted-regulatory-receipt-url: option<string>,
    /// Unique identifier for the object.
    id: string,
    /// Other flows linked to a DebitReversal.
    linked-flows: option<string>,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: list<debit-reversal-metadata-entry>,
    /// The rails used to reverse the funds.
    network: debit-reversal-network-enum,
    /// String representing the object's type. Objects of the same type share the same value.
    object: debit-reversal-object-enum,
    /// The ReceivedDebit being reversed.
    received-debit: string,
    /// Status of the DebitReversal
    status: debit-reversal-status-enum,
    status-transitions: received-debits-resource-status-transitions,
    /// The Transaction associated with this object.
    transaction: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record debit-reversal-metadata-entry {
    key: string,
    value: string
  }

  record received-debits-resource-status-transitions {
    /// Timestamp describing when the DebitReversal changed status to `completed`.
    completed-at: option<s32>
  }

  /// one entry of a string-keyed map (free-form object)
  record post-treasury-debit-reversals-body-metadata-entry {
    key: string,
    value: string
  }

  record get-treasury-financial-accounts-response {
    data: list<financial-account>,
    /// True if this list has another page of items after this one that can be fetched.
    has-more: bool,
    /// String representing the object's type. Objects of the same type share the same value. Always has the value `list`.
    object: get-treasury-credit-reversals-response-object-enum,
    /// The URL where this list can be accessed.
    url: string
  }

  /// Stripe Treasury provides users with a container for money called a FinancialAccount that is separate from their Payments balance.
  /// FinancialAccounts serve as the source and destination of Treasury’s money movement APIs.
  record financial-account {
    /// The array of paths to active Features in the Features hash.
    active-features: option<list<financial-account-active-features-item-enum>>,
    balance: financial-accounts-resource-balance,
    /// Two-letter country code ([ISO 3166-1 alpha-2](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2)).
    country: string,
    /// Time at which the object was created. Measured in seconds since the Unix epoch.
    created: s32,
    features: option<financial-account-features>,
    /// The set of credentials that resolve to a FinancialAccount.
    financial-addresses: list<financial-accounts-resource-financial-address>,
    /// Unique identifier for the object.
    id: string,
    /// Has the value `true` if the object exists in live mode or the value `false` if the object exists in test mode.
    livemode: bool,
    /// Set of [key-value pairs](https://stripe.com/docs/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format.
    metadata: option<list<financial-account-metadata-entry>>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: financial-account-object-enum,
    /// The array of paths to pending Features in the Features hash.
    pending-features: option<list<financial-account-active-features-item-enum>>,
    /// The set of functionalities that the platform can restrict on the FinancialAccount.
    platform-restrictions: option<string>,
    /// The array of paths to restricted Features in the Features hash.
    restricted-features: option<list<financial-account-active-features-item-enum>>,
    /// The enum specifying what state the account is in.
    status: financial-account-status-enum,
    status-details: financial-accounts-resource-status-details,
    /// The currencies the FinancialAccount can hold a balance in. Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase.
    supported-currencies: list<string>
  }

  /// Balance information for the FinancialAccount
  record financial-accounts-resource-balance {
    /// Funds the user can spend right now.
    cash: list<financial-accounts-resource-balance-cash-entry>,
    /// Funds not spendable yet, but will become available at a later time.
    inbound-pending: list<financial-accounts-resource-balance-inbound-pending-entry>,
    /// Funds in the account, but not spendable because they are being held for pending outbound flows.
    outbound-pending: list<financial-accounts-resource-balance-outbound-pending-entry>
  }

  /// one entry of a string-keyed map (free-form object)
  record financial-accounts-resource-balance-cash-entry {
    key: string,
    value: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record financial-accounts-resource-balance-inbound-pending-entry {
    key: string,
    value: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record financial-accounts-resource-balance-outbound-pending-entry {
    key: string,
    value: s32
  }

  /// Encodes whether a FinancialAccount has access to a particular Feature, with a `status` enum and associated `status_details`.
  /// Stripe or the platform can control Features via the requested field.
  record financial-account-features {
    card-issuing: option<financial-accounts-resource-toggle-settings>,
    deposit-insurance: option<financial-accounts-resource-toggle-settings>,
    financial-addresses: option<financial-accounts-resource-financial-addresses-features>,
    inbound-transfers: option<financial-accounts-resource-inbound-transfers>,
    intra-stripe-flows: option<financial-accounts-resource-toggle-settings>,
    /// String representing the object's type. Objects of the same type share the same value.
    object: financial-account-features-object-enum,
    outbound-payments: option<financial-accounts-resource-outbound-payments>,
    outbound-transfers: option<financial-accounts-resource-outbound-transfers>
  }

  /// Toggle settings for enabling/disabling a feature
  record financial-accounts-resource-toggle-settings {
    /// Whether the FinancialAccount should have the Feature.
    requested: bool,
    /// Whether the Feature is operational.
    status: financial-accounts-resource-toggle-settings-status-enum,
    /// Additional details; includes at least one entry when the status is not `active`.
    status-details: list<financial-accounts-resource-toggles-setting-status-details>
  }

  /// Additional details on the FinancialAccount Features information.
  record financial-accounts-resource-toggles-setting-status-details {
    /// Represents the reason why the status is `pending` or `restricted`.
    code: financial-accounts-resource-toggles-setting-status-details-code-enum,
    /// Represents what the user should do, if anything, to activate the Feature.
    resolution: option<financial-accounts-resource-toggles-setting-status-details-resolution-enum>,
    /// The `platform_restrictions` that are restricting this Feature.
    restriction: option<financial-accounts-resource-toggles-setting-status-details-restriction-enum>
  }

  /// Settings related to Financial Addresses features on a Financial Account
  record financial-accounts-resource-financial-addresses-features {
    aba: option<financial-accounts-resource-toggle-settings>
  }

  /// InboundTransfers contains inbound transfers features for a FinancialAccount.
  record financial-accounts-resource-inbound-transfers {
    ach: option<financial-accounts-resource-ach-toggle-settings>
  }

  /// Toggle settings for enabling/disabling an ACH specific feature
  record financial-accounts-resource-ach-toggle-settings {
    /// Whether the FinancialAccount should have the Feature.
    requested: bool,
    /// Whether the Feature is operational.
    status: financial-accounts-resource-toggle-settings-status-enum,
    /// Additional details; includes at least one entry when the status is not `active`.
    status-details: list<financial-accounts-resource-toggles-setting-status-details>
  }

  /// Settings related to Outbound Payments features on a Financial Account
  record financial-accounts-resource-outbound-payments {
    ach: option<financial-accounts-resource-ach-toggle-settings>,
    us-domestic-wire: option<financial-accounts-resource-toggle-settings>
  }

  /// OutboundTransfers contains outbound transfers features for a FinancialAccount.
  record financial-accounts-resource-outbound-transfers {
    ach: option<financial-accounts-resource-ach-toggle-settings>,
    us-domestic-wire: option<financial-accounts-resource-toggle-settings>
  }

  /// FinancialAddresses contain identifying information that resolves to a FinancialAccount.
  record financial-accounts-resource-financial-address {
    aba: option<financial-accounts-resource-aba-record>,
    /// The list of networks that the address supports
    supported-networks: option<list<financial-accounts-resource-financial-address-supported-networks-item-enum>>,
    /// The type of financial address
    type-op: financial-accounts-resource-financial-address-type-op-enum
  }

  /// ABA Records contain U.S. bank account details per the ABA format.
  record financial-accounts-resource-aba-record {
    /// The name of the person or business that owns the bank account.
    account-holder-name: string,
    /// The account number.
    account-number: option<string>,
    /// The last four characters of the account number.
    account-number-last4: string,
    /// Name of the bank.
    bank-name: string,
    /// Routing number for the account.
    routing-number: string
  }

  /// one entry of a string-keyed map (free-form object)
  record financial-account-metadata-entry {
    key: string,
    value: string
  }

  record financial-accounts-resource-status-details {
    /// Details related to the closure of this FinancialAccount
    closed: option<string>
  }

  /// Encodes whether a FinancialAccount has access to a particular feature. Stripe or the platform can control features via the requested field.
  record post-treasury-financial-accounts-body-features {
    card-issuing: option<post-treasury-financial-accounts-body-features-card-issuing>,
