  enum get-users-id-bookmarks-media-fields-item-enum {
    alt-text,
    duration-ms,
    height,
    media-key,
    non-public-metrics,
    organic-metrics,
    preview-image-url,
    promoted-metrics,
    public-metrics,
    type-op,
    url,
    variants,
    width,
  }

  enum get-users-id-bookmarks-poll-fields-item-enum {
    duration-minutes,
    end-datetime,
    id,
    options,
    voting-status,
  }

  enum get-users-id-bookmarks-user-fields-item-enum {
    created-at,
    description,
    entities,
    id,
    location,
    name,
    pinned-tweet-id,
    profile-image-url,
    protected,
    public-metrics,
    url,
    username,
    verified,
    verified-type,
    withheld,
  }

  enum get-users-id-bookmarks-place-fields-item-enum {
    contained-within,
    country,
    country-code,
    full-name,
    geo,
    id,
    name,
    place-type,
  }

  /// A base36 pagination token.
  record pagination-token36 {
    /// opaque schema; raw JSON
    value: string
  }

  /// Unique identifier of this Tweet. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record tweet-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Bookmarks by User
  record get-users-id-bookmarks-params {
    /// The ID of the authenticated source User for whom to return results.
    id: string,
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get the next 'page' of results.
    pagination-token: option<pagination-token36>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<get-users-id-bookmarks-tweet-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<get-users-id-bookmarks-expansions-item-enum>>,
    /// A comma separated list of Media fields to display.
    media-fields: option<list<get-users-id-bookmarks-media-fields-item-enum>>,
    /// A comma separated list of Poll fields to display.
    poll-fields: option<list<get-users-id-bookmarks-poll-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<get-users-id-bookmarks-user-fields-item-enum>>,
    /// A comma separated list of Place fields to display.
    place-fields: option<list<get-users-id-bookmarks-place-fields-item-enum>>
  }
  get-users-id-bookmarks: func(params: get-users-id-bookmarks-params) -> result<string, string>;

  /// Add Tweet to Bookmarks
  record post-users-id-bookmarks-params {
    /// The ID of the authenticated source User for whom to add bookmarks.
    id: string,
    tweet-id: tweet-id
  }
  post-users-id-bookmarks: func(params: post-users-id-bookmarks-params) -> result<string, string>;

  /// Remove a bookmarked Tweet
  record users-id-bookmarks-delete-params {
    /// The ID of the authenticated source User whose bookmark is to be removed.
    id: string,
    /// The ID of the Tweet that the source User is removing from bookmarks.
    tweet-id: string
  }
  users-id-bookmarks-delete: func(params: users-id-bookmarks-delete-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export compliance;
  export direct-messages;
  export lists;
  export users;
  export tweets;
  export general;
  export spaces;
  export bookmarks;
}
