/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `BearerToken` | `Authorization: Bearer <secret>` |
/// | `OAuth2UserToken` | `Authorization: Bearer <secret>` |
package autostamp:twitter@0.5.0;

interface compliance {
  enum list-batch-compliance-jobs-type-op-enum {
    tweets,
    users,
  }

  enum list-batch-compliance-jobs-status-enum {
    created,
    in-progress,
    failed,
    complete,
  }

  enum list-batch-compliance-jobs-compliance-job-fields-item-enum {
    created-at,
    download-expires-at,
    download-url,
    id,
    name,
    resumable,
    status,
    type-op,
    upload-expires-at,
    upload-url,
  }

  record get2-compliance-jobs-response {
    data: option<list<job>>,
    errors: option<list<problem>>,
    meta: option<get2-compliance-jobs-response-meta>
  }

  record job {
    created-at: created-at,
    download-expires-at: download-expiration,
    download-url: download-url,
    id: job-id,
    name: option<job-name>,
    status: job-status,
    type-op: job-type,
    upload-expires-at: upload-expiration,
    upload-url: upload-url
  }

  /// Creation time of the compliance job.
  record created-at {
    /// opaque schema; raw JSON
    value: string
  }

  /// Expiration time of the download URL.
  record download-expiration {
    /// opaque schema; raw JSON
    value: string
  }

  /// URL from which the user will retrieve their compliance results.
  record download-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Compliance Job ID.
  record job-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// User-provided name for a compliance job.
  record job-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Status of a compliance job.
  record job-status {
    /// opaque schema; raw JSON
    value: string
  }

  /// Type of compliance job to list.
  record job-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Expiration time of the upload URL.
  record upload-expiration {
    /// opaque schema; raw JSON
    value: string
  }

  /// URL to which the user will upload their Tweet or user IDs.
  record upload-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// An HTTP Problem Details object, as defined in IETF RFC 7807 (https://tools.ietf.org/html/rfc7807).
  record problem {
    detail: option<string>,
    status: option<s32>,
    title: string,
    type-op: string
  }

  record get2-compliance-jobs-response-meta {
    result-count: option<result-count>
  }

  /// The number of results returned in this response.
  record result-count {
    /// opaque schema; raw JSON
    value: string
  }

  record create-compliance-job-response {
    data: option<job>,
    errors: option<list<problem>>
  }

  record get2-compliance-jobs-id-response {
    data: option<job>,
    errors: option<list<problem>>
  }

  /// Tweet compliance stream events.
  record tweet-compliance-stream-response {
    /// opaque schema; raw JSON
    value: string
  }

  /// Tweet label stream events.
  record tweet-label-stream-response {
    /// opaque schema; raw JSON
    value: string
  }

  /// User compliance stream events.
  record user-compliance-stream-response {
    /// opaque schema; raw JSON
    value: string
  }

  /// List Compliance Jobs
  record list-batch-compliance-jobs-params {
    /// Type of Compliance Job to list.
    type-op: list-batch-compliance-jobs-type-op-enum,
    /// Status of Compliance Job to list.
    status: option<list-batch-compliance-jobs-status-enum>,
    /// A comma separated list of ComplianceJob fields to display.
    compliance-job-fields: option<list<list-batch-compliance-jobs-compliance-job-fields-item-enum>>
  }
  list-batch-compliance-jobs: func(params: list-batch-compliance-jobs-params) -> result<get2-compliance-jobs-response, string>;

  /// Create compliance job
  record create-batch-compliance-job-params {
    name: option<job-name>,
    /// If true, this endpoint will return a pre-signed URL with resumable uploads enabled.
    resumable: option<bool>,
    /// Type of compliance job to list.
    type-op: list-batch-compliance-jobs-type-op-enum
  }
  create-batch-compliance-job: func(params: create-batch-compliance-job-params) -> result<create-compliance-job-response, string>;

  /// Get Compliance Job
  record get-batch-compliance-job-params {
    /// The ID of the Compliance Job to retrieve.
    id: string,
    /// A comma separated list of ComplianceJob fields to display.
    compliance-job-fields: option<list<list-batch-compliance-jobs-compliance-job-fields-item-enum>>
  }
  get-batch-compliance-job: func(params: get-batch-compliance-job-params) -> result<get2-compliance-jobs-id-response, string>;

  /// Tweets Compliance stream
  record get-tweets-compliance-stream-params {
    /// The number of minutes of backfill requested.
    backfill-minutes: option<s32>,
    /// The partition number.
    partition: s32,
    /// YYYY-MM-DDTHH:mm:ssZ. The earliest UTC timestamp from which the Tweet Compliance events will be provided.
    start-time: option<string>,
    /// YYYY-MM-DDTHH:mm:ssZ. The latest UTC timestamp to which the Tweet Compliance events will be provided.
    end-time: option<string>
  }
  get-tweets-compliance-stream: func(params: get-tweets-compliance-stream-params) -> result<tweet-compliance-stream-response, string>;

  /// Tweets Label stream
  record get-tweets-label-stream-params {
    /// The number of minutes of backfill requested.
    backfill-minutes: option<s32>,
    /// YYYY-MM-DDTHH:mm:ssZ. The earliest UTC timestamp from which the Tweet labels will be provided.
    start-time: option<string>,
    /// YYYY-MM-DDTHH:mm:ssZ. The latest UTC timestamp from which the Tweet labels will be provided.
    end-time: option<string>
  }
  get-tweets-label-stream: func(params: get-tweets-label-stream-params) -> result<tweet-label-stream-response, string>;

  /// Users Compliance stream
  record get-users-compliance-stream-params {
    /// The number of minutes of backfill requested.
    backfill-minutes: option<s32>,
    /// The partition number.
    partition: s32,
    /// YYYY-MM-DDTHH:mm:ssZ. The earliest UTC timestamp from which the User Compliance events will be provided.
    start-time: option<string>,
    /// YYYY-MM-DDTHH:mm:ssZ. The latest UTC timestamp from which the User Compliance events will be provided.
    end-time: option<string>
  }
  get-users-compliance-stream: func(params: get-users-compliance-stream-params) -> result<user-compliance-stream-response, string>;

}


interface direct-messages {
  enum create-dm-conversation-request-conversation-type-enum {
    group,
  }

  enum get-dm-conversations-with-participant-id-dm-events-event-types-item-enum {
    message-create,
    participants-join,
    participants-leave,
  }

  enum get-dm-conversations-with-participant-id-dm-events-dm-event-fields-item-enum {
    attachments,
    created-at,
    dm-conversation-id,
    event-type,
    id,
    participant-ids,
    referenced-tweets,
    sender-id,
    text,
  }

  enum get-dm-conversations-with-participant-id-dm-events-expansions-item-enum {
    attachments-media-keys,
    participant-ids,
    referenced-tweets-id,
    sender-id,
  }

  enum get-dm-conversations-with-participant-id-dm-events-media-fields-item-enum {
    alt-text,
    duration-ms,
    height,
    media-key,
    non-public-metrics,
    organic-metrics,
    preview-image-url,
    promoted-metrics,
    public-metrics,
    type-op,
    url,
    variants,
    width,
  }

  enum get-dm-conversations-with-participant-id-dm-events-user-fields-item-enum {
    created-at,
    description,
    entities,
    id,
    location,
    name,
    pinned-tweet-id,
    profile-image-url,
    protected,
    public-metrics,
    url,
    username,
    verified,
    verified-type,
    withheld,
  }

  enum get-dm-conversations-with-participant-id-dm-events-tweet-fields-item-enum {
    attachments,
    author-id,
    context-annotations,
    conversation-id,
    created-at,
    edit-controls,
    edit-history-tweet-ids,
    entities,
    geo,
    id,
    in-reply-to-user-id,
    lang,
    non-public-metrics,
    organic-metrics,
    possibly-sensitive,
    promoted-metrics,
    public-metrics,
    referenced-tweets,
    reply-settings,
    source,
    text,
    withheld,
  }

  enum point-type-op-enum {
    point,
  }

  enum geo-type-op-enum {
    feature,
  }

  enum poll-voting-status-enum {
    open,
    closed,
  }

  enum tweet-referenced-tweets-item-type-op-enum {
    retweeted,
    quoted,
    replied-to,
  }

  enum tweet-withheld-scope-enum {
    tweet,
    user,
  }

  enum user-withheld-scope-enum {
    user,
  }

  record create-message-request {
    /// opaque schema; raw JSON
    value: string
  }

  /// Participants for the DM Conversation.
  record dm-participants {
    /// opaque schema; raw JSON
    value: string
  }

  record create-dm-event-response {
    data: option<create-dm-event-response-data>,
    errors: option<list<problem>>
  }

  record create-dm-event-response-data {
    dm-conversation-id: dm-conversation-id,
    dm-event-id: dm-event-id
  }

  /// Unique identifier of a DM conversation. This can either be a numeric string, or a pair of numeric strings separated by a '-' character in the case of one-on-one DM Conversations.
  record dm-conversation-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Unique identifier of a DM Event.
  record dm-event-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// An HTTP Problem Details object, as defined in IETF RFC 7807 (https://tools.ietf.org/html/rfc7807).
  record problem {
    detail: option<string>,
    status: option<s32>,
    title: string,
    type-op: string
  }

  /// A base32 pagination token.
  record pagination-token32 {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-dm-conversations-with-participant-id-dm-events-response {
    data: option<list<dm-event>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-dm-conversations-with-participant-id-dm-events-response-meta>
  }

  record dm-event {
    /// Specifies the type of attachments (if any) present in this DM.
    attachments: option<dm-event-attachments>,
    created-at: option<string>,
    dm-conversation-id: option<dm-conversation-id>,
    event-type: string,
    id: dm-event-id,
    /// A list of participants for a ParticipantsJoin or ParticipantsLeave event_type.
    participant-ids: option<list<user-id>>,
    /// A list of Tweets this DM refers to.
    referenced-tweets: option<list<dm-event-referenced-tweets-item>>,
    sender-id: option<user-id>,
    text: option<string>
  }

  /// Specifies the type of attachments (if any) present in this DM.
  record dm-event-attachments {
    /// A list of card IDs (if cards are attached).
    card-ids: option<list<string>>,
    /// A list of Media Keys for each one of the media attachments (if media are attached).
    media-keys: option<list<media-key>>
  }

  /// The Media Key identifier for this attachment.
  record media-key {
    /// opaque schema; raw JSON
    value: string
  }

  /// Unique identifier of this User. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record user-id {
    /// opaque schema; raw JSON
    value: string
  }

  record dm-event-referenced-tweets-item {
    id: tweet-id
  }

  /// Unique identifier of this Tweet. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record tweet-id {
    /// opaque schema; raw JSON
    value: string
  }

  record expansions {
    media: option<list<media>>,
    places: option<list<place>>,
    polls: option<list<poll>>,
    topics: option<list<topic>>,
    tweets: option<list<tweet>>,
    users: option<list<user>>
  }

  record media {
    height: option<media-height>,
    media-key: option<media-key>,
    type-op: string,
    width: option<media-width>
  }

  /// The height of the media in pixels.
  record media-height {
    /// opaque schema; raw JSON
    value: string
  }

  /// The width of the media in pixels.
  record media-width {
    /// opaque schema; raw JSON
    value: string
  }

  record place {
    contained-within: option<list<place-id>>,
    /// The full name of the county in which this place exists.
    country: option<string>,
    country-code: option<country-code>,
    /// The full name of this place.
    full-name: string,
    geo: option<geo>,
    id: place-id,
    /// The human readable name of this place.
    name: option<string>,
    place-type: option<place-type>
  }

  /// The identifier for this place.
  record place-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// A two-letter ISO 3166-1 alpha-2 country code.
  record country-code {
    /// opaque schema; raw JSON
    value: string
  }

  record geo {
    bbox: list<f64>,
    geometry: option<point>,
    properties: geo-properties,
    type-op: geo-type-op-enum
  }

  /// A [GeoJson Point](https://tools.ietf.org/html/rfc7946#section-3.1.2) geometry object.
  record point {
    coordinates: position,
    type-op: point-type-op-enum
  }

  /// A [GeoJson Position](https://tools.ietf.org/html/rfc7946#section-3.1.1) in the format `[longitude,latitude]`.
  record position {
    /// opaque schema; raw JSON
    value: string
  }

  record geo-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record place-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent a Poll attached to a Tweet.
  record poll {
    duration-minutes: option<s32>,
    end-datetime: option<string>,
    id: poll-id,
    options: list<poll-option>,
    voting-status: option<poll-voting-status-enum>
  }

  /// Unique identifier of this poll.
  record poll-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Describes a choice in a Poll object.
  record poll-option {
    label: poll-option-label,
    /// Position of this choice in the poll.
    position: s32,
    /// Number of users who voted for this choice.
    votes: s32
  }

  /// The text of a poll choice.
  record poll-option-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// The topic of a Space, as selected by its creator.
  record topic {
    /// The description of the given topic.
    description: option<string>,
    id: topic-id,
    /// The name of the given topic.
    name: string
  }

  /// Unique identifier of this Topic.
  record topic-id {
    /// opaque schema; raw JSON
    value: string
  }

  record tweet {
    /// Specifies the type of attachments (if any) present in this Tweet.
    attachments: option<tweet-attachments>,
    author-id: option<user-id>,
    context-annotations: option<list<context-annotation>>,
    conversation-id: option<tweet-id>,
    /// Creation time of the Tweet.
    created-at: option<string>,
    edit-controls: option<tweet-edit-controls>,
    /// A list of Tweet Ids in this Tweet chain.
    edit-history-tweet-ids: list<tweet-id>,
    entities: option<full-text-entities>,
    /// The location tagged on the Tweet, if the user provided one.
    geo: option<tweet-geo>,
    id: tweet-id,
    in-reply-to-user-id: option<user-id>,
    /// Language of the Tweet, if detected by Twitter. Returned as a BCP47 language tag.
    lang: option<string>,
    /// Nonpublic engagement metrics for the Tweet at the time of the request.
    non-public-metrics: option<tweet-non-public-metrics>,
    /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
    organic-metrics: option<tweet-organic-metrics>,
    /// Indicates if this Tweet contains URLs marked as sensitive, for example content suitable for mature audiences.
    possibly-sensitive: option<bool>,
    /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
    promoted-metrics: option<tweet-promoted-metrics>,
    /// Engagement metrics for the Tweet at the time of the request.
    public-metrics: option<tweet-public-metrics>,
    /// A list of Tweets this Tweet refers to. For example, if the parent Tweet is a Retweet, a Quoted Tweet or a Reply, it will include the related Tweet referenced to by its parent.
    referenced-tweets: option<list<tweet-referenced-tweets-item>>,
    reply-settings: option<reply-settings>,
    /// This is deprecated.
    source: option<string>,
    text: tweet-text,
    withheld: option<tweet-withheld>
  }

  /// Specifies the type of attachments (if any) present in this Tweet.
  record tweet-attachments {
    /// A list of Media Keys for each one of the media attachments (if media are attached).
    media-keys: option<list<media-key>>,
    /// A list of poll IDs (if polls are attached).
    poll-ids: option<list<poll-id>>
  }

  /// Annotation inferred from the Tweet text.
  record context-annotation {
    domain: context-annotation-domain-fields,
    entity: context-annotation-entity-fields
  }

  /// Represents the data for the context annotation domain.
  record context-annotation-domain-fields {
    /// Description of the context annotation domain.
    description: option<string>,
    /// The unique id for a context annotation domain.
    id: string,
    /// Name of the context annotation domain.
    name: option<string>
  }

  /// Represents the data for the context annotation entity.
  record context-annotation-entity-fields {
    /// Description of the context annotation entity.
    description: option<string>,
    /// The unique id for a context annotation entity.
    id: string,
    /// Name of the context annotation entity.
    name: option<string>
  }

  record tweet-edit-controls {
    /// Time when Tweet is no longer editable.
    editable-until: string,
    /// Number of times this Tweet can be edited.
    edits-remaining: s32,
    /// Indicates if this Tweet is eligible to be edited.
    is-edit-eligible: bool
  }

  record full-text-entities {
    annotations: option<list<full-text-entities-annotations-item>>,
    cashtags: option<list<cashtag-entity>>,
    hashtags: option<list<hashtag-entity>>,
    mentions: option<list<mention-entity>>,
    urls: option<list<url-entity>>
  }

  /// Annotation for entities based on the Tweet text.
  record full-text-entities-annotations-item {
    /// Index (zero-based) at which position this entity ends.  The index is inclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Text used to determine annotation.
    normalized-text: option<string>,
    /// Confidence factor for annotation type.
    probability: option<f64>,
    /// Annotation type.
    type-op: option<string>
  }

  record cashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    tag: string
  }

  record hashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// The text of the Hashtag.
    tag: string
  }

  record mention-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    id: option<user-id>,
    username: user-name
  }

  /// The Twitter handle (screen name) of this user.
  record user-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the portion of text recognized as a URL, and its start and end position within the text.
  record url-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Description of the URL landing page.
    description: option<string>,
    /// The URL as displayed in the Twitter client.
    display-url: option<string>,
    expanded-url: option<url>,
    images: option<list<url-image>>,
    media-key: option<media-key>,
    status: option<http-status-code>,
    /// Title of the page the URL points to.
    title: option<string>,
    /// Fully resolved url.
    unwound-url: option<string>,
    url: url
  }

  /// A validly formatted URL.
  record url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the information for the URL image.
  record url-image {
    height: option<media-height>,
    url: option<url>,
    width: option<media-width>
  }

  /// HTTP Status Code.
  record http-status-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// The location tagged on the Tweet, if the user provided one.
  record tweet-geo {
    coordinates: option<point>,
    place-id: option<place-id>
  }

  /// Nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-non-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>
  }

  /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-organic-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-promoted-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>,
    /// Number of times this Tweet has been liked.
    like-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: option<s32>,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: option<s32>
  }

  /// Engagement metrics for the Tweet at the time of the request.
  record tweet-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been quoted.
    quote-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  record tweet-referenced-tweets-item {
    id: tweet-id,
    type-op: tweet-referenced-tweets-item-type-op-enum
  }

  /// Shows who can reply a Tweet. Fields returned are everyone, mentioned_users, and following.
  record reply-settings {
    /// opaque schema; raw JSON
    value: string
  }

  /// The content of the Tweet.
  record tweet-text {
    /// opaque schema; raw JSON
    value: string
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record tweet-withheld {
    /// Indicates if the content is being withheld for on the basis of copyright infringement.
    copyright: bool,
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates whether the content being withheld is the `tweet` or a `user`.
    scope: option<tweet-withheld-scope-enum>
  }

  /// The Twitter User object.
  record user {
    /// Creation time of this User.
    created-at: option<string>,
    /// The text of this User's profile description (also known as bio), if the User provided one.
    description: option<string>,
    /// A list of metadata found in the User's profile description.
    entities: option<user-entities>,
    id: user-id,
    /// The location specified in the User's profile, if the User provided one. As this is a freeform value, it may not indicate a valid location, but it may be fuzzily evaluated when performing searches with location queries.
    location: option<string>,
    /// The friendly name of this User, as shown on their profile.
    name: string,
    pinned-tweet-id: option<tweet-id>,
    /// The URL to the profile image for this User.
    profile-image-url: option<string>,
    /// Indicates if this User has chosen to protect their Tweets (in other words, if this User's Tweets are private).
    protected: option<bool>,
    /// A list of metrics for this User.
    public-metrics: option<user-public-metrics>,
    /// The URL specified in the User's profile.
    url: option<string>,
    username: user-name,
    /// Indicate if this User is a verified Twitter User.
    verified: option<bool>,
    /// The Twitter Blue verified type of the user, eg: blue, government, business or none.
    verified-type: option<string>,
    withheld: option<user-withheld>
  }

  /// A list of metadata found in the User's profile description.
  record user-entities {
    description: option<full-text-entities>,
    /// Expanded details for the URL specified in the User's profile, with start and end indices.
    url: option<user-entities-url>
  }

  /// Expanded details for the URL specified in the User's profile, with start and end indices.
  record user-entities-url {
    urls: option<list<url-entity>>
  }

  /// A list of metrics for this User.
  record user-public-metrics {
    /// Number of Users who are following this User.
    followers-count: s32,
    /// Number of Users this User is following.
    following-count: s32,
    /// The number of lists that include this User.
    listed-count: s32,
    /// The number of Tweets (including Retweets) posted by this User.
    tweet-count: s32
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record user-withheld {
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates that the content being withheld is a `user`.
    scope: option<user-withheld-scope-enum>
  }

  record get2-dm-conversations-with-participant-id-dm-events-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  /// The next token.
  record next-token {
    /// opaque schema; raw JSON
    value: string
  }

  /// The previous token.
  record previous-token {
    /// opaque schema; raw JSON
    value: string
  }

  /// The number of results returned in this response.
  record result-count {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-dm-conversations-id-dm-events-response {
    data: option<list<dm-event>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-dm-conversations-id-dm-events-response-meta>
  }

  record get2-dm-conversations-id-dm-events-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  record get2-dm-events-response {
    data: option<list<dm-event>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-dm-events-response-meta>
  }

  record get2-dm-events-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  /// Create a new DM Conversation
  record dm-conversation-id-create-params {
    /// The conversation type that is being created.
    conversation-type: create-dm-conversation-request-conversation-type-enum,
    message: create-message-request,
    participant-ids: dm-participants
  }
  dm-conversation-id-create: func(params: dm-conversation-id-create-params) -> result<create-dm-event-response, string>;

  /// Get DM Events for a DM Conversation
  record get-dm-conversations-with-participant-id-dm-events-params {
    /// The ID of the participant user for the One to One DM conversation.
    participant-id: string,
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get a specified 'page' of results.
    pagination-token: option<pagination-token32>,
    /// The set of event_types to include in the results.
    event-types: option<list<get-dm-conversations-with-participant-id-dm-events-event-types-item-enum>>,
    /// A comma separated list of DmEvent fields to display.
    dm-event-fields: option<list<get-dm-conversations-with-participant-id-dm-events-dm-event-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<get-dm-conversations-with-participant-id-dm-events-expansions-item-enum>>,
    /// A comma separated list of Media fields to display.
    media-fields: option<list<get-dm-conversations-with-participant-id-dm-events-media-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<get-dm-conversations-with-participant-id-dm-events-user-fields-item-enum>>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<get-dm-conversations-with-participant-id-dm-events-tweet-fields-item-enum>>
  }
  get-dm-conversations-with-participant-id-dm-events: func(params: get-dm-conversations-with-participant-id-dm-events-params) -> result<get2-dm-conversations-with-participant-id-dm-events-response, string>;

  /// Send a new message to a user
  record dm-conversation-with-user-event-id-create-params {
    /// The ID of the recipient user that will receive the DM.
    participant-id: string,
    /// opaque schema; raw JSON
    value: string
  }
  dm-conversation-with-user-event-id-create: func(params: dm-conversation-with-user-event-id-create-params) -> result<create-dm-event-response, string>;

  /// Send a new message to a DM Conversation
  record dm-conversation-by-id-event-id-create-params {
    /// The DM Conversation ID.
    dm-conversation-id: string,
    /// opaque schema; raw JSON
    value: string
  }
  dm-conversation-by-id-event-id-create: func(params: dm-conversation-by-id-event-id-create-params) -> result<create-dm-event-response, string>;

  /// Get DM Events for a DM Conversation
  record get-dm-conversations-id-dm-events-params {
    /// The DM Conversation ID.
    id: string,
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get a specified 'page' of results.
    pagination-token: option<pagination-token32>,
    /// The set of event_types to include in the results.
    event-types: option<list<get-dm-conversations-with-participant-id-dm-events-event-types-item-enum>>,
    /// A comma separated list of DmEvent fields to display.
    dm-event-fields: option<list<get-dm-conversations-with-participant-id-dm-events-dm-event-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<get-dm-conversations-with-participant-id-dm-events-expansions-item-enum>>,
    /// A comma separated list of Media fields to display.
    media-fields: option<list<get-dm-conversations-with-participant-id-dm-events-media-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<get-dm-conversations-with-participant-id-dm-events-user-fields-item-enum>>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<get-dm-conversations-with-participant-id-dm-events-tweet-fields-item-enum>>
  }
  get-dm-conversations-id-dm-events: func(params: get-dm-conversations-id-dm-events-params) -> result<get2-dm-conversations-id-dm-events-response, string>;

  /// Get recent DM Events
  record get-dm-events-params {
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get a specified 'page' of results.
    pagination-token: option<pagination-token32>,
    /// The set of event_types to include in the results.
    event-types: option<list<get-dm-conversations-with-participant-id-dm-events-event-types-item-enum>>,
    /// A comma separated list of DmEvent fields to display.
    dm-event-fields: option<list<get-dm-conversations-with-participant-id-dm-events-dm-event-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<get-dm-conversations-with-participant-id-dm-events-expansions-item-enum>>,
    /// A comma separated list of Media fields to display.
    media-fields: option<list<get-dm-conversations-with-participant-id-dm-events-media-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<get-dm-conversations-with-participant-id-dm-events-user-fields-item-enum>>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<get-dm-conversations-with-participant-id-dm-events-tweet-fields-item-enum>>
  }
  get-dm-events: func(params: get-dm-events-params) -> result<get2-dm-events-response, string>;

}

interface lists {
  enum list-id-get-list-fields-item-enum {
    created-at,
    description,
    follower-count,
    id,
    member-count,
    name,
    owner-id,
    private,
  }

  enum list-id-get-expansions-item-enum {
    owner-id,
  }

  enum list-id-get-user-fields-item-enum {
    created-at,
    description,
    entities,
    id,
    location,
    name,
    pinned-tweet-id,
    profile-image-url,
    protected,
    public-metrics,
    url,
    username,
    verified,
    verified-type,
    withheld,
  }

  enum point-type-op-enum {
    point,
  }

  enum geo-type-op-enum {
    feature,
  }

  enum poll-voting-status-enum {
    open,
    closed,
  }

  enum tweet-referenced-tweets-item-type-op-enum {
    retweeted,
    quoted,
    replied-to,
  }

  enum tweet-withheld-scope-enum {
    tweet,
    user,
  }

  enum user-withheld-scope-enum {
    user,
  }

  record list-create-response {
    /// A Twitter List is a curated group of accounts.
    data: option<list-create-response-data>,
    errors: option<list<problem>>
  }

  /// A Twitter List is a curated group of accounts.
  record list-create-response-data {
    id: list-id,
    /// The name of this List.
    name: string
  }

  /// The unique identifier of this List.
  record list-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// An HTTP Problem Details object, as defined in IETF RFC 7807 (https://tools.ietf.org/html/rfc7807).
  record problem {
    detail: option<string>,
    status: option<s32>,
    title: string,
    type-op: string
  }

  record get2-lists-id-response {
    data: option<list-op>,
    errors: option<list<problem>>,
    includes: option<expansions>
  }

  /// A Twitter List is a curated group of accounts.
  record list-op {
    created-at: option<string>,
    description: option<string>,
    follower-count: option<s32>,
    id: list-id,
    member-count: option<s32>,
    /// The name of this List.
    name: string,
    owner-id: option<user-id>,
    private: option<bool>
  }

  /// Unique identifier of this User. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record user-id {
    /// opaque schema; raw JSON
    value: string
  }

  record expansions {
    media: option<list<media>>,
    places: option<list<place>>,
    polls: option<list<poll>>,
    topics: option<list<topic>>,
    tweets: option<list<tweet>>,
    users: option<list<user>>
  }

  record media {
    height: option<media-height>,
    media-key: option<media-key>,
    type-op: string,
    width: option<media-width>
  }

  /// The height of the media in pixels.
  record media-height {
    /// opaque schema; raw JSON
    value: string
  }

  /// The Media Key identifier for this attachment.
  record media-key {
    /// opaque schema; raw JSON
    value: string
  }

  /// The width of the media in pixels.
  record media-width {
    /// opaque schema; raw JSON
    value: string
  }

  record place {
    contained-within: option<list<place-id>>,
    /// The full name of the county in which this place exists.
    country: option<string>,
    country-code: option<country-code>,
    /// The full name of this place.
    full-name: string,
    geo: option<geo>,
    id: place-id,
    /// The human readable name of this place.
    name: option<string>,
    place-type: option<place-type>
  }

  /// The identifier for this place.
  record place-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// A two-letter ISO 3166-1 alpha-2 country code.
  record country-code {
    /// opaque schema; raw JSON
    value: string
  }

  record geo {
    bbox: list<f64>,
    geometry: option<point>,
    properties: geo-properties,
    type-op: geo-type-op-enum
  }

  /// A [GeoJson Point](https://tools.ietf.org/html/rfc7946#section-3.1.2) geometry object.
  record point {
    coordinates: position,
    type-op: point-type-op-enum
  }

  /// A [GeoJson Position](https://tools.ietf.org/html/rfc7946#section-3.1.1) in the format `[longitude,latitude]`.
  record position {
    /// opaque schema; raw JSON
    value: string
  }

  record geo-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record place-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent a Poll attached to a Tweet.
  record poll {
    duration-minutes: option<s32>,
    end-datetime: option<string>,
    id: poll-id,
    options: list<poll-option>,
    voting-status: option<poll-voting-status-enum>
  }

  /// Unique identifier of this poll.
  record poll-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Describes a choice in a Poll object.
  record poll-option {
    label: poll-option-label,
    /// Position of this choice in the poll.
    position: s32,
    /// Number of users who voted for this choice.
    votes: s32
  }

  /// The text of a poll choice.
  record poll-option-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// The topic of a Space, as selected by its creator.
  record topic {
    /// The description of the given topic.
    description: option<string>,
    id: topic-id,
    /// The name of the given topic.
    name: string
  }

  /// Unique identifier of this Topic.
  record topic-id {
    /// opaque schema; raw JSON
    value: string
  }

  record tweet {
    /// Specifies the type of attachments (if any) present in this Tweet.
    attachments: option<tweet-attachments>,
    author-id: option<user-id>,
    context-annotations: option<list<context-annotation>>,
    conversation-id: option<tweet-id>,
    /// Creation time of the Tweet.
    created-at: option<string>,
    edit-controls: option<tweet-edit-controls>,
    /// A list of Tweet Ids in this Tweet chain.
    edit-history-tweet-ids: list<tweet-id>,
    entities: option<full-text-entities>,
    /// The location tagged on the Tweet, if the user provided one.
    geo: option<tweet-geo>,
    id: tweet-id,
    in-reply-to-user-id: option<user-id>,
    /// Language of the Tweet, if detected by Twitter. Returned as a BCP47 language tag.
    lang: option<string>,
    /// Nonpublic engagement metrics for the Tweet at the time of the request.
    non-public-metrics: option<tweet-non-public-metrics>,
    /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
    organic-metrics: option<tweet-organic-metrics>,
    /// Indicates if this Tweet contains URLs marked as sensitive, for example content suitable for mature audiences.
    possibly-sensitive: option<bool>,
    /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
    promoted-metrics: option<tweet-promoted-metrics>,
    /// Engagement metrics for the Tweet at the time of the request.
    public-metrics: option<tweet-public-metrics>,
    /// A list of Tweets this Tweet refers to. For example, if the parent Tweet is a Retweet, a Quoted Tweet or a Reply, it will include the related Tweet referenced to by its parent.
    referenced-tweets: option<list<tweet-referenced-tweets-item>>,
    reply-settings: option<reply-settings>,
    /// This is deprecated.
    source: option<string>,
    text: tweet-text,
    withheld: option<tweet-withheld>
  }

  /// Specifies the type of attachments (if any) present in this Tweet.
  record tweet-attachments {
    /// A list of Media Keys for each one of the media attachments (if media are attached).
    media-keys: option<list<media-key>>,
    /// A list of poll IDs (if polls are attached).
    poll-ids: option<list<poll-id>>
  }

  /// Annotation inferred from the Tweet text.
  record context-annotation {
    domain: context-annotation-domain-fields,
    entity: context-annotation-entity-fields
  }

  /// Represents the data for the context annotation domain.
  record context-annotation-domain-fields {
    /// Description of the context annotation domain.
    description: option<string>,
    /// The unique id for a context annotation domain.
    id: string,
    /// Name of the context annotation domain.
    name: option<string>
  }

  /// Represents the data for the context annotation entity.
  record context-annotation-entity-fields {
    /// Description of the context annotation entity.
    description: option<string>,
    /// The unique id for a context annotation entity.
    id: string,
    /// Name of the context annotation entity.
    name: option<string>
  }

  /// Unique identifier of this Tweet. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record tweet-id {
    /// opaque schema; raw JSON
    value: string
  }

  record tweet-edit-controls {
    /// Time when Tweet is no longer editable.
    editable-until: string,
    /// Number of times this Tweet can be edited.
    edits-remaining: s32,
    /// Indicates if this Tweet is eligible to be edited.
    is-edit-eligible: bool
  }

  record full-text-entities {
    annotations: option<list<full-text-entities-annotations-item>>,
    cashtags: option<list<cashtag-entity>>,
    hashtags: option<list<hashtag-entity>>,
    mentions: option<list<mention-entity>>,
    urls: option<list<url-entity>>
  }

  /// Annotation for entities based on the Tweet text.
  record full-text-entities-annotations-item {
    /// Index (zero-based) at which position this entity ends.  The index is inclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Text used to determine annotation.
    normalized-text: option<string>,
    /// Confidence factor for annotation type.
    probability: option<f64>,
    /// Annotation type.
    type-op: option<string>
  }

  record cashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    tag: string
  }

  record hashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// The text of the Hashtag.
    tag: string
  }

  record mention-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    id: option<user-id>,
    username: user-name
  }

  /// The Twitter handle (screen name) of this user.
  record user-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the portion of text recognized as a URL, and its start and end position within the text.
  record url-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Description of the URL landing page.
    description: option<string>,
    /// The URL as displayed in the Twitter client.
    display-url: option<string>,
    expanded-url: option<url>,
    images: option<list<url-image>>,
    media-key: option<media-key>,
    status: option<http-status-code>,
    /// Title of the page the URL points to.
    title: option<string>,
    /// Fully resolved url.
    unwound-url: option<string>,
    url: url
  }

  /// A validly formatted URL.
  record url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the information for the URL image.
  record url-image {
    height: option<media-height>,
    url: option<url>,
    width: option<media-width>
  }

  /// HTTP Status Code.
  record http-status-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// The location tagged on the Tweet, if the user provided one.
  record tweet-geo {
    coordinates: option<point>,
    place-id: option<place-id>
  }

  /// Nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-non-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>
  }

  /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-organic-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-promoted-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>,
    /// Number of times this Tweet has been liked.
    like-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: option<s32>,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: option<s32>
  }

  /// Engagement metrics for the Tweet at the time of the request.
  record tweet-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been quoted.
    quote-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  record tweet-referenced-tweets-item {
    id: tweet-id,
    type-op: tweet-referenced-tweets-item-type-op-enum
  }

  /// Shows who can reply a Tweet. Fields returned are everyone, mentioned_users, and following.
  record reply-settings {
    /// opaque schema; raw JSON
    value: string
  }

  /// The content of the Tweet.
  record tweet-text {
    /// opaque schema; raw JSON
    value: string
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record tweet-withheld {
    /// Indicates if the content is being withheld for on the basis of copyright infringement.
    copyright: bool,
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates whether the content being withheld is the `tweet` or a `user`.
    scope: option<tweet-withheld-scope-enum>
  }

  /// The Twitter User object.
  record user {
    /// Creation time of this User.
    created-at: option<string>,
    /// The text of this User's profile description (also known as bio), if the User provided one.
    description: option<string>,
    /// A list of metadata found in the User's profile description.
    entities: option<user-entities>,
    id: user-id,
    /// The location specified in the User's profile, if the User provided one. As this is a freeform value, it may not indicate a valid location, but it may be fuzzily evaluated when performing searches with location queries.
    location: option<string>,
    /// The friendly name of this User, as shown on their profile.
    name: string,
    pinned-tweet-id: option<tweet-id>,
    /// The URL to the profile image for this User.
    profile-image-url: option<string>,
    /// Indicates if this User has chosen to protect their Tweets (in other words, if this User's Tweets are private).
    protected: option<bool>,
    /// A list of metrics for this User.
    public-metrics: option<user-public-metrics>,
    /// The URL specified in the User's profile.
    url: option<string>,
    username: user-name,
    /// Indicate if this User is a verified Twitter User.
    verified: option<bool>,
    /// The Twitter Blue verified type of the user, eg: blue, government, business or none.
    verified-type: option<string>,
    withheld: option<user-withheld>
  }

  /// A list of metadata found in the User's profile description.
  record user-entities {
    description: option<full-text-entities>,
    /// Expanded details for the URL specified in the User's profile, with start and end indices.
    url: option<user-entities-url>
  }

  /// Expanded details for the URL specified in the User's profile, with start and end indices.
  record user-entities-url {
    urls: option<list<url-entity>>
  }

  /// A list of metrics for this User.
  record user-public-metrics {
    /// Number of Users who are following this User.
    followers-count: s32,
    /// Number of Users this User is following.
    following-count: s32,
    /// The number of lists that include this User.
    listed-count: s32,
    /// The number of Tweets (including Retweets) posted by this User.
    tweet-count: s32
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record user-withheld {
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates that the content being withheld is a `user`.
    scope: option<user-withheld-scope-enum>
  }

  record list-update-response {
    data: option<list-update-response-data>,
    errors: option<list<problem>>
  }

  record list-update-response-data {
    updated: option<bool>
  }

  record list-delete-response {
    data: option<list-delete-response-data>,
    errors: option<list<problem>>
  }

  record list-delete-response-data {
    deleted: option<bool>
  }

  record list-mutate-response {
    data: option<list-mutate-response-data>,
    errors: option<list<problem>>
  }

  record list-mutate-response-data {
    is-member: option<bool>
  }

  /// A 'long' pagination token.
  record pagination-token-long {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-users-id-followed-lists-response {
    data: option<list<list-op>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-users-id-followed-lists-response-meta>
  }

  record get2-users-id-followed-lists-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  /// The next token.
  record next-token {
    /// opaque schema; raw JSON
    value: string
  }

  /// The previous token.
  record previous-token {
    /// opaque schema; raw JSON
    value: string
  }

  /// The number of results returned in this response.
  record result-count {
    /// opaque schema; raw JSON
    value: string
  }

  record list-followed-response {
    data: option<list-followed-response-data>,
    errors: option<list<problem>>
  }

  record list-followed-response-data {
    following: option<bool>
  }

  record get2-users-id-list-memberships-response {
    data: option<list<list-op>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-users-id-list-memberships-response-meta>
  }

  record get2-users-id-list-memberships-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  record get2-users-id-owned-lists-response {
    data: option<list<list-op>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-users-id-owned-lists-response-meta>
  }

  record get2-users-id-owned-lists-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  record get2-users-id-pinned-lists-response {
    data: option<list<list-op>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-users-id-pinned-lists-response-meta>
  }

  record get2-users-id-pinned-lists-response-meta {
    result-count: option<result-count>
  }

  record list-pinned-response {
    data: option<list-pinned-response-data>,
    errors: option<list<problem>>
  }

  record list-pinned-response-data {
    pinned: option<bool>
  }

  record list-unpin-response {
    data: option<list-unpin-response-data>,
    errors: option<list<problem>>
  }

  record list-unpin-response-data {
    pinned: option<bool>
  }

  /// Create List
  record list-id-create-params {
    description: option<string>,
    name: string,
    private: option<bool>
  }
  list-id-create: func(params: list-id-create-params) -> result<list-create-response, string>;

  /// List lookup by List ID.
  record list-id-get-params {
    /// The ID of the List.
    id: string,
    /// A comma separated list of List fields to display.
    list-fields: option<list<list-id-get-list-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<list-id-get-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<list-id-get-user-fields-item-enum>>
  }
  list-id-get: func(params: list-id-get-params) -> result<get2-lists-id-response, string>;

  /// Update List.
  record list-id-update-params {
    /// The ID of the List to modify.
    id: string,
    description: option<string>,
    name: option<string>,
    private: option<bool>
  }
  list-id-update: func(params: list-id-update-params) -> result<list-update-response, string>;

  /// Delete List
  record list-id-delete-params {
    /// The ID of the List to delete.
    id: string
  }
  list-id-delete: func(params: list-id-delete-params) -> result<list-delete-response, string>;

  /// Add a List member
  record list-add-member-params {
    /// The ID of the List for which to add a member.
    id: string,
    user-id: user-id
  }
  list-add-member: func(params: list-add-member-params) -> result<list-mutate-response, string>;

  /// Remove a List member
  record list-remove-member-params {
    /// The ID of the List to remove a member.
    id: string,
    /// The ID of User that will be removed from the List.
    user-id: string
  }
  list-remove-member: func(params: list-remove-member-params) -> result<list-mutate-response, string>;

  /// Get User's Followed Lists
  record user-followed-lists-params {
    /// The ID of the User to lookup.
    id: string,
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get a specified 'page' of results.
    pagination-token: option<pagination-token-long>,
    /// A comma separated list of List fields to display.
    list-fields: option<list<list-id-get-list-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<list-id-get-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<list-id-get-user-fields-item-enum>>
  }
  user-followed-lists: func(params: user-followed-lists-params) -> result<get2-users-id-followed-lists-response, string>;

  /// Follow a List
  record list-user-follow-params {
    /// The ID of the authenticated source User that will follow the List.
    id: string,
    list-id: list-id
  }
  list-user-follow: func(params: list-user-follow-params) -> result<list-followed-response, string>;

  /// Unfollow a List
  record list-user-unfollow-params {
    /// The ID of the authenticated source User that will unfollow the List.
    id: string,
    /// The ID of the List to unfollow.
    list-id: string
  }
  list-user-unfollow: func(params: list-user-unfollow-params) -> result<list-followed-response, string>;

  /// Get a User's List Memberships
  record get-user-list-memberships-params {
    /// The ID of the User to lookup.
    id: string,
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get a specified 'page' of results.
    pagination-token: option<pagination-token-long>,
    /// A comma separated list of List fields to display.
    list-fields: option<list<list-id-get-list-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<list-id-get-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<list-id-get-user-fields-item-enum>>
  }
  get-user-list-memberships: func(params: get-user-list-memberships-params) -> result<get2-users-id-list-memberships-response, string>;

  /// Get a User's Owned Lists.
  record list-user-owned-lists-params {
    /// The ID of the User to lookup.
    id: string,
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get a specified 'page' of results.
    pagination-token: option<pagination-token-long>,
    /// A comma separated list of List fields to display.
    list-fields: option<list<list-id-get-list-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<list-id-get-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<list-id-get-user-fields-item-enum>>
  }
  list-user-owned-lists: func(params: list-user-owned-lists-params) -> result<get2-users-id-owned-lists-response, string>;

  /// Get a User's Pinned Lists
  record list-user-pinned-lists-params {
    /// The ID of the authenticated source User for whom to return results.
    id: string,
    /// A comma separated list of List fields to display.
    list-fields: option<list<list-id-get-list-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<list-id-get-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<list-id-get-user-fields-item-enum>>
  }
  list-user-pinned-lists: func(params: list-user-pinned-lists-params) -> result<get2-users-id-pinned-lists-response, string>;

  /// Pin a List
  record list-user-pin-params {
    /// The ID of the authenticated source User that will pin the List.
    id: string,
    list-id: list-id
  }
  list-user-pin: func(params: list-user-pin-params) -> result<list-pinned-response, string>;

  /// Unpin a List
  record list-user-unpin-params {
    /// The ID of the authenticated source User for whom to return results.
    id: string,
    /// The ID of the List to unpin.
    list-id: string
  }
  list-user-unpin: func(params: list-user-unpin-params) -> result<list-unpin-response, string>;

}

interface users {
  enum list-get-followers-user-fields-item-enum {
    created-at,
    description,
    entities,
    id,
    location,
    name,
    pinned-tweet-id,
    profile-image-url,
    protected,
    public-metrics,
    url,
    username,
    verified,
    verified-type,
    withheld,
  }

  enum list-get-followers-expansions-item-enum {
    pinned-tweet-id,
  }

  enum list-get-followers-tweet-fields-item-enum {
    attachments,
    author-id,
    context-annotations,
    conversation-id,
    created-at,
    edit-controls,
    edit-history-tweet-ids,
    entities,
    geo,
    id,
    in-reply-to-user-id,
    lang,
    non-public-metrics,
    organic-metrics,
    possibly-sensitive,
    promoted-metrics,
    public-metrics,
    referenced-tweets,
    reply-settings,
    source,
    text,
    withheld,
  }

  enum user-withheld-scope-enum {
    user,
  }

  enum point-type-op-enum {
    point,
  }

  enum geo-type-op-enum {
    feature,
  }

  enum poll-voting-status-enum {
    open,
    closed,
  }

  enum tweet-referenced-tweets-item-type-op-enum {
    retweeted,
    quoted,
    replied-to,
  }

  enum tweet-withheld-scope-enum {
    tweet,
    user,
  }

  /// A 'long' pagination token.
  record pagination-token-long {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-lists-id-followers-response {
    data: option<list<user>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-lists-id-followers-response-meta>
  }

  /// The Twitter User object.
  record user {
    /// Creation time of this User.
    created-at: option<string>,
    /// The text of this User's profile description (also known as bio), if the User provided one.
    description: option<string>,
    /// A list of metadata found in the User's profile description.
    entities: option<user-entities>,
    id: user-id,
    /// The location specified in the User's profile, if the User provided one. As this is a freeform value, it may not indicate a valid location, but it may be fuzzily evaluated when performing searches with location queries.
    location: option<string>,
    /// The friendly name of this User, as shown on their profile.
    name: string,
    pinned-tweet-id: option<tweet-id>,
    /// The URL to the profile image for this User.
    profile-image-url: option<string>,
    /// Indicates if this User has chosen to protect their Tweets (in other words, if this User's Tweets are private).
    protected: option<bool>,
    /// A list of metrics for this User.
    public-metrics: option<user-public-metrics>,
    /// The URL specified in the User's profile.
    url: option<string>,
    username: user-name,
    /// Indicate if this User is a verified Twitter User.
    verified: option<bool>,
    /// The Twitter Blue verified type of the user, eg: blue, government, business or none.
    verified-type: option<string>,
    withheld: option<user-withheld>
  }

  /// A list of metadata found in the User's profile description.
  record user-entities {
    description: option<full-text-entities>,
    /// Expanded details for the URL specified in the User's profile, with start and end indices.
    url: option<user-entities-url>
  }

  record full-text-entities {
    annotations: option<list<full-text-entities-annotations-item>>,
    cashtags: option<list<cashtag-entity>>,
    hashtags: option<list<hashtag-entity>>,
    mentions: option<list<mention-entity>>,
    urls: option<list<url-entity>>
  }

  /// Annotation for entities based on the Tweet text.
  record full-text-entities-annotations-item {
    /// Index (zero-based) at which position this entity ends.  The index is inclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Text used to determine annotation.
    normalized-text: option<string>,
    /// Confidence factor for annotation type.
    probability: option<f64>,
    /// Annotation type.
    type-op: option<string>
  }

  record cashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    tag: string
  }

  record hashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// The text of the Hashtag.
    tag: string
  }

  record mention-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    id: option<user-id>,
    username: user-name
  }

  /// Unique identifier of this User. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record user-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The Twitter handle (screen name) of this user.
  record user-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the portion of text recognized as a URL, and its start and end position within the text.
  record url-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Description of the URL landing page.
    description: option<string>,
    /// The URL as displayed in the Twitter client.
    display-url: option<string>,
    expanded-url: option<url>,
    images: option<list<url-image>>,
    media-key: option<media-key>,
    status: option<http-status-code>,
    /// Title of the page the URL points to.
    title: option<string>,
    /// Fully resolved url.
    unwound-url: option<string>,
    url: url
  }

  /// A validly formatted URL.
  record url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the information for the URL image.
  record url-image {
    height: option<media-height>,
    url: option<url>,
    width: option<media-width>
  }

  /// The height of the media in pixels.
  record media-height {
    /// opaque schema; raw JSON
    value: string
  }

  /// The width of the media in pixels.
  record media-width {
    /// opaque schema; raw JSON
    value: string
  }

  /// The Media Key identifier for this attachment.
  record media-key {
    /// opaque schema; raw JSON
    value: string
  }

  /// HTTP Status Code.
  record http-status-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// Expanded details for the URL specified in the User's profile, with start and end indices.
  record user-entities-url {
    urls: option<list<url-entity>>
  }

  /// Unique identifier of this Tweet. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record tweet-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// A list of metrics for this User.
  record user-public-metrics {
    /// Number of Users who are following this User.
    followers-count: s32,
    /// Number of Users this User is following.
    following-count: s32,
    /// The number of lists that include this User.
    listed-count: s32,
    /// The number of Tweets (including Retweets) posted by this User.
    tweet-count: s32
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record user-withheld {
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates that the content being withheld is a `user`.
    scope: option<user-withheld-scope-enum>
  }

  /// A two-letter ISO 3166-1 alpha-2 country code.
  record country-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// An HTTP Problem Details object, as defined in IETF RFC 7807 (https://tools.ietf.org/html/rfc7807).
  record problem {
    detail: option<string>,
    status: option<s32>,
    title: string,
    type-op: string
  }

  record expansions {
    media: option<list<media>>,
    places: option<list<place>>,
    polls: option<list<poll>>,
    topics: option<list<topic>>,
    tweets: option<list<tweet>>,
    users: option<list<user>>
  }

  record media {
    height: option<media-height>,
    media-key: option<media-key>,
    type-op: string,
    width: option<media-width>
  }

  record place {
    contained-within: option<list<place-id>>,
    /// The full name of the county in which this place exists.
    country: option<string>,
    country-code: option<country-code>,
    /// The full name of this place.
    full-name: string,
    geo: option<geo>,
    id: place-id,
    /// The human readable name of this place.
    name: option<string>,
    place-type: option<place-type>
  }

  /// The identifier for this place.
  record place-id {
    /// opaque schema; raw JSON
    value: string
  }

  record geo {
    bbox: list<f64>,
    geometry: option<point>,
    properties: geo-properties,
    type-op: geo-type-op-enum
  }

  /// A [GeoJson Point](https://tools.ietf.org/html/rfc7946#section-3.1.2) geometry object.
  record point {
    coordinates: position,
    type-op: point-type-op-enum
  }

  /// A [GeoJson Position](https://tools.ietf.org/html/rfc7946#section-3.1.1) in the format `[longitude,latitude]`.
  record position {
    /// opaque schema; raw JSON
    value: string
  }

  record geo-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record place-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent a Poll attached to a Tweet.
  record poll {
    duration-minutes: option<s32>,
    end-datetime: option<string>,
    id: poll-id,
    options: list<poll-option>,
    voting-status: option<poll-voting-status-enum>
  }

  /// Unique identifier of this poll.
  record poll-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Describes a choice in a Poll object.
  record poll-option {
    label: poll-option-label,
    /// Position of this choice in the poll.
    position: s32,
    /// Number of users who voted for this choice.
    votes: s32
  }

  /// The text of a poll choice.
  record poll-option-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// The topic of a Space, as selected by its creator.
  record topic {
    /// The description of the given topic.
    description: option<string>,
    id: topic-id,
    /// The name of the given topic.
    name: string
  }

  /// Unique identifier of this Topic.
  record topic-id {
    /// opaque schema; raw JSON
    value: string
  }

  record tweet {
    /// Specifies the type of attachments (if any) present in this Tweet.
    attachments: option<tweet-attachments>,
    author-id: option<user-id>,
    context-annotations: option<list<context-annotation>>,
    conversation-id: option<tweet-id>,
    /// Creation time of the Tweet.
    created-at: option<string>,
    edit-controls: option<tweet-edit-controls>,
    /// A list of Tweet Ids in this Tweet chain.
    edit-history-tweet-ids: list<tweet-id>,
    entities: option<full-text-entities>,
    /// The location tagged on the Tweet, if the user provided one.
    geo: option<tweet-geo>,
    id: tweet-id,
    in-reply-to-user-id: option<user-id>,
    /// Language of the Tweet, if detected by Twitter. Returned as a BCP47 language tag.
    lang: option<string>,
    /// Nonpublic engagement metrics for the Tweet at the time of the request.
    non-public-metrics: option<tweet-non-public-metrics>,
    /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
    organic-metrics: option<tweet-organic-metrics>,
    /// Indicates if this Tweet contains URLs marked as sensitive, for example content suitable for mature audiences.
    possibly-sensitive: option<bool>,
    /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
    promoted-metrics: option<tweet-promoted-metrics>,
    /// Engagement metrics for the Tweet at the time of the request.
    public-metrics: option<tweet-public-metrics>,
    /// A list of Tweets this Tweet refers to. For example, if the parent Tweet is a Retweet, a Quoted Tweet or a Reply, it will include the related Tweet referenced to by its parent.
    referenced-tweets: option<list<tweet-referenced-tweets-item>>,
    reply-settings: option<reply-settings>,
    /// This is deprecated.
    source: option<string>,
    text: tweet-text,
    withheld: option<tweet-withheld>
  }

  /// Specifies the type of attachments (if any) present in this Tweet.
  record tweet-attachments {
    /// A list of Media Keys for each one of the media attachments (if media are attached).
    media-keys: option<list<media-key>>,
    /// A list of poll IDs (if polls are attached).
    poll-ids: option<list<poll-id>>
  }

  /// Annotation inferred from the Tweet text.
  record context-annotation {
    domain: context-annotation-domain-fields,
    entity: context-annotation-entity-fields
  }

  /// Represents the data for the context annotation domain.
  record context-annotation-domain-fields {
    /// Description of the context annotation domain.
    description: option<string>,
    /// The unique id for a context annotation domain.
    id: string,
    /// Name of the context annotation domain.
    name: option<string>
  }

  /// Represents the data for the context annotation entity.
  record context-annotation-entity-fields {
    /// Description of the context annotation entity.
    description: option<string>,
    /// The unique id for a context annotation entity.
    id: string,
    /// Name of the context annotation entity.
    name: option<string>
  }

  record tweet-edit-controls {
    /// Time when Tweet is no longer editable.
    editable-until: string,
    /// Number of times this Tweet can be edited.
    edits-remaining: s32,
    /// Indicates if this Tweet is eligible to be edited.
    is-edit-eligible: bool
  }

  /// The location tagged on the Tweet, if the user provided one.
  record tweet-geo {
    coordinates: option<point>,
    place-id: option<place-id>
  }

  /// Nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-non-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>
  }

  /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-organic-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-promoted-metrics {
