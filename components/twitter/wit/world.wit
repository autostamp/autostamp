interface tweets {
  enum lists-id-tweets-tweet-fields-item-enum {
    attachments,
    author-id,
    context-annotations,
    conversation-id,
    created-at,
    edit-controls,
    edit-history-tweet-ids,
    entities,
    geo,
    id,
    in-reply-to-user-id,
    lang,
    non-public-metrics,
    organic-metrics,
    possibly-sensitive,
    promoted-metrics,
    public-metrics,
    referenced-tweets,
    reply-settings,
    source,
    text,
    withheld,
  }

  enum lists-id-tweets-expansions-item-enum {
    attachments-media-keys,
    attachments-poll-ids,
    author-id,
    edit-history-tweet-ids,
    entities-mentions-username,
    geo-place-id,
    in-reply-to-user-id,
    referenced-tweets-id,
    referenced-tweets-id-author-id,
  }

  enum lists-id-tweets-media-fields-item-enum {
    alt-text,
    duration-ms,
    height,
    media-key,
    non-public-metrics,
    organic-metrics,
    preview-image-url,
    promoted-metrics,
    public-metrics,
    type-op,
    url,
    variants,
    width,
  }

  enum lists-id-tweets-poll-fields-item-enum {
    duration-minutes,
    end-datetime,
    id,
    options,
    voting-status,
  }

  enum lists-id-tweets-user-fields-item-enum {
    created-at,
    description,
    entities,
    id,
    location,
    name,
    pinned-tweet-id,
    profile-image-url,
    protected,
    public-metrics,
    url,
    username,
    verified,
    verified-type,
    withheld,
  }

  enum lists-id-tweets-place-fields-item-enum {
    contained-within,
    country,
    country-code,
    full-name,
    geo,
    id,
    name,
    place-type,
  }

  enum point-type-op-enum {
    point,
  }

  enum tweet-referenced-tweets-item-type-op-enum {
    retweeted,
    quoted,
    replied-to,
  }

  enum tweet-withheld-scope-enum {
    tweet,
    user,
  }

  enum geo-type-op-enum {
    feature,
  }

  enum poll-voting-status-enum {
    open,
    closed,
  }

  enum user-withheld-scope-enum {
    user,
  }

  enum tweet-create-request-poll-reply-settings-enum {
    following,
    mentioned-users,
  }

  enum tweet-counts-full-archive-search-granularity-enum {
    minute,
    hour,
    day,
  }

  enum tweet-counts-full-archive-search-search-count-fields-item-enum {
    end,
    start,
    tweet-count,
  }

  enum fullarchive-search-sort-order-enum {
    recency,
    relevancy,
  }

  enum find-tweets-that-quote-a-tweet-exclude-item-enum {
    replies,
    retweets,
  }

  /// A base36 pagination token.
  record pagination-token36 {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-lists-id-tweets-response {
    data: option<list<tweet>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-lists-id-tweets-response-meta>
  }

  record tweet {
    /// Specifies the type of attachments (if any) present in this Tweet.
    attachments: option<tweet-attachments>,
    author-id: option<user-id>,
    context-annotations: option<list<context-annotation>>,
    conversation-id: option<tweet-id>,
    /// Creation time of the Tweet.
    created-at: option<string>,
    edit-controls: option<tweet-edit-controls>,
    /// A list of Tweet Ids in this Tweet chain.
    edit-history-tweet-ids: list<tweet-id>,
    entities: option<full-text-entities>,
    /// The location tagged on the Tweet, if the user provided one.
    geo: option<tweet-geo>,
    id: tweet-id,
    in-reply-to-user-id: option<user-id>,
    /// Language of the Tweet, if detected by Twitter. Returned as a BCP47 language tag.
    lang: option<string>,
    /// Nonpublic engagement metrics for the Tweet at the time of the request.
    non-public-metrics: option<tweet-non-public-metrics>,
    /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
    organic-metrics: option<tweet-organic-metrics>,
    /// Indicates if this Tweet contains URLs marked as sensitive, for example content suitable for mature audiences.
    possibly-sensitive: option<bool>,
    /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
    promoted-metrics: option<tweet-promoted-metrics>,
    /// Engagement metrics for the Tweet at the time of the request.
    public-metrics: option<tweet-public-metrics>,
    /// A list of Tweets this Tweet refers to. For example, if the parent Tweet is a Retweet, a Quoted Tweet or a Reply, it will include the related Tweet referenced to by its parent.
    referenced-tweets: option<list<tweet-referenced-tweets-item>>,
    reply-settings: option<reply-settings>,
    /// This is deprecated.
    source: option<string>,
    text: tweet-text,
    withheld: option<tweet-withheld>
  }

  /// Specifies the type of attachments (if any) present in this Tweet.
  record tweet-attachments {
    /// A list of Media Keys for each one of the media attachments (if media are attached).
    media-keys: option<list<media-key>>,
    /// A list of poll IDs (if polls are attached).
    poll-ids: option<list<poll-id>>
  }

  /// The Media Key identifier for this attachment.
  record media-key {
    /// opaque schema; raw JSON
    value: string
  }

  /// Unique identifier of this poll.
  record poll-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Unique identifier of this User. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record user-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Annotation inferred from the Tweet text.
  record context-annotation {
    domain: context-annotation-domain-fields,
    entity: context-annotation-entity-fields
  }

  /// Represents the data for the context annotation domain.
  record context-annotation-domain-fields {
    /// Description of the context annotation domain.
    description: option<string>,
    /// The unique id for a context annotation domain.
    id: string,
    /// Name of the context annotation domain.
    name: option<string>
  }

  /// Represents the data for the context annotation entity.
  record context-annotation-entity-fields {
    /// Description of the context annotation entity.
    description: option<string>,
    /// The unique id for a context annotation entity.
    id: string,
    /// Name of the context annotation entity.
    name: option<string>
  }

  /// Unique identifier of this Tweet. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record tweet-id {
    /// opaque schema; raw JSON
    value: string
  }

  record tweet-edit-controls {
    /// Time when Tweet is no longer editable.
    editable-until: string,
    /// Number of times this Tweet can be edited.
    edits-remaining: s32,
    /// Indicates if this Tweet is eligible to be edited.
    is-edit-eligible: bool
  }

  record full-text-entities {
    annotations: option<list<full-text-entities-annotations-item>>,
    cashtags: option<list<cashtag-entity>>,
    hashtags: option<list<hashtag-entity>>,
    mentions: option<list<mention-entity>>,
    urls: option<list<url-entity>>
  }

  /// Annotation for entities based on the Tweet text.
  record full-text-entities-annotations-item {
    /// Index (zero-based) at which position this entity ends.  The index is inclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Text used to determine annotation.
    normalized-text: option<string>,
    /// Confidence factor for annotation type.
    probability: option<f64>,
    /// Annotation type.
    type-op: option<string>
  }

  record cashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    tag: string
  }

  record hashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// The text of the Hashtag.
    tag: string
  }

  record mention-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    id: option<user-id>,
    username: user-name
  }

  /// The Twitter handle (screen name) of this user.
  record user-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the portion of text recognized as a URL, and its start and end position within the text.
  record url-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Description of the URL landing page.
    description: option<string>,
    /// The URL as displayed in the Twitter client.
    display-url: option<string>,
    expanded-url: option<url>,
    images: option<list<url-image>>,
    media-key: option<media-key>,
    status: option<http-status-code>,
    /// Title of the page the URL points to.
    title: option<string>,
    /// Fully resolved url.
    unwound-url: option<string>,
    url: url
  }

  /// A validly formatted URL.
  record url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the information for the URL image.
  record url-image {
    height: option<media-height>,
    url: option<url>,
    width: option<media-width>
  }

  /// The height of the media in pixels.
  record media-height {
    /// opaque schema; raw JSON
    value: string
  }

  /// The width of the media in pixels.
  record media-width {
    /// opaque schema; raw JSON
    value: string
  }

  /// HTTP Status Code.
  record http-status-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// The location tagged on the Tweet, if the user provided one.
  record tweet-geo {
    coordinates: option<point>,
    place-id: option<place-id>
  }

  /// A [GeoJson Point](https://tools.ietf.org/html/rfc7946#section-3.1.2) geometry object.
  record point {
    coordinates: position,
    type-op: point-type-op-enum
  }

  /// A [GeoJson Position](https://tools.ietf.org/html/rfc7946#section-3.1.1) in the format `[longitude,latitude]`.
  record position {
    /// opaque schema; raw JSON
    value: string
  }

  /// The identifier for this place.
  record place-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-non-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>
  }

  /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-organic-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-promoted-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>,
    /// Number of times this Tweet has been liked.
    like-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: option<s32>,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: option<s32>
  }

  /// Engagement metrics for the Tweet at the time of the request.
  record tweet-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been quoted.
    quote-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  record tweet-referenced-tweets-item {
    id: tweet-id,
    type-op: tweet-referenced-tweets-item-type-op-enum
  }

  /// Shows who can reply a Tweet. Fields returned are everyone, mentioned_users, and following.
  record reply-settings {
    /// opaque schema; raw JSON
    value: string
  }

  /// The content of the Tweet.
  record tweet-text {
    /// opaque schema; raw JSON
    value: string
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record tweet-withheld {
    /// Indicates if the content is being withheld for on the basis of copyright infringement.
    copyright: bool,
    /// Provides a list of countries where this content is not available.
