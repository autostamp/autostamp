    /// A comma separated list of Poll fields to display.
    poll-fields: option<list<lists-id-tweets-poll-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<lists-id-tweets-user-fields-item-enum>>,
    /// A comma separated list of Place fields to display.
    place-fields: option<list<lists-id-tweets-place-fields-item-enum>>
  }
