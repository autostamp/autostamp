    /// YYYY-MM-DDTHH:mm:ssZ. The earliest UTC timestamp from which the Tweets will be provided. The since_id parameter takes precedence if it is also specified.
    start-time: option<string>,
    /// YYYY-MM-DDTHH:mm:ssZ. The latest UTC timestamp to which the Tweets will be provided. The until_id parameter takes precedence if it is also specified.
    end-time: option<string>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<lists-id-tweets-tweet-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<lists-id-tweets-expansions-item-enum>>,
    /// A comma separated list of Media fields to display.
    media-fields: option<list<lists-id-tweets-media-fields-item-enum>>,
    /// A comma separated list of Poll fields to display.
    poll-fields: option<list<lists-id-tweets-poll-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<lists-id-tweets-user-fields-item-enum>>,
    /// A comma separated list of Place fields to display.
    place-fields: option<list<lists-id-tweets-place-fields-item-enum>>
  }
  users-id-timeline: func(params: users-id-timeline-params) -> result<get2-users-id-timelines-reverse-chronological-response, string>;

  /// User Tweets timeline by User ID
  record users-id-tweets-params {
    /// The ID of the User to lookup.
    id: string,
    /// The minimum Tweet ID to be included in the result set. This parameter takes precedence over start_time if both are specified.
    since-id: option<tweet-id>,
    /// The maximum Tweet ID to be included in the result set. This parameter takes precedence over end_time if both are specified.
    until-id: option<tweet-id>,
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get the next 'page' of results.
    pagination-token: option<pagination-token36>,
    /// The set of entities to exclude (e.g. 'replies' or 'retweets').
    exclude: option<list<find-tweets-that-quote-a-tweet-exclude-item-enum>>,
    /// YYYY-MM-DDTHH:mm:ssZ. The earliest UTC timestamp from which the Tweets will be provided. The since_id parameter takes precedence if it is also specified.
    start-time: option<string>,
    /// YYYY-MM-DDTHH:mm:ssZ. The latest UTC timestamp to which the Tweets will be provided. The until_id parameter takes precedence if it is also specified.
    end-time: option<string>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<lists-id-tweets-tweet-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<lists-id-tweets-expansions-item-enum>>,
    /// A comma separated list of Media fields to display.
    media-fields: option<list<lists-id-tweets-media-fields-item-enum>>,
    /// A comma separated list of Poll fields to display.
    poll-fields: option<list<lists-id-tweets-poll-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<lists-id-tweets-user-fields-item-enum>>,
    /// A comma separated list of Place fields to display.
    place-fields: option<list<lists-id-tweets-place-fields-item-enum>>
  }
  users-id-tweets: func(params: users-id-tweets-params) -> result<get2-users-id-tweets-response, string>;

}

interface general {
  record get-open-api-spec-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Returns the OpenAPI Specification document.
  get-open-api-spec: func() -> result<get-open-api-spec-response, string>;

}

interface spaces {
  enum find-spaces-by-ids-space-fields-item-enum {
    created-at,
    creator-id,
    ended-at,
    host-ids,
    id,
    invited-user-ids,
    is-ticketed,
    lang,
    participant-count,
    scheduled-start,
    speaker-ids,
    started-at,
    state,
    subscriber-count,
    title,
    topic-ids,
    updated-at,
  }

  enum find-spaces-by-ids-expansions-item-enum {
    creator-id,
    host-ids,
    invited-user-ids,
    speaker-ids,
    topic-ids,
  }

  enum find-spaces-by-ids-user-fields-item-enum {
    created-at,
    description,
    entities,
    id,
    location,
    name,
    pinned-tweet-id,
    profile-image-url,
    protected,
    public-metrics,
    url,
    username,
    verified,
    verified-type,
    withheld,
  }

  enum find-spaces-by-ids-topic-fields-item-enum {
    description,
    id,
    name,
  }

  enum space-state-enum {
    live,
    scheduled,
    ended,
  }

  enum point-type-op-enum {
    point,
  }

  enum geo-type-op-enum {
    feature,
  }

  enum poll-voting-status-enum {
    open,
    closed,
  }

  enum tweet-referenced-tweets-item-type-op-enum {
    retweeted,
    quoted,
    replied-to,
  }

  enum tweet-withheld-scope-enum {
    tweet,
    user,
  }

  enum user-withheld-scope-enum {
    user,
  }

  enum search-spaces-state-enum {
    live,
    scheduled,
    all,
  }

  enum space-buyers-expansions-item-enum {
    pinned-tweet-id,
  }

  enum space-buyers-tweet-fields-item-enum {
    attachments,
    author-id,
    context-annotations,
    conversation-id,
    created-at,
    edit-controls,
    edit-history-tweet-ids,
    entities,
    geo,
    id,
    in-reply-to-user-id,
    lang,
    non-public-metrics,
    organic-metrics,
    possibly-sensitive,
    promoted-metrics,
    public-metrics,
    referenced-tweets,
    reply-settings,
    source,
    text,
    withheld,
  }

  enum space-tweets-expansions-item-enum {
    attachments-media-keys,
    attachments-poll-ids,
    author-id,
    edit-history-tweet-ids,
    entities-mentions-username,
    geo-place-id,
    in-reply-to-user-id,
    referenced-tweets-id,
    referenced-tweets-id-author-id,
  }

  enum space-tweets-media-fields-item-enum {
    alt-text,
    duration-ms,
    height,
    media-key,
    non-public-metrics,
    organic-metrics,
    preview-image-url,
    promoted-metrics,
    public-metrics,
    type-op,
    url,
    variants,
    width,
  }

  enum space-tweets-poll-fields-item-enum {
    duration-minutes,
    end-datetime,
    id,
    options,
    voting-status,
  }

  enum space-tweets-place-fields-item-enum {
    contained-within,
    country,
    country-code,
    full-name,
    geo,
    id,
    name,
    place-type,
  }

  record get2-spaces-response {
    data: option<list<space>>,
    errors: option<list<problem>>,
    includes: option<expansions>
  }

  record space {
    /// Creation time of the Space.
    created-at: option<string>,
    creator-id: option<user-id>,
    /// End time of the Space.
    ended-at: option<string>,
    /// The user ids for the hosts of the Space.
    host-ids: option<list<user-id>>,
    id: space-id,
    /// An array of user ids for people who were invited to a Space.
    invited-user-ids: option<list<user-id>>,
    /// Denotes if the Space is a ticketed Space.
    is-ticketed: option<bool>,
    /// The language of the Space.
    lang: option<string>,
    /// The number of participants in a Space.
    participant-count: option<s32>,
    /// A date time stamp for when a Space is scheduled to begin.
    scheduled-start: option<string>,
    /// An array of user ids for people who were speakers in a Space.
    speaker-ids: option<list<user-id>>,
    /// When the Space was started as a date string.
    started-at: option<string>,
    /// The current state of the Space.
    state: space-state-enum,
    /// The number of people who have either purchased a ticket or set a reminder for this Space.
    subscriber-count: option<s32>,
    /// The title of the Space.
    title: option<string>,
    /// The topics of a Space, as selected by its creator.
    topics: option<list<space-topics-item>>,
    /// When the Space was last updated.
    updated-at: option<string>
  }

  /// Unique identifier of this User. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record user-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The unique identifier of this Space.
  record space-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The Twitter Topic object.
  record space-topics-item {
    /// The description of the given topic.
    description: option<string>,
    /// An ID suitable for use in the REST API.
    id: string,
    /// The name of the given topic.
    name: string
  }

  /// An HTTP Problem Details object, as defined in IETF RFC 7807 (https://tools.ietf.org/html/rfc7807).
  record problem {
    detail: option<string>,
    status: option<s32>,
    title: string,
    type-op: string
  }

  record expansions {
    media: option<list<media>>,
    places: option<list<place>>,
    polls: option<list<poll>>,
    topics: option<list<topic>>,
    tweets: option<list<tweet>>,
    users: option<list<user>>
  }

  record media {
    height: option<media-height>,
    media-key: option<media-key>,
    type-op: string,
    width: option<media-width>
  }

  /// The height of the media in pixels.
  record media-height {
    /// opaque schema; raw JSON
    value: string
  }

  /// The Media Key identifier for this attachment.
  record media-key {
    /// opaque schema; raw JSON
    value: string
  }

  /// The width of the media in pixels.
  record media-width {
    /// opaque schema; raw JSON
    value: string
  }

  record place {
    contained-within: option<list<place-id>>,
    /// The full name of the county in which this place exists.
    country: option<string>,
    country-code: option<country-code>,
    /// The full name of this place.
    full-name: string,
    geo: option<geo>,
    id: place-id,
    /// The human readable name of this place.
    name: option<string>,
    place-type: option<place-type>
  }

  /// The identifier for this place.
  record place-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// A two-letter ISO 3166-1 alpha-2 country code.
  record country-code {
    /// opaque schema; raw JSON
    value: string
  }

  record geo {
    bbox: list<f64>,
    geometry: option<point>,
    properties: geo-properties,
    type-op: geo-type-op-enum
  }

  /// A [GeoJson Point](https://tools.ietf.org/html/rfc7946#section-3.1.2) geometry object.
  record point {
    coordinates: position,
    type-op: point-type-op-enum
  }

  /// A [GeoJson Position](https://tools.ietf.org/html/rfc7946#section-3.1.1) in the format `[longitude,latitude]`.
  record position {
    /// opaque schema; raw JSON
    value: string
  }

  record geo-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record place-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent a Poll attached to a Tweet.
  record poll {
    duration-minutes: option<s32>,
    end-datetime: option<string>,
    id: poll-id,
    options: list<poll-option>,
    voting-status: option<poll-voting-status-enum>
  }

  /// Unique identifier of this poll.
  record poll-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Describes a choice in a Poll object.
  record poll-option {
    label: poll-option-label,
    /// Position of this choice in the poll.
    position: s32,
    /// Number of users who voted for this choice.
    votes: s32
  }

  /// The text of a poll choice.
  record poll-option-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// The topic of a Space, as selected by its creator.
  record topic {
    /// The description of the given topic.
    description: option<string>,
    id: topic-id,
    /// The name of the given topic.
    name: string
  }

  /// Unique identifier of this Topic.
  record topic-id {
    /// opaque schema; raw JSON
    value: string
  }

  record tweet {
    /// Specifies the type of attachments (if any) present in this Tweet.
    attachments: option<tweet-attachments>,
    author-id: option<user-id>,
    context-annotations: option<list<context-annotation>>,
    conversation-id: option<tweet-id>,
    /// Creation time of the Tweet.
    created-at: option<string>,
    edit-controls: option<tweet-edit-controls>,
    /// A list of Tweet Ids in this Tweet chain.
    edit-history-tweet-ids: list<tweet-id>,
    entities: option<full-text-entities>,
    /// The location tagged on the Tweet, if the user provided one.
    geo: option<tweet-geo>,
    id: tweet-id,
    in-reply-to-user-id: option<user-id>,
    /// Language of the Tweet, if detected by Twitter. Returned as a BCP47 language tag.
    lang: option<string>,
    /// Nonpublic engagement metrics for the Tweet at the time of the request.
    non-public-metrics: option<tweet-non-public-metrics>,
    /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
    organic-metrics: option<tweet-organic-metrics>,
    /// Indicates if this Tweet contains URLs marked as sensitive, for example content suitable for mature audiences.
    possibly-sensitive: option<bool>,
    /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
    promoted-metrics: option<tweet-promoted-metrics>,
    /// Engagement metrics for the Tweet at the time of the request.
    public-metrics: option<tweet-public-metrics>,
    /// A list of Tweets this Tweet refers to. For example, if the parent Tweet is a Retweet, a Quoted Tweet or a Reply, it will include the related Tweet referenced to by its parent.
    referenced-tweets: option<list<tweet-referenced-tweets-item>>,
    reply-settings: option<reply-settings>,
    /// This is deprecated.
    source: option<string>,
    text: tweet-text,
    withheld: option<tweet-withheld>
  }

  /// Specifies the type of attachments (if any) present in this Tweet.
  record tweet-attachments {
    /// A list of Media Keys for each one of the media attachments (if media are attached).
    media-keys: option<list<media-key>>,
    /// A list of poll IDs (if polls are attached).
    poll-ids: option<list<poll-id>>
  }

  /// Annotation inferred from the Tweet text.
  record context-annotation {
    domain: context-annotation-domain-fields,
    entity: context-annotation-entity-fields
  }

  /// Represents the data for the context annotation domain.
  record context-annotation-domain-fields {
    /// Description of the context annotation domain.
    description: option<string>,
    /// The unique id for a context annotation domain.
    id: string,
    /// Name of the context annotation domain.
    name: option<string>
  }

  /// Represents the data for the context annotation entity.
  record context-annotation-entity-fields {
    /// Description of the context annotation entity.
    description: option<string>,
    /// The unique id for a context annotation entity.
    id: string,
    /// Name of the context annotation entity.
    name: option<string>
  }

  /// Unique identifier of this Tweet. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record tweet-id {
    /// opaque schema; raw JSON
    value: string
  }

  record tweet-edit-controls {
    /// Time when Tweet is no longer editable.
    editable-until: string,
    /// Number of times this Tweet can be edited.
    edits-remaining: s32,
    /// Indicates if this Tweet is eligible to be edited.
    is-edit-eligible: bool
  }

  record full-text-entities {
    annotations: option<list<full-text-entities-annotations-item>>,
    cashtags: option<list<cashtag-entity>>,
    hashtags: option<list<hashtag-entity>>,
    mentions: option<list<mention-entity>>,
    urls: option<list<url-entity>>
  }

  /// Annotation for entities based on the Tweet text.
  record full-text-entities-annotations-item {
    /// Index (zero-based) at which position this entity ends.  The index is inclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Text used to determine annotation.
    normalized-text: option<string>,
    /// Confidence factor for annotation type.
    probability: option<f64>,
    /// Annotation type.
    type-op: option<string>
  }

  record cashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    tag: string
  }

  record hashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// The text of the Hashtag.
    tag: string
  }

  record mention-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    id: option<user-id>,
    username: user-name
  }

  /// The Twitter handle (screen name) of this user.
  record user-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the portion of text recognized as a URL, and its start and end position within the text.
  record url-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Description of the URL landing page.
    description: option<string>,
    /// The URL as displayed in the Twitter client.
    display-url: option<string>,
    expanded-url: option<url>,
    images: option<list<url-image>>,
    media-key: option<media-key>,
    status: option<http-status-code>,
    /// Title of the page the URL points to.
    title: option<string>,
    /// Fully resolved url.
    unwound-url: option<string>,
    url: url
  }

  /// A validly formatted URL.
  record url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the information for the URL image.
  record url-image {
    height: option<media-height>,
    url: option<url>,
    width: option<media-width>
  }

  /// HTTP Status Code.
  record http-status-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// The location tagged on the Tweet, if the user provided one.
  record tweet-geo {
    coordinates: option<point>,
    place-id: option<place-id>
  }

  /// Nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-non-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>
  }

  /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-organic-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-promoted-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>,
    /// Number of times this Tweet has been liked.
    like-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: option<s32>,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: option<s32>
  }

  /// Engagement metrics for the Tweet at the time of the request.
  record tweet-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been quoted.
    quote-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  record tweet-referenced-tweets-item {
    id: tweet-id,
    type-op: tweet-referenced-tweets-item-type-op-enum
  }

  /// Shows who can reply a Tweet. Fields returned are everyone, mentioned_users, and following.
  record reply-settings {
    /// opaque schema; raw JSON
    value: string
  }

  /// The content of the Tweet.
  record tweet-text {
    /// opaque schema; raw JSON
    value: string
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record tweet-withheld {
    /// Indicates if the content is being withheld for on the basis of copyright infringement.
    copyright: bool,
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates whether the content being withheld is the `tweet` or a `user`.
    scope: option<tweet-withheld-scope-enum>
  }

  /// The Twitter User object.
  record user {
    /// Creation time of this User.
    created-at: option<string>,
    /// The text of this User's profile description (also known as bio), if the User provided one.
    description: option<string>,
    /// A list of metadata found in the User's profile description.
    entities: option<user-entities>,
    id: user-id,
    /// The location specified in the User's profile, if the User provided one. As this is a freeform value, it may not indicate a valid location, but it may be fuzzily evaluated when performing searches with location queries.
    location: option<string>,
    /// The friendly name of this User, as shown on their profile.
    name: string,
    pinned-tweet-id: option<tweet-id>,
    /// The URL to the profile image for this User.
    profile-image-url: option<string>,
    /// Indicates if this User has chosen to protect their Tweets (in other words, if this User's Tweets are private).
    protected: option<bool>,
    /// A list of metrics for this User.
    public-metrics: option<user-public-metrics>,
    /// The URL specified in the User's profile.
    url: option<string>,
    username: user-name,
    /// Indicate if this User is a verified Twitter User.
    verified: option<bool>,
    /// The Twitter Blue verified type of the user, eg: blue, government, business or none.
    verified-type: option<string>,
    withheld: option<user-withheld>
  }

  /// A list of metadata found in the User's profile description.
  record user-entities {
    description: option<full-text-entities>,
    /// Expanded details for the URL specified in the User's profile, with start and end indices.
    url: option<user-entities-url>
  }

  /// Expanded details for the URL specified in the User's profile, with start and end indices.
  record user-entities-url {
    urls: option<list<url-entity>>
  }

  /// A list of metrics for this User.
  record user-public-metrics {
    /// Number of Users who are following this User.
    followers-count: s32,
    /// Number of Users this User is following.
    following-count: s32,
    /// The number of lists that include this User.
    listed-count: s32,
    /// The number of Tweets (including Retweets) posted by this User.
    tweet-count: s32
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record user-withheld {
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates that the content being withheld is a `user`.
    scope: option<user-withheld-scope-enum>
  }

  record get2-spaces-by-creator-ids-response {
    data: option<list<space>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-spaces-by-creator-ids-response-meta>
  }

  record get2-spaces-by-creator-ids-response-meta {
    result-count: option<result-count>
  }

  /// The number of results returned in this response.
  record result-count {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-spaces-search-response {
    data: option<list<space>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-spaces-search-response-meta>
  }

  record get2-spaces-search-response-meta {
    result-count: option<result-count>
  }

  record get2-spaces-id-response {
    data: option<space>,
    errors: option<list<problem>>,
    includes: option<expansions>
  }

  /// A base32 pagination token.
  record pagination-token32 {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-spaces-id-buyers-response {
    data: option<list<user>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-spaces-id-buyers-response-meta>
  }

  record get2-spaces-id-buyers-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  /// The next token.
  record next-token {
    /// opaque schema; raw JSON
    value: string
  }

  /// The previous token.
  record previous-token {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-spaces-id-tweets-response {
    data: option<list<tweet>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-spaces-id-tweets-response-meta>
  }

  record get2-spaces-id-tweets-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  /// Space lookup up Space IDs
  record find-spaces-by-ids-params {
    /// The list of Space IDs to return.
    ids: list<string>,
    /// A comma separated list of Space fields to display.
    space-fields: option<list<find-spaces-by-ids-space-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<find-spaces-by-ids-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<find-spaces-by-ids-user-fields-item-enum>>,
    /// A comma separated list of Topic fields to display.
    topic-fields: option<list<find-spaces-by-ids-topic-fields-item-enum>>
  }
  find-spaces-by-ids: func(params: find-spaces-by-ids-params) -> result<get2-spaces-response, string>;

  /// Space lookup by their creators
  record find-spaces-by-creator-ids-params {
    /// The IDs of Users to search through.
    user-ids: list<user-id>,
    /// A comma separated list of Space fields to display.
    space-fields: option<list<find-spaces-by-ids-space-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<find-spaces-by-ids-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<find-spaces-by-ids-user-fields-item-enum>>,
    /// A comma separated list of Topic fields to display.
    topic-fields: option<list<find-spaces-by-ids-topic-fields-item-enum>>
  }
  find-spaces-by-creator-ids: func(params: find-spaces-by-creator-ids-params) -> result<get2-spaces-by-creator-ids-response, string>;

  /// Search for Spaces
  record search-spaces-params {
    /// The search query.
    query: string,
    /// The state of Spaces to search for.
    state: option<search-spaces-state-enum>,
    /// The number of results to return.
    max-results: option<s32>,
    /// A comma separated list of Space fields to display.
    space-fields: option<list<find-spaces-by-ids-space-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<find-spaces-by-ids-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<find-spaces-by-ids-user-fields-item-enum>>,
    /// A comma separated list of Topic fields to display.
    topic-fields: option<list<find-spaces-by-ids-topic-fields-item-enum>>
  }
  search-spaces: func(params: search-spaces-params) -> result<get2-spaces-search-response, string>;

  /// Space lookup by Space ID
  record find-space-by-id-params {
    /// The ID of the Space to be retrieved.
    id: string,
    /// A comma separated list of Space fields to display.
    space-fields: option<list<find-spaces-by-ids-space-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<find-spaces-by-ids-expansions-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<find-spaces-by-ids-user-fields-item-enum>>,
    /// A comma separated list of Topic fields to display.
    topic-fields: option<list<find-spaces-by-ids-topic-fields-item-enum>>
  }
  find-space-by-id: func(params: find-space-by-id-params) -> result<get2-spaces-id-response, string>;

  /// Retrieve the list of Users who purchased a ticket to the given space
  record space-buyers-params {
    /// The ID of the Space to be retrieved.
    id: string,
    /// This parameter is used to get a specified 'page' of results.
    pagination-token: option<pagination-token32>,
    /// The maximum number of results.
    max-results: option<s32>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<find-spaces-by-ids-user-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<space-buyers-expansions-item-enum>>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<space-buyers-tweet-fields-item-enum>>
  }
  space-buyers: func(params: space-buyers-params) -> result<get2-spaces-id-buyers-response, string>;

  /// Retrieve Tweets from a Space.
  record space-tweets-params {
    /// The ID of the Space to be retrieved.
    id: string,
    /// The number of Tweets to fetch from the provided space. If not provided, the value will default to the maximum of 100.
    max-results: option<s32>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<space-buyers-tweet-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<space-tweets-expansions-item-enum>>,
    /// A comma separated list of Media fields to display.
    media-fields: option<list<space-tweets-media-fields-item-enum>>,
    /// A comma separated list of Poll fields to display.
    poll-fields: option<list<space-tweets-poll-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<find-spaces-by-ids-user-fields-item-enum>>,
    /// A comma separated list of Place fields to display.
    place-fields: option<list<space-tweets-place-fields-item-enum>>
  }
  space-tweets: func(params: space-tweets-params) -> result<get2-spaces-id-tweets-response, string>;

}

interface bookmarks {
  enum get-users-id-bookmarks-tweet-fields-item-enum {
    attachments,
    author-id,
    context-annotations,
    conversation-id,
    created-at,
    edit-controls,
    edit-history-tweet-ids,
    entities,
    geo,
    id,
    in-reply-to-user-id,
    lang,
    non-public-metrics,
    organic-metrics,
    possibly-sensitive,
    promoted-metrics,
    public-metrics,
    referenced-tweets,
    reply-settings,
    source,
    text,
    withheld,
  }

  enum get-users-id-bookmarks-expansions-item-enum {
    attachments-media-keys,
    attachments-poll-ids,
    author-id,
    edit-history-tweet-ids,
    entities-mentions-username,
    geo-place-id,
    in-reply-to-user-id,
    referenced-tweets-id,
    referenced-tweets-id-author-id,
  }

  enum get-users-id-bookmarks-media-fields-item-enum {
    alt-text,
    duration-ms,
    height,
    media-key,
    non-public-metrics,
    organic-metrics,
    preview-image-url,
    promoted-metrics,
    public-metrics,
    type-op,
    url,
    variants,
    width,
  }

  enum get-users-id-bookmarks-poll-fields-item-enum {
    duration-minutes,
    end-datetime,
    id,
    options,
    voting-status,
  }

  enum get-users-id-bookmarks-user-fields-item-enum {
    created-at,
    description,
    entities,
    id,
    location,
    name,
    pinned-tweet-id,
    profile-image-url,
    protected,
    public-metrics,
    url,
    username,
    verified,
    verified-type,
    withheld,
  }

  enum get-users-id-bookmarks-place-fields-item-enum {
    contained-within,
    country,
    country-code,
    full-name,
    geo,
    id,
    name,
    place-type,
  }

  enum point-type-op-enum {
    point,
  }

  enum tweet-referenced-tweets-item-type-op-enum {
    retweeted,
    quoted,
    replied-to,
  }

  enum tweet-withheld-scope-enum {
    tweet,
    user,
  }

  enum geo-type-op-enum {
    feature,
  }

  enum poll-voting-status-enum {
    open,
    closed,
  }

  enum user-withheld-scope-enum {
    user,
  }

  /// A base36 pagination token.
  record pagination-token36 {
    /// opaque schema; raw JSON
    value: string
  }

  record get2-users-id-bookmarks-response {
    data: option<list<tweet>>,
    errors: option<list<problem>>,
    includes: option<expansions>,
    meta: option<get2-users-id-bookmarks-response-meta>
  }

  record tweet {
    /// Specifies the type of attachments (if any) present in this Tweet.
    attachments: option<tweet-attachments>,
    author-id: option<user-id>,
    context-annotations: option<list<context-annotation>>,
    conversation-id: option<tweet-id>,
    /// Creation time of the Tweet.
    created-at: option<string>,
    edit-controls: option<tweet-edit-controls>,
    /// A list of Tweet Ids in this Tweet chain.
    edit-history-tweet-ids: list<tweet-id>,
    entities: option<full-text-entities>,
    /// The location tagged on the Tweet, if the user provided one.
    geo: option<tweet-geo>,
    id: tweet-id,
    in-reply-to-user-id: option<user-id>,
    /// Language of the Tweet, if detected by Twitter. Returned as a BCP47 language tag.
    lang: option<string>,
    /// Nonpublic engagement metrics for the Tweet at the time of the request.
    non-public-metrics: option<tweet-non-public-metrics>,
    /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
    organic-metrics: option<tweet-organic-metrics>,
    /// Indicates if this Tweet contains URLs marked as sensitive, for example content suitable for mature audiences.
    possibly-sensitive: option<bool>,
    /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
    promoted-metrics: option<tweet-promoted-metrics>,
    /// Engagement metrics for the Tweet at the time of the request.
    public-metrics: option<tweet-public-metrics>,
    /// A list of Tweets this Tweet refers to. For example, if the parent Tweet is a Retweet, a Quoted Tweet or a Reply, it will include the related Tweet referenced to by its parent.
    referenced-tweets: option<list<tweet-referenced-tweets-item>>,
    reply-settings: option<reply-settings>,
    /// This is deprecated.
    source: option<string>,
    text: tweet-text,
    withheld: option<tweet-withheld>
  }

  /// Specifies the type of attachments (if any) present in this Tweet.
  record tweet-attachments {
    /// A list of Media Keys for each one of the media attachments (if media are attached).
    media-keys: option<list<media-key>>,
    /// A list of poll IDs (if polls are attached).
    poll-ids: option<list<poll-id>>
  }

  /// The Media Key identifier for this attachment.
  record media-key {
    /// opaque schema; raw JSON
    value: string
  }

  /// Unique identifier of this poll.
  record poll-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Unique identifier of this User. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record user-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Annotation inferred from the Tweet text.
  record context-annotation {
    domain: context-annotation-domain-fields,
    entity: context-annotation-entity-fields
  }

  /// Represents the data for the context annotation domain.
  record context-annotation-domain-fields {
    /// Description of the context annotation domain.
    description: option<string>,
    /// The unique id for a context annotation domain.
    id: string,
    /// Name of the context annotation domain.
    name: option<string>
  }

  /// Represents the data for the context annotation entity.
  record context-annotation-entity-fields {
    /// Description of the context annotation entity.
    description: option<string>,
    /// The unique id for a context annotation entity.
    id: string,
    /// Name of the context annotation entity.
    name: option<string>
  }

  /// Unique identifier of this Tweet. This is returned as a string in order to avoid complications with languages and tools that cannot handle large integers.
  record tweet-id {
    /// opaque schema; raw JSON
    value: string
  }

  record tweet-edit-controls {
    /// Time when Tweet is no longer editable.
    editable-until: string,
    /// Number of times this Tweet can be edited.
    edits-remaining: s32,
    /// Indicates if this Tweet is eligible to be edited.
    is-edit-eligible: bool
  }

  record full-text-entities {
    annotations: option<list<full-text-entities-annotations-item>>,
    cashtags: option<list<cashtag-entity>>,
    hashtags: option<list<hashtag-entity>>,
    mentions: option<list<mention-entity>>,
    urls: option<list<url-entity>>
  }

  /// Annotation for entities based on the Tweet text.
  record full-text-entities-annotations-item {
    /// Index (zero-based) at which position this entity ends.  The index is inclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Text used to determine annotation.
    normalized-text: option<string>,
    /// Confidence factor for annotation type.
    probability: option<f64>,
    /// Annotation type.
    type-op: option<string>
  }

  record cashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    tag: string
  }

  record hashtag-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// The text of the Hashtag.
    tag: string
  }

  record mention-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    id: option<user-id>,
    username: user-name
  }

  /// The Twitter handle (screen name) of this user.
  record user-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the portion of text recognized as a URL, and its start and end position within the text.
  record url-entity {
    /// Index (zero-based) at which position this entity ends.  The index is exclusive.
    end: s32,
    /// Index (zero-based) at which position this entity starts.  The index is inclusive.
    start: s32,
    /// Description of the URL landing page.
    description: option<string>,
    /// The URL as displayed in the Twitter client.
    display-url: option<string>,
    expanded-url: option<url>,
    images: option<list<url-image>>,
    media-key: option<media-key>,
    status: option<http-status-code>,
    /// Title of the page the URL points to.
    title: option<string>,
    /// Fully resolved url.
    unwound-url: option<string>,
    url: url
  }

  /// A validly formatted URL.
  record url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent the information for the URL image.
  record url-image {
    height: option<media-height>,
    url: option<url>,
    width: option<media-width>
  }

  /// The height of the media in pixels.
  record media-height {
    /// opaque schema; raw JSON
    value: string
  }

  /// The width of the media in pixels.
  record media-width {
    /// opaque schema; raw JSON
    value: string
  }

  /// HTTP Status Code.
  record http-status-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// The location tagged on the Tweet, if the user provided one.
  record tweet-geo {
    coordinates: option<point>,
    place-id: option<place-id>
  }

  /// A [GeoJson Point](https://tools.ietf.org/html/rfc7946#section-3.1.2) geometry object.
  record point {
    coordinates: position,
    type-op: point-type-op-enum
  }

  /// A [GeoJson Position](https://tools.ietf.org/html/rfc7946#section-3.1.1) in the format `[longitude,latitude]`.
  record position {
    /// opaque schema; raw JSON
    value: string
  }

  /// The identifier for this place.
  record place-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// Nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-non-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>
  }

  /// Organic nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-organic-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  /// Promoted nonpublic engagement metrics for the Tweet at the time of the request.
  record tweet-promoted-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: option<s32>,
    /// Number of times this Tweet has been liked.
    like-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: option<s32>,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: option<s32>
  }

  /// Engagement metrics for the Tweet at the time of the request.
  record tweet-public-metrics {
    /// Number of times this Tweet has been viewed.
    impression-count: s32,
    /// Number of times this Tweet has been liked.
    like-count: s32,
    /// Number of times this Tweet has been quoted.
    quote-count: option<s32>,
    /// Number of times this Tweet has been replied to.
    reply-count: s32,
    /// Number of times this Tweet has been Retweeted.
    retweet-count: s32
  }

  record tweet-referenced-tweets-item {
    id: tweet-id,
    type-op: tweet-referenced-tweets-item-type-op-enum
  }

  /// Shows who can reply a Tweet. Fields returned are everyone, mentioned_users, and following.
  record reply-settings {
    /// opaque schema; raw JSON
    value: string
  }

  /// The content of the Tweet.
  record tweet-text {
    /// opaque schema; raw JSON
    value: string
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record tweet-withheld {
    /// Indicates if the content is being withheld for on the basis of copyright infringement.
    copyright: bool,
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates whether the content being withheld is the `tweet` or a `user`.
    scope: option<tweet-withheld-scope-enum>
  }

  /// A two-letter ISO 3166-1 alpha-2 country code.
  record country-code {
    /// opaque schema; raw JSON
    value: string
  }

  /// An HTTP Problem Details object, as defined in IETF RFC 7807 (https://tools.ietf.org/html/rfc7807).
  record problem {
    detail: option<string>,
    status: option<s32>,
    title: string,
    type-op: string
  }

  record expansions {
    media: option<list<media>>,
    places: option<list<place>>,
    polls: option<list<poll>>,
    topics: option<list<topic>>,
    tweets: option<list<tweet>>,
    users: option<list<user>>
  }

  record media {
    height: option<media-height>,
    media-key: option<media-key>,
    type-op: string,
    width: option<media-width>
  }

  record place {
    contained-within: option<list<place-id>>,
    /// The full name of the county in which this place exists.
    country: option<string>,
    country-code: option<country-code>,
    /// The full name of this place.
    full-name: string,
    geo: option<geo>,
    id: place-id,
    /// The human readable name of this place.
    name: option<string>,
    place-type: option<place-type>
  }

  record geo {
    bbox: list<f64>,
    geometry: option<point>,
    properties: geo-properties,
    type-op: geo-type-op-enum
  }

  record geo-properties {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record place-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// Represent a Poll attached to a Tweet.
  record poll {
    duration-minutes: option<s32>,
    end-datetime: option<string>,
    id: poll-id,
    options: list<poll-option>,
    voting-status: option<poll-voting-status-enum>
  }

  /// Describes a choice in a Poll object.
  record poll-option {
    label: poll-option-label,
    /// Position of this choice in the poll.
    position: s32,
    /// Number of users who voted for this choice.
    votes: s32
  }

  /// The text of a poll choice.
  record poll-option-label {
    /// opaque schema; raw JSON
    value: string
  }

  /// The topic of a Space, as selected by its creator.
  record topic {
    /// The description of the given topic.
    description: option<string>,
    id: topic-id,
    /// The name of the given topic.
    name: string
  }

  /// Unique identifier of this Topic.
  record topic-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The Twitter User object.
  record user {
    /// Creation time of this User.
    created-at: option<string>,
    /// The text of this User's profile description (also known as bio), if the User provided one.
    description: option<string>,
    /// A list of metadata found in the User's profile description.
    entities: option<user-entities>,
    id: user-id,
    /// The location specified in the User's profile, if the User provided one. As this is a freeform value, it may not indicate a valid location, but it may be fuzzily evaluated when performing searches with location queries.
    location: option<string>,
    /// The friendly name of this User, as shown on their profile.
    name: string,
    pinned-tweet-id: option<tweet-id>,
    /// The URL to the profile image for this User.
    profile-image-url: option<string>,
    /// Indicates if this User has chosen to protect their Tweets (in other words, if this User's Tweets are private).
    protected: option<bool>,
    /// A list of metrics for this User.
    public-metrics: option<user-public-metrics>,
    /// The URL specified in the User's profile.
    url: option<string>,
    username: user-name,
    /// Indicate if this User is a verified Twitter User.
    verified: option<bool>,
    /// The Twitter Blue verified type of the user, eg: blue, government, business or none.
    verified-type: option<string>,
    withheld: option<user-withheld>
  }

  /// A list of metadata found in the User's profile description.
  record user-entities {
    description: option<full-text-entities>,
    /// Expanded details for the URL specified in the User's profile, with start and end indices.
    url: option<user-entities-url>
  }

  /// Expanded details for the URL specified in the User's profile, with start and end indices.
  record user-entities-url {
    urls: option<list<url-entity>>
  }

  /// A list of metrics for this User.
  record user-public-metrics {
    /// Number of Users who are following this User.
    followers-count: s32,
    /// Number of Users this User is following.
    following-count: s32,
    /// The number of lists that include this User.
    listed-count: s32,
    /// The number of Tweets (including Retweets) posted by this User.
    tweet-count: s32
  }

  /// Indicates withholding details for [withheld content](https://help.twitter.com/en/rules-and-policies/tweet-withheld-by-country).
  record user-withheld {
    /// Provides a list of countries where this content is not available.
    country-codes: list<country-code>,
    /// Indicates that the content being withheld is a `user`.
    scope: option<user-withheld-scope-enum>
  }

  record get2-users-id-bookmarks-response-meta {
    next-token: option<next-token>,
    previous-token: option<previous-token>,
    result-count: option<result-count>
  }

  /// The next token.
  record next-token {
    /// opaque schema; raw JSON
    value: string
  }

  /// The previous token.
  record previous-token {
    /// opaque schema; raw JSON
    value: string
  }

  /// The number of results returned in this response.
  record result-count {
    /// opaque schema; raw JSON
    value: string
  }

  record bookmark-mutation-response {
    data: option<bookmark-mutation-response-data>,
    errors: option<list<problem>>
  }

  record bookmark-mutation-response-data {
    bookmarked: option<bool>
  }

  /// Bookmarks by User
  record get-users-id-bookmarks-params {
    /// The ID of the authenticated source User for whom to return results.
    id: string,
    /// The maximum number of results.
    max-results: option<s32>,
    /// This parameter is used to get the next 'page' of results.
    pagination-token: option<pagination-token36>,
    /// A comma separated list of Tweet fields to display.
    tweet-fields: option<list<get-users-id-bookmarks-tweet-fields-item-enum>>,
    /// A comma separated list of fields to expand.
    expansions: option<list<get-users-id-bookmarks-expansions-item-enum>>,
    /// A comma separated list of Media fields to display.
    media-fields: option<list<get-users-id-bookmarks-media-fields-item-enum>>,
    /// A comma separated list of Poll fields to display.
    poll-fields: option<list<get-users-id-bookmarks-poll-fields-item-enum>>,
    /// A comma separated list of User fields to display.
    user-fields: option<list<get-users-id-bookmarks-user-fields-item-enum>>,
    /// A comma separated list of Place fields to display.
    place-fields: option<list<get-users-id-bookmarks-place-fields-item-enum>>
  }
  get-users-id-bookmarks: func(params: get-users-id-bookmarks-params) -> result<get2-users-id-bookmarks-response, string>;

  /// Add Tweet to Bookmarks
  record post-users-id-bookmarks-params {
    /// The ID of the authenticated source User for whom to add bookmarks.
    id: string,
    tweet-id: tweet-id
  }
  post-users-id-bookmarks: func(params: post-users-id-bookmarks-params) -> result<bookmark-mutation-response, string>;

  /// Remove a bookmarked Tweet
  record users-id-bookmarks-delete-params {
    /// The ID of the authenticated source User whose bookmark is to be removed.
    id: string,
    /// The ID of the Tweet that the source User is removing from bookmarks.
    tweet-id: string
  }
  users-id-bookmarks-delete: func(params: users-id-bookmarks-delete-params) -> result<bookmark-mutation-response, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export compliance;
  export direct-messages;
  export lists;
  export users;
  export tweets;
  export general;
  export spaces;
  export bookmarks;
}
