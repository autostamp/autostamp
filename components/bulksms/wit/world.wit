/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `basicAuth` | `Authorization: Basic base64(<secret>)` |
package autostamp:bulksms@0.5.0;

interface blocked-numbers {
  record blocked-number {
    /// A unique identifier that is assigned when the BlockedNumber is created.
    id: f64,
    phone-number: phone-number
  }

  /// A phone number in E.164 format
  record phone-number {
    /// opaque schema; raw JSON
    value: string
  }

  /// List blocked numbers
  record get-blocked-numbers-params {
    /// Records with an `id` that is greater or equal to min-id will be returned. The default value is `0`.  You can add 1 to an id that you previously retrieved, to return subsequent records.
    min-id: option<s32>,
    /// The maximum number of records to return. The default value is `10000`. The value cannot be greater than 10000.
    limit: option<s32>
  }
  get-blocked-numbers: func(params: get-blocked-numbers-params) -> result<blocked-number, string>;

  /// Create a blocked number
  record post-blocked-numbers-params {
    body: list<phone-number>
  }
  post-blocked-numbers: func(params: post-blocked-numbers-params) -> result<string, string>;

}


interface credits {
  variant post-credit-transfer-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  /// Transfer credits to another account
  record post-credit-transfer-params {
    /// An optional note that will be shown on the credit history of your account.
    /// The maximum length of the comment is 100.
    comment-on-from: option<string>,
    /// An optional note that will be shown on the credit history of the recipient's account.
    /// The maximum length of the comment is 100.
    comment-on-to: option<string>,
    /// The amount of credits to transfer.
    credits: f64,
    /// The numeric user ID of the account that will receive the credits.
    /// The ID must match the username.
    to-user-id: f64,
    /// The username of the account that will receive the credits.
    to-username: string
  }
  post-credit-transfer: func(params: post-credit-transfer-params) -> result<string, post-credit-transfer-error>;

}

interface message {
  enum get-messages-sort-order-enum {
    ascending,
  }

  enum message-encoding-enum {
    text,
    unicode,
    binary,
  }

  enum message-status-subtype-enum {
    expired,
    handset-error,
    blocked,
    not-sent,
  }

  enum message-status-type-op-enum {
    accepted,
    scheduled,
    sent,
    delivered,
    unknown,
    failed,
  }

  enum message-type-op-enum {
    sent,
    received,
  }

  enum submission-entry-delivery-reports-enum {
    all,
    errors,
    none,
  }

  enum submission-entry-from-op-type-op-enum {
    international,
    alphanumeric,
    shortcode,
    repliable,
  }

  enum submission-entry-message-class-enum {
    flash-sms,
    me-specific,
    sim-specific,
    te-specific,
  }

  enum submission-entry-protocol-id-enum {
    implicit,
    short-message-type-v0,
    replace-message-v1,
    replace-message-v2,
    replace-message-v3,
    replace-message-v4,
    replace-message-v5,
    replace-message-v6,
    replace-message-v7,
    return-call,
    me-download,
    me-depersonalize,
    sim-download,
  }

  enum submission-entry-routing-group-enum {
    economy,
    standard,
    premium,
  }

  enum submission-entry-to-item-type-op-enum {
    international,
    group,
  }

  record message {
    /// The content of the message
    body: string,
    /// The cost of the message (in credits).   Note that this field does not have a value in the submission response.
    credit-cost: option<f64>,
    /// The type of the content.  See the `encoding` field for more information.
    encoding: option<message-encoding-enum>,
    /// The address part of the sender id
    from-op: option<string>,
    /// A unique identifier that is assigned when the message is created.
    id: string,
    /// See the `messageClass` field for more information.
    message-class: option<s32>,
    /// The number of parts.  If this is a concatenated message, the number of parts will be more than 1.  Note that this field does not have a value in the submission response.
    number-of-parts: option<s32>,
    /// See the `protocolId` field for more information.
    protocol-id: option<s32>,
    /// This field has a value only if the type is RECEIVED.
    /// With SMS messages, it is not possible to link a reply directly with a specific sent message.  However, if you specified `REPLIABLE` in the `from` property, BulkSMS will link any reply to the most recent message sent to a given phone number.
    related-sent-message-id: option<string>,
    /// The status of the message
    status: message-status,
    /// Identifies the submission.
    submission: option<message-submission>,
    /// The phone number of the recipient
    to: string,
    /// The message direction
    type-op: message-type-op-enum,
    /// This is the value you supplied in the `userSuppliedId` field.
    /// Has a value only if the `type` is SENT.
    user-supplied-id: option<string>
  }

  /// The status of the message
  record message-status {
    /// A concatenated value A.B where A is the `status.type` and B is the `status.subtype`.  
    /// It there is no value for `subtype` then B takes string value `"null"` (e.g. `"SENT.null"`).   
    id: string,
    /// Has a value only if the `type` is FAILED.
    /// 
    subtype: option<message-status-subtype-enum>,
    /// 
    /// ACCEPTED  Message accepted for delivery. Only returned for initial message submissions.
    type-op: message-status-type-op-enum
  }

  /// Identifies the submission.
  record message-submission {
    /// The date and time the submission was processed. If the `type` is RECEIVED, this field reflects the date and time the received message was processed.
    date: string,
    /// A unique identity shared by all messages that were created from the same submission. This field should be ignored if the `type` is not SENT.
    id: string
  }

  /// An object that you use when posting messages.
  record submission-entry {
    /// The message content as described in the `encoding`. If the `encoding` is BINARY, the body must contain only hexadecimal digits where one byte is represented as two digits. For example, if you want to send two bytes '0x05' and '0x1F', the message body must contain the text '051F'.
    /// 
    body: string,
    /// The type of delivery reports to request from the delivering network.
    /// The default value  is `ALL`. Please note that not all networks support delivery reports.
    delivery-reports: option<submission-entry-delivery-reports-enum>,
    /// Describes the content of the message body.
    /// 
    encoding: option<message-encoding-enum>,
    /// Identifies the sender.
    /// 
    from-op: option<submission-entry-from-op>,
    /// The maximum number of message parts that can be used for a [concatenated message](https://en.wikipedia.org/wiki/Concatenated_SMS).
    /// The default is `3`.
    long-message-max-parts: option<s32>,
    /// The class of the message, as specified by §4 of the GSM 03.38 specification.
    /// 
    message-class: option<submission-entry-message-class-enum>,
    /// The TP-PID value from GSM 03.40[.750] §9.2.3.9.
    /// 
    protocol-id: option<submission-entry-protocol-id-enum>,
    /// Allows you to choose routing. The default is STANDARD.
    routing-group: option<submission-entry-routing-group-enum>,
    /// Identifies the recipients
    /// 
    to: list<submission-entry-to-item>,
    /// Correlate the messages created from this submission to your data.
    /// 
    user-supplied-id: option<string>
  }

  /// Identifies the sender.
  /// 
  /// Instead of a structured object, you can supply a string value here. 
  /// If you do this, the `type` of the sender is derived to be either INTERNATIONAL or ALPHANUMERIC.  If the value does not begin with a `+` and it contains at least one character that is not a digit, the type is detected as ALPHANUMERIC. Otherwise, the type is detected as INTERNATIONAL.
  record submission-entry-from-op {
    /// The address of the sender id.
    /// 
    address: option<string>,
    /// The type of the sender id.
    /// 
    type-op: submission-entry-from-op-type-op-enum
  }

  record submission-entry-to-item {
    /// The phone number of the recipient.  It must be supplied if the `type` is INTERNATIONAL
    address: option<string>,
    /// Custom fields that can be used in the message body. A value can be given if the `type` is INTERNATIONAL
    /// 
    fields: option<list<string>>,
    /// The id of a group in your phonebook.  A value can be given if the `type` is GROUP.
    id: option<string>,
    /// The name of a group in your phonebook. A value can be given if the `type` is GROUP.
    name: option<string>,
    /// Type of the recipient. The default value is INTERNATIONAL.
    type-op: option<submission-entry-to-item-type-op-enum>
  }

  variant get-messages-error {
    bad-request(string),
    other(string)
  }

  variant post-messages-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant get-messages-send-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  variant get-messages-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant get-messages-id-related-received-messages-error {
    bad-request(string),
    other(string)
  }

  /// Retrieve Messages
  record get-messages-params {
    /// The maximum number of messages that are returned.  The default is 1000.
    /// The value of `limit` is not a guarantee that a specific number of messages will be in the response, even if there are more messages available.  Consider the case where you have 150 messages and you specify `limit=50`.  It is possible that only 49 messages will be returned.  The  way to make sure that there are no more messages is to submit a new call using the `id` filter field with the `<` operator (described below).
    limit: option<f64>,
    /// See the message filtering for more information.
    filter: option<string>,
    /// The default value is DESCENDING
    /// 
    sort-order: option<get-messages-sort-order-enum>
  }
  get-messages: func(params: get-messages-params) -> result<list<message>, get-messages-error>;

  /// Send Messages
  record post-messages-params {
    /// Safeguards against the possibility of sending the same messages more than once.
    /// 
    deduplication-id: option<s32>,
    /// Specifies how to deal with message text that contains characters not present in the GSM 03.38 character set.
    /// 
    auto-unicode: option<bool>,
    /// Allows you to send a message in the future.
    /// 
    schedule-date: option<string>,
    /// A note that is stored together with a scheduled submission, which could be used to more easily identify the scheduled submission at a later date.
    /// 
    schedule-description: option<string>,
    body: list<submission-entry>
  }
  post-messages: func(params: post-messages-params) -> result<list<message>, post-messages-error>;

  /// Send message by simple GET or POST
  record get-messages-send-params {
    /// The phone number of the recipient.
    to: string,
    /// The text you want to send.
    body: string,
    /// Refer to the `deduplication-id` parameter.
    deduplication-id: option<s32>
  }
  get-messages-send: func(params: get-messages-send-params) -> result<list<message>, get-messages-send-error>;

  /// Show Message
  record get-messages-id-params {
    /// The `id` of the message you want to retrieve
    id: string
  }
  get-messages-id: func(params: get-messages-id-params) -> result<message, get-messages-id-error>;

  /// List Related Messages
  record get-messages-id-related-received-messages-params {
    /// The `id` of the sent message
    id: string
  }
  get-messages-id-related-received-messages: func(params: get-messages-id-related-received-messages-params) -> result<list<message>, get-messages-id-related-received-messages-error>;

}

interface profile {
  record profile {
    commerce: option<profile-commerce>,
    company: option<profile-company>,
    created: string,
    credits: profile-credits,
    id: string,
    origin-addresses: option<profile-origin-addresses>,
    quota: profile-quota,
    username: string
  }

  record profile-commerce {
    address: option<profile-commerce-address>,
    bank-payment-reference: option<string>
  }

  record profile-commerce-address {
    city: option<string>,
    country: option<string>,
    postal-code: option<string>,
    region: option<string>,
    street: option<list<string>>
  }

  record profile-company {
    name: option<string>,
    tax-reference: option<string>
  }

  record profile-credits {
    balance: option<f64>,
    is-transfer-allowed: option<bool>,
    limit: option<s32>
  }

  record profile-origin-addresses {
    allowed: option<list<string>>,
    is-full-control-allowed: option<bool>
  }

  record profile-quota {
    /// The number of messages you can still send today.
    remaining: s32,
    /// The setting that limits the number of messages you can send in a day.
    size: s32
  }

  /// Get profile
  get-profile: func() -> result<profile, string>;

}

interface attachments {
  record pre-sign-info {
    /// The URL you use in your SMS text.  It is the file location.
    fetch-url: option<string>,
    /// Name value objects to add to the headers of the PUT request.
    fields: option<list<pre-sign-info-fields-item>>,
    /// The address of the PUT request to upload the file.
    put-url: option<string>
  }

  record pre-sign-info-fields-item {
    /// The header name
    name: option<string>,
    /// The header value
    value: option<string>
  }

  /// Upload an attachment via a signed URL
  record post-rmm-pre-sign-attachment-params {
    /// The extension of the file.  Usually related to the media type.
    file-extension: option<string>,
    /// The media type of the file you would like to upload.  If you are not sure what value to use here, check out the standard [list of media types](https://www.iana.org/assignments/media-types/media-types.xhtml).
    media-type: option<string>
  }
  post-rmm-pre-sign-attachment: func(params: post-rmm-pre-sign-attachment-params) -> result<pre-sign-info, string>;

}

interface webhooks {
  enum webhook-entry-invoke-option-enum {
    one,
    many,
  }

  enum webhook-entry-trigger-scope-enum {
    sent,
    received,
  }

  record webhook {
    active: option<bool>,
    contact-email-address: option<string>,
    id: option<f64>,
    name: option<string>,
    on-web-app: option<bool>,
    trigger-scope: option<string>,
    url: option<string>
  }

  variant post-webhooks-error {
    bad-request(string),
    other(string)
  }

  variant get-webhooks-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant post-webhooks-id-error {
    not-found(string),
    other(string)
  }

  variant delete-webhooks-id-error {
    not-found(string),
    other(string)
  }

  /// List webhooks
  get-webhooks: func() -> result<list<webhook>, string>;

  /// Create a webhook
  record post-webhooks-params {
    /// Indicates whether you want the webhook activated.
    /// 
    active: option<bool>,
    /// The email address to which emails will be sent if there are problem with invoking the webhook.
    /// 
    contact-email-address: option<string>,
    /// Specifies how to invoke your webhook.
    /// 
    invoke-option: option<webhook-entry-invoke-option-enum>,
    /// A text identifier for the webhook.
    /// More than one webhook cannot have the same name.
    name: string,
    /// Indicates whether you want to show this webhook on the Web App.
    /// 
    on-web-app: option<bool>,
    /// Specifies when the webhook will be triggered.  
    /// 
    trigger-scope: webhook-entry-trigger-scope-enum,
    /// The location of the webhook.
    /// 
    url: string
  }
  post-webhooks: func(params: post-webhooks-params) -> result<webhook, post-webhooks-error>;

  /// Read a webhook
  record get-webhooks-id-params {
    /// The `id` of the webhook
    id: string
  }
  get-webhooks-id: func(params: get-webhooks-id-params) -> result<webhook, get-webhooks-id-error>;

  /// Update a webhook
  record post-webhooks-id-params {
    /// The `id` of the webhook
    id: string,
    /// Indicates whether you want the webhook activated.
    /// 
    active: option<bool>,
    /// The email address to which emails will be sent if there are problem with invoking the webhook.
    /// 
    contact-email-address: option<string>,
    /// Specifies how to invoke your webhook.
    /// 
    invoke-option: option<webhook-entry-invoke-option-enum>,
    /// A text identifier for the webhook.
    /// More than one webhook cannot have the same name.
    name: string,
    /// Indicates whether you want to show this webhook on the Web App.
    /// 
    on-web-app: option<bool>,
    /// Specifies when the webhook will be triggered.  
    /// 
    trigger-scope: webhook-entry-trigger-scope-enum,
    /// The location of the webhook.
    /// 
    url: string
  }
  post-webhooks-id: func(params: post-webhooks-id-params) -> result<webhook, post-webhooks-id-error>;

  /// Delete a webhook
  record delete-webhooks-id-params {
    /// The `id` of the webhook
    id: string
  }
  delete-webhooks-id: func(params: delete-webhooks-id-params) -> result<string, delete-webhooks-id-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export blocked-numbers;
  export credits;
  export message;
  export profile;
  export attachments;
  export webhooks;
}
