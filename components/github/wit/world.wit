  /// Specify which security and analysis features to enable or disable for the repository.
  /// 
  /// To use this parameter, you must have admin permissions for the repository or be an owner or security manager for the organization that owns the repository. For more information, see "[Managing security managers in your organization](https://docs.github.com/organizations/managing-peoples-access-to-your-organization-with-roles/managing-security-managers-in-your-organization)."
  /// 
  /// For example, to enable GitHub Advanced Security, use this data in the body of the `PATCH` request:
  /// `{ "security_and_analysis": {"advanced_security": { "status": "enabled" } } }`.
  /// 
  /// You can check which security and analysis features are currently enabled by using a `GET /repos/{owner}/{repo}` request.
  record update-body-security-and-analysis {
    /// Use the `status` property to enable or disable GitHub Advanced Security for this repository. For more information, see "[About GitHub Advanced Security](/github/getting-started-with-github/learning-about-github/about-github-advanced-security)."
    advanced-security: option<update-body-security-and-analysis-advanced-security>,
    /// Use the `status` property to enable or disable secret scanning for this repository. For more information, see "[About secret scanning](/code-security/secret-security/about-secret-scanning)."
    secret-scanning: option<update-body-security-and-analysis-secret-scanning>,
    /// Use the `status` property to enable or disable secret scanning push protection for this repository. For more information, see "[Protecting pushes with secret scanning](/code-security/secret-scanning/protecting-pushes-with-secret-scanning)."
    secret-scanning-push-protection: option<update-body-security-and-analysis-secret-scanning-push-protection>
  }

  /// Use the `status` property to enable or disable GitHub Advanced Security for this repository. For more information, see "[About GitHub Advanced Security](/github/getting-started-with-github/learning-about-github/about-github-advanced-security)."
  record update-body-security-and-analysis-advanced-security {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// Use the `status` property to enable or disable secret scanning for this repository. For more information, see "[About secret scanning](/code-security/secret-security/about-secret-scanning)."
  record update-body-security-and-analysis-secret-scanning {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// Use the `status` property to enable or disable secret scanning push protection for this repository. For more information, see "[Protecting pushes with secret scanning](/code-security/secret-scanning/protecting-pushes-with-secret-scanning)."
  record update-body-security-and-analysis-secret-scanning-push-protection {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// An autolink reference.
  record autolink {
    id: s32,
    /// Whether this autolink reference matches alphanumeric characters. If false, this autolink reference only matches numeric characters.
    is-alphanumeric: bool,
    /// The prefix of a key that is linkified.
    key-prefix: string,
    /// A template for the target URL that is generated if a key was found.
    url-template: string
  }

  /// Short Branch
  record short-branch {
    commit: short-branch-commit,
    name: string,
    protected: bool,
    protection: option<branch-protection>,
    protection-url: option<string>
  }

  record short-branch-commit {
    sha: string,
    url: string
  }

  /// Branch Protection
  record branch-protection {
    allow-deletions: option<branch-protection-allow-deletions>,
    allow-force-pushes: option<branch-protection-allow-force-pushes>,
    /// Whether users can pull changes from upstream when the branch is locked. Set to `true` to allow fork syncing. Set to `false` to prevent fork syncing.
    allow-fork-syncing: option<branch-protection-allow-fork-syncing>,
    block-creations: option<branch-protection-block-creations>,
    enabled: option<bool>,
    enforce-admins: option<protected-branch-admin-enforced>,
    /// Whether to set the branch as read-only. If this is true, users will not be able to push to the branch.
    lock-branch: option<branch-protection-lock-branch>,
    name: option<string>,
    protection-url: option<string>,
    required-conversation-resolution: option<branch-protection-required-conversation-resolution>,
    required-linear-history: option<branch-protection-required-linear-history>,
    required-pull-request-reviews: option<protected-branch-pull-request-review>,
    required-signatures: option<branch-protection-required-signatures>,
    required-status-checks: option<protected-branch-required-status-check>,
    restrictions: option<branch-restriction-policy>,
    url: option<string>
  }

  record branch-protection-allow-deletions {
    enabled: option<bool>
  }

  record branch-protection-allow-force-pushes {
    enabled: option<bool>
  }

  /// Whether users can pull changes from upstream when the branch is locked. Set to `true` to allow fork syncing. Set to `false` to prevent fork syncing.
  record branch-protection-allow-fork-syncing {
    enabled: option<bool>
  }

  record branch-protection-block-creations {
    enabled: option<bool>
  }

  /// Protected Branch Admin Enforced
  record protected-branch-admin-enforced {
    enabled: bool,
    url: string
  }

  /// Whether to set the branch as read-only. If this is true, users will not be able to push to the branch.
  record branch-protection-lock-branch {
    enabled: option<bool>
  }

  record branch-protection-required-conversation-resolution {
    enabled: option<bool>
  }

  record branch-protection-required-linear-history {
    enabled: option<bool>
  }

  /// Protected Branch Pull Request Review
  record protected-branch-pull-request-review {
    /// Allow specific users, teams, or apps to bypass pull request requirements.
    bypass-pull-request-allowances: option<protected-branch-pull-request-review-bypass-pull-request-allowances>,
    dismiss-stale-reviews: bool,
    dismissal-restrictions: option<protected-branch-pull-request-review-dismissal-restrictions>,
    require-code-owner-reviews: bool,
    /// Whether the most recent push must be approved by someone other than the person who pushed it.
    require-last-push-approval: option<bool>,
    required-approving-review-count: option<s32>,
    url: option<string>
  }

  /// Allow specific users, teams, or apps to bypass pull request requirements.
  record protected-branch-pull-request-review-bypass-pull-request-allowances {
    /// The list of apps allowed to bypass pull request requirements.
    apps: option<list<integration>>,
    /// The list of teams allowed to bypass pull request requirements.
    teams: option<list<team>>,
    /// The list of users allowed to bypass pull request requirements.
    users: option<list<simple-user>>
  }

  /// GitHub apps are a new way to extend GitHub. They can be installed directly on organizations and user accounts and granted access to specific repositories. They come with granular permissions and built-in webhooks. GitHub apps are first class actors within GitHub.
  record integration {
    client-id: option<string>,
    client-secret: option<string>,
    created-at: string,
    description: string,
    /// The list of events for the GitHub app
    events: list<string>,
    external-url: string,
    html-url: string,
    /// Unique identifier of the GitHub app
    id: s32,
    /// The number of installations associated with the GitHub app
    installations-count: option<s32>,
    /// The name of the GitHub app
    name: string,
    node-id: string,
    owner: nullable-simple-user,
    pem: option<string>,
    /// The set of permissions for the GitHub app
    permissions: integration-permissions,
    /// The slug name of the GitHub app
    slug: option<string>,
    updated-at: string,
    webhook-secret: option<string>
  }

  /// The set of permissions for the GitHub app
  record integration-permissions {
    checks: option<string>,
    contents: option<string>,
    deployments: option<string>,
    issues: option<string>,
    metadata: option<string>
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record team {
    description: string,
    html-url: string,
    id: s32,
    members-url: string,
    name: string,
    node-id: string,
    parent: nullable-team-simple,
    permission: string,
    permissions: option<team-permissions>,
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    url: string
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record nullable-team-simple {
    /// Description of the team
    description: string,
    html-url: string,
    /// Unique identifier of the team
    id: s32,
    /// Distinguished Name (DN) that team maps to within LDAP environment
    ldap-dn: option<string>,
    members-url: string,
    /// Name of the team
    name: string,
    node-id: string,
    /// Permission that the team will have for its repositories
    permission: string,
    /// The level of privacy this team should have
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    /// URL for the team
    url: string
  }

  record team-permissions {
    admin: bool,
    maintain: bool,
    pull: bool,
    push: bool,
    triage: bool
  }

  record protected-branch-pull-request-review-dismissal-restrictions {
    /// The list of apps with review dismissal access.
    apps: option<list<integration>>,
    /// The list of teams with review dismissal access.
    teams: option<list<team>>,
    teams-url: option<string>,
    url: option<string>,
    /// The list of users with review dismissal access.
    users: option<list<simple-user>>,
    users-url: option<string>
  }

  record branch-protection-required-signatures {
    enabled: bool,
    url: string
  }

  /// Protected Branch Required Status Check
  record protected-branch-required-status-check {
    checks: list<protected-branch-required-status-check-checks-item>,
    contexts: list<string>,
    contexts-url: option<string>,
    enforcement-level: option<string>,
    strict: option<bool>,
    url: option<string>
  }

  record protected-branch-required-status-check-checks-item {
    app-id: s32,
    context: string
  }

  /// Branch Restriction Policy
  record branch-restriction-policy {
    apps: list<branch-restriction-policy-apps-item>,
