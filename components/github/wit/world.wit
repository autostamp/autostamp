  /// Replace all repository topics
  record replace-all-topics-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// An array of topics to add to the repository. Pass one or more topics to _replace_ the set of existing topics. Send an empty array (`[]`) to clear all topics from the repository. **Note:** Topic `names` cannot contain uppercase letters.
    names: list<string>
  }
  replace-all-topics: func(params: replace-all-topics-params) -> result<topic, replace-all-topics-error>;

  /// Get repository clones
  record get-clones-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The time frame to display results for.
    per: option<get-clones-per-enum>
  }
  get-clones: func(params: get-clones-params) -> result<clone-traffic, get-clones-error>;

  /// Get top referral paths
  record get-top-paths-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-top-paths: func(params: get-top-paths-params) -> result<list<content-traffic>, get-top-paths-error>;

  /// Get top referral sources
  record get-top-referrers-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-top-referrers: func(params: get-top-referrers-params) -> result<list<referrer-traffic>, get-top-referrers-error>;

  /// Get page views
  record get-views-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The time frame to display results for.
    per: option<get-clones-per-enum>
  }
  get-views: func(params: get-views-params) -> result<view-traffic, get-views-error>;

  /// Transfer a repository
  record transfer-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The new name to be given to the repository.
    new-name: option<string>,
    /// The username or organization name the repository will be transferred to.
    new-owner: string,
    /// ID of the team or teams to add to the repository. Teams can only be added to organization-owned repositories.
    team-ids: option<list<s32>>
  }
  transfer: func(params: transfer-params) -> result<minimal-repository, string>;

  /// Check if vulnerability alerts are enabled for a repository
  record check-vulnerability-alerts-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  check-vulnerability-alerts: func(params: check-vulnerability-alerts-params) -> result<string, check-vulnerability-alerts-error>;

  /// Enable vulnerability alerts
  record enable-vulnerability-alerts-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  enable-vulnerability-alerts: func(params: enable-vulnerability-alerts-params) -> result<string, string>;

  /// Disable vulnerability alerts
  record disable-vulnerability-alerts-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  disable-vulnerability-alerts: func(params: disable-vulnerability-alerts-params) -> result<string, string>;

  /// Download a repository archive (zip)
  record download-zipball-archive-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    ref: string
  }
  download-zipball-archive: func(params: download-zipball-archive-params) -> result<string, download-zipball-archive-error>;

  /// Create a repository using a template
  record create-using-template-params {
    template-owner: string,
    template-repo: string,
    /// A short description of the new repository.
    description: option<string>,
    /// Set to `true` to include the directory structure and files from all branches in the template repository, and not just the default branch. Default: `false`.
    include-all-branches: option<bool>,
    /// The name of the new repository.
    name: string,
    /// The organization or person who will own the new repository. To create a new repository in an organization, the authenticated user must be a member of the specified organization.
    owner: option<string>,
    /// Either `true` to create a new private repository or `false` to create a new public one.
    private: option<bool>
  }
  create-using-template: func(params: create-using-template-params) -> result<repository, string>;

  /// List public repositories
  record list-public-params {
    /// A repository ID. Only return repositories with an ID greater than this ID.
    since: option<s32>
  }
  list-public: func(params: list-public-params) -> result<list<minimal-repository>, list-public-error>;

  /// List repositories for the authenticated user
  record list-for-authenticated-user-params {
    /// Limit results to repositories with the specified visibility.
    visibility: option<list-for-authenticated-user-visibility-enum>,
    /// Comma-separated list of values. Can include:  
    ///  * `owner`: Repositories that are owned by the authenticated user.  
    affiliation: option<string>,
    /// Limit results to repositories of the specified type. Will cause a `422` error if used in the same request as **visibility** or **affiliation**.
    type-op: option<list-for-authenticated-user-type-op-enum>,
    /// The property to sort the results by.
    sort: option<list-for-org-sort-enum>,
    /// The order to sort by. Default: `asc` when using `full_name`, otherwise `desc`.
    direction: option<list-for-org-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// Only show notifications updated before the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    before: option<string>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<list<repository>, list-for-authenticated-user-error>;

  /// Create a repository for the authenticated user
  record create-for-authenticated-user-params {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether the repository is initialized with a minimal README.
    auto-init: option<bool>,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    /// A short description of the repository.
    description: option<string>,
    /// The desired language or platform to apply to the .gitignore.
    gitignore-template: option<string>,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: option<bool>,
    /// Whether issues are enabled.
    has-issues: option<bool>,
    /// Whether projects are enabled.
    has-projects: option<bool>,
    /// Whether the wiki is enabled.
    has-wiki: option<bool>,
    /// A URL with more information about the repository.
    homepage: option<string>,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    /// The license keyword of the open source license for this repository.
    license-template: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<create-in-org-body-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<create-in-org-body-merge-commit-title-enum>,
    /// The name of the repository.
    name: string,
    /// Whether the repository is private.
    private: option<bool>,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<create-in-org-body-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<create-in-org-body-squash-merge-commit-title-enum>,
    /// The id of the team that will be granted access to this repository. This is only valid when creating a repository in an organization.
    team-id: option<s32>
  }
  create-for-authenticated-user: func(params: create-for-authenticated-user-params) -> result<repository, create-for-authenticated-user-error>;

  /// List repository invitations for the authenticated user
  record list-invitations-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-invitations-for-authenticated-user: func(params: list-invitations-for-authenticated-user-params) -> result<list<repository-invitation>, list-invitations-for-authenticated-user-error>;

  /// Accept a repository invitation
  record accept-invitation-for-authenticated-user-params {
    /// The unique identifier of the invitation.
    invitation-id: string
  }
  accept-invitation-for-authenticated-user: func(params: accept-invitation-for-authenticated-user-params) -> result<string, accept-invitation-for-authenticated-user-error>;

  /// Decline a repository invitation
  record decline-invitation-for-authenticated-user-params {
    /// The unique identifier of the invitation.
    invitation-id: string
  }
  decline-invitation-for-authenticated-user: func(params: decline-invitation-for-authenticated-user-params) -> result<string, decline-invitation-for-authenticated-user-error>;

  /// List repositories for a user
  record list-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// Limit results to repositories of the specified type.
    type-op: option<list-for-user-type-op-enum>,
    /// The property to sort the results by.
    sort: option<list-for-org-sort-enum>,
    /// The order to sort by. Default: `asc` when using `full_name`, otherwise `desc`.
    direction: option<list-for-org-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-user: func(params: list-for-user-params) -> result<list<minimal-repository>, string>;

}

interface billing {
  record actions-billing-usage {
    /// The amount of free GitHub Actions minutes available.
    included-minutes: s32,
    minutes-used-breakdown: actions-billing-usage-minutes-used-breakdown,
    /// The sum of the free and paid GitHub Actions minutes used.
    total-minutes-used: s32,
    /// The total paid GitHub Actions minutes used.
    total-paid-minutes-used: s32
  }

  record actions-billing-usage-minutes-used-breakdown {
    /// Total minutes used on macOS runner machines.
    macos: option<s32>,
    /// Total minutes used on Ubuntu runner machines.
    ubuntu: option<s32>,
    /// Total minutes used on Windows runner machines.
    windows: option<s32>,
    /// Total minutes used on macOS 12 core runner machines.
    macos-v12-core: option<s32>,
    /// Total minutes used on all runner machines.
    total: option<s32>,
    /// Total minutes used on Ubuntu 16 core runner machines.
    ubuntu-v16-core: option<s32>,
    /// Total minutes used on Ubuntu 32 core runner machines.
    ubuntu-v32-core: option<s32>,
    /// Total minutes used on Ubuntu 4 core runner machines.
    ubuntu-v4-core: option<s32>,
    /// Total minutes used on Ubuntu 64 core runner machines.
    ubuntu-v64-core: option<s32>,
    /// Total minutes used on Ubuntu 8 core runner machines.
    ubuntu-v8-core: option<s32>,
    /// Total minutes used on Windows 16 core runner machines.
    windows-v16-core: option<s32>,
    /// Total minutes used on Windows 32 core runner machines.
    windows-v32-core: option<s32>,
    /// Total minutes used on Windows 4 core runner machines.
    windows-v4-core: option<s32>,
    /// Total minutes used on Windows 64 core runner machines.
    windows-v64-core: option<s32>,
    /// Total minutes used on Windows 8 core runner machines.
    windows-v8-core: option<s32>
  }

  record packages-billing-usage {
    /// Free storage space (GB) for GitHub Packages.
    included-gigabytes-bandwidth: s32,
    /// Sum of the free and paid storage space (GB) for GitHuub Packages.
    total-gigabytes-bandwidth-used: s32,
    /// Total paid storage space (GB) for GitHuub Packages.
    total-paid-gigabytes-bandwidth-used: s32
  }

  record combined-billing-usage {
    /// Numbers of days left in billing cycle.
    days-left-in-billing-cycle: s32,
    /// Estimated storage space (GB) used in billing cycle.
    estimated-paid-storage-for-month: s32,
    /// Estimated sum of free and paid storage space (GB) used in billing cycle.
    estimated-storage-for-month: s32
  }

  /// Get GitHub Actions billing for an organization
  record get-github-actions-billing-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-github-actions-billing-org: func(params: get-github-actions-billing-org-params) -> result<actions-billing-usage, string>;

  /// Get GitHub Packages billing for an organization
  record get-github-packages-billing-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-github-packages-billing-org: func(params: get-github-packages-billing-org-params) -> result<packages-billing-usage, string>;

  /// Get shared storage billing for an organization
  record get-shared-storage-billing-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-shared-storage-billing-org: func(params: get-shared-storage-billing-org-params) -> result<combined-billing-usage, string>;

  /// Get GitHub Actions billing for a user
  record get-github-actions-billing-user-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-github-actions-billing-user: func(params: get-github-actions-billing-user-params) -> result<actions-billing-usage, string>;

  /// Get GitHub Packages billing for a user
  record get-github-packages-billing-user-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-github-packages-billing-user: func(params: get-github-packages-billing-user-params) -> result<packages-billing-usage, string>;

  /// Get shared storage billing for a user
  record get-shared-storage-billing-user-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-shared-storage-billing-user: func(params: get-shared-storage-billing-user-params) -> result<combined-billing-usage, string>;

}

interface teams {
  enum create-body-permission-enum {
    pull,
    push,
  }

  enum create-body-privacy-enum {
    secret,
    closed,
  }

  enum team-full-privacy-enum {
    closed,
    secret,
  }

  enum update-in-org-body-permission-enum {
    pull,
    push,
    admin,
  }

  enum list-discussions-in-org-direction-enum {
    asc,
    desc,
  }

  enum list-members-in-org-role-enum {
    member,
    maintainer,
    all,
  }

  enum team-membership-role-enum {
    member,
    maintainer,
  }

  enum team-membership-state-enum {
    active,
    pending,
  }

  enum add-or-update-project-permissions-in-org-body-permission-enum {
    read,
    write,
    admin,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum nullable-repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum nullable-repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum nullable-repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum nullable-repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record team {
    description: string,
    html-url: string,
    id: s32,
    members-url: string,
    name: string,
    node-id: string,
    parent: nullable-team-simple,
    permission: string,
    permissions: option<team-permissions>,
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    url: string
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record nullable-team-simple {
    /// Description of the team
    description: string,
    html-url: string,
    /// Unique identifier of the team
    id: s32,
    /// Distinguished Name (DN) that team maps to within LDAP environment
    ldap-dn: option<string>,
    members-url: string,
    /// Name of the team
    name: string,
    node-id: string,
    /// Permission that the team will have for its repositories
    permission: string,
    /// The level of privacy this team should have
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    /// URL for the team
    url: string
  }

  record team-permissions {
    admin: bool,
    maintain: bool,
    pull: bool,
    push: bool,
    triage: bool
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record team-full {
    created-at: string,
    description: string,
    html-url: string,
    /// Unique identifier of the team
    id: s32,
    /// Distinguished Name (DN) that team maps to within LDAP environment
    ldap-dn: option<string>,
    members-count: s32,
    members-url: string,
    /// Name of the team
    name: string,
    node-id: string,
    organization: team-organization,
    parent: option<nullable-team-simple>,
    /// Permission that the team will have for its repositories
    permission: string,
    /// The level of privacy this team should have
    privacy: option<team-full-privacy-enum>,
    repos-count: s32,
    repositories-url: string,
    slug: string,
    updated-at: string,
    /// URL for the team
    url: string
  }

  /// Team Organization
  record team-organization {
    avatar-url: string,
    billing-email: option<string>,
    blog: option<string>,
    collaborators: option<s32>,
    company: option<string>,
    created-at: string,
    default-repository-permission: option<string>,
    description: string,
    disk-usage: option<s32>,
    email: option<string>,
    events-url: string,
    followers: s32,
    following: s32,
    has-organization-projects: bool,
    has-repository-projects: bool,
    hooks-url: string,
    html-url: string,
    id: s32,
    is-verified: option<bool>,
    issues-url: string,
    location: option<string>,
    login: string,
    members-allowed-repository-creation-type: option<string>,
    members-can-create-internal-repositories: option<bool>,
    members-can-create-pages: option<bool>,
    members-can-create-private-pages: option<bool>,
    members-can-create-private-repositories: option<bool>,
    members-can-create-public-pages: option<bool>,
    members-can-create-public-repositories: option<bool>,
    members-can-create-repositories: option<bool>,
    members-can-fork-private-repositories: option<bool>,
    members-url: string,
    name: option<string>,
    node-id: string,
    owned-private-repos: option<s32>,
    plan: option<team-organization-plan>,
    private-gists: option<s32>,
    public-gists: s32,
    public-members-url: string,
    public-repos: s32,
    repos-url: string,
    total-private-repos: option<s32>,
    twitter-username: option<string>,
    two-factor-requirement-enabled: option<bool>,
    type-op: string,
    updated-at: string,
    url: string,
    web-commit-signoff-required: option<bool>
  }

  record team-organization-plan {
    filled-seats: option<s32>,
    name: string,
    private-repos: s32,
    seats: option<s32>,
    space: s32
  }

  /// A team discussion is a persistent record of a free-form conversation within a team.
  record team-discussion {
    author: nullable-simple-user,
    /// The main text of the discussion.
    body: string,
    body-html: string,
    /// The current version of the body content. If provided, this update operation will be rejected if the given version does not match the latest version on the server.
    body-version: string,
    comments-count: s32,
    comments-url: string,
    created-at: string,
    html-url: string,
    last-edited-at: string,
    node-id: string,
    /// The unique sequence number of a team discussion.
    number: s32,
    /// Whether or not this discussion should be pinned for easy retrieval.
    pinned: bool,
    /// Whether or not this discussion should be restricted to team members and organization administrators.
    private: bool,
    reactions: option<reaction-rollup>,
    team-url: string,
    /// The title of the discussion.
    title: string,
    updated-at: string,
    url: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record reaction-rollup {
    v1: s32,
    v1-v2: s32,
    confused: s32,
    eyes: s32,
    heart: s32,
    hooray: s32,
    laugh: s32,
    rocket: s32,
    total-count: s32,
    url: string
  }

  /// A reply to a discussion within a team.
  record team-discussion-comment {
    author: nullable-simple-user,
    /// The main text of the comment.
    body: string,
    body-html: string,
    /// The current version of the body content. If provided, this update operation will be rejected if the given version does not match the latest version on the server.
    body-version: string,
    created-at: string,
    discussion-url: string,
    html-url: string,
    last-edited-at: string,
    node-id: string,
    /// The unique sequence number of a team discussion comment.
    number: s32,
    reactions: option<reaction-rollup>,
    updated-at: string,
    url: string
  }

  /// Organization Invitation
  record organization-invitation {
    created-at: string,
    email: string,
    failed-at: option<string>,
    failed-reason: option<string>,
    id: s32,
    invitation-source: option<string>,
    invitation-teams-url: string,
    inviter: simple-user,
    login: string,
    node-id: string,
    role: string,
    team-count: s32
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Team Membership
  record team-membership {
    /// The role of the user in the team.
    role: team-membership-role-enum,
    /// The state of the user's membership in the team.
    state: team-membership-state-enum,
    url: string
  }

  /// A team's access to a project.
  record team-project {
    body: string,
    columns-url: string,
    created-at: string,
    creator: simple-user,
    html-url: string,
    id: s32,
    name: string,
    node-id: string,
    number: s32,
    /// The organization permission for this project. Only present when owner is an organization.
    organization-permission: option<string>,
    owner-url: string,
    permissions: team-project-permissions,
    /// Whether the project is private or not. Only present when owner is an organization.
    private: option<bool>,
    state: string,
    updated-at: string,
    url: string
  }

  record team-project-permissions {
    admin: bool,
    read: bool,
    write: bool
  }

  /// Minimal Repository
  record minimal-repository {
    allow-forking: option<bool>,
    archive-url: string,
    archived: option<bool>,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: option<string>,
    code-of-conduct: option<code-of-conduct>,
    collaborators-url: string,
