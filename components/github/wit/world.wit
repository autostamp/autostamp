    repo: string
  }
  list-in-repository-for-authenticated-user: func(params: list-in-repository-for-authenticated-user-params) -> result<string, string>;

  /// Create a codespace in a repository
  record create-with-repo-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
