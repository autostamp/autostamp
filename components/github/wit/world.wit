interface checks {
  enum checks-create-body-conclusion-enum {
    action-required,
    cancelled,
    failure,
    neutral,
    success,
    skipped,
    stale,
    timed-out,
  }

  enum checks-create-body-output-annotations-item-annotation-level-enum {
    notice,
    warning,
    failure,
  }

  enum checks-create-body-status-enum {
    queued,
    in-progress,
    completed,
  }

  enum checks-list-for-suite-filter-enum {
    latest,
    all,
  }

  record checks-create-body-actions-item {
    /// A short explanation of what this action would do. The maximum size is 40 characters.
    description: string,
    /// A reference for the action on the integrator's system. The maximum size is 20 characters.
    identifier: string,
    /// The text to be displayed on a button in the web UI. The maximum size is 20 characters.
    label: string
  }

  /// Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run.
  record checks-create-body-output {
    /// Adds information from your analysis to specific lines of code. Annotations are visible on GitHub in the **Checks** and **Files changed** tab of the pull request. The Checks API limits the number of annotations to a maximum of 50 per API request. To create more than 50 annotations, you have to make multiple requests to the [Update a check run](https://docs.github.com/rest/reference/checks#update-a-check-run) endpoint. Each time you update the check run, annotations are appended to the list of annotations that already exist for the check run. For details about how you can view annotations on GitHub, see "[About status checks](https://docs.github.com/articles/about-status-checks#checks)".
    annotations: option<list<checks-create-body-output-annotations-item>>,
    /// Adds images to the output displayed in the GitHub pull request UI.
    images: option<list<checks-create-body-output-images-item>>,
    /// The summary of the check run. This parameter supports Markdown. **Maximum length**: 65535 characters.
    summary: string,
    /// The details of the check run. This parameter supports Markdown. **Maximum length**: 65535 characters.
    text: option<string>,
    /// The title of the check run.
    title: string
  }

  record checks-create-body-output-annotations-item {
    /// The level of the annotation.
    annotation-level: checks-create-body-output-annotations-item-annotation-level-enum,
    /// The end column of the annotation. Annotations only support `start_column` and `end_column` on the same line. Omit this parameter if `start_line` and `end_line` have different values.
    end-column: option<s32>,
    /// The end line of the annotation.
    end-line: s32,
    /// A short description of the feedback for these lines of code. The maximum size is 64 KB.
    message: string,
    /// The path of the file to add an annotation to. For example, `assets/css/main.css`.
    path: string,
    /// Details about this annotation. The maximum size is 64 KB.
    raw-details: option<string>,
    /// The start column of the annotation. Annotations only support `start_column` and `end_column` on the same line. Omit this parameter if `start_line` and `end_line` have different values. Column numbers start at 1.
    start-column: option<s32>,
    /// The start line of the annotation. Line numbers start at 1.
    start-line: s32,
    /// The title that represents the annotation. The maximum size is 255 characters.
    title: option<string>
  }

  record checks-create-body-output-images-item {
    /// The alternative text for the image.
    alt: string,
    /// A short image description.
    caption: option<string>,
    /// The full URL of the image.
    image-url: string
  }

  record checks-update-body-actions-item {
    /// A short explanation of what this action would do. The maximum size is 40 characters.
    description: string,
    /// A reference for the action on the integrator's system. The maximum size is 20 characters.
    identifier: string,
    /// The text to be displayed on a button in the web UI. The maximum size is 20 characters.
    label: string
  }

  /// Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run.
  record checks-update-body-output {
    /// Adds information from your analysis to specific lines of code. Annotations are visible in GitHub's pull request UI. Annotations are visible in GitHub's pull request UI. The Checks API limits the number of annotations to a maximum of 50 per API request. To create more than 50 annotations, you have to make multiple requests to the [Update a check run](https://docs.github.com/rest/reference/checks#update-a-check-run) endpoint. Each time you update the check run, annotations are appended to the list of annotations that already exist for the check run. For details about annotations in the UI, see "[About status checks](https://docs.github.com/articles/about-status-checks#checks)".
    annotations: option<list<checks-update-body-output-annotations-item>>,
    /// Adds images to the output displayed in the GitHub pull request UI.
    images: option<list<checks-update-body-output-images-item>>,
    /// Can contain Markdown.
    summary: string,
    /// Can contain Markdown.
    text: option<string>,
    /// **Required**.
    title: option<string>
  }

  record checks-update-body-output-annotations-item {
    /// The level of the annotation.
    annotation-level: checks-create-body-output-annotations-item-annotation-level-enum,
    /// The end column of the annotation. Annotations only support `start_column` and `end_column` on the same line. Omit this parameter if `start_line` and `end_line` have different values.
    end-column: option<s32>,
    /// The end line of the annotation.
    end-line: s32,
    /// A short description of the feedback for these lines of code. The maximum size is 64 KB.
    message: string,
    /// The path of the file to add an annotation to. For example, `assets/css/main.css`.
    path: string,
    /// Details about this annotation. The maximum size is 64 KB.
    raw-details: option<string>,
    /// The start column of the annotation. Annotations only support `start_column` and `end_column` on the same line. Omit this parameter if `start_line` and `end_line` have different values. Column numbers start at 1.
    start-column: option<s32>,
    /// The start line of the annotation. Line numbers start at 1.
    start-line: s32,
    /// The title that represents the annotation. The maximum size is 255 characters.
    title: option<string>
  }

  record checks-update-body-output-images-item {
    /// The alternative text for the image.
    alt: string,
    /// A short image description.
    caption: option<string>,
    /// The full URL of the image.
    image-url: string
  }

  record checks-set-suites-preferences-body-auto-trigger-checks-item {
    /// The `id` of the GitHub App.
    app-id: s32,
    /// Set to `true` to enable automatic creation of CheckSuite events upon pushes to the repository, or `false` to disable them.
    setting: bool
  }

  /// Create a check run
  record checks-create-params {
    /// Displays a button on GitHub that can be clicked to alert your app to do additional tasks. For example, a code linting app can display a button that automatically fixes detected errors. The button created in this object is displayed after the check run completes. When a user clicks the button, GitHub sends the [`check_run.requested_action` webhook](https://docs.github.com/webhooks/event-payloads/#check_run) to your app. Each action includes a `label`, `identifier` and `description`. A maximum of three actions are accepted. To learn more about check runs and requested actions, see "[Check runs and requested actions](https://docs.github.com/rest/reference/checks#check-runs-and-requested-actions)."
    actions: option<list<checks-create-body-actions-item>>,
    /// The time the check completed. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    completed-at: option<string>,
    /// **Required if you provide `completed_at` or a `status` of `completed`**. The final conclusion of the check. 
    /// **Note:** Providing `conclusion` will automatically set the `status` parameter to `completed`. You cannot change a check run conclusion to `stale`, only GitHub can set this.
    conclusion: option<checks-create-body-conclusion-enum>,
    /// The URL of the integrator's site that has the full details of the check. If the integrator does not provide this, then the homepage of the GitHub app is used.
    details-url: option<string>,
    /// A reference for the run on the integrator's system.
    external-id: option<string>,
    /// The SHA of the commit.
    head-sha: string,
    /// The name of the check. For example, "code-coverage".
    name: string,
    /// Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run.
    output: option<checks-create-body-output>,
    /// The time that the check run began. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    started-at: option<string>,
    /// The current status.
    status: option<checks-create-body-status-enum>
  }
  checks-create: func(params: checks-create-params) -> result<string, string>;

  /// Get a check run
  checks-get: func() -> result<string, string>;

  /// Update a check run
  record checks-update-params {
    /// Possible further actions the integrator can perform, which a user may trigger. Each action includes a `label`, `identifier` and `description`. A maximum of three actions are accepted. See the [`actions` object](https://docs.github.com/rest/reference/checks#actions-object) description. To learn more about check runs and requested actions, see "[Check runs and requested actions](https://docs.github.com/rest/reference/checks#check-runs-and-requested-actions)."
    actions: option<list<checks-update-body-actions-item>>,
    /// The time the check completed. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    completed-at: option<string>,
    /// **Required if you provide `completed_at` or a `status` of `completed`**. The final conclusion of the check. 
    /// **Note:** Providing `conclusion` will automatically set the `status` parameter to `completed`. You cannot change a check run conclusion to `stale`, only GitHub can set this.
    conclusion: option<checks-create-body-conclusion-enum>,
    /// The URL of the integrator's site that has the full details of the check.
    details-url: option<string>,
    /// A reference for the run on the integrator's system.
    external-id: option<string>,
    /// The name of the check. For example, "code-coverage".
    name: option<string>,
    /// Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run.
    output: option<checks-update-body-output>,
    /// This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    started-at: option<string>,
    /// The current status.
    status: option<checks-create-body-status-enum>
  }
  checks-update: func(params: checks-update-params) -> result<string, string>;

  /// List check run annotations
  checks-list-annotations: func() -> result<string, string>;

  /// Rerequest a check run
  checks-rerequest-run: func() -> result<string, string>;

  /// Create a check suite
  record checks-create-suite-params {
    /// The sha of the head commit.
    head-sha: string
  }
  checks-create-suite: func(params: checks-create-suite-params) -> result<string, string>;

  /// Update repository preferences for check suites
  record checks-set-suites-preferences-params {
    /// Enables or disables automatic creation of CheckSuite events upon pushes to the repository. Enabled by default.
    auto-trigger-checks: option<list<checks-set-suites-preferences-body-auto-trigger-checks-item>>
  }
  checks-set-suites-preferences: func(params: checks-set-suites-preferences-params) -> result<string, string>;

  /// Get a check suite
  checks-get-suite: func() -> result<string, string>;

  /// List check runs in a check suite
  record checks-list-for-suite-params {
    /// Filters check runs by their `completed_at` timestamp. `latest` returns the most recent check runs.
    filter: option<checks-list-for-suite-filter-enum>
  }
  checks-list-for-suite: func(params: checks-list-for-suite-params) -> result<string, string>;

  /// Rerequest a check suite
  checks-rerequest-suite: func() -> result<string, string>;

  /// List check runs for a Git reference
  record checks-list-for-ref-params {
    /// ref parameter
    ref: string,
    /// Filters check runs by their `completed_at` timestamp. `latest` returns the most recent check runs.
    filter: option<checks-list-for-suite-filter-enum>,
    app-id: option<s32>
  }
  checks-list-for-ref: func(params: checks-list-for-ref-params) -> result<string, string>;

  /// List check suites for a Git reference
  record checks-list-suites-for-ref-params {
    /// ref parameter
    ref: string,
    /// Filters check suites by GitHub App `id`.
    app-id: option<s32>
  }
  checks-list-suites-for-ref: func(params: checks-list-suites-for-ref-params) -> result<string, string>;

}

interface dependency-graph {
  /// A description of the detector used.
  record snapshot-detector {
    /// The name of the detector used.
    name: string,
    /// The url of the detector used.
    url: string,
    /// The version of the detector used.
    version: string
  }

  record snapshot-job {
    /// Correlator provides a key that is used to group snapshots submitted over time. Only the "latest" submitted snapshot for a given combination of `job.correlator` and `detector.name` will be considered when calculating a repository's current dependencies. Correlator should be as unique as it takes to distinguish all detection runs for a given "wave" of CI workflow you run. If you're using GitHub Actions, a good default value for this could be the environment variables GITHUB_WORKFLOW and GITHUB_JOB concatenated together. If you're using a build matrix, then you'll also need to add additional key(s) to distinguish between each submission inside a matrix variation.
    correlator: string,
    /// The url for the job.
    html-url: option<string>,
    /// The external ID of the job.
    id: string
  }

  /// A collection of package manifests, which are a collection of related dependencies declared in a file or representing a logical group of dependencies.
  record snapshot-manifests {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// User-defined metadata to store domain-specific information limited to 8 keys with scalar values.
  record metadata {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Get a diff of the dependencies between commits
  record dependency-graph-diff-range-params {
    /// The base and head Git revisions to compare. The Git revisions will be resolved to commit SHAs. Named revisions will be resolved to their corresponding HEAD commits, and an appropriate merge base will be determined. This parameter expects the format `{base}...{head}`.
    basehead: string
  }
  dependency-graph-diff-range: func(params: dependency-graph-diff-range-params) -> result<string, string>;

  /// Create a snapshot of dependencies for a repository
  record dependency-graph-create-repository-snapshot-params {
    /// A description of the detector used.
    detector: snapshot-detector,
    job: snapshot-job,
    /// A collection of package manifests, which are a collection of related dependencies declared in a file or representing a logical group of dependencies.
    manifests: option<snapshot-manifests>,
    metadata: option<metadata>,
    /// The repository branch that triggered this snapshot.
    ref: string,
    /// The time at which the snapshot was scanned.
    scanned: string,
    /// The commit SHA associated with this dependency snapshot. Maximum length: 40 characters.
    sha: string,
    /// The version of the repository snapshot submission.
    version: s32
  }
  dependency-graph-create-repository-snapshot: func(params: dependency-graph-create-repository-snapshot-params) -> result<string, string>;

}

interface git {
  enum git-create-tag-body-type-op-enum {
    commit,
    tree,
    blob,
  }

  enum git-create-tree-body-tree-item-mode-enum {
    v100644,
    v100755,
    v040000,
    v160000,
    v120000,
  }

  enum git-create-tree-body-tree-item-type-op-enum {
    blob,
    tree,
    commit,
  }

  /// Information about the author of the commit. By default, the `author` will be the authenticated user and the current date. See the `author` and `committer` object below for details.
  record git-create-commit-body-author {
    /// Indicates when this commit was authored (or committed). This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    date: option<string>,
    /// The email of the author (or committer) of the commit
    email: string,
    /// The name of the author (or committer) of the commit
    name: string
  }

  /// Information about the person who is making the commit. By default, `committer` will use the information set in `author`. See the `author` and `committer` object below for details.
  record git-create-commit-body-committer {
    /// Indicates when this commit was authored (or committed). This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    date: option<string>,
    /// The email of the author (or committer) of the commit
    email: option<string>,
    /// The name of the author (or committer) of the commit
    name: option<string>
  }

  /// An object with information about the individual creating the tag.
  record git-create-tag-body-tagger {
    /// When this object was tagged. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    date: option<string>,
    /// The email of the author of the tag
    email: string,
    /// The name of the author of the tag
    name: string
  }

  record git-create-tree-body-tree-item {
    /// The content you want this file to have. GitHub will write this blob out and use that SHA for this entry. Use either this, or `tree.sha`.  
    ///   
    content: option<string>,
    /// The file mode; one of `100644` for file (blob), `100755` for executable (blob), `040000` for subdirectory (tree), `160000` for submodule (commit), or `120000` for a blob that specifies the path of a symlink.
    mode: option<git-create-tree-body-tree-item-mode-enum>,
    /// The file referenced in the tree.
    path: option<string>,
    /// The SHA1 checksum ID of the object in the tree. Also called `tree.sha`. If the value is `null` then the file will be deleted.  
    ///   
    sha: option<string>,
    /// Either `blob`, `tree`, or `commit`.
    type-op: option<git-create-tree-body-tree-item-type-op-enum>
  }

  /// Create a blob
  record git-create-blob-params {
    /// The new blob's content.
    content: string,
    /// The encoding used for `content`. Currently, `"utf-8"` and `"base64"` are supported.
    encoding: option<string>
  }
  git-create-blob: func(params: git-create-blob-params) -> result<string, string>;

  /// Get a blob
  record git-get-blob-params {
    file-sha: string
  }
  git-get-blob: func(params: git-get-blob-params) -> result<string, string>;

  /// Create a commit
  record git-create-commit-params {
    /// Information about the author of the commit. By default, the `author` will be the authenticated user and the current date. See the `author` and `committer` object below for details.
    author: option<git-create-commit-body-author>,
    /// Information about the person who is making the commit. By default, `committer` will use the information set in `author`. See the `author` and `committer` object below for details.
    committer: option<git-create-commit-body-committer>,
    /// The commit message
    message: string,
    /// The SHAs of the commits that were the parents of this commit. If omitted or empty, the commit will be written as a root commit. For a single parent, an array of one SHA should be provided; for a merge commit, an array of more than one should be provided.
    parents: option<list<string>>,
    /// The [PGP signature](https://en.wikipedia.org/wiki/Pretty_Good_Privacy) of the commit. GitHub adds the signature to the `gpgsig` header of the created commit. For a commit signature to be verifiable by Git or GitHub, it must be an ASCII-armored detached PGP signature over the string commit as it would be written to the object database. To pass a `signature` parameter, you need to first manually create a valid PGP signature, which can be complicated. You may find it easier to [use the command line](https://git-scm.com/book/id/v2/Git-Tools-Signing-Your-Work) to create signed commits.
    signature: option<string>,
    /// The SHA of the tree object this commit points to
    tree: string
  }
  git-create-commit: func(params: git-create-commit-params) -> result<string, string>;

  /// Get a commit
  git-get-commit: func() -> result<string, string>;

  /// List matching references
  record git-list-matching-refs-params {
    /// ref parameter
    ref: string
  }
  git-list-matching-refs: func(params: git-list-matching-refs-params) -> result<string, string>;

  /// Get a reference
  record git-get-ref-params {
    /// ref parameter
    ref: string
  }
  git-get-ref: func(params: git-get-ref-params) -> result<string, string>;

  /// Create a reference
  record git-create-ref-params {
    key: option<string>,
    /// The name of the fully qualified reference (ie: `refs/heads/master`). If it doesn't start with 'refs' and have at least two slashes, it will be rejected.
    ref: string,
    /// The SHA1 value for this reference.
    sha: string
  }
  git-create-ref: func(params: git-create-ref-params) -> result<string, string>;

  /// Update a reference
  record git-update-ref-params {
    /// The name of the fully qualified reference to update. For example, `refs/heads/master`. If the value doesn't start with `refs` and have at least two slashes, it will be rejected.
    ref: string,
    /// Indicates whether to force the update or to make sure the update is a fast-forward update. Leaving this out or setting it to `false` will make sure you're not overwriting work.
    force: option<bool>,
    /// The SHA1 value to set this reference to
    sha: string
  }
  git-update-ref: func(params: git-update-ref-params) -> result<string, string>;

  /// Delete a reference
  record git-delete-ref-params {
    /// ref parameter
    ref: string
  }
  git-delete-ref: func(params: git-delete-ref-params) -> result<string, string>;

  /// Create a tag object
  record git-create-tag-params {
    /// The tag message.
    message: string,
    /// The SHA of the git object this is tagging.
    object: string,
    /// The tag's name. This is typically a version (e.g., "v0.0.1").
    tag: string,
    /// An object with information about the individual creating the tag.
    tagger: option<git-create-tag-body-tagger>,
    /// The type of the object we're tagging. Normally this is a `commit` but it can also be a `tree` or a `blob`.
    type-op: git-create-tag-body-type-op-enum
  }
  git-create-tag: func(params: git-create-tag-params) -> result<string, string>;

  /// Get a tag
  record git-get-tag-params {
    tag-sha: string
  }
  git-get-tag: func(params: git-get-tag-params) -> result<string, string>;

  /// Create a tree
  record git-create-tree-params {
    /// The SHA1 of an existing Git tree object which will be used as the base for the new tree. If provided, a new Git tree object will be created from entries in the Git tree object pointed to by `base_tree` and entries defined in the `tree` parameter. Entries defined in the `tree` parameter will overwrite items from `base_tree` with the same `path`. If you're creating new changes on a branch, then normally you'd set `base_tree` to the SHA1 of the Git tree object of the current latest commit on the branch you're working on.
    /// If not provided, GitHub will create a new Git tree object from only the entries defined in the `tree` parameter. If you create a new commit pointing to such a tree, then all files which were a part of the parent commit's tree and were not defined in the `tree` parameter will be listed as deleted by the new commit.
    base-tree: option<string>,
    /// Objects (of `path`, `mode`, `type`, and `sha`) specifying a tree structure.
    tree: list<git-create-tree-body-tree-item>
  }
  git-create-tree: func(params: git-create-tree-params) -> result<string, string>;

  /// Get a tree
  record git-get-tree-params {
    tree-sha: string,
    /// Setting this parameter to any value returns the objects or subtrees referenced by the tree specified in `:tree_sha`. For example, setting `recursive` to any of the following will enable returning objects or subtrees: `0`, `1`, `"true"`, and `"false"`. Omit this parameter to prevent recursively returning objects or subtrees.
    recursive: option<string>
  }
  git-get-tree: func(params: git-get-tree-params) -> result<string, string>;

}

interface pulls {
  enum pulls-list-state-enum {
    open,
    closed,
    all,
  }

  enum pulls-list-sort-enum {
    created,
    updated,
    popularity,
    long-running,
  }

  enum pulls-list-direction-enum {
    asc,
    desc,
  }

  enum pulls-list-review-comments-for-repo-sort-enum {
    created,
    updated,
    created-at,
  }

  enum pulls-update-body-state-enum {
    open,
    closed,
  }

  enum pulls-create-review-comment-body-side-enum {
    left,
    right,
  }

  enum pulls-create-review-comment-body-start-side-enum {
    left,
    right,
    side,
  }

  enum pulls-merge-body-merge-method-enum {
    merge,
    squash,
    rebase,
  }

  enum pulls-create-review-body-event-enum {
    approve,
    request-changes,
    comment,
  }

  enum pulls-dismiss-review-body-event-enum {
    dismiss,
  }

  record pulls-create-review-body-comments-item {
    /// Text of the review comment.
    body: string,
    line: option<s32>,
    /// The relative path to the file that necessitates a review comment.
    path: string,
    /// The position in the diff where you want to add a review comment. Note this value is not the same as the line number in the file. For help finding the position value, read the note below.
    position: option<s32>,
    side: option<string>,
    start-line: option<s32>,
    start-side: option<string>
  }

  /// List pull requests
  record pulls-list-params {
    /// Either `open`, `closed`, or `all` to filter by state.
    state: option<pulls-list-state-enum>,
    /// Filter pulls by head user or head organization and branch name in the format of `user:ref-name` or `organization:ref-name`. For example: `github:new-script-format` or `octocat:test-branch`.
    head: option<string>,
    /// Filter pulls by base branch name. Example: `gh-pages`.
    base: option<string>,
    /// What to sort results by. `popularity` will sort by the number of comments. `long-running` will sort by date created and will limit the results to pull requests that have been open for more than a month and have had activity within the past month.
    sort: option<pulls-list-sort-enum>,
    /// The direction of the sort. Default: `desc` when sort is `created` or sort is not specified, otherwise `asc`.
    direction: option<pulls-list-direction-enum>
  }
  pulls-list: func(params: pulls-list-params) -> result<string, string>;

  /// Create a pull request
  record pulls-create-params {
    /// The name of the branch you want the changes pulled into. This should be an existing branch on the current repository. You cannot submit a pull request to one repository that requests a merge to a base of another repository.
    base: string,
    /// The contents of the pull request.
    body: option<string>,
    /// Indicates whether the pull request is a draft. See "[Draft Pull Requests](https://docs.github.com/articles/about-pull-requests#draft-pull-requests)" in the GitHub Help documentation to learn more.
    draft: option<bool>,
    /// The name of the branch where your changes are implemented. For cross-repository pull requests in the same network, namespace `head` with a user like this: `username:branch`.
    head: string,
    /// The name of the repository where the changes in the pull request were made. This field is required for cross-repository pull requests if both repositories are owned by the same organization.
    head-repo: option<string>,
    /// An issue in the repository to convert to a pull request. The issue title, body, and comments will become the title, body, and comments on the new pull request. Required unless `title` is specified.
    issue: option<s32>,
    /// Indicates whether [maintainers can modify](https://docs.github.com/articles/allowing-changes-to-a-pull-request-branch-created-from-a-fork/) the pull request.
    maintainer-can-modify: option<bool>,
    /// The title of the new pull request. Required unless `issue` is specified.
    title: option<string>
  }
  pulls-create: func(params: pulls-create-params) -> result<string, string>;

  /// List review comments in a repository
  record pulls-list-review-comments-for-repo-params {
    sort: option<pulls-list-review-comments-for-repo-sort-enum>,
    /// The direction to sort results. Ignored without `sort` parameter.
    direction: option<pulls-list-direction-enum>
  }
  pulls-list-review-comments-for-repo: func(params: pulls-list-review-comments-for-repo-params) -> result<string, string>;

  /// Get a review comment for a pull request
  pulls-get-review-comment: func() -> result<string, string>;

  /// Update a review comment for a pull request
  record pulls-update-review-comment-params {
    /// The text of the reply to the review comment.
    body: string
  }
  pulls-update-review-comment: func(params: pulls-update-review-comment-params) -> result<string, string>;

  /// Delete a review comment for a pull request
  pulls-delete-review-comment: func() -> result<string, string>;

  /// Get a pull request
  pulls-get: func() -> result<string, string>;

  /// Update a pull request
  record pulls-update-params {
    /// The name of the branch you want your changes pulled into. This should be an existing branch on the current repository. You cannot update the base branch on a pull request to point to another repository.
    base: option<string>,
    /// The contents of the pull request.
    body: option<string>,
    /// Indicates whether [maintainers can modify](https://docs.github.com/articles/allowing-changes-to-a-pull-request-branch-created-from-a-fork/) the pull request.
    maintainer-can-modify: option<bool>,
    /// State of this Pull Request. Either `open` or `closed`.
    state: option<pulls-update-body-state-enum>,
    /// The title of the pull request.
    title: option<string>
  }
  pulls-update: func(params: pulls-update-params) -> result<string, string>;

  /// List review comments on a pull request
  record pulls-list-review-comments-params {
    /// The direction to sort results. Ignored without `sort` parameter.
    direction: option<pulls-list-direction-enum>
  }
  pulls-list-review-comments: func(params: pulls-list-review-comments-params) -> result<string, string>;

  /// Create a review comment for a pull request
  record pulls-create-review-comment-params {
    /// The text of the review comment.
    body: string,
    /// The SHA of the commit needing a comment. Not using the latest commit SHA may render your comment outdated if a subsequent commit modifies the line you specify as the `position`.
    commit-id: string,
    /// The ID of the review comment to reply to. To find the ID of a review comment with ["List review comments on a pull request"](#list-review-comments-on-a-pull-request). When specified, all parameters other than `body` in the request body are ignored.
    in-reply-to: option<s32>,
    /// The line of the blob in the pull request diff that the comment applies to. For a multi-line comment, the last line of the range that your comment applies to.
    line: s32,
    /// The relative path to the file that necessitates a comment.
    path: string,
    /// **This parameter is deprecated. Use `line` instead**. The position in the diff where you want to add a review comment. Note this value is not the same as the line number in the file. For help finding the position value, read the note above.
    position: option<s32>,
    /// In a split diff view, the side of the diff that the pull request's changes appear on. Can be `LEFT` or `RIGHT`. Use `LEFT` for deletions that appear in red. Use `RIGHT` for additions that appear in green or unchanged lines that appear in white and are shown for context. For a multi-line comment, side represents whether the last line of the comment range is a deletion or addition. For more information, see "[Diff view options](https://docs.github.com/articles/about-comparing-branches-in-pull-requests#diff-view-options)" in the GitHub Help documentation.
    side: option<pulls-create-review-comment-body-side-enum>,
    /// **Required when using multi-line comments unless using `in_reply_to`**. The `start_line` is the first line in the pull request diff that your multi-line comment applies to. To learn more about multi-line comments, see "[Commenting on a pull request](https://docs.github.com/articles/commenting-on-a-pull-request#adding-line-comments-to-a-pull-request)" in the GitHub Help documentation.
    start-line: option<s32>,
    /// **Required when using multi-line comments unless using `in_reply_to`**. The `start_side` is the starting side of the diff that the comment applies to. Can be `LEFT` or `RIGHT`. To learn more about multi-line comments, see "[Commenting on a pull request](https://docs.github.com/articles/commenting-on-a-pull-request#adding-line-comments-to-a-pull-request)" in the GitHub Help documentation. See `side` in this table for additional context.
    start-side: option<pulls-create-review-comment-body-start-side-enum>
  }
  pulls-create-review-comment: func(params: pulls-create-review-comment-params) -> result<string, string>;

  /// Create a reply for a review comment
  record pulls-create-reply-for-review-comment-params {
    /// The text of the review comment.
    body: string
  }
  pulls-create-reply-for-review-comment: func(params: pulls-create-reply-for-review-comment-params) -> result<string, string>;

  /// List commits on a pull request
  pulls-list-commits: func() -> result<string, string>;

  /// List pull requests files
  pulls-list-files: func() -> result<string, string>;

  /// Check if a pull request has been merged
  pulls-check-if-merged: func() -> result<string, string>;

  /// Merge a pull request
  record pulls-merge-params {
    /// Extra detail to append to automatic commit message.
    commit-message: option<string>,
    /// Title for the automatic commit message.
    commit-title: option<string>,
    /// The merge method to use.
    merge-method: option<pulls-merge-body-merge-method-enum>,
    /// SHA that pull request head must match to allow merge.
    sha: option<string>
  }
  pulls-merge: func(params: pulls-merge-params) -> result<string, string>;

  /// Get all requested reviewers for a pull request
  pulls-list-requested-reviewers: func() -> result<string, string>;

  /// Request reviewers for a pull request
  record pulls-request-reviewers-params {
    /// An array of user `login`s that will be requested.
    reviewers: option<list<string>>,
    /// An array of team `slug`s that will be requested.
    team-reviewers: option<list<string>>
  }
  pulls-request-reviewers: func(params: pulls-request-reviewers-params) -> result<string, string>;

  /// Remove requested reviewers from a pull request
  record pulls-remove-requested-reviewers-params {
    /// An array of user `login`s that will be removed.
    reviewers: list<string>,
    /// An array of team `slug`s that will be removed.
    team-reviewers: option<list<string>>
  }
  pulls-remove-requested-reviewers: func(params: pulls-remove-requested-reviewers-params) -> result<string, string>;

  /// List reviews for a pull request
  pulls-list-reviews: func() -> result<string, string>;

  /// Create a review for a pull request
  record pulls-create-review-params {
    /// **Required** when using `REQUEST_CHANGES` or `COMMENT` for the `event` parameter. The body text of the pull request review.
    body: option<string>,
    /// Use the following table to specify the location, destination, and contents of the draft review comment.
    comments: option<list<pulls-create-review-body-comments-item>>,
    /// The SHA of the commit that needs a review. Not using the latest commit SHA may render your review comment outdated if a subsequent commit modifies the line you specify as the `position`. Defaults to the most recent commit in the pull request when you do not specify a value.
    commit-id: option<string>,
    /// The review action you want to perform. The review actions include: `APPROVE`, `REQUEST_CHANGES`, or `COMMENT`. By leaving this blank, you set the review action state to `PENDING`, which means you will need to [submit the pull request review](https://docs.github.com/rest/pulls#submit-a-review-for-a-pull-request) when you are ready.
    event: option<pulls-create-review-body-event-enum>
  }
  pulls-create-review: func(params: pulls-create-review-params) -> result<string, string>;

  /// Get a review for a pull request
  pulls-get-review: func() -> result<string, string>;

  /// Update a review for a pull request
  record pulls-update-review-params {
    /// The body text of the pull request review.
    body: string
  }
  pulls-update-review: func(params: pulls-update-review-params) -> result<string, string>;

  /// Delete a pending review for a pull request
  pulls-delete-pending-review: func() -> result<string, string>;

  /// List comments for a pull request review
  pulls-list-comments-for-review: func() -> result<string, string>;

  /// Dismiss a review for a pull request
  record pulls-dismiss-review-params {
    event: option<pulls-dismiss-review-body-event-enum>,
    /// The message for the pull request review dismissal
    message: string
  }
  pulls-dismiss-review: func(params: pulls-dismiss-review-params) -> result<string, string>;

  /// Submit a review for a pull request
  record pulls-submit-review-params {
    /// The body text of the pull request review
    body: option<string>,
    /// The review action you want to perform. The review actions include: `APPROVE`, `REQUEST_CHANGES`, or `COMMENT`. When you leave this blank, the API returns _HTTP 422 (Unrecognizable entity)_ and sets the review action state to `PENDING`, which means you will need to re-submit the pull request review using a review action.
    event: pulls-create-review-body-event-enum
  }
  pulls-submit-review: func(params: pulls-submit-review-params) -> result<string, string>;

  /// Update a pull request branch
  record pulls-update-branch-params {
    /// The expected SHA of the pull request's HEAD ref. This is the most recent commit on the pull request's branch. If the expected SHA does not match the pull request's HEAD, you will receive a `422 Unprocessable Entity` status. You can use the "[List commits](https://docs.github.com/rest/reference/repos#list-commits)" endpoint to find the most recent commit SHA. Default: SHA of the pull request's current HEAD ref.
    expected-head-sha: option<string>
  }
  pulls-update-branch: func(params: pulls-update-branch-params) -> result<string, string>;

}

interface search {
  enum search-code-sort-enum {
    indexed,
  }

  enum search-commits-sort-enum {
    author-date,
    committer-date,
  }

  enum search-issues-and-pull-requests-sort-enum {
    comments,
    reactions,
    reactions-v1,
    reactions-v1-v2,
    reactions-smile,
    reactions-thinking-face,
    reactions-heart,
    reactions-tada,
    interactions,
    created,
    updated,
  }

  enum search-labels-sort-enum {
    created,
    updated,
  }

  enum search-repos-sort-enum {
    stars,
    forks,
    help-wanted-issues,
    updated,
  }

  enum search-users-sort-enum {
    followers,
    repositories,
    joined,
  }

  /// Search code
  record search-code-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching code](https://docs.github.com/search-github/searching-on-github/searching-code)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query. Can only be `indexed`, which indicates how recently a file has been indexed by the GitHub search infrastructure. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<search-code-sort-enum>
  }
  search-code: func(params: search-code-params) -> result<string, string>;

  /// Search commits
  record search-commits-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching commits](https://docs.github.com/search-github/searching-on-github/searching-commits)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query by `author-date` or `committer-date`. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<search-commits-sort-enum>
  }
  search-commits: func(params: search-commits-params) -> result<string, string>;

  /// Search issues and pull requests
  record search-issues-and-pull-requests-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching issues and pull requests](https://docs.github.com/search-github/searching-on-github/searching-issues-and-pull-requests)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query by the number of `comments`, `reactions`, `reactions-+1`, `reactions--1`, `reactions-smile`, `reactions-thinking_face`, `reactions-heart`, `reactions-tada`, or `interactions`. You can also sort results by how recently the items were `created` or `updated`, Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<search-issues-and-pull-requests-sort-enum>
  }
  search-issues-and-pull-requests: func(params: search-issues-and-pull-requests-params) -> result<string, string>;

  /// Search labels
  record search-labels-params {
    /// The id of the repository.
    repository-id: s32,
    /// The search keywords. This endpoint does not accept qualifiers in the query. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query).
    q: string,
    /// Sorts the results of your query by when the label was `created` or `updated`. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<search-labels-sort-enum>
  }
  search-labels: func(params: search-labels-params) -> result<string, string>;

  /// Search repositories
  record search-repos-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching for repositories](https://docs.github.com/articles/searching-for-repositories/)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query by number of `stars`, `forks`, or `help-wanted-issues` or how recently the items were `updated`. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<search-repos-sort-enum>
  }
  search-repos: func(params: search-repos-params) -> result<string, string>;

  /// Search topics
  record search-topics-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query).
    q: string
  }
  search-topics: func(params: search-topics-params) -> result<string, string>;

  /// Search users
  record search-users-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching users](https://docs.github.com/search-github/searching-on-github/searching-users)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query by number of `followers` or `repositories`, or when the person `joined` GitHub. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<search-users-sort-enum>
  }
  search-users: func(params: search-users-params) -> result<string, string>;

}

interface users {
  enum users-set-primary-email-visibility-for-authenticated-user-body-visibility-enum {
    public,
    private,
  }

  enum users-get-context-for-user-subject-type-enum {
    organization,
    repository,
    issue,
    pull-request,
  }

  /// Get the authenticated user
  users-get-authenticated: func() -> result<string, string>;

  /// Update the authenticated user
  record users-update-authenticated-params {
    /// The new short biography of the user.
    bio: option<string>,
    /// The new blog URL of the user.
    blog: option<string>,
    /// The new company of the user.
    company: option<string>,
    /// The publicly visible email address of the user.
    email: option<string>,
    /// The new hiring availability of the user.
    hireable: option<bool>,
    /// The new location of the user.
    location: option<string>,
    /// The new name of the user.
    name: option<string>,
    /// The new Twitter username of the user.
    twitter-username: option<string>
  }
  users-update-authenticated: func(params: users-update-authenticated-params) -> result<string, string>;

  /// List users blocked by the authenticated user
  users-list-blocked-by-authenticated-user: func() -> result<string, string>;

  /// Check if a user is blocked by the authenticated user
  users-check-blocked: func() -> result<string, string>;

  /// Block a user
  users-block: func() -> result<string, string>;

  /// Unblock a user
  users-unblock: func() -> result<string, string>;

  /// Set primary email visibility for the authenticated user
  record users-set-primary-email-visibility-for-authenticated-user-params {
    /// Denotes whether an email is publicly visible.
    visibility: users-set-primary-email-visibility-for-authenticated-user-body-visibility-enum
  }
  users-set-primary-email-visibility-for-authenticated-user: func(params: users-set-primary-email-visibility-for-authenticated-user-params) -> result<string, string>;

  /// List email addresses for the authenticated user
  users-list-emails-for-authenticated-user: func() -> result<string, string>;

  /// Add an email address for the authenticated user
  record users-add-email-for-authenticated-user-params {
    body: option<string>
  }
  users-add-email-for-authenticated-user: func(params: users-add-email-for-authenticated-user-params) -> result<string, string>;

  /// Delete an email address for the authenticated user
  record users-delete-email-for-authenticated-user-params {
    body: option<string>
  }
  users-delete-email-for-authenticated-user: func(params: users-delete-email-for-authenticated-user-params) -> result<string, string>;

  /// List followers of the authenticated user
  users-list-followers-for-authenticated-user: func() -> result<string, string>;

  /// List the people the authenticated user follows
  users-list-followed-by-authenticated-user: func() -> result<string, string>;

  /// Check if a person is followed by the authenticated user
  users-check-person-is-followed-by-authenticated: func() -> result<string, string>;

  /// Follow a user
  users-follow: func() -> result<string, string>;

  /// Unfollow a user
  users-unfollow: func() -> result<string, string>;

  /// List GPG keys for the authenticated user
  users-list-gpg-keys-for-authenticated-user: func() -> result<string, string>;

  /// Create a GPG key for the authenticated user
  record users-create-gpg-key-for-authenticated-user-params {
    /// A GPG key in ASCII-armored format.
    armored-public-key: string,
    /// A descriptive name for the new key.
    name: option<string>
  }
  users-create-gpg-key-for-authenticated-user: func(params: users-create-gpg-key-for-authenticated-user-params) -> result<string, string>;

  /// Get a GPG key for the authenticated user
  users-get-gpg-key-for-authenticated-user: func() -> result<string, string>;

  /// Delete a GPG key for the authenticated user
  users-delete-gpg-key-for-authenticated-user: func() -> result<string, string>;

  /// List public SSH keys for the authenticated user
  users-list-public-ssh-keys-for-authenticated-user: func() -> result<string, string>;

  /// Create a public SSH key for the authenticated user
  record users-create-public-ssh-key-for-authenticated-user-params {
    /// The public SSH key to add to your GitHub account.
    key: string,
    /// A descriptive name for the new key.
    title: option<string>
  }
  users-create-public-ssh-key-for-authenticated-user: func(params: users-create-public-ssh-key-for-authenticated-user-params) -> result<string, string>;

  /// Get a public SSH key for the authenticated user
  users-get-public-ssh-key-for-authenticated-user: func() -> result<string, string>;

  /// Delete a public SSH key for the authenticated user
  users-delete-public-ssh-key-for-authenticated-user: func() -> result<string, string>;

  /// List public email addresses for the authenticated user
  users-list-public-emails-for-authenticated-user: func() -> result<string, string>;

  /// List SSH signing keys for the authenticated user
  users-list-ssh-signing-keys-for-authenticated-user: func() -> result<string, string>;

  /// Create a SSH signing key for the authenticated user
  record users-create-ssh-signing-key-for-authenticated-user-params {
    /// The public SSH key to add to your GitHub account. For more information, see "[Checking for existing SSH keys](https://docs.github.com/authentication/connecting-to-github-with-ssh/checking-for-existing-ssh-keys)."
    key: string,
    /// A descriptive name for the new key.
    title: option<string>
  }
  users-create-ssh-signing-key-for-authenticated-user: func(params: users-create-ssh-signing-key-for-authenticated-user-params) -> result<string, string>;

  /// Get an SSH signing key for the authenticated user
  users-get-ssh-signing-key-for-authenticated-user: func() -> result<string, string>;

  /// Delete an SSH signing key for the authenticated user
  users-delete-ssh-signing-key-for-authenticated-user: func() -> result<string, string>;

  /// List users
  users-list: func() -> result<string, string>;

  /// Get a user
  users-get-by-username: func() -> result<string, string>;

  /// List followers of a user
  users-list-followers-for-user: func() -> result<string, string>;

  /// List the people a user follows
  users-list-following-for-user: func() -> result<string, string>;

  /// Check if a user follows another user
  record users-check-following-for-user-params {
    target-user: string
  }
  users-check-following-for-user: func(params: users-check-following-for-user-params) -> result<string, string>;

  /// List GPG keys for a user
  users-list-gpg-keys-for-user: func() -> result<string, string>;

  /// Get contextual information for a user
  record users-get-context-for-user-params {
    /// Identifies which additional information you'd like to receive about the person's hovercard. Can be `organization`, `repository`, `issue`, `pull_request`. **Required** when using `subject_id`.
    subject-type: option<users-get-context-for-user-subject-type-enum>,
    /// Uses the ID for the `subject_type` you specified. **Required** when using `subject_type`.
    subject-id: option<string>
  }
  users-get-context-for-user: func(params: users-get-context-for-user-params) -> result<string, string>;

  /// List public keys for a user
  users-list-public-keys-for-user: func() -> result<string, string>;

  /// List SSH signing keys for a user
  users-list-ssh-signing-keys-for-user: func() -> result<string, string>;

}
/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export meta;
  export apps;
  export codes-of-conduct;
  export emojis;
  export dependabot;
  export secret-scanning;
  export activity;
  export gists;
  export gitignore;
  export issues;
  export licenses;
  export markdown;
  export orgs;
  export actions;
  export oidc;
  export code-scanning;
  export codespaces;
  export interactions;
  export migrations;
  export packages;
  export projects;
  export repos;
  export billing;
  export teams;
  export reactions;
  export rate-limit;
  export checks;
  export dependency-graph;
  export git;
  export pulls;
  export search;
  export users;
}
