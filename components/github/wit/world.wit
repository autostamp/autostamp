package autostamp:github@0.6.0;

interface meta {
  record root-v2 {
    authorizations-url: string,
    code-search-url: string,
    commit-search-url: string,
    current-user-authorizations-html-url: string,
    current-user-repositories-url: string,
    current-user-url: string,
    emails-url: string,
    emojis-url: string,
    events-url: string,
    feeds-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    hub-url: string,
    issue-search-url: string,
    issues-url: string,
    keys-url: string,
    label-search-url: string,
    notifications-url: string,
    organization-repositories-url: string,
    organization-teams-url: string,
    organization-url: string,
    public-gists-url: string,
    rate-limit-url: string,
    repository-search-url: string,
    repository-url: string,
    starred-gists-url: string,
    starred-url: string,
    topic-search-url: option<string>,
    user-organizations-url: string,
    user-repositories-url: string,
    user-search-url: string,
    user-url: string
  }

  /// Api Overview
  record api-overview {
    actions: option<list<string>>,
    api: option<list<string>>,
    dependabot: option<list<string>>,
    git: option<list<string>>,
    hooks: option<list<string>>,
    importer: option<list<string>>,
    packages: option<list<string>>,
    pages: option<list<string>>,
    ssh-key-fingerprints: option<api-overview-ssh-key-fingerprints>,
    ssh-keys: option<list<string>>,
    verifiable-password-authentication: bool,
    web: option<list<string>>
  }

  record api-overview-ssh-key-fingerprints {
    sha256-dsa: option<string>,
    sha256-ecdsa: option<string>,
    sha256-ed25519: option<string>,
    sha256-rsa: option<string>
  }

  variant get-error {
    not-modified(string),
    other(string)
  }

  variant get-all-versions-error {
    not-found(string),
    other(string)
  }

  /// GitHub API Root
  root: func() -> result<root-v2, string>;

  /// Get GitHub meta information
  get: func() -> result<api-overview, get-error>;

  /// Get Octocat
  record get-octocat-params {
    /// The words to show in Octocat's speech bubble
    s: option<string>
  }
  get-octocat: func(params: get-octocat-params) -> result<string, string>;

  /// Get all API versions
  get-all-versions: func() -> result<list<string>, get-all-versions-error>;

  /// Get the Zen of GitHub
  get-zen: func() -> result<string, string>;

}


interface apps {
  enum app-permissions-actions-enum {
    read,
    write,
  }

  enum app-permissions-organization-plan-enum {
    read,
  }

  enum app-permissions-organization-projects-enum {
    read,
    write,
    admin,
  }

  enum app-permissions-workflows-enum {
    write,
  }

  enum installation-repository-selection-enum {
    all,
    selected,
  }

  enum repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  enum marketplace-listing-plan-price-model-enum {
    free,
    flat-rate,
    per-unit,
  }

  enum list-accounts-for-plan-sort-enum {
    created,
    updated,
  }

  enum list-accounts-for-plan-direction-enum {
    asc,
    desc,
  }

  /// GitHub apps are a new way to extend GitHub. They can be installed directly on organizations and user accounts and granted access to specific repositories. They come with granular permissions and built-in webhooks. GitHub apps are first class actors within GitHub.
  record integration {
    client-id: option<string>,
    client-secret: option<string>,
    created-at: string,
    description: string,
    /// The list of events for the GitHub app
    events: list<string>,
    external-url: string,
    html-url: string,
    /// Unique identifier of the GitHub app
    id: s32,
    /// The number of installations associated with the GitHub app
    installations-count: option<s32>,
    /// The name of the GitHub app
    name: string,
    node-id: string,
    owner: nullable-simple-user,
    pem: option<string>,
    /// The set of permissions for the GitHub app
    permissions: integration-permissions,
    /// The slug name of the GitHub app
    slug: option<string>,
    updated-at: string,
    webhook-secret: option<string>
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// The set of permissions for the GitHub app
  record integration-permissions {
    checks: option<string>,
    contents: option<string>,
    deployments: option<string>,
    issues: option<string>,
    metadata: option<string>
  }

  record create-from-manifest-response {
    client-id: option<string>,
    client-secret: option<string>,
    created-at: string,
    description: string,
    /// The list of events for the GitHub app
    events: list<string>,
    external-url: string,
    html-url: string,
    /// Unique identifier of the GitHub app
    id: s32,
    /// The number of installations associated with the GitHub app
    installations-count: option<s32>,
    /// The name of the GitHub app
    name: string,
    node-id: string,
    owner: nullable-simple-user,
    pem: option<string>,
    /// The set of permissions for the GitHub app
    permissions: create-from-manifest-response-permissions,
    /// The slug name of the GitHub app
    slug: option<string>,
    updated-at: string,
    webhook-secret: option<string>
  }

  /// The set of permissions for the GitHub app
  record create-from-manifest-response-permissions {
    checks: option<string>,
    contents: option<string>,
    deployments: option<string>,
    issues: option<string>,
    metadata: option<string>
  }

  /// Configuration object of the webhook
  record webhook-config {
    content-type: option<string>,
    insecure-ssl: option<string>,
    secret: option<string>,
    url: option<string>
  }

  /// Delivery made by a webhook, without request and response information.
  record hook-delivery-item {
    /// The type of activity for the event that triggered the delivery.
    action: string,
    /// Time when the webhook delivery occurred.
    delivered-at: string,
    /// Time spent delivering.
    duration: f64,
    /// The event that triggered the delivery.
    event: string,
    /// Unique identifier for the event (shared with all deliveries for all webhooks that subscribe to this event).
    guid: string,
    /// Unique identifier of the webhook delivery.
    id: s32,
    /// The id of the GitHub App installation associated with this event.
    installation-id: s32,
    /// Whether the webhook delivery is a redelivery.
    redelivery: bool,
    /// The id of the repository associated with this event.
    repository-id: s32,
    /// Describes the response returned after attempting the delivery.
    status: string,
    /// Status code received when delivery was made.
    status-code: s32
  }

  /// Delivery made by a webhook.
  record hook-delivery {
    /// The type of activity for the event that triggered the delivery.
    action: string,
    /// Time when the delivery was delivered.
    delivered-at: string,
    /// Time spent delivering.
    duration: f64,
    /// The event that triggered the delivery.
    event: string,
    /// Unique identifier for the event (shared with all deliveries for all webhooks that subscribe to this event).
    guid: string,
    /// Unique identifier of the delivery.
    id: s32,
    /// The id of the GitHub App installation associated with this event.
    installation-id: s32,
    /// Whether the delivery is a redelivery.
    redelivery: bool,
    /// The id of the repository associated with this event.
    repository-id: s32,
    request: hook-delivery-request,
    response: hook-delivery-response,
    /// Description of the status of the attempted delivery
    status: string,
    /// Status code received when delivery was made.
    status-code: s32,
    /// The URL target of the delivery.
    url: option<string>
  }

  record hook-delivery-request {
    /// The request headers sent with the webhook delivery.
    headers: list<hook-delivery-request-headers-entry>,
    /// The webhook payload.
    payload: list<hook-delivery-request-payload-entry>
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-request-headers-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-request-payload-entry {
    key: string,
    value: string
  }

  record hook-delivery-response {
    /// The response headers received when the delivery was made.
    headers: list<hook-delivery-response-headers-entry>,
    /// The response payload received.
    payload: string
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-response-headers-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record redeliver-webhook-delivery-response-entry {
    key: string,
    value: string
  }

  /// Installation
  record installation {
    access-tokens-url: string,
    account: string,
    app-id: s32,
    app-slug: string,
    contact-email: option<string>,
    created-at: string,
    events: list<string>,
    has-multiple-single-files: option<bool>,
    html-url: string,
    /// The ID of the installation.
    id: s32,
    permissions: app-permissions,
    repositories-url: string,
    /// Describe whether all repositories have been selected or there's a selection involved
    repository-selection: installation-repository-selection-enum,
    single-file-name: string,
    single-file-paths: option<list<string>>,
    suspended-at: string,
    suspended-by: nullable-simple-user,
    /// The ID of the user or organization this token is being scoped to.
    target-id: s32,
    target-type: string,
    updated-at: string
  }

  /// The permissions granted to the user-to-server access token.
  record app-permissions {
    /// The level of permission to grant the access token for GitHub Actions workflows, workflow runs, and artifacts.
    actions: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for repository creation, deletion, settings, teams, and collaborators creation.
    administration: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for checks on code.
    checks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for repository contents, commits, branches, downloads, releases, and merges.
    contents: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for deployments and deployment statuses.
    deployments: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for managing repository environments.
    environments: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for issues and related comments, assignees, labels, and milestones.
    issues: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for organization teams and members.
    members: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to search repositories, list collaborators, and access repository metadata.
    metadata: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage access to an organization.
    organization-administration: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage announcement banners for an organization.
    organization-announcement-banners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for custom repository roles management. This property is in beta and is subject to change.
    organization-custom-roles: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage the post-receive hooks for an organization.
    organization-hooks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for organization packages published to GitHub Packages.
    organization-packages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for viewing an organization's plan.
    organization-plan: option<app-permissions-organization-plan-enum>,
    /// The level of permission to grant the access token to manage organization projects and projects beta (where available).
    organization-projects: option<app-permissions-organization-projects-enum>,
    /// The level of permission to grant the access token to manage organization secrets.
    organization-secrets: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage GitHub Actions self-hosted runners available to an organization.
    organization-self-hosted-runners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage users blocked by the organization.
    organization-user-blocking: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for packages published to GitHub Packages.
    packages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to retrieve Pages statuses, configuration, and builds, as well as create new builds.
    pages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for pull requests and related comments, assignees, labels, milestones, and merges.
    pull-requests: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage announcement banners for a repository.
    repository-announcement-banners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage the post-receive hooks for a repository.
    repository-hooks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage repository projects, columns, and cards.
    repository-projects: option<app-permissions-organization-projects-enum>,
    /// The level of permission to grant the access token to view and manage secret scanning alerts.
    secret-scanning-alerts: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage repository secrets.
    secrets: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage security events like code scanning alerts.
    security-events: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage just a single file.
    single-file: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for commit statuses.
    statuses: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage team discussions and related comments.
    team-discussions: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage Dependabot alerts.
    vulnerability-alerts: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to update GitHub Actions workflow files.
    workflows: option<app-permissions-workflows-enum>
  }

  /// Authentication token for a GitHub App installed on a user or org.
  record installation-token {
    expires-at: string,
    has-multiple-single-files: option<bool>,
    permissions: option<app-permissions>,
    repositories: option<list<repository>>,
    repository-selection: option<installation-repository-selection-enum>,
    single-file: option<string>,
    single-file-paths: option<list<string>>,
    token: string
  }

  /// A repository on GitHub.
  record repository {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow forking this repo
    allow-forking: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is enabled for this repository
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    /// Whether the repository is archived.
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: string,
    /// The default branch of the repository.
    default-branch: string,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    /// Returns whether or not this repository disabled.
    disabled: bool,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: s32,
    forks-count: s32,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: string,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: bool,
    /// Whether issues are enabled.
    has-issues: bool,
    has-pages: bool,
    /// Whether projects are enabled.
    has-projects: bool,
    /// Whether the wiki is enabled.
    has-wiki: bool,
    homepage: string,
    hooks-url: string,
    html-url: string,
    /// Unique identifier of the repository
    id: s32,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: string,
    languages-url: string,
    license: nullable-license-simple,
    master-branch: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: string,
    milestones-url: string,
    mirror-url: string,
    /// The name of the repository.
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: s32,
    open-issues-count: s32,
    organization: option<nullable-simple-user>,
    owner: simple-user,
    permissions: option<repository-permissions>,
    /// Whether the repository is private or public.
    private: bool,
    pulls-url: string,
    pushed-at: string,
    releases-url: string,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: s32,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: string,
    stargazers-count: s32,
    stargazers-url: string,
    starred-at: option<string>,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: string,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    template-repository: option<repository-template-repository>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: string,
    url: string,
    /// Whether a squash merge commit can use the pull request title as default. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The repository visibility: public, private, or internal.
    visibility: option<string>,
    watchers: s32,
    watchers-count: s32,
    /// Whether to require contributors to sign off on web-based commits
    web-commit-signoff-required: option<bool>
  }

  /// License Simple
  record nullable-license-simple {
    html-url: option<string>,
    key: string,
    name: string,
    node-id: string,
    spdx-id: string,
    url: string
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record repository-permissions {
    admin: bool,
    maintain: option<bool>,
    pull: bool,
    push: bool,
    triage: option<bool>
  }

  record repository-template-repository {
    allow-auto-merge: option<bool>,
    allow-merge-commit: option<bool>,
    allow-rebase-merge: option<bool>,
    allow-squash-merge: option<bool>,
    allow-update-branch: option<bool>,
    archive-url: option<string>,
    archived: option<bool>,
    assignees-url: option<string>,
    blobs-url: option<string>,
    branches-url: option<string>,
    clone-url: option<string>,
    collaborators-url: option<string>,
    comments-url: option<string>,
    commits-url: option<string>,
    compare-url: option<string>,
    contents-url: option<string>,
    contributors-url: option<string>,
    created-at: option<string>,
    default-branch: option<string>,
    delete-branch-on-merge: option<bool>,
    deployments-url: option<string>,
    description: option<string>,
    disabled: option<bool>,
    downloads-url: option<string>,
    events-url: option<string>,
    fork: option<bool>,
    forks-count: option<s32>,
    forks-url: option<string>,
    full-name: option<string>,
    git-commits-url: option<string>,
    git-refs-url: option<string>,
    git-tags-url: option<string>,
    git-url: option<string>,
    has-downloads: option<bool>,
    has-issues: option<bool>,
    has-pages: option<bool>,
    has-projects: option<bool>,
    has-wiki: option<bool>,
    homepage: option<string>,
    hooks-url: option<string>,
    html-url: option<string>,
    id: option<s32>,
    is-template: option<bool>,
    issue-comment-url: option<string>,
    issue-events-url: option<string>,
    issues-url: option<string>,
    keys-url: option<string>,
    labels-url: option<string>,
    language: option<string>,
    languages-url: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: option<string>,
    milestones-url: option<string>,
    mirror-url: option<string>,
    name: option<string>,
    network-count: option<s32>,
    node-id: option<string>,
    notifications-url: option<string>,
    open-issues-count: option<s32>,
    owner: option<repository-template-repository-owner>,
    permissions: option<repository-template-repository-permissions>,
    private: option<bool>,
    pulls-url: option<string>,
    pushed-at: option<string>,
    releases-url: option<string>,
    size: option<s32>,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: option<string>,
    stargazers-count: option<s32>,
    stargazers-url: option<string>,
    statuses-url: option<string>,
    subscribers-count: option<s32>,
    subscribers-url: option<string>,
    subscription-url: option<string>,
    svn-url: option<string>,
    tags-url: option<string>,
    teams-url: option<string>,
    temp-clone-token: option<string>,
    topics: option<list<string>>,
    trees-url: option<string>,
    updated-at: option<string>,
    url: option<string>,
    use-squash-pr-title-as-default: option<bool>,
    visibility: option<string>,
    watchers-count: option<s32>
  }

  record repository-template-repository-owner {
    avatar-url: option<string>,
    events-url: option<string>,
    followers-url: option<string>,
    following-url: option<string>,
    gists-url: option<string>,
    gravatar-id: option<string>,
    html-url: option<string>,
    id: option<s32>,
    login: option<string>,
    node-id: option<string>,
    organizations-url: option<string>,
    received-events-url: option<string>,
    repos-url: option<string>,
    site-admin: option<bool>,
    starred-url: option<string>,
    subscriptions-url: option<string>,
    type-op: option<string>,
    url: option<string>
  }

  record repository-template-repository-permissions {
    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  /// The authorization for an OAuth app, GitHub App, or a Personal Access Token.
  record authorization {
    app: authorization-app,
    created-at: string,
    expires-at: string,
    fingerprint: string,
    hashed-token: string,
    id: s32,
    installation: option<nullable-scoped-installation>,
    note: string,
    note-url: string,
    /// A list of scopes that this authorization is in.
    scopes: list<string>,
    token: string,
    token-last-eight: string,
    updated-at: string,
    url: string,
    user: option<nullable-simple-user>
  }

  record authorization-app {
    client-id: string,
    name: string,
    url: string
  }

  record nullable-scoped-installation {
    account: simple-user,
    has-multiple-single-files: option<bool>,
    permissions: app-permissions,
    repositories-url: string,
    /// Describe whether all repositories have been selected or there's a selection involved
    repository-selection: installation-repository-selection-enum,
    single-file-name: string,
    single-file-paths: option<list<string>>
  }

  record list-repos-accessible-to-installation-response {
    repositories: list<repository>,
    repository-selection: option<string>,
    total-count: s32
  }

  /// Marketplace Purchase
  record marketplace-purchase {
    email: option<string>,
    id: s32,
    login: string,
    marketplace-pending-change: option<marketplace-purchase-marketplace-pending-change>,
    marketplace-purchase: marketplace-purchase-marketplace-purchase,
    organization-billing-email: option<string>,
    type-op: string,
    url: string
  }

  record marketplace-purchase-marketplace-pending-change {
    effective-date: option<string>,
    id: option<s32>,
    is-installed: option<bool>,
    plan: option<marketplace-listing-plan>,
    unit-count: option<s32>
  }

  /// Marketplace Listing Plan
  record marketplace-listing-plan {
    accounts-url: string,
    bullets: list<string>,
    description: string,
    has-free-trial: bool,
    id: s32,
    monthly-price-in-cents: s32,
    name: string,
    number: s32,
    price-model: marketplace-listing-plan-price-model-enum,
    state: string,
    unit-name: string,
    url: string,
    yearly-price-in-cents: s32
  }

  record marketplace-purchase-marketplace-purchase {
    billing-cycle: option<string>,
    free-trial-ends-on: option<string>,
    is-installed: option<bool>,
    next-billing-date: option<string>,
    on-free-trial: option<bool>,
    plan: option<marketplace-listing-plan>,
    unit-count: option<s32>,
    updated-at: option<string>
  }

  record list-installations-for-authenticated-user-response {
    installations: list<installation>,
    total-count: s32
  }

  record list-installation-repos-for-authenticated-user-response {
    repositories: list<repository>,
    repository-selection: option<string>,
    total-count: s32
  }

  /// User Marketplace Purchase
  record user-marketplace-purchase {
    account: marketplace-account,
    billing-cycle: string,
    free-trial-ends-on: string,
    next-billing-date: string,
    on-free-trial: bool,
    plan: marketplace-listing-plan,
    unit-count: s32,
    updated-at: string
  }

  record marketplace-account {
    email: option<string>,
    id: s32,
    login: string,
    node-id: option<string>,
    organization-billing-email: option<string>,
    type-op: string,
    url: string
  }

  variant create-from-manifest-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-webhook-deliveries-error {
    bad-request(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-webhook-delivery-error {
    bad-request(string),
    unprocessable-entity(string),
    other(string)
  }

  variant redeliver-webhook-delivery-error {
    bad-request(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-installation-error {
    not-found(string),
    other(string)
  }

  variant delete-installation-error {
    not-found(string),
    other(string)
  }

  variant create-installation-access-token-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant suspend-installation-error {
    not-found(string),
    other(string)
  }

  variant unsuspend-installation-error {
    not-found(string),
    other(string)
  }

  variant delete-authorization-error {
    unprocessable-entity(string),
    other(string)
  }

  variant check-token-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant reset-token-error {
    unprocessable-entity(string),
    other(string)
  }

  variant delete-token-error {
    unprocessable-entity(string),
    other(string)
  }

  variant scope-token-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-by-slug-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-repos-accessible-to-installation-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-subscription-plan-for-account-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant list-plans-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant list-accounts-for-plan-error {
    unauthorized(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-subscription-plan-for-account-stubbed-error {
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant list-plans-stubbed-error {
    unauthorized(string),
    other(string)
  }

  variant list-accounts-for-plan-stubbed-error {
    unauthorized(string),
    other(string)
  }

  variant get-repo-installation-error {
    moved-permanently(string),
    not-found(string),
    other(string)
  }

  variant list-installations-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant list-installation-repos-for-authenticated-user-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant add-repo-to-installation-for-authenticated-user-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant remove-repo-from-installation-for-authenticated-user-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-subscriptions-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    not-found(string),
    other(string)
  }

  variant list-subscriptions-for-authenticated-user-stubbed-error {
    not-modified(string),
    unauthorized(string),
    other(string)
  }

  /// Get the authenticated app
  get-authenticated: func() -> result<integration, string>;

  /// Create a GitHub App from a manifest
  record create-from-manifest-params {
    code: string
  }
  create-from-manifest: func(params: create-from-manifest-params) -> result<create-from-manifest-response, create-from-manifest-error>;

  /// Get a webhook configuration for an app
  get-webhook-config-for-app: func() -> result<webhook-config, string>;

  /// Update a webhook configuration for an app
  record update-webhook-config-for-app-params {
    content-type: option<string>,
    insecure-ssl: option<string>,
    secret: option<string>,
    url: option<string>
  }
  update-webhook-config-for-app: func(params: update-webhook-config-for-app-params) -> result<webhook-config, string>;

  /// List deliveries for an app webhook
  record list-webhook-deliveries-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Used for pagination: the starting delivery from which the page of deliveries is fetched. Refer to the `link` header for the next and previous page cursors.
    cursor: option<string>,
    redelivery: option<bool>
  }
  list-webhook-deliveries: func(params: list-webhook-deliveries-params) -> result<list<hook-delivery-item>, list-webhook-deliveries-error>;

  /// Get a delivery for an app webhook
  record get-webhook-delivery-params {
    delivery-id: string
  }
  get-webhook-delivery: func(params: get-webhook-delivery-params) -> result<hook-delivery, get-webhook-delivery-error>;

  /// Redeliver a delivery for an app webhook
  record redeliver-webhook-delivery-params {
    delivery-id: string
  }
  redeliver-webhook-delivery: func(params: redeliver-webhook-delivery-params) -> result<list<redeliver-webhook-delivery-response-entry>, redeliver-webhook-delivery-error>;

  /// List installations for the authenticated app
  record list-installations-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    outdated: option<string>
  }
  list-installations: func(params: list-installations-params) -> result<list<installation>, string>;

  /// Get an installation for the authenticated app
  record get-installation-params {
    /// The unique identifier of the installation.
    installation-id: string
  }
  get-installation: func(params: get-installation-params) -> result<installation, get-installation-error>;

  /// Delete an installation for the authenticated app
  record delete-installation-params {
    /// The unique identifier of the installation.
    installation-id: string
  }
  delete-installation: func(params: delete-installation-params) -> result<string, delete-installation-error>;

  /// Create an installation access token for an app
  record create-installation-access-token-params {
    /// The unique identifier of the installation.
    installation-id: string,
    permissions: option<app-permissions>,
    /// List of repository names that the token should have access to
    repositories: option<list<string>>,
    /// List of repository IDs that the token should have access to
    repository-ids: option<list<s32>>
  }
  create-installation-access-token: func(params: create-installation-access-token-params) -> result<installation-token, create-installation-access-token-error>;

  /// Suspend an app installation
  record suspend-installation-params {
    /// The unique identifier of the installation.
    installation-id: string
  }
  suspend-installation: func(params: suspend-installation-params) -> result<string, suspend-installation-error>;

  /// Unsuspend an app installation
  record unsuspend-installation-params {
    /// The unique identifier of the installation.
    installation-id: string
  }
  unsuspend-installation: func(params: unsuspend-installation-params) -> result<string, unsuspend-installation-error>;

  /// Delete an app authorization
  record delete-authorization-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The OAuth access token used to authenticate to the GitHub API.
    access-token: string
  }
  delete-authorization: func(params: delete-authorization-params) -> result<string, delete-authorization-error>;

  /// Check a token
  record check-token-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The access_token of the OAuth application.
    access-token: string
  }
  check-token: func(params: check-token-params) -> result<authorization, check-token-error>;

  /// Reset a token
  record reset-token-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The access_token of the OAuth application.
    access-token: string
  }
  reset-token: func(params: reset-token-params) -> result<authorization, reset-token-error>;

  /// Delete an app token
  record delete-token-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The OAuth access token used to authenticate to the GitHub API.
    access-token: string
  }
  delete-token: func(params: delete-token-params) -> result<string, delete-token-error>;

  /// Create a scoped access token
  record scope-token-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The access token used to authenticate to the GitHub API.
    access-token: string,
    permissions: option<app-permissions>,
    /// The list of repository names to scope the user-to-server access token to. `repositories` may not be specified if `repository_ids` is specified.
    repositories: option<list<string>>,
    /// The list of repository IDs to scope the user-to-server access token to. `repository_ids` may not be specified if `repositories` is specified.
    repository-ids: option<list<s32>>,
    /// The name of the user or organization to scope the user-to-server access token to. **Required** unless `target_id` is specified.
    target: option<string>,
    /// The ID of the user or organization to scope the user-to-server access token to. **Required** unless `target` is specified.
    target-id: option<s32>
  }
  scope-token: func(params: scope-token-params) -> result<authorization, scope-token-error>;

  /// Get an app
  record get-by-slug-params {
    app-slug: string
  }
  get-by-slug: func(params: get-by-slug-params) -> result<integration, get-by-slug-error>;

  /// List repositories accessible to the app installation
  record list-repos-accessible-to-installation-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-accessible-to-installation: func(params: list-repos-accessible-to-installation-params) -> result<list-repos-accessible-to-installation-response, list-repos-accessible-to-installation-error>;

  /// Revoke an installation access token
  revoke-installation-access-token: func() -> result<string, string>;

  /// Get a subscription plan for an account
  record get-subscription-plan-for-account-params {
    /// account_id parameter
    account-id: string
  }
  get-subscription-plan-for-account: func(params: get-subscription-plan-for-account-params) -> result<marketplace-purchase, get-subscription-plan-for-account-error>;

  /// List plans
  record list-plans-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-plans: func(params: list-plans-params) -> result<list<marketplace-listing-plan>, list-plans-error>;

  /// List accounts for a plan
  record list-accounts-for-plan-params {
    /// The unique identifier of the plan.
    plan-id: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-accounts-for-plan-sort-enum>,
    /// To return the oldest accounts first, set to `asc`. Ignored without the `sort` parameter.
    direction: option<list-accounts-for-plan-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-accounts-for-plan: func(params: list-accounts-for-plan-params) -> result<list<marketplace-purchase>, list-accounts-for-plan-error>;

  /// Get a subscription plan for an account (stubbed)
  record get-subscription-plan-for-account-stubbed-params {
    /// account_id parameter
    account-id: string
  }
  get-subscription-plan-for-account-stubbed: func(params: get-subscription-plan-for-account-stubbed-params) -> result<marketplace-purchase, get-subscription-plan-for-account-stubbed-error>;

  /// List plans (stubbed)
  record list-plans-stubbed-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-plans-stubbed: func(params: list-plans-stubbed-params) -> result<list<marketplace-listing-plan>, list-plans-stubbed-error>;

  /// List accounts for a plan (stubbed)
  record list-accounts-for-plan-stubbed-params {
    /// The unique identifier of the plan.
    plan-id: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-accounts-for-plan-sort-enum>,
    /// To return the oldest accounts first, set to `asc`. Ignored without the `sort` parameter.
    direction: option<list-accounts-for-plan-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-accounts-for-plan-stubbed: func(params: list-accounts-for-plan-stubbed-params) -> result<list<marketplace-purchase>, list-accounts-for-plan-stubbed-error>;

  /// Get an organization installation for the authenticated app
  record get-org-installation-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-org-installation: func(params: get-org-installation-params) -> result<installation, string>;

  /// Get a repository installation for the authenticated app
  record get-repo-installation-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-repo-installation: func(params: get-repo-installation-params) -> result<installation, get-repo-installation-error>;

  /// List app installations accessible to the user access token
  record list-installations-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-installations-for-authenticated-user: func(params: list-installations-for-authenticated-user-params) -> result<list-installations-for-authenticated-user-response, list-installations-for-authenticated-user-error>;

  /// List repositories accessible to the user access token
  record list-installation-repos-for-authenticated-user-params {
    /// The unique identifier of the installation.
    installation-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-installation-repos-for-authenticated-user: func(params: list-installation-repos-for-authenticated-user-params) -> result<list-installation-repos-for-authenticated-user-response, list-installation-repos-for-authenticated-user-error>;

  /// Add a repository to an app installation
  record add-repo-to-installation-for-authenticated-user-params {
    /// The unique identifier of the installation.
    installation-id: string,
    /// The unique identifier of the repository.
    repository-id: string
  }
  add-repo-to-installation-for-authenticated-user: func(params: add-repo-to-installation-for-authenticated-user-params) -> result<string, add-repo-to-installation-for-authenticated-user-error>;

  /// Remove a repository from an app installation
  record remove-repo-from-installation-for-authenticated-user-params {
    /// The unique identifier of the installation.
    installation-id: string,
    /// The unique identifier of the repository.
    repository-id: string
  }
  remove-repo-from-installation-for-authenticated-user: func(params: remove-repo-from-installation-for-authenticated-user-params) -> result<string, remove-repo-from-installation-for-authenticated-user-error>;

  /// List subscriptions for the authenticated user
  record list-subscriptions-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-subscriptions-for-authenticated-user: func(params: list-subscriptions-for-authenticated-user-params) -> result<list<user-marketplace-purchase>, list-subscriptions-for-authenticated-user-error>;

  /// List subscriptions for the authenticated user (stubbed)
  record list-subscriptions-for-authenticated-user-stubbed-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-subscriptions-for-authenticated-user-stubbed: func(params: list-subscriptions-for-authenticated-user-stubbed-params) -> result<list<user-marketplace-purchase>, list-subscriptions-for-authenticated-user-stubbed-error>;

  /// Get a user installation for the authenticated app
  record get-user-installation-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-user-installation: func(params: get-user-installation-params) -> result<installation, string>;

}

interface codes-of-conduct {
  /// Code Of Conduct
  record code-of-conduct {
    body: option<string>,
    html-url: string,
    key: string,
    name: string,
    url: string
  }

  variant get-all-codes-of-conduct-error {
    not-modified(string),
    other(string)
  }

  variant get-conduct-code-error {
    not-modified(string),
    not-found(string),
    other(string)
  }

  /// Get all codes of conduct
  get-all-codes-of-conduct: func() -> result<list<code-of-conduct>, get-all-codes-of-conduct-error>;

  /// Get a code of conduct
  record get-conduct-code-params {
    key: string
  }
  get-conduct-code: func(params: get-conduct-code-params) -> result<code-of-conduct, get-conduct-code-error>;

}

interface emojis {
  /// one entry of a string-keyed map (free-form object)
  record get-response-entry {
    key: string,
    value: string
  }

  variant get-error {
    not-modified(string),
    other(string)
  }

  /// Get emojis
  get: func() -> result<list<get-response-entry>, get-error>;

}

interface dependabot {
  enum list-alerts-for-enterprise-scope-enum {
    development,
    runtime,
  }

  enum list-alerts-for-enterprise-sort-enum {
    created,
    updated,
  }

  enum list-alerts-for-enterprise-direction-enum {
    asc,
    desc,
  }

  enum alert-with-repository-dismissed-reason-enum {
    fix-started,
    inaccurate,
    no-bandwidth,
    not-used,
    tolerable-risk,
  }

  enum alert-security-advisory-identifiers-item-type-op-enum {
    cve,
    ghsa,
  }

  enum alert-security-advisory-severity-enum {
    low,
    medium,
    high,
    critical,
  }

  enum alert-with-repository-state-enum {
    dismissed,
    fixed,
    open,
  }

  enum organization-dependabot-secret-visibility-enum {
    all,
    private,
    selected,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum update-alert-body-state-enum {
    dismissed,
    open,
  }

  /// A Dependabot alert.
  record alert-with-repository {
    created-at: string,
    /// Details for the vulnerable dependency.
    dependency: alert-with-repository-dependency,
    dismissed-at: string,
    dismissed-by: nullable-simple-user,
    /// An optional comment associated with the alert's dismissal.
    dismissed-comment: string,
    /// The reason that the alert was dismissed.
    dismissed-reason: alert-with-repository-dismissed-reason-enum,
    fixed-at: string,
    html-url: string,
    number: s32,
    repository: simple-repository,
    security-advisory: alert-security-advisory,
    security-vulnerability: alert-security-vulnerability,
    /// The state of the Dependabot alert.
    state: alert-with-repository-state-enum,
    updated-at: string,
    url: string
  }

  /// Details for the vulnerable dependency.
  record alert-with-repository-dependency {
    /// The full path to the dependency manifest file, relative to the root of the repository.
    manifest-path: option<string>,
    package-op: option<alert-package>,
    /// The execution scope of the vulnerable dependency.
    scope: option<list-alerts-for-enterprise-scope-enum>
  }

  /// Details for the vulnerable package.
  record alert-package {
    /// The package's language or package management ecosystem.
    ecosystem: string,
    /// The unique package name within its ecosystem.
    name: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A GitHub repository.
  record simple-repository {
    /// A template for the API URL to download the repository as an archive.
    archive-url: string,
    /// A template for the API URL to list the available assignees for issues in the repository.
    assignees-url: string,
    /// A template for the API URL to create or retrieve a raw Git blob in the repository.
    blobs-url: string,
    /// A template for the API URL to get information about branches in the repository.
    branches-url: string,
    /// A template for the API URL to get information about collaborators of the repository.
    collaborators-url: string,
    /// A template for the API URL to get information about comments on the repository.
    comments-url: string,
    /// A template for the API URL to get information about commits on the repository.
    commits-url: string,
    /// A template for the API URL to compare two commits or refs.
    compare-url: string,
    /// A template for the API URL to get the contents of the repository.
    contents-url: string,
    /// A template for the API URL to list the contributors to the repository.
    contributors-url: string,
    /// The API URL to list the deployments of the repository.
    deployments-url: string,
    /// The repository description.
    description: string,
    /// The API URL to list the downloads on the repository.
    downloads-url: string,
    /// The API URL to list the events of the repository.
    events-url: string,
    /// Whether the repository is a fork.
    fork: bool,
    /// The API URL to list the forks of the repository.
    forks-url: string,
    /// The full, globally unique, name of the repository.
    full-name: string,
    /// A template for the API URL to get information about Git commits of the repository.
    git-commits-url: string,
    /// A template for the API URL to get information about Git refs of the repository.
    git-refs-url: string,
    /// A template for the API URL to get information about Git tags of the repository.
    git-tags-url: string,
    /// The API URL to list the hooks on the repository.
    hooks-url: string,
    /// The URL to view the repository on GitHub.com.
    html-url: string,
    /// A unique identifier of the repository.
    id: s32,
    /// A template for the API URL to get information about issue comments on the repository.
    issue-comment-url: string,
    /// A template for the API URL to get information about issue events on the repository.
    issue-events-url: string,
    /// A template for the API URL to get information about issues on the repository.
    issues-url: string,
    /// A template for the API URL to get information about deploy keys on the repository.
    keys-url: string,
    /// A template for the API URL to get information about labels of the repository.
    labels-url: string,
    /// The API URL to get information about the languages of the repository.
    languages-url: string,
    /// The API URL to merge branches in the repository.
    merges-url: string,
    /// A template for the API URL to get information about milestones of the repository.
    milestones-url: string,
    /// The name of the repository.
    name: string,
    /// The GraphQL identifier of the repository.
    node-id: string,
    /// A template for the API URL to get information about notifications on the repository.
    notifications-url: string,
    owner: simple-user,
    /// Whether the repository is private.
    private: bool,
    /// A template for the API URL to get information about pull requests on the repository.
    pulls-url: string,
    /// A template for the API URL to get information about releases on the repository.
    releases-url: string,
    /// The API URL to list the stargazers on the repository.
    stargazers-url: string,
    /// A template for the API URL to get information about statuses of a commit.
    statuses-url: string,
    /// The API URL to list the subscribers on the repository.
    subscribers-url: string,
    /// The API URL to subscribe to notifications for this repository.
    subscription-url: string,
    /// The API URL to get information about tags on the repository.
    tags-url: string,
    /// The API URL to list the teams on the repository.
    teams-url: string,
    /// A template for the API URL to create or retrieve a raw Git tree of the repository.
    trees-url: string,
    /// The URL to get more information about the repository from the GitHub API.
    url: string
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Details for the GitHub Security Advisory.
  record alert-security-advisory {
    /// The unique CVE ID assigned to the advisory.
    cve-id: string,
    /// Details for the advisory pertaining to the Common Vulnerability Scoring System.
    cvss: alert-security-advisory-cvss,
    /// Details for the advisory pertaining to Common Weakness Enumeration.
    cwes: list<alert-security-advisory-cwes-item>,
    /// A long-form Markdown-supported description of the advisory.
    description: string,
    /// The unique GitHub Security Advisory ID assigned to the advisory.
    ghsa-id: string,
    /// Values that identify this advisory among security information sources.
    identifiers: list<alert-security-advisory-identifiers-item>,
    /// The time that the advisory was published in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
    published-at: string,
    /// Links to additional advisory information.
    references: list<alert-security-advisory-references-item>,
    /// The severity of the advisory.
    severity: alert-security-advisory-severity-enum,
    /// A short, plain text summary of the advisory.
    summary: string,
    /// The time that the advisory was last modified in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
    updated-at: string,
    /// Vulnerable version range information for the advisory.
    vulnerabilities: list<alert-security-vulnerability>,
    /// The time that the advisory was withdrawn in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
    withdrawn-at: string
  }

  /// Details for the advisory pertaining to the Common Vulnerability Scoring System.
  record alert-security-advisory-cvss {
    /// The overall CVSS score of the advisory.
    score: f64,
    /// The full CVSS vector string for the advisory.
    vector-string: string
  }

  /// A CWE weakness assigned to the advisory.
  record alert-security-advisory-cwes-item {
    /// The unique CWE ID.
    cwe-id: string,
    /// The short, plain text name of the CWE.
    name: string
  }

  /// An advisory identifier.
  record alert-security-advisory-identifiers-item {
    /// The type of advisory identifier.
    type-op: alert-security-advisory-identifiers-item-type-op-enum,
    /// The value of the advisory identifer.
    value: string
  }

  /// A link to additional advisory information.
  record alert-security-advisory-references-item {
    /// The URL of the reference.
    url: string
  }

  /// Details pertaining to one vulnerable version range for the advisory.
  record alert-security-vulnerability {
    /// Details pertaining to the package version that patches this vulnerability.
    first-patched-version: alert-security-vulnerability-first-patched-version,
    package-op: alert-package,
    /// The severity of the vulnerability.
    severity: alert-security-advisory-severity-enum,
    /// Conditions that identify vulnerable versions of this vulnerability's package.
    vulnerable-version-range: string
  }

  /// Details pertaining to the package version that patches this vulnerability.
  record alert-security-vulnerability-first-patched-version {
    /// The package version that patches this vulnerability.
    identifier: string
  }

  record list-org-secrets-response {
    secrets: list<organization-dependabot-secret>,
    total-count: s32
  }

  /// Secrets for GitHub Dependabot for an organization.
  record organization-dependabot-secret {
