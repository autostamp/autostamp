interface oidc {
  /// Actions OIDC Subject customization
  record custom-sub {
    /// Array of unique strings. Each claim key can only contain alphanumeric characters and underscores.
    include-claim-keys: list<string>
  }

  /// An object without any properties.
  record empty-object {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant update-oidc-custom-sub-template-for-org-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get the customization template for an OIDC subject claim for an organization
  record get-oidc-custom-sub-template-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-oidc-custom-sub-template-for-org: func(params: get-oidc-custom-sub-template-for-org-params) -> result<custom-sub, string>;

  /// Set the customization template for an OIDC subject claim for an organization
  record update-oidc-custom-sub-template-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Array of unique strings. Each claim key can only contain alphanumeric characters and underscores.
    include-claim-keys: list<string>
  }
  update-oidc-custom-sub-template-for-org: func(params: update-oidc-custom-sub-template-for-org-params) -> result<empty-object, update-oidc-custom-sub-template-for-org-error>;

}

interface code-scanning {
  enum list-alerts-for-org-direction-enum {
    asc,
    desc,
  }

  enum alert-state {
    open,
    closed,
    dismissed,
    fixed,
  }

  enum list-alerts-for-org-sort-enum {
    created,
    updated,
  }

  enum alert-severity {
    critical,
    high,
    medium,
    low,
    warning,
    note,
    error,
  }

  enum alert-dismissed-reason {
    false-positive,
    won-t-fix,
    used-in-tests,
  }

  enum alert-classification {
    source,
    generated,
    test,
    library,
  }

  enum alert-rule-security-severity-level-enum {
    low,
    medium,
    high,
    critical,
  }

  enum alert-rule-severity-enum {
    none,
    note,
    warning,
    error,
  }

  enum alert-set-state {
    open,
    dismissed,
  }

  enum list-recent-analyses-sort-enum {
    created,
  }

  enum sarifs-status-processing-status-enum {
    pending,
    complete,
    failed,
  }

  record organization-alert-items {
    created-at: string,
    dismissed-at: string,
    dismissed-by: nullable-simple-user,
    dismissed-comment: option<string>,
    dismissed-reason: alert-dismissed-reason,
    fixed-at: option<string>,
    html-url: string,
    instances-url: string,
    most-recent-instance: alert-instance,
    number: s32,
    repository: simple-repository,
    rule: alert-rule,
    state: alert-state,
    tool: analysis-tool,
    updated-at: option<string>,
    url: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record alert-instance {
    analysis-key: option<string>,
    category: option<string>,
    /// Classifications that have been applied to the file that triggered the alert.
    /// For example identifying it as documentation, or a generated file.
    classifications: option<list<alert-classification>>,
    commit-sha: option<string>,
    environment: option<string>,
    html-url: option<string>,
    location: option<alert-location>,
    message: option<alert-instance-message>,
    ref: option<string>,
    state: option<alert-state>
  }

  /// Describe a region within a file for the alert.
  record alert-location {
    end-column: option<s32>,
    end-line: option<s32>,
    path: option<string>,
    start-column: option<s32>,
    start-line: option<s32>
  }

  record alert-instance-message {
    text: option<string>
  }

  /// A GitHub repository.
  record simple-repository {
    /// A template for the API URL to download the repository as an archive.
    archive-url: string,
    /// A template for the API URL to list the available assignees for issues in the repository.
    assignees-url: string,
    /// A template for the API URL to create or retrieve a raw Git blob in the repository.
    blobs-url: string,
    /// A template for the API URL to get information about branches in the repository.
    branches-url: string,
    /// A template for the API URL to get information about collaborators of the repository.
    collaborators-url: string,
    /// A template for the API URL to get information about comments on the repository.
    comments-url: string,
    /// A template for the API URL to get information about commits on the repository.
    commits-url: string,
    /// A template for the API URL to compare two commits or refs.
    compare-url: string,
    /// A template for the API URL to get the contents of the repository.
    contents-url: string,
    /// A template for the API URL to list the contributors to the repository.
    contributors-url: string,
    /// The API URL to list the deployments of the repository.
    deployments-url: string,
    /// The repository description.
    description: string,
    /// The API URL to list the downloads on the repository.
    downloads-url: string,
    /// The API URL to list the events of the repository.
    events-url: string,
    /// Whether the repository is a fork.
    fork: bool,
    /// The API URL to list the forks of the repository.
    forks-url: string,
    /// The full, globally unique, name of the repository.
    full-name: string,
    /// A template for the API URL to get information about Git commits of the repository.
    git-commits-url: string,
    /// A template for the API URL to get information about Git refs of the repository.
    git-refs-url: string,
    /// A template for the API URL to get information about Git tags of the repository.
    git-tags-url: string,
    /// The API URL to list the hooks on the repository.
    hooks-url: string,
    /// The URL to view the repository on GitHub.com.
    html-url: string,
    /// A unique identifier of the repository.
    id: s32,
    /// A template for the API URL to get information about issue comments on the repository.
    issue-comment-url: string,
    /// A template for the API URL to get information about issue events on the repository.
    issue-events-url: string,
    /// A template for the API URL to get information about issues on the repository.
    issues-url: string,
    /// A template for the API URL to get information about deploy keys on the repository.
    keys-url: string,
    /// A template for the API URL to get information about labels of the repository.
    labels-url: string,
    /// The API URL to get information about the languages of the repository.
    languages-url: string,
    /// The API URL to merge branches in the repository.
    merges-url: string,
    /// A template for the API URL to get information about milestones of the repository.
    milestones-url: string,
    /// The name of the repository.
    name: string,
    /// The GraphQL identifier of the repository.
    node-id: string,
    /// A template for the API URL to get information about notifications on the repository.
    notifications-url: string,
    owner: simple-user,
    /// Whether the repository is private.
    private: bool,
    /// A template for the API URL to get information about pull requests on the repository.
    pulls-url: string,
    /// A template for the API URL to get information about releases on the repository.
    releases-url: string,
    /// The API URL to list the stargazers on the repository.
    stargazers-url: string,
    /// A template for the API URL to get information about statuses of a commit.
    statuses-url: string,
    /// The API URL to list the subscribers on the repository.
    subscribers-url: string,
    /// The API URL to subscribe to notifications for this repository.
    subscription-url: string,
    /// The API URL to get information about tags on the repository.
    tags-url: string,
    /// The API URL to list the teams on the repository.
    teams-url: string,
    /// A template for the API URL to create or retrieve a raw Git tree of the repository.
    trees-url: string,
    /// The URL to get more information about the repository from the GitHub API.
    url: string
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record alert-rule {
    /// A short description of the rule used to detect the alert.
    description: option<string>,
    /// description of the rule used to detect the alert.
    full-description: option<string>,
    /// Detailed documentation for the rule as GitHub Flavored Markdown.
    help: option<string>,
    /// A link to the documentation for the rule used to detect the alert.
    help-uri: option<string>,
    /// A unique identifier for the rule used to detect the alert.
    id: option<string>,
    /// The name of the rule used to detect the alert.
    name: option<string>,
    /// The security severity of the alert.
    security-severity-level: option<alert-rule-security-severity-level-enum>,
    /// The severity of the alert.
    severity: option<alert-rule-severity-enum>,
    /// A set of tags applicable for the rule.
    tags: option<list<string>>
  }

  record analysis-tool {
    guid: option<string>,
    name: option<string>,
    version: option<string>
  }

  record alert-items {
    created-at: string,
    dismissed-at: string,
    dismissed-by: nullable-simple-user,
    dismissed-comment: option<string>,
    dismissed-reason: alert-dismissed-reason,
    fixed-at: option<string>,
    html-url: string,
    instances-url: string,
    most-recent-instance: alert-instance,
    number: s32,
    rule: alert-rule-summary,
    state: alert-state,
    tool: analysis-tool,
    updated-at: option<string>,
    url: string
  }

  record alert-rule-summary {
    /// A short description of the rule used to detect the alert.
    description: option<string>,
    /// A unique identifier for the rule used to detect the alert.
    id: option<string>,
    /// The name of the rule used to detect the alert.
    name: option<string>,
    /// The severity of the alert.
    severity: option<alert-rule-severity-enum>,
    /// A set of tags applicable for the rule.
    tags: option<list<string>>
  }

  record alert {
    created-at: string,
    dismissed-at: string,
    dismissed-by: nullable-simple-user,
    dismissed-comment: option<string>,
    dismissed-reason: alert-dismissed-reason,
    fixed-at: option<string>,
    html-url: string,
    instances-url: string,
    most-recent-instance: alert-instance,
    number: s32,
    rule: alert-rule,
    state: alert-state,
    tool: analysis-tool,
    updated-at: option<string>,
    url: string
  }

  record analysis {
    analysis-key: string,
    category: option<string>,
    commit-sha: string,
    created-at: string,
    deletable: bool,
    environment: string,
    error: string,
    /// Unique identifier for this analysis.
    id: s32,
    ref: string,
    /// The total number of results in the analysis.
    results-count: s32,
    /// The total number of rules used in the analysis.
    rules-count: s32,
    sarif-id: string,
    tool: analysis-tool,
    url: string,
    /// Warning generated when processing the analysis
    warning: string
  }

  /// Successful deletion of a code scanning analysis
  record analysis-deletion {
    /// Next deletable analysis in chain, with last analysis deletion confirmation
    confirm-delete-url: string,
    /// Next deletable analysis in chain, without last analysis deletion confirmation
    next-analysis-url: string
  }

  /// A CodeQL database.
  record codeql-database {
    /// The MIME type of the CodeQL database file.
    content-type: string,
    /// The date and time at which the CodeQL database was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ.
    created-at: string,
    /// The ID of the CodeQL database.
    id: s32,
    /// The language of the CodeQL database.
    language: string,
    /// The name of the CodeQL database.
    name: string,
    /// The size of the CodeQL database file in bytes.
    size: s32,
    /// The date and time at which the CodeQL database was last updated, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ.
    updated-at: string,
    uploader: simple-user,
    /// The URL at which to download the CodeQL database. The `Accept` header must be set to the value of the `content_type` property.
    url: string
  }

  record sarifs-receipt {
    id: option<string>,
    /// The REST API URL for checking the status of the upload.
    url: option<string>
  }

  record sarifs-status {
    /// The REST API URL for getting the analyses associated with the upload.
    analyses-url: option<string>,
    /// Any errors that ocurred during processing of the delivery.
    errors: option<list<string>>,
    /// `pending` files have not yet been processed, while `complete` means results from the SARIF have been stored. `failed` files have either not been processed at all, or could only be partially processed.
    processing-status: option<sarifs-status-processing-status-enum>
  }

  variant list-alerts-for-org-error {
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant list-alerts-for-repo-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant get-alert-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant update-alert-error {
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant list-alert-instances-error {
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant list-recent-analyses-error {
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant get-analysis-error {
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant delete-analysis-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant list-codeql-databases-error {
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant get-codeql-database-error {
    found(string),
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant upload-sarif-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    payload-too-large(string),
    service-unavailable(string),
    other(string)
  }

  variant get-sarif-error {
    forbidden(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  /// List code scanning alerts for an organization
  record list-alerts-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of a code scanning tool. Only results by this tool will be listed. You can specify the tool by using either `tool_name` or `tool_guid`, but not both.
    tool-name: option<string>,
    /// The GUID of a code scanning tool. Only results by this tool will be listed. Note that some code scanning tools may not include a GUID in their analysis data. You can specify the tool by using either `tool_guid` or `tool_name`, but not both.
    tool-guid: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results before this cursor.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results after this cursor.
    after: option<string>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-org-direction-enum>,
    /// If specified, only code scanning alerts with this state will be returned.
    state: option<alert-state>,
    /// The property by which to sort the results.
    sort: option<list-alerts-for-org-sort-enum>,
    /// If specified, only code scanning alerts with this severity will be returned.
    severity: option<alert-severity>
  }
  list-alerts-for-org: func(params: list-alerts-for-org-params) -> result<list<organization-alert-items>, list-alerts-for-org-error>;

  /// List code scanning alerts for a repository
  record list-alerts-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of a code scanning tool. Only results by this tool will be listed. You can specify the tool by using either `tool_name` or `tool_guid`, but not both.
    tool-name: option<string>,
    /// The GUID of a code scanning tool. Only results by this tool will be listed. Note that some code scanning tools may not include a GUID in their analysis data. You can specify the tool by using either `tool_guid` or `tool_name`, but not both.
    tool-guid: option<string>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The Git reference for the results you want to list. The `ref` for a branch can be formatted either as `refs/heads/<branch name>` or simply `<branch name>`. To reference a pull request use `refs/pull/<number>/merge`.
    ref: option<string>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-org-direction-enum>,
    /// The property by which to sort the results.
    sort: option<list-alerts-for-org-sort-enum>,
    /// If specified, only code scanning alerts with this state will be returned.
    state: option<alert-state>,
    /// If specified, only code scanning alerts with this severity will be returned.
    severity: option<alert-severity>
  }
  list-alerts-for-repo: func(params: list-alerts-for-repo-params) -> result<list<alert-items>, list-alerts-for-repo-error>;

  /// Get a code scanning alert
  record get-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string
  }
  get-alert: func(params: get-alert-params) -> result<alert, get-alert-error>;

  /// Update a code scanning alert
  record update-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string,
    dismissed-comment: option<string>,
    dismissed-reason: option<alert-dismissed-reason>,
    state: alert-set-state
  }
  update-alert: func(params: update-alert-params) -> result<alert, update-alert-error>;

  /// List instances of a code scanning alert
  record list-alert-instances-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The Git reference for the results you want to list. The `ref` for a branch can be formatted either as `refs/heads/<branch name>` or simply `<branch name>`. To reference a pull request use `refs/pull/<number>/merge`.
    ref: option<string>
  }
  list-alert-instances: func(params: list-alert-instances-params) -> result<list<alert-instance>, list-alert-instances-error>;

  /// List code scanning analyses for a repository
  record list-recent-analyses-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of a code scanning tool. Only results by this tool will be listed. You can specify the tool by using either `tool_name` or `tool_guid`, but not both.
    tool-name: option<string>,
    /// The GUID of a code scanning tool. Only results by this tool will be listed. Note that some code scanning tools may not include a GUID in their analysis data. You can specify the tool by using either `tool_guid` or `tool_name`, but not both.
    tool-guid: option<string>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The Git reference for the analyses you want to list. The `ref` for a branch can be formatted either as `refs/heads/<branch name>` or simply `<branch name>`. To reference a pull request use `refs/pull/<number>/merge`.
    ref: option<string>,
    /// Filter analyses belonging to the same SARIF upload.
    sarif-id: option<string>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-org-direction-enum>,
    /// The property by which to sort the results.
    sort: option<list-recent-analyses-sort-enum>
  }
  list-recent-analyses: func(params: list-recent-analyses-params) -> result<list<analysis>, list-recent-analyses-error>;

  /// Get a code scanning analysis for a repository
  record get-analysis-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the analysis, as returned from the `GET /repos/{owner}/{repo}/code-scanning/analyses` operation.
    analysis-id: string
  }
  get-analysis: func(params: get-analysis-params) -> result<analysis, get-analysis-error>;

  /// Delete a code scanning analysis from a repository
  record delete-analysis-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the analysis, as returned from the `GET /repos/{owner}/{repo}/code-scanning/analyses` operation.
    analysis-id: string,
    /// Allow deletion if the specified analysis is the last in a set. If you attempt to delete the final analysis in a set without setting this parameter to `true`, you'll get a 400 response with the message: `Analysis is last of its type and deletion may result in the loss of historical alert data. Please specify confirm_delete.`
    confirm-delete: option<string>
  }
  delete-analysis: func(params: delete-analysis-params) -> result<analysis-deletion, delete-analysis-error>;

  /// List CodeQL databases for a repository
  record list-codeql-databases-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  list-codeql-databases: func(params: list-codeql-databases-params) -> result<list<codeql-database>, list-codeql-databases-error>;

  /// Get a CodeQL database for a repository
  record get-codeql-database-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The language of the CodeQL database.
    language: string
  }
  get-codeql-database: func(params: get-codeql-database-params) -> result<codeql-database, get-codeql-database-error>;

  /// Upload an analysis as SARIF data
  record upload-sarif-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The base directory used in the analysis, as it appears in the SARIF file.
    /// This property is used to convert file paths from absolute to relative, so that alerts can be mapped to their correct location in the repository.
    checkout-uri: option<string>,
    commit-sha: string,
    ref: string,
    sarif: string,
    /// The time that the analysis run began. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    started-at: option<string>,
    /// The name of the tool used to generate the code scanning analysis. If this parameter is not used, the tool name defaults to "API". If the uploaded SARIF contains a tool GUID, this will be available for filtering using the `tool_guid` parameter of operations such as `GET /repos/{owner}/{repo}/code-scanning/alerts`.
    tool-name: option<string>,
    /// Whether the SARIF file will be validated according to the code scanning specifications.
    /// This parameter is intended to help integrators ensure that the uploaded SARIF files are correctly rendered by code scanning.
    validate: option<bool>
  }
  upload-sarif: func(params: upload-sarif-params) -> result<sarifs-receipt, upload-sarif-error>;

  /// Get information about a SARIF upload
  record get-sarif-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The SARIF ID obtained after uploading.
    sarif-id: string
  }
  get-sarif: func(params: get-sarif-params) -> result<sarifs-status, get-sarif-error>;

}

interface codespaces {
  enum codespace-location-enum {
    east-us,
    south-east-asia,
    west-europe,
    west-us2,
  }

  enum nullable-codespace-machine-prebuild-availability-enum {
    none,
    ready,
    in-progress,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum codespace-state-enum {
    unknown,
    created,
    queued,
    provisioning,
    available,
    awaiting,
    unavailable,
    deleted,
    moved,
    shutdown,
    archived,
    starting,
    shutting-down,
    failed,
    exporting,
    updating,
    rebuilding,
  }

  enum set-codespaces-billing-body-visibility-enum {
    disabled,
    selected-members,
    all-members,
    all-members-and-outside-collaborators,
  }

  enum org-secret-visibility-enum {
    all,
    private,
    selected,
  }

  enum full-repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum full-repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  record list-in-organization-response {
    codespaces: list<codespace>,
    total-count: s32
  }

  /// A codespace.
  record codespace {
    billable-owner: simple-user,
    created-at: string,
    /// Path to devcontainer.json from repo root used to create Codespace.
    devcontainer-path: option<string>,
    /// Display name for this codespace.
    display-name: option<string>,
    /// UUID identifying this codespace's environment.
    environment-id: string,
    /// Details about the codespace's git repository.
    git-status: codespace-git-status,
    id: s32,
    /// The number of minutes of inactivity after which this codespace will be automatically stopped.
    idle-timeout-minutes: s32,
    /// Text to show user when codespace idle timeout minutes has been overriden by an organization policy
    idle-timeout-notice: option<string>,
    /// The text to display to a user when a codespace has been stopped for a potentially actionable reason.
    last-known-stop-notice: option<string>,
    /// Last known time this codespace was started.
    last-used-at: string,
    /// The Azure region where this codespace is located.
    location: codespace-location-enum,
    machine: nullable-codespace-machine,
    /// API URL to access available alternate machine types for this codespace.
    machines-url: string,
    /// Automatically generated name of this codespace.
    name: string,
    owner: simple-user,
    /// Whether or not a codespace has a pending async operation. This would mean that the codespace is temporarily unavailable. The only thing that you can do with a codespace in this state is delete it.
    pending-operation: option<bool>,
    /// Text to show user when codespace is disabled by a pending operation
    pending-operation-disabled-reason: option<string>,
    /// Whether the codespace was created from a prebuild.
    prebuild: bool,
    /// API URL to publish this codespace to a new repository.
    publish-url: option<string>,
    /// API URL for the Pull Request associated with this codespace, if any.
    pulls-url: string,
    recent-folders: list<string>,
    repository: minimal-repository,
    /// When a codespace will be auto-deleted based on the "retention_period_minutes" and "last_used_at"
    retention-expires-at: option<string>,
    /// Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).
    retention-period-minutes: option<s32>,
    runtime-constraints: option<codespace-runtime-constraints>,
    /// API URL to start this codespace.
    start-url: string,
    /// State of this codespace.
    state: codespace-state-enum,
    /// API URL to stop this codespace.
    stop-url: string,
    updated-at: string,
    /// API URL for this codespace.
    url: string,
    /// URL to access this codespace on the web.
    web-url: string
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Details about the codespace's git repository.
  record codespace-git-status {
    /// The number of commits the local repository is ahead of the remote.
    ahead: option<s32>,
    /// The number of commits the local repository is behind the remote.
    behind: option<s32>,
    /// Whether the local repository has uncommitted changes.
    has-uncommitted-changes: option<bool>,
    /// Whether the local repository has unpushed changes.
    has-unpushed-changes: option<bool>,
    /// The current branch (or SHA if in detached HEAD state) of the local repository.
    ref: option<string>
  }

  /// A description of the machine powering a codespace.
  record nullable-codespace-machine {
    /// How many cores are available to the codespace.
    cpus: s32,
    /// The display name of the machine includes cores, memory, and storage.
    display-name: string,
    /// How much memory is available to the codespace.
    memory-in-bytes: s32,
    /// The name of the machine.
    name: string,
    /// The operating system of the machine.
    operating-system: string,
    /// Whether a prebuild is currently available when creating a codespace for this machine and repository. If a branch was not specified as a ref, the default branch will be assumed. Value will be "null" if prebuilds are not supported or prebuild availability could not be determined. Value will be "none" if no prebuild is available. Latest values "ready" and "in_progress" indicate the prebuild availability status.
    prebuild-availability: nullable-codespace-machine-prebuild-availability-enum,
    /// How much storage is available to the codespace.
    storage-in-bytes: s32
  }

  /// Minimal Repository
  record minimal-repository {
    allow-forking: option<bool>,
    archive-url: string,
    archived: option<bool>,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: option<string>,
    code-of-conduct: option<code-of-conduct>,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: option<string>,
    default-branch: option<string>,
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    disabled: option<bool>,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: option<s32>,
    forks-count: option<s32>,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: option<string>,
    has-discussions: option<bool>,
    has-downloads: option<bool>,
    has-issues: option<bool>,
    has-pages: option<bool>,
    has-projects: option<bool>,
    has-wiki: option<bool>,
    homepage: option<string>,
    hooks-url: string,
    html-url: string,
    id: s32,
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: option<string>,
    languages-url: string,
    license: option<minimal-repository-license>,
    merges-url: string,
    milestones-url: string,
    mirror-url: option<string>,
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: option<s32>,
    open-issues-count: option<s32>,
    owner: simple-user,
    permissions: option<minimal-repository-permissions>,
    private: bool,
    pulls-url: string,
    pushed-at: option<string>,
    releases-url: string,
    role-name: option<string>,
    security-and-analysis: option<security-and-analysis>,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: option<s32>,
    ssh-url: option<string>,
    stargazers-count: option<s32>,
    stargazers-url: string,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: option<string>,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: option<string>,
    url: string,
    visibility: option<string>,
    watchers: option<s32>,
    watchers-count: option<s32>,
    web-commit-signoff-required: option<bool>
  }

  /// Code Of Conduct
  record code-of-conduct {
    body: option<string>,
    html-url: string,
    key: string,
    name: string,
    url: string
  }

  record minimal-repository-license {
    key: option<string>,
    name: option<string>,
    node-id: option<string>,
    spdx-id: option<string>,
    url: option<string>
  }

  record minimal-repository-permissions {
    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  record security-and-analysis {
    advanced-security: option<security-and-analysis-advanced-security>,
    secret-scanning: option<security-and-analysis-secret-scanning>,
    secret-scanning-push-protection: option<security-and-analysis-secret-scanning-push-protection>
  }

  record security-and-analysis-advanced-security {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning-push-protection {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record codespace-runtime-constraints {
    /// The privacy settings a user can select from when forwarding a port.
    allowed-port-privacy-settings: option<list<string>>
  }

  record list-org-secrets-response {
    secrets: list<org-secret>,
    total-count: s32
  }

  /// Secrets for a GitHub Codespace.
  record org-secret {
    /// The date and time at which the secret was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ.
    created-at: string,
    /// The name of the secret
    name: string,
    /// The API URL at which the list of repositories this secret is visible to can be retrieved
    selected-repositories-url: option<string>,
    /// The date and time at which the secret was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ.
    updated-at: string,
    /// The type of repositories in the organization that the secret is visible to
    visibility: org-secret-visibility-enum
  }

  /// The public key used for setting Codespaces secrets.
  record public-key {
    created-at: option<string>,
    id: option<s32>,
    /// The Base64 encoded public key.
    key: string,
    /// The identifier for the key.
    key-id: string,
    title: option<string>,
    url: option<string>
  }

  /// An object without any properties.
  record empty-object {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record list-selected-repos-for-org-secret-response {
    repositories: list<minimal-repository>,
    total-count: s32
  }

  record get-codespaces-for-user-in-org-response {
    codespaces: list<codespace>,
    total-count: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-from-organization-response-entry {
    key: string,
    value: string
  }

  record list-in-repository-for-authenticated-user-response {
    codespaces: list<codespace>,
    total-count: s32
  }

  record list-devcontainers-in-repository-for-authenticated-user-response {
    devcontainers: list<list-devcontainers-in-repository-for-authenticated-user-response-devcontainers-item>,
    total-count: s32
  }

  record list-devcontainers-in-repository-for-authenticated-user-response-devcontainers-item {
    name: option<string>,
    path: string
  }

  record repo-machines-for-authenticated-user-response {
    machines: list<codespace-machine>,
    total-count: s32
  }

  /// A description of the machine powering a codespace.
  record codespace-machine {
    /// How many cores are available to the codespace.
    cpus: s32,
    /// The display name of the machine includes cores, memory, and storage.
    display-name: string,
    /// How much memory is available to the codespace.
    memory-in-bytes: s32,
    /// The name of the machine.
    name: string,
    /// The operating system of the machine.
    operating-system: string,
    /// Whether a prebuild is currently available when creating a codespace for this machine and repository. If a branch was not specified as a ref, the default branch will be assumed. Value will be "null" if prebuilds are not supported or prebuild availability could not be determined. Value will be "none" if no prebuild is available. Latest values "ready" and "in_progress" indicate the prebuild availability status.
    prebuild-availability: nullable-codespace-machine-prebuild-availability-enum,
    /// How much storage is available to the codespace.
    storage-in-bytes: s32
  }

  record pre-flight-with-repo-for-authenticated-user-response {
    billable-owner: option<simple-user>,
    defaults: option<pre-flight-with-repo-for-authenticated-user-response-defaults>
  }

  record pre-flight-with-repo-for-authenticated-user-response-defaults {
    devcontainer-path: string,
    location: string
  }

  record list-repo-secrets-response {
    secrets: list<repo-codespaces-secret>,
    total-count: s32
  }

  /// Set repository secrets for GitHub Codespaces.
  record repo-codespaces-secret {
    created-at: string,
    /// The name of the secret.
    name: string,
    updated-at: string
  }

  record list-for-authenticated-user-response {
    codespaces: list<codespace>,
    total-count: s32
  }

  record list-secrets-for-authenticated-user-response {
    secrets: list<secret>,
    total-count: s32
  }

  /// Secrets for a GitHub Codespace.
  record secret {
    /// The date and time at which the secret was created, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ.
    created-at: string,
    /// The name of the secret
    name: string,
    /// The API URL at which the list of repositories this secret is visible to can be retrieved
    selected-repositories-url: string,
    /// The date and time at which the secret was last updated, in ISO 8601 format':' YYYY-MM-DDTHH:MM:SSZ.
    updated-at: string,
    /// The type of repositories in the organization that the secret is visible to
    visibility: org-secret-visibility-enum
  }

  /// The public key used for setting user Codespaces' Secrets.
  record user-public-key {
    /// The Base64 encoded public key.
    key: string,
    /// The identifier for the key.
    key-id: string
  }

  record list-repositories-for-secret-for-authenticated-user-response {
    repositories: list<minimal-repository>,
    total-count: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record delete-for-authenticated-user-response-entry {
    key: string,
    value: string
  }

  /// An export of a codespace. Also, latest export details for a codespace can be fetched with id = latest
  record codespace-export-details {
    /// Name of the exported branch
    branch: option<string>,
    /// Completion time of the last export operation
    completed-at: option<string>,
    /// Url for fetching export details
    export-url: option<string>,
    /// Web url for the exported branch
    html-url: option<string>,
    /// Id for the export details
    id: option<string>,
    /// Git commit SHA of the exported branch
    sha: option<string>,
    /// State of the latest export
    state: option<string>
  }

  record codespace-machines-for-authenticated-user-response {
    machines: list<codespace-machine>,
    total-count: s32
  }

  /// A codespace.
  record codespace-with-full-repository {
    billable-owner: simple-user,
    created-at: string,
    /// Path to devcontainer.json from repo root used to create Codespace.
    devcontainer-path: option<string>,
    /// Display name for this codespace.
    display-name: option<string>,
    /// UUID identifying this codespace's environment.
    environment-id: string,
    /// Details about the codespace's git repository.
    git-status: codespace-with-full-repository-git-status,
    id: s32,
    /// The number of minutes of inactivity after which this codespace will be automatically stopped.
    idle-timeout-minutes: s32,
    /// Text to show user when codespace idle timeout minutes has been overriden by an organization policy
    idle-timeout-notice: option<string>,
    /// Last known time this codespace was started.
    last-used-at: string,
    /// The Azure region where this codespace is located.
    location: codespace-location-enum,
    machine: nullable-codespace-machine,
    /// API URL to access available alternate machine types for this codespace.
    machines-url: string,
    /// Automatically generated name of this codespace.
    name: string,
    owner: simple-user,
    /// Whether or not a codespace has a pending async operation. This would mean that the codespace is temporarily unavailable. The only thing that you can do with a codespace in this state is delete it.
    pending-operation: option<bool>,
    /// Text to show user when codespace is disabled by a pending operation
    pending-operation-disabled-reason: option<string>,
    /// Whether the codespace was created from a prebuild.
    prebuild: bool,
    /// API URL to publish this codespace to a new repository.
    publish-url: option<string>,
    /// API URL for the Pull Request associated with this codespace, if any.
    pulls-url: string,
    recent-folders: list<string>,
    repository: full-repository,
    /// When a codespace will be auto-deleted based on the "retention_period_minutes" and "last_used_at"
    retention-expires-at: option<string>,
    /// Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).
    retention-period-minutes: option<s32>,
    runtime-constraints: option<codespace-with-full-repository-runtime-constraints>,
    /// API URL to start this codespace.
    start-url: string,
    /// State of this codespace.
    state: codespace-state-enum,
    /// API URL to stop this codespace.
    stop-url: string,
    updated-at: string,
    /// API URL for this codespace.
    url: string,
    /// URL to access this codespace on the web.
    web-url: string
  }

  /// Details about the codespace's git repository.
  record codespace-with-full-repository-git-status {
    /// The number of commits the local repository is ahead of the remote.
    ahead: option<s32>,
    /// The number of commits the local repository is behind the remote.
    behind: option<s32>,
    /// Whether the local repository has uncommitted changes.
    has-uncommitted-changes: option<bool>,
    /// Whether the local repository has unpushed changes.
    has-unpushed-changes: option<bool>,
    /// The current branch (or SHA if in detached HEAD state) of the local repository.
    ref: option<string>
  }

  /// Full Repository
  record full-repository {
    allow-auto-merge: option<bool>,
    allow-forking: option<bool>,
    allow-merge-commit: option<bool>,
    allow-rebase-merge: option<bool>,
    allow-squash-merge: option<bool>,
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is allowed.
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    code-of-conduct: option<code-of-conduct-simple>,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: string,
    default-branch: string,
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    /// Returns whether or not this repository disabled.
    disabled: bool,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: s32,
    forks-count: s32,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: string,
    has-discussions: bool,
    has-downloads: bool,
    has-issues: bool,
    has-pages: bool,
    has-projects: bool,
    has-wiki: bool,
    homepage: string,
    hooks-url: string,
    html-url: string,
    id: s32,
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: string,
    languages-url: string,
    license: nullable-license-simple,
    master-branch: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<full-repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<full-repository-merge-commit-title-enum>,
    merges-url: string,
    milestones-url: string,
    mirror-url: string,
    name: string,
    network-count: s32,
    node-id: string,
    notifications-url: string,
    open-issues: s32,
    open-issues-count: s32,
    organization: option<nullable-simple-user>,
    owner: simple-user,
    parent: option<repository>,
    permissions: option<full-repository-permissions>,
    private: bool,
    pulls-url: string,
    pushed-at: string,
    releases-url: string,
    security-and-analysis: option<security-and-analysis>,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: s32,
    source: option<repository>,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: string,
    stargazers-count: s32,
    stargazers-url: string,
    statuses-url: string,
    subscribers-count: s32,
    subscribers-url: string,
    subscription-url: string,
    svn-url: string,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    template-repository: option<nullable-repository>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: string,
    url: string,
    use-squash-pr-title-as-default: option<bool>,
    /// The repository visibility: public, private, or internal.
    visibility: option<string>,
    watchers: s32,
    watchers-count: s32,
    web-commit-signoff-required: option<bool>
  }

  /// Code of Conduct Simple
  record code-of-conduct-simple {
    html-url: string,
    key: string,
    name: string,
    url: string
  }

  /// License Simple
  record nullable-license-simple {
    html-url: option<string>,
    key: string,
    name: string,
    node-id: string,
    spdx-id: string,
    url: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A repository on GitHub.
  record repository {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow forking this repo
    allow-forking: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is enabled for this repository
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    /// Whether the repository is archived.
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    collaborators-url: string,
    comments-url: string,
