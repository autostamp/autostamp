    url: option<string>
  }

  record repository-template-repository-permissions {
    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  record result-text-matches-item-v3 {
    fragment: option<string>,
    matches: option<list<result-text-matches-item-v3-matches-item>>,
    object-type: option<string>,
