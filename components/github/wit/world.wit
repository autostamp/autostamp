    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the workflow. You can also pass the workflow file name as a string.
    workflow-id: string
  }
  disable-workflow: func(params: disable-workflow-params) -> result<string, string>;

  /// Create a workflow dispatch event
  record create-workflow-dispatch-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the workflow. You can also pass the workflow file name as a string.
    workflow-id: string,
    /// Input keys and values configured in the workflow file. The maximum number of properties is 10. Any default properties configured in the workflow file will be used when `inputs` are omitted.
    inputs: option<create-workflow-dispatch-body-inputs>,
    /// The git reference for the workflow. The reference can be a branch or tag name.
    ref: string
  }
  create-workflow-dispatch: func(params: create-workflow-dispatch-params) -> result<string, string>;

  /// Enable a workflow
  record enable-workflow-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the workflow. You can also pass the workflow file name as a string.
    workflow-id: string
  }
  enable-workflow: func(params: enable-workflow-params) -> result<string, string>;

  /// List workflow runs for a workflow
  record list-workflow-runs-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the workflow. You can also pass the workflow file name as a string.
    workflow-id: string,
    /// Returns someone's workflow runs. Use the login for the user who created the `push` associated with the check suite or workflow run.
    actor: option<string>,
    /// Returns workflow runs associated with a branch. Use the name of the branch of the `push`.
    branch: option<string>,
    /// Returns workflow run triggered by the event you specify. For example, `push`, `pull_request` or `issue`. For more information, see "[Events that trigger workflows](https://docs.github.com/actions/automating-your-workflow-with-github-actions/events-that-trigger-workflows)."
    event: option<string>,
    /// Returns workflow runs with the check run `status` or `conclusion` that you specify. For example, a conclusion can be `success` or a status can be `in_progress`. Only GitHub can set a status of `waiting` or `requested`.
    status: option<list-required-workflow-runs-status-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Returns workflow runs created within the given date-time range. For more information on the syntax, see "[Understanding the search syntax](https://docs.github.com/search-github/getting-started-with-searching-on-github/understanding-the-search-syntax#query-for-dates)."
    created: option<string>,
    /// If `true` pull requests are omitted from the response (empty array).
    exclude-pull-requests: option<bool>,
    /// Returns workflow runs with the `check_suite_id` that you specify.
    check-suite-id: option<s32>,
    /// Only returns workflow runs that are associated with the specified `head_sha`.
    head-sha: option<string>
  }
  list-workflow-runs: func(params: list-workflow-runs-params) -> result<string, string>;

  /// Get workflow usage
  record get-workflow-usage-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the workflow. You can also pass the workflow file name as a string.
    workflow-id: string
  }
  get-workflow-usage: func(params: get-workflow-usage-params) -> result<string, string>;

  /// List environment secrets
  record list-environment-secrets-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the environment.
    environment-name: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-environment-secrets: func(params: list-environment-secrets-params) -> result<string, string>;

  /// Get an environment public key
  record get-environment-public-key-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the environment.
    environment-name: string
  }
  get-environment-public-key: func(params: get-environment-public-key-params) -> result<string, string>;

  /// Get an environment secret
  record get-environment-secret-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the environment.
    environment-name: string,
    /// The name of the secret.
    secret-name: string
  }
  get-environment-secret: func(params: get-environment-secret-params) -> result<string, string>;

  /// Create or update an environment secret
  record create-or-update-environment-secret-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the environment.
    environment-name: string,
    /// The name of the secret.
    secret-name: string,
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an environment public key](https://docs.github.com/rest/reference/actions#get-an-environment-public-key) endpoint.
    encrypted-value: string,
    /// ID of the key you used to encrypt the secret.
    key-id: string
  }
  create-or-update-environment-secret: func(params: create-or-update-environment-secret-params) -> result<string, string>;

  /// Delete an environment secret
  record delete-environment-secret-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the environment.
    environment-name: string,
    /// The name of the secret.
    secret-name: string
  }
  delete-environment-secret: func(params: delete-environment-secret-params) -> result<string, string>;

  /// List environment variables
  record list-environment-variables-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the environment.
    environment-name: string,
    /// The number of results per page (max 30).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-environment-variables: func(params: list-environment-variables-params) -> result<string, string>;

  /// Create an environment variable
  record create-environment-variable-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the environment.
    environment-name: string,
    /// The name of the variable.
    name: string,
    /// The value of the variable.
    value: string
  }
  create-environment-variable: func(params: create-environment-variable-params) -> result<string, string>;

  /// Get an environment variable
  record get-environment-variable-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the environment.
    environment-name: string,
    /// The name of the variable.
    name: string
  }
  get-environment-variable: func(params: get-environment-variable-params) -> result<string, string>;

  /// Update an environment variable
  record update-environment-variable-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the variable.
    name: string,
    /// The name of the environment.
    environment-name: string,
    /// The value of the variable.
    value: option<string>
  }
  update-environment-variable: func(params: update-environment-variable-params) -> result<string, string>;

  /// Delete an environment variable
  record delete-environment-variable-params {
    /// The unique identifier of the repository.
    repository-id: string,
    /// The name of the variable.
    name: string,
    /// The name of the environment.
    environment-name: string
  }
  delete-environment-variable: func(params: delete-environment-variable-params) -> result<string, string>;

}

interface oidc {
  /// Get the customization template for an OIDC subject claim for an organization
  record get-oidc-custom-sub-template-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-oidc-custom-sub-template-for-org: func(params: get-oidc-custom-sub-template-for-org-params) -> result<string, string>;

  /// Set the customization template for an OIDC subject claim for an organization
  record update-oidc-custom-sub-template-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Array of unique strings. Each claim key can only contain alphanumeric characters and underscores.
    include-claim-keys: list<string>
  }
  update-oidc-custom-sub-template-for-org: func(params: update-oidc-custom-sub-template-for-org-params) -> result<string, string>;

}

interface code-scanning {
  enum list-alerts-for-org-direction-enum {
    asc,
    desc,
  }

  enum list-alerts-for-org-sort-enum {
    created,
    updated,
  }

  enum list-recent-analyses-sort-enum {
    created,
  }

  /// The name of the tool used to generate the code scanning analysis.
  record analysis-tool-name {
    /// opaque schema; raw JSON
    value: string
  }

  /// The GUID of the tool used to generate the code scanning analysis, if provided in the uploaded SARIF data.
  record analysis-tool-guid {
    /// opaque schema; raw JSON
    value: string
  }

  /// State of a code scanning alert.
  record alert-state {
    /// opaque schema; raw JSON
    value: string
  }

  /// Severity of a code scanning alert.
  record alert-severity {
    /// opaque schema; raw JSON
    value: string
  }

  /// The full Git reference, formatted as `refs/heads/<branch name>`,
  /// `refs/pull/<number>/merge`, or `refs/pull/<number>/head`.
  record ref {
    /// opaque schema; raw JSON
    value: string
  }

  /// The dismissal comment associated with the dismissal of the alert.
  record alert-dismissed-comment {
    /// opaque schema; raw JSON
    value: string
  }

  /// **Required when the state is dismissed.** The reason for dismissing or closing the alert.
  record alert-dismissed-reason {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the state of the code scanning alert. You must provide `dismissed_reason` when you set the state to `dismissed`.
  record alert-set-state {
    /// opaque schema; raw JSON
    value: string
  }

  /// An identifier for the upload.
  record analysis-sarif-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The SHA of the commit to which the analysis you are uploading relates.
  record analysis-commit-sha {
    /// opaque schema; raw JSON
    value: string
  }

  /// A Base64 string representing the SARIF file to upload. You must first compress your SARIF file using [`gzip`](http://www.gnu.org/software/gzip/manual/gzip.html) and then translate the contents of the file into a Base64 encoding string. For more information, see "[SARIF support for code scanning](https://docs.github.com/code-security/secure-coding/sarif-support-for-code-scanning)."
  record analysis-sarif-file {
    /// opaque schema; raw JSON
    value: string
  }

  /// List code scanning alerts for an organization
  record list-alerts-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of a code scanning tool. Only results by this tool will be listed. You can specify the tool by using either `tool_name` or `tool_guid`, but not both.
    tool-name: option<analysis-tool-name>,
    /// The GUID of a code scanning tool. Only results by this tool will be listed. Note that some code scanning tools may not include a GUID in their analysis data. You can specify the tool by using either `tool_guid` or `tool_name`, but not both.
    tool-guid: option<analysis-tool-guid>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results before this cursor.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results after this cursor.
    after: option<string>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-org-direction-enum>,
    /// If specified, only code scanning alerts with this state will be returned.
    state: option<alert-state>,
    /// The property by which to sort the results.
    sort: option<list-alerts-for-org-sort-enum>,
    /// If specified, only code scanning alerts with this severity will be returned.
    severity: option<alert-severity>
  }
  list-alerts-for-org: func(params: list-alerts-for-org-params) -> result<string, string>;

  /// List code scanning alerts for a repository
  record list-alerts-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of a code scanning tool. Only results by this tool will be listed. You can specify the tool by using either `tool_name` or `tool_guid`, but not both.
    tool-name: option<analysis-tool-name>,
    /// The GUID of a code scanning tool. Only results by this tool will be listed. Note that some code scanning tools may not include a GUID in their analysis data. You can specify the tool by using either `tool_guid` or `tool_name`, but not both.
    tool-guid: option<analysis-tool-guid>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The Git reference for the results you want to list. The `ref` for a branch can be formatted either as `refs/heads/<branch name>` or simply `<branch name>`. To reference a pull request use `refs/pull/<number>/merge`.
    ref: option<ref>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-org-direction-enum>,
    /// The property by which to sort the results.
    sort: option<list-alerts-for-org-sort-enum>,
    /// If specified, only code scanning alerts with this state will be returned.
    state: option<alert-state>,
    /// If specified, only code scanning alerts with this severity will be returned.
    severity: option<alert-severity>
  }
  list-alerts-for-repo: func(params: list-alerts-for-repo-params) -> result<string, string>;

  /// Get a code scanning alert
  record get-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string
  }
  get-alert: func(params: get-alert-params) -> result<string, string>;

  /// Update a code scanning alert
  record update-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string,
    dismissed-comment: option<alert-dismissed-comment>,
    dismissed-reason: option<alert-dismissed-reason>,
    state: alert-set-state
  }
  update-alert: func(params: update-alert-params) -> result<string, string>;

  /// List instances of a code scanning alert
  record list-alert-instances-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The Git reference for the results you want to list. The `ref` for a branch can be formatted either as `refs/heads/<branch name>` or simply `<branch name>`. To reference a pull request use `refs/pull/<number>/merge`.
    ref: option<ref>
  }
  list-alert-instances: func(params: list-alert-instances-params) -> result<string, string>;

  /// List code scanning analyses for a repository
  record list-recent-analyses-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of a code scanning tool. Only results by this tool will be listed. You can specify the tool by using either `tool_name` or `tool_guid`, but not both.
    tool-name: option<analysis-tool-name>,
    /// The GUID of a code scanning tool. Only results by this tool will be listed. Note that some code scanning tools may not include a GUID in their analysis data. You can specify the tool by using either `tool_guid` or `tool_name`, but not both.
    tool-guid: option<analysis-tool-guid>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The Git reference for the analyses you want to list. The `ref` for a branch can be formatted either as `refs/heads/<branch name>` or simply `<branch name>`. To reference a pull request use `refs/pull/<number>/merge`.
    ref: option<ref>,
    /// Filter analyses belonging to the same SARIF upload.
    sarif-id: option<analysis-sarif-id>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-org-direction-enum>,
    /// The property by which to sort the results.
    sort: option<list-recent-analyses-sort-enum>
  }
  list-recent-analyses: func(params: list-recent-analyses-params) -> result<string, string>;

  /// Get a code scanning analysis for a repository
  record get-analysis-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the analysis, as returned from the `GET /repos/{owner}/{repo}/code-scanning/analyses` operation.
    analysis-id: string
  }
  get-analysis: func(params: get-analysis-params) -> result<string, string>;

  /// Delete a code scanning analysis from a repository
  record delete-analysis-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The ID of the analysis, as returned from the `GET /repos/{owner}/{repo}/code-scanning/analyses` operation.
    analysis-id: string,
    /// Allow deletion if the specified analysis is the last in a set. If you attempt to delete the final analysis in a set without setting this parameter to `true`, you'll get a 400 response with the message: `Analysis is last of its type and deletion may result in the loss of historical alert data. Please specify confirm_delete.`
    confirm-delete: option<string>
  }
  delete-analysis: func(params: delete-analysis-params) -> result<string, string>;

  /// List CodeQL databases for a repository
  record list-codeql-databases-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  list-codeql-databases: func(params: list-codeql-databases-params) -> result<string, string>;

  /// Get a CodeQL database for a repository
  record get-codeql-database-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The language of the CodeQL database.
    language: string
  }
  get-codeql-database: func(params: get-codeql-database-params) -> result<string, string>;

  /// Upload an analysis as SARIF data
  record upload-sarif-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The base directory used in the analysis, as it appears in the SARIF file.
    /// This property is used to convert file paths from absolute to relative, so that alerts can be mapped to their correct location in the repository.
    checkout-uri: option<string>,
    commit-sha: analysis-commit-sha,
    ref: ref,
    sarif: analysis-sarif-file,
    /// The time that the analysis run began. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    started-at: option<string>,
    /// The name of the tool used to generate the code scanning analysis. If this parameter is not used, the tool name defaults to "API". If the uploaded SARIF contains a tool GUID, this will be available for filtering using the `tool_guid` parameter of operations such as `GET /repos/{owner}/{repo}/code-scanning/alerts`.
    tool-name: option<string>,
    /// Whether the SARIF file will be validated according to the code scanning specifications.
    /// This parameter is intended to help integrators ensure that the uploaded SARIF files are correctly rendered by code scanning.
    validate: option<bool>
  }
  upload-sarif: func(params: upload-sarif-params) -> result<string, string>;

  /// Get information about a SARIF upload
  record get-sarif-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The SARIF ID obtained after uploading.
    sarif-id: string
  }
  get-sarif: func(params: get-sarif-params) -> result<string, string>;

}

interface codespaces {
  enum set-codespaces-billing-body-visibility-enum {
    disabled,
    selected-members,
    all-members,
    all-members-and-outside-collaborators,
  }

  enum create-or-update-org-secret-body-visibility-enum {
    all,
    private,
    selected,
  }

  /// List codespaces for the organization
  record list-in-organization-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The organization name. The name is not case sensitive.
    org: string
  }
  list-in-organization: func(params: list-in-organization-params) -> result<string, string>;

  /// Manage access control for organization codespaces
  record set-codespaces-billing-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The usernames of the organization members who should have access to codespaces in the organization. Required when `visibility` is `selected_members`. The provided list of usernames will replace any existing value.
    selected-usernames: option<list<string>>,
    /// Which users can access codespaces in the organization. `disabled` means that no users can access codespaces in the organization.
    visibility: set-codespaces-billing-body-visibility-enum
  }
  set-codespaces-billing: func(params: set-codespaces-billing-params) -> result<string, string>;

  /// Add users to Codespaces billing for an organization
  record set-codespaces-billing-users-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The usernames of the organization members whose codespaces be billed to the organization.
    selected-usernames: list<string>
  }
  set-codespaces-billing-users: func(params: set-codespaces-billing-users-params) -> result<string, string>;

  /// Removes users from Codespaces billing for an organization
  record delete-codespaces-billing-users-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The usernames of the organization members whose codespaces should not be billed to the organization.
    selected-usernames: list<string>
  }
  delete-codespaces-billing-users: func(params: delete-codespaces-billing-users-params) -> result<string, string>;

  /// List organization secrets
  record list-org-secrets-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-org-secrets: func(params: list-org-secrets-params) -> result<string, string>;

  /// Get an organization public key
  record get-org-public-key-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-org-public-key: func(params: get-org-public-key-params) -> result<string, string>;

  /// Get an organization secret
  record get-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string
  }
  get-org-secret: func(params: get-org-secret-params) -> result<string, string>;

  /// Create or update an organization secret
  record create-or-update-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    /// The value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an organization public key](https://docs.github.com/rest/reference/codespaces#get-an-organization-public-key) endpoint.
    encrypted-value: option<string>,
    /// The ID of the key you used to encrypt the secret.
    key-id: option<string>,
    /// An array of repository IDs that can access the organization secret. You can only provide a list of repository IDs when the `visibility` is set to `selected`. You can manage the list of selected repositories using the [List selected repositories for an organization secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-an-organization-secret), [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/codespaces#set-selected-repositories-for-an-organization-secret), and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/codespaces#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: option<list<s32>>,
    /// Which type of organization repositories have access to the organization secret. `selected` means only the repositories specified by `selected_repository_ids` can access the secret.
    visibility: create-or-update-org-secret-body-visibility-enum
  }
  create-or-update-org-secret: func(params: create-or-update-org-secret-params) -> result<string, string>;

  /// Delete an organization secret
  record delete-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string
  }
  delete-org-secret: func(params: delete-org-secret-params) -> result<string, string>;

  /// List selected repositories for an organization secret
  record list-selected-repos-for-org-secret-params {
    /// The organization name. The name is not case sensitive.
