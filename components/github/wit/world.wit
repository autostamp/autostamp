  variant start-for-org-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-status-for-org-error {
    not-found(string),
    other(string)
  }

  variant download-archive-for-org-error {
    found(string),
    not-found(string),
