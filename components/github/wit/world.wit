  /// A request for a specific ref(branch,sha,tag) to be deployed
  record deployment {
    created-at: string,
    creator: nullable-simple-user,
    description: string,
    /// Name for the target deployment environment.
    environment: string,
    /// Unique identifier of the deployment
    id: s32,
    node-id: string,
    original-environment: option<string>,
    payload: string,
    performed-via-github-app: option<nullable-integration>,
    /// Specifies if the given environment is one that end-users directly interact with. Default: false.
    production-environment: option<bool>,
    /// The ref to deploy. This can be a branch, tag, or sha.
    ref: string,
    repository-url: string,
    sha: string,
    statuses-url: string,
    /// Parameter to specify a task to execute
    task: string,
    /// Specifies if the given environment is will no longer exist at some point in the future. Default: false.
    transient-environment: option<bool>,
    updated-at: string,
    url: string
  }

  /// GitHub apps are a new way to extend GitHub. They can be installed directly on organizations and user accounts and granted access to specific repositories. They come with granular permissions and built-in webhooks. GitHub apps are first class actors within GitHub.
  record nullable-integration {
    client-id: option<string>,
    client-secret: option<string>,
    created-at: string,
    description: string,
    /// The list of events for the GitHub app
    events: list<string>,
    external-url: string,
    html-url: string,
    /// Unique identifier of the GitHub app
    id: s32,
    /// The number of installations associated with the GitHub app
    installations-count: option<s32>,
    /// The name of the GitHub app
    name: string,
    node-id: string,
    owner: nullable-simple-user,
    pem: option<string>,
    /// The set of permissions for the GitHub app
    permissions: nullable-integration-permissions,
    /// The slug name of the GitHub app
    slug: option<string>,
    updated-at: string,
    webhook-secret: option<string>
  }

  /// The set of permissions for the GitHub app
  record nullable-integration-permissions {
    checks: option<string>,
    contents: option<string>,
    deployments: option<string>,
    issues: option<string>,
    metadata: option<string>
  }

  /// The status of a deployment.
  record deployment-status {
    created-at: string,
    creator: nullable-simple-user,
    deployment-url: string,
    /// A short description of the status.
    description: string,
    /// The environment of the deployment that the status is for.
    environment: option<string>,
    /// The URL for accessing your environment.
    environment-url: option<string>,
    id: s32,
    /// The URL to associate with this status.
    log-url: option<string>,
    node-id: string,
    performed-via-github-app: option<nullable-integration>,
    repository-url: string,
    /// The state of the status.
    state: deployment-status-state-enum,
    /// Deprecated: the URL to associate with this status.
    target-url: string,
    updated-at: string,
    url: string
  }

  /// one entry of a string-keyed map (free-form object)
  record create-dispatch-event-body-client-payload-entry {
    key: string,
    value: string
  }

  record get-all-environments-response {
    environments: option<list<environment>>,
    /// The number of environments in this repository
    total-count: option<s32>
  }

  /// Details of a deployment environment
  record environment {
    /// The time that the environment was created, in ISO 8601 format.
    created-at: string,
    deployment-branch-policy: option<deployment-branch-policy-settings>,
    html-url: string,
    /// The id of the environment.
    id: s32,
    /// The name of the environment.
    name: string,
    node-id: string,
    protection-rules: option<list<string>>,
    /// The time that the environment was last updated, in ISO 8601 format.
    updated-at: string,
    url: string
  }

  /// The type of deployment branch policy for this environment. To allow all branches to deploy, set to `null`.
  record deployment-branch-policy-settings {
    /// Whether only branches that match the specified name patterns can deploy to this environment.  If `custom_branch_policies` is `true`, `protected_branches` must be `false`; if `custom_branch_policies` is `false`, `protected_branches` must be `true`.
    custom-branch-policies: bool,
    /// Whether only branches with branch protection rules can deploy to this environment. If `protected_branches` is `true`, `custom_branch_policies` must be `false`; if `protected_branches` is `false`, `custom_branch_policies` must be `true`.
    protected-branches: bool
  }

  record create-or-update-environment-body-reviewers-item {
    /// The id of the user or team who can review the deployment
    id: option<s32>,
    type-op: option<deployment-reviewer-type>
  }

  record list-deployment-branch-policies-response {
    branch-policies: list<deployment-branch-policy>,
    /// The number of deployment branch policies for the environment.
    total-count: s32
  }

  /// Details of a deployment branch policy.
  record deployment-branch-policy {
    /// The unique identifier of the branch policy.
    id: option<s32>,
    /// The name pattern that branches must match in order to deploy to the environment.
    name: option<string>,
    node-id: option<string>
  }

  /// Webhooks for repositories.
  record hook {
    /// Determines whether the hook is actually triggered on pushes.
    active: bool,
    config: hook-config,
    created-at: string,
    deliveries-url: option<string>,
    /// Determines what events the hook is triggered for. Default: ['push'].
    events: list<string>,
    /// Unique identifier of the webhook.
    id: s32,
    last-response: hook-response,
    /// The name of a valid service, use 'web' for a webhook.
    name: string,
    ping-url: string,
    test-url: string,
    type-op: string,
    updated-at: string,
    url: string
  }

  record hook-config {
    content-type: option<string>,
    digest: option<string>,
    email: option<string>,
    insecure-ssl: option<string>,
    password: option<string>,
    room: option<string>,
    secret: option<string>,
    subdomain: option<string>,
    token: option<string>,
    url: option<string>
  }

  record hook-response {
    code: s32,
    message: string,
    status: string
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/repos#create-hook-config-params).
  record create-webhook-body-config {
    content-type: option<string>,
    digest: option<string>,
    insecure-ssl: option<string>,
    secret: option<string>,
    token: option<string>,
    url: option<string>
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/repos#create-hook-config-params).
  record update-webhook-body-config {
    address: option<string>,
    content-type: option<string>,
    insecure-ssl: option<string>,
    room: option<string>,
    secret: option<string>,
    url: string
  }

  /// Configuration object of the webhook
  record webhook-config {
    content-type: option<string>,
    insecure-ssl: option<string>,
    secret: option<string>,
    url: option<string>
  }

  /// Delivery made by a webhook, without request and response information.
  record hook-delivery-item {
    /// The type of activity for the event that triggered the delivery.
    action: string,
    /// Time when the webhook delivery occurred.
    delivered-at: string,
    /// Time spent delivering.
    duration: f64,
    /// The event that triggered the delivery.
    event: string,
    /// Unique identifier for the event (shared with all deliveries for all webhooks that subscribe to this event).
    guid: string,
    /// Unique identifier of the webhook delivery.
    id: s32,
    /// The id of the GitHub App installation associated with this event.
    installation-id: s32,
    /// Whether the webhook delivery is a redelivery.
    redelivery: bool,
    /// The id of the repository associated with this event.
    repository-id: s32,
    /// Describes the response returned after attempting the delivery.
    status: string,
    /// Status code received when delivery was made.
    status-code: s32
  }

  /// Delivery made by a webhook.
  record hook-delivery {
    /// The type of activity for the event that triggered the delivery.
    action: string,
    /// Time when the delivery was delivered.
    delivered-at: string,
    /// Time spent delivering.
    duration: f64,
    /// The event that triggered the delivery.
    event: string,
    /// Unique identifier for the event (shared with all deliveries for all webhooks that subscribe to this event).
    guid: string,
    /// Unique identifier of the delivery.
    id: s32,
    /// The id of the GitHub App installation associated with this event.
    installation-id: s32,
    /// Whether the delivery is a redelivery.
    redelivery: bool,
    /// The id of the repository associated with this event.
    repository-id: s32,
    request: hook-delivery-request,
    response: hook-delivery-response,
    /// Description of the status of the attempted delivery
    status: string,
    /// Status code received when delivery was made.
    status-code: s32,
    /// The URL target of the delivery.
    url: option<string>
  }

  record hook-delivery-request {
    /// The request headers sent with the webhook delivery.
    headers: list<hook-delivery-request-headers-entry>,
    /// The webhook payload.
    payload: list<hook-delivery-request-payload-entry>
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-request-headers-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-request-payload-entry {
    key: string,
    value: string
  }

  record hook-delivery-response {
    /// The response headers received when the delivery was made.
    headers: list<hook-delivery-response-headers-entry>,
    /// The response payload received.
    payload: string
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-response-headers-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record redeliver-webhook-delivery-response-entry {
    key: string,
    value: string
  }

  /// An SSH key granting access to a single repository.
  record deploy-key {
    added-by: option<string>,
    created-at: string,
    id: s32,
    key: string,
    last-used: option<string>,
    read-only: bool,
    title: string,
    url: string,
    verified: bool
  }

  /// one entry of a string-keyed map (free-form object)
  record language-entry {
    key: string,
    value: s32
  }

  /// one entry of a string-keyed map (free-form object)
  record enable-lfs-for-repo-response-entry {
    key: string,
    value: string
  }

  /// Results of a successful merge upstream request
  record merged-upstream {
    base-branch: option<string>,
    merge-type: option<merged-upstream-merge-type-enum>,
    message: option<string>
  }

  /// The configuration for GitHub Pages for a repository.
  record page {
    /// The process in which the Page will be built.
    build-type: option<page-build-type-enum>,
    /// The Pages site's custom domain
    cname: string,
    /// Whether the Page has a custom 404 page.
    custom-v404: bool,
    /// The web address the Page can be accessed from.
    html-url: option<string>,
    https-certificate: option<pages-https-certificate>,
    /// Whether https is enabled on the domain
    https-enforced: option<bool>,
    /// The timestamp when a pending domain becomes unverified.
    pending-domain-unverified-at: option<string>,
    /// The state if the domain is verified
    protected-domain-state: option<page-protected-domain-state-enum>,
    /// Whether the GitHub Pages site is publicly visible. If set to `true`, the site is accessible to anyone on the internet. If set to `false`, the site will only be accessible to users who have at least `read` access to the repository that published the site.
    public: bool,
    source: option<pages-source-hash>,
    /// The status of the most recent build of the Page.
    status: page-status-enum,
    /// The API address for accessing this Page resource.
    url: string
  }

  record pages-https-certificate {
    description: string,
    /// Array of the domain set and its alternate name (if it is configured)
    domains: list<string>,
    expires-at: option<string>,
    state: pages-https-certificate-state-enum
  }

  record pages-source-hash {
    branch: string,
    path: string
  }

  /// The source branch and directory used to publish your Pages site.
  record create-pages-site-body-source {
    /// The repository branch used to publish your site's source files.
    branch: string,
    /// The repository directory that includes the source files for the Pages site. Allowed paths are `/` or `/docs`. Default: `/`
    path: option<create-pages-site-body-source-path-enum>
  }

  /// Page Build
  record page-build {
    commit: string,
    created-at: string,
    duration: s32,
    error: page-build-error,
    pusher: nullable-simple-user,
    status: string,
    updated-at: string,
    url: string
  }

  record page-build-error {
    message: string
  }

  /// Page Build Status
  record page-build-status {
    status: string,
    url: string
  }

  /// The GitHub Pages deployment status.
  record page-deployment {
    /// The URI to the deployed GitHub Pages.
    page-url: string,
    /// The URI to the deployed GitHub Pages preview.
    preview-url: option<string>,
    /// The URI to monitor GitHub Pages deployment status.
    status-url: string
  }

  /// Pages Health Check Status
  record pages-health-check {
    alt-domain: option<pages-health-check-alt-domain>,
    domain: option<pages-health-check-domain>
  }

  record pages-health-check-alt-domain {
    caa-error: option<string>,
    dns-resolves: option<bool>,
    enforces-https: option<bool>,
    has-cname-record: option<bool>,
    has-mx-records-present: option<bool>,
    host: option<string>,
    https-error: option<string>,
    is-a-record: option<bool>,
    is-apex-domain: option<bool>,
    is-cloudflare-ip: option<bool>,
    is-cname-to-fastly: option<bool>,
    is-cname-to-github-user-domain: option<bool>,
    is-cname-to-pages-dot-github-dot-com: option<bool>,
    is-fastly-ip: option<bool>,
    is-https-eligible: option<bool>,
    is-non-github-pages-ip-present: option<bool>,
    is-old-ip-address: option<bool>,
    is-pages-domain: option<bool>,
    is-pointed-to-github-pages-ip: option<bool>,
    is-proxied: option<bool>,
    is-served-by-pages: option<bool>,
    is-valid: option<bool>,
    is-valid-domain: option<bool>,
    nameservers: option<string>,
    reason: option<string>,
    responds-to-https: option<bool>,
    should-be-a-record: option<bool>,
    uri: option<string>
  }

  record pages-health-check-domain {
    caa-error: option<string>,
    dns-resolves: option<bool>,
    enforces-https: option<bool>,
    has-cname-record: option<bool>,
    has-mx-records-present: option<bool>,
    host: option<string>,
    https-error: option<string>,
    is-a-record: option<bool>,
    is-apex-domain: option<bool>,
    is-cloudflare-ip: option<bool>,
    is-cname-to-fastly: option<bool>,
    is-cname-to-github-user-domain: option<bool>,
    is-cname-to-pages-dot-github-dot-com: option<bool>,
    is-fastly-ip: option<bool>,
    is-https-eligible: option<bool>,
    is-non-github-pages-ip-present: option<bool>,
    is-old-ip-address: option<bool>,
    is-pages-domain: option<bool>,
    is-pointed-to-github-pages-ip: option<bool>,
    is-proxied: option<bool>,
    is-served-by-pages: option<bool>,
    is-valid: option<bool>,
    is-valid-domain: option<bool>,
    nameservers: option<string>,
    reason: option<string>,
    responds-to-https: option<bool>,
    should-be-a-record: option<bool>,
    uri: option<string>
  }

  /// Content File
  record content-file {
    links: content-file-links,
    content: string,
    download-url: string,
    encoding: string,
    git-url: string,
    html-url: string,
    name: string,
    path: string,
    sha: string,
    size: s32,
    submodule-git-url: option<string>,
    target: option<string>,
    type-op: content-file-type-op-enum,
    url: string
  }

  record content-file-links {
    git: string,
    html: string,
    self: string
  }

  /// A release.
  record release {
    assets: list<release-asset>,
    assets-url: string,
    author: simple-user,
    body: option<string>,
    body-html: option<string>,
    body-text: option<string>,
    created-at: string,
    /// The URL of the release discussion.
    discussion-url: option<string>,
    /// true to create a draft (unpublished) release, false to create a published one.
    draft: bool,
    html-url: string,
    id: s32,
    mentions-count: option<s32>,
    name: string,
    node-id: string,
    /// Whether to identify the release as a prerelease or a full release.
    prerelease: bool,
    published-at: string,
    reactions: option<reaction-rollup>,
    /// The name of the tag.
    tag-name: string,
    tarball-url: string,
    /// Specifies the commitish value that determines where the Git tag is created from.
    target-commitish: string,
    upload-url: string,
    url: string,
    zipball-url: string
  }

  /// Data related to a release.
  record release-asset {
    browser-download-url: string,
    content-type: string,
    created-at: string,
    download-count: s32,
    id: s32,
    label: string,
    /// The file name of the asset.
    name: string,
    node-id: string,
    size: s32,
    /// State of the release asset.
    state: release-asset-state-enum,
    updated-at: string,
    uploader: nullable-simple-user,
    url: string
  }

  /// Generated name and body describing a release
  record release-notes-content {
    /// The generated body describing the contents of the release supporting markdown formatting
    body: string,
    /// The generated name of the release
    name: string
  }

  /// Commit Activity
  record commit-activity {
    days: list<s32>,
    total: s32,
    week: s32
  }

  /// Contributor Activity
  record contributor-activity {
    author: nullable-simple-user,
    total: s32,
    weeks: list<contributor-activity-weeks-item>
  }

  record contributor-activity-weeks-item {
    a: option<s32>,
    c: option<s32>,
    d: option<s32>,
    w: option<s32>
  }

  record participation-stats {
    all: list<s32>,
    owner: list<s32>
  }

  /// Tag
  record tag {
    commit: tag-commit,
    name: string,
    node-id: string,
    tarball-url: string,
    zipball-url: string
  }

  record tag-commit {
    sha: string,
    url: string
  }

  /// Tag protection
  record tag-protection {
    created-at: option<string>,
    enabled: option<bool>,
    id: option<s32>,
    pattern: string,
    updated-at: option<string>
  }

  /// A topic aggregates entities that are related to a subject.
  record topic {
    names: list<string>
  }

  /// Clone Traffic
  record clone-traffic {
    clones: list<traffic>,
    count: s32,
    uniques: s32
  }

  record traffic {
    count: s32,
    timestamp: string,
    uniques: s32
  }

  /// Content Traffic
  record content-traffic {
    count: s32,
    path: string,
    title: string,
    uniques: s32
  }

  /// Referrer Traffic
  record referrer-traffic {
    count: s32,
    referrer: string,
    uniques: s32
  }

  /// View Traffic
  record view-traffic {
    count: s32,
    uniques: s32,
    views: list<traffic>
  }

