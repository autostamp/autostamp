    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Specifies a path to a file in the repository containing configuration settings used for generating the release notes. If unspecified, the configuration file located in the repository at '.github/release.yml' or '.github/release.yaml' will be used. If that is not present, the default configuration will be used.
    configuration-file-path: option<string>,
    /// The name of the previous tag to use as the starting point for the release notes. Use to manually specify the range for the set of changes considered as part this release.
    previous-tag-name: option<string>,
    /// The tag name for the release. This can be an existing tag or a new one.
    tag-name: string,
    /// Specifies the commitish value that will be the target for the release's tag. Required if the supplied tag_name does not reference an existing tag. Ignored if the tag_name already exists.
    target-commitish: option<string>
  }
  generate-release-notes: func(params: generate-release-notes-params) -> result<string, string>;

  /// Get the latest release
  record get-latest-release-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-latest-release: func(params: get-latest-release-params) -> result<string, string>;

  /// Get a release by tag name
  record get-release-by-tag-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// tag parameter
    tag: string
  }
  get-release-by-tag: func(params: get-release-by-tag-params) -> result<string, string>;

  /// Get a release
  record get-release-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the release.
    release-id: string
  }
  get-release: func(params: get-release-params) -> result<string, string>;

  /// Update a release
  record update-release-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the release.
    release-id: string,
    /// Text describing the contents of the tag.
    body: option<string>,
    /// If specified, a discussion of the specified category is created and linked to the release. The value must be a category that already exists in the repository. If there is already a discussion linked to the release, this parameter is ignored. For more information, see "[Managing categories for discussions in your repository](https://docs.github.com/discussions/managing-discussions-for-your-community/managing-categories-for-discussions-in-your-repository)."
    discussion-category-name: option<string>,
    /// `true` makes the release a draft, and `false` publishes the release.
    draft: option<bool>,
    /// Specifies whether this release should be set as the latest release for the repository. Drafts and prereleases cannot be set as latest. Defaults to `true` for newly published releases. `legacy` specifies that the latest release should be determined based on the release creation date and higher semantic version.
    make-latest: option<create-release-body-make-latest-enum>,
    /// The name of the release.
    name: option<string>,
    /// `true` to identify the release as a prerelease, `false` to identify the release as a full release.
    prerelease: option<bool>,
    /// The name of the tag.
    tag-name: option<string>,
    /// Specifies the commitish value that determines where the Git tag is created from. Can be any branch or commit SHA. Unused if the Git tag already exists. Default: the repository's default branch (usually `master`).
    target-commitish: option<string>
  }
  update-release: func(params: update-release-params) -> result<string, string>;

  /// Delete a release
  record delete-release-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the release.
    release-id: string
  }
  delete-release: func(params: delete-release-params) -> result<string, string>;

  /// List release assets
  record list-release-assets-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the release.
    release-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-release-assets: func(params: list-release-assets-params) -> result<string, string>;

  /// Upload a release asset
  record upload-release-asset-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the release.
    release-id: string,
    name: string,
    label: option<string>
  }
  upload-release-asset: func(params: upload-release-asset-params) -> result<string, string>;

  /// Get the weekly commit activity
  record get-code-frequency-stats-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-code-frequency-stats: func(params: get-code-frequency-stats-params) -> result<string, string>;

  /// Get the last year of commit activity
  record get-commit-activity-stats-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-commit-activity-stats: func(params: get-commit-activity-stats-params) -> result<string, string>;

  /// Get all contributor commit activity
  record get-contributors-stats-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-contributors-stats: func(params: get-contributors-stats-params) -> result<string, string>;

  /// Get the weekly commit count
  record get-participation-stats-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-participation-stats: func(params: get-participation-stats-params) -> result<string, string>;

  /// Get the hourly commit count for each day
  record get-punch-card-stats-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-punch-card-stats: func(params: get-punch-card-stats-params) -> result<string, string>;

  /// Create a commit status
  record create-commit-status-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    sha: string,
    /// A string label to differentiate this status from the status of other systems. This field is case-insensitive.
    context: option<string>,
    /// A short description of the status.
    description: option<string>,
    /// The state of the status.
    state: create-commit-status-body-state-enum,
    /// The target URL to associate with this status. This URL will be linked from the GitHub UI to allow users to easily see the source of the status.  
    /// For example, if your continuous integration system is posting build status, you would want to provide the deep link for the build output for this specific SHA:  
    target-url: option<string>
  }
  create-commit-status: func(params: create-commit-status-params) -> result<string, string>;

  /// List repository tags
  record list-tags-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-tags: func(params: list-tags-params) -> result<string, string>;

  /// List tag protection states for a repository
  record list-tag-protection-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  list-tag-protection: func(params: list-tag-protection-params) -> result<string, string>;

  /// Create a tag protection state for a repository
  record create-tag-protection-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// An optional glob pattern to match against when enforcing tag protection.
    pattern: string
  }
  create-tag-protection: func(params: create-tag-protection-params) -> result<string, string>;

  /// Delete a tag protection state for a repository
  record delete-tag-protection-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the tag protection.
    tag-protection-id: string
  }
  delete-tag-protection: func(params: delete-tag-protection-params) -> result<string, string>;

  /// Download a repository archive (tar)
  record download-tarball-archive-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    ref: string
  }
  download-tarball-archive: func(params: download-tarball-archive-params) -> result<string, string>;

  /// List repository teams
  record list-teams-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-teams: func(params: list-teams-params) -> result<string, string>;

  /// Get all repository topics
  record get-all-topics-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  get-all-topics: func(params: get-all-topics-params) -> result<string, string>;

  /// Replace all repository topics
  record replace-all-topics-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// An array of topics to add to the repository. Pass one or more topics to _replace_ the set of existing topics. Send an empty array (`[]`) to clear all topics from the repository. **Note:** Topic `names` cannot contain uppercase letters.
    names: list<string>
  }
  replace-all-topics: func(params: replace-all-topics-params) -> result<string, string>;

  /// Get repository clones
  record get-clones-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The time frame to display results for.
    per: option<get-clones-per-enum>
  }
  get-clones: func(params: get-clones-params) -> result<string, string>;

  /// Get top referral paths
  record get-top-paths-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-top-paths: func(params: get-top-paths-params) -> result<string, string>;

  /// Get top referral sources
  record get-top-referrers-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-top-referrers: func(params: get-top-referrers-params) -> result<string, string>;

  /// Get page views
  record get-views-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The time frame to display results for.
    per: option<get-clones-per-enum>
  }
  get-views: func(params: get-views-params) -> result<string, string>;

  /// Transfer a repository
  record transfer-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The new name to be given to the repository.
    new-name: option<string>,
    /// The username or organization name the repository will be transferred to.
    new-owner: string,
    /// ID of the team or teams to add to the repository. Teams can only be added to organization-owned repositories.
    team-ids: option<list<s32>>
  }
  transfer: func(params: transfer-params) -> result<string, string>;

  /// Check if vulnerability alerts are enabled for a repository
  record check-vulnerability-alerts-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  check-vulnerability-alerts: func(params: check-vulnerability-alerts-params) -> result<string, string>;

  /// Enable vulnerability alerts
  record enable-vulnerability-alerts-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  enable-vulnerability-alerts: func(params: enable-vulnerability-alerts-params) -> result<string, string>;

  /// Disable vulnerability alerts
  record disable-vulnerability-alerts-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  disable-vulnerability-alerts: func(params: disable-vulnerability-alerts-params) -> result<string, string>;

  /// Download a repository archive (zip)
  record download-zipball-archive-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    ref: string
  }
  download-zipball-archive: func(params: download-zipball-archive-params) -> result<string, string>;

  /// Create a repository using a template
  record create-using-template-params {
    template-owner: string,
    template-repo: string,
    /// A short description of the new repository.
    description: option<string>,
    /// Set to `true` to include the directory structure and files from all branches in the template repository, and not just the default branch. Default: `false`.
    include-all-branches: option<bool>,
    /// The name of the new repository.
    name: string,
    /// The organization or person who will own the new repository. To create a new repository in an organization, the authenticated user must be a member of the specified organization.
    owner: option<string>,
    /// Either `true` to create a new private repository or `false` to create a new public one.
    private: option<bool>
  }
  create-using-template: func(params: create-using-template-params) -> result<string, string>;

  /// List public repositories
  record list-public-params {
    /// A repository ID. Only return repositories with an ID greater than this ID.
    since: option<s32>
  }
  list-public: func(params: list-public-params) -> result<string, string>;

  /// List repositories for the authenticated user
  record list-for-authenticated-user-params {
    /// Limit results to repositories with the specified visibility.
    visibility: option<list-for-authenticated-user-visibility-enum>,
    /// Comma-separated list of values. Can include:  
    ///  * `owner`: Repositories that are owned by the authenticated user.  
    affiliation: option<string>,
    /// Limit results to repositories of the specified type. Will cause a `422` error if used in the same request as **visibility** or **affiliation**.
    type-op: option<list-for-authenticated-user-type-op-enum>,
    /// The property to sort the results by.
    sort: option<list-for-org-sort-enum>,
    /// The order to sort by. Default: `asc` when using `full_name`, otherwise `desc`.
    direction: option<list-for-org-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// Only show notifications updated before the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    before: option<string>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<string, string>;

  /// Create a repository for the authenticated user
  record create-for-authenticated-user-params {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether the repository is initialized with a minimal README.
    auto-init: option<bool>,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    /// A short description of the repository.
    description: option<string>,
    /// The desired language or platform to apply to the .gitignore.
    gitignore-template: option<string>,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: option<bool>,
    /// Whether issues are enabled.
    has-issues: option<bool>,
    /// Whether projects are enabled.
    has-projects: option<bool>,
    /// Whether the wiki is enabled.
    has-wiki: option<bool>,
    /// A URL with more information about the repository.
    homepage: option<string>,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    /// The license keyword of the open source license for this repository.
    license-template: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<create-in-org-body-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<create-in-org-body-merge-commit-title-enum>,
    /// The name of the repository.
    name: string,
    /// Whether the repository is private.
    private: option<bool>,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<create-in-org-body-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<create-in-org-body-squash-merge-commit-title-enum>,
    /// The id of the team that will be granted access to this repository. This is only valid when creating a repository in an organization.
    team-id: option<s32>
  }
  create-for-authenticated-user: func(params: create-for-authenticated-user-params) -> result<string, string>;

  /// List repository invitations for the authenticated user
  record list-invitations-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-invitations-for-authenticated-user: func(params: list-invitations-for-authenticated-user-params) -> result<string, string>;

  /// Accept a repository invitation
  record accept-invitation-for-authenticated-user-params {
    /// The unique identifier of the invitation.
    invitation-id: string
  }
  accept-invitation-for-authenticated-user: func(params: accept-invitation-for-authenticated-user-params) -> result<string, string>;

  /// Decline a repository invitation
  record decline-invitation-for-authenticated-user-params {
    /// The unique identifier of the invitation.
    invitation-id: string
  }
  decline-invitation-for-authenticated-user: func(params: decline-invitation-for-authenticated-user-params) -> result<string, string>;

  /// List repositories for a user
  record list-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// Limit results to repositories of the specified type.
    type-op: option<list-for-user-type-op-enum>,
    /// The property to sort the results by.
    sort: option<list-for-org-sort-enum>,
    /// The order to sort by. Default: `asc` when using `full_name`, otherwise `desc`.
    direction: option<list-for-org-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-user: func(params: list-for-user-params) -> result<string, string>;

}

interface billing {
  /// Get GitHub Actions billing for an organization
  record get-github-actions-billing-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-github-actions-billing-org: func(params: get-github-actions-billing-org-params) -> result<string, string>;

  /// Get GitHub Packages billing for an organization
  record get-github-packages-billing-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-github-packages-billing-org: func(params: get-github-packages-billing-org-params) -> result<string, string>;

  /// Get shared storage billing for an organization
  record get-shared-storage-billing-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-shared-storage-billing-org: func(params: get-shared-storage-billing-org-params) -> result<string, string>;

  /// Get GitHub Actions billing for a user
  record get-github-actions-billing-user-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-github-actions-billing-user: func(params: get-github-actions-billing-user-params) -> result<string, string>;

  /// Get GitHub Packages billing for a user
  record get-github-packages-billing-user-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-github-packages-billing-user: func(params: get-github-packages-billing-user-params) -> result<string, string>;

  /// Get shared storage billing for a user
  record get-shared-storage-billing-user-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-shared-storage-billing-user: func(params: get-shared-storage-billing-user-params) -> result<string, string>;

}

interface teams {
  enum create-body-permission-enum {
    pull,
    push,
  }

  enum create-body-privacy-enum {
    secret,
    closed,
  }

  enum update-in-org-body-permission-enum {
    pull,
    push,
    admin,
  }

  enum list-discussions-in-org-direction-enum {
    asc,
    desc,
  }

  enum list-members-in-org-role-enum {
    member,
    maintainer,
    all,
  }

  enum add-or-update-membership-for-user-in-org-body-role-enum {
    member,
    maintainer,
  }

  enum add-or-update-project-permissions-in-org-body-permission-enum {
    read,
    write,
    admin,
  }

  /// List teams
  record list-op-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Create a team
  record create-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The description of the team.
    description: option<string>,
    /// List GitHub IDs for organization members who will become team maintainers.
    maintainers: option<list<string>>,
    /// The name of the team.
    name: string,
    /// The ID of a team to set as the parent team.
    parent-team-id: option<s32>,
    /// **Deprecated**. The permission that new repositories will be added to the team with when none is specified.
    permission: option<create-body-permission-enum>,
    /// The level of privacy this team should have. The options are:  
    /// **For a non-nested team:**  
    privacy: option<create-body-privacy-enum>,
    /// The full name (e.g., "organization-name/repository-name") of repositories to add the team to.
    repo-names: option<list<string>>
  }
  create: func(params: create-params) -> result<string, string>;

  /// Get a team by name
  record get-by-name-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string
  }
  get-by-name: func(params: get-by-name-params) -> result<string, string>;

  /// Update a team
  record update-in-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string,
    /// The description of the team.
    description: option<string>,
    /// The name of the team.
    name: option<string>,
    /// The ID of a team to set as the parent team.
    parent-team-id: option<s32>,
    /// **Deprecated**. The permission that new repositories will be added to the team with when none is specified.
    permission: option<update-in-org-body-permission-enum>,
    /// The level of privacy this team should have. Editing teams without specifying this parameter leaves `privacy` intact. When a team is nested, the `privacy` for parent teams cannot be `secret`. The options are:  
    /// **For a non-nested team:**  
    privacy: option<create-body-privacy-enum>
  }
  update-in-org: func(params: update-in-org-params) -> result<string, string>;

  /// Delete a team
  record delete-in-org-params {
