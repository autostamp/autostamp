    followers-url: option<string>,
    following-url: option<string>,
    gists-url: option<string>,
    gravatar-id: option<string>,
    hooks-url: option<string>,
    html-url: option<string>,
    id: option<s32>,
    issues-url: option<string>,
    login: option<string>,
    members-url: option<string>,
    node-id: option<string>,
    organizations-url: option<string>,
    public-members-url: option<string>,
    received-events-url: option<string>,
    repos-url: option<string>,
    site-admin: option<bool>,
    starred-url: option<string>,
    subscriptions-url: option<string>,
    type-op: option<string>,
    url: option<string>
  }

  record branch-restriction-policy-apps-item-permissions {
    contents: option<string>,
    issues: option<string>,
    metadata: option<string>,
    single-file: option<string>
  }

  record branch-restriction-policy-teams-item {
    description: option<string>,
    html-url: option<string>,
    id: option<s32>,
    members-url: option<string>,
    name: option<string>,
    node-id: option<string>,
    parent: option<string>,
    permission: option<string>,
    privacy: option<string>,
    repositories-url: option<string>,
    slug: option<string>,
    url: option<string>
  }

  record branch-restriction-policy-users-item {
    avatar-url: option<string>,
    events-url: option<string>,
    followers-url: option<string>,
    following-url: option<string>,
    gists-url: option<string>,
    gravatar-id: option<string>,
    html-url: option<string>,
    id: option<s32>,
    login: option<string>,
    node-id: option<string>,
    organizations-url: option<string>,
    received-events-url: option<string>,
    repos-url: option<string>,
    site-admin: option<bool>,
    starred-url: option<string>,
    subscriptions-url: option<string>,
    type-op: option<string>,
    url: option<string>
  }

  /// Branch With Protection
  record branch-with-protection {
    links: branch-with-protection-links,
    commit: commit,
    name: string,
    pattern: option<string>,
    protected: bool,
    protection: branch-protection,
    protection-url: string,
    required-approving-review-count: option<s32>
  }

  record branch-with-protection-links {
    html: string,
    self: string
  }

  /// Commit
  record commit {
    author: nullable-simple-user,
    comments-url: string,
    commit: commit-commit,
    committer: nullable-simple-user,
    files: option<list<diff-entry>>,
    html-url: string,
    node-id: string,
    parents: list<commit-parents-item>,
    sha: string,
    stats: option<commit-stats>,
    url: string
  }

  record commit-commit {
    author: nullable-git-user,
    comment-count: s32,
    committer: nullable-git-user,
    message: string,
    tree: commit-commit-tree,
    url: string,
    verification: option<verification>
  }

  /// Metaproperties for Git author/committer information.
  record nullable-git-user {
    date: option<string>,
    email: option<string>,
    name: option<string>
  }

  record commit-commit-tree {
    sha: string,
    url: string
  }

  record verification {
    payload: string,
    reason: string,
    signature: string,
    verified: bool
  }

  /// Diff Entry
  record diff-entry {
    additions: s32,
    blob-url: string,
    changes: s32,
    contents-url: string,
    deletions: s32,
    filename: string,
    patch: option<string>,
    previous-filename: option<string>,
    raw-url: string,
    sha: string,
    status: diff-entry-status-enum
  }

  record commit-parents-item {
    html-url: option<string>,
    sha: string,
    url: string
  }

  record commit-stats {
    additions: option<s32>,
    deletions: option<s32>,
    total: option<s32>
  }

  /// Require at least one approving review on a pull request, before merging. Set to `null` to disable.
  record update-branch-protection-body-required-pull-request-reviews {
    /// Allow specific users, teams, or apps to bypass pull request requirements.
    bypass-pull-request-allowances: option<update-branch-protection-body-required-pull-request-reviews-bypass-pull-request-allowances>,
    /// Set to `true` if you want to automatically dismiss approving reviews when someone pushes a new commit.
    dismiss-stale-reviews: option<bool>,
    /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
    dismissal-restrictions: option<update-branch-protection-body-required-pull-request-reviews-dismissal-restrictions>,
    /// Blocks merging pull requests until [code owners](https://docs.github.com/articles/about-code-owners/) review them.
    require-code-owner-reviews: option<bool>,
    /// Whether the most recent push must be approved by someone other than the person who pushed it. Default: `false`.
    require-last-push-approval: option<bool>,
    /// Specify the number of reviewers required to approve pull requests. Use a number between 1 and 6 or 0 to not require reviewers.
    required-approving-review-count: option<s32>
  }

  /// Allow specific users, teams, or apps to bypass pull request requirements.
  record update-branch-protection-body-required-pull-request-reviews-bypass-pull-request-allowances {
    /// The list of app `slug`s allowed to bypass pull request requirements.
    apps: option<list<string>>,
    /// The list of team `slug`s allowed to bypass pull request requirements.
    teams: option<list<string>>,
    /// The list of user `login`s allowed to bypass pull request requirements.
    users: option<list<string>>
  }

  /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
  record update-branch-protection-body-required-pull-request-reviews-dismissal-restrictions {
    /// The list of app `slug`s with dismissal access
    apps: option<list<string>>,
    /// The list of team `slug`s with dismissal access
    teams: option<list<string>>,
    /// The list of user `login`s with dismissal access
    users: option<list<string>>
  }

  /// Require status checks to pass before merging. Set to `null` to disable.
  record update-branch-protection-body-required-status-checks {
    /// The list of status checks to require in order to merge into this branch.
    checks: option<list<update-branch-protection-body-required-status-checks-checks-item>>,
    /// **Deprecated**: The list of status checks to require in order to merge into this branch. If any of these checks have recently been set by a particular GitHub App, they will be required to come from that app in future for the branch to merge. Use `checks` instead of `contexts` for more fine-grained control.
    contexts: list<string>,
    /// Require branches to be up to date before merging.
    strict: bool
  }

  record update-branch-protection-body-required-status-checks-checks-item {
    /// The ID of the GitHub App that must provide this check. Omit this field to automatically select the GitHub App that has recently provided this check, or any app if it was not set by a GitHub App. Pass -1 to explicitly allow any app to set the status.
    app-id: option<s32>,
    /// The name of the required check
    context: string
  }

  /// Restrict who can push to the protected branch. User, app, and team `restrictions` are only available for organization-owned repositories. Set to `null` to disable.
  record update-branch-protection-body-restrictions {
    /// The list of app `slug`s with push access
    apps: option<list<string>>,
    /// The list of team `slug`s with push access
    teams: list<string>,
    /// The list of user `login`s with push access
    users: list<string>
  }

  /// Branch protections protect branches
  record protected-branch {
    allow-deletions: option<protected-branch-allow-deletions>,
    allow-force-pushes: option<protected-branch-allow-force-pushes>,
    /// Whether users can pull changes from upstream when the branch is locked. Set to `true` to allow fork syncing. Set to `false` to prevent fork syncing.
    allow-fork-syncing: option<protected-branch-allow-fork-syncing>,
    block-creations: option<protected-branch-block-creations>,
    enforce-admins: option<protected-branch-enforce-admins>,
    /// Whether to set the branch as read-only. If this is true, users will not be able to push to the branch.
    lock-branch: option<protected-branch-lock-branch>,
    required-conversation-resolution: option<protected-branch-required-conversation-resolution>,
    required-linear-history: option<protected-branch-required-linear-history>,
    required-pull-request-reviews: option<protected-branch-required-pull-request-reviews>,
    required-signatures: option<protected-branch-required-signatures>,
    required-status-checks: option<status-check-policy>,
    restrictions: option<branch-restriction-policy>,
    url: string
  }

  record protected-branch-allow-deletions {
    enabled: bool
  }

  record protected-branch-allow-force-pushes {
    enabled: bool
  }

  /// Whether users can pull changes from upstream when the branch is locked. Set to `true` to allow fork syncing. Set to `false` to prevent fork syncing.
  record protected-branch-allow-fork-syncing {
    enabled: option<bool>
  }

  record protected-branch-block-creations {
    enabled: bool
  }

  record protected-branch-enforce-admins {
    enabled: bool,
    url: string
  }

  /// Whether to set the branch as read-only. If this is true, users will not be able to push to the branch.
  record protected-branch-lock-branch {
    enabled: option<bool>
  }

  record protected-branch-required-conversation-resolution {
    enabled: option<bool>
  }

  record protected-branch-required-linear-history {
    enabled: bool
  }

  record protected-branch-required-pull-request-reviews {
    bypass-pull-request-allowances: option<protected-branch-required-pull-request-reviews-bypass-pull-request-allowances>,
    dismiss-stale-reviews: option<bool>,
    dismissal-restrictions: option<protected-branch-required-pull-request-reviews-dismissal-restrictions>,
    require-code-owner-reviews: option<bool>,
    /// Whether the most recent push must be approved by someone other than the person who pushed it.
    require-last-push-approval: option<bool>,
    required-approving-review-count: option<s32>,
    url: string
  }

  record protected-branch-required-pull-request-reviews-bypass-pull-request-allowances {
    apps: option<list<integration>>,
    teams: list<team>,
    users: list<simple-user>
  }

  record protected-branch-required-pull-request-reviews-dismissal-restrictions {
    apps: option<list<integration>>,
    teams: list<team>,
    teams-url: string,
    url: string,
    users: list<simple-user>,
    users-url: string
  }

  record protected-branch-required-signatures {
    enabled: bool,
    url: string
  }

  /// Status Check Policy
  record status-check-policy {
    checks: list<status-check-policy-checks-item>,
    contexts: list<string>,
    contexts-url: string,
    strict: bool,
    url: string
  }

  record status-check-policy-checks-item {
    app-id: s32,
    context: string
  }

  /// Allow specific users, teams, or apps to bypass pull request requirements.
  record update-pull-request-review-protection-body-bypass-pull-request-allowances {
    /// The list of app `slug`s allowed to bypass pull request requirements.
    apps: option<list<string>>,
    /// The list of team `slug`s allowed to bypass pull request requirements.
    teams: option<list<string>>,
    /// The list of user `login`s allowed to bypass pull request requirements.
    users: option<list<string>>
  }

  /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
  record update-pull-request-review-protection-body-dismissal-restrictions {
    /// The list of app `slug`s with dismissal access
    apps: option<list<string>>,
    /// The list of team `slug`s with dismissal access
    teams: option<list<string>>,
    /// The list of user `login`s with dismissal access
    users: option<list<string>>
  }

  record update-status-check-protection-body-checks-item {
    /// The ID of the GitHub App that must provide this check. Omit this field to automatically select the GitHub App that has recently provided this check, or any app if it was not set by a GitHub App. Pass -1 to explicitly allow any app to set the status.
    app-id: option<s32>,
    /// The name of the required check
    context: string
  }

  /// A list of errors found in a repo's CODEOWNERS file
  record codeowners-errors-v2 {
    errors: list<codeowners-errors-v2-errors-item>
  }

  record codeowners-errors-v2-errors-item {
    /// The column number where this errors occurs.
    column: s32,
    /// The type of error.
    kind: string,
    /// The line number where this errors occurs.
    line: s32,
    /// A human-readable description of the error, combining information from multiple fields, laid out for display in a monospaced typeface (for example, a command-line setting).
    message: string,
    /// The path of the file where the error occured.
    path: string,
    /// The contents of the line where the error occurs.
    source: option<string>,
    /// Suggested action to fix the error. This will usually be `null`, but is provided for some common errors.
    suggestion: option<string>
  }

