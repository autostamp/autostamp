  get-by-username: func(params: get-by-username-params) -> result<string, string>;

  /// List followers of a user
  record list-followers-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-followers-for-user: func(params: list-followers-for-user-params) -> result<string, string>;

  /// List the people a user follows
  record list-following-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-following-for-user: func(params: list-following-for-user-params) -> result<string, string>;

  /// Check if a user follows another user
  record check-following-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    target-user: string
  }
  check-following-for-user: func(params: check-following-for-user-params) -> result<string, string>;

  /// List GPG keys for a user
  record list-gpg-keys-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-gpg-keys-for-user: func(params: list-gpg-keys-for-user-params) -> result<string, string>;

  /// Get contextual information for a user
  record get-context-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// Identifies which additional information you'd like to receive about the person's hovercard. Can be `organization`, `repository`, `issue`, `pull_request`. **Required** when using `subject_id`.
    subject-type: option<get-context-for-user-subject-type-enum>,
    /// Uses the ID for the `subject_type` you specified. **Required** when using `subject_type`.
    subject-id: option<string>
  }
  get-context-for-user: func(params: get-context-for-user-params) -> result<string, string>;

  /// List public keys for a user
  record list-public-keys-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-keys-for-user: func(params: list-public-keys-for-user-params) -> result<string, string>;

  /// List SSH signing keys for a user
  record list-ssh-signing-keys-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-ssh-signing-keys-for-user: func(params: list-ssh-signing-keys-for-user-params) -> result<string, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export meta;
  export apps;
  export codes-of-conduct;
  export emojis;
  export dependabot;
  export secret-scanning;
  export activity;
  export gists;
  export gitignore;
  export issues;
  export licenses;
  export markdown;
  export orgs;
  export actions;
  export oidc;
  export code-scanning;
  export codespaces;
  export interactions;
  export migrations;
  export packages;
  export projects;
  export repos;
  export billing;
  export teams;
  export reactions;
  export rate-limit;
  export checks;
  export dependency-graph;
  export git;
  export pulls;
  export search;
  export users;
}
