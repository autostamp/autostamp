interface oidc {
  /// Get the customization template for an OIDC subject claim for an organization
  oidc-get-oidc-custom-sub-template-for-org: func() -> result<string, string>;

  /// Set the customization template for an OIDC subject claim for an organization
  record oidc-update-oidc-custom-sub-template-for-org-params {
    /// Array of unique strings. Each claim key can only contain alphanumeric characters and underscores.
    include-claim-keys: list<string>
  }
  oidc-update-oidc-custom-sub-template-for-org: func(params: oidc-update-oidc-custom-sub-template-for-org-params) -> result<string, string>;

}

interface code-scanning {
  enum code-scanning-list-alerts-for-org-sort-enum {
    created,
    updated,
  }

  enum code-scanning-list-recent-analyses-sort-enum {
    created,
  }

  /// State of a code scanning alert.
  record code-scanning-alert-state {
    /// opaque schema; raw JSON
    value: string
  }

  /// Severity of a code scanning alert.
  record code-scanning-alert-severity {
    /// opaque schema; raw JSON
    value: string
  }

  /// The dismissal comment associated with the dismissal of the alert.
  record code-scanning-alert-dismissed-comment {
    /// opaque schema; raw JSON
    value: string
  }

  /// **Required when the state is dismissed.** The reason for dismissing or closing the alert.
  record code-scanning-alert-dismissed-reason {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the state of the code scanning alert. You must provide `dismissed_reason` when you set the state to `dismissed`.
  record code-scanning-alert-set-state {
    /// opaque schema; raw JSON
    value: string
  }

  /// The full Git reference, formatted as `refs/heads/<branch name>`,
  /// `refs/pull/<number>/merge`, or `refs/pull/<number>/head`.
  record code-scanning-ref {
    /// opaque schema; raw JSON
    value: string
  }

  /// An identifier for the upload.
  record code-scanning-analysis-sarif-id {
    /// opaque schema; raw JSON
    value: string
  }

  /// The SHA of the commit to which the analysis you are uploading relates.
  record code-scanning-analysis-commit-sha {
    /// opaque schema; raw JSON
    value: string
  }

  /// A Base64 string representing the SARIF file to upload. You must first compress your SARIF file using [`gzip`](http://www.gnu.org/software/gzip/manual/gzip.html) and then translate the contents of the file into a Base64 encoding string. For more information, see "[SARIF support for code scanning](https://docs.github.com/code-security/secure-coding/sarif-support-for-code-scanning)."
  record code-scanning-analysis-sarif-file {
    /// opaque schema; raw JSON
    value: string
  }

  /// List code scanning alerts for an organization
  record code-scanning-list-alerts-for-org-params {
    /// If specified, only code scanning alerts with this state will be returned.
    state: option<code-scanning-alert-state>,
    /// The property by which to sort the results.
    sort: option<code-scanning-list-alerts-for-org-sort-enum>,
    /// If specified, only code scanning alerts with this severity will be returned.
    severity: option<code-scanning-alert-severity>
  }
  code-scanning-list-alerts-for-org: func(params: code-scanning-list-alerts-for-org-params) -> result<string, string>;

  /// List code scanning alerts for a repository
  record code-scanning-list-alerts-for-repo-params {
    /// The property by which to sort the results.
    sort: option<code-scanning-list-alerts-for-org-sort-enum>,
    /// If specified, only code scanning alerts with this state will be returned.
    state: option<code-scanning-alert-state>,
    /// If specified, only code scanning alerts with this severity will be returned.
    severity: option<code-scanning-alert-severity>
  }
  code-scanning-list-alerts-for-repo: func(params: code-scanning-list-alerts-for-repo-params) -> result<string, string>;

  /// Get a code scanning alert
  code-scanning-get-alert: func() -> result<string, string>;

  /// Update a code scanning alert
  record code-scanning-update-alert-params {
    dismissed-comment: option<code-scanning-alert-dismissed-comment>,
    dismissed-reason: option<code-scanning-alert-dismissed-reason>,
    state: code-scanning-alert-set-state
  }
  code-scanning-update-alert: func(params: code-scanning-update-alert-params) -> result<string, string>;

  /// List instances of a code scanning alert
  code-scanning-list-alert-instances: func() -> result<string, string>;

  /// List code scanning analyses for a repository
  record code-scanning-list-recent-analyses-params {
    /// The Git reference for the analyses you want to list. The `ref` for a branch can be formatted either as `refs/heads/<branch name>` or simply `<branch name>`. To reference a pull request use `refs/pull/<number>/merge`.
    ref: option<code-scanning-ref>,
    /// Filter analyses belonging to the same SARIF upload.
    sarif-id: option<code-scanning-analysis-sarif-id>,
    /// The property by which to sort the results.
    sort: option<code-scanning-list-recent-analyses-sort-enum>
  }
  code-scanning-list-recent-analyses: func(params: code-scanning-list-recent-analyses-params) -> result<string, string>;

  /// Get a code scanning analysis for a repository
  record code-scanning-get-analysis-params {
    /// The ID of the analysis, as returned from the `GET /repos/{owner}/{repo}/code-scanning/analyses` operation.
    analysis-id: string
  }
  code-scanning-get-analysis: func(params: code-scanning-get-analysis-params) -> result<string, string>;

  /// Delete a code scanning analysis from a repository
  record code-scanning-delete-analysis-params {
    /// The ID of the analysis, as returned from the `GET /repos/{owner}/{repo}/code-scanning/analyses` operation.
    analysis-id: string,
    /// Allow deletion if the specified analysis is the last in a set. If you attempt to delete the final analysis in a set without setting this parameter to `true`, you'll get a 400 response with the message: `Analysis is last of its type and deletion may result in the loss of historical alert data. Please specify confirm_delete.`
    confirm-delete: option<string>
  }
  code-scanning-delete-analysis: func(params: code-scanning-delete-analysis-params) -> result<string, string>;

  /// List CodeQL databases for a repository
  code-scanning-list-codeql-databases: func() -> result<string, string>;

  /// Get a CodeQL database for a repository
  record code-scanning-get-codeql-database-params {
    /// The language of the CodeQL database.
    language: string
  }
  code-scanning-get-codeql-database: func(params: code-scanning-get-codeql-database-params) -> result<string, string>;

  /// Upload an analysis as SARIF data
  record code-scanning-upload-sarif-params {
    /// The base directory used in the analysis, as it appears in the SARIF file.
    /// This property is used to convert file paths from absolute to relative, so that alerts can be mapped to their correct location in the repository.
    checkout-uri: option<string>,
    commit-sha: code-scanning-analysis-commit-sha,
    ref: code-scanning-ref,
    sarif: code-scanning-analysis-sarif-file,
    /// The time that the analysis run began. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    started-at: option<string>,
    /// The name of the tool used to generate the code scanning analysis. If this parameter is not used, the tool name defaults to "API". If the uploaded SARIF contains a tool GUID, this will be available for filtering using the `tool_guid` parameter of operations such as `GET /repos/{owner}/{repo}/code-scanning/alerts`.
    tool-name: option<string>,
    /// Whether the SARIF file will be validated according to the code scanning specifications.
    /// This parameter is intended to help integrators ensure that the uploaded SARIF files are correctly rendered by code scanning.
    validate: option<bool>
  }
  code-scanning-upload-sarif: func(params: code-scanning-upload-sarif-params) -> result<string, string>;

  /// Get information about a SARIF upload
  record code-scanning-get-sarif-params {
    /// The SARIF ID obtained after uploading.
    sarif-id: string
  }
  code-scanning-get-sarif: func(params: code-scanning-get-sarif-params) -> result<string, string>;

}

interface codespaces {
  enum codespaces-set-codespaces-billing-body-visibility-enum {
    disabled,
    selected-members,
    all-members,
    all-members-and-outside-collaborators,
  }

  enum codespaces-create-or-update-org-secret-body-visibility-enum {
    all,
    private,
    selected,
  }

  /// List codespaces for the organization
  codespaces-list-in-organization: func() -> result<string, string>;

  /// Manage access control for organization codespaces
  record codespaces-set-codespaces-billing-params {
    /// The usernames of the organization members who should have access to codespaces in the organization. Required when `visibility` is `selected_members`. The provided list of usernames will replace any existing value.
    selected-usernames: option<list<string>>,
    /// Which users can access codespaces in the organization. `disabled` means that no users can access codespaces in the organization.
    visibility: codespaces-set-codespaces-billing-body-visibility-enum
  }
  codespaces-set-codespaces-billing: func(params: codespaces-set-codespaces-billing-params) -> result<string, string>;

  /// Add users to Codespaces billing for an organization
  record codespaces-set-codespaces-billing-users-params {
    /// The usernames of the organization members whose codespaces be billed to the organization.
    selected-usernames: list<string>
  }
  codespaces-set-codespaces-billing-users: func(params: codespaces-set-codespaces-billing-users-params) -> result<string, string>;

  /// Removes users from Codespaces billing for an organization
  record codespaces-delete-codespaces-billing-users-params {
    /// The usernames of the organization members whose codespaces should not be billed to the organization.
    selected-usernames: list<string>
  }
  codespaces-delete-codespaces-billing-users: func(params: codespaces-delete-codespaces-billing-users-params) -> result<string, string>;

  /// List organization secrets
  codespaces-list-org-secrets: func() -> result<string, string>;

  /// Get an organization public key
  codespaces-get-org-public-key: func() -> result<string, string>;

  /// Get an organization secret
  codespaces-get-org-secret: func() -> result<string, string>;

  /// Create or update an organization secret
  record codespaces-create-or-update-org-secret-params {
    /// The value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an organization public key](https://docs.github.com/rest/reference/codespaces#get-an-organization-public-key) endpoint.
    encrypted-value: option<string>,
    /// The ID of the key you used to encrypt the secret.
    key-id: option<string>,
    /// An array of repository IDs that can access the organization secret. You can only provide a list of repository IDs when the `visibility` is set to `selected`. You can manage the list of selected repositories using the [List selected repositories for an organization secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-an-organization-secret), [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/codespaces#set-selected-repositories-for-an-organization-secret), and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/codespaces#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: option<list<s32>>,
    /// Which type of organization repositories have access to the organization secret. `selected` means only the repositories specified by `selected_repository_ids` can access the secret.
    visibility: codespaces-create-or-update-org-secret-body-visibility-enum
  }
  codespaces-create-or-update-org-secret: func(params: codespaces-create-or-update-org-secret-params) -> result<string, string>;

  /// Delete an organization secret
  codespaces-delete-org-secret: func() -> result<string, string>;

  /// List selected repositories for an organization secret
  codespaces-list-selected-repos-for-org-secret: func() -> result<string, string>;

  /// Set selected repositories for an organization secret
  record codespaces-set-selected-repos-for-org-secret-params {
    /// An array of repository ids that can access the organization secret. You can only provide a list of repository ids when the `visibility` is set to `selected`. You can add and remove individual repositories using the [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/codespaces#set-selected-repositories-for-an-organization-secret) and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/codespaces#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: list<s32>
  }
  codespaces-set-selected-repos-for-org-secret: func(params: codespaces-set-selected-repos-for-org-secret-params) -> result<string, string>;

  /// Add selected repository to an organization secret
  record codespaces-add-selected-repo-to-org-secret-params {
    repository-id: string
  }
  codespaces-add-selected-repo-to-org-secret: func(params: codespaces-add-selected-repo-to-org-secret-params) -> result<string, string>;

  /// Remove selected repository from an organization secret
  record codespaces-remove-selected-repo-from-org-secret-params {
    repository-id: string
  }
  codespaces-remove-selected-repo-from-org-secret: func(params: codespaces-remove-selected-repo-from-org-secret-params) -> result<string, string>;

  /// List codespaces for a user in organization
  codespaces-get-codespaces-for-user-in-org: func() -> result<string, string>;

  /// Delete a codespace from the organization
  codespaces-delete-from-organization: func() -> result<string, string>;

  /// Stop a codespace for an organization user
  codespaces-stop-in-organization: func() -> result<string, string>;

  /// List codespaces in a repository for the authenticated user
  codespaces-list-in-repository-for-authenticated-user: func() -> result<string, string>;

  /// Create a codespace in a repository
  record codespaces-create-with-repo-for-authenticated-user-params {
    /// IP for location auto-detection when proxying a request
    client-ip: option<string>,
    /// Path to devcontainer.json config to use for this codespace
    devcontainer-path: option<string>,
    /// Display name for this codespace
    display-name: option<string>,
    /// Time in minutes before codespace stops from inactivity
    idle-timeout-minutes: option<s32>,
    /// Location for this codespace. Assigned by IP if not provided
    location: option<string>,
    /// Machine type to use for this codespace
    machine: option<string>,
    /// Whether to authorize requested permissions from devcontainer.json
    multi-repo-permissions-opt-out: option<bool>,
    /// Git ref (typically a branch name) for this codespace
    ref: option<string>,
    /// Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).
    retention-period-minutes: option<s32>,
    /// Working directory for this codespace
    working-directory: option<string>
  }
  codespaces-create-with-repo-for-authenticated-user: func(params: codespaces-create-with-repo-for-authenticated-user-params) -> result<string, string>;

  /// List devcontainer configurations in a repository for the authenticated user
  codespaces-list-devcontainers-in-repository-for-authenticated-user: func() -> result<string, string>;

  /// List available machine types for a repository
  record codespaces-repo-machines-for-authenticated-user-params {
    /// The location to check for available machines. Assigned by IP if not provided.
    location: option<string>,
    /// IP for location auto-detection when proxying a request
    client-ip: option<string>
  }
  codespaces-repo-machines-for-authenticated-user: func(params: codespaces-repo-machines-for-authenticated-user-params) -> result<string, string>;

  /// Get default attributes for a codespace
  record codespaces-pre-flight-with-repo-for-authenticated-user-params {
    /// The branch or commit to check for a default devcontainer path. If not specified, the default branch will be checked.
    ref: option<string>,
    /// An alternative IP for default location auto-detection, such as when proxying a request.
    client-ip: option<string>
  }
  codespaces-pre-flight-with-repo-for-authenticated-user: func(params: codespaces-pre-flight-with-repo-for-authenticated-user-params) -> result<string, string>;

  /// List repository secrets
  codespaces-list-repo-secrets: func() -> result<string, string>;

  /// Get a repository public key
  codespaces-get-repo-public-key: func() -> result<string, string>;

  /// Get a repository secret
  codespaces-get-repo-secret: func() -> result<string, string>;

  /// Create or update a repository secret
  record codespaces-create-or-update-repo-secret-params {
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get a repository public key](https://docs.github.com/rest/reference/codespaces#get-a-repository-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>
  }
  codespaces-create-or-update-repo-secret: func(params: codespaces-create-or-update-repo-secret-params) -> result<string, string>;

  /// Delete a repository secret
  codespaces-delete-repo-secret: func() -> result<string, string>;

  /// Create a codespace from a pull request
  record codespaces-create-with-pr-for-authenticated-user-params {
    /// IP for location auto-detection when proxying a request
    client-ip: option<string>,
    /// Path to devcontainer.json config to use for this codespace
    devcontainer-path: option<string>,
    /// Display name for this codespace
    display-name: option<string>,
    /// Time in minutes before codespace stops from inactivity
    idle-timeout-minutes: option<s32>,
    /// Location for this codespace. Assigned by IP if not provided
    location: option<string>,
    /// Machine type to use for this codespace
    machine: option<string>,
    /// Whether to authorize requested permissions from devcontainer.json
    multi-repo-permissions-opt-out: option<bool>,
    /// Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).
    retention-period-minutes: option<s32>,
    /// Working directory for this codespace
    working-directory: option<string>
  }
  codespaces-create-with-pr-for-authenticated-user: func(params: codespaces-create-with-pr-for-authenticated-user-params) -> result<string, string>;

  /// List codespaces for the authenticated user
  codespaces-list-for-authenticated-user: func() -> result<string, string>;

  /// Create a codespace for the authenticated user
  record codespaces-create-for-authenticated-user-params {
    body: string
  }
  codespaces-create-for-authenticated-user: func(params: codespaces-create-for-authenticated-user-params) -> result<string, string>;

  /// List secrets for the authenticated user
  codespaces-list-secrets-for-authenticated-user: func() -> result<string, string>;

  /// Get public key for the authenticated user
  codespaces-get-public-key-for-authenticated-user: func() -> result<string, string>;

  /// Get a secret for the authenticated user
  codespaces-get-secret-for-authenticated-user: func() -> result<string, string>;

  /// Create or update a secret for the authenticated user
  record codespaces-create-or-update-secret-for-authenticated-user-params {
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get the public key for the authenticated user](https://docs.github.com/rest/reference/codespaces#get-the-public-key-for-the-authenticated-user) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: string,
    /// An array of repository ids that can access the user secret. You can manage the list of selected repositories using the [List selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-a-user-secret), [Set selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#set-selected-repositories-for-a-user-secret), and [Remove a selected repository from a user secret](https://docs.github.com/rest/reference/codespaces#remove-a-selected-repository-from-a-user-secret) endpoints.
    selected-repository-ids: option<list<string>>
  }
  codespaces-create-or-update-secret-for-authenticated-user: func(params: codespaces-create-or-update-secret-for-authenticated-user-params) -> result<string, string>;

  /// Delete a secret for the authenticated user
  codespaces-delete-secret-for-authenticated-user: func() -> result<string, string>;

  /// List selected repositories for a user secret
  codespaces-list-repositories-for-secret-for-authenticated-user: func() -> result<string, string>;

  /// Set selected repositories for a user secret
  record codespaces-set-repositories-for-secret-for-authenticated-user-params {
    /// An array of repository ids for which a codespace can access the secret. You can manage the list of selected repositories using the [List selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-a-user-secret), [Add a selected repository to a user secret](https://docs.github.com/rest/reference/codespaces#add-a-selected-repository-to-a-user-secret), and [Remove a selected repository from a user secret](https://docs.github.com/rest/reference/codespaces#remove-a-selected-repository-from-a-user-secret) endpoints.
    selected-repository-ids: list<s32>
  }
  codespaces-set-repositories-for-secret-for-authenticated-user: func(params: codespaces-set-repositories-for-secret-for-authenticated-user-params) -> result<string, string>;

  /// Add a selected repository to a user secret
  record codespaces-add-repository-for-secret-for-authenticated-user-params {
    repository-id: string
  }
  codespaces-add-repository-for-secret-for-authenticated-user: func(params: codespaces-add-repository-for-secret-for-authenticated-user-params) -> result<string, string>;

  /// Remove a selected repository from a user secret
  record codespaces-remove-repository-for-secret-for-authenticated-user-params {
    repository-id: string
  }
  codespaces-remove-repository-for-secret-for-authenticated-user: func(params: codespaces-remove-repository-for-secret-for-authenticated-user-params) -> result<string, string>;

  /// Get a codespace for the authenticated user
  codespaces-get-for-authenticated-user: func() -> result<string, string>;

  /// Update a codespace for the authenticated user
  record codespaces-update-for-authenticated-user-params {
    /// Display name for this codespace
    display-name: option<string>,
    /// A valid machine to transition this codespace to.
    machine: option<string>,
    /// Recently opened folders inside the codespace. It is currently used by the clients to determine the folder path to load the codespace in.
    recent-folders: option<list<string>>
  }
  codespaces-update-for-authenticated-user: func(params: codespaces-update-for-authenticated-user-params) -> result<string, string>;

  /// Delete a codespace for the authenticated user
  codespaces-delete-for-authenticated-user: func() -> result<string, string>;

  /// Export a codespace for the authenticated user
  codespaces-export-for-authenticated-user: func() -> result<string, string>;

  /// Get details about a codespace export
  codespaces-get-export-details-for-authenticated-user: func() -> result<string, string>;

  /// List machine types for a codespace
  codespaces-codespace-machines-for-authenticated-user: func() -> result<string, string>;

  /// Create a repository from an unpublished codespace
  record codespaces-publish-for-authenticated-user-params {
    /// A name for the new repository.
    name: option<string>,
    /// Whether the new repository should be private.
    private: option<bool>
  }
  codespaces-publish-for-authenticated-user: func(params: codespaces-publish-for-authenticated-user-params) -> result<string, string>;

  /// Start a codespace for the authenticated user
  codespaces-start-for-authenticated-user: func() -> result<string, string>;

  /// Stop a codespace for the authenticated user
  codespaces-stop-for-authenticated-user: func() -> result<string, string>;

}

interface interactions {
  /// The duration of the interaction restriction. Default: `one_day`.
  record interaction-expiry {
    /// opaque schema; raw JSON
    value: string
  }

  /// The type of GitHub user that can comment, open issues, or create pull requests while the interaction limit is in effect.
  record interaction-group {
    /// opaque schema; raw JSON
    value: string
  }

  /// Get interaction restrictions for an organization
  interactions-get-restrictions-for-org: func() -> result<string, string>;

  /// Set interaction restrictions for an organization
  record interactions-set-restrictions-for-org-params {
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  interactions-set-restrictions-for-org: func(params: interactions-set-restrictions-for-org-params) -> result<string, string>;

  /// Remove interaction restrictions for an organization
  interactions-remove-restrictions-for-org: func() -> result<string, string>;

  /// Get interaction restrictions for a repository
  interactions-get-restrictions-for-repo: func() -> result<string, string>;

  /// Set interaction restrictions for a repository
  record interactions-set-restrictions-for-repo-params {
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  interactions-set-restrictions-for-repo: func(params: interactions-set-restrictions-for-repo-params) -> result<string, string>;

  /// Remove interaction restrictions for a repository
  interactions-remove-restrictions-for-repo: func() -> result<string, string>;

  /// Get interaction restrictions for your public repositories
  interactions-get-restrictions-for-authenticated-user: func() -> result<string, string>;

  /// Set interaction restrictions for your public repositories
  record interactions-set-restrictions-for-authenticated-user-params {
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  interactions-set-restrictions-for-authenticated-user: func(params: interactions-set-restrictions-for-authenticated-user-params) -> result<string, string>;

  /// Remove interaction restrictions from your public repositories
  interactions-remove-restrictions-for-authenticated-user: func() -> result<string, string>;

}

interface migrations {
  enum migrations-list-for-org-exclude-item-enum {
    repositories,
  }

  enum migrations-start-import-body-vcs-enum {
    subversion,
    git,
    mercurial,
    tfvc,
  }

  enum migrations-update-import-body-vcs-enum {
    subversion,
    tfvc,
    git,
    mercurial,
  }

  enum migrations-set-lfs-preference-body-use-lfs-enum {
    opt-in,
    opt-out,
  }

  /// List organization migrations
  record migrations-list-for-org-params {
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<migrations-list-for-org-exclude-item-enum>>
  }
  migrations-list-for-org: func(params: migrations-list-for-org-params) -> result<string, string>;

  /// Start an organization migration
  record migrations-start-for-org-params {
    /// Exclude related items from being returned in the response in order to improve performance of the request. The array can include any of: `"repositories"`.
    exclude: option<list<migrations-list-for-org-exclude-item-enum>>,
    /// Indicates whether attachments should be excluded from the migration (to reduce migration archive file size).
    exclude-attachments: option<bool>,
    /// Indicates whether the repository git data should be excluded from the migration.
    exclude-git-data: option<bool>,
    /// Indicates whether metadata should be excluded and only git source should be included for the migration.
    exclude-metadata: option<bool>,
    /// Indicates whether projects owned by the organization or users should be excluded. from the migration.
    exclude-owner-projects: option<bool>,
    /// Indicates whether releases should be excluded from the migration (to reduce migration archive file size).
    exclude-releases: option<bool>,
    /// Indicates whether repositories should be locked (to prevent manipulation) while migrating data.
    lock-repositories: option<bool>,
    /// Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags).
    org-metadata-only: option<bool>,
    /// A list of arrays indicating which repositories should be migrated.
    repositories: list<string>
  }
  migrations-start-for-org: func(params: migrations-start-for-org-params) -> result<string, string>;

  /// Get an organization migration status
  record migrations-get-status-for-org-params {
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<migrations-list-for-org-exclude-item-enum>>
  }
  migrations-get-status-for-org: func(params: migrations-get-status-for-org-params) -> result<string, string>;

  /// Download an organization migration archive
  migrations-download-archive-for-org: func() -> result<string, string>;

  /// Delete an organization migration archive
  migrations-delete-archive-for-org: func() -> result<string, string>;

  /// Unlock an organization repository
  migrations-unlock-repo-for-org: func() -> result<string, string>;

  /// List repositories in an organization migration
  migrations-list-repos-for-org: func() -> result<string, string>;

  /// Get an import status
  migrations-get-import-status: func() -> result<string, string>;

  /// Start an import
  record migrations-start-import-params {
    /// For a tfvc import, the name of the project that is being imported.
    tfvc-project: option<string>,
    /// The originating VCS type. Without this parameter, the import job will take additional time to detect the VCS type before beginning the import. This detection step will be reflected in the response.
    vcs: option<migrations-start-import-body-vcs-enum>,
    /// If authentication is required, the password to provide to `vcs_url`.
    vcs-password: option<string>,
    /// The URL of the originating repository.
    vcs-url: string,
    /// If authentication is required, the username to provide to `vcs_url`.
    vcs-username: option<string>
  }
  migrations-start-import: func(params: migrations-start-import-params) -> result<string, string>;

  /// Update an import
  record migrations-update-import-params {
    /// For a tfvc import, the name of the project that is being imported.
    tfvc-project: option<string>,
    /// The type of version control system you are migrating from.
    vcs: option<migrations-update-import-body-vcs-enum>,
    /// The password to provide to the originating repository.
    vcs-password: option<string>,
    /// The username to provide to the originating repository.
    vcs-username: option<string>
  }
  migrations-update-import: func(params: migrations-update-import-params) -> result<string, string>;

  /// Cancel an import
  migrations-cancel-import: func() -> result<string, string>;

  /// Get commit authors
  migrations-get-commit-authors: func() -> result<string, string>;

  /// Map a commit author
  record migrations-map-commit-author-params {
    author-id: string,
    /// The new Git author email.
    email: option<string>,
    /// The new Git author name.
    name: option<string>
  }
  migrations-map-commit-author: func(params: migrations-map-commit-author-params) -> result<string, string>;

  /// Get large files
  migrations-get-large-files: func() -> result<string, string>;

  /// Update Git LFS preference
  record migrations-set-lfs-preference-params {
    /// Whether to store large files during the import. `opt_in` means large files will be stored using Git LFS. `opt_out` means large files will be removed during the import.
    use-lfs: migrations-set-lfs-preference-body-use-lfs-enum
  }
  migrations-set-lfs-preference: func(params: migrations-set-lfs-preference-params) -> result<string, string>;

  /// List user migrations
  migrations-list-for-authenticated-user: func() -> result<string, string>;

  /// Start a user migration
  record migrations-start-for-authenticated-user-params {
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<migrations-list-for-org-exclude-item-enum>>,
    /// Do not include attachments in the migration
    exclude-attachments: option<bool>,
    /// Indicates whether the repository git data should be excluded from the migration.
    exclude-git-data: option<bool>,
    /// Indicates whether metadata should be excluded and only git source should be included for the migration.
    exclude-metadata: option<bool>,
    /// Indicates whether projects owned by the organization or users should be excluded.
    exclude-owner-projects: option<bool>,
    /// Do not include releases in the migration
    exclude-releases: option<bool>,
    /// Lock the repositories being migrated at the start of the migration
    lock-repositories: option<bool>,
    /// Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags).
    org-metadata-only: option<bool>,
    repositories: list<string>
  }
  migrations-start-for-authenticated-user: func(params: migrations-start-for-authenticated-user-params) -> result<string, string>;

  /// Get a user migration status
  record migrations-get-status-for-authenticated-user-params {
    exclude: option<list<string>>
  }
  migrations-get-status-for-authenticated-user: func(params: migrations-get-status-for-authenticated-user-params) -> result<string, string>;

  /// Download a user migration archive
  migrations-get-archive-for-authenticated-user: func() -> result<string, string>;

  /// Delete a user migration archive
  migrations-delete-archive-for-authenticated-user: func() -> result<string, string>;

  /// Unlock a user repository
  migrations-unlock-repo-for-authenticated-user: func() -> result<string, string>;

  /// List repositories for a user migration
  migrations-list-repos-for-authenticated-user: func() -> result<string, string>;

}

interface packages {
  enum packages-list-packages-for-organization-package-type-enum {
    npm,
    maven,
    rubygems,
    docker,
    nuget,
    container,
  }

  enum packages-get-all-package-versions-for-package-owned-by-org-state-enum {
    active,
    deleted,
  }

  /// List packages for an organization
  record packages-list-packages-for-organization-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: packages-list-packages-for-organization-package-type-enum,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
