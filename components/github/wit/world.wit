  /// List organization migrations
  record list-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<list-for-org-exclude-item-enum>>
  }
  list-for-org: func(params: list-for-org-params) -> result<list<migration>, string>;

  /// Start an organization migration
  record start-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Exclude related items from being returned in the response in order to improve performance of the request. The array can include any of: `"repositories"`.
    exclude: option<list<list-for-org-exclude-item-enum>>,
    /// Indicates whether attachments should be excluded from the migration (to reduce migration archive file size).
    exclude-attachments: option<bool>,
    /// Indicates whether the repository git data should be excluded from the migration.
    exclude-git-data: option<bool>,
    /// Indicates whether metadata should be excluded and only git source should be included for the migration.
    exclude-metadata: option<bool>,
    /// Indicates whether projects owned by the organization or users should be excluded. from the migration.
    exclude-owner-projects: option<bool>,
    /// Indicates whether releases should be excluded from the migration (to reduce migration archive file size).
    exclude-releases: option<bool>,
    /// Indicates whether repositories should be locked (to prevent manipulation) while migrating data.
    lock-repositories: option<bool>,
    /// Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags).
    org-metadata-only: option<bool>,
    /// A list of arrays indicating which repositories should be migrated.
    repositories: list<string>
  }
  start-for-org: func(params: start-for-org-params) -> result<migration, start-for-org-error>;

  /// Get an organization migration status
  record get-status-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string,
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<list-for-org-exclude-item-enum>>
  }
  get-status-for-org: func(params: get-status-for-org-params) -> result<migration, get-status-for-org-error>;

  /// Download an organization migration archive
  record download-archive-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string
  }
  download-archive-for-org: func(params: download-archive-for-org-params) -> result<string, download-archive-for-org-error>;

  /// Delete an organization migration archive
  record delete-archive-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string
  }
  delete-archive-for-org: func(params: delete-archive-for-org-params) -> result<string, delete-archive-for-org-error>;

  /// Unlock an organization repository
  record unlock-repo-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string,
    /// repo_name parameter
    repo-name: string
  }
  unlock-repo-for-org: func(params: unlock-repo-for-org-params) -> result<string, unlock-repo-for-org-error>;

  /// List repositories in an organization migration
  record list-repos-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-for-org: func(params: list-repos-for-org-params) -> result<list<minimal-repository>, list-repos-for-org-error>;

  /// Get an import status
  record get-import-status-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-import-status: func(params: get-import-status-params) -> result<import-op, get-import-status-error>;

  /// Start an import
  record start-import-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// For a tfvc import, the name of the project that is being imported.
    tfvc-project: option<string>,
    /// The originating VCS type. Without this parameter, the import job will take additional time to detect the VCS type before beginning the import. This detection step will be reflected in the response.
    vcs: option<start-import-body-vcs-enum>,
    /// If authentication is required, the password to provide to `vcs_url`.
    vcs-password: option<string>,
    /// The URL of the originating repository.
    vcs-url: string,
    /// If authentication is required, the username to provide to `vcs_url`.
    vcs-username: option<string>
  }
  start-import: func(params: start-import-params) -> result<import-op, start-import-error>;

  /// Update an import
  record update-import-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// For a tfvc import, the name of the project that is being imported.
    tfvc-project: option<string>,
    /// The type of version control system you are migrating from.
    vcs: option<update-import-body-vcs-enum>,
    /// The password to provide to the originating repository.
    vcs-password: option<string>,
    /// The username to provide to the originating repository.
    vcs-username: option<string>
  }
  update-import: func(params: update-import-params) -> result<import-op, update-import-error>;

  /// Cancel an import
  record cancel-import-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  cancel-import: func(params: cancel-import-params) -> result<string, cancel-import-error>;

  /// Get commit authors
  record get-commit-authors-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// A user ID. Only return users with an ID greater than this ID.
    since: option<s32>
  }
  get-commit-authors: func(params: get-commit-authors-params) -> result<list<porter-author>, get-commit-authors-error>;

  /// Map a commit author
  record map-commit-author-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    author-id: string,
    /// The new Git author email.
    email: option<string>,
    /// The new Git author name.
    name: option<string>
  }
  map-commit-author: func(params: map-commit-author-params) -> result<porter-author, map-commit-author-error>;

  /// Get large files
  record get-large-files-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-large-files: func(params: get-large-files-params) -> result<list<porter-large-file>, get-large-files-error>;

  /// Update Git LFS preference
  record set-lfs-preference-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Whether to store large files during the import. `opt_in` means large files will be stored using Git LFS. `opt_out` means large files will be removed during the import.
    use-lfs: set-lfs-preference-body-use-lfs-enum
  }
  set-lfs-preference: func(params: set-lfs-preference-params) -> result<import-op, set-lfs-preference-error>;

  /// List user migrations
  record list-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<list<migration>, list-for-authenticated-user-error>;

  /// Start a user migration
  record start-for-authenticated-user-params {
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<list-for-org-exclude-item-enum>>,
    /// Do not include attachments in the migration
    exclude-attachments: option<bool>,
    /// Indicates whether the repository git data should be excluded from the migration.
    exclude-git-data: option<bool>,
    /// Indicates whether metadata should be excluded and only git source should be included for the migration.
    exclude-metadata: option<bool>,
    /// Indicates whether projects owned by the organization or users should be excluded.
    exclude-owner-projects: option<bool>,
    /// Do not include releases in the migration
    exclude-releases: option<bool>,
    /// Lock the repositories being migrated at the start of the migration
    lock-repositories: option<bool>,
    /// Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags).
    org-metadata-only: option<bool>,
    repositories: list<string>
  }
  start-for-authenticated-user: func(params: start-for-authenticated-user-params) -> result<migration, start-for-authenticated-user-error>;

  /// Get a user migration status
  record get-status-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string,
    exclude: option<list<string>>
  }
  get-status-for-authenticated-user: func(params: get-status-for-authenticated-user-params) -> result<migration, get-status-for-authenticated-user-error>;

  /// Download a user migration archive
  record get-archive-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string
  }
  get-archive-for-authenticated-user: func(params: get-archive-for-authenticated-user-params) -> result<string, get-archive-for-authenticated-user-error>;

  /// Delete a user migration archive
  record delete-archive-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string
  }
  delete-archive-for-authenticated-user: func(params: delete-archive-for-authenticated-user-params) -> result<string, delete-archive-for-authenticated-user-error>;

  /// Unlock a user repository
  record unlock-repo-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string,
    /// repo_name parameter
    repo-name: string
  }
  unlock-repo-for-authenticated-user: func(params: unlock-repo-for-authenticated-user-params) -> result<string, unlock-repo-for-authenticated-user-error>;

  /// List repositories for a user migration
  record list-repos-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-for-authenticated-user: func(params: list-repos-for-authenticated-user-params) -> result<list<minimal-repository>, list-repos-for-authenticated-user-error>;

}

interface packages {
  enum list-packages-for-organization-package-type-enum {
    npm,
    maven,
    rubygems,
    docker,
    nuget,
    container,
  }

  enum list-packages-for-organization-visibility-enum {
    public,
    private,
    internal,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum package-op-visibility-enum {
    private,
    public,
  }

  enum get-all-package-versions-for-package-owned-by-org-state-enum {
    active,
    deleted,
  }

  /// A software package
  record package-op {
    created-at: string,
    html-url: string,
    /// Unique identifier of the package.
    id: s32,
    /// The name of the package.
    name: string,
    owner: option<nullable-simple-user>,
    package-type: list-packages-for-organization-package-type-enum,
    repository: option<nullable-minimal-repository>,
    updated-at: string,
    url: string,
    /// The number of versions of the package.
    version-count: s32,
    visibility: package-op-visibility-enum
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Minimal Repository
  record nullable-minimal-repository {
    allow-forking: option<bool>,
    archive-url: string,
    archived: option<bool>,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: option<string>,
    code-of-conduct: option<code-of-conduct>,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: option<string>,
    default-branch: option<string>,
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    disabled: option<bool>,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: option<s32>,
    forks-count: option<s32>,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: option<string>,
    has-discussions: option<bool>,
    has-downloads: option<bool>,
    has-issues: option<bool>,
    has-pages: option<bool>,
    has-projects: option<bool>,
    has-wiki: option<bool>,
    homepage: option<string>,
    hooks-url: string,
    html-url: string,
    id: s32,
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: option<string>,
    languages-url: string,
    license: option<nullable-minimal-repository-license>,
    merges-url: string,
    milestones-url: string,
    mirror-url: option<string>,
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: option<s32>,
    open-issues-count: option<s32>,
    owner: simple-user,
    permissions: option<nullable-minimal-repository-permissions>,
    private: bool,
    pulls-url: string,
    pushed-at: option<string>,
    releases-url: string,
    role-name: option<string>,
    security-and-analysis: option<security-and-analysis>,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: option<s32>,
    ssh-url: option<string>,
    stargazers-count: option<s32>,
    stargazers-url: string,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: option<string>,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: option<string>,
    url: string,
    visibility: option<string>,
    watchers: option<s32>,
    watchers-count: option<s32>,
    web-commit-signoff-required: option<bool>
  }

  /// Code Of Conduct
  record code-of-conduct {
    body: option<string>,
    html-url: string,
    key: string,
    name: string,
    url: string
  }

  record nullable-minimal-repository-license {
    key: option<string>,
    name: option<string>,
    node-id: option<string>,
    spdx-id: option<string>,
    url: option<string>
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record nullable-minimal-repository-permissions {
    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  record security-and-analysis {
    advanced-security: option<security-and-analysis-advanced-security>,
    secret-scanning: option<security-and-analysis-secret-scanning>,
    secret-scanning-push-protection: option<security-and-analysis-secret-scanning-push-protection>
  }

  record security-and-analysis-advanced-security {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning-push-protection {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  /// A version of a software package
  record package-version {
    created-at: string,
    deleted-at: option<string>,
    description: option<string>,
    html-url: option<string>,
    /// Unique identifier of the package version.
    id: s32,
    license: option<string>,
    metadata: option<package-version-metadata>,
    /// The name of the package version.
    name: string,
    package-html-url: string,
    updated-at: string,
    url: string
  }

  record package-version-metadata {
    container: option<package-version-metadata-container>,
    docker: option<package-version-metadata-docker>,
    package-type: list-packages-for-organization-package-type-enum
  }

  record package-version-metadata-container {
    tags: list<string>
  }

  record package-version-metadata-docker {
    tag: option<list<string>>
  }

  variant list-packages-for-organization-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant delete-package-for-org-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant restore-package-for-org-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-all-package-versions-for-package-owned-by-org-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-package-version-for-org-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant restore-package-version-for-org-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-package-for-authenticated-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant restore-package-for-authenticated-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-all-package-versions-for-package-owned-by-authenticated-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-package-version-for-authenticated-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant restore-package-version-for-authenticated-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-packages-for-user-error {
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant delete-package-for-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant restore-package-for-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-all-package-versions-for-package-owned-by-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-package-version-for-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant restore-package-version-for-user-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// List packages for an organization
  record list-packages-for-organization-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: list-packages-for-organization-package-type-enum,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The selected visibility of the packages.  This parameter is optional and only filters an existing result set.
    /// 
    visibility: option<list-packages-for-organization-visibility-enum>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-packages-for-organization: func(params: list-packages-for-organization-params) -> result<list<package-op>, list-packages-for-organization-error>;

  /// Get a package for an organization
  record get-package-for-organization-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-package-for-organization: func(params: get-package-for-organization-params) -> result<package-op, string>;

  /// Delete a package for an organization
  record delete-package-for-org-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The organization name. The name is not case sensitive.
    org: string
  }
  delete-package-for-org: func(params: delete-package-for-org-params) -> result<string, delete-package-for-org-error>;

  /// Restore a package for an organization
  record restore-package-for-org-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// package token
    token: option<string>
  }
  restore-package-for-org: func(params: restore-package-for-org-params) -> result<string, restore-package-for-org-error>;

  /// List package versions for a package owned by an organization
  record get-all-package-versions-for-package-owned-by-org-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The state of the package, either active or deleted.
    state: option<get-all-package-versions-for-package-owned-by-org-state-enum>
  }
  get-all-package-versions-for-package-owned-by-org: func(params: get-all-package-versions-for-package-owned-by-org-params) -> result<list<package-version>, get-all-package-versions-for-package-owned-by-org-error>;

  /// Get a package version for an organization
  record get-package-version-for-organization-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Unique identifier of the package version.
    package-version-id: string
  }
  get-package-version-for-organization: func(params: get-package-version-for-organization-params) -> result<package-version, string>;

  /// Delete package version for an organization
  record delete-package-version-for-org-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Unique identifier of the package version.
    package-version-id: string
  }
  delete-package-version-for-org: func(params: delete-package-version-for-org-params) -> result<string, delete-package-version-for-org-error>;

  /// Restore package version for an organization
  record restore-package-version-for-org-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Unique identifier of the package version.
    package-version-id: string
  }
  restore-package-version-for-org: func(params: restore-package-version-for-org-params) -> result<string, restore-package-version-for-org-error>;

  /// List packages for the authenticated user's namespace
  record list-packages-for-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: list-packages-for-organization-package-type-enum,
    /// The selected visibility of the packages.  This parameter is optional and only filters an existing result set.
    /// 
    visibility: option<list-packages-for-organization-visibility-enum>
  }
  list-packages-for-authenticated-user: func(params: list-packages-for-authenticated-user-params) -> result<list<package-op>, string>;

  /// Get a package for the authenticated user
  record get-package-for-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string
  }
  get-package-for-authenticated-user: func(params: get-package-for-authenticated-user-params) -> result<package-op, string>;

  /// Delete a package for the authenticated user
  record delete-package-for-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string
  }
  delete-package-for-authenticated-user: func(params: delete-package-for-authenticated-user-params) -> result<string, delete-package-for-authenticated-user-error>;

  /// Restore a package for the authenticated user
  record restore-package-for-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// package token
    token: option<string>
  }
  restore-package-for-authenticated-user: func(params: restore-package-for-authenticated-user-params) -> result<string, restore-package-for-authenticated-user-error>;

  /// List package versions for a package owned by the authenticated user
  record get-all-package-versions-for-package-owned-by-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// The state of the package, either active or deleted.
    state: option<get-all-package-versions-for-package-owned-by-org-state-enum>
  }
  get-all-package-versions-for-package-owned-by-authenticated-user: func(params: get-all-package-versions-for-package-owned-by-authenticated-user-params) -> result<list<package-version>, get-all-package-versions-for-package-owned-by-authenticated-user-error>;

  /// Get a package version for the authenticated user
  record get-package-version-for-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// Unique identifier of the package version.
    package-version-id: string
  }
  get-package-version-for-authenticated-user: func(params: get-package-version-for-authenticated-user-params) -> result<package-version, string>;

  /// Delete a package version for the authenticated user
  record delete-package-version-for-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// Unique identifier of the package version.
    package-version-id: string
  }
  delete-package-version-for-authenticated-user: func(params: delete-package-version-for-authenticated-user-params) -> result<string, delete-package-version-for-authenticated-user-error>;

  /// Restore a package version for the authenticated user
  record restore-package-version-for-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// Unique identifier of the package version.
    package-version-id: string
  }
  restore-package-version-for-authenticated-user: func(params: restore-package-version-for-authenticated-user-params) -> result<string, restore-package-version-for-authenticated-user-error>;

  /// List packages for a user
  record list-packages-for-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: list-packages-for-organization-package-type-enum,
    /// The selected visibility of the packages.  This parameter is optional and only filters an existing result set.
    /// 
    visibility: option<list-packages-for-organization-visibility-enum>,
    /// The handle for the GitHub user account.
    username: string
  }
  list-packages-for-user: func(params: list-packages-for-user-params) -> result<list<package-op>, list-packages-for-user-error>;

  /// Get a package for a user
  record get-package-for-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The handle for the GitHub user account.
    username: string
  }
  get-package-for-user: func(params: get-package-for-user-params) -> result<package-op, string>;

  /// Delete a package for a user
  record delete-package-for-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The handle for the GitHub user account.
    username: string
  }
  delete-package-for-user: func(params: delete-package-for-user-params) -> result<string, delete-package-for-user-error>;

  /// Restore a package for a user
  record restore-package-for-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The handle for the GitHub user account.
    username: string,
    /// package token
    token: option<string>
  }
  restore-package-for-user: func(params: restore-package-for-user-params) -> result<string, restore-package-for-user-error>;

  /// List package versions for a package owned by a user
  record get-all-package-versions-for-package-owned-by-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The handle for the GitHub user account.
    username: string
  }
  get-all-package-versions-for-package-owned-by-user: func(params: get-all-package-versions-for-package-owned-by-user-params) -> result<list<package-version>, get-all-package-versions-for-package-owned-by-user-error>;

  /// Get a package version for a user
  record get-package-version-for-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// Unique identifier of the package version.
    package-version-id: string,
    /// The handle for the GitHub user account.
    username: string
  }
  get-package-version-for-user: func(params: get-package-version-for-user-params) -> result<package-version, string>;

  /// Delete package version for a user
  record delete-package-version-for-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The handle for the GitHub user account.
    username: string,
    /// Unique identifier of the package version.
    package-version-id: string
  }
  delete-package-version-for-user: func(params: delete-package-version-for-user-params) -> result<string, delete-package-version-for-user-error>;

  /// Restore package version for a user
  record restore-package-version-for-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: string,
    /// The name of the package.
    package-name: string,
    /// The handle for the GitHub user account.
    username: string,
    /// Unique identifier of the package version.
    package-version-id: string
  }
  restore-package-version-for-user: func(params: restore-package-version-for-user-params) -> result<string, restore-package-version-for-user-error>;

}

interface projects {
  enum list-for-org-state-enum {
    open,
    closed,
    all,
  }

  enum project-organization-permission-enum {
    read,
    write,
    admin,
    none,
  }

  enum list-cards-archived-state-enum {
    all,
    archived,
    not-archived,
  }

  enum list-collaborators-affiliation-enum {
    outside,
    direct,
    all,
  }

  enum add-collaborator-body-permission-enum {
    read,
    write,
    admin,
  }

  /// Projects are a way to organize columns and cards of work.
  record project {
    /// Body of the project
    body: string,
    columns-url: string,
    created-at: string,
    creator: nullable-simple-user,
    html-url: string,
    id: s32,
    /// Name of the project
    name: string,
    node-id: string,
    number: s32,
    /// The baseline permission that all organization members have on this project. Only present if owner is an organization.
    organization-permission: option<project-organization-permission-enum>,
    owner-url: string,
    /// Whether or not this project can be seen by everyone. Only present if owner is an organization.
    private: option<bool>,
    /// State of the project; either 'open' or 'closed'
    state: string,
    updated-at: string,
    url: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Project cards represent a scope of work.
  record project-card {
    /// Whether or not the card is archived
    archived: option<bool>,
    column-name: option<string>,
    column-url: string,
    content-url: option<string>,
    created-at: string,
    creator: nullable-simple-user,
    /// The project card's ID
    id: s32,
    node-id: string,
    note: string,
    project-id: option<string>,
    project-url: string,
    updated-at: string,
    url: string
  }

  record move-card-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Project columns contain cards of work.
  record project-column {
    cards-url: string,
    created-at: string,
    /// The unique identifier of the project column
    id: s32,
    /// Name of the project column
    name: string,
    node-id: string,
    project-url: string,
    updated-at: string,
    url: string
  }

  record move-column-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Project Collaborator Permission
  record project-collaborator-permission {
    permission: string,
    user: nullable-simple-user
  }

  variant list-for-org-error {
    unprocessable-entity(string),
    other(string)
  }

  variant create-for-org-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    gone(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-card-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-card-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-card-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant move-card-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    service-unavailable(string),
    other(string)
  }

  variant get-column-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-column-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant delete-column-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant list-cards-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-card-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    service-unavailable(string),
    other(string)
  }

  variant move-column-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant update-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    gone(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    gone(string),
    other(string)
  }

  variant list-collaborators-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant add-collaborator-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant remove-collaborator-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-permission-for-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-columns-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant create-column-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-for-repo-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    gone(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-for-repo-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    gone(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-for-user-error {
    unprocessable-entity(string),
    other(string)
  }

  /// List organization projects
  record list-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Indicates the state of the projects to return.
    state: option<list-for-org-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-org: func(params: list-for-org-params) -> result<list<project>, list-for-org-error>;

  /// Create an organization project
  record create-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The description of the project.
    body: option<string>,
    /// The name of the project.
    name: string
  }
  create-for-org: func(params: create-for-org-params) -> result<project, create-for-org-error>;

  /// Get a project card
  record get-card-params {
    /// The unique identifier of the card.
    card-id: string
  }
  get-card: func(params: get-card-params) -> result<project-card, get-card-error>;

  /// Update an existing project card
  record update-card-params {
    /// The unique identifier of the card.
    card-id: string,
    /// Whether or not the card is archived
    archived: option<bool>,
    /// The project card's note
    note: option<string>
  }
  update-card: func(params: update-card-params) -> result<project-card, update-card-error>;

  /// Delete a project card
  record delete-card-params {
    /// The unique identifier of the card.
    card-id: string
  }
  delete-card: func(params: delete-card-params) -> result<string, delete-card-error>;

  /// Move a project card
  record move-card-params {
    /// The unique identifier of the card.
    card-id: string,
    /// The unique identifier of the column the card should be moved to
    column-id: option<s32>,
    /// The position of the card in a column. Can be one of: `top`, `bottom`, or `after:<card_id>` to place after the specified card.
    position: string
  }
  move-card: func(params: move-card-params) -> result<move-card-response, move-card-error>;

  /// Get a project column
  record get-column-params {
    /// The unique identifier of the column.
    column-id: string
  }
  get-column: func(params: get-column-params) -> result<project-column, get-column-error>;

  /// Update an existing project column
  record update-column-params {
    /// The unique identifier of the column.
    column-id: string,
    /// Name of the project column
    name: string
  }
  update-column: func(params: update-column-params) -> result<project-column, update-column-error>;

  /// Delete a project column
  record delete-column-params {
    /// The unique identifier of the column.
    column-id: string
  }
  delete-column: func(params: delete-column-params) -> result<string, delete-column-error>;

  /// List project cards
  record list-cards-params {
    /// The unique identifier of the column.
    column-id: string,
    /// Filters the project cards that are returned by the card's state.
    archived-state: option<list-cards-archived-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-cards: func(params: list-cards-params) -> result<list<project-card>, list-cards-error>;

  /// Create a project card
  record create-card-params {
    /// The unique identifier of the column.
    column-id: string,
    body: string
  }
  create-card: func(params: create-card-params) -> result<project-card, create-card-error>;

  /// Move a project column
  record move-column-params {
    /// The unique identifier of the column.
    column-id: string,
    /// The position of the column in a project. Can be one of: `first`, `last`, or `after:<column_id>` to place after the specified column.
    position: string
  }
  move-column: func(params: move-column-params) -> result<move-column-response, move-column-error>;

  /// Get a project
  record get-params {
    /// The unique identifier of the project.
    project-id: string
  }
  get: func(params: get-params) -> result<project, get-error>;

  /// Update a project
  record update-params {
    /// The unique identifier of the project.
    project-id: string,
    /// Body of the project
    body: option<string>,
    /// Name of the project
    name: option<string>,
    /// The baseline permission that all organization members have on this project
    organization-permission: option<project-organization-permission-enum>,
    /// Whether or not this project can be seen by everyone.
    private: option<bool>,
    /// State of the project; either 'open' or 'closed'
    state: option<string>
  }
  update: func(params: update-params) -> result<project, update-error>;

  /// Delete a project
  record delete-params {
    /// The unique identifier of the project.
    project-id: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

  /// List project collaborators
  record list-collaborators-params {
    /// The unique identifier of the project.
    project-id: string,
    /// Filters the collaborators by their affiliation. `outside` means outside collaborators of a project that are not a member of the project's organization. `direct` means collaborators with permissions to a project, regardless of organization membership status. `all` means all collaborators the authenticated user can see.
    affiliation: option<list-collaborators-affiliation-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-collaborators: func(params: list-collaborators-params) -> result<list<simple-user>, list-collaborators-error>;

  /// Add project collaborator
  record add-collaborator-params {
    /// The unique identifier of the project.
    project-id: string,
    /// The handle for the GitHub user account.
    username: string,
    /// The permission to grant the collaborator.
    permission: option<add-collaborator-body-permission-enum>
  }
  add-collaborator: func(params: add-collaborator-params) -> result<string, add-collaborator-error>;

  /// Remove user as a collaborator
  record remove-collaborator-params {
    /// The unique identifier of the project.
    project-id: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-collaborator: func(params: remove-collaborator-params) -> result<string, remove-collaborator-error>;

  /// Get project permission for a user
  record get-permission-for-user-params {
    /// The unique identifier of the project.
    project-id: string,
    /// The handle for the GitHub user account.
    username: string
  }
  get-permission-for-user: func(params: get-permission-for-user-params) -> result<project-collaborator-permission, get-permission-for-user-error>;

  /// List project columns
  record list-columns-params {
    /// The unique identifier of the project.
    project-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-columns: func(params: list-columns-params) -> result<list<project-column>, list-columns-error>;

  /// Create a project column
  record create-column-params {
    /// The unique identifier of the project.
    project-id: string,
    /// Name of the project column
    name: string
  }
  create-column: func(params: create-column-params) -> result<project-column, create-column-error>;

  /// List repository projects
  record list-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Indicates the state of the projects to return.
    state: option<list-for-org-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-repo: func(params: list-for-repo-params) -> result<list<project>, list-for-repo-error>;

  /// Create a repository project
  record create-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The description of the project.
    body: option<string>,
    /// The name of the project.
    name: string
  }
  create-for-repo: func(params: create-for-repo-params) -> result<project, create-for-repo-error>;

  /// Create a user project
  record create-for-authenticated-user-params {
    /// Body of the project
    body: option<string>,
    /// Name of the project
    name: string
  }
  create-for-authenticated-user: func(params: create-for-authenticated-user-params) -> result<project, create-for-authenticated-user-error>;

  /// List user projects
  record list-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// Indicates the state of the projects to return.
    state: option<list-for-org-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-user: func(params: list-for-user-params) -> result<list<project>, list-for-user-error>;

}

interface repos {
  enum list-for-org-type-op-enum {
    all,
    public,
    private,
    forks,
    sources,
    member,
  }

  enum list-for-org-sort-enum {
    created,
    updated,
    pushed,
    full-name,
  }

  enum list-for-org-direction-enum {
    asc,
    desc,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum create-in-org-body-merge-commit-message-enum {
    pr-body,
    pr-title,
