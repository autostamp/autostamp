  /// List organizations
  record list-op-params {
    /// An organization ID. Only return organizations with an ID greater than this ID.
    since: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list<organization-simple>, list-op-error>;

  /// Get an organization
  record get-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get: func(params: get-params) -> result<organization-full, get-error>;

  /// Update an organization
  record update-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Whether GitHub Advanced Security is automatically enabled for new repositories.
    /// 
    advanced-security-enabled-for-new-repositories: option<bool>,
    /// Billing email address. This address is not publicized.
    billing-email: option<string>,
    blog: option<string>,
    /// The company name.
    company: option<string>,
    /// Default permission level members have for organization repositories.
    default-repository-permission: option<update-body-default-repository-permission-enum>,
    /// Whether Dependabot alerts is automatically enabled for new repositories.
    /// 
    dependabot-alerts-enabled-for-new-repositories: option<bool>,
    /// Whether Dependabot security updates is automatically enabled for new repositories.
    /// 
    dependabot-security-updates-enabled-for-new-repositories: option<bool>,
    /// Whether dependency graph is automatically enabled for new repositories.
    /// 
    dependency-graph-enabled-for-new-repositories: option<bool>,
    /// The description of the company.
    description: option<string>,
    /// The publicly visible email address.
    email: option<string>,
    /// Whether an organization can use organization projects.
    has-organization-projects: option<bool>,
    /// Whether repositories that belong to the organization can use repository projects.
    has-repository-projects: option<bool>,
    /// The location.
    location: option<string>,
    /// Specifies which types of repositories non-admin organization members can create. `private` is only available to repositories that are part of an organization on GitHub Enterprise Cloud. 
    /// **Note:** This parameter is deprecated and will be removed in the future. Its return value ignores internal repositories. Using this parameter overrides values set in `members_can_create_repositories`. See the parameter deprecation notice in the operation description for details.
    members-allowed-repository-creation-type: option<update-body-members-allowed-repository-creation-type-enum>,
    /// Whether organization members can create internal repositories, which are visible to all enterprise members. You can only allow members to create internal repositories if your organization is associated with an enterprise account using GitHub Enterprise Cloud or GitHub Enterprise Server 2.20+. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-internal-repositories: option<bool>,
    /// Whether organization members can create GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-pages: option<bool>,
    /// Whether organization members can create private GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-private-pages: option<bool>,
    /// Whether organization members can create private repositories, which are visible to organization members with permission. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-private-repositories: option<bool>,
    /// Whether organization members can create public GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-public-pages: option<bool>,
    /// Whether organization members can create public repositories, which are visible to anyone. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-public-repositories: option<bool>,
    /// Whether of non-admin organization members can create repositories. **Note:** A parameter can override this parameter. See `members_allowed_repository_creation_type` in this table for details.
    members-can-create-repositories: option<bool>,
    /// Whether organization members can fork private organization repositories.
    members-can-fork-private-repositories: option<bool>,
    /// The shorthand name of the company.
    name: option<string>,
    /// Whether secret scanning is automatically enabled for new repositories.
    /// 
    secret-scanning-enabled-for-new-repositories: option<bool>,
    /// If `secret_scanning_push_protection_custom_link_enabled` is true, the URL that will be displayed to contributors who are blocked from pushing a secret.
    secret-scanning-push-protection-custom-link: option<string>,
    /// Whether a custom link is shown to contributors who are blocked from pushing a secret by push protection.
    secret-scanning-push-protection-custom-link-enabled: option<bool>,
    /// Whether secret scanning push protection is automatically enabled for new repositories.
    /// 
    secret-scanning-push-protection-enabled-for-new-repositories: option<bool>,
    /// The Twitter username of the company.
    twitter-username: option<string>,
    /// Whether contributors to organization repositories are required to sign off on commits they make through GitHub's web interface.
    web-commit-signoff-required: option<bool>
  }
  update: func(params: update-params) -> result<organization-full, update-error>;

  /// List users blocked by an organization
  record list-blocked-users-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-blocked-users: func(params: list-blocked-users-params) -> result<list<simple-user>, string>;

  /// Check if a user is blocked by an organization
  record check-blocked-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  check-blocked-user: func(params: check-blocked-user-params) -> result<string, check-blocked-user-error>;

  /// Block a user from an organization
  record block-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  block-user: func(params: block-user-params) -> result<string, block-user-error>;

  /// Unblock a user from an organization
  record unblock-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  unblock-user: func(params: unblock-user-params) -> result<string, string>;

  /// List failed organization invitations
  record list-failed-invitations-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-failed-invitations: func(params: list-failed-invitations-params) -> result<list<organization-invitation>, list-failed-invitations-error>;

  /// List organization webhooks
  record list-webhooks-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-webhooks: func(params: list-webhooks-params) -> result<list<org-hook>, list-webhooks-error>;

  /// Create an organization webhook
  record create-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Determines if notifications are sent when the webhook is triggered. Set to `true` to send notifications.
    active: option<bool>,
    /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#create-hook-config-params).
    config: create-webhook-body-config,
    /// Determines what [events](https://docs.github.com/webhooks/event-payloads) the hook is triggered for. Set to `["*"]` to receive all possible events.
    events: option<list<string>>,
    /// Must be passed as "web".
    name: string
  }
  create-webhook: func(params: create-webhook-params) -> result<org-hook, create-webhook-error>;

  /// Get an organization webhook
  record get-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string
  }
  get-webhook: func(params: get-webhook-params) -> result<org-hook, get-webhook-error>;

  /// Update an organization webhook
  record update-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    /// Determines if notifications are sent when the webhook is triggered. Set to `true` to send notifications.
    active: option<bool>,
    /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#update-hook-config-params).
    config: option<update-webhook-body-config>,
    /// Determines what [events](https://docs.github.com/webhooks/event-payloads) the hook is triggered for.
    events: option<list<string>>,
    name: option<string>
  }
  update-webhook: func(params: update-webhook-params) -> result<org-hook, update-webhook-error>;

  /// Delete an organization webhook
  record delete-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string
  }
  delete-webhook: func(params: delete-webhook-params) -> result<string, delete-webhook-error>;

  /// Get a webhook configuration for an organization
  record get-webhook-config-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string
  }
  get-webhook-config-for-org: func(params: get-webhook-config-for-org-params) -> result<webhook-config, string>;

  /// Update a webhook configuration for an organization
  record update-webhook-config-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    content-type: option<string>,
    insecure-ssl: option<string>,
    secret: option<string>,
    url: option<string>
  }
  update-webhook-config-for-org: func(params: update-webhook-config-for-org-params) -> result<webhook-config, string>;

  /// List deliveries for an organization webhook
  record list-webhook-deliveries-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Used for pagination: the starting delivery from which the page of deliveries is fetched. Refer to the `link` header for the next and previous page cursors.
    cursor: option<string>,
    redelivery: option<bool>
  }
  list-webhook-deliveries: func(params: list-webhook-deliveries-params) -> result<list<hook-delivery-item>, list-webhook-deliveries-error>;

  /// Get a webhook delivery for an organization webhook
  record get-webhook-delivery-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    delivery-id: string
  }
  get-webhook-delivery: func(params: get-webhook-delivery-params) -> result<hook-delivery, get-webhook-delivery-error>;

  /// Redeliver a delivery for an organization webhook
  record redeliver-webhook-delivery-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    delivery-id: string
  }
  redeliver-webhook-delivery: func(params: redeliver-webhook-delivery-params) -> result<list<redeliver-webhook-delivery-response-entry>, redeliver-webhook-delivery-error>;

  /// Ping an organization webhook
  record ping-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string
  }
  ping-webhook: func(params: ping-webhook-params) -> result<string, ping-webhook-error>;

  /// List app installations for an organization
  record list-app-installations-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-app-installations: func(params: list-app-installations-params) -> result<list-app-installations-response, string>;

  /// List pending organization invitations
  record list-pending-invitations-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Filter invitations by their member role.
    role: option<list-pending-invitations-role-enum>,
    /// Filter invitations by their invitation source.
    invitation-source: option<list-pending-invitations-invitation-source-enum>
  }
  list-pending-invitations: func(params: list-pending-invitations-params) -> result<list<organization-invitation>, list-pending-invitations-error>;

  /// Create an organization invitation
  record create-invitation-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// **Required unless you provide `invitee_id`**. Email address of the person you are inviting, which can be an existing GitHub user.
    email: option<string>,
    /// **Required unless you provide `email`**. GitHub user ID for the person you are inviting.
    invitee-id: option<s32>,
    /// The role for the new member. 
    ///  * `admin` - Organization owners with full administrative rights to the organization and complete access to all repositories and teams.  
    role: option<create-invitation-body-role-enum>,
    /// Specify IDs for the teams you want to invite new members to.
    team-ids: option<list<s32>>
  }
  create-invitation: func(params: create-invitation-params) -> result<organization-invitation, create-invitation-error>;

  /// Cancel an organization invitation
  record cancel-invitation-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the invitation.
    invitation-id: string
  }
  cancel-invitation: func(params: cancel-invitation-params) -> result<string, cancel-invitation-error>;

  /// List organization invitation teams
  record list-invitation-teams-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the invitation.
    invitation-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-invitation-teams: func(params: list-invitation-teams-params) -> result<list<team>, list-invitation-teams-error>;

  /// List organization members
  record list-members-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Filter members returned in the list. `2fa_disabled` means that only members without [two-factor authentication](https://github.com/blog/1614-two-factor-authentication) enabled will be returned. This options is only available for organization owners.
    filter: option<list-members-filter-enum>,
    /// Filter members returned by their role.
    role: option<list-members-role-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-members: func(params: list-members-params) -> result<list<simple-user>, list-members-error>;

  /// Check organization membership for a user
  record check-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  check-membership-for-user: func(params: check-membership-for-user-params) -> result<string, check-membership-for-user-error>;

  /// Remove an organization member
  record remove-member-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-member: func(params: remove-member-params) -> result<string, remove-member-error>;

  /// Get organization membership for a user
  record get-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  get-membership-for-user: func(params: get-membership-for-user-params) -> result<org-membership, get-membership-for-user-error>;

  /// Set organization membership for a user
  record set-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string,
    /// The role to give the user in the organization. Can be one of:  
    ///  * `admin` - The user will become an owner of the organization.  
    role: option<set-membership-for-user-body-role-enum>
  }
  set-membership-for-user: func(params: set-membership-for-user-params) -> result<org-membership, set-membership-for-user-error>;

  /// Remove organization membership for a user
  record remove-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-membership-for-user: func(params: remove-membership-for-user-params) -> result<string, remove-membership-for-user-error>;

  /// List outside collaborators for an organization
  record list-outside-collaborators-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Filter the list of outside collaborators. `2fa_disabled` means that only outside collaborators without [two-factor authentication](https://github.com/blog/1614-two-factor-authentication) enabled will be returned.
    filter: option<list-members-filter-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-outside-collaborators: func(params: list-outside-collaborators-params) -> result<list<simple-user>, string>;

  /// Convert an organization member to outside collaborator
  record convert-member-to-outside-collaborator-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string,
    /// When set to `true`, the request will be performed asynchronously. Returns a 202 status code when the job is successfully queued.
    async-op: option<bool>
  }
  convert-member-to-outside-collaborator: func(params: convert-member-to-outside-collaborator-params) -> result<convert-member-to-outside-collaborator-response, convert-member-to-outside-collaborator-error>;

  /// Remove outside collaborator from an organization
  record remove-outside-collaborator-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-outside-collaborator: func(params: remove-outside-collaborator-params) -> result<string, remove-outside-collaborator-error>;

  /// List public organization members
  record list-public-members-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-members: func(params: list-public-members-params) -> result<list<simple-user>, string>;

  /// Check public organization membership for a user
  record check-public-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  check-public-membership-for-user: func(params: check-public-membership-for-user-params) -> result<string, check-public-membership-for-user-error>;

  /// Set public organization membership for the authenticated user
  record set-public-membership-for-authenticated-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  set-public-membership-for-authenticated-user: func(params: set-public-membership-for-authenticated-user-params) -> result<string, set-public-membership-for-authenticated-user-error>;

  /// Remove public organization membership for the authenticated user
  record remove-public-membership-for-authenticated-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-public-membership-for-authenticated-user: func(params: remove-public-membership-for-authenticated-user-params) -> result<string, string>;

  /// List security manager teams
  record list-security-manager-teams-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  list-security-manager-teams: func(params: list-security-manager-teams-params) -> result<list<team-simple>, string>;

  /// Add a security manager team
  record add-security-manager-team-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string
  }
  add-security-manager-team: func(params: add-security-manager-team-params) -> result<string, add-security-manager-team-error>;

  /// Remove a security manager team
  record remove-security-manager-team-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string
  }
  remove-security-manager-team: func(params: remove-security-manager-team-params) -> result<string, string>;

  /// Enable or disable a security feature for an organization
  record enable-or-disable-security-product-on-all-org-repos-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The security feature to enable or disable.
    security-product: string,
    /// The action to take.
    /// 
    enablement: string
  }
  enable-or-disable-security-product-on-all-org-repos: func(params: enable-or-disable-security-product-on-all-org-repos-params) -> result<string, enable-or-disable-security-product-on-all-org-repos-error>;

  /// List organization memberships for the authenticated user
  record list-memberships-for-authenticated-user-params {
    /// Indicates the state of the memberships to return. If not specified, the API returns both active and pending memberships.
    state: option<org-membership-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-memberships-for-authenticated-user: func(params: list-memberships-for-authenticated-user-params) -> result<list<org-membership>, list-memberships-for-authenticated-user-error>;

  /// Get an organization membership for the authenticated user
  record get-membership-for-authenticated-user-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-membership-for-authenticated-user: func(params: get-membership-for-authenticated-user-params) -> result<org-membership, get-membership-for-authenticated-user-error>;

  /// Update an organization membership for the authenticated user
  record update-membership-for-authenticated-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The state that the membership should be in. Only `"active"` will be accepted.
    state: update-membership-for-authenticated-user-body-state-enum
  }
  update-membership-for-authenticated-user: func(params: update-membership-for-authenticated-user-params) -> result<org-membership, update-membership-for-authenticated-user-error>;

  /// List organizations for the authenticated user
  record list-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<list<organization-simple>, list-for-authenticated-user-error>;

  /// List organizations for a user
  record list-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-user: func(params: list-for-user-params) -> result<list<organization-simple>, string>;

}

interface actions {
  enum allowed-actions {
    all,
    local-only,
    selected,
  }

  enum enabled-repositories {
    all,
    none,
    selected,
  }

  enum repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  enum default-workflow-permissions {
    read,
    write,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum required-workflow-scope-enum {
    all,
    selected,
  }

  enum required-workflow-state-enum {
    active,
    deleted,
  }

  enum create-required-workflow-body-scope-enum {
    selected,
    all,
  }

  enum runner-label-type-op-enum {
    read-only,
    custom,
  }

  enum organization-actions-secret-visibility-enum {
    all,
    private,
    selected,
  }

  enum get-actions-cache-list-sort-enum {
    created-at,
    last-accessed-at,
    size-in-bytes,
  }

  enum get-actions-cache-list-direction-enum {
    asc,
    desc,
  }

  enum job-conclusion-enum {
    success,
    failure,
    neutral,
    cancelled,
    skipped,
    timed-out,
    action-required,
  }

  enum job-status-enum {
    queued,
    in-progress,
    completed,
  }

  enum workflow-access-to-repository-access-level-enum {
    none,
    user,
    organization,
  }

  enum list-required-workflow-runs-status-enum {
    completed,
    action-required,
    cancelled,
    failure,
    neutral,
    skipped,
    stale,
    success,
    timed-out,
    in-progress,
    queued,
    requested,
    waiting,
    pending,
  }

  enum environment-approvals-state-enum {
    approved,
    rejected,
    pending,
  }

  enum list-jobs-for-workflow-run-filter-enum {
    latest,
    all,
  }

  enum deployment-reviewer-type {
    user,
    team,
  }

  enum review-pending-deployments-for-run-body-state-enum {
    approved,
    rejected,
  }

  enum workflow-state-enum {
    active,
    deleted,
    disabled-fork,
    disabled-inactivity,
    disabled-manually,
  }

  record cache-usage-org-enterprise {
    /// The count of active caches across all repositories of an enterprise or an organization.
    total-active-caches-count: s32,
    /// The total size in bytes of all active cache items across all repositories of an enterprise or an organization.
    total-active-caches-size-in-bytes: s32
  }

  record get-actions-cache-usage-by-repo-for-org-response {
    repository-cache-usages: list<cache-usage-by-repository>,
    total-count: s32
  }

  /// GitHub Actions Cache Usage by repository.
  record cache-usage-by-repository {
    /// The number of active caches in the repository.
    active-caches-count: s32,
    /// The sum of the size in bytes of all the active cache items in the repository.
    active-caches-size-in-bytes: s32,
    /// The repository owner and name for the cache usage being shown.
    full-name: string
  }

  record organization-permissions {
    allowed-actions: option<allowed-actions>,
    enabled-repositories: enabled-repositories,
    selected-actions-url: option<string>,
    /// The API URL to use to get or set the selected repositories that are allowed to run GitHub Actions, when `enabled_repositories` is set to `selected`.
    selected-repositories-url: option<string>
  }

  record list-selected-repositories-enabled-github-actions-organization-response {
    repositories: list<repository>,
    total-count: f64
  }

  /// A repository on GitHub.
  record repository {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow forking this repo
    allow-forking: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is enabled for this repository
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    /// Whether the repository is archived.
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: string,
    /// The default branch of the repository.
    default-branch: string,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    /// Returns whether or not this repository disabled.
    disabled: bool,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: s32,
    forks-count: s32,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: string,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: bool,
    /// Whether issues are enabled.
    has-issues: bool,
    has-pages: bool,
    /// Whether projects are enabled.
    has-projects: bool,
    /// Whether the wiki is enabled.
    has-wiki: bool,
    homepage: string,
    hooks-url: string,
    html-url: string,
    /// Unique identifier of the repository
    id: s32,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: string,
    languages-url: string,
    license: nullable-license-simple,
    master-branch: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: string,
    milestones-url: string,
    mirror-url: string,
    /// The name of the repository.
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: s32,
    open-issues-count: s32,
    organization: option<nullable-simple-user>,
    owner: simple-user,
    permissions: option<repository-permissions>,
    /// Whether the repository is private or public.
    private: bool,
    pulls-url: string,
    pushed-at: string,
    releases-url: string,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: s32,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: string,
    stargazers-count: s32,
    stargazers-url: string,
    starred-at: option<string>,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: string,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    template-repository: option<repository-template-repository>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: string,
    url: string,
    /// Whether a squash merge commit can use the pull request title as default. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The repository visibility: public, private, or internal.
    visibility: option<string>,
    watchers: s32,
    watchers-count: s32,
    /// Whether to require contributors to sign off on web-based commits
    web-commit-signoff-required: option<bool>
  }

  /// License Simple
  record nullable-license-simple {
    html-url: option<string>,
    key: string,
    name: string,
    node-id: string,
    spdx-id: string,
    url: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record repository-permissions {
    admin: bool,
    maintain: option<bool>,
    pull: bool,
    push: bool,
    triage: option<bool>
  }

  record repository-template-repository {
    allow-auto-merge: option<bool>,
    allow-merge-commit: option<bool>,
    allow-rebase-merge: option<bool>,
    allow-squash-merge: option<bool>,
    allow-update-branch: option<bool>,
    archive-url: option<string>,
    archived: option<bool>,
    assignees-url: option<string>,
    blobs-url: option<string>,
    branches-url: option<string>,
    clone-url: option<string>,
    collaborators-url: option<string>,
    comments-url: option<string>,
    commits-url: option<string>,
    compare-url: option<string>,
    contents-url: option<string>,
    contributors-url: option<string>,
    created-at: option<string>,
    default-branch: option<string>,
    delete-branch-on-merge: option<bool>,
    deployments-url: option<string>,
    description: option<string>,
    disabled: option<bool>,
    downloads-url: option<string>,
    events-url: option<string>,
    fork: option<bool>,
    forks-count: option<s32>,
    forks-url: option<string>,
    full-name: option<string>,
    git-commits-url: option<string>,
    git-refs-url: option<string>,
    git-tags-url: option<string>,
    git-url: option<string>,
    has-downloads: option<bool>,
    has-issues: option<bool>,
    has-pages: option<bool>,
    has-projects: option<bool>,
    has-wiki: option<bool>,
    homepage: option<string>,
    hooks-url: option<string>,
    html-url: option<string>,
    id: option<s32>,
    is-template: option<bool>,
    issue-comment-url: option<string>,
    issue-events-url: option<string>,
    issues-url: option<string>,
    keys-url: option<string>,
    labels-url: option<string>,
    language: option<string>,
    languages-url: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: option<string>,
    milestones-url: option<string>,
    mirror-url: option<string>,
    name: option<string>,
    network-count: option<s32>,
    node-id: option<string>,
    notifications-url: option<string>,
    open-issues-count: option<s32>,
    owner: option<repository-template-repository-owner>,
    permissions: option<repository-template-repository-permissions>,
    private: option<bool>,
    pulls-url: option<string>,
    pushed-at: option<string>,
    releases-url: option<string>,
    size: option<s32>,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: option<string>,
    stargazers-count: option<s32>,
    stargazers-url: option<string>,
    statuses-url: option<string>,
    subscribers-count: option<s32>,
    subscribers-url: option<string>,
    subscription-url: option<string>,
    svn-url: option<string>,
    tags-url: option<string>,
    teams-url: option<string>,
    temp-clone-token: option<string>,
    topics: option<list<string>>,
    trees-url: option<string>,
    updated-at: option<string>,
    url: option<string>,
    use-squash-pr-title-as-default: option<bool>,
    visibility: option<string>,
    watchers-count: option<s32>
  }

  record repository-template-repository-owner {
    avatar-url: option<string>,
    events-url: option<string>,
    followers-url: option<string>,
    following-url: option<string>,
    gists-url: option<string>,
    gravatar-id: option<string>,
    html-url: option<string>,
    id: option<s32>,
    login: option<string>,
    node-id: option<string>,
    organizations-url: option<string>,
    received-events-url: option<string>,
    repos-url: option<string>,
    site-admin: option<bool>,
    starred-url: option<string>,
    subscriptions-url: option<string>,
    type-op: option<string>,
    url: option<string>
  }

  record repository-template-repository-permissions {
    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  record selected-actions {
    /// Whether GitHub-owned actions are allowed. For example, this includes the actions in the `actions` organization.
    github-owned-allowed: option<bool>,
    /// Specifies a list of string-matching patterns to allow specific action(s) and reusable workflow(s). Wildcards, tags, and SHAs are allowed. For example, `monalisa/octocat@*`, `monalisa/octocat@v2`, `monalisa/*`.
    /// 
    patterns-allowed: option<list<string>>,
