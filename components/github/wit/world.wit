package autostamp:github@0.3.0;

interface meta {
  /// GitHub API Root
  root: func() -> result<string, string>;

  /// Get GitHub meta information
  get: func() -> result<string, string>;

  /// Get Octocat
  record get-octocat-params {
    /// The words to show in Octocat's speech bubble
    s: option<string>
  }
  get-octocat: func(params: get-octocat-params) -> result<string, string>;

  /// Get all API versions
  get-all-versions: func() -> result<string, string>;

  /// Get the Zen of GitHub
  get-zen: func() -> result<string, string>;

}


interface apps {
  enum app-permissions-actions-enum {
    read,
    write,
  }

  enum app-permissions-organization-plan-enum {
    read,
  }

  enum app-permissions-organization-projects-enum {
    read,
    write,
    admin,
  }

  enum app-permissions-workflows-enum {
    write,
  }

  enum list-accounts-for-plan-sort-enum {
    created,
    updated,
  }

  enum list-accounts-for-plan-direction-enum {
    asc,
    desc,
  }

  /// The media type used to serialize the payloads. Supported values include `json` and `form`. The default is `form`.
  record webhook-config-content-type {
    /// opaque schema; raw JSON
    value: string
  }

  record webhook-config-insecure-ssl {
    /// opaque schema; raw JSON
    value: string
  }

  /// If provided, the `secret` will be used as the `key` to generate the HMAC hex digest value for [delivery signature headers](https://docs.github.com/webhooks/event-payloads/#delivery-headers).
  record webhook-config-secret {
    /// opaque schema; raw JSON
    value: string
  }

  /// The URL to which the payloads will be delivered.
  record webhook-config-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// The permissions granted to the user-to-server access token.
  record app-permissions {
    /// The level of permission to grant the access token for GitHub Actions workflows, workflow runs, and artifacts.
    actions: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for repository creation, deletion, settings, teams, and collaborators creation.
    administration: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for checks on code.
    checks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for repository contents, commits, branches, downloads, releases, and merges.
    contents: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for deployments and deployment statuses.
    deployments: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for managing repository environments.
    environments: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for issues and related comments, assignees, labels, and milestones.
    issues: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for organization teams and members.
    members: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to search repositories, list collaborators, and access repository metadata.
    metadata: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage access to an organization.
    organization-administration: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage announcement banners for an organization.
    organization-announcement-banners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for custom repository roles management. This property is in beta and is subject to change.
    organization-custom-roles: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage the post-receive hooks for an organization.
    organization-hooks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for organization packages published to GitHub Packages.
    organization-packages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for viewing an organization's plan.
    organization-plan: option<app-permissions-organization-plan-enum>,
    /// The level of permission to grant the access token to manage organization projects and projects beta (where available).
    organization-projects: option<app-permissions-organization-projects-enum>,
    /// The level of permission to grant the access token to manage organization secrets.
    organization-secrets: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage GitHub Actions self-hosted runners available to an organization.
    organization-self-hosted-runners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage users blocked by the organization.
    organization-user-blocking: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for packages published to GitHub Packages.
    packages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to retrieve Pages statuses, configuration, and builds, as well as create new builds.
    pages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for pull requests and related comments, assignees, labels, milestones, and merges.
    pull-requests: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage announcement banners for a repository.
    repository-announcement-banners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage the post-receive hooks for a repository.
    repository-hooks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage repository projects, columns, and cards.
    repository-projects: option<app-permissions-organization-projects-enum>,
    /// The level of permission to grant the access token to view and manage secret scanning alerts.
    secret-scanning-alerts: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage repository secrets.
    secrets: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage security events like code scanning alerts.
    security-events: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage just a single file.
    single-file: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for commit statuses.
    statuses: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage team discussions and related comments.
    team-discussions: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage Dependabot alerts.
    vulnerability-alerts: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to update GitHub Actions workflow files.
    workflows: option<app-permissions-workflows-enum>
  }

  /// Get the authenticated app
  get-authenticated: func() -> result<string, string>;

  /// Create a GitHub App from a manifest
  record create-from-manifest-params {
    code: string
  }
  create-from-manifest: func(params: create-from-manifest-params) -> result<string, string>;

  /// Get a webhook configuration for an app
  get-webhook-config-for-app: func() -> result<string, string>;

  /// Update a webhook configuration for an app
  record update-webhook-config-for-app-params {
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    secret: option<webhook-config-secret>,
    url: option<webhook-config-url>
  }
  update-webhook-config-for-app: func(params: update-webhook-config-for-app-params) -> result<string, string>;

  /// List deliveries for an app webhook
  record list-webhook-deliveries-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Used for pagination: the starting delivery from which the page of deliveries is fetched. Refer to the `link` header for the next and previous page cursors.
    cursor: option<string>,
    redelivery: option<bool>
  }
  list-webhook-deliveries: func(params: list-webhook-deliveries-params) -> result<string, string>;

  /// Get a delivery for an app webhook
  record get-webhook-delivery-params {
    delivery-id: string
  }
  get-webhook-delivery: func(params: get-webhook-delivery-params) -> result<string, string>;

  /// Redeliver a delivery for an app webhook
  record redeliver-webhook-delivery-params {
    delivery-id: string
  }
  redeliver-webhook-delivery: func(params: redeliver-webhook-delivery-params) -> result<string, string>;

  /// List installations for the authenticated app
  record list-installations-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    outdated: option<string>
  }
  list-installations: func(params: list-installations-params) -> result<string, string>;

  /// Get an installation for the authenticated app
  record get-installation-params {
    /// The unique identifier of the installation.
    installation-id: string
  }
  get-installation: func(params: get-installation-params) -> result<string, string>;

  /// Delete an installation for the authenticated app
  record delete-installation-params {
    /// The unique identifier of the installation.
    installation-id: string
  }
  delete-installation: func(params: delete-installation-params) -> result<string, string>;

  /// Create an installation access token for an app
  record create-installation-access-token-params {
    /// The unique identifier of the installation.
    installation-id: string,
    permissions: option<app-permissions>,
    /// List of repository names that the token should have access to
    repositories: option<list<string>>,
    /// List of repository IDs that the token should have access to
    repository-ids: option<list<s32>>
  }
  create-installation-access-token: func(params: create-installation-access-token-params) -> result<string, string>;

  /// Suspend an app installation
  record suspend-installation-params {
    /// The unique identifier of the installation.
    installation-id: string
  }
  suspend-installation: func(params: suspend-installation-params) -> result<string, string>;

  /// Unsuspend an app installation
  record unsuspend-installation-params {
    /// The unique identifier of the installation.
    installation-id: string
  }
  unsuspend-installation: func(params: unsuspend-installation-params) -> result<string, string>;

  /// Delete an app authorization
  record delete-authorization-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The OAuth access token used to authenticate to the GitHub API.
    access-token: string
  }
  delete-authorization: func(params: delete-authorization-params) -> result<string, string>;

  /// Check a token
  record check-token-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The access_token of the OAuth application.
    access-token: string
  }
  check-token: func(params: check-token-params) -> result<string, string>;

  /// Reset a token
  record reset-token-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The access_token of the OAuth application.
    access-token: string
  }
  reset-token: func(params: reset-token-params) -> result<string, string>;

  /// Delete an app token
  record delete-token-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The OAuth access token used to authenticate to the GitHub API.
    access-token: string
  }
  delete-token: func(params: delete-token-params) -> result<string, string>;

  /// Create a scoped access token
  record scope-token-params {
    /// The client ID of the GitHub app.
    client-id: string,
    /// The access token used to authenticate to the GitHub API.
    access-token: string,
    permissions: option<app-permissions>,
    /// The list of repository names to scope the user-to-server access token to. `repositories` may not be specified if `repository_ids` is specified.
    repositories: option<list<string>>,
    /// The list of repository IDs to scope the user-to-server access token to. `repository_ids` may not be specified if `repositories` is specified.
    repository-ids: option<list<s32>>,
    /// The name of the user or organization to scope the user-to-server access token to. **Required** unless `target_id` is specified.
    target: option<string>,
    /// The ID of the user or organization to scope the user-to-server access token to. **Required** unless `target` is specified.
    target-id: option<s32>
  }
  scope-token: func(params: scope-token-params) -> result<string, string>;

  /// Get an app
  record get-by-slug-params {
    app-slug: string
  }
  get-by-slug: func(params: get-by-slug-params) -> result<string, string>;

  /// List repositories accessible to the app installation
  record list-repos-accessible-to-installation-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-accessible-to-installation: func(params: list-repos-accessible-to-installation-params) -> result<string, string>;

  /// Revoke an installation access token
  revoke-installation-access-token: func() -> result<string, string>;

  /// Get a subscription plan for an account
  record get-subscription-plan-for-account-params {
    /// account_id parameter
    account-id: string
  }
  get-subscription-plan-for-account: func(params: get-subscription-plan-for-account-params) -> result<string, string>;

  /// List plans
  record list-plans-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-plans: func(params: list-plans-params) -> result<string, string>;

  /// List accounts for a plan
  record list-accounts-for-plan-params {
    /// The unique identifier of the plan.
    plan-id: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-accounts-for-plan-sort-enum>,
    /// To return the oldest accounts first, set to `asc`. Ignored without the `sort` parameter.
    direction: option<list-accounts-for-plan-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-accounts-for-plan: func(params: list-accounts-for-plan-params) -> result<string, string>;

  /// Get a subscription plan for an account (stubbed)
  record get-subscription-plan-for-account-stubbed-params {
    /// account_id parameter
    account-id: string
  }
  get-subscription-plan-for-account-stubbed: func(params: get-subscription-plan-for-account-stubbed-params) -> result<string, string>;

  /// List plans (stubbed)
  record list-plans-stubbed-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-plans-stubbed: func(params: list-plans-stubbed-params) -> result<string, string>;

  /// List accounts for a plan (stubbed)
  record list-accounts-for-plan-stubbed-params {
    /// The unique identifier of the plan.
    plan-id: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-accounts-for-plan-sort-enum>,
    /// To return the oldest accounts first, set to `asc`. Ignored without the `sort` parameter.
    direction: option<list-accounts-for-plan-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-accounts-for-plan-stubbed: func(params: list-accounts-for-plan-stubbed-params) -> result<string, string>;

  /// Get an organization installation for the authenticated app
  record get-org-installation-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-org-installation: func(params: get-org-installation-params) -> result<string, string>;

  /// Get a repository installation for the authenticated app
  record get-repo-installation-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-repo-installation: func(params: get-repo-installation-params) -> result<string, string>;

  /// List app installations accessible to the user access token
  record list-installations-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-installations-for-authenticated-user: func(params: list-installations-for-authenticated-user-params) -> result<string, string>;

  /// List repositories accessible to the user access token
  record list-installation-repos-for-authenticated-user-params {
    /// The unique identifier of the installation.
    installation-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-installation-repos-for-authenticated-user: func(params: list-installation-repos-for-authenticated-user-params) -> result<string, string>;

  /// Add a repository to an app installation
  record add-repo-to-installation-for-authenticated-user-params {
    /// The unique identifier of the installation.
    installation-id: string,
    /// The unique identifier of the repository.
    repository-id: string
  }
  add-repo-to-installation-for-authenticated-user: func(params: add-repo-to-installation-for-authenticated-user-params) -> result<string, string>;

  /// Remove a repository from an app installation
  record remove-repo-from-installation-for-authenticated-user-params {
    /// The unique identifier of the installation.
    installation-id: string,
    /// The unique identifier of the repository.
    repository-id: string
  }
  remove-repo-from-installation-for-authenticated-user: func(params: remove-repo-from-installation-for-authenticated-user-params) -> result<string, string>;

  /// List subscriptions for the authenticated user
  record list-subscriptions-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-subscriptions-for-authenticated-user: func(params: list-subscriptions-for-authenticated-user-params) -> result<string, string>;

  /// List subscriptions for the authenticated user (stubbed)
  record list-subscriptions-for-authenticated-user-stubbed-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-subscriptions-for-authenticated-user-stubbed: func(params: list-subscriptions-for-authenticated-user-stubbed-params) -> result<string, string>;

  /// Get a user installation for the authenticated app
  record get-user-installation-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-user-installation: func(params: get-user-installation-params) -> result<string, string>;

}

interface codes-of-conduct {
  /// Get all codes of conduct
  get-all-codes-of-conduct: func() -> result<string, string>;

  /// Get a code of conduct
  record get-conduct-code-params {
    key: string
  }
  get-conduct-code: func(params: get-conduct-code-params) -> result<string, string>;

}

interface emojis {
  /// Get emojis
  get: func() -> result<string, string>;

}

interface dependabot {
  enum list-alerts-for-enterprise-scope-enum {
    development,
    runtime,
  }

  enum list-alerts-for-enterprise-sort-enum {
    created,
    updated,
  }

  enum list-alerts-for-enterprise-direction-enum {
    asc,
    desc,
  }

  enum create-or-update-org-secret-body-visibility-enum {
    all,
    private,
    selected,
  }

  enum update-alert-body-dismissed-reason-enum {
    fix-started,
    inaccurate,
    no-bandwidth,
    not-used,
    tolerable-risk,
  }

  enum update-alert-body-state-enum {
    dismissed,
    open,
  }

  /// List Dependabot alerts for an enterprise
  record list-alerts-for-enterprise-params {
    /// The slug version of the enterprise name. You can also substitute this value with the enterprise id.
    enterprise: string,
    /// A comma-separated list of states. If specified, only alerts with these states will be returned.
    /// 
    state: option<string>,
    /// A comma-separated list of severities. If specified, only alerts with these severities will be returned.
    /// 
    severity: option<string>,
    /// A comma-separated list of ecosystems. If specified, only alerts for these ecosystems will be returned.
    /// 
    ecosystem: option<string>,
    /// A comma-separated list of package names. If specified, only alerts for these packages will be returned.
    package-op: option<string>,
    /// The scope of the vulnerable dependency. If specified, only alerts with this scope will be returned.
    scope: option<list-alerts-for-enterprise-scope-enum>,
    /// The property by which to sort the results.
    /// `created` means when the alert was created.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results before this cursor.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results after this cursor.
    after: option<string>,
    /// **Deprecated**. The number of results per page (max 100), starting from the first matching result.
    /// This parameter must not be used in combination with `last`.
    first: option<s32>,
    /// **Deprecated**. The number of results per page (max 100), starting from the last matching result.
    /// This parameter must not be used in combination with `first`.
    last: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-alerts-for-enterprise: func(params: list-alerts-for-enterprise-params) -> result<string, string>;

  /// List Dependabot alerts for an organization
  record list-alerts-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// A comma-separated list of states. If specified, only alerts with these states will be returned.
    /// 
    state: option<string>,
    /// A comma-separated list of severities. If specified, only alerts with these severities will be returned.
    /// 
    severity: option<string>,
    /// A comma-separated list of ecosystems. If specified, only alerts for these ecosystems will be returned.
    /// 
    ecosystem: option<string>,
    /// A comma-separated list of package names. If specified, only alerts for these packages will be returned.
    package-op: option<string>,
    /// The scope of the vulnerable dependency. If specified, only alerts with this scope will be returned.
    scope: option<list-alerts-for-enterprise-scope-enum>,
    /// The property by which to sort the results.
    /// `created` means when the alert was created.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results before this cursor.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results after this cursor.
    after: option<string>,
    /// **Deprecated**. The number of results per page (max 100), starting from the first matching result.
    /// This parameter must not be used in combination with `last`.
    first: option<s32>,
    /// **Deprecated**. The number of results per page (max 100), starting from the last matching result.
    /// This parameter must not be used in combination with `first`.
    last: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-alerts-for-org: func(params: list-alerts-for-org-params) -> result<string, string>;

  /// List organization secrets
  record list-org-secrets-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-org-secrets: func(params: list-org-secrets-params) -> result<string, string>;

  /// Get an organization public key
  record get-org-public-key-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-org-public-key: func(params: get-org-public-key-params) -> result<string, string>;

  /// Get an organization secret
  record get-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string
  }
  get-org-secret: func(params: get-org-secret-params) -> result<string, string>;

  /// Create or update an organization secret
  record create-or-update-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an organization public key](https://docs.github.com/rest/reference/dependabot#get-an-organization-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>,
    /// An array of repository ids that can access the organization secret. You can only provide a list of repository ids when the `visibility` is set to `selected`. You can manage the list of selected repositories using the [List selected repositories for an organization secret](https://docs.github.com/rest/reference/dependabot#list-selected-repositories-for-an-organization-secret), [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/dependabot#set-selected-repositories-for-an-organization-secret), and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/dependabot#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: option<list<string>>,
    /// Which type of organization repositories have access to the organization secret. `selected` means only the repositories specified by `selected_repository_ids` can access the secret.
    visibility: create-or-update-org-secret-body-visibility-enum
  }
  create-or-update-org-secret: func(params: create-or-update-org-secret-params) -> result<string, string>;

  /// Delete an organization secret
  record delete-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string
  }
  delete-org-secret: func(params: delete-org-secret-params) -> result<string, string>;

  /// List selected repositories for an organization secret
  record list-selected-repos-for-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-selected-repos-for-org-secret: func(params: list-selected-repos-for-org-secret-params) -> result<string, string>;

  /// Set selected repositories for an organization secret
  record set-selected-repos-for-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    /// An array of repository ids that can access the organization secret. You can only provide a list of repository ids when the `visibility` is set to `selected`. You can add and remove individual repositories using the [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/dependabot#set-selected-repositories-for-an-organization-secret) and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/dependabot#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: list<s32>
  }
  set-selected-repos-for-org-secret: func(params: set-selected-repos-for-org-secret-params) -> result<string, string>;

  /// Add selected repository to an organization secret
  record add-selected-repo-to-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  add-selected-repo-to-org-secret: func(params: add-selected-repo-to-org-secret-params) -> result<string, string>;

  /// Remove selected repository from an organization secret
  record remove-selected-repo-from-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  remove-selected-repo-from-org-secret: func(params: remove-selected-repo-from-org-secret-params) -> result<string, string>;

  /// List Dependabot alerts for a repository
  record list-alerts-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// A comma-separated list of states. If specified, only alerts with these states will be returned.
    /// 
    state: option<string>,
    /// A comma-separated list of severities. If specified, only alerts with these severities will be returned.
    /// 
    severity: option<string>,
    /// A comma-separated list of ecosystems. If specified, only alerts for these ecosystems will be returned.
    /// 
    ecosystem: option<string>,
    /// A comma-separated list of package names. If specified, only alerts for these packages will be returned.
    package-op: option<string>,
    /// A comma-separated list of full manifest paths. If specified, only alerts for these manifests will be returned.
    manifest: option<string>,
    /// The scope of the vulnerable dependency. If specified, only alerts with this scope will be returned.
    scope: option<list-alerts-for-enterprise-scope-enum>,
    /// The property by which to sort the results.
    /// `created` means when the alert was created.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// **Deprecated**. Page number of the results to fetch. Use cursor-based pagination with `before` or `after` instead.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results before this cursor.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results after this cursor.
    after: option<string>,
    /// **Deprecated**. The number of results per page (max 100), starting from the first matching result.
    /// This parameter must not be used in combination with `last`.
    first: option<s32>,
    /// **Deprecated**. The number of results per page (max 100), starting from the last matching result.
    /// This parameter must not be used in combination with `first`.
    last: option<s32>
  }
  list-alerts-for-repo: func(params: list-alerts-for-repo-params) -> result<string, string>;

  /// Get a Dependabot alert
  record get-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies a Dependabot alert in its repository.
    /// You can find this at the end of the URL for a Dependabot alert within GitHub,
    alert-number: string
  }
  get-alert: func(params: get-alert-params) -> result<string, string>;

  /// Update a Dependabot alert
  record update-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies a Dependabot alert in its repository.
    /// You can find this at the end of the URL for a Dependabot alert within GitHub,
    alert-number: string,
    /// An optional comment associated with dismissing the alert.
    dismissed-comment: option<string>,
    /// **Required when `state` is `dismissed`.** A reason for dismissing the alert.
    dismissed-reason: option<update-alert-body-dismissed-reason-enum>,
    /// The state of the Dependabot alert.
    /// A `dismissed_reason` must be provided when setting the state to `dismissed`.
    state: update-alert-body-state-enum
  }
  update-alert: func(params: update-alert-params) -> result<string, string>;

  /// List repository secrets
  record list-repo-secrets-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repo-secrets: func(params: list-repo-secrets-params) -> result<string, string>;

  /// Get a repository public key
  record get-repo-public-key-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-repo-public-key: func(params: get-repo-public-key-params) -> result<string, string>;

  /// Get a repository secret
  record get-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string
  }
  get-repo-secret: func(params: get-repo-secret-params) -> result<string, string>;

  /// Create or update a repository secret
  record create-or-update-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string,
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get a repository public key](https://docs.github.com/rest/reference/dependabot#get-a-repository-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>
  }
  create-or-update-repo-secret: func(params: create-or-update-repo-secret-params) -> result<string, string>;

  /// Delete a repository secret
  record delete-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string
  }
  delete-repo-secret: func(params: delete-repo-secret-params) -> result<string, string>;

}

interface secret-scanning {
  enum list-alerts-for-enterprise-state-enum {
    open,
    resolved,
  }

  enum list-alerts-for-enterprise-sort-enum {
    created,
    updated,
  }

  enum list-alerts-for-enterprise-direction-enum {
    asc,
    desc,
  }

  /// **Required when the `state` is `resolved`.** The reason for resolving the alert.
  record alert-resolution {
    /// opaque schema; raw JSON
    value: string
  }

  /// An optional comment when closing an alert. Cannot be updated or deleted. Must be `null` when changing `state` to `open`.
  record alert-resolution-comment {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the state of the secret scanning alert. You must provide `resolution` when you set the state to `resolved`.
  record alert-state {
    /// opaque schema; raw JSON
    value: string
  }

  /// List secret scanning alerts for an enterprise
  record list-alerts-for-enterprise-params {
    /// The slug version of the enterprise name. You can also substitute this value with the enterprise id.
    enterprise: string,
    /// Set to `open` or `resolved` to only list secret scanning alerts in a specific state.
    state: option<list-alerts-for-enterprise-state-enum>,
    /// A comma-separated list of secret types to return. By default all secret types are returned.
    /// See "[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security)"
    secret-type: option<string>,
    /// A comma-separated list of resolutions. Only secret scanning alerts with one of these resolutions are listed. Valid resolutions are `false_positive`, `wont_fix`, `revoked`, `pattern_edited`, `pattern_deleted` or `used_in_tests`.
    resolution: option<string>,
    /// The property to sort the results by. `created` means when the alert was created. `updated` means when the alert was updated or resolved.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results before this cursor.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results after this cursor.
    after: option<string>
  }
  list-alerts-for-enterprise: func(params: list-alerts-for-enterprise-params) -> result<string, string>;

  /// List secret scanning alerts for an organization
  record list-alerts-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Set to `open` or `resolved` to only list secret scanning alerts in a specific state.
    state: option<list-alerts-for-enterprise-state-enum>,
    /// A comma-separated list of secret types to return. By default all secret types are returned.
    /// See "[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security)"
    secret-type: option<string>,
    /// A comma-separated list of resolutions. Only secret scanning alerts with one of these resolutions are listed. Valid resolutions are `false_positive`, `wont_fix`, `revoked`, `pattern_edited`, `pattern_deleted` or `used_in_tests`.
    resolution: option<string>,
    /// The property to sort the results by. `created` means when the alert was created. `updated` means when the alert was updated or resolved.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for events before this cursor. To receive an initial cursor on your first request, include an empty "before" query string.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for events after this cursor.  To receive an initial cursor on your first request, include an empty "after" query string.
    after: option<string>
  }
  list-alerts-for-org: func(params: list-alerts-for-org-params) -> result<string, string>;

  /// List secret scanning alerts for a repository
  record list-alerts-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Set to `open` or `resolved` to only list secret scanning alerts in a specific state.
    state: option<list-alerts-for-enterprise-state-enum>,
    /// A comma-separated list of secret types to return. By default all secret types are returned.
    /// See "[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security)"
    secret-type: option<string>,
    /// A comma-separated list of resolutions. Only secret scanning alerts with one of these resolutions are listed. Valid resolutions are `false_positive`, `wont_fix`, `revoked`, `pattern_edited`, `pattern_deleted` or `used_in_tests`.
    resolution: option<string>,
    /// The property to sort the results by. `created` means when the alert was created. `updated` means when the alert was updated or resolved.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for events before this cursor. To receive an initial cursor on your first request, include an empty "before" query string.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for events after this cursor.  To receive an initial cursor on your first request, include an empty "after" query string.
    after: option<string>
  }
  list-alerts-for-repo: func(params: list-alerts-for-repo-params) -> result<string, string>;

  /// Get a secret scanning alert
  record get-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string
  }
  get-alert: func(params: get-alert-params) -> result<string, string>;

  /// Update a secret scanning alert
  record update-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string,
    resolution: option<alert-resolution>,
    resolution-comment: option<alert-resolution-comment>,
    state: alert-state
  }
  update-alert: func(params: update-alert-params) -> result<string, string>;

  /// List locations for a secret scanning alert
  record list-locations-for-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-locations-for-alert: func(params: list-locations-for-alert-params) -> result<string, string>;

}

interface activity {
  enum list-repos-starred-by-authenticated-user-sort-enum {
    created,
    updated,
  }

  enum list-repos-starred-by-authenticated-user-direction-enum {
    asc,
    desc,
  }

  /// List public events
  record list-public-events-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-events: func(params: list-public-events-params) -> result<string, string>;

  /// Get feeds
  get-feeds: func() -> result<string, string>;

  /// List public events for a network of repositories
  record list-public-events-for-repo-network-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
