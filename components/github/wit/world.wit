  /// List teams
  record list-op-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list<team>, list-op-error>;

  /// Create a team
  record create-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The description of the team.
    description: option<string>,
    /// List GitHub IDs for organization members who will become team maintainers.
    maintainers: option<list<string>>,
    /// The name of the team.
    name: string,
    /// The ID of a team to set as the parent team.
    parent-team-id: option<s32>,
    /// **Deprecated**. The permission that new repositories will be added to the team with when none is specified.
    permission: option<create-body-permission-enum>,
    /// The level of privacy this team should have. The options are:  
    /// **For a non-nested team:**  
    privacy: option<create-body-privacy-enum>,
    /// The full name (e.g., "organization-name/repository-name") of repositories to add the team to.
    repo-names: option<list<string>>
  }
  create: func(params: create-params) -> result<team-full, create-error>;

  /// Get a team by name
  record get-by-name-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string
  }
  get-by-name: func(params: get-by-name-params) -> result<team-full, get-by-name-error>;

  /// Update a team
  record update-in-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string,
    /// The description of the team.
    description: option<string>,
    /// The name of the team.
    name: option<string>,
    /// The ID of a team to set as the parent team.
    parent-team-id: option<s32>,
    /// **Deprecated**. The permission that new repositories will be added to the team with when none is specified.
    permission: option<update-in-org-body-permission-enum>,
    /// The level of privacy this team should have. Editing teams without specifying this parameter leaves `privacy` intact. When a team is nested, the `privacy` for parent teams cannot be `secret`. The options are:  
    /// **For a non-nested team:**  
    privacy: option<create-body-privacy-enum>
  }
  update-in-org: func(params: update-in-org-params) -> result<team-full, update-in-org-error>;

  /// Delete a team
  record delete-in-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string
  }
  delete-in-org: func(params: delete-in-org-params) -> result<string, string>;

  /// List discussions
  record list-discussions-in-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string,
    /// The direction to sort the results by.
    direction: option<list-discussions-in-org-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Pinned discussions only filter
    pinned: option<string>
  }
  list-discussions-in-org: func(params: list-discussions-in-org-params) -> result<list<team-discussion>, string>;

  /// Create a discussion
  record create-discussion-in-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string,
    /// The discussion post's body text.
    body: string,
    /// Private posts are only visible to team members, organization owners, and team maintainers. Public posts are visible to all members of the organization. Set to `true` to create a private post.
    private: option<bool>,
    /// The discussion post's title.
    title: string
