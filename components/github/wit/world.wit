  /// An artifact
  record artifact {
    archive-download-url: string,
    created-at: string,
    /// Whether or not the artifact has expired.
    expired: bool,
    expires-at: string,
    id: s32,
    /// The name of the artifact.
    name: string,
    node-id: string,
    /// The size in bytes of the artifact.
    size-in-bytes: s32,
    updated-at: string,
    url: string,
    workflow-run: option<artifact-workflow-run>
  }

