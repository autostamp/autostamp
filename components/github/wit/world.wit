  }

  /// A collection of related issues and pull requests.
  record nullable-milestone {
    closed-at: string,
    closed-issues: s32,
    created-at: string,
    creator: nullable-simple-user,
    description: string,
    due-on: string,
    html-url: string,
    id: s32,
    labels-url: string,
    node-id: string,
    /// The number of the milestone.
    number: s32,
    open-issues: s32,
    /// The state of the milestone.
    state: nullable-milestone-state-enum,
    /// The title of the milestone.
    title: string,
    updated-at: string,
    url: string
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record team {
    description: string,
    html-url: string,
    id: s32,
    members-url: string,
    name: string,
    node-id: string,
    parent: nullable-team-simple,
    permission: string,
    permissions: option<team-permissions>,
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    url: string
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record nullable-team-simple {
    /// Description of the team
    description: string,
    html-url: string,
    /// Unique identifier of the team
    id: s32,
    /// Distinguished Name (DN) that team maps to within LDAP environment
    ldap-dn: option<string>,
    members-url: string,
    /// Name of the team
    name: string,
    node-id: string,
    /// Permission that the team will have for its repositories
    permission: string,
    /// The level of privacy this team should have
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    /// URL for the team
    url: string
  }

  record team-permissions {
    admin: bool,
    maintain: bool,
    pull: bool,
    push: bool,
    triage: bool
  }

  /// Pull requests let you tell others about changes you've pushed to a repository on GitHub. Once a pull request is sent, interested parties can review the set of changes, discuss potential modifications, and even push follow-up commits if necessary.
  record pull-request {
    links: pull-request-links,
    active-lock-reason: option<string>,
    additions: s32,
    assignee: nullable-simple-user,
    assignees: option<list<simple-user>>,
    author-association: author-association,
    auto-merge: auto-merge,
    base: pull-request-base,
    body: string,
    changed-files: s32,
    closed-at: string,
    comments: s32,
    comments-url: string,
    commits: s32,
    commits-url: string,
    created-at: string,
    deletions: s32,
    diff-url: string,
    /// Indicates whether or not the pull request is a draft.
    draft: option<bool>,
    head: pull-request-head,
    html-url: string,
    id: s32,
    issue-url: string,
    labels: list<pull-request-labels-item>,
    locked: bool,
    /// Indicates whether maintainers can modify the pull request.
    maintainer-can-modify: bool,
    merge-commit-sha: string,
    mergeable: bool,
    mergeable-state: string,
    merged: bool,
    merged-at: string,
    merged-by: nullable-simple-user,
    milestone: nullable-milestone,
    node-id: string,
    /// Number uniquely identifying the pull request within its repository.
    number: s32,
    patch-url: string,
    rebaseable: option<bool>,
    requested-reviewers: option<list<simple-user>>,
    requested-teams: option<list<team-simple>>,
    review-comment-url: string,
    review-comments: s32,
    review-comments-url: string,
    /// State of this Pull Request. Either `open` or `closed`.
    state: nullable-milestone-state-enum,
    statuses-url: string,
    /// The title of the pull request.
    title: string,
    updated-at: string,
    url: string,
    user: nullable-simple-user
  }

  record pull-request-links {
    comments: link,
    commits: link,
    html: link,
    issue: link,
    review-comment: link,
    review-comments: link,
    self: link,
    statuses: link
  }

