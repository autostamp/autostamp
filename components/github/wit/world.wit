    /// The scope of the vulnerable dependency. If specified, only alerts with this scope will be returned.
    scope: option<list-alerts-for-enterprise-scope-enum>,
    /// The property by which to sort the results.
    /// `created` means when the alert was created.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// **Deprecated**. Page number of the results to fetch. Use cursor-based pagination with `before` or `after` instead.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results before this cursor.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results after this cursor.
    after: option<string>,
    /// **Deprecated**. The number of results per page (max 100), starting from the first matching result.
    /// This parameter must not be used in combination with `last`.
    first: option<s32>,
    /// **Deprecated**. The number of results per page (max 100), starting from the last matching result.
    /// This parameter must not be used in combination with `first`.
    last: option<s32>
  }
  list-alerts-for-repo: func(params: list-alerts-for-repo-params) -> result<list<alert>, list-alerts-for-repo-error>;

  /// Get a Dependabot alert
  record get-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies a Dependabot alert in its repository.
    /// You can find this at the end of the URL for a Dependabot alert within GitHub,
    alert-number: string
  }
  get-alert: func(params: get-alert-params) -> result<alert, get-alert-error>;

  /// Update a Dependabot alert
  record update-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies a Dependabot alert in its repository.
    /// You can find this at the end of the URL for a Dependabot alert within GitHub,
    alert-number: string,
    /// An optional comment associated with dismissing the alert.
    dismissed-comment: option<string>,
    /// **Required when `state` is `dismissed`.** A reason for dismissing the alert.
    dismissed-reason: option<alert-with-repository-dismissed-reason-enum>,
    /// The state of the Dependabot alert.
    /// A `dismissed_reason` must be provided when setting the state to `dismissed`.
    state: update-alert-body-state-enum
  }
  update-alert: func(params: update-alert-params) -> result<alert, update-alert-error>;

  /// List repository secrets
  record list-repo-secrets-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repo-secrets: func(params: list-repo-secrets-params) -> result<list-repo-secrets-response, string>;

  /// Get a repository public key
  record get-repo-public-key-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-repo-public-key: func(params: get-repo-public-key-params) -> result<public-key, string>;

  /// Get a repository secret
  record get-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string
  }
  get-repo-secret: func(params: get-repo-secret-params) -> result<secret, string>;

  /// Create or update a repository secret
  record create-or-update-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string,
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get a repository public key](https://docs.github.com/rest/reference/dependabot#get-a-repository-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>
  }
  create-or-update-repo-secret: func(params: create-or-update-repo-secret-params) -> result<empty-object, string>;

  /// Delete a repository secret
  record delete-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string
  }
  delete-repo-secret: func(params: delete-repo-secret-params) -> result<string, string>;

}

interface secret-scanning {
  enum list-alerts-for-enterprise-state-enum {
    open,
    resolved,
  }

  enum list-alerts-for-enterprise-sort-enum {
    created,
    updated,
  }

  enum list-alerts-for-enterprise-direction-enum {
    asc,
    desc,
  }

  enum alert-resolution {
    false-positive,
    wont-fix,
    revoked,
    used-in-tests,
  }

  enum alert-state {
    open,
    resolved,
  }

  enum location-type-op-enum {
    commit,
    issue-title,
    issue-body,
    issue-comment,
  }

  record organization-secret-scanning-alert {
    created-at: option<string>,
    html-url: option<string>,
    /// The REST API URL of the code locations for this alert.
    locations-url: option<string>,
    number: option<s32>,
    /// Whether push protection was bypassed for the detected secret.
    push-protection-bypassed: option<bool>,
    /// The time that push protection was bypassed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
    push-protection-bypassed-at: option<string>,
    push-protection-bypassed-by: option<nullable-simple-user>,
    repository: option<simple-repository>,
    resolution: option<alert-resolution>,
    /// The comment that was optionally added when this alert was closed
    resolution-comment: option<string>,
    /// The time that the alert was resolved in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
    resolved-at: option<string>,
    resolved-by: option<nullable-simple-user>,
    /// The secret that was detected.
    secret: option<string>,
    /// The type of secret that secret scanning detected.
    secret-type: option<string>,
    /// User-friendly name for the detected secret, matching the `secret_type`.
    /// For a list of built-in patterns, see "[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security)."
    secret-type-display-name: option<string>,
    state: option<alert-state>,
    updated-at: option<string>,
    url: option<string>
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A GitHub repository.
  record simple-repository {
    /// A template for the API URL to download the repository as an archive.
    archive-url: string,
    /// A template for the API URL to list the available assignees for issues in the repository.
    assignees-url: string,
    /// A template for the API URL to create or retrieve a raw Git blob in the repository.
    blobs-url: string,
    /// A template for the API URL to get information about branches in the repository.
    branches-url: string,
    /// A template for the API URL to get information about collaborators of the repository.
    collaborators-url: string,
    /// A template for the API URL to get information about comments on the repository.
    comments-url: string,
    /// A template for the API URL to get information about commits on the repository.
    commits-url: string,
    /// A template for the API URL to compare two commits or refs.
    compare-url: string,
    /// A template for the API URL to get the contents of the repository.
    contents-url: string,
    /// A template for the API URL to list the contributors to the repository.
    contributors-url: string,
    /// The API URL to list the deployments of the repository.
    deployments-url: string,
    /// The repository description.
    description: string,
    /// The API URL to list the downloads on the repository.
    downloads-url: string,
    /// The API URL to list the events of the repository.
    events-url: string,
    /// Whether the repository is a fork.
    fork: bool,
    /// The API URL to list the forks of the repository.
    forks-url: string,
    /// The full, globally unique, name of the repository.
    full-name: string,
    /// A template for the API URL to get information about Git commits of the repository.
    git-commits-url: string,
    /// A template for the API URL to get information about Git refs of the repository.
    git-refs-url: string,
    /// A template for the API URL to get information about Git tags of the repository.
    git-tags-url: string,
    /// The API URL to list the hooks on the repository.
    hooks-url: string,
    /// The URL to view the repository on GitHub.com.
    html-url: string,
    /// A unique identifier of the repository.
    id: s32,
    /// A template for the API URL to get information about issue comments on the repository.
    issue-comment-url: string,
    /// A template for the API URL to get information about issue events on the repository.
    issue-events-url: string,
    /// A template for the API URL to get information about issues on the repository.
    issues-url: string,
    /// A template for the API URL to get information about deploy keys on the repository.
    keys-url: string,
    /// A template for the API URL to get information about labels of the repository.
    labels-url: string,
    /// The API URL to get information about the languages of the repository.
    languages-url: string,
    /// The API URL to merge branches in the repository.
    merges-url: string,
    /// A template for the API URL to get information about milestones of the repository.
    milestones-url: string,
    /// The name of the repository.
    name: string,
    /// The GraphQL identifier of the repository.
    node-id: string,
    /// A template for the API URL to get information about notifications on the repository.
    notifications-url: string,
    owner: simple-user,
    /// Whether the repository is private.
    private: bool,
    /// A template for the API URL to get information about pull requests on the repository.
    pulls-url: string,
    /// A template for the API URL to get information about releases on the repository.
    releases-url: string,
    /// The API URL to list the stargazers on the repository.
    stargazers-url: string,
    /// A template for the API URL to get information about statuses of a commit.
    statuses-url: string,
    /// The API URL to list the subscribers on the repository.
    subscribers-url: string,
    /// The API URL to subscribe to notifications for this repository.
    subscription-url: string,
    /// The API URL to get information about tags on the repository.
    tags-url: string,
    /// The API URL to list the teams on the repository.
    teams-url: string,
    /// A template for the API URL to create or retrieve a raw Git tree of the repository.
    trees-url: string,
    /// The URL to get more information about the repository from the GitHub API.
    url: string
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record alert {
    created-at: option<string>,
    html-url: option<string>,
    /// The REST API URL of the code locations for this alert.
    locations-url: option<string>,
    number: option<s32>,
    /// Whether push protection was bypassed for the detected secret.
    push-protection-bypassed: option<bool>,
    /// The time that push protection was bypassed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
    push-protection-bypassed-at: option<string>,
    push-protection-bypassed-by: option<nullable-simple-user>,
    resolution: option<alert-resolution>,
    /// An optional comment to resolve an alert.
    resolution-comment: option<string>,
    /// The time that the alert was resolved in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
    resolved-at: option<string>,
    resolved-by: option<nullable-simple-user>,
    /// The secret that was detected.
    secret: option<string>,
    /// The type of secret that secret scanning detected.
    secret-type: option<string>,
    /// User-friendly name for the detected secret, matching the `secret_type`.
    /// For a list of built-in patterns, see "[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security)."
    secret-type-display-name: option<string>,
    state: option<alert-state>,
    updated-at: option<string>,
    url: option<string>
  }

  record location {
    details: string,
    /// The location type. Because secrets may be found in different types of resources (ie. code, comments, issues), this field identifies the type of resource where the secret was found.
    type-op: location-type-op-enum
  }

  variant list-alerts-for-enterprise-error {
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant list-alerts-for-org-error {
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant list-alerts-for-repo-error {
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant get-alert-error {
    not-modified(string),
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  variant update-alert-error {
    bad-request(string),
    not-found(string),
    unprocessable-entity(string),
    service-unavailable(string),
    other(string)
  }

  variant list-locations-for-alert-error {
    not-found(string),
    service-unavailable(string),
    other(string)
  }

  /// List secret scanning alerts for an enterprise
  record list-alerts-for-enterprise-params {
    /// The slug version of the enterprise name. You can also substitute this value with the enterprise id.
    enterprise: string,
    /// Set to `open` or `resolved` to only list secret scanning alerts in a specific state.
    state: option<list-alerts-for-enterprise-state-enum>,
    /// A comma-separated list of secret types to return. By default all secret types are returned.
    /// See "[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security)"
    secret-type: option<string>,
    /// A comma-separated list of resolutions. Only secret scanning alerts with one of these resolutions are listed. Valid resolutions are `false_positive`, `wont_fix`, `revoked`, `pattern_edited`, `pattern_deleted` or `used_in_tests`.
    resolution: option<string>,
    /// The property to sort the results by. `created` means when the alert was created. `updated` means when the alert was updated or resolved.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results before this cursor.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for results after this cursor.
    after: option<string>
  }
  list-alerts-for-enterprise: func(params: list-alerts-for-enterprise-params) -> result<list<organization-secret-scanning-alert>, list-alerts-for-enterprise-error>;

  /// List secret scanning alerts for an organization
  record list-alerts-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Set to `open` or `resolved` to only list secret scanning alerts in a specific state.
    state: option<list-alerts-for-enterprise-state-enum>,
    /// A comma-separated list of secret types to return. By default all secret types are returned.
    /// See "[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security)"
    secret-type: option<string>,
    /// A comma-separated list of resolutions. Only secret scanning alerts with one of these resolutions are listed. Valid resolutions are `false_positive`, `wont_fix`, `revoked`, `pattern_edited`, `pattern_deleted` or `used_in_tests`.
    resolution: option<string>,
    /// The property to sort the results by. `created` means when the alert was created. `updated` means when the alert was updated or resolved.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for events before this cursor. To receive an initial cursor on your first request, include an empty "before" query string.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for events after this cursor.  To receive an initial cursor on your first request, include an empty "after" query string.
    after: option<string>
  }
  list-alerts-for-org: func(params: list-alerts-for-org-params) -> result<list<organization-secret-scanning-alert>, list-alerts-for-org-error>;

  /// List secret scanning alerts for a repository
  record list-alerts-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Set to `open` or `resolved` to only list secret scanning alerts in a specific state.
    state: option<list-alerts-for-enterprise-state-enum>,
    /// A comma-separated list of secret types to return. By default all secret types are returned.
    /// See "[Secret scanning patterns](https://docs.github.com/code-security/secret-scanning/secret-scanning-patterns#supported-secrets-for-advanced-security)"
    secret-type: option<string>,
    /// A comma-separated list of resolutions. Only secret scanning alerts with one of these resolutions are listed. Valid resolutions are `false_positive`, `wont_fix`, `revoked`, `pattern_edited`, `pattern_deleted` or `used_in_tests`.
    resolution: option<string>,
    /// The property to sort the results by. `created` means when the alert was created. `updated` means when the alert was updated or resolved.
    sort: option<list-alerts-for-enterprise-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-alerts-for-enterprise-direction-enum>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for events before this cursor. To receive an initial cursor on your first request, include an empty "before" query string.
    before: option<string>,
    /// A cursor, as given in the [Link header](https://docs.github.com/rest/overview/resources-in-the-rest-api#link-header). If specified, the query only searches for events after this cursor.  To receive an initial cursor on your first request, include an empty "after" query string.
    after: option<string>
  }
  list-alerts-for-repo: func(params: list-alerts-for-repo-params) -> result<list<alert>, list-alerts-for-repo-error>;

  /// Get a secret scanning alert
  record get-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string
  }
  get-alert: func(params: get-alert-params) -> result<alert, get-alert-error>;

  /// Update a secret scanning alert
  record update-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string,
    resolution: option<alert-resolution>,
    resolution-comment: option<string>,
    state: alert-state
  }
  update-alert: func(params: update-alert-params) -> result<alert, update-alert-error>;

  /// List locations for a secret scanning alert
  record list-locations-for-alert-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies an alert. You can find this at the end of the URL for a code scanning alert within GitHub, and in the `number` field in the response from the `GET /repos/{owner}/{repo}/code-scanning/alerts` operation.
    alert-number: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-locations-for-alert: func(params: list-locations-for-alert-params) -> result<list<location>, list-locations-for-alert-error>;

}

interface activity {
  enum author-association {
    collaborator,
    contributor,
    first-timer,
    first-time-contributor,
    mannequin,
    member,
    none,
    owner,
  }

  enum nullable-milestone-state-enum {
    open,
    closed,
  }

  enum repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  enum issue-state-reason-enum {
    completed,
    reopened,
    not-planned,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum list-repos-starred-by-authenticated-user-sort-enum {
    created,
    updated,
  }

  enum list-repos-starred-by-authenticated-user-direction-enum {
    asc,
    desc,
  }

  /// Event
  record event {
    actor: actor,
    created-at: string,
    id: string,
    org: option<actor>,
    payload: event-payload,
    public: bool,
    repo: event-repo,
    type-op: string
  }

  /// Actor
  record actor {
    avatar-url: string,
    display-login: option<string>,
    gravatar-id: string,
    id: s32,
    login: string,
    url: string
  }

  record event-payload {
    action: option<string>,
    comment: option<issue-comment>,
    issue: option<issue>,
    pages: option<list<event-payload-pages-item>>
  }

  /// Comments provide a way for people to collaborate on an issue.
  record issue-comment {
    author-association: author-association,
    /// Contents of the issue comment
    body: option<string>,
    body-html: option<string>,
    body-text: option<string>,
    created-at: string,
    html-url: string,
    /// Unique identifier of the issue comment
    id: s32,
    issue-url: string,
    node-id: string,
    performed-via-github-app: option<nullable-integration>,
    reactions: option<reaction-rollup>,
    updated-at: string,
    /// URL for the issue comment
    url: string,
    user: nullable-simple-user
  }

  /// GitHub apps are a new way to extend GitHub. They can be installed directly on organizations and user accounts and granted access to specific repositories. They come with granular permissions and built-in webhooks. GitHub apps are first class actors within GitHub.
  record nullable-integration {
    client-id: option<string>,
    client-secret: option<string>,
    created-at: string,
    description: string,
    /// The list of events for the GitHub app
    events: list<string>,
    external-url: string,
    html-url: string,
    /// Unique identifier of the GitHub app
    id: s32,
    /// The number of installations associated with the GitHub app
    installations-count: option<s32>,
    /// The name of the GitHub app
    name: string,
    node-id: string,
    owner: nullable-simple-user,
    pem: option<string>,
    /// The set of permissions for the GitHub app
    permissions: nullable-integration-permissions,
    /// The slug name of the GitHub app
    slug: option<string>,
    updated-at: string,
    webhook-secret: option<string>
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// The set of permissions for the GitHub app
  record nullable-integration-permissions {
    checks: option<string>,
    contents: option<string>,
    deployments: option<string>,
    issues: option<string>,
    metadata: option<string>
  }

  record reaction-rollup {
    v1: s32,
    v1-v2: s32,
    confused: s32,
    eyes: s32,
    heart: s32,
    hooray: s32,
    laugh: s32,
    rocket: s32,
    total-count: s32,
    url: string
  }

  /// Issues are a great way to keep track of tasks, enhancements, and bugs for your projects.
  record issue {
    active-lock-reason: option<string>,
    assignee: nullable-simple-user,
    assignees: option<list<simple-user>>,
    author-association: author-association,
    /// Contents of the issue
    body: option<string>,
    body-html: option<string>,
    body-text: option<string>,
    closed-at: string,
    closed-by: option<nullable-simple-user>,
    comments: s32,
    comments-url: string,
    created-at: string,
    draft: option<bool>,
    events-url: string,
    html-url: string,
    id: s32,
    /// Labels to associate with this issue; pass one or more label names to replace the set of labels on this issue; send an empty array to clear all labels from the issue; note that the labels are silently dropped for users without push access to the repository
    labels: list<string>,
    labels-url: string,
    locked: bool,
    milestone: nullable-milestone,
    node-id: string,
    /// Number uniquely identifying the issue within its repository
    number: s32,
    performed-via-github-app: option<nullable-integration>,
    pull-request: option<issue-pull-request>,
    reactions: option<reaction-rollup>,
    repository: option<repository>,
    repository-url: string,
    /// State of the issue; either 'open' or 'closed'
    state: string,
    /// The reason for the current state
    state-reason: option<issue-state-reason-enum>,
    timeline-url: option<string>,
    /// Title of the issue
    title: string,
    updated-at: string,
    /// URL for the issue
    url: string,
    user: nullable-simple-user
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A collection of related issues and pull requests.
  record nullable-milestone {
    closed-at: string,
    closed-issues: s32,
    created-at: string,
    creator: nullable-simple-user,
    description: string,
    due-on: string,
    html-url: string,
    id: s32,
    labels-url: string,
    node-id: string,
    /// The number of the milestone.
    number: s32,
    open-issues: s32,
    /// The state of the milestone.
    state: nullable-milestone-state-enum,
    /// The title of the milestone.
    title: string,
    updated-at: string,
    url: string
  }

  record issue-pull-request {
    diff-url: string,
    html-url: string,
    merged-at: option<string>,
    patch-url: string,
    url: string
  }

  /// A repository on GitHub.
  record repository {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow forking this repo
    allow-forking: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is enabled for this repository
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    /// Whether the repository is archived.
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: string,
    /// The default branch of the repository.
    default-branch: string,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    /// Returns whether or not this repository disabled.
    disabled: bool,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: s32,
    forks-count: s32,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: string,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: bool,
    /// Whether issues are enabled.
    has-issues: bool,
    has-pages: bool,
    /// Whether projects are enabled.
    has-projects: bool,
    /// Whether the wiki is enabled.
    has-wiki: bool,
    homepage: string,
    hooks-url: string,
    html-url: string,
    /// Unique identifier of the repository
    id: s32,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: string,
    languages-url: string,
    license: nullable-license-simple,
    master-branch: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: string,
    milestones-url: string,
    mirror-url: string,
    /// The name of the repository.
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: s32,
    open-issues-count: s32,
    organization: option<nullable-simple-user>,
    owner: simple-user,
    permissions: option<repository-permissions>,
    /// Whether the repository is private or public.
    private: bool,
    pulls-url: string,
    pushed-at: string,
    releases-url: string,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: s32,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: string,
    stargazers-count: s32,
    stargazers-url: string,
    starred-at: option<string>,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: string,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    template-repository: option<repository-template-repository>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: string,
    url: string,
    /// Whether a squash merge commit can use the pull request title as default. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The repository visibility: public, private, or internal.
    visibility: option<string>,
    watchers: s32,
    watchers-count: s32,
    /// Whether to require contributors to sign off on web-based commits
    web-commit-signoff-required: option<bool>
  }

  /// License Simple
  record nullable-license-simple {
