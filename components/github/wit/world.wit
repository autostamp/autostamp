    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  record security-and-analysis {
    advanced-security: option<security-and-analysis-advanced-security>,
    secret-scanning: option<security-and-analysis-secret-scanning>,
    secret-scanning-push-protection: option<security-and-analysis-secret-scanning-push-protection>
  }

  record security-and-analysis-advanced-security {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning-push-protection {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record thread-subject {
    latest-comment-url: string,
    title: string,
    type-op: string,
    url: string
  }

  record mark-notifications-as-read-response {
    message: option<string>
  }

  /// Thread Subscription
  record thread-subscription {
    created-at: string,
    ignored: bool,
    reason: string,
    repository-url: option<string>,
    subscribed: bool,
    thread-url: option<string>,
    url: string
  }

  record mark-repo-notifications-as-read-response {
    message: option<string>,
    url: option<string>
  }

  /// Repository invitations let you manage who you collaborate with.
  record repository-subscription {
    created-at: string,
    /// Determines if all notifications should be blocked from this repository.
    ignored: bool,
    reason: string,
    repository-url: string,
    /// Determines if notifications should be received from this repository.
    subscribed: bool,
    url: string
  }

  variant list-public-events-error {
    not-modified(string),
    forbidden(string),
    service-unavailable(string),
    other(string)
  }

  variant list-public-events-for-repo-network-error {
    moved-permanently(string),
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-notifications-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant mark-notifications-as-read-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-thread-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant mark-thread-as-read-error {
    not-modified(string),
    forbidden(string),
    other(string)
  }

  variant get-thread-subscription-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant set-thread-subscription-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant delete-thread-subscription-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant list-stargazers-for-repo-error {
    unprocessable-entity(string),
    other(string)
  }

  variant get-repo-subscription-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-repos-starred-by-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant check-repo-is-starred-by-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant star-repo-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant unstar-repo-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-watched-repos-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  /// List public events
  record list-public-events-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-events: func(params: list-public-events-params) -> result<list<event>, list-public-events-error>;

  /// Get feeds
  get-feeds: func() -> result<feed, string>;

  /// List public events for a network of repositories
  record list-public-events-for-repo-network-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-events-for-repo-network: func(params: list-public-events-for-repo-network-params) -> result<list<event>, list-public-events-for-repo-network-error>;

  /// List notifications for the authenticated user
  record list-notifications-for-authenticated-user-params {
    /// If `true`, show notifications marked as read.
    all: option<bool>,
    /// If `true`, only shows notifications in which the user is directly participating or mentioned.
    participating: option<bool>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// Only show notifications updated before the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    before: option<string>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 50).
    per-page: option<s32>
  }
  list-notifications-for-authenticated-user: func(params: list-notifications-for-authenticated-user-params) -> result<list<thread>, list-notifications-for-authenticated-user-error>;

  /// Mark notifications as read
  record mark-notifications-as-read-params {
    /// Describes the last point that notifications were checked. Anything updated since this time will not be marked as read. If you omit this parameter, all notifications are marked as read. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. Default: The current timestamp.
    last-read-at: option<string>,
    /// Whether the notification has been read.
    read: option<bool>
  }
  mark-notifications-as-read: func(params: mark-notifications-as-read-params) -> result<mark-notifications-as-read-response, mark-notifications-as-read-error>;

  /// Get a thread
  record get-thread-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string
  }
  get-thread: func(params: get-thread-params) -> result<thread, get-thread-error>;

  /// Mark a thread as read
  record mark-thread-as-read-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string
  }
  mark-thread-as-read: func(params: mark-thread-as-read-params) -> result<string, mark-thread-as-read-error>;

  /// Get a thread subscription for the authenticated user
  record get-thread-subscription-for-authenticated-user-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string
  }
  get-thread-subscription-for-authenticated-user: func(params: get-thread-subscription-for-authenticated-user-params) -> result<thread-subscription, get-thread-subscription-for-authenticated-user-error>;

  /// Set a thread subscription
  record set-thread-subscription-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string,
    /// Whether to block all notifications from a thread.
    ignored: option<bool>
  }
  set-thread-subscription: func(params: set-thread-subscription-params) -> result<thread-subscription, set-thread-subscription-error>;

  /// Delete a thread subscription
  record delete-thread-subscription-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string
  }
  delete-thread-subscription: func(params: delete-thread-subscription-params) -> result<string, delete-thread-subscription-error>;

  /// List public organization events
  record list-public-org-events-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-org-events: func(params: list-public-org-events-params) -> result<list<event>, string>;

  /// List repository events
  record list-repo-events-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repo-events: func(params: list-repo-events-params) -> result<list<event>, string>;

  /// List repository notifications for the authenticated user
  record list-repo-notifications-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// If `true`, show notifications marked as read.
    all: option<bool>,
    /// If `true`, only shows notifications in which the user is directly participating or mentioned.
    participating: option<bool>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// Only show notifications updated before the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    before: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repo-notifications-for-authenticated-user: func(params: list-repo-notifications-for-authenticated-user-params) -> result<list<thread>, string>;

  /// Mark repository notifications as read
  record mark-repo-notifications-as-read-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Describes the last point that notifications were checked. Anything updated since this time will not be marked as read. If you omit this parameter, all notifications are marked as read. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. Default: The current timestamp.
    last-read-at: option<string>
  }
  mark-repo-notifications-as-read: func(params: mark-repo-notifications-as-read-params) -> result<mark-repo-notifications-as-read-response, string>;

  /// List stargazers
  record list-stargazers-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-stargazers-for-repo: func(params: list-stargazers-for-repo-params) -> result<string, list-stargazers-for-repo-error>;

  /// List watchers
  record list-watchers-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-watchers-for-repo: func(params: list-watchers-for-repo-params) -> result<list<simple-user>, string>;

  /// Get a repository subscription
  record get-repo-subscription-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-repo-subscription: func(params: get-repo-subscription-params) -> result<repository-subscription, get-repo-subscription-error>;

  /// Set a repository subscription
  record set-repo-subscription-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Determines if all notifications should be blocked from this repository.
    ignored: option<bool>,
    /// Determines if notifications should be received from this repository.
    subscribed: option<bool>
  }
  set-repo-subscription: func(params: set-repo-subscription-params) -> result<repository-subscription, string>;

  /// Delete a repository subscription
  record delete-repo-subscription-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  delete-repo-subscription: func(params: delete-repo-subscription-params) -> result<string, string>;

  /// List repositories starred by the authenticated user
  record list-repos-starred-by-authenticated-user-params {
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-repos-starred-by-authenticated-user-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-repos-starred-by-authenticated-user-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-starred-by-authenticated-user: func(params: list-repos-starred-by-authenticated-user-params) -> result<list<repository>, list-repos-starred-by-authenticated-user-error>;

  /// Check if a repository is starred by the authenticated user
  record check-repo-is-starred-by-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  check-repo-is-starred-by-authenticated-user: func(params: check-repo-is-starred-by-authenticated-user-params) -> result<string, check-repo-is-starred-by-authenticated-user-error>;

  /// Star a repository for the authenticated user
  record star-repo-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  star-repo-for-authenticated-user: func(params: star-repo-for-authenticated-user-params) -> result<string, star-repo-for-authenticated-user-error>;

  /// Unstar a repository for the authenticated user
  record unstar-repo-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  unstar-repo-for-authenticated-user: func(params: unstar-repo-for-authenticated-user-params) -> result<string, unstar-repo-for-authenticated-user-error>;

  /// List repositories watched by the authenticated user
  record list-watched-repos-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-watched-repos-for-authenticated-user: func(params: list-watched-repos-for-authenticated-user-params) -> result<list<minimal-repository>, list-watched-repos-for-authenticated-user-error>;

  /// List events for the authenticated user
  record list-events-for-authenticated-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-events-for-authenticated-user: func(params: list-events-for-authenticated-user-params) -> result<list<event>, string>;

  /// List organization events for the authenticated user
  record list-org-events-for-authenticated-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-org-events-for-authenticated-user: func(params: list-org-events-for-authenticated-user-params) -> result<list<event>, string>;

  /// List public events for a user
  record list-public-events-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-events-for-user: func(params: list-public-events-for-user-params) -> result<list<event>, string>;

  /// List events received by the authenticated user
  record list-received-events-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-received-events-for-user: func(params: list-received-events-for-user-params) -> result<list<event>, string>;

  /// List public events received by a user
  record list-received-public-events-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-received-public-events-for-user: func(params: list-received-public-events-for-user-params) -> result<list<event>, string>;

  /// List repositories starred by a user
  record list-repos-starred-by-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-repos-starred-by-authenticated-user-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-repos-starred-by-authenticated-user-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-starred-by-user: func(params: list-repos-starred-by-user-params) -> result<string, string>;

  /// List repositories watched by a user
  record list-repos-watched-by-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-watched-by-user: func(params: list-repos-watched-by-user-params) -> result<list<minimal-repository>, string>;

}

interface gists {
  enum author-association {
    collaborator,
    contributor,
    first-timer,
    first-time-contributor,
    mannequin,
    member,
    none,
    owner,
  }

  /// Base Gist
  record base-gist {
    comments: s32,
    comments-url: string,
    commits-url: string,
    created-at: string,
    description: string,
    files: list<base-gist-files-entry>,
    forks: option<list<string>>,
    forks-url: string,
    git-pull-url: string,
    git-push-url: string,
    history: option<list<string>>,
    html-url: string,
    id: string,
    node-id: string,
    owner: option<simple-user>,
    public: bool,
    truncated: option<bool>,
    updated-at: string,
    url: string,
    user: nullable-simple-user
  }

  record base-gist-files-value {
    filename: option<string>,
    language: option<string>,
    raw-url: option<string>,
    size: option<s32>,
    type-op: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record base-gist-files-entry {
    key: string,
    value: base-gist-files-value
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record create-body-files-value {
    /// Content of the file
    content: string
  }

  /// one entry of a string-keyed map (free-form object)
  record create-body-files-entry {
    key: string,
    value: create-body-files-value
  }

  /// Gist Simple
  record gist-simple {
    comments: option<s32>,
    comments-url: option<string>,
    commits-url: option<string>,
    created-at: option<string>,
    description: option<string>,
    files: option<list<gist-simple-files-entry>>,
    /// Gist
    fork-of: option<gist-simple-fork-of>,
    forks: option<list<gist-simple-forks-item>>,
    forks-url: option<string>,
    git-pull-url: option<string>,
    git-push-url: option<string>,
    history: option<list<gist-history>>,
    html-url: option<string>,
    id: option<string>,
    node-id: option<string>,
    owner: option<simple-user>,
    public: option<bool>,
    truncated: option<bool>,
    updated-at: option<string>,
    url: option<string>,
    user: option<string>
  }

  record gist-simple-files-value {
    content: option<string>,
    filename: option<string>,
    language: option<string>,
    raw-url: option<string>,
    size: option<s32>,
    truncated: option<bool>,
    type-op: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record gist-simple-files-entry {
    key: string,
    value: gist-simple-files-value
  }

  /// Gist
  record gist-simple-fork-of {
    comments: s32,
    comments-url: string,
    commits-url: string,
    created-at: string,
    description: string,
    files: list<gist-simple-fork-of-files-entry>,
    forks: option<list<string>>,
    forks-url: string,
    git-pull-url: string,
    git-push-url: string,
    history: option<list<string>>,
    html-url: string,
    id: string,
    node-id: string,
    owner: option<nullable-simple-user>,
    public: bool,
    truncated: option<bool>,
    updated-at: string,
    url: string,
    user: nullable-simple-user
  }

  record gist-simple-fork-of-files-value {
    filename: option<string>,
    language: option<string>,
    raw-url: option<string>,
    size: option<s32>,
    type-op: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record gist-simple-fork-of-files-entry {
    key: string,
    value: gist-simple-fork-of-files-value
  }

  record gist-simple-forks-item {
    created-at: option<string>,
    id: option<string>,
    updated-at: option<string>,
    url: option<string>,
    user: option<public-user>
  }

  /// Public User
  record public-user {
    avatar-url: string,
    bio: string,
    blog: string,
    collaborators: option<s32>,
    company: string,
    created-at: string,
    disk-usage: option<s32>,
    email: string,
    events-url: string,
    followers: s32,
    followers-url: string,
    following: s32,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    hireable: bool,
    html-url: string,
    id: s32,
    location: string,
    login: string,
    name: string,
    node-id: string,
    organizations-url: string,
    owned-private-repos: option<s32>,
    plan: option<public-user-plan>,
    private-gists: option<s32>,
    public-gists: s32,
    public-repos: s32,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-url: string,
    subscriptions-url: string,
    suspended-at: option<string>,
    total-private-repos: option<s32>,
    twitter-username: option<string>,
    type-op: string,
    updated-at: string,
    url: string
  }

  record public-user-plan {
    collaborators: s32,
    name: string,
    private-repos: s32,
    space: s32
  }

  /// Gist History
  record gist-history {
    change-status: option<gist-history-change-status>,
    committed-at: option<string>,
    url: option<string>,
    user: option<nullable-simple-user>,
    version: option<string>
  }

  record gist-history-change-status {
    additions: option<s32>,
    deletions: option<s32>,
    total: option<s32>
  }

  record update-body-files-value {
    /// The new content of the file.
    content: option<string>,
    /// The new filename for the file.
    filename: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record update-body-files-entry {
    key: string,
    value: update-body-files-value
  }

  /// A comment made to a gist.
  record gist-comment {
    author-association: author-association,
    /// The comment text.
    body: string,
    created-at: string,
    id: s32,
    node-id: string,
    updated-at: string,
    url: string,
    user: nullable-simple-user
  }

  /// Gist Commit
  record gist-commit {
    change-status: gist-commit-change-status,
    committed-at: string,
    url: string,
    user: nullable-simple-user,
    version: string
  }

  record gist-commit-change-status {
    additions: option<s32>,
    deletions: option<s32>,
    total: option<s32>
  }

  variant list-op-error {
    not-modified(string),
    forbidden(string),
    other(string)
  }

  variant create-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-public-error {
    not-modified(string),
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-starred-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-comments-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-comment-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-comment-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant update-comment-error {
    not-found(string),
    other(string)
  }

  variant delete-comment-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-commits-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-forks-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant fork-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant check-is-starred-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant star-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant unstar-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-revision-error {
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-for-user-error {
    unprocessable-entity(string),
    other(string)
  }

  /// List gists for the authenticated user
  record list-op-params {
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list<base-gist>, list-op-error>;

  /// Create a gist
  record create-params {
    /// Description of the gist
    description: option<string>,
    /// Names and content for the files that make up the gist
    files: list<create-body-files-entry>,
    public: option<string>
  }
  create: func(params: create-params) -> result<gist-simple, create-error>;

  /// List public gists
  record list-public-params {
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public: func(params: list-public-params) -> result<list<base-gist>, list-public-error>;

  /// List starred gists
  record list-starred-params {
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-starred: func(params: list-starred-params) -> result<list<base-gist>, list-starred-error>;

  /// Get a gist
  record get-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  get: func(params: get-params) -> result<gist-simple, get-error>;

  /// Update a gist
  record update-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The description of the gist.
    description: option<string>,
    /// The gist files to be updated, renamed, or deleted. Each `key` must match the current filename
    /// (including extension) of the targeted gist file. For example: `hello.py`.
    files: option<list<update-body-files-entry>>
  }
  update: func(params: update-params) -> result<gist-simple, update-error>;

  /// Delete a gist
  record delete-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  delete: func(params: delete-params) -> result<string, delete-error>;

  /// List gist comments
  record list-comments-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-comments: func(params: list-comments-params) -> result<list<gist-comment>, list-comments-error>;

  /// Create a gist comment
  record create-comment-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The comment text.
    body: string
  }
  create-comment: func(params: create-comment-params) -> result<gist-comment, create-comment-error>;

  /// Get a gist comment
  record get-comment-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  get-comment: func(params: get-comment-params) -> result<gist-comment, get-comment-error>;

  /// Update a gist comment
  record update-comment-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The unique identifier of the comment.
    comment-id: string,
    /// The comment text.
    body: string
  }
  update-comment: func(params: update-comment-params) -> result<gist-comment, update-comment-error>;

  /// Delete a gist comment
  record delete-comment-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  delete-comment: func(params: delete-comment-params) -> result<string, delete-comment-error>;

  /// List gist commits
  record list-commits-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-commits: func(params: list-commits-params) -> result<list<gist-commit>, list-commits-error>;

  /// List gist forks
  record list-forks-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-forks: func(params: list-forks-params) -> result<list<gist-simple>, list-forks-error>;

  /// Fork a gist
  record fork-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  fork: func(params: fork-params) -> result<base-gist, fork-error>;

  /// Check if a gist is starred
  record check-is-starred-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  check-is-starred: func(params: check-is-starred-params) -> result<string, check-is-starred-error>;

  /// Star a gist
  record star-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  star: func(params: star-params) -> result<string, star-error>;

  /// Unstar a gist
  record unstar-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  unstar: func(params: unstar-params) -> result<string, unstar-error>;

  /// Get a gist revision
  record get-revision-params {
    /// The unique identifier of the gist.
    gist-id: string,
    sha: string
  }
  get-revision: func(params: get-revision-params) -> result<gist-simple, get-revision-error>;

  /// List gists for a user
  record list-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-user: func(params: list-for-user-params) -> result<list<base-gist>, list-for-user-error>;

}

interface gitignore {
  /// Gitignore Template
  record template {
    name: string,
    source: string
  }

  variant get-all-templates-error {
    not-modified(string),
    other(string)
  }

  variant get-template-error {
    not-modified(string),
    other(string)
  }

  /// Get all gitignore templates
  get-all-templates: func() -> result<list<string>, get-all-templates-error>;

  /// Get a gitignore template
  record get-template-params {
    name: string
  }
  get-template: func(params: get-template-params) -> result<template, get-template-error>;

}

interface issues {
  enum list-op-filter-enum {
    assigned,
    created,
    mentioned,
    subscribed,
    repos,
    all,
  }

  enum list-op-state-enum {
    open,
    closed,
    all,
  }

  enum list-op-sort-enum {
    created,
    updated,
    comments,
  }

  enum list-op-direction-enum {
    asc,
    desc,
  }

  enum author-association {
    collaborator,
    contributor,
    first-timer,
    first-time-contributor,
    mannequin,
    member,
    none,
    owner,
  }

  enum nullable-milestone-state-enum {
    open,
    closed,
  }

  enum repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  enum issue-state-reason-enum {
    completed,
    reopened,
    not-planned,
  }

  enum list-comments-for-repo-sort-enum {
    created,
    updated,
  }

  enum update-body-state-reason-enum {
    completed,
    not-planned,
    reopened,
  }

  enum lock-body-lock-reason-enum {
    off-topic,
    too-heated,
    resolved,
    spam,
  }

  enum list-milestones-sort-enum {
    due-on,
    completeness,
  }

  /// Issues are a great way to keep track of tasks, enhancements, and bugs for your projects.
  record issue {
    active-lock-reason: option<string>,
    assignee: nullable-simple-user,
    assignees: option<list<simple-user>>,
    author-association: author-association,
    /// Contents of the issue
    body: option<string>,
    body-html: option<string>,
    body-text: option<string>,
    closed-at: string,
    closed-by: option<nullable-simple-user>,
    comments: s32,
    comments-url: string,
    created-at: string,
    draft: option<bool>,
    events-url: string,
    html-url: string,
    id: s32,
    /// Labels to associate with this issue; pass one or more label names to replace the set of labels on this issue; send an empty array to clear all labels from the issue; note that the labels are silently dropped for users without push access to the repository
    labels: list<string>,
    labels-url: string,
    locked: bool,
    milestone: nullable-milestone,
    node-id: string,
    /// Number uniquely identifying the issue within its repository
    number: s32,
    performed-via-github-app: option<nullable-integration>,
    pull-request: option<issue-pull-request>,
    reactions: option<reaction-rollup>,
    repository: option<repository>,
    repository-url: string,
    /// State of the issue; either 'open' or 'closed'
    state: string,
    /// The reason for the current state
    state-reason: option<issue-state-reason-enum>,
    timeline-url: option<string>,
    /// Title of the issue
    title: string,
    updated-at: string,
    /// URL for the issue
    url: string,
    user: nullable-simple-user
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A collection of related issues and pull requests.
  record nullable-milestone {
    closed-at: string,
    closed-issues: s32,
    created-at: string,
    creator: nullable-simple-user,
    description: string,
    due-on: string,
    html-url: string,
    id: s32,
    labels-url: string,
    node-id: string,
    /// The number of the milestone.
    number: s32,
    open-issues: s32,
    /// The state of the milestone.
    state: nullable-milestone-state-enum,
    /// The title of the milestone.
    title: string,
    updated-at: string,
    url: string
  }

  /// GitHub apps are a new way to extend GitHub. They can be installed directly on organizations and user accounts and granted access to specific repositories. They come with granular permissions and built-in webhooks. GitHub apps are first class actors within GitHub.
  record nullable-integration {
    client-id: option<string>,
    client-secret: option<string>,
    created-at: string,
    description: string,
    /// The list of events for the GitHub app
    events: list<string>,
    external-url: string,
    html-url: string,
    /// Unique identifier of the GitHub app
    id: s32,
    /// The number of installations associated with the GitHub app
    installations-count: option<s32>,
    /// The name of the GitHub app
    name: string,
    node-id: string,
    owner: nullable-simple-user,
    pem: option<string>,
    /// The set of permissions for the GitHub app
    permissions: nullable-integration-permissions,
    /// The slug name of the GitHub app
    slug: option<string>,
    updated-at: string,
    webhook-secret: option<string>
  }

  /// The set of permissions for the GitHub app
  record nullable-integration-permissions {
    checks: option<string>,
    contents: option<string>,
    deployments: option<string>,
    issues: option<string>,
    metadata: option<string>
  }

  record issue-pull-request {
    diff-url: string,
    html-url: string,
    merged-at: option<string>,
    patch-url: string,
    url: string
  }

  record reaction-rollup {
    v1: s32,
    v1-v2: s32,
    confused: s32,
    eyes: s32,
    heart: s32,
    hooray: s32,
    laugh: s32,
    rocket: s32,
    total-count: s32,
    url: string
  }

  /// A repository on GitHub.
  record repository {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow forking this repo
    allow-forking: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is enabled for this repository
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    /// Whether the repository is archived.
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: string,
    /// The default branch of the repository.
    default-branch: string,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    /// Returns whether or not this repository disabled.
    disabled: bool,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: s32,
    forks-count: s32,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: string,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: bool,
    /// Whether issues are enabled.
    has-issues: bool,
    has-pages: bool,
    /// Whether projects are enabled.
    has-projects: bool,
    /// Whether the wiki is enabled.
    has-wiki: bool,
    homepage: string,
    hooks-url: string,
    html-url: string,
    /// Unique identifier of the repository
    id: s32,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: string,
    languages-url: string,
    license: nullable-license-simple,
    master-branch: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: string,
    milestones-url: string,
    mirror-url: string,
    /// The name of the repository.
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: s32,
    open-issues-count: s32,
    organization: option<nullable-simple-user>,
    owner: simple-user,
    permissions: option<repository-permissions>,
    /// Whether the repository is private or public.
    private: bool,
    pulls-url: string,
    pushed-at: string,
    releases-url: string,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: s32,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: string,
    stargazers-count: s32,
    stargazers-url: string,
    starred-at: option<string>,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: string,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    template-repository: option<repository-template-repository>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: string,
    url: string,
    /// Whether a squash merge commit can use the pull request title as default. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The repository visibility: public, private, or internal.
    visibility: option<string>,
    watchers: s32,
    watchers-count: s32,
    /// Whether to require contributors to sign off on web-based commits
    web-commit-signoff-required: option<bool>
  }

  /// License Simple
  record nullable-license-simple {
    html-url: option<string>,
    key: string,
    name: string,
    node-id: string,
    spdx-id: string,
    url: string
  }

  record repository-permissions {
    admin: bool,
    maintain: option<bool>,
    pull: bool,
    push: bool,
    triage: option<bool>
  }

  record repository-template-repository {
    allow-auto-merge: option<bool>,
    allow-merge-commit: option<bool>,
    allow-rebase-merge: option<bool>,
    allow-squash-merge: option<bool>,
    allow-update-branch: option<bool>,
    archive-url: option<string>,
    archived: option<bool>,
    assignees-url: option<string>,
    blobs-url: option<string>,
    branches-url: option<string>,
    clone-url: option<string>,
    collaborators-url: option<string>,
    comments-url: option<string>,
    commits-url: option<string>,
    compare-url: option<string>,
    contents-url: option<string>,
    contributors-url: option<string>,
    created-at: option<string>,
    default-branch: option<string>,
    delete-branch-on-merge: option<bool>,
    deployments-url: option<string>,
    description: option<string>,
    disabled: option<bool>,
    downloads-url: option<string>,
    events-url: option<string>,
    fork: option<bool>,
    forks-count: option<s32>,
    forks-url: option<string>,
    full-name: option<string>,
    git-commits-url: option<string>,
    git-refs-url: option<string>,
    git-tags-url: option<string>,
    git-url: option<string>,
    has-downloads: option<bool>,
    has-issues: option<bool>,
    has-pages: option<bool>,
    has-projects: option<bool>,
    has-wiki: option<bool>,
    homepage: option<string>,
    hooks-url: option<string>,
    html-url: option<string>,
    id: option<s32>,
    is-template: option<bool>,
    issue-comment-url: option<string>,
    issue-events-url: option<string>,
    issues-url: option<string>,
    keys-url: option<string>,
    labels-url: option<string>,
    language: option<string>,
    languages-url: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: option<string>,
    milestones-url: option<string>,
    mirror-url: option<string>,
    name: option<string>,
    network-count: option<s32>,
    node-id: option<string>,
    notifications-url: option<string>,
    open-issues-count: option<s32>,
    owner: option<repository-template-repository-owner>,
    permissions: option<repository-template-repository-permissions>,
    private: option<bool>,
    pulls-url: option<string>,
    pushed-at: option<string>,
    releases-url: option<string>,
    size: option<s32>,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: option<string>,
    stargazers-count: option<s32>,
    stargazers-url: option<string>,
    statuses-url: option<string>,
    subscribers-count: option<s32>,
    subscribers-url: option<string>,
    subscription-url: option<string>,
    svn-url: option<string>,
    tags-url: option<string>,
    teams-url: option<string>,
    temp-clone-token: option<string>,
    topics: option<list<string>>,
    trees-url: option<string>,
    updated-at: option<string>,
    url: option<string>,
    use-squash-pr-title-as-default: option<bool>,
    visibility: option<string>,
    watchers-count: option<s32>
  }

  record repository-template-repository-owner {
    avatar-url: option<string>,
    events-url: option<string>,
    followers-url: option<string>,
    following-url: option<string>,
    gists-url: option<string>,
    gravatar-id: option<string>,
    html-url: option<string>,
    id: option<s32>,
    login: option<string>,
    node-id: option<string>,
    organizations-url: option<string>,
    received-events-url: option<string>,
    repos-url: option<string>,
    site-admin: option<bool>,
    starred-url: option<string>,
    subscriptions-url: option<string>,
    type-op: option<string>,
    url: option<string>
  }

  record repository-template-repository-permissions {
    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  /// Comments provide a way for people to collaborate on an issue.
  record issue-comment {
    author-association: author-association,
    /// Contents of the issue comment
    body: option<string>,
    body-html: option<string>,
    body-text: option<string>,
    created-at: string,
    html-url: string,
    /// Unique identifier of the issue comment
    id: s32,
    issue-url: string,
    node-id: string,
    performed-via-github-app: option<nullable-integration>,
    reactions: option<reaction-rollup>,
    updated-at: string,
    /// URL for the issue comment
    url: string,
    user: nullable-simple-user
  }

  /// Issue Event
  record issue-event {
    actor: nullable-simple-user,
    assignee: option<nullable-simple-user>,
    assigner: option<nullable-simple-user>,
    author-association: option<author-association>,
    commit-id: string,
    commit-url: string,
    created-at: string,
    dismissed-review: option<issue-event-dismissed-review>,
    event: string,
    id: s32,
    issue: option<nullable-issue>,
    label: option<issue-event-label>,
    lock-reason: option<string>,
    milestone: option<issue-event-milestone>,
    node-id: string,
    performed-via-github-app: option<nullable-integration>,
    project-card: option<issue-event-project-card>,
    rename: option<issue-event-rename>,
    requested-reviewer: option<nullable-simple-user>,
    requested-team: option<team>,
    review-requester: option<nullable-simple-user>,
    url: string
  }

  record issue-event-dismissed-review {
    dismissal-commit-id: option<string>,
    dismissal-message: string,
    review-id: s32,
    state: string
  }

  /// Issues are a great way to keep track of tasks, enhancements, and bugs for your projects.
  record nullable-issue {
    active-lock-reason: option<string>,
    assignee: nullable-simple-user,
    assignees: option<list<simple-user>>,
    author-association: author-association,
    /// Contents of the issue
    body: option<string>,
    body-html: option<string>,
    body-text: option<string>,
    closed-at: string,
    closed-by: option<nullable-simple-user>,
    comments: s32,
    comments-url: string,
    created-at: string,
    draft: option<bool>,
    events-url: string,
    html-url: string,
    id: s32,
    /// Labels to associate with this issue; pass one or more label names to replace the set of labels on this issue; send an empty array to clear all labels from the issue; note that the labels are silently dropped for users without push access to the repository
    labels: list<string>,
    labels-url: string,
    locked: bool,
    milestone: nullable-milestone,
    node-id: string,
    /// Number uniquely identifying the issue within its repository
    number: s32,
    performed-via-github-app: option<nullable-integration>,
    pull-request: option<nullable-issue-pull-request>,
    reactions: option<reaction-rollup>,
    repository: option<repository>,
    repository-url: string,
    /// State of the issue; either 'open' or 'closed'
    state: string,
    /// The reason for the current state
    state-reason: option<issue-state-reason-enum>,
    timeline-url: option<string>,
    /// Title of the issue
    title: string,
    updated-at: string,
    /// URL for the issue
    url: string,
    user: nullable-simple-user
  }

  record nullable-issue-pull-request {
    diff-url: string,
    html-url: string,
    merged-at: option<string>,
    patch-url: string,
    url: string
  }

  /// Issue Event Label
  record issue-event-label {
    color: string,
    name: string
  }

  /// Issue Event Milestone
  record issue-event-milestone {
    title: string
  }

  /// Issue Event Project Card
  record issue-event-project-card {
    column-name: string,
    id: s32,
    previous-column-name: option<string>,
    project-id: s32,
    project-url: string,
    url: string
  }

  /// Issue Event Rename
  record issue-event-rename {
    from-op: string,
    to: string
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record team {
    description: string,
    html-url: string,
    id: s32,
    members-url: string,
    name: string,
    node-id: string,
    parent: nullable-team-simple,
    permission: string,
    permissions: option<team-permissions>,
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    url: string
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record nullable-team-simple {
    /// Description of the team
    description: string,
    html-url: string,
    /// Unique identifier of the team
    id: s32,
    /// Distinguished Name (DN) that team maps to within LDAP environment
    ldap-dn: option<string>,
    members-url: string,
    /// Name of the team
    name: string,
    node-id: string,
    /// Permission that the team will have for its repositories
    permission: string,
    /// The level of privacy this team should have
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    /// URL for the team
    url: string
  }

  record team-permissions {
    admin: bool,
    maintain: bool,
    pull: bool,
    push: bool,
    triage: bool
  }

  /// Color-coded labels help you categorize and filter your issues (just like labels in Gmail).
  record label {
    /// 6-character hex code, without the leading #, identifying the color
    color: string,
    default: bool,
    description: string,
    id: s64,
    /// The name of the label.
    name: string,
    node-id: string,
    /// URL for the label
    url: string
  }

  /// Timeline Event
  record timeline-issue-events {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A collection of related issues and pull requests.
  record milestone {
    closed-at: string,
    closed-issues: s32,
    created-at: string,
    creator: nullable-simple-user,
    description: string,
    due-on: string,
    html-url: string,
    id: s32,
    labels-url: string,
    node-id: string,
    /// The number of the milestone.
    number: s32,
    open-issues: s32,
    /// The state of the milestone.
    state: nullable-milestone-state-enum,
    /// The title of the milestone.
    title: string,
    updated-at: string,
    url: string
  }

  variant list-op-error {
    not-modified(string),
    not-found(string),
