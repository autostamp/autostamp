  /// Groups of organization members that gives permissions on specified repositories.
  record team-simple {
    /// Description of the team
    description: string,
    html-url: string,
    /// Unique identifier of the team
    id: s32,
    /// Distinguished Name (DN) that team maps to within LDAP environment
    ldap-dn: option<string>,
    members-url: string,
    /// Name of the team
    name: string,
    node-id: string,
    /// Permission that the team will have for its repositories
    permission: string,
    /// The level of privacy this team should have
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    /// URL for the team
    url: string
  }

  /// Pull Request Review Comments are comments on a portion of the Pull Request's diff.
  record pull-request-review-comment {
    links: pull-request-review-comment-links,
    author-association: author-association,
    /// The text of the comment.
    body: string,
    body-html: option<string>,
    body-text: option<string>,
    /// The SHA of the commit to which the comment applies.
    commit-id: string,
    created-at: string,
    /// The diff of the line that the comment refers to.
    diff-hunk: string,
    /// HTML URL for the pull request review comment.
    html-url: string,
    /// The ID of the pull request review comment.
    id: s32,
    /// The comment ID to reply to.
    in-reply-to-id: option<s32>,
    /// The line of the blob to which the comment applies. The last line of the range for a multi-line comment
    line: option<s32>,
    /// The node ID of the pull request review comment.
    node-id: string,
    /// The SHA of the original commit to which the comment applies.
    original-commit-id: string,
    /// The line of the blob to which the comment applies. The last line of the range for a multi-line comment
    original-line: option<s32>,
    /// The index of the original line in the diff to which the comment applies. This field is deprecated; use `original_line` instead.
    original-position: s32,
    /// The first line of the range for a multi-line comment.
    original-start-line: option<s32>,
    /// The relative path of the file to which the comment applies.
    path: string,
    /// The line index in the diff to which the comment applies. This field is deprecated; use `line` instead.
    position: s32,
    /// The ID of the pull request review to which the comment belongs.
    pull-request-review-id: s32,
    /// URL for the pull request that the review comment belongs to.
    pull-request-url: string,
    reactions: option<reaction-rollup>,
    /// The side of the diff to which the comment applies. The side of the last line of the range for a multi-line comment
    side: option<pull-request-review-comment-side-enum>,
    /// The first line of the range for a multi-line comment.
    start-line: option<s32>,
    /// The side of the first line of the range for a multi-line comment.
    start-side: option<pull-request-review-comment-side-enum>,
    updated-at: string,
    /// URL for the pull request review comment
    url: string,
    user: simple-user
  }

  record pull-request-review-comment-links {
    html: pull-request-review-comment-links-html,
    pull-request: pull-request-review-comment-links-pull-request,
    self: pull-request-review-comment-links-self
  }

  record pull-request-review-comment-links-html {
    href: string
  }

  record pull-request-review-comment-links-pull-request {
    href: string
  }

  record pull-request-review-comment-links-self {
    href: string
  }

  record reaction-rollup {
    v1: s32,
    v1-v2: s32,
    confused: s32,
    eyes: s32,
    heart: s32,
    hooray: s32,
    laugh: s32,
    rocket: s32,
    total-count: s32,
    url: string
  }

  /// Commit
  record commit {
    author: nullable-simple-user,
    comments-url: string,
    commit: commit-commit,
    committer: nullable-simple-user,
    files: option<list<diff-entry>>,
    html-url: string,
    node-id: string,
    parents: list<commit-parents-item>,
    sha: string,
    stats: option<commit-stats>,
    url: string
  }

  record commit-commit {
    author: nullable-git-user,
    comment-count: s32,
    committer: nullable-git-user,
    message: string,
    tree: commit-commit-tree,
    url: string,
    verification: option<verification>
  }

  /// Metaproperties for Git author/committer information.
  record nullable-git-user {
    date: option<string>,
    email: option<string>,
    name: option<string>
  }

  record commit-commit-tree {
    sha: string,
    url: string
  }

  record verification {
    payload: string,
    reason: string,
    signature: string,
    verified: bool
  }

  /// Diff Entry
  record diff-entry {
    additions: s32,
    blob-url: string,
    changes: s32,
    contents-url: string,
    deletions: s32,
    filename: string,
    patch: option<string>,
    previous-filename: option<string>,
    raw-url: string,
    sha: string,
    status: diff-entry-status-enum
  }

  record commit-parents-item {
    html-url: option<string>,
    sha: string,
    url: string
  }

  record commit-stats {
    additions: option<s32>,
    deletions: option<s32>,
    total: option<s32>
  }

  /// Pull Request Merge Result
  record pull-request-merge-result {
    merged: bool,
    message: string,
    sha: string
  }

  /// Pull Request Review Request
  record pull-request-review-request {
    teams: list<team>,
    users: list<simple-user>
  }

  /// Pull Request Reviews are reviews on pull requests.
  record pull-request-review {
    links: pull-request-review-links,
    author-association: author-association,
    /// The text of the review.
    body: string,
    body-html: option<string>,
    body-text: option<string>,
    /// A commit SHA for the review. If the commit object was garbage collected or forcibly deleted, then it no longer exists in Git and this value will be `null`.
    commit-id: string,
    html-url: string,
    /// Unique identifier of the review
    id: s32,
    node-id: string,
    pull-request-url: string,
    state: string,
    submitted-at: option<string>,
    user: nullable-simple-user
  }

  record pull-request-review-links {
    html: pull-request-review-links-html,
    pull-request: pull-request-review-links-pull-request
  }

  record pull-request-review-links-html {
    href: string
  }

  record pull-request-review-links-pull-request {
    href: string
  }

  record create-review-body-comments-item {
    /// Text of the review comment.
    body: string,
    line: option<s32>,
    /// The relative path to the file that necessitates a review comment.
    path: string,
    /// The position in the diff where you want to add a review comment. Note this value is not the same as the line number in the file. For help finding the position value, read the note below.
    position: option<s32>,
    side: option<string>,
    start-line: option<s32>,
    start-side: option<string>
  }

  /// Legacy Review Comment
  record review-comment {
    links: review-comment-links,
    author-association: author-association,
    body: string,
    body-html: option<string>,
    body-text: option<string>,
    commit-id: string,
    created-at: string,
    diff-hunk: string,
    html-url: string,
    id: s32,
    in-reply-to-id: option<s32>,
    /// The line of the blob to which the comment applies. The last line of the range for a multi-line comment
    line: option<s32>,
    node-id: string,
    original-commit-id: string,
    /// The original line of the blob to which the comment applies. The last line of the range for a multi-line comment
    original-line: option<s32>,
    original-position: s32,
    /// The original first line of the range for a multi-line comment.
    original-start-line: option<s32>,
    path: string,
    position: s32,
    pull-request-review-id: s32,
    pull-request-url: string,
    reactions: option<reaction-rollup>,
    /// The side of the first line of the range for a multi-line comment.
    side: option<pull-request-review-comment-side-enum>,
    /// The first line of the range for a multi-line comment.
    start-line: option<s32>,
    /// The side of the first line of the range for a multi-line comment.
    start-side: option<pull-request-review-comment-side-enum>,
    updated-at: string,
    url: string,
    user: nullable-simple-user
  }

  record review-comment-links {
    html: link,
    pull-request: link,
    self: link
  }

  record update-branch-response {
    message: option<string>,
    url: option<string>
  }

  variant list-op-error {
    not-modified(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-error {
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-review-comment-error {
    not-found(string),
    other(string)
  }

  variant delete-review-comment-error {
    not-found(string),
    other(string)
  }

  variant get-error {
    not-modified(string),
    not-found(string),
    internal-server-error(string),
    service-unavailable(string),
    other(string)
  }

  variant update-error {
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-review-comment-error {
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-reply-for-review-comment-error {
    not-found(string),
    other(string)
  }

  variant list-files-error {
    unprocessable-entity(string),
    internal-server-error(string),
    service-unavailable(string),
    other(string)
  }

  variant check-if-merged-error {
    not-found(string),
    other(string)
  }

  variant merge-error {
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    conflict(string),
    unprocessable-entity(string),
    other(string)
  }

  variant request-reviewers-error {
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant remove-requested-reviewers-error {
    unprocessable-entity(string),
    other(string)
  }

  variant create-review-error {
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-review-error {
    not-found(string),
    other(string)
  }

  variant update-review-error {
    unprocessable-entity(string),
    other(string)
  }

  variant delete-pending-review-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant list-comments-for-review-error {
    not-found(string),
    other(string)
  }

  variant dismiss-review-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant submit-review-error {
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant update-branch-error {
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  /// List pull requests
  record list-op-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Either `open`, `closed`, or `all` to filter by state.
    state: option<list-op-state-enum>,
    /// Filter pulls by head user or head organization and branch name in the format of `user:ref-name` or `organization:ref-name`. For example: `github:new-script-format` or `octocat:test-branch`.
    head: option<string>,
    /// Filter pulls by base branch name. Example: `gh-pages`.
    base: option<string>,
    /// What to sort results by. `popularity` will sort by the number of comments. `long-running` will sort by date created and will limit the results to pull requests that have been open for more than a month and have had activity within the past month.
    sort: option<list-op-sort-enum>,
    /// The direction of the sort. Default: `desc` when sort is `created` or sort is not specified, otherwise `asc`.
    direction: option<list-op-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list<pull-request-simple>, list-op-error>;

  /// Create a pull request
  record create-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the branch you want the changes pulled into. This should be an existing branch on the current repository. You cannot submit a pull request to one repository that requests a merge to a base of another repository.
    base: string,
    /// The contents of the pull request.
    body: option<string>,
    /// Indicates whether the pull request is a draft. See "[Draft Pull Requests](https://docs.github.com/articles/about-pull-requests#draft-pull-requests)" in the GitHub Help documentation to learn more.
    draft: option<bool>,
    /// The name of the branch where your changes are implemented. For cross-repository pull requests in the same network, namespace `head` with a user like this: `username:branch`.
    head: string,
    /// The name of the repository where the changes in the pull request were made. This field is required for cross-repository pull requests if both repositories are owned by the same organization.
    head-repo: option<string>,
    /// An issue in the repository to convert to a pull request. The issue title, body, and comments will become the title, body, and comments on the new pull request. Required unless `title` is specified.
    issue: option<s32>,
    /// Indicates whether [maintainers can modify](https://docs.github.com/articles/allowing-changes-to-a-pull-request-branch-created-from-a-fork/) the pull request.
    maintainer-can-modify: option<bool>,
    /// The title of the new pull request. Required unless `issue` is specified.
    title: option<string>
  }
  create: func(params: create-params) -> result<pull-request, create-error>;

  /// List review comments in a repository
  record list-review-comments-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    sort: option<list-review-comments-for-repo-sort-enum>,
    /// The direction to sort results. Ignored without `sort` parameter.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-review-comments-for-repo: func(params: list-review-comments-for-repo-params) -> result<list<pull-request-review-comment>, string>;

  /// Get a review comment for a pull request
  record get-review-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  get-review-comment: func(params: get-review-comment-params) -> result<pull-request-review-comment, get-review-comment-error>;

  /// Update a review comment for a pull request
  record update-review-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string,
    /// The text of the reply to the review comment.
    body: string
  }
  update-review-comment: func(params: update-review-comment-params) -> result<pull-request-review-comment, string>;

  /// Delete a review comment for a pull request
  record delete-review-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  delete-review-comment: func(params: delete-review-comment-params) -> result<string, delete-review-comment-error>;

  /// Get a pull request
  record get-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string
  }
  get: func(params: get-params) -> result<pull-request, get-error>;

  /// Update a pull request
  record update-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The name of the branch you want your changes pulled into. This should be an existing branch on the current repository. You cannot update the base branch on a pull request to point to another repository.
    base: option<string>,
    /// The contents of the pull request.
    body: option<string>,
    /// Indicates whether [maintainers can modify](https://docs.github.com/articles/allowing-changes-to-a-pull-request-branch-created-from-a-fork/) the pull request.
    maintainer-can-modify: option<bool>,
    /// State of this Pull Request. Either `open` or `closed`.
    state: option<nullable-milestone-state-enum>,
    /// The title of the pull request.
    title: option<string>
  }
  update: func(params: update-params) -> result<pull-request, update-error>;

  /// List review comments on a pull request
  record list-review-comments-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-review-comments-sort-enum>,
    /// The direction to sort results. Ignored without `sort` parameter.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-review-comments: func(params: list-review-comments-params) -> result<list<pull-request-review-comment>, string>;

  /// Create a review comment for a pull request
  record create-review-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The text of the review comment.
    body: string,
    /// The SHA of the commit needing a comment. Not using the latest commit SHA may render your comment outdated if a subsequent commit modifies the line you specify as the `position`.
    commit-id: string,
    /// The ID of the review comment to reply to. To find the ID of a review comment with ["List review comments on a pull request"](#list-review-comments-on-a-pull-request). When specified, all parameters other than `body` in the request body are ignored.
    in-reply-to: option<s32>,
    /// The line of the blob in the pull request diff that the comment applies to. For a multi-line comment, the last line of the range that your comment applies to.
    line: s32,
    /// The relative path to the file that necessitates a comment.
    path: string,
    /// **This parameter is deprecated. Use `line` instead**. The position in the diff where you want to add a review comment. Note this value is not the same as the line number in the file. For help finding the position value, read the note above.
    position: option<s32>,
    /// In a split diff view, the side of the diff that the pull request's changes appear on. Can be `LEFT` or `RIGHT`. Use `LEFT` for deletions that appear in red. Use `RIGHT` for additions that appear in green or unchanged lines that appear in white and are shown for context. For a multi-line comment, side represents whether the last line of the comment range is a deletion or addition. For more information, see "[Diff view options](https://docs.github.com/articles/about-comparing-branches-in-pull-requests#diff-view-options)" in the GitHub Help documentation.
    side: option<pull-request-review-comment-side-enum>,
    /// **Required when using multi-line comments unless using `in_reply_to`**. The `start_line` is the first line in the pull request diff that your multi-line comment applies to. To learn more about multi-line comments, see "[Commenting on a pull request](https://docs.github.com/articles/commenting-on-a-pull-request#adding-line-comments-to-a-pull-request)" in the GitHub Help documentation.
    start-line: option<s32>,
    /// **Required when using multi-line comments unless using `in_reply_to`**. The `start_side` is the starting side of the diff that the comment applies to. Can be `LEFT` or `RIGHT`. To learn more about multi-line comments, see "[Commenting on a pull request](https://docs.github.com/articles/commenting-on-a-pull-request#adding-line-comments-to-a-pull-request)" in the GitHub Help documentation. See `side` in this table for additional context.
    start-side: option<create-review-comment-body-start-side-enum>
  }
  create-review-comment: func(params: create-review-comment-params) -> result<pull-request-review-comment, create-review-comment-error>;

  /// Create a reply for a review comment
  record create-reply-for-review-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The unique identifier of the comment.
    comment-id: string,
    /// The text of the review comment.
    body: string
  }
  create-reply-for-review-comment: func(params: create-reply-for-review-comment-params) -> result<pull-request-review-comment, create-reply-for-review-comment-error>;

  /// List commits on a pull request
  record list-commits-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-commits: func(params: list-commits-params) -> result<list<commit>, string>;

  /// List pull requests files
  record list-files-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-files: func(params: list-files-params) -> result<list<diff-entry>, list-files-error>;

  /// Check if a pull request has been merged
  record check-if-merged-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string
  }
  check-if-merged: func(params: check-if-merged-params) -> result<string, check-if-merged-error>;

  /// Merge a pull request
  record merge-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// Extra detail to append to automatic commit message.
    commit-message: option<string>,
    /// Title for the automatic commit message.
    commit-title: option<string>,
    /// The merge method to use.
    merge-method: option<auto-merge-merge-method-enum>,
    /// SHA that pull request head must match to allow merge.
    sha: option<string>
  }
  merge: func(params: merge-params) -> result<pull-request-merge-result, merge-error>;

  /// Get all requested reviewers for a pull request
  record list-requested-reviewers-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string
  }
  list-requested-reviewers: func(params: list-requested-reviewers-params) -> result<pull-request-review-request, string>;

  /// Request reviewers for a pull request
  record request-reviewers-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// An array of user `login`s that will be requested.
    reviewers: option<list<string>>,
    /// An array of team `slug`s that will be requested.
    team-reviewers: option<list<string>>
  }
  request-reviewers: func(params: request-reviewers-params) -> result<pull-request-simple, request-reviewers-error>;

  /// Remove requested reviewers from a pull request
  record remove-requested-reviewers-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// An array of user `login`s that will be removed.
    reviewers: list<string>,
    /// An array of team `slug`s that will be removed.
    team-reviewers: option<list<string>>
  }
  remove-requested-reviewers: func(params: remove-requested-reviewers-params) -> result<pull-request-simple, remove-requested-reviewers-error>;

  /// List reviews for a pull request
  record list-reviews-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-reviews: func(params: list-reviews-params) -> result<list<pull-request-review>, string>;

  /// Create a review for a pull request
  record create-review-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// **Required** when using `REQUEST_CHANGES` or `COMMENT` for the `event` parameter. The body text of the pull request review.
    body: option<string>,
    /// Use the following table to specify the location, destination, and contents of the draft review comment.
    comments: option<list<create-review-body-comments-item>>,
    /// The SHA of the commit that needs a review. Not using the latest commit SHA may render your review comment outdated if a subsequent commit modifies the line you specify as the `position`. Defaults to the most recent commit in the pull request when you do not specify a value.
    commit-id: option<string>,
    /// The review action you want to perform. The review actions include: `APPROVE`, `REQUEST_CHANGES`, or `COMMENT`. By leaving this blank, you set the review action state to `PENDING`, which means you will need to [submit the pull request review](https://docs.github.com/rest/pulls#submit-a-review-for-a-pull-request) when you are ready.
    event: option<create-review-body-event-enum>
  }
  create-review: func(params: create-review-params) -> result<pull-request-review, create-review-error>;

  /// Get a review for a pull request
  record get-review-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The unique identifier of the review.
    review-id: string
  }
  get-review: func(params: get-review-params) -> result<pull-request-review, get-review-error>;

  /// Update a review for a pull request
  record update-review-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The unique identifier of the review.
    review-id: string,
    /// The body text of the pull request review.
    body: string
  }
  update-review: func(params: update-review-params) -> result<pull-request-review, update-review-error>;

  /// Delete a pending review for a pull request
  record delete-pending-review-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The unique identifier of the review.
    review-id: string
  }
  delete-pending-review: func(params: delete-pending-review-params) -> result<pull-request-review, delete-pending-review-error>;

  /// List comments for a pull request review
  record list-comments-for-review-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The unique identifier of the review.
    review-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-comments-for-review: func(params: list-comments-for-review-params) -> result<list<review-comment>, list-comments-for-review-error>;

  /// Dismiss a review for a pull request
  record dismiss-review-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The unique identifier of the review.
    review-id: string,
    event: option<dismiss-review-body-event-enum>,
    /// The message for the pull request review dismissal
    message: string
  }
  dismiss-review: func(params: dismiss-review-params) -> result<pull-request-review, dismiss-review-error>;

  /// Submit a review for a pull request
  record submit-review-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The unique identifier of the review.
    review-id: string,
    /// The body text of the pull request review
    body: option<string>,
    /// The review action you want to perform. The review actions include: `APPROVE`, `REQUEST_CHANGES`, or `COMMENT`. When you leave this blank, the API returns _HTTP 422 (Unrecognizable entity)_ and sets the review action state to `PENDING`, which means you will need to re-submit the pull request review using a review action.
    event: create-review-body-event-enum
  }
  submit-review: func(params: submit-review-params) -> result<pull-request-review, submit-review-error>;

  /// Update a pull request branch
  record update-branch-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// The expected SHA of the pull request's HEAD ref. This is the most recent commit on the pull request's branch. If the expected SHA does not match the pull request's HEAD, you will receive a `422 Unprocessable Entity` status. You can use the "[List commits](https://docs.github.com/rest/reference/repos#list-commits)" endpoint to find the most recent commit SHA. Default: SHA of the pull request's current HEAD ref.
    expected-head-sha: option<string>
  }
  update-branch: func(params: update-branch-params) -> result<update-branch-response, update-branch-error>;

}

interface search {
  enum code-sort-enum {
    indexed,
  }

  enum code-order-enum {
    desc,
    asc,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum commits-sort-enum {
    author-date,
    committer-date,
  }

  enum issues-and-pull-requests-sort-enum {
    comments,
    reactions,
    reactions-v1,
    reactions-v1-v2,
    reactions-smile,
    reactions-thinking-face,
    reactions-heart,
    reactions-tada,
    interactions,
    created,
    updated,
  }

  enum author-association {
    collaborator,
    contributor,
    first-timer,
    first-time-contributor,
    mannequin,
    member,
    none,
    owner,
  }

  enum nullable-milestone-state-enum {
    open,
    closed,
  }

  enum repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  enum labels-sort-enum {
    created,
    updated,
  }

  enum repos-sort-enum {
    stars,
    forks,
    help-wanted-issues,
    updated,
  }

  enum users-sort-enum {
    followers,
    repositories,
    joined,
  }

  record code-response {
    incomplete-results: bool,
    items: list<code-search-result-item>,
    total-count: s32
  }

  /// Code Search Result Item
  record code-search-result-item {
    file-size: option<s32>,
    git-url: string,
    html-url: string,
    language: option<string>,
    last-modified-at: option<string>,
    line-numbers: option<list<string>>,
    name: string,
    path: string,
    repository: minimal-repository,
    score: f64,
    sha: string,
    text-matches: option<list<result-text-matches-item>>,
    url: string
  }

  /// Minimal Repository
  record minimal-repository {
    allow-forking: option<bool>,
    archive-url: string,
    archived: option<bool>,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: option<string>,
    code-of-conduct: option<code-of-conduct>,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: option<string>,
    default-branch: option<string>,
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    disabled: option<bool>,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: option<s32>,
    forks-count: option<s32>,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: option<string>,
    has-discussions: option<bool>,
    has-downloads: option<bool>,
    has-issues: option<bool>,
    has-pages: option<bool>,
    has-projects: option<bool>,
    has-wiki: option<bool>,
    homepage: option<string>,
    hooks-url: string,
    html-url: string,
    id: s32,
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: option<string>,
    languages-url: string,
    license: option<minimal-repository-license>,
    merges-url: string,
    milestones-url: string,
    mirror-url: option<string>,
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: option<s32>,
    open-issues-count: option<s32>,
    owner: simple-user,
    permissions: option<minimal-repository-permissions>,
    private: bool,
    pulls-url: string,
    pushed-at: option<string>,
    releases-url: string,
    role-name: option<string>,
    security-and-analysis: option<security-and-analysis>,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: option<s32>,
    ssh-url: option<string>,
    stargazers-count: option<s32>,
    stargazers-url: string,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: option<string>,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: option<string>,
    url: string,
    visibility: option<string>,
    watchers: option<s32>,
    watchers-count: option<s32>,
    web-commit-signoff-required: option<bool>
  }

  /// Code Of Conduct
  record code-of-conduct {
    body: option<string>,
    html-url: string,
    key: string,
    name: string,
    url: string
  }

  record minimal-repository-license {
    key: option<string>,
    name: option<string>,
    node-id: option<string>,
    spdx-id: option<string>,
    url: option<string>
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record minimal-repository-permissions {
    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  record security-and-analysis {
    advanced-security: option<security-and-analysis-advanced-security>,
    secret-scanning: option<security-and-analysis-secret-scanning>,
    secret-scanning-push-protection: option<security-and-analysis-secret-scanning-push-protection>
  }

  record security-and-analysis-advanced-security {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning-push-protection {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record result-text-matches-item {
    fragment: option<string>,
    matches: option<list<result-text-matches-item-matches-item>>,
    object-type: option<string>,
    object-url: option<string>,
    property: option<string>
  }

  record result-text-matches-item-matches-item {
    indices: option<list<s32>>,
    text: option<string>
  }

  record commits-response {
    incomplete-results: bool,
    items: list<commit-search-result-item>,
    total-count: s32
  }

  /// Commit Search Result Item
  record commit-search-result-item {
    author: nullable-simple-user,
    comments-url: string,
    commit: commit-search-result-item-commit,
    committer: nullable-git-user,
    html-url: string,
    node-id: string,
    parents: list<commit-search-result-item-parents-item>,
    repository: minimal-repository,
    score: f64,
    sha: string,
    text-matches: option<list<result-text-matches-item-v2>>,
    url: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record commit-search-result-item-commit {
    author: commit-search-result-item-commit-author,
    comment-count: s32,
    committer: nullable-git-user,
    message: string,
    tree: commit-search-result-item-commit-tree,
    url: string,
    verification: option<verification>
  }

  record commit-search-result-item-commit-author {
    date: string,
    email: string,
    name: string
  }

  /// Metaproperties for Git author/committer information.
  record nullable-git-user {
    date: option<string>,
    email: option<string>,
    name: option<string>
  }

  record commit-search-result-item-commit-tree {
    sha: string,
    url: string
  }

  record verification {
    payload: string,
    reason: string,
    signature: string,
    verified: bool
  }

  record commit-search-result-item-parents-item {
    html-url: option<string>,
    sha: option<string>,
    url: option<string>
  }

  record result-text-matches-item-v2 {
    fragment: option<string>,
    matches: option<list<result-text-matches-item-v2-matches-item>>,
    object-type: option<string>,
    object-url: option<string>,
    property: option<string>
  }

  record result-text-matches-item-v2-matches-item {
    indices: option<list<s32>>,
    text: option<string>
  }

  record issues-and-pull-requests-response {
    incomplete-results: bool,
    items: list<issue-search-result-item>,
    total-count: s32
  }

  /// Issue Search Result Item
  record issue-search-result-item {
    active-lock-reason: option<string>,
    assignee: nullable-simple-user,
    assignees: option<list<simple-user>>,
    author-association: author-association,
    body: option<string>,
    body-html: option<string>,
    body-text: option<string>,
    closed-at: string,
    comments: s32,
    comments-url: string,
    created-at: string,
    draft: option<bool>,
    events-url: string,
    html-url: string,
    id: s32,
    labels: list<issue-search-result-item-labels-item>,
    labels-url: string,
    locked: bool,
    milestone: nullable-milestone,
    node-id: string,
    number: s32,
    performed-via-github-app: option<nullable-integration>,
    pull-request: option<issue-search-result-item-pull-request>,
    reactions: option<reaction-rollup>,
    repository: option<repository>,
    repository-url: string,
    score: f64,
    state: string,
    state-reason: option<string>,
    text-matches: option<list<result-text-matches-item-v3>>,
    timeline-url: option<string>,
    title: string,
    updated-at: string,
    url: string,
    user: nullable-simple-user
  }

  record issue-search-result-item-labels-item {
    color: option<string>,
    default: option<bool>,
    description: option<string>,
    id: option<s64>,
    name: option<string>,
    node-id: option<string>,
    url: option<string>
  }

  /// A collection of related issues and pull requests.
  record nullable-milestone {
    closed-at: string,
    closed-issues: s32,
    created-at: string,
    creator: nullable-simple-user,
    description: string,
    due-on: string,
    html-url: string,
    id: s32,
    labels-url: string,
    node-id: string,
    /// The number of the milestone.
    number: s32,
    open-issues: s32,
    /// The state of the milestone.
    state: nullable-milestone-state-enum,
    /// The title of the milestone.
    title: string,
    updated-at: string,
    url: string
  }

  /// GitHub apps are a new way to extend GitHub. They can be installed directly on organizations and user accounts and granted access to specific repositories. They come with granular permissions and built-in webhooks. GitHub apps are first class actors within GitHub.
  record nullable-integration {
    client-id: option<string>,
    client-secret: option<string>,
    created-at: string,
    description: string,
    /// The list of events for the GitHub app
    events: list<string>,
    external-url: string,
    html-url: string,
    /// Unique identifier of the GitHub app
    id: s32,
    /// The number of installations associated with the GitHub app
    installations-count: option<s32>,
    /// The name of the GitHub app
    name: string,
    node-id: string,
    owner: nullable-simple-user,
    pem: option<string>,
    /// The set of permissions for the GitHub app
    permissions: nullable-integration-permissions,
    /// The slug name of the GitHub app
    slug: option<string>,
    updated-at: string,
    webhook-secret: option<string>
  }

  /// The set of permissions for the GitHub app
  record nullable-integration-permissions {
    checks: option<string>,
    contents: option<string>,
    deployments: option<string>,
    issues: option<string>,
    metadata: option<string>
  }

  record issue-search-result-item-pull-request {
    diff-url: string,
    html-url: string,
    merged-at: option<string>,
    patch-url: string,
    url: string
  }

  record reaction-rollup {
    v1: s32,
    v1-v2: s32,
    confused: s32,
    eyes: s32,
    heart: s32,
    hooray: s32,
    laugh: s32,
    rocket: s32,
    total-count: s32,
    url: string
  }

  /// A repository on GitHub.
  record repository {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow forking this repo
    allow-forking: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is enabled for this repository
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    /// Whether the repository is archived.
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: string,
    /// The default branch of the repository.
    default-branch: string,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    /// Returns whether or not this repository disabled.
    disabled: bool,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: s32,
    forks-count: s32,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: string,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: bool,
    /// Whether issues are enabled.
    has-issues: bool,
    has-pages: bool,
    /// Whether projects are enabled.
    has-projects: bool,
    /// Whether the wiki is enabled.
    has-wiki: bool,
    homepage: string,
    hooks-url: string,
    html-url: string,
    /// Unique identifier of the repository
    id: s32,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: string,
    languages-url: string,
    license: nullable-license-simple,
    master-branch: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: string,
    milestones-url: string,
    mirror-url: string,
    /// The name of the repository.
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: s32,
    open-issues-count: s32,
    organization: option<nullable-simple-user>,
    owner: simple-user,
    permissions: option<repository-permissions>,
    /// Whether the repository is private or public.
    private: bool,
    pulls-url: string,
    pushed-at: string,
    releases-url: string,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: s32,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: string,
    stargazers-count: s32,
    stargazers-url: string,
    starred-at: option<string>,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: string,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    template-repository: option<repository-template-repository>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: string,
    url: string,
    /// Whether a squash merge commit can use the pull request title as default. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The repository visibility: public, private, or internal.
    visibility: option<string>,
    watchers: s32,
    watchers-count: s32,
    /// Whether to require contributors to sign off on web-based commits
    web-commit-signoff-required: option<bool>
  }

  /// License Simple
  record nullable-license-simple {
    html-url: option<string>,
    key: string,
    name: string,
    node-id: string,
    spdx-id: string,
    url: string
  }

  record repository-permissions {
