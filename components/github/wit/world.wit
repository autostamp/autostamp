  list-stargazers-for-repo: func(params: list-stargazers-for-repo-params) -> result<string, string>;

  /// List watchers
  record list-watchers-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-watchers-for-repo: func(params: list-watchers-for-repo-params) -> result<string, string>;

  /// Get a repository subscription
  record get-repo-subscription-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-repo-subscription: func(params: get-repo-subscription-params) -> result<string, string>;

  /// Set a repository subscription
  record set-repo-subscription-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Determines if all notifications should be blocked from this repository.
    ignored: option<bool>,
    /// Determines if notifications should be received from this repository.
    subscribed: option<bool>
  }
  set-repo-subscription: func(params: set-repo-subscription-params) -> result<string, string>;

  /// Delete a repository subscription
  record delete-repo-subscription-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  delete-repo-subscription: func(params: delete-repo-subscription-params) -> result<string, string>;

  /// List repositories starred by the authenticated user
  record list-repos-starred-by-authenticated-user-params {
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-repos-starred-by-authenticated-user-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-repos-starred-by-authenticated-user-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-starred-by-authenticated-user: func(params: list-repos-starred-by-authenticated-user-params) -> result<string, string>;

  /// Check if a repository is starred by the authenticated user
  record check-repo-is-starred-by-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  check-repo-is-starred-by-authenticated-user: func(params: check-repo-is-starred-by-authenticated-user-params) -> result<string, string>;

  /// Star a repository for the authenticated user
  record star-repo-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  star-repo-for-authenticated-user: func(params: star-repo-for-authenticated-user-params) -> result<string, string>;

  /// Unstar a repository for the authenticated user
  record unstar-repo-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  unstar-repo-for-authenticated-user: func(params: unstar-repo-for-authenticated-user-params) -> result<string, string>;

  /// List repositories watched by the authenticated user
  record list-watched-repos-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-watched-repos-for-authenticated-user: func(params: list-watched-repos-for-authenticated-user-params) -> result<string, string>;

  /// List events for the authenticated user
  record list-events-for-authenticated-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-events-for-authenticated-user: func(params: list-events-for-authenticated-user-params) -> result<string, string>;

  /// List organization events for the authenticated user
  record list-org-events-for-authenticated-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-org-events-for-authenticated-user: func(params: list-org-events-for-authenticated-user-params) -> result<string, string>;

  /// List public events for a user
  record list-public-events-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-events-for-user: func(params: list-public-events-for-user-params) -> result<string, string>;

  /// List events received by the authenticated user
  record list-received-events-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-received-events-for-user: func(params: list-received-events-for-user-params) -> result<string, string>;

  /// List public events received by a user
  record list-received-public-events-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-received-public-events-for-user: func(params: list-received-public-events-for-user-params) -> result<string, string>;

  /// List repositories starred by a user
  record list-repos-starred-by-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-repos-starred-by-authenticated-user-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-repos-starred-by-authenticated-user-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-starred-by-user: func(params: list-repos-starred-by-user-params) -> result<string, string>;

  /// List repositories watched by a user
  record list-repos-watched-by-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-watched-by-user: func(params: list-repos-watched-by-user-params) -> result<string, string>;

}

interface gists {
  /// Names and content for the files that make up the gist
  record create-body-files {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The gist files to be updated, renamed, or deleted. Each `key` must match the current filename
  /// (including extension) of the targeted gist file. For example: `hello.py`.
  /// 
  /// To delete a file, set the whole file to null. For example: `hello.py : null`.
  record update-body-files {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List gists for the authenticated user
  record list-op-params {
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Create a gist
  record create-params {
    /// Description of the gist
    description: option<string>,
    /// Names and content for the files that make up the gist
    files: create-body-files,
    public: option<string>
  }
  create: func(params: create-params) -> result<string, string>;

  /// List public gists
  record list-public-params {
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public: func(params: list-public-params) -> result<string, string>;

  /// List starred gists
  record list-starred-params {
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-starred: func(params: list-starred-params) -> result<string, string>;

  /// Get a gist
  record get-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update a gist
  record update-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The description of the gist.
    description: option<string>,
    /// The gist files to be updated, renamed, or deleted. Each `key` must match the current filename
    /// (including extension) of the targeted gist file. For example: `hello.py`.
    files: option<update-body-files>
  }
  update: func(params: update-params) -> result<string, string>;

  /// Delete a gist
  record delete-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  delete: func(params: delete-params) -> result<string, string>;

  /// List gist comments
  record list-comments-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-comments: func(params: list-comments-params) -> result<string, string>;

  /// Create a gist comment
  record create-comment-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The comment text.
    body: string
  }
  create-comment: func(params: create-comment-params) -> result<string, string>;

  /// Get a gist comment
  record get-comment-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  get-comment: func(params: get-comment-params) -> result<string, string>;

  /// Update a gist comment
  record update-comment-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The unique identifier of the comment.
    comment-id: string,
    /// The comment text.
    body: string
  }
  update-comment: func(params: update-comment-params) -> result<string, string>;

  /// Delete a gist comment
  record delete-comment-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  delete-comment: func(params: delete-comment-params) -> result<string, string>;

  /// List gist commits
  record list-commits-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-commits: func(params: list-commits-params) -> result<string, string>;

  /// List gist forks
  record list-forks-params {
    /// The unique identifier of the gist.
    gist-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-forks: func(params: list-forks-params) -> result<string, string>;

  /// Fork a gist
  record fork-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  fork: func(params: fork-params) -> result<string, string>;

  /// Check if a gist is starred
  record check-is-starred-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  check-is-starred: func(params: check-is-starred-params) -> result<string, string>;

  /// Star a gist
  record star-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  star: func(params: star-params) -> result<string, string>;

  /// Unstar a gist
  record unstar-params {
    /// The unique identifier of the gist.
    gist-id: string
  }
  unstar: func(params: unstar-params) -> result<string, string>;

  /// Get a gist revision
  record get-revision-params {
    /// The unique identifier of the gist.
    gist-id: string,
    sha: string
  }
  get-revision: func(params: get-revision-params) -> result<string, string>;

  /// List gists for a user
  record list-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-user: func(params: list-for-user-params) -> result<string, string>;

}

interface gitignore {
  /// Get all gitignore templates
  get-all-templates: func() -> result<string, string>;

  /// Get a gitignore template
  record get-template-params {
    name: string
  }
  get-template: func(params: get-template-params) -> result<string, string>;

}

interface issues {
  enum list-op-filter-enum {
    assigned,
    created,
    mentioned,
    subscribed,
    repos,
    all,
  }

  enum list-op-state-enum {
    open,
    closed,
    all,
  }

  enum list-op-sort-enum {
    created,
    updated,
    comments,
  }

  enum list-op-direction-enum {
    asc,
    desc,
  }

  enum list-comments-for-repo-sort-enum {
    created,
    updated,
  }

  enum update-body-state-enum {
    open,
    closed,
  }

  enum update-body-state-reason-enum {
    completed,
    not-planned,
    reopened,
  }

  enum lock-body-lock-reason-enum {
    off-topic,
    too-heated,
    resolved,
    spam,
  }

  enum list-milestones-sort-enum {
    due-on,
    completeness,
  }

  /// List issues assigned to the authenticated user
  record list-op-params {
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<list-op-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<list-op-state-enum>,
    /// A list of comma separated label names. Example: `bug,ui,@high`
    labels: option<string>,
    /// What to sort results by.
    sort: option<list-op-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    collab: option<bool>,
    orgs: option<bool>,
    owned: option<bool>,
    pulls: option<bool>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// List organization issues assigned to the authenticated user
  record list-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<list-op-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<list-op-state-enum>,
    /// A list of comma separated label names. Example: `bug,ui,@high`
    labels: option<string>,
    /// What to sort results by.
    sort: option<list-op-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-org: func(params: list-for-org-params) -> result<string, string>;

  /// List assignees
  record list-assignees-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-assignees: func(params: list-assignees-params) -> result<string, string>;

  /// Check if a user can be assigned
  record check-user-can-be-assigned-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    assignee: string
  }
  check-user-can-be-assigned: func(params: check-user-can-be-assigned-params) -> result<string, string>;

  /// List repository issues
  record list-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// If an `integer` is passed, it should refer to a milestone by its `number` field. If the string `*` is passed, issues with any milestone are accepted. If the string `none` is passed, issues without milestones are returned.
    milestone: option<string>,
    /// Indicates the state of the issues to return.
    state: option<list-op-state-enum>,
    /// Can be the name of a user. Pass in `none` for issues with no assigned user, and `*` for issues assigned to any user.
    assignee: option<string>,
    /// The user that created the issue.
    creator: option<string>,
    /// A user that's mentioned in the issue.
    mentioned: option<string>,
    /// A list of comma separated label names. Example: `bug,ui,@high`
    labels: option<string>,
    /// What to sort results by.
    sort: option<list-op-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-repo: func(params: list-for-repo-params) -> result<string, string>;

  /// Create an issue
  record create-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Login for the user that this issue should be assigned to. _NOTE: Only users with push access can set the assignee for new issues. The assignee is silently dropped otherwise. **This field is deprecated.**_
    assignee: option<string>,
    /// Logins for Users to assign to this issue. _NOTE: Only users with push access can set assignees for new issues. Assignees are silently dropped otherwise._
    assignees: option<list<string>>,
    /// The contents of the issue.
    body: option<string>,
    /// Labels to associate with this issue. _NOTE: Only users with push access can set labels for new issues. Labels are silently dropped otherwise._
    labels: option<list<string>>,
    milestone: option<string>,
    /// The title of the issue.
    title: string
  }
  create: func(params: create-params) -> result<string, string>;

  /// List issue comments for a repository
  record list-comments-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-comments-for-repo-sort-enum>,
    /// Either `asc` or `desc`. Ignored without the `sort` parameter.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-comments-for-repo: func(params: list-comments-for-repo-params) -> result<string, string>;

  /// Get an issue comment
  record get-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  get-comment: func(params: get-comment-params) -> result<string, string>;

  /// Update an issue comment
  record update-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string,
    /// The contents of the comment.
    body: string
  }
  update-comment: func(params: update-comment-params) -> result<string, string>;

  /// Delete an issue comment
  record delete-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  delete-comment: func(params: delete-comment-params) -> result<string, string>;

  /// List issue events for a repository
  record list-events-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-events-for-repo: func(params: list-events-for-repo-params) -> result<string, string>;

  /// Get an issue event
  record get-event-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    event-id: string
  }
  get-event: func(params: get-event-params) -> result<string, string>;

  /// Get an issue
  record get-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update an issue
  record update-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// Username to assign to this issue. **This field is deprecated.**
    assignee: option<string>,
    /// Usernames to assign to this issue. Pass one or more user logins to _replace_ the set of assignees on this issue. Send an empty array (`[]`) to clear all assignees from the issue. Only users with push access can set assignees for new issues. Without push access to the repository, assignee changes are silently dropped.
    assignees: option<list<string>>,
    /// The contents of the issue.
    body: option<string>,
    /// Labels to associate with this issue. Pass one or more labels to _replace_ the set of labels on this issue. Send an empty array (`[]`) to clear all labels from the issue. Only users with push access can set labels for issues. Without push access to the repository, label changes are silently dropped.
    labels: option<list<string>>,
    milestone: option<string>,
    /// The open or closed state of the issue.
    state: option<update-body-state-enum>,
    /// The reason for the state change. Ignored unless `state` is changed.
    state-reason: option<update-body-state-reason-enum>,
    /// The title of the issue.
    title: option<string>
  }
  update: func(params: update-params) -> result<string, string>;

  /// Add assignees to an issue
  record add-assignees-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// Usernames of people to assign this issue to. _NOTE: Only users with push access can add assignees to an issue. Assignees are silently ignored otherwise._
    assignees: option<list<string>>
  }
  add-assignees: func(params: add-assignees-params) -> result<string, string>;

  /// Remove assignees from an issue
  record remove-assignees-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// Usernames of assignees to remove from an issue. _NOTE: Only users with push access can remove assignees from an issue. Assignees are silently ignored otherwise._
    assignees: option<list<string>>
  }
  remove-assignees: func(params: remove-assignees-params) -> result<string, string>;

  /// Check if a user can be assigned to a issue
  record check-user-can-be-assigned-to-issue-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    assignee: string
  }
  check-user-can-be-assigned-to-issue: func(params: check-user-can-be-assigned-to-issue-params) -> result<string, string>;

  /// List issue comments
  record list-comments-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-comments: func(params: list-comments-params) -> result<string, string>;

  /// Create an issue comment
  record create-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The contents of the comment.
    body: string
  }
  create-comment: func(params: create-comment-params) -> result<string, string>;

  /// List issue events
  record list-events-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-events: func(params: list-events-params) -> result<string, string>;

  /// List labels for an issue
  record list-labels-on-issue-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-labels-on-issue: func(params: list-labels-on-issue-params) -> result<string, string>;

  /// Add labels to an issue
  record add-labels-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    body: option<string>
  }
  add-labels: func(params: add-labels-params) -> result<string, string>;

  /// Set labels for an issue
  record set-labels-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    body: option<string>
  }
  set-labels: func(params: set-labels-params) -> result<string, string>;

  /// Remove all labels from an issue
  record remove-all-labels-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string
  }
  remove-all-labels: func(params: remove-all-labels-params) -> result<string, string>;

  /// Remove a label from an issue
  record remove-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    name: string
  }
  remove-label: func(params: remove-label-params) -> result<string, string>;

  /// Lock an issue
  record lock-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The reason for locking the issue or pull request conversation. Lock will fail if you don't use one of these reasons:  
    ///  * `off-topic`  
    lock-reason: option<lock-body-lock-reason-enum>
  }
  lock: func(params: lock-params) -> result<string, string>;

  /// Unlock an issue
  record unlock-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string
  }
  unlock: func(params: unlock-params) -> result<string, string>;

  /// List timeline events for an issue
  record list-events-for-timeline-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-events-for-timeline: func(params: list-events-for-timeline-params) -> result<string, string>;

  /// List labels for a repository
  record list-labels-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-labels-for-repo: func(params: list-labels-for-repo-params) -> result<string, string>;

  /// Create a label
  record create-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The [hexadecimal color code](http://www.color-hex.com/) for the label, without the leading `#`.
    color: option<string>,
    /// A short description of the label. Must be 100 characters or fewer.
    description: option<string>,
    /// The name of the label. Emoji can be added to label names, using either native emoji or colon-style markup. For example, typing `:strawberry:` will render the emoji ![:strawberry:](https://github.githubassets.com/images/icons/emoji/unicode/1f353.png ":strawberry:"). For a full list of available emoji and codes, see "[Emoji cheat sheet](https://github.com/ikatyang/emoji-cheat-sheet)."
    name: string
  }
  create-label: func(params: create-label-params) -> result<string, string>;

  /// Get a label
  record get-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    name: string
  }
  get-label: func(params: get-label-params) -> result<string, string>;

  /// Update a label
  record update-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    name: string,
    /// The [hexadecimal color code](http://www.color-hex.com/) for the label, without the leading `#`.
    color: option<string>,
    /// A short description of the label. Must be 100 characters or fewer.
    description: option<string>,
    /// The new name of the label. Emoji can be added to label names, using either native emoji or colon-style markup. For example, typing `:strawberry:` will render the emoji ![:strawberry:](https://github.githubassets.com/images/icons/emoji/unicode/1f353.png ":strawberry:"). For a full list of available emoji and codes, see "[Emoji cheat sheet](https://github.com/ikatyang/emoji-cheat-sheet)."
    new-name: option<string>
  }
  update-label: func(params: update-label-params) -> result<string, string>;

  /// Delete a label
  record delete-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    name: string
  }
  delete-label: func(params: delete-label-params) -> result<string, string>;

  /// List milestones
  record list-milestones-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The state of the milestone. Either `open`, `closed`, or `all`.
    state: option<list-op-state-enum>,
    /// What to sort results by. Either `due_on` or `completeness`.
    sort: option<list-milestones-sort-enum>,
    /// The direction of the sort. Either `asc` or `desc`.
    direction: option<list-op-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-milestones: func(params: list-milestones-params) -> result<string, string>;

  /// Create a milestone
  record create-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// A description of the milestone.
    description: option<string>,
    /// The milestone due date. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    due-on: option<string>,
    /// The state of the milestone. Either `open` or `closed`.
    state: option<update-body-state-enum>,
    /// The title of the milestone.
    title: string
  }
  create-milestone: func(params: create-milestone-params) -> result<string, string>;

  /// Get a milestone
  record get-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the milestone.
    milestone-number: string
  }
  get-milestone: func(params: get-milestone-params) -> result<string, string>;

  /// Update a milestone
  record update-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the milestone.
    milestone-number: string,
    /// A description of the milestone.
    description: option<string>,
    /// The milestone due date. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    due-on: option<string>,
    /// The state of the milestone. Either `open` or `closed`.
    state: option<update-body-state-enum>,
    /// The title of the milestone.
    title: option<string>
  }
  update-milestone: func(params: update-milestone-params) -> result<string, string>;

  /// Delete a milestone
  record delete-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the milestone.
    milestone-number: string
  }
  delete-milestone: func(params: delete-milestone-params) -> result<string, string>;

  /// List labels for issues in a milestone
  record list-labels-for-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the milestone.
    milestone-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-labels-for-milestone: func(params: list-labels-for-milestone-params) -> result<string, string>;

  /// List user account issues assigned to the authenticated user
  record list-for-authenticated-user-params {
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<list-op-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<list-op-state-enum>,
    /// A list of comma separated label names. Example: `bug,ui,@high`
    labels: option<string>,
    /// What to sort results by.
    sort: option<list-op-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<string, string>;

}

interface licenses {
  /// Get all commonly used licenses
  record get-all-commonly-used-params {
    featured: option<bool>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  get-all-commonly-used: func(params: get-all-commonly-used-params) -> result<string, string>;

  /// Get a license
  record get-params {
    license: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Get the license for a repository
  record get-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-for-repo: func(params: get-for-repo-params) -> result<string, string>;

}

interface markdown {
  enum render-body-mode-enum {
    markdown,
    gfm,
  }

  /// Render a Markdown document
  record render-params {
    /// The repository context to use when creating references in `gfm` mode.  For example, setting `context` to `octo-org/octo-repo` will change the text `#42` into an HTML link to issue 42 in the `octo-org/octo-repo` repository.
    context: option<string>,
    /// The rendering mode.
    mode: option<render-body-mode-enum>,
    /// The Markdown text to render in HTML.
    text: string
  }
  render: func(params: render-params) -> result<string, string>;

  /// Render a Markdown document in raw mode
  render-raw: func() -> result<string, string>;

}

interface orgs {
  enum update-body-default-repository-permission-enum {
    read,
    write,
    admin,
    none,
  }

  enum update-body-members-allowed-repository-creation-type-enum {
    all,
    private,
    none,
  }

  enum list-pending-invitations-role-enum {
    all,
    admin,
    direct-member,
    billing-manager,
    hiring-manager,
  }

  enum list-pending-invitations-invitation-source-enum {
    all,
    member,
    scim,
  }

  enum create-invitation-body-role-enum {
    admin,
    direct-member,
    billing-manager,
  }

  enum list-members-filter-enum {
    v2fa-disabled,
    all,
  }

  enum list-members-role-enum {
    all,
    admin,
    member,
  }

  enum set-membership-for-user-body-role-enum {
    admin,
    member,
  }

  enum list-memberships-for-authenticated-user-state-enum {
    active,
    pending,
  }

  enum update-membership-for-authenticated-user-body-state-enum {
    active,
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#create-hook-config-params).
  record create-webhook-body-config {
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    password: option<string>,
    secret: option<webhook-config-secret>,
    url: webhook-config-url,
    username: option<string>
  }

  /// The media type used to serialize the payloads. Supported values include `json` and `form`. The default is `form`.
  record webhook-config-content-type {
    /// opaque schema; raw JSON
    value: string
  }

  record webhook-config-insecure-ssl {
    /// opaque schema; raw JSON
    value: string
  }

  /// If provided, the `secret` will be used as the `key` to generate the HMAC hex digest value for [delivery signature headers](https://docs.github.com/webhooks/event-payloads/#delivery-headers).
  record webhook-config-secret {
    /// opaque schema; raw JSON
    value: string
  }

  /// The URL to which the payloads will be delivered.
  record webhook-config-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#update-hook-config-params).
  record update-webhook-body-config {
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    secret: option<webhook-config-secret>,
    url: webhook-config-url
  }

  /// List organizations
  record list-op-params {
    /// An organization ID. Only return organizations with an ID greater than this ID.
    since: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get an organization
  record get-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update an organization
  record update-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Whether GitHub Advanced Security is automatically enabled for new repositories.
    /// 
    advanced-security-enabled-for-new-repositories: option<bool>,
    /// Billing email address. This address is not publicized.
    billing-email: option<string>,
    blog: option<string>,
    /// The company name.
    company: option<string>,
    /// Default permission level members have for organization repositories.
    default-repository-permission: option<update-body-default-repository-permission-enum>,
    /// Whether Dependabot alerts is automatically enabled for new repositories.
    /// 
    dependabot-alerts-enabled-for-new-repositories: option<bool>,
    /// Whether Dependabot security updates is automatically enabled for new repositories.
    /// 
    dependabot-security-updates-enabled-for-new-repositories: option<bool>,
    /// Whether dependency graph is automatically enabled for new repositories.
    /// 
    dependency-graph-enabled-for-new-repositories: option<bool>,
    /// The description of the company.
    description: option<string>,
    /// The publicly visible email address.
    email: option<string>,
    /// Whether an organization can use organization projects.
    has-organization-projects: option<bool>,
    /// Whether repositories that belong to the organization can use repository projects.
    has-repository-projects: option<bool>,
    /// The location.
    location: option<string>,
    /// Specifies which types of repositories non-admin organization members can create. `private` is only available to repositories that are part of an organization on GitHub Enterprise Cloud. 
    /// **Note:** This parameter is deprecated and will be removed in the future. Its return value ignores internal repositories. Using this parameter overrides values set in `members_can_create_repositories`. See the parameter deprecation notice in the operation description for details.
    members-allowed-repository-creation-type: option<update-body-members-allowed-repository-creation-type-enum>,
    /// Whether organization members can create internal repositories, which are visible to all enterprise members. You can only allow members to create internal repositories if your organization is associated with an enterprise account using GitHub Enterprise Cloud or GitHub Enterprise Server 2.20+. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-internal-repositories: option<bool>,
    /// Whether organization members can create GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-pages: option<bool>,
    /// Whether organization members can create private GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-private-pages: option<bool>,
    /// Whether organization members can create private repositories, which are visible to organization members with permission. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-private-repositories: option<bool>,
    /// Whether organization members can create public GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-public-pages: option<bool>,
    /// Whether organization members can create public repositories, which are visible to anyone. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-public-repositories: option<bool>,
    /// Whether of non-admin organization members can create repositories. **Note:** A parameter can override this parameter. See `members_allowed_repository_creation_type` in this table for details.
    members-can-create-repositories: option<bool>,
    /// Whether organization members can fork private organization repositories.
    members-can-fork-private-repositories: option<bool>,
    /// The shorthand name of the company.
    name: option<string>,
    /// Whether secret scanning is automatically enabled for new repositories.
    /// 
    secret-scanning-enabled-for-new-repositories: option<bool>,
    /// If `secret_scanning_push_protection_custom_link_enabled` is true, the URL that will be displayed to contributors who are blocked from pushing a secret.
    secret-scanning-push-protection-custom-link: option<string>,
    /// Whether a custom link is shown to contributors who are blocked from pushing a secret by push protection.
    secret-scanning-push-protection-custom-link-enabled: option<bool>,
    /// Whether secret scanning push protection is automatically enabled for new repositories.
    /// 
    secret-scanning-push-protection-enabled-for-new-repositories: option<bool>,
    /// The Twitter username of the company.
    twitter-username: option<string>,
    /// Whether contributors to organization repositories are required to sign off on commits they make through GitHub's web interface.
    web-commit-signoff-required: option<bool>
  }
  update: func(params: update-params) -> result<string, string>;

  /// List users blocked by an organization
  record list-blocked-users-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-blocked-users: func(params: list-blocked-users-params) -> result<string, string>;

  /// Check if a user is blocked by an organization
  record check-blocked-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  check-blocked-user: func(params: check-blocked-user-params) -> result<string, string>;

  /// Block a user from an organization
  record block-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  block-user: func(params: block-user-params) -> result<string, string>;

  /// Unblock a user from an organization
  record unblock-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  unblock-user: func(params: unblock-user-params) -> result<string, string>;

  /// List failed organization invitations
  record list-failed-invitations-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-failed-invitations: func(params: list-failed-invitations-params) -> result<string, string>;

  /// List organization webhooks
  record list-webhooks-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-webhooks: func(params: list-webhooks-params) -> result<string, string>;

  /// Create an organization webhook
  record create-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Determines if notifications are sent when the webhook is triggered. Set to `true` to send notifications.
    active: option<bool>,
    /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#create-hook-config-params).
    config: create-webhook-body-config,
    /// Determines what [events](https://docs.github.com/webhooks/event-payloads) the hook is triggered for. Set to `["*"]` to receive all possible events.
    events: option<list<string>>,
    /// Must be passed as "web".
    name: string
  }
  create-webhook: func(params: create-webhook-params) -> result<string, string>;

  /// Get an organization webhook
  record get-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string
  }
  get-webhook: func(params: get-webhook-params) -> result<string, string>;

  /// Update an organization webhook
  record update-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    /// Determines if notifications are sent when the webhook is triggered. Set to `true` to send notifications.
    active: option<bool>,
    /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#update-hook-config-params).
    config: option<update-webhook-body-config>,
    /// Determines what [events](https://docs.github.com/webhooks/event-payloads) the hook is triggered for.
    events: option<list<string>>,
    name: option<string>
  }
  update-webhook: func(params: update-webhook-params) -> result<string, string>;

  /// Delete an organization webhook
  record delete-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string
  }
  delete-webhook: func(params: delete-webhook-params) -> result<string, string>;

  /// Get a webhook configuration for an organization
  record get-webhook-config-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string
  }
  get-webhook-config-for-org: func(params: get-webhook-config-for-org-params) -> result<string, string>;

  /// Update a webhook configuration for an organization
  record update-webhook-config-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    secret: option<webhook-config-secret>,
    url: option<webhook-config-url>
  }
  update-webhook-config-for-org: func(params: update-webhook-config-for-org-params) -> result<string, string>;

  /// List deliveries for an organization webhook
  record list-webhook-deliveries-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Used for pagination: the starting delivery from which the page of deliveries is fetched. Refer to the `link` header for the next and previous page cursors.
    cursor: option<string>,
    redelivery: option<bool>
  }
  list-webhook-deliveries: func(params: list-webhook-deliveries-params) -> result<string, string>;

  /// Get a webhook delivery for an organization webhook
  record get-webhook-delivery-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    delivery-id: string
  }
  get-webhook-delivery: func(params: get-webhook-delivery-params) -> result<string, string>;

  /// Redeliver a delivery for an organization webhook
  record redeliver-webhook-delivery-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string,
    delivery-id: string
  }
  redeliver-webhook-delivery: func(params: redeliver-webhook-delivery-params) -> result<string, string>;

  /// Ping an organization webhook
  record ping-webhook-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the hook.
    hook-id: string
  }
  ping-webhook: func(params: ping-webhook-params) -> result<string, string>;

  /// List app installations for an organization
  record list-app-installations-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-app-installations: func(params: list-app-installations-params) -> result<string, string>;

  /// List pending organization invitations
  record list-pending-invitations-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Filter invitations by their member role.
    role: option<list-pending-invitations-role-enum>,
    /// Filter invitations by their invitation source.
    invitation-source: option<list-pending-invitations-invitation-source-enum>
  }
  list-pending-invitations: func(params: list-pending-invitations-params) -> result<string, string>;

  /// Create an organization invitation
  record create-invitation-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// **Required unless you provide `invitee_id`**. Email address of the person you are inviting, which can be an existing GitHub user.
    email: option<string>,
    /// **Required unless you provide `email`**. GitHub user ID for the person you are inviting.
    invitee-id: option<s32>,
    /// The role for the new member. 
    ///  * `admin` - Organization owners with full administrative rights to the organization and complete access to all repositories and teams.  
    role: option<create-invitation-body-role-enum>,
    /// Specify IDs for the teams you want to invite new members to.
    team-ids: option<list<s32>>
  }
  create-invitation: func(params: create-invitation-params) -> result<string, string>;

  /// Cancel an organization invitation
  record cancel-invitation-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the invitation.
    invitation-id: string
  }
  cancel-invitation: func(params: cancel-invitation-params) -> result<string, string>;

  /// List organization invitation teams
  record list-invitation-teams-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the invitation.
    invitation-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-invitation-teams: func(params: list-invitation-teams-params) -> result<string, string>;

  /// List organization members
  record list-members-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Filter members returned in the list. `2fa_disabled` means that only members without [two-factor authentication](https://github.com/blog/1614-two-factor-authentication) enabled will be returned. This options is only available for organization owners.
    filter: option<list-members-filter-enum>,
    /// Filter members returned by their role.
    role: option<list-members-role-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-members: func(params: list-members-params) -> result<string, string>;

  /// Check organization membership for a user
  record check-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  check-membership-for-user: func(params: check-membership-for-user-params) -> result<string, string>;

  /// Remove an organization member
  record remove-member-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-member: func(params: remove-member-params) -> result<string, string>;

  /// Get organization membership for a user
  record get-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  get-membership-for-user: func(params: get-membership-for-user-params) -> result<string, string>;

  /// Set organization membership for a user
  record set-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string,
    /// The role to give the user in the organization. Can be one of:  
    ///  * `admin` - The user will become an owner of the organization.  
    role: option<set-membership-for-user-body-role-enum>
  }
  set-membership-for-user: func(params: set-membership-for-user-params) -> result<string, string>;

  /// Remove organization membership for a user
  record remove-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-membership-for-user: func(params: remove-membership-for-user-params) -> result<string, string>;

  /// List outside collaborators for an organization
  record list-outside-collaborators-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Filter the list of outside collaborators. `2fa_disabled` means that only outside collaborators without [two-factor authentication](https://github.com/blog/1614-two-factor-authentication) enabled will be returned.
    filter: option<list-members-filter-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-outside-collaborators: func(params: list-outside-collaborators-params) -> result<string, string>;

  /// Convert an organization member to outside collaborator
  record convert-member-to-outside-collaborator-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string,
    /// When set to `true`, the request will be performed asynchronously. Returns a 202 status code when the job is successfully queued.
    async-op: option<bool>
  }
  convert-member-to-outside-collaborator: func(params: convert-member-to-outside-collaborator-params) -> result<string, string>;

  /// Remove outside collaborator from an organization
  record remove-outside-collaborator-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-outside-collaborator: func(params: remove-outside-collaborator-params) -> result<string, string>;

  /// List public organization members
  record list-public-members-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-members: func(params: list-public-members-params) -> result<string, string>;

  /// Check public organization membership for a user
  record check-public-membership-for-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  check-public-membership-for-user: func(params: check-public-membership-for-user-params) -> result<string, string>;

  /// Set public organization membership for the authenticated user
  record set-public-membership-for-authenticated-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  set-public-membership-for-authenticated-user: func(params: set-public-membership-for-authenticated-user-params) -> result<string, string>;

  /// Remove public organization membership for the authenticated user
  record remove-public-membership-for-authenticated-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-public-membership-for-authenticated-user: func(params: remove-public-membership-for-authenticated-user-params) -> result<string, string>;

  /// List security manager teams
  record list-security-manager-teams-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  list-security-manager-teams: func(params: list-security-manager-teams-params) -> result<string, string>;

  /// Add a security manager team
  record add-security-manager-team-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string
  }
  add-security-manager-team: func(params: add-security-manager-team-params) -> result<string, string>;

  /// Remove a security manager team
  record remove-security-manager-team-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The slug of the team name.
    team-slug: string
  }
  remove-security-manager-team: func(params: remove-security-manager-team-params) -> result<string, string>;

  /// Enable or disable a security feature for an organization
  record enable-or-disable-security-product-on-all-org-repos-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The security feature to enable or disable.
    security-product: string,
    /// The action to take.
    /// 
    enablement: string
  }
  enable-or-disable-security-product-on-all-org-repos: func(params: enable-or-disable-security-product-on-all-org-repos-params) -> result<string, string>;

  /// List organization memberships for the authenticated user
  record list-memberships-for-authenticated-user-params {
    /// Indicates the state of the memberships to return. If not specified, the API returns both active and pending memberships.
    state: option<list-memberships-for-authenticated-user-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-memberships-for-authenticated-user: func(params: list-memberships-for-authenticated-user-params) -> result<string, string>;

  /// Get an organization membership for the authenticated user
  record get-membership-for-authenticated-user-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-membership-for-authenticated-user: func(params: get-membership-for-authenticated-user-params) -> result<string, string>;

  /// Update an organization membership for the authenticated user
  record update-membership-for-authenticated-user-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The state that the membership should be in. Only `"active"` will be accepted.
    state: update-membership-for-authenticated-user-body-state-enum
  }
  update-membership-for-authenticated-user: func(params: update-membership-for-authenticated-user-params) -> result<string, string>;

  /// List organizations for the authenticated user
  record list-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<string, string>;

  /// List organizations for a user
  record list-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-user: func(params: list-for-user-params) -> result<string, string>;

}

interface actions {
  enum create-required-workflow-body-scope-enum {
    selected,
    all,
  }

  enum create-or-update-org-secret-body-visibility-enum {
    all,
    private,
    selected,
  }

  enum get-actions-cache-list-sort-enum {
    created-at,
    last-accessed-at,
    size-in-bytes,
  }

  enum get-actions-cache-list-direction-enum {
    asc,
    desc,
  }

  enum workflow-access-to-repository-access-level-enum {
    none,
    user,
    organization,
  }

  enum list-required-workflow-runs-status-enum {
    completed,
    action-required,
    cancelled,
    failure,
    neutral,
    skipped,
    stale,
    success,
    timed-out,
    in-progress,
    queued,
    requested,
    waiting,
    pending,
  }

  enum list-jobs-for-workflow-run-filter-enum {
    latest,
    all,
  }

  enum review-pending-deployments-for-run-body-state-enum {
    approved,
    rejected,
  }

  /// The permissions policy that controls the actions and reusable workflows that are allowed to run.
  record allowed-actions {
    /// opaque schema; raw JSON
    value: string
  }

  /// The policy that controls the repositories in the organization that are allowed to run GitHub Actions.
  record enabled-repositories {
    /// opaque schema; raw JSON
    value: string
  }

  /// Whether GitHub Actions can approve pull requests. Enabling this can be a security risk.
  record can-approve-pull-request-reviews {
    /// opaque schema; raw JSON
    value: string
  }

  /// The default workflow permissions granted to the GITHUB_TOKEN when running workflows.
  record default-workflow-permissions {
    /// opaque schema; raw JSON
    value: string
  }

  /// The full Git reference, formatted as `refs/heads/<branch name>`,
  /// `refs/pull/<number>/merge`, or `refs/pull/<number>/head`.
  record code-scanning-ref {
    /// opaque schema; raw JSON
    value: string
  }

  /// Whether GitHub Actions is enabled on the repository.
  record enabled {
    /// opaque schema; raw JSON
    value: string
  }

  /// Input keys and values configured in the workflow file. The maximum number of properties is 10. Any default properties configured in the workflow file will be used when `inputs` are omitted.
  record create-workflow-dispatch-body-inputs {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Get GitHub Actions cache usage for an organization
  record get-actions-cache-usage-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-actions-cache-usage-for-org: func(params: get-actions-cache-usage-for-org-params) -> result<string, string>;

  /// List repositories with GitHub Actions cache usage for an organization
  record get-actions-cache-usage-by-repo-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  get-actions-cache-usage-by-repo-for-org: func(params: get-actions-cache-usage-by-repo-for-org-params) -> result<string, string>;

  /// Get GitHub Actions permissions for an organization
  record get-github-actions-permissions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-github-actions-permissions-organization: func(params: get-github-actions-permissions-organization-params) -> result<string, string>;

  /// Set GitHub Actions permissions for an organization
  record set-github-actions-permissions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    allowed-actions: option<allowed-actions>,
    enabled-repositories: enabled-repositories
  }
  set-github-actions-permissions-organization: func(params: set-github-actions-permissions-organization-params) -> result<string, string>;

  /// List selected repositories enabled for GitHub Actions in an organization
  record list-selected-repositories-enabled-github-actions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-selected-repositories-enabled-github-actions-organization: func(params: list-selected-repositories-enabled-github-actions-organization-params) -> result<string, string>;

  /// Set selected repositories enabled for GitHub Actions in an organization
  record set-selected-repositories-enabled-github-actions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// List of repository IDs to enable for GitHub Actions.
    selected-repository-ids: list<s32>
  }
  set-selected-repositories-enabled-github-actions-organization: func(params: set-selected-repositories-enabled-github-actions-organization-params) -> result<string, string>;

  /// Enable a selected repository for GitHub Actions in an organization
  record enable-selected-repository-github-actions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the repository.
    repository-id: string
  }
  enable-selected-repository-github-actions-organization: func(params: enable-selected-repository-github-actions-organization-params) -> result<string, string>;

  /// Disable a selected repository for GitHub Actions in an organization
  record disable-selected-repository-github-actions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the repository.
    repository-id: string
  }
  disable-selected-repository-github-actions-organization: func(params: disable-selected-repository-github-actions-organization-params) -> result<string, string>;

  /// Get allowed actions and reusable workflows for an organization
  record get-allowed-actions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-allowed-actions-organization: func(params: get-allowed-actions-organization-params) -> result<string, string>;

  /// Set allowed actions and reusable workflows for an organization
  record set-allowed-actions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Whether GitHub-owned actions are allowed. For example, this includes the actions in the `actions` organization.
    github-owned-allowed: option<bool>,
    /// Specifies a list of string-matching patterns to allow specific action(s) and reusable workflow(s). Wildcards, tags, and SHAs are allowed. For example, `monalisa/octocat@*`, `monalisa/octocat@v2`, `monalisa/*`.
    /// 
    patterns-allowed: option<list<string>>,
    /// Whether actions from GitHub Marketplace verified creators are allowed. Set to `true` to allow all actions by GitHub Marketplace verified creators.
    verified-allowed: option<bool>
  }
  set-allowed-actions-organization: func(params: set-allowed-actions-organization-params) -> result<string, string>;

  /// Get default workflow permissions for an organization
  record get-github-actions-default-workflow-permissions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-github-actions-default-workflow-permissions-organization: func(params: get-github-actions-default-workflow-permissions-organization-params) -> result<string, string>;

  /// Set default workflow permissions for an organization
  record set-github-actions-default-workflow-permissions-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    can-approve-pull-request-reviews: option<can-approve-pull-request-reviews>,
    default-workflow-permissions: option<default-workflow-permissions>
  }
  set-github-actions-default-workflow-permissions-organization: func(params: set-github-actions-default-workflow-permissions-organization-params) -> result<string, string>;

  /// List required workflows
  record list-required-workflows-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-required-workflows: func(params: list-required-workflows-params) -> result<string, string>;

  /// Create a required workflow
  record create-required-workflow-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The ID of the repository that contains the workflow file.
    repository-id: string,
    /// Enable the required workflow for all repositories or selected repositories in the organization.
    scope: option<create-required-workflow-body-scope-enum>,
    /// A list of repository IDs where you want to enable the required workflow. You can only provide a list of repository ids when the `scope` is set to `selected`.
    selected-repository-ids: option<list<s32>>,
    /// Path of the workflow file to be configured as a required workflow.
    workflow-file-path: string
  }
  create-required-workflow: func(params: create-required-workflow-params) -> result<string, string>;

  /// Get a required workflow
  record get-required-workflow-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the required workflow.
    required-workflow-id: string
  }
  get-required-workflow: func(params: get-required-workflow-params) -> result<string, string>;

  /// Update a required workflow
  record update-required-workflow-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the required workflow.
    required-workflow-id: string,
    /// The ID of the repository that contains the workflow file.
    repository-id: option<string>,
    /// Enable the required workflow for all repositories or selected repositories in the organization.
    scope: option<create-required-workflow-body-scope-enum>,
    /// A list of repository IDs where you want to enable the required workflow. A list of repository IDs where you want to enable the required workflow. You can only provide a list of repository ids when the `scope` is set to `selected`.
    selected-repository-ids: option<list<s32>>,
