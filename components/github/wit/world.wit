  /// List codespaces for the organization
  record list-in-organization-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The organization name. The name is not case sensitive.
    org: string
  }
  list-in-organization: func(params: list-in-organization-params) -> result<list-in-organization-response, list-in-organization-error>;

  /// Manage access control for organization codespaces
  record set-codespaces-billing-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The usernames of the organization members who should have access to codespaces in the organization. Required when `visibility` is `selected_members`. The provided list of usernames will replace any existing value.
    selected-usernames: option<list<string>>,
    /// Which users can access codespaces in the organization. `disabled` means that no users can access codespaces in the organization.
    visibility: set-codespaces-billing-body-visibility-enum
  }
  set-codespaces-billing: func(params: set-codespaces-billing-params) -> result<string, set-codespaces-billing-error>;

  /// Add users to Codespaces billing for an organization
  record set-codespaces-billing-users-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The usernames of the organization members whose codespaces be billed to the organization.
    selected-usernames: list<string>
  }
  set-codespaces-billing-users: func(params: set-codespaces-billing-users-params) -> result<string, set-codespaces-billing-users-error>;

  /// Removes users from Codespaces billing for an organization
  record delete-codespaces-billing-users-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The usernames of the organization members whose codespaces should not be billed to the organization.
    selected-usernames: list<string>
  }
  delete-codespaces-billing-users: func(params: delete-codespaces-billing-users-params) -> result<string, delete-codespaces-billing-users-error>;

  /// List organization secrets
  record list-org-secrets-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-org-secrets: func(params: list-org-secrets-params) -> result<list-org-secrets-response, string>;

  /// Get an organization public key
  record get-org-public-key-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-org-public-key: func(params: get-org-public-key-params) -> result<public-key, string>;

  /// Get an organization secret
  record get-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string
  }
  get-org-secret: func(params: get-org-secret-params) -> result<org-secret, string>;

  /// Create or update an organization secret
  record create-or-update-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    /// The value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an organization public key](https://docs.github.com/rest/reference/codespaces#get-an-organization-public-key) endpoint.
    encrypted-value: option<string>,
    /// The ID of the key you used to encrypt the secret.
    key-id: option<string>,
    /// An array of repository IDs that can access the organization secret. You can only provide a list of repository IDs when the `visibility` is set to `selected`. You can manage the list of selected repositories using the [List selected repositories for an organization secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-an-organization-secret), [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/codespaces#set-selected-repositories-for-an-organization-secret), and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/codespaces#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: option<list<s32>>,
    /// Which type of organization repositories have access to the organization secret. `selected` means only the repositories specified by `selected_repository_ids` can access the secret.
    visibility: org-secret-visibility-enum
  }
  create-or-update-org-secret: func(params: create-or-update-org-secret-params) -> result<empty-object, create-or-update-org-secret-error>;

  /// Delete an organization secret
  record delete-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string
  }
  delete-org-secret: func(params: delete-org-secret-params) -> result<string, delete-org-secret-error>;

  /// List selected repositories for an organization secret
  record list-selected-repos-for-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-selected-repos-for-org-secret: func(params: list-selected-repos-for-org-secret-params) -> result<list-selected-repos-for-org-secret-response, list-selected-repos-for-org-secret-error>;

  /// Set selected repositories for an organization secret
  record set-selected-repos-for-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    /// An array of repository ids that can access the organization secret. You can only provide a list of repository ids when the `visibility` is set to `selected`. You can add and remove individual repositories using the [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/codespaces#set-selected-repositories-for-an-organization-secret) and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/codespaces#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: list<s32>
  }
  set-selected-repos-for-org-secret: func(params: set-selected-repos-for-org-secret-params) -> result<string, set-selected-repos-for-org-secret-error>;

  /// Add selected repository to an organization secret
  record add-selected-repo-to-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  add-selected-repo-to-org-secret: func(params: add-selected-repo-to-org-secret-params) -> result<string, add-selected-repo-to-org-secret-error>;

  /// Remove selected repository from an organization secret
  record remove-selected-repo-from-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  remove-selected-repo-from-org-secret: func(params: remove-selected-repo-from-org-secret-params) -> result<string, remove-selected-repo-from-org-secret-error>;

  /// List codespaces for a user in organization
  record get-codespaces-for-user-in-org-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string
  }
  get-codespaces-for-user-in-org: func(params: get-codespaces-for-user-in-org-params) -> result<get-codespaces-for-user-in-org-response, get-codespaces-for-user-in-org-error>;

  /// Delete a codespace from the organization
  record delete-from-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string,
    /// The name of the codespace.
    codespace-name: string
  }
  delete-from-organization: func(params: delete-from-organization-params) -> result<list<delete-from-organization-response-entry>, delete-from-organization-error>;

  /// Stop a codespace for an organization user
  record stop-in-organization-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The handle for the GitHub user account.
    username: string,
    /// The name of the codespace.
    codespace-name: string
  }
  stop-in-organization: func(params: stop-in-organization-params) -> result<codespace, stop-in-organization-error>;

  /// List codespaces in a repository for the authenticated user
  record list-in-repository-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  list-in-repository-for-authenticated-user: func(params: list-in-repository-for-authenticated-user-params) -> result<list-in-repository-for-authenticated-user-response, list-in-repository-for-authenticated-user-error>;

  /// Create a codespace in a repository
  record create-with-repo-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// IP for location auto-detection when proxying a request
    client-ip: option<string>,
    /// Path to devcontainer.json config to use for this codespace
    devcontainer-path: option<string>,
    /// Display name for this codespace
    display-name: option<string>,
    /// Time in minutes before codespace stops from inactivity
    idle-timeout-minutes: option<s32>,
    /// Location for this codespace. Assigned by IP if not provided
    location: option<string>,
    /// Machine type to use for this codespace
    machine: option<string>,
    /// Whether to authorize requested permissions from devcontainer.json
    multi-repo-permissions-opt-out: option<bool>,
    /// Git ref (typically a branch name) for this codespace
    ref: option<string>,
    /// Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).
    retention-period-minutes: option<s32>,
    /// Working directory for this codespace
    working-directory: option<string>
  }
  create-with-repo-for-authenticated-user: func(params: create-with-repo-for-authenticated-user-params) -> result<codespace, create-with-repo-for-authenticated-user-error>;

  /// List devcontainer configurations in a repository for the authenticated user
  record list-devcontainers-in-repository-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  list-devcontainers-in-repository-for-authenticated-user: func(params: list-devcontainers-in-repository-for-authenticated-user-params) -> result<list-devcontainers-in-repository-for-authenticated-user-response, list-devcontainers-in-repository-for-authenticated-user-error>;

  /// List available machine types for a repository
  record repo-machines-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The location to check for available machines. Assigned by IP if not provided.
    location: option<string>,
    /// IP for location auto-detection when proxying a request
    client-ip: option<string>
  }
  repo-machines-for-authenticated-user: func(params: repo-machines-for-authenticated-user-params) -> result<repo-machines-for-authenticated-user-response, repo-machines-for-authenticated-user-error>;

  /// Get default attributes for a codespace
  record pre-flight-with-repo-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The branch or commit to check for a default devcontainer path. If not specified, the default branch will be checked.
    ref: option<string>,
    /// An alternative IP for default location auto-detection, such as when proxying a request.
    client-ip: option<string>
  }
  pre-flight-with-repo-for-authenticated-user: func(params: pre-flight-with-repo-for-authenticated-user-params) -> result<pre-flight-with-repo-for-authenticated-user-response, pre-flight-with-repo-for-authenticated-user-error>;

  /// List repository secrets
  record list-repo-secrets-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repo-secrets: func(params: list-repo-secrets-params) -> result<list-repo-secrets-response, string>;

  /// Get a repository public key
  record get-repo-public-key-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-repo-public-key: func(params: get-repo-public-key-params) -> result<public-key, string>;

  /// Get a repository secret
  record get-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string
  }
  get-repo-secret: func(params: get-repo-secret-params) -> result<repo-codespaces-secret, string>;

  /// Create or update a repository secret
  record create-or-update-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string,
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get a repository public key](https://docs.github.com/rest/reference/codespaces#get-a-repository-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>
  }
  create-or-update-repo-secret: func(params: create-or-update-repo-secret-params) -> result<empty-object, string>;

  /// Delete a repository secret
  record delete-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string
  }
  delete-repo-secret: func(params: delete-repo-secret-params) -> result<string, string>;

  /// Create a codespace from a pull request
  record create-with-pr-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// IP for location auto-detection when proxying a request
    client-ip: option<string>,
    /// Path to devcontainer.json config to use for this codespace
    devcontainer-path: option<string>,
    /// Display name for this codespace
    display-name: option<string>,
    /// Time in minutes before codespace stops from inactivity
    idle-timeout-minutes: option<s32>,
    /// Location for this codespace. Assigned by IP if not provided
    location: option<string>,
    /// Machine type to use for this codespace
    machine: option<string>,
    /// Whether to authorize requested permissions from devcontainer.json
    multi-repo-permissions-opt-out: option<bool>,
    /// Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).
    retention-period-minutes: option<s32>,
    /// Working directory for this codespace
    working-directory: option<string>
  }
  create-with-pr-for-authenticated-user: func(params: create-with-pr-for-authenticated-user-params) -> result<codespace, create-with-pr-for-authenticated-user-error>;

  /// List codespaces for the authenticated user
  record list-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// ID of the Repository to filter on
    repository-id: option<s32>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<list-for-authenticated-user-response, list-for-authenticated-user-error>;

  /// Create a codespace for the authenticated user
  record create-for-authenticated-user-params {
    body: string
  }
  create-for-authenticated-user: func(params: create-for-authenticated-user-params) -> result<codespace, create-for-authenticated-user-error>;

  /// List secrets for the authenticated user
  record list-secrets-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-secrets-for-authenticated-user: func(params: list-secrets-for-authenticated-user-params) -> result<list-secrets-for-authenticated-user-response, string>;

  /// Get public key for the authenticated user
  get-public-key-for-authenticated-user: func() -> result<user-public-key, string>;

  /// Get a secret for the authenticated user
  record get-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string
  }
  get-secret-for-authenticated-user: func(params: get-secret-for-authenticated-user-params) -> result<secret, string>;

  /// Create or update a secret for the authenticated user
  record create-or-update-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string,
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get the public key for the authenticated user](https://docs.github.com/rest/reference/codespaces#get-the-public-key-for-the-authenticated-user) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: string,
    /// An array of repository ids that can access the user secret. You can manage the list of selected repositories using the [List selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-a-user-secret), [Set selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#set-selected-repositories-for-a-user-secret), and [Remove a selected repository from a user secret](https://docs.github.com/rest/reference/codespaces#remove-a-selected-repository-from-a-user-secret) endpoints.
    selected-repository-ids: option<list<string>>
  }
  create-or-update-secret-for-authenticated-user: func(params: create-or-update-secret-for-authenticated-user-params) -> result<empty-object, create-or-update-secret-for-authenticated-user-error>;

  /// Delete a secret for the authenticated user
  record delete-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string
  }
  delete-secret-for-authenticated-user: func(params: delete-secret-for-authenticated-user-params) -> result<string, string>;

  /// List selected repositories for a user secret
  record list-repositories-for-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string
  }
  list-repositories-for-secret-for-authenticated-user: func(params: list-repositories-for-secret-for-authenticated-user-params) -> result<list-repositories-for-secret-for-authenticated-user-response, list-repositories-for-secret-for-authenticated-user-error>;

  /// Set selected repositories for a user secret
  record set-repositories-for-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string,
    /// An array of repository ids for which a codespace can access the secret. You can manage the list of selected repositories using the [List selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-a-user-secret), [Add a selected repository to a user secret](https://docs.github.com/rest/reference/codespaces#add-a-selected-repository-to-a-user-secret), and [Remove a selected repository from a user secret](https://docs.github.com/rest/reference/codespaces#remove-a-selected-repository-from-a-user-secret) endpoints.
    selected-repository-ids: list<s32>
  }
  set-repositories-for-secret-for-authenticated-user: func(params: set-repositories-for-secret-for-authenticated-user-params) -> result<string, set-repositories-for-secret-for-authenticated-user-error>;

  /// Add a selected repository to a user secret
  record add-repository-for-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  add-repository-for-secret-for-authenticated-user: func(params: add-repository-for-secret-for-authenticated-user-params) -> result<string, add-repository-for-secret-for-authenticated-user-error>;

  /// Remove a selected repository from a user secret
  record remove-repository-for-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  remove-repository-for-secret-for-authenticated-user: func(params: remove-repository-for-secret-for-authenticated-user-params) -> result<string, remove-repository-for-secret-for-authenticated-user-error>;

  /// Get a codespace for the authenticated user
  record get-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  get-for-authenticated-user: func(params: get-for-authenticated-user-params) -> result<codespace, get-for-authenticated-user-error>;

  /// Update a codespace for the authenticated user
  record update-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string,
    /// Display name for this codespace
    display-name: option<string>,
    /// A valid machine to transition this codespace to.
    machine: option<string>,
    /// Recently opened folders inside the codespace. It is currently used by the clients to determine the folder path to load the codespace in.
    recent-folders: option<list<string>>
  }
  update-for-authenticated-user: func(params: update-for-authenticated-user-params) -> result<codespace, update-for-authenticated-user-error>;

  /// Delete a codespace for the authenticated user
  record delete-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  delete-for-authenticated-user: func(params: delete-for-authenticated-user-params) -> result<list<delete-for-authenticated-user-response-entry>, delete-for-authenticated-user-error>;

  /// Export a codespace for the authenticated user
  record export-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  export-for-authenticated-user: func(params: export-for-authenticated-user-params) -> result<codespace-export-details, export-for-authenticated-user-error>;

  /// Get details about a codespace export
  record get-export-details-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string,
    /// The ID of the export operation, or `latest`. Currently only `latest` is currently supported.
    export-id: string
  }
  get-export-details-for-authenticated-user: func(params: get-export-details-for-authenticated-user-params) -> result<codespace-export-details, get-export-details-for-authenticated-user-error>;

  /// List machine types for a codespace
  record codespace-machines-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  codespace-machines-for-authenticated-user: func(params: codespace-machines-for-authenticated-user-params) -> result<codespace-machines-for-authenticated-user-response, codespace-machines-for-authenticated-user-error>;

  /// Create a repository from an unpublished codespace
  record publish-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string,
    /// A name for the new repository.
    name: option<string>,
    /// Whether the new repository should be private.
    private: option<bool>
  }
  publish-for-authenticated-user: func(params: publish-for-authenticated-user-params) -> result<codespace-with-full-repository, publish-for-authenticated-user-error>;

  /// Start a codespace for the authenticated user
  record start-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  start-for-authenticated-user: func(params: start-for-authenticated-user-params) -> result<codespace, start-for-authenticated-user-error>;

  /// Stop a codespace for the authenticated user
  record stop-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  stop-for-authenticated-user: func(params: stop-for-authenticated-user-params) -> result<codespace, stop-for-authenticated-user-error>;

}

interface interactions {
  enum interaction-expiry {
    one-day,
    three-days,
    one-week,
    one-month,
    six-months,
  }

  enum interaction-group {
    existing-users,
    contributors-only,
    collaborators-only,
  }

  /// Interaction limit settings.
  record interaction-limit-response {
    expires-at: string,
    limit: interaction-group,
    origin: string
  }

  variant set-restrictions-for-org-error {
    unprocessable-entity(string),
    other(string)
  }

  variant set-restrictions-for-repo-error {
    conflict(string),
    other(string)
  }

  variant remove-restrictions-for-repo-error {
    conflict(string),
    other(string)
  }

  variant set-restrictions-for-authenticated-user-error {
    unprocessable-entity(string),
    other(string)
  }

  /// Get interaction restrictions for an organization
  record get-restrictions-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-restrictions-for-org: func(params: get-restrictions-for-org-params) -> result<string, string>;

  /// Set interaction restrictions for an organization
  record set-restrictions-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  set-restrictions-for-org: func(params: set-restrictions-for-org-params) -> result<interaction-limit-response, set-restrictions-for-org-error>;

  /// Remove interaction restrictions for an organization
  record remove-restrictions-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  remove-restrictions-for-org: func(params: remove-restrictions-for-org-params) -> result<string, string>;

  /// Get interaction restrictions for a repository
  record get-restrictions-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-restrictions-for-repo: func(params: get-restrictions-for-repo-params) -> result<string, string>;

  /// Set interaction restrictions for a repository
  record set-restrictions-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  set-restrictions-for-repo: func(params: set-restrictions-for-repo-params) -> result<interaction-limit-response, set-restrictions-for-repo-error>;

  /// Remove interaction restrictions for a repository
  record remove-restrictions-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  remove-restrictions-for-repo: func(params: remove-restrictions-for-repo-params) -> result<string, remove-restrictions-for-repo-error>;

  /// Get interaction restrictions for your public repositories
  get-restrictions-for-authenticated-user: func() -> result<string, string>;

  /// Set interaction restrictions for your public repositories
  record set-restrictions-for-authenticated-user-params {
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  set-restrictions-for-authenticated-user: func(params: set-restrictions-for-authenticated-user-params) -> result<interaction-limit-response, set-restrictions-for-authenticated-user-error>;

  /// Remove interaction restrictions from your public repositories
  remove-restrictions-for-authenticated-user: func() -> result<string, string>;

}

interface migrations {
  enum list-for-org-exclude-item-enum {
    repositories,
  }

  enum repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum import-op-status-enum {
    auth,
    error,
    none,
    detecting,
    choose,
    auth-failed,
    importing,
    mapping,
    waiting-to-push,
    pushing,
    complete,
    setup,
    unknown,
    detection-found-multiple,
    detection-found-nothing,
    detection-needs-auth,
  }

  enum start-import-body-vcs-enum {
    subversion,
    git,
    mercurial,
    tfvc,
  }

  enum update-import-body-vcs-enum {
    subversion,
    tfvc,
    git,
    mercurial,
  }

  enum set-lfs-preference-body-use-lfs-enum {
    opt-in,
    opt-out,
  }

  /// A migration.
  record migration {
    archive-url: option<string>,
    created-at: string,
    exclude: option<list<string>>,
    exclude-attachments: bool,
    exclude-git-data: bool,
    exclude-metadata: bool,
    exclude-owner-projects: bool,
    exclude-releases: bool,
    guid: string,
    id: s32,
    lock-repositories: bool,
    node-id: string,
    org-metadata-only: bool,
    owner: nullable-simple-user,
    /// The repositories included in the migration. Only returned for export migrations.
    repositories: list<repository>,
    state: string,
    updated-at: string,
    url: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A repository on GitHub.
  record repository {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow forking this repo
    allow-forking: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is enabled for this repository
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    /// Whether the repository is archived.
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: string,
    /// The default branch of the repository.
    default-branch: string,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    /// Returns whether or not this repository disabled.
    disabled: bool,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: s32,
    forks-count: s32,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: string,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: bool,
    /// Whether issues are enabled.
    has-issues: bool,
    has-pages: bool,
    /// Whether projects are enabled.
    has-projects: bool,
    /// Whether the wiki is enabled.
    has-wiki: bool,
    homepage: string,
    hooks-url: string,
    html-url: string,
    /// Unique identifier of the repository
    id: s32,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: string,
    languages-url: string,
    license: nullable-license-simple,
    master-branch: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: string,
    milestones-url: string,
    mirror-url: string,
    /// The name of the repository.
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: s32,
    open-issues-count: s32,
    organization: option<nullable-simple-user>,
    owner: simple-user,
    permissions: option<repository-permissions>,
    /// Whether the repository is private or public.
    private: bool,
    pulls-url: string,
    pushed-at: string,
    releases-url: string,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: s32,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: string,
    stargazers-count: s32,
    stargazers-url: string,
    starred-at: option<string>,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: string,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    template-repository: option<repository-template-repository>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: string,
    url: string,
    /// Whether a squash merge commit can use the pull request title as default. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The repository visibility: public, private, or internal.
    visibility: option<string>,
    watchers: s32,
    watchers-count: s32,
    /// Whether to require contributors to sign off on web-based commits
    web-commit-signoff-required: option<bool>
  }

  /// License Simple
  record nullable-license-simple {
    html-url: option<string>,
    key: string,
    name: string,
    node-id: string,
    spdx-id: string,
    url: string
