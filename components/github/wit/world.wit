    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  add-selected-repo-to-org-secret: func(params: add-selected-repo-to-org-secret-params) -> result<string, string>;

  /// Remove selected repository from an organization secret
  record remove-selected-repo-from-org-secret-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  remove-selected-repo-from-org-secret: func(params: remove-selected-repo-from-org-secret-params) -> result<string, string>;

  /// List codespaces for a user in organization
  record get-codespaces-for-user-in-org-params {
    /// The number of results per page (max 100).
