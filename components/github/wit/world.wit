    line: option<s32>,
    /// Relative path of the file to comment on.
    path: option<string>,
    /// Line index in the diff to comment on.
    position: option<s32>
  }
  repos-create-commit-comment: func(params: repos-create-commit-comment-params) -> result<string, string>;

