    other(string)
  }

  variant get-public-ssh-key-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-public-ssh-key-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-public-emails-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-ssh-signing-keys-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant create-ssh-signing-key-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-ssh-signing-key-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-ssh-signing-key-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant list-op-error {
    not-modified(string),
    other(string)
  }

  variant get-by-username-error {
    not-found(string),
    other(string)
  }

  variant check-following-for-user-error {
    not-found(string),
    other(string)
  }

  variant get-context-for-user-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// Get the authenticated user
  get-authenticated: func() -> result<string, get-authenticated-error>;

  /// Update the authenticated user
  record update-authenticated-params {
    /// The new short biography of the user.
    bio: option<string>,
    /// The new blog URL of the user.
    blog: option<string>,
    /// The new company of the user.
    company: option<string>,
    /// The publicly visible email address of the user.
    email: option<string>,
    /// The new hiring availability of the user.
    hireable: option<bool>,
    /// The new location of the user.
    location: option<string>,
    /// The new name of the user.
    name: option<string>,
    /// The new Twitter username of the user.
    twitter-username: option<string>
  }
  update-authenticated: func(params: update-authenticated-params) -> result<private-user, update-authenticated-error>;

  /// List users blocked by the authenticated user
  record list-blocked-by-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-blocked-by-authenticated-user: func(params: list-blocked-by-authenticated-user-params) -> result<list<simple-user>, list-blocked-by-authenticated-user-error>;

  /// Check if a user is blocked by the authenticated user
  record check-blocked-params {
    /// The handle for the GitHub user account.
    username: string
  }
  check-blocked: func(params: check-blocked-params) -> result<string, check-blocked-error>;

  /// Block a user
  record block-params {
    /// The handle for the GitHub user account.
    username: string
  }
  block: func(params: block-params) -> result<string, block-error>;

  /// Unblock a user
  record unblock-params {
    /// The handle for the GitHub user account.
    username: string
  }
  unblock: func(params: unblock-params) -> result<string, unblock-error>;

  /// Set primary email visibility for the authenticated user
  record set-primary-email-visibility-for-authenticated-user-params {
    /// Denotes whether an email is publicly visible.
    visibility: set-primary-email-visibility-for-authenticated-user-body-visibility-enum
  }
  set-primary-email-visibility-for-authenticated-user: func(params: set-primary-email-visibility-for-authenticated-user-params) -> result<list<email>, set-primary-email-visibility-for-authenticated-user-error>;

  /// List email addresses for the authenticated user
  record list-emails-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-emails-for-authenticated-user: func(params: list-emails-for-authenticated-user-params) -> result<list<email>, list-emails-for-authenticated-user-error>;

  /// Add an email address for the authenticated user
  record add-email-for-authenticated-user-params {
    body: option<string>
  }
  add-email-for-authenticated-user: func(params: add-email-for-authenticated-user-params) -> result<list<email>, add-email-for-authenticated-user-error>;

  /// Delete an email address for the authenticated user
  record delete-email-for-authenticated-user-params {
    body: option<string>
  }
  delete-email-for-authenticated-user: func(params: delete-email-for-authenticated-user-params) -> result<string, delete-email-for-authenticated-user-error>;

  /// List followers of the authenticated user
  record list-followers-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-followers-for-authenticated-user: func(params: list-followers-for-authenticated-user-params) -> result<list<simple-user>, list-followers-for-authenticated-user-error>;

  /// List the people the authenticated user follows
  record list-followed-by-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-followed-by-authenticated-user: func(params: list-followed-by-authenticated-user-params) -> result<list<simple-user>, list-followed-by-authenticated-user-error>;

  /// Check if a person is followed by the authenticated user
  record check-person-is-followed-by-authenticated-params {
    /// The handle for the GitHub user account.
    username: string
  }
  check-person-is-followed-by-authenticated: func(params: check-person-is-followed-by-authenticated-params) -> result<string, check-person-is-followed-by-authenticated-error>;

  /// Follow a user
  record follow-params {
    /// The handle for the GitHub user account.
    username: string
  }
  follow: func(params: follow-params) -> result<string, follow-error>;

  /// Unfollow a user
  record unfollow-params {
    /// The handle for the GitHub user account.
    username: string
  }
  unfollow: func(params: unfollow-params) -> result<string, unfollow-error>;

  /// List GPG keys for the authenticated user
  record list-gpg-keys-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-gpg-keys-for-authenticated-user: func(params: list-gpg-keys-for-authenticated-user-params) -> result<list<gpg-key>, list-gpg-keys-for-authenticated-user-error>;

  /// Create a GPG key for the authenticated user
  record create-gpg-key-for-authenticated-user-params {
    /// A GPG key in ASCII-armored format.
    armored-public-key: string,
    /// A descriptive name for the new key.
    name: option<string>
  }
  create-gpg-key-for-authenticated-user: func(params: create-gpg-key-for-authenticated-user-params) -> result<gpg-key, create-gpg-key-for-authenticated-user-error>;

  /// Get a GPG key for the authenticated user
  record get-gpg-key-for-authenticated-user-params {
    /// The unique identifier of the GPG key.
    gpg-key-id: string
  }
  get-gpg-key-for-authenticated-user: func(params: get-gpg-key-for-authenticated-user-params) -> result<gpg-key, get-gpg-key-for-authenticated-user-error>;

  /// Delete a GPG key for the authenticated user
  record delete-gpg-key-for-authenticated-user-params {
    /// The unique identifier of the GPG key.
    gpg-key-id: string
  }
  delete-gpg-key-for-authenticated-user: func(params: delete-gpg-key-for-authenticated-user-params) -> result<string, delete-gpg-key-for-authenticated-user-error>;

  /// List public SSH keys for the authenticated user
  record list-public-ssh-keys-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-ssh-keys-for-authenticated-user: func(params: list-public-ssh-keys-for-authenticated-user-params) -> result<list<key>, list-public-ssh-keys-for-authenticated-user-error>;

  /// Create a public SSH key for the authenticated user
  record create-public-ssh-key-for-authenticated-user-params {
    /// The public SSH key to add to your GitHub account.
    key: string,
    /// A descriptive name for the new key.
    title: option<string>
  }
  create-public-ssh-key-for-authenticated-user: func(params: create-public-ssh-key-for-authenticated-user-params) -> result<key, create-public-ssh-key-for-authenticated-user-error>;

  /// Get a public SSH key for the authenticated user
  record get-public-ssh-key-for-authenticated-user-params {
    /// The unique identifier of the key.
    key-id: string
  }
  get-public-ssh-key-for-authenticated-user: func(params: get-public-ssh-key-for-authenticated-user-params) -> result<key, get-public-ssh-key-for-authenticated-user-error>;

  /// Delete a public SSH key for the authenticated user
  record delete-public-ssh-key-for-authenticated-user-params {
    /// The unique identifier of the key.
    key-id: string
  }
  delete-public-ssh-key-for-authenticated-user: func(params: delete-public-ssh-key-for-authenticated-user-params) -> result<string, delete-public-ssh-key-for-authenticated-user-error>;

  /// List public email addresses for the authenticated user
  record list-public-emails-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-emails-for-authenticated-user: func(params: list-public-emails-for-authenticated-user-params) -> result<list<email>, list-public-emails-for-authenticated-user-error>;

  /// List SSH signing keys for the authenticated user
  record list-ssh-signing-keys-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-ssh-signing-keys-for-authenticated-user: func(params: list-ssh-signing-keys-for-authenticated-user-params) -> result<list<ssh-signing-key>, list-ssh-signing-keys-for-authenticated-user-error>;

  /// Create a SSH signing key for the authenticated user
  record create-ssh-signing-key-for-authenticated-user-params {
    /// The public SSH key to add to your GitHub account. For more information, see "[Checking for existing SSH keys](https://docs.github.com/authentication/connecting-to-github-with-ssh/checking-for-existing-ssh-keys)."
    key: string,
    /// A descriptive name for the new key.
    title: option<string>
  }
  create-ssh-signing-key-for-authenticated-user: func(params: create-ssh-signing-key-for-authenticated-user-params) -> result<ssh-signing-key, create-ssh-signing-key-for-authenticated-user-error>;

  /// Get an SSH signing key for the authenticated user
  record get-ssh-signing-key-for-authenticated-user-params {
    /// The unique identifier of the SSH signing key.
    ssh-signing-key-id: string
  }
  get-ssh-signing-key-for-authenticated-user: func(params: get-ssh-signing-key-for-authenticated-user-params) -> result<ssh-signing-key, get-ssh-signing-key-for-authenticated-user-error>;

  /// Delete an SSH signing key for the authenticated user
  record delete-ssh-signing-key-for-authenticated-user-params {
    /// The unique identifier of the SSH signing key.
    ssh-signing-key-id: string
  }
  delete-ssh-signing-key-for-authenticated-user: func(params: delete-ssh-signing-key-for-authenticated-user-params) -> result<string, delete-ssh-signing-key-for-authenticated-user-error>;

  /// List users
  record list-op-params {
    /// A user ID. Only return users with an ID greater than this ID.
    since: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list<simple-user>, list-op-error>;

  /// Get a user
  record get-by-username-params {
    /// The handle for the GitHub user account.
    username: string
  }
  get-by-username: func(params: get-by-username-params) -> result<string, get-by-username-error>;

  /// List followers of a user
  record list-followers-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-followers-for-user: func(params: list-followers-for-user-params) -> result<list<simple-user>, string>;

  /// List the people a user follows
  record list-following-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-following-for-user: func(params: list-following-for-user-params) -> result<list<simple-user>, string>;

  /// Check if a user follows another user
  record check-following-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    target-user: string
  }
  check-following-for-user: func(params: check-following-for-user-params) -> result<string, check-following-for-user-error>;

  /// List GPG keys for a user
  record list-gpg-keys-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-gpg-keys-for-user: func(params: list-gpg-keys-for-user-params) -> result<list<gpg-key>, string>;

  /// Get contextual information for a user
  record get-context-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// Identifies which additional information you'd like to receive about the person's hovercard. Can be `organization`, `repository`, `issue`, `pull_request`. **Required** when using `subject_id`.
    subject-type: option<get-context-for-user-subject-type-enum>,
    /// Uses the ID for the `subject_type` you specified. **Required** when using `subject_type`.
    subject-id: option<string>
  }
  get-context-for-user: func(params: get-context-for-user-params) -> result<hovercard, get-context-for-user-error>;

  /// List public keys for a user
  record list-public-keys-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-keys-for-user: func(params: list-public-keys-for-user-params) -> result<list<key-simple>, string>;

  /// List SSH signing keys for a user
  record list-ssh-signing-keys-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-ssh-signing-keys-for-user: func(params: list-ssh-signing-keys-for-user-params) -> result<list<ssh-signing-key>, string>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export meta;
  export apps;
  export codes-of-conduct;
  export emojis;
  export dependabot;
  export secret-scanning;
  export activity;
  export gists;
  export gitignore;
  export issues;
  export licenses;
  export markdown;
  export orgs;
  export actions;
  export oidc;
  export code-scanning;
  export codespaces;
  export interactions;
  export migrations;
  export packages;
  export projects;
  export repos;
  export billing;
  export teams;
  export reactions;
  export rate-limit;
  export checks;
  export dependency-graph;
  export git;
  export pulls;
  export search;
  export users;
}
