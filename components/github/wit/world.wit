  /// List issues assigned to the authenticated user
  record list-op-params {
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<list-op-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<list-op-state-enum>,
    /// A list of comma separated label names. Example: `bug,ui,@high`
    labels: option<string>,
    /// What to sort results by.
    sort: option<list-op-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    collab: option<bool>,
    orgs: option<bool>,
    owned: option<bool>,
    pulls: option<bool>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<list<issue>, list-op-error>;

  /// List organization issues assigned to the authenticated user
  record list-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<list-op-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<list-op-state-enum>,
    /// A list of comma separated label names. Example: `bug,ui,@high`
    labels: option<string>,
    /// What to sort results by.
    sort: option<list-op-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-org: func(params: list-for-org-params) -> result<list<issue>, list-for-org-error>;

  /// List assignees
  record list-assignees-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-assignees: func(params: list-assignees-params) -> result<list<simple-user>, list-assignees-error>;

  /// Check if a user can be assigned
  record check-user-can-be-assigned-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    assignee: string
  }
  check-user-can-be-assigned: func(params: check-user-can-be-assigned-params) -> result<string, check-user-can-be-assigned-error>;

  /// List repository issues
  record list-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// If an `integer` is passed, it should refer to a milestone by its `number` field. If the string `*` is passed, issues with any milestone are accepted. If the string `none` is passed, issues without milestones are returned.
    milestone: option<string>,
    /// Indicates the state of the issues to return.
    state: option<list-op-state-enum>,
    /// Can be the name of a user. Pass in `none` for issues with no assigned user, and `*` for issues assigned to any user.
    assignee: option<string>,
    /// The user that created the issue.
    creator: option<string>,
    /// A user that's mentioned in the issue.
    mentioned: option<string>,
    /// A list of comma separated label names. Example: `bug,ui,@high`
    labels: option<string>,
    /// What to sort results by.
    sort: option<list-op-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-repo: func(params: list-for-repo-params) -> result<list<issue>, list-for-repo-error>;

  /// Create an issue
  record create-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Login for the user that this issue should be assigned to. _NOTE: Only users with push access can set the assignee for new issues. The assignee is silently dropped otherwise. **This field is deprecated.**_
    assignee: option<string>,
    /// Logins for Users to assign to this issue. _NOTE: Only users with push access can set assignees for new issues. Assignees are silently dropped otherwise._
    assignees: option<list<string>>,
    /// The contents of the issue.
    body: option<string>,
    /// Labels to associate with this issue. _NOTE: Only users with push access can set labels for new issues. Labels are silently dropped otherwise._
    labels: option<list<string>>,
    milestone: option<string>,
    /// The title of the issue.
    title: string
  }
  create: func(params: create-params) -> result<issue, create-error>;

  /// List issue comments for a repository
  record list-comments-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The property to sort the results by. `created` means when the repository was starred. `updated` means when the repository was last pushed to.
    sort: option<list-comments-for-repo-sort-enum>,
    /// Either `asc` or `desc`. Ignored without the `sort` parameter.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-comments-for-repo: func(params: list-comments-for-repo-params) -> result<list<issue-comment>, list-comments-for-repo-error>;

  /// Get an issue comment
  record get-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  get-comment: func(params: get-comment-params) -> result<issue-comment, get-comment-error>;

  /// Update an issue comment
  record update-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string,
    /// The contents of the comment.
    body: string
  }
  update-comment: func(params: update-comment-params) -> result<issue-comment, update-comment-error>;

  /// Delete an issue comment
  record delete-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the comment.
    comment-id: string
  }
  delete-comment: func(params: delete-comment-params) -> result<string, string>;

  /// List issue events for a repository
  record list-events-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-events-for-repo: func(params: list-events-for-repo-params) -> result<list<issue-event>, list-events-for-repo-error>;

  /// Get an issue event
  record get-event-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    event-id: string
  }
  get-event: func(params: get-event-params) -> result<issue-event, get-event-error>;

  /// Get an issue
  record get-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string
  }
  get: func(params: get-params) -> result<issue, get-error>;

  /// Update an issue
  record update-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// Username to assign to this issue. **This field is deprecated.**
    assignee: option<string>,
    /// Usernames to assign to this issue. Pass one or more user logins to _replace_ the set of assignees on this issue. Send an empty array (`[]`) to clear all assignees from the issue. Only users with push access can set assignees for new issues. Without push access to the repository, assignee changes are silently dropped.
    assignees: option<list<string>>,
    /// The contents of the issue.
    body: option<string>,
    /// Labels to associate with this issue. Pass one or more labels to _replace_ the set of labels on this issue. Send an empty array (`[]`) to clear all labels from the issue. Only users with push access can set labels for issues. Without push access to the repository, label changes are silently dropped.
    labels: option<list<string>>,
    milestone: option<string>,
    /// The open or closed state of the issue.
    state: option<nullable-milestone-state-enum>,
    /// The reason for the state change. Ignored unless `state` is changed.
    state-reason: option<update-body-state-reason-enum>,
    /// The title of the issue.
    title: option<string>
  }
  update: func(params: update-params) -> result<issue, update-error>;

  /// Add assignees to an issue
  record add-assignees-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// Usernames of people to assign this issue to. _NOTE: Only users with push access can add assignees to an issue. Assignees are silently ignored otherwise._
    assignees: option<list<string>>
  }
  add-assignees: func(params: add-assignees-params) -> result<issue, string>;

  /// Remove assignees from an issue
  record remove-assignees-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// Usernames of assignees to remove from an issue. _NOTE: Only users with push access can remove assignees from an issue. Assignees are silently ignored otherwise._
    assignees: option<list<string>>
  }
  remove-assignees: func(params: remove-assignees-params) -> result<issue, string>;

  /// Check if a user can be assigned to a issue
  record check-user-can-be-assigned-to-issue-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    assignee: string
  }
  check-user-can-be-assigned-to-issue: func(params: check-user-can-be-assigned-to-issue-params) -> result<string, check-user-can-be-assigned-to-issue-error>;

  /// List issue comments
  record list-comments-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-comments: func(params: list-comments-params) -> result<list<issue-comment>, list-comments-error>;

  /// Create an issue comment
  record create-comment-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The contents of the comment.
    body: string
  }
  create-comment: func(params: create-comment-params) -> result<issue-comment, create-comment-error>;

  /// List issue events
  record list-events-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-events: func(params: list-events-params) -> result<list<string>, list-events-error>;

  /// List labels for an issue
  record list-labels-on-issue-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-labels-on-issue: func(params: list-labels-on-issue-params) -> result<list<label>, list-labels-on-issue-error>;

  /// Add labels to an issue
  record add-labels-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    body: option<string>
  }
  add-labels: func(params: add-labels-params) -> result<list<label>, add-labels-error>;

  /// Set labels for an issue
  record set-labels-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    body: option<string>
  }
  set-labels: func(params: set-labels-params) -> result<list<label>, set-labels-error>;

  /// Remove all labels from an issue
  record remove-all-labels-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string
  }
  remove-all-labels: func(params: remove-all-labels-params) -> result<string, remove-all-labels-error>;

  /// Remove a label from an issue
  record remove-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    name: string
  }
  remove-label: func(params: remove-label-params) -> result<list<label>, remove-label-error>;

  /// Lock an issue
  record lock-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The reason for locking the issue or pull request conversation. Lock will fail if you don't use one of these reasons:  
    ///  * `off-topic`  
    lock-reason: option<lock-body-lock-reason-enum>
  }
  lock: func(params: lock-params) -> result<string, lock-error>;

  /// Unlock an issue
  record unlock-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string
  }
  unlock: func(params: unlock-params) -> result<string, unlock-error>;

  /// List timeline events for an issue
  record list-events-for-timeline-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the issue.
    issue-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-events-for-timeline: func(params: list-events-for-timeline-params) -> result<list<timeline-issue-events>, list-events-for-timeline-error>;

  /// List labels for a repository
  record list-labels-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-labels-for-repo: func(params: list-labels-for-repo-params) -> result<list<label>, list-labels-for-repo-error>;

  /// Create a label
  record create-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The [hexadecimal color code](http://www.color-hex.com/) for the label, without the leading `#`.
    color: option<string>,
    /// A short description of the label. Must be 100 characters or fewer.
    description: option<string>,
    /// The name of the label. Emoji can be added to label names, using either native emoji or colon-style markup. For example, typing `:strawberry:` will render the emoji ![:strawberry:](https://github.githubassets.com/images/icons/emoji/unicode/1f353.png ":strawberry:"). For a full list of available emoji and codes, see "[Emoji cheat sheet](https://github.com/ikatyang/emoji-cheat-sheet)."
    name: string
  }
  create-label: func(params: create-label-params) -> result<label, create-label-error>;

  /// Get a label
  record get-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    name: string
  }
  get-label: func(params: get-label-params) -> result<label, get-label-error>;

  /// Update a label
  record update-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    name: string,
    /// The [hexadecimal color code](http://www.color-hex.com/) for the label, without the leading `#`.
    color: option<string>,
    /// A short description of the label. Must be 100 characters or fewer.
    description: option<string>,
    /// The new name of the label. Emoji can be added to label names, using either native emoji or colon-style markup. For example, typing `:strawberry:` will render the emoji ![:strawberry:](https://github.githubassets.com/images/icons/emoji/unicode/1f353.png ":strawberry:"). For a full list of available emoji and codes, see "[Emoji cheat sheet](https://github.com/ikatyang/emoji-cheat-sheet)."
    new-name: option<string>
  }
  update-label: func(params: update-label-params) -> result<label, string>;

  /// Delete a label
  record delete-label-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    name: string
  }
  delete-label: func(params: delete-label-params) -> result<string, string>;

  /// List milestones
  record list-milestones-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The state of the milestone. Either `open`, `closed`, or `all`.
    state: option<list-op-state-enum>,
    /// What to sort results by. Either `due_on` or `completeness`.
    sort: option<list-milestones-sort-enum>,
    /// The direction of the sort. Either `asc` or `desc`.
    direction: option<list-op-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-milestones: func(params: list-milestones-params) -> result<list<milestone>, list-milestones-error>;

  /// Create a milestone
  record create-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// A description of the milestone.
    description: option<string>,
    /// The milestone due date. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    due-on: option<string>,
    /// The state of the milestone. Either `open` or `closed`.
    state: option<nullable-milestone-state-enum>,
    /// The title of the milestone.
    title: string
  }
  create-milestone: func(params: create-milestone-params) -> result<milestone, create-milestone-error>;

  /// Get a milestone
  record get-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the milestone.
    milestone-number: string
  }
  get-milestone: func(params: get-milestone-params) -> result<milestone, get-milestone-error>;

  /// Update a milestone
  record update-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the milestone.
    milestone-number: string,
    /// A description of the milestone.
    description: option<string>,
    /// The milestone due date. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    due-on: option<string>,
    /// The state of the milestone. Either `open` or `closed`.
    state: option<nullable-milestone-state-enum>,
    /// The title of the milestone.
    title: option<string>
  }
  update-milestone: func(params: update-milestone-params) -> result<milestone, string>;

  /// Delete a milestone
  record delete-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the milestone.
    milestone-number: string
  }
  delete-milestone: func(params: delete-milestone-params) -> result<string, delete-milestone-error>;

  /// List labels for issues in a milestone
  record list-labels-for-milestone-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the milestone.
    milestone-number: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-labels-for-milestone: func(params: list-labels-for-milestone-params) -> result<list<label>, string>;

  /// List user account issues assigned to the authenticated user
  record list-for-authenticated-user-params {
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<list-op-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<list-op-state-enum>,
    /// A list of comma separated label names. Example: `bug,ui,@high`
    labels: option<string>,
    /// What to sort results by.
    sort: option<list-op-sort-enum>,
    /// The direction to sort the results by.
    direction: option<list-op-direction-enum>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<list<issue>, list-for-authenticated-user-error>;

}

interface licenses {
  /// License Simple
  record license-simple {
    html-url: option<string>,
    key: string,
    name: string,
    node-id: string,
    spdx-id: string,
    url: string
  }

  /// License
  record license {
    body: string,
    conditions: list<string>,
    description: string,
    featured: bool,
    html-url: string,
    implementation: string,
    key: string,
    limitations: list<string>,
    name: string,
    node-id: string,
    permissions: list<string>,
    spdx-id: string,
    url: string
  }

  /// License Content
  record license-content {
    links: license-content-links,
    content: string,
    download-url: string,
    encoding: string,
    git-url: string,
    html-url: string,
    license: nullable-license-simple,
    name: string,
    path: string,
    sha: string,
    size: s32,
    type-op: string,
    url: string
  }

  record license-content-links {
    git: string,
    html: string,
    self: string
  }

  /// License Simple
  record nullable-license-simple {
    html-url: option<string>,
    key: string,
    name: string,
    node-id: string,
    spdx-id: string,
    url: string
  }

  variant get-all-commonly-used-error {
    not-modified(string),
    other(string)
  }

  variant get-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get all commonly used licenses
  record get-all-commonly-used-params {
    featured: option<bool>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  get-all-commonly-used: func(params: get-all-commonly-used-params) -> result<list<license-simple>, get-all-commonly-used-error>;

  /// Get a license
  record get-params {
    license: string
  }
  get: func(params: get-params) -> result<license, get-error>;

  /// Get the license for a repository
  record get-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-for-repo: func(params: get-for-repo-params) -> result<license-content, string>;

}

interface markdown {
  enum render-body-mode-enum {
    markdown,
    gfm,
  }

  variant render-error {
    not-modified(string),
    other(string)
  }

  variant render-raw-error {
    not-modified(string),
    other(string)
  }

  /// Render a Markdown document
  record render-params {
    /// The repository context to use when creating references in `gfm` mode.  For example, setting `context` to `octo-org/octo-repo` will change the text `#42` into an HTML link to issue 42 in the `octo-org/octo-repo` repository.
    context: option<string>,
    /// The rendering mode.
    mode: option<render-body-mode-enum>,
    /// The Markdown text to render in HTML.
    text: string
  }
  render: func(params: render-params) -> result<string, render-error>;

  /// Render a Markdown document in raw mode
  record render-raw-params {
    body: option<string>
  }
  render-raw: func(params: render-raw-params) -> result<string, render-raw-error>;

}

interface orgs {
  enum update-body-default-repository-permission-enum {
    read,
    write,
    admin,
    none,
  }

  enum update-body-members-allowed-repository-creation-type-enum {
    all,
    private,
    none,
  }

  enum app-permissions-actions-enum {
    read,
    write,
  }

  enum app-permissions-organization-plan-enum {
    read,
  }

  enum app-permissions-organization-projects-enum {
    read,
    write,
    admin,
  }

  enum app-permissions-workflows-enum {
    write,
  }

  enum installation-repository-selection-enum {
    all,
    selected,
  }

  enum list-pending-invitations-role-enum {
    all,
    admin,
    direct-member,
    billing-manager,
    hiring-manager,
  }

  enum list-pending-invitations-invitation-source-enum {
    all,
    member,
    scim,
  }

  enum create-invitation-body-role-enum {
    admin,
    direct-member,
    billing-manager,
  }

  enum list-members-filter-enum {
    v2fa-disabled,
    all,
  }

  enum list-members-role-enum {
    all,
    admin,
    member,
  }

  enum org-membership-role-enum {
    admin,
    member,
    billing-manager,
  }

  enum org-membership-state-enum {
    active,
    pending,
  }

  enum set-membership-for-user-body-role-enum {
    admin,
    member,
  }

  enum update-membership-for-authenticated-user-body-state-enum {
    active,
  }

  /// A GitHub organization.
  record organization-simple {
    avatar-url: string,
    description: string,
    events-url: string,
    hooks-url: string,
    id: s32,
    issues-url: string,
    login: string,
    members-url: string,
    node-id: string,
    public-members-url: string,
    repos-url: string,
    url: string
  }

  /// Organization Full
  record organization-full {
    /// Whether GitHub Advanced Security is enabled for new repositories and repositories transferred to this organization.
    /// 
    advanced-security-enabled-for-new-repositories: option<bool>,
    avatar-url: string,
    billing-email: option<string>,
    blog: option<string>,
    collaborators: option<s32>,
    company: option<string>,
    created-at: string,
    default-repository-permission: option<string>,
    /// Whether GitHub Advanced Security is automatically enabled for new repositories and repositories transferred to
    /// this organization.
    dependabot-alerts-enabled-for-new-repositories: option<bool>,
    /// Whether dependabot security updates are automatically enabled for new repositories and repositories transferred
    /// to this organization.
    dependabot-security-updates-enabled-for-new-repositories: option<bool>,
    /// Whether dependency graph is automatically enabled for new repositories and repositories transferred to this
    /// organization.
    dependency-graph-enabled-for-new-repositories: option<bool>,
    description: string,
    disk-usage: option<s32>,
    email: option<string>,
    events-url: string,
    followers: s32,
    following: s32,
    has-organization-projects: bool,
    has-repository-projects: bool,
    hooks-url: string,
    html-url: string,
    id: s32,
    is-verified: option<bool>,
    issues-url: string,
    location: option<string>,
    login: string,
    members-allowed-repository-creation-type: option<string>,
    members-can-create-internal-repositories: option<bool>,
    members-can-create-pages: option<bool>,
    members-can-create-private-pages: option<bool>,
    members-can-create-private-repositories: option<bool>,
    members-can-create-public-pages: option<bool>,
    members-can-create-public-repositories: option<bool>,
    members-can-create-repositories: option<bool>,
    members-can-fork-private-repositories: option<bool>,
    members-url: string,
    name: option<string>,
    node-id: string,
    owned-private-repos: option<s32>,
    plan: option<organization-full-plan>,
    private-gists: option<s32>,
    public-gists: s32,
    public-members-url: string,
    public-repos: s32,
    repos-url: string,
    /// Whether secret scanning is automatically enabled for new repositories and repositories transferred to this
    /// organization.
    secret-scanning-enabled-for-new-repositories: option<bool>,
    /// An optional URL string to display to contributors who are blocked from pushing a secret.
    secret-scanning-push-protection-custom-link: option<string>,
    /// Whether a custom link is shown to contributors who are blocked from pushing a secret by push protection.
    secret-scanning-push-protection-custom-link-enabled: option<bool>,
    /// Whether secret scanning push protection is automatically enabled for new repositories and repositories
    /// transferred to this organization.
    secret-scanning-push-protection-enabled-for-new-repositories: option<bool>,
    total-private-repos: option<s32>,
    twitter-username: option<string>,
    two-factor-requirement-enabled: option<bool>,
    type-op: string,
    updated-at: string,
    url: string,
    web-commit-signoff-required: option<bool>
  }

  record organization-full-plan {
    filled-seats: option<s32>,
    name: string,
    private-repos: s32,
    seats: option<s32>,
    space: s32
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Organization Invitation
  record organization-invitation {
    created-at: string,
    email: string,
    failed-at: option<string>,
    failed-reason: option<string>,
    id: s32,
    invitation-source: option<string>,
    invitation-teams-url: string,
    inviter: simple-user,
    login: string,
    node-id: string,
    role: string,
    team-count: s32
  }

  /// Org Hook
  record org-hook {
    active: bool,
    config: org-hook-config,
    created-at: string,
    deliveries-url: option<string>,
    events: list<string>,
    id: s32,
    name: string,
    ping-url: string,
    type-op: string,
    updated-at: string,
    url: string
  }

  record org-hook-config {
    content-type: option<string>,
    insecure-ssl: option<string>,
    secret: option<string>,
    url: option<string>
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#create-hook-config-params).
  record create-webhook-body-config {
    content-type: option<string>,
    insecure-ssl: option<string>,
    password: option<string>,
    secret: option<string>,
    url: string,
    username: option<string>
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#update-hook-config-params).
  record update-webhook-body-config {
    content-type: option<string>,
    insecure-ssl: option<string>,
    secret: option<string>,
    url: string
  }

  /// Configuration object of the webhook
  record webhook-config {
    content-type: option<string>,
    insecure-ssl: option<string>,
    secret: option<string>,
    url: option<string>
  }

  /// Delivery made by a webhook, without request and response information.
  record hook-delivery-item {
    /// The type of activity for the event that triggered the delivery.
    action: string,
    /// Time when the webhook delivery occurred.
    delivered-at: string,
    /// Time spent delivering.
    duration: f64,
    /// The event that triggered the delivery.
    event: string,
    /// Unique identifier for the event (shared with all deliveries for all webhooks that subscribe to this event).
    guid: string,
    /// Unique identifier of the webhook delivery.
    id: s32,
    /// The id of the GitHub App installation associated with this event.
    installation-id: s32,
    /// Whether the webhook delivery is a redelivery.
    redelivery: bool,
    /// The id of the repository associated with this event.
    repository-id: s32,
    /// Describes the response returned after attempting the delivery.
    status: string,
    /// Status code received when delivery was made.
    status-code: s32
  }

  /// Delivery made by a webhook.
  record hook-delivery {
    /// The type of activity for the event that triggered the delivery.
    action: string,
    /// Time when the delivery was delivered.
    delivered-at: string,
    /// Time spent delivering.
    duration: f64,
    /// The event that triggered the delivery.
    event: string,
    /// Unique identifier for the event (shared with all deliveries for all webhooks that subscribe to this event).
    guid: string,
    /// Unique identifier of the delivery.
    id: s32,
    /// The id of the GitHub App installation associated with this event.
    installation-id: s32,
    /// Whether the delivery is a redelivery.
    redelivery: bool,
    /// The id of the repository associated with this event.
    repository-id: s32,
    request: hook-delivery-request,
    response: hook-delivery-response,
    /// Description of the status of the attempted delivery
    status: string,
    /// Status code received when delivery was made.
    status-code: s32,
    /// The URL target of the delivery.
    url: option<string>
  }

  record hook-delivery-request {
    /// The request headers sent with the webhook delivery.
    headers: list<hook-delivery-request-headers-entry>,
    /// The webhook payload.
    payload: list<hook-delivery-request-payload-entry>
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-request-headers-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-request-payload-entry {
    key: string,
    value: string
  }

  record hook-delivery-response {
    /// The response headers received when the delivery was made.
    headers: list<hook-delivery-response-headers-entry>,
    /// The response payload received.
    payload: string
  }

  /// one entry of a string-keyed map (free-form object)
  record hook-delivery-response-headers-entry {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record redeliver-webhook-delivery-response-entry {
    key: string,
    value: string
  }

  record list-app-installations-response {
    installations: list<installation>,
    total-count: s32
  }

  /// Installation
  record installation {
    access-tokens-url: string,
    account: string,
    app-id: s32,
    app-slug: string,
    contact-email: option<string>,
    created-at: string,
    events: list<string>,
    has-multiple-single-files: option<bool>,
    html-url: string,
    /// The ID of the installation.
    id: s32,
    permissions: app-permissions,
    repositories-url: string,
    /// Describe whether all repositories have been selected or there's a selection involved
    repository-selection: installation-repository-selection-enum,
    single-file-name: string,
    single-file-paths: option<list<string>>,
    suspended-at: string,
    suspended-by: nullable-simple-user,
    /// The ID of the user or organization this token is being scoped to.
    target-id: s32,
    target-type: string,
    updated-at: string
  }

  /// The permissions granted to the user-to-server access token.
  record app-permissions {
    /// The level of permission to grant the access token for GitHub Actions workflows, workflow runs, and artifacts.
    actions: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for repository creation, deletion, settings, teams, and collaborators creation.
    administration: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for checks on code.
    checks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for repository contents, commits, branches, downloads, releases, and merges.
    contents: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for deployments and deployment statuses.
    deployments: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for managing repository environments.
    environments: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for issues and related comments, assignees, labels, and milestones.
    issues: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for organization teams and members.
    members: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to search repositories, list collaborators, and access repository metadata.
    metadata: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage access to an organization.
    organization-administration: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage announcement banners for an organization.
    organization-announcement-banners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for custom repository roles management. This property is in beta and is subject to change.
    organization-custom-roles: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage the post-receive hooks for an organization.
    organization-hooks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for organization packages published to GitHub Packages.
    organization-packages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for viewing an organization's plan.
    organization-plan: option<app-permissions-organization-plan-enum>,
    /// The level of permission to grant the access token to manage organization projects and projects beta (where available).
    organization-projects: option<app-permissions-organization-projects-enum>,
    /// The level of permission to grant the access token to manage organization secrets.
    organization-secrets: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage GitHub Actions self-hosted runners available to an organization.
    organization-self-hosted-runners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage users blocked by the organization.
    organization-user-blocking: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for packages published to GitHub Packages.
    packages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to retrieve Pages statuses, configuration, and builds, as well as create new builds.
    pages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for pull requests and related comments, assignees, labels, milestones, and merges.
    pull-requests: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage announcement banners for a repository.
    repository-announcement-banners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage the post-receive hooks for a repository.
    repository-hooks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage repository projects, columns, and cards.
    repository-projects: option<app-permissions-organization-projects-enum>,
    /// The level of permission to grant the access token to view and manage secret scanning alerts.
    secret-scanning-alerts: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage repository secrets.
    secrets: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage security events like code scanning alerts.
    security-events: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage just a single file.
    single-file: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for commit statuses.
    statuses: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage team discussions and related comments.
    team-discussions: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage Dependabot alerts.
    vulnerability-alerts: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to update GitHub Actions workflow files.
    workflows: option<app-permissions-workflows-enum>
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record team {
    description: string,
    html-url: string,
    id: s32,
    members-url: string,
    name: string,
    node-id: string,
    parent: nullable-team-simple,
    permission: string,
    permissions: option<team-permissions>,
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    url: string
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record nullable-team-simple {
    /// Description of the team
    description: string,
    html-url: string,
    /// Unique identifier of the team
    id: s32,
    /// Distinguished Name (DN) that team maps to within LDAP environment
    ldap-dn: option<string>,
    members-url: string,
    /// Name of the team
    name: string,
    node-id: string,
    /// Permission that the team will have for its repositories
    permission: string,
    /// The level of privacy this team should have
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    /// URL for the team
    url: string
  }

  record team-permissions {
    admin: bool,
    maintain: bool,
    pull: bool,
    push: bool,
    triage: bool
  }

  /// Org Membership
  record org-membership {
    organization: organization-simple,
    organization-url: string,
    permissions: option<org-membership-permissions>,
    /// The user's membership type in the organization.
    role: org-membership-role-enum,
    /// The state of the member in the organization. The `pending` state indicates the user has not yet accepted an invitation.
    state: org-membership-state-enum,
    url: string,
    user: nullable-simple-user
  }

  record org-membership-permissions {
    can-create-repository: bool
  }

  record convert-member-to-outside-collaborator-response {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Groups of organization members that gives permissions on specified repositories.
  record team-simple {
    /// Description of the team
    description: string,
    html-url: string,
    /// Unique identifier of the team
    id: s32,
    /// Distinguished Name (DN) that team maps to within LDAP environment
    ldap-dn: option<string>,
    members-url: string,
    /// Name of the team
    name: string,
    node-id: string,
    /// Permission that the team will have for its repositories
    permission: string,
    /// The level of privacy this team should have
    privacy: option<string>,
    repositories-url: string,
    slug: string,
    /// URL for the team
    url: string
  }

