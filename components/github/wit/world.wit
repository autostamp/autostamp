    repo: string
  }
  list-devcontainers-in-repository-for-authenticated-user: func(params: list-devcontainers-in-repository-for-authenticated-user-params) -> result<string, string>;

  /// List available machine types for a repository
  record repo-machines-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
