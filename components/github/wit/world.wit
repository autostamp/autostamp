interface rate-limit {
  /// Rate Limit Overview
  record overview {
    rate: rate-limit,
    resources: overview-resources
  }

  record rate-limit {
    limit: s32,
    remaining: s32,
    reset: s32,
    used: s32
  }

  record overview-resources {
    actions-runner-registration: option<rate-limit>,
    code-scanning-upload: option<rate-limit>,
    core: rate-limit,
    dependency-snapshots: option<rate-limit>,
    graphql: option<rate-limit>,
    integration-manifest: option<rate-limit>,
    scim: option<rate-limit>,
    search: rate-limit,
    source-import: option<rate-limit>
  }

  variant get-error {
    not-modified(string),
    not-found(string),
    other(string)
  }

  /// Get rate limit status for the authenticated user
  get: func() -> result<overview, get-error>;

}

interface checks {
  enum create-body-conclusion-enum {
    action-required,
    cancelled,
    failure,
    neutral,
    success,
    skipped,
    stale,
    timed-out,
  }

  enum create-body-output-annotations-item-annotation-level-enum {
    notice,
    warning,
    failure,
  }

  enum create-body-status-enum {
    queued,
    in-progress,
    completed,
  }

  enum check-run-conclusion-enum {
    success,
    failure,
    neutral,
    cancelled,
    skipped,
    timed-out,
    action-required,
  }

  enum check-suite-conclusion-enum {
    success,
    failure,
    neutral,
    cancelled,
    skipped,
    timed-out,
    action-required,
    startup-failure,
    stale,
  }

  enum security-and-analysis-advanced-security-status-enum {
    enabled,
    disabled,
  }

  enum list-for-suite-filter-enum {
    latest,
    all,
  }

  record create-body-actions-item {
    /// A short explanation of what this action would do. The maximum size is 40 characters.
    description: string,
    /// A reference for the action on the integrator's system. The maximum size is 20 characters.
    identifier: string,
    /// The text to be displayed on a button in the web UI. The maximum size is 20 characters.
    label: string
  }

  /// Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run.
  record create-body-output {
    /// Adds information from your analysis to specific lines of code. Annotations are visible on GitHub in the **Checks** and **Files changed** tab of the pull request. The Checks API limits the number of annotations to a maximum of 50 per API request. To create more than 50 annotations, you have to make multiple requests to the [Update a check run](https://docs.github.com/rest/reference/checks#update-a-check-run) endpoint. Each time you update the check run, annotations are appended to the list of annotations that already exist for the check run. For details about how you can view annotations on GitHub, see "[About status checks](https://docs.github.com/articles/about-status-checks#checks)".
    annotations: option<list<create-body-output-annotations-item>>,
    /// Adds images to the output displayed in the GitHub pull request UI.
    images: option<list<create-body-output-images-item>>,
    /// The summary of the check run. This parameter supports Markdown. **Maximum length**: 65535 characters.
    summary: string,
    /// The details of the check run. This parameter supports Markdown. **Maximum length**: 65535 characters.
    text: option<string>,
    /// The title of the check run.
    title: string
  }

  record create-body-output-annotations-item {
    /// The level of the annotation.
    annotation-level: create-body-output-annotations-item-annotation-level-enum,
    /// The end column of the annotation. Annotations only support `start_column` and `end_column` on the same line. Omit this parameter if `start_line` and `end_line` have different values.
    end-column: option<s32>,
    /// The end line of the annotation.
    end-line: s32,
    /// A short description of the feedback for these lines of code. The maximum size is 64 KB.
    message: string,
    /// The path of the file to add an annotation to. For example, `assets/css/main.css`.
    path: string,
    /// Details about this annotation. The maximum size is 64 KB.
    raw-details: option<string>,
    /// The start column of the annotation. Annotations only support `start_column` and `end_column` on the same line. Omit this parameter if `start_line` and `end_line` have different values. Column numbers start at 1.
    start-column: option<s32>,
    /// The start line of the annotation. Line numbers start at 1.
    start-line: s32,
    /// The title that represents the annotation. The maximum size is 255 characters.
    title: option<string>
  }

  record create-body-output-images-item {
    /// The alternative text for the image.
    alt: string,
    /// A short image description.
    caption: option<string>,
    /// The full URL of the image.
    image-url: string
  }

  /// A check performed on the code of a given code change
  record check-run {
    app: nullable-integration,
    check-suite: check-run-check-suite,
    completed-at: string,
    conclusion: check-run-conclusion-enum,
    deployment: option<deployment-simple>,
    details-url: string,
    external-id: string,
    /// The SHA of the commit that is being checked.
    head-sha: string,
    html-url: string,
    /// The id of the check.
    id: s32,
    /// The name of the check.
    name: string,
    node-id: string,
    output: check-run-output,
    pull-requests: list<pull-request-minimal>,
    started-at: string,
    /// The phase of the lifecycle that the check is currently in.
    status: create-body-status-enum,
    url: string
  }

  /// GitHub apps are a new way to extend GitHub. They can be installed directly on organizations and user accounts and granted access to specific repositories. They come with granular permissions and built-in webhooks. GitHub apps are first class actors within GitHub.
  record nullable-integration {
    client-id: option<string>,
    client-secret: option<string>,
    created-at: string,
    description: string,
    /// The list of events for the GitHub app
    events: list<string>,
    external-url: string,
    html-url: string,
    /// Unique identifier of the GitHub app
    id: s32,
    /// The number of installations associated with the GitHub app
    installations-count: option<s32>,
    /// The name of the GitHub app
    name: string,
    node-id: string,
    owner: nullable-simple-user,
    pem: option<string>,
    /// The set of permissions for the GitHub app
    permissions: nullable-integration-permissions,
    /// The slug name of the GitHub app
    slug: option<string>,
    updated-at: string,
    webhook-secret: option<string>
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// The set of permissions for the GitHub app
  record nullable-integration-permissions {
    checks: option<string>,
    contents: option<string>,
    deployments: option<string>,
    issues: option<string>,
    metadata: option<string>
  }

  record check-run-check-suite {
    id: s32
  }

  /// A deployment created as the result of an Actions check run from a workflow that references an environment
  record deployment-simple {
    created-at: string,
    description: string,
    /// Name for the target deployment environment.
    environment: string,
    /// Unique identifier of the deployment
    id: s32,
    node-id: string,
    original-environment: option<string>,
    performed-via-github-app: option<nullable-integration>,
    /// Specifies if the given environment is one that end-users directly interact with. Default: false.
    production-environment: option<bool>,
    repository-url: string,
    statuses-url: string,
    /// Parameter to specify a task to execute
    task: string,
    /// Specifies if the given environment is will no longer exist at some point in the future. Default: false.
    transient-environment: option<bool>,
    updated-at: string,
    url: string
  }

  record check-run-output {
    annotations-count: s32,
    annotations-url: string,
    summary: string,
    text: string,
    title: string
  }

  record pull-request-minimal {
    base: pull-request-minimal-base,
    head: pull-request-minimal-head,
    id: s32,
    number: s32,
    url: string
  }

  record pull-request-minimal-base {
    ref: string,
    repo: pull-request-minimal-base-repo,
    sha: string
  }

  record pull-request-minimal-base-repo {
    id: s32,
    name: string,
    url: string
  }

  record pull-request-minimal-head {
    ref: string,
    repo: pull-request-minimal-head-repo,
    sha: string
  }

  record pull-request-minimal-head-repo {
    id: s32,
    name: string,
    url: string
  }

  record update-body-actions-item {
    /// A short explanation of what this action would do. The maximum size is 40 characters.
    description: string,
    /// A reference for the action on the integrator's system. The maximum size is 20 characters.
    identifier: string,
    /// The text to be displayed on a button in the web UI. The maximum size is 20 characters.
    label: string
  }

  /// Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run.
  record update-body-output {
    /// Adds information from your analysis to specific lines of code. Annotations are visible in GitHub's pull request UI. Annotations are visible in GitHub's pull request UI. The Checks API limits the number of annotations to a maximum of 50 per API request. To create more than 50 annotations, you have to make multiple requests to the [Update a check run](https://docs.github.com/rest/reference/checks#update-a-check-run) endpoint. Each time you update the check run, annotations are appended to the list of annotations that already exist for the check run. For details about annotations in the UI, see "[About status checks](https://docs.github.com/articles/about-status-checks#checks)".
    annotations: option<list<update-body-output-annotations-item>>,
    /// Adds images to the output displayed in the GitHub pull request UI.
    images: option<list<update-body-output-images-item>>,
    /// Can contain Markdown.
    summary: string,
    /// Can contain Markdown.
    text: option<string>,
    /// **Required**.
    title: option<string>
  }

  record update-body-output-annotations-item {
    /// The level of the annotation.
    annotation-level: create-body-output-annotations-item-annotation-level-enum,
    /// The end column of the annotation. Annotations only support `start_column` and `end_column` on the same line. Omit this parameter if `start_line` and `end_line` have different values.
    end-column: option<s32>,
    /// The end line of the annotation.
    end-line: s32,
    /// A short description of the feedback for these lines of code. The maximum size is 64 KB.
    message: string,
    /// The path of the file to add an annotation to. For example, `assets/css/main.css`.
    path: string,
    /// Details about this annotation. The maximum size is 64 KB.
    raw-details: option<string>,
    /// The start column of the annotation. Annotations only support `start_column` and `end_column` on the same line. Omit this parameter if `start_line` and `end_line` have different values. Column numbers start at 1.
    start-column: option<s32>,
    /// The start line of the annotation. Line numbers start at 1.
    start-line: s32,
    /// The title that represents the annotation. The maximum size is 255 characters.
    title: option<string>
  }

  record update-body-output-images-item {
    /// The alternative text for the image.
    alt: string,
    /// A short image description.
    caption: option<string>,
    /// The full URL of the image.
    image-url: string
  }

  /// Check Annotation
  record check-annotation {
    annotation-level: string,
    blob-href: string,
    end-column: s32,
    end-line: s32,
    message: string,
    path: string,
    raw-details: string,
    start-column: s32,
    start-line: s32,
    title: string
  }

  /// An object without any properties.
  record empty-object {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A suite of checks performed on the code of a given code change
  record check-suite {
    after: string,
    app: nullable-integration,
    before: string,
    check-runs-url: string,
    conclusion: check-suite-conclusion-enum,
    created-at: string,
    head-branch: string,
    head-commit: simple-commit,
    /// The SHA of the head commit that is being checked.
    head-sha: string,
    id: s32,
    latest-check-runs-count: s32,
    node-id: string,
    pull-requests: list<pull-request-minimal>,
    repository: minimal-repository,
    rerequestable: option<bool>,
    runs-rerequestable: option<bool>,
    status: create-body-status-enum,
    updated-at: string,
    url: string
  }

  /// A commit.
  record simple-commit {
    author: simple-commit-author,
    committer: simple-commit-committer,
    id: string,
    message: string,
    timestamp: string,
    tree-id: string
  }

  record simple-commit-author {
    email: string,
    name: string
  }

  record simple-commit-committer {
    email: string,
    name: string
  }

  /// Minimal Repository
  record minimal-repository {
    allow-forking: option<bool>,
    archive-url: string,
    archived: option<bool>,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: option<string>,
    code-of-conduct: option<code-of-conduct>,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: option<string>,
    default-branch: option<string>,
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    disabled: option<bool>,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: option<s32>,
    forks-count: option<s32>,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: option<string>,
    has-discussions: option<bool>,
    has-downloads: option<bool>,
    has-issues: option<bool>,
    has-pages: option<bool>,
    has-projects: option<bool>,
    has-wiki: option<bool>,
    homepage: option<string>,
    hooks-url: string,
    html-url: string,
    id: s32,
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: option<string>,
    languages-url: string,
    license: option<minimal-repository-license>,
    merges-url: string,
    milestones-url: string,
    mirror-url: option<string>,
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: option<s32>,
    open-issues-count: option<s32>,
    owner: simple-user,
    permissions: option<minimal-repository-permissions>,
    private: bool,
    pulls-url: string,
    pushed-at: option<string>,
    releases-url: string,
    role-name: option<string>,
    security-and-analysis: option<security-and-analysis>,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: option<s32>,
    ssh-url: option<string>,
    stargazers-count: option<s32>,
    stargazers-url: string,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: option<string>,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: option<string>,
    url: string,
    visibility: option<string>,
    watchers: option<s32>,
    watchers-count: option<s32>,
    web-commit-signoff-required: option<bool>
  }

  /// Code Of Conduct
  record code-of-conduct {
    body: option<string>,
    html-url: string,
    key: string,
    name: string,
    url: string
  }

  record minimal-repository-license {
    key: option<string>,
    name: option<string>,
    node-id: option<string>,
    spdx-id: option<string>,
    url: option<string>
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  record minimal-repository-permissions {
    admin: option<bool>,
    maintain: option<bool>,
    pull: option<bool>,
    push: option<bool>,
    triage: option<bool>
  }

  record security-and-analysis {
    advanced-security: option<security-and-analysis-advanced-security>,
    secret-scanning: option<security-and-analysis-secret-scanning>,
    secret-scanning-push-protection: option<security-and-analysis-secret-scanning-push-protection>
  }

  record security-and-analysis-advanced-security {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record security-and-analysis-secret-scanning-push-protection {
    status: option<security-and-analysis-advanced-security-status-enum>
  }

  record set-suites-preferences-body-auto-trigger-checks-item {
    /// The `id` of the GitHub App.
    app-id: s32,
    /// Set to `true` to enable automatic creation of CheckSuite events upon pushes to the repository, or `false` to disable them.
    setting: bool
  }

  /// Check suite configuration preferences for a repository.
  record check-suite-preference {
    preferences: check-suite-preference-preferences,
    repository: minimal-repository
  }

  record check-suite-preference-preferences {
    auto-trigger-checks: option<list<check-suite-preference-preferences-auto-trigger-checks-item>>
  }

  record check-suite-preference-preferences-auto-trigger-checks-item {
    app-id: s32,
    setting: bool
  }

  record list-for-suite-response {
    check-runs: list<check-run>,
    total-count: s32
  }

  record list-for-ref-response {
    check-runs: list<check-run>,
    total-count: s32
  }

  record list-suites-for-ref-response {
    check-suites: list<check-suite>,
    total-count: s32
  }

  variant rerequest-run-error {
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// Create a check run
  record create-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Displays a button on GitHub that can be clicked to alert your app to do additional tasks. For example, a code linting app can display a button that automatically fixes detected errors. The button created in this object is displayed after the check run completes. When a user clicks the button, GitHub sends the [`check_run.requested_action` webhook](https://docs.github.com/webhooks/event-payloads/#check_run) to your app. Each action includes a `label`, `identifier` and `description`. A maximum of three actions are accepted. To learn more about check runs and requested actions, see "[Check runs and requested actions](https://docs.github.com/rest/reference/checks#check-runs-and-requested-actions)."
    actions: option<list<create-body-actions-item>>,
    /// The time the check completed. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    completed-at: option<string>,
    /// **Required if you provide `completed_at` or a `status` of `completed`**. The final conclusion of the check. 
    /// **Note:** Providing `conclusion` will automatically set the `status` parameter to `completed`. You cannot change a check run conclusion to `stale`, only GitHub can set this.
    conclusion: option<create-body-conclusion-enum>,
    /// The URL of the integrator's site that has the full details of the check. If the integrator does not provide this, then the homepage of the GitHub app is used.
    details-url: option<string>,
    /// A reference for the run on the integrator's system.
    external-id: option<string>,
    /// The SHA of the commit.
    head-sha: string,
    /// The name of the check. For example, "code-coverage".
    name: string,
    /// Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run.
    output: option<create-body-output>,
    /// The time that the check run began. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    started-at: option<string>,
    /// The current status.
    status: option<create-body-status-enum>
  }
  create: func(params: create-params) -> result<check-run, string>;

  /// Get a check run
  record get-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the check run.
    check-run-id: string
  }
  get: func(params: get-params) -> result<check-run, string>;

  /// Update a check run
  record update-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the check run.
    check-run-id: string,
    /// Possible further actions the integrator can perform, which a user may trigger. Each action includes a `label`, `identifier` and `description`. A maximum of three actions are accepted. See the [`actions` object](https://docs.github.com/rest/reference/checks#actions-object) description. To learn more about check runs and requested actions, see "[Check runs and requested actions](https://docs.github.com/rest/reference/checks#check-runs-and-requested-actions)."
    actions: option<list<update-body-actions-item>>,
    /// The time the check completed. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    completed-at: option<string>,
    /// **Required if you provide `completed_at` or a `status` of `completed`**. The final conclusion of the check. 
    /// **Note:** Providing `conclusion` will automatically set the `status` parameter to `completed`. You cannot change a check run conclusion to `stale`, only GitHub can set this.
    conclusion: option<create-body-conclusion-enum>,
    /// The URL of the integrator's site that has the full details of the check.
    details-url: option<string>,
    /// A reference for the run on the integrator's system.
    external-id: option<string>,
    /// The name of the check. For example, "code-coverage".
    name: option<string>,
    /// Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run.
    output: option<update-body-output>,
    /// This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    started-at: option<string>,
    /// The current status.
    status: option<create-body-status-enum>
  }
  update: func(params: update-params) -> result<check-run, string>;

  /// List check run annotations
  record list-annotations-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the check run.
    check-run-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-annotations: func(params: list-annotations-params) -> result<list<check-annotation>, string>;

  /// Rerequest a check run
  record rerequest-run-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the check run.
    check-run-id: string
  }
  rerequest-run: func(params: rerequest-run-params) -> result<empty-object, rerequest-run-error>;

  /// Create a check suite
  record create-suite-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The sha of the head commit.
    head-sha: string
  }
  create-suite: func(params: create-suite-params) -> result<check-suite, string>;

  /// Update repository preferences for check suites
  record set-suites-preferences-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Enables or disables automatic creation of CheckSuite events upon pushes to the repository. Enabled by default.
    auto-trigger-checks: option<list<set-suites-preferences-body-auto-trigger-checks-item>>
  }
  set-suites-preferences: func(params: set-suites-preferences-params) -> result<check-suite-preference, string>;

  /// Get a check suite
  record get-suite-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the check suite.
    check-suite-id: string
  }
  get-suite: func(params: get-suite-params) -> result<check-suite, string>;

  /// List check runs in a check suite
  record list-for-suite-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the check suite.
    check-suite-id: string,
    /// Returns check runs with the specified `name`.
    check-name: option<string>,
    /// Returns check runs with the specified `status`.
    status: option<create-body-status-enum>,
    /// Filters check runs by their `completed_at` timestamp. `latest` returns the most recent check runs.
    filter: option<list-for-suite-filter-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-suite: func(params: list-for-suite-params) -> result<list-for-suite-response, string>;

  /// Rerequest a check suite
  record rerequest-suite-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The unique identifier of the check suite.
    check-suite-id: string
  }
  rerequest-suite: func(params: rerequest-suite-params) -> result<empty-object, string>;

  /// List check runs for a Git reference
  record list-for-ref-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// ref parameter
    ref: string,
    /// Returns check runs with the specified `name`.
    check-name: option<string>,
    /// Returns check runs with the specified `status`.
    status: option<create-body-status-enum>,
    /// Filters check runs by their `completed_at` timestamp. `latest` returns the most recent check runs.
    filter: option<list-for-suite-filter-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    app-id: option<s32>
  }
  list-for-ref: func(params: list-for-ref-params) -> result<list-for-ref-response, string>;

  /// List check suites for a Git reference
  record list-suites-for-ref-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// ref parameter
    ref: string,
    /// Filters check suites by GitHub App `id`.
    app-id: option<s32>,
    /// Returns check runs with the specified `name`.
    check-name: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-suites-for-ref: func(params: list-suites-for-ref-params) -> result<list-suites-for-ref-response, string>;

}

interface dependency-graph {
  enum diff-item-change-type-enum {
    added,
    removed,
  }

  enum diff-item-scope-enum {
    unknown,
    runtime,
    development,
  }

  enum dependency-relationship-enum {
    direct,
    indirect,
  }

  enum dependency-scope-enum {
    runtime,
    development,
  }

  record diff-item {
    change-type: diff-item-change-type-enum,
    ecosystem: string,
    license: string,
    manifest: string,
    name: string,
    package-url: string,
    /// Where the dependency is utilized. `development` means that the dependency is only utilized in the development environment. `runtime` means that the dependency is utilized at runtime and in the development environment.
    scope: diff-item-scope-enum,
    source-repository-url: string,
    version: string,
    vulnerabilities: list<diff-item-vulnerabilities-item>
  }

  record diff-item-vulnerabilities-item {
    advisory-ghsa-id: string,
    advisory-summary: string,
    advisory-url: string,
    severity: string
  }

  /// A description of the detector used.
  record snapshot-detector {
    /// The name of the detector used.
    name: string,
    /// The url of the detector used.
    url: string,
    /// The version of the detector used.
    version: string
  }

  record snapshot-job {
    /// Correlator provides a key that is used to group snapshots submitted over time. Only the "latest" submitted snapshot for a given combination of `job.correlator` and `detector.name` will be considered when calculating a repository's current dependencies. Correlator should be as unique as it takes to distinguish all detection runs for a given "wave" of CI workflow you run. If you're using GitHub Actions, a good default value for this could be the environment variables GITHUB_WORKFLOW and GITHUB_JOB concatenated together. If you're using a build matrix, then you'll also need to add additional key(s) to distinguish between each submission inside a matrix variation.
    correlator: string,
    /// The url for the job.
    html-url: option<string>,
    /// The external ID of the job.
    id: string
  }

  record manifest {
    file: option<manifest-file>,
    metadata: option<list<metadata-entry>>,
    /// The name of the manifest.
    name: string,
    /// A collection of resolved package dependencies.
    resolved: option<list<manifest-resolved-entry>>
  }

  record manifest-file {
    /// The path of the manifest file relative to the root of the Git repository.
    source-location: option<string>
  }

  /// one entry of a string-keyed map (free-form object)
  record metadata-entry {
    key: string,
    value: string
  }

  record dependency {
    /// Array of package-url (PURLs) of direct child dependencies.
    dependencies: option<list<string>>,
    metadata: option<list<metadata-entry-v2>>,
    /// Package-url (PURL) of dependency. See https://github.com/package-url/purl-spec for more details.
    package-url: option<string>,
    /// A notation of whether a dependency is requested directly by this manifest or is a dependency of another dependency.
    relationship: option<dependency-relationship-enum>,
    /// A notation of whether the dependency is required for the primary build artifact (runtime) or is only used for development. Future versions of this specification may allow for more granular scopes.
    scope: option<dependency-scope-enum>
  }

  /// one entry of a string-keyed map (free-form object)
  record metadata-entry-v2 {
    key: string,
    value: string
  }

  /// one entry of a string-keyed map (free-form object)
  record manifest-resolved-entry {
    key: string,
    value: dependency
  }

  /// one entry of a string-keyed map (free-form object)
  record snapshot-manifests-entry {
    key: string,
    value: manifest
  }

  /// one entry of a string-keyed map (free-form object)
  record metadata-entry-v3 {
    key: string,
    value: string
  }

  record create-repository-snapshot-response {
    /// The time at which the snapshot was created.
    created-at: string,
    /// ID of the created snapshot.
    id: s32,
    /// A message providing further details about the result, such as why the dependencies were not updated.
    message: string,
    /// Either "SUCCESS", "ACCEPTED", or "INVALID". "SUCCESS" indicates that the snapshot was successfully created and the repository's dependencies were updated. "ACCEPTED" indicates that the snapshot was successfully created, but the repository's dependencies were not updated. "INVALID" indicates that the snapshot was malformed.
    result-op: string
  }

  variant diff-range-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get a diff of the dependencies between commits
  record diff-range-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The base and head Git revisions to compare. The Git revisions will be resolved to commit SHAs. Named revisions will be resolved to their corresponding HEAD commits, and an appropriate merge base will be determined. This parameter expects the format `{base}...{head}`.
    basehead: string,
    /// The full path, relative to the repository root, of the dependency manifest file.
    name: option<string>
  }
  diff-range: func(params: diff-range-params) -> result<list<diff-item>, diff-range-error>;

  /// Create a snapshot of dependencies for a repository
  record create-repository-snapshot-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// A description of the detector used.
    detector: snapshot-detector,
    job: snapshot-job,
    /// A collection of package manifests, which are a collection of related dependencies declared in a file or representing a logical group of dependencies.
    manifests: option<list<snapshot-manifests-entry>>,
    metadata: option<list<metadata-entry-v3>>,
    /// The repository branch that triggered this snapshot.
    ref: string,
    /// The time at which the snapshot was scanned.
    scanned: string,
    /// The commit SHA associated with this dependency snapshot. Maximum length: 40 characters.
    sha: string,
    /// The version of the repository snapshot submission.
    version: s32
  }
  create-repository-snapshot: func(params: create-repository-snapshot-params) -> result<create-repository-snapshot-response, string>;

}

interface git {
  enum create-tag-body-type-op-enum {
    commit,
    tree,
    blob,
  }

  enum create-tree-body-tree-item-mode-enum {
    v100644,
    v100755,
    v040000,
    v160000,
    v120000,
  }

  enum create-tree-body-tree-item-type-op-enum {
    blob,
    tree,
    commit,
  }

  /// Short Blob
  record short-blob {
    sha: string,
    url: string
  }

  /// Blob
  record blob {
    content: string,
    encoding: string,
    highlighted-content: option<string>,
    node-id: string,
    sha: string,
    size: s32,
    url: string
  }

  /// Information about the author of the commit. By default, the `author` will be the authenticated user and the current date. See the `author` and `committer` object below for details.
  record create-commit-body-author {
    /// Indicates when this commit was authored (or committed). This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    date: option<string>,
    /// The email of the author (or committer) of the commit
    email: string,
    /// The name of the author (or committer) of the commit
    name: string
  }

  /// Information about the person who is making the commit. By default, `committer` will use the information set in `author`. See the `author` and `committer` object below for details.
  record create-commit-body-committer {
    /// Indicates when this commit was authored (or committed). This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    date: option<string>,
    /// The email of the author (or committer) of the commit
    email: option<string>,
    /// The name of the author (or committer) of the commit
    name: option<string>
  }

  /// Low-level Git commit operations within a repository
  record commit {
    /// Identifying information for the git-user
    author: commit-author,
    /// Identifying information for the git-user
    committer: commit-committer,
    html-url: string,
    /// Message describing the purpose of the commit
    message: string,
    node-id: string,
    parents: list<commit-parents-item>,
    /// SHA for the commit
    sha: string,
    tree: commit-tree,
    url: string,
    verification: commit-verification
  }

  /// Identifying information for the git-user
  record commit-author {
    /// Timestamp of the commit
    date: string,
    /// Git email address of the user
    email: string,
    /// Name of the git user
    name: string
  }

  /// Identifying information for the git-user
  record commit-committer {
    /// Timestamp of the commit
    date: string,
    /// Git email address of the user
    email: string,
    /// Name of the git user
    name: string
  }

  record commit-parents-item {
    html-url: string,
    /// SHA for the commit
    sha: string,
    url: string
  }

  record commit-tree {
    /// SHA for the commit
    sha: string,
    url: string
  }

  record commit-verification {
    payload: string,
    reason: string,
    signature: string,
    verified: bool
  }

  /// Git references within a repository
  record ref {
    node-id: string,
    object: ref-object,
    ref: string,
    url: string
  }

  record ref-object {
    /// SHA for the reference
    sha: string,
    type-op: string,
    url: string
  }

  /// An object with information about the individual creating the tag.
  record create-tag-body-tagger {
    /// When this object was tagged. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    date: option<string>,
    /// The email of the author of the tag
    email: string,
    /// The name of the author of the tag
    name: string
  }

  /// Metadata for a Git tag
  record tag {
    /// Message describing the purpose of the tag
    message: string,
    node-id: string,
    object: tag-object,
    sha: string,
    /// Name of the tag
    tag: string,
    tagger: tag-tagger,
    /// URL for the tag
    url: string,
    verification: option<verification>
  }

  record tag-object {
    sha: string,
    type-op: string,
    url: string
  }

  record tag-tagger {
    date: string,
    email: string,
    name: string
  }

  record verification {
    payload: string,
    reason: string,
    signature: string,
    verified: bool
  }

  record create-tree-body-tree-item {
    /// The content you want this file to have. GitHub will write this blob out and use that SHA for this entry. Use either this, or `tree.sha`.  
    ///   
    content: option<string>,
    /// The file mode; one of `100644` for file (blob), `100755` for executable (blob), `040000` for subdirectory (tree), `160000` for submodule (commit), or `120000` for a blob that specifies the path of a symlink.
    mode: option<create-tree-body-tree-item-mode-enum>,
    /// The file referenced in the tree.
    path: option<string>,
    /// The SHA1 checksum ID of the object in the tree. Also called `tree.sha`. If the value is `null` then the file will be deleted.  
    ///   
    sha: option<string>,
    /// Either `blob`, `tree`, or `commit`.
    type-op: option<create-tree-body-tree-item-type-op-enum>
  }

  /// The hierarchy between files in a Git repository.
  record tree {
    sha: string,
    /// Objects specifying a tree structure
    tree: list<tree-tree-item>,
    truncated: bool,
    url: string
  }

  record tree-tree-item {
    mode: option<string>,
    path: option<string>,
    sha: option<string>,
    size: option<s32>,
    type-op: option<string>,
    url: option<string>
  }

  variant create-blob-error {
    forbidden(string),
    not-found(string),
    conflict(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-blob-error {
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant create-commit-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-commit-error {
    not-found(string),
    other(string)
  }

  variant get-ref-error {
    not-found(string),
    other(string)
  }

  variant create-ref-error {
    unprocessable-entity(string),
    other(string)
  }

  variant update-ref-error {
    unprocessable-entity(string),
    other(string)
  }

  variant delete-ref-error {
    unprocessable-entity(string),
    other(string)
  }

  variant create-tag-error {
    unprocessable-entity(string),
    other(string)
  }

  variant get-tag-error {
    not-found(string),
    other(string)
  }

  variant create-tree-error {
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-tree-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  /// Create a blob
  record create-blob-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The new blob's content.
    content: string,
    /// The encoding used for `content`. Currently, `"utf-8"` and `"base64"` are supported.
    encoding: option<string>
  }
  create-blob: func(params: create-blob-params) -> result<short-blob, create-blob-error>;

  /// Get a blob
  record get-blob-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    file-sha: string
  }
  get-blob: func(params: get-blob-params) -> result<blob, get-blob-error>;

  /// Create a commit
  record create-commit-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Information about the author of the commit. By default, the `author` will be the authenticated user and the current date. See the `author` and `committer` object below for details.
    author: option<create-commit-body-author>,
    /// Information about the person who is making the commit. By default, `committer` will use the information set in `author`. See the `author` and `committer` object below for details.
    committer: option<create-commit-body-committer>,
    /// The commit message
    message: string,
    /// The SHAs of the commits that were the parents of this commit. If omitted or empty, the commit will be written as a root commit. For a single parent, an array of one SHA should be provided; for a merge commit, an array of more than one should be provided.
    parents: option<list<string>>,
    /// The [PGP signature](https://en.wikipedia.org/wiki/Pretty_Good_Privacy) of the commit. GitHub adds the signature to the `gpgsig` header of the created commit. For a commit signature to be verifiable by Git or GitHub, it must be an ASCII-armored detached PGP signature over the string commit as it would be written to the object database. To pass a `signature` parameter, you need to first manually create a valid PGP signature, which can be complicated. You may find it easier to [use the command line](https://git-scm.com/book/id/v2/Git-Tools-Signing-Your-Work) to create signed commits.
    signature: option<string>,
    /// The SHA of the tree object this commit points to
    tree: string
  }
  create-commit: func(params: create-commit-params) -> result<commit, create-commit-error>;

  /// Get a commit
  record get-commit-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The SHA of the commit.
    commit-sha: string
  }
  get-commit: func(params: get-commit-params) -> result<commit, get-commit-error>;

  /// List matching references
  record list-matching-refs-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// ref parameter
    ref: string
  }
  list-matching-refs: func(params: list-matching-refs-params) -> result<list<ref>, string>;

  /// Get a reference
  record get-ref-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// ref parameter
    ref: string
  }
  get-ref: func(params: get-ref-params) -> result<ref, get-ref-error>;

  /// Create a reference
  record create-ref-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    key: option<string>,
    /// The name of the fully qualified reference (ie: `refs/heads/master`). If it doesn't start with 'refs' and have at least two slashes, it will be rejected.
    ref: string,
    /// The SHA1 value for this reference.
    sha: string
  }
  create-ref: func(params: create-ref-params) -> result<ref, create-ref-error>;

  /// Update a reference
  record update-ref-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the fully qualified reference to update. For example, `refs/heads/master`. If the value doesn't start with `refs` and have at least two slashes, it will be rejected.
    ref: string,
    /// Indicates whether to force the update or to make sure the update is a fast-forward update. Leaving this out or setting it to `false` will make sure you're not overwriting work.
    force: option<bool>,
    /// The SHA1 value to set this reference to
    sha: string
  }
  update-ref: func(params: update-ref-params) -> result<ref, update-ref-error>;

  /// Delete a reference
  record delete-ref-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// ref parameter
    ref: string
  }
  delete-ref: func(params: delete-ref-params) -> result<string, delete-ref-error>;

  /// Create a tag object
  record create-tag-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The tag message.
    message: string,
    /// The SHA of the git object this is tagging.
    object: string,
    /// The tag's name. This is typically a version (e.g., "v0.0.1").
    tag: string,
    /// An object with information about the individual creating the tag.
    tagger: option<create-tag-body-tagger>,
    /// The type of the object we're tagging. Normally this is a `commit` but it can also be a `tree` or a `blob`.
    type-op: create-tag-body-type-op-enum
  }
  create-tag: func(params: create-tag-params) -> result<tag, create-tag-error>;

  /// Get a tag
  record get-tag-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    tag-sha: string
  }
  get-tag: func(params: get-tag-params) -> result<tag, get-tag-error>;

  /// Create a tree
  record create-tree-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The SHA1 of an existing Git tree object which will be used as the base for the new tree. If provided, a new Git tree object will be created from entries in the Git tree object pointed to by `base_tree` and entries defined in the `tree` parameter. Entries defined in the `tree` parameter will overwrite items from `base_tree` with the same `path`. If you're creating new changes on a branch, then normally you'd set `base_tree` to the SHA1 of the Git tree object of the current latest commit on the branch you're working on.
    /// If not provided, GitHub will create a new Git tree object from only the entries defined in the `tree` parameter. If you create a new commit pointing to such a tree, then all files which were a part of the parent commit's tree and were not defined in the `tree` parameter will be listed as deleted by the new commit.
    base-tree: option<string>,
    /// Objects (of `path`, `mode`, `type`, and `sha`) specifying a tree structure.
    tree: list<create-tree-body-tree-item>
  }
  create-tree: func(params: create-tree-params) -> result<tree, create-tree-error>;

  /// Get a tree
  record get-tree-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    tree-sha: string,
    /// Setting this parameter to any value returns the objects or subtrees referenced by the tree specified in `:tree_sha`. For example, setting `recursive` to any of the following will enable returning objects or subtrees: `0`, `1`, `"true"`, and `"false"`. Omit this parameter to prevent recursively returning objects or subtrees.
    recursive: option<string>
  }
  get-tree: func(params: get-tree-params) -> result<tree, get-tree-error>;

}

interface pulls {
  enum list-op-state-enum {
    open,
    closed,
    all,
  }

  enum list-op-sort-enum {
    created,
    updated,
    popularity,
    long-running,
  }

  enum list-op-direction-enum {
    asc,
    desc,
  }

  enum author-association {
    collaborator,
    contributor,
    first-timer,
    first-time-contributor,
    mannequin,
    member,
    none,
    owner,
  }

  enum auto-merge-merge-method-enum {
    merge,
    squash,
    rebase,
  }

  enum repository-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum repository-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum repository-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum repository-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  enum nullable-milestone-state-enum {
    open,
    closed,
  }

  enum list-review-comments-for-repo-sort-enum {
    created,
    updated,
    created-at,
  }

  enum pull-request-review-comment-side-enum {
    left,
    right,
  }

  enum list-review-comments-sort-enum {
    created,
    updated,
  }

  enum create-review-comment-body-start-side-enum {
    left,
    right,
    side,
  }

  enum diff-entry-status-enum {
    added,
    removed,
    modified,
    renamed,
    copied,
    changed,
    unchanged,
  }

  enum create-review-body-event-enum {
    approve,
    request-changes,
    comment,
  }

  enum dismiss-review-body-event-enum {
    dismiss,
  }

  /// Pull Request Simple
  record pull-request-simple {
    links: pull-request-simple-links,
    active-lock-reason: option<string>,
    assignee: nullable-simple-user,
    assignees: option<list<simple-user>>,
    author-association: author-association,
    auto-merge: auto-merge,
    base: pull-request-simple-base,
    body: string,
    closed-at: string,
    comments-url: string,
    commits-url: string,
    created-at: string,
    diff-url: string,
    /// Indicates whether or not the pull request is a draft.
    draft: option<bool>,
    head: pull-request-simple-head,
    html-url: string,
    id: s32,
    issue-url: string,
    labels: list<pull-request-simple-labels-item>,
    locked: bool,
    merge-commit-sha: string,
    merged-at: string,
    milestone: nullable-milestone,
    node-id: string,
    number: s32,
    patch-url: string,
    requested-reviewers: option<list<simple-user>>,
    requested-teams: option<list<team>>,
    review-comment-url: string,
    review-comments-url: string,
    state: string,
    statuses-url: string,
    title: string,
    updated-at: string,
    url: string,
    user: nullable-simple-user
  }

  record pull-request-simple-links {
    comments: link,
    commits: link,
    html: link,
    issue: link,
    review-comment: link,
    review-comments: link,
    self: link,
    statuses: link
  }

  /// Hypermedia Link
  record link {
    href: string
  }

  /// A GitHub user.
  record nullable-simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// The status of auto merging a pull request.
  record auto-merge {
    /// Commit message for the merge commit.
    commit-message: string,
    /// Title for the merge commit message.
    commit-title: string,
    enabled-by: simple-user,
    /// The merge method to use.
    merge-method: auto-merge-merge-method-enum
  }

  record pull-request-simple-base {
    label: string,
    ref: string,
    repo: repository,
    sha: string,
    user: nullable-simple-user
  }

  /// A repository on GitHub.
  record repository {
    /// Whether to allow Auto-merge to be used on pull requests.
    allow-auto-merge: option<bool>,
    /// Whether to allow forking this repo
    allow-forking: option<bool>,
    /// Whether to allow merge commits for pull requests.
    allow-merge-commit: option<bool>,
    /// Whether to allow rebase merges for pull requests.
    allow-rebase-merge: option<bool>,
    /// Whether to allow squash merges for pull requests.
    allow-squash-merge: option<bool>,
    /// Whether or not a pull request head branch that is behind its base branch can always be updated even if it is not required to be up to date before merging.
    allow-update-branch: option<bool>,
    /// Whether anonymous git access is enabled for this repository
    anonymous-access-enabled: option<bool>,
    archive-url: string,
    /// Whether the repository is archived.
    archived: bool,
    assignees-url: string,
    blobs-url: string,
    branches-url: string,
    clone-url: string,
    collaborators-url: string,
    comments-url: string,
    commits-url: string,
    compare-url: string,
    contents-url: string,
    contributors-url: string,
    created-at: string,
    /// The default branch of the repository.
    default-branch: string,
    /// Whether to delete head branches when pull requests are merged
    delete-branch-on-merge: option<bool>,
    deployments-url: string,
    description: string,
    /// Returns whether or not this repository disabled.
    disabled: bool,
    downloads-url: string,
    events-url: string,
    fork: bool,
    forks: s32,
    forks-count: s32,
    forks-url: string,
    full-name: string,
    git-commits-url: string,
    git-refs-url: string,
    git-tags-url: string,
    git-url: string,
    /// Whether discussions are enabled.
    has-discussions: option<bool>,
    /// Whether downloads are enabled.
    has-downloads: bool,
    /// Whether issues are enabled.
    has-issues: bool,
    has-pages: bool,
    /// Whether projects are enabled.
    has-projects: bool,
    /// Whether the wiki is enabled.
    has-wiki: bool,
    homepage: string,
    hooks-url: string,
    html-url: string,
    /// Unique identifier of the repository
    id: s32,
    /// Whether this repository acts as a template that can be used to generate new repositories.
    is-template: option<bool>,
    issue-comment-url: string,
    issue-events-url: string,
    issues-url: string,
    keys-url: string,
    labels-url: string,
    language: string,
    languages-url: string,
    license: nullable-license-simple,
    master-branch: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repository-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repository-merge-commit-title-enum>,
    merges-url: string,
    milestones-url: string,
    mirror-url: string,
    /// The name of the repository.
    name: string,
    network-count: option<s32>,
    node-id: string,
    notifications-url: string,
    open-issues: s32,
    open-issues-count: s32,
    organization: option<nullable-simple-user>,
    owner: simple-user,
    permissions: option<repository-permissions>,
    /// Whether the repository is private or public.
    private: bool,
    pulls-url: string,
    pushed-at: string,
    releases-url: string,
    /// The size of the repository. Size is calculated hourly. When a repository is initially created, the size is 0.
    size: s32,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repository-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repository-squash-merge-commit-title-enum>,
    ssh-url: string,
    stargazers-count: s32,
    stargazers-url: string,
    starred-at: option<string>,
    statuses-url: string,
    subscribers-count: option<s32>,
    subscribers-url: string,
    subscription-url: string,
    svn-url: string,
    tags-url: string,
    teams-url: string,
    temp-clone-token: option<string>,
    template-repository: option<repository-template-repository>,
    topics: option<list<string>>,
    trees-url: string,
    updated-at: string,
    url: string,
    /// Whether a squash merge commit can use the pull request title as default. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The repository visibility: public, private, or internal.
    visibility: option<string>,
    watchers: s32,
    watchers-count: s32,
    /// Whether to require contributors to sign off on web-based commits
    web-commit-signoff-required: option<bool>
  }

  /// License Simple
  record nullable-license-simple {
