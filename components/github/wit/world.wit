  }

  variant code-error {
    not-modified(string),
    forbidden(string),
    unprocessable-entity(string),
    service-unavailable(string),
    other(string)
  }

  variant commits-error {
    not-modified(string),
    other(string)
  }

  variant issues-and-pull-requests-error {
    not-modified(string),
    forbidden(string),
    unprocessable-entity(string),
    service-unavailable(string),
    other(string)
  }

  variant labels-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant repos-error {
    not-modified(string),
    unprocessable-entity(string),
    service-unavailable(string),
    other(string)
  }

  variant topics-error {
    not-modified(string),
    other(string)
  }

  variant users-error {
    not-modified(string),
    unprocessable-entity(string),
    service-unavailable(string),
    other(string)
  }

  /// Search code
  record code-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching code](https://docs.github.com/search-github/searching-on-github/searching-code)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query. Can only be `indexed`, which indicates how recently a file has been indexed by the GitHub search infrastructure. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<code-sort-enum>,
    /// Determines whether the first search result returned is the highest number of matches (`desc`) or lowest number of matches (`asc`). This parameter is ignored unless you provide `sort`.
    order: option<code-order-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  code: func(params: code-params) -> result<code-response, code-error>;

  /// Search commits
  record commits-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching commits](https://docs.github.com/search-github/searching-on-github/searching-commits)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query by `author-date` or `committer-date`. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<commits-sort-enum>,
    /// Determines whether the first search result returned is the highest number of matches (`desc`) or lowest number of matches (`asc`). This parameter is ignored unless you provide `sort`.
    order: option<code-order-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  commits: func(params: commits-params) -> result<commits-response, commits-error>;

  /// Search issues and pull requests
  record issues-and-pull-requests-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching issues and pull requests](https://docs.github.com/search-github/searching-on-github/searching-issues-and-pull-requests)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query by the number of `comments`, `reactions`, `reactions-+1`, `reactions--1`, `reactions-smile`, `reactions-thinking_face`, `reactions-heart`, `reactions-tada`, or `interactions`. You can also sort results by how recently the items were `created` or `updated`, Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<issues-and-pull-requests-sort-enum>,
    /// Determines whether the first search result returned is the highest number of matches (`desc`) or lowest number of matches (`asc`). This parameter is ignored unless you provide `sort`.
    order: option<code-order-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  issues-and-pull-requests: func(params: issues-and-pull-requests-params) -> result<issues-and-pull-requests-response, issues-and-pull-requests-error>;

  /// Search labels
  record labels-params {
    /// The id of the repository.
    repository-id: s32,
    /// The search keywords. This endpoint does not accept qualifiers in the query. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query).
    q: string,
    /// Sorts the results of your query by when the label was `created` or `updated`. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<labels-sort-enum>,
    /// Determines whether the first search result returned is the highest number of matches (`desc`) or lowest number of matches (`asc`). This parameter is ignored unless you provide `sort`.
    order: option<code-order-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  labels: func(params: labels-params) -> result<labels-response, labels-error>;

  /// Search repositories
  record repos-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching for repositories](https://docs.github.com/articles/searching-for-repositories/)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query by number of `stars`, `forks`, or `help-wanted-issues` or how recently the items were `updated`. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<repos-sort-enum>,
    /// Determines whether the first search result returned is the highest number of matches (`desc`) or lowest number of matches (`asc`). This parameter is ignored unless you provide `sort`.
    order: option<code-order-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  repos: func(params: repos-params) -> result<repos-response, repos-error>;

  /// Search topics
  record topics-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query).
    q: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  topics: func(params: topics-params) -> result<topics-response, topics-error>;

  /// Search users
  record users-params {
    /// The query contains one or more search keywords and qualifiers. Qualifiers allow you to limit your search to specific areas of GitHub. The REST API supports the same qualifiers as the web interface for GitHub. To learn more about the format of the query, see [Constructing a search query](https://docs.github.com/rest/reference/search#constructing-a-search-query). See "[Searching users](https://docs.github.com/search-github/searching-on-github/searching-users)" for a detailed list of qualifiers.
    q: string,
    /// Sorts the results of your query by number of `followers` or `repositories`, or when the person `joined` GitHub. Default: [best match](https://docs.github.com/rest/reference/search#ranking-search-results)
    sort: option<users-sort-enum>,
    /// Determines whether the first search result returned is the highest number of matches (`desc`) or lowest number of matches (`asc`). This parameter is ignored unless you provide `sort`.
    order: option<code-order-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  users: func(params: users-params) -> result<users-response, users-error>;

}

interface users {
  enum set-primary-email-visibility-for-authenticated-user-body-visibility-enum {
    public,
    private,
  }

  enum get-context-for-user-subject-type-enum {
    organization,
    repository,
    issue,
    pull-request,
  }

  /// Private User
  record private-user {
    avatar-url: string,
    bio: string,
    blog: string,
    business-plus: option<bool>,
    collaborators: s32,
    company: string,
    created-at: string,
    disk-usage: s32,
    email: string,
    events-url: string,
    followers: s32,
    followers-url: string,
    following: s32,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    hireable: bool,
    html-url: string,
    id: s32,
    ldap-dn: option<string>,
    location: string,
    login: string,
    name: string,
    node-id: string,
    organizations-url: string,
    owned-private-repos: s32,
    plan: option<private-user-plan>,
    private-gists: s32,
    public-gists: s32,
    public-repos: s32,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-url: string,
    subscriptions-url: string,
    suspended-at: option<string>,
    total-private-repos: s32,
    twitter-username: option<string>,
    two-factor-authentication: bool,
    type-op: string,
    updated-at: string,
    url: string
  }

  record private-user-plan {
    collaborators: s32,
    name: string,
    private-repos: s32,
    space: s32
  }

  /// A GitHub user.
  record simple-user {
    avatar-url: string,
    email: option<string>,
    events-url: string,
    followers-url: string,
    following-url: string,
    gists-url: string,
    gravatar-id: string,
    html-url: string,
    id: s32,
    login: string,
    name: option<string>,
    node-id: string,
    organizations-url: string,
    received-events-url: string,
    repos-url: string,
    site-admin: bool,
    starred-at: option<string>,
    starred-url: string,
    subscriptions-url: string,
    type-op: string,
    url: string
  }

  /// Email
  record email {
    email: string,
    primary: bool,
    verified: bool,
    visibility: string
  }

  /// A unique encryption key
  record gpg-key {
    can-certify: bool,
    can-encrypt-comms: bool,
    can-encrypt-storage: bool,
    can-sign: bool,
    created-at: string,
    emails: list<gpg-key-emails-item>,
    expires-at: string,
    id: s32,
    key-id: string,
    name: option<string>,
    primary-key-id: s32,
    public-key: string,
    raw-key: string,
    revoked: bool,
    subkeys: list<gpg-key-subkeys-item>
  }

  record gpg-key-emails-item {
    email: option<string>,
    verified: option<bool>
  }

  record gpg-key-subkeys-item {
    can-certify: option<bool>,
    can-encrypt-comms: option<bool>,
    can-encrypt-storage: option<bool>,
    can-sign: option<bool>,
    created-at: option<string>,
    emails: option<list<string>>,
    expires-at: option<string>,
    id: option<s32>,
    key-id: option<string>,
    primary-key-id: option<s32>,
    public-key: option<string>,
    raw-key: option<string>,
    revoked: option<bool>,
    subkeys: option<list<string>>
  }

  /// Key
  record key {
    created-at: string,
    id: s32,
    key: string,
    read-only: bool,
    title: string,
    url: string,
    verified: bool
  }

  /// A public SSH key used to sign Git commits
  record ssh-signing-key {
    created-at: string,
    id: s32,
    key: string,
    title: string
  }

  /// Hovercard
  record hovercard {
    contexts: list<hovercard-contexts-item>
  }

  record hovercard-contexts-item {
    message: string,
    octicon: string
  }

  /// Key Simple
  record key-simple {
    id: s32,
    key: string
  }

  variant get-authenticated-error {
    not-modified(string),
