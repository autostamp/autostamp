interface reactions {
  enum list-for-team-discussion-comment-in-org-content-enum {
    v1,
    v1-v2,
    laugh,
    confused,
    heart,
    hooray,
    rocket,
    eyes,
  }

  enum list-for-release-content-enum {
    v1,
    laugh,
    heart,
    hooray,
    rocket,
    eyes,
  }

