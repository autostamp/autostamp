    ssh-signing-key-id: string
  }
  get-ssh-signing-key-for-authenticated-user: func(params: get-ssh-signing-key-for-authenticated-user-params) -> result<string, string>;

  /// Delete an SSH signing key for the authenticated user
  record delete-ssh-signing-key-for-authenticated-user-params {
    /// The unique identifier of the SSH signing key.
    ssh-signing-key-id: string
  }
  delete-ssh-signing-key-for-authenticated-user: func(params: delete-ssh-signing-key-for-authenticated-user-params) -> result<string, string>;

  /// List users
  record list-op-params {
    /// A user ID. Only return users with an ID greater than this ID.
    since: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  list-op: func(params: list-op-params) -> result<string, string>;

  /// Get a user
  record get-by-username-params {
    /// The handle for the GitHub user account.
    username: string
