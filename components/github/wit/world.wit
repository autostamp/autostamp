    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-repo-public-key: func(params: get-repo-public-key-params) -> result<string, string>;

  /// Get a repository secret
  record get-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string
  }
  get-repo-secret: func(params: get-repo-secret-params) -> result<string, string>;

  /// Create or update a repository secret
  record create-or-update-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string,
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get a repository public key](https://docs.github.com/rest/reference/codespaces#get-a-repository-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>
  }
  create-or-update-repo-secret: func(params: create-or-update-repo-secret-params) -> result<string, string>;

  /// Delete a repository secret
  record delete-repo-secret-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The name of the secret.
    secret-name: string
  }
  delete-repo-secret: func(params: delete-repo-secret-params) -> result<string, string>;

  /// Create a codespace from a pull request
  record create-with-pr-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number that identifies the pull request.
    pull-number: string,
    /// IP for location auto-detection when proxying a request
    client-ip: option<string>,
    /// Path to devcontainer.json config to use for this codespace
    devcontainer-path: option<string>,
    /// Display name for this codespace
    display-name: option<string>,
    /// Time in minutes before codespace stops from inactivity
    idle-timeout-minutes: option<s32>,
    /// Location for this codespace. Assigned by IP if not provided
    location: option<string>,
    /// Machine type to use for this codespace
    machine: option<string>,
    /// Whether to authorize requested permissions from devcontainer.json
    multi-repo-permissions-opt-out: option<bool>,
    /// Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).
    retention-period-minutes: option<s32>,
    /// Working directory for this codespace
    working-directory: option<string>
  }
  create-with-pr-for-authenticated-user: func(params: create-with-pr-for-authenticated-user-params) -> result<string, string>;

  /// List codespaces for the authenticated user
  record list-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// ID of the Repository to filter on
    repository-id: option<s32>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<string, string>;

  /// Create a codespace for the authenticated user
  record create-for-authenticated-user-params {
    body: string
  }
  create-for-authenticated-user: func(params: create-for-authenticated-user-params) -> result<string, string>;

  /// List secrets for the authenticated user
  record list-secrets-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-secrets-for-authenticated-user: func(params: list-secrets-for-authenticated-user-params) -> result<string, string>;

  /// Get public key for the authenticated user
  get-public-key-for-authenticated-user: func() -> result<string, string>;

  /// Get a secret for the authenticated user
  record get-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string
  }
  get-secret-for-authenticated-user: func(params: get-secret-for-authenticated-user-params) -> result<string, string>;

  /// Create or update a secret for the authenticated user
  record create-or-update-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string,
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get the public key for the authenticated user](https://docs.github.com/rest/reference/codespaces#get-the-public-key-for-the-authenticated-user) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: string,
    /// An array of repository ids that can access the user secret. You can manage the list of selected repositories using the [List selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-a-user-secret), [Set selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#set-selected-repositories-for-a-user-secret), and [Remove a selected repository from a user secret](https://docs.github.com/rest/reference/codespaces#remove-a-selected-repository-from-a-user-secret) endpoints.
    selected-repository-ids: option<list<string>>
  }
  create-or-update-secret-for-authenticated-user: func(params: create-or-update-secret-for-authenticated-user-params) -> result<string, string>;

  /// Delete a secret for the authenticated user
  record delete-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string
  }
  delete-secret-for-authenticated-user: func(params: delete-secret-for-authenticated-user-params) -> result<string, string>;

  /// List selected repositories for a user secret
  record list-repositories-for-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string
  }
  list-repositories-for-secret-for-authenticated-user: func(params: list-repositories-for-secret-for-authenticated-user-params) -> result<string, string>;

  /// Set selected repositories for a user secret
  record set-repositories-for-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string,
    /// An array of repository ids for which a codespace can access the secret. You can manage the list of selected repositories using the [List selected repositories for a user secret](https://docs.github.com/rest/reference/codespaces#list-selected-repositories-for-a-user-secret), [Add a selected repository to a user secret](https://docs.github.com/rest/reference/codespaces#add-a-selected-repository-to-a-user-secret), and [Remove a selected repository from a user secret](https://docs.github.com/rest/reference/codespaces#remove-a-selected-repository-from-a-user-secret) endpoints.
    selected-repository-ids: list<s32>
  }
  set-repositories-for-secret-for-authenticated-user: func(params: set-repositories-for-secret-for-authenticated-user-params) -> result<string, string>;

  /// Add a selected repository to a user secret
  record add-repository-for-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  add-repository-for-secret-for-authenticated-user: func(params: add-repository-for-secret-for-authenticated-user-params) -> result<string, string>;

  /// Remove a selected repository from a user secret
  record remove-repository-for-secret-for-authenticated-user-params {
    /// The name of the secret.
    secret-name: string,
    repository-id: string
  }
  remove-repository-for-secret-for-authenticated-user: func(params: remove-repository-for-secret-for-authenticated-user-params) -> result<string, string>;

  /// Get a codespace for the authenticated user
  record get-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  get-for-authenticated-user: func(params: get-for-authenticated-user-params) -> result<string, string>;

  /// Update a codespace for the authenticated user
  record update-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string,
    /// Display name for this codespace
    display-name: option<string>,
    /// A valid machine to transition this codespace to.
    machine: option<string>,
    /// Recently opened folders inside the codespace. It is currently used by the clients to determine the folder path to load the codespace in.
    recent-folders: option<list<string>>
  }
  update-for-authenticated-user: func(params: update-for-authenticated-user-params) -> result<string, string>;

  /// Delete a codespace for the authenticated user
  record delete-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  delete-for-authenticated-user: func(params: delete-for-authenticated-user-params) -> result<string, string>;

  /// Export a codespace for the authenticated user
  record export-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  export-for-authenticated-user: func(params: export-for-authenticated-user-params) -> result<string, string>;

  /// Get details about a codespace export
  record get-export-details-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string,
    /// The ID of the export operation, or `latest`. Currently only `latest` is currently supported.
    export-id: string
  }
  get-export-details-for-authenticated-user: func(params: get-export-details-for-authenticated-user-params) -> result<string, string>;

  /// List machine types for a codespace
  record codespace-machines-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  codespace-machines-for-authenticated-user: func(params: codespace-machines-for-authenticated-user-params) -> result<string, string>;

  /// Create a repository from an unpublished codespace
  record publish-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string,
    /// A name for the new repository.
    name: option<string>,
    /// Whether the new repository should be private.
    private: option<bool>
  }
  publish-for-authenticated-user: func(params: publish-for-authenticated-user-params) -> result<string, string>;

  /// Start a codespace for the authenticated user
  record start-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  start-for-authenticated-user: func(params: start-for-authenticated-user-params) -> result<string, string>;

  /// Stop a codespace for the authenticated user
  record stop-for-authenticated-user-params {
    /// The name of the codespace.
    codespace-name: string
  }
  stop-for-authenticated-user: func(params: stop-for-authenticated-user-params) -> result<string, string>;

}

interface interactions {
  /// The duration of the interaction restriction. Default: `one_day`.
  record interaction-expiry {
    /// opaque schema; raw JSON
    value: string
  }

  /// The type of GitHub user that can comment, open issues, or create pull requests while the interaction limit is in effect.
  record interaction-group {
    /// opaque schema; raw JSON
    value: string
  }

  /// Get interaction restrictions for an organization
  record get-restrictions-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  get-restrictions-for-org: func(params: get-restrictions-for-org-params) -> result<string, string>;

  /// Set interaction restrictions for an organization
  record set-restrictions-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  set-restrictions-for-org: func(params: set-restrictions-for-org-params) -> result<string, string>;

  /// Remove interaction restrictions for an organization
  record remove-restrictions-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string
  }
  remove-restrictions-for-org: func(params: remove-restrictions-for-org-params) -> result<string, string>;

  /// Get interaction restrictions for a repository
  record get-restrictions-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-restrictions-for-repo: func(params: get-restrictions-for-repo-params) -> result<string, string>;

  /// Set interaction restrictions for a repository
  record set-restrictions-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  set-restrictions-for-repo: func(params: set-restrictions-for-repo-params) -> result<string, string>;

  /// Remove interaction restrictions for a repository
  record remove-restrictions-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  remove-restrictions-for-repo: func(params: remove-restrictions-for-repo-params) -> result<string, string>;

  /// Get interaction restrictions for your public repositories
  get-restrictions-for-authenticated-user: func() -> result<string, string>;

  /// Set interaction restrictions for your public repositories
  record set-restrictions-for-authenticated-user-params {
    expiry: option<interaction-expiry>,
    limit: interaction-group
  }
  set-restrictions-for-authenticated-user: func(params: set-restrictions-for-authenticated-user-params) -> result<string, string>;

  /// Remove interaction restrictions from your public repositories
  remove-restrictions-for-authenticated-user: func() -> result<string, string>;

}

interface migrations {
  enum list-for-org-exclude-item-enum {
    repositories,
  }

  enum start-import-body-vcs-enum {
    subversion,
    git,
    mercurial,
    tfvc,
  }

  enum update-import-body-vcs-enum {
    subversion,
    tfvc,
    git,
    mercurial,
  }

  enum set-lfs-preference-body-use-lfs-enum {
    opt-in,
    opt-out,
  }

  /// List organization migrations
  record list-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<list-for-org-exclude-item-enum>>
  }
  list-for-org: func(params: list-for-org-params) -> result<string, string>;

  /// Start an organization migration
  record start-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Exclude related items from being returned in the response in order to improve performance of the request. The array can include any of: `"repositories"`.
    exclude: option<list<list-for-org-exclude-item-enum>>,
    /// Indicates whether attachments should be excluded from the migration (to reduce migration archive file size).
    exclude-attachments: option<bool>,
    /// Indicates whether the repository git data should be excluded from the migration.
    exclude-git-data: option<bool>,
    /// Indicates whether metadata should be excluded and only git source should be included for the migration.
    exclude-metadata: option<bool>,
    /// Indicates whether projects owned by the organization or users should be excluded. from the migration.
    exclude-owner-projects: option<bool>,
    /// Indicates whether releases should be excluded from the migration (to reduce migration archive file size).
    exclude-releases: option<bool>,
    /// Indicates whether repositories should be locked (to prevent manipulation) while migrating data.
    lock-repositories: option<bool>,
    /// Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags).
    org-metadata-only: option<bool>,
    /// A list of arrays indicating which repositories should be migrated.
    repositories: list<string>
  }
  start-for-org: func(params: start-for-org-params) -> result<string, string>;

  /// Get an organization migration status
  record get-status-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string,
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<list-for-org-exclude-item-enum>>
  }
  get-status-for-org: func(params: get-status-for-org-params) -> result<string, string>;

  /// Download an organization migration archive
  record download-archive-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string
  }
  download-archive-for-org: func(params: download-archive-for-org-params) -> result<string, string>;

  /// Delete an organization migration archive
  record delete-archive-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string
  }
  delete-archive-for-org: func(params: delete-archive-for-org-params) -> result<string, string>;

  /// Unlock an organization repository
  record unlock-repo-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string,
    /// repo_name parameter
    repo-name: string
  }
  unlock-repo-for-org: func(params: unlock-repo-for-org-params) -> result<string, string>;

  /// List repositories in an organization migration
  record list-repos-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The unique identifier of the migration.
    migration-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-for-org: func(params: list-repos-for-org-params) -> result<string, string>;

  /// Get an import status
  record get-import-status-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-import-status: func(params: get-import-status-params) -> result<string, string>;

  /// Start an import
  record start-import-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// For a tfvc import, the name of the project that is being imported.
    tfvc-project: option<string>,
    /// The originating VCS type. Without this parameter, the import job will take additional time to detect the VCS type before beginning the import. This detection step will be reflected in the response.
    vcs: option<start-import-body-vcs-enum>,
    /// If authentication is required, the password to provide to `vcs_url`.
    vcs-password: option<string>,
    /// The URL of the originating repository.
    vcs-url: string,
    /// If authentication is required, the username to provide to `vcs_url`.
    vcs-username: option<string>
  }
  start-import: func(params: start-import-params) -> result<string, string>;

  /// Update an import
  record update-import-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// For a tfvc import, the name of the project that is being imported.
    tfvc-project: option<string>,
    /// The type of version control system you are migrating from.
    vcs: option<update-import-body-vcs-enum>,
    /// The password to provide to the originating repository.
    vcs-password: option<string>,
    /// The username to provide to the originating repository.
    vcs-username: option<string>
  }
  update-import: func(params: update-import-params) -> result<string, string>;

  /// Cancel an import
  record cancel-import-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  cancel-import: func(params: cancel-import-params) -> result<string, string>;

  /// Get commit authors
  record get-commit-authors-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// A user ID. Only return users with an ID greater than this ID.
    since: option<s32>
  }
  get-commit-authors: func(params: get-commit-authors-params) -> result<string, string>;

  /// Map a commit author
  record map-commit-author-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    author-id: string,
    /// The new Git author email.
    email: option<string>,
    /// The new Git author name.
    name: option<string>
  }
  map-commit-author: func(params: map-commit-author-params) -> result<string, string>;

  /// Get large files
  record get-large-files-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string
  }
  get-large-files: func(params: get-large-files-params) -> result<string, string>;

  /// Update Git LFS preference
  record set-lfs-preference-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Whether to store large files during the import. `opt_in` means large files will be stored using Git LFS. `opt_out` means large files will be removed during the import.
    use-lfs: set-lfs-preference-body-use-lfs-enum
  }
  set-lfs-preference: func(params: set-lfs-preference-params) -> result<string, string>;

  /// List user migrations
  record list-for-authenticated-user-params {
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-authenticated-user: func(params: list-for-authenticated-user-params) -> result<string, string>;

  /// Start a user migration
  record start-for-authenticated-user-params {
    /// Exclude attributes from the API response to improve performance
    exclude: option<list<list-for-org-exclude-item-enum>>,
    /// Do not include attachments in the migration
    exclude-attachments: option<bool>,
    /// Indicates whether the repository git data should be excluded from the migration.
    exclude-git-data: option<bool>,
    /// Indicates whether metadata should be excluded and only git source should be included for the migration.
    exclude-metadata: option<bool>,
    /// Indicates whether projects owned by the organization or users should be excluded.
    exclude-owner-projects: option<bool>,
    /// Do not include releases in the migration
    exclude-releases: option<bool>,
    /// Lock the repositories being migrated at the start of the migration
    lock-repositories: option<bool>,
    /// Indicates whether this should only include organization metadata (repositories array should be empty and will ignore other flags).
    org-metadata-only: option<bool>,
    repositories: list<string>
  }
  start-for-authenticated-user: func(params: start-for-authenticated-user-params) -> result<string, string>;

  /// Get a user migration status
  record get-status-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string,
    exclude: option<list<string>>
  }
  get-status-for-authenticated-user: func(params: get-status-for-authenticated-user-params) -> result<string, string>;

  /// Download a user migration archive
  record get-archive-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string
  }
  get-archive-for-authenticated-user: func(params: get-archive-for-authenticated-user-params) -> result<string, string>;

  /// Delete a user migration archive
  record delete-archive-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string
  }
  delete-archive-for-authenticated-user: func(params: delete-archive-for-authenticated-user-params) -> result<string, string>;

  /// Unlock a user repository
  record unlock-repo-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string,
    /// repo_name parameter
    repo-name: string
  }
  unlock-repo-for-authenticated-user: func(params: unlock-repo-for-authenticated-user-params) -> result<string, string>;

  /// List repositories for a user migration
  record list-repos-for-authenticated-user-params {
    /// The unique identifier of the migration.
    migration-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repos-for-authenticated-user: func(params: list-repos-for-authenticated-user-params) -> result<string, string>;

}

