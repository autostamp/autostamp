    /// ref parameter
    ref: string
  }
  repos-list-commit-statuses-for-ref: func(params: repos-list-commit-statuses-for-ref-params) -> result<string, string>;

  /// Get community profile metrics
  repos-get-community-profile-metrics: func() -> result<string, string>;

  /// Compare two commits
  record repos-compare-commits-params {
    /// The base branch and head branch to compare. This parameter expects the format `BASE...HEAD`. Both must be branch names in `repo`. To compare with a branch that exists in a different repository in the same network as `repo`, the `basehead` parameter expects the format `USERNAME:BASE...USERNAME:HEAD`.
    basehead: string
  }
  repos-compare-commits: func(params: repos-compare-commits-params) -> result<string, string>;

  /// Get repository content
  record repos-get-content-params {
    /// path parameter
    path: string,
    /// The name of the commit/branch/tag. Default: the repository’s default branch (usually `master`)
    ref: option<string>
  }
  repos-get-content: func(params: repos-get-content-params) -> result<string, string>;

  /// Create or update file contents
  record repos-create-or-update-file-contents-params {
    /// path parameter
    path: string,
    /// The author of the file. Default: The `committer` or the authenticated user if you omit `committer`.
    author: option<repos-create-or-update-file-contents-body-author>,
    /// The branch name. Default: the repository’s default branch (usually `master`)
    branch: option<string>,
    /// The person that committed the file. Default: the authenticated user.
    committer: option<repos-create-or-update-file-contents-body-committer>,
    /// The new file content, using Base64 encoding.
    content: string,
    /// The commit message.
    message: string,
    /// **Required if you are updating a file**. The blob SHA of the file being replaced.
    sha: option<string>
  }
  repos-create-or-update-file-contents: func(params: repos-create-or-update-file-contents-params) -> result<string, string>;

  /// Delete a file
  record repos-delete-file-params {
    /// path parameter
    path: string,
    /// object containing information about the author.
    author: option<repos-delete-file-body-author>,
    /// The branch name. Default: the repository’s default branch (usually `master`)
    branch: option<string>,
    /// object containing information about the committer.
    committer: option<repos-delete-file-body-committer>,
    /// The commit message.
    message: string,
    /// The blob SHA of the file being deleted.
    sha: string
  }
  repos-delete-file: func(params: repos-delete-file-params) -> result<string, string>;

  /// List repository contributors
  record repos-list-contributors-params {
    /// Set to `1` or `true` to include anonymous contributors in results.
    anon: option<string>
  }
  repos-list-contributors: func(params: repos-list-contributors-params) -> result<string, string>;

  /// List deployments
  record repos-list-deployments-params {
    /// The SHA recorded at creation time.
    sha: option<string>,
    /// The name of the ref. This can be a branch, tag, or SHA.
    ref: option<string>,
    /// The name of the task for the deployment (e.g., `deploy` or `deploy:migrations`).
    task: option<string>,
    /// The name of the environment that was deployed to (e.g., `staging` or `production`).
    environment: option<string>
  }
  repos-list-deployments: func(params: repos-list-deployments-params) -> result<string, string>;

  /// Create a deployment
  record repos-create-deployment-params {
    /// Attempts to automatically merge the default branch into the requested ref, if it's behind the default branch.
    auto-merge: option<bool>,
    /// Short description of the deployment.
    description: option<string>,
    /// Name for the target deployment environment (e.g., `production`, `staging`, `qa`).
    environment: option<string>,
    payload: option<string>,
    /// Specifies if the given environment is one that end-users directly interact with. Default: `true` when `environment` is `production` and `false` otherwise.
    production-environment: option<bool>,
    /// The ref to deploy. This can be a branch, tag, or SHA.
    ref: string,
    /// The [status](https://docs.github.com/rest/commits/statuses) contexts to verify against commit status checks. If you omit this parameter, GitHub verifies all unique contexts before creating a deployment. To bypass checking entirely, pass an empty array. Defaults to all unique contexts.
    required-contexts: option<list<string>>,
    /// Specifies a task to execute (e.g., `deploy` or `deploy:migrations`).
    task: option<string>,
    /// Specifies if the given environment is specific to the deployment and will no longer exist at some point in the future. Default: `false`
    transient-environment: option<bool>
  }
  repos-create-deployment: func(params: repos-create-deployment-params) -> result<string, string>;

  /// Get a deployment
  repos-get-deployment: func() -> result<string, string>;

  /// Delete a deployment
  repos-delete-deployment: func() -> result<string, string>;

  /// List deployment statuses
  repos-list-deployment-statuses: func() -> result<string, string>;

  /// Create a deployment status
  record repos-create-deployment-status-params {
    /// Adds a new `inactive` status to all prior non-transient, non-production environment deployments with the same repository and `environment` name as the created status's deployment. An `inactive` status is only added to deployments that had a `success` state. Default: `true`
    auto-inactive: option<bool>,
    /// A short description of the status. The maximum description length is 140 characters.
    description: option<string>,
    /// Name for the target deployment environment, which can be changed when setting a deploy status. For example, `production`, `staging`, or `qa`.
    environment: option<repos-create-deployment-status-body-environment-enum>,
    /// Sets the URL for accessing your environment. Default: `""`
    environment-url: option<string>,
    /// The full URL of the deployment's output. This parameter replaces `target_url`. We will continue to accept `target_url` to support legacy uses, but we recommend replacing `target_url` with `log_url`. Setting `log_url` will automatically set `target_url` to the same value. Default: `""`
    log-url: option<string>,
    /// The state of the status. When you set a transient deployment to `inactive`, the deployment will be shown as `destroyed` in GitHub.
    state: repos-create-deployment-status-body-state-enum,
    /// The target URL to associate with this status. This URL should contain output to keep the user updated while the task is running or serve as historical information for what happened in the deployment. **Note:** It's recommended to use the `log_url` parameter, which replaces `target_url`.
    target-url: option<string>
  }
  repos-create-deployment-status: func(params: repos-create-deployment-status-params) -> result<string, string>;

