package autostamp:github@0.2.0;

interface meta {
  /// GitHub API Root
  meta-root: func() -> result<string, string>;

  /// Get GitHub meta information
  meta-get: func() -> result<string, string>;

  /// Get Octocat
  record meta-get-octocat-params {
    /// The words to show in Octocat's speech bubble
    s: option<string>
  }
  meta-get-octocat: func(params: meta-get-octocat-params) -> result<string, string>;

  /// Get all API versions
  meta-get-all-versions: func() -> result<string, string>;

  /// Get the Zen of GitHub
  meta-get-zen: func() -> result<string, string>;

}


interface apps {
  enum app-permissions-actions-enum {
    read,
    write,
  }

  enum app-permissions-organization-plan-enum {
    read,
  }

  enum app-permissions-organization-projects-enum {
    read,
    write,
    admin,
  }

  enum app-permissions-workflows-enum {
    write,
  }

  enum apps-list-accounts-for-plan-direction-enum {
    asc,
    desc,
  }

  /// The media type used to serialize the payloads. Supported values include `json` and `form`. The default is `form`.
  record webhook-config-content-type {
    /// opaque schema; raw JSON
    value: string
  }

  record webhook-config-insecure-ssl {
    /// opaque schema; raw JSON
    value: string
  }

  /// If provided, the `secret` will be used as the `key` to generate the HMAC hex digest value for [delivery signature headers](https://docs.github.com/webhooks/event-payloads/#delivery-headers).
  record webhook-config-secret {
    /// opaque schema; raw JSON
    value: string
  }

  /// The URL to which the payloads will be delivered.
  record webhook-config-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// The permissions granted to the user-to-server access token.
  record app-permissions {
    /// The level of permission to grant the access token for GitHub Actions workflows, workflow runs, and artifacts.
    actions: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for repository creation, deletion, settings, teams, and collaborators creation.
    administration: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for checks on code.
    checks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for repository contents, commits, branches, downloads, releases, and merges.
    contents: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for deployments and deployment statuses.
    deployments: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for managing repository environments.
    environments: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for issues and related comments, assignees, labels, and milestones.
    issues: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for organization teams and members.
    members: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to search repositories, list collaborators, and access repository metadata.
    metadata: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage access to an organization.
    organization-administration: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage announcement banners for an organization.
    organization-announcement-banners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for custom repository roles management. This property is in beta and is subject to change.
    organization-custom-roles: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage the post-receive hooks for an organization.
    organization-hooks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for organization packages published to GitHub Packages.
    organization-packages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for viewing an organization's plan.
    organization-plan: option<app-permissions-organization-plan-enum>,
    /// The level of permission to grant the access token to manage organization projects and projects beta (where available).
    organization-projects: option<app-permissions-organization-projects-enum>,
    /// The level of permission to grant the access token to manage organization secrets.
    organization-secrets: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage GitHub Actions self-hosted runners available to an organization.
    organization-self-hosted-runners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage users blocked by the organization.
    organization-user-blocking: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for packages published to GitHub Packages.
    packages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to retrieve Pages statuses, configuration, and builds, as well as create new builds.
    pages: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for pull requests and related comments, assignees, labels, milestones, and merges.
    pull-requests: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage announcement banners for a repository.
    repository-announcement-banners: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage the post-receive hooks for a repository.
    repository-hooks: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage repository projects, columns, and cards.
    repository-projects: option<app-permissions-organization-projects-enum>,
    /// The level of permission to grant the access token to view and manage secret scanning alerts.
    secret-scanning-alerts: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage repository secrets.
    secrets: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to view and manage security events like code scanning alerts.
    security-events: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage just a single file.
    single-file: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token for commit statuses.
    statuses: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage team discussions and related comments.
    team-discussions: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to manage Dependabot alerts.
    vulnerability-alerts: option<app-permissions-actions-enum>,
    /// The level of permission to grant the access token to update GitHub Actions workflow files.
    workflows: option<app-permissions-workflows-enum>
  }

  /// Get the authenticated app
  apps-get-authenticated: func() -> result<string, string>;

  /// Create a GitHub App from a manifest
  record apps-create-from-manifest-params {
    code: string
  }
  apps-create-from-manifest: func(params: apps-create-from-manifest-params) -> result<string, string>;

  /// Get a webhook configuration for an app
  apps-get-webhook-config-for-app: func() -> result<string, string>;

  /// Update a webhook configuration for an app
  record apps-update-webhook-config-for-app-params {
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    secret: option<webhook-config-secret>,
    url: option<webhook-config-url>
  }
  apps-update-webhook-config-for-app: func(params: apps-update-webhook-config-for-app-params) -> result<string, string>;

  /// List deliveries for an app webhook
  record apps-list-webhook-deliveries-params {
    redelivery: option<bool>
  }
  apps-list-webhook-deliveries: func(params: apps-list-webhook-deliveries-params) -> result<string, string>;

  /// Get a delivery for an app webhook
  apps-get-webhook-delivery: func() -> result<string, string>;

  /// Redeliver a delivery for an app webhook
  apps-redeliver-webhook-delivery: func() -> result<string, string>;

  /// List installations for the authenticated app
  record apps-list-installations-params {
    outdated: option<string>
  }
  apps-list-installations: func(params: apps-list-installations-params) -> result<string, string>;

  /// Get an installation for the authenticated app
  apps-get-installation: func() -> result<string, string>;

  /// Delete an installation for the authenticated app
  apps-delete-installation: func() -> result<string, string>;

  /// Create an installation access token for an app
  record apps-create-installation-access-token-params {
    permissions: option<app-permissions>,
    /// List of repository names that the token should have access to
    repositories: option<list<string>>,
    /// List of repository IDs that the token should have access to
    repository-ids: option<list<s32>>
  }
  apps-create-installation-access-token: func(params: apps-create-installation-access-token-params) -> result<string, string>;

  /// Suspend an app installation
  apps-suspend-installation: func() -> result<string, string>;

  /// Unsuspend an app installation
  apps-unsuspend-installation: func() -> result<string, string>;

  /// Delete an app authorization
  record apps-delete-authorization-params {
    /// The OAuth access token used to authenticate to the GitHub API.
    access-token: string
  }
  apps-delete-authorization: func(params: apps-delete-authorization-params) -> result<string, string>;

  /// Check a token
  record apps-check-token-params {
    /// The access_token of the OAuth application.
    access-token: string
  }
  apps-check-token: func(params: apps-check-token-params) -> result<string, string>;

  /// Reset a token
  record apps-reset-token-params {
    /// The access_token of the OAuth application.
    access-token: string
  }
  apps-reset-token: func(params: apps-reset-token-params) -> result<string, string>;

  /// Delete an app token
  record apps-delete-token-params {
    /// The OAuth access token used to authenticate to the GitHub API.
    access-token: string
  }
  apps-delete-token: func(params: apps-delete-token-params) -> result<string, string>;

  /// Create a scoped access token
  record apps-scope-token-params {
    /// The access token used to authenticate to the GitHub API.
    access-token: string,
    permissions: option<app-permissions>,
    /// The list of repository names to scope the user-to-server access token to. `repositories` may not be specified if `repository_ids` is specified.
    repositories: option<list<string>>,
    /// The list of repository IDs to scope the user-to-server access token to. `repository_ids` may not be specified if `repositories` is specified.
    repository-ids: option<list<s32>>,
    /// The name of the user or organization to scope the user-to-server access token to. **Required** unless `target_id` is specified.
    target: option<string>,
    /// The ID of the user or organization to scope the user-to-server access token to. **Required** unless `target` is specified.
    target-id: option<s32>
  }
  apps-scope-token: func(params: apps-scope-token-params) -> result<string, string>;

  /// Get an app
  apps-get-by-slug: func() -> result<string, string>;

  /// List repositories accessible to the app installation
  apps-list-repos-accessible-to-installation: func() -> result<string, string>;

  /// Revoke an installation access token
  apps-revoke-installation-access-token: func() -> result<string, string>;

  /// Get a subscription plan for an account
  apps-get-subscription-plan-for-account: func() -> result<string, string>;

  /// List plans
  apps-list-plans: func() -> result<string, string>;

  /// List accounts for a plan
  record apps-list-accounts-for-plan-params {
    /// To return the oldest accounts first, set to `asc`. Ignored without the `sort` parameter.
    direction: option<apps-list-accounts-for-plan-direction-enum>
  }
  apps-list-accounts-for-plan: func(params: apps-list-accounts-for-plan-params) -> result<string, string>;

  /// Get a subscription plan for an account (stubbed)
  apps-get-subscription-plan-for-account-stubbed: func() -> result<string, string>;

  /// List plans (stubbed)
  apps-list-plans-stubbed: func() -> result<string, string>;

  /// List accounts for a plan (stubbed)
  record apps-list-accounts-for-plan-stubbed-params {
    /// To return the oldest accounts first, set to `asc`. Ignored without the `sort` parameter.
    direction: option<apps-list-accounts-for-plan-direction-enum>
  }
  apps-list-accounts-for-plan-stubbed: func(params: apps-list-accounts-for-plan-stubbed-params) -> result<string, string>;

  /// Get an organization installation for the authenticated app
  apps-get-org-installation: func() -> result<string, string>;

  /// Get a repository installation for the authenticated app
  apps-get-repo-installation: func() -> result<string, string>;

  /// List app installations accessible to the user access token
  apps-list-installations-for-authenticated-user: func() -> result<string, string>;

  /// List repositories accessible to the user access token
  apps-list-installation-repos-for-authenticated-user: func() -> result<string, string>;

  /// Add a repository to an app installation
  apps-add-repo-to-installation-for-authenticated-user: func() -> result<string, string>;

  /// Remove a repository from an app installation
  apps-remove-repo-from-installation-for-authenticated-user: func() -> result<string, string>;

  /// List subscriptions for the authenticated user
  apps-list-subscriptions-for-authenticated-user: func() -> result<string, string>;

  /// List subscriptions for the authenticated user (stubbed)
  apps-list-subscriptions-for-authenticated-user-stubbed: func() -> result<string, string>;

  /// Get a user installation for the authenticated app
  apps-get-user-installation: func() -> result<string, string>;

}

interface codes-of-conduct {
  /// Get all codes of conduct
  codes-of-conduct-get-all-codes-of-conduct: func() -> result<string, string>;

  /// Get a code of conduct
  record codes-of-conduct-get-conduct-code-params {
    key: string
  }
  codes-of-conduct-get-conduct-code: func(params: codes-of-conduct-get-conduct-code-params) -> result<string, string>;

}

interface emojis {
  /// Get emojis
  emojis-get: func() -> result<string, string>;

}

interface dependabot {
  enum dependabot-create-or-update-org-secret-body-visibility-enum {
    all,
    private,
    selected,
  }

  enum dependabot-update-alert-body-dismissed-reason-enum {
    fix-started,
    inaccurate,
    no-bandwidth,
    not-used,
    tolerable-risk,
  }

  enum dependabot-update-alert-body-state-enum {
    dismissed,
    open,
  }

  /// List Dependabot alerts for an enterprise
  dependabot-list-alerts-for-enterprise: func() -> result<string, string>;

  /// List Dependabot alerts for an organization
  dependabot-list-alerts-for-org: func() -> result<string, string>;

  /// List organization secrets
  dependabot-list-org-secrets: func() -> result<string, string>;

  /// Get an organization public key
  dependabot-get-org-public-key: func() -> result<string, string>;

  /// Get an organization secret
  dependabot-get-org-secret: func() -> result<string, string>;

  /// Create or update an organization secret
  record dependabot-create-or-update-org-secret-params {
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an organization public key](https://docs.github.com/rest/reference/dependabot#get-an-organization-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>,
    /// An array of repository ids that can access the organization secret. You can only provide a list of repository ids when the `visibility` is set to `selected`. You can manage the list of selected repositories using the [List selected repositories for an organization secret](https://docs.github.com/rest/reference/dependabot#list-selected-repositories-for-an-organization-secret), [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/dependabot#set-selected-repositories-for-an-organization-secret), and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/dependabot#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: option<list<string>>,
    /// Which type of organization repositories have access to the organization secret. `selected` means only the repositories specified by `selected_repository_ids` can access the secret.
    visibility: dependabot-create-or-update-org-secret-body-visibility-enum
  }
  dependabot-create-or-update-org-secret: func(params: dependabot-create-or-update-org-secret-params) -> result<string, string>;

  /// Delete an organization secret
  dependabot-delete-org-secret: func() -> result<string, string>;

  /// List selected repositories for an organization secret
  dependabot-list-selected-repos-for-org-secret: func() -> result<string, string>;

  /// Set selected repositories for an organization secret
  record dependabot-set-selected-repos-for-org-secret-params {
    /// An array of repository ids that can access the organization secret. You can only provide a list of repository ids when the `visibility` is set to `selected`. You can add and remove individual repositories using the [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/dependabot#set-selected-repositories-for-an-organization-secret) and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/dependabot#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: list<s32>
  }
  dependabot-set-selected-repos-for-org-secret: func(params: dependabot-set-selected-repos-for-org-secret-params) -> result<string, string>;

  /// Add selected repository to an organization secret
  record dependabot-add-selected-repo-to-org-secret-params {
    repository-id: string
  }
  dependabot-add-selected-repo-to-org-secret: func(params: dependabot-add-selected-repo-to-org-secret-params) -> result<string, string>;

  /// Remove selected repository from an organization secret
  record dependabot-remove-selected-repo-from-org-secret-params {
    repository-id: string
  }
  dependabot-remove-selected-repo-from-org-secret: func(params: dependabot-remove-selected-repo-from-org-secret-params) -> result<string, string>;

  /// List Dependabot alerts for a repository
  record dependabot-list-alerts-for-repo-params {
    /// **Deprecated**. Page number of the results to fetch. Use cursor-based pagination with `before` or `after` instead.
    page: option<s32>,
    /// The number of results per page (max 100).
    per-page: option<s32>
  }
  dependabot-list-alerts-for-repo: func(params: dependabot-list-alerts-for-repo-params) -> result<string, string>;

  /// Get a Dependabot alert
  dependabot-get-alert: func() -> result<string, string>;

  /// Update a Dependabot alert
  record dependabot-update-alert-params {
    /// An optional comment associated with dismissing the alert.
    dismissed-comment: option<string>,
    /// **Required when `state` is `dismissed`.** A reason for dismissing the alert.
    dismissed-reason: option<dependabot-update-alert-body-dismissed-reason-enum>,
    /// The state of the Dependabot alert.
    /// A `dismissed_reason` must be provided when setting the state to `dismissed`.
    state: dependabot-update-alert-body-state-enum
  }
  dependabot-update-alert: func(params: dependabot-update-alert-params) -> result<string, string>;

  /// List repository secrets
  dependabot-list-repo-secrets: func() -> result<string, string>;

  /// Get a repository public key
  dependabot-get-repo-public-key: func() -> result<string, string>;

  /// Get a repository secret
  dependabot-get-repo-secret: func() -> result<string, string>;

  /// Create or update a repository secret
  record dependabot-create-or-update-repo-secret-params {
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get a repository public key](https://docs.github.com/rest/reference/dependabot#get-a-repository-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>
  }
  dependabot-create-or-update-repo-secret: func(params: dependabot-create-or-update-repo-secret-params) -> result<string, string>;

  /// Delete a repository secret
  dependabot-delete-repo-secret: func() -> result<string, string>;

}

interface secret-scanning {
  /// **Required when the `state` is `resolved`.** The reason for resolving the alert.
  record secret-scanning-alert-resolution {
    /// opaque schema; raw JSON
    value: string
  }

  /// An optional comment when closing an alert. Cannot be updated or deleted. Must be `null` when changing `state` to `open`.
  record secret-scanning-alert-resolution-comment {
    /// opaque schema; raw JSON
    value: string
  }

  /// Sets the state of the secret scanning alert. You must provide `resolution` when you set the state to `resolved`.
  record secret-scanning-alert-state {
    /// opaque schema; raw JSON
    value: string
  }

  /// List secret scanning alerts for an enterprise
  secret-scanning-list-alerts-for-enterprise: func() -> result<string, string>;

  /// List secret scanning alerts for an organization
  secret-scanning-list-alerts-for-org: func() -> result<string, string>;

  /// List secret scanning alerts for a repository
  secret-scanning-list-alerts-for-repo: func() -> result<string, string>;

  /// Get a secret scanning alert
  secret-scanning-get-alert: func() -> result<string, string>;

  /// Update a secret scanning alert
  record secret-scanning-update-alert-params {
    resolution: option<secret-scanning-alert-resolution>,
    resolution-comment: option<secret-scanning-alert-resolution-comment>,
    state: secret-scanning-alert-state
  }
  secret-scanning-update-alert: func(params: secret-scanning-update-alert-params) -> result<string, string>;

  /// List locations for a secret scanning alert
  secret-scanning-list-locations-for-alert: func() -> result<string, string>;

}

interface activity {
  /// List public events
  activity-list-public-events: func() -> result<string, string>;

  /// Get feeds
  activity-get-feeds: func() -> result<string, string>;

  /// List public events for a network of repositories
  activity-list-public-events-for-repo-network: func() -> result<string, string>;

  /// List notifications for the authenticated user
  record activity-list-notifications-for-authenticated-user-params {
    /// The number of results per page (max 50).
    per-page: option<s32>
  }
  activity-list-notifications-for-authenticated-user: func(params: activity-list-notifications-for-authenticated-user-params) -> result<string, string>;

  /// Mark notifications as read
  record activity-mark-notifications-as-read-params {
    /// Describes the last point that notifications were checked. Anything updated since this time will not be marked as read. If you omit this parameter, all notifications are marked as read. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. Default: The current timestamp.
    last-read-at: option<string>,
    /// Whether the notification has been read.
    read: option<bool>
  }
  activity-mark-notifications-as-read: func(params: activity-mark-notifications-as-read-params) -> result<string, string>;

  /// Get a thread
  activity-get-thread: func() -> result<string, string>;

  /// Mark a thread as read
  activity-mark-thread-as-read: func() -> result<string, string>;

  /// Get a thread subscription for the authenticated user
  activity-get-thread-subscription-for-authenticated-user: func() -> result<string, string>;

  /// Set a thread subscription
  record activity-set-thread-subscription-params {
    /// Whether to block all notifications from a thread.
    ignored: option<bool>
  }
  activity-set-thread-subscription: func(params: activity-set-thread-subscription-params) -> result<string, string>;

  /// Delete a thread subscription
  activity-delete-thread-subscription: func() -> result<string, string>;

  /// List public organization events
  activity-list-public-org-events: func() -> result<string, string>;

  /// List repository events
  activity-list-repo-events: func() -> result<string, string>;

  /// List repository notifications for the authenticated user
  activity-list-repo-notifications-for-authenticated-user: func() -> result<string, string>;

  /// Mark repository notifications as read
  record activity-mark-repo-notifications-as-read-params {
    /// Describes the last point that notifications were checked. Anything updated since this time will not be marked as read. If you omit this parameter, all notifications are marked as read. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. Default: The current timestamp.
    last-read-at: option<string>
  }
  activity-mark-repo-notifications-as-read: func(params: activity-mark-repo-notifications-as-read-params) -> result<string, string>;

  /// List stargazers
  activity-list-stargazers-for-repo: func() -> result<string, string>;

  /// List watchers
  activity-list-watchers-for-repo: func() -> result<string, string>;

  /// Get a repository subscription
  activity-get-repo-subscription: func() -> result<string, string>;

  /// Set a repository subscription
  record activity-set-repo-subscription-params {
    /// Determines if all notifications should be blocked from this repository.
    ignored: option<bool>,
    /// Determines if notifications should be received from this repository.
    subscribed: option<bool>
  }
  activity-set-repo-subscription: func(params: activity-set-repo-subscription-params) -> result<string, string>;

  /// Delete a repository subscription
  activity-delete-repo-subscription: func() -> result<string, string>;

  /// List repositories starred by the authenticated user
  activity-list-repos-starred-by-authenticated-user: func() -> result<string, string>;

  /// Check if a repository is starred by the authenticated user
  activity-check-repo-is-starred-by-authenticated-user: func() -> result<string, string>;

  /// Star a repository for the authenticated user
  activity-star-repo-for-authenticated-user: func() -> result<string, string>;

  /// Unstar a repository for the authenticated user
  activity-unstar-repo-for-authenticated-user: func() -> result<string, string>;

  /// List repositories watched by the authenticated user
  activity-list-watched-repos-for-authenticated-user: func() -> result<string, string>;

  /// List events for the authenticated user
  activity-list-events-for-authenticated-user: func() -> result<string, string>;

  /// List organization events for the authenticated user
  activity-list-org-events-for-authenticated-user: func() -> result<string, string>;

  /// List public events for a user
  activity-list-public-events-for-user: func() -> result<string, string>;

  /// List events received by the authenticated user
  activity-list-received-events-for-user: func() -> result<string, string>;

  /// List public events received by a user
  activity-list-received-public-events-for-user: func() -> result<string, string>;

  /// List repositories starred by a user
  activity-list-repos-starred-by-user: func() -> result<string, string>;

  /// List repositories watched by a user
  activity-list-repos-watched-by-user: func() -> result<string, string>;

}

interface gists {
  /// Names and content for the files that make up the gist
  record gists-create-body-files {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The gist files to be updated, renamed, or deleted. Each `key` must match the current filename
  /// (including extension) of the targeted gist file. For example: `hello.py`.
  /// 
  /// To delete a file, set the whole file to null. For example: `hello.py : null`.
  record gists-update-body-files {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List gists for the authenticated user
  gists-list: func() -> result<string, string>;

  /// Create a gist
  record gists-create-params {
    /// Description of the gist
    description: option<string>,
    /// Names and content for the files that make up the gist
    files: gists-create-body-files,
    public: option<string>
  }
  gists-create: func(params: gists-create-params) -> result<string, string>;

  /// List public gists
  gists-list-public: func() -> result<string, string>;

  /// List starred gists
  gists-list-starred: func() -> result<string, string>;

  /// Get a gist
  gists-get: func() -> result<string, string>;

  /// Update a gist
  record gists-update-params {
    /// The description of the gist.
    description: option<string>,
    /// The gist files to be updated, renamed, or deleted. Each `key` must match the current filename
    /// (including extension) of the targeted gist file. For example: `hello.py`.
    files: option<gists-update-body-files>
  }
  gists-update: func(params: gists-update-params) -> result<string, string>;

  /// Delete a gist
  gists-delete: func() -> result<string, string>;

  /// List gist comments
  gists-list-comments: func() -> result<string, string>;

  /// Create a gist comment
  record gists-create-comment-params {
    /// The comment text.
    body: string
  }
  gists-create-comment: func(params: gists-create-comment-params) -> result<string, string>;

  /// Get a gist comment
  gists-get-comment: func() -> result<string, string>;

  /// Update a gist comment
  record gists-update-comment-params {
    /// The comment text.
    body: string
  }
  gists-update-comment: func(params: gists-update-comment-params) -> result<string, string>;

  /// Delete a gist comment
  gists-delete-comment: func() -> result<string, string>;

  /// List gist commits
  gists-list-commits: func() -> result<string, string>;

  /// List gist forks
  gists-list-forks: func() -> result<string, string>;

  /// Fork a gist
  gists-fork: func() -> result<string, string>;

  /// Check if a gist is starred
  gists-check-is-starred: func() -> result<string, string>;

  /// Star a gist
  gists-star: func() -> result<string, string>;

  /// Unstar a gist
  gists-unstar: func() -> result<string, string>;

  /// Get a gist revision
  record gists-get-revision-params {
    sha: string
  }
  gists-get-revision: func(params: gists-get-revision-params) -> result<string, string>;

  /// List gists for a user
  gists-list-for-user: func() -> result<string, string>;

}

interface gitignore {
  /// Get all gitignore templates
  gitignore-get-all-templates: func() -> result<string, string>;

  /// Get a gitignore template
  record gitignore-get-template-params {
    name: string
  }
  gitignore-get-template: func(params: gitignore-get-template-params) -> result<string, string>;

}

interface issues {
  enum issues-list-filter-enum {
    assigned,
    created,
    mentioned,
    subscribed,
    repos,
    all,
  }

  enum issues-list-state-enum {
    open,
    closed,
    all,
  }

  enum issues-list-sort-enum {
    created,
    updated,
    comments,
  }

  enum issues-list-comments-for-repo-direction-enum {
    asc,
    desc,
  }

  enum issues-update-body-state-enum {
    open,
    closed,
  }

  enum issues-update-body-state-reason-enum {
    completed,
    not-planned,
    reopened,
  }

  enum issues-lock-body-lock-reason-enum {
    off-topic,
    too-heated,
    resolved,
    spam,
  }

  enum issues-list-milestones-sort-enum {
    due-on,
    completeness,
  }

  /// List issues assigned to the authenticated user
  record issues-list-params {
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<issues-list-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<issues-list-state-enum>,
    /// What to sort results by.
    sort: option<issues-list-sort-enum>,
    collab: option<bool>,
    orgs: option<bool>,
    owned: option<bool>,
    pulls: option<bool>
  }
  issues-list: func(params: issues-list-params) -> result<string, string>;

  /// List organization issues assigned to the authenticated user
  record issues-list-for-org-params {
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<issues-list-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<issues-list-state-enum>,
    /// What to sort results by.
    sort: option<issues-list-sort-enum>
  }
  issues-list-for-org: func(params: issues-list-for-org-params) -> result<string, string>;

  /// List assignees
  issues-list-assignees: func() -> result<string, string>;

  /// Check if a user can be assigned
  record issues-check-user-can-be-assigned-params {
    assignee: string
  }
  issues-check-user-can-be-assigned: func(params: issues-check-user-can-be-assigned-params) -> result<string, string>;

  /// List repository issues
  record issues-list-for-repo-params {
    /// If an `integer` is passed, it should refer to a milestone by its `number` field. If the string `*` is passed, issues with any milestone are accepted. If the string `none` is passed, issues without milestones are returned.
    milestone: option<string>,
    /// Indicates the state of the issues to return.
    state: option<issues-list-state-enum>,
    /// Can be the name of a user. Pass in `none` for issues with no assigned user, and `*` for issues assigned to any user.
    assignee: option<string>,
    /// The user that created the issue.
    creator: option<string>,
    /// A user that's mentioned in the issue.
    mentioned: option<string>,
    /// What to sort results by.
    sort: option<issues-list-sort-enum>
  }
  issues-list-for-repo: func(params: issues-list-for-repo-params) -> result<string, string>;

  /// Create an issue
  record issues-create-params {
    /// Login for the user that this issue should be assigned to. _NOTE: Only users with push access can set the assignee for new issues. The assignee is silently dropped otherwise. **This field is deprecated.**_
    assignee: option<string>,
    /// Logins for Users to assign to this issue. _NOTE: Only users with push access can set assignees for new issues. Assignees are silently dropped otherwise._
    assignees: option<list<string>>,
    /// The contents of the issue.
    body: option<string>,
    /// Labels to associate with this issue. _NOTE: Only users with push access can set labels for new issues. Labels are silently dropped otherwise._
    labels: option<list<string>>,
    milestone: option<string>,
    /// The title of the issue.
    title: string
  }
  issues-create: func(params: issues-create-params) -> result<string, string>;

  /// List issue comments for a repository
  record issues-list-comments-for-repo-params {
    /// Either `asc` or `desc`. Ignored without the `sort` parameter.
    direction: option<issues-list-comments-for-repo-direction-enum>
  }
  issues-list-comments-for-repo: func(params: issues-list-comments-for-repo-params) -> result<string, string>;

  /// Get an issue comment
  issues-get-comment: func() -> result<string, string>;

  /// Update an issue comment
  record issues-update-comment-params {
    /// The contents of the comment.
    body: string
  }
  issues-update-comment: func(params: issues-update-comment-params) -> result<string, string>;

  /// Delete an issue comment
  issues-delete-comment: func() -> result<string, string>;

  /// List issue events for a repository
  issues-list-events-for-repo: func() -> result<string, string>;

  /// Get an issue event
  record issues-get-event-params {
    event-id: string
  }
  issues-get-event: func(params: issues-get-event-params) -> result<string, string>;

  /// Get an issue
  issues-get: func() -> result<string, string>;

  /// Update an issue
  record issues-update-params {
    /// Username to assign to this issue. **This field is deprecated.**
    assignee: option<string>,
    /// Usernames to assign to this issue. Pass one or more user logins to _replace_ the set of assignees on this issue. Send an empty array (`[]`) to clear all assignees from the issue. Only users with push access can set assignees for new issues. Without push access to the repository, assignee changes are silently dropped.
    assignees: option<list<string>>,
    /// The contents of the issue.
    body: option<string>,
    /// Labels to associate with this issue. Pass one or more labels to _replace_ the set of labels on this issue. Send an empty array (`[]`) to clear all labels from the issue. Only users with push access can set labels for issues. Without push access to the repository, label changes are silently dropped.
    labels: option<list<string>>,
    milestone: option<string>,
    /// The open or closed state of the issue.
    state: option<issues-update-body-state-enum>,
    /// The reason for the state change. Ignored unless `state` is changed.
    state-reason: option<issues-update-body-state-reason-enum>,
    /// The title of the issue.
    title: option<string>
  }
  issues-update: func(params: issues-update-params) -> result<string, string>;

  /// Add assignees to an issue
  record issues-add-assignees-params {
    /// Usernames of people to assign this issue to. _NOTE: Only users with push access can add assignees to an issue. Assignees are silently ignored otherwise._
    assignees: option<list<string>>
  }
  issues-add-assignees: func(params: issues-add-assignees-params) -> result<string, string>;

  /// Remove assignees from an issue
  record issues-remove-assignees-params {
    /// Usernames of assignees to remove from an issue. _NOTE: Only users with push access can remove assignees from an issue. Assignees are silently ignored otherwise._
    assignees: option<list<string>>
  }
  issues-remove-assignees: func(params: issues-remove-assignees-params) -> result<string, string>;

  /// Check if a user can be assigned to a issue
  record issues-check-user-can-be-assigned-to-issue-params {
    assignee: string
  }
  issues-check-user-can-be-assigned-to-issue: func(params: issues-check-user-can-be-assigned-to-issue-params) -> result<string, string>;

  /// List issue comments
  issues-list-comments: func() -> result<string, string>;

  /// Create an issue comment
  record issues-create-comment-params {
    /// The contents of the comment.
    body: string
  }
  issues-create-comment: func(params: issues-create-comment-params) -> result<string, string>;

  /// List issue events
  issues-list-events: func() -> result<string, string>;

  /// List labels for an issue
  issues-list-labels-on-issue: func() -> result<string, string>;

  /// Add labels to an issue
  record issues-add-labels-params {
    body: option<string>
  }
  issues-add-labels: func(params: issues-add-labels-params) -> result<string, string>;

  /// Set labels for an issue
  record issues-set-labels-params {
    body: option<string>
  }
  issues-set-labels: func(params: issues-set-labels-params) -> result<string, string>;

  /// Remove all labels from an issue
  issues-remove-all-labels: func() -> result<string, string>;

  /// Remove a label from an issue
  record issues-remove-label-params {
    name: string
  }
  issues-remove-label: func(params: issues-remove-label-params) -> result<string, string>;

  /// Lock an issue
  record issues-lock-params {
    /// The reason for locking the issue or pull request conversation. Lock will fail if you don't use one of these reasons:  
    ///  * `off-topic`  
    lock-reason: option<issues-lock-body-lock-reason-enum>
  }
  issues-lock: func(params: issues-lock-params) -> result<string, string>;

  /// Unlock an issue
  issues-unlock: func() -> result<string, string>;

  /// List timeline events for an issue
  issues-list-events-for-timeline: func() -> result<string, string>;

  /// List labels for a repository
  issues-list-labels-for-repo: func() -> result<string, string>;

  /// Create a label
  record issues-create-label-params {
    /// The [hexadecimal color code](http://www.color-hex.com/) for the label, without the leading `#`.
    color: option<string>,
    /// A short description of the label. Must be 100 characters or fewer.
    description: option<string>,
    /// The name of the label. Emoji can be added to label names, using either native emoji or colon-style markup. For example, typing `:strawberry:` will render the emoji ![:strawberry:](https://github.githubassets.com/images/icons/emoji/unicode/1f353.png ":strawberry:"). For a full list of available emoji and codes, see "[Emoji cheat sheet](https://github.com/ikatyang/emoji-cheat-sheet)."
    name: string
  }
  issues-create-label: func(params: issues-create-label-params) -> result<string, string>;

  /// Get a label
  record issues-get-label-params {
    name: string
  }
  issues-get-label: func(params: issues-get-label-params) -> result<string, string>;

  /// Update a label
  record issues-update-label-params {
    name: string,
    /// The [hexadecimal color code](http://www.color-hex.com/) for the label, without the leading `#`.
    color: option<string>,
    /// A short description of the label. Must be 100 characters or fewer.
    description: option<string>,
    /// The new name of the label. Emoji can be added to label names, using either native emoji or colon-style markup. For example, typing `:strawberry:` will render the emoji ![:strawberry:](https://github.githubassets.com/images/icons/emoji/unicode/1f353.png ":strawberry:"). For a full list of available emoji and codes, see "[Emoji cheat sheet](https://github.com/ikatyang/emoji-cheat-sheet)."
    new-name: option<string>
  }
  issues-update-label: func(params: issues-update-label-params) -> result<string, string>;

  /// Delete a label
  record issues-delete-label-params {
    name: string
  }
  issues-delete-label: func(params: issues-delete-label-params) -> result<string, string>;

  /// List milestones
  record issues-list-milestones-params {
    /// The state of the milestone. Either `open`, `closed`, or `all`.
    state: option<issues-list-state-enum>,
    /// What to sort results by. Either `due_on` or `completeness`.
    sort: option<issues-list-milestones-sort-enum>,
    /// The direction of the sort. Either `asc` or `desc`.
    direction: option<issues-list-comments-for-repo-direction-enum>
  }
  issues-list-milestones: func(params: issues-list-milestones-params) -> result<string, string>;

  /// Create a milestone
  record issues-create-milestone-params {
    /// A description of the milestone.
    description: option<string>,
    /// The milestone due date. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    due-on: option<string>,
    /// The state of the milestone. Either `open` or `closed`.
    state: option<issues-update-body-state-enum>,
    /// The title of the milestone.
    title: string
  }
  issues-create-milestone: func(params: issues-create-milestone-params) -> result<string, string>;

  /// Get a milestone
  issues-get-milestone: func() -> result<string, string>;

  /// Update a milestone
  record issues-update-milestone-params {
    /// A description of the milestone.
    description: option<string>,
    /// The milestone due date. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    due-on: option<string>,
    /// The state of the milestone. Either `open` or `closed`.
    state: option<issues-update-body-state-enum>,
    /// The title of the milestone.
    title: option<string>
  }
  issues-update-milestone: func(params: issues-update-milestone-params) -> result<string, string>;

  /// Delete a milestone
  issues-delete-milestone: func() -> result<string, string>;

  /// List labels for issues in a milestone
  issues-list-labels-for-milestone: func() -> result<string, string>;

  /// List user account issues assigned to the authenticated user
  record issues-list-for-authenticated-user-params {
    /// Indicates which sorts of issues to return. `assigned` means issues assigned to you. `created` means issues created by you. `mentioned` means issues mentioning you. `subscribed` means issues you're subscribed to updates for. `all` or `repos` means all issues you can see, regardless of participation or creation.
    filter: option<issues-list-filter-enum>,
    /// Indicates the state of the issues to return.
    state: option<issues-list-state-enum>,
    /// What to sort results by.
    sort: option<issues-list-sort-enum>
  }
  issues-list-for-authenticated-user: func(params: issues-list-for-authenticated-user-params) -> result<string, string>;

}

interface licenses {
  /// Get all commonly used licenses
  record licenses-get-all-commonly-used-params {
    featured: option<bool>
  }
  licenses-get-all-commonly-used: func(params: licenses-get-all-commonly-used-params) -> result<string, string>;

  /// Get a license
  record licenses-get-params {
    license: string
  }
  licenses-get: func(params: licenses-get-params) -> result<string, string>;

  /// Get the license for a repository
  licenses-get-for-repo: func() -> result<string, string>;

}

interface markdown {
  enum markdown-render-body-mode-enum {
    markdown,
    gfm,
  }

  /// Render a Markdown document
  record markdown-render-params {
    /// The repository context to use when creating references in `gfm` mode.  For example, setting `context` to `octo-org/octo-repo` will change the text `#42` into an HTML link to issue 42 in the `octo-org/octo-repo` repository.
    context: option<string>,
    /// The rendering mode.
    mode: option<markdown-render-body-mode-enum>,
    /// The Markdown text to render in HTML.
    text: string
  }
  markdown-render: func(params: markdown-render-params) -> result<string, string>;

  /// Render a Markdown document in raw mode
  markdown-render-raw: func() -> result<string, string>;

}

interface orgs {
  enum orgs-update-body-default-repository-permission-enum {
    read,
    write,
    admin,
    none,
  }

  enum orgs-update-body-members-allowed-repository-creation-type-enum {
    all,
    private,
    none,
  }

  enum orgs-list-pending-invitations-role-enum {
    all,
    admin,
    direct-member,
    billing-manager,
    hiring-manager,
  }

  enum orgs-list-pending-invitations-invitation-source-enum {
    all,
    member,
    scim,
  }

  enum orgs-create-invitation-body-role-enum {
    admin,
    direct-member,
    billing-manager,
  }

  enum orgs-list-members-filter-enum {
    v2fa-disabled,
    all,
  }

  enum orgs-list-members-role-enum {
    all,
    admin,
    member,
  }

  enum orgs-set-membership-for-user-body-role-enum {
    admin,
    member,
  }

  enum orgs-list-memberships-for-authenticated-user-state-enum {
    active,
    pending,
  }

  enum orgs-update-membership-for-authenticated-user-body-state-enum {
    active,
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#create-hook-config-params).
  record orgs-create-webhook-body-config {
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    password: option<string>,
    secret: option<webhook-config-secret>,
    url: webhook-config-url,
    username: option<string>
  }

  /// The media type used to serialize the payloads. Supported values include `json` and `form`. The default is `form`.
  record webhook-config-content-type {
    /// opaque schema; raw JSON
    value: string
  }

  record webhook-config-insecure-ssl {
    /// opaque schema; raw JSON
    value: string
  }

  /// If provided, the `secret` will be used as the `key` to generate the HMAC hex digest value for [delivery signature headers](https://docs.github.com/webhooks/event-payloads/#delivery-headers).
  record webhook-config-secret {
    /// opaque schema; raw JSON
    value: string
  }

  /// The URL to which the payloads will be delivered.
  record webhook-config-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#update-hook-config-params).
  record orgs-update-webhook-body-config {
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    secret: option<webhook-config-secret>,
    url: webhook-config-url
  }

  /// List organizations
  orgs-list: func() -> result<string, string>;

  /// Get an organization
  orgs-get: func() -> result<string, string>;

  /// Update an organization
  record orgs-update-params {
    /// Whether GitHub Advanced Security is automatically enabled for new repositories.
    /// 
    advanced-security-enabled-for-new-repositories: option<bool>,
    /// Billing email address. This address is not publicized.
    billing-email: option<string>,
    blog: option<string>,
    /// The company name.
    company: option<string>,
    /// Default permission level members have for organization repositories.
    default-repository-permission: option<orgs-update-body-default-repository-permission-enum>,
    /// Whether Dependabot alerts is automatically enabled for new repositories.
    /// 
    dependabot-alerts-enabled-for-new-repositories: option<bool>,
    /// Whether Dependabot security updates is automatically enabled for new repositories.
    /// 
    dependabot-security-updates-enabled-for-new-repositories: option<bool>,
    /// Whether dependency graph is automatically enabled for new repositories.
    /// 
    dependency-graph-enabled-for-new-repositories: option<bool>,
    /// The description of the company.
    description: option<string>,
    /// The publicly visible email address.
    email: option<string>,
    /// Whether an organization can use organization projects.
    has-organization-projects: option<bool>,
    /// Whether repositories that belong to the organization can use repository projects.
    has-repository-projects: option<bool>,
    /// The location.
    location: option<string>,
    /// Specifies which types of repositories non-admin organization members can create. `private` is only available to repositories that are part of an organization on GitHub Enterprise Cloud. 
    /// **Note:** This parameter is deprecated and will be removed in the future. Its return value ignores internal repositories. Using this parameter overrides values set in `members_can_create_repositories`. See the parameter deprecation notice in the operation description for details.
    members-allowed-repository-creation-type: option<orgs-update-body-members-allowed-repository-creation-type-enum>,
    /// Whether organization members can create internal repositories, which are visible to all enterprise members. You can only allow members to create internal repositories if your organization is associated with an enterprise account using GitHub Enterprise Cloud or GitHub Enterprise Server 2.20+. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-internal-repositories: option<bool>,
    /// Whether organization members can create GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-pages: option<bool>,
    /// Whether organization members can create private GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-private-pages: option<bool>,
    /// Whether organization members can create private repositories, which are visible to organization members with permission. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-private-repositories: option<bool>,
    /// Whether organization members can create public GitHub Pages sites. Existing published sites will not be impacted.
    members-can-create-public-pages: option<bool>,
    /// Whether organization members can create public repositories, which are visible to anyone. For more information, see "[Restricting repository creation in your organization](https://docs.github.com/github/setting-up-and-managing-organizations-and-teams/restricting-repository-creation-in-your-organization)" in the GitHub Help documentation.
    members-can-create-public-repositories: option<bool>,
    /// Whether of non-admin organization members can create repositories. **Note:** A parameter can override this parameter. See `members_allowed_repository_creation_type` in this table for details.
    members-can-create-repositories: option<bool>,
    /// Whether organization members can fork private organization repositories.
    members-can-fork-private-repositories: option<bool>,
    /// The shorthand name of the company.
    name: option<string>,
    /// Whether secret scanning is automatically enabled for new repositories.
    /// 
    secret-scanning-enabled-for-new-repositories: option<bool>,
    /// If `secret_scanning_push_protection_custom_link_enabled` is true, the URL that will be displayed to contributors who are blocked from pushing a secret.
    secret-scanning-push-protection-custom-link: option<string>,
    /// Whether a custom link is shown to contributors who are blocked from pushing a secret by push protection.
    secret-scanning-push-protection-custom-link-enabled: option<bool>,
    /// Whether secret scanning push protection is automatically enabled for new repositories.
    /// 
    secret-scanning-push-protection-enabled-for-new-repositories: option<bool>,
    /// The Twitter username of the company.
    twitter-username: option<string>,
    /// Whether contributors to organization repositories are required to sign off on commits they make through GitHub's web interface.
    web-commit-signoff-required: option<bool>
  }
  orgs-update: func(params: orgs-update-params) -> result<string, string>;

  /// List users blocked by an organization
  orgs-list-blocked-users: func() -> result<string, string>;

  /// Check if a user is blocked by an organization
  orgs-check-blocked-user: func() -> result<string, string>;

  /// Block a user from an organization
  orgs-block-user: func() -> result<string, string>;

  /// Unblock a user from an organization
  orgs-unblock-user: func() -> result<string, string>;

  /// List failed organization invitations
  orgs-list-failed-invitations: func() -> result<string, string>;

  /// List organization webhooks
  orgs-list-webhooks: func() -> result<string, string>;

  /// Create an organization webhook
  record orgs-create-webhook-params {
    /// Determines if notifications are sent when the webhook is triggered. Set to `true` to send notifications.
    active: option<bool>,
    /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#create-hook-config-params).
    config: orgs-create-webhook-body-config,
    /// Determines what [events](https://docs.github.com/webhooks/event-payloads) the hook is triggered for. Set to `["*"]` to receive all possible events.
    events: option<list<string>>,
    /// Must be passed as "web".
    name: string
  }
  orgs-create-webhook: func(params: orgs-create-webhook-params) -> result<string, string>;

  /// Get an organization webhook
  orgs-get-webhook: func() -> result<string, string>;

  /// Update an organization webhook
  record orgs-update-webhook-params {
    /// Determines if notifications are sent when the webhook is triggered. Set to `true` to send notifications.
    active: option<bool>,
    /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/orgs#update-hook-config-params).
    config: option<orgs-update-webhook-body-config>,
    /// Determines what [events](https://docs.github.com/webhooks/event-payloads) the hook is triggered for.
    events: option<list<string>>,
    name: option<string>
  }
  orgs-update-webhook: func(params: orgs-update-webhook-params) -> result<string, string>;

  /// Delete an organization webhook
  orgs-delete-webhook: func() -> result<string, string>;

  /// Get a webhook configuration for an organization
  orgs-get-webhook-config-for-org: func() -> result<string, string>;

  /// Update a webhook configuration for an organization
  record orgs-update-webhook-config-for-org-params {
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    secret: option<webhook-config-secret>,
    url: option<webhook-config-url>
  }
  orgs-update-webhook-config-for-org: func(params: orgs-update-webhook-config-for-org-params) -> result<string, string>;

  /// List deliveries for an organization webhook
  record orgs-list-webhook-deliveries-params {
    redelivery: option<bool>
  }
  orgs-list-webhook-deliveries: func(params: orgs-list-webhook-deliveries-params) -> result<string, string>;

  /// Get a webhook delivery for an organization webhook
  orgs-get-webhook-delivery: func() -> result<string, string>;

  /// Redeliver a delivery for an organization webhook
  orgs-redeliver-webhook-delivery: func() -> result<string, string>;

  /// Ping an organization webhook
  orgs-ping-webhook: func() -> result<string, string>;

  /// List app installations for an organization
  orgs-list-app-installations: func() -> result<string, string>;

  /// List pending organization invitations
  record orgs-list-pending-invitations-params {
    /// Filter invitations by their member role.
    role: option<orgs-list-pending-invitations-role-enum>,
    /// Filter invitations by their invitation source.
    invitation-source: option<orgs-list-pending-invitations-invitation-source-enum>
  }
  orgs-list-pending-invitations: func(params: orgs-list-pending-invitations-params) -> result<string, string>;

  /// Create an organization invitation
  record orgs-create-invitation-params {
    /// **Required unless you provide `invitee_id`**. Email address of the person you are inviting, which can be an existing GitHub user.
    email: option<string>,
    /// **Required unless you provide `email`**. GitHub user ID for the person you are inviting.
    invitee-id: option<s32>,
    /// The role for the new member. 
    ///  * `admin` - Organization owners with full administrative rights to the organization and complete access to all repositories and teams.  
    role: option<orgs-create-invitation-body-role-enum>,
    /// Specify IDs for the teams you want to invite new members to.
    team-ids: option<list<s32>>
  }
  orgs-create-invitation: func(params: orgs-create-invitation-params) -> result<string, string>;

  /// Cancel an organization invitation
  orgs-cancel-invitation: func() -> result<string, string>;

  /// List organization invitation teams
  orgs-list-invitation-teams: func() -> result<string, string>;

  /// List organization members
  record orgs-list-members-params {
    /// Filter members returned in the list. `2fa_disabled` means that only members without [two-factor authentication](https://github.com/blog/1614-two-factor-authentication) enabled will be returned. This options is only available for organization owners.
    filter: option<orgs-list-members-filter-enum>,
    /// Filter members returned by their role.
    role: option<orgs-list-members-role-enum>
  }
  orgs-list-members: func(params: orgs-list-members-params) -> result<string, string>;

  /// Check organization membership for a user
  orgs-check-membership-for-user: func() -> result<string, string>;

  /// Remove an organization member
  orgs-remove-member: func() -> result<string, string>;

  /// Get organization membership for a user
  orgs-get-membership-for-user: func() -> result<string, string>;

  /// Set organization membership for a user
  record orgs-set-membership-for-user-params {
    /// The role to give the user in the organization. Can be one of:  
    ///  * `admin` - The user will become an owner of the organization.  
    role: option<orgs-set-membership-for-user-body-role-enum>
  }
  orgs-set-membership-for-user: func(params: orgs-set-membership-for-user-params) -> result<string, string>;

  /// Remove organization membership for a user
  orgs-remove-membership-for-user: func() -> result<string, string>;

  /// List outside collaborators for an organization
  record orgs-list-outside-collaborators-params {
    /// Filter the list of outside collaborators. `2fa_disabled` means that only outside collaborators without [two-factor authentication](https://github.com/blog/1614-two-factor-authentication) enabled will be returned.
    filter: option<orgs-list-members-filter-enum>
  }
  orgs-list-outside-collaborators: func(params: orgs-list-outside-collaborators-params) -> result<string, string>;

  /// Convert an organization member to outside collaborator
  record orgs-convert-member-to-outside-collaborator-params {
    /// When set to `true`, the request will be performed asynchronously. Returns a 202 status code when the job is successfully queued.
    async-op: option<bool>
  }
  orgs-convert-member-to-outside-collaborator: func(params: orgs-convert-member-to-outside-collaborator-params) -> result<string, string>;

  /// Remove outside collaborator from an organization
  orgs-remove-outside-collaborator: func() -> result<string, string>;

  /// List public organization members
  orgs-list-public-members: func() -> result<string, string>;

  /// Check public organization membership for a user
  orgs-check-public-membership-for-user: func() -> result<string, string>;

  /// Set public organization membership for the authenticated user
  orgs-set-public-membership-for-authenticated-user: func() -> result<string, string>;

  /// Remove public organization membership for the authenticated user
  orgs-remove-public-membership-for-authenticated-user: func() -> result<string, string>;

  /// List security manager teams
  orgs-list-security-manager-teams: func() -> result<string, string>;

  /// Add a security manager team
  orgs-add-security-manager-team: func() -> result<string, string>;

  /// Remove a security manager team
  orgs-remove-security-manager-team: func() -> result<string, string>;

  /// Enable or disable a security feature for an organization
  orgs-enable-or-disable-security-product-on-all-org-repos: func() -> result<string, string>;

  /// List organization memberships for the authenticated user
  record orgs-list-memberships-for-authenticated-user-params {
    /// Indicates the state of the memberships to return. If not specified, the API returns both active and pending memberships.
    state: option<orgs-list-memberships-for-authenticated-user-state-enum>
  }
  orgs-list-memberships-for-authenticated-user: func(params: orgs-list-memberships-for-authenticated-user-params) -> result<string, string>;

  /// Get an organization membership for the authenticated user
  orgs-get-membership-for-authenticated-user: func() -> result<string, string>;

  /// Update an organization membership for the authenticated user
  record orgs-update-membership-for-authenticated-user-params {
    /// The state that the membership should be in. Only `"active"` will be accepted.
    state: orgs-update-membership-for-authenticated-user-body-state-enum
  }
  orgs-update-membership-for-authenticated-user: func(params: orgs-update-membership-for-authenticated-user-params) -> result<string, string>;

  /// List organizations for the authenticated user
  orgs-list-for-authenticated-user: func() -> result<string, string>;

  /// List organizations for a user
  orgs-list-for-user: func() -> result<string, string>;

}

interface actions {
  enum actions-create-required-workflow-body-scope-enum {
    selected,
    all,
  }

  enum actions-create-or-update-org-secret-body-visibility-enum {
    all,
    private,
    selected,
  }

  enum actions-workflow-access-to-repository-access-level-enum {
    none,
    user,
    organization,
  }

  enum actions-list-jobs-for-workflow-run-filter-enum {
    latest,
    all,
  }

  enum actions-review-pending-deployments-for-run-body-state-enum {
    approved,
    rejected,
  }

  /// The permissions policy that controls the actions and reusable workflows that are allowed to run.
  record allowed-actions {
    /// opaque schema; raw JSON
    value: string
  }

  /// The policy that controls the repositories in the organization that are allowed to run GitHub Actions.
  record enabled-repositories {
    /// opaque schema; raw JSON
    value: string
  }

  /// Whether GitHub Actions can approve pull requests. Enabling this can be a security risk.
  record actions-can-approve-pull-request-reviews {
    /// opaque schema; raw JSON
    value: string
  }

  /// The default workflow permissions granted to the GITHUB_TOKEN when running workflows.
  record actions-default-workflow-permissions {
    /// opaque schema; raw JSON
    value: string
  }

  /// Whether GitHub Actions is enabled on the repository.
  record actions-enabled {
    /// opaque schema; raw JSON
    value: string
  }

  /// Input keys and values configured in the workflow file. The maximum number of properties is 10. Any default properties configured in the workflow file will be used when `inputs` are omitted.
  record actions-create-workflow-dispatch-body-inputs {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Get GitHub Actions cache usage for an organization
  actions-get-actions-cache-usage-for-org: func() -> result<string, string>;

  /// List repositories with GitHub Actions cache usage for an organization
  actions-get-actions-cache-usage-by-repo-for-org: func() -> result<string, string>;

  /// Get GitHub Actions permissions for an organization
  actions-get-github-actions-permissions-organization: func() -> result<string, string>;

  /// Set GitHub Actions permissions for an organization
  record actions-set-github-actions-permissions-organization-params {
    allowed-actions: option<allowed-actions>,
    enabled-repositories: enabled-repositories
  }
  actions-set-github-actions-permissions-organization: func(params: actions-set-github-actions-permissions-organization-params) -> result<string, string>;

  /// List selected repositories enabled for GitHub Actions in an organization
  actions-list-selected-repositories-enabled-github-actions-organization: func() -> result<string, string>;

  /// Set selected repositories enabled for GitHub Actions in an organization
  record actions-set-selected-repositories-enabled-github-actions-organization-params {
    /// List of repository IDs to enable for GitHub Actions.
    selected-repository-ids: list<s32>
  }
  actions-set-selected-repositories-enabled-github-actions-organization: func(params: actions-set-selected-repositories-enabled-github-actions-organization-params) -> result<string, string>;

  /// Enable a selected repository for GitHub Actions in an organization
  actions-enable-selected-repository-github-actions-organization: func() -> result<string, string>;

  /// Disable a selected repository for GitHub Actions in an organization
  actions-disable-selected-repository-github-actions-organization: func() -> result<string, string>;

  /// Get allowed actions and reusable workflows for an organization
  actions-get-allowed-actions-organization: func() -> result<string, string>;

  /// Set allowed actions and reusable workflows for an organization
  record actions-set-allowed-actions-organization-params {
    /// Whether GitHub-owned actions are allowed. For example, this includes the actions in the `actions` organization.
    github-owned-allowed: option<bool>,
    /// Specifies a list of string-matching patterns to allow specific action(s) and reusable workflow(s). Wildcards, tags, and SHAs are allowed. For example, `monalisa/octocat@*`, `monalisa/octocat@v2`, `monalisa/*`.
    /// 
    patterns-allowed: option<list<string>>,
    /// Whether actions from GitHub Marketplace verified creators are allowed. Set to `true` to allow all actions by GitHub Marketplace verified creators.
    verified-allowed: option<bool>
  }
  actions-set-allowed-actions-organization: func(params: actions-set-allowed-actions-organization-params) -> result<string, string>;

  /// Get default workflow permissions for an organization
  actions-get-github-actions-default-workflow-permissions-organization: func() -> result<string, string>;

  /// Set default workflow permissions for an organization
  record actions-set-github-actions-default-workflow-permissions-organization-params {
    can-approve-pull-request-reviews: option<actions-can-approve-pull-request-reviews>,
    default-workflow-permissions: option<actions-default-workflow-permissions>
  }
  actions-set-github-actions-default-workflow-permissions-organization: func(params: actions-set-github-actions-default-workflow-permissions-organization-params) -> result<string, string>;

  /// List required workflows
  actions-list-required-workflows: func() -> result<string, string>;

  /// Create a required workflow
  record actions-create-required-workflow-params {
    /// The ID of the repository that contains the workflow file.
    repository-id: string,
    /// Enable the required workflow for all repositories or selected repositories in the organization.
    scope: option<actions-create-required-workflow-body-scope-enum>,
    /// A list of repository IDs where you want to enable the required workflow. You can only provide a list of repository ids when the `scope` is set to `selected`.
    selected-repository-ids: option<list<s32>>,
    /// Path of the workflow file to be configured as a required workflow.
    workflow-file-path: string
  }
  actions-create-required-workflow: func(params: actions-create-required-workflow-params) -> result<string, string>;

  /// Get a required workflow
  actions-get-required-workflow: func() -> result<string, string>;

  /// Update a required workflow
  record actions-update-required-workflow-params {
    /// The ID of the repository that contains the workflow file.
    repository-id: option<string>,
    /// Enable the required workflow for all repositories or selected repositories in the organization.
    scope: option<actions-create-required-workflow-body-scope-enum>,
    /// A list of repository IDs where you want to enable the required workflow. A list of repository IDs where you want to enable the required workflow. You can only provide a list of repository ids when the `scope` is set to `selected`.
    selected-repository-ids: option<list<s32>>,
    /// Path of the workflow file to be configured as a required workflow.
    workflow-file-path: option<string>
  }
  actions-update-required-workflow: func(params: actions-update-required-workflow-params) -> result<string, string>;

  /// Delete a required workflow
  actions-delete-required-workflow: func() -> result<string, string>;

  /// List selected repositories for a required workflow
  actions-list-selected-repositories-required-workflow: func() -> result<string, string>;

  /// Sets repositories for a required workflow
  record actions-set-selected-repos-to-required-workflow-params {
    /// The IDs of the repositories for which the workflow should be required.
    selected-repository-ids: list<s32>
  }
  actions-set-selected-repos-to-required-workflow: func(params: actions-set-selected-repos-to-required-workflow-params) -> result<string, string>;

  /// Add a repository to a required workflow
  actions-add-selected-repo-to-required-workflow: func() -> result<string, string>;

  /// Remove a selected repository from required workflow
  actions-remove-selected-repo-from-required-workflow: func() -> result<string, string>;

  /// List self-hosted runners for an organization
  actions-list-self-hosted-runners-for-org: func() -> result<string, string>;

  /// List runner applications for an organization
  actions-list-runner-applications-for-org: func() -> result<string, string>;

  /// Create a registration token for an organization
  actions-create-registration-token-for-org: func() -> result<string, string>;

  /// Create a remove token for an organization
  actions-create-remove-token-for-org: func() -> result<string, string>;

  /// Get a self-hosted runner for an organization
  actions-get-self-hosted-runner-for-org: func() -> result<string, string>;

  /// Delete a self-hosted runner from an organization
  actions-delete-self-hosted-runner-from-org: func() -> result<string, string>;

  /// List labels for a self-hosted runner for an organization
  actions-list-labels-for-self-hosted-runner-for-org: func() -> result<string, string>;

  /// Add custom labels to a self-hosted runner for an organization
  record actions-add-custom-labels-to-self-hosted-runner-for-org-params {
    /// The names of the custom labels to add to the runner.
    labels: list<string>
  }
  actions-add-custom-labels-to-self-hosted-runner-for-org: func(params: actions-add-custom-labels-to-self-hosted-runner-for-org-params) -> result<string, string>;

  /// Set custom labels for a self-hosted runner for an organization
  record actions-set-custom-labels-for-self-hosted-runner-for-org-params {
    /// The names of the custom labels to set for the runner. You can pass an empty array to remove all custom labels.
    labels: list<string>
  }
  actions-set-custom-labels-for-self-hosted-runner-for-org: func(params: actions-set-custom-labels-for-self-hosted-runner-for-org-params) -> result<string, string>;

  /// Remove all custom labels from a self-hosted runner for an organization
  actions-remove-all-custom-labels-from-self-hosted-runner-for-org: func() -> result<string, string>;

  /// Remove a custom label from a self-hosted runner for an organization
  actions-remove-custom-label-from-self-hosted-runner-for-org: func() -> result<string, string>;

  /// List organization secrets
  actions-list-org-secrets: func() -> result<string, string>;

  /// Get an organization public key
  actions-get-org-public-key: func() -> result<string, string>;

  /// Get an organization secret
  actions-get-org-secret: func() -> result<string, string>;

  /// Create or update an organization secret
  record actions-create-or-update-org-secret-params {
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an organization public key](https://docs.github.com/rest/reference/actions#get-an-organization-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>,
    /// An array of repository ids that can access the organization secret. You can only provide a list of repository ids when the `visibility` is set to `selected`. You can manage the list of selected repositories using the [List selected repositories for an organization secret](https://docs.github.com/rest/reference/actions#list-selected-repositories-for-an-organization-secret), [Set selected repositories for an organization secret](https://docs.github.com/rest/reference/actions#set-selected-repositories-for-an-organization-secret), and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/actions#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: option<list<s32>>,
    /// Which type of organization repositories have access to the organization secret. `selected` means only the repositories specified by `selected_repository_ids` can access the secret.
    visibility: actions-create-or-update-org-secret-body-visibility-enum
  }
  actions-create-or-update-org-secret: func(params: actions-create-or-update-org-secret-params) -> result<string, string>;

  /// Delete an organization secret
  actions-delete-org-secret: func() -> result<string, string>;

  /// List selected repositories for an organization secret
  actions-list-selected-repos-for-org-secret: func() -> result<string, string>;

  /// Set selected repositories for an organization secret
  record actions-set-selected-repos-for-org-secret-params {
    /// An array of repository ids that can access the organization secret. You can only provide a list of repository ids when the `visibility` is set to `selected`. You can add and remove individual repositories using the [Add selected repository to an organization secret](https://docs.github.com/rest/actions/secrets#add-selected-repository-to-an-organization-secret) and [Remove selected repository from an organization secret](https://docs.github.com/rest/reference/actions#remove-selected-repository-from-an-organization-secret) endpoints.
    selected-repository-ids: list<s32>
  }
  actions-set-selected-repos-for-org-secret: func(params: actions-set-selected-repos-for-org-secret-params) -> result<string, string>;

  /// Add selected repository to an organization secret
  record actions-add-selected-repo-to-org-secret-params {
    repository-id: string
  }
  actions-add-selected-repo-to-org-secret: func(params: actions-add-selected-repo-to-org-secret-params) -> result<string, string>;

  /// Remove selected repository from an organization secret
  record actions-remove-selected-repo-from-org-secret-params {
    repository-id: string
  }
  actions-remove-selected-repo-from-org-secret: func(params: actions-remove-selected-repo-from-org-secret-params) -> result<string, string>;

  /// List organization variables
  actions-list-org-variables: func() -> result<string, string>;

  /// Create an organization variable
  record actions-create-org-variable-params {
    /// The name of the variable.
    name: string,
    /// An array of repository ids that can access the organization variable. You can only provide a list of repository ids when the `visibility` is set to `selected`.
    selected-repository-ids: option<list<s32>>,
    /// The value of the variable.
    value: string,
    /// The type of repositories in the organization that can access the variable. `selected` means only the repositories specified by `selected_repository_ids` can access the variable.
    visibility: actions-create-or-update-org-secret-body-visibility-enum
  }
  actions-create-org-variable: func(params: actions-create-org-variable-params) -> result<string, string>;

  /// Get an organization variable
  actions-get-org-variable: func() -> result<string, string>;

  /// Update an organization variable
  record actions-update-org-variable-params {
    /// The name of the variable.
    name: option<string>,
    /// An array of repository ids that can access the organization variable. You can only provide a list of repository ids when the `visibility` is set to `selected`.
    selected-repository-ids: option<list<s32>>,
    /// The value of the variable.
    value: option<string>,
    /// The type of repositories in the organization that can access the variable. `selected` means only the repositories specified by `selected_repository_ids` can access the variable.
    visibility: option<actions-create-or-update-org-secret-body-visibility-enum>
  }
  actions-update-org-variable: func(params: actions-update-org-variable-params) -> result<string, string>;

  /// Delete an organization variable
  actions-delete-org-variable: func() -> result<string, string>;

  /// List selected repositories for an organization variable
  actions-list-selected-repos-for-org-variable: func() -> result<string, string>;

  /// Set selected repositories for an organization variable
  record actions-set-selected-repos-for-org-variable-params {
    /// The IDs of the repositories that can access the organization variable.
    selected-repository-ids: list<s32>
  }
  actions-set-selected-repos-for-org-variable: func(params: actions-set-selected-repos-for-org-variable-params) -> result<string, string>;

  /// Add selected repository to an organization variable
  record actions-add-selected-repo-to-org-variable-params {
    repository-id: string
  }
  actions-add-selected-repo-to-org-variable: func(params: actions-add-selected-repo-to-org-variable-params) -> result<string, string>;

  /// Remove selected repository from an organization variable
  record actions-remove-selected-repo-from-org-variable-params {
    repository-id: string
  }
  actions-remove-selected-repo-from-org-variable: func(params: actions-remove-selected-repo-from-org-variable-params) -> result<string, string>;

  /// List repository required workflows
  actions-list-repo-required-workflows: func() -> result<string, string>;

  /// Get a required workflow entity for a repository
  actions-get-repo-required-workflow: func() -> result<string, string>;

  /// Get required workflow usage
  actions-get-repo-required-workflow-usage: func() -> result<string, string>;

  /// List artifacts for a repository
  record actions-list-artifacts-for-repo-params {
    /// Filters artifacts by exact match on their name field.
    name: option<string>
  }
  actions-list-artifacts-for-repo: func(params: actions-list-artifacts-for-repo-params) -> result<string, string>;

  /// Get an artifact
  actions-get-artifact: func() -> result<string, string>;

  /// Delete an artifact
  actions-delete-artifact: func() -> result<string, string>;

  /// Download an artifact
  record actions-download-artifact-params {
    archive-format: string
  }
  actions-download-artifact: func(params: actions-download-artifact-params) -> result<string, string>;

  /// Get GitHub Actions cache usage for a repository
  actions-get-actions-cache-usage: func() -> result<string, string>;

  /// List GitHub Actions caches for a repository
  actions-get-actions-cache-list: func() -> result<string, string>;

  /// Delete GitHub Actions caches for a repository (using a cache key)
  actions-delete-actions-cache-by-key: func() -> result<string, string>;

  /// Delete a GitHub Actions cache for a repository (using a cache ID)
  actions-delete-actions-cache-by-id: func() -> result<string, string>;

  /// Get a job for a workflow run
  actions-get-job-for-workflow-run: func() -> result<string, string>;

  /// Download job logs for a workflow run
  actions-download-job-logs-for-workflow-run: func() -> result<string, string>;

  /// Re-run a job from a workflow run
  record actions-re-run-job-for-workflow-run-params {
    /// Whether to enable debug logging for the re-run.
    enable-debug-logging: option<bool>
  }
  actions-re-run-job-for-workflow-run: func(params: actions-re-run-job-for-workflow-run-params) -> result<string, string>;

  /// Get the customization template for an OIDC subject claim for a repository
  actions-get-custom-oidc-sub-claim-for-repo: func() -> result<string, string>;

  /// Set the customization template for an OIDC subject claim for a repository
  record actions-set-custom-oidc-sub-claim-for-repo-params {
    /// Array of unique strings. Each claim key can only contain alphanumeric characters and underscores.
    include-claim-keys: option<list<string>>,
    /// Whether to use the default template or not. If `true`, the `include_claim_keys` field is ignored.
    use-default: bool
  }
  actions-set-custom-oidc-sub-claim-for-repo: func(params: actions-set-custom-oidc-sub-claim-for-repo-params) -> result<string, string>;

  /// Get GitHub Actions permissions for a repository
  actions-get-github-actions-permissions-repository: func() -> result<string, string>;

  /// Set GitHub Actions permissions for a repository
  record actions-set-github-actions-permissions-repository-params {
    allowed-actions: option<allowed-actions>,
    enabled: actions-enabled
  }
  actions-set-github-actions-permissions-repository: func(params: actions-set-github-actions-permissions-repository-params) -> result<string, string>;

  /// Get the level of access for workflows outside of the repository
  actions-get-workflow-access-to-repository: func() -> result<string, string>;

  /// Set the level of access for workflows outside of the repository
  record actions-set-workflow-access-to-repository-params {
    /// Defines the level of access that workflows outside of the repository have to actions and reusable workflows within the
    /// repository.
    access-level: actions-workflow-access-to-repository-access-level-enum
  }
  actions-set-workflow-access-to-repository: func(params: actions-set-workflow-access-to-repository-params) -> result<string, string>;

  /// Get allowed actions and reusable workflows for a repository
  actions-get-allowed-actions-repository: func() -> result<string, string>;

  /// Set allowed actions and reusable workflows for a repository
  record actions-set-allowed-actions-repository-params {
    /// Whether GitHub-owned actions are allowed. For example, this includes the actions in the `actions` organization.
    github-owned-allowed: option<bool>,
    /// Specifies a list of string-matching patterns to allow specific action(s) and reusable workflow(s). Wildcards, tags, and SHAs are allowed. For example, `monalisa/octocat@*`, `monalisa/octocat@v2`, `monalisa/*`.
    /// 
    patterns-allowed: option<list<string>>,
    /// Whether actions from GitHub Marketplace verified creators are allowed. Set to `true` to allow all actions by GitHub Marketplace verified creators.
    verified-allowed: option<bool>
  }
  actions-set-allowed-actions-repository: func(params: actions-set-allowed-actions-repository-params) -> result<string, string>;

  /// Get default workflow permissions for a repository
  actions-get-github-actions-default-workflow-permissions-repository: func() -> result<string, string>;

  /// Set default workflow permissions for a repository
  record actions-set-github-actions-default-workflow-permissions-repository-params {
    can-approve-pull-request-reviews: option<actions-can-approve-pull-request-reviews>,
    default-workflow-permissions: option<actions-default-workflow-permissions>
  }
  actions-set-github-actions-default-workflow-permissions-repository: func(params: actions-set-github-actions-default-workflow-permissions-repository-params) -> result<string, string>;

  /// List workflow runs for a required workflow
  actions-list-required-workflow-runs: func() -> result<string, string>;

  /// List self-hosted runners for a repository
  actions-list-self-hosted-runners-for-repo: func() -> result<string, string>;

  /// List runner applications for a repository
  actions-list-runner-applications-for-repo: func() -> result<string, string>;

  /// Create a registration token for a repository
  actions-create-registration-token-for-repo: func() -> result<string, string>;

  /// Create a remove token for a repository
  actions-create-remove-token-for-repo: func() -> result<string, string>;

  /// Get a self-hosted runner for a repository
  actions-get-self-hosted-runner-for-repo: func() -> result<string, string>;

  /// Delete a self-hosted runner from a repository
  actions-delete-self-hosted-runner-from-repo: func() -> result<string, string>;

  /// List labels for a self-hosted runner for a repository
  actions-list-labels-for-self-hosted-runner-for-repo: func() -> result<string, string>;

  /// Add custom labels to a self-hosted runner for a repository
  record actions-add-custom-labels-to-self-hosted-runner-for-repo-params {
    /// The names of the custom labels to add to the runner.
    labels: list<string>
  }
  actions-add-custom-labels-to-self-hosted-runner-for-repo: func(params: actions-add-custom-labels-to-self-hosted-runner-for-repo-params) -> result<string, string>;

  /// Set custom labels for a self-hosted runner for a repository
  record actions-set-custom-labels-for-self-hosted-runner-for-repo-params {
    /// The names of the custom labels to set for the runner. You can pass an empty array to remove all custom labels.
    labels: list<string>
  }
  actions-set-custom-labels-for-self-hosted-runner-for-repo: func(params: actions-set-custom-labels-for-self-hosted-runner-for-repo-params) -> result<string, string>;

  /// Remove all custom labels from a self-hosted runner for a repository
  actions-remove-all-custom-labels-from-self-hosted-runner-for-repo: func() -> result<string, string>;

  /// Remove a custom label from a self-hosted runner for a repository
  actions-remove-custom-label-from-self-hosted-runner-for-repo: func() -> result<string, string>;

  /// List workflow runs for a repository
  actions-list-workflow-runs-for-repo: func() -> result<string, string>;

  /// Get a workflow run
  actions-get-workflow-run: func() -> result<string, string>;

  /// Delete a workflow run
  actions-delete-workflow-run: func() -> result<string, string>;

  /// Get the review history for a workflow run
  actions-get-reviews-for-run: func() -> result<string, string>;

  /// Approve a workflow run for a fork pull request
  actions-approve-workflow-run: func() -> result<string, string>;

  /// List workflow run artifacts
  actions-list-workflow-run-artifacts: func() -> result<string, string>;

  /// Get a workflow run attempt
  actions-get-workflow-run-attempt: func() -> result<string, string>;

  /// List jobs for a workflow run attempt
  actions-list-jobs-for-workflow-run-attempt: func() -> result<string, string>;

  /// Download workflow run attempt logs
  actions-download-workflow-run-attempt-logs: func() -> result<string, string>;

  /// Cancel a workflow run
  actions-cancel-workflow-run: func() -> result<string, string>;

  /// List jobs for a workflow run
  record actions-list-jobs-for-workflow-run-params {
    /// Filters jobs by their `completed_at` timestamp. `latest` returns jobs from the most recent execution of the workflow run. `all` returns all jobs for a workflow run, including from old executions of the workflow run.
    filter: option<actions-list-jobs-for-workflow-run-filter-enum>
  }
  actions-list-jobs-for-workflow-run: func(params: actions-list-jobs-for-workflow-run-params) -> result<string, string>;

  /// Download workflow run logs
  actions-download-workflow-run-logs: func() -> result<string, string>;

  /// Delete workflow run logs
  actions-delete-workflow-run-logs: func() -> result<string, string>;

  /// Get pending deployments for a workflow run
  actions-get-pending-deployments-for-run: func() -> result<string, string>;

  /// Review pending deployments for a workflow run
  record actions-review-pending-deployments-for-run-params {
    /// A comment to accompany the deployment review
    comment: string,
    /// The list of environment ids to approve or reject
    environment-ids: list<s32>,
    /// Whether to approve or reject deployment to the specified environments.
    state: actions-review-pending-deployments-for-run-body-state-enum
  }
  actions-review-pending-deployments-for-run: func(params: actions-review-pending-deployments-for-run-params) -> result<string, string>;

  /// Re-run a workflow
  record actions-re-run-workflow-params {
    /// Whether to enable debug logging for the re-run.
    enable-debug-logging: option<bool>
  }
  actions-re-run-workflow: func(params: actions-re-run-workflow-params) -> result<string, string>;

  /// Re-run failed jobs from a workflow run
  record actions-re-run-workflow-failed-jobs-params {
    /// Whether to enable debug logging for the re-run.
    enable-debug-logging: option<bool>
  }
  actions-re-run-workflow-failed-jobs: func(params: actions-re-run-workflow-failed-jobs-params) -> result<string, string>;

  /// Get workflow run usage
  actions-get-workflow-run-usage: func() -> result<string, string>;

  /// List repository secrets
  actions-list-repo-secrets: func() -> result<string, string>;

  /// Get a repository public key
  actions-get-repo-public-key: func() -> result<string, string>;

  /// Get a repository secret
  actions-get-repo-secret: func() -> result<string, string>;

  /// Create or update a repository secret
  record actions-create-or-update-repo-secret-params {
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get a repository public key](https://docs.github.com/rest/reference/actions#get-a-repository-public-key) endpoint.
    encrypted-value: option<string>,
    /// ID of the key you used to encrypt the secret.
    key-id: option<string>
  }
  actions-create-or-update-repo-secret: func(params: actions-create-or-update-repo-secret-params) -> result<string, string>;

  /// Delete a repository secret
  actions-delete-repo-secret: func() -> result<string, string>;

  /// List repository variables
  actions-list-repo-variables: func() -> result<string, string>;

  /// Create a repository variable
  record actions-create-repo-variable-params {
    /// The name of the variable.
    name: string,
    /// The value of the variable.
    value: string
  }
  actions-create-repo-variable: func(params: actions-create-repo-variable-params) -> result<string, string>;

  /// Get a repository variable
  actions-get-repo-variable: func() -> result<string, string>;

  /// Update a repository variable
  record actions-update-repo-variable-params {
    /// The name of the variable.
    name: option<string>,
    /// The value of the variable.
    value: option<string>
  }
  actions-update-repo-variable: func(params: actions-update-repo-variable-params) -> result<string, string>;

  /// Delete a repository variable
  actions-delete-repo-variable: func() -> result<string, string>;

  /// List repository workflows
  actions-list-repo-workflows: func() -> result<string, string>;

  /// Get a workflow
  actions-get-workflow: func() -> result<string, string>;

  /// Disable a workflow
  actions-disable-workflow: func() -> result<string, string>;

  /// Create a workflow dispatch event
  record actions-create-workflow-dispatch-params {
    /// Input keys and values configured in the workflow file. The maximum number of properties is 10. Any default properties configured in the workflow file will be used when `inputs` are omitted.
    inputs: option<actions-create-workflow-dispatch-body-inputs>,
    /// The git reference for the workflow. The reference can be a branch or tag name.
    ref: string
  }
  actions-create-workflow-dispatch: func(params: actions-create-workflow-dispatch-params) -> result<string, string>;

  /// Enable a workflow
  actions-enable-workflow: func() -> result<string, string>;

  /// List workflow runs for a workflow
  actions-list-workflow-runs: func() -> result<string, string>;

  /// Get workflow usage
  actions-get-workflow-usage: func() -> result<string, string>;

  /// List environment secrets
  actions-list-environment-secrets: func() -> result<string, string>;

  /// Get an environment public key
  actions-get-environment-public-key: func() -> result<string, string>;

  /// Get an environment secret
  actions-get-environment-secret: func() -> result<string, string>;

  /// Create or update an environment secret
  record actions-create-or-update-environment-secret-params {
    /// Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get an environment public key](https://docs.github.com/rest/reference/actions#get-an-environment-public-key) endpoint.
    encrypted-value: string,
    /// ID of the key you used to encrypt the secret.
    key-id: string
  }
  actions-create-or-update-environment-secret: func(params: actions-create-or-update-environment-secret-params) -> result<string, string>;

  /// Delete an environment secret
  actions-delete-environment-secret: func() -> result<string, string>;

  /// List environment variables
  actions-list-environment-variables: func() -> result<string, string>;

  /// Create an environment variable
  record actions-create-environment-variable-params {
    /// The name of the variable.
    name: string,
    /// The value of the variable.
    value: string
  }
  actions-create-environment-variable: func(params: actions-create-environment-variable-params) -> result<string, string>;

  /// Get an environment variable
  actions-get-environment-variable: func() -> result<string, string>;

  /// Update an environment variable
  record actions-update-environment-variable-params {
    /// The name of the variable.
    name: option<string>,
    /// The value of the variable.
    value: option<string>
  }
  actions-update-environment-variable: func(params: actions-update-environment-variable-params) -> result<string, string>;

  /// Delete an environment variable
  actions-delete-environment-variable: func() -> result<string, string>;

