interface teams {
  enum teams-create-body-permission-enum {
    pull,
    push,
  }

  enum teams-create-body-privacy-enum {
    secret,
    closed,
  }

  enum teams-update-in-org-body-permission-enum {
    pull,
    push,
    admin,
  }

  enum teams-list-members-in-org-role-enum {
    member,
    maintainer,
    all,
  }

  enum teams-add-or-update-membership-for-user-in-org-body-role-enum {
    member,
    maintainer,
  }

  enum teams-add-or-update-project-permissions-in-org-body-permission-enum {
    read,
    write,
    admin,
  }

  /// List teams
  teams-list: func() -> result<string, string>;

  /// Create a team
  record teams-create-params {
    /// The description of the team.
    description: option<string>,
    /// List GitHub IDs for organization members who will become team maintainers.
    maintainers: option<list<string>>,
    /// The name of the team.
    name: string,
    /// The ID of a team to set as the parent team.
    parent-team-id: option<s32>,
    /// **Deprecated**. The permission that new repositories will be added to the team with when none is specified.
    permission: option<teams-create-body-permission-enum>,
    /// The level of privacy this team should have. The options are:  
    /// **For a non-nested team:**  
    privacy: option<teams-create-body-privacy-enum>,
    /// The full name (e.g., "organization-name/repository-name") of repositories to add the team to.
    repo-names: option<list<string>>
  }
  teams-create: func(params: teams-create-params) -> result<string, string>;

  /// Get a team by name
  teams-get-by-name: func() -> result<string, string>;

  /// Update a team
  record teams-update-in-org-params {
    /// The description of the team.
    description: option<string>,
    /// The name of the team.
    name: option<string>,
    /// The ID of a team to set as the parent team.
    parent-team-id: option<s32>,
    /// **Deprecated**. The permission that new repositories will be added to the team with when none is specified.
    permission: option<teams-update-in-org-body-permission-enum>,
    /// The level of privacy this team should have. Editing teams without specifying this parameter leaves `privacy` intact. When a team is nested, the `privacy` for parent teams cannot be `secret`. The options are:  
    /// **For a non-nested team:**  
    privacy: option<teams-create-body-privacy-enum>
  }
  teams-update-in-org: func(params: teams-update-in-org-params) -> result<string, string>;

  /// Delete a team
  teams-delete-in-org: func() -> result<string, string>;

