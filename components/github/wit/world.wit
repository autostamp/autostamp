    service-unavailable(string),
    other(string)
  }

  variant set-lfs-preference-error {
    unprocessable-entity(string),
    service-unavailable(string),
    other(string)
  }

  variant list-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant start-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    unprocessable-entity(string),
    other(string)
  }

  variant get-status-for-authenticated-user-error {
    not-modified(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-archive-for-authenticated-user-error {
