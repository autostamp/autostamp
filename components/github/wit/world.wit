    x,
    docs,
  }

  enum content-file-type-op-enum {
    file,
  }

  enum release-asset-state-enum {
    uploaded,
    open,
  }

  enum create-release-body-make-latest-enum {
    true,
    false,
    legacy,
  }

  enum create-commit-status-body-state-enum {
    error,
    failure,
    pending,
    success,
  }

  enum get-clones-per-enum {
    day,
