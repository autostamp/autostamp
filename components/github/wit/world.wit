  /// Get a package for a user
  packages-get-package-for-user: func() -> result<string, string>;

  /// Delete a package for a user
  packages-delete-package-for-user: func() -> result<string, string>;

  /// Restore a package for a user
  record packages-restore-package-for-user-params {
    /// package token
    token: option<string>
  }
  packages-restore-package-for-user: func(params: packages-restore-package-for-user-params) -> result<string, string>;

  /// List package versions for a package owned by a user
  packages-get-all-package-versions-for-package-owned-by-user: func() -> result<string, string>;

  /// Get a package version for a user
  packages-get-package-version-for-user: func() -> result<string, string>;

  /// Delete package version for a user
  packages-delete-package-version-for-user: func() -> result<string, string>;

  /// Restore package version for a user
  packages-restore-package-version-for-user: func() -> result<string, string>;

}

interface projects {
  enum projects-list-for-org-state-enum {
    open,
    closed,
    all,
  }

  enum projects-list-cards-archived-state-enum {
    all,
    archived,
    not-archived,
  }

  enum projects-update-body-organization-permission-enum {
    read,
    write,
    admin,
    none,
  }

  enum projects-list-collaborators-affiliation-enum {
    outside,
    direct,
    all,
  }

  enum projects-add-collaborator-body-permission-enum {
    read,
    write,
    admin,
  }

  /// List organization projects
  record projects-list-for-org-params {
    /// Indicates the state of the projects to return.
    state: option<projects-list-for-org-state-enum>
  }
  projects-list-for-org: func(params: projects-list-for-org-params) -> result<string, string>;

  /// Create an organization project
  record projects-create-for-org-params {
    /// The description of the project.
    body: option<string>,
    /// The name of the project.
    name: string
  }
  projects-create-for-org: func(params: projects-create-for-org-params) -> result<string, string>;

  /// Get a project card
  projects-get-card: func() -> result<string, string>;

  /// Update an existing project card
  record projects-update-card-params {
    /// Whether or not the card is archived
    archived: option<bool>,
    /// The project card's note
    note: option<string>
  }
  projects-update-card: func(params: projects-update-card-params) -> result<string, string>;

  /// Delete a project card
  projects-delete-card: func() -> result<string, string>;

  /// Move a project card
  record projects-move-card-params {
    /// The unique identifier of the column the card should be moved to
    column-id: option<s32>,
    /// The position of the card in a column. Can be one of: `top`, `bottom`, or `after:<card_id>` to place after the specified card.
    position: string
  }
  projects-move-card: func(params: projects-move-card-params) -> result<string, string>;

  /// Get a project column
  projects-get-column: func() -> result<string, string>;

  /// Update an existing project column
  record projects-update-column-params {
    /// Name of the project column
    name: string
  }
  projects-update-column: func(params: projects-update-column-params) -> result<string, string>;

  /// Delete a project column
  projects-delete-column: func() -> result<string, string>;

  /// List project cards
  record projects-list-cards-params {
    /// Filters the project cards that are returned by the card's state.
    archived-state: option<projects-list-cards-archived-state-enum>
  }
  projects-list-cards: func(params: projects-list-cards-params) -> result<string, string>;

  /// Create a project card
  record projects-create-card-params {
    body: string
  }
  projects-create-card: func(params: projects-create-card-params) -> result<string, string>;

  /// Move a project column
  record projects-move-column-params {
    /// The position of the column in a project. Can be one of: `first`, `last`, or `after:<column_id>` to place after the specified column.
    position: string
  }
  projects-move-column: func(params: projects-move-column-params) -> result<string, string>;

  /// Get a project
  projects-get: func() -> result<string, string>;

  /// Update a project
  record projects-update-params {
    /// Body of the project
    body: option<string>,
    /// Name of the project
    name: option<string>,
    /// The baseline permission that all organization members have on this project
    organization-permission: option<projects-update-body-organization-permission-enum>,
    /// Whether or not this project can be seen by everyone.
    private: option<bool>,
    /// State of the project; either 'open' or 'closed'
    state: option<string>
  }
  projects-update: func(params: projects-update-params) -> result<string, string>;

  /// Delete a project
  projects-delete: func() -> result<string, string>;

  /// List project collaborators
  record projects-list-collaborators-params {
    /// Filters the collaborators by their affiliation. `outside` means outside collaborators of a project that are not a member of the project's organization. `direct` means collaborators with permissions to a project, regardless of organization membership status. `all` means all collaborators the authenticated user can see.
    affiliation: option<projects-list-collaborators-affiliation-enum>
  }
  projects-list-collaborators: func(params: projects-list-collaborators-params) -> result<string, string>;

  /// Add project collaborator
  record projects-add-collaborator-params {
    /// The permission to grant the collaborator.
    permission: option<projects-add-collaborator-body-permission-enum>
  }
  projects-add-collaborator: func(params: projects-add-collaborator-params) -> result<string, string>;

  /// Remove user as a collaborator
  projects-remove-collaborator: func() -> result<string, string>;

  /// Get project permission for a user
  projects-get-permission-for-user: func() -> result<string, string>;

  /// List project columns
  projects-list-columns: func() -> result<string, string>;

  /// Create a project column
  record projects-create-column-params {
    /// Name of the project column
    name: string
  }
  projects-create-column: func(params: projects-create-column-params) -> result<string, string>;

  /// List repository projects
  record projects-list-for-repo-params {
    /// Indicates the state of the projects to return.
    state: option<projects-list-for-org-state-enum>
  }
  projects-list-for-repo: func(params: projects-list-for-repo-params) -> result<string, string>;

  /// Create a repository project
  record projects-create-for-repo-params {
    /// The description of the project.
    body: option<string>,
    /// The name of the project.
    name: string
  }
  projects-create-for-repo: func(params: projects-create-for-repo-params) -> result<string, string>;

  /// Create a user project
  record projects-create-for-authenticated-user-params {
    /// Body of the project
    body: option<string>,
    /// Name of the project
    name: string
  }
  projects-create-for-authenticated-user: func(params: projects-create-for-authenticated-user-params) -> result<string, string>;

  /// List user projects
  record projects-list-for-user-params {
    /// Indicates the state of the projects to return.
    state: option<projects-list-for-org-state-enum>
  }
  projects-list-for-user: func(params: projects-list-for-user-params) -> result<string, string>;

}

