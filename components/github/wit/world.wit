  }
  packages-get-all-package-versions-for-package-owned-by-org: func(params: packages-get-all-package-versions-for-package-owned-by-org-params) -> result<string, string>;

  /// Get a package version for an organization
  packages-get-package-version-for-organization: func() -> result<string, string>;

  /// Delete package version for an organization
  packages-delete-package-version-for-org: func() -> result<string, string>;

  /// Restore package version for an organization
  packages-restore-package-version-for-org: func() -> result<string, string>;

  /// List packages for the authenticated user's namespace
  record packages-list-packages-for-authenticated-user-params {
    /// The type of supported package. Packages in GitHub's Gradle registry have the type `maven`. Docker images pushed to GitHub's Container registry (`ghcr.io`) have the type `container`. You can use the type `docker` to find images that were pushed to GitHub's Docker registry (`docker.pkg.github.com`), even if these have now been migrated to the Container registry.
    package-type: packages-list-packages-for-organization-package-type-enum
  }
  packages-list-packages-for-authenticated-user: func(params: packages-list-packages-for-authenticated-user-params) -> result<string, string>;

  /// Get a package for the authenticated user
  packages-get-package-for-authenticated-user: func() -> result<string, string>;

  /// Delete a package for the authenticated user
  packages-delete-package-for-authenticated-user: func() -> result<string, string>;

  /// Restore a package for the authenticated user
