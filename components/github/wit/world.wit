    /// Limit results to repositories of the specified type.
    type-op: option<repos-list-for-user-type-op-enum>,
    /// The property to sort the results by.
    sort: option<repos-list-for-org-sort-enum>,
    /// The order to sort by. Default: `asc` when using `full_name`, otherwise `desc`.
    direction: option<repos-list-for-org-direction-enum>
  }
  repos-list-for-user: func(params: repos-list-for-user-params) -> result<string, string>;

}

