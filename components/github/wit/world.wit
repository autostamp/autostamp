interface projects {
  enum list-for-org-state-enum {
    open,
    closed,
    all,
  }

  enum list-cards-archived-state-enum {
    all,
    archived,
    not-archived,
  }

  enum update-body-organization-permission-enum {
    read,
    write,
    admin,
    none,
  }

  enum list-collaborators-affiliation-enum {
    outside,
    direct,
    all,
  }

  enum add-collaborator-body-permission-enum {
    read,
    write,
    admin,
  }

  /// List organization projects
  record list-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Indicates the state of the projects to return.
    state: option<list-for-org-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-org: func(params: list-for-org-params) -> result<string, string>;

  /// Create an organization project
  record create-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The description of the project.
    body: option<string>,
    /// The name of the project.
    name: string
  }
  create-for-org: func(params: create-for-org-params) -> result<string, string>;

  /// Get a project card
  record get-card-params {
    /// The unique identifier of the card.
    card-id: string
  }
  get-card: func(params: get-card-params) -> result<string, string>;

  /// Update an existing project card
  record update-card-params {
    /// The unique identifier of the card.
    card-id: string,
    /// Whether or not the card is archived
    archived: option<bool>,
    /// The project card's note
    note: option<string>
  }
  update-card: func(params: update-card-params) -> result<string, string>;

  /// Delete a project card
  record delete-card-params {
    /// The unique identifier of the card.
    card-id: string
  }
  delete-card: func(params: delete-card-params) -> result<string, string>;

  /// Move a project card
  record move-card-params {
    /// The unique identifier of the card.
    card-id: string,
    /// The unique identifier of the column the card should be moved to
    column-id: option<s32>,
    /// The position of the card in a column. Can be one of: `top`, `bottom`, or `after:<card_id>` to place after the specified card.
    position: string
  }
  move-card: func(params: move-card-params) -> result<string, string>;

  /// Get a project column
  record get-column-params {
    /// The unique identifier of the column.
    column-id: string
  }
  get-column: func(params: get-column-params) -> result<string, string>;

  /// Update an existing project column
  record update-column-params {
    /// The unique identifier of the column.
    column-id: string,
    /// Name of the project column
    name: string
  }
  update-column: func(params: update-column-params) -> result<string, string>;

  /// Delete a project column
  record delete-column-params {
    /// The unique identifier of the column.
    column-id: string
  }
  delete-column: func(params: delete-column-params) -> result<string, string>;

  /// List project cards
  record list-cards-params {
    /// The unique identifier of the column.
    column-id: string,
    /// Filters the project cards that are returned by the card's state.
    archived-state: option<list-cards-archived-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-cards: func(params: list-cards-params) -> result<string, string>;

  /// Create a project card
  record create-card-params {
    /// The unique identifier of the column.
    column-id: string,
    body: string
  }
  create-card: func(params: create-card-params) -> result<string, string>;

  /// Move a project column
  record move-column-params {
    /// The unique identifier of the column.
    column-id: string,
    /// The position of the column in a project. Can be one of: `first`, `last`, or `after:<column_id>` to place after the specified column.
    position: string
  }
  move-column: func(params: move-column-params) -> result<string, string>;

  /// Get a project
  record get-params {
    /// The unique identifier of the project.
    project-id: string
  }
  get: func(params: get-params) -> result<string, string>;

  /// Update a project
  record update-params {
    /// The unique identifier of the project.
    project-id: string,
    /// Body of the project
    body: option<string>,
    /// Name of the project
    name: option<string>,
    /// The baseline permission that all organization members have on this project
    organization-permission: option<update-body-organization-permission-enum>,
    /// Whether or not this project can be seen by everyone.
    private: option<bool>,
    /// State of the project; either 'open' or 'closed'
    state: option<string>
  }
  update: func(params: update-params) -> result<string, string>;

  /// Delete a project
  record delete-params {
    /// The unique identifier of the project.
    project-id: string
  }
  delete: func(params: delete-params) -> result<string, string>;

  /// List project collaborators
  record list-collaborators-params {
    /// The unique identifier of the project.
    project-id: string,
    /// Filters the collaborators by their affiliation. `outside` means outside collaborators of a project that are not a member of the project's organization. `direct` means collaborators with permissions to a project, regardless of organization membership status. `all` means all collaborators the authenticated user can see.
    affiliation: option<list-collaborators-affiliation-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-collaborators: func(params: list-collaborators-params) -> result<string, string>;

  /// Add project collaborator
  record add-collaborator-params {
    /// The unique identifier of the project.
    project-id: string,
    /// The handle for the GitHub user account.
    username: string,
    /// The permission to grant the collaborator.
    permission: option<add-collaborator-body-permission-enum>
  }
  add-collaborator: func(params: add-collaborator-params) -> result<string, string>;

  /// Remove user as a collaborator
  record remove-collaborator-params {
    /// The unique identifier of the project.
    project-id: string,
    /// The handle for the GitHub user account.
    username: string
  }
  remove-collaborator: func(params: remove-collaborator-params) -> result<string, string>;

  /// Get project permission for a user
  record get-permission-for-user-params {
    /// The unique identifier of the project.
    project-id: string,
    /// The handle for the GitHub user account.
    username: string
  }
  get-permission-for-user: func(params: get-permission-for-user-params) -> result<string, string>;

  /// List project columns
  record list-columns-params {
    /// The unique identifier of the project.
    project-id: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-columns: func(params: list-columns-params) -> result<string, string>;

  /// Create a project column
  record create-column-params {
    /// The unique identifier of the project.
    project-id: string,
    /// Name of the project column
    name: string
  }
  create-column: func(params: create-column-params) -> result<string, string>;

  /// List repository projects
  record list-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// Indicates the state of the projects to return.
    state: option<list-for-org-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-repo: func(params: list-for-repo-params) -> result<string, string>;

  /// Create a repository project
  record create-for-repo-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The description of the project.
    body: option<string>,
    /// The name of the project.
    name: string
  }
  create-for-repo: func(params: create-for-repo-params) -> result<string, string>;

  /// Create a user project
  record create-for-authenticated-user-params {
    /// Body of the project
    body: option<string>,
    /// Name of the project
    name: string
  }
  create-for-authenticated-user: func(params: create-for-authenticated-user-params) -> result<string, string>;

  /// List user projects
  record list-for-user-params {
    /// The handle for the GitHub user account.
    username: string,
    /// Indicates the state of the projects to return.
    state: option<list-for-org-state-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-user: func(params: list-for-user-params) -> result<string, string>;

}

interface repos {
  enum list-for-org-type-op-enum {
    all,
    public,
    private,
    forks,
    sources,
    member,
  }

  enum list-for-org-sort-enum {
    created,
    updated,
    pushed,
    full-name,
  }

  enum list-for-org-direction-enum {
    asc,
    desc,
  }

  enum create-in-org-body-merge-commit-message-enum {
    pr-body,
    pr-title,
    blank,
  }

  enum create-in-org-body-merge-commit-title-enum {
    pr-title,
    merge-message,
  }

  enum create-in-org-body-squash-merge-commit-message-enum {
    pr-body,
    commit-messages,
    blank,
  }

  enum create-in-org-body-squash-merge-commit-title-enum {
    pr-title,
    commit-or-pr-title,
  }

  enum create-in-org-body-visibility-enum {
    public,
    private,
  }

  enum list-collaborators-affiliation-enum {
    outside,
    direct,
    all,
  }

  enum list-collaborators-permission-enum {
    pull,
    triage,
    push,
    maintain,
    admin,
  }

  enum create-deployment-status-body-environment-enum {
    production,
    staging,
    qa,
  }

  enum create-deployment-status-body-state-enum {
    error,
    failure,
    inactive,
    in-progress,
    queued,
    pending,
    success,
  }

  enum list-forks-sort-enum {
    newest,
    oldest,
    stargazers,
    watchers,
  }

  enum update-invitation-body-permissions-enum {
    read,
    write,
    maintain,
    triage,
    admin,
  }

  enum create-pages-site-body-build-type-enum {
    legacy,
    workflow,
  }

  enum create-pages-site-body-source-path-enum {
    x,
    docs,
  }

  enum create-release-body-make-latest-enum {
    true,
    false,
    legacy,
  }

  enum create-commit-status-body-state-enum {
    error,
    failure,
    pending,
    success,
  }

  enum get-clones-per-enum {
    day,
    week,
  }

  enum list-for-authenticated-user-visibility-enum {
    all,
    public,
    private,
  }

  enum list-for-authenticated-user-type-op-enum {
    all,
    owner,
    public,
    private,
    member,
  }

  enum list-for-user-type-op-enum {
    all,
    owner,
    member,
  }

  /// Specify which security and analysis features to enable or disable for the repository.
  /// 
  /// To use this parameter, you must have admin permissions for the repository or be an owner or security manager for the organization that owns the repository. For more information, see "[Managing security managers in your organization](https://docs.github.com/organizations/managing-peoples-access-to-your-organization-with-roles/managing-security-managers-in-your-organization)."
  /// 
  /// For example, to enable GitHub Advanced Security, use this data in the body of the `PATCH` request:
  /// `{ "security_and_analysis": {"advanced_security": { "status": "enabled" } } }`.
  /// 
  /// You can check which security and analysis features are currently enabled by using a `GET /repos/{owner}/{repo}` request.
  record update-body-security-and-analysis {
    /// Use the `status` property to enable or disable GitHub Advanced Security for this repository. For more information, see "[About GitHub Advanced Security](/github/getting-started-with-github/learning-about-github/about-github-advanced-security)."
    advanced-security: option<update-body-security-and-analysis-advanced-security>,
    /// Use the `status` property to enable or disable secret scanning for this repository. For more information, see "[About secret scanning](/code-security/secret-security/about-secret-scanning)."
    secret-scanning: option<update-body-security-and-analysis-secret-scanning>,
    /// Use the `status` property to enable or disable secret scanning push protection for this repository. For more information, see "[Protecting pushes with secret scanning](/code-security/secret-scanning/protecting-pushes-with-secret-scanning)."
    secret-scanning-push-protection: option<update-body-security-and-analysis-secret-scanning-push-protection>
  }

  /// Use the `status` property to enable or disable GitHub Advanced Security for this repository. For more information, see "[About GitHub Advanced Security](/github/getting-started-with-github/learning-about-github/about-github-advanced-security)."
  record update-body-security-and-analysis-advanced-security {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// Use the `status` property to enable or disable secret scanning for this repository. For more information, see "[About secret scanning](/code-security/secret-security/about-secret-scanning)."
  record update-body-security-and-analysis-secret-scanning {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// Use the `status` property to enable or disable secret scanning push protection for this repository. For more information, see "[Protecting pushes with secret scanning](/code-security/secret-scanning/protecting-pushes-with-secret-scanning)."
  record update-body-security-and-analysis-secret-scanning-push-protection {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// Require at least one approving review on a pull request, before merging. Set to `null` to disable.
  record update-branch-protection-body-required-pull-request-reviews {
    /// Allow specific users, teams, or apps to bypass pull request requirements.
    bypass-pull-request-allowances: option<update-branch-protection-body-required-pull-request-reviews-bypass-pull-request-allowances>,
    /// Set to `true` if you want to automatically dismiss approving reviews when someone pushes a new commit.
    dismiss-stale-reviews: option<bool>,
    /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
    dismissal-restrictions: option<update-branch-protection-body-required-pull-request-reviews-dismissal-restrictions>,
    /// Blocks merging pull requests until [code owners](https://docs.github.com/articles/about-code-owners/) review them.
    require-code-owner-reviews: option<bool>,
    /// Whether the most recent push must be approved by someone other than the person who pushed it. Default: `false`.
    require-last-push-approval: option<bool>,
    /// Specify the number of reviewers required to approve pull requests. Use a number between 1 and 6 or 0 to not require reviewers.
    required-approving-review-count: option<s32>
  }

  /// Allow specific users, teams, or apps to bypass pull request requirements.
  record update-branch-protection-body-required-pull-request-reviews-bypass-pull-request-allowances {
    /// The list of app `slug`s allowed to bypass pull request requirements.
    apps: option<list<string>>,
    /// The list of team `slug`s allowed to bypass pull request requirements.
    teams: option<list<string>>,
    /// The list of user `login`s allowed to bypass pull request requirements.
    users: option<list<string>>
  }

  /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
  record update-branch-protection-body-required-pull-request-reviews-dismissal-restrictions {
    /// The list of app `slug`s with dismissal access
    apps: option<list<string>>,
    /// The list of team `slug`s with dismissal access
    teams: option<list<string>>,
    /// The list of user `login`s with dismissal access
    users: option<list<string>>
  }

  /// Require status checks to pass before merging. Set to `null` to disable.
  record update-branch-protection-body-required-status-checks {
    /// The list of status checks to require in order to merge into this branch.
    checks: option<list<update-branch-protection-body-required-status-checks-checks-item>>,
    /// **Deprecated**: The list of status checks to require in order to merge into this branch. If any of these checks have recently been set by a particular GitHub App, they will be required to come from that app in future for the branch to merge. Use `checks` instead of `contexts` for more fine-grained control.
    contexts: list<string>,
    /// Require branches to be up to date before merging.
    strict: bool
  }

  record update-branch-protection-body-required-status-checks-checks-item {
    /// The ID of the GitHub App that must provide this check. Omit this field to automatically select the GitHub App that has recently provided this check, or any app if it was not set by a GitHub App. Pass -1 to explicitly allow any app to set the status.
    app-id: option<s32>,
    /// The name of the required check
    context: string
  }

  /// Restrict who can push to the protected branch. User, app, and team `restrictions` are only available for organization-owned repositories. Set to `null` to disable.
  record update-branch-protection-body-restrictions {
    /// The list of app `slug`s with push access
    apps: option<list<string>>,
    /// The list of team `slug`s with push access
    teams: list<string>,
    /// The list of user `login`s with push access
    users: list<string>
  }

  /// Allow specific users, teams, or apps to bypass pull request requirements.
  record update-pull-request-review-protection-body-bypass-pull-request-allowances {
    /// The list of app `slug`s allowed to bypass pull request requirements.
    apps: option<list<string>>,
    /// The list of team `slug`s allowed to bypass pull request requirements.
    teams: option<list<string>>,
    /// The list of user `login`s allowed to bypass pull request requirements.
    users: option<list<string>>
  }

  /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
  record update-pull-request-review-protection-body-dismissal-restrictions {
    /// The list of app `slug`s with dismissal access
    apps: option<list<string>>,
    /// The list of team `slug`s with dismissal access
    teams: option<list<string>>,
    /// The list of user `login`s with dismissal access
    users: option<list<string>>
  }

  record update-status-check-protection-body-checks-item {
    /// The ID of the GitHub App that must provide this check. Omit this field to automatically select the GitHub App that has recently provided this check, or any app if it was not set by a GitHub App. Pass -1 to explicitly allow any app to set the status.
    app-id: option<s32>,
    /// The name of the required check
    context: string
  }

  /// The author of the file. Default: The `committer` or the authenticated user if you omit `committer`.
  record create-or-update-file-contents-body-author {
    date: option<string>,
    /// The email of the author or committer of the commit. You'll receive a `422` status code if `email` is omitted.
    email: string,
    /// The name of the author or committer of the commit. You'll receive a `422` status code if `name` is omitted.
    name: string
  }

  /// The person that committed the file. Default: the authenticated user.
  record create-or-update-file-contents-body-committer {
    date: option<string>,
    /// The email of the author or committer of the commit. You'll receive a `422` status code if `email` is omitted.
    email: string,
    /// The name of the author or committer of the commit. You'll receive a `422` status code if `name` is omitted.
    name: string
  }

  /// object containing information about the author.
  record delete-file-body-author {
    /// The email of the author (or committer) of the commit
    email: option<string>,
    /// The name of the author (or committer) of the commit
    name: option<string>
  }

  /// object containing information about the committer.
  record delete-file-body-committer {
    /// The email of the author (or committer) of the commit
    email: option<string>,
    /// The name of the author (or committer) of the commit
    name: option<string>
  }

  /// JSON payload with extra information about the webhook event that your action or workflow may use. The maximum number of top-level properties is 10.
  record create-dispatch-event-body-client-payload {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The type of deployment branch policy for this environment. To allow all branches to deploy, set to `null`.
  record deployment-branch-policy-settings {
    /// Whether only branches that match the specified name patterns can deploy to this environment.  If `custom_branch_policies` is `true`, `protected_branches` must be `false`; if `custom_branch_policies` is `false`, `protected_branches` must be `true`.
    custom-branch-policies: bool,
    /// Whether only branches with branch protection rules can deploy to this environment. If `protected_branches` is `true`, `custom_branch_policies` must be `false`; if `protected_branches` is `false`, `custom_branch_policies` must be `true`.
    protected-branches: bool
  }

  record create-or-update-environment-body-reviewers-item {
    /// The id of the user or team who can review the deployment
    id: option<s32>,
    type-op: option<deployment-reviewer-type>
  }

  /// The type of reviewer.
  record deployment-reviewer-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// The amount of time to delay a job after the job is initially triggered. The time (in minutes) must be an integer between 0 and 43,200 (30 days).
  record wait-timer {
    /// opaque schema; raw JSON
    value: string
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/repos#create-hook-config-params).
  record create-webhook-body-config {
    content-type: option<webhook-config-content-type>,
    digest: option<string>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    secret: option<webhook-config-secret>,
    token: option<string>,
    url: option<webhook-config-url>
  }

  /// The media type used to serialize the payloads. Supported values include `json` and `form`. The default is `form`.
  record webhook-config-content-type {
    /// opaque schema; raw JSON
    value: string
  }

  record webhook-config-insecure-ssl {
    /// opaque schema; raw JSON
    value: string
  }

  /// If provided, the `secret` will be used as the `key` to generate the HMAC hex digest value for [delivery signature headers](https://docs.github.com/webhooks/event-payloads/#delivery-headers).
  record webhook-config-secret {
    /// opaque schema; raw JSON
    value: string
  }

  /// The URL to which the payloads will be delivered.
  record webhook-config-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/repos#create-hook-config-params).
  record update-webhook-body-config {
    address: option<string>,
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    room: option<string>,
    secret: option<webhook-config-secret>,
    url: webhook-config-url
  }

  /// The source branch and directory used to publish your Pages site.
  record create-pages-site-body-source {
    /// The repository branch used to publish your site's source files.
    branch: string,
    /// The repository directory that includes the source files for the Pages site. Allowed paths are `/` or `/docs`. Default: `/`
    path: option<create-pages-site-body-source-path-enum>
  }

  /// List organization repositories
  record list-for-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Specifies the types of repositories you want returned.
    type-op: option<list-for-org-type-op-enum>,
    /// The property to sort the results by.
    sort: option<list-for-org-sort-enum>,
    /// The order to sort by. Default: `asc` when using `full_name`, otherwise `desc`.
    direction: option<list-for-org-direction-enum>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-for-org: func(params: list-for-org-params) -> result<string, string>;

  /// Create an organization repository
  record create-in-org-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// Either `true` to allow auto-merge on pull requests, or `false` to disallow auto-merge.
    allow-auto-merge: option<bool>,
    /// Either `true` to allow merging pull requests with a merge commit, or `false` to prevent merging pull requests with merge commits.
    allow-merge-commit: option<bool>,
    /// Either `true` to allow rebase-merging pull requests, or `false` to prevent rebase-merging.
    allow-rebase-merge: option<bool>,
    /// Either `true` to allow squash-merging pull requests, or `false` to prevent squash-merging.
    allow-squash-merge: option<bool>,
    /// Pass `true` to create an initial commit with empty README.
    auto-init: option<bool>,
    /// Either `true` to allow automatically deleting head branches when pull requests are merged, or `false` to prevent automatic deletion. **The authenticated user must be an organization owner to set this property to `true`.**
    delete-branch-on-merge: option<bool>,
    /// A short description of the repository.
    description: option<string>,
    /// Desired language or platform [.gitignore template](https://github.com/github/gitignore) to apply. Use the name of the template without the extension. For example, "Haskell".
    gitignore-template: option<string>,
    /// Whether downloads are enabled.
    has-downloads: option<bool>,
    /// Either `true` to enable issues for this repository or `false` to disable them.
    has-issues: option<bool>,
    /// Either `true` to enable projects for this repository or `false` to disable them. **Note:** If you're creating a repository in an organization that has disabled repository projects, the default is `false`, and if you pass `true`, the API returns an error.
    has-projects: option<bool>,
    /// Either `true` to enable the wiki for this repository or `false` to disable it.
    has-wiki: option<bool>,
    /// A URL with more information about the repository.
    homepage: option<string>,
    /// Either `true` to make this repo available as a template repository or `false` to prevent it.
    is-template: option<bool>,
    /// Choose an [open source license template](https://choosealicense.com/) that best suits your needs, and then use the [license keyword](https://docs.github.com/articles/licensing-a-repository/#searching-github-by-license-type) as the `license_template` string. For example, "mit" or "mpl-2.0".
    license-template: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<create-in-org-body-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<create-in-org-body-merge-commit-title-enum>,
    /// The name of the repository.
    name: string,
    /// Whether the repository is private.
