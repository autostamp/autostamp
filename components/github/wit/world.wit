  }
  list-public-events-for-repo-network: func(params: list-public-events-for-repo-network-params) -> result<string, string>;

  /// List notifications for the authenticated user
  record list-notifications-for-authenticated-user-params {
    /// If `true`, show notifications marked as read.
    all: option<bool>,
    /// If `true`, only shows notifications in which the user is directly participating or mentioned.
    participating: option<bool>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// Only show notifications updated before the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    before: option<string>,
    /// Page number of the results to fetch.
    page: option<s32>,
    /// The number of results per page (max 50).
    per-page: option<s32>
  }
  list-notifications-for-authenticated-user: func(params: list-notifications-for-authenticated-user-params) -> result<string, string>;

  /// Mark notifications as read
  record mark-notifications-as-read-params {
    /// Describes the last point that notifications were checked. Anything updated since this time will not be marked as read. If you omit this parameter, all notifications are marked as read. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. Default: The current timestamp.
    last-read-at: option<string>,
    /// Whether the notification has been read.
    read: option<bool>
  }
  mark-notifications-as-read: func(params: mark-notifications-as-read-params) -> result<string, string>;

  /// Get a thread
  record get-thread-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string
  }
  get-thread: func(params: get-thread-params) -> result<string, string>;

  /// Mark a thread as read
  record mark-thread-as-read-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string
  }
  mark-thread-as-read: func(params: mark-thread-as-read-params) -> result<string, string>;

  /// Get a thread subscription for the authenticated user
  record get-thread-subscription-for-authenticated-user-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string
  }
  get-thread-subscription-for-authenticated-user: func(params: get-thread-subscription-for-authenticated-user-params) -> result<string, string>;

  /// Set a thread subscription
  record set-thread-subscription-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string,
    /// Whether to block all notifications from a thread.
    ignored: option<bool>
  }
  set-thread-subscription: func(params: set-thread-subscription-params) -> result<string, string>;

  /// Delete a thread subscription
  record delete-thread-subscription-params {
    /// The unique identifier of the notification thread. This corresponds to the value returned in the `id` field when you retrieve notifications (for example with the [`GET /notifications` operation](https://docs.github.com/rest/reference/activity#list-notifications-for-the-authenticated-user)).
    thread-id: string
  }
  delete-thread-subscription: func(params: delete-thread-subscription-params) -> result<string, string>;

  /// List public organization events
  record list-public-org-events-params {
    /// The organization name. The name is not case sensitive.
    org: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-public-org-events: func(params: list-public-org-events-params) -> result<string, string>;

  /// List repository events
  record list-repo-events-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repo-events: func(params: list-repo-events-params) -> result<string, string>;

  /// List repository notifications for the authenticated user
  record list-repo-notifications-for-authenticated-user-params {
    /// The account owner of the repository. The name is not case sensitive.
    owner: string,
    /// The name of the repository. The name is not case sensitive.
    repo: string,
    /// If `true`, show notifications marked as read.
    all: option<bool>,
    /// If `true`, only shows notifications in which the user is directly participating or mentioned.
    participating: option<bool>,
    /// Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    since: option<string>,
    /// Only show notifications updated before the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`.
    before: option<string>,
    /// The number of results per page (max 100).
    per-page: option<s32>,
    /// Page number of the results to fetch.
    page: option<s32>
  }
  list-repo-notifications-for-authenticated-user: func(params: list-repo-notifications-for-authenticated-user-params) -> result<string, string>;

  /// Mark repository notifications as read
  record mark-repo-notifications-as-read-params {
    /// The account owner of the repository. The name is not case sensitive.
