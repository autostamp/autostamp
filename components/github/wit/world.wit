  enum repos-list-for-user-type-op-enum {
    all,
    owner,
    member,
  }

  /// Specify which security and analysis features to enable or disable for the repository.
  /// 
  /// To use this parameter, you must have admin permissions for the repository or be an owner or security manager for the organization that owns the repository. For more information, see "[Managing security managers in your organization](https://docs.github.com/organizations/managing-peoples-access-to-your-organization-with-roles/managing-security-managers-in-your-organization)."
  /// 
  /// For example, to enable GitHub Advanced Security, use this data in the body of the `PATCH` request:
  /// `{ "security_and_analysis": {"advanced_security": { "status": "enabled" } } }`.
  /// 
  /// You can check which security and analysis features are currently enabled by using a `GET /repos/{owner}/{repo}` request.
  record repos-update-body-security-and-analysis {
    /// Use the `status` property to enable or disable GitHub Advanced Security for this repository. For more information, see "[About GitHub Advanced Security](/github/getting-started-with-github/learning-about-github/about-github-advanced-security)."
    advanced-security: option<repos-update-body-security-and-analysis-advanced-security>,
    /// Use the `status` property to enable or disable secret scanning for this repository. For more information, see "[About secret scanning](/code-security/secret-security/about-secret-scanning)."
    secret-scanning: option<repos-update-body-security-and-analysis-secret-scanning>,
    /// Use the `status` property to enable or disable secret scanning push protection for this repository. For more information, see "[Protecting pushes with secret scanning](/code-security/secret-scanning/protecting-pushes-with-secret-scanning)."
    secret-scanning-push-protection: option<repos-update-body-security-and-analysis-secret-scanning-push-protection>
  }

  /// Use the `status` property to enable or disable GitHub Advanced Security for this repository. For more information, see "[About GitHub Advanced Security](/github/getting-started-with-github/learning-about-github/about-github-advanced-security)."
  record repos-update-body-security-and-analysis-advanced-security {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// Use the `status` property to enable or disable secret scanning for this repository. For more information, see "[About secret scanning](/code-security/secret-security/about-secret-scanning)."
  record repos-update-body-security-and-analysis-secret-scanning {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// Use the `status` property to enable or disable secret scanning push protection for this repository. For more information, see "[Protecting pushes with secret scanning](/code-security/secret-scanning/protecting-pushes-with-secret-scanning)."
  record repos-update-body-security-and-analysis-secret-scanning-push-protection {
    /// Can be `enabled` or `disabled`.
    status: option<string>
  }

  /// Require at least one approving review on a pull request, before merging. Set to `null` to disable.
  record repos-update-branch-protection-body-required-pull-request-reviews {
    /// Allow specific users, teams, or apps to bypass pull request requirements.
    bypass-pull-request-allowances: option<repos-update-branch-protection-body-required-pull-request-reviews-bypass-pull-request-allowances>,
    /// Set to `true` if you want to automatically dismiss approving reviews when someone pushes a new commit.
    dismiss-stale-reviews: option<bool>,
    /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
    dismissal-restrictions: option<repos-update-branch-protection-body-required-pull-request-reviews-dismissal-restrictions>,
    /// Blocks merging pull requests until [code owners](https://docs.github.com/articles/about-code-owners/) review them.
    require-code-owner-reviews: option<bool>,
    /// Whether the most recent push must be approved by someone other than the person who pushed it. Default: `false`.
    require-last-push-approval: option<bool>,
    /// Specify the number of reviewers required to approve pull requests. Use a number between 1 and 6 or 0 to not require reviewers.
    required-approving-review-count: option<s32>
  }

  /// Allow specific users, teams, or apps to bypass pull request requirements.
  record repos-update-branch-protection-body-required-pull-request-reviews-bypass-pull-request-allowances {
    /// The list of app `slug`s allowed to bypass pull request requirements.
    apps: option<list<string>>,
    /// The list of team `slug`s allowed to bypass pull request requirements.
    teams: option<list<string>>,
    /// The list of user `login`s allowed to bypass pull request requirements.
    users: option<list<string>>
  }

  /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
  record repos-update-branch-protection-body-required-pull-request-reviews-dismissal-restrictions {
    /// The list of app `slug`s with dismissal access
    apps: option<list<string>>,
    /// The list of team `slug`s with dismissal access
    teams: option<list<string>>,
    /// The list of user `login`s with dismissal access
    users: option<list<string>>
  }

  /// Require status checks to pass before merging. Set to `null` to disable.
  record repos-update-branch-protection-body-required-status-checks {
    /// The list of status checks to require in order to merge into this branch.
    checks: option<list<repos-update-branch-protection-body-required-status-checks-checks-item>>,
    /// **Deprecated**: The list of status checks to require in order to merge into this branch. If any of these checks have recently been set by a particular GitHub App, they will be required to come from that app in future for the branch to merge. Use `checks` instead of `contexts` for more fine-grained control.
    contexts: list<string>,
    /// Require branches to be up to date before merging.
    strict: bool
  }

  record repos-update-branch-protection-body-required-status-checks-checks-item {
    /// The ID of the GitHub App that must provide this check. Omit this field to automatically select the GitHub App that has recently provided this check, or any app if it was not set by a GitHub App. Pass -1 to explicitly allow any app to set the status.
    app-id: option<s32>,
    /// The name of the required check
    context: string
  }

  /// Restrict who can push to the protected branch. User, app, and team `restrictions` are only available for organization-owned repositories. Set to `null` to disable.
  record repos-update-branch-protection-body-restrictions {
    /// The list of app `slug`s with push access
    apps: option<list<string>>,
    /// The list of team `slug`s with push access
    teams: list<string>,
    /// The list of user `login`s with push access
    users: list<string>
  }

  /// Allow specific users, teams, or apps to bypass pull request requirements.
  record repos-update-pull-request-review-protection-body-bypass-pull-request-allowances {
    /// The list of app `slug`s allowed to bypass pull request requirements.
    apps: option<list<string>>,
    /// The list of team `slug`s allowed to bypass pull request requirements.
    teams: option<list<string>>,
    /// The list of user `login`s allowed to bypass pull request requirements.
    users: option<list<string>>
  }

  /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
  record repos-update-pull-request-review-protection-body-dismissal-restrictions {
    /// The list of app `slug`s with dismissal access
    apps: option<list<string>>,
    /// The list of team `slug`s with dismissal access
    teams: option<list<string>>,
    /// The list of user `login`s with dismissal access
    users: option<list<string>>
  }

  record repos-update-status-check-protection-body-checks-item {
    /// The ID of the GitHub App that must provide this check. Omit this field to automatically select the GitHub App that has recently provided this check, or any app if it was not set by a GitHub App. Pass -1 to explicitly allow any app to set the status.
    app-id: option<s32>,
    /// The name of the required check
    context: string
  }

  /// The author of the file. Default: The `committer` or the authenticated user if you omit `committer`.
  record repos-create-or-update-file-contents-body-author {
    date: option<string>,
    /// The email of the author or committer of the commit. You'll receive a `422` status code if `email` is omitted.
    email: string,
    /// The name of the author or committer of the commit. You'll receive a `422` status code if `name` is omitted.
    name: string
  }

  /// The person that committed the file. Default: the authenticated user.
  record repos-create-or-update-file-contents-body-committer {
    date: option<string>,
    /// The email of the author or committer of the commit. You'll receive a `422` status code if `email` is omitted.
    email: string,
    /// The name of the author or committer of the commit. You'll receive a `422` status code if `name` is omitted.
    name: string
  }

  /// object containing information about the author.
  record repos-delete-file-body-author {
    /// The email of the author (or committer) of the commit
    email: option<string>,
    /// The name of the author (or committer) of the commit
    name: option<string>
  }

  /// object containing information about the committer.
  record repos-delete-file-body-committer {
    /// The email of the author (or committer) of the commit
    email: option<string>,
    /// The name of the author (or committer) of the commit
    name: option<string>
  }

  /// JSON payload with extra information about the webhook event that your action or workflow may use. The maximum number of top-level properties is 10.
  record repos-create-dispatch-event-body-client-payload {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The type of deployment branch policy for this environment. To allow all branches to deploy, set to `null`.
  record deployment-branch-policy-settings {
    /// Whether only branches that match the specified name patterns can deploy to this environment.  If `custom_branch_policies` is `true`, `protected_branches` must be `false`; if `custom_branch_policies` is `false`, `protected_branches` must be `true`.
    custom-branch-policies: bool,
    /// Whether only branches with branch protection rules can deploy to this environment. If `protected_branches` is `true`, `custom_branch_policies` must be `false`; if `protected_branches` is `false`, `custom_branch_policies` must be `true`.
    protected-branches: bool
  }

  record repos-create-or-update-environment-body-reviewers-item {
    /// The id of the user or team who can review the deployment
    id: option<s32>,
    type-op: option<deployment-reviewer-type>
  }

  /// The type of reviewer.
  record deployment-reviewer-type {
    /// opaque schema; raw JSON
    value: string
  }

  /// The amount of time to delay a job after the job is initially triggered. The time (in minutes) must be an integer between 0 and 43,200 (30 days).
  record wait-timer {
    /// opaque schema; raw JSON
    value: string
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/repos#create-hook-config-params).
  record repos-create-webhook-body-config {
    content-type: option<webhook-config-content-type>,
    digest: option<string>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    secret: option<webhook-config-secret>,
    token: option<string>,
    url: option<webhook-config-url>
  }

  /// The media type used to serialize the payloads. Supported values include `json` and `form`. The default is `form`.
  record webhook-config-content-type {
    /// opaque schema; raw JSON
    value: string
  }

  record webhook-config-insecure-ssl {
    /// opaque schema; raw JSON
    value: string
  }

  /// If provided, the `secret` will be used as the `key` to generate the HMAC hex digest value for [delivery signature headers](https://docs.github.com/webhooks/event-payloads/#delivery-headers).
  record webhook-config-secret {
    /// opaque schema; raw JSON
    value: string
  }

  /// The URL to which the payloads will be delivered.
  record webhook-config-url {
    /// opaque schema; raw JSON
    value: string
  }

  /// Key/value pairs to provide settings for this webhook. [These are defined below](https://docs.github.com/rest/reference/repos#create-hook-config-params).
  record repos-update-webhook-body-config {
    address: option<string>,
    content-type: option<webhook-config-content-type>,
    insecure-ssl: option<webhook-config-insecure-ssl>,
    room: option<string>,
    secret: option<webhook-config-secret>,
    url: webhook-config-url
  }

  /// The source branch and directory used to publish your Pages site.
  record repos-create-pages-site-body-source {
    /// The repository branch used to publish your site's source files.
    branch: string,
    /// The repository directory that includes the source files for the Pages site. Allowed paths are `/` or `/docs`. Default: `/`
    path: option<repos-create-pages-site-body-source-path-enum>
  }

  /// List organization repositories
  record repos-list-for-org-params {
    /// Specifies the types of repositories you want returned.
    type-op: option<repos-list-for-org-type-op-enum>,
    /// The property to sort the results by.
    sort: option<repos-list-for-org-sort-enum>,
    /// The order to sort by. Default: `asc` when using `full_name`, otherwise `desc`.
    direction: option<repos-list-for-org-direction-enum>
  }
  repos-list-for-org: func(params: repos-list-for-org-params) -> result<string, string>;

  /// Create an organization repository
  record repos-create-in-org-params {
    /// Either `true` to allow auto-merge on pull requests, or `false` to disallow auto-merge.
    allow-auto-merge: option<bool>,
    /// Either `true` to allow merging pull requests with a merge commit, or `false` to prevent merging pull requests with merge commits.
    allow-merge-commit: option<bool>,
    /// Either `true` to allow rebase-merging pull requests, or `false` to prevent rebase-merging.
    allow-rebase-merge: option<bool>,
    /// Either `true` to allow squash-merging pull requests, or `false` to prevent squash-merging.
    allow-squash-merge: option<bool>,
    /// Pass `true` to create an initial commit with empty README.
    auto-init: option<bool>,
    /// Either `true` to allow automatically deleting head branches when pull requests are merged, or `false` to prevent automatic deletion. **The authenticated user must be an organization owner to set this property to `true`.**
    delete-branch-on-merge: option<bool>,
    /// A short description of the repository.
    description: option<string>,
    /// Desired language or platform [.gitignore template](https://github.com/github/gitignore) to apply. Use the name of the template without the extension. For example, "Haskell".
    gitignore-template: option<string>,
    /// Whether downloads are enabled.
    has-downloads: option<bool>,
    /// Either `true` to enable issues for this repository or `false` to disable them.
    has-issues: option<bool>,
    /// Either `true` to enable projects for this repository or `false` to disable them. **Note:** If you're creating a repository in an organization that has disabled repository projects, the default is `false`, and if you pass `true`, the API returns an error.
    has-projects: option<bool>,
    /// Either `true` to enable the wiki for this repository or `false` to disable it.
    has-wiki: option<bool>,
    /// A URL with more information about the repository.
    homepage: option<string>,
    /// Either `true` to make this repo available as a template repository or `false` to prevent it.
    is-template: option<bool>,
    /// Choose an [open source license template](https://choosealicense.com/) that best suits your needs, and then use the [license keyword](https://docs.github.com/articles/licensing-a-repository/#searching-github-by-license-type) as the `license_template` string. For example, "mit" or "mpl-2.0".
    license-template: option<string>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repos-create-in-org-body-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repos-create-in-org-body-merge-commit-title-enum>,
    /// The name of the repository.
    name: string,
    /// Whether the repository is private.
    private: option<bool>,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repos-create-in-org-body-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repos-create-in-org-body-squash-merge-commit-title-enum>,
    /// The id of the team that will be granted access to this repository. This is only valid when creating a repository in an organization.
    team-id: option<s32>,
    /// Either `true` to allow squash-merge commits to use pull request title, or `false` to use commit message. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The visibility of the repository.
    visibility: option<repos-create-in-org-body-visibility-enum>
  }
  repos-create-in-org: func(params: repos-create-in-org-params) -> result<string, string>;

  /// Get a repository
  repos-get: func() -> result<string, string>;

  /// Update a repository
  record repos-update-params {
    /// Either `true` to allow auto-merge on pull requests, or `false` to disallow auto-merge.
    allow-auto-merge: option<bool>,
    /// Either `true` to allow private forks, or `false` to prevent private forks.
    allow-forking: option<bool>,
    /// Either `true` to allow merging pull requests with a merge commit, or `false` to prevent merging pull requests with merge commits.
    allow-merge-commit: option<bool>,
    /// Either `true` to allow rebase-merging pull requests, or `false` to prevent rebase-merging.
    allow-rebase-merge: option<bool>,
    /// Either `true` to allow squash-merging pull requests, or `false` to prevent squash-merging.
    allow-squash-merge: option<bool>,
    /// Either `true` to always allow a pull request head branch that is behind its base branch to be updated even if it is not required to be up to date before merging, or false otherwise.
    allow-update-branch: option<bool>,
    /// Whether to archive this repository. `false` will unarchive a previously archived repository.
    archived: option<bool>,
    /// Updates the default branch for this repository.
    default-branch: option<string>,
    /// Either `true` to allow automatically deleting head branches when pull requests are merged, or `false` to prevent automatic deletion.
    delete-branch-on-merge: option<bool>,
    /// A short description of the repository.
    description: option<string>,
    /// Either `true` to enable issues for this repository or `false` to disable them.
    has-issues: option<bool>,
    /// Either `true` to enable projects for this repository or `false` to disable them. **Note:** If you're creating a repository in an organization that has disabled repository projects, the default is `false`, and if you pass `true`, the API returns an error.
    has-projects: option<bool>,
    /// Either `true` to enable the wiki for this repository or `false` to disable it.
    has-wiki: option<bool>,
    /// A URL with more information about the repository.
    homepage: option<string>,
    /// Either `true` to make this repo available as a template repository or `false` to prevent it.
    is-template: option<bool>,
    /// The default value for a merge commit message.
    /// 
    merge-commit-message: option<repos-create-in-org-body-merge-commit-message-enum>,
    /// The default value for a merge commit title.
    /// 
    merge-commit-title: option<repos-create-in-org-body-merge-commit-title-enum>,
    /// The name of the repository.
    name: option<string>,
    /// Either `true` to make the repository private or `false` to make it public. Default: `false`.  
    /// **Note**: You will get a `422` error if the organization restricts [changing repository visibility](https://docs.github.com/articles/repository-permission-levels-for-an-organization#changing-the-visibility-of-repositories) to organization owners and a non-owner tries to change the value of private.
    private: option<bool>,
    /// Specify which security and analysis features to enable or disable for the repository.
    /// 
    security-and-analysis: option<repos-update-body-security-and-analysis>,
    /// The default value for a squash merge commit message:
    /// 
    squash-merge-commit-message: option<repos-create-in-org-body-squash-merge-commit-message-enum>,
    /// The default value for a squash merge commit title:
    /// 
    squash-merge-commit-title: option<repos-create-in-org-body-squash-merge-commit-title-enum>,
    /// Either `true` to allow squash-merge commits to use pull request title, or `false` to use commit message. **This property has been deprecated. Please use `squash_merge_commit_title` instead.
    use-squash-pr-title-as-default: option<bool>,
    /// The visibility of the repository.
    visibility: option<repos-create-in-org-body-visibility-enum>,
    /// Either `true` to require contributors to sign off on web-based commits, or `false` to not require contributors to sign off on web-based commits.
    web-commit-signoff-required: option<bool>
  }
  repos-update: func(params: repos-update-params) -> result<string, string>;

  /// Delete a repository
  repos-delete: func() -> result<string, string>;

  /// List all autolinks of a repository
  repos-list-autolinks: func() -> result<string, string>;

  /// Create an autolink reference for a repository
  record repos-create-autolink-params {
    /// Whether this autolink reference matches alphanumeric characters. If true, the `<num>` parameter of the `url_template` matches alphanumeric characters `A-Z` (case insensitive), `0-9`, and `-`. If false, this autolink reference only matches numeric characters.
    is-alphanumeric: option<bool>,
    /// This prefix appended by certain characters will generate a link any time it is found in an issue, pull request, or commit.
    key-prefix: string,
    /// The URL must contain `<num>` for the reference number. `<num>` matches different characters depending on the value of `is_alphanumeric`.
    url-template: string
  }
  repos-create-autolink: func(params: repos-create-autolink-params) -> result<string, string>;

  /// Get an autolink reference of a repository
  repos-get-autolink: func() -> result<string, string>;

  /// Delete an autolink reference from a repository
  repos-delete-autolink: func() -> result<string, string>;

  /// Enable automated security fixes
  repos-enable-automated-security-fixes: func() -> result<string, string>;

  /// Disable automated security fixes
  repos-disable-automated-security-fixes: func() -> result<string, string>;

  /// List branches
  record repos-list-branches-params {
    /// Setting to `true` returns only protected branches. When set to `false`, only unprotected branches are returned. Omitting this parameter returns all branches.
    protected: option<bool>
  }
  repos-list-branches: func(params: repos-list-branches-params) -> result<string, string>;

  /// Get a branch
  repos-get-branch: func() -> result<string, string>;

  /// Get branch protection
  repos-get-branch-protection: func() -> result<string, string>;

  /// Update branch protection
  record repos-update-branch-protection-params {
    /// Allows deletion of the protected branch by anyone with write access to the repository. Set to `false` to prevent deletion of the protected branch. Default: `false`. For more information, see "[Enabling force pushes to a protected branch](https://docs.github.com/github/administering-a-repository/enabling-force-pushes-to-a-protected-branch)" in the GitHub Help documentation.
    allow-deletions: option<bool>,
    /// Permits force pushes to the protected branch by anyone with write access to the repository. Set to `true` to allow force pushes. Set to `false` or `null` to block force pushes. Default: `false`. For more information, see "[Enabling force pushes to a protected branch](https://docs.github.com/github/administering-a-repository/enabling-force-pushes-to-a-protected-branch)" in the GitHub Help documentation."
    allow-force-pushes: option<bool>,
    /// Whether users can pull changes from upstream when the branch is locked. Set to `true` to allow fork syncing. Set to `false` to prevent fork syncing. Default: `false`.
    allow-fork-syncing: option<bool>,
    /// If set to `true`, the `restrictions` branch protection settings which limits who can push will also block pushes which create new branches, unless the push is initiated by a user, team, or app which has the ability to push. Set to `true` to restrict new branch creation. Default: `false`.
    block-creations: option<bool>,
    /// Enforce all configured restrictions for administrators. Set to `true` to enforce required status checks for repository administrators. Set to `null` to disable.
    enforce-admins: bool,
    /// Whether to set the branch as read-only. If this is true, users will not be able to push to the branch. Default: `false`.
    lock-branch: option<bool>,
    /// Requires all conversations on code to be resolved before a pull request can be merged into a branch that matches this rule. Set to `false` to disable. Default: `false`.
    required-conversation-resolution: option<bool>,
    /// Enforces a linear commit Git history, which prevents anyone from pushing merge commits to a branch. Set to `true` to enforce a linear commit history. Set to `false` to disable a linear commit Git history. Your repository must allow squash merging or rebase merging before you can enable a linear commit history. Default: `false`. For more information, see "[Requiring a linear commit history](https://docs.github.com/github/administering-a-repository/requiring-a-linear-commit-history)" in the GitHub Help documentation.
    required-linear-history: option<bool>,
    /// Require at least one approving review on a pull request, before merging. Set to `null` to disable.
    required-pull-request-reviews: repos-update-branch-protection-body-required-pull-request-reviews,
    /// Require status checks to pass before merging. Set to `null` to disable.
    required-status-checks: repos-update-branch-protection-body-required-status-checks,
    /// Restrict who can push to the protected branch. User, app, and team `restrictions` are only available for organization-owned repositories. Set to `null` to disable.
    restrictions: repos-update-branch-protection-body-restrictions
  }
  repos-update-branch-protection: func(params: repos-update-branch-protection-params) -> result<string, string>;

  /// Delete branch protection
  repos-delete-branch-protection: func() -> result<string, string>;

  /// Get admin branch protection
  repos-get-admin-branch-protection: func() -> result<string, string>;

  /// Set admin branch protection
  repos-set-admin-branch-protection: func() -> result<string, string>;

  /// Delete admin branch protection
  repos-delete-admin-branch-protection: func() -> result<string, string>;

  /// Get pull request review protection
  repos-get-pull-request-review-protection: func() -> result<string, string>;

  /// Update pull request review protection
  record repos-update-pull-request-review-protection-params {
    /// Allow specific users, teams, or apps to bypass pull request requirements.
    bypass-pull-request-allowances: option<repos-update-pull-request-review-protection-body-bypass-pull-request-allowances>,
    /// Set to `true` if you want to automatically dismiss approving reviews when someone pushes a new commit.
    dismiss-stale-reviews: option<bool>,
    /// Specify which users, teams, and apps can dismiss pull request reviews. Pass an empty `dismissal_restrictions` object to disable. User and team `dismissal_restrictions` are only available for organization-owned repositories. Omit this parameter for personal repositories.
    dismissal-restrictions: option<repos-update-pull-request-review-protection-body-dismissal-restrictions>,
    /// Blocks merging pull requests until [code owners](https://docs.github.com/articles/about-code-owners/) have reviewed.
    require-code-owner-reviews: option<bool>,
    /// Whether the most recent push must be approved by someone other than the person who pushed it. Default: `false`
    require-last-push-approval: option<bool>,
    /// Specifies the number of reviewers required to approve pull requests. Use a number between 1 and 6 or 0 to not require reviewers.
    required-approving-review-count: option<s32>
  }
  repos-update-pull-request-review-protection: func(params: repos-update-pull-request-review-protection-params) -> result<string, string>;

  /// Delete pull request review protection
  repos-delete-pull-request-review-protection: func() -> result<string, string>;

  /// Get commit signature protection
  repos-get-commit-signature-protection: func() -> result<string, string>;

  /// Create commit signature protection
  repos-create-commit-signature-protection: func() -> result<string, string>;

  /// Delete commit signature protection
  repos-delete-commit-signature-protection: func() -> result<string, string>;

  /// Get status checks protection
  repos-get-status-checks-protection: func() -> result<string, string>;

  /// Update status check protection
  record repos-update-status-check-protection-params {
    /// The list of status checks to require in order to merge into this branch.
    checks: option<list<repos-update-status-check-protection-body-checks-item>>,
    /// **Deprecated**: The list of status checks to require in order to merge into this branch. If any of these checks have recently been set by a particular GitHub App, they will be required to come from that app in future for the branch to merge. Use `checks` instead of `contexts` for more fine-grained control.
    contexts: option<list<string>>,
    /// Require branches to be up to date before merging.
    strict: option<bool>
  }
  repos-update-status-check-protection: func(params: repos-update-status-check-protection-params) -> result<string, string>;

  /// Remove status check protection
  repos-remove-status-check-protection: func() -> result<string, string>;

