package autostamp:openai@0.5.0;

interface open-ai {
  enum chat-completion-request-message-role-enum {
    system,
    user,
    assistant,
  }

  enum create-image-request-response-format-enum {
    url,
    b64-json,
  }

  enum create-image-request-size-enum {
    v256x256,
    v512x512,
    v1024x1024,
  }

  /// Modify the likelihood of specified tokens appearing in the completion.
  /// 
  /// Accepts a json object that maps tokens (specified by their token ID in the GPT tokenizer) to an associated bias value from -100 to 100. You can use this [tokenizer tool](/tokenizer?view=bpe) (which works for both GPT-2 and GPT-3) to convert text to token IDs. Mathematically, the bias is added to the logits generated by the model prior to sampling. The exact effect will vary per model, but values between -1 and 1 should decrease or increase likelihood of selection; values like -100 or 100 should result in a ban or exclusive selection of the relevant token.
  /// 
  /// As an example, you can pass `{"50256": -100}` to prevent the <|endoftext|> token from being generated.
  record create-completion-request-properties-logit-bias {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A special boolean flag for showing metadata. If set to `true`, each document entry in the returned JSON will contain a "metadata" field.
  /// 
  /// This flag only takes effect when `file` is set.
  record create-search-request-properties-return-metadata {
    /// opaque schema; raw JSON
    value: string
  }

  /// A unique identifier representing your end-user, which can help OpenAI to monitor and detect abuse. [Learn more](/docs/guides/safety-best-practices/end-user-ids).
  record create-completion-request-properties-user {
    /// opaque schema; raw JSON
    value: string
  }

  record create-answer-response {
    answers: option<list<string>>,
    completion: option<string>,
    model: option<string>,
    object: option<string>,
    search-model: option<string>,
    selected-documents: option<list<create-answer-response-selected-documents-item>>
  }

  record create-answer-response-selected-documents-item {
    document: option<s32>,
    text: option<string>
  }

  record create-transcription-response {
    text: string
  }

  record create-translation-response {
    text: string
  }

  /// Modify the likelihood of specified tokens appearing in the completion.
  /// 
  /// Accepts a json object that maps tokens (specified by their token ID in the tokenizer) to an associated bias value from -100 to 100. Mathematically, the bias is added to the logits generated by the model prior to sampling. The exact effect will vary per model, but values between -1 and 1 should decrease or increase likelihood of selection; values like -100 or 100 should result in a ban or exclusive selection of the relevant token.
  record create-chat-completion-request-logit-bias {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record chat-completion-request-message {
    /// The contents of the message
    content: string,
    /// The name of the user in a multi-user chat
    name: option<string>,
    /// The role of the author of this message.
    role: chat-completion-request-message-role-enum
  }

  record create-chat-completion-response {
    choices: list<create-chat-completion-response-choices-item>,
    created: s32,
    id: string,
    model: string,
    object: string,
    usage: option<create-chat-completion-response-usage>
  }

  record create-chat-completion-response-choices-item {
    finish-reason: option<string>,
    index: option<s32>,
    message: option<chat-completion-response-message>
  }

  record chat-completion-response-message {
    /// The contents of the message
    content: string,
    /// The role of the author of this message.
    role: chat-completion-request-message-role-enum
  }

  record create-chat-completion-response-usage {
    completion-tokens: s32,
    prompt-tokens: s32,
    total-tokens: s32
  }

  /// If an object name is in the list, we provide the full information of the object; otherwise, we only provide the object ID. Currently we support `completion` and `file` objects for expansion.
  record create-answer-request-properties-expand {
    /// opaque schema; raw JSON
    value: string
  }

  /// Include the log probabilities on the `logprobs` most likely tokens, as well the chosen tokens. For example, if `logprobs` is 5, the API will return a list of the 5 most likely tokens. The API will always return the `logprob` of the sampled token, so there may be up to `logprobs+1` elements in the response.
  /// 
  /// The maximum value for `logprobs` is 5. If you need more than this, please contact us through our [Help center](https://help.openai.com) and describe your use case.
  /// 
  /// When `logprobs` is set, `completion` will be automatically added into `expand` to get the logprobs.
  record create-answer-request-properties-logprobs {
    /// opaque schema; raw JSON
    value: string
  }

  /// ID of the model to use. You can use the [List models](/docs/api-reference/models/list) API to see all of your available models, or see our [Model overview](/docs/models/overview) for descriptions of them.
  record create-completion-request-properties-model {
    /// opaque schema; raw JSON
    value: string
  }

  /// If set to `true`, the returned JSON will include a "prompt" field containing the final prompt that was used to request a completion. This is mainly useful for debugging purposes.
  record create-answer-request-properties-return-prompt {
    /// opaque schema; raw JSON
    value: string
  }

  /// ID of the model to use for [Search](/docs/api-reference/searches/create). You can select one of `ada`, `babbage`, `curie`, or `davinci`.
  record create-answer-request-properties-search-model {
    /// opaque schema; raw JSON
    value: string
  }

  record create-classification-response {
    completion: option<string>,
    label: option<string>,
    model: option<string>,
    object: option<string>,
    search-model: option<string>,
    selected-examples: option<list<create-classification-response-selected-examples-item>>
  }

  record create-classification-response-selected-examples-item {
    document: option<s32>,
    label: option<string>,
    text: option<string>
  }

  /// Modify the likelihood of specified tokens appearing in the completion.
  /// 
  /// Accepts a json object that maps tokens (specified by their token ID in the GPT tokenizer) to an associated bias value from -100 to 100. You can use this [tokenizer tool](/tokenizer?view=bpe) (which works for both GPT-2 and GPT-3) to convert text to token IDs. Mathematically, the bias is added to the logits generated by the model prior to sampling. The exact effect will vary per model, but values between -1 and 1 should decrease or increase likelihood of selection; values like -100 or 100 should result in a ban or exclusive selection of the relevant token.
  /// 
  /// As an example, you can pass `{"50256": -100}` to prevent the <|endoftext|> token from being generated.
  record create-completion-request-logit-bias {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record create-completion-response {
    choices: list<create-completion-response-choices-item>,
    created: s32,
    id: string,
    model: string,
    object: string,
    usage: option<create-completion-response-usage>
  }

  record create-completion-response-choices-item {
    finish-reason: option<string>,
    index: option<s32>,
    logprobs: option<create-completion-response-choices-item-logprobs>,
    text: option<string>
  }

  record create-completion-response-choices-item-logprobs {
    text-offset: option<list<s32>>,
    token-logprobs: option<list<f64>>,
    tokens: option<list<string>>,
    top-logprobs: option<list<create-completion-response-choices-item-logprobs-top-logprobs-item>>
  }

  record create-completion-response-choices-item-logprobs-top-logprobs-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record create-completion-response-usage {
    completion-tokens: s32,
    prompt-tokens: s32,
    total-tokens: s32
  }

  record create-edit-response {
    choices: list<create-edit-response-choices-item>,
    created: s32,
    object: string,
    usage: create-edit-response-usage
  }

  record create-edit-response-choices-item {
    finish-reason: option<string>,
    index: option<s32>,
    logprobs: option<create-edit-response-choices-item-logprobs>,
    text: option<string>
  }

  record create-edit-response-choices-item-logprobs {
    text-offset: option<list<s32>>,
    token-logprobs: option<list<f64>>,
    tokens: option<list<string>>,
    top-logprobs: option<list<create-edit-response-choices-item-logprobs-top-logprobs-item>>
  }

  record create-edit-response-choices-item-logprobs-top-logprobs-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record create-edit-response-usage {
    completion-tokens: s32,
    prompt-tokens: s32,
    total-tokens: s32
  }

  record create-embedding-response {
    data: list<create-embedding-response-data-item>,
    model: string,
    object: string,
    usage: create-embedding-response-usage
  }

  record create-embedding-response-data-item {
    embedding: list<f64>,
    index: s32,
    object: string
  }

  record create-embedding-response-usage {
    prompt-tokens: s32,
    total-tokens: s32
  }

  record list-engines-response {
    data: list<engine>,
    object: string
  }

  record engine {
    created: s32,
    id: string,
    object: string,
    ready: bool
  }

  record create-search-response {
    data: option<list<create-search-response-data-item>>,
    model: option<string>,
    object: option<string>
  }

  record create-search-response-data-item {
    document: option<s32>,
    object: option<string>,
    score: option<f64>
  }

  record list-files-response {
    data: list<file>,
    object: string
  }

  record file {
    bytes: s32,
    created-at: s32,
    filename: string,
    id: string,
    object: string,
    purpose: string,
    status: option<string>,
    status-details: option<file-status-details>
  }

  record file-status-details {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record delete-file-response {
    deleted: bool,
    id: string,
    object: string
  }

  record list-fine-tunes-response {
    data: list<fine-tune>,
    object: string
  }

  record fine-tune {
    created-at: s32,
    events: option<list<fine-tune-event>>,
    fine-tuned-model: string,
    hyperparams: fine-tune-hyperparams,
    id: string,
    model: string,
    object: string,
    organization-id: string,
    result-files: list<file>,
    status: string,
    training-files: list<file>,
    updated-at: s32,
    validation-files: list<file>
  }

  record fine-tune-event {
    created-at: s32,
    level: string,
    message: string,
    object: string
  }

  record fine-tune-hyperparams {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record list-fine-tune-events-response {
    data: list<fine-tune-event>,
    object: string
  }

  /// The number of images to generate. Must be between 1 and 10.
  record create-image-request-properties-n {
    /// opaque schema; raw JSON
    value: string
  }

  /// The format in which the generated images are returned. Must be one of `url` or `b64_json`.
  record create-image-request-properties-response-format {
    /// opaque schema; raw JSON
    value: string
  }

  /// The size of the generated images. Must be one of `256x256`, `512x512`, or `1024x1024`.
  record create-image-request-properties-size {
    /// opaque schema; raw JSON
    value: string
  }

  record images-response {
    created: s32,
    data: list<images-response-data-item>
  }

  record images-response-data-item {
    b64-json: option<string>,
    url: option<string>
  }

  record list-models-response {
    data: list<model>,
    object: string
  }

  record model {
    created: s32,
    id: string,
    object: string,
    owned-by: string
  }

  record delete-model-response {
    deleted: bool,
    id: string,
    object: string
  }

  record create-moderation-response {
    id: string,
    model: string,
    results: list<create-moderation-response-results-item>
  }

  record create-moderation-response-results-item {
    categories: create-moderation-response-results-item-categories,
    category-scores: create-moderation-response-results-item-category-scores,
    flagged: bool
  }

  record create-moderation-response-results-item-categories {
    hate: bool,
    hate-threatening: bool,
    self-harm: bool,
    sexual: bool,
    sexual-minors: bool,
    violence: bool,
    violence-graphic: bool
  }

  record create-moderation-response-results-item-category-scores {
    hate: f64,
    hate-threatening: f64,
    self-harm: f64,
    sexual: f64,
    sexual-minors: f64,
    violence: f64,
    violence-graphic: f64
  }

  /// Answers the specified question using the provided documents and examples.
  /// 
  /// The endpoint first [searches](/docs/api-reference/searches) over provided documents or files to find relevant context. The relevant context is combined with the provided examples and question to create the prompt for [completion](/docs/api-reference/completions).
  record create-answer-params {
    /// List of documents from which the answer for the input `question` should be derived. If this is an empty list, the question will be answered based on the question-answer examples.
    /// 
    documents: option<list<string>>,
    /// List of (question, answer) pairs that will help steer the model towards the tone and answer format you'd like. We recommend adding 2 to 3 examples.
    examples: list<list<string>>,
    /// A text snippet containing the contextual information used to generate the answers for the `examples` you provide.
    examples-context: string,
    /// If an object name is in the list, we provide the full information of the object; otherwise, we only provide the object ID. Currently we support `completion` and `file` objects for expansion.
    expand: option<list<string>>,
    /// The ID of an uploaded file that contains documents to search over. See [upload file](/docs/api-reference/files/upload) for how to upload a file of the desired format and purpose.
    /// 
    file: option<string>,
    logit-bias: option<create-completion-request-properties-logit-bias>,
    /// Include the log probabilities on the `logprobs` most likely tokens, as well the chosen tokens. For example, if `logprobs` is 5, the API will return a list of the 5 most likely tokens. The API will always return the `logprob` of the sampled token, so there may be up to `logprobs+1` elements in the response.
    /// 
    logprobs: option<s32>,
    /// The maximum number of documents to be ranked by [Search](/docs/api-reference/searches/create) when using `file`. Setting it to a higher value leads to improved accuracy but with increased latency and cost.
    max-rerank: option<s32>,
    /// The maximum number of tokens allowed for the generated answer
    max-tokens: option<s32>,
    /// ID of the model to use for completion. You can select one of `ada`, `babbage`, `curie`, or `davinci`.
    model: string,
    /// How many answers to generate for each question.
    n: option<s32>,
    /// Question to get answered.
    question: string,
    return-metadata: option<create-search-request-properties-return-metadata>,
    /// If set to `true`, the returned JSON will include a "prompt" field containing the final prompt that was used to request a completion. This is mainly useful for debugging purposes.
    return-prompt: option<bool>,
    /// ID of the model to use for [Search](/docs/api-reference/searches/create). You can select one of `ada`, `babbage`, `curie`, or `davinci`.
    search-model: option<string>,
    /// Up to 4 sequences where the API will stop generating further tokens. The returned text will not contain the stop sequence.
    stop: option<string>,
    /// What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic.
    temperature: option<f64>,
    user: option<create-completion-request-properties-user>
  }
  create-answer: func(params: create-answer-params) -> result<create-answer-response, string>;

  /// Transcribes audio into the input language.
  record create-transcription-params {
    /// The audio file to transcribe, in one of these formats: mp3, mp4, mpeg, mpga, m4a, wav, or webm.
    file: string,
    /// The language of the input audio. Supplying the input language in [ISO-639-1](https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes) format will improve accuracy and latency.
    language: option<string>,
    /// ID of the model to use. Only `whisper-1` is currently available.
    model: string,
    /// An optional text to guide the model's style or continue a previous audio segment. The [prompt](/docs/guides/speech-to-text/prompting) should match the audio language.
    prompt: option<string>,
    /// The format of the transcript output, in one of these options: json, text, srt, verbose_json, or vtt.
    response-format: option<string>,
    /// The sampling temperature, between 0 and 1. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. If set to 0, the model will use [log probability](https://en.wikipedia.org/wiki/Log_probability) to automatically increase the temperature until certain thresholds are hit.
    temperature: option<f64>
  }
  create-transcription: func(params: create-transcription-params) -> result<create-transcription-response, string>;

  /// Translates audio into into English.
  record create-translation-params {
    /// The audio file to translate, in one of these formats: mp3, mp4, mpeg, mpga, m4a, wav, or webm.
    file: string,
    /// ID of the model to use. Only `whisper-1` is currently available.
    model: string,
    /// An optional text to guide the model's style or continue a previous audio segment. The [prompt](/docs/guides/speech-to-text/prompting) should be in English.
    prompt: option<string>,
    /// The format of the transcript output, in one of these options: json, text, srt, verbose_json, or vtt.
    response-format: option<string>,
    /// The sampling temperature, between 0 and 1. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. If set to 0, the model will use [log probability](https://en.wikipedia.org/wiki/Log_probability) to automatically increase the temperature until certain thresholds are hit.
    temperature: option<f64>
  }
  create-translation: func(params: create-translation-params) -> result<create-translation-response, string>;

  /// Creates a completion for the chat message
  record create-chat-completion-params {
    /// Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.
    /// 
    frequency-penalty: option<f64>,
    /// Modify the likelihood of specified tokens appearing in the completion.
    /// 
    logit-bias: option<create-chat-completion-request-logit-bias>,
    /// The maximum number of tokens allowed for the generated answer. By default, the number of tokens the model can return will be (4096 - prompt tokens).
    max-tokens: option<s32>,
    /// The messages to generate chat completions for, in the [chat format](/docs/guides/chat/introduction).
    messages: list<chat-completion-request-message>,
    /// ID of the model to use. Currently, only `gpt-3.5-turbo` and `gpt-3.5-turbo-0301` are supported.
    model: string,
    /// How many chat completion choices to generate for each input message.
    n: option<s32>,
    /// Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.
    /// 
    presence-penalty: option<f64>,
    /// Up to 4 sequences where the API will stop generating further tokens.
    stop: option<string>,
    /// If set, partial message deltas will be sent, like in ChatGPT. Tokens will be sent as data-only [server-sent events](https://developer.mozilla.org/en-US/docs/Web/API/Server-sent_events/Using_server-sent_events#Event_stream_format) as they become available, with the stream terminated by a `data: [DONE]` message.
    stream-op: option<bool>,
    /// What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic.
    /// 
    temperature: option<f64>,
    /// An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered.
    /// 
    top-p: option<f64>,
    user: option<create-completion-request-properties-user>
  }
  create-chat-completion: func(params: create-chat-completion-params) -> result<create-chat-completion-response, string>;

  /// Classifies the specified `query` using provided examples.
  /// 
  /// The endpoint first [searches](/docs/api-reference/searches) over the labeled examples
  /// to select the ones most relevant for the particular query. Then, the relevant examples
  /// are combined with the query to construct a prompt to produce the final label via the
  /// [completions](/docs/api-reference/completions) endpoint.
  /// 
  /// Labeled examples can be provided via an uploaded `file`, or explicitly listed in the
  /// request using the `examples` parameter for quick tests and small scale use cases.
  record create-classification-params {
    /// A list of examples with labels, in the following format:
    /// 
    examples: option<list<list<string>>>,
    expand: option<create-answer-request-properties-expand>,
    /// The ID of the uploaded file that contains training examples. See [upload file](/docs/api-reference/files/upload) for how to upload a file of the desired format and purpose.
    /// 
    file: option<string>,
    /// The set of categories being classified. If not specified, candidate labels will be automatically collected from the examples you provide. All the label strings will be normalized to be capitalized.
    labels: option<list<string>>,
    logit-bias: option<create-completion-request-properties-logit-bias>,
    logprobs: option<create-answer-request-properties-logprobs>,
    /// The maximum number of examples to be ranked by [Search](/docs/api-reference/searches/create) when using `file`. Setting it to a higher value leads to improved accuracy but with increased latency and cost.
    max-examples: option<s32>,
    model: create-completion-request-properties-model,
    /// Query to be classified.
    query: string,
    return-metadata: option<create-search-request-properties-return-metadata>,
    return-prompt: option<create-answer-request-properties-return-prompt>,
    search-model: option<create-answer-request-properties-search-model>,
    /// What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic.
    temperature: option<f64>,
    user: option<create-completion-request-properties-user>
  }
  create-classification: func(params: create-classification-params) -> result<create-classification-response, string>;

  /// Creates a completion for the provided prompt and parameters
  record create-completion-params {
    /// Generates `best_of` completions server-side and returns the "best" (the one with the highest log probability per token). Results cannot be streamed.
    /// 
    best-of: option<s32>,
    /// Echo back the prompt in addition to the completion
    echo: option<bool>,
    /// Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim.
    /// 
    frequency-penalty: option<f64>,
    /// Modify the likelihood of specified tokens appearing in the completion.
    /// 
    logit-bias: option<create-completion-request-logit-bias>,
    /// Include the log probabilities on the `logprobs` most likely tokens, as well the chosen tokens. For example, if `logprobs` is 5, the API will return a list of the 5 most likely tokens. The API will always return the `logprob` of the sampled token, so there may be up to `logprobs+1` elements in the response.
    /// 
    logprobs: option<s32>,
    /// The maximum number of [tokens](/tokenizer) to generate in the completion.
    /// 
    max-tokens: option<s32>,
    /// ID of the model to use. You can use the [List models](/docs/api-reference/models/list) API to see all of your available models, or see our [Model overview](/docs/models/overview) for descriptions of them.
    model: string,
    /// How many completions to generate for each prompt.
    /// 
    n: option<s32>,
    /// Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics.
    /// 
    presence-penalty: option<f64>,
    /// The prompt(s) to generate completions for, encoded as a string, array of strings, array of tokens, or array of token arrays.
    /// 
    prompt: option<string>,
    /// Up to 4 sequences where the API will stop generating further tokens. The returned text will not contain the stop sequence.
    stop: option<string>,
    /// Whether to stream back partial progress. If set, tokens will be sent as data-only [server-sent events](https://developer.mozilla.org/en-US/docs/Web/API/Server-sent_events/Using_server-sent_events#Event_stream_format) as they become available, with the stream terminated by a `data: [DONE]` message.
    stream-op: option<bool>,
    /// The suffix that comes after a completion of inserted text.
    suffix: option<string>,
    /// What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic.
    /// 
    temperature: option<f64>,
    /// An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered.
    /// 
    top-p: option<f64>,
    /// A unique identifier representing your end-user, which can help OpenAI to monitor and detect abuse. [Learn more](/docs/guides/safety-best-practices/end-user-ids).
    user: option<string>
  }
  create-completion: func(params: create-completion-params) -> result<create-completion-response, string>;

  /// Creates a new edit for the provided input, instruction, and parameters.
  record create-edit-params {
    /// The input text to use as a starting point for the edit.
    input: option<string>,
    /// The instruction that tells the model how to edit the prompt.
    instruction: string,
    /// ID of the model to use. You can use the `text-davinci-edit-001` or `code-davinci-edit-001` model with this endpoint.
    model: string,
    /// How many edits to generate for the input and instruction.
    n: option<s32>,
    /// What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic.
    /// 
    temperature: option<f64>,
    /// An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered.
    /// 
    top-p: option<f64>
  }
  create-edit: func(params: create-edit-params) -> result<create-edit-response, string>;

  /// Creates an embedding vector representing the input text.
  record create-embedding-params {
    /// Input text to get embeddings for, encoded as a string or array of tokens. To get embeddings for multiple inputs in a single request, pass an array of strings or array of token arrays. Each input must not exceed 8192 tokens in length.
    input: string,
    model: create-completion-request-properties-model,
    user: option<create-completion-request-properties-user>
  }
  create-embedding: func(params: create-embedding-params) -> result<create-embedding-response, string>;

  /// Lists the currently available (non-finetuned) models, and provides basic information about each one such as the owner and availability.
  list-engines: func() -> result<list-engines-response, string>;

  /// Retrieves a model instance, providing basic information about it such as the owner and availability.
  record retrieve-engine-params {
    /// The ID of the engine to use for this request
    engine-id: string
  }
  retrieve-engine: func(params: retrieve-engine-params) -> result<engine, string>;

  /// The search endpoint computes similarity scores between provided query and documents. Documents can be passed directly to the API if there are no more than 200 of them.
  /// 
  /// To go beyond the 200 document limit, documents can be processed offline and then used for efficient retrieval at query time. When `file` is set, the search endpoint searches over all the documents in the given file and returns up to the `max_rerank` number of documents. These documents will be returned along with their search scores.
  /// 
  /// The similarity score is a positive score that usually ranges from 0 to 300 (but can sometimes go higher), where a score above 200 usually means the document is semantically similar to the query.
  record create-search-params {
    /// The ID of the engine to use for this request.  You can select one of `ada`, `babbage`, `curie`, or `davinci`.
    engine-id: string,
    /// Up to 200 documents to search over, provided as a list of strings.
    /// 
    documents: option<list<string>>,
    /// The ID of an uploaded file that contains documents to search over.
    /// 
    file: option<string>,
    /// The maximum number of documents to be re-ranked and returned by search.
    /// 
    max-rerank: option<s32>,
    /// Query to search against the documents.
    query: string,
    /// A special boolean flag for showing metadata. If set to `true`, each document entry in the returned JSON will contain a "metadata" field.
    /// 
    return-metadata: option<bool>,
    user: option<create-completion-request-properties-user>
  }
  create-search: func(params: create-search-params) -> result<create-search-response, string>;

  /// Returns a list of files that belong to the user's organization.
  list-files: func() -> result<list-files-response, string>;

  /// Upload a file that contains document(s) to be used across various endpoints/features. Currently, the size of all the files uploaded by one organization can be up to 1 GB. Please contact us if you need to increase the storage limit.
  record create-file-params {
    /// Name of the [JSON Lines](https://jsonlines.readthedocs.io/en/latest/) file to be uploaded.
    /// 
    file: string,
    /// The intended purpose of the uploaded documents.
    /// 
    purpose: string
  }
  create-file: func(params: create-file-params) -> result<file, string>;

  /// Returns information about a specific file.
  record retrieve-file-params {
    /// The ID of the file to use for this request
    file-id: string
  }
  retrieve-file: func(params: retrieve-file-params) -> result<file, string>;

  /// Delete a file.
  record delete-file-params {
    /// The ID of the file to use for this request
    file-id: string
  }
  delete-file: func(params: delete-file-params) -> result<delete-file-response, string>;

  /// Returns the contents of the specified file
  record download-file-params {
    /// The ID of the file to use for this request
    file-id: string
  }
  download-file: func(params: download-file-params) -> result<string, string>;

  /// List your organization's fine-tuning jobs
  list-fine-tunes: func() -> result<list-fine-tunes-response, string>;

  /// Creates a job that fine-tunes a specified model from a given dataset.
  /// 
  /// Response includes details of the enqueued job including job status and the name of the fine-tuned models once complete.
  /// 
  /// [Learn more about Fine-tuning](/docs/guides/fine-tuning)
  record create-fine-tune-params {
    /// The batch size to use for training. The batch size is the number of
    /// training examples used to train a single forward and backward pass.
    batch-size: option<s32>,
    /// If this is provided, we calculate F-beta scores at the specified
    /// beta values. The F-beta score is a generalization of F-1 score.
    classification-betas: option<list<f64>>,
    /// The number of classes in a classification task.
    /// 
    classification-n-classes: option<s32>,
    /// The positive class in binary classification.
    /// 
    classification-positive-class: option<string>,
    /// If set, we calculate classification-specific metrics such as accuracy
    /// and F-1 score using the validation set at the end of every epoch.
    compute-classification-metrics: option<bool>,
    /// The learning rate multiplier to use for training.
    /// The fine-tuning learning rate is the original learning rate used for
    learning-rate-multiplier: option<f64>,
    /// The name of the base model to fine-tune. You can select one of "ada",
    /// "babbage", "curie", "davinci", or a fine-tuned model created after 2022-04-21.
    model: option<string>,
    /// The number of epochs to train the model for. An epoch refers to one
    /// full cycle through the training dataset.
    n-epochs: option<s32>,
    /// The weight to use for loss on the prompt tokens. This controls how
    /// much the model tries to learn to generate the prompt (as compared
    prompt-loss-weight: option<f64>,
    /// A string of up to 40 characters that will be added to your fine-tuned model name.
    /// 
    suffix: option<string>,
    /// The ID of an uploaded file that contains training data.
    /// 
    training-file: string,
    /// The ID of an uploaded file that contains validation data.
    /// 
    validation-file: option<string>
  }
  create-fine-tune: func(params: create-fine-tune-params) -> result<fine-tune, string>;

  /// Gets info about the fine-tune job.
  /// 
  /// [Learn more about Fine-tuning](/docs/guides/fine-tuning)
  record retrieve-fine-tune-params {
    /// The ID of the fine-tune job
    fine-tune-id: string
  }
  retrieve-fine-tune: func(params: retrieve-fine-tune-params) -> result<fine-tune, string>;

  /// Immediately cancel a fine-tune job.
  record cancel-fine-tune-params {
    /// The ID of the fine-tune job to cancel
    fine-tune-id: string
  }
  cancel-fine-tune: func(params: cancel-fine-tune-params) -> result<fine-tune, string>;

  /// Get fine-grained status updates for a fine-tune job.
  record list-fine-tune-events-params {
    /// The ID of the fine-tune job to get events for.
    fine-tune-id: string,
    /// Whether to stream events for the fine-tune job. If set to true,
    /// events will be sent as data-only
    stream-op: option<bool>
  }
  list-fine-tune-events: func(params: list-fine-tune-events-params) -> result<list-fine-tune-events-response, string>;

  /// Creates an edited or extended image given an original image and a prompt.
  record create-image-edit-params {
    /// The image to edit. Must be a valid PNG file, less than 4MB, and square. If mask is not provided, image must have transparency, which will be used as the mask.
    image: string,
    /// An additional image whose fully transparent areas (e.g. where alpha is zero) indicate where `image` should be edited. Must be a valid PNG file, less than 4MB, and have the same dimensions as `image`.
    mask: option<string>,
    n: option<create-image-request-properties-n>,
    /// A text description of the desired image(s). The maximum length is 1000 characters.
    prompt: string,
    response-format: option<create-image-request-properties-response-format>,
    size: option<create-image-request-properties-size>,
    user: option<create-completion-request-properties-user>
  }
  create-image-edit: func(params: create-image-edit-params) -> result<images-response, string>;

  /// Creates an image given a prompt.
  record create-image-params {
    /// The number of images to generate. Must be between 1 and 10.
    n: option<s32>,
    /// A text description of the desired image(s). The maximum length is 1000 characters.
    prompt: string,
    /// The format in which the generated images are returned. Must be one of `url` or `b64_json`.
    response-format: option<create-image-request-response-format-enum>,
    /// The size of the generated images. Must be one of `256x256`, `512x512`, or `1024x1024`.
    size: option<create-image-request-size-enum>,
    user: option<create-completion-request-properties-user>
  }
  create-image: func(params: create-image-params) -> result<images-response, string>;

  /// Creates a variation of a given image.
  record create-image-variation-params {
    /// The image to use as the basis for the variation(s). Must be a valid PNG file, less than 4MB, and square.
    image: string,
    n: option<create-image-request-properties-n>,
    response-format: option<create-image-request-properties-response-format>,
    size: option<create-image-request-properties-size>,
    user: option<create-completion-request-properties-user>
  }
  create-image-variation: func(params: create-image-variation-params) -> result<images-response, string>;

  /// Lists the currently available models, and provides basic information about each one such as the owner and availability.
  list-models: func() -> result<list-models-response, string>;

  /// Retrieves a model instance, providing basic information about the model such as the owner and permissioning.
  record retrieve-model-params {
    /// The ID of the model to use for this request
    model: string
  }
  retrieve-model: func(params: retrieve-model-params) -> result<model, string>;

  /// Delete a fine-tuned model. You must have the Owner role in your organization.
  record delete-model-params {
    /// The model to delete
    model: string
  }
  delete-model: func(params: delete-model-params) -> result<delete-model-response, string>;

  /// Classifies if text violates OpenAI's Content Policy
  record create-moderation-params {
    /// The input text to classify
    input: string,
    /// Two content moderations models are available: `text-moderation-stable` and `text-moderation-latest`.
    /// 
    model: option<string>
  }
  create-moderation: func(params: create-moderation-params) -> result<create-moderation-response, string>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export open-ai;
}
