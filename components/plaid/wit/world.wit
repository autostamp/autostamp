  }

  /// Documentation not found in the MISMO model viewer and not provided by Freddie Mac.
  record credit-freddie-mac-assets-voe-v2-v5 {
    /// Documentation not found in the MISMO model viewer and not provided by Freddie Mac.
    asset: list<credit-freddie-mac-asset-voe-v2-v5>
  }

  /// Documentation not found in the MISMO model viewer and not provided by Freddie Mac.
  record credit-freddie-mac-asset-voe-v2-v5 {
    asset-detail: credit-freddie-mac-asset-detail-voe-v2-v5,
    asset-holder: asset-holder,
    asset-owners: asset-owners,
    asset-transactions: credit-freddie-mac-asset-transactions-voe-v2-v5
  }

  /// Details about an asset.
  record credit-freddie-mac-asset-detail-voe-v2-v5 {
    /// A unique alphanumeric string identifying an asset.
    asset-account-identifier: string,
    /// Account Report As of Date / Create Date. Format YYYY-MM-DD
    asset-as-of-date: string,
    /// The Number of days requested made to the Financial Institution. Example When looking for 3 months of data from the FI, pass in 90 days.
    asset-days-requested-count: s32,
    /// A text description that further defines the Asset. This could be used to describe the shares associated with the stocks, bonds or mutual funds, retirement funds or business owned that the borrower has disclosed (named) as an asset.
    asset-description: string,
    /// Ownership type of the asset account.
    asset-ownership-type: string,
    asset-type: asset-type,
    /// Additional Asset Decription some examples are Investment Tax-Deferred , Loan, 401K, 403B, Checking, Money Market, Credit Card,ROTH,529,Biller,ROLLOVER,CD,Savings,Investment Taxable, IRA, Mortgage, Line Of Credit.
    asset-type-additional-description: string,
    /// A vendor created unique Identifier.
    asset-unique-identifier: string
  }

  /// Documentation not found in the MISMO model viewer and not provided by Freddie Mac.
  record credit-freddie-mac-asset-transactions-voe-v2-v5 {
    asset-transaction: list<credit-freddie-mac-asset-transaction-voe-v2-v5>
  }

  /// An object representing...
  record credit-freddie-mac-asset-transaction-voe-v2-v5 {
    /// Documentation not found in the MISMO model viewer and not provided by Freddie Mac.
    asset-transaction-description: list<asset-transaction-description>,
