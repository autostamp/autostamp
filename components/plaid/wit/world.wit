  record credit-report-audit-copy-remove-params {
    /// The `audit_copy_token` granting access to the Audit Copy you would like to revoke.
    audit-copy-token: string
  }
  credit-report-audit-copy-remove: func(params: credit-report-audit-copy-remove-params) -> result<credit-audit-copy-token-remove-response, string>;

  /// Update an Audit Copy Token
  record credit-audit-copy-token-update-params {
    /// The `audit_copy_token` you would like to update.
    audit-copy-token: string,
