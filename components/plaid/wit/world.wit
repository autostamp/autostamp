  }

  /// Documentation not found in the MISMO model viewer and not provided by Freddie Mac.
  record credit-freddie-mac-verification-of-asset-voe-v2-v5 {
    reporting-information: credit-freddie-mac-reporting-information-voa-v2-v4,
    service-product-fulfillment: service-product-fulfillment,
