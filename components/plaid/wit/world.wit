    audit-copy-token: string
  }
  credit-freddie-mac-reports-get: func(params: credit-freddie-mac-reports-get-params) -> result<credit-freddie-mac-reports-get-response, string>;

  /// Retrieve a user's payroll information
  record credit-payroll-income-get-params {
    user-token: option<user-token>
  }
  credit-payroll-income-get: func(params: credit-payroll-income-get-params) -> result<credit-payroll-income-get-response, string>;

  /// Check income verification eligibility and optimize conversion
  record credit-payroll-income-precheck-params {
    /// An array of access tokens corresponding to Items belonging to the user whose eligibility is being checked. Note that if the Items specified here are not already initialized with `transactions`, providing them in this field will cause these Items to be initialized with (and billed for) the Transactions product.
    access-tokens: option<list<access-token>>,
    employer: option<income-verification-precheck-employer>,
    payroll-institution: option<income-verification-precheck-payroll-institution>,
    us-military-info: option<income-verification-precheck-military-info>,
    user-token: option<user-token>
  }
  credit-payroll-income-precheck: func(params: credit-payroll-income-precheck-params) -> result<credit-payroll-income-precheck-response, string>;

  /// Refresh a digital payroll income verification
  record credit-payroll-income-refresh-params {
    options: option<credit-payroll-income-refresh-request-options>,
    user-token: user-token
  }
  credit-payroll-income-refresh: func(params: credit-payroll-income-refresh-params) -> result<credit-payroll-income-refresh-response, string>;

  /// Create a relay token to share an Asset Report with a partner client (beta)
  record credit-relay-create-params {
    /// List of report token strings, with at most one token of each report type. Currently only Asset Report token is supported.
    report-tokens: list<string>,
    /// The `secondary_client_id` is the client id of the third party with whom you would like to share the relay token.
    secondary-client-id: string,
    /// URL to which Plaid will send webhooks when the Secondary Client successfully retrieves an Asset Report by calling `/credit/relay/get`.
    webhook: option<string>
  }
  credit-relay-create: func(params: credit-relay-create-params) -> result<credit-relay-create-response, string>;

  /// Retrieve the reports associated with a relay token that was shared with you (beta)
  record credit-relay-get-params {
    /// The `relay_token` granting access to the report you would like to get.
    relay-token: string,
    report-type: report-type
  }
  credit-relay-get: func(params: credit-relay-get-params) -> result<asset-report-get-response, string>;

  /// Refresh a report of a relay token (beta)
  record credit-relay-refresh-params {
    /// The `relay_token` granting access to the report you would like to refresh.
    relay-token: string,
    report-type: report-type,
    /// The URL registered to receive webhooks when the report of a relay token has been refreshed.
    webhook: option<string>
  }
  credit-relay-refresh: func(params: credit-relay-refresh-params) -> result<credit-relay-refresh-response, string>;

  /// Remove relay token (beta)
  record credit-relay-remove-params {
    /// The `relay_token` you would like to revoke.
    relay-token: string
  }
  credit-relay-remove: func(params: credit-relay-remove-params) -> result<credit-relay-remove-response, string>;

  /// Retrieve Link sessions for your user
  record credit-sessions-get-params {
    user-token: user-token
  }
