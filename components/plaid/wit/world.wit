  credit-bank-income-get: func(params: credit-bank-income-get-params) -> result<credit-bank-income-get-response, string>;

  /// Retrieve information from the bank accounts used for income verification in PDF format
  record credit-bank-income-pdf-get-params {
    user-token: user-token
  }
  credit-bank-income-pdf-get: func(params: credit-bank-income-pdf-get-params) -> result<credit-bank-income-pdf-get-response, string>;

