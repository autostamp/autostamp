    parties: credit-freddie-mac-parties-voa-v2-v4,
    services: credit-freddie-mac-services-voe-v2-v5
  }

  /// A collection of objects that describe requests and responses for services.
  record credit-freddie-mac-services-voe-v2-v5 {
