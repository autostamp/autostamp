    personal-finance-category: string,
    rule-details: transactions-rule-details
  }
  transactions-rules-create: func(params: transactions-rules-create-params) -> result<transactions-rules-create-response, string>;

  /// Return a list of rules created for the Item associated with the access token.
  record transactions-rules-list-params {
    access-token: access-token
  }
  transactions-rules-list: func(params: transactions-rules-list-params) -> result<transactions-rules-list-response, string>;

  /// Remove transaction rule
  record transactions-rules-remove-params {
    access-token: access-token,
    /// A rule's unique identifier
    rule-id: string
  }
  transactions-rules-remove: func(params: transactions-rules-remove-params) -> result<transactions-rules-remove-response, string>;

  /// enhance locally-held transaction data
  record transactions-enhance-params {
    /// The type of account for the requested transactions (`depository` or `credit`).
    account-type: string,
    /// An array of raw transactions to be enhanced.
    transactions: list<client-provided-raw-transaction>
  }
  transactions-enhance: func(params: transactions-enhance-params) -> result<transactions-enhance-get-response, string>;

  /// Get Categories
  record categories-get-params {
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  categories-get: func(params: categories-get-params) -> result<categories-get-response, string>;

  /// Retrieve an Asset Report with Freddie Mac format. Only Freddie Mac can use this endpoint.
  record credit-asset-report-freddie-mac-get-params {
    /// A token that can be shared with a third party auditor to allow them to obtain access to the Asset Report. This token should be stored securely.
    audit-copy-token: string
  }
  credit-asset-report-freddie-mac-get: func(params: credit-asset-report-freddie-mac-get-params) -> result<asset-report-freddie-get-response, string>;

  /// Create Asset or Income Report Audit Copy Token
  record credit-audit-copy-token-create-params {
    /// List of report tokens; can include at most one VOA/standard Asset Report tokens and one VOE Asset Report Token.
    report-tokens: list<string>
  }
  credit-audit-copy-token-create: func(params: credit-audit-copy-token-create-params) -> result<credit-audit-copy-token-create-response, string>;

