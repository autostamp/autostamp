  record credit-bank-income-refresh-params {
    options: option<credit-bank-income-refresh-request-options>,
    user-token: user-token
  }
  credit-bank-income-refresh: func(params: credit-bank-income-refresh-params) -> result<credit-bank-income-refresh-response, string>;

  /// Retrieve a summary of an individual's employment information
  record credit-employment-get-params {
    user-token: user-token
  }
  credit-employment-get: func(params: credit-employment-get-params) -> result<credit-employment-get-response, string>;

  /// Retrieve an Asset Report with Freddie Mac format (aka VOA - Verification Of Assets), and a Verification Of Employment (VOE) report if this one is available. Only Freddie Mac can use this endpoint.
  record credit-freddie-mac-reports-get-params {
