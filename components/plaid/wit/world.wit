  record income-verification-create-params {
    options: option<income-verification-create-request-options>,
    /// The ID of a precheck created with `/income/verification/precheck`. Will be used to improve conversion of the income verification flow.
    precheck-id: option<string>,
    /// The URL endpoint to which Plaid should send webhooks related to the progress of the income verification process.
    webhook: string
  }
  income-verification-create: func(params: income-verification-create-params) -> result<income-verification-create-response, string>;

  /// (Deprecated) Download the original documents used for income verification
  record income-verification-documents-download-params {
    access-token: option<access-token-nullable>,
    /// The document ID to download. If passed, a single document will be returned in the resulting zip file, rather than all document
    document-id: option<string>,
    /// The ID of the verification.
    income-verification-id: option<string>
  }
  income-verification-documents-download: func(params: income-verification-documents-download-params) -> result<string, string>;

  /// (Deprecated) Retrieve information from the paystubs used for income verification
  record income-verification-paystubs-get-params {
    access-token: option<access-token-nullable>,
    /// The ID of the verification for which to get paystub information.
    income-verification-id: option<string>
  }
  income-verification-paystubs-get: func(params: income-verification-paystubs-get-params) -> result<income-verification-paystubs-get-response, string>;

  /// (Deprecated) Check digital income verification eligibility and optimize conversion
  record income-verification-precheck-params {
    employer: option<income-verification-precheck-employer>,
    payroll-institution: option<income-verification-precheck-payroll-institution>,
    transactions-access-token: option<access-token-nullable>,
    /// An array of access tokens corresponding to Items belonging to the user whose eligibility is being checked. Note that if the Items specified here are not already initialized with `transactions`, providing them in this field will cause these Items to be initialized with (and billed for) the Transactions product.
    transactions-access-tokens: option<list<access-token>>,
    us-military-info: option<income-verification-precheck-military-info>,
    user: option<income-verification-precheck-user>
  }
  income-verification-precheck: func(params: income-verification-precheck-params) -> result<income-verification-precheck-response, string>;

  /// (Deprecated) Retrieve information from the tax documents used for income verification
  record income-verification-taxforms-get-params {
    access-token: option<access-token-nullable>,
    /// The ID of the verification.
    income-verification-id: option<string>
  }
  income-verification-taxforms-get: func(params: income-verification-taxforms-get-params) -> result<income-verification-taxforms-get-response, string>;

  /// Get details of all supported institutions
  record institutions-get-params {
    /// The total number of Institutions to return.
    count: s32,
    /// Specify an array of Plaid-supported country codes this institution supports, using the ISO-3166-1 alpha-2 country code standard.
    /// 
    country-codes: list<country-code>,
    /// The number of Institutions to skip.
    offset: s32,
    options: option<institutions-get-request-options>
  }
  institutions-get: func(params: institutions-get-params) -> result<institutions-get-response, string>;

  /// Get details of an institution
  record institutions-get-by-id-params {
    /// Specify an array of Plaid-supported country codes this institution supports, using the ISO-3166-1 alpha-2 country code standard. In API versions 2019-05-29 and earlier, the `country_codes` parameter is an optional parameter within the `options` object and will default to `[US]` if it is not supplied.
    country-codes: list<country-code>,
    /// The ID of the institution to get details about
    institution-id: string,
    options: option<institutions-get-by-id-request-options>
  }
  institutions-get-by-id: func(params: institutions-get-by-id-params) -> result<institutions-get-by-id-response, string>;

  /// Search institutions
  record institutions-search-params {
    /// Specify an array of Plaid-supported country codes this institution supports, using the ISO-3166-1 alpha-2 country code standard. In API versions 2019-05-29 and earlier, the `country_codes` parameter is an optional parameter within the `options` object and will default to `[US]` if it is not supplied.
    country-codes: list<country-code>,
    options: option<institutions-search-request-options>,
    /// Filter the Institutions based on whether they support all products listed in `products`. Provide `null` to get institutions regardless of supported products. Note that when `auth` is specified as a product, if you are enabled for Instant Match or Automated Micro-deposits, institutions that support those products will be returned even if `auth` is not present in their product array.
    products: list<products>,
    /// The search query. Institutions with names matching the query are returned
    query: string
  }
  institutions-search: func(params: institutions-search-params) -> result<institutions-search-response, string>;

  /// Get Investment holdings
  record investments-holdings-get-params {
    access-token: access-token,
    options: option<investment-holdings-get-request-options>
  }
  investments-holdings-get: func(params: investments-holdings-get-params) -> result<investments-holdings-get-response, string>;

  /// Get investment transactions
  record investments-transactions-get-params {
    access-token: access-token,
    /// The most recent date for which to fetch transaction history. Dates should be formatted as YYYY-MM-DD.
    end-date: string,
    options: option<investments-transactions-get-request-options>,
    /// The earliest date for which to fetch transaction history. Dates should be formatted as YYYY-MM-DD.
    start-date: string
  }
  investments-transactions-get: func(params: investments-transactions-get-params) -> result<investments-transactions-get-response, string>;

  /// Invalidate access_token
