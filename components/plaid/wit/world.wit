  liabilities-get: func(params: liabilities-get-params) -> result<string, string>;

  /// Exchange the Link Correlation Id for a Link Token
  record link-oauth-correlation-id-exchange-params {
    /// A `link_correlation_id` from a received OAuth redirect URI callback
    link-correlation-id: string
  }
  link-oauth-correlation-id-exchange: func(params: link-oauth-correlation-id-exchange-params) -> result<string, string>;

  /// Create Link Token
  record link-token-create-params {
    /// The `access_token` associated with the Item to update or reference, used when updating, modifying, or accessing an existing `access_token`. Used when launching Link in update mode, when completing the Same-day (manual) Micro-deposit flow, or (optionally) when initializing Link for a returning user as part of the Transfer UI flow.
    access-token: option<string>,
    account-filters: option<link-token-account-filters>,
    /// (Beta) This field has no effect unless you are participating in the Product Scope Transparency beta program.
    /// List of additional Plaid product(s) you wish to collect consent for. These products will not be billed until you start using them by calling the relevant endpoints.
    additional-consented-products: option<list<products>>,
    /// The name of your app's Android package. Required if using the `link_token` to initialize Link on Android. Any package name specified here must also be added to the Allowed Android package names setting on the [developer dashboard](https://dashboard.plaid.com/team/api). When creating a `link_token` for initializing Link on other platforms, `android_package_name` must be left blank and `redirect_uri` should be used instead.
    android-package-name: option<string>,
    auth: option<link-token-create-request-auth>,
    /// The name of your application, as it should be displayed in Link. Maximum length of 30 characters. If a value longer than 30 characters is provided, Link will display "This Application" instead.
    client-name: string,
    /// Specify an array of Plaid-supported country codes using the ISO-3166-1 alpha-2 country code standard. Institutions from all listed countries will be shown. For a complete mapping of supported products by country, see https://plaid.com/global/.
    /// 
    country-codes: list<country-code>,
    deposit-switch: option<link-token-create-request-deposit-switch>,
    employment: option<link-token-create-request-employment>,
    eu-config: option<link-token-eu-config>,
    identity-verification: option<link-token-create-request-identity-verification>,
    income-verification: option<link-token-create-request-income-verification>,
    institution-data: option<link-token-create-institution-data>,
    /// Used for certain Europe-only configurations, as well as certain legacy use cases in other regions.
    institution-id: option<string>,
    investments: option<link-token-investments>,
    /// The language that Link should be displayed in. When initializing with Identity Verification, this field is not used; for more details, see [Identity Verification supported languages](https://www.plaid.com/docs/identity-verification/#supported-languages).
    /// 
    language: string,
    /// The name of the Link customization from the Plaid Dashboard to be applied to Link. If not specified, the `default` customization will be used. When using a Link customization, the language in the customization must match the language selected via the `language` parameter, and the countries in the customization should match the country codes selected via `country_codes`.
    link-customization-name: option<string>,
    payment-initiation: option<link-token-create-request-payment-initiation>,
    /// List of Plaid product(s) you wish to use. If launching Link in update mode, should be omitted (unless you are using update mode to add Income or Assets to an Item); required otherwise.
    /// 
    products: option<list<products>>,
    /// A URI indicating the destination where a user should be forwarded after completing the Link flow; used to support OAuth authentication flows when launching Link in the browser or via a webview. The `redirect_uri` should not contain any query parameters. When used in Production or Development, must be an https URI. To specify any subdomain, use `*` as a wildcard character, e.g. `https://*.example.com/oauth.html`. Note that any redirect URI must also be added to the Allowed redirect URIs list in the [developer dashboard](https://dashboard.plaid.com/team/api). If initializing on Android, `android_package_name` must be specified instead and `redirect_uri` should be left blank.
    redirect-uri: option<string>,
    transfer: option<link-token-create-request-transfer>,
    update: option<link-token-create-request-update>,
    user: link-token-create-request-user,
    /// A user token generated using `/user/create`. Any Item created during the Link session will be associated with the user.
    user-token: option<string>,
    /// The destination URL to which any webhooks should be sent. Note that webhooks for Payment Initiation (e-wallet transactions only), Transfer, Bank Transfer (including Auth micro-deposit notification webhooks) and Identity Verification are configured via the Dashboard instead.
    webhook: option<string>
  }
  link-token-create: func(params: link-token-create-params) -> result<string, string>;

  /// Get Link Token
  record link-token-get-params {
    /// A `link_token` from a previous invocation of `/link/token/create`
    link-token: string
  }
  link-token-get: func(params: link-token-get-params) -> result<string, string>;

  /// Create Link Delivery session
  record link-delivery-create-params {
    /// A `link_token` from a previous invocation of `/link/token/create` with Link Delivery enabled.
    link-token: string,
    options: option<link-delivery-options>
  }
  link-delivery-create: func(params: link-delivery-create-params) -> result<string, string>;

  /// Get Link Delivery session
  record link-delivery-get-params {
    /// The ID for the Link Delivery session from a previous invocation of `/link_delivery/create`.
    link-delivery-session-id: string
  }
  link-delivery-get: func(params: link-delivery-get-params) -> result<string, string>;

  /// Creates a new end customer for a Plaid reseller.
  record partner-customer-create-params {
    address: partner-end-customer-address,
    /// The name of the end customer's application. This will be shown to end users when they go through the Plaid Link flow.
    application-name: string,
    assets-under-management: option<partner-end-customer-assets-under-management>,
    billing-contact: option<partner-end-customer-billing-contact>,
    /// The company name of the end customer being created. This will be used to display the end customer in the Plaid Dashboard. It will not be shown to end users.
    company-name: string,
    /// If `true`, the end customer's default Link customization will be set to match the partner's. You can always change the end customer's Link customization in the Plaid Dashboard. See the [Link Customization docs](https://plaid.com/docs/link/customization/) for more information.
    create-link-customization: option<bool>,
    customer-support-info: option<partner-end-customer-customer-support-info>,
    /// Denotes whether the partner has forwarded the Plaid bank addendum to the end customer.
    is-bank-addendum-completed: bool,
    /// Denotes whether or not the partner has completed attestation of diligence for the end customer to be created.
    is-diligence-attested: bool,
    /// The end customer's legal name. This will be shared with financial institutions as part of the OAuth registration process. It will not be shown to end users.
    legal-entity-name: string,
    /// Base64-encoded representation of the end customer's logo. Must be a PNG of size 1024x1024 under 4MB. The logo will be shared with financial institutions and shown to the end user during Link flows. A logo is required if `create_link_customization` is `true`. If `create_link_customization` is `false` and the logo is omitted, a stock logo will be used.
    logo: option<string>,
    /// The products to be enabled for the end customer.
    products: list<products>,
    /// A list of URIs indicating the destination(s) where a user can be forwarded after completing the Link flow; used to support OAuth authentication flows when launching Link in the browser or via a webview. URIs should not contain any query parameters. When used in Production or Development, URIs must use https. To specify any subdomain, use `*` as a wildcard character, e.g. `https://*.example.com/oauth.html`. To modify redirect URIs for an end customer after creating them, go to the end customer's [API page](https://dashboard.plaid.com/team/api) in the Dashboard.
    redirect-uris: option<list<string>>,
    technical-contact: option<partner-end-customer-technical-contact>,
    /// The end customer's website.
    website: string
  }
  partner-customer-create: func(params: partner-customer-create-params) -> result<string, string>;

  /// Enables a Plaid reseller's end customer in the Production environment.
  record partner-customer-enable-params {
    end-customer-client-id: string
  }
  partner-customer-enable: func(params: partner-customer-enable-params) -> result<string, string>;

  /// Returns a Plaid reseller's end customer.
  record partner-customer-get-params {
    end-customer-client-id: string
  }
  partner-customer-get: func(params: partner-customer-get-params) -> result<string, string>;

  /// Returns OAuth-institution registration information for a given end customer.
  record partner-customer-oauth-institutions-get-params {
    end-customer-client-id: string
  }
  partner-customer-oauth-institutions-get: func(params: partner-customer-oauth-institutions-get-params) -> result<string, string>;

  /// Removes a Plaid reseller's end customer.
  record partner-customer-remove-params {
    end-customer-client-id: string
  }
  partner-customer-remove: func(params: partner-customer-remove-params) -> result<string, string>;

  /// Create payment consent
  record payment-initiation-consent-create-params {
    constraints: payment-initiation-consent-constraints,
    options: option<external-payment-initiation-consent-options>,
    /// The ID of the recipient the payment consent is for. The created consent can be used to transfer funds to this recipient only.
    recipient-id: string,
    /// A reference for the payment consent. This must be an alphanumeric string with at most 18 characters and must not contain any special characters.
    reference: string,
    /// An array of payment consent scopes.
    scopes: list<payment-initiation-consent-scope>
  }
  payment-initiation-consent-create: func(params: payment-initiation-consent-create-params) -> result<string, string>;

  /// Get payment consent
  record payment-initiation-consent-get-params {
    /// The `consent_id` returned from `/payment_initiation/consent/create`.
    consent-id: string
  }
  payment-initiation-consent-get: func(params: payment-initiation-consent-get-params) -> result<string, string>;

  /// Execute a single payment using consent
  record payment-initiation-consent-payment-execute-params {
    amount: payment-amount,
    /// The consent ID.
    consent-id: string,
    idempotency-key: consent-payment-idempotency-key
  }
  payment-initiation-consent-payment-execute: func(params: payment-initiation-consent-payment-execute-params) -> result<string, string>;

  /// Revoke payment consent
  record payment-initiation-consent-revoke-params {
    /// The consent ID.
    consent-id: string
  }
  payment-initiation-consent-revoke: func(params: payment-initiation-consent-revoke-params) -> result<string, string>;

  /// Create a payment
  record payment-initiation-payment-create-params {
    amount: payment-amount,
    options: option<external-payment-options>,
    /// The ID of the recipient the payment is for.
    recipient-id: string,
    /// A reference for the payment. This must be an alphanumeric string with at most 18 characters and must not contain any special characters (since not all institutions support them).
    /// In order to track settlement via Payment Confirmation, each payment must have a unique reference. If the reference provided through the API is not unique, Plaid will adjust it.
    reference: string,
    schedule: option<external-payment-schedule-request>
  }
  payment-initiation-payment-create: func(params: payment-initiation-payment-create-params) -> result<string, string>;

  /// Get payment details
  record payment-initiation-payment-get-params {
    /// The `payment_id` returned from `/payment_initiation/payment/create`.
    payment-id: string
  }
  payment-initiation-payment-get: func(params: payment-initiation-payment-get-params) -> result<string, string>;

  /// List payments
  record payment-initiation-payment-list-params {
    /// The consent ID. If specified, only payments, executed using this consent, will be returned.
    consent-id: option<string>,
    /// The maximum number of payments to return. If `count` is not specified, a maximum of 10 payments will be returned, beginning with the most recent payment before the cursor (if specified).
    count: option<s32>,
    /// A string in RFC 3339 format (i.e. "2019-12-06T22:35:49Z"). Only payments created before the cursor will be returned.
    cursor: option<string>
  }
  payment-initiation-payment-list: func(params: payment-initiation-payment-list-params) -> result<string, string>;

  /// Reverse an existing payment
  record payment-initiation-payment-reverse-params {
    amount: option<payment-amount-to-refund>,
    idempotency-key: wallet-transaction-idempotency-key,
    /// The ID of the payment to reverse
    payment-id: string,
    /// A reference for the refund. This must be an alphanumeric string with 6 to 18 characters and must not contain any special characters or spaces.
    reference: string
  }
  payment-initiation-payment-reverse: func(params: payment-initiation-payment-reverse-params) -> result<string, string>;

  /// Create payment token
  record create-payment-token-params {
    /// The `payment_id` returned from `/payment_initiation/payment/create`.
    payment-id: string
  }
  create-payment-token: func(params: create-payment-token-params) -> result<string, string>;

  /// Create payment recipient
  record payment-initiation-recipient-create-params {
    address: option<payment-initiation-address>,
    bacs: option<recipient-bacs-nullable>,
    /// The International Bank Account Number (IBAN) for the recipient. If BACS data is not provided, an IBAN is required.
    iban: option<string>,
    /// The name of the recipient. We recommend using strings of length 18 or less and avoid special characters to ensure compatibility with all institutions.
    name: string
  }
  payment-initiation-recipient-create: func(params: payment-initiation-recipient-create-params) -> result<string, string>;

  /// Get payment recipient
  record payment-initiation-recipient-get-params {
    /// The ID of the recipient
    recipient-id: string
  }
  payment-initiation-recipient-get: func(params: payment-initiation-recipient-get-params) -> result<string, string>;

  /// List payment recipients
  payment-initiation-recipient-list: func() -> result<string, string>;

  /// Create payment profile
  payment-profile-create: func() -> result<string, string>;

  /// Get payment profile
  record payment-profile-get-params {
    payment-profile-token: payment-profile-token
  }
  payment-profile-get: func(params: payment-profile-get-params) -> result<string, string>;

  /// Remove payment profile
  record payment-profile-remove-params {
    payment-profile-token: payment-profile-token
  }
  payment-profile-remove: func(params: payment-profile-remove-params) -> result<string, string>;

  /// Create Apex bank account token
  record processor-apex-processor-token-create-params {
    access-token: access-token,
    /// The `account_id` value obtained from the `onSuccess` callback in Link
    account-id: string
  }
  processor-apex-processor-token-create: func(params: processor-apex-processor-token-create-params) -> result<string, string>;

  /// Retrieve Auth data
  record processor-auth-get-params {
    processor-token: processor-token
  }
  processor-auth-get: func(params: processor-auth-get-params) -> result<string, string>;

  /// Retrieve Balance data
  record processor-balance-get-params {
    options: option<processor-balance-get-request-options>,
    processor-token: processor-token
  }
  processor-balance-get: func(params: processor-balance-get-params) -> result<string, string>;

  /// Create a bank transfer as a processor
  record processor-bank-transfer-create-params {
    ach-class: option<ach-class>,
    amount: bank-transfer-amount,
    /// An arbitrary string provided by the client for storage with the bank transfer. May be up to 100 characters.
    custom-tag: option<string>,
    /// The transfer description. Maximum of 10 characters.
    description: string,
    idempotency-key: bank-transfer-idempotency-key,
    /// The currency of the transfer amount – should be set to "USD".
    iso-currency-code: string,
    metadata: option<bank-transfer-metadata>,
    network: bank-transfer-network,
    /// Plaid’s unique identifier for the origination account for this transfer. If you have more than one origination account, this value must be specified.
    origination-account-id: option<string>,
    processor-token: processor-token,
    type-op: bank-transfer-type,
    user: bank-transfer-user
  }
  processor-bank-transfer-create: func(params: processor-bank-transfer-create-params) -> result<string, string>;

  /// Retrieve Identity data
  record processor-identity-get-params {
    processor-token: processor-token
  }
  processor-identity-get: func(params: processor-identity-get-params) -> result<string, string>;

  /// Report whether you initiated an ACH transaction
  record processor-signal-decision-report-params {
    /// The amount (in USD) made available to your customers instantly following the debit transaction. It could be a partial amount of the requested transaction (example: 102.05).
    amount-instantly-available: option<f64>,
    /// Must be the same as the `client_transaction_id` supplied when calling `/signal/evaluate`
    client-transaction-id: string,
    /// The actual number of days (hold time) since the ACH debit transaction that you wait before making funds available to your customers. The holding time could affect the ACH return rate.
    /// 
    days-funds-on-hold: option<s32>,
    decision-outcome: option<signal-decision-outcome>,
    /// `true` if the ACH transaction was initiated, `false` otherwise.
    /// 
    initiated: bool,
    payment-method: option<signal-payment-method>,
    processor-token: processor-token
  }
  processor-signal-decision-report: func(params: processor-signal-decision-report-params) -> result<string, string>;

  /// Evaluate a planned ACH transaction
  record processor-signal-evaluate-params {
    /// The transaction amount, in USD (e.g. `102.05`)
    amount: f64,
    /// The unique ID that you would like to use to refer to this transaction. For your convenience mapping your internal data, you could use your internal ID/identifier for this transaction. The max length for this field is 36 characters.
    client-transaction-id: string,
    /// A unique ID that identifies the end user in your system. This ID is used to correlate requests by a user with multiple Items. The max length for this field is 36 characters. Personally identifiable information, such as an email address or phone number, should not be used in the `client_user_id`.
    client-user-id: option<string>,
    /// The default ACH or non-ACH payment method to complete the transaction.
    /// `SAME_DAY_ACH`: Same Day ACH by NACHA. The debit transaction is processed and settled on the same day
    default-payment-method: option<string>,
    device: option<signal-device>,
    /// **true** if the ACH transaction is a recurring transaction; **false** otherwise 
    is-recurring: option<bool>,
    processor-token: processor-token,
    user: option<signal-user>,
    /// `true` if the end user is present while initiating the ACH transfer and the endpoint is being called; `false` otherwise (for example, when the ACH transfer is scheduled and the end user is not present, or you call this endpoint after the ACH transfer but before submitting the Nacha file for ACH processing).
    user-present: option<bool>
  }
  processor-signal-evaluate: func(params: processor-signal-evaluate-params) -> result<string, string>;

  /// Report a return for an ACH transaction
  record processor-signal-return-report-params {
    /// Must be the same as the `client_transaction_id` supplied when calling `/processor/signal/evaluate`
    client-transaction-id: string,
    processor-token: processor-token,
    /// Must be a valid ACH return code (e.g. "R01")
    /// 
    return-code: string,
    /// Date and time when you receive the returns from your payment processors, in ISO 8601 format (`YYYY-MM-DDTHH:mm:ssZ`).
    returned-at: option<string>
  }
  processor-signal-return-report: func(params: processor-signal-return-report-params) -> result<string, string>;

  /// Create Stripe bank account token
  record processor-stripe-bank-account-token-create-params {
    access-token: access-token,
    /// The `account_id` value obtained from the `onSuccess` callback in Link
    account-id: string
  }
  processor-stripe-bank-account-token-create: func(params: processor-stripe-bank-account-token-create-params) -> result<string, string>;

  /// Create processor token
  record processor-token-create-params {
    access-token: access-token,
    /// The `account_id` value obtained from the `onSuccess` callback in Link
    account-id: string,
    /// The processor you are integrating with.
    processor: processor-token-create-request-processor-enum
  }
  processor-token-create: func(params: processor-token-create-params) -> result<string, string>;

  /// Manually fire a Bank Transfer webhook
  record sandbox-bank-transfer-fire-webhook-params {
    /// The URL to which the webhook should be sent.
    webhook: string
  }
  sandbox-bank-transfer-fire-webhook: func(params: sandbox-bank-transfer-fire-webhook-params) -> result<string, string>;

  /// Simulate a bank transfer event in Sandbox
  record sandbox-bank-transfer-simulate-params {
    bank-transfer-id: bank-transfer-id,
