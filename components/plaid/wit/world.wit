    failure-reason: option<bank-transfer-failure>
  }
  sandbox-bank-transfer-simulate: func(params: sandbox-bank-transfer-simulate-params) -> result<string, string>;

  /// Manually fire an Income webhook
  record sandbox-income-fire-webhook-params {
    /// The Item ID associated with the verification.
    item-id: string,
    user-id: option<user-id>,
    /// `VERIFICATION_STATUS_PROCESSING_COMPLETE`: The income verification status processing has completed. If the user uploaded multiple documents, this webhook will fire when all documents have finished processing. Call the `/income/verification/paystubs/get` endpoint and check the document metadata to see which documents were successfully parsed.
    /// 
    verification-status: sandbox-income-fire-webhook-request-verification-status-enum,
    /// The URL to which the webhook should be sent.
    webhook: string
  }
  sandbox-income-fire-webhook: func(params: sandbox-income-fire-webhook-params) -> result<string, string>;

  /// Fire a test webhook
  record sandbox-item-fire-webhook-params {
    access-token: access-token,
    /// The webhook codes that can be fired by this test endpoint.
    webhook-code: sandbox-item-fire-webhook-request-webhook-code-enum,
    webhook-type: option<webhook-type>
  }
  sandbox-item-fire-webhook: func(params: sandbox-item-fire-webhook-params) -> result<string, string>;

  /// Force a Sandbox Item into an error state
  record sandbox-item-reset-login-params {
    access-token: access-token
  }
  sandbox-item-reset-login: func(params: sandbox-item-reset-login-params) -> result<string, string>;

  /// Set verification status for Sandbox account
  record sandbox-item-set-verification-status-params {
    access-token: access-token,
    /// The `account_id` of the account whose verification status is to be modified
    account-id: string,
    /// The verification status to set the account to.
    verification-status: sandbox-item-set-verification-status-request-verification-status-enum
  }
  sandbox-item-set-verification-status: func(params: sandbox-item-set-verification-status-params) -> result<string, string>;

  /// Save the selected accounts when connecting to the Platypus Oauth institution
  record sandbox-oauth-select-accounts-params {
    accounts: list<string>,
    oauth-state-id: string
  }
  sandbox-oauth-select-accounts: func(params: sandbox-oauth-select-accounts-params) -> result<string, string>;

  /// Reset the login of a Payment Profile
  record sandbox-payment-profile-reset-login-params {
    payment-profile-token: payment-profile-token
  }
  sandbox-payment-profile-reset-login: func(params: sandbox-payment-profile-reset-login-params) -> result<string, string>;

  /// Create a test Item and processor token
  record sandbox-processor-token-create-params {
    /// The ID of the institution the Item will be associated with
    institution-id: string,
    options: option<sandbox-processor-token-create-request-options>
  }
  sandbox-processor-token-create: func(params: sandbox-processor-token-create-params) -> result<string, string>;

  /// Create a test Item
  record sandbox-public-token-create-params {
    /// The products to initially pull for the Item. May be any products that the specified `institution_id`  supports. This array may not be empty.
    initial-products: list<products>,
    /// The ID of the institution the Item will be associated with
    institution-id: string,
    options: option<sandbox-public-token-create-request-options>,
    user-token: option<user-token>
  }
  sandbox-public-token-create: func(params: sandbox-public-token-create-params) -> result<string, string>;

  /// Manually fire a Transfer webhook
  record sandbox-transfer-fire-webhook-params {
    /// The URL to which the webhook should be sent.
    webhook: string
  }
  sandbox-transfer-fire-webhook: func(params: sandbox-transfer-fire-webhook-params) -> result<string, string>;

  /// Trigger the creation of a repayment
  sandbox-transfer-repayment-simulate: func() -> result<string, string>;

  /// Simulate a transfer event in Sandbox
  record sandbox-transfer-simulate-params {
    /// The asynchronous event to be simulated. May be: `posted`, `settled`, `failed`, or `returned`.
    /// 
    event-type: string,
    failure-reason: option<transfer-failure>,
    transfer-id: transfer-id
  }
  sandbox-transfer-simulate: func(params: sandbox-transfer-simulate-params) -> result<string, string>;

  /// Simulate creating a sweep
  sandbox-transfer-sweep-simulate: func() -> result<string, string>;

  /// Advance a test clock
  record sandbox-transfer-test-clock-advance-params {
    new-virtual-time: virtual-time,
    test-clock-id: transfer-test-clock-id
  }
  sandbox-transfer-test-clock-advance: func(params: sandbox-transfer-test-clock-advance-params) -> result<string, string>;

  /// Create a test clock
  record sandbox-transfer-test-clock-create-params {
    virtual-time: virtual-time
  }
  sandbox-transfer-test-clock-create: func(params: sandbox-transfer-test-clock-create-params) -> result<string, string>;

  /// Get a test clock
  record sandbox-transfer-test-clock-get-params {
    test-clock-id: transfer-test-clock-id
  }
  sandbox-transfer-test-clock-get: func(params: sandbox-transfer-test-clock-get-params) -> result<string, string>;

  /// List test clocks
  record sandbox-transfer-test-clock-list-params {
    /// The maximum number of test clocks to return.
    count: option<s32>,
    /// The end virtual timestamp of test clocks to return. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    end-virtual-time: option<string>,
    /// The number of test clocks to skip before returning results.
    offset: option<s32>,
    /// The start virtual timestamp of test clocks to return. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    start-virtual-time: option<string>
  }
  sandbox-transfer-test-clock-list: func(params: sandbox-transfer-test-clock-list-params) -> result<string, string>;

  /// Report whether you initiated an ACH transaction
  record signal-decision-report-params {
    /// The amount (in USD) made available to your customers instantly following the debit transaction. It could be a partial amount of the requested transaction (example: 102.05).
    amount-instantly-available: option<f64>,
    /// Must be the same as the `client_transaction_id` supplied when calling `/signal/evaluate`
    client-transaction-id: string,
    /// The actual number of days (hold time) since the ACH debit transaction that you wait before making funds available to your customers. The holding time could affect the ACH return rate.
    /// 
    days-funds-on-hold: option<s32>,
    decision-outcome: option<signal-decision-outcome>,
    /// `true` if the ACH transaction was initiated, `false` otherwise.
    /// 
    initiated: bool,
    payment-method: option<signal-payment-method>
  }
  signal-decision-report: func(params: signal-decision-report-params) -> result<string, string>;

  /// Evaluate a planned ACH transaction
  record signal-evaluate-params {
    access-token: access-token,
    /// The Plaid `account_id` of the account that is the funding source for the proposed transaction. The `account_id` is returned in the `/accounts/get` endpoint as well as the [`onSuccess`](/docs/link/ios/#link-ios-onsuccess-linkSuccess-metadata-accounts-id) callback metadata.
    /// 
    account-id: string,
    /// The transaction amount, in USD (e.g. `102.05`)
    amount: f64,
    /// The unique ID that you would like to use to refer to this transaction. For your convenience mapping your internal data, you could use your internal ID/identifier for this transaction. The max length for this field is 36 characters.
    client-transaction-id: string,
    /// A unique ID that identifies the end user in your system. This ID is used to correlate requests by a user with multiple Items. The max length for this field is 36 characters. Personally identifiable information, such as an email address or phone number, should not be used in the `client_user_id`.
    client-user-id: option<string>,
    /// The default ACH or non-ACH payment method to complete the transaction.
    /// `SAME_DAY_ACH`: Same Day ACH by NACHA. The debit transaction is processed and settled on the same day
    default-payment-method: option<string>,
    device: option<signal-device>,
    /// `true` if the ACH transaction is a recurring transaction; `false` otherwise 
    is-recurring: option<bool>,
    user: option<signal-user>,
    /// `true` if the end user is present while initiating the ACH transfer and the endpoint is being called; `false` otherwise (for example, when the ACH transfer is scheduled and the end user is not present, or you call this endpoint after the ACH transfer but before submitting the Nacha file for ACH processing).
    user-present: option<bool>
  }
  signal-evaluate: func(params: signal-evaluate-params) -> result<string, string>;

  /// Opt-in an Item to Signal
  record signal-prepare-params {
    access-token: access-token
  }
  signal-prepare: func(params: signal-prepare-params) -> result<string, string>;

  /// Report a return for an ACH transaction
  record signal-return-report-params {
    /// Must be the same as the `client_transaction_id` supplied when calling `/signal/evaluate`
    client-transaction-id: string,
    /// Must be a valid ACH return code (e.g. "R01")
    /// 
    return-code: string,
    /// Date and time when you receive the returns from your payment processors, in ISO 8601 format (`YYYY-MM-DDTHH:mm:ssZ`).
    returned-at: option<string>
  }
  signal-return-report: func(params: signal-return-report-params) -> result<string, string>;

  /// Enrich locally-held transaction data
  record transactions-enrich-params {
    /// The account type for the requested transactions (either `depository` or `credit`).
    account-type: string,
    options: option<transactions-enrich-request-options>,
    /// An array of transaction objects to be enriched by Plaid. Maximum of 100 transactions per request.
    transactions: list<client-provided-transaction>
  }
  transactions-enrich: func(params: transactions-enrich-params) -> result<string, string>;

  /// Get transaction data
  record transactions-get-params {
    access-token: access-token,
    /// The latest date for which data should be returned. Dates should be formatted as YYYY-MM-DD.
    end-date: string,
    options: option<transactions-get-request-options>,
    /// The earliest date for which data should be returned. Dates should be formatted as YYYY-MM-DD.
    start-date: string
  }
  transactions-get: func(params: transactions-get-params) -> result<string, string>;

  /// Fetch recurring transaction streams
  record transactions-recurring-get-params {
    access-token: access-token,
    /// A list of `account_ids` to retrieve for the Item
    /// 
    account-ids: list<string>,
    options: option<transactions-recurring-get-request-options>
  }
  transactions-recurring-get: func(params: transactions-recurring-get-params) -> result<string, string>;

  /// Refresh transaction data
  record transactions-refresh-params {
    access-token: access-token
  }
  transactions-refresh: func(params: transactions-refresh-params) -> result<string, string>;

  /// Get incremental transaction updates on an Item
  record transactions-sync-params {
    access-token: access-token,
    /// The number of transaction updates to fetch.
    count: option<s32>,
    /// The cursor value represents the last update requested. Providing it will cause the response to only return changes after this update.
    /// If omitted, the entire history of updates will be returned, starting with the first-added transactions on the item.
    cursor: option<string>,
    options: option<transactions-sync-request-options>
  }
  transactions-sync: func(params: transactions-sync-params) -> result<string, string>;

  /// Create a transfer authorization
  record transfer-authorization-create-params {
    access-token: option<transfer-access-token>,
    account-id: option<transfer-account-id>,
    ach-class: option<ach-class>,
    amount: transfer-amount,
    /// The unique identifier returned by Plaid's [beacon](https://plaid.com/docs/transfer/guarantee/#using-a-beacon) when it is run on your webpage. Required for Guarantee customers who are not using [Transfer UI](https://plaid.com/docs/transfer/using-transfer-ui/) and have a web checkout experience.
    beacon-session-id: option<string>,
    device: option<transfer-authorization-device>,
    funding-account-id: option<transfer-funding-account-id-request>,
    idempotency-key: option<transfer-authorization-idempotency-key>,
    /// The currency of the transfer amount. The default value is "USD".
    iso-currency-code: option<string>,
    network: transfer-network,
    /// Plaid's unique identifier for the origination account for this authorization. If not specified, the default account will be used.
    origination-account-id: option<string>,
    /// The Plaid client ID that is the originator of this transfer. Only needed if creating transfers on behalf of another client as a third-party sender (TPS).
    originator-client-id: option<string>,
    payment-profile-token: option<transfer-payment-profile-token>,
    type-op: transfer-type,
    user: transfer-authorization-user-in-request,
    /// Required for Guarantee. If the end user is initiating the specific transfer themselves via an interactive UI, this should be `true`; for automatic recurring payments where the end user is not actually initiating each individual transfer, it should be `false`.
    user-present: option<bool>,
    /// If set to `false`, Plaid will not offer a `guarantee_decision` for this request(Guarantee customers only).
    with-guarantee: option<bool>
  }
  transfer-authorization-create: func(params: transfer-authorization-create-params) -> result<string, string>;

  /// Cancel a transfer
  record transfer-cancel-params {
    /// The Plaid client ID of the transfer originator. Should only be present if `client_id` is a third-party sender (TPS).
    originator-client-id: option<string>,
    transfer-id: transfer-id
  }
  transfer-cancel: func(params: transfer-cancel-params) -> result<string, string>;

  /// Get RTP eligibility information of a transfer
  record transfer-capabilities-get-params {
    access-token: option<transfer-access-token>,
    account-id: option<transfer-account-id>,
    payment-profile-token: option<payment-profile-token>
  }
  transfer-capabilities-get: func(params: transfer-capabilities-get-params) -> result<string, string>;

  /// Get transfer product configuration
  record transfer-configuration-get-params {
    /// The Plaid client ID of the transfer originator. Should only be present if `client_id` is a third-party sender (TPS).
    originator-client-id: option<string>
  }
  transfer-configuration-get: func(params: transfer-configuration-get-params) -> result<string, string>;

  /// Create a transfer
  record transfer-create-params {
    access-token: option<transfer-access-token>,
    account-id: option<transfer-account-id>,
    ach-class: option<string>,
    amount: option<transfer-amount>,
    /// Plaid’s unique identifier for a transfer authorization. This parameter also serves the purpose of acting as an idempotency identifier.
    authorization-id: string,
    /// The transfer description. Maximum of 10 characters. If reprocessing a returned transfer, please note that the `description` field must be `"Retry"` to indicate that it's a retry of a previously returned transfer. You may retry a transfer up to 2 times, within 180 days of creating the original transfer. Only transfers that were returned with code `R01` or `R09` may be retried. For a full listing of ACH return codes, see [Transfer errors](https://plaid.com/docs/errors/transfer/#ach-return-codes).
    description: string,
    idempotency-key: option<transfer-create-idempotency-key>,
    /// The currency of the transfer amount. The default value is "USD".
    iso-currency-code: option<string>,
    metadata: option<transfer-metadata>,
    network: option<string>,
    /// Plaid’s unique identifier for the origination account for this transfer. If you have more than one origination account, this value must be specified. Otherwise, this field should be left blank.
    origination-account-id: option<string>,
    payment-profile-token: option<transfer-payment-profile-token>,
    type-op: option<string>,
    user: option<transfer-user-in-request-deprecated>
  }
  transfer-create: func(params: transfer-create-params) -> result<string, string>;

  /// List transfer events
  record transfer-event-list-params {
    /// The account ID to get events for all transactions to/from an account.
    account-id: option<string>,
    /// The maximum number of transfer events to return. If the number of events matching the above parameters is greater than `count`, the most recent events will be returned.
    count: option<s32>,
    /// The end datetime of transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    end-date: option<string>,
    /// Filter events by event type.
    event-types: option<list<transfer-event-type>>,
    /// Filter transfer events to only those with the specified `funding_account_id`.
    funding-account-id: option<string>,
    /// The offset into the list of transfer events. When `count`=25 and `offset`=0, the first 25 events will be returned. When `count`=25 and `offset`=25, the next 25 events will be returned.
    offset: option<s32>,
    /// The origination account ID to get events for transfers from a specific origination account.
    origination-account-id: option<string>,
    /// Filter transfer events to only those with the specified originator client.
    originator-client-id: option<string>,
    /// The start datetime of transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    start-date: option<string>,
    /// Plaid’s unique identifier for a sweep.
    sweep-id: option<string>,
    /// Plaid’s unique identifier for a transfer.
    transfer-id: option<string>,
    transfer-type: option<transfer-event-list-transfer-type>
  }
  transfer-event-list: func(params: transfer-event-list-params) -> result<string, string>;

  /// Sync transfer events
  record transfer-event-sync-params {
    /// The latest (largest) `event_id` fetched via the sync endpoint, or 0 initially.
    after-id: s32,
    /// The maximum number of transfer events to return.
    count: option<s32>
  }
  transfer-event-sync: func(params: transfer-event-sync-params) -> result<string, string>;

  /// Retrieve a transfer
  record transfer-get-params {
    /// The Plaid client ID of the transfer originator. Should only be present if `client_id` is a third-party sender (TPS).
    originator-client-id: option<string>,
    transfer-id: transfer-id
  }
  transfer-get: func(params: transfer-get-params) -> result<string, string>;

  /// Create a transfer intent object to invoke the Transfer UI
  record transfer-intent-create-params {
    /// The Plaid `account_id` corresponding to the end-user account that will be debited or credited.
    account-id: option<string>,
    ach-class: option<ach-class>,
    amount: transfer-amount,
    /// A description for the underlying transfer. Maximum of 8 characters.
    description: string,
    funding-account-id: option<transfer-funding-account-id-request>,
    /// The currency of the transfer amount, e.g. "USD"
    iso-currency-code: option<string>,
    metadata: option<transfer-metadata>,
    mode: transfer-intent-create-mode,
    network: option<transfer-intent-create-network>,
    /// Plaid’s unique identifier for the origination account for the intent. If not provided, the default account will be used.
    origination-account-id: option<string>,
    /// When `true`, the transfer requires a `GUARANTEED` decision by Plaid to proceed (Guarantee customers only).
    require-guarantee: option<bool>,
    user: transfer-user-in-request
  }
  transfer-intent-create: func(params: transfer-intent-create-params) -> result<string, string>;

  /// Retrieve more information about a transfer intent
  record transfer-intent-get-params {
    /// Plaid's unique identifier for a transfer intent object.
    transfer-intent-id: string
  }
  transfer-intent-get: func(params: transfer-intent-get-params) -> result<string, string>;

  /// List transfers
  record transfer-list-params {
    /// The maximum number of transfers to return.
    count: option<s32>,
    /// The end datetime of transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    end-date: option<string>,
    /// Filter transfers to only those with the specified `funding_account_id`.
    funding-account-id: option<string>,
    /// The number of transfers to skip before returning results.
    offset: option<s32>,
    /// Filter transfers to only those originated through the specified origination account.
    origination-account-id: option<string>,
    /// Filter transfers to only those with the specified originator client.
    originator-client-id: option<string>,
    /// The start datetime of transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    start-date: option<string>
  }
  transfer-list: func(params: transfer-list-params) -> result<string, string>;

  /// Get transfer product usage metrics
  record transfer-metrics-get-params {
    /// The Plaid client ID of the transfer originator. Should only be present if `client_id` is a third-party sender (TPS).
    originator-client-id: option<string>
  }
  transfer-metrics-get: func(params: transfer-metrics-get-params) -> result<string, string>;

  /// Migrate account into Transfers
  record transfer-migrate-account-params {
    /// The user's account number.
    account-number: string,
    /// The type of the bank account (`checking` or `savings`).
    account-type: string,
    /// The user's routing number.
    routing-number: string,
    /// The user's wire transfer routing number. This is the ABA number; for some institutions, this may differ from the ACH number used in `routing_number`.
    wire-routing-number: option<string>
  }
  transfer-migrate-account: func(params: transfer-migrate-account-params) -> result<string, string>;

  /// Create a new originator
  record transfer-originator-create-params {
    /// The company name of the end customer being created. This will be displayed in public-facing surfaces, e.g. Plaid Dashboard.
    company-name: string
  }
  transfer-originator-create: func(params: transfer-originator-create-params) -> result<string, string>;

  /// Get status of an originator's onboarding
  record transfer-originator-get-params {
    /// Client ID of the end customer (i.e. the originator).
    originator-client-id: string
  }
  transfer-originator-get: func(params: transfer-originator-get-params) -> result<string, string>;

  /// Get status of all originators' onboarding
  record transfer-originator-list-params {
    /// The maximum number of originators to return.
    count: option<s32>,
    /// The number of originators to skip before returning results.
    offset: option<s32>
  }
  transfer-originator-list: func(params: transfer-originator-list-params) -> result<string, string>;

  /// Generate a Plaid-hosted onboarding UI URL.
  record transfer-questionnaire-create-params {
    /// Client ID of the end customer.
    originator-client-id: string,
    /// URL the end customer will be redirected to after completing questions in Plaid-hosted onboarding flow.
    redirect-uri: string
  }
  transfer-questionnaire-create: func(params: transfer-questionnaire-create-params) -> result<string, string>;

  /// Cancel a recurring transfer.
  record transfer-recurring-cancel-params {
    recurring-transfer-id: recurring-transfer-id
  }
  transfer-recurring-cancel: func(params: transfer-recurring-cancel-params) -> result<string, string>;

  /// Create a recurring transfer
  record transfer-recurring-create-params {
    access-token: transfer-access-token,
    account-id: transfer-account-id,
    ach-class: option<ach-class>,
    amount: transfer-amount,
    /// The description of the recurring transfer.
    description: string,
    device: transfer-device,
    funding-account-id: option<transfer-funding-account-id-request>,
    idempotency-key: transfer-recurring-idempotency-key,
    /// The currency of the transfer amount. The default value is "USD".
    iso-currency-code: option<string>,
    network: transfer-network,
    schedule: transfer-recurring-schedule,
    /// Plaid’s unique identifier for a test clock.
    test-clock-id: option<string>,
    type-op: transfer-type,
    user: transfer-user-in-request,
    /// If the end user is initiating the specific transfer themselves via an interactive UI, this should be `true`; for automatic recurring payments where the end user is not actually initiating each individual transfer, it should be `false`.
    user-present: bool
  }
  transfer-recurring-create: func(params: transfer-recurring-create-params) -> result<string, string>;

  /// Retrieve a recurring transfer
  record transfer-recurring-get-params {
    recurring-transfer-id: recurring-transfer-id
  }
  transfer-recurring-get: func(params: transfer-recurring-get-params) -> result<string, string>;

  /// List recurring transfers
  record transfer-recurring-list-params {
    /// The maximum number of recurring transfers to return.
    count: option<s32>,
    /// The end datetime of recurring transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    end-time: option<string>,
    /// Filter recurring transfers to only those with the specified `funding_account_id`.
    funding-account-id: option<string>,
    /// The number of recurring transfers to skip before returning results.
    offset: option<s32>,
    /// The start datetime of recurring transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    start-time: option<string>
  }
  transfer-recurring-list: func(params: transfer-recurring-list-params) -> result<string, string>;

  /// Cancel a refund
  record transfer-refund-cancel-params {
    refund-id: transfer-refund-id
  }
  transfer-refund-cancel: func(params: transfer-refund-cancel-params) -> result<string, string>;

  /// Create a refund
  record transfer-refund-create-params {
    amount: transfer-refund-amount,
    idempotency-key: transfer-refund-idempotency-key,
    transfer-id: transfer-id-for-refund
  }
  transfer-refund-create: func(params: transfer-refund-create-params) -> result<string, string>;

  /// Retrieve a refund
  record transfer-refund-get-params {
    refund-id: transfer-refund-id
  }
  transfer-refund-get: func(params: transfer-refund-get-params) -> result<string, string>;

  /// Lists historical repayments
  record transfer-repayment-list-params {
    /// The maximum number of repayments to return.
    count: option<s32>,
    /// The end datetime of repayments to return (RFC 3339 format).
    end-date: option<string>,
    /// The number of repayments to skip before returning results.
    offset: option<s32>,
    /// The start datetime of repayments to return (RFC 3339 format).
    start-date: option<string>
  }
  transfer-repayment-list: func(params: transfer-repayment-list-params) -> result<string, string>;

  /// List the returns included in a repayment
  record transfer-repayment-return-list-params {
    /// The maximum number of repayments to return.
    count: option<s32>,
    /// The number of repayments to skip before returning results.
    offset: option<s32>,
    /// Identifier of the repayment to query.
    repayment-id: string
  }
  transfer-repayment-return-list: func(params: transfer-repayment-return-list-params) -> result<string, string>;

  /// Retrieve a sweep
  record transfer-sweep-get-params {
    /// Plaid’s unique identifier for a sweep.
    sweep-id: string
  }
  transfer-sweep-get: func(params: transfer-sweep-get-params) -> result<string, string>;

  /// List sweeps
  record transfer-sweep-list-params {
    /// The maximum number of sweeps to return.
    count: option<s32>,
    /// The end datetime of sweeps to return (RFC 3339 format).
    end-date: option<string>,
    /// Filter sweeps to only those with the specified `funding_account_id`.
    funding-account-id: option<string>,
    /// The number of sweeps to skip before returning results.
    offset: option<s32>,
    /// Filter sweeps to only those with the specified originator client.
    originator-client-id: option<string>,
    /// The start datetime of sweeps to return (RFC 3339 format).
    start-date: option<string>
  }
  transfer-sweep-list: func(params: transfer-sweep-list-params) -> result<string, string>;

  /// Create user
  record user-create-params {
    /// A unique ID representing the end user. Maximum of 128 characters. Typically this will be a user ID number from your application. Personally identifiable information, such as an email address or phone number, should not be used in the `client_user_id`.
    client-user-id: string
  }
  user-create: func(params: user-create-params) -> result<string, string>;

  /// Create an e-wallet
  record wallet-create-params {
    iso-currency-code: wallet-iso-currency-code
  }
  wallet-create: func(params: wallet-create-params) -> result<string, string>;

  /// Fetch an e-wallet
  record wallet-get-params {
    /// The ID of the e-wallet
    wallet-id: string
  }
  wallet-get: func(params: wallet-get-params) -> result<string, string>;

  /// Fetch a list of e-wallets
  record wallet-list-params {
    /// The number of e-wallets to fetch
    count: option<s32>,
    /// A base64 value representing the latest e-wallet that has already been requested. Set this to `next_cursor` received from the previous `/wallet/list` request. If provided, the response will only contain e-wallets created before that e-wallet. If omitted, the response will contain e-wallets starting from the most recent, and in descending order.
    cursor: option<string>,
    iso-currency-code: option<wallet-iso-currency-code>
  }
  wallet-list: func(params: wallet-list-params) -> result<string, string>;

  /// Execute a transaction using an e-wallet
  record wallet-transaction-execute-params {
    amount: wallet-transaction-amount,
    counterparty: wallet-transaction-counterparty,
    idempotency-key: wallet-transaction-idempotency-key,
    /// A reference for the transaction. This must be an alphanumeric string with 6 to 18 characters and must not contain any special characters or spaces.
    /// Ensure that the `reference` field is unique for each transaction.
    reference: string,
    /// The ID of the e-wallet to debit from
    wallet-id: string
  }
  wallet-transaction-execute: func(params: wallet-transaction-execute-params) -> result<string, string>;

  /// Fetch an e-wallet transaction
  record wallet-transaction-get-params {
    /// The ID of the transaction to fetch
    transaction-id: string
  }
  wallet-transaction-get: func(params: wallet-transaction-get-params) -> result<string, string>;

  /// List e-wallet transactions
  record wallet-transaction-list-params {
    /// The number of transactions to fetch
    count: option<s32>,
    /// A base64 value representing the latest transaction that has already been requested. Set this to `next_cursor` received from the previous `/wallet/transaction/list` request. If provided, the response will only contain transactions created before that transaction. If omitted, the response will contain transactions starting from the most recent, and in descending order by the `created_at` time.
    cursor: option<string>,
    options: option<wallet-transaction-list-request-options>,
    /// The ID of the e-wallet to fetch transactions from
    wallet-id: string
  }
  wallet-transaction-list: func(params: wallet-transaction-list-params) -> result<string, string>;

  /// Create a watchlist screening for an entity
  record watchlist-screening-entity-create-params {
    client-user-id: option<client-user-id>,
    search-terms: entity-watchlist-search-terms
  }
  watchlist-screening-entity-create: func(params: watchlist-screening-entity-create-params) -> result<string, string>;

  /// Get an entity screening
  record watchlist-screening-entity-get-params {
    entity-watchlist-screening-id: entity-watchlist-screening-id
  }
  watchlist-screening-entity-get: func(params: watchlist-screening-entity-get-params) -> result<string, string>;

  /// List history for entity watchlist screenings
  record watchlist-screening-entity-history-list-params {
    cursor: option<cursor>,
    entity-watchlist-screening-id: entity-watchlist-screening-id
  }
  watchlist-screening-entity-history-list: func(params: watchlist-screening-entity-history-list-params) -> result<string, string>;

  /// List hits for entity watchlist screenings
  record watchlist-screening-entity-hit-list-params {
    cursor: option<cursor>,
    entity-watchlist-screening-id: entity-watchlist-screening-id
  }
  watchlist-screening-entity-hit-list: func(params: watchlist-screening-entity-hit-list-params) -> result<string, string>;

  /// List entity watchlist screenings
  record watchlist-screening-entity-list-params {
    assignee: option<dashboard-user-id>,
    client-user-id: option<client-user-id>,
    cursor: option<cursor>,
    entity-watchlist-program-id: entity-watchlist-program-id,
    status: option<watchlist-screening-status>
  }
  watchlist-screening-entity-list: func(params: watchlist-screening-entity-list-params) -> result<string, string>;

  /// Get entity watchlist screening program
  record watchlist-screening-entity-program-get-params {
    entity-watchlist-program-id: entity-watchlist-program-id
  }
  watchlist-screening-entity-program-get: func(params: watchlist-screening-entity-program-get-params) -> result<string, string>;

  /// List entity watchlist screening programs
  record watchlist-screening-entity-program-list-params {
    cursor: option<cursor>
  }
  watchlist-screening-entity-program-list: func(params: watchlist-screening-entity-program-list-params) -> result<string, string>;

  /// Create a review for an entity watchlist screening
  record watchlist-screening-entity-review-create-params {
    comment: option<review-comment>,
    /// Hits to mark as a true positive after thorough manual review. These hits will never recur or be updated once dismissed. In most cases, confirmed hits indicate that the customer should be rejected.
    confirmed-hits: list<entity-watchlist-screening-hit-id>,
    /// Hits to mark as a false positive after thorough manual review. These hits will never recur or be updated once dismissed.
    dismissed-hits: list<entity-watchlist-screening-hit-id>,
    entity-watchlist-screening-id: entity-watchlist-screening-id
  }
  watchlist-screening-entity-review-create: func(params: watchlist-screening-entity-review-create-params) -> result<string, string>;

  /// List reviews for entity watchlist screenings
  record watchlist-screening-entity-review-list-params {
    cursor: option<cursor>,
    entity-watchlist-screening-id: entity-watchlist-screening-id
  }
  watchlist-screening-entity-review-list: func(params: watchlist-screening-entity-review-list-params) -> result<string, string>;

  /// Update an entity screening
  record watchlist-screening-entity-update-params {
    assignee: option<dashboard-user-id>,
    client-user-id: option<client-user-id>,
    entity-watchlist-screening-id: entity-watchlist-screening-id,
    reset-fields: option<watchlist-screening-entity-update-request-resettable-field-list>,
    search-terms: option<update-entity-screening-request-search-terms>,
    status: option<watchlist-screening-status>
  }
  watchlist-screening-entity-update: func(params: watchlist-screening-entity-update-params) -> result<string, string>;

  /// Create a watchlist screening for a person
  record watchlist-screening-individual-create-params {
    client-user-id: option<client-user-id>,
    search-terms: watchlist-screening-request-search-terms
  }
  watchlist-screening-individual-create: func(params: watchlist-screening-individual-create-params) -> result<string, string>;

  /// Retrieve an individual watchlist screening
  record watchlist-screening-individual-get-params {
    watchlist-screening-id: watchlist-screening-individual-id
  }
  watchlist-screening-individual-get: func(params: watchlist-screening-individual-get-params) -> result<string, string>;

  /// List history for individual watchlist screenings
  record watchlist-screening-individual-history-list-params {
    cursor: option<cursor>,
    watchlist-screening-id: watchlist-screening-individual-id
  }
  watchlist-screening-individual-history-list: func(params: watchlist-screening-individual-history-list-params) -> result<string, string>;

  /// List hits for individual watchlist screening
  record watchlist-screening-individual-hit-list-params {
    cursor: option<cursor>,
    watchlist-screening-id: watchlist-screening-individual-id
  }
  watchlist-screening-individual-hit-list: func(params: watchlist-screening-individual-hit-list-params) -> result<string, string>;

  /// List Individual Watchlist Screenings
  record watchlist-screening-individual-list-params {
    assignee: option<dashboard-user-id>,
    client-user-id: option<client-user-id>,
    cursor: option<cursor>,
    status: option<watchlist-screening-status>,
    watchlist-program-id: watchlist-program-id
  }
  watchlist-screening-individual-list: func(params: watchlist-screening-individual-list-params) -> result<string, string>;

  /// Get individual watchlist screening program
  record watchlist-screening-individual-program-get-params {
    watchlist-program-id: watchlist-program-id
  }
  watchlist-screening-individual-program-get: func(params: watchlist-screening-individual-program-get-params) -> result<string, string>;

  /// List individual watchlist screening programs
  record watchlist-screening-individual-program-list-params {
    cursor: option<cursor>
  }
  watchlist-screening-individual-program-list: func(params: watchlist-screening-individual-program-list-params) -> result<string, string>;

  /// Create a review for an individual watchlist screening
  record watchlist-screening-individual-review-create-params {
    comment: option<review-comment>,
    /// Hits to mark as a true positive after thorough manual review. These hits will never recur or be updated once dismissed. In most cases, confirmed hits indicate that the customer should be rejected.
    confirmed-hits: list<watchlist-screening-hit-id>,
    /// Hits to mark as a false positive after thorough manual review. These hits will never recur or be updated once dismissed.
    dismissed-hits: list<watchlist-screening-hit-id>,
    watchlist-screening-id: watchlist-screening-individual-id
  }
  watchlist-screening-individual-review-create: func(params: watchlist-screening-individual-review-create-params) -> result<string, string>;

  /// List reviews for individual watchlist screenings
  record watchlist-screening-individual-review-list-params {
    cursor: option<cursor>,
    watchlist-screening-id: watchlist-screening-individual-id
  }
  watchlist-screening-individual-review-list: func(params: watchlist-screening-individual-review-list-params) -> result<string, string>;

  /// Update individual watchlist screening
  record watchlist-screening-individual-update-params {
    assignee: option<dashboard-user-id>,
    client-user-id: option<client-user-id>,
    reset-fields: option<watchlist-screening-individual-update-request-resettable-field-list>,
    search-terms: option<update-individual-screening-request-search-terms>,
    status: option<watchlist-screening-status>,
    watchlist-screening-id: watchlist-screening-individual-id
  }
  watchlist-screening-individual-update: func(params: watchlist-screening-individual-update-params) -> result<string, string>;

  /// Get webhook verification key
  record webhook-verification-key-get-params {
    /// The key ID ( `kid` ) from the JWT header.
    key-id: string
  }
  webhook-verification-key-get: func(params: webhook-verification-key-get-params) -> result<string, string>;

}

/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export plaid;
}
