/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `usertoken` | `Authorization: Basic base64(<secret>)` |
package autostamp:tvmaze@0.5.0;

interface auth {
  record post-auth-poll-response {
    /// The user's API key
    apikey: option<string>,
    /// The user's username
    username: option<string>
  }

  record post-auth-start-response {
    /// URL where the user can confirm the authentication request
    confirm-url: option<string>,
    /// Authentication token to use in the `poll` endpoint
    token: option<string>
  }

  record get-auth-validate-response {
    /// The user's premium level; 1 for Bronze, 2 for Silver, 3 for Gold; or 0 for none
    premium: option<s32>
  }

  variant post-auth-poll-error {
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant post-auth-start-error {
    unauthorized(string),
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant get-auth-validate-error {
    unauthorized(string),
    other(string)
  }

  /// Poll whether an authentication request was confirmed
  record post-auth-poll-params {
    token: option<string>
  }
  post-auth-poll: func(params: post-auth-poll-params) -> result<post-auth-poll-response, post-auth-poll-error>;

  /// Start an authentication request
  record post-auth-start-params {
    /// The user's email address
    email: option<string>,
    /// Whether to email the user a confirmation link
    email-confirmation: option<bool>
  }
  post-auth-start: func(params: post-auth-start-params) -> result<post-auth-start-response, post-auth-start-error>;

  /// Validate your authentication credentials
  get-auth-validate: func() -> result<get-auth-validate-response, get-auth-validate-error>;

}


interface scrobbling {
  enum get-scrobble-shows-show-id-embed-enum {
    episode,
  }

  record post-scrobble-episodes-body-item {
    /// The TVmaze episode ID
    episode-id: option<s32>,
    /// Epoch timestamp for when the user watched the episode, or 0 for unknown.
    marked-at: option<s32>,
    type-op: option<mark-type>
  }

  /// 0 for watched, 1 for acquired, 2 for skipped
  record mark-type {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A list of responses to your bulk input, ordered the same as your input
  record bulk-response {
    /// opaque schema; raw JSON
    value: string
  }

  record marked-episode {
    embedded: option<marked-episode-embedded>,
    episode-id: option<s32>,
    /// Epoch timestamp for when the user watched the episode, or 0 for unknown.
    marked-at: option<s32>,
    type-op: option<mark-type>
  }

  record marked-episode-embedded {
    episode: option<episode>
  }

  record episode {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record post-scrobble-shows-body-item {
    /// The episode airdate
    airdate: option<string>,
    /// The episode number
    episode: option<s32>,
    /// Epoch timestamp for when the user watched the episode, or 0 for unknown.
    marked-at: option<s32>,
    /// The season number
    season: option<s32>,
    type-op: option<mark-type>
  }

  variant post-scrobble-episodes-error {
    unprocessable-entity(string),
    other(string)
  }

  variant put-scrobble-episodes-episode-id-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant post-scrobble-shows-error {
    unprocessable-entity(string),
    other(string)
  }

  /// Mark episodes as acquired or watched based on their IDs
  record post-scrobble-episodes-params {
    body: option<list<post-scrobble-episodes-body-item>>
  }
  post-scrobble-episodes: func(params: post-scrobble-episodes-params) -> result<bulk-response, post-scrobble-episodes-error>;

  /// Mark an episode as acquired or watched based on its ID
  record put-scrobble-episodes-episode-id-params {
    episode-id: string,
    embedded: option<marked-episode-embedded>,
    episode-id-v2: option<s32>,
    /// Epoch timestamp for when the user watched the episode, or 0 for unknown.
    marked-at: option<s32>,
    type-op: option<mark-type>
  }
  put-scrobble-episodes-episode-id: func(params: put-scrobble-episodes-episode-id-params) -> result<marked-episode, put-scrobble-episodes-episode-id-error>;

  /// Mark episodes within a show as acquired or watched based on their attributes
  record post-scrobble-shows-params {
    /// The show's TVmaze ID
    tvmaze-id: option<s32>,
    /// The show's TheTVDB ID
    thetvdb-id: option<s32>,
    /// The show's IMDB ID
    imdb-id: option<s32>,
    body: option<list<post-scrobble-shows-body-item>>
  }
  post-scrobble-shows: func(params: post-scrobble-shows-params) -> result<bulk-response, post-scrobble-shows-error>;

  /// List watched and acquired episodes for a show
  record get-scrobble-shows-show-id-params {
    /// ID of the target show
    show-id: string,
    /// Embed full episode info
    embed: option<get-scrobble-shows-show-id-embed-enum>
  }
  get-scrobble-shows-show-id: func(params: get-scrobble-shows-show-id-params) -> result<list<marked-episode>, string>;

}

interface marked-episodes {
  record marked-episode {
    embedded: option<marked-episode-embedded>,
    episode-id: option<s32>,
    /// Epoch timestamp for when the user watched the episode, or 0 for unknown.
    marked-at: option<s32>,
    type-op: option<mark-type>
  }

  record marked-episode-embedded {
    episode: option<episode>
  }

  record episode {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// 0 for watched, 1 for acquired, 2 for skipped
  record mark-type {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-user-episodes-episode-id-error {
    not-found(string),
    other(string)
  }

  variant put-user-episodes-episode-id-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-user-episodes-episode-id-error {
    not-found(string),
    other(string)
  }

  /// List the marked episodes
  record get-user-episodes-params {
    /// Only return episodes from this specific show
    show-id: option<s32>
  }
  get-user-episodes: func(params: get-user-episodes-params) -> result<list<marked-episode>, string>;

  /// Check if an episode is marked
  record get-user-episodes-episode-id-params {
    episode-id: string
  }
  get-user-episodes-episode-id: func(params: get-user-episodes-episode-id-params) -> result<marked-episode, get-user-episodes-episode-id-error>;

  /// Mark an episode
  record put-user-episodes-episode-id-params {
    episode-id: string,
    embedded: option<marked-episode-embedded>,
    episode-id-v2: option<s32>,
    /// Epoch timestamp for when the user watched the episode, or 0 for unknown.
    marked-at: option<s32>,
    type-op: option<mark-type>
  }
  put-user-episodes-episode-id: func(params: put-user-episodes-episode-id-params) -> result<marked-episode, put-user-episodes-episode-id-error>;

  /// Unmark an episode
  record delete-user-episodes-episode-id-params {
    episode-id: string
  }
  delete-user-episodes-episode-id: func(params: delete-user-episodes-episode-id-params) -> result<string, delete-user-episodes-episode-id-error>;

}

