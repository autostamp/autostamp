interface tagged-shows {
  enum get-user-tags-tag-id-shows-embed-enum {
    show,
  }

  record tag {
    id: option<s32>,
    name: option<string>
  }

  record tag-instance {
    embedded: option<tag-instance-embedded>,
    show-id: option<s32>
  }

  record tag-instance-embedded {
    show: option<show>
  }

  record show {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-user-tags-error {
    unprocessable-entity(string),
    other(string)
  }

  variant patch-user-tags-tag-id-error {
    not-found(string),
    unprocessable-entity(string),
    other(string)
  }

  variant delete-user-tags-tag-id-error {
    not-found(string),
    other(string)
  }

  variant get-user-tags-tag-id-shows-error {
    not-found(string),
    other(string)
  }

  variant put-user-tags-tag-id-shows-show-id-error {
    not-found(string),
    other(string)
  }

  variant delete-user-tags-tag-id-shows-show-id-error {
    not-found(string),
    other(string)
  }

  /// List all tags
  get-user-tags: func() -> result<list<tag>, string>;

  /// Create a new tag
  record post-user-tags-params {
    id: option<s32>,
    name: option<string>
  }
  post-user-tags: func(params: post-user-tags-params) -> result<tag, post-user-tags-error>;

  /// Update a specific tag
  record patch-user-tags-tag-id-params {
    tag-id: string,
    id: option<s32>,
    name: option<string>
  }
  patch-user-tags-tag-id: func(params: patch-user-tags-tag-id-params) -> result<tag, patch-user-tags-tag-id-error>;

  /// Delete a specific tag
  record delete-user-tags-tag-id-params {
    tag-id: string
  }
  delete-user-tags-tag-id: func(params: delete-user-tags-tag-id-params) -> result<string, delete-user-tags-tag-id-error>;

  /// List all shows under this tag
  record get-user-tags-tag-id-shows-params {
    tag-id: string,
    /// Embed full show info
    embed: option<get-user-tags-tag-id-shows-embed-enum>
  }
  get-user-tags-tag-id-shows: func(params: get-user-tags-tag-id-shows-params) -> result<list<tag-instance>, get-user-tags-tag-id-shows-error>;

  /// Tag a show
  record put-user-tags-tag-id-shows-show-id-params {
    tag-id: string,
    show-id: string
  }
  put-user-tags-tag-id-shows-show-id: func(params: put-user-tags-tag-id-shows-show-id-params) -> result<tag-instance, put-user-tags-tag-id-shows-show-id-error>;

  /// Untag a show
  record delete-user-tags-tag-id-shows-show-id-params {
    tag-id: string,
    show-id: string
  }
  delete-user-tags-tag-id-shows-show-id: func(params: delete-user-tags-tag-id-shows-show-id-params) -> result<string, delete-user-tags-tag-id-shows-show-id-error>;

}

