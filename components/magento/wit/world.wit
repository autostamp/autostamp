interface products-sku {
  record catalog-data-product-interface {
    /// Attribute set id
    attribute-set-id: option<s32>,
    /// Created date
    created-at: option<string>,
    /// Custom attributes values.
    custom-attributes: option<list<framework-attribute-interface>>,
    extension-attributes: option<catalog-data-product-extension-interface>,
    /// Id
    id: option<s32>,
    /// Media gallery entries
    media-gallery-entries: option<list<catalog-data-product-attribute-media-gallery-entry-interface>>,
    /// Name
    name: option<string>,
    /// List of product options
    options: option<list<catalog-data-product-custom-option-interface>>,
    /// Price
    price: option<f64>,
    /// Product links info
    product-links: option<list<catalog-data-product-link-interface>>,
    /// Sku
    sku: string,
    /// Status
    status: option<s32>,
    /// List of product tier prices
    tier-prices: option<list<catalog-data-product-tier-price-interface>>,
    /// Type id
    type-id: option<string>,
    /// Updated date
    updated-at: option<string>,
    /// Visibility
    visibility: option<s32>,
    /// Weight
    weight: option<f64>
  }

  /// Interface for custom attribute value.
  record framework-attribute-interface {
    /// Attribute code
    attribute-code: string,
    /// Attribute value
    value: string
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductInterface
  record catalog-data-product-extension-interface {
    bundle-product-options: option<list<bundle-data-option-interface>>,
    category-links: option<list<catalog-data-category-link-interface>>,
    configurable-product-links: option<list<s32>>,
    configurable-product-options: option<list<configurable-product-data-option-interface>>,
    downloadable-product-links: option<list<downloadable-data-link-interface>>,
    downloadable-product-samples: option<list<downloadable-data-sample-interface>>,
    giftcard-amounts: option<list<gift-card-data-giftcard-amount-interface>>,
    stock-item: option<catalog-inventory-data-stock-item-interface>,
    website-ids: option<list<s32>>
  }

  /// Interface OptionInterface
  record bundle-data-option-interface {
    extension-attributes: option<bundle-data-option-extension-interface>,
    /// Option id
    option-id: option<s32>,
    /// Option position
    position: option<s32>,
    /// Product links
    product-links: option<list<bundle-data-link-interface>>,
    /// Is required option
    required: option<bool>,
    /// Product sku
    sku: option<string>,
    /// Option title
    title: option<string>,
    /// Input type
    type-op: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Bundle\Api\Data\OptionInterface
  record bundle-data-option-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Interface LinkInterface
  record bundle-data-link-interface {
    /// Whether quantity could be changed
    can-change-quantity: option<s32>,
    extension-attributes: option<bundle-data-link-extension-interface>,
    /// The identifier
    id: option<string>,
    /// Is default
    is-default: bool,
    /// Option id
    option-id: option<s32>,
    /// Position
    position: option<s32>,
    /// Price
    price: f64,
    /// Price type
    price-type: s32,
    /// Qty
    qty: option<f64>,
    /// Linked product sku
    sku: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Bundle\Api\Data\LinkInterface
  record bundle-data-link-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record catalog-data-category-link-interface {
    /// Category id
    category-id: string,
    extension-attributes: option<catalog-data-category-link-extension-interface>,
    position: option<s32>
  }

