    attribute-id: option<string>,
    extension-attributes: option<configurable-product-data-option-extension-interface>,
    id: option<s32>,
    is-use-default: option<bool>,
    label: option<string>,
    position: option<s32>,
    product-id: option<s32>,
    values: option<list<configurable-product-data-option-value-interface>>
