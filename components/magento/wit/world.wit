interface attribute-metadata-customer {
  /// Customer attribute metadata interface.
  record customer-data-attribute-metadata-interface {
    /// Code of the attribute.
    attribute-code: string,
    /// Backend type.
    backend-type: string,
    /// Data model for attribute.
    data-model: string,
    /// Class which is used to display the attribute on frontend.
    frontend-class: string,
    /// HTML for input element.
    frontend-input: string,
    /// Label which supposed to be displayed on frontend.
    frontend-label: string,
    /// Template used for input (e.g. "date")
    input-filter: string,
    /// It is filterable in customer grid
    is-filterable-in-grid: option<bool>,
    /// It is searchable in customer grid
    is-searchable-in-grid: option<bool>,
    /// It is used in customer grid
    is-used-in-grid: option<bool>,
    /// It is visible in customer grid
    is-visible-in-grid: option<bool>,
    /// Of lines of the attribute value.
    multiline-count: s32,
    /// The note attribute for the element.
    note: string,
    /// Options of the attribute (key => value pairs for select)
    options: list<customer-data-option-interface>,
    /// Attribute is required.
    required: bool,
    /// Attributes sort order.
    sort-order: s32,
    /// Label of the store.
    store-label: string,
    /// This is a system attribute.
    system: bool,
    /// Current attribute has been defined by a user.
    user-defined: bool,
    /// Validation rules.
    validation-rules: list<customer-data-validation-rule-interface>,
    /// Attribute is visible on frontend.
    visible: bool
  }

  /// Option interface.
  record customer-data-option-interface {
    /// Option label
    label: string,
    /// Nested options
    options: option<list<string>>,
    /// Option value
    value: option<string>
  }

  /// Validation rule interface.
  record customer-data-validation-rule-interface {
    /// Validation rule name
    name: string,
    /// Validation rule value
    value: string
  }

  variant customer-customer-metadata-v1-get-all-attributes-metadata-get-error {
    unauthorized(string),
    internal-server-error(string),
    other(string)
  }

  /// attributeMetadata/customer
  customer-customer-metadata-v1-get-all-attributes-metadata-get: func() -> result<list<customer-data-attribute-metadata-interface>, customer-customer-metadata-v1-get-all-attributes-metadata-get-error>;

}

