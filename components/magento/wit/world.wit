    /// Aggregation
    value: string
  }

  /// Interface \Magento\Framework\Api\Search\DocumentInterface
  record framework-search-document-interface {
    /// Custom attributes values.
    custom-attributes: option<list<framework-attribute-interface>>,
    id: s32
  }

  /// Interface for custom attribute value.
  record framework-attribute-interface {
    /// Attribute code
    attribute-code: string,
    /// Attribute value
    value: string
  }

  /// Interface SearchCriteriaInterface
  record framework-search-search-criteria-interface {
    /// Current page.
    current-page: option<s32>,
    /// A list of filter groups.
    filter-groups: list<framework-search-filter-group>,
    /// Page size.
    page-size: option<s32>,
    request-name: string,
    /// Sort order.
    sort-orders: option<list<framework-sort-order>>
  }

  /// Groups two or more filters together using a logical OR
  record framework-search-filter-group {
    /// A list of filters in this group
    filters: option<list<framework-filter>>
  }

  /// Filter which can be used by any methods from service layer.
  record framework-filter {
    /// Condition type
    condition-type: option<string>,
    /// Field
    field: string,
    /// Value
    value: string
  }

  /// Data object for sort order.
  record framework-sort-order {
    /// Sorting direction.
    direction: string,
    /// Sorting field.
    field: string
  }

  /// search
  record v1-search-get-params {
    search-criteria-request-name: option<string>,
    /// Field
    search-criteria-filter-groups-v0-filters-v0-field: option<string>,
    /// Value
    search-criteria-filter-groups-v0-filters-v0-value: option<string>,
    /// Condition type
    search-criteria-filter-groups-v0-filters-v0-condition-type: option<string>,
    /// Sorting field.
    search-criteria-sort-orders-v0-field: option<string>,
    /// Sorting direction.
    search-criteria-sort-orders-v0-direction: option<string>,
    /// Page size.
    search-criteria-page-size: option<s32>,
    /// Current page.
    search-criteria-current-page: option<s32>
  }
  v1-search-get: func(params: v1-search-get-params) -> result<framework-search-search-result-interface, string>;

}

