    /// Gift card sender name.
    giftcard-sender-name: string
  }

  /// ExtensionInterface class for @see \Magento\GiftCard\Api\Data\GiftCardOptionInterface
  record gift-card-data-gift-card-option-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant sales-order-item-repository-v1-get-get-error {
    unauthorized(string),
    other(string)
  }

  /// orders/items/{id}
  record sales-order-item-repository-v1-get-get-params {
    /// The order item ID.
    id: string
  }
  sales-order-item-repository-v1-get-get: func(params: sales-order-item-repository-v1-get-get-params) -> result<sales-data-order-item-interface, sales-order-item-repository-v1-get-get-error>;

}

