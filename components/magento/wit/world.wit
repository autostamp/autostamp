  record framework-data-image-content-interface {
    /// Media data (base64 encoded content)
    base64-encoded-data: string,
    /// Image name
    name: string,
    /// MIME type
    type-op: string
  }

  /// Downloadable Option
  record downloadable-data-downloadable-option-interface {
