interface creditmemo {
  /// Credit memo interface. After a customer places and pays for an order and an invoice has been issued, the merchant can create a credit memo to refund all or part of the amount paid for any returned or undelivered items. The memo restores funds to the customer account so that the customer can make future purchases.
  record sales-data-creditmemo-interface {
    /// Credit memo adjustment.
    adjustment: option<f64>,
    /// Credit memo negative adjustment.
    adjustment-negative: option<f64>,
    /// Credit memo positive adjustment.
    adjustment-positive: option<f64>,
    /// Credit memo base adjustment.
    base-adjustment: option<f64>,
    /// Credit memo negative base adjustment.
    base-adjustment-negative: option<f64>,
    /// Credit memo positive base adjustment.
    base-adjustment-positive: option<f64>,
    /// Credit memo base currency code.
    base-currency-code: option<string>,
    /// Credit memo base discount amount.
    base-discount-amount: option<f64>,
    /// Credit memo base discount tax compensation amount.
    base-discount-tax-compensation-amount: option<f64>,
    /// Credit memo base grand total.
    base-grand-total: option<f64>,
    /// Credit memo base shipping amount.
    base-shipping-amount: option<f64>,
    /// Credit memo base shipping discount tax compensation amount.
    base-shipping-discount-tax-compensation-amnt: option<f64>,
    /// Credit memo base shipping including tax.
    base-shipping-incl-tax: option<f64>,
    /// Credit memo base shipping tax amount.
    base-shipping-tax-amount: option<f64>,
    /// Credit memo base subtotal.
    base-subtotal: option<f64>,
    /// Credit memo base subtotal including tax.
    base-subtotal-incl-tax: option<f64>,
    /// Credit memo base tax amount.
    base-tax-amount: option<f64>,
    /// Credit memo base-to-global rate.
    base-to-global-rate: option<f64>,
    /// Credit memo base-to-order rate.
    base-to-order-rate: option<f64>,
    /// Credit memo billing address ID.
    billing-address-id: option<s32>,
    /// Array of any credit memo comments. Otherwise, null.
    comments: option<list<sales-data-creditmemo-comment-interface>>,
    /// Credit memo created-at timestamp.
    created-at: option<string>,
    /// Credit memo status.
    creditmemo-status: option<s32>,
    /// Credit memo discount amount.
    discount-amount: option<f64>,
    /// Credit memo discount description.
    discount-description: option<string>,
    /// Credit memo discount tax compensation amount.
    discount-tax-compensation-amount: option<f64>,
    /// Credit memo email sent flag value.
    email-sent: option<s32>,
    /// Credit memo ID.
    entity-id: option<s32>,
    extension-attributes: option<sales-data-creditmemo-extension-interface>,
    /// Credit memo global currency code.
    global-currency-code: option<string>,
    /// Credit memo grand total.
    grand-total: option<f64>,
    /// Credit memo increment ID.
    increment-id: option<string>,
    /// Credit memo invoice ID.
    invoice-id: option<s32>,
    /// Array of credit memo items.
    items: list<sales-data-creditmemo-item-interface>,
    /// Credit memo order currency code.
    order-currency-code: option<string>,
    /// Credit memo order ID.
    order-id: s32,
    /// Credit memo shipping address ID.
    shipping-address-id: option<s32>,
    /// Credit memo shipping amount.
    shipping-amount: option<f64>,
    /// Credit memo shipping discount tax compensation amount.
    shipping-discount-tax-compensation-amount: option<f64>,
    /// Credit memo shipping including tax.
    shipping-incl-tax: option<f64>,
    /// Credit memo shipping tax amount.
    shipping-tax-amount: option<f64>,
    /// Credit memo state.
    state: option<s32>,
    /// Credit memo store currency code.
    store-currency-code: option<string>,
    /// Credit memo store ID.
    store-id: option<s32>,
    /// Credit memo store-to-base rate.
    store-to-base-rate: option<f64>,
    /// Credit memo store-to-order rate.
    store-to-order-rate: option<f64>,
    /// Credit memo subtotal.
    subtotal: option<f64>,
    /// Credit memo subtotal including tax.
    subtotal-incl-tax: option<f64>,
    /// Credit memo tax amount.
    tax-amount: option<f64>,
    /// Credit memo transaction ID.
    transaction-id: option<string>,
    /// Credit memo updated-at timestamp.
    updated-at: option<string>
  }

  /// Credit memo comment interface. After a customer places and pays for an order and an invoice has been issued, the merchant can create a credit memo to refund all or part of the amount paid for any returned or undelivered items. The memo restores funds to the customer account so that the customer can make future purchases. A credit memo usually includes comments that detail why the credit memo amount was credited to the customer.
  record sales-data-creditmemo-comment-interface {
    /// Comment.
    comment: string,
    /// Created-at timestamp.
    created-at: option<string>,
    /// Credit memo ID.
    entity-id: option<s32>,
    extension-attributes: option<sales-data-creditmemo-comment-extension-interface>,
    /// Is-customer-notified flag value.
    is-customer-notified: s32,
    /// Is-visible-on-storefront flag value.
    is-visible-on-front: s32,
    /// Parent ID.
    parent-id: s32
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\CreditmemoCommentInterface
  record sales-data-creditmemo-comment-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\CreditmemoInterface
  record sales-data-creditmemo-extension-interface {
    base-customer-balance-amount: option<f64>,
    base-gift-cards-amount: option<f64>,
    customer-balance-amount: option<f64>,
    gift-cards-amount: option<f64>,
    gw-base-price: option<string>,
    gw-base-tax-amount: option<string>,
    gw-card-base-price: option<string>,
    gw-card-base-tax-amount: option<string>,
    gw-card-price: option<string>,
    gw-card-tax-amount: option<string>,
    gw-items-base-price: option<string>,
    gw-items-base-tax-amount: option<string>,
    gw-items-price: option<string>,
    gw-items-tax-amount: option<string>,
    gw-price: option<string>,
    gw-tax-amount: option<string>
  }

  /// Credit memo item interface. After a customer places and pays for an order and an invoice has been issued, the merchant can create a credit memo to refund all or part of the amount paid for any returned or undelivered items. The memo restores funds to the customer account so that the customer can make future purchases. A credit memo item is an invoiced item for which a merchant creates a credit memo.
  record sales-data-creditmemo-item-interface {
    /// Additional data.
    additional-data: option<string>,
    /// The base cost for a credit memo item.
    base-cost: f64,
    /// The base discount amount for a credit memo item.
    base-discount-amount: option<f64>,
    /// The base discount tax compensation amount for a credit memo item.
    base-discount-tax-compensation-amount: option<f64>,
    /// The base price for a credit memo item.
    base-price: f64,
    /// Base price including tax.
    base-price-incl-tax: option<f64>,
    /// Base row total.
    base-row-total: option<f64>,
    /// Base row total including tax.
    base-row-total-incl-tax: option<f64>,
    /// Base tax amount.
    base-tax-amount: option<f64>,
    /// Base WEEE tax applied amount.
    base-weee-tax-applied-amount: option<f64>,
    /// Base WEEE tax applied row amount.
    base-weee-tax-applied-row-amnt: option<f64>,
    /// Base WEEE tax disposition.
    base-weee-tax-disposition: option<f64>,
    /// Base WEEE tax row disposition.
    base-weee-tax-row-disposition: option<f64>,
    /// Description.
    description: option<string>,
    /// Discount amount.
    discount-amount: option<f64>,
    /// Discount tax compensation amount.
    discount-tax-compensation-amount: option<f64>,
    /// Credit memo item ID.
    entity-id: s32,
    extension-attributes: option<sales-data-creditmemo-item-extension-interface>,
    /// Name.
    name: option<string>,
    /// Order item ID.
    order-item-id: s32,
    /// Parent ID.
    parent-id: option<s32>,
    /// Price.
    price: option<f64>,
    /// Price including tax.
    price-incl-tax: option<f64>,
    /// Product ID.
    product-id: option<s32>,
    /// Quantity.
    qty: f64,
    /// Row total.
    row-total: option<f64>,
    /// Row total including tax.
    row-total-incl-tax: option<f64>,
    /// SKU.
    sku: option<string>,
    /// Tax amount.
    tax-amount: option<f64>,
    /// WEEE tax applied.
    weee-tax-applied: option<string>,
    /// WEEE tax applied amount.
    weee-tax-applied-amount: option<f64>,
    /// WEEE tax applied row amount.
    weee-tax-applied-row-amount: option<f64>,
    /// WEEE tax disposition.
    weee-tax-disposition: option<f64>,
    /// WEEE tax row disposition.
    weee-tax-row-disposition: option<f64>
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\CreditmemoItemInterface
  record sales-data-creditmemo-item-extension-interface {
    invoice-text-codes: option<list<string>>,
    tax-codes: option<list<string>>,
    vertex-tax-codes: option<list<string>>
  }

  /// creditmemo
  record sales-creditmemo-repository-v1-save-post-params {
    entity: sales-data-creditmemo-interface
  }
  sales-creditmemo-repository-v1-save-post: func(params: sales-creditmemo-repository-v1-save-post-params) -> result<string, string>;

}

interface creditmemo-refund {
  /// Credit memo interface. After a customer places and pays for an order and an invoice has been issued, the merchant can create a credit memo to refund all or part of the amount paid for any returned or undelivered items. The memo restores funds to the customer account so that the customer can make future purchases.
  record sales-data-creditmemo-interface {
    /// Credit memo adjustment.
    adjustment: option<f64>,
    /// Credit memo negative adjustment.
    adjustment-negative: option<f64>,
    /// Credit memo positive adjustment.
    adjustment-positive: option<f64>,
    /// Credit memo base adjustment.
    base-adjustment: option<f64>,
    /// Credit memo negative base adjustment.
    base-adjustment-negative: option<f64>,
    /// Credit memo positive base adjustment.
    base-adjustment-positive: option<f64>,
    /// Credit memo base currency code.
    base-currency-code: option<string>,
    /// Credit memo base discount amount.
    base-discount-amount: option<f64>,
    /// Credit memo base discount tax compensation amount.
    base-discount-tax-compensation-amount: option<f64>,
    /// Credit memo base grand total.
    base-grand-total: option<f64>,
    /// Credit memo base shipping amount.
    base-shipping-amount: option<f64>,
    /// Credit memo base shipping discount tax compensation amount.
    base-shipping-discount-tax-compensation-amnt: option<f64>,
    /// Credit memo base shipping including tax.
    base-shipping-incl-tax: option<f64>,
    /// Credit memo base shipping tax amount.
    base-shipping-tax-amount: option<f64>,
    /// Credit memo base subtotal.
    base-subtotal: option<f64>,
    /// Credit memo base subtotal including tax.
    base-subtotal-incl-tax: option<f64>,
    /// Credit memo base tax amount.
    base-tax-amount: option<f64>,
    /// Credit memo base-to-global rate.
    base-to-global-rate: option<f64>,
    /// Credit memo base-to-order rate.
    base-to-order-rate: option<f64>,
    /// Credit memo billing address ID.
    billing-address-id: option<s32>,
    /// Array of any credit memo comments. Otherwise, null.
    comments: option<list<sales-data-creditmemo-comment-interface>>,
    /// Credit memo created-at timestamp.
    created-at: option<string>,
    /// Credit memo status.
    creditmemo-status: option<s32>,
    /// Credit memo discount amount.
    discount-amount: option<f64>,
    /// Credit memo discount description.
    discount-description: option<string>,
    /// Credit memo discount tax compensation amount.
    discount-tax-compensation-amount: option<f64>,
    /// Credit memo email sent flag value.
    email-sent: option<s32>,
    /// Credit memo ID.
    entity-id: option<s32>,
    extension-attributes: option<sales-data-creditmemo-extension-interface>,
    /// Credit memo global currency code.
