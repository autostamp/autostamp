  record asynchronous-operations-data-bulk-summary-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Getter Class OperationsStatusInterface Instead of OperationInterface this class don't provide all operation data and not responsive to set any data, just to get operation data without serialized_data and result_serialized_data
  record asynchronous-operations-data-summary-operation-status-interface {
    /// Error code
    error-code: s32,
    /// Id
    id: s32,
    /// Result message
    result-message: string,
    /// Operation status
    status: s32
  }

