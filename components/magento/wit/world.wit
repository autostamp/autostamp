    /// Store ID.
    store-id: option<s32>,
    /// Tax amount.
    tax-amount: option<f64>,
    /// Tax before discount.
    tax-before-discount: option<f64>,
    /// Tax canceled.
    tax-canceled: option<f64>,
    /// Tax invoiced.
    tax-invoiced: option<f64>,
    /// Tax percent.
    tax-percent: option<f64>,
    /// Tax refunded.
    tax-refunded: option<f64>,
