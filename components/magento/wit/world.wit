    /// GW price.
    gw-price: option<f64>,
    /// GW price invoiced.
    gw-price-invoiced: option<f64>,
    /// GW price refunded.
    gw-price-refunded: option<f64>,
    /// GW tax amount.
    gw-tax-amount: option<f64>,
    /// GW tax amount invoiced.
    gw-tax-amount-invoiced: option<f64>,
    /// GW tax amount refunded.
    gw-tax-amount-refunded: option<f64>,
    /// Is-quantity-decimal flag value.
    is-qty-decimal: option<s32>,
    /// Is-virtual flag value.
    is-virtual: option<s32>,
    /// Item ID.
    item-id: option<s32>,
    /// Locked DO invoice flag value.
    locked-do-invoice: option<s32>,
    /// Locked DO ship flag value.
    locked-do-ship: option<s32>,
    /// Name.
    name: option<string>,
    /// No-discount flag value.
    no-discount: option<s32>,
