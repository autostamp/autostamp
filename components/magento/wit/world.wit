    base-discount-amount: option<f64>,
    /// The base discount tax compensation amount for a credit memo item.
    base-discount-tax-compensation-amount: option<f64>,
    /// The base price for a credit memo item.
    base-price: f64,
    /// Base price including tax.
    base-price-incl-tax: option<f64>,
    /// Base row total.
    base-row-total: option<f64>,
    /// Base row total including tax.
    base-row-total-incl-tax: option<f64>,
    /// Base tax amount.
    base-tax-amount: option<f64>,
    /// Base WEEE tax applied amount.
    base-weee-tax-applied-amount: option<f64>,
    /// Base WEEE tax applied row amount.
    base-weee-tax-applied-row-amnt: option<f64>,
    /// Base WEEE tax disposition.
    base-weee-tax-disposition: option<f64>,
    /// Base WEEE tax row disposition.
    base-weee-tax-row-disposition: option<f64>,
    /// Description.
    description: option<string>,
    /// Discount amount.
    discount-amount: option<f64>,
    /// Discount tax compensation amount.
    discount-tax-compensation-amount: option<f64>,
    /// Credit memo item ID.
    entity-id: s32,
    extension-attributes: option<sales-data-creditmemo-item-extension-interface>,
    /// Name.
    name: option<string>,
    /// Order item ID.
    order-item-id: s32,
    /// Parent ID.
    parent-id: option<s32>,
    /// Price.
    price: option<f64>,
    /// Price including tax.
    price-incl-tax: option<f64>,
    /// Product ID.
    product-id: option<s32>,
    /// Quantity.
    qty: f64,
    /// Row total.
    row-total: option<f64>,
    /// Row total including tax.
    row-total-incl-tax: option<f64>,
    /// SKU.
    sku: option<string>,
    /// Tax amount.
    tax-amount: option<f64>,
    /// WEEE tax applied.
    weee-tax-applied: option<string>,
    /// WEEE tax applied amount.
    weee-tax-applied-amount: option<f64>,
    /// WEEE tax applied row amount.
    weee-tax-applied-row-amount: option<f64>,
    /// WEEE tax disposition.
    weee-tax-disposition: option<f64>,
    /// WEEE tax row disposition.
    weee-tax-row-disposition: option<f64>
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\CreditmemoItemInterface
  record sales-data-creditmemo-item-extension-interface {
    invoice-text-codes: option<list<string>>,
    tax-codes: option<list<string>>,
    vertex-tax-codes: option<list<string>>
  }

