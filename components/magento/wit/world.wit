    product-option: option<catalog-data-product-option-interface>,
    /// Product type.
    product-type: option<string>,
    /// Quantity backordered.
    qty-backordered: option<f64>,
    /// Quantity canceled.
    qty-canceled: option<f64>,
    /// Quantity invoiced.
    qty-invoiced: option<f64>,
    /// Quantity ordered.
