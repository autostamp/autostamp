interface carts-mine {
  /// Interface CartInterface
  record quote-data-cart-interface {
    billing-address: option<quote-data-address-interface>,
    /// Cart conversion date and time. Otherwise, null.
    converted-at: option<string>,
    /// Cart creation date and time. Otherwise, null.
    created-at: option<string>,
    currency: option<quote-data-currency-interface>,
    customer: customer-data-customer-interface,
    /// For guest customers, false for logged in customers
    customer-is-guest: option<bool>,
    /// Notice text
    customer-note: option<string>,
    /// Customer notification flag
    customer-note-notify: option<bool>,
    /// Customer tax class ID.
    customer-tax-class-id: option<s32>,
    extension-attributes: option<quote-data-cart-extension-interface>,
    /// Cart/quote ID.
    id: s32,
    /// Active status flag value. Otherwise, null.
    is-active: option<bool>,
    /// Virtual flag value. Otherwise, null.
    is-virtual: option<bool>,
    /// Array of items. Otherwise, null.
    items: option<list<quote-data-cart-item-interface>>,
    /// Number of different items or products in the cart. Otherwise, null.
    items-count: option<s32>,
    /// Total quantity of all cart items. Otherwise, null.
    items-qty: option<f64>,
    /// Original order ID. Otherwise, null.
    orig-order-id: option<s32>,
    /// Reserved order ID. Otherwise, null.
    reserved-order-id: option<string>,
    /// Store identifier
    store-id: s32,
    /// Cart last update date and time. Otherwise, null.
    updated-at: option<string>
  }

  /// Interface AddressInterface
  record quote-data-address-interface {
    /// City name
    city: string,
    /// Company
    company: option<string>,
    /// Country id
    country-id: string,
    /// Custom attributes values.
    custom-attributes: option<list<framework-attribute-interface>>,
    /// Customer address id
    customer-address-id: option<s32>,
    /// Customer id
    customer-id: option<s32>,
    /// Billing/shipping email
    email: string,
    extension-attributes: option<quote-data-address-extension-interface>,
    /// Fax number
    fax: option<string>,
    /// First name
    firstname: string,
    /// Id
    id: option<s32>,
    /// Last name
    lastname: string,
    /// Middle name
    middlename: option<string>,
    /// Postcode
    postcode: string,
    /// Prefix
    prefix: option<string>,
    /// Region name
    region: string,
    /// Region code
    region-code: string,
    /// Region id
    region-id: s32,
    /// Same as billing flag
    same-as-billing: option<s32>,
    /// Save in address book flag
    save-in-address-book: option<s32>,
    /// Street
    street: list<string>,
    /// Suffix
    suffix: option<string>,
    /// Telephone number
    telephone: string,
    /// Vat id
    vat-id: option<string>
  }

  /// Interface for custom attribute value.
  record framework-attribute-interface {
    /// Attribute code
    attribute-code: string,
    /// Attribute value
    value: string
  }

  /// ExtensionInterface class for @see \Magento\Quote\Api\Data\AddressInterface
  record quote-data-address-extension-interface {
    checkout-fields: option<list<framework-attribute-interface>>,
    gift-registry-id: option<s32>
  }

  /// Interface CurrencyInterface
  record quote-data-currency-interface {
    /// Base currency code
    base-currency-code: option<string>,
    /// Base currency to global currency rate
    base-to-global-rate: option<f64>,
    /// Base currency to quote currency rate
    base-to-quote-rate: option<f64>,
    extension-attributes: option<quote-data-currency-extension-interface>,
    /// Global currency code
    global-currency-code: option<string>,
    /// Quote currency code
    quote-currency-code: option<string>,
    /// Store currency code
    store-currency-code: option<string>,
    /// Store currency to base currency rate
    store-to-base-rate: option<f64>,
    /// Store currency to quote currency rate
    store-to-quote-rate: option<f64>
  }

  /// ExtensionInterface class for @see \Magento\Quote\Api\Data\CurrencyInterface
  record quote-data-currency-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Customer interface.
  record customer-data-customer-interface {
    /// Customer addresses.
    addresses: option<list<customer-data-address-interface>>,
    /// Confirmation
    confirmation: option<string>,
    /// Created at time
    created-at: option<string>,
    /// Created in area
    created-in: option<string>,
    /// Custom attributes values.
    custom-attributes: option<list<framework-attribute-interface>>,
    /// Default billing address id
    default-billing: option<string>,
    /// Default shipping address id
    default-shipping: option<string>,
    /// Disable auto group change flag.
    disable-auto-group-change: option<s32>,
    /// Date of birth
    dob: option<string>,
    /// Email address
    email: string,
    extension-attributes: option<customer-data-customer-extension-interface>,
    /// First name
    firstname: string,
    /// Gender
    gender: option<s32>,
    /// Group id
    group-id: option<s32>,
    /// Customer id
    id: option<s32>,
    /// Last name
    lastname: string,
    /// Middle name
    middlename: option<string>,
    /// Prefix
    prefix: option<string>,
    /// Store id
    store-id: option<s32>,
    /// Suffix
    suffix: option<string>,
    /// Tax Vat
    taxvat: option<string>,
    /// Updated at time
    updated-at: option<string>,
    /// Website id
    website-id: option<s32>
  }

  /// Customer address interface.
  record customer-data-address-interface {
    /// City name
    city: option<string>,
    /// Company
    company: option<string>,
    /// Country code in ISO_3166-2 format
    country-id: option<string>,
    /// Custom attributes values.
    custom-attributes: option<list<framework-attribute-interface>>,
    /// Customer ID
    customer-id: option<s32>,
    /// If this address is default billing address
    default-billing: option<bool>,
    /// If this address is default shipping address.
    default-shipping: option<bool>,
    extension-attributes: option<customer-data-address-extension-interface>,
    /// Fax number
    fax: option<string>,
    /// First name
    firstname: option<string>,
    /// ID
    id: option<s32>,
    /// Last name
    lastname: option<string>,
    /// Middle name
    middlename: option<string>,
    /// Postcode
    postcode: option<string>,
    /// Prefix
    prefix: option<string>,
    region: option<customer-data-region-interface>,
    /// Region ID
    region-id: option<s32>,
    /// Street
    street: option<list<string>>,
    /// Suffix
    suffix: option<string>,
    /// Telephone number
    telephone: option<string>,
    /// Vat id
    vat-id: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Customer\Api\Data\AddressInterface
  record customer-data-address-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Customer address region interface.
  record customer-data-region-interface {
    extension-attributes: option<customer-data-region-extension-interface>,
    /// Region
    region: string,
    /// Region code
    region-code: string,
    /// Region id
    region-id: s32
  }

  /// ExtensionInterface class for @see \Magento\Customer\Api\Data\RegionInterface
  record customer-data-region-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Customer\Api\Data\CustomerInterface
  record customer-data-customer-extension-interface {
    amazon-id: option<string>,
    company-attributes: option<company-data-company-customer-interface>,
    is-subscribed: option<bool>,
    vertex-customer-code: option<string>
  }

  /// Extended customer custom attributes interface.
  record company-data-company-customer-interface {
    /// Company ID.
    company-id: option<s32>,
    /// Customer ID.
    customer-id: option<s32>,
    extension-attributes: option<company-data-company-customer-extension-interface>,
    /// Get job title.
    job-title: option<string>,
    /// Customer status.
    status: option<s32>,
    /// Get telephone.
    telephone: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Company\Api\Data\CompanyCustomerInterface
  record company-data-company-customer-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Quote\Api\Data\CartInterface
  record quote-data-cart-extension-interface {
    amazon-order-reference-id: option<string>,
    negotiable-quote: option<negotiable-quote-data-negotiable-quote-interface>,
