interface shipment {
  /// Shipment interface. A shipment is a delivery package that contains products. A shipment document accompanies the shipment. This document lists the products and their quantities in the delivery package.
  record sales-data-shipment-interface {
    /// Billing address ID.
    billing-address-id: option<s32>,
    /// Array of comments.
    comments: list<sales-data-shipment-comment-interface>,
    /// Created-at timestamp.
    created-at: option<string>,
    /// Customer ID.
    customer-id: option<s32>,
    /// Email-sent flag value.
    email-sent: option<s32>,
    /// Shipment ID.
    entity-id: option<s32>,
    extension-attributes: option<sales-data-shipment-extension-interface>,
    /// Increment ID.
    increment-id: option<string>,
    /// Array of items.
    items: list<sales-data-shipment-item-interface>,
    /// Order ID.
    order-id: s32,
    /// Array of packages, if any. Otherwise, null.
    packages: option<list<sales-data-shipment-package-interface>>,
    /// Shipment status.
    shipment-status: option<s32>,
    /// Shipping address ID.
    shipping-address-id: option<s32>,
    /// Shipping label.
    shipping-label: option<string>,
    /// Store ID.
    store-id: option<s32>,
    /// Total quantity.
    total-qty: option<f64>,
    /// Total weight.
    total-weight: option<f64>,
    /// Array of tracks.
    tracks: list<sales-data-shipment-track-interface>,
    /// Updated-at timestamp.
    updated-at: option<string>
  }

  /// Shipment comment interface. A shipment is a delivery package that contains products. A shipment document accompanies the shipment. This document lists the products and their quantities in the delivery package. A shipment document can contain comments.
  record sales-data-shipment-comment-interface {
    /// Comment.
    comment: string,
    /// Created-at timestamp.
    created-at: option<string>,
    /// Invoice ID.
    entity-id: option<s32>,
    extension-attributes: option<sales-data-shipment-comment-extension-interface>,
    /// Is-customer-notified flag value.
    is-customer-notified: s32,
    /// Is-visible-on-storefront flag value.
    is-visible-on-front: s32,
    /// Parent ID.
    parent-id: s32
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\ShipmentCommentInterface
  record sales-data-shipment-comment-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\ShipmentInterface
  record sales-data-shipment-extension-interface {
    ext-location-id: option<string>,
    ext-return-shipment-id: option<string>,
    ext-shipment-id: option<string>,
    ext-tracking-reference: option<string>,
    ext-tracking-url: option<string>
  }

  /// Shipment item interface. A shipment is a delivery package that contains products. A shipment document accompanies the shipment. This document lists the products and their quantities in the delivery package. A product is an item in a shipment.
  record sales-data-shipment-item-interface {
    /// Additional data.
    additional-data: option<string>,
    /// Description.
    description: option<string>,
    /// Shipment item ID.
    entity-id: option<s32>,
    extension-attributes: option<sales-data-shipment-item-extension-interface>,
    /// Name.
    name: option<string>,
    /// Order item ID.
    order-item-id: s32,
    /// Parent ID.
    parent-id: option<s32>,
    /// Price.
    price: option<f64>,
    /// Product ID.
    product-id: option<s32>,
    /// Quantity.
    qty: f64,
    /// Row total.
    row-total: option<f64>,
    /// SKU.
    sku: option<string>,
    /// Weight.
    weight: option<f64>
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\ShipmentItemInterface
  record sales-data-shipment-item-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Shipment package interface. A shipment is a delivery package that contains products. A shipment document accompanies the shipment. This document lists the products and their quantities in the delivery package.
  record sales-data-shipment-package-interface {
    extension-attributes: option<sales-data-shipment-package-extension-interface>
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\ShipmentPackageInterface
  record sales-data-shipment-package-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Shipment track interface. A shipment is a delivery package that contains products. A shipment document accompanies the shipment. This document lists the products and their quantities in the delivery package. Merchants and customers can track shipments.
  record sales-data-shipment-track-interface {
    /// Carrier code.
    carrier-code: string,
    /// Created-at timestamp.
    created-at: option<string>,
    /// Description.
    description: string,
    /// Shipment package ID.
    entity-id: option<s32>,
    extension-attributes: option<sales-data-shipment-track-extension-interface>,
    /// The order_id for the shipment package.
    order-id: s32,
    /// Parent ID.
    parent-id: s32,
    /// Quantity.
    qty: f64,
    /// Title.
    title: string,
    /// Track number.
    track-number: string,
    /// Updated-at timestamp.
    updated-at: option<string>,
    /// Weight.
    weight: f64
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\ShipmentTrackInterface
  record sales-data-shipment-track-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// shipment/
  record sales-shipment-repository-v1-save-post-params {
    entity: sales-data-shipment-interface
  }
  sales-shipment-repository-v1-save-post: func(params: sales-shipment-repository-v1-save-post-params) -> result<string, string>;

}

