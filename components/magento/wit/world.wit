    /// Description
    description: option<string>,
    /// Discount amount
    discount-amount: f64,
    /// Maximum qty discount is applied
    discount-qty: option<f64>,
    /// Discount step
    discount-step: s32,
    extension-attributes: option<sales-rule-data-rule-extension-interface>,
    /// The start date when the coupon is active
    from-date: option<string>,
    /// The coupon is active
    is-active: bool,
    /// Is this field needed
    is-advanced: bool,
    /// Whether the rule is in RSS
    is-rss: bool,
    /// Rule name
    name: option<string>,
    /// Product ids
    product-ids: option<list<s32>>,
    /// Rule id
    rule-id: option<s32>,
    /// Simple action of the rule
    simple-action: option<string>,
    /// To grant free shipping
    simple-free-shipping: option<string>,
    /// Sort order
    sort-order: s32,
    /// To stop rule processing
    stop-rules-processing: bool,
    /// Display label
    store-labels: option<list<sales-rule-data-rule-label-interface>>,
    /// How many times the rule has been used
    times-used: s32,
    /// The end date when the coupon is active
    to-date: option<string>,
    /// To auto generate coupon
    use-auto-generation: bool,
    /// Limit of uses per coupon
    uses-per-coupon: s32,
    /// Number of uses per customer
    uses-per-customer: s32,
    /// A list of websites the rule applies to
    website-ids: list<s32>
  }

  /// Interface ConditionInterface
