    /// Postal code.
    postcode: string,
    /// Prefix.
    prefix: option<string>,
    /// Region.
    region: option<string>,
    /// Region code.
    region-code: option<string>,
    /// Region ID.
    region-id: option<s32>,
    /// Array of any street values. Otherwise, null.
    street: option<list<string>>,
    /// Suffix.
    suffix: option<string>,
    /// Telephone number.
    telephone: string,
    /// VAT ID.
    vat-id: option<string>,
    /// VAT-is-valid flag value.
    vat-is-valid: option<s32>,
    /// VAT request date.
    vat-request-date: option<string>,
    /// VAT request ID.
    vat-request-id: option<string>,
    /// VAT-request-success flag value.
    vat-request-success: option<s32>
  }

  /// ExtensionInterface class for @see \Magento\Sales\Api\Data\OrderAddressInterface
  record sales-data-order-address-extension-interface {
    checkout-fields: option<list<framework-attribute-interface>>
  }

  /// Interface for custom attribute value.
  record framework-attribute-interface {
    /// Attribute code
    attribute-code: string,
    /// Attribute value
    value: string
  }

  variant sales-order-address-repository-v1-save-put-error {
    unauthorized(string),
    other(string)
  }

  /// orders/{parent_id}
  record sales-order-address-repository-v1-save-put-params {
    parent-id: string,
    entity: sales-data-order-address-interface
  }
  sales-order-address-repository-v1-save-put: func(params: sales-order-address-repository-v1-save-put-params) -> result<sales-data-order-address-interface, sales-order-address-repository-v1-save-put-error>;

}

interface products {
  record catalog-data-product-search-results-interface {
    /// Attributes list.
    items: list<catalog-data-product-interface>,
    search-criteria: framework-search-criteria-interface,
    /// Total count.
    total-count: s32
  }

  record catalog-data-product-interface {
    /// Attribute set id
    attribute-set-id: option<s32>,
    /// Created date
    created-at: option<string>,
    /// Custom attributes values.
    custom-attributes: option<list<framework-attribute-interface>>,
    extension-attributes: option<catalog-data-product-extension-interface>,
    /// Id
    id: option<s32>,
    /// Media gallery entries
    media-gallery-entries: option<list<catalog-data-product-attribute-media-gallery-entry-interface>>,
    /// Name
    name: option<string>,
    /// List of product options
    options: option<list<catalog-data-product-custom-option-interface>>,
    /// Price
    price: option<f64>,
    /// Product links info
    product-links: option<list<catalog-data-product-link-interface>>,
    /// Sku
    sku: string,
    /// Status
    status: option<s32>,
    /// List of product tier prices
    tier-prices: option<list<catalog-data-product-tier-price-interface>>,
    /// Type id
    type-id: option<string>,
    /// Updated date
    updated-at: option<string>,
    /// Visibility
    visibility: option<s32>,
    /// Weight
    weight: option<f64>
  }

  /// Interface for custom attribute value.
  record framework-attribute-interface {
    /// Attribute code
    attribute-code: string,
    /// Attribute value
    value: string
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductInterface
  record catalog-data-product-extension-interface {
    bundle-product-options: option<list<bundle-data-option-interface>>,
    category-links: option<list<catalog-data-category-link-interface>>,
    configurable-product-links: option<list<s32>>,
    configurable-product-options: option<list<configurable-product-data-option-interface>>,
    downloadable-product-links: option<list<downloadable-data-link-interface>>,
    downloadable-product-samples: option<list<downloadable-data-sample-interface>>,
    giftcard-amounts: option<list<gift-card-data-giftcard-amount-interface>>,
    stock-item: option<catalog-inventory-data-stock-item-interface>,
    website-ids: option<list<s32>>
  }

  /// Interface OptionInterface
  record bundle-data-option-interface {
    extension-attributes: option<bundle-data-option-extension-interface>,
    /// Option id
    option-id: option<s32>,
    /// Option position
    position: option<s32>,
    /// Product links
    product-links: option<list<bundle-data-link-interface>>,
    /// Is required option
    required: option<bool>,
    /// Product sku
    sku: option<string>,
    /// Option title
    title: option<string>,
    /// Input type
    type-op: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Bundle\Api\Data\OptionInterface
  record bundle-data-option-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Interface LinkInterface
  record bundle-data-link-interface {
    /// Whether quantity could be changed
    can-change-quantity: option<s32>,
    extension-attributes: option<bundle-data-link-extension-interface>,
    /// The identifier
    id: option<string>,
    /// Is default
    is-default: bool,
    /// Option id
    option-id: option<s32>,
    /// Position
    position: option<s32>,
    /// Price
    price: f64,
    /// Price type
    price-type: s32,
    /// Qty
    qty: option<f64>,
    /// Linked product sku
    sku: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Bundle\Api\Data\LinkInterface
  record bundle-data-link-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record catalog-data-category-link-interface {
    /// Category id
    category-id: string,
    extension-attributes: option<catalog-data-category-link-extension-interface>,
    position: option<s32>
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\CategoryLinkInterface
  record catalog-data-category-link-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Interface OptionInterface
  record configurable-product-data-option-interface {
    attribute-id: option<string>,
    extension-attributes: option<configurable-product-data-option-extension-interface>,
    id: option<s32>,
    is-use-default: option<bool>,
    label: option<string>,
    position: option<s32>,
    product-id: option<s32>,
    values: option<list<configurable-product-data-option-value-interface>>
  }

  /// ExtensionInterface class for @see \Magento\ConfigurableProduct\Api\Data\OptionInterface
  record configurable-product-data-option-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Interface OptionValueInterface
  record configurable-product-data-option-value-interface {
    extension-attributes: option<configurable-product-data-option-value-extension-interface>,
    value-index: s32
  }

  /// ExtensionInterface class for @see \Magento\ConfigurableProduct\Api\Data\OptionValueInterface
  record configurable-product-data-option-value-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record downloadable-data-link-interface {
    extension-attributes: option<downloadable-data-link-extension-interface>,
    /// Sample(or link) id
    id: option<s32>,
    /// Shareable status
    is-shareable: s32,
    /// relative file path
    link-file: option<string>,
    link-file-content: option<downloadable-data-file-content-interface>,
    link-type: string,
    /// Link url or null when type is 'file'
    link-url: option<string>,
    /// Of downloads per user
    number-of-downloads: option<s32>,
    /// Price
    price: f64,
    /// relative file path
    sample-file: option<string>,
    sample-file-content: option<downloadable-data-file-content-interface>,
    sample-type: string,
    /// file URL
    sample-url: option<string>,
    sort-order: s32,
    title: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Downloadable\Api\Data\LinkInterface
  record downloadable-data-link-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record downloadable-data-file-content-interface {
    extension-attributes: option<downloadable-data-file-content-extension-interface>,
    /// Data (base64 encoded content)
    file-data: string,
    /// File name
    name: string
  }

  /// ExtensionInterface class for @see \Magento\Downloadable\Api\Data\File\ContentInterface
  record downloadable-data-file-content-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record downloadable-data-sample-interface {
    extension-attributes: option<downloadable-data-sample-extension-interface>,
    /// Sample(or link) id
    id: option<s32>,
    /// relative file path
    sample-file: option<string>,
    sample-file-content: option<downloadable-data-file-content-interface>,
    sample-type: string,
    /// file URL
    sample-url: option<string>,
    /// Order index for sample
    sort-order: s32,
    /// Title
    title: string
  }

  /// ExtensionInterface class for @see \Magento\Downloadable\Api\Data\SampleInterface
  record downloadable-data-sample-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Interface GiftcardAmountInterface: this interface is used to serialize and deserialize EAV attribute giftcard_amounts
  record gift-card-data-giftcard-amount-interface {
    attribute-id: s32,
    extension-attributes: option<gift-card-data-giftcard-amount-extension-interface>,
    value: f64,
    website-id: s32,
    website-value: f64
  }

  /// ExtensionInterface class for @see \Magento\GiftCard\Api\Data\GiftcardAmountInterface
  record gift-card-data-giftcard-amount-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Interface StockItem
  record catalog-inventory-data-stock-item-interface {
    /// Backorders status
    backorders: s32,
    /// Whether Quantity Increments is enabled
    enable-qty-increments: bool,
    extension-attributes: option<catalog-inventory-data-stock-item-extension-interface>,
    is-decimal-divided: bool,
    /// Stock Availability
    is-in-stock: bool,
    is-qty-decimal: bool,
    item-id: option<s32>,
    low-stock-date: string,
    /// Can Manage Stock
    manage-stock: bool,
    /// Maximum Qty Allowed in Shopping Cart data wrapper
    max-sale-qty: f64,
    /// Minimal quantity available for item status in stock
    min-qty: f64,
    /// Minimum Qty Allowed in Shopping Cart or NULL when there is no limitation
    min-sale-qty: f64,
    /// Notify for Quantity Below data wrapper
    notify-stock-qty: f64,
    product-id: option<s32>,
    qty: f64,
    /// Quantity Increments data wrapper
    qty-increments: f64,
    show-default-notification-message: bool,
    /// Stock identifier
    stock-id: option<s32>,
    stock-status-changed-auto: s32,
    use-config-backorders: bool,
    use-config-enable-qty-inc: bool,
    use-config-manage-stock: bool,
    use-config-max-sale-qty: bool,
    use-config-min-qty: bool,
    use-config-min-sale-qty: s32,
    use-config-notify-stock-qty: bool,
    use-config-qty-increments: bool
  }

  /// ExtensionInterface class for @see \Magento\CatalogInventory\Api\Data\StockItemInterface
  record catalog-inventory-data-stock-item-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record catalog-data-product-attribute-media-gallery-entry-interface {
    content: option<framework-data-image-content-interface>,
    /// If gallery entry is hidden from product page
    disabled: bool,
    extension-attributes: option<catalog-data-product-attribute-media-gallery-entry-extension-interface>,
    /// File path
    file: option<string>,
    /// Gallery entry ID
    id: option<s32>,
    /// Gallery entry alternative text
    label: string,
    /// Media type
    media-type: string,
    /// Gallery entry position (sort order)
    position: s32,
    /// Gallery entry image types (thumbnail, image, small_image etc)
    types: list<string>
  }

  /// Image Content data interface
  record framework-data-image-content-interface {
    /// Media data (base64 encoded content)
    base64-encoded-data: string,
    /// Image name
    name: string,
    /// MIME type
    type-op: string
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductAttributeMediaGalleryEntryInterface
  record catalog-data-product-attribute-media-gallery-entry-extension-interface {
    video-content: option<framework-data-video-content-interface>
  }

  /// Video Content data interface
  record framework-data-video-content-interface {
    /// MIME type
    media-type: string,
    /// Video Description
    video-description: string,
    /// Metadata
    video-metadata: string,
    /// Provider
    video-provider: string,
    /// Title
    video-title: string,
    /// Video URL
    video-url: string
  }

  record catalog-data-product-custom-option-interface {
    extension-attributes: option<catalog-data-product-custom-option-extension-interface>,
    file-extension: option<string>,
    image-size-x: option<s32>,
    image-size-y: option<s32>,
    /// Is require
    is-require: bool,
    max-characters: option<s32>,
    /// Option id
    option-id: option<s32>,
    /// Price
    price: option<f64>,
    /// Price type
    price-type: option<string>,
    /// Product SKU
    product-sku: string,
    /// Sku
    sku: option<string>,
    /// Sort order
    sort-order: s32,
    /// Option title
    title: string,
    /// Option type
    type-op: string,
    values: option<list<catalog-data-product-custom-option-values-interface>>
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductCustomOptionInterface
  record catalog-data-product-custom-option-extension-interface {
    vertex-flex-field: option<string>
  }

  record catalog-data-product-custom-option-values-interface {
    /// Option type id
    option-type-id: option<s32>,
    /// Price
    price: f64,
    /// Price type
    price-type: string,
    /// Sku
    sku: option<string>,
    /// Sort order
    sort-order: s32,
    /// Option title
    title: string
  }

  record catalog-data-product-link-interface {
    extension-attributes: option<catalog-data-product-link-extension-interface>,
    /// Link type
    link-type: string,
    /// Linked product sku
    linked-product-sku: string,
    /// Linked product type (simple, virtual, etc)
    linked-product-type: string,
    /// Linked item position
    position: s32,
    /// SKU
    sku: string
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductLinkInterface
  record catalog-data-product-link-extension-interface {
    qty: option<f64>
  }

  record catalog-data-product-tier-price-interface {
    /// Customer group id
    customer-group-id: s32,
    extension-attributes: option<catalog-data-product-tier-price-extension-interface>,
    /// Tier qty
    qty: f64,
    /// Price value
    value: f64
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductTierPriceInterface
  record catalog-data-product-tier-price-extension-interface {
    percentage-value: option<f64>,
    website-id: option<s32>
  }

  /// Search criteria interface.
  record framework-search-criteria-interface {
    /// Current page.
    current-page: option<s32>,
    /// A list of filter groups.
    filter-groups: list<framework-search-filter-group>,
    /// Page size.
    page-size: option<s32>,
    /// Sort order.
    sort-orders: option<list<framework-sort-order>>
  }

  /// Groups two or more filters together using a logical OR
  record framework-search-filter-group {
    /// A list of filters in this group
    filters: option<list<framework-filter>>
  }

  /// Filter which can be used by any methods from service layer.
  record framework-filter {
    /// Condition type
    condition-type: option<string>,
    /// Field
    field: string,
    /// Value
    value: string
  }

  /// Data object for sort order.
  record framework-sort-order {
    /// Sorting direction.
    direction: string,
    /// Sorting field.
    field: string
  }

  variant catalog-product-repository-v1-get-list-get-error {
    unauthorized(string),
    other(string)
  }

  variant catalog-product-repository-v1-save-post-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// products
  record catalog-product-repository-v1-get-list-get-params {
    /// Field
    search-criteria-filter-groups-v0-filters-v0-field: option<string>,
    /// Value
    search-criteria-filter-groups-v0-filters-v0-value: option<string>,
    /// Condition type
    search-criteria-filter-groups-v0-filters-v0-condition-type: option<string>,
    /// Sorting field.
    search-criteria-sort-orders-v0-field: option<string>,
    /// Sorting direction.
    search-criteria-sort-orders-v0-direction: option<string>,
    /// Page size.
    search-criteria-page-size: option<s32>,
    /// Current page.
    search-criteria-current-page: option<s32>
  }
  catalog-product-repository-v1-get-list-get: func(params: catalog-product-repository-v1-get-list-get-params) -> result<catalog-data-product-search-results-interface, catalog-product-repository-v1-get-list-get-error>;

  /// products
  record catalog-product-repository-v1-save-post-params {
    product: catalog-data-product-interface,
    save-options: option<bool>
  }
  catalog-product-repository-v1-save-post: func(params: catalog-product-repository-v1-save-post-params) -> result<catalog-data-product-interface, catalog-product-repository-v1-save-post-error>;

}

interface products-render-info {
  /// Dto that holds render information about products
  record catalog-data-product-render-search-results-interface {
    /// List of products rendered information
    items: list<catalog-data-product-render-interface>
  }

  /// Represents Data Object which holds enough information to render product This information is put into part as Add To Cart or Add to Compare Data or Price Data
  record catalog-data-product-render-interface {
    add-to-cart-button: catalog-data-product-render-button-interface,
    add-to-compare-button: catalog-data-product-render-button-interface,
    /// Current or desired currency code to product
    currency-code: string,
    extension-attributes: catalog-data-product-render-extension-interface,
    /// Product identifier
    id: s32,
    /// Enough information, that needed to render image on front
    images: list<catalog-data-product-render-image-interface>,
    /// Information about product saleability (In Stock)
    is-salable: string,
    /// Product name
    name: string,
    price-info: catalog-data-product-render-price-info-interface,
    /// Information about current store id or requested store id
    store-id: s32,
    /// Product type. Such as bundle, grouped, simple, etc...
    type-op: string,
    /// Product url
    url: string
  }

  /// Button interface. This interface represents all manner of product buttons: add to cart, add to compare, etc... The buttons describes by this interface should have interaction with backend
  record catalog-data-product-render-button-interface {
    extension-attributes: option<catalog-data-product-render-button-extension-interface>,
    /// Post data
    post-data: string,
    /// Flag whether a product has options or not
    required-options: bool,
    /// Url, needed to add product to cart
    url: string
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductRender\ButtonInterface
  record catalog-data-product-render-button-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductRenderInterface
  record catalog-data-product-render-extension-interface {
    review-html: option<string>,
    wishlist-button: option<catalog-data-product-render-button-interface>
  }

  /// Product Render image interface. Represents physical characteristics of image, that can be used in product listing or product view
  record catalog-data-product-render-image-interface {
    /// Image code
    code: string,
    extension-attributes: option<catalog-data-product-render-image-extension-interface>,
    /// Image height
    height: f64,
    /// Image label
    label: string,
    /// Resize height
    resized-height: f64,
    /// Resize width
    resized-width: f64,
    /// Image url
    url: string,
    /// Image width in px
    width: f64
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductRender\ImageInterface
  record catalog-data-product-render-image-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Price interface.
  record catalog-data-product-render-price-info-interface {
    extension-attributes: option<catalog-data-product-render-price-info-extension-interface>,
    /// Final price
    final-price: f64,
    formatted-prices: catalog-data-product-render-formatted-price-info-interface,
    /// Max price of a product
    max-price: f64,
    /// Max regular price
    max-regular-price: f64,
    minimal-price: f64,
    /// Minimal regular price
    minimal-regular-price: f64,
    /// Regular price
    regular-price: f64,
    /// Special price
    special-price: f64
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductRender\PriceInfoInterface
  record catalog-data-product-render-price-info-extension-interface {
    msrp: option<msrp-data-product-render-msrp-price-info-interface>,
    tax-adjustments: option<string>,
    weee-adjustment: option<string>,
    weee-attributes: option<list<weee-data-product-render-weee-adjustment-attribute-interface>>
  }

  /// Price interface.
  record msrp-data-product-render-msrp-price-info-interface {
    explanation-message: string,
    extension-attributes: option<msrp-data-product-render-msrp-price-info-extension-interface>,
    is-applicable: string,
    is-shown-price-on-gesture: string,
    msrp-message: string,
    msrp-price: string
  }

  /// ExtensionInterface class for @see \Magento\Msrp\Api\Data\ProductRender\MsrpPriceInfoInterface
  record msrp-data-product-render-msrp-price-info-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List of all weee attributes, their amounts, etc.., that product has
  record weee-data-product-render-weee-adjustment-attribute-interface {
    /// Weee attribute amount
    amount: string,
    /// Product amount exclude tax
    amount-excl-tax: string,
    /// Weee attribute code
    attribute-code: string,
    extension-attributes: weee-data-product-render-weee-adjustment-attribute-extension-interface,
    /// Tax which is calculated to fixed product tax attribute
    tax-amount: string,
    /// Tax amount of weee attribute
    tax-amount-incl-tax: string
  }

  /// ExtensionInterface class for @see \Magento\Weee\Api\Data\ProductRender\WeeeAdjustmentAttributeInterface
  record weee-data-product-render-weee-adjustment-attribute-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Formatted Price interface. Aggregate formatted html with price representations. E.g.: <span class="price">$9.00</span> Consider currency, rounding and html
  record catalog-data-product-render-formatted-price-info-interface {
    extension-attributes: option<catalog-data-product-render-formatted-price-info-extension-interface>,
    /// Html with final price
    final-price: string,
    /// Max price of a product
    max-price: string,
    /// Max regular price
    max-regular-price: string,
    /// The minimal price of the product or variation
    minimal-price: string,
    /// Minimal regular price
    minimal-regular-price: string,
    /// Price - is price of product without discounts and special price with taxes and fixed product tax
    regular-price: string,
    /// Special price
    special-price: string
  }

  /// ExtensionInterface class for @see \Magento\Catalog\Api\Data\ProductRender\FormattedPriceInfoInterface
  record catalog-data-product-render-formatted-price-info-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// products-render-info
  record catalog-product-render-list-v1-get-list-get-params {
    /// Field
    search-criteria-filter-groups-v0-filters-v0-field: option<string>,
    /// Value
    search-criteria-filter-groups-v0-filters-v0-value: option<string>,
    /// Condition type
    search-criteria-filter-groups-v0-filters-v0-condition-type: option<string>,
    /// Sorting field.
    search-criteria-sort-orders-v0-field: option<string>,
    /// Sorting direction.
    search-criteria-sort-orders-v0-direction: option<string>,
    /// Page size.
    search-criteria-page-size: option<s32>,
    /// Current page.
    search-criteria-current-page: option<s32>,
    store-id: s32,
    currency-code: string
  }
  catalog-product-render-list-v1-get-list-get: func(params: catalog-product-render-list-v1-get-list-get-params) -> result<catalog-data-product-render-search-results-interface, string>;

}

interface products-attribute-sets {
  /// Interface AttributeSetInterface
  record eav-data-attribute-set-interface {
    /// Attribute set ID
    attribute-set-id: option<s32>,
    /// Attribute set name
    attribute-set-name: string,
    /// Attribute set entity type id
    entity-type-id: option<s32>,
    extension-attributes: option<eav-data-attribute-set-extension-interface>,
    /// Attribute set sort order index
    sort-order: s32
