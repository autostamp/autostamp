interface bulk-bulk-uuid-detailed-status {
  /// Interface BulkStatusInterface Bulk summary data with list of operations items full data.
  record asynchronous-operations-data-detailed-bulk-operations-status-interface {
    /// Bulk uuid
    bulk-id: string,
    /// Bulk description
    description: string,
    extension-attributes: option<asynchronous-operations-data-bulk-summary-extension-interface>,
    /// Total number of operations scheduled in scope of this bulk
    operation-count: s32,
    /// Operations list.
    operations-list: list<asynchronous-operations-data-detailed-operation-status-interface>,
    /// Bulk scheduled time
    start-time: string,
    /// User id
    user-id: s32
  }

  /// ExtensionInterface class for @see \Magento\AsynchronousOperations\Api\Data\BulkSummaryInterface
  record asynchronous-operations-data-bulk-summary-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record asynchronous-operations-data-detailed-operation-status-interface {
    /// Bulk uuid
    bulk-uuid: string,
    /// Error code
    error-code: s32,
    extension-attributes: option<asynchronous-operations-data-operation-extension-interface>,
    /// Id
    id: s32,
    /// Result message
    result-message: string,
    /// Serialized Data
    result-serialized-data: string,
    /// Data
    serialized-data: string,
    /// Operation status
    status: s32,
    /// Queue Topic
    topic-name: string
  }

  /// ExtensionInterface class for @see \Magento\AsynchronousOperations\Api\Data\OperationInterface
  record asynchronous-operations-data-operation-extension-interface {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant asynchronous-operations-bulk-status-v1-get-bulk-detailed-status-get-error {
    bad-request(string),
    unauthorized(string),
    other(string)
  }

  /// bulk/{bulkUuid}/detailed-status
  record asynchronous-operations-bulk-status-v1-get-bulk-detailed-status-get-params {
    bulk-uuid: string
  }
