    bad-request(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant put-folders-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-error {
    bad-request(string),
    internal-server-error(string),
    other(string)
  }

  variant delete-folders-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-error {
    bad-request(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

