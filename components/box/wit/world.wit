    /// The email address of the user to assign to the task.
    /// To specify a user by their user ID please use the `id` parameter.
    login: option<string>
  }

  /// The task to assign to a user.
  record post-task-assignments-body-task {
    /// The ID of the task
    id: string,
    /// The type of the item to assign.
    type-op: post-task-assignments-body-task-type-op-enum
  }

  /// A task assignment defines which task is assigned to which user to complete.
  record task-assignment {
    /// The date at which this task was assigned to the user.
    assigned-at: option<string>,
    assigned-by: option<task-assignment-assigned-by>,
    assigned-to: option<task-assignment-assigned-to>,
    /// The date at which this task assignment was
    /// completed. This will be `null` if the task is not completed yet.
    completed-at: option<string>,
    /// The unique identifier for this task assignment
    id: option<string>,
    item: option<task-assignment-item>,
    /// A message that will is included with the task
    /// assignment. This is visible to the assigned user in the web and mobile
    message: option<string>,
    /// The date at which the assigned user was reminded of this task
    /// assignment.
    reminded-at: option<string>,
    /// The current state of the assignment. The available states depend on
    /// the `action` value of the task object.
    resolution-state: option<task-assignment-resolution-state-enum>,
    /// `task_assignment`
    type-op: option<task-assignment-type-op-enum>
  }

  record task-assignment-assigned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-assignment-assigned-to {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-assignment-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A list of task assignments
  record task-assignments {
    entries: option<list<task-assignment>>,
    /// The total number of items in this collection.
    total-count: option<s64>
  }

  variant post-task-assignments-error {
    forbidden(string),
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  variant get-task-assignments-id-error {
    not-found(string),
    other(string)
  }

  variant put-task-assignments-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant delete-task-assignments-id-error {
    not-found(string),
    other(string)
  }

  variant get-tasks-id-assignments-error {
    not-found(string),
    internal-server-error(string),
    other(string)
  }

  /// Assign task
  record post-task-assignments-params {
    /// The user to assign the task to.
    assign-to: post-task-assignments-body-assign-to,
    /// The task to assign to a user.
    task: post-task-assignments-body-task
  }
  post-task-assignments: func(params: post-task-assignments-params) -> result<task-assignment, post-task-assignments-error>;

  /// Get task assignment
  record get-task-assignments-id-params {
    /// The ID of the task assignment.
    task-assignment-id: string
  }
  get-task-assignments-id: func(params: get-task-assignments-id-params) -> result<task-assignment, get-task-assignments-id-error>;

  /// Update task assignment
  record put-task-assignments-id-params {
    /// The ID of the task assignment.
    task-assignment-id: string,
    /// An optional message by the assignee that can be added to the task.
    message: option<string>,
    /// The state of the task assigned to the user.
    /// 
    resolution-state: option<task-assignment-resolution-state-enum>
  }
  put-task-assignments-id: func(params: put-task-assignments-id-params) -> result<task-assignment, put-task-assignments-id-error>;

  /// Unassign task
  record delete-task-assignments-id-params {
    /// The ID of the task assignment.
    task-assignment-id: string
  }
  delete-task-assignments-id: func(params: delete-task-assignments-id-params) -> result<string, delete-task-assignments-id-error>;

  /// List task assignments
  record get-tasks-id-assignments-params {
    /// The ID of the task.
    task-id: string
  }
  get-tasks-id-assignments: func(params: get-tasks-id-assignments-params) -> result<task-assignments, get-tasks-id-assignments-error>;

}

interface terms-of-service-user-statuses {
  enum terms-of-service-user-status-tos-type-op-enum {
    terms-of-service,
  }

  enum terms-of-service-user-status-type-op-enum {
    terms-of-service-user-status,
  }

  enum post-terms-of-service-user-statuses-body-user-type-op-enum {
    user,
  }

  /// A list of terms of service user statuses
  record terms-of-service-user-statuses {
    entries: option<list<terms-of-service-user-status>>,
    /// The total number of objects.
    total-count: option<s64>
  }

  /// The association between a Terms of Service and a user
  record terms-of-service-user-status {
    /// When the legal item was created
    created-at: option<string>,
    /// The unique identifier for this terms of service user status
    id: option<string>,
    /// If the user has accepted the terms of services
    is-accepted: option<bool>,
    /// When the legal item was modified.
    modified-at: option<string>,
    tos: option<terms-of-service-user-status-tos>,
    /// `terms_of_service_user_status`
    type-op: option<terms-of-service-user-status-type-op-enum>,
    user: option<terms-of-service-user-status-user>
  }

  record terms-of-service-user-status-tos {
    /// The unique identifier for this terms of service.
    id: option<string>,
    /// `terms_of_service`
    type-op: option<terms-of-service-user-status-tos-type-op-enum>
  }

  record terms-of-service-user-status-user {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The terms of service to set the status for.
  record post-terms-of-service-user-statuses-body-tos {
    /// The ID of terms of service
    id: string,
    /// The type of object.
    type-op: terms-of-service-user-status-tos-type-op-enum
  }

  /// The user to set the status for.
  record post-terms-of-service-user-statuses-body-user {
    /// The ID of user
    id: string,
    /// The type of object.
    type-op: post-terms-of-service-user-statuses-body-user-type-op-enum
  }

  /// List terms of service user statuses
  record get-terms-of-service-user-statuses-params {
    /// The ID of the terms of service.
    tos-id: string,
    /// Limits results to the given user ID.
    user-id: option<string>
  }
  get-terms-of-service-user-statuses: func(params: get-terms-of-service-user-statuses-params) -> result<terms-of-service-user-statuses, string>;

  /// Create terms of service status for new user
  record post-terms-of-service-user-statuses-params {
    /// Whether the user has accepted the terms.
    is-accepted: bool,
    /// The terms of service to set the status for.
    tos: post-terms-of-service-user-statuses-body-tos,
    /// The user to set the status for.
    user: post-terms-of-service-user-statuses-body-user
  }
  post-terms-of-service-user-statuses: func(params: post-terms-of-service-user-statuses-params) -> result<terms-of-service-user-status, string>;

  /// Update terms of service status for existing user
  record put-terms-of-service-user-statuses-id-params {
    /// The ID of the terms of service status.
    terms-of-service-user-status-id: string,
    /// Whether the user has accepted the terms.
    is-accepted: bool
  }
  put-terms-of-service-user-statuses-id: func(params: put-terms-of-service-user-statuses-id-params) -> result<terms-of-service-user-status, string>;

}

interface terms-of-service {
  enum get-terms-of-services-tos-type-enum {
    external,
    managed,
  }

  enum post-terms-of-services-body-status-enum {
    enabled,
    disabled,
  }

  enum task-action-enum {
    review,
    complete,
  }

  enum task-completion-rule-enum {
    all-assignees,
    any-assignee,
  }

  enum task-assignment-resolution-state-enum {
    completed,
    incomplete,
    approved,
    rejected,
  }

  enum task-assignment-type-op-enum {
    task-assignment,
  }

  enum task-type-op-enum {
    task,
  }

  /// A list of terms of services
  record terms-of-services {
    entries: option<list<terms-of-service>>,
    /// The total number of objects.
    total-count: option<s64>
  }

  /// The root-level record that is supposed to represent a
  /// single Terms of Service.
  record terms-of-service {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A task allows for file-centric workflows within Box. Users can
  /// create tasks on files and assign them to other users for them to complete the
  /// tasks.
  record task {
    /// The type of task the task assignee will be prompted to
    /// perform.
    action: option<task-action-enum>,
    /// Defines which assignees need to complete this task before the task
    /// is considered completed.
    completion-rule: option<task-completion-rule-enum>,
    /// When the task object was created
    created-at: option<string>,
    created-by: option<task-created-by>,
    /// When the task is due
    due-at: option<string>,
    /// The unique identifier for this task
    id: option<string>,
    /// Whether the task has been completed
    is-completed: option<bool>,
    item: option<task-item>,
    /// A message that will be included with the task
    message: option<string>,
    task-assignment-collection: option<task-task-assignment-collection>,
    /// `task`
    type-op: option<task-type-op-enum>
  }

  record task-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-task-assignment-collection {
    entries: option<list<task-assignment>>,
    /// The total number of items in this collection.
    total-count: option<s64>
  }

  /// A task assignment defines which task is assigned to which user to complete.
  record task-assignment {
    /// The date at which this task was assigned to the user.
    assigned-at: option<string>,
    assigned-by: option<task-assignment-assigned-by>,
    assigned-to: option<task-assignment-assigned-to>,
    /// The date at which this task assignment was
    /// completed. This will be `null` if the task is not completed yet.
    completed-at: option<string>,
    /// The unique identifier for this task assignment
    id: option<string>,
    item: option<task-assignment-item>,
    /// A message that will is included with the task
    /// assignment. This is visible to the assigned user in the web and mobile
    message: option<string>,
    /// The date at which the assigned user was reminded of this task
    /// assignment.
    reminded-at: option<string>,
    /// The current state of the assignment. The available states depend on
    /// the `action` value of the task object.
    resolution-state: option<task-assignment-resolution-state-enum>,
    /// `task_assignment`
    type-op: option<task-assignment-type-op-enum>
  }

  record task-assignment-assigned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-assignment-assigned-to {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-assignment-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List terms of services
  record get-terms-of-services-params {
    /// Limits the results to the terms of service of the given type.
    tos-type: option<get-terms-of-services-tos-type-enum>
  }
  get-terms-of-services: func(params: get-terms-of-services-params) -> result<terms-of-services, string>;

  /// Create terms of service
  record post-terms-of-services-params {
    /// Whether this terms of service is active.
    status: post-terms-of-services-body-status-enum,
    /// The terms of service text to display to users.
    /// 
    text: string,
    /// The type of user to set the terms of
    /// service for.
    tos-type: option<get-terms-of-services-tos-type-enum>
  }
  post-terms-of-services: func(params: post-terms-of-services-params) -> result<task, string>;

  /// Get terms of service
  record get-terms-of-services-id-params {
    /// The ID of the terms of service.
    terms-of-service-id: string
  }
  get-terms-of-services-id: func(params: get-terms-of-services-id-params) -> result<terms-of-service, string>;

  /// Update terms of service
  record put-terms-of-services-id-params {
    /// The ID of the terms of service.
    terms-of-service-id: string,
    /// Whether this terms of service is active.
    status: post-terms-of-services-body-status-enum,
    /// The terms of service text to display to users.
    /// 
    text: string
  }
  put-terms-of-services-id: func(params: put-terms-of-services-id-params) -> result<terms-of-service, string>;

}

interface users {
  enum get-users-user-type-enum {
    all,
    managed,
    external,
  }

  enum post-users-body-role-enum {
    coadmin,
    user,
  }

  enum post-users-body-status-enum {
    active,
    inactive,
    cannot-delete-edit,
    cannot-delete-edit-upload,
  }

  enum tracking-code-type-op-enum {
    tracking-code,
  }

  /// A list of users.
  record users {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Tracking codes allow an admin to generate reports from the admin console
  /// and assign an attribute to a specific group of users.
  /// This setting must be enabled for an enterprise before it can be used.
  record tracking-code {
    /// The name of the tracking code, which must be preconfigured in
    /// the Admin Console
    name: option<string>,
    /// `tracking_code`
    type-op: option<tracking-code-type-op-enum>,
    /// The value of the tracking code
    value: option<string>
  }

  /// A standard representation of a user, as returned from any
  /// user API endpoints by default
  record user {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A full representation of a user, as can be returned from any
  /// user API endpoint.
  record user-full {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A message informing about the
  /// termination job status
  record session-termination-message {
    /// The unique identifier for the termination job status
    message: option<string>
  }

  /// An alternate notification email address to which email
  /// notifications are sent. When it's confirmed, this will be
  /// the email address to which notifications are sent instead of
  /// to the primary email address.
  /// 
  /// Set this value to `null` to remove the notification email.
  record put-users-id-body-notification-email {
    /// The email address to send the notifications to.
    email: option<string>
  }

  variant post-users-terminate-sessions-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    service-unavailable(string),
    other(string)
  }

  variant put-users-id-error {
    bad-request(string),
    forbidden(string),
    other(string)
  }

  /// List enterprise users
  record get-users-params {
    /// Limits the results to only users who's `name` or
    /// `login` start with the search term.
    filter-term: option<string>,
    /// Limits the results to the kind of user specified.
    /// 
    user-type: option<get-users-user-type-enum>,
    /// Limits the results to app users with the given
    /// `external_app_user_id` value.
    external-app-user-id: option<string>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// Specifies whether to use marker-based pagination instead of
    /// offset-based pagination. Only one pagination method can
    usemarker: option<bool>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>
  }
  get-users: func(params: get-users-params) -> result<users, string>;

  /// Create user
  record post-users-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The user’s address
    address: option<string>,
    /// Whether the user can see other enterprise users in their
    /// contact list
    can-see-managed-users: option<bool>,
    /// An external identifier for an app user, which can be used to look
    /// up the user. This can be used to tie user IDs from external
    external-app-user-id: option<string>,
    /// Whether to exempt the user from enterprise device limits
    is-exempt-from-device-limits: option<bool>,
    /// Whether the user must use two-factor authentication
    is-exempt-from-login-verification: option<bool>,
    /// Whether the user is allowed to collaborate with users outside
    /// their enterprise
    is-external-collab-restricted: option<bool>,
    /// Specifies that the user is an app user.
    is-platform-access-only: option<bool>,
    /// Whether the user can use Box Sync
    is-sync-enabled: option<bool>,
    /// The user’s job title
    job-title: option<string>,
    /// The language of the user, formatted in modified version of the
    /// [ISO 639-1](/guides/api-calls/language-codes) format.
    language: option<string>,
    /// The email address the user uses to log in
    /// 
    login: option<string>,
    /// The name of the user
    name: string,
    /// The user’s phone number
    phone: option<string>,
    /// The user’s enterprise role
    role: option<post-users-body-role-enum>,
    /// The user’s total available space in bytes. Set this to `-1` to
    /// indicate unlimited storage.
    space-amount: option<s64>,
    /// The user's account status
    status: option<post-users-body-status-enum>,
    /// The user's timezone
    timezone: option<string>,
    /// Tracking codes allow an admin to generate reports from the
    /// admin console and assign an attribute to a specific group
    tracking-codes: option<list<tracking-code>>
  }
  post-users: func(params: post-users-params) -> result<user, string>;

  /// Get current user
  record get-users-me-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-users-me: func(params: get-users-me-params) -> result<user-full, string>;

  /// Create jobs to terminate users session
  record post-users-terminate-sessions-params {
    /// A list of user IDs
    user-ids: list<string>,
    /// A list of user logins
    user-logins: list<string>
  }
  post-users-terminate-sessions: func(params: post-users-terminate-sessions-params) -> result<session-termination-message, post-users-terminate-sessions-error>;

  /// Get user
  record get-users-id-params {
    /// The ID of the user.
    user-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-users-id: func(params: get-users-id-params) -> result<user-full, string>;

  /// Update user
  record put-users-id-params {
    /// The ID of the user.
    user-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The user’s address
    address: option<string>,
    /// Whether the user can see other enterprise users in their
    /// contact list
    can-see-managed-users: option<bool>,
    /// Set this to `null` to roll the user out of the enterprise
    /// and make them a free user
    enterprise: option<string>,
    /// An external identifier for an app user, which can be used to look
    /// up the user. This can be used to tie user IDs from external
    external-app-user-id: option<string>,
    /// Whether to exempt the user from enterprise device limits
    is-exempt-from-device-limits: option<bool>,
    /// Whether the user must use two-factor authentication
    is-exempt-from-login-verification: option<bool>,
    /// Whether the user is allowed to collaborate with users outside
    /// their enterprise
    is-external-collab-restricted: option<bool>,
    /// Whether the user is required to reset their password
    is-password-reset-required: option<bool>,
    /// Whether the user can use Box Sync
    is-sync-enabled: option<bool>,
    /// The user’s job title
    job-title: option<string>,
    /// The language of the user, formatted in modified version of the
    /// [ISO 639-1](/guides/api-calls/language-codes) format.
    language: option<string>,
    /// The email address the user uses to log in
    /// 
    login: option<string>,
    /// The name of the user
    name: option<string>,
    /// An alternate notification email address to which email
    /// notifications are sent. When it's confirmed, this will be
    notification-email: option<put-users-id-body-notification-email>,
    /// Whether the user should receive an email when they
    /// are rolled out of an enterprise
    notify: option<bool>,
    /// The user’s phone number
    phone: option<string>,
    /// The user’s enterprise role
    role: option<post-users-body-role-enum>,
    /// The user’s total available space in bytes. Set this to `-1` to
    /// indicate unlimited storage.
    space-amount: option<s64>,
    /// The user's account status
    status: option<post-users-body-status-enum>,
    /// The user's timezone
    timezone: option<string>,
    /// Tracking codes allow an admin to generate reports from the
    /// admin console and assign an attribute to a specific group
    tracking-codes: option<list<tracking-code>>
  }
  put-users-id: func(params: put-users-id-params) -> result<user-full, put-users-id-error>;

  /// Delete user
  record delete-users-id-params {
    /// The ID of the user.
    user-id: string,
    /// Whether the user will receive email notification of
    /// the deletion
    notify: option<bool>,
    /// Whether the user should be deleted even if this user
    /// still own files
    force: option<bool>
  }
  delete-users-id: func(params: delete-users-id-params) -> result<string, string>;

}

interface user-avatars {
  /// A resource holding URLs to the
  /// avatar uploaded to a Box application.
  record user-avatar {
    /// Represents an object with user avatar URLs.
    pic-urls: option<user-avatar-pic-urls>
  }

  /// Represents an object with user avatar URLs.
  record user-avatar-pic-urls {
    /// The location of a large-sized avatar.
    large: option<string>,
    /// The location of the avatar preview.
    preview: option<string>,
    /// The location of a small-sized avatar.
    small: option<string>
  }

  variant post-users-id-avatar-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-users-id-avatar-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get user avatar
  record get-users-id-avatar-params {
    /// The ID of the user.
    user-id: string
  }
  get-users-id-avatar: func(params: get-users-id-avatar-params) -> result<string, string>;

  /// Add or update user avatar
  record post-users-id-avatar-params {
    /// The ID of the user.
    user-id: string,
    /// The image file to be uploaded to Box.
    /// Accepted file extensions are `.jpg` or `.png`.
    pic: string
  }
  post-users-id-avatar: func(params: post-users-id-avatar-params) -> result<user-avatar, post-users-id-avatar-error>;

  /// Delete user avatar
  record delete-users-id-avatar-params {
    /// The ID of the user.
    user-id: string
  }
  delete-users-id-avatar: func(params: delete-users-id-avatar-params) -> result<string, delete-users-id-avatar-error>;

}

interface email-aliases {
  enum email-alias-type-op-enum {
    email-alias,
  }

  /// A list of email aliases
  record email-aliases {
    entries: option<list<email-alias>>,
    /// The number of email aliases.
    total-count: option<s64>
  }

  /// An email alias for a user.
  record email-alias {
    /// The email address
    email: option<string>,
    /// The unique identifier for this object
    id: option<string>,
    /// Whether the email address has been confirmed
    is-confirmed: option<bool>,
    /// `email_alias`
    type-op: option<email-alias-type-op-enum>
  }

  /// List user's email aliases
  record get-users-id-email-aliases-params {
    /// The ID of the user.
    user-id: string
  }
  get-users-id-email-aliases: func(params: get-users-id-email-aliases-params) -> result<email-aliases, string>;

  /// Create email alias
  record post-users-id-email-aliases-params {
    /// The ID of the user.
    user-id: string,
    /// The email address to add to the account as an alias.
    /// 
    email: string
  }
  post-users-id-email-aliases: func(params: post-users-id-email-aliases-params) -> result<email-alias, string>;

  /// Remove email alias
  record delete-users-id-email-aliases-id-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the email alias.
    email-alias-id: string
  }
  delete-users-id-email-aliases-id: func(params: delete-users-id-email-aliases-id-params) -> result<string, string>;

}

interface transfer-folders {
