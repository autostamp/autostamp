  post-users-terminate-sessions: func(params: post-users-terminate-sessions-params) -> result<string, string>;

  /// Get user
  record get-users-id-params {
    /// The ID of the user.
    user-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-users-id: func(params: get-users-id-params) -> result<string, string>;

  /// Update user
  record put-users-id-params {
    /// The ID of the user.
    user-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The user’s address
    address: option<string>,
    /// Whether the user can see other enterprise users in their
    /// contact list
    can-see-managed-users: option<bool>,
    /// Set this to `null` to roll the user out of the enterprise
    /// and make them a free user
    enterprise: option<string>,
    /// An external identifier for an app user, which can be used to look
    /// up the user. This can be used to tie user IDs from external
    external-app-user-id: option<string>,
    /// Whether to exempt the user from enterprise device limits
    is-exempt-from-device-limits: option<bool>,
    /// Whether the user must use two-factor authentication
    is-exempt-from-login-verification: option<bool>,
    /// Whether the user is allowed to collaborate with users outside
    /// their enterprise
    is-external-collab-restricted: option<bool>,
    /// Whether the user is required to reset their password
    is-password-reset-required: option<bool>,
    /// Whether the user can use Box Sync
    is-sync-enabled: option<bool>,
    /// The user’s job title
    job-title: option<string>,
    /// The language of the user, formatted in modified version of the
    /// [ISO 639-1](/guides/api-calls/language-codes) format.
    language: option<string>,
    /// The email address the user uses to log in
    /// 
    login: option<string>,
    /// The name of the user
    name: option<string>,
    /// An alternate notification email address to which email
    /// notifications are sent. When it's confirmed, this will be
    notification-email: option<put-users-id-body-notification-email>,
    /// Whether the user should receive an email when they
    /// are rolled out of an enterprise
    notify: option<bool>,
    /// The user’s phone number
    phone: option<string>,
    /// The user’s enterprise role
    role: option<post-users-body-role-enum>,
    /// The user’s total available space in bytes. Set this to `-1` to
    /// indicate unlimited storage.
    space-amount: option<s64>,
    /// The user's account status
    status: option<post-users-body-status-enum>,
    /// The user's timezone
    timezone: option<string>,
    /// Tracking codes allow an admin to generate reports from the
    /// admin console and assign an attribute to a specific group
    tracking-codes: option<list<tracking-code>>
  }
  put-users-id: func(params: put-users-id-params) -> result<string, string>;

  /// Delete user
  record delete-users-id-params {
    /// The ID of the user.
    user-id: string,
    /// Whether the user will receive email notification of
    /// the deletion
    notify: option<bool>,
    /// Whether the user should be deleted even if this user
    /// still own files
    force: option<bool>
  }
  delete-users-id: func(params: delete-users-id-params) -> result<string, string>;

}

interface user-avatars {
  /// Get user avatar
  record get-users-id-avatar-params {
    /// The ID of the user.
    user-id: string
  }
  get-users-id-avatar: func(params: get-users-id-avatar-params) -> result<string, string>;

  /// Add or update user avatar
  record post-users-id-avatar-params {
    /// The ID of the user.
    user-id: string
  }
  post-users-id-avatar: func(params: post-users-id-avatar-params) -> result<string, string>;

  /// Delete user avatar
  record delete-users-id-avatar-params {
    /// The ID of the user.
    user-id: string
  }
  delete-users-id-avatar: func(params: delete-users-id-avatar-params) -> result<string, string>;

}

interface email-aliases {
  /// List user's email aliases
  record get-users-id-email-aliases-params {
    /// The ID of the user.
    user-id: string
  }
  get-users-id-email-aliases: func(params: get-users-id-email-aliases-params) -> result<string, string>;

  /// Create email alias
  record post-users-id-email-aliases-params {
    /// The ID of the user.
    user-id: string,
    /// The email address to add to the account as an alias.
    /// 
    email: string
  }
  post-users-id-email-aliases: func(params: post-users-id-email-aliases-params) -> result<string, string>;

  /// Remove email alias
  record delete-users-id-email-aliases-id-params {
    /// The ID of the user.
    user-id: string,
    /// The ID of the email alias.
    email-alias-id: string
  }
  delete-users-id-email-aliases-id: func(params: delete-users-id-email-aliases-id-params) -> result<string, string>;

}

interface transfer-folders {
  /// The user who the folder will be transferred to
  record put-users-id-folders-v0-body-owned-by {
    /// The ID of the user who the folder will be
    /// transferred to
    id: string
  }

  /// Transfer owned folders
  record put-users-id-folders-v0-params {
    /// The ID of the user.
    user-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Determines if users should receive email notification
    /// for the action performed.
    notify: option<bool>,
    /// The user who the folder will be transferred to
    owned-by: put-users-id-folders-v0-body-owned-by
  }
  put-users-id-folders-v0: func(params: put-users-id-folders-v0-params) -> result<string, string>;

}

interface web-links {
  enum post-web-links-body-shared-link-access-enum {
    open,
    company,
    collaborators,
  }

  /// The parent folder to create the web link within.
  record post-web-links-body-parent {
    /// The ID of parent folder
    id: string
  }

  /// The settings for the shared link to update.
  record post-web-links-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<post-web-links-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  /// The settings for the shared link to update.
  record put-web-links-id-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<post-web-links-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  /// Create web link
  record post-web-links-params {
    /// Description of the web link.
    description: option<string>,
    /// Name of the web link. Defaults to the URL if not set.
    name: option<string>,
    /// The parent folder to create the web link within.
    parent: post-web-links-body-parent,
    /// The settings for the shared link to update.
    shared-link: option<post-web-links-body-shared-link>,
    /// The URL that this web link links to. Must start with
    /// `"http://"` or `"https://"`.
    url: string
  }
  post-web-links: func(params: post-web-links-params) -> result<string, string>;

  /// Get web link
  record get-web-links-id-params {
    /// The ID of the web link.
    web-link-id: string,
    /// The URL, and optional password, for the shared link of this item.
    /// 
    boxapi: option<string>
  }
  get-web-links-id: func(params: get-web-links-id-params) -> result<string, string>;

  /// Update web link
  record put-web-links-id-params {
    /// The ID of the web link.
    web-link-id: string,
    /// A new description of the web link.
    description: option<string>,
    /// A new name for the web link. Defaults to the URL if not set.
    name: option<string>,
    parent: option<string>,
    /// The settings for the shared link to update.
    shared-link: option<put-web-links-id-body-shared-link>,
    /// The new URL that the web link links to. Must start with
    /// `"http://"` or `"https://"`.
    url: option<string>
  }
  put-web-links-id: func(params: put-web-links-id-params) -> result<string, string>;

  /// Remove web link
  record delete-web-links-id-params {
    /// The ID of the web link.
    web-link-id: string
  }
  delete-web-links-id: func(params: delete-web-links-id-params) -> result<string, string>;

}

interface trashed-web-links {
  /// Restore web link
  record post-web-links-id-params {
    /// The ID of the web link.
    web-link-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional new name for the web link.
    name: option<string>,
    parent: option<string>
  }
  post-web-links-id: func(params: post-web-links-id-params) -> result<string, string>;

  /// Get trashed web link
  record get-web-links-id-trash-params {
    /// The ID of the web link.
    web-link-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-web-links-id-trash: func(params: get-web-links-id-trash-params) -> result<string, string>;

  /// Permanently remove web link
  record delete-web-links-id-trash-params {
    /// The ID of the web link.
    web-link-id: string
  }
  delete-web-links-id-trash: func(params: delete-web-links-id-trash-params) -> result<string, string>;

}

interface webhooks {
  enum post-webhooks-body-target-type-op-enum {
    file,
    folder,
  }

  enum post-webhooks-body-triggers-item-enum {
    file-uploaded,
    file-previewed,
    file-downloaded,
    file-trashed,
    file-deleted,
    file-restored,
    file-copied,
    file-moved,
    file-locked,
    file-unlocked,
    file-renamed,
    comment-created,
    comment-updated,
    comment-deleted,
    task-assignment-created,
    task-assignment-updated,
    metadata-instance-created,
    metadata-instance-updated,
    metadata-instance-deleted,
    folder-created,
    folder-renamed,
    folder-downloaded,
    folder-restored,
    folder-deleted,
    folder-copied,
    folder-moved,
    folder-trashed,
    webhook-deleted,
    collaboration-created,
    collaboration-accepted,
    collaboration-rejected,
    collaboration-removed,
    collaboration-updated,
    shared-link-deleted,
    shared-link-created,
    shared-link-updated,
    sign-request-completed,
    sign-request-declined,
    sign-request-expired,
  }

  /// The item that will trigger the webhook
  record post-webhooks-body-target {
    /// The ID of the item to trigger a webhook
    id: option<string>,
    /// The type of item to trigger a webhook
    type-op: option<post-webhooks-body-target-type-op-enum>
  }

  /// The item that will trigger the webhook
  record put-webhooks-id-body-target {
    /// The ID of the item to trigger a webhook
    id: option<string>,
    /// The type of item to trigger a webhook
    type-op: option<post-webhooks-body-target-type-op-enum>
  }

  /// List all webhooks
  record get-webhooks-params {
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-webhooks: func(params: get-webhooks-params) -> result<string, string>;

  /// Create webhook
  record post-webhooks-params {
    /// The URL that is notified by this webhook
    address: string,
    /// The item that will trigger the webhook
    target: post-webhooks-body-target,
    /// An array of event names that this webhook is
    /// to be triggered for
    triggers: list<post-webhooks-body-triggers-item-enum>
  }
  post-webhooks: func(params: post-webhooks-params) -> result<string, string>;

  /// Get webhook
  record get-webhooks-id-params {
    /// The ID of the webhook.
    webhook-id: string
  }
  get-webhooks-id: func(params: get-webhooks-id-params) -> result<string, string>;

  /// Update webhook
  record put-webhooks-id-params {
    /// The ID of the webhook.
    webhook-id: string,
    /// The URL that is notified by this webhook
    address: option<string>,
    /// The item that will trigger the webhook
    target: option<put-webhooks-id-body-target>,
    /// An array of event names that this webhook is
    /// to be triggered for
    triggers: option<list<post-webhooks-body-triggers-item-enum>>
  }
  put-webhooks-id: func(params: put-webhooks-id-params) -> result<string, string>;

  /// Remove webhook
  record delete-webhooks-id-params {
    /// The ID of the webhook.
    webhook-id: string
  }
  delete-webhooks-id: func(params: delete-webhooks-id-params) -> result<string, string>;

}

interface workflows {
  enum post-workflows-id-start-body-files-item-type-op-enum {
    file,
  }

  enum post-workflows-id-start-body-folder-type-op-enum {
    folder,
  }

  enum post-workflows-id-start-body-outcomes-item-type-op-enum {
    outcome,
  }

  enum post-workflows-id-start-body-type-op-enum {
    workflow-parameters,
  }

  /// A file the workflow should start for
  record post-workflows-id-start-body-files-item {
    /// The id of the file
    id: option<string>,
    /// The type of the file object
    type-op: option<post-workflows-id-start-body-files-item-type-op-enum>
  }

  /// The flow that will be triggered
  record post-workflows-id-start-body-flow {
    /// The id of the flow
    id: option<string>,
    /// The type of the flow object
    type-op: option<string>
  }

  /// The folder object for which the workflow is configured.
  record post-workflows-id-start-body-folder {
    /// The id of the folder
    id: option<string>,
    /// The type of the folder object
    type-op: option<post-workflows-id-start-body-folder-type-op-enum>
  }

  /// A configurable outcome the workflow should complete. If you
  /// have a `task_completion_rule`, you may input `all_assignees` or
  /// `any_assignee` in the `variable_value` field. Similarly, if you
  /// have a `collaborator_role`, you may input `editor`, `viewer`,
  /// `previewer`, `uploader`, `previewer uploader`, `viewer uploader`
  /// , `co-owner` in the `variable_value` field.
  record post-workflows-id-start-body-outcomes-item {
    /// The id of the outcome
    id: option<string>,
    /// This is a placeholder example for various objects that
    /// can be passed in - refer to the guides section to find
    parameter: option<string>,
    /// The type of the outcome object
    type-op: option<post-workflows-id-start-body-outcomes-item-type-op-enum>
  }

  /// List workflows
  record get-workflows-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// Type of trigger to search for.
    trigger-type: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>
  }
  get-workflows: func(params: get-workflows-params) -> result<string, string>;

  /// Starts workflow based on request body
  record post-workflows-id-start-params {
    /// The ID of the workflow.
    workflow-id: string,
    /// The array of files for which the workflow should start. All files
    /// must be in the workflow's configured folder.
    files: list<post-workflows-id-start-body-files-item>,
    /// The flow that will be triggered
    flow: post-workflows-id-start-body-flow,
    /// The folder object for which the workflow is configured.
    folder: post-workflows-id-start-body-folder,
    /// A list of outcomes required to be configured at start time.
    outcomes: option<list<post-workflows-id-start-body-outcomes-item>>,
    /// The type of the parameters object
    type-op: option<post-workflows-id-start-body-type-op-enum>
  }
  post-workflows-id-start: func(params: post-workflows-id-start-params) -> result<string, string>;

}

interface zip-downloads {
  enum zip-download-request-items-item-type-op-enum {
    file,
    folder,
  }

  /// An item to add to the `zip` archive. This can be a file or a folder.
  record zip-download-request-items-item {
    /// The identifier of the item to add to the archive. When this item is
    /// a folder then this can not be the root folder with ID `0`.
    id: string,
    /// The type of the item to add to the archive.
    type-op: zip-download-request-items-item-type-op-enum
  }

  /// Create zip download
  record post-zip-downloads-params {
    /// The optional name of the `zip` archive. This name will be appended by the
    /// `.zip` file extension, for example `January Financials.zip`.
    download-file-name: option<string>,
    /// A list of items to add to the `zip` archive. These can
    /// be folders or files.
    items: list<zip-download-request-items-item>
  }
  post-zip-downloads: func(params: post-zip-downloads-params) -> result<string, string>;

  /// Download zip archive
  record get-zip-downloads-id-content-params {
    /// The unique identifier that represent this `zip` archive.
    zip-download-id: string
  }
  get-zip-downloads-id-content: func(params: get-zip-downloads-id-content-params) -> result<string, string>;

  /// Get zip download status
  record get-zip-downloads-id-status-params {
    /// The unique identifier that represent this `zip` archive.
    zip-download-id: string
  }
  get-zip-downloads-id-status: func(params: get-zip-downloads-id-status-params) -> result<string, string>;

}
