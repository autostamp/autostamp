  /// Create retention policy
  record post-retention-policies-params {
    /// Whether owner and co-owners of a file are notified
    /// when the policy nears expiration.
    are-owners-notified: option<bool>,
    /// Whether the owner of a file will be allowed to
    /// extend the retention.
    can-owner-extend-retention: option<bool>,
    /// A list of users notified when
    /// the retention policy duration is about to end.
    custom-notification-recipients: option<list<user-mini>>,
    /// The additional text description of the retention policy.
    description: option<string>,
    /// The disposition action of the retention policy.
    /// `permanently_delete` deletes the content
    disposition-action: post-retention-policies-body-disposition-action-enum,
    /// The name for the retention policy
    policy-name: string,
    /// The type of the retention policy. A retention
    /// policy type can either be `finite`, where a
    policy-type: get-retention-policies-policy-type-enum,
    /// The length of the retention policy. This value
    /// specifies the duration in days that the retention
    retention-length: option<string>,
    /// Specifies the retention type:
    /// 
    retention-type: option<post-retention-policies-body-retention-type-enum>
  }
  post-retention-policies: func(params: post-retention-policies-params) -> result<retention-policy, post-retention-policies-error>;

  /// Get retention policy
  record get-retention-policies-id-params {
    /// The ID of the retention policy.
    retention-policy-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-retention-policies-id: func(params: get-retention-policies-id-params) -> result<retention-policy, string>;

  /// Update retention policy
  record put-retention-policies-id-params {
    /// The ID of the retention policy.
    retention-policy-id: string,
    /// Determines if owners and co-owners of items
    /// under the policy are notified when
    are-owners-notified: option<bool>,
    /// Determines if the owner of items under the policy
    /// can extend the retention when the original retention
    can-owner-extend-retention: option<bool>,
    /// A list of users notified when the retention duration is about to end.
    custom-notification-recipients: option<list<user-mini>>,
    /// The additional text description of the retention policy.
    description: option<string>,
    /// The disposition action of the retention policy.
    /// `permanently_delete` deletes the content
    disposition-action: option<post-retention-policies-body-disposition-action-enum>,
    /// The name for the retention policy
    policy-name: option<string>,
    /// The length of the retention policy. This value
    /// specifies the duration in days that the retention
    retention-length: option<string>,
    /// Specifies the retention type:
    /// 
    retention-type: option<string>,
    /// Used to retire a retention policy.
    /// 
    status: option<string>
  }
  put-retention-policies-id: func(params: put-retention-policies-id-params) -> result<retention-policy, put-retention-policies-id-error>;

