  get-collections-id-items: func(params: get-collections-id-items-params) -> result<string, string>;

}

interface comments {
  enum post-comments-body-item-type-op-enum {
    file,
    comment,
  }

  /// The item to attach the comment to.
  record post-comments-body-item {
    /// The ID of the item
    id: string,
    /// The type of the item that this comment will be placed on.
    type-op: post-comments-body-item-type-op-enum
  }

  /// Create comment
  record post-comments-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The item to attach the comment to.
    item: option<post-comments-body-item>,
    /// The text of the comment.
    /// 
    message: string,
    /// The text of the comment, including `@[user_id:name]`
    /// somewhere in the message to mention another user, which
    tagged-message: option<string>
  }
  post-comments: func(params: post-comments-params) -> result<string, string>;

  /// Get comment
  record get-comments-id-params {
    /// The ID of the comment.
    comment-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-comments-id: func(params: get-comments-id-params) -> result<string, string>;

  /// Update comment
  record put-comments-id-params {
    /// The ID of the comment.
    comment-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The text of the comment to update
    message: option<string>
  }
  put-comments-id: func(params: put-comments-id-params) -> result<string, string>;

  /// Remove comment
  record delete-comments-id-params {
    /// The ID of the comment.
    comment-id: string
  }
  delete-comments-id: func(params: delete-comments-id-params) -> result<string, string>;

  /// List file comments
  record get-files-id-comments-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>
  }
  get-files-id-comments: func(params: get-files-id-comments-params) -> result<string, string>;

}

