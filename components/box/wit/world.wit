  }
  get-folders-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo: func(params: get-folders-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-params) -> result<classification, get-folders-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-error>;

  /// Add classification to folder
