    /// 
    file-id: string,
    /// The scope of the metadata template
    scope: string,
    /// The name of the metadata template
    template-key: string,
    body: option<list<put-files-id-metadata-id-id-body-item>>
  }
  put-files-id-metadata-id-id: func(params: put-files-id-metadata-id-id-params) -> result<metadata, put-files-id-metadata-id-id-error>;

  /// Remove metadata instance from file
