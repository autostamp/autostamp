    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The file version ID
    id: option<string>,
    /// The type to promote
    type-op: option<post-files-id-versions-current-body-type-op-enum>
  }
  post-files-id-versions-current: func(params: post-files-id-versions-current-params) -> result<file-version-full, string>;

  /// Get file version
  record get-files-id-versions-id-params {
    /// The unique identifier that represents a file.
    /// 
