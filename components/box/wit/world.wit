  post-folders-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo: func(params: post-folders-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-params) -> result<classification, post-folders-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-error>;

