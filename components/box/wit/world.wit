    file-id: string,
    /// The ID of the file version
    file-version-id: string,
    /// Set this to `null` to clear
    /// the date and restore the file.
    trashed-at: option<string>
  }
  put-files-id-versions-id: func(params: put-files-id-versions-id-params) -> result<file-version-full, string>;

  /// Remove file version
