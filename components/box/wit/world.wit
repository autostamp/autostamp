interface retention-policies {
  enum get-retention-policies-policy-type-enum {
    finite,
    indefinite,
  }

  enum post-retention-policies-body-disposition-action-enum {
    permanently-delete,
    remove-retention,
  }

  enum post-retention-policies-body-retention-type-enum {
    modifiable,
    non-modifiable,
  }

  /// A list of retention policies.
