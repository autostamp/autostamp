  }
  post-files-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo: func(params: post-files-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-params) -> result<classification, post-files-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-error>;

