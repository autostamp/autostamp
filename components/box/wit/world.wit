interface file-version-retentions {
  enum get-file-version-retentions-disposition-action-enum {
    permanently-delete,
    remove-retention,
  }

  enum file-version-retention-type-op-enum {
    file-version-retention,
  }

  /// A list of file version retentions.
  record file-version-retentions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A retention policy blocks permanent deletion of content
  /// for a specified amount of time. Admins can apply policies to
  /// specified folders, or an entire enterprise. A file version retention
  /// is a  record for a retained file version. To use this feature,
  /// you must  have the manage retention policies scope enabled for your
  /// API key via  your application management console. For more information
  /// about retention policies, please visit our help documentation
  record file-version-retention {
    /// When this file version retention object was
    /// created
    applied-at: option<string>,
    /// When the retention expires on this file
    /// version retention
    disposition-at: option<string>,
    file: option<file-version-retention-file>,
    file-version: option<file-version-retention-file-version>,
    /// The unique identifier for this file version retention.
    id: option<string>,
    /// `file_version_retention`
    type-op: option<file-version-retention-type-op-enum>,
    winning-retention-policy: option<file-version-retention-winning-retention-policy>
  }

  record file-version-retention-file {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record file-version-retention-file-version {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record file-version-retention-winning-retention-policy {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List file version retentions
  record get-file-version-retentions-params {
    /// Filters results by files with this ID.
    file-id: option<string>,
    /// Filters results by file versions with this ID.
    file-version-id: option<string>,
    /// Filters results by the retention policy with this ID.
    policy-id: option<string>,
    /// Filters results by the retention policy with this disposition
    /// action.
    disposition-action: option<get-file-version-retentions-disposition-action-enum>,
    /// Filters results by files that will have their disposition
    /// come into effect before this date.
    disposition-before: option<string>,
    /// Filters results by files that will have their disposition
    /// come into effect after this date.
    disposition-after: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>
  }
  get-file-version-retentions: func(params: get-file-version-retentions-params) -> result<file-version-retentions, string>;

  /// Get retention on file
