  }
  get-files-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo: func(params: get-files-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-params) -> result<classification, get-files-id-metadata-enterprise-security-classification-v6vm-vochw-u-wo-error>;

  /// Add classification to file
