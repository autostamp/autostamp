interface shared-links-web-links {
  enum add-shared-link-body-shared-link-access-enum {
    open,
    company,
    collaborators,
  }

  /// Web links are objects that point to URLs. These objects
  /// are also known as bookmarks within the Box web application.
  /// 
  /// Web link objects are treated similarly to file objects,
  /// they will also support most actions that apply to regular files.
  record web-link {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The settings for the shared link to create on the web link.
  /// 
  /// Use an empty object (`{}`) to use the default settings for shared
  /// links.
  record add-shared-link-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<add-shared-link-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    permissions: option<add-shared-link-body-shared-link-permissions>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  record add-shared-link-body-shared-link-permissions {
    /// If the shared link allows for downloading of files.
    /// This can only be set when `access` is set to
    can-download: option<bool>,
    /// This value can only be `true` is `type` is `file`.
    can-edit: option<bool>,
    /// If the shared link allows for previewing of files.
    /// This value is always `true`. For shared links on folders
    can-preview: option<bool>
  }

  /// By setting this value to `null`, the shared link
  /// is removed from the web link.
  record remove-shared-link-body-shared-link {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The settings for the shared link to update.
  record update-shared-link-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<add-shared-link-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    permissions: option<update-shared-link-body-shared-link-permissions>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  record update-shared-link-body-shared-link-permissions {
    /// If the shared link allows for downloading of files.
    /// This can only be set when `access` is set to
    can-download: option<bool>,
    /// This value can only be `true` is `type` is `file`.
    can-edit: option<bool>,
    /// If the shared link allows for previewing of files.
    /// This value is always `true`. For shared links on folders
    can-preview: option<bool>
  }

  variant web-links-error {
    not-modified(string),
    other(string)
  }

  variant add-shared-link-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant get-shared-link-error {
    unauthorized(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant remove-shared-link-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant update-shared-link-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  /// Find web link for shared link
  record web-links-params {
    /// Ensures an item is only returned if it has changed.
    /// 
    if-none-match: option<string>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// A header containing the shared link and optional password for the
    /// shared link.
    boxapi: string
  }
  web-links: func(params: web-links-params) -> result<web-link, web-links-error>;

  /// Add shared link to web link
  record add-shared-link-params {
    /// The ID of the web link.
    web-link-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// The settings for the shared link to create on the web link.
    /// 
    shared-link: option<add-shared-link-body-shared-link>
  }
  add-shared-link: func(params: add-shared-link-params) -> result<web-link, add-shared-link-error>;

  /// Get shared link for web link
  record get-shared-link-params {
    /// The ID of the web link.
    web-link-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string
  }
  get-shared-link: func(params: get-shared-link-params) -> result<web-link, get-shared-link-error>;

  /// Remove shared link from web link
  record remove-shared-link-params {
    /// The ID of the web link.
    web-link-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// By setting this value to `null`, the shared link
    /// is removed from the web link.
    shared-link: option<remove-shared-link-body-shared-link>
  }
  remove-shared-link: func(params: remove-shared-link-params) -> result<web-link, remove-shared-link-error>;

  /// Update shared link on web link
  record update-shared-link-params {
    /// The ID of the web link.
    web-link-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// The settings for the shared link to update.
    shared-link: option<update-shared-link-body-shared-link>
  }
  update-shared-link: func(params: update-shared-link-params) -> result<web-link, update-shared-link-error>;

}

