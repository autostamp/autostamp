interface group-memberships {
  enum post-group-memberships-body-role-enum {
    member,
    admin,
  }

  enum group-membership-type-op-enum {
    group-membership,
  }

  /// Custom configuration for the permissions an admin
  /// if a group will receive. This option has no effect
  /// on members with a role of `member`.
  /// 
  /// Setting these permissions overwrites the default
  /// access levels of an admin.
  /// 
  /// Specifying a value of "null" for this object will disable
  /// all configurable permissions. Specifying permissions will set
  /// them accordingly, omitted permissions will be enabled by default.
  record post-group-memberships-body-configurable-permissions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The group to add the user to.
  record post-group-memberships-body-group {
    /// The ID of the group to add the user to
    id: string
  }

  /// The user to add to the group.
  record post-group-memberships-body-user {
    /// The ID of the user to add to the group
    id: string
  }

  /// Membership is used to signify that a user is part of a
  /// group.
  record group-membership {
    /// The time this membership was created.
    created-at: option<string>,
    group: option<group-membership-group>,
    /// The unique identifier for this group membership
    id: option<string>,
    /// The time this membership was last modified.
    modified-at: option<string>,
    /// The role of the user in the group.
    role: option<post-group-memberships-body-role-enum>,
    /// `group_membership`
    type-op: option<group-membership-type-op-enum>,
    user: option<group-membership-user>
  }

  record group-membership-group {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record group-membership-user {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Custom configuration for the permissions an admin
  /// if a group will receive. This option has no effect
  /// on members with a role of `member`.
  /// 
  /// Setting these permissions overwrites the default
  /// access levels of an admin.
  /// 
  /// Specifying a value of "null" for this object will disable
  /// all configurable permissions. Specifying permissions will set
  /// them accordingly, omitted permissions will be enabled by default.
  record put-group-memberships-id-body-configurable-permissions {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A list of group memberships.
  record group-memberships {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-group-memberships-error {
    forbidden(string),
    other(string)
  }

  /// Add user to group
  record post-group-memberships-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Custom configuration for the permissions an admin
    /// if a group will receive. This option has no effect
    configurable-permissions: option<post-group-memberships-body-configurable-permissions>,
    /// The group to add the user to.
    group: post-group-memberships-body-group,
    /// The role of the user in the group.
    role: option<post-group-memberships-body-role-enum>,
    /// The user to add to the group.
    user: post-group-memberships-body-user
  }
  post-group-memberships: func(params: post-group-memberships-params) -> result<group-membership, post-group-memberships-error>;

  /// Get group membership
  record get-group-memberships-id-params {
    /// The ID of the group membership.
    group-membership-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-group-memberships-id: func(params: get-group-memberships-id-params) -> result<group-membership, string>;

  /// Update group membership
  record put-group-memberships-id-params {
    /// The ID of the group membership.
    group-membership-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Custom configuration for the permissions an admin
    /// if a group will receive. This option has no effect
    configurable-permissions: option<put-group-memberships-id-body-configurable-permissions>,
    /// The role of the user in the group.
    role: option<post-group-memberships-body-role-enum>
  }
  put-group-memberships-id: func(params: put-group-memberships-id-params) -> result<group-membership, string>;

  /// Remove user from group
  record delete-group-memberships-id-params {
    /// The ID of the group membership.
    group-membership-id: string
  }
  delete-group-memberships-id: func(params: delete-group-memberships-id-params) -> result<string, string>;

  /// List members of group
  record get-groups-id-memberships-params {
    /// The ID of the group.
    group-id: string,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>
  }
  get-groups-id-memberships: func(params: get-groups-id-memberships-params) -> result<group-memberships, string>;

  /// List user's groups
  record get-users-id-memberships-params {
    /// The ID of the user.
    user-id: string,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>
  }
  get-users-id-memberships: func(params: get-users-id-memberships-params) -> result<group-memberships, string>;

}

interface groups {
  enum post-groups-body-invitability-level-enum {
    admins-only,
    admins-and-members,
    all-managed-users,
  }

  /// A list of groups.
  record groups {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A standard representation of a group, as returned from any
  /// group API endpoints by default
  record group {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A message informing about the
  /// termination job status
  record session-termination-message {
    /// The unique identifier for the termination job status
    message: option<string>
  }

  /// Groups contain a set of users, and can be used in place of
  /// users in some operations, such as collaborations.
  record group-full {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-groups-error {
    conflict(string),
    other(string)
  }

  variant post-groups-terminate-sessions-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    too-many-requests(string),
    internal-server-error(string),
    service-unavailable(string),
    other(string)
  }

  variant put-groups-id-error {
    conflict(string),
    other(string)
  }

  /// List groups for enterprise
  record get-groups-params {
    /// Limits the results to only groups whose `name` starts
    /// with the search term.
    filter-term: option<string>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>
  }
  get-groups: func(params: get-groups-params) -> result<groups, string>;

  /// Create group
  record post-groups-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// A human readable description of the group.
    description: option<string>,
    /// An arbitrary identifier that can be used by
    /// external group sync tools to link this Box Group to
    external-sync-identifier: option<string>,
    /// Specifies who can invite the group to collaborate
    /// on folders.
    invitability-level: option<post-groups-body-invitability-level-enum>,
    /// Specifies who can see the members of the group.
    /// 
    member-viewability-level: option<post-groups-body-invitability-level-enum>,
    /// The name of the new group to be created. This name must be unique
    /// within the enterprise.
    name: string,
    /// Keeps track of which external source this group is
    /// coming, for example `Active Directory`, or `Okta`.
    provenance: option<string>
  }
  post-groups: func(params: post-groups-params) -> result<group, post-groups-error>;

  /// Create jobs to terminate user group session
  record post-groups-terminate-sessions-params {
    /// A list of group IDs
    group-ids: list<string>
  }
  post-groups-terminate-sessions: func(params: post-groups-terminate-sessions-params) -> result<session-termination-message, post-groups-terminate-sessions-error>;

  /// Get group
  record get-groups-id-params {
    /// The ID of the group.
    group-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-groups-id: func(params: get-groups-id-params) -> result<group-full, string>;

  /// Update group
  record put-groups-id-params {
    /// The ID of the group.
    group-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// A human readable description of the group.
    description: option<string>,
    /// An arbitrary identifier that can be used by
    /// external group sync tools to link this Box Group to
    external-sync-identifier: option<string>,
    /// Specifies who can invite the group to collaborate
    /// on folders.
    invitability-level: option<post-groups-body-invitability-level-enum>,
    /// Specifies who can see the members of the group.
    /// 
    member-viewability-level: option<post-groups-body-invitability-level-enum>,
    /// The name of the new group to be created. Must be unique within the
    /// enterprise.
    name: option<string>,
    /// Keeps track of which external source this group is
    /// coming, for example `Active Directory`, or `Okta`.
    provenance: option<string>
  }
  put-groups-id: func(params: put-groups-id-params) -> result<group-full, put-groups-id-error>;

  /// Remove group
  record delete-groups-id-params {
    /// The ID of the group.
    group-id: string
  }
  delete-groups-id: func(params: delete-groups-id-params) -> result<string, string>;

}

interface invites {
  enum invite-invited-to-type-op-enum {
    enterprise,
  }

  enum invite-type-op-enum {
    invite,
  }

  /// The user to invite
  record post-invites-body-actionable-by {
    /// The login of the invited user
    login: option<string>
  }

  /// The enterprise to invite the user to
  record post-invites-body-enterprise {
    /// The ID of the enterprise
    id: string
  }

  /// An invite for a user to an enterprise.
  record invite {
    actionable-by: option<user-mini>,
    /// When the invite was created
    created-at: option<string>,
    /// The unique identifier for this invite
    id: option<string>,
    invited-by: option<user-mini>,
    /// A representation of a Box enterprise
    invited-to: option<invite-invited-to>,
    /// When the invite was modified.
    modified-at: option<string>,
    /// The status of the invite
    status: option<string>,
    /// `invite`
    type-op: option<invite-type-op-enum>
  }

  /// A mini representation of a user, as can be returned when nested within other
  /// resources.
  record user-mini {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A representation of a Box enterprise
  record invite-invited-to {
    /// The unique identifier for this enterprise.
    id: option<string>,
    /// The name of the enterprise
    name: option<string>,
    /// `enterprise`
    type-op: option<invite-invited-to-type-op-enum>
  }

  /// Create user invite
  record post-invites-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The user to invite
    actionable-by: post-invites-body-actionable-by,
    /// The enterprise to invite the user to
    enterprise: post-invites-body-enterprise
  }
  post-invites: func(params: post-invites-params) -> result<invite, string>;

  /// Get user invite status
  record get-invites-id-params {
    /// The ID of an invite.
    invite-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-invites-id: func(params: get-invites-id-params) -> result<invite, string>;

}

interface legal-hold-policies {
  /// A list of legal hold policies.
  record legal-hold-policies {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Legal Hold Policy information describes the basic
  /// characteristics of the Policy, such as name, description,
  /// and filter dates.
  record legal-hold-policy {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-legal-hold-policies-error {
    bad-request(string),
    conflict(string),
    other(string)
  }

  variant put-legal-hold-policies-id-error {
    conflict(string),
    other(string)
  }

  /// List all legal hold policies
  record get-legal-hold-policies-params {
    /// Limits results to policies for which the names start with
    /// this search term. This is a case-insensitive prefix.
    policy-name: option<string>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-legal-hold-policies: func(params: get-legal-hold-policies-params) -> result<legal-hold-policies, string>;

  /// Create legal hold policy
  record post-legal-hold-policies-params {
    /// A description for the policy.
    description: option<string>,
    /// The filter end date.
    /// 
    filter-ended-at: option<string>,
    /// The filter start date.
    /// 
    filter-started-at: option<string>,
    /// Whether new assignments under this policy should
    /// continue applying to files even after initialization.
    is-ongoing: option<bool>,
    /// The name of the policy.
    policy-name: string
  }
  post-legal-hold-policies: func(params: post-legal-hold-policies-params) -> result<legal-hold-policy, post-legal-hold-policies-error>;

  /// Get legal hold policy
  record get-legal-hold-policies-id-params {
    /// The ID of the legal hold policy
    legal-hold-policy-id: string
  }
  get-legal-hold-policies-id: func(params: get-legal-hold-policies-id-params) -> result<legal-hold-policy, string>;

  /// Update legal hold policy
  record put-legal-hold-policies-id-params {
    /// The ID of the legal hold policy
    legal-hold-policy-id: string,
    /// A description for the policy.
    description: option<string>,
    /// The name of the policy.
    policy-name: option<string>,
    /// Notes around why the policy was released.
    release-notes: option<string>
  }
  put-legal-hold-policies-id: func(params: put-legal-hold-policies-id-params) -> result<legal-hold-policy, put-legal-hold-policies-id-error>;

  /// Remove legal hold policy
  record delete-legal-hold-policies-id-params {
    /// The ID of the legal hold policy
    legal-hold-policy-id: string
  }
  delete-legal-hold-policies-id: func(params: delete-legal-hold-policies-id-params) -> result<string, string>;

}

interface legal-hold-policy-assignments {
  enum get-legal-hold-policy-assignments-assign-to-type-enum {
    file,
    file-version,
    folder,
    user,
  }

  /// A list of legal hold policies assignments.
  record legal-hold-policy-assignments {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The item to assign the policy to
  record post-legal-hold-policy-assignments-body-assign-to {
    /// The ID of item to assign the policy to
    id: string,
    /// The type of item to assign the policy to
    type-op: get-legal-hold-policy-assignments-assign-to-type-enum
  }

  /// Legal Hold Assignments are used to assign Legal Hold
  /// Policies to Users, Folders, Files, or File Versions.
  /// 
  /// Creating a Legal Hold Assignment puts a hold
  /// on the File-Versions that belong to the Assignment's
  /// 'apply-to' entity.
  record legal-hold-policy-assignment {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A list of file version legal holds.
  record file-version-legal-holds {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List legal hold policy assignments
  record get-legal-hold-policy-assignments-params {
    /// The ID of the legal hold policy
    policy-id: string,
    /// Filters the results by the type of item the
    /// policy was applied to.
    assign-to-type: option<get-legal-hold-policy-assignments-assign-to-type-enum>,
    /// Filters the results by the ID of item the
    /// policy was applied to.
    assign-to-id: option<string>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-legal-hold-policy-assignments: func(params: get-legal-hold-policy-assignments-params) -> result<legal-hold-policy-assignments, string>;

  /// Assign legal hold policy
  record post-legal-hold-policy-assignments-params {
    /// The item to assign the policy to
    assign-to: post-legal-hold-policy-assignments-body-assign-to,
    /// The ID of the policy to assign.
    policy-id: string
  }
  post-legal-hold-policy-assignments: func(params: post-legal-hold-policy-assignments-params) -> result<legal-hold-policy-assignment, string>;

  /// Get legal hold policy assignment
  record get-legal-hold-policy-assignments-id-params {
    /// The ID of the legal hold policy assignment
    legal-hold-policy-assignment-id: string
  }
  get-legal-hold-policy-assignments-id: func(params: get-legal-hold-policy-assignments-id-params) -> result<legal-hold-policy-assignment, string>;

  /// Unassign legal hold policy
  record delete-legal-hold-policy-assignments-id-params {
    /// The ID of the legal hold policy assignment
    legal-hold-policy-assignment-id: string
  }
  delete-legal-hold-policy-assignments-id: func(params: delete-legal-hold-policy-assignments-id-params) -> result<string, string>;

  /// List previous file versions for legal hold policy assignment
  record get-legal-hold-policy-assignments-id-file-versions-on-hold-params {
    /// The ID of the legal hold policy assignment
    legal-hold-policy-assignment-id: string,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-legal-hold-policy-assignments-id-file-versions-on-hold: func(params: get-legal-hold-policy-assignments-id-file-versions-on-hold-params) -> result<file-version-legal-holds, string>;

  /// List current file versions for legal hold policy assignment
  record get-legal-hold-policy-assignments-id-files-on-hold-params {
    /// The ID of the legal hold policy assignment
    legal-hold-policy-assignment-id: string,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-legal-hold-policy-assignments-id-files-on-hold: func(params: get-legal-hold-policy-assignments-id-files-on-hold-params) -> result<file-version-legal-holds, string>;

}

interface metadata-cascade-policies {
  enum post-metadata-cascade-policies-body-scope-enum {
    global,
    enterprise,
  }

  enum metadata-cascade-policy-owner-enterprise-type-op-enum {
    enterprise,
  }

  enum metadata-cascade-policy-parent-type-op-enum {
    folder,
  }

  enum metadata-cascade-policy-type-op-enum {
    metadata-cascade-policy,
  }

  enum post-metadata-cascade-policies-id-apply-body-conflict-resolution-enum {
    none,
    overwrite,
  }

  /// A list of metadata cascade policies.
  record metadata-cascade-policies {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A metadata cascade policy automatically applies a metadata template instance
  /// to all the files and folders within the targeted folder.
  record metadata-cascade-policy {
    /// The ID of the metadata cascade policy object
    id: option<string>,
    /// The enterprise that owns this policy.
    owner-enterprise: option<metadata-cascade-policy-owner-enterprise>,
    /// Represent the folder the policy is applied to.
    parent: option<metadata-cascade-policy-parent>,
    /// The scope of the of the template that is cascaded down to the folder's
    /// children.
    scope: option<post-metadata-cascade-policies-body-scope-enum>,
    /// The key of the template that is cascaded down to the folder's
    /// children.
    template-key: option<string>,
    /// `metadata_cascade_policy`
    type-op: option<metadata-cascade-policy-type-op-enum>
  }

  /// The enterprise that owns this policy.
  record metadata-cascade-policy-owner-enterprise {
    /// The ID of the enterprise that owns the policy.
    id: option<string>,
    /// `enterprise`
    type-op: option<metadata-cascade-policy-owner-enterprise-type-op-enum>
  }

  /// Represent the folder the policy is applied to.
  record metadata-cascade-policy-parent {
    /// The ID of the folder the policy is applied to.
    id: option<string>,
    /// `folder`
    type-op: option<metadata-cascade-policy-parent-type-op-enum>
  }

  variant get-metadata-cascade-policies-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant post-metadata-cascade-policies-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-metadata-cascade-policies-id-error {
    not-found(string),
    other(string)
  }

  variant delete-metadata-cascade-policies-id-error {
    not-found(string),
    other(string)
  }

  variant post-metadata-cascade-policies-id-apply-error {
    not-found(string),
    other(string)
  }

  /// List metadata cascade policies
  record get-metadata-cascade-policies-params {
    /// Specifies which folder to return policies for. This can not be used on the
    /// root folder with ID `0`.
    folder-id: string,
    /// The ID of the enterprise ID for which to find metadata
    /// cascade policies. If not specified, it defaults to the
    owner-enterprise-id: option<string>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>
  }
  get-metadata-cascade-policies: func(params: get-metadata-cascade-policies-params) -> result<metadata-cascade-policies, get-metadata-cascade-policies-error>;

  /// Create metadata cascade policy
  record post-metadata-cascade-policies-params {
    /// The ID of the folder to apply the policy to. This folder will
    /// need to already have an instance of the targeted metadata
    folder-id: string,
    /// The scope of the targeted metadata template. This template will
    /// need to already have an instance applied to the targeted folder.
    scope: post-metadata-cascade-policies-body-scope-enum,
    /// The key of the targeted metadata template. This template will
    /// need to already have an instance applied to the targeted folder.
    template-key: string
  }
  post-metadata-cascade-policies: func(params: post-metadata-cascade-policies-params) -> result<metadata-cascade-policy, post-metadata-cascade-policies-error>;

  /// Get metadata cascade policy
  record get-metadata-cascade-policies-id-params {
    /// The ID of the metadata cascade policy.
    metadata-cascade-policy-id: string
  }
  get-metadata-cascade-policies-id: func(params: get-metadata-cascade-policies-id-params) -> result<metadata-cascade-policy, get-metadata-cascade-policies-id-error>;

  /// Remove metadata cascade policy
  record delete-metadata-cascade-policies-id-params {
    /// The ID of the metadata cascade policy.
    metadata-cascade-policy-id: string
  }
  delete-metadata-cascade-policies-id: func(params: delete-metadata-cascade-policies-id-params) -> result<string, delete-metadata-cascade-policies-id-error>;

  /// Force-apply metadata cascade policy to folder
  record post-metadata-cascade-policies-id-apply-params {
    /// The ID of the cascade policy to force-apply.
    metadata-cascade-policy-id: string,
    /// Describes the desired behavior when dealing with the conflict
    /// where a metadata template already has an instance applied
    conflict-resolution: post-metadata-cascade-policies-id-apply-body-conflict-resolution-enum
  }
  post-metadata-cascade-policies-id-apply: func(params: post-metadata-cascade-policies-id-apply-params) -> result<string, post-metadata-cascade-policies-id-apply-error>;

}

interface search {
  enum metadata-query-order-by-item-direction-enum {
    asc,
    desc,
    asc-v2,
    desc-v2,
  }

  enum get-metadata-query-indices-scope-enum {
    global,
    enterprise,
  }

  enum metadata-query-index-status-enum {
    building,
    active,
    disabled,
  }

  enum get-search-scope-enum {
    user-content,
    enterprise-content,
  }

  enum get-search-content-types-item-enum {
    name,
    description,
    file-content,
    comments,
    tag,
  }

  enum get-search-type-op-enum {
    file,
    folder,
    web-link,
  }

  enum get-search-trash-content-enum {
    non-trashed-only,
    trashed-only,
  }

  enum metadata-filter-scope-enum {
    global,
    enterprise,
    enterprise-enterprise-id,
  }

  enum get-search-sort-enum {
    modified-at,
    relevance,
  }

  enum get-search-direction-enum {
    desc,
    asc,
  }

  /// An object representing one of the metadata template fields to sort the
  /// metadata query results by.
  record metadata-query-order-by-item {
    /// The direction to order by, either ascending or descending.
    /// 
    direction: option<metadata-query-order-by-item-direction-enum>,
    /// The metadata template field to order by.
    /// 
    field-key: option<string>
  }

  /// Set of arguments corresponding to the parameters specified in the
  /// `query`. The type of each parameter used in the `query_params` must match
  /// the type of the corresponding metadata template field.
  record metadata-query-query-params {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A page of files and folders that matched the metadata query.
  record metadata-query-results {
    /// The mini representation of the files and folders that match the search
    /// terms.
    entries: option<list<string>>,
    /// The limit that was used for this search. This will be the same as the
    /// `limit` query parameter unless that value exceeded the maximum value
    limit: option<s64>,
    /// The marker for the start of the next page of results.
    next-marker: option<string>
  }

  /// A collection of metadata query indices.
  record metadata-query-indices {
    /// A collection of metadata query indices.
    entries: option<list<metadata-query-index>>,
    /// The limit that was used for this request.
    limit: option<s64>,
    /// The marker for the start of the next page of results.
    next-marker: option<string>
  }

  /// A metadata query index
  record metadata-query-index {
    /// A list of template fields which make up the index.
    fields: option<list<string>>,
    /// The ID of the metadata query index.
    id: option<string>,
    /// The status of the metadata query index
    status: metadata-query-index-status-enum,
    /// Value is always `metadata_query_index`
    type-op: string
  }

  /// A metadata template to filter the search results by.
  record metadata-filter {
    filters: option<metadata-filter-filters>,
    /// Specifies the scope of the template to filter search results by.
    /// 
    scope: option<metadata-filter-scope-enum>,
    /// The key of the template to filter search results by.
    /// 
    template-key: option<string>
  }

  record metadata-filter-filters {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-metadata-queries-execute-read-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant get-metadata-query-indices-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant get-search-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Query files/folders by metadata
  record post-metadata-queries-execute-read-params {
    /// The ID of the folder that you are restricting the query to. A
    /// value of zero will return results from all folders you have access
    ancestor-folder-id: string,
    /// By default, this endpoint returns only the most basic info about the items for
    /// which the query matches. This attribute can be used to specify a list of
    fields: option<list<string>>,
    /// Specifies the template used in the query. Must be in the form
    /// `scope.templateKey`. Not all templates can be used in this field,
    from-op: string,
    /// A value between 0 and 100 that indicates the maximum number of results
    /// to return for a single request. This only specifies a maximum
    limit: option<s32>,
    /// Marker to use for requesting the next page.
    marker: option<string>,
    /// A list of template fields and directions to sort the metadata query
    /// results by.
    order-by: option<list<metadata-query-order-by-item>>,
    /// The query to perform. A query is a logical expression that is very similar
    /// to a SQL `SELECT` statement. Values in the search query can be turned into
    query: option<string>,
    /// Set of arguments corresponding to the parameters specified in the
    /// `query`. The type of each parameter used in the `query_params` must match
    query-params: option<metadata-query-query-params>
  }
  post-metadata-queries-execute-read: func(params: post-metadata-queries-execute-read-params) -> result<metadata-query-results, post-metadata-queries-execute-read-error>;

  /// List metadata query indices
  record get-metadata-query-indices-params {
    /// The scope of the metadata template
    scope: get-metadata-query-indices-scope-enum,
    /// The name of the metadata template
    template-key: string
  }
  get-metadata-query-indices: func(params: get-metadata-query-indices-params) -> result<metadata-query-indices, get-metadata-query-indices-error>;

  /// Search for content
  record get-search-params {
    /// The string to search for. This query is matched against item names,
    /// descriptions, text content of files, and various other fields of
    query: option<string>,
    /// Limits the search results to either the files that the user has
    /// access to, or to files available to the entire enterprise.
    scope: option<get-search-scope-enum>,
    /// Limits the search results to any files that match any of the provided
    /// file extensions. This list is a comma-separated list of file extensions
    file-extensions: option<list<string>>,
    /// Limits the search results to any items created within
    /// a given date range.
    created-at-range: option<list<string>>,
    /// Limits the search results to any items updated within
    /// a given date range.
    updated-at-range: option<list<string>>,
    /// Limits the search results to any items with a size within
    /// a given file size range. This applied to files and folders.
    size-range: option<list<s32>>,
    /// Limits the search results to any items that are owned
    /// by the given list of owners, defined as a list of comma separated
    owner-user-ids: option<list<string>>,
    /// Limits the search results to any items that have been updated
    /// by the given list of users, defined as a list of comma separated
    recent-updater-user-ids: option<list<string>>,
    /// Limits the search results to items within the given
    /// list of folders, defined as a comma separated lists
    ancestor-folder-ids: option<list<string>>,
    /// Limits the search results to any items that match the search query
    /// for a specific part of the file, for example the file description.
    content-types: option<list<get-search-content-types-item-enum>>,
    /// Limits the search results to any items of this type. This
    /// parameter only takes one value. By default the API returns
    type-op: option<get-search-type-op-enum>,
    /// Determines if the search should look in the trash for items.
    /// 
    trash-content: option<get-search-trash-content-enum>,
    /// Limits the search results to any items for which the metadata matches
    /// the provided filter.
    mdfilters: option<list<metadata-filter>>,
    /// Defines the order in which search results are returned. This API
    /// defaults to returning items by relevance unless this parameter is
    sort: option<get-search-sort-enum>,
    /// Defines the direction in which search results are ordered. This API
    /// defaults to returning items in descending (`DESC`) order unless this
    direction: option<get-search-direction-enum>,
    /// Defines the maximum number of items to return as part of a page of
    /// results.
    limit: option<s64>,
    /// Defines whether the search results should include any items
    /// that the user recently accessed through a shared link.
    include-recent-shared-links: option<bool>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>,
    /// Limits the search results to items that were deleted by the given
    /// list of users, defined as a list of comma separated user IDs.
    deleted-user-ids: option<list<string>>,
    /// Limits the search results to any items deleted within a given
    /// date range.
    deleted-at-range: option<list<string>>
  }
  get-search: func(params: get-search-params) -> result<string, get-search-error>;

}

