    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// The scope of the metadata template
    scope: string,
    /// The name of the metadata template
    template-key: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  post-folders-id-metadata-id-id: func(params: post-folders-id-metadata-id-id-params) -> result<metadata, post-folders-id-metadata-id-id-error>;

  /// Update metadata instance on folder
  record put-folders-id-metadata-id-id-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// The scope of the metadata template
    scope: string,
    /// The name of the metadata template
    template-key: string,
    body: option<list<put-folders-id-metadata-id-id-body-item>>
  }
  put-folders-id-metadata-id-id: func(params: put-folders-id-metadata-id-id-params) -> result<metadata, put-folders-id-metadata-id-id-error>;

