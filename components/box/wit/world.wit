    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>
  }
  get-files-id-collaborations: func(params: get-files-id-collaborations-params) -> result<string, string>;

  /// List folder collaborations
  record get-folders-id-collaborations-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-folders-id-collaborations: func(params: get-folders-id-collaborations-params) -> result<string, string>;

  /// List group collaborations
  record get-groups-id-collaborations-params {
    /// The ID of the group.
    group-id: string,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>
  }
  get-groups-id-collaborations: func(params: get-groups-id-collaborations-params) -> result<string, string>;

}

interface collaborations {
  enum post-collaborations-body-accessible-by-type-op-enum {
    user,
    group,
  }

  enum post-collaborations-body-item-type-op-enum {
    file,
    folder,
  }

  enum post-collaborations-body-role-enum {
    editor,
    viewer,
    previewer,
    uploader,
    previewer-uploader,
    viewer-uploader,
    co-owner,
  }

  enum put-collaborations-id-body-role-enum {
    editor,
    viewer,
    previewer,
    uploader,
    previewer-uploader,
    viewer-uploader,
    co-owner,
    owner,
  }

  enum put-collaborations-id-body-status-enum {
    pending,
    accepted,
    rejected,
  }

  /// The user or group to give access to the item.
  record post-collaborations-body-accessible-by {
    /// The ID of the user or group.
    /// 
    id: option<string>,
    /// The email address of the user to grant access to the item.
    /// 
    login: option<string>,
    /// The type of collaborator to invite.
    type-op: post-collaborations-body-accessible-by-type-op-enum
  }

  /// The item to attach the comment to.
  record post-collaborations-body-item {
    /// The ID of the item that will be granted access to
    id: string,
    /// The type of the item that this collaboration will be
    /// granted access to
    type-op: post-collaborations-body-item-type-op-enum
  }

  /// Create collaboration
  record post-collaborations-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Determines if users should receive email notification
    /// for the action performed.
    notify: option<bool>,
    /// The user or group to give access to the item.
    accessible-by: post-collaborations-body-accessible-by,
    /// Determines if the invited users can see the entire parent path to
    /// the associated folder. The user will not gain privileges in any
    can-view-path: option<bool>,
    /// Set the expiration date for the collaboration. At this date, the
    /// collaboration will be automatically removed from the item.
    expires-at: option<string>,
    /// The item to attach the comment to.
    item: post-collaborations-body-item,
    /// The level of access granted.
    role: post-collaborations-body-role-enum
  }
  post-collaborations: func(params: post-collaborations-params) -> result<string, string>;

  /// Get collaboration
  record get-collaborations-id-params {
    /// The ID of the collaboration
    collaboration-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-collaborations-id: func(params: get-collaborations-id-params) -> result<string, string>;

  /// Update collaboration
  record put-collaborations-id-params {
    /// The ID of the collaboration
    collaboration-id: string,
    /// Determines if the invited users can see the entire parent path to
    /// the associated folder. The user will not gain privileges in any
    can-view-path: option<bool>,
    /// Update the expiration date for the collaboration. At this date,
    /// the collaboration will be automatically removed from the item.
    expires-at: option<string>,
    /// The level of access granted.
    role: put-collaborations-id-body-role-enum,
    /// <!--alex ignore reject-->
    /// Set the status of a `pending` collaboration invitation,
    status: option<put-collaborations-id-body-status-enum>
  }
  put-collaborations-id: func(params: put-collaborations-id-params) -> result<string, string>;

  /// Remove collaboration
  record delete-collaborations-id-params {
    /// The ID of the collaboration
    collaboration-id: string
  }
  delete-collaborations-id: func(params: delete-collaborations-id-params) -> result<string, string>;

}

interface collections {
  /// List all collections
  record get-collections-params {
    /// A comma-separated list of attributes to include in the
