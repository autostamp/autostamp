interface folder-locks {
  enum folder-lock-created-by-type-op-enum {
    user,
  }

  /// A list of folder locks
  record folder-locks {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The folder to apply the lock to.
  record post-folder-locks-body-folder {
    /// The ID of the folder.
    id: string,
    /// The content type the lock is being applied to. Only `folder`
    /// is supported.
    type-op: string
  }

  /// The operations to lock for the folder. If `locked_operations` is
  /// included in the request, both `move` and `delete` must also be
  /// included and both set to `true`.
  record post-folder-locks-body-locked-operations {
    /// Whether deleting the folder should be locked.
    delete: bool,
    /// Whether moving the folder should be locked.
    move: bool
  }

  /// Folder locks define access restrictions placed by folder owners
  /// to prevent specific folders from being moved or deleted.
  record folder-lock {
    /// When the folder lock object was created.
    created-at: option<string>,
    created-by: option<folder-lock-created-by>,
    folder: option<folder-lock-folder>,
    /// The unique identifier for this folder lock.
    id: option<string>,
    /// The lock type, always `freeze`.
    lock-type: option<string>,
    /// The operations that have been locked. Currently the `move`
    /// and `delete` operations cannot be locked separately, and both need to be
    locked-operations: option<folder-lock-locked-operations>,
    /// The object type, always `folder_lock`.
    type-op: option<string>
  }

  record folder-lock-created-by {
    /// The unique identifier for this user
    id: option<string>,
    /// `user`
    type-op: folder-lock-created-by-type-op-enum
  }

  record folder-lock-folder {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The operations that have been locked. Currently the `move`
  /// and `delete` operations cannot be locked separately, and both need to be
  /// set to `true`.
  record folder-lock-locked-operations {
    /// Whether deleting the folder is restricted.
    delete: bool,
    /// Whether moving the folder is restricted.
    move: bool
  }

  variant get-folder-locks-error {
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant post-folder-locks-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant delete-folder-locks-id-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// List folder locks
  record get-folder-locks-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string
  }
  get-folder-locks: func(params: get-folder-locks-params) -> result<folder-locks, get-folder-locks-error>;

  /// Create folder lock
  record post-folder-locks-params {
    /// The folder to apply the lock to.
    folder: post-folder-locks-body-folder,
    /// The operations to lock for the folder. If `locked_operations` is
    /// included in the request, both `move` and `delete` must also be
    locked-operations: option<post-folder-locks-body-locked-operations>
  }
  post-folder-locks: func(params: post-folder-locks-params) -> result<folder-lock, post-folder-locks-error>;

  /// Delete folder lock
  record delete-folder-locks-id-params {
    /// The ID of the folder lock.
    folder-lock-id: string
  }
  delete-folder-locks-id: func(params: delete-folder-locks-id-params) -> result<string, delete-folder-locks-id-error>;

}

interface folders {
  enum post-folders-body-folder-upload-email-access-enum {
    open,
    collaborators,
  }

  enum post-folders-body-sync-state-enum {
    synced,
    not-synced,
    partially-synced,
  }

  enum put-folders-id-body-shared-link-access-enum {
    open,
    company,
    collaborators,
  }

  enum get-folders-id-items-sort-enum {
    id,
    name,
    date,
    size,
  }

  enum get-folders-id-items-direction-enum {
    asc,
    desc,
  }

  record post-folders-body-folder-upload-email {
    /// When this parameter has been set, users can email files
    /// to the email address that has been automatically
    access: option<post-folders-body-folder-upload-email-access-enum>
  }

  /// The parent folder to create the new folder within.
  record post-folders-body-parent {
    /// The ID of parent folder
    id: string
  }

  /// A full representation of a folder, as can be returned from any
  /// folder API endpoints by default
  record folder-full {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The bare basic reference for an object
  record put-folders-id-body-collections-item {
    /// The unique identifier for this object
    id: option<string>,
    /// The type for this object
    type-op: option<string>
  }

  record put-folders-id-body-folder-upload-email {
    /// When this parameter has been set, users can email files
    /// to the email address that has been automatically
    access: option<post-folders-body-folder-upload-email-access-enum>
  }

  /// The parent folder for this folder. Use this to move
  /// the folder or to restore it out of the trash.
  record put-folders-id-body-parent {
    /// The ID of the new parent folder
    id: option<string>
  }

  record put-folders-id-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<put-folders-id-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    permissions: option<put-folders-id-body-shared-link-permissions>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  record put-folders-id-body-shared-link-permissions {
    /// If the shared link allows for downloading of files.
    /// This can only be set when `access` is set to
    can-download: option<bool>
  }

  /// The destination folder to copy the folder to.
  record post-folders-id-copy-body-parent {
    /// The ID of parent folder
    id: string
  }

  /// A list of files, folders, and web links in
  /// their mini representation.
  record items {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-folders-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-folders-id-error {
    not-modified(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant put-folders-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    precondition-failed(string),
    service-unavailable(string),
    other(string)
  }

  variant delete-folders-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    precondition-failed(string),
    service-unavailable(string),
    other(string)
  }

  variant post-folders-id-copy-error {
    not-modified(string),
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    internal-server-error(string),
    other(string)
  }

  variant get-folders-id-items-error {
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  /// Create folder
  record post-folders-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    folder-upload-email: option<post-folders-body-folder-upload-email>,
    /// The name for the new folder.
    /// 
    name: string,
    /// The parent folder to create the new folder within.
    parent: post-folders-body-parent,
    /// Specifies whether a folder should be synced to a
    /// user's device or not. This is used by Box Sync
    sync-state: option<post-folders-body-sync-state-enum>
  }
  post-folders: func(params: post-folders-params) -> result<folder-full, post-folders-error>;

  /// Get folder information
  record get-folders-id-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Ensures an item is only returned if it has changed.
    /// 
    if-none-match: option<string>,
    /// The URL, and optional password, for the shared link of this item.
    /// 
    boxapi: option<string>
  }
  get-folders-id: func(params: get-folders-id-params) -> result<folder-full, get-folders-id-error>;

  /// Update folder
  record put-folders-id-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Ensures this item hasn't recently changed before
    /// making changes.
    if-match: option<string>,
    /// Specifies if users who are not the owner
    /// of the folder can invite new collaborators to the folder.
    can-non-owners-invite: option<bool>,
    /// Restricts collaborators who are not the owner of
    /// this folder from viewing other collaborations on
    can-non-owners-view-collaborators: option<bool>,
    /// An array of collections to make this folder
    /// a member of. Currently
    collections: option<list<put-folders-id-body-collections-item>>,
    /// The optional description of this folder
    description: option<string>,
    folder-upload-email: option<put-folders-id-body-folder-upload-email>,
    /// Specifies if new invites to this folder are restricted to users
    /// within the enterprise. This does not affect existing
    is-collaboration-restricted-to-enterprise: option<bool>,
    /// The optional new name for this folder.
    name: option<string>,
    /// The parent folder for this folder. Use this to move
    /// the folder or to restore it out of the trash.
    parent: option<put-folders-id-body-parent>,
    shared-link: option<put-folders-id-body-shared-link>,
    /// Specifies whether a folder should be synced to a
    /// user's device or not. This is used by Box Sync
    sync-state: option<post-folders-body-sync-state-enum>,
    /// The tags for this item. These tags are shown in
    /// the Box web app and mobile apps next to an item.
    tags: option<list<string>>
  }
  put-folders-id: func(params: put-folders-id-params) -> result<folder-full, put-folders-id-error>;

  /// Delete folder
  record delete-folders-id-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// Ensures this item hasn't recently changed before
    /// making changes.
    if-match: option<string>,
    /// Delete a folder that is not empty by recursively deleting the
    /// folder and all of its content.
    recursive: option<bool>
  }
  delete-folders-id: func(params: delete-folders-id-params) -> result<string, delete-folders-id-error>;

  /// Copy folder
  record post-folders-id-copy-params {
    /// The unique identifier of the folder to copy.
    /// 
    folder-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional new name for the copied folder.
    /// 
    name: option<string>,
    /// The destination folder to copy the folder to.
    parent: post-folders-id-copy-body-parent
  }
  post-folders-id-copy: func(params: post-folders-id-copy-params) -> result<folder-full, post-folders-id-copy-error>;

  /// List items in folder
  record get-folders-id-items-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Specifies whether to use marker-based pagination instead of
    /// offset-based pagination. Only one pagination method can
    usemarker: option<bool>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// The URL, and optional password, for the shared link of this item.
    /// 
    boxapi: option<string>,
    /// Defines the **second** attribute by which items
    /// are sorted.
    sort: option<get-folders-id-items-sort-enum>,
    /// The direction to sort results in. This can be either in alphabetical ascending
    /// (`ASC`) or descending (`DESC`) order.
    direction: option<get-folders-id-items-direction-enum>
  }
  get-folders-id-items: func(params: get-folders-id-items-params) -> result<items, get-folders-id-items-error>;

}

interface trashed-items {
  enum get-folders-trash-items-direction-enum {
    asc,
    desc,
