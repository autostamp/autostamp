/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `OAuth2Security` | `Authorization: Bearer <secret>` |
package autostamp:box-api@0.2.0;

interface authorization {
  enum get-authorize-response-type-enum {
    code,
  }

  /// Authorize user
  record get-authorize-params {
    /// The type of response we'd like to receive.
    response-type: get-authorize-response-type-enum,
    /// The Client ID of the application that is requesting to authenticate
    /// the user. To get the Client ID for your application, log in to your
    client-id: string,
    /// The URI to which Box redirects the browser after the user has granted
    /// or denied the application permission. This URI match one of the redirect
    redirect-uri: option<string>,
    /// A custom string of your choice. Box will pass the same string to
    /// the redirect URL when authentication is complete. This parameter
    state: option<string>,
    /// A comma-separated list of application scopes you'd like to
    /// authenticate the user for. This defaults to all the scopes configured
    scope: option<string>
  }
  get-authorize: func(params: get-authorize-params) -> result<string, string>;

  /// Revoke access token
  post-oauth2-revoke: func() -> result<string, string>;

  /// Request access token
  post-oauth2-token: func() -> result<string, string>;

  /// Refresh access token
  refresh: func() -> result<string, string>;

}


interface domain-restrictions-for-collaborations {
  enum post-collaboration-whitelist-entries-body-direction-enum {
    inbound,
    outbound,
    both,
  }

  /// List allowed collaboration domains
  record get-collaboration-whitelist-entries-params {
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-collaboration-whitelist-entries: func(params: get-collaboration-whitelist-entries-params) -> result<string, string>;

  /// Add domain to list of allowed collaboration domains
  record post-collaboration-whitelist-entries-params {
    /// The direction in which to allow collaborations.
    direction: post-collaboration-whitelist-entries-body-direction-enum,
    /// The domain to add to the list of allowed domains.
    domain: string
  }
  post-collaboration-whitelist-entries: func(params: post-collaboration-whitelist-entries-params) -> result<string, string>;

  /// Get allowed collaboration domain
  record get-collaboration-whitelist-entries-id-params {
    /// The ID of the entry in the list.
    collaboration-whitelist-entry-id: string
  }
  get-collaboration-whitelist-entries-id: func(params: get-collaboration-whitelist-entries-id-params) -> result<string, string>;

  /// Remove domain from list of allowed collaboration domains
  record delete-collaboration-whitelist-entries-id-params {
    /// The ID of the entry in the list.
    collaboration-whitelist-entry-id: string
  }
  delete-collaboration-whitelist-entries-id: func(params: delete-collaboration-whitelist-entries-id-params) -> result<string, string>;

}

interface domain-restrictions-user-exemptions {
  /// The user to exempt.
  record post-collaboration-whitelist-exempt-targets-body-user {
    /// The ID of the user to exempt.
    id: string
  }

  /// List users exempt from collaboration domain restrictions
  record get-collaboration-whitelist-exempt-targets-params {
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-collaboration-whitelist-exempt-targets: func(params: get-collaboration-whitelist-exempt-targets-params) -> result<string, string>;

  /// Create user exemption from collaboration domain restrictions
  record post-collaboration-whitelist-exempt-targets-params {
    /// The user to exempt.
    user: post-collaboration-whitelist-exempt-targets-body-user
  }
  post-collaboration-whitelist-exempt-targets: func(params: post-collaboration-whitelist-exempt-targets-params) -> result<string, string>;

  /// Get user exempt from collaboration domain restrictions
  record get-collaboration-whitelist-exempt-targets-id-params {
    /// The ID of the exemption to the list.
    collaboration-whitelist-exempt-target-id: string
  }
  get-collaboration-whitelist-exempt-targets-id: func(params: get-collaboration-whitelist-exempt-targets-id-params) -> result<string, string>;

  /// Remove user from list of users exempt from domain restrictions
  record delete-collaboration-whitelist-exempt-targets-id-params {
    /// The ID of the exemption to the list.
    collaboration-whitelist-exempt-target-id: string
  }
  delete-collaboration-whitelist-exempt-targets-id: func(params: delete-collaboration-whitelist-exempt-targets-id-params) -> result<string, string>;

}

