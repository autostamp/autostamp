interface trashed-folders {
  enum trash-folder-restored-item-status-enum {
    active,
    trashed,
    deleted,
  }

  enum trash-folder-restored-type-op-enum {
    folder,
  }

  record post-folders-id-body-parent {
    /// The ID of parent item
    id: option<string>
  }

  /// Represents a folder restored from the trash.
  record trash-folder-restored {
    /// The date and time at which this folder was originally
    /// created.
    content-created-at: option<string>,
    /// The date and time at which this folder was last updated.
    content-modified-at: option<string>,
    /// The date and time when the folder was created. This value may
    /// be `null` for some folders such as the root folder or the trash
    created-at: option<string>,
    created-by: option<trash-folder-restored-created-by>,
    description: option<trash-folder-restored-description>,
    /// The HTTP `etag` of this folder. This can be used within some API
    /// endpoints in the `If-Match` and `If-None-Match` headers to only
    etag: option<string>,
    /// The folder upload email for this folder. This will
    /// be `null` if a folder has been trashed, even though the original upload
    folder-upload-email: option<string>,
    /// The unique identifier that represent a folder.
    /// 
    id: option<string>,
    /// Defines if this item has been deleted or not.
    /// 
    item-status: option<trash-folder-restored-item-status-enum>,
    /// The date and time when the folder was last updated. This value may
    /// be `null` for some folders such as the root folder or the trash
    modified-at: option<string>,
    modified-by: option<trash-folder-restored-modified-by>,
    /// The name of the folder.
    name: option<string>,
    owned-by: option<trash-folder-restored-owned-by>,
    parent: option<trash-folder-restored-parent>,
    path-collection: option<trash-folder-restored-path-collection>,
    /// The time at which this folder is expected to be purged
    /// from the trash  - becomes `null` after restore.
    purged-at: option<string>,
    sequence-id: option<trash-folder-restored-sequence-id>,
    /// The shared link for this file. This will
    /// be `null` if a folder had been trashed, even though the original shared
    shared-link: option<string>,
    /// The folder size in bytes.
    /// 
    size: option<s64>,
    /// The time at which this folder was put in the
    /// trash - becomes `null` after restore.
    trashed-at: option<string>,
    /// `folder`
    type-op: option<trash-folder-restored-type-op-enum>
  }

  record trash-folder-restored-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-restored-description {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-restored-modified-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-restored-owned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-restored-parent {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-restored-path-collection {
    /// The parent folders for this item
    entries: list<folder-mini>,
    /// The number of folders in this list.
    total-count: s64
  }

  /// A mini representation of a file version, used when
  /// nested under another resource.
  record folder-mini {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-restored-sequence-id {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents a trashed folder.
  record trash-folder {
    /// The date and time at which this folder was originally
    /// created.
    content-created-at: option<string>,
    /// The date and time at which this folder was last updated.
    content-modified-at: option<string>,
    /// The date and time when the folder was created. This value may
    /// be `null` for some folders such as the root folder or the trash
    created-at: option<string>,
    created-by: trash-folder-created-by,
    description: trash-folder-description,
    /// The HTTP `etag` of this folder. This can be used within some API
    /// endpoints in the `If-Match` and `If-None-Match` headers to only
    etag: option<string>,
    /// The folder upload email for this folder. This will
    /// be `null` if a folder has been trashed, since the upload will no longer
    folder-upload-email: option<string>,
    /// The unique identifier that represent a folder.
    /// 
    id: string,
    /// Defines if this item has been deleted or not.
    /// 
    item-status: trash-folder-restored-item-status-enum,
    /// The date and time when the folder was last updated. This value may
    /// be `null` for some folders such as the root folder or the trash
    modified-at: option<string>,
    modified-by: trash-folder-modified-by,
    /// The name of the folder.
    name: string,
    owned-by: trash-folder-owned-by,
    parent: option<trash-folder-parent>,
    path-collection: trash-folder-path-collection,
    /// The time at which this folder is expected to be purged
    /// from the trash.
    purged-at: option<string>,
    sequence-id: option<trash-folder-sequence-id>,
    /// The shared link for this folder. This will
    /// be `null` if a folder has been trashed, since the link will no longer
    shared-link: option<string>,
    /// The folder size in bytes.
    /// 
    size: s64,
    /// The time at which this folder was put in the trash.
    trashed-at: option<string>,
    /// `folder`
    type-op: trash-folder-restored-type-op-enum
  }

  record trash-folder-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-description {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-modified-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-owned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-parent {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-folder-path-collection {
    /// Array of folders for this item's path collection
    entries: list<trash-folder-path-collection-entries-item>,
    /// The number of folders in this list.
    total-count: s64
  }

  /// The parent folder for this item
  record trash-folder-path-collection-entries-item {
    /// This field is null for the Trash folder
    etag: option<string>,
    /// The unique identifier that represent a folder.
    id: option<string>,
    /// The name of the Trash folder.
    name: option<string>,
    /// This field is null for the Trash folder
    sequence-id: option<string>,
    /// `folder`
    type-op: option<trash-folder-restored-type-op-enum>
  }

  record trash-folder-sequence-id {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-folders-id-error {
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-folders-id-trash-error {
    not-found(string),
    other(string)
  }

  variant delete-folders-id-trash-error {
    not-found(string),
    other(string)
  }

  /// Restore folder
  record post-folders-id-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional new name for the folder.
    name: option<string>,
    parent: option<post-folders-id-body-parent>
  }
  post-folders-id: func(params: post-folders-id-params) -> result<trash-folder-restored, post-folders-id-error>;

  /// Get trashed folder
  record get-folders-id-trash-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-folders-id-trash: func(params: get-folders-id-trash-params) -> result<trash-folder, get-folders-id-trash-error>;

  /// Permanently remove folder
  record delete-folders-id-trash-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string
  }
  delete-folders-id-trash: func(params: delete-folders-id-trash-params) -> result<string, delete-folders-id-trash-error>;

}

interface shared-links-folders {
  enum add-shared-link-body-shared-link-access-enum {
    open,
    company,
    collaborators,
  }

  /// The settings for the shared link to create on the folder.
  /// 
  /// Use an empty object (`{}`) to use the default settings for shared
  /// links.
  record add-shared-link-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<add-shared-link-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    permissions: option<add-shared-link-body-shared-link-permissions>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  record add-shared-link-body-shared-link-permissions {
    /// If the shared link allows for downloading of files.
    /// This can only be set when `access` is set to
    can-download: option<bool>,
    /// This value can only be `false` for items
    /// with a `type` of `folder`.
    can-edit: option<bool>,
    /// If the shared link allows for previewing of files.
    /// This value is always `true`. For shared links on folders
    can-preview: option<bool>
  }

  /// A full representation of a folder, as can be returned from any
  /// folder API endpoints by default
  record folder-full {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// By setting this value to `null`, the shared link
  /// is removed from the folder.
  record remove-shared-link-body-shared-link {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The settings for the shared link to update.
  record update-shared-link-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<add-shared-link-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    permissions: option<update-shared-link-body-shared-link-permissions>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  record update-shared-link-body-shared-link-permissions {
    /// If the shared link allows for downloading of files.
    /// This can only be set when `access` is set to
    can-download: option<bool>,
    /// This value can only be `false` for items
    /// with a `type` of `folder`.
    can-edit: option<bool>,
    /// If the shared link allows for previewing of files.
    /// This value is always `true`. For shared links on folders
    can-preview: option<bool>
  }

  variant add-shared-link-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant get-shared-link-error {
    unauthorized(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant remove-shared-link-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant update-shared-link-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant folders-error {
    not-modified(string),
    other(string)
  }

  /// Add shared link to folder
  record add-shared-link-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// The settings for the shared link to create on the folder.
    /// 
    shared-link: option<add-shared-link-body-shared-link>
  }
  add-shared-link: func(params: add-shared-link-params) -> result<folder-full, add-shared-link-error>;

  /// Get shared link for folder
  record get-shared-link-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string
  }
  get-shared-link: func(params: get-shared-link-params) -> result<folder-full, get-shared-link-error>;

  /// Remove shared link from folder
  record remove-shared-link-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// By setting this value to `null`, the shared link
    /// is removed from the folder.
    shared-link: option<remove-shared-link-body-shared-link>
  }
  remove-shared-link: func(params: remove-shared-link-params) -> result<folder-full, remove-shared-link-error>;

  /// Update shared link on folder
  record update-shared-link-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// The settings for the shared link to update.
    shared-link: option<update-shared-link-body-shared-link>
  }
  update-shared-link: func(params: update-shared-link-params) -> result<folder-full, update-shared-link-error>;

  /// Find folder for shared link
  record folders-params {
    /// Ensures an item is only returned if it has changed.
    /// 
    if-none-match: option<string>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// A header containing the shared link and optional password for the
    /// shared link.
    boxapi: string
  }
  folders: func(params: folders-params) -> result<folder-full, folders-error>;

}

interface metadata-instances-folders {
  enum put-folders-id-metadata-id-id-body-item-op-enum {
    add,
    replace,
    remove,
    test,
    move,
    copy,
  }

