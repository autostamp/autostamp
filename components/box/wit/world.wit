interface skills {
  enum put-files-id-metadata-global-box-skills-cards-body-item-op-enum {
    replace,
  }

  enum put-skill-invocations-id-body-file-type-op-enum {
    file,
  }

  enum put-skill-invocations-id-body-file-version-type-op-enum {
    file-version,
  }

  enum put-skill-invocations-id-body-status-enum {
    invoked,
    processing,
    success,
    transient-failure,
    permanent-failure,
  }

  /// The metadata assigned to a using for Box skills.
  record skill-cards-metadata {
    /// Whether the user can edit this metadata
    can-edit: option<bool>,
    /// A UUID to identify the metadata object
    id: option<string>,
    /// An ID for the parent folder
    parent: option<string>,
    /// An ID for the scope in which this template
    /// has been applied
    scope: option<string>,
    /// The name of the template
    template: option<string>,
    /// A unique identifier for the "type" of this instance. This is an internal
    /// system property and should not be used by a client application.
    type-op: option<string>,
    /// The last-known version of the template of the object. This is an internal
    /// system property and should not be used by a client application.
    type-version: option<s32>,
    /// The version of the metadata object. Starts at 0 and increases every time
    /// a user-defined property is modified.
    version: option<s32>,
    /// A list of Box Skill cards that have been applied to this file.
    cards: option<list<string>>
  }

  /// An operation that replaces an existing card.
  record put-files-id-metadata-global-box-skills-cards-body-item {
    /// `replace`
    op: option<put-files-id-metadata-global-box-skills-cards-body-item-op-enum>,
    /// The JSON Path that represents the card to replace. In most cases
    /// this will be in the format `/cards/{index}` where `index` is the
    path: option<string>,
    value: option<put-files-id-metadata-global-box-skills-cards-body-item-value>
  }

  record put-files-id-metadata-global-box-skills-cards-body-item-value {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The file to assign the cards to.
  record put-skill-invocations-id-body-file {
    /// The ID of the file
    id: option<string>,
    /// `file`
    type-op: option<put-skill-invocations-id-body-file-type-op-enum>
  }

  /// The optional file version to assign the cards to.
  record put-skill-invocations-id-body-file-version {
    /// The ID of the file version
    id: option<string>,
    /// `file_version`
    type-op: option<put-skill-invocations-id-body-file-version-type-op-enum>
  }

  /// The metadata to set for this skill. This is a list of
  /// Box Skills cards. These cards will overwrite any existing Box
  /// skill cards on the file.
  record put-skill-invocations-id-body-metadata {
    /// A list of Box Skill cards to apply to this file.
    cards: option<list<string>>
  }

  /// A descriptor that defines what items are affected by this call.
  /// 
  /// Set this to the default values when setting a card to a `success`
  /// state, and leave it out in most other situations.
  record put-skill-invocations-id-body-usage {
    /// `file`
    unit: option<string>,
    /// `1`
    value: option<f64>
  }

  variant post-files-id-metadata-global-box-skills-cards-error {
    bad-request(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant put-files-id-metadata-global-box-skills-cards-error {
    not-found(string),
    other(string)
  }

  variant delete-files-id-metadata-global-box-skills-cards-error {
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant put-skill-invocations-id-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  /// List Box Skill cards on file
  record get-files-id-metadata-global-box-skills-cards-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string
  }
  get-files-id-metadata-global-box-skills-cards: func(params: get-files-id-metadata-global-box-skills-cards-params) -> result<skill-cards-metadata, string>;

  /// Create Box Skill cards on file
  record post-files-id-metadata-global-box-skills-cards-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A list of Box Skill cards to apply to this file.
    cards: list<string>
  }
  post-files-id-metadata-global-box-skills-cards: func(params: post-files-id-metadata-global-box-skills-cards-params) -> result<skill-cards-metadata, post-files-id-metadata-global-box-skills-cards-error>;

  /// Update Box Skill cards on file
  record put-files-id-metadata-global-box-skills-cards-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    body: option<list<put-files-id-metadata-global-box-skills-cards-body-item>>
  }
  put-files-id-metadata-global-box-skills-cards: func(params: put-files-id-metadata-global-box-skills-cards-params) -> result<skill-cards-metadata, put-files-id-metadata-global-box-skills-cards-error>;

  /// Remove Box Skill cards from file
  record delete-files-id-metadata-global-box-skills-cards-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string
  }
  delete-files-id-metadata-global-box-skills-cards: func(params: delete-files-id-metadata-global-box-skills-cards-params) -> result<string, delete-files-id-metadata-global-box-skills-cards-error>;

  /// Update all Box Skill cards on file
  record put-skill-invocations-id-params {
    /// The ID of the skill to apply this metadata for.
    skill-id: string,
    /// The file to assign the cards to.
    file: put-skill-invocations-id-body-file,
    /// The optional file version to assign the cards to.
    file-version: option<put-skill-invocations-id-body-file-version>,
    /// The metadata to set for this skill. This is a list of
    /// Box Skills cards. These cards will overwrite any existing Box
    metadata: put-skill-invocations-id-body-metadata,
    /// Defines the status of this invocation. Set this to `success` when setting Skill cards.
    status: put-skill-invocations-id-body-status-enum,
    /// A descriptor that defines what items are affected by this call.
    /// 
    usage: option<put-skill-invocations-id-body-usage>
  }
  put-skill-invocations-id: func(params: put-skill-invocations-id-params) -> result<string, put-skill-invocations-id-error>;

}

interface tasks {
  enum task-action-enum {
    review,
    complete,
  }

  enum task-completion-rule-enum {
    all-assignees,
    any-assignee,
  }

  enum task-assignment-resolution-state-enum {
    completed,
    incomplete,
    approved,
    rejected,
  }

  enum task-assignment-type-op-enum {
    task-assignment,
  }

  enum task-type-op-enum {
    task,
  }

  enum post-tasks-body-item-type-op-enum {
    file,
  }

  /// A list of tasks
  record tasks {
    entries: option<list<task>>,
    /// One greater than the offset of the last entry in the entire collection.
    /// The total number of entries in the collection may be less than
    total-count: option<s64>
  }

  /// A task allows for file-centric workflows within Box. Users can
  /// create tasks on files and assign them to other users for them to complete the
  /// tasks.
  record task {
    /// The type of task the task assignee will be prompted to
    /// perform.
    action: option<task-action-enum>,
    /// Defines which assignees need to complete this task before the task
    /// is considered completed.
    completion-rule: option<task-completion-rule-enum>,
    /// When the task object was created
    created-at: option<string>,
    created-by: option<task-created-by>,
    /// When the task is due
    due-at: option<string>,
    /// The unique identifier for this task
    id: option<string>,
    /// Whether the task has been completed
    is-completed: option<bool>,
    item: option<task-item>,
    /// A message that will be included with the task
    message: option<string>,
    task-assignment-collection: option<task-task-assignment-collection>,
    /// `task`
    type-op: option<task-type-op-enum>
  }

  record task-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-task-assignment-collection {
    entries: option<list<task-assignment>>,
    /// The total number of items in this collection.
    total-count: option<s64>
  }

  /// A task assignment defines which task is assigned to which user to complete.
  record task-assignment {
    /// The date at which this task was assigned to the user.
    assigned-at: option<string>,
    assigned-by: option<task-assignment-assigned-by>,
    assigned-to: option<task-assignment-assigned-to>,
    /// The date at which this task assignment was
    /// completed. This will be `null` if the task is not completed yet.
    completed-at: option<string>,
    /// The unique identifier for this task assignment
    id: option<string>,
    item: option<task-assignment-item>,
    /// A message that will is included with the task
    /// assignment. This is visible to the assigned user in the web and mobile
    message: option<string>,
    /// The date at which the assigned user was reminded of this task
    /// assignment.
    reminded-at: option<string>,
    /// The current state of the assignment. The available states depend on
    /// the `action` value of the task object.
    resolution-state: option<task-assignment-resolution-state-enum>,
    /// `task_assignment`
    type-op: option<task-assignment-type-op-enum>
  }

  record task-assignment-assigned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-assignment-assigned-to {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record task-assignment-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The file to attach the task to.
  record post-tasks-body-item {
    /// The ID of the file
    id: string,
    /// `file`
    type-op: post-tasks-body-item-type-op-enum
  }

  variant get-files-id-tasks-error {
    not-found(string),
    method-not-allowed(string),
    internal-server-error(string),
    other(string)
  }

  variant post-tasks-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant get-tasks-id-error {
    not-found(string),
    other(string)
  }

  variant put-tasks-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant delete-tasks-id-error {
    not-found(string),
    other(string)
  }

  /// List tasks on file
  record get-files-id-tasks-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string
  }
  get-files-id-tasks: func(params: get-files-id-tasks-params) -> result<tasks, get-files-id-tasks-error>;

  /// Create task
  record post-tasks-params {
    /// The action the task assignee will be prompted to do. Must be
    /// 
    action: option<task-action-enum>,
    /// Defines which assignees need to complete this task before the task
    /// is considered completed.
    completion-rule: option<task-completion-rule-enum>,
    /// Defines when the task is due. Defaults to `null` if not
    /// provided.
    due-at: option<string>,
    /// The file to attach the task to.
    item: post-tasks-body-item,
    /// An optional message to include with the task.
    message: option<string>
  }
  post-tasks: func(params: post-tasks-params) -> result<task, post-tasks-error>;

  /// Get task
  record get-tasks-id-params {
    /// The ID of the task.
    task-id: string
  }
  get-tasks-id: func(params: get-tasks-id-params) -> result<task, get-tasks-id-error>;

  /// Update task
  record put-tasks-id-params {
    /// The ID of the task.
    task-id: string,
    /// The action the task assignee will be prompted to do. Must be
    /// 
    action: option<task-action-enum>,
    /// Defines which assignees need to complete this task before the task
    /// is considered completed.
    completion-rule: option<task-completion-rule-enum>,
    /// When the task is due at.
    due-at: option<string>,
    /// The message included with the task.
    message: option<string>
  }
  put-tasks-id: func(params: put-tasks-id-params) -> result<task, put-tasks-id-error>;

  /// Remove task
  record delete-tasks-id-params {
    /// The ID of the task.
    task-id: string
  }
  delete-tasks-id: func(params: delete-tasks-id-params) -> result<string, delete-tasks-id-error>;

}

interface file-versions {
  enum post-files-id-versions-current-body-type-op-enum {
    file-version,
  }

  /// A list of file versions
  record file-versions {
    /// JSON-encoded free-form object payload
