interface file-requests {
  enum file-request-status-enum {
    active,
    inactive,
  }

  enum file-request-type-op-enum {
    file-request,
  }

  /// A standard representation of a file request, as returned
  /// from any file request API endpoints by default.
  record file-request {
    /// The date and time when the file request was created.
    created-at: string,
    created-by: option<file-request-created-by>,
    /// The optional description of this file request. This is
    /// shown in the Box UI to users uploading files.
    description: option<string>,
    /// The HTTP `etag` of this file. This can be used in combination with
    /// the `If-Match` header when updating a file request. By providing that
    etag: option<string>,
    /// The date after which a file request will no longer accept new
    /// submissions.
    expires-at: option<string>,
    folder: file-request-folder,
    /// The unique identifier for this file request.
    id: option<string>,
    /// Whether a file request submitter is required to provide
    /// a description of the files they are submitting.
    is-description-required: option<bool>,
    /// Whether a file request submitter is required to provide
    /// their email address.
    is-email-required: option<bool>,
    /// The status of the file request. This defaults
    /// to `active`.
    status: option<file-request-status-enum>,
    /// The title of file request. This is shown
    /// in the Box UI to users uploading files.
    title: option<string>,
    /// `file_request`
    type-op: option<file-request-type-op-enum>,
    /// The date and time when the file request was last updated.
    updated-at: string,
    updated-by: option<file-request-updated-by>,
    /// The generated URL for this file request. This URL can be shared
    /// with users to let them upload files to the associated folder.
    url: option<string>
  }

  record file-request-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record file-request-folder {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record file-request-updated-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant get-file-requests-id-error {
    unauthorized(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant put-file-requests-id-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant delete-file-requests-id-error {
    unauthorized(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant post-file-requests-id-copy-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  /// Get file request
  record get-file-requests-id-params {
    /// The unique identifier that represent a file request.
    /// 
    file-request-id: string
  }
  get-file-requests-id: func(params: get-file-requests-id-params) -> result<file-request, get-file-requests-id-error>;

  /// Update file request
  record put-file-requests-id-params {
    /// The unique identifier that represent a file request.
    /// 
    file-request-id: string,
    /// Ensures this item hasn't recently changed before
    /// making changes.
    if-match: option<string>,
    /// An optional new description for the file request. This can be
    /// used to change the description of the file request.
    description: option<string>,
    /// The date after which a file request will no longer accept new
    /// submissions.
    expires-at: option<string>,
    /// Whether a file request submitter is required to provide
    /// a description of the files they are submitting.
    is-description-required: option<bool>,
    /// Whether a file request submitter is required to provide
    /// their email address.
    is-email-required: option<bool>,
    /// An optional new status of the file request.
    /// 
    status: option<file-request-status-enum>,
    /// An optional new title for the file request. This can be
    /// used to change the title of the file request.
    title: option<string>
  }
  put-file-requests-id: func(params: put-file-requests-id-params) -> result<file-request, put-file-requests-id-error>;

  /// Delete file request
  record delete-file-requests-id-params {
    /// The unique identifier that represent a file request.
    /// 
    file-request-id: string
  }
  delete-file-requests-id: func(params: delete-file-requests-id-params) -> result<string, delete-file-requests-id-error>;

  /// Copy file request
  record post-file-requests-id-copy-params {
    /// The unique identifier that represent a file request.
    /// 
    file-request-id: string,
    /// JSON-encoded free-form object payload
    data: option<string>
  }
  post-file-requests-id-copy: func(params: post-file-requests-id-copy-params) -> result<file-request, post-file-requests-id-copy-error>;

}

