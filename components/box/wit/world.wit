interface web-links {
  enum post-web-links-body-shared-link-access-enum {
    open,
    company,
    collaborators,
  }

  /// The parent folder to create the web link within.
  record post-web-links-body-parent {
    /// The ID of parent folder
    id: string
  }

  /// The settings for the shared link to update.
  record post-web-links-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<post-web-links-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  /// Web links are objects that point to URLs. These objects
  /// are also known as bookmarks within the Box web application.
  /// 
  /// Web link objects are treated similarly to file objects,
  /// they will also support most actions that apply to regular files.
  record web-link {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record put-web-links-id-body-parent {
    /// The ID of parent item
    id: option<string>
  }

  /// The settings for the shared link to update.
  record put-web-links-id-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<post-web-links-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  /// Create web link
  record post-web-links-params {
    /// Description of the web link.
    description: option<string>,
    /// Name of the web link. Defaults to the URL if not set.
    name: option<string>,
    /// The parent folder to create the web link within.
    parent: post-web-links-body-parent,
    /// The settings for the shared link to update.
    shared-link: option<post-web-links-body-shared-link>,
    /// The URL that this web link links to. Must start with
    /// `"http://"` or `"https://"`.
    url: string
  }
  post-web-links: func(params: post-web-links-params) -> result<web-link, string>;

  /// Get web link
  record get-web-links-id-params {
    /// The ID of the web link.
    web-link-id: string,
    /// The URL, and optional password, for the shared link of this item.
    /// 
    boxapi: option<string>
  }
  get-web-links-id: func(params: get-web-links-id-params) -> result<web-link, string>;

  /// Update web link
  record put-web-links-id-params {
    /// The ID of the web link.
    web-link-id: string,
    /// A new description of the web link.
    description: option<string>,
    /// A new name for the web link. Defaults to the URL if not set.
    name: option<string>,
    parent: option<put-web-links-id-body-parent>,
    /// The settings for the shared link to update.
    shared-link: option<put-web-links-id-body-shared-link>,
    /// The new URL that the web link links to. Must start with
    /// `"http://"` or `"https://"`.
    url: option<string>
  }
  put-web-links-id: func(params: put-web-links-id-params) -> result<web-link, string>;

  /// Remove web link
  record delete-web-links-id-params {
    /// The ID of the web link.
    web-link-id: string
  }
  delete-web-links-id: func(params: delete-web-links-id-params) -> result<string, string>;

}

interface trashed-web-links {
  enum trash-web-link-restored-item-status-enum {
    active,
    trashed,
    deleted,
  }

  enum trash-web-link-restored-type-op-enum {
    web-link,
  }

  enum trash-web-link-path-collection-entries-item-type-op-enum {
    folder,
  }

  record post-web-links-id-body-parent {
    /// The ID of parent item
    id: option<string>
  }

  /// Represents a web link restored from the trash.
  record trash-web-link-restored {
    /// When this file was created on Box’s servers.
    created-at: option<string>,
    created-by: option<trash-web-link-restored-created-by>,
    /// The description accompanying the web link. This is
    /// visible within the Box web application.
    description: option<string>,
    /// The entity tag of this web link. Used with `If-Match`
    /// headers.
    etag: option<string>,
    /// The unique identifier for this web link
    id: option<string>,
    /// Whether this item is deleted or not. Values include `active`,
    /// `trashed` if the file has been moved to the trash, and `deleted` if
    item-status: option<trash-web-link-restored-item-status-enum>,
    /// When this file was last updated on the Box
    /// servers.
    modified-at: option<string>,
    modified-by: option<trash-web-link-restored-modified-by>,
    /// The name of the web link
    name: option<string>,
    owned-by: option<trash-web-link-restored-owned-by>,
    parent: option<trash-web-link-restored-parent>,
    path-collection: trash-web-link-restored-path-collection,
    /// The time at which this bookmark will be permanently
    /// deleted - becomes `null` after restore.
    purged-at: option<string>,
    sequence-id: trash-web-link-restored-sequence-id,
    /// The shared link for this bookmark. This will
    /// be `null` if a bookmark had been trashed, even though the original shared
    shared-link: option<string>,
    /// The time at which this bookmark was put in the
    /// trash - becomes `null` after restore.
    trashed-at: option<string>,
    /// `web_link`
    type-op: option<trash-web-link-restored-type-op-enum>,
    /// The URL this web link points to
    url: option<string>
  }

  record trash-web-link-restored-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-restored-modified-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-restored-owned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-restored-parent {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-restored-path-collection {
    /// The parent folders for this item
    entries: list<folder-mini>,
    /// The number of folders in this list.
    total-count: s64
  }

  /// A mini representation of a file version, used when
  /// nested under another resource.
  record folder-mini {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-restored-sequence-id {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents a trashed web link.
  record trash-web-link {
    /// When this file was created on Box’s servers.
    created-at: option<string>,
    created-by: option<trash-web-link-created-by>,
    /// The description accompanying the web link. This is
    /// visible within the Box web application.
    description: option<string>,
    /// The entity tag of this web link. Used with `If-Match`
    /// headers.
    etag: option<string>,
    /// The unique identifier for this web link
    id: option<string>,
    /// Whether this item is deleted or not. Values include `active`,
    /// `trashed` if the file has been moved to the trash, and `deleted` if
    item-status: option<trash-web-link-restored-item-status-enum>,
    /// When this file was last updated on the Box
    /// servers.
    modified-at: option<string>,
    modified-by: option<trash-web-link-modified-by>,
    /// The name of the web link
    name: option<string>,
    owned-by: option<trash-web-link-owned-by>,
    parent: option<trash-web-link-parent>,
    path-collection: option<trash-web-link-path-collection>,
    /// When this file will be permanently deleted.
    purged-at: option<string>,
    sequence-id: option<trash-web-link-sequence-id>,
    /// The shared link for this bookmark. This will
    /// be `null` if a bookmark has been trashed, since the link will no longer
    shared-link: option<string>,
    /// When this file was last moved to the trash.
    trashed-at: option<string>,
    /// `web_link`
    type-op: option<trash-web-link-restored-type-op-enum>,
    /// The URL this web link points to
    url: option<string>
  }

  record trash-web-link-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-modified-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-owned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-parent {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-web-link-path-collection {
    /// Array of folders for this item's path collection
    entries: list<trash-web-link-path-collection-entries-item>,
    /// The number of folders in this list.
    total-count: s64
  }

  /// The parent folder for this item
  record trash-web-link-path-collection-entries-item {
    /// This field is null for the Trash folder
    etag: option<string>,
    /// The unique identifier that represent a folder.
    id: option<string>,
    /// The name of the Trash folder.
    name: option<string>,
    /// This field is null for the Trash folder
    sequence-id: option<string>,
    /// `folder`
    type-op: option<trash-web-link-path-collection-entries-item-type-op-enum>
  }

  record trash-web-link-sequence-id {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-web-links-id-error {
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-web-links-id-trash-error {
    not-found(string),
    other(string)
  }

  variant delete-web-links-id-trash-error {
    not-found(string),
    other(string)
  }

  /// Restore web link
  record post-web-links-id-params {
    /// The ID of the web link.
    web-link-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional new name for the web link.
    name: option<string>,
    parent: option<post-web-links-id-body-parent>
  }
  post-web-links-id: func(params: post-web-links-id-params) -> result<trash-web-link-restored, post-web-links-id-error>;

  /// Get trashed web link
  record get-web-links-id-trash-params {
    /// The ID of the web link.
    web-link-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-web-links-id-trash: func(params: get-web-links-id-trash-params) -> result<trash-web-link, get-web-links-id-trash-error>;

  /// Permanently remove web link
  record delete-web-links-id-trash-params {
    /// The ID of the web link.
    web-link-id: string
  }
  delete-web-links-id-trash: func(params: delete-web-links-id-trash-params) -> result<string, delete-web-links-id-trash-error>;

}

interface webhooks {
  enum post-webhooks-body-target-type-op-enum {
    file,
    folder,
  }

  enum post-webhooks-body-triggers-item-enum {
    file-uploaded,
    file-previewed,
    file-downloaded,
    file-trashed,
    file-deleted,
    file-restored,
    file-copied,
    file-moved,
    file-locked,
    file-unlocked,
    file-renamed,
    comment-created,
    comment-updated,
    comment-deleted,
    task-assignment-created,
    task-assignment-updated,
    metadata-instance-created,
    metadata-instance-updated,
    metadata-instance-deleted,
    folder-created,
    folder-renamed,
    folder-downloaded,
    folder-restored,
    folder-deleted,
    folder-copied,
    folder-moved,
    folder-trashed,
    webhook-deleted,
    collaboration-created,
    collaboration-accepted,
    collaboration-rejected,
    collaboration-removed,
    collaboration-updated,
    shared-link-deleted,
    shared-link-created,
    shared-link-updated,
    sign-request-completed,
    sign-request-declined,
    sign-request-expired,
  }

  /// A list of webhooks.
  record webhooks {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The item that will trigger the webhook
  record post-webhooks-body-target {
    /// The ID of the item to trigger a webhook
    id: option<string>,
    /// The type of item to trigger a webhook
    type-op: option<post-webhooks-body-target-type-op-enum>
  }

  /// Represents a configured webhook.
  record webhook {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The item that will trigger the webhook
  record put-webhooks-id-body-target {
    /// The ID of the item to trigger a webhook
    id: option<string>,
    /// The type of item to trigger a webhook
    type-op: option<post-webhooks-body-target-type-op-enum>
  }

  variant get-webhooks-error {
    forbidden(string),
    other(string)
  }

  variant post-webhooks-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-webhooks-id-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  variant put-webhooks-id-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant delete-webhooks-id-error {
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// List all webhooks
  record get-webhooks-params {
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-webhooks: func(params: get-webhooks-params) -> result<webhooks, get-webhooks-error>;

  /// Create webhook
  record post-webhooks-params {
    /// The URL that is notified by this webhook
    address: string,
    /// The item that will trigger the webhook
    target: post-webhooks-body-target,
    /// An array of event names that this webhook is
    /// to be triggered for
    triggers: list<post-webhooks-body-triggers-item-enum>
  }
  post-webhooks: func(params: post-webhooks-params) -> result<webhook, post-webhooks-error>;

  /// Get webhook
  record get-webhooks-id-params {
    /// The ID of the webhook.
    webhook-id: string
  }
  get-webhooks-id: func(params: get-webhooks-id-params) -> result<webhook, get-webhooks-id-error>;

  /// Update webhook
  record put-webhooks-id-params {
    /// The ID of the webhook.
    webhook-id: string,
    /// The URL that is notified by this webhook
    address: option<string>,
    /// The item that will trigger the webhook
    target: option<put-webhooks-id-body-target>,
    /// An array of event names that this webhook is
    /// to be triggered for
    triggers: option<list<post-webhooks-body-triggers-item-enum>>
  }
  put-webhooks-id: func(params: put-webhooks-id-params) -> result<webhook, put-webhooks-id-error>;

  /// Remove webhook
  record delete-webhooks-id-params {
    /// The ID of the webhook.
    webhook-id: string
  }
  delete-webhooks-id: func(params: delete-webhooks-id-params) -> result<string, delete-webhooks-id-error>;

}

interface workflows {
  enum post-workflows-id-start-body-files-item-type-op-enum {
    file,
  }

  enum post-workflows-id-start-body-folder-type-op-enum {
    folder,
  }

  enum post-workflows-id-start-body-outcomes-item-type-op-enum {
    outcome,
  }

  enum post-workflows-id-start-body-type-op-enum {
    workflow-parameters,
  }

  /// A list of workflows.
  /// 
  /// You application must be authorized to use the `Manage Box Relay` application
  /// scope within the developer console in order to use this resource.
  record workflows {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A file the workflow should start for
  record post-workflows-id-start-body-files-item {
    /// The id of the file
    id: option<string>,
    /// The type of the file object
    type-op: option<post-workflows-id-start-body-files-item-type-op-enum>
  }

  /// The flow that will be triggered
  record post-workflows-id-start-body-flow {
    /// The id of the flow
    id: option<string>,
    /// The type of the flow object
    type-op: option<string>
  }

  /// The folder object for which the workflow is configured.
  record post-workflows-id-start-body-folder {
    /// The id of the folder
    id: option<string>,
    /// The type of the folder object
    type-op: option<post-workflows-id-start-body-folder-type-op-enum>
  }

  /// A configurable outcome the workflow should complete. If you
  /// have a `task_completion_rule`, you may input `all_assignees` or
  /// `any_assignee` in the `variable_value` field. Similarly, if you
  /// have a `collaborator_role`, you may input `editor`, `viewer`,
  /// `previewer`, `uploader`, `previewer uploader`, `viewer uploader`
  /// , `co-owner` in the `variable_value` field.
  record post-workflows-id-start-body-outcomes-item {
    /// The id of the outcome
    id: option<string>,
    /// This is a placeholder example for various objects that
    /// can be passed in - refer to the guides section to find
    parameter: option<string>,
    /// The type of the outcome object
    type-op: option<post-workflows-id-start-body-outcomes-item-type-op-enum>
  }

  variant get-workflows-error {
    bad-request(string),
    not-found(string),
    other(string)
  }

  variant post-workflows-id-start-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// List workflows
  record get-workflows-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// Type of trigger to search for.
    trigger-type: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>
  }
  get-workflows: func(params: get-workflows-params) -> result<workflows, get-workflows-error>;

  /// Starts workflow based on request body
  record post-workflows-id-start-params {
    /// The ID of the workflow.
    workflow-id: string,
    /// The array of files for which the workflow should start. All files
    /// must be in the workflow's configured folder.
    files: list<post-workflows-id-start-body-files-item>,
    /// The flow that will be triggered
    flow: post-workflows-id-start-body-flow,
    /// The folder object for which the workflow is configured.
    folder: post-workflows-id-start-body-folder,
    /// A list of outcomes required to be configured at start time.
    outcomes: option<list<post-workflows-id-start-body-outcomes-item>>,
    /// The type of the parameters object
    type-op: option<post-workflows-id-start-body-type-op-enum>
  }
  post-workflows-id-start: func(params: post-workflows-id-start-params) -> result<string, post-workflows-id-start-error>;

}

interface zip-downloads {
  enum zip-download-request-items-item-type-op-enum {
    file,
    folder,
  }

  enum zip-download-status-state-enum {
    in-progress,
    failed,
    success,
  }

  /// An item to add to the `zip` archive. This can be a file or a folder.
  record zip-download-request-items-item {
    /// The identifier of the item to add to the archive. When this item is
    /// a folder then this can not be the root folder with ID `0`.
    id: string,
    /// The type of the item to add to the archive.
    type-op: zip-download-request-items-item-type-op-enum
  }

  /// Represents a successful request to create a `zip` archive of a list of files
  /// and folders.
  record zip-download {
    /// The URL that can be used to download the `zip` archive. A `Get` request to
    /// this URL will start streaming the items requested. By default, this URL
    download-url: option<string>,
    /// The time and date when this archive will expire. After this time the
    /// `status_url` and `download_url` will return an error.
    expires-at: option<string>,
    /// A list of conflicts that occurred when trying to create the archive. This
    /// would occur when multiple items have been requested with the
    name-conflicts: option<list<list<zip-download-name-conflicts-item-item>>>,
    /// The URL that can be used to get the status of the `zip` archive being
    /// downloaded. A `Get` request to this URL will return the number of files
    status-url: option<string>
  }

  /// A file or folder for which a conflict was encountered, This object provides the type and identifier of the original item, as well as a mapping between its original name and it's new name as it will appear in the archive.
  record zip-download-name-conflicts-item-item {
    /// The new name of this item as it will appear in the
    /// downloaded `zip` archive.
    download-name: option<string>,
    /// The identifier of the item
    id: option<string>,
    /// The original name of this item
    original-name: option<string>,
    /// The type of this item
    type-op: option<zip-download-request-items-item-type-op-enum>
  }

  /// The status of a `zip` archive being downloaded.
  record zip-download-status {
    /// The number of files that have already been downloaded.
    downloaded-file-count: option<s32>,
    /// The number of files that have been skipped as they could not be
    /// downloaded. In many cases this is due to permission issues that have
    skipped-file-count: option<s32>,
    /// The number of folders that have been skipped as they could not be
    /// downloaded. In many cases this is due to permission issues that have
    skipped-folder-count: option<s32>,
    /// The state of the archive being downloaded.
    state: option<zip-download-status-state-enum>,
    /// The total number of files in the archive.
    total-file-count: option<s32>
  }

  variant post-zip-downloads-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    other(string)
  }

  variant get-zip-downloads-id-content-error {
    not-found(string),
    too-many-requests(string),
    other(string)
  }

  variant get-zip-downloads-id-status-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Create zip download
  record post-zip-downloads-params {
    /// The optional name of the `zip` archive. This name will be appended by the
    /// `.zip` file extension, for example `January Financials.zip`.
    download-file-name: option<string>,
    /// A list of items to add to the `zip` archive. These can
    /// be folders or files.
    items: list<zip-download-request-items-item>
  }
  post-zip-downloads: func(params: post-zip-downloads-params) -> result<zip-download, post-zip-downloads-error>;

  /// Download zip archive
  record get-zip-downloads-id-content-params {
    /// The unique identifier that represent this `zip` archive.
    zip-download-id: string
  }
  get-zip-downloads-id-content: func(params: get-zip-downloads-id-content-params) -> result<string, get-zip-downloads-id-content-error>;

  /// Get zip download status
  record get-zip-downloads-id-status-params {
    /// The unique identifier that represent this `zip` archive.
    zip-download-id: string
  }
  get-zip-downloads-id-status: func(params: get-zip-downloads-id-status-params) -> result<zip-download-status, get-zip-downloads-id-status-error>;

}
/// The component world: imports the secrets host capability
