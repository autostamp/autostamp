    remove-retention,
  }

  /// List file version retentions
  record get-file-version-retentions-params {
    /// Filters results by files with this ID.
    file-id: option<string>,
    /// Filters results by file versions with this ID.
    file-version-id: option<string>,
    /// Filters results by the retention policy with this ID.
    policy-id: option<string>,
    /// Filters results by the retention policy with this disposition
    /// action.
    disposition-action: option<get-file-version-retentions-disposition-action-enum>,
    /// Filters results by files that will have their disposition
    /// come into effect before this date.
    disposition-before: option<string>,
    /// Filters results by files that will have their disposition
    /// come into effect after this date.
    disposition-after: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>
  }
  get-file-version-retentions: func(params: get-file-version-retentions-params) -> result<string, string>;

  /// Get retention on file
  record get-file-version-retentions-id-params {
    /// The ID of the file version retention
    file-version-retention-id: string
  }
  get-file-version-retentions-id: func(params: get-file-version-retentions-id-params) -> result<string, string>;

}

interface uploads {
  /// Upload file
  record post-files-content-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional header containing the SHA1 hash of the file to
    /// ensure that the file was not corrupted in transit.
    content-md5: option<string>
  }
  post-files-content: func(params: post-files-content-params) -> result<string, string>;

  /// Upload file version
  record post-files-id-content-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// Ensures this item hasn't recently changed before
    /// making changes.
    if-match: option<string>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional header containing the SHA1 hash of the file to
    /// ensure that the file was not corrupted in transit.
    content-md5: option<string>
  }
