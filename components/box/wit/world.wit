/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `OAuth2Security` | `Authorization: Bearer <secret>` |
package autostamp:box-api@0.5.0;

interface authorization {
  enum get-authorize-response-type-enum {
    code,
  }

  enum post-o-auth2-token-actor-token-type-enum {
    urn-ietf-params-oauth-token-type-id-token,
  }

  enum post-o-auth2-token-box-subject-type-enum {
    enterprise,
    user,
  }

  enum post-o-auth2-token-grant-type-enum {
    authorization-code,
    refresh-token,
    client-credentials,
    urn-ietf-params-oauth-grant-type-jwt-bearer,
    urn-ietf-params-oauth-grant-type-token-exchange,
  }

  enum post-o-auth2-token-subject-token-type-enum {
    urn-ietf-params-oauth-token-type-access-token,
  }

  enum file-scope-scope-enum {
    annotation-edit,
    annotation-view-all,
    annotation-view-self,
    base-explorer,
    base-picker,
    base-preview,
    base-upload,
    item-delete,
    item-download,
    item-preview,
    item-rename,
    item-share,
  }

  enum access-token-token-type-enum {
    bearer,
  }

  enum post-o-auth2-token-refresh-access-token-grant-type-enum {
    refresh-token,
  }

  /// A token that can be used to make authenticated API calls.
  record access-token {
    /// The requested access token.
    access-token: option<string>,
    /// The time in seconds in seconds by which this token will expire.
    expires-in: option<s64>,
    /// The type of downscoped access token returned. This is only
    /// returned if an access token has been downscoped.
    issued-token-type: option<post-o-auth2-token-subject-token-type-enum>,
    /// The refresh token for this access token, which can be used
    /// to request a new access token when the current one expires.
    refresh-token: option<string>,
    /// The permissions that this access token permits,
    /// providing a list of resources (files, folders, etc)
    restricted-to: option<list<file-scope>>,
    /// The type of access token returned.
    token-type: option<access-token-token-type-enum>
  }

  /// A relation between a file and the scopes for which the file can be accessed
  record file-scope {
    object: option<file-scope-object>,
    /// The file scopes for the file access
    scope: option<file-scope-scope-enum>
  }

  record file-scope-object {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-oauth2-revoke-error {
    bad-request(string),
    other(string)
  }

  variant post-oauth2-token-error {
    bad-request(string),
    other(string)
  }

  variant refresh-error {
    bad-request(string),
    other(string)
  }

  /// Authorize user
  record get-authorize-params {
    /// The type of response we'd like to receive.
    response-type: get-authorize-response-type-enum,
    /// The Client ID of the application that is requesting to authenticate
    /// the user. To get the Client ID for your application, log in to your
    client-id: string,
    /// The URI to which Box redirects the browser after the user has granted
    /// or denied the application permission. This URI match one of the redirect
    redirect-uri: option<string>,
    /// A custom string of your choice. Box will pass the same string to
    /// the redirect URL when authentication is complete. This parameter
    state: option<string>,
    /// A comma-separated list of application scopes you'd like to
    /// authenticate the user for. This defaults to all the scopes configured
    scope: option<string>
  }
  get-authorize: func(params: get-authorize-params) -> result<string, string>;

  /// Revoke access token
  record post-oauth2-revoke-params {
    /// The Client ID of the application requesting to revoke the
    /// access token.
    client-id: option<string>,
    /// The client secret of the application requesting to revoke
    /// an access token.
    client-secret: option<string>,
    /// The access token to revoke.
    token: option<string>
  }
  post-oauth2-revoke: func(params: post-oauth2-revoke-params) -> result<string, post-oauth2-revoke-error>;

  /// Request access token
  record post-oauth2-token-params {
    /// The token used to create an annotator token.
    /// This is a JWT assertion.
    actor-token: option<string>,
    /// The type of `actor_token` passed in.
    /// 
    actor-token-type: option<post-o-auth2-token-actor-token-type-enum>,
    /// A JWT assertion for which to request a new access token.
    /// 
    assertion: option<string>,
    /// Full URL of the shared link on the file or folder
    /// that the token should be generated for.
    box-shared-link: option<string>,
    /// Used in combination with `client_credentials` as the `grant_type`.
    /// Value is determined by `box_subject_type`. If `user` use user ID and if
    box-subject-id: option<string>,
    /// Used in combination with `client_credentials` as the `grant_type`.
    box-subject-type: option<post-o-auth2-token-box-subject-type-enum>,
    /// The Client ID of the application requesting an access token.
    /// 
    client-id: option<string>,
    /// The client secret of the application requesting an access token.
    /// 
    client-secret: option<string>,
    /// The client-side authorization code passed to your application by
    /// Box in the browser redirect after the user has successfully
    code: option<string>,
    /// The type of request being made, either using a client-side obtained
    /// authorization code, a refresh token, a JWT assertion, client credentials
    grant-type: post-o-auth2-token-grant-type-enum,
    /// A refresh token used to get a new access token with.
    /// 
    refresh-token: option<string>,
    /// Full URL for the file that the token should be generated for.
    resource-op: option<string>,
    /// The space-delimited list of scopes that you want apply to the
    /// new access token.
    scope: option<string>,
    /// The token to exchange for a downscoped token. This can be a regular
    /// access token, a JWT assertion, or an app token.
    subject-token: option<string>,
    /// The type of `subject_token` passed in.
    /// 
    subject-token-type: option<post-o-auth2-token-subject-token-type-enum>
  }
  post-oauth2-token: func(params: post-oauth2-token-params) -> result<access-token, post-oauth2-token-error>;

  /// Refresh access token
  record refresh-params {
    /// The client ID of the application requesting to refresh the token.
    client-id: string,
    /// The client secret of the application requesting to refresh the token.
    client-secret: string,
    /// The type of request being made, in this case a refresh request.
    grant-type: post-o-auth2-token-refresh-access-token-grant-type-enum,
    /// The refresh token to refresh.
    refresh-token: string
  }
  refresh: func(params: refresh-params) -> result<access-token, refresh-error>;

}


interface domain-restrictions-for-collaborations {
  enum post-collaboration-whitelist-entries-body-direction-enum {
    inbound,
    outbound,
    both,
  }

  enum collaboration-allowlist-entry-enterprise-type-op-enum {
    enterprise,
  }

  enum collaboration-allowlist-entry-type-op-enum {
    collaboration-whitelist-entry,
  }

  /// A list of allowed domains for collaboration.
  record collaboration-allowlist-entries {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// An entry that describes an approved domain for which users can collaborate
  /// with files and folders in your enterprise or vice versa.
  record collaboration-allowlist-entry {
    /// The time the entry was created at
    created-at: option<string>,
    /// The direction of the collaborations to allow.
    direction: option<post-collaboration-whitelist-entries-body-direction-enum>,
    /// The whitelisted domain
    domain: option<string>,
    enterprise: option<collaboration-allowlist-entry-enterprise>,
    /// The unique identifier for this entry
    id: option<string>,
    /// `collaboration_whitelist_entry`
    type-op: option<collaboration-allowlist-entry-type-op-enum>
  }

  record collaboration-allowlist-entry-enterprise {
    /// The unique identifier for this enterprise.
    id: option<string>,
    /// The name of the enterprise
    name: option<string>,
    /// `enterprise`
    type-op: option<collaboration-allowlist-entry-enterprise-type-op-enum>
  }

  /// List allowed collaboration domains
  record get-collaboration-whitelist-entries-params {
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-collaboration-whitelist-entries: func(params: get-collaboration-whitelist-entries-params) -> result<collaboration-allowlist-entries, string>;

  /// Add domain to list of allowed collaboration domains
  record post-collaboration-whitelist-entries-params {
    /// The direction in which to allow collaborations.
    direction: post-collaboration-whitelist-entries-body-direction-enum,
    /// The domain to add to the list of allowed domains.
    domain: string
  }
  post-collaboration-whitelist-entries: func(params: post-collaboration-whitelist-entries-params) -> result<collaboration-allowlist-entry, string>;

  /// Get allowed collaboration domain
  record get-collaboration-whitelist-entries-id-params {
    /// The ID of the entry in the list.
    collaboration-whitelist-entry-id: string
  }
  get-collaboration-whitelist-entries-id: func(params: get-collaboration-whitelist-entries-id-params) -> result<collaboration-allowlist-entry, string>;

  /// Remove domain from list of allowed collaboration domains
  record delete-collaboration-whitelist-entries-id-params {
    /// The ID of the entry in the list.
    collaboration-whitelist-entry-id: string
  }
  delete-collaboration-whitelist-entries-id: func(params: delete-collaboration-whitelist-entries-id-params) -> result<string, string>;

}

interface domain-restrictions-user-exemptions {
  enum collaboration-allowlist-exempt-target-enterprise-type-op-enum {
    enterprise,
  }

  enum collaboration-allowlist-exempt-target-type-op-enum {
    collaboration-whitelist,
  }

  /// A list of users that is exempt from any of the restrictions
  /// imposed by the list of allowed collaboration domains for this enterprise.
  record collaboration-allowlist-exempt-targets {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The user to exempt.
  record post-collaboration-whitelist-exempt-targets-body-user {
    /// The ID of the user to exempt.
    id: string
  }

  /// The user that is exempt from any of the restrictions
  /// imposed by the list of allowed collaboration domains for this enterprise.
  record collaboration-allowlist-exempt-target {
    /// The time the entry was created
    created-at: option<string>,
    enterprise: option<collaboration-allowlist-exempt-target-enterprise>,
    /// The unique identifier for this exemption
    id: option<string>,
    /// The time the entry was modified
    modified-at: option<string>,
    /// `collaboration_whitelist`
    type-op: option<collaboration-allowlist-exempt-target-type-op-enum>,
    user: option<collaboration-allowlist-exempt-target-user>
  }

  record collaboration-allowlist-exempt-target-enterprise {
    /// The unique identifier for this enterprise.
    id: option<string>,
    /// The name of the enterprise
    name: option<string>,
    /// `enterprise`
    type-op: option<collaboration-allowlist-exempt-target-enterprise-type-op-enum>
  }

  record collaboration-allowlist-exempt-target-user {
    /// The unique identifier for this enterprise.
    id: option<string>,
    /// The name of the enterprise
    name: option<string>,
    /// `enterprise`
    type-op: option<collaboration-allowlist-exempt-target-enterprise-type-op-enum>
  }

  /// List users exempt from collaboration domain restrictions
  record get-collaboration-whitelist-exempt-targets-params {
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-collaboration-whitelist-exempt-targets: func(params: get-collaboration-whitelist-exempt-targets-params) -> result<collaboration-allowlist-exempt-targets, string>;

  /// Create user exemption from collaboration domain restrictions
  record post-collaboration-whitelist-exempt-targets-params {
    /// The user to exempt.
    user: post-collaboration-whitelist-exempt-targets-body-user
  }
  post-collaboration-whitelist-exempt-targets: func(params: post-collaboration-whitelist-exempt-targets-params) -> result<collaboration-allowlist-exempt-target, string>;

  /// Get user exempt from collaboration domain restrictions
  record get-collaboration-whitelist-exempt-targets-id-params {
    /// The ID of the exemption to the list.
    collaboration-whitelist-exempt-target-id: string
  }
  get-collaboration-whitelist-exempt-targets-id: func(params: get-collaboration-whitelist-exempt-targets-id-params) -> result<collaboration-allowlist-exempt-target, string>;

  /// Remove user from list of users exempt from domain restrictions
  record delete-collaboration-whitelist-exempt-targets-id-params {
    /// The ID of the exemption to the list.
    collaboration-whitelist-exempt-target-id: string
  }
  delete-collaboration-whitelist-exempt-targets-id: func(params: delete-collaboration-whitelist-exempt-targets-id-params) -> result<string, string>;

}

interface collaborations-list {
  enum get-collaborations-status-enum {
    pending,
  }

  /// A list of collaborations
  record collaborations {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List pending collaborations
  record get-collaborations-params {
    /// The status of the collaborations to retrieve
    status: get-collaborations-status-enum,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-collaborations: func(params: get-collaborations-params) -> result<collaborations, string>;

  /// List file collaborations
  record get-files-id-collaborations-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// Defines the position marker at which to begin returning results. This is
    /// used when paginating using marker-based pagination.
    marker: option<string>
  }
  get-files-id-collaborations: func(params: get-files-id-collaborations-params) -> result<collaborations, string>;

  /// List folder collaborations
  record get-folders-id-collaborations-params {
    /// The unique identifier that represent a folder.
    /// 
    folder-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-folders-id-collaborations: func(params: get-folders-id-collaborations-params) -> result<collaborations, string>;

  /// List group collaborations
  record get-groups-id-collaborations-params {
    /// The ID of the group.
    group-id: string,
    /// The maximum number of items to return per page.
    limit: option<s64>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>
  }
  get-groups-id-collaborations: func(params: get-groups-id-collaborations-params) -> result<collaborations, string>;

}

interface collaborations {
  enum post-collaborations-body-accessible-by-type-op-enum {
    user,
    group,
  }

  enum post-collaborations-body-item-type-op-enum {
    file,
    folder,
  }

  enum post-collaborations-body-role-enum {
    editor,
    viewer,
    previewer,
    uploader,
    previewer-uploader,
    viewer-uploader,
    co-owner,
  }

  enum collaboration-acceptance-requirements-status-terms-of-service-requirement-terms-of-service-type-op-enum {
    terms-of-service,
  }

  enum collaboration-role-enum {
    editor,
    viewer,
    previewer,
    uploader,
    previewer-uploader,
    viewer-uploader,
    co-owner,
    owner,
  }

  enum collaboration-status-enum {
    accepted,
    pending,
    rejected,
  }

  enum collaboration-type-op-enum {
    collaboration,
  }

  enum put-collaborations-id-body-status-enum {
    pending,
    accepted,
    rejected,
  }

  /// The user or group to give access to the item.
  record post-collaborations-body-accessible-by {
    /// The ID of the user or group.
    /// 
    id: option<string>,
    /// The email address of the user to grant access to the item.
    /// 
    login: option<string>,
    /// The type of collaborator to invite.
    type-op: post-collaborations-body-accessible-by-type-op-enum
  }

  /// The item to attach the comment to.
  record post-collaborations-body-item {
    /// The ID of the item that will be granted access to
    id: string,
    /// The type of the item that this collaboration will be
    /// granted access to
    type-op: post-collaborations-body-item-type-op-enum
  }

  /// Collaborations define access permissions for users and groups to files and
  /// folders, similar to access control lists. A collaboration object grants a
  /// user or group access to a file or folder with permissions defined by a
  /// specific role.
  record collaboration {
    acceptance-requirements-status: option<collaboration-acceptance-requirements-status>,
    accessible-by: option<collaboration-accessible-by>,
    /// When the `status` of the collaboration object changed to
    /// `accepted` or `rejected`.
    acknowledged-at: option<string>,
    /// When the collaboration object was created.
    created-at: option<string>,
    created-by: option<collaboration-created-by>,
    /// When the collaboration will expire, or `null` if no expiration
    /// date is set.
    expires-at: option<string>,
    /// The unique identifier for this collaboration.
    id: option<string>,
    /// The email address used to invite an unregistered collaborator, if
    /// they are not a registered user.
    invite-email: option<string>,
    item: option<collaboration-item>,
    /// When the collaboration object was last modified.
    modified-at: option<string>,
    /// The level of access granted.
    role: option<collaboration-role-enum>,
    /// The status of the collaboration invitation. If the status
    /// is `pending`, `login` and `name` return an empty string.
    status: option<collaboration-status-enum>,
    /// `collaboration`
    type-op: option<collaboration-type-op-enum>
  }

  record collaboration-acceptance-requirements-status {
    strong-password-requirement: option<collaboration-acceptance-requirements-status-strong-password-requirement>,
    terms-of-service-requirement: option<collaboration-acceptance-requirements-status-terms-of-service-requirement>,
    two-factor-authentication-requirement: option<collaboration-acceptance-requirements-status-two-factor-authentication-requirement>
  }

  record collaboration-acceptance-requirements-status-strong-password-requirement {
    /// Whether or not the enterprise that owns the content requires
    /// a strong password to collaborate on the content.
    enterprise-has-strong-password-required-for-external-users: option<bool>,
    /// Whether or not the user has a strong password set for their
    /// account. The field is `null` when a strong password is not
    user-has-strong-password: option<bool>
  }

  record collaboration-acceptance-requirements-status-terms-of-service-requirement {
    /// Whether or not the terms of service have been accepted.  The
    /// field is `null` when there is no terms of service required.
    is-accepted: option<bool>,
    terms-of-service: option<collaboration-acceptance-requirements-status-terms-of-service-requirement-terms-of-service>
  }

  record collaboration-acceptance-requirements-status-terms-of-service-requirement-terms-of-service {
    /// The unique identifier for this terms of service.
    id: option<string>,
    /// `terms_of_service`
    type-op: option<collaboration-acceptance-requirements-status-terms-of-service-requirement-terms-of-service-type-op-enum>
  }

  record collaboration-acceptance-requirements-status-two-factor-authentication-requirement {
    /// Whether or not the enterprise that owns the content requires
    /// two-factor authentication to be enabled in order to
    enterprise-has-two-factor-auth-enabled: option<bool>,
    /// Whether or not the user has two-factor authentication
    /// enabled. The field is `null` when two-factor
    user-has-two-factor-authentication-enabled: option<bool>
  }

  record collaboration-accessible-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record collaboration-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record collaboration-item {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-collaborations-error {
    forbidden(string),
    other(string)
  }

  variant put-collaborations-id-error {
    forbidden(string),
    other(string)
  }

  /// Create collaboration
  record post-collaborations-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Determines if users should receive email notification
    /// for the action performed.
    notify: option<bool>,
    /// The user or group to give access to the item.
    accessible-by: post-collaborations-body-accessible-by,
    /// Determines if the invited users can see the entire parent path to
    /// the associated folder. The user will not gain privileges in any
    can-view-path: option<bool>,
    /// Set the expiration date for the collaboration. At this date, the
    /// collaboration will be automatically removed from the item.
    expires-at: option<string>,
    /// The item to attach the comment to.
    item: post-collaborations-body-item,
    /// The level of access granted.
    role: post-collaborations-body-role-enum
  }
  post-collaborations: func(params: post-collaborations-params) -> result<collaboration, post-collaborations-error>;

  /// Get collaboration
  record get-collaborations-id-params {
    /// The ID of the collaboration
    collaboration-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-collaborations-id: func(params: get-collaborations-id-params) -> result<collaboration, string>;

  /// Update collaboration
  record put-collaborations-id-params {
    /// The ID of the collaboration
    collaboration-id: string,
    /// Determines if the invited users can see the entire parent path to
    /// the associated folder. The user will not gain privileges in any
    can-view-path: option<bool>,
    /// Update the expiration date for the collaboration. At this date,
    /// the collaboration will be automatically removed from the item.
    expires-at: option<string>,
    /// The level of access granted.
    role: collaboration-role-enum,
    /// <!--alex ignore reject-->
    /// Set the status of a `pending` collaboration invitation,
    status: option<put-collaborations-id-body-status-enum>
  }
  put-collaborations-id: func(params: put-collaborations-id-params) -> result<collaboration, put-collaborations-id-error>;

  /// Remove collaboration
  record delete-collaborations-id-params {
    /// The ID of the collaboration
    collaboration-id: string
  }
  delete-collaborations-id: func(params: delete-collaborations-id-params) -> result<string, string>;

}

interface collections {
  /// A list of collections
  record collections {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A list of files, folders, and web links in
  /// their mini representation.
  record items {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// List all collections
  record get-collections-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-collections: func(params: get-collections-params) -> result<collections, string>;

  /// List collection items
  record get-collections-id-items-params {
    /// The ID of the collection.
    collection-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-collections-id-items: func(params: get-collections-id-items-params) -> result<items, string>;

}

interface comments {
  enum post-comments-body-item-type-op-enum {
    file,
    comment,
  }

  /// The item to attach the comment to.
  record post-comments-body-item {
    /// The ID of the item
    id: string,
    /// The type of the item that this comment will be placed on.
    type-op: post-comments-body-item-type-op-enum
  }

  /// Standard representation of a comment.
  record comment {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Comments are messages created on files. Comments
  /// can be made independently or created as responses to other
  /// comments
  record comment-full {
    /// JSON-encoded free-form object payload
    data: option<string>
