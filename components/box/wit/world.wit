    /// The id of the parent folder. Use
    /// `0` for the user's root folder.
    id: string
  }

  /// A list of files
  record files {
    /// A list of files
    entries: option<list<file>>,
    /// The number of files.
    total-count: option<s64>
  }

  /// A standard representation of a file, as returned from any
  /// file API endpoints by default
  record file {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The additional attributes of the file being uploaded. Mainly the
  /// name and the parent folder. These attributes are part of the multi
  /// part request body and are in JSON format.
  /// 
  /// <Message warning>
  /// 
  ///   The `attributes` part of the body must come **before** the
  ///   `file` part. Requests that do not follow this format when
  ///   uploading the file will receive a HTTP `400` error with a
  ///   `metadata_after_file_contents` error code.
  /// 
  /// </Message>
  record post-files-id-content-body-attributes {
    /// Defines the time the file was last modified at.
    /// 
    content-modified-at: option<string>,
    /// An optional new name for the file. If specified, the file
    /// will be renamed when the new version is uploaded.
    name: string
  }

  variant post-files-content-error {
    bad-request(string),
    conflict(string),
    other(string)
  }

  variant post-files-id-content-error {
    precondition-failed(string),
    other(string)
  }

  /// Upload file
  record post-files-content-params {
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional header containing the SHA1 hash of the file to
    /// ensure that the file was not corrupted in transit.
    content-md5: option<string>,
    /// The additional attributes of the file being uploaded. Mainly the
    /// name and the parent folder. These attributes are part of the multi
    attributes: post-files-content-body-attributes,
    /// The content of the file to upload to Box.
    /// 
    file: string
  }
  post-files-content: func(params: post-files-content-params) -> result<files, post-files-content-error>;

  /// Upload file version
  record post-files-id-content-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// Ensures this item hasn't recently changed before
    /// making changes.
    if-match: option<string>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional header containing the SHA1 hash of the file to
    /// ensure that the file was not corrupted in transit.
    content-md5: option<string>,
    /// The additional attributes of the file being uploaded. Mainly the
    /// name and the parent folder. These attributes are part of the multi
    attributes: post-files-id-content-body-attributes,
    /// The content of the file to upload to Box.
    /// 
    file: string
  }
  post-files-id-content: func(params: post-files-id-content-params) -> result<files, post-files-id-content-error>;

}

interface uploads-chunked {
  enum upload-session-type-op-enum {
    upload-session,
  }

  /// An upload session for chunk uploading a file.
  record upload-session {
    /// The unique identifier for this session
    id: option<string>,
    /// The number of parts that have been uploaded and processed
    /// by the server. This starts at `0`.
    num-parts-processed: option<s32>,
    /// The  size in bytes that must be used for all parts of of the
    /// upload.
    part-size: option<s64>,
    session-endpoints: option<upload-session-session-endpoints>,
    /// The date and time when this session expires.
    session-expires-at: option<string>,
    /// The total number of parts expected in this upload session,
    /// as determined by the file size and part size.
    total-parts: option<s32>,
    /// `upload_session`
    type-op: option<upload-session-type-op-enum>
  }

  record upload-session-session-endpoints {
    /// The URL for used to abort the session.
    abort: option<string>,
    /// The URL used to commit the file
    commit: option<string>,
    /// The URL users to list all parts.
    list-parts: option<string>,
    /// The URL used to get the upload log from.
    log-event: option<string>,
    /// The URL used to get the status of the upload.
    status: option<string>,
    /// The URL to upload parts to
    upload-part: option<string>
  }

  /// A chunk of a file uploaded as part of
  /// an upload session, as returned by some endpoints.
  record uploaded-part {
    part: option<upload-part>
  }

  /// The representation of an upload
  /// session chunk.
  record upload-part {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A list of files
  record files {
    /// A list of files
    entries: option<list<file>>,
    /// The number of files.
    total-count: option<s64>
  }

  /// A standard representation of a file, as returned from any
  /// file API endpoints by default
  record file {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// A list of uploaded chunks for an upload
  /// session.
  record upload-parts {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-files-upload-sessions-error {
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant put-files-upload-sessions-id-error {
    conflict(string),
    precondition-failed(string),
    range-not-satisfiable(string),
    other(string)
  }

  variant post-files-upload-sessions-id-commit-error {
    conflict(string),
    precondition-failed(string),
    other(string)
  }

  variant post-files-id-upload-sessions-error {
    conflict(string),
    other(string)
  }

  /// Create upload session
  record post-files-upload-sessions-params {
    /// The name of new file
    file-name: string,
    /// The total number of bytes of the file to be uploaded
    file-size: s64,
    /// The ID of the folder to upload the new file to.
    folder-id: string
  }
  post-files-upload-sessions: func(params: post-files-upload-sessions-params) -> result<upload-session, post-files-upload-sessions-error>;

  /// Get upload session
  record get-files-upload-sessions-id-params {
    /// The ID of the upload session.
    upload-session-id: string
  }
  get-files-upload-sessions-id: func(params: get-files-upload-sessions-id-params) -> result<upload-session, string>;

  /// Upload part of file
  record put-files-upload-sessions-id-params {
    /// The ID of the upload session.
    upload-session-id: string,
    /// The [RFC3230][1] message digest of the chunk uploaded.
    /// 
    digest: string,
    /// The byte range of the chunk.
    /// 
    content-range: string,
    body: option<string>
  }
  put-files-upload-sessions-id: func(params: put-files-upload-sessions-id-params) -> result<uploaded-part, put-files-upload-sessions-id-error>;

  /// Remove upload session
  record delete-files-upload-sessions-id-params {
    /// The ID of the upload session.
    upload-session-id: string
  }
  delete-files-upload-sessions-id: func(params: delete-files-upload-sessions-id-params) -> result<string, string>;

  /// Commit upload session
  record post-files-upload-sessions-id-commit-params {
    /// The ID of the upload session.
    upload-session-id: string,
    /// The [RFC3230][1] message digest of the whole file.
    /// 
    digest: string,
    /// Ensures this item hasn't recently changed before
    /// making changes.
    if-match: option<string>,
    /// Ensures an item is only returned if it has changed.
    /// 
    if-none-match: option<string>,
    /// The list details for the uploaded parts
    parts: list<upload-part>
  }
  post-files-upload-sessions-id-commit: func(params: post-files-upload-sessions-id-commit-params) -> result<files, post-files-upload-sessions-id-commit-error>;

  /// List parts
  record get-files-upload-sessions-id-parts-params {
    /// The ID of the upload session.
    upload-session-id: string,
    /// The offset of the item at which to begin the response.
    /// 
    offset: option<s64>,
    /// The maximum number of items to return per page.
    limit: option<s64>
  }
  get-files-upload-sessions-id-parts: func(params: get-files-upload-sessions-id-parts-params) -> result<upload-parts, string>;

  /// Create upload session for existing file
  record post-files-id-upload-sessions-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// The optional new name of new file
    file-name: option<string>,
    /// The total number of bytes of the file to be uploaded
    file-size: s64
  }
  post-files-id-upload-sessions: func(params: post-files-id-upload-sessions-params) -> result<upload-session, post-files-id-upload-sessions-error>;

}

interface files {
  enum put-files-id-body-lock-access-enum {
    lock,
  }

  enum put-files-id-body-permissions-can-download-enum {
    open,
    company,
  }

  enum put-files-id-body-shared-link-access-enum {
    open,
    company,
    collaborators,
  }

  /// A full representation of a file, as can be returned from any
  /// file API endpoints by default
  record file-full {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Defines a lock on an item. This prevents the item from being
  /// moved, renamed, or otherwise changed by anyone other than the user
  /// who created the lock.
  /// 
  /// Set this to `null` to remove the lock.
  record put-files-id-body-lock {
    /// The type of this object.
    access: option<put-files-id-body-lock-access-enum>,
    /// Defines the time at which the lock expires.
    expires-at: option<string>,
    /// Defines if the file can be downloaded while it is locked.
    is-download-prevented: option<bool>
  }

  record put-files-id-body-parent {
    /// The ID of parent item
    id: option<string>
  }

  /// Defines who can download a file.
  record put-files-id-body-permissions {
    /// Defines who is allowed to download this file. The possible
    /// values are either `open` for everyone or `company` for
    can-download: option<put-files-id-body-permissions-can-download-enum>
  }

  record put-files-id-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<put-files-id-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    permissions: option<put-files-id-body-shared-link-permissions>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  record put-files-id-body-shared-link-permissions {
    /// If the shared link allows for downloading of files.
    /// This can only be set when `access` is set to
    can-download: option<bool>
  }

  /// The destination folder to copy the file to.
  record post-files-id-copy-body-parent {
    /// The ID of folder to copy the file to.
    id: string
  }

  variant get-files-id-error {
    not-modified(string),
    unauthorized(string),
    not-found(string),
    method-not-allowed(string),
    unsupported-media-type(string),
    other(string)
  }

  variant put-files-id-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant delete-files-id-error {
    unauthorized(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant post-files-id-copy-error {
    not-modified(string),
    bad-request(string),
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-files-id-thumbnail-id-error {
    found(string),
    bad-request(string),
    forbidden(string),
    not-found(string),
    other(string)
  }

  /// Get file information
  record get-files-id-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Ensures an item is only returned if it has changed.
    /// 
    if-none-match: option<string>,
    /// The URL, and optional password, for the shared link of this item.
    /// 
    boxapi: option<string>,
    /// A header required to request specific `representations`
    /// of a file. Use this in combination with the `fields` query
    x-rep-hints: option<string>
  }
  get-files-id: func(params: get-files-id-params) -> result<file-full, get-files-id-error>;

  /// Update file
  record put-files-id-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// Ensures this item hasn't recently changed before
    /// making changes.
    if-match: option<string>,
    /// The description for a file. This can be seen in the right-hand sidebar panel
    /// when viewing a file in the Box web app. Additionally, this index is used in
    description: option<string>,
    /// The retention expiration timestamp for the given file. This
    /// date cannot be shortened once set on a file.
    disposition-at: option<string>,
    /// Defines a lock on an item. This prevents the item from being
    /// moved, renamed, or otherwise changed by anyone other than the user
    lock: option<put-files-id-body-lock>,
    /// An optional different name for the file. This can be used to
    /// rename the file.
    name: option<string>,
    parent: option<put-files-id-body-parent>,
    /// Defines who can download a file.
    permissions: option<put-files-id-body-permissions>,
    shared-link: option<put-files-id-body-shared-link>,
    /// The tags for this item. These tags are shown in
    /// the Box web app and mobile apps next to an item.
    tags: option<list<string>>
  }
  put-files-id: func(params: put-files-id-params) -> result<file-full, put-files-id-error>;

  /// Delete file
  record delete-files-id-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// Ensures this item hasn't recently changed before
    /// making changes.
    if-match: option<string>
  }
  delete-files-id: func(params: delete-files-id-params) -> result<string, delete-files-id-error>;

  /// Copy file
  record post-files-id-copy-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional new name for the copied file.
    /// 
    name: option<string>,
    /// The destination folder to copy the file to.
    parent: post-files-id-copy-body-parent,
    /// An optional ID of the specific file version to copy.
    version: option<string>
  }
  post-files-id-copy: func(params: post-files-id-copy-params) -> result<file-full, post-files-id-copy-error>;

  /// Get file thumbnail
  record get-files-id-thumbnail-id-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// The file format for the thumbnail
    extension: string,
    /// The minimum height of the thumbnail
    min-height: option<s32>,
    /// The minimum width of the thumbnail
    min-width: option<s32>,
    /// The maximum height of the thumbnail
    max-height: option<s32>,
    /// The maximum width of the thumbnail
    max-width: option<s32>
  }
  get-files-id-thumbnail-id: func(params: get-files-id-thumbnail-id-params) -> result<string, get-files-id-thumbnail-id-error>;

}

interface trashed-files {
  enum trash-file-restored-item-status-enum {
    active,
    trashed,
    deleted,
  }

  enum trash-file-restored-type-op-enum {
    file,
  }

  enum trash-file-path-collection-entries-item-type-op-enum {
    folder,
  }

  record post-files-id-body-parent {
    /// The ID of parent item
    id: option<string>
  }

  /// Represents a file restored from the trash.
  record trash-file-restored {
    /// The date and time at which this file was originally
    /// created, which might be before it was uploaded to Box.
    content-created-at: option<string>,
    /// The date and time at which this file was last updated,
    /// which might be before it was uploaded to Box.
    content-modified-at: option<string>,
    /// The date and time when the file was created on Box.
    created-at: string,
    created-by: option<trash-file-restored-created-by>,
    /// The optional description of this file
    description: string,
    /// The HTTP `etag` of this file. This can be used within some API
    /// endpoints in the `If-Match` and `If-None-Match` headers to only
    etag: option<string>,
    file-version: option<trash-file-restored-file-version>,
    /// The unique identifier that represent a file.
    /// 
    id: string,
    /// Defines if this item has been deleted or not.
    /// 
    item-status: trash-file-restored-item-status-enum,
    /// The date and time when the file was last updated on Box.
    modified-at: string,
    modified-by: trash-file-restored-modified-by,
    /// The name of the file
    name: option<string>,
    owned-by: trash-file-restored-owned-by,
    parent: option<trash-file-restored-parent>,
    path-collection: trash-file-restored-path-collection,
    /// The time at which this file is expected to be purged
    /// from the trash  - becomes `null` after restore.
    purged-at: option<string>,
    sequence-id: trash-file-restored-sequence-id,
    /// The SHA1 hash of the file. This can be used to compare the contents
    /// of a file on Box with a local file.
    sha1: string,
    /// The shared link for this file. This will
    /// be `null` if a file had been trashed, even though the original shared
    shared-link: option<string>,
    /// The file size in bytes. Be careful parsing this integer as it can
    /// get very large and cause an integer overflow.
    size: s32,
    /// The time at which this file was put in the
    /// trash - becomes `null` after restore.
    trashed-at: option<string>,
    /// `file`
    type-op: trash-file-restored-type-op-enum
  }

  record trash-file-restored-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-restored-file-version {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-restored-modified-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-restored-owned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-restored-parent {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-restored-path-collection {
    /// The parent folders for this item
    entries: list<folder-mini>,
    /// The number of folders in this list.
    total-count: s64
  }

  /// A mini representation of a file version, used when
  /// nested under another resource.
  record folder-mini {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-restored-sequence-id {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// Represents a trashed file.
  record trash-file {
    /// The date and time at which this file was originally
    /// created, which might be before it was uploaded to Box.
    content-created-at: option<string>,
    /// The date and time at which this file was last updated,
    /// which might be before it was uploaded to Box.
    content-modified-at: option<string>,
    /// The date and time when the file was created on Box.
    created-at: string,
    created-by: option<trash-file-created-by>,
    /// The optional description of this file
    description: string,
    /// The HTTP `etag` of this file. This can be used within some API
    /// endpoints in the `If-Match` and `If-None-Match` headers to only
    etag: option<string>,
    file-version: option<trash-file-file-version>,
    /// The unique identifier that represent a file.
    /// 
    id: string,
    /// Defines if this item has been deleted or not.
    /// 
    item-status: trash-file-restored-item-status-enum,
    /// The date and time when the file was last updated on Box.
    modified-at: string,
    modified-by: trash-file-modified-by,
    /// The name of the file
    name: option<string>,
    owned-by: trash-file-owned-by,
    parent: option<trash-file-parent>,
    path-collection: trash-file-path-collection,
    /// The time at which this file is expected to be purged
    /// from the trash.
    purged-at: option<string>,
    sequence-id: trash-file-sequence-id,
    /// The SHA1 hash of the file. This can be used to compare the contents
    /// of a file on Box with a local file.
    sha1: string,
    /// The shared link for this file. This will
    /// be `null` if a file has been trashed, since the link will no longer
    shared-link: option<string>,
    /// The file size in bytes. Be careful parsing this integer as it can
    /// get very large and cause an integer overflow.
    size: s32,
    /// The time at which this file was put in the trash.
    trashed-at: option<string>,
    /// `file`
    type-op: trash-file-restored-type-op-enum
  }

  record trash-file-created-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-file-version {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-modified-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-owned-by {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-parent {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record trash-file-path-collection {
    /// Array of folders for this item's path collection
    entries: list<trash-file-path-collection-entries-item>,
    /// The number of folders in this list.
    total-count: s64
  }

  /// The parent folder for this item
  record trash-file-path-collection-entries-item {
    /// This field is null for the Trash folder
    etag: option<string>,
    /// The unique identifier that represent a folder.
    id: option<string>,
    /// The name of the Trash folder.
    name: option<string>,
    /// This field is null for the Trash folder
    sequence-id: option<string>,
    /// `folder`
    type-op: option<trash-file-path-collection-entries-item-type-op-enum>
  }

  record trash-file-sequence-id {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  variant post-files-id-error {
    forbidden(string),
    not-found(string),
    conflict(string),
    other(string)
  }

  variant get-files-id-trash-error {
    not-found(string),
    other(string)
  }

  variant delete-files-id-trash-error {
    not-found(string),
    other(string)
  }

  /// Restore file
  record post-files-id-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// An optional new name for the file.
    name: option<string>,
    parent: option<post-files-id-body-parent>
  }
  post-files-id: func(params: post-files-id-params) -> result<trash-file-restored, post-files-id-error>;

  /// Get trashed file
  record get-files-id-trash-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>
  }
  get-files-id-trash: func(params: get-files-id-trash-params) -> result<trash-file, get-files-id-trash-error>;

  /// Permanently remove file
  record delete-files-id-trash-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string
  }
  delete-files-id-trash: func(params: delete-files-id-trash-params) -> result<string, delete-files-id-trash-error>;

}

interface shared-links-files {
  enum add-shared-link-body-shared-link-access-enum {
    open,
    company,
    collaborators,
  }

  /// The settings for the shared link to create on the file.
  /// Use an empty object (`{}`) to use the default settings for shared
  /// links.
  record add-shared-link-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<add-shared-link-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    permissions: option<add-shared-link-body-shared-link-permissions>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  record add-shared-link-body-shared-link-permissions {
    /// If the shared link allows for downloading of files.
    /// This can only be set when `access` is set to
    can-download: option<bool>,
    /// If the shared link allows for editing of files.
    /// This can only be set when `access` is set to
    can-edit: option<bool>,
    /// If the shared link allows for previewing of files.
    /// This value is always `true`. For shared links on folders
    can-preview: option<bool>
  }

  /// A full representation of a file, as can be returned from any
  /// file API endpoints by default
  record file-full {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// By setting this value to `null`, the shared link
  /// is removed from the file.
  record remove-shared-link-body-shared-link {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The settings for the shared link to update.
  record update-shared-link-body-shared-link {
    /// The level of access for the shared link. This can be
    /// restricted to anyone with the link (`open`), only people
    access: option<add-shared-link-body-shared-link-access-enum>,
    /// The password required to access the shared link. Set the
    /// password to `null` to remove it.
    password: option<string>,
    permissions: option<update-shared-link-body-shared-link-permissions>,
    /// The timestamp at which this shared link will
    /// expire. This field can only be set by
    unshared-at: option<string>,
    /// Defines a custom vanity name to use in the shared link URL,
    /// for example `https://app.box.com/v/my-shared-link`.
    vanity-name: option<string>
  }

  record update-shared-link-body-shared-link-permissions {
    /// If the shared link allows for downloading of files.
    /// This can only be set when `access` is set to
    can-download: option<bool>,
    /// If the shared link allows for editing of files.
    /// This can only be set when `access` is set to
    can-edit: option<bool>,
    /// If the shared link allows for previewing of files.
    /// This value is always `true`. For shared links on folders
    can-preview: option<bool>
  }

  variant add-shared-link-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant get-shared-link-error {
    unauthorized(string),
    not-found(string),
    method-not-allowed(string),
    other(string)
  }

  variant remove-shared-link-error {
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant update-shared-link-error {
    bad-request(string),
    unauthorized(string),
    forbidden(string),
    not-found(string),
    method-not-allowed(string),
    precondition-failed(string),
    other(string)
  }

  variant get-shared-items-error {
    not-modified(string),
    other(string)
  }

  /// Add shared link to file
  record add-shared-link-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// The settings for the shared link to create on the file.
    /// Use an empty object (`{}`) to use the default settings for shared
    shared-link: option<add-shared-link-body-shared-link>
  }
  add-shared-link: func(params: add-shared-link-params) -> result<file-full, add-shared-link-error>;

  /// Get shared link for file
  record get-shared-link-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string
  }
  get-shared-link: func(params: get-shared-link-params) -> result<file-full, get-shared-link-error>;

  /// Remove shared link from file
  record remove-shared-link-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// By setting this value to `null`, the shared link
    /// is removed from the file.
    shared-link: option<remove-shared-link-body-shared-link>
  }
  remove-shared-link: func(params: remove-shared-link-params) -> result<file-full, remove-shared-link-error>;

  /// Update shared link on file
  record update-shared-link-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// Explicitly request the `shared_link` fields
    /// to be returned for this item.
    fields: string,
    /// The settings for the shared link to update.
    shared-link: option<update-shared-link-body-shared-link>
  }
  update-shared-link: func(params: update-shared-link-params) -> result<file-full, update-shared-link-error>;

  /// Find file for shared link
  record get-shared-items-params {
    /// Ensures an item is only returned if it has changed.
    /// 
    if-none-match: option<string>,
    /// A comma-separated list of attributes to include in the
    /// response. This can be used to request fields that are
    fields: option<list<string>>,
    /// A header containing the shared link and optional password for the
    /// shared link.
    boxapi: string
  }
  get-shared-items: func(params: get-shared-items-params) -> result<file-full, get-shared-items-error>;

}

interface downloads {
  variant get-files-id-content-error {
    found(string),
    other(string)
  }

  /// Download file
  record get-files-id-content-params {
    /// The unique identifier that represents a file.
    /// 
    file-id: string,
    /// The byte range of the content to download.
    /// 
    range: option<string>,
    /// The URL, and optional password, for the shared link of this item.
    /// 
    boxapi: option<string>,
    /// The file version to download
    version: option<string>,
    /// An optional access token that can be used to pre-authenticate this request, which means that a download link can be shared with a browser or a third party service without them needing to know how to handle the authentication.
    /// When using this parameter, please make sure that the access token is sufficiently scoped down to only allow read access to that file and no other files or folders.
    access-token: option<string>
  }
  get-files-id-content: func(params: get-files-id-content-params) -> result<string, get-files-id-content-error>;

}

