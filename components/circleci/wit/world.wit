/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `apikey` | query `circle-token` |
package autostamp:circleci@0.5.0;

interface me {
  record user {
    admin: option<bool>,
    all-emails: option<list<string>>,
    analytics-id: option<string>,
    avatar-url: option<string>,
    basic-email-prefs: option<string>,
    bitbucket: option<s32>,
    bitbucket-authorized: option<bool>,
    containers: option<s32>,
    created-at: option<string>,
    days-left-in-trial: option<s32>,
    dev-admin: option<bool>,
    enrolled-betas: option<list<string>>,
    github-id: option<s32>,
    github-oauth-scopes: option<list<string>>,
    gravatar-id: option<s32>,
    heroku-api-key: option<string>,
    in-beta-program: option<bool>,
    login: option<string>,
    name: option<string>,
    organization-prefs: option<user-organization-prefs>,
    parallelism: option<s32>,
    plan: option<string>,
    projects: option<user-projects>,
    pusher-id: option<string>,
    selected-email: option<string>,
    sign-in-count: option<s32>,
    trial-end: option<string>
  }

  record user-organization-prefs {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record user-projects {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  get-me: func() -> result<user, string>;

}


interface project {
  enum get-project-username-project-filter-enum {
    completed,
    successful,
    failed,
    running,
  }

  enum post-project-username-project-checkout-key-body-enum {
    deploy-key,
    github-user-key,
  }

  enum delete-project-username-project-checkout-key-fingerprint-response-message-enum {
    ok,
  }

  enum post-project-username-project-ssh-key-content-type-enum {
    application-json,
  }

  record builds {
    /// opaque schema; raw JSON
    value: string
  }

  /// Additional environment variables to inject into the build environment. A map of names to values.
  record build-parameters {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  /// The number of containers to use to run the build. Default is null and the project default is used.
  record parallel {
    /// opaque schema; raw JSON
    value: string
  }

  /// The specific revision to build.
  /// Default is null and the head of the branch is used. Cannot be used with tag parameter.
  record revision {
    /// opaque schema; raw JSON
    value: string
  }

  /// The tag to build. Default is null. Cannot be used with revision parameter.
  record tag {
    /// opaque schema; raw JSON
    value: string
  }

  record build-summary {
    added-at: option<string>,
    build-num: option<s32>,
    outcome: option<outcome>,
    pushed-at: option<string>,
    status: option<status>,
    vcs-revision: option<sha1>
  }

  record outcome {
    /// opaque schema; raw JSON
    value: string
  }

  record status {
    /// opaque schema; raw JSON
    value: string
  }

  record sha1 {
    /// opaque schema; raw JSON
    value: string
  }

  record delete-project-username-project-build-cache-response {
    status: option<string>
  }

  record keys {
    /// opaque schema; raw JSON
    value: string
  }

  record key {
    fingerprint: option<string>,
    preferred: option<bool>,
    public-key: option<string>,
    /// when the key was issued
    time: option<string>,
    /// can be "deploy-key" or "github-user-key"
    type-op: option<post-project-username-project-checkout-key-body-enum>
  }

  record delete-project-username-project-checkout-key-fingerprint-response {
    message: option<delete-project-username-project-checkout-key-fingerprint-response-message-enum>
  }

  record envvars {
    /// opaque schema; raw JSON
    value: string
  }

  record envvar {
    name: option<string>,
    value: option<string>
  }

  record delete-project-username-project-envvar-name-response {
    message: option<delete-project-username-project-checkout-key-fingerprint-response-message-enum>
  }

  record build {
    /// commit message body
    body: option<string>,
    branch: option<string>,
    build-time-millis: option<s32>,
    build-url: option<string>,
    committer-email: option<string>,
    committer-name: option<string>,
    /// reason why we didn't build, if we didn't build
    dont-build: option<string>,
    lifecycle: option<lifecycle>,
    previous: option<previous-build>,
    /// time build was queued
    queued-at: option<string>,
    reponame: option<string>,
    /// build_num of the build this is a retry of
    retry-of: option<s32>,
    /// time build started
    start-time: option<string>,
    /// time build finished
    stop-time: option<string>,
    subject: option<string>,
    username: option<string>,
    vcs-url: option<string>,
    /// short string explaining the reason we built
    why: option<string>
  }

  record lifecycle {
    /// opaque schema; raw JSON
    value: string
  }

  /// previous build
  record previous-build {
    build-num: option<s32>,
    build-time-millis: option<s32>,
    status: option<status>
  }

  /// previous build
  record build-detail {
    all-commit-details: option<commit-details>,
    compare: option<string>,
    job-name: option<string>,
    node: option<string>,
    previous-successful-build: option<previous-build>,
    retries: option<bool>,
    ssh-enabled: option<bool>,
    timedout: option<bool>,
    usage-queued-at: option<string>,
    user: option<user>
  }

  record commit-details {
    /// opaque schema; raw JSON
    value: string
  }

  record user {
    admin: option<bool>,
    all-emails: option<list<string>>,
    analytics-id: option<string>,
    avatar-url: option<string>,
    basic-email-prefs: option<string>,
    bitbucket: option<s32>,
    bitbucket-authorized: option<bool>,
    containers: option<s32>,
    created-at: option<string>,
    days-left-in-trial: option<s32>,
    dev-admin: option<bool>,
    enrolled-betas: option<list<string>>,
    github-id: option<s32>,
    github-oauth-scopes: option<list<string>>,
    gravatar-id: option<s32>,
    heroku-api-key: option<string>,
    in-beta-program: option<bool>,
    login: option<string>,
    name: option<string>,
    organization-prefs: option<user-organization-prefs>,
    parallelism: option<s32>,
    plan: option<string>,
    projects: option<user-projects>,
    pusher-id: option<string>,
    selected-email: option<string>,
    sign-in-count: option<s32>,
    trial-end: option<string>
  }

  record user-organization-prefs {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record user-projects {
    /// JSON-encoded free-form object payload
    data: option<string>
  }

  record artifacts {
    /// opaque schema; raw JSON
    value: string
  }

  record tests {
    tests: option<list<tests-tests-item>>
  }

  record tests-tests-item {
    classname: option<string>,
    file: option<string>,
    message: option<string>,
    name: option<string>,
    result-op: option<status>,
    run-time: option<f64>,
    source: option<string>
  }

  record get-project-username-project-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// The number of builds to return. Maximum 100, defaults to 30.
    limit: option<s32>,
    /// The API returns builds starting from this offset, defaults to 0.
    offset: option<s32>,
    /// Restricts which builds are returned.
    /// Set to "completed", "successful", "failed", "running", or defaults to no filter.
    filter: option<get-project-username-project-filter-enum>
  }
  get-project-username-project: func(params: get-project-username-project-params) -> result<builds, string>;

  record post-project-username-project-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    build-parameters: option<build-parameters>,
    parallel: option<parallel>,
    revision: option<revision>,
    tag: option<tag>
  }
  post-project-username-project: func(params: post-project-username-project-params) -> result<build-summary, string>;

  record delete-project-username-project-build-cache-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string
  }
  delete-project-username-project-build-cache: func(params: delete-project-username-project-build-cache-params) -> result<delete-project-username-project-build-cache-response, string>;

  record get-project-username-project-checkout-key-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string
  }
  get-project-username-project-checkout-key: func(params: get-project-username-project-checkout-key-params) -> result<keys, string>;

  record post-project-username-project-checkout-key-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string
  }
  post-project-username-project-checkout-key: func(params: post-project-username-project-checkout-key-params) -> result<key, string>;

  record get-project-username-project-checkout-key-fingerprint-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    fingerprint: string
  }
  get-project-username-project-checkout-key-fingerprint: func(params: get-project-username-project-checkout-key-fingerprint-params) -> result<key, string>;

  record delete-project-username-project-checkout-key-fingerprint-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    fingerprint: string
  }
  delete-project-username-project-checkout-key-fingerprint: func(params: delete-project-username-project-checkout-key-fingerprint-params) -> result<delete-project-username-project-checkout-key-fingerprint-response, string>;

  record get-project-username-project-envvar-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string
  }
  get-project-username-project-envvar: func(params: get-project-username-project-envvar-params) -> result<envvars, string>;

  record post-project-username-project-envvar-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string
  }
  post-project-username-project-envvar: func(params: post-project-username-project-envvar-params) -> result<envvar, string>;

  record get-project-username-project-envvar-name-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    name: string
  }
  get-project-username-project-envvar-name: func(params: get-project-username-project-envvar-name-params) -> result<envvar, string>;

  record delete-project-username-project-envvar-name-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    name: string
  }
  delete-project-username-project-envvar-name: func(params: delete-project-username-project-envvar-name-params) -> result<delete-project-username-project-envvar-name-response, string>;

  record post-project-username-project-ssh-key-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    content-type: post-project-username-project-ssh-key-content-type-enum,
    hostname: option<string>,
    private-key: option<string>
  }
  post-project-username-project-ssh-key: func(params: post-project-username-project-ssh-key-params) -> result<string, string>;

  record post-project-username-project-tree-branch-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// The branch name should be url-encoded.
    branch: string,
    build-parameters: option<build-parameters>,
    parallel: option<parallel>,
    revision: option<revision>
  }
  post-project-username-project-tree-branch: func(params: post-project-username-project-tree-branch-params) -> result<build, string>;

  record get-project-username-project-build-num-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    build-num: string
  }
  get-project-username-project-build-num: func(params: get-project-username-project-build-num-params) -> result<build-detail, string>;

  record get-project-username-project-build-num-artifacts-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    build-num: string
  }
  get-project-username-project-build-num-artifacts: func(params: get-project-username-project-build-num-artifacts-params) -> result<artifacts, string>;

  record post-project-username-project-build-num-cancel-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    build-num: string
  }
  post-project-username-project-build-num-cancel: func(params: post-project-username-project-build-num-cancel-params) -> result<build, string>;

  record post-project-username-project-build-num-retry-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    build-num: string
  }
  post-project-username-project-build-num-retry: func(params: post-project-username-project-build-num-retry-params) -> result<build, string>;

  record get-project-username-project-build-num-tests-params {
    /// XXXXXXXXX
    username: string,
    /// XXXXXXXXX
    project: string,
    /// XXXXXXXXXX
    build-num: string
  }
  get-project-username-project-build-num-tests: func(params: get-project-username-project-build-num-tests-params) -> result<tests, string>;

}

interface projects {
  record projects {
    /// opaque schema; raw JSON
    value: string
  }

  get-projects: func() -> result<projects, string>;

}

interface recent-builds {
  record builds {
    /// opaque schema; raw JSON
    value: string
  }

  record get-recent-builds-params {
    /// The number of builds to return. Maximum 100, defaults to 30.
    limit: option<s32>,
    /// The API returns builds starting from this offset, defaults to 0.
    offset: option<s32>
  }
  get-recent-builds: func(params: get-recent-builds-params) -> result<builds, string>;

}

interface user {
  variant post-user-heroku-key-error {
    forbidden(string),
    other(string)
  }

  post-user-heroku-key: func() -> result<string, post-user-heroku-key-error>;

}
/// The component world: imports the secrets host capability
/// the runtime uses and exports the generated interfaces. The HTTP host
/// capability is imported by the `wstd` crate's bindings at build time.
world client {
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export me;
  export project;
  export projects;
  export recent-builds;
  export user;
}
