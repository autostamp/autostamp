/// ## Authentication
///
/// Reads credentials from the host via `wasmcloud:secrets`; operations never take a token.
/// Provision these named secrets:
///
/// | Secret name | Applied to each request as |
/// | --- | --- |
/// | `api_key` | query `key` |
package autostamp:tomtom@0.2.0;

interface copyrights {
  /// Copyrights whole world
  record get-map-version-number-copyrights-format-params {
    /// Version of the service to call. The current version is 1
    version-number: string,
    /// Format of the response
    format: string,
    /// Specifies the jsonp callback method. Only used when format is jsonp
    callback: option<string>
  }
  get-map-version-number-copyrights-format: func(params: get-map-version-number-copyrights-format-params) -> result<string, string>;

  /// Captions
  record get-map-version-number-copyrights-caption-format-params {
    /// Version of the service to call. The current version is 1.
    version-number: string,
    /// Format of the response
    format: string,
    /// Specifies the jsonp callback method. Only used when format is jsonp
    callback: option<string>
  }
  get-map-version-number-copyrights-caption-format: func(params: get-map-version-number-copyrights-caption-format-params) -> result<string, string>;

  /// Copyrights bounding box
  record get-map-version-number-copyrights-min-lon-min-lat-max-lon-max-lat-format-params {
    /// Version of the service to call. The current version is 1
    version-number: string,
    /// Format of the response
    format: string,
    /// Minimum longitude coordinate of bounding box defined in terms of latitude/longitude.
    min-lon: string,
    /// Minimum latitude coordinate of bounding box defined in terms of latitude/longitude.
    min-lat: string,
    /// Maximum longitude coordinate of bounding box defined in terms of latitude/longitude.
    max-lon: string,
    /// Maximum latitude coordinate of bounding box defined in terms of latitude/longitude.
    max-lat: string,
    /// Specifies the jsonp callback method. Only used when format is jsonp.
    callback: option<string>
  }
  get-map-version-number-copyrights-min-lon-min-lat-max-lon-max-lat-format: func(params: get-map-version-number-copyrights-min-lon-min-lat-max-lon-max-lat-format-params) -> result<string, string>;

  /// Copyrights tile
  record get-map-version-number-copyrights-zoom-x-y-format-params {
    /// Version of the service to call. The current version is 1
    version-number: string,
    /// Format of the response
    format: string,
    /// Zoom level of tile to be rendered. Only used for tile-level
    /// copyright calls.
    zoom: string,
    /// X coordinate of the tile on zoom grid. Only used for tile-level
    /// copyright calls.
    x: string,
    /// Y coordinate of the tile on zoom grid. Only used for tile-level
    /// copyright calls.
    y: string,
    /// Specifies the jsonp callback method. Only used when format is jsonp.
    callback: option<string>
  }
  get-map-version-number-copyrights-zoom-x-y-format: func(params: get-map-version-number-copyrights-zoom-x-y-format-params) -> result<string, string>;

}


interface raster {
  enum get-map-version-number-staticimage-layer-enum {
    basic,
    hybrid,
    labels,
  }

  enum get-map-version-number-staticimage-style-enum {
    main,
    night,
  }

  enum get-map-version-number-staticimage-format-enum {
    png,
    jpg,
    jpeg,
  }

  enum get-map-version-number-staticimage-view-enum {
    unified,
    in,
  }

  /// Static Image
  record get-map-version-number-staticimage-params {
    /// Version of the service to call. The current version is 1.
    version-number: string,
    /// Layer of image to be rendered. <em>Hybrid</em> and <em>labels</em>
    /// are intended for layering with other data and are only available in <em>png</em> format.
    layer: option<get-map-version-number-staticimage-layer-enum>,
    /// Map style to be returned
    style: option<get-map-version-number-staticimage-style-enum>,
    /// Image format to be returned
    format: option<get-map-version-number-staticimage-format-enum>,
    /// Zoom level of map image to be returned.
    zoom: option<s32>,
    /// Coordinates for the center point of the image.
    /// Must be used with the <strong>width</strong> and
    center: option<string>,
    /// Width of the resulting image in pixels. Width must be a positive integer between 1 and 8192.
    width: option<s32>,
    /// Height of the resulting image in pixels. Height must be a positive integer between 1 and 8192.
    height: option<s32>,
    /// Bounding box for the image, using EPSG:3857 projection (functionally equivalent to EPSG:900910).
    /// Values <strong>must</strong> be in the order of minLon, minLat, maxLon, maxLat.
    bbox: option<string>,
    /// Geopolitical view. Determines rendering of disputed areas. See the <a href="/maps-api/maps-api-documentation-raster/raster-tile">documentation</a> for an explanation of how this works in live services.
    view: option<get-map-version-number-staticimage-view-enum>
  }
  get-map-version-number-staticimage: func(params: get-map-version-number-staticimage-params) -> result<string, string>;

  /// Tile
  record get-map-version-number-tile-layer-style-zoom-x-y-format-params {
    /// Version of the service to call. The current version is 1.
    version-number: string,
    /// Layer of tile to be rendered. <em>Hybrid</em> and <em>labels</em> are intended for layering with other data and are only available in <em>png</em> format.
    layer: string,
    /// Style of tile to be rendered
    style: string,
    /// Zoom level of tile to be rendered
    zoom: string,
    /// x coordinate of tile on zoom grid
    x: string,
    /// y coordinate of tile on zoom grid
    y: string,
    /// Format of the response.
    format: string,
    /// Tile dimensions in pixels. <em>512</em> is only available for the <em>main</em> style and <em>basic</em> or <em>labels</em> layers.
    tile-size: option<s32>,
    /// Geopolitical view. Determines rendering of disputed areas. See the <a href="/maps-sdk-web/functional-examples#geopolitical-views">documentation</a> for an explanation of how this works in live services.
    view: option<get-map-version-number-staticimage-view-enum>
  }
  get-map-version-number-tile-layer-style-zoom-x-y-format: func(params: get-map-version-number-tile-layer-style-zoom-x-y-format-params) -> result<string, string>;

}

interface vector {
  enum get-map-version-number-tile-layer-style-zoom-x-y-pbf-view-enum {
    unified,
    il,
    in,
  }

  /// Tile
  record get-map-version-number-tile-layer-style-zoom-x-y-pbf-params {
    /// Version of the service to call. The current version is 1
    version-number: string,
    /// Layer of tile to be rendered
    layer: string,
    /// Style of tile to be rendered
    style: string,
    /// Zoom level of tile to be rendered
    zoom: string,
    /// x coordinate of tile on zoom grid
    x: string,
    /// y coordinate of tile on zoom grid
    y: string,
    /// Geopolitical view. Determines rendering of disputed areas. See the <a href="/maps-api/maps-api-documentation-vector/tile">documentation</a> for an explanation of how this works in live services.
    view: option<get-map-version-number-tile-layer-style-zoom-x-y-pbf-view-enum>,
    /// Language to be used for labels in the response. The default is NGT: Neutral Ground Truth, which uses each place's local official language and script (where available). See the <a href="/maps-api/maps-api-documentation-vector/tile">documentation</a> for a full list of options.
    language: option<string>
  }
  get-map-version-number-tile-layer-style-zoom-x-y-pbf: func(params: get-map-version-number-tile-layer-style-zoom-x-y-pbf-params) -> result<string, string>;

}

interface wms-wmts {
  enum get-map-request-enum {
    get-map,
  }

  enum get-map-srs-enum {
    epsg-v3857,
    epsg-v4326,
  }

  enum get-map-format-enum {
    image-jpeg,
    image-png,
  }

  enum get-map-layers-enum {
    basic,
  }

  enum get-map-styles-enum {
    empty,
  }

  enum get-map-service-enum {
    wms,
  }

  enum get-map-version-enum {
    v1-v1-v1,
  }

  enum get-capabilities-request-enum {
    get-capabilities,
  }

  /// GetMap
  record get-map-params {
    /// Version of the service to call. The current version is 1
    version-number: string,
    /// Request type
    request: get-map-request-enum,
    /// Projection used in describing the <b>bbox</b> EPSG:3857 is
    /// recommended, particularly at higher zoom levels. (Note that
    srs: get-map-srs-enum,
    /// Bounding box in the projection stated in <b>srs</b>
    /// (minLon,minLat,maxLon,maxLat)
    bbox: string,
    /// Width of the resulting image, in pixels Maximum value is 2048
    width: s32,
    /// Height of the resulting image, in pixels Maximum value is 2048
    height: s32,
    /// Image format to be returned
    format: get-map-format-enum,
    /// Map layers requested Currently only the basic layer is available
    layers: get-map-layers-enum,
    /// Map styles to be returned. Currently, no styles are available. This
    /// parameter is present for forward compatibility; it must be used and
    styles: option<get-map-styles-enum>,
    /// Service type
    service: option<get-map-service-enum>,
    /// WMS service version
    version: get-map-version-enum
  }
  get-map: func(params: get-map-params) -> result<string, string>;

  /// GetCapabilities
  record get-capabilities-params {
    version-number: string,
    service: get-map-service-enum,
    request: get-capabilities-request-enum,
    /// WMS service version
    version: option<get-map-version-enum>
  }
  get-capabilities: func(params: get-capabilities-params) -> result<string, string>;

  /// WMTS
  record get-map-version-number-wmts-key-wmts-version-wmts-capabilities-xml-params {
    /// Version of the service to call. The current version is 1
    version-number: string,
    /// Your API key for calling this service.
    key: string,
    wmts-version: string
  }
  get-map-version-number-wmts-key-wmts-version-wmts-capabilities-xml: func(params: get-map-version-number-wmts-key-wmts-version-wmts-capabilities-xml-params) -> result<string, string>;

}
/// The component world: imports the HTTP + secrets host
/// capabilities the runtime uses and exports the generated interfaces.
world client {
  import wasi:http/outgoing-handler@0.2.3;
  import wasmcloud:secrets/store@1.0.0;
  import wasmcloud:secrets/reveal@1.0.0;
  export copyrights;
  export raster;
  export vector;
  export wms-wmts;
}
