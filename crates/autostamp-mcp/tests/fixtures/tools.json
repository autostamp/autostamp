{
  "tools": [
    {
      "name": "find_items",
      "description": "Find items by query.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "$defs": {
          "status/value~": {
            "type": ["string", "null"],
            "enum": ["in-progress", "done", null],
            "description": "A status, or explicit null."
          }
        },
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z]+$",
            "default": "all"
          },
          "status": { "$ref": "#/$defs/status~1value~0" },
          "limit": { "type": "integer", "format": "uint16", "minimum": 1, "maximum": 100 },
          "filters": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          },
          "options": {
            "type": "object",
            "properties": {
              "additional-properties": { "type": "string" },
              "known": { "type": ["number", "null"], "format": "float32" }
            },
            "required": ["known"],
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "required": ["query"]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "integer", "format": "uint64" },
                "name": { "type": "string" }
              },
              "required": ["id", "name"]
            }
          }
        },
        "required": ["items"]
      },
      "annotations": { "readOnlyHint": true },
      "execution": { "taskSupport": "optional" }
    },
    {
      "name": "ping",
      "inputSchema": { "type": "object", "additionalProperties": false }
    }
  ],
  "_meta": { "fixture": true }
}
